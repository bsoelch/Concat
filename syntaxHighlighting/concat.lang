<?xml version="1.0" encoding="UTF-8"?>

<language id="concat" name="Concat" version="2.0" _section="Source">
  <metadata>
    <property name="mimetypes">text/*</property>
    <property name="globs">*.txt</property>
    <property name="line-comment-start">--</property>
    <property name="suggested-suffix">.txt</property>
  </metadata>

  <styles>
    <style id="preprocessor" name="Preprocessor" map-to="def:preprocessor"/>
    <style id="comment"      name="Comment"      map-to="def:comment"/>
    <style id="variable"     name="Variable"                         />
    <style id="symbol"       name="Symbol"                           />
    <style id="keyword"      name="Keyword"      map-to="def:keyword"/>
    <style id="type-keyword" name="Type Keyword" map-to="c:keyword"/>
    <style id="operator"     name="Operator"      map-to="def:keyword"/>
    <style id="type"         name="Data Type"    map-to="def:type"/>
    <style id="string"       name="String"       map-to="def:string"/>
    <style id="character"    name="Character"    map-to="def:character"/>
    <style id="char-escape"  name="Escaped Character" map-to="def:special-char"/>
    <style id="float"        name="Float"        map-to="def:floating-point"/>
    <style id="decimal"      name="Decimal"      map-to="def:decimal"/>
    <style id="binary"       name="Binary"       map-to="def:base-n-integer"/>
    <style id="hexadecimal"  name="Hex"          map-to="def:base-n-integer"/>
    <style id="boolean"      name="Boolean value"         map-to="def:boolean"/>
    <style id="error"        name="Error"                 map-to="def:error"/>
  </styles>

  <definitions>
  
    <context id="line-comment" style-ref="comment" end-at-line-end="true" class="comment" class-disabled="no-spell-check">
      <start>\#\#</start>
      <include>
        <context ref="def:in-comment"/>
      </include>
    </context>

    <context id="block-comment" style-ref="comment" class="comment" class-disabled="no-spell-check">
      <start>\#\+</start>
      <end>\+\#</end>
      <include>
        <context ref="def:in-comment"/>
        <context ref="block-comment"/>
      </include>
    </context>


    <context id="postfix-keyword" style-ref="keyword">
      <keyword>if</keyword>
      <keyword>else</keyword>
      <keyword>_if</keyword>
      <keyword>end</keyword>
      <keyword>while</keyword>
      <keyword>do</keyword>
      <keyword>return</keyword>
      <keyword>addrOf</keyword>
      <keyword>new</keyword>
      <keyword>print</keyword>
    </context>
    <context id="declaration" style-ref="keyword">
      <match extended="true">
        =?: | 
        =:: |
        entryPoint:
      </match>
    </context>
    
    <context id="operators" style-ref="operator">
      <keyword>\+</keyword>
      <keyword>-</keyword>
      <keyword>\++</keyword>
      <keyword>--</keyword>
      <keyword>\*</keyword>
      <keyword>/</keyword>
      <keyword>%</keyword>
      <keyword>\&amp;</keyword>
      <keyword>\|</keyword>
      <keyword>^</keyword>
      <keyword>=</keyword>
      <keyword>&lt;</keyword>
      <keyword>&gt;</keyword>
      <keyword>&lt;=</keyword>
      <keyword>&gt;=</keyword>
      <keyword>==</keyword>
      <keyword>!=</keyword>
    </context>
    <context id="operator-punctuation" style-ref="operator">
      <match extended="true">
        \[\] | 
        \.   | 
        @
      </match>
    </context>
    
    
    <context id="type-keywords" style-ref="type-keyword">
      <keyword>tuple</keyword>
      <keyword>proc</keyword>
      <keyword>ptr</keyword>
      
      <keyword>enum</keyword>
      <keyword>struct</keyword>
    </context> 
    <context id="type-punctuation" style-ref="type-keyword">
      <match extended="true">
        \(|\) | 
        =&gt;
      </match>
    </context>
    
    <context id="typeName" style-ref="type">
      <keyword>i64</keyword>
      <keyword>i32</keyword>
      <keyword>i8</keyword>
      <keyword>char</keyword>
      <keyword>float</keyword>
      <keyword>string</keyword>
    </context>


    <define-regex id="escaped-character" extended="true">
        \\(                   # leading backslash
        [bfnrtv\\"\'] | # escaped character
        u[0-9A-Fa-f]{4} |       # 'u' followed by 4 hex digits
        U[0-9A-Fa-f]{8} |       # 'U' followed by 8 hex digits
        x[0-9A-Fa-f]{2} |       # 'x' followed by 2 hex digits
        )
    </define-regex>

    <context id="string" style-ref="string" end-at-line-end="false" class="string" class-disabled="no-spell-check">
      <start>"</start>
      <end>"</end>
      <include>
        <context ref="def:line-continue"/>
        <context style-ref="char-escape">
          <match>\%{escaped-character}</match>
        </context>
      </include>
    </context>

    <context id="char" style-ref="character" end-at-line-end="false">
      <start>'</start>
      <end>'</end>
      <include>
        <context style-ref="char-escape" once-only="true">
          <match>\%{escaped-character}</match>
        </context>
        <context once-only="true" extend-parent="false">
          <match>.</match>
        </context>
        <context style-ref="def:error" extend-parent="false">
          <match>.</match>
        </context>
      </include>
    </context>
<!--
    <context id="float" style-ref="float">
      <match extended="true">
          [0-9]+ \. [0-9]+ ([eE][+-]?[0-9]+)?
        | [0-9]+            [eE][+-]?[0-9]+
      </match>
    </context>
-->
    
    <context id="binary" style-ref="binary">
      <match extended="true">
        (?&lt;![\w\.])
        0[bB][01]+
        (?![\w\.])
      </match>
    </context>

    <context id="invalid-binary" style-ref="error">
      <match extended="true">
        (?&lt;![\w\.])
        0[bB][01]*[2-9a-zA-Z][01]*
        (?![\w\.])
      </match>
    </context>
    
    <context id="hexadecimal" style-ref="hexadecimal">
      <match extended="true">
        (?&lt;![\w\.])
        0[xX][a-fA-F0-9]+[uUlL]*
        (?![\w\.])
      </match>
    </context>

    <context id="invalid-hexadecimal" style-ref="error">
      <match extended="true">
        (?&lt;![\w\.])
        0[xX][a-fA-F0-9]*[g-zG-Z][a-zA-Z0-9]*[uUlL]*
        (?![\w\.])
      </match>
    </context>
    
    <context id="decimal" style-ref="decimal">
      <match extended="true">
        (?&lt;![\w\.])
        (0|[1-9][0-9]*)[uUlL]*
        (?![\w\.])
      </match>
    </context>
    
    <context id="boolean" style-ref="boolean">
      <keyword>true</keyword>
      <keyword>false</keyword>
    </context>

    <context id="body">
      <include>
        <context ref="line-comment"/>
        <context ref="block-comment"/>
        <context ref="postfix-keyword"/>
        <context ref="declaration"/>
        <context ref="type-keywords"/>
        <context ref="type-punctuation" />
        <context ref="typeName"/>
        <context ref="string"/>
        <context ref="char"/>
    <!--    <context ref="float"/> -->
        <context ref="hexadecimal"/>
        <context ref="binary"/>
        <context ref="invalid-hexadecimal"/>
        <context ref="invalid-binary"/>
        <context ref="decimal"/>
        <context ref="operators"/>
        
      </include>
    </context>

    <context id="concat" class="no-spell-check">
      <include>
      <!--
        <context ref="def:shebang"/>
        <context ref="c:if0-comment"/>
        <context ref="c:include"/>
        <context ref="c:preprocessor"/>
        -->
        <context ref="body"/>
      </include>
    </context>

  </definitions>
</language>
