<?xml version="1.0" encoding="UTF-8"?>

<language id="concat" name="Concat" version="2.0" _section="Source">
  <metadata>
    <property name="mimetypes">text/x-concat</property>
    <property name="globs">*.concat</property>
    <property name="line-comment-start">--</property>
    <property name="suggested-suffix">.concat</property>
  </metadata>

  <styles>
    <style id="compile-time" name="compile time operation" map-to="def:preprocessor"/>
    <style id="comment"      name="Comment"      map-to="def:comment"/>
    <style id="annotation"   name="annotation"   map-to="def:comment"/>
    <style id="variable"     name="Variable"                         />
    <style id="field"        name="Field"                            />
    <style id="symbol"       name="Symbol"                           />
    <style id="keyword"      name="Keyword"      map-to="def:keyword"/>
    <style id="type-keyword" name="Type Keyword" map-to="c:keyword"/>
    <style id="operator"     name="Operator"      map-to="def:keyword"/>
    <style id="type"         name="Data Type"    map-to="def:type"/>
    <style id="string"       name="String"       map-to="def:string"/>
    <style id="character"    name="Character"    map-to="def:character"/>
    <style id="char-escape"  name="Escaped Character" map-to="def:special-char"/>
    <style id="float"        name="Float"        map-to="def:floating-point"/>
    <style id="decimal"      name="Decimal"      map-to="def:decimal"/>
    <style id="binary"       name="Binary"       map-to="def:base-n-integer"/>
    <style id="hexadecimal"  name="Hex"          map-to="def:base-n-integer"/>
    <style id="boolean"      name="Boolean value"         map-to="def:boolean"/>
    <style id="error"        name="Error"                 map-to="def:error"/>
  </styles>

  <definitions>
  
    <context id="line-comment" style-ref="comment" end-at-line-end="true" class="comment" class-disabled="no-spell-check">
      <start>(\A|(?&lt;=[[:space:]]))\#\#</start>
      <include>
        <context ref="def:in-comment"/>
      </include>
    </context>

    <context id="block-comment" style-ref="comment" class="comment" class-disabled="no-spell-check">
      <start>(\A|(?&lt;=[[:space:]]))\#\+</start>
      <end>\+\#</end>
      <include>
        <context ref="def:in-comment"/>
        <context ref="block-comment"/>
      </include>
    </context>


    <context id="postfix-keyword" style-ref="keyword">
      <match extended="true">
        (\A|(?&lt;=[[:space:]]))( # start of file or white-space
          if              |
          else            |
          _if             |
          end             |
          while           |
          do              |
          break           |
          continue        |
          switch          |
          case            |
          default         |
          return          |
          end             
        )(\Z|(?=[[:space:]])) # end of file or white-space
      </match>
    </context>
    
    <context id="declaration" style-ref="keyword">
      <match extended="true">
        (\A|(?&lt;=[[:space:]]))( # start of file or white-space
          (=?: | =:: | \#typedef ) ([[:space:]]+(mut|auto|static|extern|public|private))*  |
          entryPoint:
        )(\Z|(?=[[:space:]])) # end of file or white-space
      </match>
    </context>
    
    <context id="operators" style-ref="operator">
      <match extended="true">
        (\A|(?&lt;=[[:space:]]))( # start of file or white-space
          \+                  | 
          -                   |
          \*                  |
          /                   |
          %                   |
          \.\.udiv            |
          \.\.umod            |
          \&amp;              |
          \|                  |
          \^                  |
          =                   |
          &lt;=?              |
          &gt;=?              |
          ==                  |
          \!=                 |
          \.\.u&lt;           |
          \.\.u&lt;=          |
          \.\.u&gt;=          |
          \.\.u&gt;           |
          \+\+                |
          --                  |
          \!                  |
          ~                   |
          -_                  |
          \[\]                |
          \(\)                |
          @                   |
          &lt;&lt;            |
          &gt;&gt;            |
          \.\.lshr            |
          addrOf              |
          new                 |
          cast                |
          cast!               |
          \.\.argc            |
          \.\.getArg          |
          \.\.length          |
          \.\.size            |
          \.\.alloca          |
          \.\.unreachable     |
          \.\.debug\.print          
        )(\Z|(?=[[:space:]])) # end of file or white-space
      </match>
    </context>
    
    <context id="compile-time" style-ref="compile-time">
      <match extended="true">
        (\A|(?&lt;=[[:space:]]))( # start of file or white-space
          \#(
            dup(\:[0-9]+)?     |
            drop(\:[0-9]+)?    |
            swap               |
            over(\:[0-9]+)?    |
            namespace          |
            using              |
            end                |
            include            |
            template           |
            types(\:[0-9]+)?   |
            stack(\:[0-9]+)?   |
            ops(\:[0-9]+)?     |
            find               |
            assert          
          )
        )(\Z|(?=[[:space:]])) # end of file or white-space
      </match>
    </context>
    
    <context id="annotation" style-ref="annotation">
      <match extended="true">
        (\A|(?&lt;=[[:space:]]))( # start of file or white-space
          \#\:[^[:space:]]+
        )(\Z|(?=[[:space:]])) # end of file or white-space
      </match>
    </context>
    
    <context id="field-access" style-ref="field">
      <match extended="true">
        (\A|(?&lt;=[[:space:]]))( # start of file or white-space
          \.([^\.[:space:]])+
        )(\Z|(?=[[:space:]])) # end of file or white-space
      </match>
    </context>
    
    <context id="type-keywords" style-ref="type-keyword">
      <match extended="true">
        (\A|(?&lt;=[[:space:]]))( # start of file or white-space
          \(|\)                        | 
          tuple\(                      |
          proc\(                       |
          =&gt;                        |
          enum\(                       |
          struct\(                     |
          union\(                      |
          array                        |
          ptr ([[:space:]]+mut)?
        )(\Z|(?=[[:space:]])) # end of file or white-space
      </match>
    </context>
    <context id="libtype-keywords" style-ref="type-keyword">
      <match extended="true">
        (\A|(?&lt;=[[:space:]]))( # start of file or white-space
          list                         |
          arrayView                    |
          optional                     |
          hashMap
        )(\Z|(?=[[:space:]])) # end of file or white-space
      </match>
    </context>
    
    <context id="primitiveType" style-ref="type">
      <match extended="true">
        (\A|(?&lt;=[[:space:]]))( # start of file or white-space
          bool            |
          i8              |
          i16             |
          i32             |
          i64             |
          float           |
          double          |
          type         
        )(\Z|(?=[[:space:]])) # end of file or white-space
      </match>
    </context>
    <context id="libType" style-ref="type">
      <match extended="true">
        (\A|(?&lt;=[[:space:]]))( # start of file or white-space
          string          |
          stringBuilder   |
          (io\.)?FILE     |
          (io\.)?IOError  |
          (io\.)?OpenMode
        )(\Z|(?=[[:space:]])) # end of file or white-space
      </match>
    </context>


    <define-regex id="escaped-character" extended="true">
        \\(                     # leading backslash
        [bfnrtv\\"\']   |       # escaped character
        u[0-9A-Fa-f]{4} |       # 'u' followed by 4 hex digits
        U[0-9A-Fa-f]{8} |       # 'U' followed by 8 hex digits
        x[0-9A-Fa-f]{2} |       # 'x' followed by 2 hex digits
        )
    </define-regex>

    <context id="string" style-ref="string" end-at-line-end="false" class="string" class-disabled="no-spell-check">
      <start>(\A|(?&lt;=[[:space:]]))"</start>
      <end>"</end>
      <include>
        <context ref="def:line-continue"/>
        <context style-ref="char-escape">
          <match>\%{escaped-character}</match>
        </context>
      </include>
    </context>

    <context id="char" style-ref="character" end-at-line-end="false">
      <start>(\A|(?&lt;=[[:space:]]))'</start>
      <end>'</end>
      <include>
        <context style-ref="char-escape" once-only="true">
          <match>\%{escaped-character}</match>
        </context>
        <context once-only="true" extend-parent="false">
          <match>.</match>
        </context>
        <context style-ref="def:error" extend-parent="false">
          <match>.</match>
        </context>
      </include>
    </context>
<!--
    <context id="float" style-ref="float">
      <match extended="true">
          [0-9]+ \. [0-9]+ ([eE][+-]?[0-9]+)?
        | [0-9]+            [eE][+-]?[0-9]+
      </match>
    </context>
-->
    
    <context id="binary" style-ref="binary">
      <match extended="true">
        (\A|(?&lt;=[[:space:]]))( # start of file or white-space
          -?0[bB][01]([_']*[0-1])*(u|U|((u|U|i|I)[0-9]+))?
        )(\Z|(?=[[:space:]])) # end of file or white-space
      </match>
    </context>

    <context id="hexadecimal" style-ref="hexadecimal">
      <match extended="true">
        (\A|(?&lt;=[[:space:]]))( # start of file or white-space
          -?0[xX][a-fA-F0-9]([_']*[a-fA-F0-9])*(u|U|((u|U|i|I)[0-9]+))?
        )(\Z|(?=[[:space:]])) # end of file or white-space
      </match>
    </context>
    
    <context id="decimal" style-ref="decimal">
      <match extended="true">
        (\A|(?&lt;=[[:space:]]))( # start of file or white-space
          -?[0-9]([_']*[0-9])*(u|U|((u|U|i|I)[0-9]+))?
        )(\Z|(?=[[:space:]])) # end of file or white-space
      </match>
    </context>
    
    <context id="boolean" style-ref="boolean">
      <match extended="true">
        (\A|(?&lt;=[[:space:]]))( # start of file or white-space
          true |
          false
        )(\Z|(?=[[:space:]])) # end of file or white-space
      </match>
    </context>


    <context id="concat" class="no-spell-check">
      <include>
        <context ref="line-comment"/>
        <context ref="block-comment"/>
        <context ref="postfix-keyword"/>
        <context ref="declaration"/>
        <context ref="type-keywords"/>
        <context ref="libtype-keywords"/>
        <context ref="primitiveType"/>
        <context ref="libType"/>
        <context ref="string"/>
        <context ref="char"/>
    <!--    <context ref="float"/> -->
        <context ref="hexadecimal"/>
        <context ref="binary"/>
        <context ref="decimal"/>
        <context ref="operators"/>
        <context ref="field-access"/>
        <context ref="compile-time"/>
        <context ref="annotation"/>
        <context ref="boolean"/>
      </include>
    </context>

  </definitions>
</language>
