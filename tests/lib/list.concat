'list' import
'print' import

proc( type : auto: T  T list : l -> ) =>: printList
  0:iSize while ..dup l .length u< do
    l .data ..over [] io.println
    1:iSize +
  end ..drop
end

proc( -> ) =>: main
  4 i32 list.create
    1 list.append
    2 list.append
    3 list.append
    4 list.append
    5 list.append
    6 list.append
  printList
  
  8 char8 list.create "World" list.appendP =:: l
  16 char8 list.create
    "Hello" list.appendP
    ' '     list.append
    l       list.appendAll
  printList
 
  l 0 [] io.println
  '\x2a' l 3 list.set
  l 3 [] io.println
end
