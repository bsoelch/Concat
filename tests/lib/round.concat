  -0.25 math.round ..debug.print
  -5e-324 math.round ..debug.print
  -0.0 math.round ..debug.print
  0.0 math.round ..debug.print
  5e-324 math.round ..debug.print
  0.25 math.round ..debug.print
  0.5 math.round ..debug.print
  0.75 math.round ..debug.print
  1.0 math.round ..debug.print
