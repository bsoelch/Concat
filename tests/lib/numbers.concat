import numbers
using number.
import debug

proc( -> ) =>: main
  5 2 powI debug.print
  2 f32 cast 100 powI debug.print
  "1.25" string.wrap 10 tryParseFloat ..drop debug.print

  "f.ffffffffffff8X+ff"  string.wrap 16 tryParseFloat .NONE ?? debug.print debug.print
  "-f.ffffffffffff8X+ff"  string.wrap 16 tryParseFloat .NONE ?? debug.print debug.print
  "0.00000000000004X-ff" string.wrap 16 tryParseFloat .NONE ?? debug.print debug.print
  "-0.00000000000004X-ff" string.wrap 16 tryParseFloat .NONE ?? debug.print debug.print
  "1'000'000'000'000'000'000'000'000'000" string.wrap 0 tryParseFloat
    .INT ?? "parse success" assert
  1e27 == "large ints parse correctly" assert

  "0x1000p-10"  string.wrap 0 tryParseFloat .NONE ?? debug.print debug.print

  "123456789"  string.wrap 0 tryParseFloat .NONE ?? debug.print debug.print

  "0x7fff_ffff_ffff_ffff" string.wrap 0 tryParseInt .NONE ?? debug.print debug.print
  "0x8000_0000_0000_0000" string.wrap 0 tryParseInt .NONE ?? debug.print debug.print
  "-0x8000_0000_0000_0000" string.wrap 0 tryParseInt .NONE ?? debug.print debug.print
  "0x8000_0000_0000_0000" string.wrap 0 tryParseUInt .NONE ?? debug.print debug.print
  "-1" string.wrap 0 tryParseUInt .NONE ?? debug.print debug.print

  "0b11'00'10'01" string.wrap 0 tryParseInt .NONE ?? debug.print debug.print
  "12345678987654321" string.wrap 0 tryParseInt .NONE ?? debug.print debug.print

  "9223372036854775808" string.wrap 10 number.tryParseInt .NONE ?? debug.print debug.print
  "9223372036854775807" string.wrap 10 number.tryParseInt .NONE ?? debug.print debug.print
end
