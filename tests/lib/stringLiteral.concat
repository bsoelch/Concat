import string
using std.literals.

proc( -> ) =>: main
  "This is a string literal":s =:: str
  utf16"This is a UTF16-String👍":s =:: str16
  utf32"This is a UTF32-String👍":s =:: str32
  str .data:? "str has data" assert
  str16 .data:? "str16 has data" assert
  str32 .data:? "str32 has data" assert
  str .length 24 == "str.length == 24" assert
  str16 .length 24 == "str16.length == 24" assert
  str32 .length 23 == "str32.length == 23" assert
end
