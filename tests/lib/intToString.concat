#include numbers/printInt
#include stringIO

entryPoint:
  16 sb.create
    -12345678             sb.appendI    '\n' sb.appendC
    "0x"                  sb.appendS
    0x1234567             sb.appendX    '\n' sb.appendC
    "0b"                  sb.appendS 
    0b11001001            sb.appendBin  '\n' sb.appendC
    0x7fff_ffff_ffff_ffff sb.appendX    '\n' sb.appendC
   -0x8000_0000_0000_0000 sb.appendI    '\n' sb.appendC
   -1                     sb.appendU    '\n' sb.appendC
   -1                     sb.appendUBin '\n' sb.appendC
   io.stdOut #over io.fputSb ..debug.print
  sb.free #drop
end
