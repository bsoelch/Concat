import numbers/i128

proc( i128 : x i64 : hi i64 : low -> bool ) =>: check
  x .hi hi == and x .low low == end
end

proc( -> ) =>: main
  1 i128.fromU64 65 i128.fromU64 << ..dup 2 0 check "1 << 65" assert
    2 i128.fromU64 i128.lshr ..dup 0 0x8000'0000'0000'0000:i64 check "$ >>> 2" assert
    1 i128.fromU64 i128.ashr ..dup 0 0x4000'0000'0000'0000:i64 check "$ >> 1" assert
    i128.neg ..dup -1 0xC000'0000'0000'0000:i64 check "-$" assert
    1 i128.fromU64 i128.ashr ..dup -1 0xE000'0000'0000'0000:i64 check "$ >> 1" assert
  1 i128.fromU64 i128.lshr 0x7fff'ffff'ffff'ffff 0xF000'0000'0000'0000:i64 check "$ >>> 1" assert
  ## add
    -1 i128.fromI64
    1 i128.fromI64
  i128.add 0 0 check "-1+1==0" assert
  ## add
    -1:i64 i128.fromU64
    1 i128.fromU64
  i128.add 1 0 check "U64_MAX+1" assert
  ## mul
    0x111111111111111 i128.fromU64
    0x111111111111111 i128.fromU64
  i128.mul ..dup 0x123456789ABCD:i64 0xEFEDCBA987654321:i64 check "11111111111111²" assert
    0x111111111111111 i128.fromU64
  i128.div 0 0x111111111111111:i64 check "11111111111111²/11111111111111²" assert
end
