import map

import stringBuilder
import numbers/intToStr
import print

proc( i32 -> i32 ) =>: i32Hash end
proc( i32 i32 -> bool ) =>: i32Eq  == end

proc( -> ) =>: main
  i32Hash@ i32Eq@ 16 i64 map.create =:: mut: myMap
  char8 32 array : charBuff
  myMap@
    ..dup 0   1 map.put ..drop
    ..dup -5  2 map.put ..drop
    ..dup 2   3 map.put ..drop
    ..dup 11  4 map.put ..drop
    ..dup 11  5 map.put ..drop
    ..dup 2   6 map.put ..drop
    ..dup 42  7 map.put ..drop
    $ for =:: key =:: val
      charBuff@ sb.wrapBuffer
        key sb.appendI
        ": " sb.appendS
        val sb.appendI
        '\n' sb.appendC
      sb.asStr io.print
    end
 map.free
end
