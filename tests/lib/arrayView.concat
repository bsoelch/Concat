#include arrayView

#template type : T #end
proc( T arrayView : l => ) =: printArray
  0 while #dup l .length < do
    l .data #over [] print
    1 +
  end #drop
end

#using array 
entryPoint:
  "Hello World" array.wrap =:: str
  str 5 get print
  str 'A' indexOf print
  str 'o' indexOf print
  str 'A' lastIndexOf print
  str 'o' lastIndexOf print
  str 'c' contains print
  i32 10 array new =:: mut a
  0 while #dup a .length < do
    #dup #dup * a #over:2 [] =
    1 +
  end #drop
  a addrOf 8 array.create
    #dup 3 head printArray
    -141516511 print
    #dup 5 tail printArray
    -34731715 print
    #dup 1 4 slice printArray
    -82745267 print
    #dup -1 12 slice printArray
    -125136145 print
    #dup 4 cutIndex printArray -313123 print printArray
    -991749124 print
    #dup 3 split printArray -112414 print printArray
    -124151151 print
    #dup 16 split printArray -112414 print printArray
    -434262161 print
  printArray
end
