import io
using io
import debug

proc( -> ) =>: main
  i8 64 array new =:: mut: buff
  stdIn buff @  0 16 fread io.FILE_ERROR_NONE == assert "fread works" debug.print
  stdIn buff @ 16 32 fread io.FILE_ERR_END_OF_FILE == assert "EOF detection" debug.print

  stdOut "Hello World!" 0 5 fwrite io.FILE_ERROR_NONE == assert "fwrite works" debug.print
  stdOut "Hello World!" 6 5 fwrite io.FILE_ERROR_NONE == assert "fwrite works" debug.print
  "!" puts io.FILE_ERROR_NONE == assert "puts works"
  stdOut buff @ 0 45 fwrite io.FILE_ERROR_NONE == assert "fwrite works" debug.print
  stdOut '\n' fputc io.FILE_ERROR_NONE == assert "fputc works"
  "../lib" OPEN_WRITE fopenS io.FILE_ERR_FILE_IS_DIR == assert "open directory" =:: empty
  empty ( ) ptr cast! debug.print
  empty fclose io.FILE_ERR_INVALID_FILE == assert "fclose invalid"
  "./.io.out" OPEN_READ OPEN_WRITE | fopenS io.FILE_ERROR_NONE == assert "fopenS works" =:: file
  file "Written directly to file!\n" fputs io.FILE_ERROR_NONE == assert "fputs works"
  file fflush io.FILE_ERROR_NONE == assert "fflush works"
  file fclose io.FILE_ERROR_NONE == assert "fclose works"
  stdErr "printing to stderr" fputs io.FILE_ERROR_NONE == assert "fputs works"
  stdErr '\n' fputc io.FILE_ERROR_NONE == assert "fputc works"
  stdErr "non ASCII string: ä×√φ\U0001F4BB□\n" fputs io.FILE_ERROR_NONE == assert "fputs works"
end
