'stringBuilder' *import
'print' *import

proc( char8 : a char8 : b i32 : C -> i32 ) =>: cmp
  a i32 cast.u b i32 cast.u -
end

proc( -> ) =>: main
  "Hello, World!" sb.copyPtr
     char8 list cast cmp@ 0 list.sort stringBuilder cast
     '\n' sb.appendC
     $ sb.asStr io.print
   sb.free ..drop
end
