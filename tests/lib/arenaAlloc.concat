import arenaAlloc

0 =:: mut: valCount
0 =:: mut: valId
proc( -> i32 ) =>: newInt
  valCount 1 + valCount@ =
  valId
    $ 1 + valId@ =
  return
end
proc( i32 ptr : ignore -> ) =>: freeVal
  valCount 1 - valCount@ =
end

proc( -> ) =>: main
  1024 freeVal@ arenaAlloc.create =:: allocator
  newInt =:: anInt
  allocator
    anInt@ arenaAlloc.copyPtr ..drop
    newInt arenaAlloc.copyValue ..drop
    newInt arenaAlloc.copyValue ..drop
    newInt arenaAlloc.copyValue =:: a
    a [] 3 == "3 stored in a" assert
    newInt arenaAlloc.copyValue ..drop
    newInt arenaAlloc.copyValue ..drop
    $ arenaAlloc.offset =:: offset
    newInt arenaAlloc.copyValue =:: b
    b [] 6 == "6 stored in b" assert
    newInt arenaAlloc.copyValue ..drop
    newInt arenaAlloc.copyValue ..drop
    offset arenaAlloc.reset
    valCount 6 == "values at end of arena freed" assert
    newInt arenaAlloc.copyValue ..drop
    b [] 9 == "9 stored in b" assert
    3000 i32 mem.alloc i32 3000 ptr.mut cast! =:: largeArray
    3000:i64 for =:: i
      newInt largeArray i []=
    end
    largeArray arenaAlloc.copyPtrs ..drop
    largeArray mem.free
  arenaAlloc.free ..drop
  0 valCount == "all values freed" assert
end
