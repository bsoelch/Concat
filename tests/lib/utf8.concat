import unicode
import debug

proc( -> ) =>: main
  "ACBÄÖÜ°?ℂ💻!0\xc2\x80\xc1\xbf\xec\x3a\xf0" string.wrap =:: str
  str .length sb.create =:: mut: copy
  str 0:iSize while $ str .length u< do
    utf8.nextCodepoint ..dup i32 cast debug.print
    copy ..swap sb.appendCodepoint copy=
  end ..drop.2
  str copy sb.asStr string.eq debug.print
  copy sb.free ..drop
end
