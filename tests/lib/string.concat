import string
import io
import stringIO

proc( -> ) =>: main
  "Hello World!" string.wrap io.println
  "Hello World!" string.wrap "substring" string.wrap string.indexOfStr ? io.println
  "Hello World!" string.wrap 'o' string.contains io.println
  "This sentence will be split into Worlds!" string.wrap ' ' printSplit
end

proc( string : str char8 : chr -> ) =>: printSplit
  0 =:: mut: i
  str 
  while
    chr string.split printStr
    $ .length 0:iSize u>
  do end ..drop
end

proc( string : str -> ) =>: printStr
  io.stdOut str .data 0:iSize str .length io.fwrite ..drop.2
  io.stdOut  '\n' io.fputc ..drop
end

