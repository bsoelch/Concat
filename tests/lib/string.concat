#include string
#include io

entryPoint:
  "Hello World!" io.puts print

  
  "Hello World!" string.wrap "World" string.wrap  string.indexOfStr print
  "Hello World!" string.wrap "substring" string.wrap string.indexOfStr print
  "Hello World!" string.wrap 'o' string.contains print
  "This sentence will be split into Worlds!" string.wrap ' ' printSplit
end

proc( string : str i8 : chr => ) =: printSplit
  0 =:: mut i
  str 
  while
    chr string.split printStr
    #dup .length 0 >
  do end #drop
end

proc( string : str => ) =: printStr
  io.stdOut str .data 0 str .length io.fwrite #drop:2
  io.stdOut  '\n' io.fputc #drop
end

