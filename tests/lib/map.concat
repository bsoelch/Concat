import map
import optional

import io
import stringBuilder
import numbers/printInt
import print
using std.literals.

proc( i32 -> i32 ) =>: i32Hash end
proc( i32 i32 -> bool ) =>: i32Eq  == end

proc( i64 optional -> ) =>: printOpt
  .else
    "empty":s io.println
    return
  end
  char8 32 array : buf
  buf@ sb.wrapBuffer
    "optional(" sb.appendS
    >$ sb.appendI
    ")\n" sb.appendS
  sb.asStr io.print
end

proc( -> ) =>: main
  i32Hash@ i32Eq@ 16 i64 map.create =:: mut: myMap
  myMap@
    ..dup 0   1 map.put printOpt
    ..dup -5  2 map.put printOpt
    ..dup 2   3 map.put printOpt
    ..dup 11  4 map.put printOpt
    ..dup 11  5 map.put printOpt
    ..dup 2   6 map.put printOpt
    ..dup 42  7 map.put printOpt
    "-------------":s io.println
    ..dup 0   map.get printOpt
    ..dup -5  map.get printOpt
    ..dup 2   map.get printOpt
    ..dup 11  map.get printOpt
    ..dup 42  map.get printOpt
    ..dup 16  map.get printOpt
 map.free
end
