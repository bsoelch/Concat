proc( i64 -> bool ) =>: isZeroExtened
  0xffff'ffff:i64 ==
end
proc( i64 -> bool ) =>: isSignExtened
  -1:i64 ==
end

proc( bool : c -> ) =>: checkSignMerge
  c if 0x7fff_ffff ..?types else -1 ..?types end ..?types ..drop
  c if 0xffff_ffff ..?types else -1 ..?types end ..?types ..drop
end

proc( -> ) =>: main
  -1 ..?types isSignExtened "-1 is sign extended" assert
  0xffff'ffff ..?types isZeroExtened "0xffff'ffff is zero extended" assert
  true checkSignMerge
end
