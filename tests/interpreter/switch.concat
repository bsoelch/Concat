proc( char8 -> bool ) =>: isSpace
  switch
    '\x00' case break
    ' ' '\n' '\t' '\v' '\f' '\r' case true return
  end
  false return
end
'A' isSpace ! "A is not space" assert
' ' isSpace "' ' is space" assert
'\n' isSpace "'\n' is space" assert

proc( i64 -> bool ) =>: isFermatPrime
  switch
    3     case true break
    5     case true break
    17    case true break
    257   case true break
    65537 case true break
    default   false break
  end return
end
42 isFermatPrime ! "42 is not a Fermat prime" assert
2381 isFermatPrime ! "42 is not a Fermat prime" assert
17 isFermatPrime "42 is a Fermat prime" assert

enum( A B C ) =:: anEnum
proc( anEnum -> bool ) =>: isA
  switch
    A case true return
    B C case false return
  end
end
anEnum .A isA "A is A" assert
anEnum .B isA ! "B is not A" assert
anEnum .C isA ! "C is not A" assert

union( i32 : integer f32 : float ) =:: number
proc( number -> bool ) =>: isInteger
  switch
    integer case true return
    float case false return
  end
end
0 number .integer isInteger "int(0) is int" assert
1 number .integer isInteger "int(1) is int" assert
0 number .float isInteger ! "float is not int" assert

proc( -> ) =>: main end
