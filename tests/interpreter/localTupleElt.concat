proc( ( i32 i32 ) -> ( i32 i32 ) ) =>: test
  =:: mut: a
  11 a@ .0=
  -1283 a@ .1=
  a return
end

proc( -> ) =>: main
  ( i32 ( i32 i32 ) ) : y
  42 y@ .0=
  y .0 42 == "y.0 == 42" assert
  197 16 ( i32 i32 ) new =:: mut: y1
  y1 y@ .1=
  y .1 .0 197 ==  "y.1.0 == 197" assert
  y .1 test y@ .1=
  y .1 .1 -1283 ==  "y.1.1 == -1283" assert
  117 y@ .1 .0=
  y .1 .0 117 ==  "y.1.0 == 117" assert
  y .1 .1 -1283 ==  "y.1.1 == -1283" assert
  1 y@ .0 =[]
  5 y@ .1 .0 =[]
  y .0 1 == "y.0 == 1" assert
  y .1 .0 5 ==  "y.1.0 == 5" assert
end
main ## run main at compile time
