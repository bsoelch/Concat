proc( i32 : n -> bool ) =>: isPrime
  n 2 ..u< if false return end
  2 while $ $ * n ..u<= do
    n $1 ..umod ? ! if ..drop
      false return
    end
  finally 1 + end ..drop
  true return
end
1 isPrime ! "one is not prime" assert
2 isPrime "two is prime" assert
3 isPrime "three is prime" assert
4 isPrime ! "four is not prime" assert
243 isPrime ! "243 is not prime" assert
2381 isPrime "2381 is prime" assert

proc( -> ) =>: main end
