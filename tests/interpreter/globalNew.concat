import debug
struct( i32 : x i32 : y ) =:: Point

1 2 Point new =:: p

42 Point ptr.raw cast! 5 ( Point ptr.raw : data i64 : length ) new =:: sizedPointer

proc( -> ) =>: main
  p .x debug.print
  p .y debug.print
  sys.argc i32 cast 5 Point new =:: dynamicPoint
  dynamicPoint .x debug.print
  dynamicPoint .y debug.print
  sizedPointer .data debug.print
  sizedPointer .length debug.print
end
