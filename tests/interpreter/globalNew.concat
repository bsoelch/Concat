struct( i32 : x i32 : y ) =:: Point

1 2 Point new =:: p

42 Point ptr.raw cast! 5 ( Point ptr.raw : data i64 : length ) new =:: sizedPointer

proc( -> ) =>: main
  p .x 1 == "p.x" assert
  p .y 2 == "p.y" assert
  sys.argc i32 cast 5 Point new =:: dynamicPoint
  dynamicPoint .x 1 == "dp.x" assert
  dynamicPoint .y 5 == "dp.y" assert
  sizedPointer .data i64 cast! 0x2A == "sp.data" assert
  sizedPointer .length 5 == "sp.len" assert
end
