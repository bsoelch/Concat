import future/int
import print
proc( int : x -> ) =>: printInt
  0 sb.create
    x int.sbAppendX
    $ sb.asStr io.println
  sb.free ..drop
end
proc( -> ) =>: export: main
  { 0x0123456789abcdef:i64 0xfedcba9876543210:i64 0x0123456789abcdef:i64 } slice.wrap false int.fromSlice =:: a
  { 0xfedcba9876543210:i64 0x0123456789abcdef:i64 0xfedcba9876543210:i64 } slice.wrap true int.fromSlice =:: b
  a int.copy printInt
  b int.copy printInt
  a b int.mul printInt
end
