import future/float
import print

proc( float -> ) =>: printFloatX
  0 sb.create
    >$ float.sbAppendX
    $ sb.asStr io.println
  sb.free ..drop
end
proc( -> ) =>: main
  "-0b1'001000":s 0 int.parse .Ok <unwrap> -6:iSize float.Precission.INFINITE float.create printFloatX
  "-0b1'001001":s 0 int.parse .Ok <unwrap> -6:iSize float.Precission.INFINITE float.create printFloatX
  "-0b1'001010":s 0 int.parse .Ok <unwrap> -6:iSize float.Precission.INFINITE float.create printFloatX
