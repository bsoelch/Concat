  "-0b1'001110":s 0 int.parse .Ok <unwrap> -6:iSize float.Precission.INFINITE float.create printFloatX
  "-0b1'001111":s 0 int.parse .Ok <unwrap> -6:iSize float.Precission.INFINITE float.create printFloatX
