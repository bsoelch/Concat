proc( bool : a bool : b => bool ) =: AND
  a if b _if
    true
  else
    false
  end
end

proc( bool : a bool : b bool : c bool : d => i32 ) =: COUNT
  a if b _if c _if
    3
  else b _if c _if d _if
    3
  else a _if b _if
    2
  else b _if c _if
    2
  else c _if d _if
    2
  else a b | c d | | _if
    1
  else
    0
  end
end

proc( bool : x bool : a bool : b => bool ) =: INVIF
  x
    a if b _if ! end
  return
end

entryPoint:
  false false AND ..debug.print
  false true  AND ..debug.print
  true  false AND ..debug.print
  true  true  AND ..debug.print
  true  true  true  false COUNT ..debug.print
  true  true  false true  COUNT ..debug.print
  true  false true  true  COUNT ..debug.print
  true  false true  false COUNT ..debug.print
  false false false false COUNT ..debug.print
  true  true  false INVIF ..debug.print
  true  false true  INVIF ..debug.print
  true  true  true  INVIF ..debug.print
  false true  false INVIF ..debug.print
end
