'print' *import
union( _ : A _ : B i32 : C char8 : D ) =:: anUnion

proc( i32 : i anUnion : e char8 : c -> ) =>: switchTest
  i switch
    1 2 case
      return ## not needed when branch ends with return
    3 case
      break
    0 case
      false if return else break end
      break
    -1 case
      return break ## optional break allowed after return
    default ## the last branch does not need a break
  end
  e switch
    A B case
      break
    C case
      e ..raw .C io.println
      break
    D case
      e ..raw .D io.println
      break
  end
  c switch ## switch character
  ' ' '\n' '\t' '\v' '\f' '\r' case
    true
    break
  default
    false
    break
  end =:: isSpace
  isSpace io.println
end

proc( -> ) =>: main
 0 anUnion .A 'A' switchTest
 1 'A' anUnion .D  '\n' switchTest
 0xabcdef  0x12345678 anUnion .C  ' ' switchTest
end
