enum( A B i32 : C i8 : D ) =:: anEnum

proc( i32 : i anEnum : e i8 : c -> ) =>: switchTest
  i switch
    1 2 case
      return ## not needed when branch ends with return
    3 case
      break
    0 case
      false if return else break end
      break
    -1 case
      return break ## optional break allowed after return
    default ## the last branch does not need a break
  end
  e switch
    A B case
      break
    C case
      e .C ..debug.print
      break
    D case
      e .D ..debug.print
      break
  end
  c switch ## switch character
  ' ' '\n' '\t' '\v' '\f' '\r' case
    true
    break
  default
    false
    break
  end =:: isSpace
  isSpace ..debug.print
end

proc( -> ) =>: main
 0 anEnum .A 'A' switchTest
 1 'A' anEnum .D  '\n' switchTest
 0xabcdef  0x12345678 anEnum .C  ' ' switchTest
end
