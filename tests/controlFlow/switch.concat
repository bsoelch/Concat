enum( A B i32 : C i8 : D ) =:: anEnum

proc( i32 : i anEnum : e i8 : c -> ) =>: switchTest
  i switch
    1 2 case
      return
    3 case
      break
    0 case
      false if return else break end
      ## break is not needed if all branches terminate
    -1 case
      false if break else break end
      break ## break is allowed if all branches terminate
    default
  end
  e switch 
    A B case
      break
    C case
      e .C ..debug.print
      break
    D case
      e .D ..debug.print
      break
  end
  c switch ## switch character
  ' ' '\n' '\t' '\v' '\f' '\r' case
    true
    break
  default
    false
  end =:: isSpace
  isSpace ..debug.print
end

proc( -> ) =>: main
 0 anEnum .A 'A' switchTest
 1 'A' anEnum .D  '\n' switchTest
 0xabcdef  0x12345678 anEnum .C  ' ' switchTest
end
