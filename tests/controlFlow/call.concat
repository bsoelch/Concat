import debug

proc( i32 i32 -> i32 i32 ) =>: divMod
  ..over ..over % =:: mod / mod return
end

proc( i32 i32 -> i32 2 array ) =>: array2
  i32 2 array new =:: mut: data
    data@ 1 =[]
    data@ 0 =[]
  data return
end

proc( i64 i64 i64 i64 -> i64 4 array ) =>: array4
  i64 4 array new =:: mut: data
    data@ 3 =[]
    data@ 2 =[]
    data@ 1 =[]
    data@ 0 =[]
  data return
end

proc( i32 : a i32 : b -> i32 ) =>: cmp
  a b > if 1 else a b < _if -1 else 0 end
end

proc( i32 : ignore -> ) =>: consume end


struct( i64 : length char8 ptr.raw : data ) =:: String
proc( i64 : auto: k char8 k ptr : str -> String i64 ) =>: startItr
  k str String new 0
end
proc( String i64 -> String i64 char8 bool ) =>: nextChar
  =:: i
  =:: s
  s
    i s .length >= if
      i '\x00'  false return
    end
    i 1 +  s .data i [] true return
end
proc( String i64 char8 -> ) =>: endItr
  ..drop ..drop ..drop
end

union( i32 : a i32 : b ) =:: U
proc( i32 -> U ) =>: unionCreate
  U .a return
end

proc( -> ) =>: main
  1234 consume
  43 17 divMod ..swap debug.print debug.print
  5 7 cmp debug.print
  1 2 array2 =:: A
  A@ 0 [] debug.print
  A@ 1 [] debug.print
  1 2 3 4 array4 =:: B
  B@ 0 [] debug.print
  B@ 1 [] debug.print
  B@ 2 [] debug.print
  B@ 3 [] debug.print
  "Hello" startItr while nextChar do
    #+char+# debug.print
  end endItr
  42 unionCreate .a debug.print
end
