proc( char8 -> bool ) =>: check
  switch
    'h' case
      break
    'o' case
      break
    'p' case
      break
    't' case
      break
    'l' case
      break
    'e' case
      break
    'W' case
      break
    'X' case
      break
    'q' case
      break
    default
      false return
  end
  true return
end

proc( -> ) =>: main
  'n' check ! "n" assert
  'o' check "o" assert
  'p' check "p" assert
  'q' check "q" assert
  'r' check ! "r" assert
  's' check ! "s" assert
  't' check "t" assert
  'u' check ! "u" assert
end
