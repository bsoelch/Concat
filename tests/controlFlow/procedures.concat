import print
proc( i32 : a i32 : b -> i32 i32 ) =>: proc0
  doNothing
  b a return
end
proc( i32 : x i32 : y -> ) =>: argTest
end
proc( -> ) =>: doNothing
  return
end 

proc( -> ) =>: main
  proc0@ =:: fct
  1 2 fct () io.println io.println
  1 2 proc0 doNothing proc0 io.println io.println
  2 3 argTest
end
