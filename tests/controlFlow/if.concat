import debug

proc( bool : f bool : t i32 : one i32 : two -> ) =>: test
  t if 
    1 debug.print
  end
  f if 
    0 debug.print
  else 
    1 debug.print
  end
  1 one + 2 == if 
    1 debug.print
  else 2 two * 4 != _if
    0 debug.print
  end
  1 1 + two == if 
    1 debug.print
  else 2 two * 4 == _if
    0 debug.print
  else
    0 debug.print
  end
  f if else f _if else f _if else f _if else f _if else f _if else f _if else f _if end
  f if else f _if else f _if else f _if else f _if else f _if else f _if else f _if else end
  42 ## push value through if statements 
  t if 
    1 debug.print
  end
  f if 
    0 debug.print
  else 
    1 debug.print
  end
  1 1 + two == if 
    1 debug.print
  else 2 2 * 4 != _if
    0 debug.print
  end
  1 one + 2 == if 
    1 debug.print
  else 2 two * 4 == _if
    0 debug.print
  else
    0 debug.print
  end
  f if else f _if else f _if else f _if else f _if else f _if else f _if else f _if end
  f if else f _if else f _if else f _if else f _if else f _if else f _if else f _if else end
  debug.print
  ## return value from if statements 
  f if 
    0 debug.print 2
  else 
    1 debug.print 3
  end 
  debug.print
  1 one + 2 == if 
    1 debug.print 4 
  else 5 2 2 * 4 != _if
    0 debug.print
  end
  debug.print
  one 1 + 2 == if 
    1 debug.print 6
  else 2 two * 4 == _if
    0 debug.print 7
  else
    0 debug.print 8
  end debug.print
  f if 9 else 11 f _if else f _if else f _if else f _if else f _if else f _if else f _if end debug.print
  f if 10 else 12 f _if else f _if else f _if else f _if else f _if else f _if else f _if else end debug.print
  ##push value in if-statement
  1 f if 
    0 debug.print debug.print
  else 
    1 debug.print debug.print
  end
  
  2 1 1 + two == if 
    1 debug.print debug.print
  else 2 two * 4 == _if
    0 debug.print debug.print
  else
    0 debug.print debug.print
  end
  3 f if debug.print else debug.print f _if else f _if else f _if else f _if else f _if else f _if else f _if end
  4 f if debug.print else f _if debug.print else debug.print f _if else f _if else f _if else f _if else f _if else f _if else end
end
proc( -> ) =>: main
  false true 1 2 test
end
