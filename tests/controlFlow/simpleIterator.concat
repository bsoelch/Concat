'string' *import
'print' *import

proc( iSize : auto: k char8 k ptr : str -> string iSize ) =>: startItr
  str string.wrap 0:iSize
end
proc( string iSize -> string iSize char8 bool ) =>: nextChar
  =:: i
  =:: s
  s
    i s .length u>= if
      i '\x00'  false return
    end
    i 1:iSize +  s i string.charAt true return
end
proc( string iSize char8 -> ) =>: endItr
  ..drop ..drop ..drop
end

proc( -> ) =>: main
  "Hello" startItr while nextChar do
    #+char+# io.println
  end endItr
end
