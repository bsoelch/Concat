#include string

proc( i64 : static k i8 k ptr : str => string2 i64 ) =: startItr
  str k string.create 0
end
proc( string2 i64 => string2 i64 char bool ) =: nextChar
  =:: i
  =:: s
  s
    i s .length >= if
      i '\x00'  false return
    end
    i 1 +  s i string.charAt true return
end
proc( string2 i64 i8 => ) =: endItr
  #drop #drop #drop
end

entryPoint:
  "Hello" startItr while nextChar do
    #+char+# print
  end endItr
end
