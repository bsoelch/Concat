import string
import debug

proc( i64 : auto: k char8 k ptr : str -> string i64 ) =>: startItr
  str string.wrap 0
end
proc( string i64 -> string i64 char8 bool ) =>: nextChar
  =:: i
  =:: s
  s
    i s .length >= if
      i '\x00'  false return
    end
    i 1 +  s i string.charAt true return
end
proc( string i64 char8 -> ) =>: endItr
  ..drop ..drop ..drop
end

proc( -> ) =>: main
  "Hello" startItr while nextChar do
    #+char+# debug.print
  end endItr
end
