union(
  i32 : Int
  f32 : Float
) =:: aUnion

proc( aUnion ptr : u -> f64 ) =>: ptrRead
  u .Int .if
    [] f64 cast
  else .Float ._if
    [] f64 cast
  else ..unreachable end  
end
proc( -> ) =>: main
  3 aUnion .Int =:: ui
  2.5:f32 aUnion .Float =:: uf
  ## read unionElement pointer
  ui@ ptrRead 3 == "read 3" assert
  uf@ ptrRead 2.5 == "read 2.5" assert
  ## write to unionElement pointer
  3.14:f32 aUnion .Float =:: mut: um
  um@ .Float .if
   5 >$ =[]
  else ..drop end
  um@ ptrRead 5 == "read 5" assert
end
