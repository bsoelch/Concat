import mem
proc( iSize : auto: k char8 k ptr : p -> char8 k ptr ) =>: strDup
  k char8 mem.alloc =:: M
  M p k mem.copy char8 k ptr cast! return
end

proc( -> ) =>: main
  "Test"
    $ =:: src
  strDup =:: copy
  src copy != "strDup changed address" assert
  0:iSize while $ src ..length u< do =:: i
    src i [] copy i [] == "copy success full" assert
  finally i 1:iSize + end ..drop
end
