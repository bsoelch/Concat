import mem
proc( i64 : auto: k char8 k ptr : p -> char8 k ptr ) =>: strDup
  k char8 mem.alloc =:: M
  M p k mem.copy char8 k ptr cast! return
end

proc( -> ) =>: main
  "Test"
    $ =:: src
  strDup =:: copy
  src copy != "strDup changed address" assert
  0:i64 while $ src ..length < do =:: i
    src i [] copy i [] == "copy success full" assert
  finally i 1 + end ..drop
end
