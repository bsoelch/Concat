enum( A B C ) =:: E

proc( -> ) =>: main
  E .A .A:? "E .A .A exists" assert
  E .A .C:? "E .A .C exists" assert
  E .A .D:? ! "E .A .D does not exist" assert
  E .A:? "E .A exists" assert
  E .D:? ! "E .D does not exist" assert
  E:? "E exists" assert
  ThisDoesNotExist:? ! "ThisDoesNotExist" assert
  i32:? "i32 exists" assert
end
main:? "main exists" assert
