
proc( f64 -> i8 ) =>: inline.never: castI8
  i8 cast
end
proc( f64 -> i8 ) =>: inline.never: castU8
  i8 cast.u
end
proc( f64 -> i16 ) =>: inline.never: castI16
  i16 cast
end
proc( f64 -> i32 ) =>: inline.never: castI32
  i32 cast
end
proc( f64 -> i32 ) =>: inline.never: castU32
  i32 cast.u
end
proc( f64 -> i64 ) =>: inline.never: castI64
  i64 cast
end
proc( f64 -> i64 ) =>: inline.never: castU64
  i64 cast.u
end

proc( -> ) =>: main
  ## runtime evaluation
  1e10   castI8 127:i8 == assert "1e10 -> 127:i8"
  1e10   castU8 255:i8 == assert "1e10 -> 255:i8"
  -1e400 castI8 -128:i8 == assert "-1e400 -> -128:i8"
  240.0  castU8 240:i8 == assert "240.0 -> 240:i8"
  1e100  castI32 0x7fff_ffff:i32 == assert "1e100 -> 0x7fff_ffff:i32"
  1e100  castU32 0xffff_ffff:i32 == assert "1e100 -> 0xffff_ffff:i32"
  -1e100 castI16 -0x8000:i16 == assert "-1e100 -> -0x8000:i16"
  1e18   castI64 1'000'000'000'000'000'000 == assert "1e18 -> 1'000'000'000'000'000'000"
  1e19   castI64 0x7fff'ffff'ffff'ffff == assert "1e19 -> 0x7fff'ffff'ffff'ffff"
  -1.0   castU64 0:i64 == assert "-1.0 -> 0:i64"
  ## constant folding
  1e10   i8 cast 127:i8 == assert "1e10 -> 127:i8"
  1e10   i8 cast.u 255:i8 == assert "1e10 -> 255:i8"
  -1e400 i8 cast -128:i8 == assert "-1e400 -> -128:i8"
  240.0  i8 cast.u 240:i8 == assert "240.0 -> 240:i8"
  1e100  i32 cast 0x7fff_ffff:i32 == assert "1e100 -> 0x7fff_ffff:i32"
  1e100  i32 cast.u 0xffff_ffff:i32 == assert "1e100 -> 0xffff_ffff:i32"
  -1e100 i16 cast -0x8000:i16 == assert "-1e100 -> -0x8000:i32"
  1e18   i64 cast 1'000'000'000'000'000'000 == assert "1e18 -> 1'000'000'000'000'000'000"
  1e19   i64 cast 0x7fff'ffff'ffff'ffff == assert "1e19 -> 0x7fff'ffff'ffff'ffff"
  -1.0   i64 cast.u 0:i64 == assert "-1.0 -> 0:i64"
end
