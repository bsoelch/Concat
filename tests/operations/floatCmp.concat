proc( -> ) =>: main
  f32.NaN f32.Infinity <=> 1 == assert "NaN > Infinity"
  f32.NaN f32.NaN <=> 0 == assert "NaN == NaN"
  f32.NaN -_ f32.NaN <=> -1 == assert "-NaN < NaN"
  f32.NaN -_ f32.NaN -_ <=> 0 == assert "-NaN == -NaN"
  f32.NaN 3 <=> 1 == assert "NaN > 3"
  1:f32 42:f32 <=> -1 == assert "1 < 42"
  -0:f32 -0:f32 <=> 0 == assert "-0 == -0"
  -0:f32 0:f32 <=> -1 == assert "-0 < 0"
   0:f32 0:f32 <=> 0 == assert "0 == 0"
  -5:f32 7:f32 <=> -1 == assert "-5 < 7"
  -5:f32 -7:f32 <=> 1 == assert "-5 > -7"
  -5:f32 f32.-Infinity <=> 1 == assert "-5 > -Infinity"
  f32.MAX f32.Infinity <=> -1 == assert "f32.MAX < Infinity"
  f32.MIN f32.-Infinity <=> 1 == assert "f32.MIN > -Infinity"
  f32.Infinity f32.-Infinity <=> 1 == assert "Infinity > -Infinity"
  f32.-Infinity f32.-Infinity <=> 0 == assert "-Infinity == -Infinity"
  f32.-Infinity f32.NaN -_ <=> 1 == assert "-Infinity > -NaN"
  
  f64.NaN f64.Infinity <=> 1 == assert "NaN > Infinity"
  f64.NaN f64.NaN <=> 0 == assert "NaN == NaN"
  f64.NaN -_ f64.NaN <=> -1 == assert "-NaN < NaN"
  f64.NaN -_ f64.NaN -_ <=> 0 == assert "-NaN == -NaN"
  f64.NaN 3 <=> 1 == assert "NaN > 3"
  3.4:f64 3.5:f64 <=> -1 == assert "3.4 < 3.5"
  -0:f64 -0:f64 <=> 0 == assert "-0 == -0"
  -0:f64 0:f64 <=> -1 == assert "-0 < 0"
   0:f64 0:f64 <=> 0 == assert "0 == 0"
  -4:f64 12.375:f64 <=> -1 == assert "-4 < 12.375"
  -3.99999:f64 -4:f64 <=> 1 == assert "-3.99999 > -4"
  -117:f64 f64.-Infinity <=> 1 == assert "-117 > -Infinity"
  f64.MAX f64.Infinity <=> -1 == assert "f64.MAX < Infinity"
  f64.MIN f64.-Infinity <=> 1 == assert "f64.MIN > -Infinity"
  f64.Infinity f64.-Infinity <=> 1 == assert "Infinity > -Infinity"
  f64.-Infinity f64.-Infinity <=> 0 == assert "-Infinity == -Infinity"
  f64.-Infinity f64.NaN -_ <=> 1 == assert "-Infinity > -NaN"
end
