proc( -> ) =>: main
  f32.NaN f32.Infinity <=> 1 == "NaN > Infinity" assert
  f32.NaN f32.NaN <=> 0 == "NaN == NaN" assert
  f32.NaN -_ f32.NaN <=> -1 == "-NaN < NaN" assert
  f32.NaN -_ f32.NaN -_ <=> 0 == "-NaN == -NaN" assert
  f32.NaN 3 <=> 1 == "NaN > 3" assert
  1:f32 42:f32 <=> -1 == "1 < 42" assert
  -0:f32 -0:f32 <=> 0 == "-0 == -0" assert
  -0:f32 0:f32 <=> -1 == "-0 < 0" assert
   0:f32 0:f32 <=> 0 == "0 == 0" assert
  -5:f32 7:f32 <=> -1 == "-5 < 7" assert
  -5:f32 -7:f32 <=> 1 == "-5 > -7" assert
  -5:f32 f32.-Infinity <=> 1 == "-5 > -Infinity" assert
  f32.MAX f32.Infinity <=> -1 == "f32.MAX < Infinity" assert
  f32.MIN f32.-Infinity <=> 1 == "f32.MIN > -Infinity" assert
  f32.Infinity f32.-Infinity <=> 1 == "Infinity > -Infinity" assert
  f32.-Infinity f32.-Infinity <=> 0 == "-Infinity == -Infinity" assert
  f32.-Infinity f32.NaN -_ <=> 1 == "-Infinity > -NaN" assert
  
  f64.NaN f64.Infinity <=> 1 == "NaN > Infinity" assert
  f64.NaN f64.NaN <=> 0 == "NaN == NaN" assert
  f64.NaN -_ f64.NaN <=> -1 == "-NaN < NaN" assert
  f64.NaN -_ f64.NaN -_ <=> 0 == "-NaN == -NaN" assert
  f64.NaN 3 <=> 1 == "NaN > 3" assert
  3.4:f64 3.5:f64 <=> -1 == "3.4 < 3.5" assert
  -0:f64 -0:f64 <=> 0 == "-0 == -0" assert
  -0:f64 0:f64 <=> -1 == "-0 < 0" assert
   0:f64 0:f64 <=> 0 == "0 == 0" assert
  -4:f64 12.375:f64 <=> -1 == "-4 < 12.375" assert
  -3.99999:f64 -4:f64 <=> 1 == "-3.99999 > -4" assert
  -117:f64 f64.-Infinity <=> 1 == "-117 > -Infinity" assert
  f64.MAX f64.Infinity <=> -1 == "f64.MAX < Infinity" assert
  f64.MIN f64.-Infinity <=> 1 == "f64.MIN > -Infinity" assert
  f64.Infinity f64.-Infinity <=> 1 == "Infinity > -Infinity" assert
  f64.-Infinity f64.-Infinity <=> 0 == "-Infinity == -Infinity" assert
  f64.-Infinity f64.NaN -_ <=> 1 == "-Infinity > -NaN" assert
end
