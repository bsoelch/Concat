i32 =:: Label

( char8 ptr.raw iSize -> Label ) : static: alias: :Label ..builtIn.parse.i32
namespace: Label
  proc( Label Label -> Label ) : alias: and  i32.and
  proc( Label Label -> Label ) : alias: or   i32.or
  proc( Label Label -> Label ) : alias: xor  i32.xor
  proc( Label -> Label ) : alias: flip i32.flip
  proc( Label -> bool ) : alias: toBool i32.toBool
end

proc( -> ) =>: main
  1:Label 2:Label Label.or i32 cast 3 == "1|2==3" assert
  1:Label Label.toBool "1 toBool" assert
  0:Label Label.toBool ! "0 toBool !" assert
end
