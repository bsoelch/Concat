"A" =:: s1
"A string" =:: s2

proc( => ) =: main
  ..compiler.parser.find.s2
  s3 ..length ..debug.print
  specialString ..length ..debug.print
  0 while #dup specialString ..length < do
    specialString #over [] ..debug.print
    1 +
  end #drop
  multiLine ..length ..debug.print
  0 while #dup multiLine ..length < do
    multiLine #over [] ..debug.print
    1 +
  end #drop
end

"string" =:: s3
"strings can contain other strings as substring" =:: s4
"\"'\\\u2203\U0001F4BB\t² \x00##" =:: specialString
"Multi
 line
 String" =:: multiLine

