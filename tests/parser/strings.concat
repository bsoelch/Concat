import debug
"A" =:: str1
"A string" =:: str2

proc( -> ) =>: main
  ..?parser.find.str2
  str3 ..length debug.print
  specialString ..length debug.print
  0:i64 while ..dup specialString ..length < do
    specialString ..over [] debug.print
    1 +
  end ..drop
  multiLine ..length debug.print
  0:i64 while ..dup multiLine ..length < do
    multiLine ..over [] debug.print
    1 +
  end ..drop
end

"string" =:: str3
"strings can contain other strings as substring" =:: s4
