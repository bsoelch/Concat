"A" =:: s1
"A string" =:: s2

entryPoint:
  #find s2
  s3 ..length print
  specialString ..length print
  0 while #dup specialString ..length < do
    specialString #over [] print
    1 +
  end #drop
  multiLine ..length print
  0 while #dup multiLine ..length < do
    multiLine #over [] print
    1 +
  end #drop
end

"string" =:: s3
"strings can contain other strings as substring" =:: s4
"\"'\\\u2203\U0001F4BB\t² \x00##" =:: specialString
"Multi
