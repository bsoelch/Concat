'print' *import
"A" =:: str1
"A string" =:: str2

proc( -> ) =>: main
  ..?find.str2
  str3 ..length io.println
  specialString ..length io.println
  0:iSize while ..dup specialString ..length u< do
    specialString ..over [] i32 cast.u io.println
    1:iSize +
  end ..drop
  multiLine ..length io.println
  0:iSize while ..dup multiLine ..length u< do
    multiLine ..over [] i32 cast.u io.println
    1:iSize +
  end ..drop
end

"string" =:: str3
"strings can contain other strings as substring" =:: s4
"\"'\\\u2203\U0001F4BB\t² \x00##" =:: specialString
"Multi
 line
 String" =:: multiLine

