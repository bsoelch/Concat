( type : T -> type ) =>: slice
  struct(
    T _ ptr : data
    i64 : length
  )
end
namespace: slice
  ( type : T -> T slice ) =>: empty
    { { } : data 0 : length }
  end
end

char8 slice =:: string

namespace: string
  { "" : data 0 : length } string =: empty
end

proc( -> ) =>: main
  string.empty ..?stack .length 0 == "empty.length==0" assert
  i32 slice.empty ..?stack .length 0 == "empty.length==0" assert
end
