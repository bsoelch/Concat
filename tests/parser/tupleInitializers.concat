( type : T -> type ) =>: slice2
  struct(
    T ptr.raw : data
    i64 : length
  )
end
namespace: slice2
  ( type : T -> T slice2 ) =>: empty
    { { } : data 0 : length }
  end
end

char8 slice2 =:: string

namespace: string
  { "" : data 0 : length } string =: empty
end

proc( -> ) =>: main
  string.empty ..?stack .length 0 == "empty.length==0" assert
  i32 slice2.empty ..?stack .length 0 == "empty.length==0" assert
end
