true =:: _BIG_ENDIAN_
struct(
  _BIG_ENDIAN_ if
    i64 : mut: hi
    i64 : mut: low
  else
    i64 : mut: low
    i64 : mut: hi
  end
) =:: i128

_BIG_ENDIAN_ if
  proc( i64 -> i64 ) =>: hton
  end
  proc( i64 i64 -> i128 ) =>: createI128
    ..swap i128 new
  end
else
  proc( i64 -> i64 ) =>: hton
    =:: mut: x
      x 0xffff_ffff:i64 & 32 << x 32 >>> 0xffff_ffff:i64 & | x=
      x 0xffff_0000_ffff:i64 & 16 << x 16 >>> 0xffff_0000_ffff:i64 & | x=
      x 0x00ff_00ff_00ff_00ff:i64 & 8 << x 8 >>> 0x00ff_00ff_00ff_00ff:i64 & | x=
    x return
  end
  proc( i64 i64 -> i128 ) =>: createI128
    i128 new
  end
end

proc( -> ) =>: main
  0x123456789abcdef hton 0x123456789abcdef == "hton" assert
  1 2 createI128 =:: i
  i .hi 2 == "<low> <hi> createI128" assert
  i .low 1 == "<low> <hi> createI128" assert
  i@ i64 ptr.raw cast! =:: p
  p 0 [] 2 == "i128 {hi,low}" assert
  p 1 [] 1 == "i128 {hi,low}" assert
end
