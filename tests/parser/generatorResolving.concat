#:if:exp
( type : T -> type ) =>: box
  T ptr mut
end
proc( type : auto: T T box : a T box : b T box : out -> ) =>: boxAdd
  a [] b [] + out [] =
end
#:else
#template type : T #end
T ptr mut =:: box

#template type : T #end
proc( T box : a T box : b T box : out -> ) =>: boxAdd
  a [] b [] + out [] =
end
#:end

proc( -> ) =>: main
  1 =:: mut: one
  2 =:: mut: two
  i32 : mut: res
  ## boxAdd
    one @ i32 box cast
    two @ i32 box cast 
    res @ i32 box cast
  boxAdd
  res ..debug.print
end
