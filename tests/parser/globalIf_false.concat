false =:: _BIG_ENDIAN_
struct(
  _BIG_ENDIAN_ if
    i64 : mut: hi
    i64 : mut: low
  else
    i64 : mut: low
    i64 : mut: hi
  end
) =:: bits128

_BIG_ENDIAN_ if
  proc( i64 -> i64 ) =>: export: hton
  end
  proc( i64 i64 -> bits128 ) =>: export: create128
    ..swap bits128 new
  end
else
  proc( i64 -> i64 ) =>: export: hton
    =:: mut: x
      x 0xffff_ffff:i64 & 32 << x 32 >>> 0xffff_ffff:i64 & | x=
      x 0xffff_0000_ffff:i64 & 16 << x 16 >>> 0xffff_0000_ffff:i64 & | x=
      x 0x00ff_00ff_00ff_00ff:i64 & 8 << x 8 >>> 0x00ff_00ff_00ff_00ff:i64 & | x=
    x return
  end
  proc( i64 i64 -> bits128 ) =>: export: create128
    bits128 new
  end
end

proc( -> ) =>: main
  0x123456789abcdef hton 0xefcdab8967452301:i64 == "hton" assert
  1 2 create128 =:: i
  i .hi 2 == "<low> <hi> create128" assert
  i .low 1 == "<low> <hi> create128" assert
  i@ i64 ptr.raw cast! =:: p
  p 0 [] 1 == "bits128 {low,hi}" assert
  p 1 [] 2 == "bits128 {low,hi}" assert
end
