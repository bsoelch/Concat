proc( bool : x bool : y  bool : z -> ) =>: inline.never: test
  x and 0 =:: a1 y and 1 =:: a2 z if
    a1 a2
  else
    a1 a2
  end ..drop.2
  a1 a2 ..drop.2
  x and 0 =:: b1 y or 1 =:: b2 z if
    b1 b2
  else
    b1 b2
  end ..drop.2
  b1 b2 ..drop.2
  x or 0 =:: c1 y and 1 =:: c2 z if
    c1 c2
  else
    c1 c2
  end ..drop.2
  c1 c2 ..drop.2
  x and 0 =:: d1 y and 1 =:: d2 z if
    d1 d2
  else
    d1 d2
  end ..drop.2
  d1 d2 ..drop.2
end
proc( -> ) =>: main
  true false true test
end
