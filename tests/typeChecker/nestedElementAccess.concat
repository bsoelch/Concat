union( i32 : I f32 : F ) =:: aUnion
proc( -> ) =>: main
  1 2 3 ( i32 i32 ) new ( i32 ( i32 i32 ) ) new =:: mut: x
  x..1@ =:: eltPtr
  eltPtr x@ .1 == "x..1@" assert
  x .1.0 =:: y
  y 2 == "y" assert
  4 x .1.1= x=
  5 x..1.0=
  x..1.0 5 == "x.1.0" assert
  x..1.1 4 == "x.1.1" assert
  0 aUnion .I 1 aUnion .F ( aUnion : a aUnion : b ) new =:: mut: u
  u..a.I .and 0 == end "u.a.I" assert
  2 u..a.I=
  3 u..b.I=
  u..b.I .and 3 == end "u.b.I" assert
end
