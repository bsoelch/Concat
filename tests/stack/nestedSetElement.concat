proc( -> ) =>: main
  0 0 ( i32 i32 ) new 0 0 ( i32 i32 ) new ( ( i32 i32 ) ( i32 i32 ) ) new
    $ .0
      1 >$ .0=
      2 >$ .1=
    >$ .0=
    $ .1
      3 >$ .0=
      4 >$ .1=
    >$ .1=
  =:: x
  x .0 .0 1 == "x .0 .0 1 ==" assert
  x .0 .1 2 == "x .0 .1 2 ==" assert
  x .1 .0 3 == "x .1 .0 3 ==" assert
  x .1 .1 4 == "x .1 .1 4 ==" assert
end
