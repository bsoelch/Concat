struct( i32 : mut: x ) =:: s

proc( -> ) =>: main
  0 s new =:: mut: A
  A .x 0 == assert "A .x 0 =="
  ## direct edit
  1 A .x =
  A .x 1 == assert "A .x 1 =="
  ## edit value while tuple is on stack
  A
    3 A .x =
  .x 1 == assert "stack value unmodified"
  A .x 3 == assert "A .x 3 =="
  ## edit value while value is on stack
  A .x
    4 A .x =
  3 == assert "stack value unmodified"
  A .x 4  == assert "A .x 4 =="
end
