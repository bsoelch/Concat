
proc( -> i64 ) =>: anInt
  12345678987654321 return
end

proc( -> ) =>: main
  1 1 +  i32 =: mut A
  A 1 - 3 *  i32 =: mut B
  i32 : mut C 
    
  11_00'10'01 ..debug.print      
  anInt ..debug.print
  
  A ..debug.print
  B ..debug.print
  A B == ..debug.print
  
  A i8 cast 1000000000000000000 + ..debug.print
  A 1 + B 1 - A = B =
  
  A ..debug.print
  B ..debug.print
  
  2 C =

  0x7fff i16 cast =:: short1
  1 i16 cast =:: short2
  short1 short2 + ..debug.print
end
