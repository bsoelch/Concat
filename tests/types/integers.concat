
proc( => i64 ) =: anInt
  12345678987654321 return
end

entryPoint:
  1 1 +  i32 =: mut A
  A 1 - 3 *  i32 =: mut B
  i32 : mut C 
    
  11_00'10'01 print      
  anInt print
  
  A print
  B print
  A B == print
  
  A i8 cast 1000000000000000000 + print
  A 1 + B 1 - A = B =
  
  A print
  B print
  
  2 C =
end
