'print' *import
proc( -> i64 ) =>: anInt
  12345678987654321 return
end

proc( -> ) =>: main
  1 1 +  i32 =: mut: A
  A 1 - 3 *  i32 =: mut: B
  i32 : mut: C 
    
  11_00'10'01 io.println
  anInt io.println
  
  A io.println
  B io.println
  A B == io.println
  
  A i64 cast.s 1000000000000000000 + io.println
  A 1 + B 1 - A= B=
  
  A io.println
  B io.println
  
  2 C=

  0x7fff i16 cast =:: short1
  1 i16 cast =:: short2
  short1 short2 + io.println
end
