import debug
union( i32 : mut: x i32 : y ) =:: anUnion
struct( anUnion : mut: a i32 : mut: b ) =:: aStruct

proc( aStruct ptr.mut : p -> i32 ptr.mut ) =>: test
  p .a .?x =:: e
  e .else ..unreachable end return
end

proc( -> ) =>: main
 0 anUnion .x 0 aStruct new =:: mut: s
 1 s@ test =[]
 s .a ..raw .x debug.print
end
