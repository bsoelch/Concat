import debug
( i32 -> i64 ) =>: procedure
  i64 cast.u
end

( i32 : a -> i64 ) =>: labledPrcoedure
  a i64 cast.s
end

( i32 ) =:: tuple

( i32 : x ) =:: struct

proc( -> ) =>: main
  0 procedure debug.print
  1 labledPrcoedure debug.print
  2 tuple new .0 debug.print
  3 struct new .x debug.print
end
