( i32 -> i64 ) =>: procedure
  i64 cast.u
end

( i32 : a -> i64 ) =>: labledPrcoedure
  a i64 cast.s
end

( i32 ) =:: tuple

( i32 : x ) =:: struct

proc( -> ) =>: main
  0 procedure 0 == "0" assert
  1 labledPrcoedure 1 == "1" assert
  2 tuple new .0 2 == "2" assert
  3 struct new .x 3 == "3" assert
end
