import debug
union( _ : A _ : B i32 : C  ( i32 char8 ) : mut: D ) type =: anUnion
enum( A B C ) type =: labelEnum 
union( _ : empty i64 ptr : data ) type =: optionalI64

anUnion .A =:: e1
anUnion .B =:: e2
2 anUnion .C =:: e3

proc( -> ) =>: main
  -32141 anUnion .C =:: mut: u
  anUnion .A anUnion =: f
  u .?A ? debug.print
  u .?C ? debug.print
  u ..raw .C debug.print

  labelEnum .A =:: mut: l1
  l1 .B if
    labelEnum .C l1=
  end
  241 'A' ( i32 char8 ) new u@ .D=
  u ..raw .D
    2 u@ .?D .else "u .D" ..panic end .0=
    $ .1 debug.print
  .0 debug.print
end
