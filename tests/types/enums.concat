import debug
union( _ : A _ : B i32 : C  ( i32 char8 ) : mut: D ) type =: anUnion
enum( A B C ) type =: labelEnum 
union( _ : empty i64 ptr : data ) type =: optionalI64

anUnion .A =:: e1
anUnion .B =:: e2
2 anUnion .C =:: e3

proc( -> ) =>: main
  -32141 anUnion .C =:: mut: e
  anUnion .A anUnion =: f
  e .A ?? debug.print
  e .C ?? debug.print
  e .C debug.print
  
  labelEnum .A =:: mut: l1
  l1 .B ?? if
    labelEnum .C l1 =
  end
  241 'A' ( i32 char8 ) new e .D =
  e .D
    2 e .D .0 =
    ..dup .1 debug.print
  .0 debug.print
