proc( i32 ptr     ptr     -> i32 ptr     ptr     ) =>: ignoreUnused: ppPP end
proc( i32 ptr.mut ptr     -> i32 ptr     ptr     ) =>: ignoreUnused: mpPP end
proc( i32 ptr     ptr.mut -> i32 ptr     ptr     ) =>: ignoreUnused: pmPP end
proc( i32 ptr.mut ptr.mut -> i32 ptr     ptr     ) =>: ignoreUnused: mmPP end
proc( i32 ptr     ptr     -> i32 ptr.mut ptr     ) =>: ignoreUnused: ppMP end
proc( i32 ptr.mut ptr     -> i32 ptr.mut ptr     ) =>: ignoreUnused: mpMP end
proc( i32 ptr     ptr.mut -> i32 ptr.mut ptr     ) =>: ignoreUnused: pmMP end
proc( i32 ptr.mut ptr.mut -> i32 ptr.mut ptr     ) =>: ignoreUnused: mmMP end
proc( i32 ptr     ptr     -> i32 ptr     ptr.mut ) =>: ignoreUnused: ppPM end
proc( i32 ptr.mut ptr     -> i32 ptr     ptr.mut ) =>: ignoreUnused: mpPM end
proc( i32 ptr     ptr.mut -> i32 ptr     ptr.mut ) =>: ignoreUnused: pmPM end
proc( i32 ptr.mut ptr.mut -> i32 ptr     ptr.mut ) =>: ignoreUnused: mmPM end
proc( i32 ptr     ptr     -> i32 ptr.mut ptr.mut ) =>: ignoreUnused: ppMM end
proc( i32 ptr.mut ptr     -> i32 ptr.mut ptr.mut ) =>: ignoreUnused: mpMM end
proc( i32 ptr     ptr.mut -> i32 ptr.mut ptr.mut ) =>: ignoreUnused: pmMM end
proc( i32 ptr.mut ptr.mut -> i32 ptr.mut ptr.mut ) =>: ignoreUnused: mmMM end

proc( -> ) =>: main
  0 =:: mut: x
  x@ =:: y
  y@ =:: mut: z
  z@ =:: w
  w@ i32 ptr.mut ptr ptr ptr cast =:: v
end
