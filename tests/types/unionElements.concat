import numbers/print

union(
  i32 : Int
  f32 : Float
  char8 : Char
) =:: aUnion
proc( aUnion : u -> ) =>: printU
  u .Int .if
    "int: ":s io.print
    io.println
  else .Float ._if
    "float: ":s io.print
    io.println
  else ..drop
    "other":s io.println
  end
end
proc( -> ) =>: main
  1 aUnion .Int printU
  0.5:f32 aUnion .Float printU
  'A' aUnion .Char printU
end
