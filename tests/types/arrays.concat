import debug
proc( i32 3 ptr : in  i64 2 3 array : multi -> ) =>: arrayTest
  i32 3 ptr : a
  i64 2 4 6 8 10 array : b
  i32 ptr 2 ptr mut : c
  in ..length debug.print
  multi ..size =:: arraySize
  arraySize @ 0 [] debug.print
  in in 0 [] [] debug.print 
end
  
proc( -> ) =>: main
  i32 3 array new =:: anArray
  anArray @  i64 2 3 array new arrayTest
  
  ( i32 i64 ) 2 array new =:: mut: tupleArray
  1 tupleArray @ 0 [] .0 =
  
  i32 2 3 array new =:: mut: matrix
  -14121 matrix @ 1 2 [] = ##  0 1  2 3  4 5
  matrix @ i32 _ ptr cast 5 [] debug.print
end
