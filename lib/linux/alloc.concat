  proc( MemoryValue ptr.mut : mem -> CellHeader ptr.mut ) =>: export: getCellHeader ## XXX exported only for debug purposes
    mem CellHeader _ ptr.mut cast!
      -1 @[]
    CellHeader ptr.mut cast!
  end
  proc( CellHeader ptr.mut : cell -> MemoryValue ptr.mut ) =>: getCellRoot
    cell [] .chunkType ChunkType.noChunk == if
      cell [] .chunkStart MemoryValue ptr.mut cast! return
    end
    chunkInfo cell [] .chunkType i32 cast.u [] =:: chunkData
    cell [] .chunkStart i64 cast!
      chunkData .dataOffset i64 cast.u +
      cell [] .cellIndex i64 cast.u chunkData .cellSize i64 cast.u * +
    MemoryValue ptr.mut cast!
  end
  proc( CellHeader ptr.mut : head -> MemoryValue ptr.mut ) =>: getCellMemory
    head CellHeader _ ptr.mut cast!
      1 @[]
    MemoryValue ptr.mut cast!
  end
  proc( i64 : size i32 : alignment bool : clearMemory -> CellHeader ptr.mut ) =>: allocateCell
    size 15:i64 + 15:i64 ~ & =:: alignedSize
    cellSizes@ cellSizes ..length cellInfoCmp@ alignedSize array.firstBelow =:: cellSizeIndex
    cellSizes cellSizeIndex [] =:: cellSize
    cellSize .chunkType ChunkType.noChunk == if
      size alignment allocLargeChunk return
    end
    ## try finding matching chunk sequence in chunk
    rootChunks cellSize .chunkType i32 cast.u [] =:: root
    cellSize .chunkType cellSize .cellCount i32 cast.u alignment clearMemory searchAvailableCells $ optional.hasData if
      .data return
    end ..drop
    ## check for chunk sequence in next larger size
    cellSizeIndex 1 + cellSizes ..length < if
      cellSizes cellSizeIndex 1 + [] =:: nextSize
      nextSize .chunkType ChunkType.noChunk == if
        size alignment allocLargeChunk return
      end
      rootChunks nextSize .chunkType i32 cast.u [] =:: nextRoot
      nextSize .chunkType nextSize .cellCount i32 cast.u alignment clearMemory searchAvailableCells $ optional.hasData if
        .data return
      end ..drop
    end
    ## allocate cells in a new chunk
    cellSize .chunkType createChunk =:: newChunk
    newChunk cellSize .cellCount i32 cast.u alignment clearMemory allocateBlock .data return
  end
  proc( i64 : size -> MemoryValue ptr.mut ) =>: export: allocate
    size 0 == if ## empty alloc -> nullPtr
      0 MemoryValue ptr.mut cast! return
    end
    size CellHeader ..types.stride + minAlignment false allocateCell getCellMemory
  end
  proc( i64 : size i32 : alignment -> MemoryValue ptr.mut ) =>: export: aligned_allocate
    alignment alignment -_ & alignment == "alignment is power of two" assert
    size 0 == if ## empty alloc -> nullPtr
      0 MemoryValue ptr.mut cast! return
    end
    CellHeader ..types.stride alignment i64 cast.u i64.max =:: cellAlignment
    size cellAlignment + cellAlignment i32 cast false allocateCell getCellMemory
  end
  proc( i64 : size -> MemoryValue ptr.mut ) =>: export: clearedAllocate
    size 0 == if ## empty alloc -> nullPtr
      0 MemoryValue ptr.mut cast! return
    end
    size CellHeader ..types.stride + minAlignment true allocateCell getCellMemory
  end
  proc( i64 : size i32 : alignment -> MemoryValue ptr.mut ) =>: export: aligned_clearedAllocate
    alignment alignment -_ & alignment == "alignment is power of two" assert
    size 0 == if ## empty alloc -> nullPtr
      0 MemoryValue ptr.mut cast! return
    end
    CellHeader ..types.stride alignment i64 cast.u i64.max =:: cellAlignment
    size cellAlignment + alignment minAlignment i32.max true allocateCell getCellMemory
  end
  proc( CellHeader ptr.mut : cell -> ) =>: freeCell
    cell [] .chunkType ChunkType.noChunk == if
      cell freeLargeChunk return
    end
    cell [] .chunkType i64 cast.u chunkInfo ..length >= if
      "invalid chunk type" ..panic
    end
    cell 0:i32  resizeBlock
      .empty ?? "freeing block returns empty optional" assert
    return
  end
  proc( MemoryValue ptr.mut : p -> ) =>: export: free
    p i64 cast! 0 == if return end ## ignore free of null-pointer
    p getCellHeader freeCell
  end

  proc( MemoryValue ptr.mut : p i64 : newSize -> MemoryValue ptr.mut ) =>: export: reallocate
    p i64 cast! 0 == if
      newSize allocate return
    else newSize 0 == _if
      p free
      0 MemoryValue ptr.mut cast! return
    end
    p getCellHeader =:: oldHeader
    oldHeader [] .chunkType switch
      ChunkType.chunk48 case 48:i64 break
      ChunkType.chunk80 case 80:i64 break
      ChunkType.chunk208 case 208:i64 break
      ChunkType.chunk368 case 368:i64 break
      ChunkType.chunk656 case 656:i64 break
      ChunkType.chunk1072 case 1072:i64 break
      ChunkType.chunk4128 case 4128:i64 break
      ChunkType.noChunk case PAGE_SIZE break
      default ..unreachable ## unknown cell size
    end =:: oldCellSize
    newSize
      p i64 cast! oldHeader getCellRoot i64 cast! - +
    =:: newSizeWithHeader
    newSizeWithHeader 32 + oldCellSize 4 / >= and newSizeWithHeader oldCellSize MAX_CELL_COUNT i64 cast.u * <= if
      oldHeader [] .chunkType ChunkType.noChunk == if
        oldHeader newSizeWithHeader reallocateLargeChunk getCellMemory return
      end
      newSizeWithHeader oldCellSize 1 - + oldCellSize u/ i32 cast =:: newCellCount
      ## try to resize pointer in place
      oldHeader newCellCount resizeBlock =:: newHeader?
      newHeader? optional.hasData if
        newHeader? .data getCellMemory return
      end
    end
    oldCellSize oldHeader [] .size i64 cast.u * p i64 cast! oldHeader i64 cast! - - =:: oldSize
    newSize 1:i32 oldHeader [] .alignmentBits i32 cast << aligned_allocate =:: newP
    newP i8 _ ptr.mut cast! p i8 _ ptr.mut cast! oldSize newSize i64.min mem.copy ..drop
    p free
    newP return
  end
