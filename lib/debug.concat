import io
import numbers
import stringBuilder
import stringIO

namespace: sb
  proc( stringBuilder : sb char8 : c -> stringBuilder ) =>: export: appendEscapedChar
    c switch
     '\'' case sb "\\'" sb.appendS return
     '\"' case sb "\\\"" sb.appendS return
     '\\' case sb "\\\\" sb.appendS return
     '\n' case sb "\\n" sb.appendS return
     '\t' case sb "\\t" sb.appendS return
     '\b' case sb "\\b" sb.appendS return
     '\r' case sb "\\r" sb.appendS return
     '\f' case sb "\\f" sb.appendS return
     '\v' case sb "\\v" sb.appendS return
    end
    c '\x20' >= c '\x7f' < & if
      sb c sb.appendC return
    end
    sb
      "\\x" sb.appendS
      c i64 cast.u 0xff & 0x10 < if '0' sb.appendC end
      c i64 cast.u 0xff & sb.appendX
    return
  end
end
namespace: debug
  proc( bool : b -> ) =>: export: printB
    b if
      io.stdOut "true\n" io.fputs ..drop
    else
      io.stdOut "false\n" io.fputs ..drop
    end
  end
  proc( char8 : c -> ) =>: export: printC
    char8 16 array : buffer ##  length should be at most 11=1+3+4+3
    buffer@ sb.wrapBuffer
      c i64 cast.u sb.appendI
      " ('" sb.appendS
      c sb.appendEscapedChar
      "')\n" sb.appendS
      io.stdOut ..over io.fputSb ..drop
    ..drop
  end
  proc( i64 : i -> ) =>: export: printI
    char8 24 array : buffer ##  -9223372036854775808
    buffer@ sb.wrapBuffer
      i sb.appendI
      '\n' sb.appendC
      io.stdOut ..over io.fputSb ..drop
    ..drop
  end
  proc( i8  -> ) =>: export: printI8   i64 cast.s printI  end
  proc( i16 -> ) =>: export: printI16  i64 cast.s printI  end
  proc( i32 -> ) =>: export: printI32  i64 cast.s printI  end
  proc( iSize -> ) =>: export: printZ  i64 cast.u printU  end
  proc( i64 : i -> ) =>: export: printX
    char8 24 array : buffer ##  -0x8000000000000000
    buffer@ sb.wrapBuffer
      i sb.appendX
      '\n' sb.appendC
      io.stdOut ..over io.fputSb ..drop
    ..drop
  end
  proc( i64 : i -> ) =>: export: printUX
    char8 24 array : buffer ##  0xffffffffffffffff
    buffer@ sb.wrapBuffer
      i 16 sb.appendU?
      '\n' sb.appendC
      io.stdOut ..over io.fputSb ..drop
    ..drop
  end
  proc( i64 : i -> ) =>: export: printU
    char8 24 array : buffer ##  18446744073709551615
    buffer@ sb.wrapBuffer
      i sb.appendU
      '\n' sb.appendC
      io.stdOut ..over io.fputSb ..drop
    ..drop
  end
  proc( f32 : x -> ) =>: export: printF32
    x f64 cast printF
  end
  proc( f64 : x -> ) =>: export: printF
    char8 32 array : buffer ##  18446744073709551615
    buffer@ sb.wrapBuffer
      x sb.appendF
      '\n' sb.appendC
      io.stdOut ..over io.fputSb ..drop
    ..drop
  end
  proc( f64 : x -> ) =>: export: printXF
    char8 32 array : buffer ##  18446744073709551615
    buffer@ sb.wrapBuffer
      x sb.appendXF
      '\n' sb.appendC
      io.stdOut ..over io.fputSb ..drop
    ..drop
  end
  proc( type : auto: T T ptr.raw : p -> ) =>: export: printP
    char8 24 array : buffer ##  0xffffffffffffffff
    buffer@ sb.wrapBuffer
      p i64 cast! 0 == if
        "(nil)" sb.appendS
      else
        "0x" sb.appendS
        p i64 cast! sb.appendX
      end
      '\n' sb.appendC
      io.stdOut ..over io.fputSb ..drop
    ..drop
  end
  proc( i32 : auto: k  char8 k ptr : s -> ) =>: export: printS
    24 sb.create ## cannot use local buffer, upper bound of length not known at compile time
      '"' sb.appendC
      s sb.appendS
      "\" at 0x" sb.appendS
      s i64 cast! sb.appendX
      '\n' sb.appendC
      io.stdOut ..over io.fputSb ..drop
    sb.free ..drop
  end

  overload: export: print
    printB
    printC
    printI8
    printI16
    printI32
    printI
    printZ
    printF
    printF32
    printS
    printP
  end
end
