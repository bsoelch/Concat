"../core/floats" import

namespace: c
  proc.c( ..ctype.double -> ..ctype.double ) : extern: floor
  proc.c( ..ctype.double -> ..ctype.double ) : extern: ceil
  proc.c(
    ..ctype.double
    ..ctype.double
  -> ..ctype.double ) : extern: remainder
  proc.c( ..ctype.double -> ..ctype.double ) : extern: fabs

  proc.c(
    ..ctype.double
    ..ctype.double
  -> ..ctype.double ) : extern: fmin
  proc.c(
    ..ctype.double
    ..ctype.double
  -> ..ctype.double ) : extern: fmax

  proc.c( ..ctype.double -> ..ctype.double ) : extern: log2
  proc.c( ..ctype.double -> ..ctype.double ) : extern: log
  proc.c( ..ctype.double -> ..ctype.double ) : extern: exp

  proc.c( ..ctype.double -> ..ctype.double ) : extern: sqrt
  proc.c( ..ctype.double -> ..ctype.double ) : extern: cbrt
  proc.c(
    ..ctype.double
    ..ctype.double
  -> ..ctype.double ) : extern: pow
  ## XXX gamma function

  proc.c( ..ctype.double -> ..ctype.double ) : extern: sin
  proc.c( ..ctype.double -> ..ctype.double ) : extern: cos
  proc.c( ..ctype.double -> ..ctype.double ) : extern: tan
  proc.c( ..ctype.double -> ..ctype.double ) : extern: asin
  proc.c( ..ctype.double -> ..ctype.double ) : extern: acos
  proc.c( ..ctype.double -> ..ctype.double ) : extern: atan
  proc.c( ..ctype.double -> ..ctype.double ) : extern: sinh
  proc.c( ..ctype.double -> ..ctype.double ) : extern: cosh
  proc.c( ..ctype.double -> ..ctype.double ) : extern: tanh
  proc.c( ..ctype.double -> ..ctype.double ) : extern: asinh
  proc.c( ..ctype.double -> ..ctype.double ) : extern: acosh
  proc.c( ..ctype.double -> ..ctype.double ) : extern: atanh
  proc.c(
    ..ctype.double : x
    ..ctype.double : y
  -> ..ctype.double ) : extern: atan2
end
namespace: math
  proc( f64 -> f64 ) =>: export: floor
    ..ctype.double cast c.floor f64 cast
  end
  proc( f64 -> f64 ) =>: export: ceil
    ..ctype.double cast c.ceil f64 cast
  end
  proc( f64 -> f64 ) =>: export: round
    ..dup f64.isFinite ! if
      return ## no change for non-finite number
    end
    ## remainder(x,1) = x - roundeven(x)
    1.0 ..ctype.double cast $1 ..ctype.double cast c.remainder f64 cast -
  end
  proc( f64 -> f64 ) =>: export: abs
    ..ctype.double cast c.fabs f64 cast
  end

  proc( f64 : a f64 : b -> f64 ) =>: export: min
    b ..ctype.double cast a ..ctype.double cast c.fmin f64 cast
  end
  proc( f64 : a f64 : b -> f64 ) =>: export: max
    b ..ctype.double cast a ..ctype.double cast c.fmax f64 cast
  end

  proc( f64 -> f64 ) =>: export: log2
    ..ctype.double cast c.log2 f64 cast
  end
  proc( f64 -> f64 ) =>: export: log
    ..ctype.double cast c.log f64 cast
  end
  proc( f64 -> f64 ) =>: export: exp
    ..ctype.double cast c.exp f64 cast
  end

  proc( f64 -> f64 ) =>: export: sqrt
    ..ctype.double cast c.sqrt f64 cast
  end
  proc( f64 -> f64 ) =>: export: cbrt
    ..ctype.double cast c.cbrt f64 cast
  end
  proc( f64 : base f64 : power -> f64 ) =>: export: pow
    power ..ctype.double cast base ..ctype.double cast c.pow f64 cast
  end
  ## XXX gamma function

  proc( f64 -> f64 ) =>: export: sin
    ..ctype.double cast c.sin f64 cast
  end
  proc( f64 -> f64 ) =>: export: cos
    ..ctype.double cast c.cos f64 cast
  end
  proc( f64 -> f64 ) =>: export: tan
    ..ctype.double cast c.tan f64 cast
  end
  proc( f64 -> f64 ) =>: export: asin
    ..ctype.double cast c.asin f64 cast
  end
  proc( f64 -> f64 ) =>: export: acos
    ..ctype.double cast c.acos f64 cast
  end
  proc( f64 -> f64 ) =>: export: atan
    ..ctype.double cast c.atan f64 cast
  end
  proc( f64 -> f64 ) =>: export: sinh
    ..ctype.double cast c.sinh f64 cast
  end
  proc( f64 -> f64 ) =>: export: cosh
    ..ctype.double cast c.cosh f64 cast
  end
  proc( f64 -> f64 ) =>: export: tanh
    ..ctype.double cast c.tanh f64 cast
  end
  proc( f64 -> f64 ) =>: export: asinh
    ..ctype.double cast c.asinh f64 cast
  end
  proc( f64 -> f64 ) =>: export: acosh
    ..ctype.double cast c.acosh f64 cast
  end
  proc( f64 -> f64 ) =>: export: atanh
    ..ctype.double cast c.atanh f64 cast
  end
  proc( f64 : y f64 : x -> f64 ) =>: export: atan2
    x ..ctype.double cast y ..ctype.double cast c.atan2 f64 cast
  end
end
