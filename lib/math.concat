#namespace c
proc( ..ctype.double => ..ctype.double ) : extern floor
proc( ..ctype.double => ..ctype.double ) : extern ceil
proc( ..ctype.double => ..ctype.double ) : extern round
proc( ..ctype.double => ..ctype.double ) : extern fabs

proc(
  ..ctype.double
  ..ctype.double
=> ..ctype.double ) : extern fmin
proc(
  ..ctype.double
  ..ctype.double
=> ..ctype.double ) : extern fmax

proc( ..ctype.double => ..ctype.double ) : extern log2
proc( ..ctype.double => ..ctype.double ) : extern log
proc( ..ctype.double => ..ctype.double ) : extern exp

proc( ..ctype.double => ..ctype.double ) : extern sqrt
proc( ..ctype.double => ..ctype.double ) : extern cbrt
proc(
  ..ctype.double
  ..ctype.double
=> ..ctype.double ) : extern pow
## XXX gamma function

proc( ..ctype.double => ..ctype.double ) : extern sin
proc( ..ctype.double => ..ctype.double ) : extern cos
proc( ..ctype.double => ..ctype.double ) : extern tan
proc( ..ctype.double => ..ctype.double ) : extern asin
proc( ..ctype.double => ..ctype.double ) : extern acos
proc( ..ctype.double => ..ctype.double ) : extern atan
proc( ..ctype.double => ..ctype.double ) : extern sinh
proc( ..ctype.double => ..ctype.double ) : extern cosh
proc( ..ctype.double => ..ctype.double ) : extern tanh
proc( ..ctype.double => ..ctype.double ) : extern asinh
proc( ..ctype.double => ..ctype.double ) : extern acosh
proc( ..ctype.double => ..ctype.double ) : extern atanh
proc(
  ..ctype.double : y
  ..ctype.double : x
=> ..ctype.double ) : extern atan2

proc( ..ctype.float => ..ctype.int ) : extern isnanf
proc( ..ctype.float => ..ctype.int ) : extern isinff
proc( ..ctype.float => ..ctype.int ) : extern isfinitef
proc( ..ctype.double => ..ctype.int ) : extern isnan
proc( ..ctype.double => ..ctype.int ) : extern isinf
proc( ..ctype.double => ..ctype.int ) : extern isfinite
#end
#namespace math
proc( double => double ) =: public floor
  c.floor
end
proc( double => double ) =: public ceil
  c.ceil
end
proc( double => double ) =: public round
  c.round
end
proc( double => double ) =: public abs
  c.fabs
end

proc( double double => double ) =: public min
  c.fmin
end
proc( double double => double ) =: public max
  c.fmax
end

proc( double => double ) =: public log2
  c.log2
end
proc( double => double ) =: public log
  c.log
end
proc( double => double ) =: public exp
  c.exp
end

proc( double => double ) =: public sqrt
  c.sqrt
end
proc( double => double ) =: public cbrt
  c.cbrt
end
proc( double : base double : power => double ) =: public pow
  base power c.pow
end
## XXX gamma function

proc( double => double ) =: public sin
  c.sin
end
proc( double => double ) =: public cos
  c.cos
end
proc( double => double ) =: public tan
  c.tan
end
proc( double => double ) =: public asin
  c.asin
end
proc( double => double ) =: public acos
  c.acos
end
proc( double => double ) =: public atan
  c.atan
end
proc( double => double ) =: public sinh
  c.sinh
end
proc( double => double ) =: public cosh
  c.cosh
end
proc( double => double ) =: public tanh
  c.tanh
end
proc( double => double ) =: public asinh
  c.asinh
end
proc( double => double ) =: public acosh
  c.acosh
end
proc( double => double ) =: public atanh
  c.atanh
end
proc( double double => double ) =: public atan2
  c.atan2
end
#end
#namespace double
  proc( double => bool ) =: public isNaN
    c.isnan i32 cast ?
  end
  proc( double => bool ) =: public isInfinite
    c.isinf i32 cast ?
  end
  proc( double => bool ) =: public isFinite
    c.isfinite i32 cast ?
  end
#end
