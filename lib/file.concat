"optional" *import
"string" *import
"stringBuilder" *import

namespace: file
  i32 =:: export: Error
  namespace: Error
    0 Error =: export: NONE
    -1 Error =: export: END_OF_FILE
    1 Error =: export: IO
    2 Error =: export: PATH_OVERFLOW
    3 Error =: export: OPEN_MODE
    4 Error =: export: FILE_NOT_FOUND
    5 Error =: export: FILE_IS_DIR
    6 Error =: export: FILE_ALREADY_EXISTS
    7 Error =: export: ACCESS_DENIED
    8 Error =: export: INVALID_FILE
  end
end
## TODO: move low-level code to platform dependent section of library
namespace: c
  ..ctype.struct ptr.mut =:: export: FILE
  ..ctype.struct ptr.mut =:: export: DIR
  ..ctype.int =:: fd
  namespace: fd
    0 fd =: stdIn
    1 fd =: stdOut
    2 fd =: stdErr
  end
  proc.c(
    ..ctype.char ptr.raw : mode
    ..ctype.char ptr.raw : path
  -> FILE ) : extern: fopen
  proc.c( FILE -> ) : extern: clearerr
  proc.c( FILE -> ..ctype.int ) : extern: feof
  proc.c( FILE -> ..ctype.int ) : extern: ferror
  proc.c( FILE : file -> i32 ) : extern: fgetc
  proc.c(
    FILE : file
    ..ctype.size : eltCount
    ..ctype.size : eltSize
    ..ctype.void ptr.raw.mut : buffer
  -> ..ctype.size ) : extern: fread
  proc.c(
    FILE : file
    ..ctype.size : count
    ..ctype.char ptr.raw.mut : buffer
  -> ..ctype.char ptr.raw ) : extern: fgets

  proc.c(
    FILE : file
    ..ctype.size : eltCount
    ..ctype.size : eltSize
    ..ctype.void ptr.raw : buffer
  -> ..ctype.size ) : extern: fwrite
  proc.c( FILE : file -> ..ctype.int ) : extern: fflush
  proc.c( FILE : file -> ..ctype.int ) : extern: fclose
  proc.c( ..ctype.char ptr.raw -> ..ctype.int ) : extern: remove
  proc.c( ..ctype.char ptr.raw -> DIR ) : extern: opendir
  proc.c( DIR -> ..ctype.int ) : extern: closedir
  proc.c( FILE -> fd ) : extern: fileno
  proc.c( fd fd -> i32 ) : extern: dup2
  ## wrapper functions to allow interoperability with lib-c code
  proc.c( ..ctype.char ptr.raw -> iSize ) : extern: strlen
  proc.c( -> FILE ) : extern: concatIOHelper_stdin
  proc.c( -> FILE ) : extern: concatIOHelper_stdout
  proc.c( -> FILE ) : extern: concatIOHelper_stderr
  proc.c( -> ) : extern: concatIOHelper_resetErrno
  proc.c( -> file.Error ) : extern: concatIOHelper_checkErrno
  proc.c( DIR -> ..ctype.char ptr.raw ) : extern: concatIOHelper_readdirname
end
namespace: io
  proc( -> char8 optional ) =>: export: getChar
    c.concatIOHelper_stdin c.fgetc $ 0 > if
      char8 cast.u optional.wrap return
    else ..drop
      char8 optional.empty return
    end
  end
end
namespace: file
  i8 =:: Flags
  namespace: Flags
    0x00 Flags =: NONE
    0x01 Flags =: NO_CLOSE
    proc( Flags Flags -> Flags ) : alias: or i8.or
    proc( Flags Flags -> Flags ) : alias: and i8.and
    proc( Flags Flags -> Flags ) : alias: xor i8.xor
    proc( Flags -> bool ) : alias: toBool i8.toBool
  end
end
overload: merge: & file.Flags.and end
overload: merge: | file.Flags.or end
overload: merge: ^ file.Flags.xor end
overload: merge: ? file.Flags.toBool end
namespace: file
  union(
    _ : None
    c.FILE : File
    c.DIR : Dir
  ) =:: export: FileValue
  struct(
    ## TODO? remember path
    FileValue : value
    Error : error
    Flags : flags
  ) =:: export: File
  ## TODO? more modes: read+append ?
  enum( READ WRITE APPEND READ_WRITE DIR ) =:: export: OpenMode
  proc( File -> bool ) =>: export: isOk   .error Error.NONE == end
  proc( File -> bool ) =>: export: isErr  .error Error.NONE != end
  proc( File -> bool ) =>: export: isFile .value .File ? end
  proc( File -> bool ) =>: export: isDir  .value .Dir ? end
  ## TODO: state checker .isReadable / .isWriteable / .size
  proc( File -> Error ) =>: export: getError   .error  end
  proc( File -> File ) =>: export: clearError
    Error.NONE >$ .error=
  end
  proc( -> File ) =>: export: stdIn  c.concatIOHelper_stdin  FileValue .File Error.NONE Flags.NO_CLOSE File new end
  proc( -> File ) =>: export: stdOut c.concatIOHelper_stdout FileValue .File Error.NONE Flags.NO_CLOSE File new end
  proc( -> File ) =>: export: stdErr c.concatIOHelper_stderr FileValue .File Error.NONE Flags.NO_CLOSE File new end

  ## redirect input/output
  ## TODO? versions that take File instead of string
  proc( string -> bool ) =>: export: setStdIn
    OpenMode .READ open
      $ .value .File .else ..drop.2 false return end
      c.fd.stdIn c.fd cast >$ c.fileno
    c.dup2 0 >=
      >$ ..drop
    return
  end
  proc( string bool : append -> bool ) =>: export: setStdOut
    append if OpenMode .APPEND else OpenMode .WRITE end open
      $ .value .File .else ..drop.2 false return end
      c.fd.stdOut c.fd cast >$ c.fileno
    c.dup2 0 >=
      >$ ..drop
    return
  end
  proc( string bool : append -> bool ) =>: export: setStdErr
    append if OpenMode .APPEND else OpenMode .WRITE end open
      $ .value .File .else ..drop.2 false return end
      c.fd.stdErr c.fd cast >$ c.fileno
    c.dup2 0 >=
      >$ ..drop
    return
  end
  ## TODO: path management functions:
  ## .path / .create / .createDir / .delete / .parent

  char8 4096 array : mut: fileNameBuffer ## XXX make buffer thread safe
  proc( string : fileName -> ..ctype.char ptr.raw bool ) =>: getCPath
    false =:: mut: shouldFree
    fileName $ .length 1 - string.charAt '\x00' == if
      fileName .data
    else
      fileName .length fileNameBuffer@ ptr.length u< if
        fileNameBuffer@
      else
        fileName .length 1 + char8 mem.alloc
        true shouldFree=
      end
        fileName .data
        fileName .length
      mem.copy
      '\x00' $1 fileName .length =[]
    end ..ctype.char ptr.raw cast! shouldFree
  end
  ## TODO? open as directory when mode if READ and path is directory
  proc( string : fileName OpenMode : openMode -> File ) =>: export: open
    c.concatIOHelper_resetErrno
    fileName getCPath =:: shouldFree =:: path
    openMode switch
      READ case "rb\x00" ..ctype.char ptr.raw cast! break
      WRITE case "wb\x00" ..ctype.char ptr.raw cast! break
      APPEND case "ab\x00" ..ctype.char ptr.raw cast! break
      READ_WRITE case "r+b\x00" ..ctype.char ptr.raw cast! break
      DIR case
        path c.opendir
          $ ( ) ptr cast! c.isNull if
            c.concatIOHelper_checkErrno
            >$ ..drop FileValue .None <$
          else
            FileValue .Dir Error.NONE
          end
          shouldFree if path iSize cast! char8 ptr.raw.mut cast! mem.free end
        Flags.NONE File new
      return
    end
      path
    c.fopen
      $ ( ) ptr cast! c.isNull if
        ..drop FileValue .None
        c.concatIOHelper_checkErrno
      else
        FileValue .File Error.NONE
      end
      shouldFree if path iSize cast! char8 ptr.raw.mut cast! mem.free end
    Flags.NONE File new
  end
  proc( string : fileName bool : deleteDir -> bool ) =>: export: delete
    fileName getCPath =:: shouldFree =:: path
    ## TODO: recursively delete directory if flag is set
      path c.remove i32 cast 0 ==
    shouldFree if
      shouldFree if path iSize cast! char8 ptr.raw.mut cast! mem.free end
    end
  end
  proc( File char8 ptr.raw.mut : buffer iSize : count -> File iSize ) =>: export: fread_wrapper
    $ .value .File .else ..drop 0 return end =:: fileVal
    fileVal c.clearerr
    c.concatIOHelper_resetErrno
    fileVal
      count ..ctype.size cast
      1 ..ctype.size cast
      buffer ..ctype.void ptr.raw.mut cast!
    c.fread iSize cast.s =:: nRead
      fileVal c.feof i32 cast ? if
        Error.END_OF_FILE >$ .error=
      end
      fileVal c.ferror i32 cast ? if
        c.concatIOHelper_checkErrno >$ .error=
      end
    nRead
  end
  proc( File string : s -> File iSize ) =>: export: fwrite_wrapper
    $ .value .File .else ..drop 0 return end =:: fileVal
    fileVal c.clearerr
    c.concatIOHelper_resetErrno
    fileVal
      s .length ..ctype.size cast
      1 ..ctype.size cast
      s .data ..ctype.void ptr.raw cast!
    c.fwrite iSize cast.s =:: nWritten
      fileVal c.feof i32 cast ? if
        Error.END_OF_FILE >$ .error=
      end
      fileVal c.ferror i32 cast ? if
        c.concatIOHelper_checkErrno >$ .error=
      end
    nWritten
  end
  proc( File char8 slice.mut : s -> File string ) =>: export: read
    $ isErr if "":s return end
    $ isFile ! if "":s return end ## TODO set error flag
    0:iSize =:: mut: count
    while count s .length u< do
      s .data count @[] s .length count - fread_wrapper count + count=
    finally
      $ isErr if s .data count string.create return end
    end
    s .data count string.create
  end
  ## TODO? io buffering?
  proc( File string : mut: s -> File ) =>: export: write
    $ isErr if return end
    $ isFile ! if return end ## TODO set error flag
    while s .length 0 != do
      s fwrite_wrapper =:: nWritten
    finally
      $ isErr if return end
      s nWritten string.tail s=
    end
  end
  proc( File : mut: f stringBuilder -> File stringBuilder ) =>: export: readTo
    f isErr if f >$ return end
    f isFile ! if f >$ return end ## TODO set error flag
    while
      $ .length $ 2 * >$ 8192 + iSize.min sb.ensureCap
      f $1 .data $2 .length @[] $2 sb.getCapacity $3 .length - fread_wrapper =:: nRead f=
      $ .length nRead + >$ .length=
      f isOk
    end
    f
      $ .error Error.END_OF_FILE == if ## do not treat end of file as error
        Error.NONE >$ .error=
      end
    >$ return
  end
  ## TODO? convenience Function: ( string -> stringBuilder ) : readAll
  proc( File -> File stringBuilder ) =>: export: readAll
    256 sb.create readTo
  end
  proc( File stringBuilder -> File stringBuilder ) =>: export: readLine
    $1 .value .File .else ..drop return end =:: fileVal
    while
      fileVal c.clearerr
      c.concatIOHelper_resetErrno
      $ .length 16 + sb.ensureCap
      fileVal
        $1 sb.getCapacity $2 .length - ..ctype.size cast
        $2 .data $3 .length @[] ..ctype.char ptr.raw.mut cast!
      c.fgets $ c.isNull if
        ..drop
        >$
          fileVal c.feof i32 cast ? if
            Error.END_OF_FILE >$ .error=
          end
          fileVal c.ferror i32 cast ? if
            c.concatIOHelper_checkErrno >$ .error=
          end
        <$
        return
      end c.strlen $1 .length + >$ .length=
      $ $ .length 1 - [] '\n' !=
    end return
  end
  proc( File -> ) =>: export: close
    $ .flags Flags.NO_CLOSE & ? if ..drop return end
    .value switch
      None case return
      File .case c.fclose ..drop return
      Dir .case c.closedir ..drop return
    end
  end
  proc( File -> File ) =>: export: flush
    $ .value switch
      None Dir case return
      File .case c.fflush ..drop return
    end
  end

  union(
    _ : End
    string : Ok ## TODO? cstring type to indicate null-terminator
    Error : Err
  ) =:: DirResult
  struct(
    c.DIR : dir
    DirResult : next
  ) =:: export: DirItr
  ## TODO: make entries iterate over files and "entryNames" over entry-names
  proc( File -> DirItr ) =>: export: entries
    .value .Dir .else ..drop
      DirItr.empty return
    end DirItr.fromDir return
  end
  namespace: DirItr
    proc( -> DirItr ) =>: empty
      0 c.DIR cast! DirResult .End DirItr new
    end
    proc( c.DIR : dir -> DirItr ) =>: fromDir
      dir $ nextDirEntry DirItr new
    end
    proc( c.DIR : dir -> DirResult ) =>: nextDirEntry
      c.concatIOHelper_resetErrno
      dir c.concatIOHelper_readdirname
        $ c.isNull if ..drop
          c.concatIOHelper_checkErrno
            $ Error.NONE == if ..drop DirResult .End return end
          DirResult .Err return
        end
      $ char8 ptr.raw cast! >$ c.strlen string new
        $ ".":s string.eq or $ "..":s string.eq if ..drop
          dir nextDirEntry return
        end
      DirResult .Ok
    end
    proc( DirItr -> DirItr ) =>: id end
    proc( DirItr -> string ) =>:  get
      .next .Ok .else "missing value" ..panic end
    end
    proc( DirItr -> DirItr ) =>:  step
      $ .dir nextDirEntry >$ .next=
    end
    proc( DirItr -> bool ) =>: export: hasNext
      .next .Ok ?
    end
    proc( DirItr -> DirItr string ) =>: export: next
      $ .next .Ok .else "missing value" ..panic end
        $1 .dir nextDirEntry >>$ .next=
      >$
    end
    proc( DirItr -> Error ) =>: checkError
      .next .Err .else ..drop
        Error.NONE
      end return
    end
  end
end
overload: merge: ..itr.prepare
  file.DirItr.id
end
overload: merge: ..itr.check
  file.DirItr.hasNext
end
overload: merge: ..itr.get
  file.DirItr.get
end
overload: merge: ..itr.step
  file.DirItr.step
end
overload: merge: ..itr.end
  file.DirItr.checkError
end
