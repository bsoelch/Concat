import io
namespace: file
  struct(
    io.FILE : file
    io.IOError : error
  ) =:: export: FILE
  ## TODO? more modes: read+append ?
  enum( READ WRITE APPEND READ_WRITE ) =:: export: OpenMode
  proc( FILE -> bool ) =>: export: isOk   .error io.FILE_ERROR_NONE == end
  proc( FILE -> bool ) =>: export: isErr  .error io.FILE_ERROR_NONE != end
  proc( FILE -> io.IOError ) =>: export: getError   .error  end
  proc( FILE -> FILE ) =>: export: clearError
    io.FILE_ERROR_NONE >$ .error=
  end

  proc( string : fileName OpenMode : openMode -> FILE ) =>: export: open
    openMode switch
      READ case io.OPEN_READ break
      WRITE case io.OPEN_WRITE break
      APPEND case io.OPEN_APPEND break
      READ_WRITE case io.OPEN_READ io.OPEN_WRITE | break
    end =:: ioOpenMode
    fileName .data fileName .length ioOpenMode io.fopen
      =:: ioError
    =:: file
    file ioError FILE new
  end
  ## TODO? ( FILE buffer count -> FILE ) read / ( FILE string -> FILE ) write
  proc( FILE : f0 -> FILE stringBuilder ) =>: export: readAll
    f0 isErr if f0 0 sb.create return end
    f0 =:: mut: f
    256 sb.create =:: mut: sb
    while
      sb
        $ .length 2 * sb.ensureCap
      sb=
      f .file sb .data sb .length sb sb.getCapacity sb .length - io.fread f@ .error= =:: nRead
      sb .length
        nRead +
      sb@ .length=
      f isOk
    end
    f
      $ .error io.FILE_ERR_END_OF_FILE == if ## do not treat end of file as error
        io.FILE_ERROR_NONE >$ .error=
      end
    sb return
  end
  proc( FILE -> ) =>: export: close
    .file io.fclose ..drop
  end
end
