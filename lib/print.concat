  proc( f32 : i -> ) =>: export: printXF32
    char8 16 array : mut: buffer ## -0xf.fffffX1f
    buffer@ sb.wrapBuffer
      i f32.sbAppendX
    sb.asStr printS
  end
  proc( f64 : i -> ) =>: export: printXF64
    char8 24 array : mut: buffer ## -f.ffffffffffff8X+ff
    buffer@ sb.wrapBuffer
      i f64.sbAppendX
    sb.asStr printS
  end
  proc( f128 : i -> ) =>: export: printXF128
    char8 40 array : mut: buffer ## -f.ffffffffffff8X+ff
    buffer@ sb.wrapBuffer
