"file" import
"numbers/toStr" import

namespace: io
  proc( char8 : c -> ) =>: export: printC
    file.stdOut c@ string.wrap file.write ..drop
  end
  proc( char8 : c -> ) =>: export: printlnC
    char8 2 array : mut: chrs
    c chrs@ 0 =[]
    '\n' chrs@ 1 =[]
    chrs@ string.wrap printS
  end
  proc( string : s -> ) =>: export: printS
    file.stdOut s file.write ..drop
  end
  proc( string : s -> ) =>: export: printlnS
    s printS '\n' printC
  end
  proc( bool -> ) =>: export: printBool
    if "true":s else "false":s end printS
  end
  proc( bool -> ) =>: export: printlnBool
    if "true\n":s else "false\n":s end printS
  end

  proc( char8 : c -> ) =>: export: eprintC
    file.stdErr c@ string.wrap file.write ..drop
  end
  proc( char8 : c -> ) =>: export: eprintlnC
    char8 2 array : mut: chrs
    c chrs@ 0 =[]
    '\n' chrs@ 1 =[]
    chrs@ string.wrap eprintS
  end
  proc( string : s -> ) =>: export: eprintS
    file.stdErr s file.write ..drop
  end
  proc( string : s -> ) =>: export: eprintlnS
    s eprintS '\n' eprintC
  end

  proc( i32 : i -> ) =>: printI32
    char8 12 array : mut: buffer ## -4294967296\n
    buffer@ sb.wrapBuffer
      i i32.sbAppend
    sb.asStr printS
  end
  proc( i64 : i -> ) =>: export: printI64
    char8 24 array : mut: buffer ## -9223372036854775808\n
    buffer@ sb.wrapBuffer
      i i64.sbAppend
    sb.asStr printS
  end
  proc( i128 : i -> ) =>: export: printI128
    char8 40 array : mut: buffer ## -1701411 83460469 23173168 73037158 84105728
    buffer@ sb.wrapBuffer
      i i128.sbAppend
    sb.asStr printS
  end
  proc( iSize : i -> ) =>: export: printZ
    char8 24 array : mut: buffer ## -9223372036854775808\n
    buffer@ sb.wrapBuffer
      i iSize.sbAppend
    sb.asStr printS
  end
  proc( i8 : i -> ) =>: export: printI8   i i32 cast printI32 end
  proc( i16 : i -> ) =>: export: printI16   i i32 cast printI32 end
  proc( f16 : f -> ) =>: export: printF16
    char8 16 array : mut: buffer
    buffer@ sb.wrapBuffer
      f f16.sbAppend
    sb.asStr printS
  end
  proc( f32 : f -> ) =>: export: printF32
    char8 16 array : mut: buffer
    buffer@ sb.wrapBuffer
      f f32.sbAppend
    sb.asStr printS
  end
  proc( f64 : f -> ) =>: export: printF64
    char8 24 array : mut: buffer
    buffer@ sb.wrapBuffer
      f f64.sbAppend
    sb.asStr printS
  end
  proc( f128 : f -> ) =>: export: printF128
    char8 40 array : mut: buffer
    buffer@ sb.wrapBuffer
      f f128.sbAppend
    sb.asStr printS
  end
  proc( i32 : i -> ) =>: export: printlnI32
    char8 12 array : mut: buffer
    buffer@ sb.wrapBuffer
      i i32.sbAppend
      '\n' sb.appendC
    sb.asStr printS
  end
  proc( i64 : i -> ) =>: export: printlnI64
    char8 24 array : mut: buffer
    buffer@ sb.wrapBuffer
      i i64.sbAppend
      '\n' sb.appendC
    sb.asStr printS
  end
  proc( i128 : i -> ) =>: export: printlnI128
    char8 48 array : mut: buffer ## -170141183460469231731687303715884105728\n
    buffer@ sb.wrapBuffer
      i i128.sbAppend
      '\n' sb.appendC
    sb.asStr printS
  end
  proc( iSize : i -> ) =>: export: printlnZ
    char8 24 array : mut: buffer
    buffer@ sb.wrapBuffer
      i iSize.sbAppend
      '\n' sb.appendC
    sb.asStr printS
  end
  proc( i8 : i -> ) =>: export: printlnI8 i i32 cast printlnI32 end
  proc( i16 : i -> ) =>: export: printlnI16 i i32 cast printlnI32 end
  proc( f16 : f -> ) =>: export: printlnF16
    char8 16 array : mut: buffer
    buffer@ sb.wrapBuffer
      f f16.sbAppend
      '\n' sb.appendC
    sb.asStr printS
  end
  proc( f32 : f -> ) =>: export: printlnF32
