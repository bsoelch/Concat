  overload: export: print
    printC printS printBool
    printI8 printI16 printI32 printI64 printI128 printZ
    printF16 printF32 printF64 printF128
  end
  overload: export: println
    printlnC printlnS printlnBool
    printlnI8 printlnI16 printlnI32 printlnI64 printlnI128 printlnZ
    printlnF16 printlnF32 printlnF64 printlnF128
  end
  overload: export: eprint
    eprintC eprintS
  end
  overload: export: eprintln
    eprintlnC eprintlnS
  end
  overload: export: printX
    printX8 printX16 printX32 printX64 printXZ printX128
    printXF16 printXF32 printXF64 printXF128
  end
  overload: export: printXln
    printXln8 printXln16 printXln32 printXln64 printXlnZ printXln128
    printXlnF16 printXlnF32 printXlnF64 printXlnF128
  end
  overload: export: printU printU8 printU16 printU32 printU64 printUZ printU128 end
  overload: export: printUln printUln8 printUln16 printUln32 printUln64 printUlnZ printUln128 end
end

"future/int" ..compiler.hasImport if "future/printInt" import end
"future/float" ..compiler.hasImport  if "future/printFloat" import end
