import file

namespace: io
  proc( char8 : c -> ) =>: export: printC
    file.stdOut c@ string.wrap file.write ..drop
  end
  proc( string : s -> ) =>: export: printS
    file.stdOut s file.write ..drop
  end
  proc( bool -> ) =>: export: printB
    if "true":s else "false":s end printS
  end
  overload: export: print printC printS printB end
  proc( char8 : c -> ) =>: export: printlnC
    char8 2 array : mut: chrs
    c chrs@ 0 =[]
    '\n' chrs@ 1 =[]
    chrs@ string.wrap printS
  end
  proc( bool -> ) =>: export: printlnB
    if "true\n":s else "false\n":s end printS
  end
  proc( string : s -> ) =>: export: printlnS
    s printS '\n' printC
  end
  overload: export: println printlnC printlnS printlnB end
end
