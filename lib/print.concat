    sb.asStr printS
  end
  proc( i8 : i -> ) =>: export: printU8   i i32 cast.u printU32 end
  proc( i16 : i -> ) =>: export: printU16   i i32 cast.u printU32 end
  proc( i128 : i -> ) =>: export: printU128
    char8 48 array : mut: buffer ## -170141183460469231731687303715884105728\n
    buffer@ sb.wrapBuffer
      i i128.sbAppendU
    sb.asStr printS
  end
