    buffer@ sb.wrapBuffer
      i iSize.sbAppendX
      '\n' sb.appendC
    sb.asStr printS
  end
  proc( i8 : i -> ) =>: export: printXln8   i i32 cast.s printXln32 end
  proc( i16 : i -> ) =>: export: printXln16   i i32 cast.s printXln32 end
  proc( i128 : i -> ) =>: export: printXln128
    char8 40 array : mut: buffer ## -80000000000000000000000000000000
    buffer@ sb.wrapBuffer
