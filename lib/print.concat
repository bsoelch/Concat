  proc( i32 : i -> ) =>: export: printX32
    char8 12 array : mut: buffer ## -80000000
    buffer@ sb.wrapBuffer
      i i32.sbAppendX
    sb.asStr printS
  end
  proc( i64 : i -> ) =>: export: printX64
    char8 24 array : mut: buffer ## -8000000000000000
    buffer@ sb.wrapBuffer
      i i64.sbAppendX
    sb.asStr printS
  end
  proc( iSize : i -> ) =>: export: printXZ
    char8 24 array : mut: buffer ## -8000000000000000
    buffer@ sb.wrapBuffer
      i iSize.sbAppendX
    sb.asStr printS
  end
  proc( i8 : i -> ) =>: export: printX8   i i32 cast.s printX32 end
  proc( i16 : i -> ) =>: export: printX16   i i32 cast.s printX32 end
  proc( i128 : i -> ) =>: export: printX128
    char8 40 array : mut: buffer ## -80000000000000000000000000000000
    buffer@ sb.wrapBuffer
