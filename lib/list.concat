import mem
import arrayView
import optional
import array

## XXX allow auto-cast from list -> arrayView

#:if:exp
( type : T -> type ) =>: export list
  struct( T _ ptr mut : mut data i64 : mut length i64 : mut cap )
end
#:else
#template type : T #end
struct( T _ ptr mut : mut data i64 : mut length i64 : mut cap ) =:: export list
#:end

namespace: list
  #:ifnot:exp
  #template type : T #end
  proc( i64 : k -> T list ) =>: export create
  #:else
  proc( i64 : k type : T -> T list ) =>: export create
  #:end
    k T mem.alloc  0 k  T list new return
  end

  ## creates zero-initialized list of the given length
  #:ifnot:exp
  #template type : T #end
  proc( i64 : k -> T list ) =>: export createZeroInit
  #:else
  proc( i64 : k type : T -> T list ) =>: export createZeroInit
  #:end
    k T mem.calloc  k k  T list new return
  end
  #:ifnot:exp
  #template type : T #end
  proc( T arrayView : data -> T list ) =>: export fromArray
  #:else
  proc(
    type : auto T
    T arrayView : data
  -> T list ) =>: export fromArray
  #:end
    data .length ..dup 8 / + =:: C
    C T mem.alloc =:: p
    p data .data data .length mem.copy data .length C T list new return
  end
  #:ifnot:exp
  #template type : T #end
  proc( T list : src -> T list ) =>: export copy
  #:else
  proc(
    type : auto T
    T list : src
  -> T list ) =>: export copy
  #:end
    ## list
      src .cap T mem.alloc
        src .data
        src .length
      mem.copy
      src .length
      src .cap
    T list new return
  end
  #:ifnot:exp
  #template type : T #end
  proc( T list : src ( T -> T ) ptr : copyElt -> T list ) =>: export deepCopy
  #:else
  proc(
    type : auto T
    T list : src
    ( T -> T ) ptr : copyElt
  -> T list ) =>: export deepCopy
  #:end
    ## list
      src .cap T mem.alloc
      src .length
      src .cap
    T list new =:: newList
    0 while ..dup newList .length < do =:: i
      src .data i []
        copyElt ()
      newList .data i [] =
      i 1 +
    end ..drop
    newList return
  end

  #:ifnot:exp
  #template type : T #end
  proc( T list : elts0 i64 : minCap -> T list ) =>: export ensureCap
  #:else
  proc(
    type : auto T
    T list : elts0
    i64 : minCap
  -> T list ) =>: export ensureCap
  #:end
    elts0 .cap minCap > if
      elts0 return
    end
    elts0 =:: mut elts
      minCap minCap 8 / + 8 + =:: newCap
      elts .data
        newCap mem.realloc
      elts .data =
      newCap elts .cap =
    elts return
  end
  #:ifnot:exp
  #template type : T #end
  proc( T list : elts -> T list ) =>: export free
  #:else
  proc( type : auto T T list : elts -> T list ) =>: export free
  #:end
    elts .data mem.free
    T mem.nullPtr 0 0 T list new return
  end
  #:ifnot:exp
  #template type : T #end
  proc( T list : elts0 -> T list ) =>: export clear
  #:else
  proc( type : auto T T list : elts0 -> T list ) =>: export clear
  #:end
    elts0 =:: mut elts
      0 elts .length =
    elts return
  end
  #:ifnot:exp
  #template type : T #end
  proc( T list : src i64 : newLength -> T list ) =>: export setLength
  #:else
  proc(
    type : auto T
    T list : src
    i64 : newLength
  -> T list ) =>: export setLength
  #:end
    newLength 0 < if
      ## TODO error handling
      ..unreachable
    end
    src =:: mut l
    l
      newLength ensureCap
    l =
    newLength l .length =
    l return
  end

  #:ifnot:exp
  #template type : T #end
  proc( T list : elts i64 : index -> T ) =>: export get
  #:else
  proc(
    type : auto T
    T list : elts
    i64 : index
  -> T ) =>: export get
  #:end
    index 0 < index elts .length >= | if
      ## TODO error handling
      ..unreachable
    end
    elts .data index [] return
  end
  #:ifnot:exp
  #template type : T #end
  proc( T list : elts i64 : index -> T ptr mut optional ) =>: export at
  #:else
  proc(
    type : auto T
    T list : elts
    i64 : index
  -> T ptr mut optional ) =>: export at
  #:end
    index 0 < index elts .length >= | if
      T ptr mut optional.empty return
    end
    elts .data index + T ptr mut cast! optional.wrap return
  end
  #:ifnot:exp
  #template type : T #end
  proc( T : elt T list : elts i64 : index -> ) =>: export set
  #:else
  proc(
    type : auto T
    T : elt
    T list : elts
    i64 : index
  -> ) =>: export set
  #:end
    index 0 < index elts .length >= | if
      ## TODO error handling
      ..unreachable
    end
    elt elts .data index [] =
  end
  #:ifnot:exp
  #template type : T #end
  proc( T list : elts0 T : elt -> T list ) =>: export append
  #:else
  proc(
    type : auto T
    T list : elts0
    T : elt
  -> T list ) =>: export append
  #:end
    elts0 =:: mut elts
      elts
        elts .length 1 + ensureCap
      elts =
      elt elts .data
        elts .length
      [] =
      elts .length
        1 +
      elts .length =
    elts return
  end
  #:ifnot:exp
  #template type : T #end
  proc( T list : a i64 : auto k  T k ptr : b -> T list ) =>: export appendP
  #:else
  proc(
    type : auto T
    T list : a
    i64 : auto k
    T k ptr : b
  -> T list ) =>: export appendP
  #:end
    a =:: mut elts
      elts
        elts .length k + ensureCap
      elts =
      elts .data elts .length + b T _ ptr cast k mem.copy ..drop
      elts .length k + elts .length =
    elts return
  end
  #:ifnot:exp
  #template type : T #end
  proc( T list : a T arrayView : b -> T list ) =>: export appendArray
  #:else
  proc(
    type : auto T
    T list : a
    T arrayView : b
  -> T list ) =>: export appendArray
  #:end
    a =:: mut elts
      elts
        elts .length b .length + ensureCap
      elts =
      elts .data elts .length + b .data b .length mem.copy ..drop
      elts .length   b .length + elts .length =
    elts return
  end
  #:ifnot:exp
  #template type : T #end
  proc( T list : a T list : b -> T list ) =>: export appendAll
  #:else
  proc(
    type : auto T
    T list : a
    T list : b
  -> T list ) =>: export appendAll
  #:end
    a =:: mut elts
      elts
        elts .length b .length + ensureCap
      elts =
      elts .data elts .length + b .data b .length mem.copy ..drop
      elts .length   b .length + elts .length =
    elts return
  end

  #:ifnot:exp
  #template type : T #end
  proc( T list : a T : elt i64 : index -> T list ) =>: export insert
  #:else
  proc(
    type : auto T
    T list : a
    T : elt
    i64 : index
  -> T list ) =>: export insert
  #:end
    a =:: mut elts
    elts
      elts .length 1 + ensureCap
    elts =
    elts .data index 1 + + elts .data index + elts .length index - mem.move ..drop
    elt elts .data index [] =
    elts .length 1 + elts .length =
    elts return
  end
  #:ifnot:exp
  #template type : T #end
  proc( T list : a i64 : auto k  T k ptr : b i64 : index -> T list ) =>: export insertP
  #:else
  proc(
    type : auto T
    T list : a
    i64 : auto k
    T k ptr : b
    i64 : index
  -> T list ) =>: export insertP
  #:end
    a =:: mut elts
    elts
      elts .length k + ensureCap
    elts =
    elts .data index k + +  elts .data index +  elts .length index -  mem.move ..drop
    elts .data index +  b T _ ptr cast  k  mem.copy ..drop
    elts .length k + elts .length =
    elts return
  end
  #:ifnot:exp
  #template type : T #end
  proc( T list : a T arrayView : b i64 : index -> T list ) =>: export insertArray
  #:else
  proc(
    type : auto T
    T list : a
    T arrayView : b
    i64 : index
  -> T list ) =>: export insertArray
  #:end
    a =:: mut elts
    elts
      elts .length b .length + ensureCap
    elts =
    elts .data index b .length + +  elts .data index +  elts .length index -  mem.move ..drop
    elts .data index +  b .data b .length  mem.copy ..drop
    elts .length b .length + elts .length =
    elts return
  end
  #:ifnot:exp
  #template type : T #end
  proc( T list : a T list : b i64 : index -> T list ) =>: export insertAll
  #:else
  proc(
    type : auto T
    T list : a
    T list : b
    i64 : index
  -> T list ) =>: export insertAll
  #:end
    a =:: mut elts
    elts
      elts .length b .length + ensureCap
    elts =
    elts .data index b .length + +  elts .data index +  elts .length index -  mem.move ..drop
    elts .data index +  b .data b .length  mem.copy ..drop
    elts .length b .length + elts .length =
    elts return
  end


  #:ifnot:exp
  #template type : T #end
  proc( T list : elts -> T ptr mut optional ) =>: export peek
  #:else
  proc(
    type : auto T
    T list : elts
  -> T ptr mut optional ) =>: export peek
  #:end
    elts .length 0 <= if
      T ptr mut optional.empty return
    end
    elts .data elts .length 1 - + T ptr mut cast! optional.wrap return
  end
  #:ifnot:exp
  #template type : T #end
  proc( T list  T -> T list ) =>: export push
  #:else
  proc(
    type : auto T
    T list
    T
  -> T list ) =>: export push
  #:end
    append return
  end
  #:ifnot:exp
  #template type : T #end
  proc( T list : elts0 -> T list T ) =>: export pop
  #:else
  proc(
    type : auto T
    T list : elts0
  -> T list T ) =>: export pop
  #:end
    elts0 .length 0 <= if
      ## TODO error handling
      ..unreachable
    end
    elts0 =:: mut elts
    elts .length 1 - elts .length =
    ## return
      elts
      elts .data elts .length []
    return
  end


  #:ifnot:exp
  #template type : T #end
  proc( T list : elts -> T arrayView ) =>: export asArray
  #:else
  proc(
    type : auto T
    T list : elts
  -> T arrayView ) =>: export asArray
  #:end
    elts .data elts .length array.create return
  end
  #:ifnot:exp
  #template type : T #end
  proc( T list : elts i64 : from i64 : len -> T arrayView ) =>: export slice
  #:else
  proc(
    type : auto T
    T list : elts
    i64 : from
    i64 : len
  -> T arrayView ) =>: export slice
  #:end
    elts asArray from len array.slice return
  end

  #:ifnot:exp
  #template type : T type : C #end
  proc(
    T list : elts
    proc( T T C -> i32 ) ptr : cmp
    C : context
  -> ) =>: export sort
  #:else
  proc(
    type : auto T
    type : auto C
    T list : elts
    proc( T T C -> i32 ) ptr : cmp
    C : context
  -> ) =>: export sort
  #:end
    ## sort
      elts .data
      elts .length
      cmp
      context
    array.sort
  end
  #:ifnot:exp
  #template type : T #end
  proc(
    T list : elts
  -> ) =>: export reverse
  #:else
  proc(
    type : auto T
    T list : elts
  -> ) =>: export reverse
  #:end
    ## sort
      elts .data
      elts .length
    array.reverse
  end
end
