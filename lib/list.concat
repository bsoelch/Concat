import mem
import arrayView
import optional
import array

## XXX allow auto-cast from list -> arrayView

## negative capacity indictes fixed buffer
namespace: list
  i64 =:: listCap
end

( type : T -> type ) =>: export: list
  struct( T _ ptr.mut : mut: data i64 : mut: length list.listCap : mut: cap )
end

namespace: list
  ( type : T -> T list ) =>: export: static: empty
    { { } : data 0 : length 0:listCap : cap } T list cast
  end
  proc( i32 : k type : T -> T list ) =>: export: create_32
    k i64 cast.s T create_64
  end
  proc( i64 : k type : T -> T list ) =>: export: create_64
    k 0 >= "list has non-negative capacity" assert
    k T mem.alloc  0 k listCap cast.u T list new return
  end
  overload: export: create create_32 create_64 end

  ## creates zero-initialized list of the given length
  proc( i64 : k type : T -> T list ) =>: export: createZeroInit
    k 0 >= "list has non-negative capacity" assert
    k T mem.calloc  k k listCap cast.u T list new return
  end
  proc(
    type : auto: T
    T arrayView : data
  -> T list ) =>: export: fromArray
    data .length ..dup 8 / + =:: C
    C 0 >= "list has non-negative capacity" assert
    ## list
      C T mem.alloc
        data .data
        data .length
      mem.copy
      data .length
      C listCap cast.u
    T list new return
  end
  ## creates a fixed size list backed by the buffer
  proc(
    type : auto: T
    T _ ptr.mut : buffer
    i32 : buffSize
  -> T list ) =>: export: fromBuffer
    buffer 0 buffSize -_ listCap cast.u T list new return
  end
  proc(
    type : auto: T
    T list : src
  -> T list ) =>: export: copy
    src .cap i64 cast.s
      $ 0 < if -_ end
    =:: srcCap
    ## list
      srcCap T mem.alloc
        src .data
        src .length
      mem.copy
      src .length
      srcCap listCap cast.s
    T list new return
  end
  proc(
    type : auto: T
    T list : src
    ( T -> T ) ptr : copyElt
  -> T list ) =>: export: deepCopy
    src .cap i64 cast.s
      $ 0 < if -_ end
    =:: srcCap
    ## list
      srcCap T mem.alloc
      src .length
      srcCap listCap cast.s
    T list new =:: newList
    0 while ..dup newList .length < do =:: i
      src .data i []
        copyElt ()
      newList .data i []=
      i 1 +
    end ..drop
    newList return
  end

  proc(
    type : auto: T
    T list : elts
    i32 : minCap
  -> T list ) =>: export: ensureCap_32
    elts minCap i64 cast.s ensureCap_64
  end
  proc(
    type : auto: T
    T list : elts
    i64 : minCap
  -> T list ) =>: export: ensureCap_64
    elts .cap i64 cast.s
      $ 0 < if -_ end
    =:: prevCap
    prevCap minCap > if
      elts return
    end
    elts .cap i64 cast.s 0 >= "fixed buffer list is not reallocated" assert
    elts
      minCap minCap 8 / + 8 + =:: newCap
      newCap 0 >= "list has non-negative capacity" assert
      $ .data  newCap mem.realloc  >$ .data=
      newCap listCap cast.u >$ .cap=
    return
  end
  overload: export: ensureCap ensureCap_32 ensureCap_64 end
  proc( type : auto: T T list : elts -> T list ) =>: export: free
    elts .data mem.free
    T mem.nullPtr 0 0:listCap T list new return
  end
  proc( type : auto: T T list : elts -> T list ) =>: export: clear
    elts
      0 >$ .length=
    return
  end
  proc(
    type : auto: T
    T list : src
    i64 : newLength
  -> T list ) =>: export: setLength
    newLength 0 < if
      "negative new length" ..panic
    end
    src
      newLength ensureCap
      newLength >$ .length=
    return
  end

  proc(
    type : auto: T
    T list : elts
    i32 : index
  -> T ) =>: export: get_32
    elts index i64 cast.s get_64
  end
  proc(
    type : auto: T
    T list : elts
    i64 : index
  -> T ) =>: export: get_64
    index 0 < or index elts .length >= if
      "list index outside range" ..panic
    end
    elts .data index [] return
  end
  overload: export: get
    get_32 get_64
  end
  proc(
    type : auto: T
    T list : elts
    i32 : index
  -> T ptr.mut optional ) =>: export: at_32
    elts index i64 cast.s at_64
  end
  proc(
    type : auto: T
    T list : elts
    i64 : index
  -> T ptr.mut optional ) =>: export: at_64
    index 0 < or index elts .length >= if
      T ptr.mut optional.empty return
    end
    elts .data index + T ptr.mut cast! optional.wrap return
  end
  overload: export: at
    at_32 at_64
  end
  proc(
    type : auto: T
    T : elt
    T list : elts
    i32 : index
  -> ) =>: export: set_32
    elt elts index i64 cast.s set_64
  end
  proc(
    type : auto: T
    T : elt
    T list : elts
    i64 : index
  -> ) =>: export: set_64
    index 0 < or index elts .length >= if
      "list index outside range" ..panic
    end
    elt elts .data index []=
  end
  overload: export: set
    set_32 set_64
  end
  proc(
    type : auto: T
    T list : elts
    T : elt
  -> T list ) =>: export: append
    elts
      $ .length 1 + ensureCap
      elt $1 .data $2 .length []=
      $ .length 1 + >$ .length=
    return
  end
  proc(
    type : auto: T
    T list : elts
    i64 : auto: k
    T k ptr : p
  -> T list ) =>: export: appendP
    elts
      $ .length k + ensureCap
      $ .data $1 .length + p T _ ptr cast k mem.copy ..drop
      $ .length k + >$ .length=
    return
  end
  proc(
    type : auto: T
    T list : a
    T arrayView : b
  -> T list ) =>: export: appendArray
    a
      $ .length b .length + ensureCap
      $ .data $1 .length + b .data b .length mem.copy ..drop
      $ .length b .length + >$ .length=
    return
  end
  proc(
    type : auto: T
    T list : a
    T list : b
  -> T list ) =>: export: appendAll
    a
      $ .length b .length + ensureCap
      $ .data $1 .length + b .data b .length mem.copy ..drop
      $ .length b .length + >$ .length=
    return
  end

  proc(
    type : auto: T
    T list : a
    T : elt
    i64 : index
  -> T list ) =>: export: insert
    index 0 < or index elts .length > if
      "list index outside range" ..panic
    end
    a
      $ .length 1 + ensureCap
      $ .data index 1 + + $1 .data index + $2 .length index - mem.move ..drop
      elt $1 .data index []=
      $ .length 1 + >$ .length=
    return
  end
  proc(
    type : auto: T
    T list : a
    i64 : auto: k
    T k ptr : b
    i64 : index
  -> T list ) =>: export: insertP
    index 0 < or index elts .length > if
      "list index outside range" ..panic
    end
    a
      $ .length k + ensureCap
      $ .data index k + +  $1 .data index +  $2 .length index -  mem.move ..drop
      $ .data index +  b T _ ptr cast  k  mem.copy ..drop
      $ .length k + >$ .length=
    return
  end
  proc(
    type : auto: T
    T list : a
    T arrayView : b
    i64 : index
  -> T list ) =>: export: insertArray
    index 0 < or index elts .length > if
      "list index outside range" ..panic
    end
    a
      $ .length b .length + ensureCap
      $ .data index b .length + +  $1 .data index +  $2 .length index -  mem.move ..drop
      $ .data index +  b .data b .length  mem.copy ..drop
      $ .length b .length + >$ .length=
    return
  end
  proc(
    type : auto: T
    T list : a
    T list : b
    i64 : index
  -> T list ) =>: export: insertAll
    index 0 < or index elts .length > if
      "list index outside range" ..panic
    end
    a
      $ .length b .length + ensureCap
      $ .data index b .length + +  $1 .data index +  $2 .length index -  mem.move ..drop
      $ .data index +  b .data b .length  mem.copy ..drop
      $ .length b .length + >$ .length=
    return
  end

  proc(
    type : auto: T
    T list : elts
  -> T ptr.mut optional ) =>: export: peek
    elts .length 0 <= if
      T ptr.mut optional.empty return
    end
    elts .data elts .length 1 - + T ptr.mut cast! optional.wrap return
  end
  proc(
    type : auto: T
    T list
    T
  -> T list ) =>: export: push
    append return
  end
  proc(
    type : auto: T
    T list : elts
  -> T list T ) =>: export: pop
    elts .length 0 <= if
      "pop from empty list" ..panic
    end
    elts
      $ .length 1 - >$ .length=
      $ .data $1 .length []
    return
  end

  proc(
    type : auto: T
    T list : elts
  -> T arrayView ) =>: export: asArray
    elts .data elts .length array.create return
  end
  proc(
    type : auto: T
    T list : elts
  -> T arrayView.mut ) =>: export: asMutableArray
    elts .data elts .length array.createMutable return
  end
  proc(
    type : auto: T
    T list : elts
    i64 : from
    i64 : len
  -> T arrayView ) =>: export: slice
    elts asArray from len array.slice return
  end

  proc(
    type : auto: T
    type : auto: C
    T list : elts
    proc( T T C -> i32 ) ptr : cmp
    C : context
  -> ) =>: export: sort
    ## sort
      elts .data
      elts .length
      cmp
      context
    array.sort
  end
  proc(
    type : auto: T
    T list : elts
  -> ) =>: export: reverse
    ## reverse
      elts .data
      elts .length
    array.reverse
  end
end
