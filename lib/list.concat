import mem
import slice
import optional
import array

## XXX allow auto-cast from list -> slice

## negative capacity indictes fixed buffer
namespace: list
  i32 =:: listCap
end

( type : T -> type ) =>: export: list
  struct( T _ ptr.mut : data i32 : length list.listCap : cap )
end

namespace: list
  ( type : T -> T list ) =>: export: static: empty
    { { } : data 0 : length 0:listCap : cap }
  end
  proc( i32 : k type : T -> T list ) =>: export: create_32
    k i64 cast.s T create_64
  end
  proc( i64 : k type : T -> T list ) =>: export: create_64
    k 0 >= "list has non-negative capacity" assert
    k i32.MAX i64 cast.u < "list capacity fits into i32" assert
    k T mem.alloc  0 k listCap cast.u T list new return
  end
  overload: export: create create_32 create_64 end

  ## creates zero-initialized list of the given length
  proc( i64 : k type : T -> T list ) =>: export: createZeroInit
    k 0 >= "list has non-negative capacity" assert
    k i32.MAX i64 cast.u < "list capacity fits into i32" assert
    k T mem.calloc  k k listCap cast.u T list new return
  end
  proc(
    type : auto: T
    T slice : data
  -> T list ) =>: export: fromSlice
    data .length i32.MAX i64 cast.u < "slice length fits into i32" assert
    data .length ..dup 8 / + i32.MAX i64 cast.u i64.min =:: C
    C 0 >= "list has non-negative capacity" assert
    ## list
      C T mem.alloc
        data .data
        data .length
      mem.copy
      data .length
      C listCap cast.u
    T list new return
  end
  ## creates a fixed size list backed by the buffer
  proc(
    type : auto: T
    T _ ptr.mut : buffer
    i32 : buffSize
  -> T list ) =>: export: fromBuffer
    buffer 0 buffSize -_ listCap cast.u T list new return
  end
  proc(
    type : auto: T
    i32 : auto: k
    T k ptr.mut : buffer
  -> T list ) =>: export: wrapBuffer
    buffer 0 k -_ listCap cast.u T list new return
  end
  proc(
    type : auto: T
    T list : src
  -> T list ) =>: export: copy
    src .cap i64 cast.s
      $ 0 < if -_ end
    =:: srcCap
    ## list
      srcCap T mem.alloc
        src .data
        src .length i64 cast.u
      mem.copy
      src .length
      srcCap listCap cast.s
    T list new return
  end
  proc(
    type : auto: T
    T list : src
    ( T -> T ) ptr : copyElt
  -> T list ) =>: export: deepCopy
    src .cap i64 cast.s
      $ 0 < if -_ end
    =:: srcCap
    ## list
      srcCap T mem.alloc
      src .length
      srcCap listCap cast.s
    T list new =:: newList
    0 while ..dup newList .length < do =:: i
      src .data i []
        copyElt ()
      newList .data i =[]
      i 1 +
    end ..drop
    newList return
  end

  proc(
    type : auto: T
    T list : elts
    i32 : minCap
  -> T list ) =>: export: ensureCap_32
    elts minCap i64 cast.s ensureCap_64
  end
  proc(
    type : auto: T
    T list : elts
    i64 : minCap
  -> T list ) =>: export: ensureCap_64
    elts .cap i64 cast.s
      $ 0 < if -_ end
    =:: prevCap
    prevCap minCap >= if
      elts return
    end
    minCap i32.MAX i64 cast.u < "new capacity fits into i32" assert
    elts .cap i64 cast.s 0 >= "fixed buffer list is not reallocated" assert
    elts
      minCap $ 2 / + 8 + i32.MAX i64 cast.u i64.min =:: newCap
      newCap 0 >= "list has non-negative capacity" assert
      $ .data  newCap mem.realloc  >$ .data=
      newCap listCap cast.u >$ .cap=
    return
  end
  overload: export: ensureCap ensureCap_32 ensureCap_64 end
  proc( type : auto: T T list : elts -> T list ) =>: export: free
    elts .cap i64 cast.s 0 > if ## cap <= 0 -> no allocated memory
      elts .data mem.free
    end
    T mem.nullPtr 0 0:listCap T list new return
  end
  proc( type : auto: T T list : elts -> T list ) =>: export: clear
    elts
      0 >$ .length=
    return
  end
  proc(
    type : auto: T
    T list : src
    i32 : newLength
  -> T list ) =>: export: setLength32
    newLength 0 < if
      "negative new length" ..panic
    end
    src
      newLength ensureCap
      newLength >$ .length=
    return
  end
  proc(
    type : auto: T
    T list : src
    i64 : newLength
  -> T list ) =>: export: setLength64
    newLength i32.MAX i64 cast.u > if
      "new length does not fit in an i32" ..panic
    end
    src newLength i32 cast setLength32
  end
  overload: export: setLength setLength32 setLength64 end

  proc(
    type : auto: T
    T list : elts
    i32 : index
  -> T ) =>: export: get_32
    index 0 < or index elts .length >= if
      "list index outside range" ..panic
    end
    elts .data index [] return
  end
  proc(
    type : auto: T
    T list : elts
    i64 : index
  -> T ) =>: export: get_64
    index 0 < or index elts .length i64 cast.u >= if
      "list index outside range" ..panic
    end
    elts .data index [] return
  end
  overload: export: get
    get_32 get_64
  end
  proc(
    type : auto: T
    T list : elts
    i32 : index
  -> T ptr.mut optional ) =>: export: at_32
    elts index i64 cast.s at_64 return
  end
  proc(
    type : auto: T
    T list : elts
    i64 : index
  -> T ptr.mut optional ) =>: export: at_64
    index 0 < or index elts .length i64 cast.u >= if
      T ptr.mut optional.empty return
    end
    elts .data index + T ptr.mut cast! optional.wrap return
  end
  overload: export: at
    at_32 at_64
  end
  proc(
    type : auto: T
    T list : elts
    i32 : index
  -> T ptr.mut ) =>: export: atValue_32
    index 0 < or index elts .length >= if
      "list index outside range" ..panic
    end
    elts .data index + T ptr.mut cast! optional.wrap return
  end
  proc(
    type : auto: T
    T list : elts
    i64 : index
  -> T ptr.mut ) =>: export: atValue_64
    index 0 < or index elts .length i64 cast.u >= if
      "list index outside range" ..panic
    end
    elts .data index + T ptr.mut cast! optional.wrap return
  end
  overload: export: atValue
    atValue_32 atValue_64
  end
  proc(
    type : auto: T
    T : elt
    T list : elts
    i32 : index
  -> ) =>: export: set_32
    index 0 < or index elts .length >= if
      "list index outside range" ..panic
    end
    elt elts .data index =[]
  end
  proc(
    type : auto: T
    T : elt
    T list : elts
    i64 : index
  -> ) =>: export: set_64
    index 0 < or index elts .length i64 cast.u >= if
      "list index outside range" ..panic
    end
    elt elts .data index =[]
  end
  overload: export: set
    set_32 set_64
  end
  proc(
    type : auto: T
    T list : elts
    T : elt
  -> T list ) =>: export: append
    elts
      $ .length 1 + ensureCap
      elt $1 .data $2 .length =[]
      $ .length 1 + >$ .length=
    return
  end
  proc(
    type : auto: T
    T list : elts
    i64 : auto: k
    T k ptr : p
  -> T list ) =>: export: appendP
    elts
      $ .length i64 cast.u k + ensureCap
      $ .data $1 .length @[] p T _ ptr cast k mem.copy ..drop
      $ .length k i32 cast.u + >$ .length=
    return
  end
  proc(
    type : auto: T
    T list : a
    T slice : b
  -> T list ) =>: export: appendSlice
    a
      $ .length i64 cast.u b .length + ensureCap
      $ .data $1 .length @[] b .data b .length mem.copy ..drop
      $ .length b .length i32 cast + >$ .length=
    return
  end
  proc(
    type : auto: T
    T list : a
    T list : b
  -> T list ) =>: export: appendAll
    a
      $ .length b .length + ensureCap
      $ .data $1 .length @[] b .data b .length i64 cast.u mem.copy ..drop
      $ .length b .length + >$ .length=
    return
  end

  proc(
    type : auto: T
    T list : a
    T : elt
    i32 : index
  -> T list ) =>: export: insert
    index 0 < or index elts .length > if
      "list index outside range" ..panic
    end
    a
      $ .length 1 + ensureCap
      $ .data index 1 + + $1 .data index + $2 .length index - mem.move ..drop
      elt $1 .data index =[]
      $ .length 1 + >$ .length=
    return
  end
  proc(
    type : auto: T
    T list : a
    i64 : auto: k
    T k ptr : b
    i32 : index
  -> T list ) =>: export: insertP
    index 0 < or index elts .length > if
      "list index outside range" ..panic
    end
    a
      $ .length k + ensureCap
      $ .data index k + +  $1 .data index +  $2 .length index -  mem.move ..drop
      $ .data index +  b T _ ptr cast  k  mem.copy ..drop
      $ .length k + >$ .length=
    return
  end
  proc(
    type : auto: T
    T list : a
    T slice : b
    i32 : index
  -> T list ) =>: export: insertSlice
    index 0 < or index elts .length > if
      "list index outside range" ..panic
    end
    a
      $ .length b .length + ensureCap
      $ .data index b .length + +  $1 .data index +  $2 .length index -  mem.move ..drop
      $ .data index +  b .data b .length  mem.copy ..drop
      $ .length b .length + >$ .length=
    return
  end
  proc(
    type : auto: T
    T list : a
    T list : b
    i32 : index
  -> T list ) =>: export: insertAll
    index 0 < or index elts .length > if
      "list index outside range" ..panic
    end
    a
      $ .length b .length + ensureCap
      $ .data index b .length + +  $1 .data index +  $2 .length index -  mem.move ..drop
      $ .data index +  b .data b .length  mem.copy ..drop
      $ .length b .length + >$ .length=
    return
  end
  ## XXX? insert64

  proc(
    type : auto: T
    T list : elts
  -> T ptr.mut optional ) =>: export: peek
    elts .length 0 <= if
      T ptr.mut optional.empty return
    end
    elts .data elts .length 1 - @[] T ptr.mut cast! optional.wrap return
  end
  proc(
    type : auto: T
    T list
    T
  -> T list ) =>: export: push
    append return
  end
  proc(
    type : auto: T
    T list : elts
  -> T list T ) =>: export: pop
    elts .length 0 <= if
      "pop from empty list" ..panic
    end
    elts
      $ .length 1 - >$ .length=
      $ .data $1 .length []
    return
  end

  proc(
    type : auto: T
    T list : elts
  -> T slice ) =>: export: asSlice
    elts .data elts .length slice.create return
  end
  proc(
    type : auto: T
    T list : elts
  -> T slice.mut ) =>: export: asMutableSlice
    elts .data elts .length slice.createMutable return
  end
  proc(
    type : auto: T
    T list : elts
    i32 : from
    i32 : len
  -> T slice ) =>: export: getSlice32
    elts asSlice from i64 cast.s len i64 cast.s slice.getSlice return
  end
  proc(
    type : auto: T
    T list : elts
    i64 : from
    i64 : len
  -> T slice ) =>: export: getSlice64
    elts asSlice from len slice.getSlice return
  end
  overload: export: getSlice getSlice32 getSlice64 end

  proc(
    type : auto: T
    type : auto: C
    T list : elts
    proc( T T C -> i32 ) ptr : cmp
    C : context
  -> ) =>: export: sort
    ## sort
      elts .data
      elts .length i64 cast.u
      cmp
      context
    array.sort
  end
  proc(
    type : auto: T
    T list : elts
  -> ) =>: export: reverse
    ## reverse
      elts .data
      elts .length i64 cast.u
    array.reverse
  end
  proc( type : auto: T T list -> T ptr.Itr ) =>: export: getItr
    asSlice slice.getItr
  end
  proc( type : auto: T T list -> T array.MutPtrItr ) =>: export: atItr
    asMutableSlice slice.atItrMut
  end
  proc( type : auto: T T list -> T array.ReverseItr ) =>: export: reversed
    asSlice slice.reversed
  end
  proc( type : auto: T T list -> T array.ReverseMutPtrItr ) =>: export: atReversed
    asMutableSlice slice.atReversedMut
  end
end
overload: export: []
  list.get_32
  list.get_64
end
overload: export: @[]
  list.atValue_32
  list.atValue_64
end
overload: export: =[]
  list.set_32
  list.set_64
end
overload: export: ..itr.prepare
  list.getItr
end
