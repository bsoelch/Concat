#include mem
#include arrayView

## XXX allow auto-cast from list -> arrayView

#template type : T #end
struct( T _ ptr mut : mut data i64 : mut length i64 : mut cap ) =:: public list

#namespace list
  #template type : T #end
  proc( i64 : k => T list ) =: public create
    k T mem.alloc  0 k  T list new return
  end
  #template type : T #end
  proc( T list : elts i64 : minCap => T list ) =: public ensureCap
    elts
      #dup .cap minCap > if
        return
      end
      minCap minCap 8 / + 8 +
        #over .data #over mem.realloc #over:2 .data =
        #over .cap =
    return
  end
  #template type : T #end
  proc( T list => T list ) =: public clear
    #dup .data mem.free
      0 #over .cap =
      0 #over .length =
    return
  end
  #template type : T #end
  proc( T list => T list ) =: public reset
    ## list
      0 #over .length =
    return
  end
  #template type : T #end
  proc( T list : elts T : elt => T list ) =: public append
    elts
      #dup .length 1 + ensureCap
      elt #over .data #over:2 .length ++ [] =
    return
  end
  #template type : T #end
  proc( T list  T => T list ) =: public push
    append return
  end
  #template type : T #end
  proc( T list : a i64 : static k  T k ptr : b => T list ) =: public appendP
    a
      #dup .length k + ensureCap
      #dup .data #over .length + b i8 _ ptr cast k mem.copy #drop
      #dup .length k + #over .length =
    return
  end
  #template type : T #end
  proc( T list : a T arrayView : b => T list ) =: public appendArray
    a
      #dup .length   b .length + ensureCap
      #dup .data #over .length + b .data b .length mem.copy #drop
      #dup .length   b .length + #over .length =
    return
  end
  #template type : T #end
  proc( T list : a T list : b => T list ) =: public appendAll
    a
      #dup .length   b .length + ensureCap
      #dup .data #over .length + b .data b .length mem.copy #drop
      #dup .length   b .length + #over .length =
    return
  end

  #template type : T #end
  proc( T list : elts i64 : index => T ) =: public get
    index 0 < index elts .length >= | if
      ## TODO error handling
    end
    elts .data index [] return
  end
  #template type : T #end
  proc( T list : elts i64 : index => T _ ptr mut ) =: public at
    index 0 < index elts .length >= | if
      ## TODO error handling
    end
    elts .data index + return
  end
  #template type : T #end
  proc( T : elt T list : elts i64 : index => ) =: public set
    index 0 < index elts .length >= | if
      ## TODO error handling
    end
    elt elts .data index [] =
  end
  #template type : T #end
  proc( T list : elts => T ) =: public peek
    elts .length 0 <= if
      ## TODO error handling
    end
    elts .data elts .length 1 - [] return
  end
  #template type : T #end
  proc( T list : elts => T list T ) =: public pop
    elts .length 0 <= if
      ## TODO error handling
    end
    elts
      #dup .length 1 - #over .length =
    #dup .data #over .length [] return
  end
  ## XXX insert


  #template type : T #end
  proc( T list : elts => T arrayView ) =: public asArray
    elts .data elts .length array.create return
  end
  #template type : T #end
  proc( T list : elts i64 : from i64 : len => T arrayView ) =: public slice
    elts asArray from len array.slice return
  end
#end
