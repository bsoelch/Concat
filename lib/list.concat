import mem
import arrayView
import optional
import array

## XXX allow auto-cast from list -> arrayView

#template type : T #end
struct( T _ ptr mut : mut data i64 : mut length i64 : mut cap ) =:: export list

namespace: list
  #template type : T #end
  proc( i64 : k -> T list ) =>: export create
    k T mem.alloc  0 k  T list new return
  end
  #template type : T #end
  proc( i64 : k -> T list ) =>: export createZeroInit ## creates zero-initialized list of the given length
    k T mem.calloc  k k  T list new return
  end
  #template type : T #end
  proc( T arrayView : data -> T list ) =>: export fromArray
    data .length ..dup 8 / + =:: C
    C T mem.alloc =:: p
    p data .data data .length mem.copy data .length C T list new return
  end
  #template type : T #end
  proc( T list : src -> T list ) =>: export copy
    ## list
      src .cap T mem.alloc
        src .data
        src .length
      mem.copy
      src .length
      src .cap
    T list new return
  end
  #template type : T #end
  proc( T list : src ( T -> T ) ptr : copyElt -> T list ) =>: export deepCopy
    ## list
      src .cap T mem.alloc
      src .length
      src .cap
    T list new =:: newList
    0 while ..dup newList .length < do =:: i
      src .data i []
        copyElt ()
      newList .data i [] =
      i 1 +
    end ..drop
    newList return
  end

  #template type : T #end
  proc( T list : elts i64 : minCap -> T list ) =>: export ensureCap
    elts
      ..dup .cap minCap > if
        return
      end
      minCap minCap 8 / + 8 +
        ..over .data ..over mem.realloc ..over.2 .data =
        ..over .cap =
    return
  end
  #template type : T #end
  proc( T list -> T list ) =>: export free
    ..dup .data mem.free
      0 ..over .cap =
      0 ..over .length =
    return
  end
  #template type : T #end
  proc( T list -> T list ) =>: export clear
    ## list
      0 ..over .length =
    return
  end
  #template type : T #end
  proc( T list : src i64 : newLength -> T list ) =>: export setLength
    newLength 0 < if
      ## TODO error handling
      ..unreachable
    end
    src =:: mut l
    l newLength ensureCap l =
    newLength l .length =
    l return
  end

  #template type : T #end
  proc( T list : elts i64 : index -> T ) =>: export get
    index 0 < index elts .length >= | if
      ## TODO error handling
      ..unreachable
    end
    elts .data index [] return
  end
  #template type : T #end
  proc( T list : elts i64 : index -> T ptr mut optional ) =>: export at
    index 0 < index elts .length >= | if
      T ptr mut optional.empty return
    end
    elts .data index + T ptr mut cast! optional.wrap return
  end
  #template type : T #end
  proc( T : elt T list : elts i64 : index -> ) =>: export set
    index 0 < index elts .length >= | if
      ## TODO error handling
      ..unreachable
    end
    elt elts .data index [] =
  end
  #template type : T #end
  proc( T list : elts T : elt -> T list ) =>: export append
    elts
      ..dup .length 1 + ensureCap
      elt ..over .data ..over.2 .length [] =
      ..dup .length 1 + ..over .length =
    return
  end
  #template type : T #end
  proc( T list : a i64 : auto k  T k ptr : b -> T list ) =>: export appendP
    a
      ..dup .length k + ensureCap
      ..dup .data ..over .length + b T _ ptr cast k mem.copy ..drop
      ..dup .length k + ..over .length =
    return
  end
  #template type : T #end
  proc( T list : a T arrayView : b -> T list ) =>: export appendArray
    a
      ..dup .length   b .length + ensureCap
      ..dup .data ..over .length + b .data b .length mem.copy ..drop
      ..dup .length   b .length + ..over .length =
    return
  end
  #template type : T #end
  proc( T list : a T list : b -> T list ) =>: export appendAll
    a
      ..dup .length   b .length + ensureCap
      ..dup .data ..over .length + b .data b .length mem.copy ..drop
      ..dup .length   b .length + ..over .length =
    return
  end

  #template type : T #end
  proc( T list : a T : elt i64 : index -> T list ) =>: export insert
    a =:: mut elts
    elts
      elts .length 1 + ensureCap
    elts =
    elts .data index 1 + + elts .data index + elts .length index - mem.move ..drop
    elt elts .data index [] =
    elts .length 1 + elts .length =
    elts return
  end
  #template type : T #end
  proc( T list : a i64 : auto k  T k ptr : b i64 : index -> T list ) =>: export insertP
    a =:: mut elts
    elts
      elts .length k + ensureCap
    elts =
    elts .data index k + +  elts .data index +  elts .length index -  mem.move ..drop
    elts .data index +  b T _ ptr cast  k  mem.copy ..drop
    elts .length k + elts .length =
    elts return
  end
  #template type : T #end
  proc( T list : a T arrayView : b i64 : index -> T list ) =>: export insertArray
    a =:: mut elts
    elts
      elts .length b .length + ensureCap
    elts =
    elts .data index b .length + +  elts .data index +  elts .length index -  mem.move ..drop
    elts .data index +  b .data b .length  mem.copy ..drop
    elts .length b .length + elts .length =
    elts return
  end
  #template type : T #end
  proc( T list : a T list : b i64 : index -> T list ) =>: export insertAll
    a =:: mut elts
    elts
      elts .length b .length + ensureCap
    elts =
    elts .data index b .length + +  elts .data index +  elts .length index -  mem.move ..drop
    elts .data index +  b .data b .length  mem.copy ..drop
    elts .length b .length + elts .length =
    elts return
  end


  #template type : T #end
  proc( T list : elts -> T ptr mut optional ) =>: export peek
    elts .length 0 <= if
      T ptr mut optional.empty return
    end
    elts .data elts .length 1 - + T ptr mut cast! optional.wrap return
  end
  #template type : T #end
  proc( T list  T -> T list ) =>: export push
    append return
  end
  #template type : T #end
  proc( T list : elts -> T list T ) =>: export pop
    elts .length 0 <= if
      ## TODO error handling
      ..unreachable
    end
    elts
      ..dup .length 1 - ..over .length =
    ..dup .data ..over .length [] return
  end


  #template type : T #end
  proc( T list : elts -> T arrayView ) =>: export asArray
    elts .data elts .length array.create return
  end
  #template type : T #end
  proc( T list : elts i64 : from i64 : len -> T arrayView ) =>: export slice
    elts asArray from len array.slice return
  end

  #template type : T type : C #end
  proc(
    T list : elts
    proc( T T C -> i32 ) ptr : cmp
    C : context
  -> ) =>: export sort
    ## sort
      elts .data
      elts .length
      cmp
      context
    array.sort
  end
end
