import mem
import slice
import optional
import array

## XXX allow auto-cast from list -> slice

## negative capacity indictes fixed buffer
namespace: list
  iSize =:: export: listCap
  ( char8 ptr.raw iSize -> listCap ) : static: alias: export: :listCap :iSize
end

( type : T -> type ) =>: export: list
  struct( T ptr.raw.mut : data iSize : length list.listCap : cap )
end

namespace: list
  ( type : T -> T list ) =>: export: static: empty
    { { } : data 0:iSize : length 0:listCap : cap }
  end
  proc( i32 : k type : T -> T list ) =>: export: create_32
    k iSize cast.s T create_Z
  end
  proc( i64 : k type : T -> T list ) =>: export: create_64
    k iSize cast.s T create_Z
  end
  proc( iSize : k type : T -> T list ) =>: export: create_Z
    k T mem.alloc 0:iSize k listCap cast.u T list new return
  end
  overload: export: create create_32 create_64 create_Z end

  ## creates zero-initialized list of the given length
  proc( iSize : k type : T -> T list ) =>: export: createZeroInit
    k T mem.calloc  k k listCap cast.u T list new return
  end
  proc(
    type : auto: T
    T slice : data
  -> T list ) =>: export: fromSlice
    data .length $ 8 / + =:: C
    C 0 iSize.sge "list has non-negative capacity" assert
    ## list
      C T mem.alloc
        data .data
        data .length
      mem.copy
      data .length
      C listCap cast.u
    T list new return
  end
  ## creates a fixed size list backed by the buffer
  proc(
    type : auto: T
    T ptr.raw.mut : buffer
    iSize : buffSize
  -> T list ) =>: export: fromBuffer
    buffer 0:iSize buffSize -_ listCap cast.u T list new return
  end
  proc(
    type : auto: T
    iSize : auto: k
    T k ptr.mut : buffer
  -> T list ) =>: export: wrapBuffer
    buffer 0:iSize k -_ listCap cast.u T list new return
  end
  proc(
    type : auto: T
    T slice.mut : buffer
  -> T list ) =>: export: wrapSlice
    buffer .data 0:iSize buffer .length -_ listCap cast.u T list new return
  end
  proc(
    type : auto: T
    T list : src
  -> T list ) =>: export: copy
    src .cap iSize cast.s
      $ 0:iSize iSize.slt if -_ end
    =:: srcCap
    ## list
      srcCap T mem.alloc
        src .data
        src .length
      mem.copy
      src .length
      srcCap listCap cast.s
    T list new return
  end
  proc(
    type : auto: T
    T list : src
    ( T -> T ) ptr : copyElt
  -> T list ) =>: export: deepCopy
    src .cap iSize cast.s
      $ 0 < if -_ end
    =:: srcCap
    ## list
      srcCap T mem.alloc
      src .length
      srcCap listCap cast.s
    T list new =:: newList
    0 while ..dup newList .length < do =:: i
      src .data i []
        copyElt ()
      newList .data i =[]
      i 1 +
    end ..drop
    newList return
  end

  proc(
    type : auto: T
    T list : elts
    i32 : minCap
  -> T list ) =>: export: ensureCap_32
    elts minCap iSize cast.u ensureCap_Z
  end
  proc(
    type : auto: T
    T list : elts
    i64 : minCap
  -> T list ) =>: export: ensureCap_64
    elts minCap iSize cast.u ensureCap_Z
  end
  proc(
    type : auto: T
    T list : elts
    iSize : minCap
  -> T list ) =>: export: ensureCap_Z
    elts .cap iSize cast.s
      $ 0:iSize iSize.slt if -_ end
    =:: prevCap
    prevCap minCap u>= if
      elts return
    end
    elts .cap iSize cast.s 0:iSize iSize.sge "fixed buffer list is not reallocated" assert
    elts
      minCap $ 2:iSize / + 8:iSize + =:: newCap
      newCap 0:iSize iSize.sge "list has non-negative capacity" assert
      $ .data  newCap mem.realloc  >$ .data=
      newCap listCap cast.u >$ .cap=
    return
  end
  overload: export: ensureCap ensureCap_Z ensureCap_32 ensureCap_64 end
  proc( type : auto: T T list : elts -> T list ) =>: export: free
    elts .cap iSize cast.s 0:iSize iSize.sgt if ## cap <= 0 -> no allocated memory
      elts .data mem.free
    end
    T mem.nullPtr 0:iSize 0:listCap T list new return
  end
  proc( type : auto: T T list : elts -> T list ) =>: export: clear
    elts
      0:iSize >$ .length=
    return
  end
  proc(
    type : auto: T
    T list : src
    iSize : newLength
  -> T list ) =>: export: setLengthZ
    src
      newLength ensureCap
      newLength >$ .length=
    return
  end
  proc(
    type : auto: T
    T list : src
    i32 : newLength
  -> T list ) =>: export: setLength32
    src newLength iSize cast.u setLengthZ
  end
  proc(
    type : auto: T
    T list : src
    i64 : newLength
  -> T list ) =>: export: setLength64
    src newLength iSize cast.u setLengthZ
  end
  overload: export: setLength setLengthZ setLength32 setLength64 end

  proc(
    type : auto: T
    T list : elts
    iSize : index
  -> T optional ) =>: export: get_Z
    index elts .length u>= if T optional.empty return end
    elts .data index [] optional.wrap return
  end
  proc(
    type : auto: T
    T list : elts
    i32 : index
  -> T optional ) =>: export: get_32
    elts index iSize cast.u get_Z
  end
  proc(
    type : auto: T
    T list : elts
    i64 : index
  -> T optional ) =>: export: get_64
    elts index iSize cast.u get_Z
  end
  overload: export: get
    get_Z get_32 get_64
  end
  proc(
    type : auto: T
    T list : elts
    iSize : index
  -> ) =>: checkIndex
    index elts .length u>= if
      "list index outside range" ..panic
    end
  end
  proc(
    type : auto: T
    T list : elts
    iSize : index
  -> T ) =>: export: getValue_Z
    elts index checkIndex
    elts .data index [] return
  end
  proc(
    type : auto: T
    T list : elts
    i32 : index
  -> T ) =>: export: getValue_32
    elts index iSize cast.u getValue_Z
  end
  proc(
    type : auto: T
    T list : elts
    i64 : index
  -> T ) =>: export: getValue_64
    elts index iSize cast.u getValue_Z
  end
  overload: export: getValue
    getValue_Z getValue_32 getValue_64
  end
  proc(
    type : auto: T
    T list : elts
    i32 : index
  -> T ptr.mut optional ) =>: export: at_32
    elts index iSize cast.u at_Z return
  end
  proc(
    type : auto: T
    T list : elts
    i64 : index
  -> T ptr.mut optional ) =>: export: at_64
    elts index iSize cast.u at_Z return
  end
  proc(
    type : auto: T
    T list : elts
    iSize : index
  -> T ptr.mut optional ) =>: export: at_Z
    index elts .length u>= if
      T ptr.mut optional.empty return
    end
    elts .data index @[] T ptr.mut cast! optional.wrap return
  end
  overload: export: at
    at_Z at_32 at_64
  end
  proc(
    type : auto: T
    T list : elts
    i32 : index
  -> T ptr.mut ) =>: export: atValue_32
    elts index iSize cast.u atValue_Z
  end
  proc(
    type : auto: T
    T list : elts
    i64 : index
  -> T ptr.mut ) =>: export: atValue_64
    elts index iSize cast.u atValue_Z
  end
  proc(
    type : auto: T
    T list : elts
    iSize : index
  -> T ptr.mut ) =>: export: atValue_Z
    elts index checkIndex
    elts .data index @[] T ptr.mut cast! return
  end
  overload: export: atValue
    atValue_Z atValue_32 atValue_64
  end
  proc(
    type : auto: T
    T : elt
    T list : elts
    i32 : index
  -> ) =>: export: set_32
    elt elts index iSize cast.u set_Z
  end
  proc(
    type : auto: T
    T : elt
    T list : elts
    i64 : index
  -> ) =>: export: set_64
    elt elts index iSize cast.u set_Z
  end
  proc(
    type : auto: T
    T : elt
    T list : elts
    iSize : index
  -> ) =>: export: set_Z
    elts index checkIndex
    elt elts .data index =[]
  end
  overload: export: set
    set_Z set_32 set_64
  end
  proc(
    type : auto: T
    T list : elts
    T : elt
  -> T list ) =>: export: append
    elts
      $ .length 1:iSize + ensureCap
      elt $1 .data $2 .length =[]
      $ .length 1:iSize + >$ .length=
    return
  end
  proc(
    type : auto: T
    T list : elts
    iSize : auto: k
    T k ptr : p
  -> T list ) =>: export: appendP
    elts
      $ .length iSize cast.u k + ensureCap
      $ .data $1 .length @[] p T ptr.raw cast k mem.copy ..drop
      $ .length k + >$ .length=
    return
  end
  proc(
    type : auto: T
    T list : a
    T slice : b
  -> T list ) =>: export: appendSlice
    a
      $ .length b .length + ensureCap
      $ .data $1 .length @[] b .data b .length mem.copy ..drop
      $ .length b .length + >$ .length=
    return
  end
  proc(
    type : auto: T
    T list : a
    T list : b
  -> T list ) =>: export: appendAll
    a
      $ .length b .length + ensureCap
      $ .data $1 .length @[] b .data b .length mem.copy ..drop
      $ .length b .length + >$ .length=
    return
  end

  proc(
    type : auto: T
    T list : a
    T : elt
    iSize : index
  -> T list ) =>: export: insert
    a index checkIndex
    a
      $ .length 1:iSize + ensureCap
      $ .data index 1:iSize + + $1 .data index + $2 .length index - mem.move ..drop
      elt $1 .data index =[]
      $ .length 1:iSize + >$ .length=
    return
  end
  proc(
    type : auto: T
    T list : a
    iSize : auto: k
    T k ptr : b
    iSize : index
  -> T list ) =>: export: insertP
    a index checkIndex
    a
      $ .length k + ensureCap
      $ .data index k + +  $1 .data index +  $2 .length index -  mem.move ..drop
      $ .data index +  b T ptr.raw cast  k  mem.copy ..drop
      $ .length k + >$ .length=
    return
  end
  proc(
    type : auto: T
    T list : a
    T slice : b
    iSize : index
  -> T list ) =>: export: insertSlice
    a index checkIndex
    a
      $ .length b .length + ensureCap
      $ .data index b .length + +  $1 .data index +  $2 .length index -  mem.move ..drop
      $ .data index +  b .data b .length  mem.copy ..drop
      $ .length b .length + >$ .length=
    return
  end
  proc(
    type : auto: T
    T list : a
    T list : b
    iSize : index
  -> T list ) =>: export: insertAll
    a index checkIndex
    a
      $ .length b .length + ensureCap
      $ .data index b .length + +  $1 .data index +  $2 .length index -  mem.move ..drop
      $ .data index +  b .data b .length  mem.copy ..drop
      $ .length b .length + >$ .length=
    return
  end
  ## XXX? insert64

  proc(
    type : auto: T
    T list : elts
  -> T ptr.mut optional ) =>: export: peek
    elts .length 0:iSize == if
      T ptr.mut optional.empty return
    end
    elts .data elts .length 1:iSize - @[] T ptr.mut cast! optional.wrap return
  end
  proc(
    type : auto: T
    T list
    T
  -> T list ) =>: export: push
    append return
  end
  proc(
    type : auto: T
    T list : elts
  -> T list T ) =>: export: pop
    elts .length 0:iSize == if
      "pop from empty list" ..panic
    end
    elts
      $ .length 1:iSize - >$ .length=
      $ .data $1 .length []
    return
  end

  proc(
    type : auto: T
    T list : elts
  -> T slice ) =>: export: asSlice
    elts .data elts .length slice.create return
  end
  proc(
    type : auto: T
    T list : elts
  -> T slice.mut ) =>: export: asMutableSlice
    elts .data elts .length slice.createMutable return
  end
  proc(
    type : auto: T
    T list : elts
    i32 : from
    i32 : len
  -> T slice ) =>: export: getSlice32
    elts asSlice from iSize cast.u len iSize cast.u slice.getSlice return
  end
  proc(
    type : auto: T
    T list : elts
    i64 : from
    i64 : len
  -> T slice ) =>: export: getSlice64
    elts asSlice from iSize cast.u len iSize cast.u slice.getSlice return
  end
  proc(
    type : auto: T
    T list : elts
    iSize : from
    iSize : len
  -> T slice ) =>: export: getSliceZ
    elts asSlice from len slice.getSlice return
  end
  overload: export: getSlice getSlice32 getSlice64 getSliceZ end
  proc(
    type : auto: T
    T list : elts
    i32 : from
  -> T slice ) =>: export: tail32
    elts asSlice from iSize cast.u slice.tail return
  end
  proc(
    type : auto: T
    T list : elts
    i64 : from
  -> T slice ) =>: export: tail64
    elts asSlice from iSize cast.u slice.tail return
  end
  proc(
    type : auto: T
    T list : elts
    iSize : from
  -> T slice ) =>: export: tailZ
    elts asSlice from slice.tail return
  end
  overload: export: tail tail32 tail64 tailZ end
  proc(
    type : auto: T
    T list : elts
    i32 : from
  -> T slice.mut ) =>: export: tail32mut
    elts asMutableSlice from iSize cast.u slice.tail return
  end
  proc(
    type : auto: T
    T list : elts
    i64 : from
  -> T slice.mut ) =>: export: tail64mut
    elts asMutableSlice from iSize cast.u slice.tail return
  end
  proc(
    type : auto: T
    T list : elts
    iSize : from
  -> T slice.mut ) =>: export: tailZmut
    elts asMutableSlice from slice.tail return
  end
  overload: export: tailMut tail32mut tail64mut tailZmut end
  proc(
    type : auto: T
    T list : elts
    i32 : count
  -> T slice ) =>: export: head32
    elts asSlice count iSize cast.u slice.head return
  end
  proc(
    type : auto: T
    T list : elts
    i64 : count
  -> T slice ) =>: export: head64
    elts asSlice count iSize cast.u slice.head return
  end
  proc(
    type : auto: T
    T list : elts
    iSize : count
  -> T slice ) =>: export: headZ
    elts asSlice count slice.head return
  end
  overload: export: head head32 head64 headZ end

  proc(
    type : auto: T
    type : auto: C
    T list : elts
    proc( T T C -> i32 ) ptr : cmp
    C : context
  -> ) =>: export: sort
    ## sort
      elts .data
      elts .length
      cmp
      context
    array.sort
  end
  proc(
    type : auto: T
    T list : elts
  -> ) =>: export: reverse
    ## reverse
      elts .data
      elts .length
    array.reverse
  end
  proc( type : auto: T T list -> T ptr.Itr ) =>: export: getItr
    asSlice slice.getItr
  end
  proc( type : auto: T T list -> T array.MutPtrItr ) =>: export: atItr
    asMutableSlice slice.atItrMut
  end
  proc( type : auto: T T list -> T array.ReverseItr ) =>: export: reversed
    asSlice slice.reversed
  end
  proc( type : auto: T T list -> T array.ReverseMutPtrItr ) =>: export: atReversed
    asMutableSlice slice.atReversedMut
  end
end
overload: export: []
  list.getValue_Z
  list.getValue_32
  list.getValue_64
end
overload: export: @[]
  list.atValue_Z
  list.atValue_32
  list.atValue_64
end
overload: export: =[]
  list.set_Z
  list.set_32
  list.set_64
end
overload: export: ..itr.prepare
  list.getItr
end
