import core/ptr

import slice
import mem

char8 slice =:: export: string
char16 slice =:: export: string16
char32 slice =:: export: string32

namespace: string
  { "" : data 0:iSize : length } string =: export: empty

  proc( char8 ptr.raw iSize -> string ) =>: export: createZ
    string new return
  end
  proc( char8 ptr.raw i32 -> string ) =>: export: create32
    iSize cast.u createZ
  end
  proc( char8 ptr.raw i64 -> string ) =>: export: create64
    iSize cast.u createZ
  end
  overload: export: create createZ create32 create64 end
  proc( i64 : auto: k  char8 k ptr : str -> string ) =>: export: wrap
    str k create return
  end
  proc( char8 slice -> string ) =>: export: fromChars
    string cast
  end
  proc( string -> char8 slice ) =>: export: chars
    char8 slice cast
  end
  proc( i8 slice : arr -> string ) =>: export: fromBytes
    arr .data char8 ptr.raw cast arr .length create
  end
  proc( string : str -> i8 slice ) =>: export: bytes
    str .data i8 ptr.raw cast str .length slice.create
  end

  proc( string : a string : b -> i32 ) =>: export: compare
    a .length b .length u< if a .length else b .length end =:: l
    a .data b .data l mem.compare
    ..dup 0 != if
      return
    else ..drop end
    a .length b .length u> if
       1 return
    else a .length b .length u< _if
      -1 return
    else
       0 return
    end
  end
  proc( string string -> bool ) =>: export: eq
    compare 0 == return
  end
  proc( string : str -> i32 ) =>: export: hash
    0 ## hash
      0:iSize while ..dup str .length u< do =:: i
        #+hash+# 31 * str .data i [] i32 cast.u +
        i 1:iSize +
      end ..drop
    return
  end
  ## O(1) hash function computed from length and first 4 characters
  proc( string : str -> i32 ) =>: export: fastHash
    str .length i32 cast.u
      str 4 head chars for =:: c
        31 * c i32 cast.u +
      end
    return
  end

  proc( string : str iSize : index -> char8 ) =>: export: charAt_Z
    str char8 slice cast index slice.get return
  end
  proc( string : str i32 : index -> char8 ) =>: export: charAt_32
    str char8 slice cast index slice.get return
  end
  proc( string : str i64 : index -> char8 ) =>: export: charAt_64
    str char8 slice cast index slice.get return
  end
  overload: export: charAt
    charAt_Z
    charAt_32
    charAt_64
  end

  proc( string : str char8 : chr -> iSize optional ) =>: export: indexOf
    str char8 slice cast chr slice.indexOf return
  end
  proc( string : str char8 : chr -> iSize optional ) =>: export: lastIndexOf
    str char8 slice cast chr slice.lastIndexOf return
  end
  proc( string : base string : subStr -> iSize optional ) =>: export: indexOfStr
    base chars subStr chars char8.eq@ slice.indexOfSlice return
  end
  proc( string : base string : subStr -> iSize optional ) =>: export: lastIndexOfStr
    base chars subStr chars char8.eq@ slice.lastIndexOfSlice return
  end
  proc( string : base string : subStr -> bool ) =>: export: startsWith
    subStr .length base .length u> if
      false return
    end
    base .data subStr .length create subStr compare 0 == return
  end
  proc( string : base string : subStr -> bool ) =>: export: endsWith
    subStr .length base .length u> if
      false return
    end
    base .data base .length subStr .length - @[] subStr .length create subStr compare 0 == return
  end

  proc( string : str char8 : chr -> bool ) =>: export: contains
    str char8 slice cast chr slice.indexOf .data ?? return
  end
  proc( string : base string : subStr -> bool ) =>: export: isSubstring
    base subStr indexOfStr .data ?? return
  end

  ## first n characters
  proc( string : str iSize : n -> string ) =>: export: headZ
    str char8 slice cast n slice.head string cast return
  end
  proc( string : str iSize optional : n -> string ) =>: export: headO
    str char8 slice cast n slice.head string cast return
  end
  proc( string : str i32 : n -> string ) =>: export: head32
    str n i64 cast.s head64
  end
  proc( string : str i64 : n -> string ) =>: export: head64
    str char8 slice cast n slice.head string cast return
  end
  overload: export: head headZ headO head32 head64 end
  ## everything excluding the first n characters
  proc( string : str iSize : n -> string ) =>: export: tailZ
    str char8 slice cast n slice.tail string cast return
  end
  proc( string : str iSize optional : n -> string ) =>: export: tailO
    str char8 slice cast n slice.tail string cast return
  end
  proc( string : str i32 : n -> string ) =>: export: tail32
    str n i64 cast.s tail64
  end
  proc( string : str i64 : n -> string ) =>: export: tail64
    str char8 slice cast n slice.tail string cast return
  end
  overload: export: tail tailO tailZ tail32 tail64 end
  ## equivalent to:  <from> tail <len> head
  proc( string : str iSize : from iSize : len -> string ) =>: export: getSlice
    str char8 slice cast from len slice.getSlice string cast return
  end
  proc( string : str iSize : index -> string string ) =>: export: cutIndex
    str char8 slice cast index slice.cutIndex ..swap string cast ..swap string cast return
  end
  proc( string : str iSize : index -> string string ) =>: export: splitIndex
    str char8 slice cast index slice.splitIndex ..swap string cast ..swap string cast return
  end
  proc( string : str char8 : chr -> string string ) =>: export: split
    str char8 slice cast chr slice.split ..swap string cast ..swap string cast return
  end
  proc( string : str char8 : chr -> string string ) =>: export: splitLast
    str char8 slice cast chr slice.splitLast ..swap string cast ..swap string cast return
  end
end

## XXX? implement procedures for string16, string32
namespace: string16
  { utf16"" : data 0:iSize : length } string16 =: export: empty

  proc( char16 ptr.raw  iSize -> string16 ) =>: export: create
    string16 new return
  end

  proc( char16 slice -> string16 ) =>: export: fromSlice
    string16 cast
  end
  proc( string16 -> char16 slice ) =>: export: toSlice
    char16 slice cast
  end
  proc( i16 slice : arr -> string16 ) =>: export: fromIntSlice
    arr .data char16 ptr.raw cast arr .length create
  end
  proc( string16 : str -> i16 slice ) =>: export: toIntSlice
    str .data i16 ptr.raw cast str .length slice.create
  end

  proc( string16 : str iSize : index -> char16 ) =>: export: get_Z
    str char16 slice cast index slice.get return
  end
  proc( string16 : str i32 : index -> char16 ) =>: export: get_32
    str char16 slice cast index slice.get return
  end
  proc( string16 : str i64 : index -> char16 ) =>: export: get_64
    str char16 slice cast index slice.get return
  end
  overload: export: get
    get_Z
    get_32
    get_64
  end
  proc( string16 : a string16 : b -> bool ) =>: export: eq
    a toSlice b toSlice slice.eq return
  end
end
namespace: string32
  { utf32"" : data 0:iSize : length } string32 =: export: empty

  proc( char32 ptr.raw  iSize -> string32 ) =>: export: create
    string32 new return
  end

  proc( char32 slice -> string32 ) =>: export: fromSlice
    string32 cast
  end
  proc( string32 -> char32 slice ) =>: export: toSlice
    char32 slice cast
  end
  proc( i32 slice : arr -> string32 ) =>: export: fromIntSlice
    arr .data char32 ptr.raw cast arr .length create
  end
  proc( string32 : str -> i32 slice ) =>: export: toIntSlice
    str .data i32 ptr.raw cast str .length slice.create
  end

  proc( string32 : str iSize : index -> char32 ) =>: export: get_Z
    str char32 slice cast index slice.get return
  end
  proc( string32 : str i32 : index -> char32 ) =>: export: get_32
    str char32 slice cast index slice.get return
  end
  proc( string32 : str i64 : index -> char32 ) =>: export: get_64
    str char32 slice cast index slice.get return
  end
  overload: export: get
    get_Z
    get_32
    get_64
  end
  proc( string32 : a string32 : b -> bool ) =>: export: eq
    a toSlice b toSlice slice.eq return
  end
end

namespace: std.literals
  proc( char8 ptr.raw : p iSize : k -> string ) =>: static: export: :string
    p k string new
  end
  proc( char16 ptr.raw : p iSize : k -> string16 ) =>: static: export: :string16
    p k string16 new
  end
  proc( char32 ptr.raw : p iSize : k -> string32 ) =>: static: export: :string32
    p k string32 new
  end
  overload: export: :s
    :string
    :string16
    :string32
  end
end
