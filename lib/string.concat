#include arrayView
#include mem

i8 arrayView =:: public string

#namespace string
  "" 0 string new =:: EMPTY

  proc( => string ) =: public empty
    EMPTY return
  end
  proc( i8 _ ptr  i64 => string ) =: public create
    string new return
  end
  proc( i64 : auto k  i8 k ptr : str => string ) =: public wrap
    str k create return
  end

  proc( string : s1 string : s2 => i32 ) =: public compare
    s1 .length s2 .length < if s1 .length else s2 .length end =:: l
    s1 .data s2 .data l mem.compare
    #dup 0 != if
      return
    else #drop end
    s1 .length s2 .length -
    #dup 0 > if #drop
       1 return
    else 0 < _if
      -1 return
    else
       0 return
    end
  end
  proc( string string => bool ) =: public eq
    compare 0 == return
  end
  proc( string : str => i32 ) =: public hash
    0 ## hash
      0 ## index
      while #dup str .length < do
        #swap
          31 *
          #over str .data #swap [] +
        #swap
        1 +
      end
      #drop
    return
  end

  proc( string : str i64 : index => i8 ) =: public charAt
    str index array.get return
  end
  proc( string : str i8 : chr => i64 ) =: public indexOf
    str chr array.indexOf return
  end
  proc( string : str i8 : chr => i64 ) =: public lastIndexOf
    str chr array.lastIndexOf return
  end
  proc( string : base string : subStr => i64 ) =: public indexOfStr ## XXX move to arrayView
    subStr .length base .length > if
      -1 return
    end
    base .length subStr .length - =:: maxOffset
    0 ## offset
    while #dup maxOffset <= do
      base .data #over + subStr .length create  subStr compare 0 == if
        return
      end
      1 +
    end
    #drop
    -1 return
  end
  proc( string : base string : subStr => i64 ) =: public lastIndexOfStr
    subStr .length base .length > if
      -1 return
    end
    base .length subStr .length -
      while #dup 0 >= do
        base .data #over + subStr .length create  subStr compare 0 == if
          return
        end
        1 -
      end
    return
  end
  proc( string : base string : subStr => bool ) =: public startsWith
    subStr .length base .length > if
      false return
    end
    base .data subStr .length create subStr compare 0 == return
  end
  proc( string : base string : subStr => bool ) =: public endsWith
    subStr .length base .length > if
      false return
    end
    base .data base .length subStr .length - + subStr .length create subStr compare 0 == return
  end

  proc( string : str i8 : chr => bool ) =: public contains
    str chr array.indexOf -1 != return
  end
  proc( string : base string : subStr => bool ) =: public isSubstring
    base subStr indexOfStr -1 != return
  end

  ## first n characters
  proc( string : str i64 : n => string ) =: public head
    str n array.head return
  end
  ## everything excluding the first n characters
  proc( string : str i64 : n => string ) =: public tail
    str n array.tail return
  end
  ## equivalent to:  <from> tail <len> head
  proc( string : str i64 : from i64 : len => string ) =: public slice
    str from len array.slice return
  end
  proc( string : str i64 : index => string string ) =: public cutIndex
    str index array.cutIndex return
  end
  proc( string : str i64 : index => string string ) =: public splitIndex
    str index array.splitIndex return
  end
  proc( string : str i8 : chr => string string ) =: public split
    str chr array.split return
  end
  proc( string : str i8 : chr => string string ) =: public splitLast
    str chr array.splitLast return
  end
#end
