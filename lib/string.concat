import core/ptr

import slice
import mem

char8 slice =:: export: string
char16 slice =:: export: string16
char32 slice =:: export: string32

namespace: string
  { "" : data 0 : length } string =: export: empty

  proc( char8 _ ptr  i64 -> string ) =>: export: create
    string new return
  end
  proc( i64 : auto: k  char8 k ptr : str -> string ) =>: export: wrap
    str k create return
  end
  proc( char8 slice -> string ) =>: export: fromChars
    string cast
  end
  proc( string -> char8 slice ) =>: export: chars
    char8 slice cast
  end
  proc( i8 slice : arr -> string ) =>: export: fromBytes
    arr .data char8 _ ptr cast arr .length create
  end
  proc( string : str -> i8 slice ) =>: export: bytes
    str .data i8 _ ptr cast str .length slice.create
  end

  proc( string : a string : b -> i32 ) =>: export: compare
    a .length b .length < if a .length else b .length end =:: l
    a .data b .data l mem.compare
    ..dup 0 != if
      return
    else ..drop end
    a .length b .length -
    ..dup 0 > if ..drop
       1 return
    else 0 < _if
      -1 return
    else
       0 return
    end
  end
  proc( string string -> bool ) =>: export: eq
    compare 0 == return
  end
  proc( string : str -> i32 ) =>: export: hash
    0 ## hash
      0:i64 while ..dup str .length < do =:: i
        #+hash+# 31 * str .data i [] i32 cast.u +
        i 1 +
      end ..drop
    return
  end

  proc( string : str i32 : index -> char8 ) =>: export: charAt_32
    str char8 slice cast index slice.get return
  end
  proc( string : str i64 : index -> char8 ) =>: export: charAt_64
    str char8 slice cast index slice.get return
  end
  overload: export: charAt
    charAt_32
    charAt_64
  end

  proc( string : str char8 : chr -> i64 ) =>: export: indexOf
    str char8 slice cast chr slice.indexOf return
  end
  proc( string : str char8 : chr -> i64 ) =>: export: lastIndexOf
    str char8 slice cast chr slice.lastIndexOf return
  end
  proc( string : base string : subStr -> i64 ) =>: export: indexOfStr ## XXX move to slice
    subStr .length base .length > if
      -1 return
    end
    base .length subStr .length - =:: maxOffset
    0:i64 while ..dup maxOffset <= do
      base .data ..over + subStr .length create  subStr compare 0 == if
        return
      end
      1 +
    end
    ..drop
    -1 return
  end
  proc( string : base string : subStr -> i64 ) =>: export: lastIndexOfStr
    subStr .length base .length > if
      -1 return
    end
    base .length subStr .length -
      while ..dup 0 >= do
        base .data ..over + subStr .length create  subStr compare 0 == if
          return
        end
        1 -
      end
    return
  end
  proc( string : base string : subStr -> bool ) =>: export: startsWith
    subStr .length base .length > if
      false return
    end
    base .data subStr .length create subStr compare 0 == return
  end
  proc( string : base string : subStr -> bool ) =>: export: endsWith
    subStr .length base .length > if
      false return
    end
    base .data base .length subStr .length - + subStr .length create subStr compare 0 == return
  end

  proc( string : str char8 : chr -> bool ) =>: export: contains
    str char8 slice cast chr slice.indexOf -1 != return
  end
  proc( string : base string : subStr -> bool ) =>: export: isSubstring
    base subStr indexOfStr -1 != return
  end

  ## first n characters
  proc( string : str i64 : n -> string ) =>: export: head
    str char8 slice cast n slice.head string cast return
  end
  ## everything excluding the first n characters
  proc( string : str i64 : n -> string ) =>: export: tail
    str char8 slice cast n slice.tail string cast return
  end
  ## equivalent to:  <from> tail <len> head
  proc( string : str i64 : from i64 : len -> string ) =>: export: getSlice
    str char8 slice cast from len slice.getSlice string cast return
  end
  proc( string : str i64 : index -> string string ) =>: export: cutIndex
    str char8 slice cast index slice.cutIndex ..swap string cast ..swap string cast return
  end
  proc( string : str i64 : index -> string string ) =>: export: splitIndex
    str char8 slice cast index slice.splitIndex ..swap string cast ..swap string cast return
  end
  proc( string : str char8 : chr -> string string ) =>: export: split
    str char8 slice cast chr slice.split ..swap string cast ..swap string cast return
  end
  proc( string : str char8 : chr -> string string ) =>: export: splitLast
    str char8 slice cast chr slice.splitLast ..swap string cast ..swap string cast return
  end
end

## XXX? implement procedures for string16, string32
namespace: string16
  { utf16"" : data 0 : length } string16 =: export: empty

  proc( char16 _ ptr  i64 -> string16 ) =>: export: create
    string16 new return
  end

  proc( char16 slice -> string16 ) =>: export: fromArray
    string16 cast
  end
  proc( string16 -> char16 slice ) =>: export: toArray
    char16 slice cast
  end
  proc( i16 slice : arr -> string16 ) =>: export: fromIntArray
    arr .data char16 _ ptr cast arr .length create
  end
  proc( string16 : str -> i16 slice ) =>: export: toIntArray
    str .data i16 _ ptr cast str .length slice.create
  end

  proc( string16 : str i32 : index -> char16 ) =>: export: get_32
    str char16 slice cast index slice.get return
  end
  proc( string16 : str i64 : index -> char16 ) =>: export: get_64
    str char16 slice cast index slice.get return
  end
  overload: export: get
    get_32
    get_64
  end
  proc( string16 : a string16 : b -> bool ) =>: export: eq
    a toArray b toArray slice.eq return
  end
end
namespace: string32
  { utf32"" : data 0 : length } string32 =: export: empty

  proc( char32 _ ptr  i64 -> string32 ) =>: export: create
    string32 new return
  end

  proc( char32 slice -> string32 ) =>: export: fromArray
    string32 cast
  end
  proc( string32 -> char32 slice ) =>: export: toArray
    char32 slice cast
  end
  proc( i32 slice : arr -> string32 ) =>: export: fromIntArray
    arr .data char32 _ ptr cast arr .length create
  end
  proc( string32 : str -> i32 slice ) =>: export: toIntArray
    str .data i32 _ ptr cast str .length slice.create
  end

  proc( string32 : str i32 : index -> char32 ) =>: export: get_32
    str char32 slice cast index slice.get return
  end
  proc( string32 : str i64 : index -> char32 ) =>: export: get_64
    str char32 slice cast index slice.get return
  end
  overload: export: get
    get_32
    get_64
  end
  proc( string32 : a string32 : b -> bool ) =>: export: eq
    a toArray b toArray slice.eq return
  end
end

namespace: std.literals
  namespace: string
    namespace: static
      proc( char8 _ ptr : p i64 : k -> string ) =>: static: export: parse
        p k string new
      end
    end
  end
  namespace: string16
    namespace: static
      proc( char16 _ ptr : p i64 : k -> string16 ) =>: static: export: parse
        p k string16 new
      end
    end
  end
  namespace: string32
    namespace: static
      proc( char32 _ ptr : p i64 : k -> string32 ) =>: static: export: parse
        p k string32 new
      end
    end
  end
  namespace: s
    namespace: static
      overload: static: export: parse
        string.static.parse
        string16.static.parse
        string32.static.parse
      end
    end
  end
end
