#include mem
struct( i8 _ ptr : data i64 : length ) =:: public string

#namespace string
  "" 0 string new =:: EMPTY

  proc( => string ) =: public empty
    EMPTY return
  end
  proc( i8 _ ptr  i64 => string ) =: public create
    string new return
  end
  proc( i64 : static k  i8 k ptr : str => string ) =: public wrap
    str k create return
  end
  
  proc( string : s1 string : s2 => i32 ) =: public compare
    s1 .length s2 .length < if s1 .length else s2 .length end =:: l
    s1 .data s2 .data l mem.compare
    #dup 0 != if
      return
    else #drop end
    s1 .length s2 .length -
    #dup 0 > if #drop
       1 return
    else 0 < _if
      -1 return
    else
       0 return
    end
  end
  proc( string string => bool ) =: public eq
    compare 0 == return
  end
  proc( string : str => i32 ) =: public hash
    0 ## hash
      0 ## index
      while #dup str .length < do
        #swap
          31 *
          #over str .data #swap [] +
        #swap
        1 +
      end
      #drop
    return
  end

  proc( string : str i64 : index => i8 ) =: public charAt
    index 0 < index str .length >= | if
      '\x00' return ## TODO error handling
    end
    str .data index [] return
  end
  proc( string : str i8 : chr => i64 ) =: public indexOf
    0 ## index
    while #dup str .length < do
      str .data #over [] chr == if
        return
      end
      1 +
    end
    #drop
    -1 return
  end
  proc( string : str i8 : chr => i64 ) =: public lastIndexOf
    str .length 1 - ## index
    while #dup 0 >= do
      str .data #over [] chr == if
        return
      end
      1 -
    end
    return
  end
  proc( string : base string : subStr => i64 ) =: public indexOfStr
    subStr .length base .length > if
      -1 return
    end
    base .length subStr .length - =:: maxOffset
    0 ## offset
    while #dup maxOffset <= do
      base .data #over + subStr .length create  subStr compare 0 == if
        return
      end
      1 +
    end
    #drop
    -1 return
  end
  proc( string : base string : subStr => i64 ) =: public lastIndexOfStr
    subStr .length base .length > if
      -1 return
    end
    base .length subStr .length -
      while #dup 0 >= do
        base .data #over + subStr .length create  subStr compare 0 == if
          return
        end
        1 -
      end
    return
  end
  proc( string : str i8 : chr => bool ) =: public contains
    str chr indexOf -1 != return
  end
  proc( string : base string : subStr => bool ) =: public isSubstring
    base subStr indexOfStr -1 != return
  end

  ## first n characters
  proc( string : str i64 : n => string ) =: public head
    n 0 <= if
      EMPTY return
    end
    n str .length >= if
      str return
    end
    str .data  n create return
  end
  ## everything excluding the first n characters
  proc( string : str i64 : n => string ) =: public tail
    n 0 <= if
      str return
    end
    n str .length >= if
      EMPTY return
    end
    str .data n +  str .length n -  create return
  end
  ## equivalent to:  <from> tail <len> head
  proc( string : str i64 : from i64 : len => string ) =: public slice
    len 0 <= if
      EMPTY return
    end
    from str .length >= if
      EMPTY return
    end
    from 0 <= if
      str .data  len create return
    end
    from len + str .length >= if
      str .data from +  str .length from -  create return
    end
    str .data from +  len  create return
  end
  proc( string : str i64 : index => string string ) =: public cutIndex
    str index tail
    str index head
    return
  end
  proc( string : str i64 : index => string string ) =: public splitIndex
    index 0 < if
      EMPTY str return
    end
    str index 1 + tail
    str index head
    return
  end
  proc( string : str i8 : chr => string string ) =: public split
    str
      str chr indexOf
    splitIndex return
  end
#end
