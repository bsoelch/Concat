#include mem
#include string
#include arrayView

struct( i8 _ ptr mut : mut data i64 : mut cap i64 : mut length ) =:: public stringBuilder
#namespace sb
  proc( i64 : cap => stringBuilder ) =: public create
    cap i8 mem.alloc cap 0 stringBuilder new return
  end
  proc( stringBuilder => stringBuilder ) =: public clear
    0 #over .length =
    return
  end
  proc( stringBuilder => stringBuilder ) =: public free
    #dup .data mem.free
    0 #over .cap =
    0 #over .length =
    return
  end
  proc( i64 : static k  i8 k ptr : str => stringBuilder ) =: public wrap
    k create
      str appendS
    return
  end
  proc( stringBuilder : str i64 : index => i8 ) =: public charAt
    index 0 < index str .length >= | if
      '\x00' return ## TODO error handling
    end
    str .data index [] return
  end
  proc( stringBuilder : buffer i64 : minCap => stringBuilder ) =: public ensureCap
    buffer
      #dup .cap minCap > if
        return
      end
      minCap minCap 8 / + 8 +
        #over .data #over mem.realloc #over:2 .data =
        #over .cap =
    return
  end
  proc( stringBuilder : buffer i8 : chr => stringBuilder ) =: public appendC
    buffer
      #dup .length 1 + sb.ensureCap
      chr #over .data #over:2 .length [] =
      #dup .length 1 + #over .length =
    return
  end
  proc( stringBuilder : buffer i64 : static k i8 k ptr : str => stringBuilder ) =: public appendS
    buffer
      #dup .length k + sb.ensureCap
      #dup .data #over .length + str i8 _ ptr cast k mem.copy #drop
      #dup .length k + #over .length =
    return
  end
  proc( stringBuilder : buffer string : str => stringBuilder ) =: public appendStr
    buffer
      #dup .length str .length + sb.ensureCap
      #dup .data #over .length + str .data str .length mem.copy #drop
      #dup .length str .length + #over .length =
    return
  end
  proc( stringBuilder : buffer stringBuilder : str => stringBuilder ) =: public appendSb
    buffer
      #dup .length str .length + sb.ensureCap
      #dup .data #over .length + str .data str .length mem.copy #drop
      #dup .length str .length + #over .length =
    return
  end
  proc( stringBuilder => string ) =: public asStr
    #dup .data #swap .length string.create return
  end
  proc( stringBuilder => i8 arrayView ) =: public asArray
    #dup .data #swap .length array.create return
  end

  "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz" =:: stringChars
  
  proc( stringBuilder : buffer i64 : i i32 : base bool : signed => stringBuilder ) =: public appendInt??
    base 2 < if 
      ## TODO error handling
      buffer return
    end
    i8 64 array new =:: mut chrBuff
    buffer
      i
      #dup 0 < signed & if  
        #swap '-' appendC #swap
        neg 
      else #dup 0 == _if
        #drop '0' appendC return
      end   
      63 #swap ## index in chrBuff
        while #dup 0 != do
          #swap ## <buffer> <i> <chrIndex>
            #over base %u stringChars #swap []
            #over chrBuff @ #swap [] =
            1 -
          #swap
          base /u
        end #drop
        while 1 + #dup 64 < do
          #swap ## <chrIndex> <buffer>
            #over chrBuff @ #swap [] appendC
          #swap
        end
      #drop
    return
  end
  proc( stringBuilder i64 #+value+# i32 #+base+# => stringBuilder ) =: public appendInt?
    true appendInt??
  end
  proc( stringBuilder i64 #+value+# => stringBuilder ) =: public appendBin
    2  appendInt?
  end
  proc( stringBuilder i64 #+value+# => stringBuilder ) =: public appendI
    10 appendInt?
  end
  proc( stringBuilder i64 #+value+# => stringBuilder ) =: public appendX
    16 appendInt?
  end
  proc( stringBuilder i64 #+value+# => stringBuilder ) =: public appendUBin
    2 false appendInt??
  end
  proc( stringBuilder i64 #+value+# => stringBuilder ) =: public appendU
    10 false appendInt??
  end
  proc( stringBuilder i64 #+value+# => stringBuilder ) =: public appendUHex
    16 false appendInt??
  end
#end

