namespace: char
  proc( char8 -> bool ) =>: export: isWhitespace
    switch
      ' ' '\n' '\t' '\v' '\f' '\r' case
        true return
      default
        false return
    end
  end
  proc( char8 : d -> bool ) =>: export: isDigit
    d '0' < if
      false return
    end
    d '9' <= return
  end
end
