import core/itr
import core/slice

import array
import mem
import optional

namespace: slice
  proc( type : auto: T T slice : src -> T slice.mut ) =>: copySlice
    src .length T mem.alloc =:: newData
    newData src .data src .length mem.copy src .length create_mut
  end
  proc( type : auto: T T slice.mut : src -> T slice.mut ) =>: copyMut
    src .length T mem.alloc =:: newData
    newData src .data src .length mem.copy src .length create_mut
  end
  overload: export: copy copySlice copyMut end

  proc( type : auto: T T slice.mut : src -> T slice.mut ) =>: export: free
    src .data mem.free
    T slice.emptyMutable return
  end
end
import itrs/slice
