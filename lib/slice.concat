    type : auto: T
    T slice.mut : elts
    iSize : index
  -> T ptr.mut ) =>: export: atValue_mut
    index elts .length checkIndex
    elts .data index @[] T ptr.mut cast! return
  end
  proc(
    type : auto: T
    T slice.mut : elts
    i64 : index
  -> T ptr.mut ) =>: export: atValue_64mut
    elts index iSize cast.s atValue_mut
  end
  proc(
    type : auto: T
    T slice.mut : elts
    i32 : index
  -> T ptr.mut ) =>: export: atValue_32mut
    elts index iSize cast.s atValue_mut
  end
  overload: export: atValue
    atValue_Z atValue_mut atValue_32 atValue_64 atValue_32mut atValue_64mut
  end
  proc( type : auto: T T : elt T slice.mut : elts iSize : index -> ) =>: export: set_Z
    index elts .length checkIndex
    elt elts .data index =[]
  end
  proc( type : auto: T T : elt T slice.mut : elts i64 : index -> ) =>: export: set_64
    elt elts index iSize cast.u set_Z
  end
  proc( type : auto: T T : elt T slice.mut : elts i32 : index -> ) =>: export: set_32
    elt elts index iSize cast.u set_Z
  end
  overload: export: set
    set_Z set_32 set_64
  end
  proc( type : auto: T T : elt T slice.mut : elts -> ) =>: export: fill
    elts .data elts .length elt mem.fill
  end

  ## TODO? support mutable slice
  proc(
    type : auto: T
    T slice : elts
    T : elt
  -> iSize optional ) =>: export: indexOf
    0:iSize while $ elts .length u< do
      elts .data $1 [] elt == if
        optional.wrap return
      end
      1:iSize +
    end ..drop
    iSize optional.empty return
  end
  proc(
    type : auto: T
    T slice : elts
    T : elt
    ( T T -> bool ) ptr : fEq
  -> iSize optional ) =>: export: indexOfEq
    0:iSize while $ elts .length u< do
      elts .data $1 [] elt fEq () if
        optional.wrap return
      end
      1:iSize +
    end ..drop
    iSize optional.empty return
  end
  proc(
    type : auto: T
    T slice : elts
    T : elt
  -> iSize optional ) =>: export: lastIndexOf
    elts .length 1:iSize - ## index
    while $ -1:iSize != do ## decrement until reaching zero (inclusive)
      elts .data $1 [] elt == if
        optional.wrap return
      end
      1:iSize -
    end ..drop
    iSize optional.empty return
  end
  proc(
    type : auto: T
    T slice : elts
    T : elt
    ( T T -> bool ) ptr : fEq
  -> iSize optional ) =>: export: lastIndexOfEq
    elts .length 1:iSize - ## index
    while $ -1:iSize != do ## decrement until reaching zero (inclusive)
      elts .data $1 [] elt fEq () if
        optional.wrap return
      end
      1:iSize -
    end ..drop
    iSize optional.empty return
  end
  proc(
    type : auto: T
    T slice : elts
    T : elt
  -> bool ) =>: export: contains
    elts elt indexOf ? return
  end
  proc(
    type : auto: T
    T slice : elts
    T : elt
    ( T T -> bool ) ptr : fEq
  -> bool ) =>: export: containsEq
    elts elt fEq indexOfEq ? return
  end

  proc(
    type : auto: T
    T slice : seq
    T slice : elts
  -> bool ) =>: export: isSubSequenceEq
    elts .length 0 == if true return end
    0:iSize =:: mut: i
    seq for =:: x
      x elts i [] == if
        i 1 + i=
        i elts .length u>= if
          true return
        end
      end
    end
    false return
  end
  proc(
    type : auto: T
    T slice : seq
    T slice : elts
    ( T T -> bool ) ptr : fEq
  -> bool ) =>: export: isSubSequenceF
    elts .length 0 == if true return end
    0:iSize =:: mut: i
    seq for =:: x
      x elts i [] fEq () if
        i 1 + i=
        i elts .length u>= if
          true return
        end
      end
    end
    false return
  end
  overload: export: isSubSequence isSubSequenceEq isSubSequenceF end

  proc(
    type : auto: T
    T slice : a
    T slice : b
  -> bool ) =>: export: simpleEq
    a .length b .length != if false return end
    a .data b .data == if true return end
    a .length for =:: i
      a i [] b i [] != if
        false return
      end
    end
    true return
  end
  proc(
    type : auto: T
    type : auto: C
    T slice : a
    T slice : b
    ( T T C -> bool ) ptr : eqCheck
    C : context
  -> bool ) =>: export: checkedEq
    a .length b .length != if false return end
    a .data b .data == if true return end
    a .length for =:: i
      a i [] b i [] context eqCheck () ! if
        false return
      end
    end
    true return
  end
  overload: export: eq
    simpleEq
    checkedEq
  end
  proc(
    type : auto: T
    type : auto: C
    T slice : a
    ( T C -> i32 ) ptr : eltHash
    C : context
  -> i32 ) =>: export: hash
    0:i32
      a for =:: elt
       31 * elt context eltHash () +
      end
    return
  end
  proc(
    type : auto: T
    T slice : a
    T slice : b
  -> i32 ) =>: export: simpleLexcmp
    a .length b .length iSize.min for =:: i
      a i [] b i [] == if continue end
      a i [] b i [] < if -1 else 1 end return
    end
    a .length b .length == if 0 return end
    a .length b .length u< if -1 else 1 end return
  end
  proc(
    type : auto: T
    type : auto: C
    T slice : a
    T slice : b
    ( T T C -> i32 ) ptr : eltCmp
    C : context
  -> i32 ) =>: export: checkedLexcmp
    a .length b .length iSize.min for =:: i
      a i [] b i [] eltCmp () =:: c
      c ? if c return end
    end
    a .length b .length == if 0 return end
    a .length b .length u< if -1 else 1 end return
  end
  overload: export: lexcmp
    simpleLexcmp
    checkedLexcmp
  end
  proc(
    type : auto: T
    T slice : a
    T slice : b
  -> i32 ) =>: export: simpleCmp
    a .length b .length != if
      a .length b .length u< if -1 else 1 end return
    end
    a .length b .length iSize.min for =:: i
      a i [] b i [] == if continue end
      a i [] b i [] < if -1 else 1 end return
    end
    0 return
  end
  proc(
    type : auto: T
    type : auto: C
    T slice : a
    T slice : b
    ( T T C -> i32 ) ptr : eltCmp
    C : context
  -> i32 ) =>: export: checkedCmp
    a .length b .length != if
      a .length b .length u< if -1 else 1 end return
    end
    a .length b .length iSize.min for =:: i
      a i [] b i [] eltCmp () =:: c
      c ? if c return end
    end
    0 return
  end
  overload: export: cmp
    simpleCmp
    checkedCmp
  end
  proc(
    type : auto: T
    type : auto: C
    T slice.mut : elts
    proc( T T C -> i32 ) ptr : fCmp
    C : context
  -> ) =>: export: sort
    ## sort
      elts .data
      elts .length
      fCmp
      context
    array.sort
  end

  proc(
    type : auto: T
    T slice : a
    T slice : b
    proc( T T -> bool ) ptr : shadow: eq
  -> iSize optional ) =>: export: indexOfSlice
    a .length b .length u< if
      iSize optional.empty return
    end
    ## TODO? use faster algorithm
    0:iSize while ..dup a .length b .length - u<= do =:: i
      true =:: mut: match
      0:iSize while ..dup b .length u< do =:: j
        ## eq
          a i j + []
          b j []
        eq () ! if
          false match=
          j break
        end
        j 1:iSize +
      end ..drop
      match if
        i optional.wrap return
      end
      i 1:iSize +
    end ..drop
    iSize optional.empty return
  end
  proc(
    type : auto: T
    T slice : a
    T slice : b
    proc( T T -> bool ) ptr : shadow: eq
  -> iSize optional ) =>: export: lastIndexOfSlice
    a .length b .length u< if
      iSize optional.empty return
    end
    ## TODO? use faster algorithm
    a .length b .length - while $ -1:iSize != do =:: i
      true =:: mut: match
      0:iSize while ..dup b .length u< do =:: j
        ## eq
          a i j + []
          b j []
        eq () ! if
          false match=
          j break
        end
        j 1:iSize +
      end ..drop
      match if
        i optional.wrap return
      end
      i 1:iSize -
    end ..drop
    iSize optional.empty return
  end
  ## find lowest index of slice,
  ## if the slice is not a sub-sequence contain the smallest possible start index
  proc(
    type : auto: T
    type : auto: C
    T slice : a
    T slice : b
    proc( T ptr T ptr C -> bool ) ptr : shadow: eq
    C : context
  -> iSize ) =>: export: indexOfSlicePrefix
    ## TODO? use faster algorithm
    0:iSize while ..dup a .length u<= do =:: i
      true =:: mut: match
      0:iSize while ..dup b .length u< do =:: j
        i j + a .length u>= if
          j break
        end
        ## eq
          a i j + slice.at .data
          b j slice.at .data
          context
        eq () ! if
          false match=
          j break
        end
        j 1:iSize +
      end ..drop
      match if
        i return
      end
      i 1:iSize +
    end ..drop
    ..unreachable ## TODO! is this realy unreachable
  end

  ## first n characters
  proc(
    type : auto: T
    T slice : elts
    i32 : n
  -> T slice ) =>: export: head_32
    elts n iSize cast.u head_Z
  end
  proc(
    type : auto: T
    T slice : elts
    i64 : n
  -> T slice ) =>: export: head_64
    elts n iSize cast.u head_Z
  end
  proc(
    type : auto: T
    T slice : elts
    iSize optional : n
  -> T slice ) =>: export: head_O
    n .else
      T empty return
    end =:: cound
    elts cound head_Z return
  end
  proc(
    type : auto: T
    T slice : elts
    iSize : n
  -> T slice ) =>: export: head_Z
    n elts .length u>= if
      elts return
    end
    elts .data  n create return
  end
  proc(
    type : auto: T
    T slice.mut : elts
    i32 : n
  -> T slice.mut ) =>: export: head_32mut
    elts n iSize cast.u head_mut
  end
  proc(
    type : auto: T
    T slice.mut : elts
    i64 : n
  -> T slice.mut ) =>: export: head_64mut
    elts n iSize cast.u head_mut
  end
  proc(
    type : auto: T
    T slice.mut : elts
    iSize optional : n
  -> T slice.mut ) =>: export: head_Omut
    n .else
      T emptyMutable return
    end =:: count
    elts count head_mut return
  end
  proc(
    type : auto: T
    T slice.mut : elts
    iSize : n
  -> T slice.mut ) =>: export: head_mut
    n elts .length u>= if
      elts return
    end
    elts .data  n createMutable return
  end
  overload: export: head head_Z head_mut head_O head_Omut head_32 head_64 head_32mut head_64mut end

  ## everything excluding the first n characters
  proc(
    type : auto: T
    T slice : elts
    i32 : n
  -> T slice ) =>: export: tail_32
    elts n iSize cast.u tail_Z
  end
  proc(
    type : auto: T
    T slice : elts
    i64 : n
  -> T slice ) =>: export: tail_64
    elts n iSize cast.u tail_Z
  end
  proc(
    type : auto: T
    T slice : elts
    iSize optional : n
  -> T slice ) =>: export: tail_O
    n .else
      elts return
    end =:: count
    elts  count  tail_Z return
  end
  proc(
    type : auto: T
    T slice : elts
    iSize : n
  -> T slice ) =>: export: tail_Z
    n elts .length u>= if
      T empty return
    end
    elts .data n @[] elts .length n -  create return
  end
  proc(
    type : auto: T
    T slice.mut : elts
    i32 : n
  -> T slice.mut ) =>: export: tail_32mut
    elts n iSize cast.u tail_mut
  end
  proc(
    type : auto: T
    T slice.mut : elts
    i64 : n
  -> T slice.mut ) =>: export: tail_64mut
    elts n iSize cast.u tail_mut
  end
  proc(
    type : auto: T
    T slice.mut : elts
    iSize optional : n
  -> T slice ) =>: export: tail_Omut
    n .else
      elts return
    end =:: count
    elts  count  tail_mut return
  end
  proc(
    type : auto: T
    T slice.mut : elts
    iSize : n
  -> T slice.mut ) =>: export: tail_mut
    n elts .length u>= if
      T emptyMutable return
    end
    elts .data n @[]  elts .length n -  createMutable return
  end
  overload: export: tail tail_Z tail_mut tail_O tail_Omut tail_32 tail_64 tail_32mut tail_64mut end
  ## equivalent to:  <from> tail <len> head
  proc(
    type : auto: T
    T slice : elts
    i32 : from
    i32 : len
  -> T slice ) =>: export: getSlice32
    elts from iSize cast.u len iSize cast.u getSliceZ return
  end
  proc(
    type : auto: T
    T slice : elts
    i64 : from
    i64 : len
  -> T slice ) =>: export: getSlice64
    elts from iSize cast.u len iSize cast.u getSliceZ return
  end
  proc(
    type : auto: T
    T slice : elts
    iSize : from
    iSize : len
  -> T slice ) =>: export: getSliceZ
    len 0:iSize == if
      T empty return
    end
    from elts .length u>= if
      T empty return
    end
    from 0:iSize == if
      elts  len head return
    end
    from len + elts .length u>= if
      elts .data from @[]  elts .length from -  create return
    end
    elts .data from @[]  len  create return
  end
  overload: export: getSlice getSliceZ getSlice32 getSlice64 end
  proc(
    type : auto: T
    T slice : elts
    iSize : index
  -> T slice T slice ) =>: export: cutIndex
    elts index tail
    elts index head
    return
  end
  proc(
    type : auto: T
    T slice : elts
    iSize optional : index
  -> T slice T slice ) =>: export: splitIndex_O
    index .else
      T empty elts return
    end =:: count
    elts count splitIndex_Z
  end
  proc(
    type : auto: T
    T slice : elts
    iSize : index
  -> T slice T slice ) =>: export: splitIndex_Z
    elts index 1:iSize + tail
    elts index head
    return
  end
  overload: export: splitIndex splitIndex_O splitIndex_Z end
  proc(
    type : auto: T
    T slice : elts
    T : elt
  -> T slice T slice ) =>: export: split
    elts
      elts elt indexOf
    splitIndex return
  end
  proc(
    type : auto: T
    T slice : elts
    T : elt
  -> T slice T slice ) =>: export: splitLast
    elts
      elts elt lastIndexOf
      .else
        T empty return
      end
    splitIndex return
  end

