import core/ptr
import core/itr

import mem
import optional

( type : T -> type ) =>: export: slice
  struct( T _ ptr : data i64 : length )
end
namespace: slice
  ( type : T -> type ) =>: export: mut
    struct( T _ ptr.mut : data i64 : length )
  end

  proc( type : T -> T slice ) =>: export: empty
    { { } : data 0 : length } return
  end
  proc( type : T -> T slice.mut ) =>: export: emptyMutable
    { { } : data 0 : length } return
  end
  proc( type : auto: T T _ ptr  i32 -> T slice ) =>: export: create_32
    i64 cast.s create_64
  end
  proc( type : auto: T T _ ptr  i64 -> T slice ) =>: export: create_64
    T slice new return
  end
  overload: export: create create_32 create_64 end
  proc(
    type : auto: T
    i64 : auto: k
    T k ptr : elts
  -> T slice ) =>: export: wrap
    elts k create return
  end
  proc( type : auto: T T slice.mut : a -> T slice ) =>: export: freeze
    a .data a .length slice.create_64
  end
  proc( type : auto: T T _ ptr.mut  i64 -> T slice.mut ) =>: export: shadow: create_64mut
    T slice.mut new return
  end
  proc( type : auto: T T _ ptr.mut  i32 -> T slice.mut ) =>: export: shadow: create_32mut
    i64 cast.s create_64mut
  end
  proc(
    type : auto: T
    i64 : auto: k
    T k ptr.mut : elts
  -> T slice.mut ) =>: export: shadow: wrapMutable
    elts k create_64mut return
  end
  overload: export: shadow: createMutable create_32mut create_64mut end

  proc( i64 : index i64 : length -> ) =>: checkIndex
    index 0 < or index length >= if
      "slice index outside range" ..panic
    end
  end
  proc( type : auto: T T slice : elts i64 : index -> T ) =>: export: get_64
    index elts .length checkIndex
    elts .data index [] return
  end
  proc( type : auto: T T slice : elts i32 : index -> T ) =>: export: get_32
    elts index i64 cast.s get_64
  end
  proc( type : auto: T T slice.mut : elts i64 : index -> T ) =>: export: get_64mut
    index elts .length checkIndex
    elts .data index [] return
  end
  proc( type : auto: T T slice.mut : elts i32 : index -> T ) =>: export: get_32mut
    elts index i64 cast.s get_64mut
  end
  overload: export: get
    get_32
    get_64
    get_32mut
    get_64mut
  end
  proc(
    type : auto: T
    T slice : elts
    i64 : index
  -> T ptr optional ) =>: export: at_64
    index 0 < or index elts .length >= if
      T ptr optional.empty return
    end
    elts .data index + T ptr cast! optional.wrap return
  end
  proc(
    type : auto: T
    T slice : elts
    i32 : index
  -> T ptr optional ) =>: export: at_32
    elts index i64 cast.s at_64
  end
  proc(
    type : auto: T
    T slice.mut : elts
    i64 : index
  -> T ptr.mut optional ) =>: export: at_64mut
    index 0 < or index elts .length >= if
      T ptr.mut optional.empty return
    end
    elts .data index + T ptr.mut cast! optional.wrap return
  end
  proc(
    type : auto: T
    T slice.mut : elts
    i32 : index
  -> T ptr.mut optional ) =>: export: at_32mut
    elts index i64 cast.s at_64mut
  end
  overload: export: at
    at_32 at_64 at_32mut at_64mut
  end
  proc(
    type : auto: T
    T slice : elts
    i64 : index
  -> T ptr ) =>: export: atValue_64
    index elts .length checkIndex
    elts .data index + T ptr cast! return
  end
  proc(
    type : auto: T
    T slice : elts
    i32 : index
  -> T ptr ) =>: export: atValue_32
    elts i64 cast.s atValue_64
  end
  proc(
    type : auto: T
    T slice.mut : elts
    i64 : index
  -> T ptr.mut ) =>: export: atValue_64mut
    index elts .length checkIndex
    elts .data index + T ptr cast! return
  end
  proc(
    type : auto: T
    T slice.mut : elts
    i32 : index
  -> T ptr.mut ) =>: export: atValue_32mut
    elts i64 cast.s atValue_32mut
  end
  overload: export: atValue
    atValue_32 atValue_64 atValue_32mut atValue_64mut
  end
  proc( type : auto: T T : elt T slice.mut : elts i64 : index -> ) =>: export: set_64
    index elts .length checkIndex
    elt elts .data index []=
  end
  proc( type : auto: T T : elt T slice.mut : elts i32 : index -> ) =>: export: set_32
    elt elts index i64 cast.s set_64
  end
  overload: export: set
    set_32 set_64
  end
  proc( type : auto: T T : elt T slice.mut : elts -> ) =>: export: fill
    elts .data elts .length elt mem.fill
  end

  ## TODO? support mutable slice
  proc(
    type : auto: T
    T slice : elts
    T : elt
  -> i64 ) =>: export: indexOf
    0:i64 while ..dup elts .length < do
      elts .data ..over [] elt == if
        return
      end
      1 +
    end
    ..drop
    -1 return
  end
  proc(
    type : auto: T
    T slice : elts
    T : elt
  -> i64 ) =>: export: lastIndexOf
    elts .length 1 - ## index
    while ..dup 0 >= do
      elts .data ..over [] elt == if
        return
      end
      1 -
    end
    return
  end
  proc(
    type : auto: T
    T slice : elts
    T : elt
  -> bool ) =>: export: contains
    elts elt indexOf -1 != return
  end

  proc(
    type : auto: T
    T slice : a
    T slice : b
  -> bool ) =>: export: simpleEq
    a .length b .length != if false return end
    a .data b .data == if true return end
    a .length for =:: i
      a i slice.get b i slice.get != if
        false return
      end
    end
    true return
  end
  proc(
    type : auto: T
    type : auto: C
    T slice : a
    T slice : b
    ( T T C -> bool ) ptr : eqCheck
    C : context
  -> bool ) =>: export: checkedEq
    a .length b .length != if false return end
    a .data b .data == if true return end
    a .length for =:: i
      a i slice.get b i slice.get context eqCheck () if
        false return
      end
    end
    true return
  end
  overload: export: eq
    simpleEq
    checkedEq
  end

  proc(
    type : auto: T
    T slice : a
    T slice : b
    proc( T ptr T ptr -> bool ) ptr : shadow: eq
  -> i64 ) =>: export: indexOfSlice
    a .length b .length < if
      -1 return
    end
    ## TODO? use faster algorithm
    0 while ..dup a .length b .length - <= do =:: i
      true =:: mut: match
      0 while ..dup b .length < do =:: j
        ## eq
          a i j + slice.at .data
          b j slice.at .data
        eq () ! if
          false match@ =
          j break
        end
        j 1 +
      end ..drop
      match if
        i return
      end
      i 1 +
    end ..drop
    -1 return
  end
  ## find lowest index of slice,
  ## if the slice is not a sub-sequence contain the smallest possible start index
  proc(
    type : auto: T
    type : auto: C
    T slice : a
    T slice : b
    proc( T ptr T ptr C -> bool ) ptr : shadow: eq
    C : context
  -> i64 ) =>: export: indexOfSliceStart
    ## TODO? use faster algorithm
    0:i64 while ..dup a .length <= do =:: i
      true =:: mut: match
      0:i64 while ..dup b .length < do =:: j
        i j + a .length >= if
          j break
        end
        ## eq
          a i j + slice.at .data
          b j slice.at .data
          context
        eq () ! if
          false match@ =
          j break
        end
        j 1 +
      end ..drop
      match if
        i return
      end
      i 1 +
    end ..drop
    ..unreachable ## TODO! is this realy unreachable
  end

  ## first n characters
  proc(
    type : auto: T
    T slice : elts
    i64 : n
  -> T slice ) =>: export: head_64
    n 0 <= if
      T empty return
    end
    n elts .length >= if
      elts return
    end
    elts .data  n create return
  end
  proc(
    type : auto: T
    T slice.mut : elts
    i64 : n
  -> T slice.mut ) =>: export: head_64mut
    n 0 <= if
      T emptyMutable return
    end
    n elts .length >= if
      elts return
    end
    elts .data  n createMutable return
  end
  overload: export: head head_64 head_64mut end

  ## everything excluding the first n characters
  proc(
    type : auto: T
    T slice : elts
    i64 : n
  -> T slice ) =>: export: tail_64
    n 0 <= if
      elts return
    end
    n elts .length >= if
      T empty return
    end
    elts .data n +  elts .length n -  create return
  end
  proc(
    type : auto: T
    T slice.mut : elts
    i64 : n
  -> T slice.mut ) =>: export: tail_64mut
    n 0 <= if
      elts return
    end
    n elts .length >= if
      T emptyMutable return
    end
    elts .data n +  elts .length n -  createMutable return
  end
  overload: export: tail tail_64 tail_64mut end
  ## equivalent to:  <from> tail <len> head
  proc(
    type : auto: T
    T slice : elts
    i64 : from
    i64 : len
  -> T slice ) =>: export: getSlice
    len 0 <= if
      T empty return
    end
    from elts .length >= if
      T empty return
    end
    from 0 <= if
      elts  len head return
    end
    from len + elts .length >= if
      elts .data from +  elts .length from -  create return
    end
    elts .data from +  len  create return
  end
  proc(
    type : auto: T
    T slice : elts
    i64 : index
  -> T slice T slice ) =>: export: cutIndex
    elts index tail
    elts index head
    return
  end
  proc(
    type : auto: T
    T slice : elts
    i64 : index
  -> T slice T slice ) =>: export: splitIndex
    index 0 < if
      T empty elts return
    end
    elts index 1 + tail
    elts index head
    return
  end
  proc(
    type : auto: T
    T slice : elts
    T : elt
  -> T slice T slice ) =>: export: split
    elts
      elts elt indexOf
    splitIndex return
  end
  proc(
    type : auto: T
    T slice : elts
    T : elt
  -> T slice T slice ) =>: export: splitLast
    elts
      elts elt lastIndexOf
      ..dup -1 == if ..drop.2
        elts T empty return
      end
    splitIndex return
  end

  ( type : T -> type ) =>: export: getItr
    struct(
      T slice : data
      i64 : index
    )
  end
  ( type : T -> type ) =>: export: reverseItr
    T getItr
  end
  ( type : T -> type ) =>: export: mapItr
    struct(
      T slice.mut : data
      i64 : index
    )
  end
  ( type : S type : T -> type ) =>: export: mapToItr
    struct(
      S slice : src
      T slice.mut : target
      i64 : index
    )
  end

  proc( type : auto: T
    T slice.mut
  -> T slice.mapItr ) =>: export: itrMap
    0 T slice.mapItr new
  end
  proc( type : auto: T
    T slice.mut : data
    ( T -> T ) ptr : f
  -> T slice.mut ) =>: export: fMap
    data itrMap for f () end return
  end
  overload: export: map itrMap fMap end
  proc( type : auto: S type : auto: T
    S slice : src
    T slice.mut : target
  -> S T slice.mapToItr ) =>: export: itrMapTo
    target .length src .length < if
      "target list cannot hold all values in source" ..panic
    end
    src target 0 S T slice.mapToItr new
  end
  proc( type : auto: S type : auto: T
    S slice : src
    T slice.mut : target
    ( S -> T ) ptr : f
  -> T slice.mut ) =>: export: fMapTo
    src target itrMapTo for f () end return
  end
  proc( type : auto: S type : auto: T
    S slice.mut : src
    T slice.mut : target
  -> S T slice.mapToItr ) =>: export: itrMapMutTo
    src freeze target itrMapTo
  end
  proc( type : auto: S type : auto: T
    S slice.mut : src
    T slice.mut : target
  -> T slice.mut ) =>: export: fMapMutTo
    src freeze target fMapTo
  end
  overload: export: mapTo
    itrMapTo fMapTo itrMapMutTo fMapMutTo
  end
  namespace: mapItr
    proc( type : auto: T T slice.mapItr -> T slice.mapItr ) =>: export: prepare end
    proc( type : auto: S type : auto: T
      S T slice.mapToItr
    -> S T slice.mapToItr ) =>: prepareTo end
    proc( type : auto: T T slice.mapItr : itr -> bool ) =>: export: check
      itr .index itr .data .length <
    end
    proc( type : auto: S type : auto: T
      S T slice.mapToItr : itr
    -> bool ) =>: export: checkTo
      itr .index itr .src .length <
    end
    proc( type : auto: T T slice.mapItr : itr -> T ) =>: export: shadow: get
      itr .data itr .index slice.get
    end
    proc( type : auto: S type : auto: T
      S T slice.mapToItr : itr
    -> S ) =>: export: getTo
      itr .src itr .index slice.get
    end
    proc( type : auto: T T : newVal T slice.mapItr : itr -> T slice.mapItr ) =>: export: step
      newVal itr .data itr .index slice.set
      itr
        $ .index 1 + >$ .index=
      return
    end
    proc( type : auto: S type : auto: T
      T : newVal
      S T slice.mapToItr : itr
    -> S T slice.mapToItr ) =>: export: stepTo
      newVal itr .target itr .index slice.set
      itr
        $ .index 1 + >$ .index=
      return
    end
    proc( type : auto: T T slice.mapItr : itr -> T slice.mut ) =>: export: endItr
      itr .data
    end
    proc( type : auto: S type : auto: T
      S T slice.mapToItr : itr
    -> T slice.mut ) =>: export: endTo
      itr .target
    end
  end
  proc( type : auto: T T slice : elts -> T slice.reverseItr ) =>: export: getReverseItr
    elts elts .length 1 - T slice.reverseItr new
  end
  proc( type : auto: T T slice.mut : elts -> T slice.reverseItr ) =>: export: getReverseItrMut
    elts freeze reverseItr
  end
  overload: export: reversed
    getReverseItr getReverseItrMut
  end
  namespace: itr
    proc( type : auto: T T slice -> T slice.getItr ) =>: export: prepare
      0 T slice.getItr new
    end
    proc( type : auto: T T slice.mut -> T slice.getItr ) =>: export: prepareMut
      freeze 0 T slice.getItr new
    end
    proc( type : auto: T T slice.reverseItr -> T slice.reverseItr ) =>: export: prepareReverse end
    proc( type : auto: T T slice.getItr : itr -> bool ) =>: export: check
      itr .index itr .data .length <
    end
    proc( type : auto: T T slice.reverseItr : itr -> bool ) =>: export: checkReverse
      itr .index 0 >=
    end
    proc( type : auto: T T slice.getItr : itr -> T ) =>: shadow: export: get
      itr .data itr .index slice.get
    end
    proc( type : auto: T T slice.reverseItr : itr -> T ) =>: export: getReverse
      itr .data itr .index slice.get
    end
    proc( type : auto: T T slice.getItr : itr -> T slice.getItr ) =>: export: step
      itr
        $ .index 1 + >$ .index=
      return
    end
    proc( type : auto: T T slice.reverseItr : itr -> T slice.reverseItr ) =>: export: stepReverse
      itr
        $ .index 1 - >$ .index=
      return
    end
    proc( type : auto: T T slice.getItr : itr -> ) =>: export: endItr end
    proc( type : auto: T T slice.reverseItr : itr -> ) =>: export: endReverse end
  end
end
overload: export: []
  slice.get_32
  slice.get_64
  slice.get_32mut
  slice.get_64mut
end
overload: export: @[]
  slice.atValue_32
  slice.atValue_64
  slice.atValue_32mut
  slice.atValue_64mut
end
overload: export: []=
  slice.set_32
  slice.set_64
end
overload: export: ..itr.prepare
  slice.mapItr.prepare
  slice.mapItr.prepareTo
  slice.itr.prepare
  slice.itr.prepareMut
  slice.itr.prepareReverse
end
overload: export: ..itr.check
  slice.mapItr.check
  slice.mapItr.checkTo
  slice.itr.check
  slice.itr.checkReverse
end
overload: export: ..itr.get
  slice.mapItr.get
  slice.mapItr.getTo
  slice.itr.get
  slice.itr.getReverse
end
overload: export: ..itr.step
  slice.mapItr.step
  slice.mapItr.stepTo
  slice.itr.step
  slice.itr.stepReverse
end
overload: export: ..itr.end
  slice.mapItr.endItr
  slice.mapItr.endTo
  slice.itr.endItr
  slice.itr.endReverse
end
