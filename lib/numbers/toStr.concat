    precision 0x400 u> if 0x400 precision= end ## digits needed for exact representation of longest number in base 2
    precision 0 == if
      MANTISSA_BITS base number.baseDigits precision=
    end
    buffer@ slice.wrapMutable precision base sci number.sbAppendF
  end
