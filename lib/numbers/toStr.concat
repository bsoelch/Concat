namespace: f32
  proc(
    char8 slice.mut
    f32 ## val
    i32 : base ## base
  -> string i32 ) =>: export: digits
    MANTISSA_BITS base number.baseDigits =:: maxDigits
    ## TODO? special casing power-of-2 bases
    $1 .length maxDigits iSize cast.u u> if
      ## TODO? use fixed-point calculations with 128+128-bit numbers for high precission digit computation
      f64 cast base f64.digits return
    end
    base i32 number.floatDigits
  end
  proc( stringBuilder f32 i32 : mut: precision i32 : base bool : sci -> stringBuilder ) =>: export: sbAppend???
    char8 MANTISSA_BITS array : mut: buffer
    $ 0 f32.cmp 0 < if -_ >$ '-' sb.appendC <$ end ## cmp to ensure -0 < 0
    number.sbEnsureFinite .else return end
    precision 0x80 u> if 0x80 precision= end ## digits needed for exact representation of longest number in base 2
    precision 0 == if
      MANTISSA_BITS base number.baseDigits precision=
    end
    buffer@ slice.wrapMutable precision base sci number.sbAppendF
  end

  proc( stringBuilder f32 -> stringBuilder ) =>: export: sbAppend
    0 10 false sbAppend???
  end
