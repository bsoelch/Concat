    proc( stringBuilder iSize i32 char8 iSize -> stringBuilder ) : alias: export: paddedSbAppendU i64.paddedSbAppendU
  else iSize ..types.size i32 ..types.size == _if
    proc( stringBuilder iSize i32 : base bool #+signed+# -> stringBuilder ) : alias: export: sbAppend?? i32.sbAppend??
    proc( stringBuilder iSize i32 : base -> stringBuilder ) : alias: export: sbAppend? i32.sbAppend?
    proc( stringBuilder iSize i32 : base -> stringBuilder ) : alias: export: sbAppendU? i32.sbAppendU?
