namespace: f16
  proc(
    f16 ## val
  -> i32 ) =>: export: asFixedPoint
    ## convert to 16+16 fixed point number
    $ exponent <$
    bits MANTISSA_MASK &
      $1 0 != if HIDDEN_BIT | else >$ 1 + <$ end
    i32 cast.u >$ 21 EXP_BIAS i32 cast.u - + <<
  end

  proc( stringBuilder f16 i32 : mut: precision i32 : base bool : sci -> stringBuilder ) =>: export: sbAppend???
    precision 0 == if
      MANTISSA_BITS base number.baseDigits precision=
    end
    f16.asF32 precision base sci f32.sbAppend???
  end

  proc( stringBuilder f16 -> stringBuilder ) =>: export: sbAppend
    0 10 false sbAppend???
  end
