import stringBuilder

namespace: number
  proc( type.integer : auto: I
    char8 slice.mut
    I ## val
    i32 : base
  -> string ) =>: uintToStr
    base 2 < or base 62 > if
      ..drop.2 string.empty return
    end
    ## buf val
      $1 .length 1 - <$
      while ## buf index val
        $ base u% >$ base u/
        <<<$ ## rem buf index dVal
          digitChars >$ [] $2 $2 =[]
          1 -
        >>$
        $ 0 I i128 == if i128.fromU64 end !=
      end ..drop
    1 + slice.tail slice.freeze string.fromChars
  end
  proc( type : auto: I
    char8 slice.mut : buffer
    I : val
    i32 : base
    char8 : padChar iSize : minDigits
  -> string ) =>: uintToPaddedStr
    buffer .length minDigits u< if
      string.empty return
    end
    buffer val base uintToStr
      $ .length 0 == if return end
      $ .length minDigits u< if
        buffer $ .length minDigits - slice.tail ## last minDigit chars of buffer
          $ ## str buf
            $ .length >>>$ .length - slice.head
          padChar >$ slice.fill
        slice.freeze string.fromChars
      end
    return
  end

  { 0 0 1.0 0.6309297535714575 0.5 0.43067655807339306 0.38685280723454163 0.3562071871080222 0.3333333333333333
    0.31546487678572877 0.3010299956639812 0.2890648263178879 0.27894294565112987 0.27023815442731974
    0.26264953503719357 0.2559580248098155 0.25 0.24465054211822604 0.23981246656813146 0.23540891336663824
    0.23137821315975915 0.227670248696953 0.22424382421757544 0.22106472945750374 0.21810429198553155
    0.21533827903669653 0.21274605355336318 0.2103099178571525 0.20801459767650948 0.20584683246043448
    0.2037950470905062 0.20184908658209985 0.2 0.19823986317056053 0.1965616322328226 0.1949590218937863
    0.19342640361727081 0.19195872000656014 0.1905514124267734 0.18920035951687003 0.18790182470910757
    0.18665241123894338 0.1854490234153689 0.18428883314870617 0.18316925091363362 0.18208790046993825
    0.1810425967800402 0.18003132665669264 0.17905223175104137 0.1781035935540111 0.17718382013555792
    0.17629143438888212 0.17542506358195453 0.17458343004804494 0.17376534287144002 0.1729696904450771
    0.17219543379409813 0.17144160057391347 0.17070727966372012 0.16999161628691403 0.16929380759878143
    0.1686130986895011 0.16794877895704194
  } =:: export: DIGITS_PER_BIT

  proc( oneOf( i16 i32 i64 ) : auto: I  I #+bits+# i32 : base -> i32 ) =>: baseDigits
    f64 cast.s number.DIGITS_PER_BIT@ base [] *
      base i32.isPow2 if f64.ceil end
    i32 cast.u
  end
  proc( type.float : auto: F
    char8 slice.mut
    F #+val+#
    i32 : base
    i32 : exp
    type.integer : static: I
  -> char8 slice.mut I ) =>: digitInt
    base F f128 == if f128.fromI32 else F cast.s end
      ## TODO? would pow-function be more accurate than repeated multiplication
      $2 .length 1 - i32 cast.u exp - number.powI
        $ number.isFinite ! if ..drop
          base F f128 == if f128.fromI32 else F cast.s end
            $2 .length 1 - i32 cast.u exp -
          $ 2 u/ >$ $1 - ## val base exp1 exp2
            $2 >$ number.powI >>>$ * <<$
          number.powI
        end
      *
      <round>
    I i128 == if f128.toI128 else I cast.u end
  end
  overload: approxLog2
    f16.approxLog2
    f32.approxLog2
    f64.approxLog2
    f128.approxLog2
  end
  proc( type.float : auto: F
    char8 slice.mut
    F #+val+#
    i32 : base
    type.integer : static: I
  -> string i32 ) =>: floatDigits
    base 2 < or base 62 > if
      ..drop.2 string.empty 0 return
    end
    ## buf val
    $ ? ! if ..drop ## zero
      '0' $1 slice.fill
      slice.freeze string.fromChars 0 return
    end
    $ approxLog2 F f128 == if f128.toF64 else f64 cast.s end number.DIGITS_PER_BIT@ base [] * i32 cast.s =:: mut: exp ## estimate for log_base(val)
    $ =:: val
    base exp I digitInt
      base I i128 == if i128.fromI32 else I cast.u end
        $2 .length 1 - i32 cast.u
      number.powI ## sb iVal iPow
      $1 $1 u< if ..drop.2 ## val < base^(#digits-1)
        exp 1 - exp=
        val base exp I digitInt
      else base I i128 == if i128.fromI32 else I cast.u end * $1 u<= _if ..drop ## val >= base^(#digits)
        exp 1 + exp=
        val base exp I digitInt
      end
      $1 .length =:: count
    base '0' count number.uintToPaddedStr exp
  end
  proc( i32 #+base+# -> char8 ) =>: export: expChar
    $ 10 <= if ..drop 'E' else 30 <= _if 'X' else '#' end
  end
  proc( type.float : auto: F stringBuilder F #+val+# -> stringBuilder F optional ) =>: sbEnsureFinite
    $ number.isFinite ! if
      number.isNaN if
        "[NaN]":s
      else
        "[Infinity]":s
      end sb.appendStr
      F optional.empty return
    end
    optional.wrap return
  end
  proc( string -> string ) =>: removeTrailingZeros
    $ .length while
      $ 1 u> and $1 $1 1 - [] '0' ==
    do 1 - end string.head
  end
  proc( type.float : auto: F
    stringBuilder
    F #+val+#
    char8 slice.mut : buffer
    i32 : precision
    i32 : base
    bool : sci
  -> stringBuilder ) =>: inline: sbAppendF
    char8 slice.mut optional.empty =:: mut: toFree
    precision buffer .length i32 cast u<= if
      buffer precision slice.head
    else
      precision iSize cast.u char8 slice.new $ optional.wrap toFree=
    end
      >$ base digits
      sci or $ precision > or $ -5 < if
        >$ removeTrailingZeros <$
        >>$ ## digits exp sb
          $2 0 [] sb.appendC
          $2 .length 1 u> if
            '.' sb.appendC
            >>$ 1 string.tail sb.appendStr
          else >>$ ..drop end
          base number.expChar sb.appendC
          $1 0 >= if '+' sb.appendC end
          >$ base i32.sbAppend?
        return
      end
      1 + $ 0 > if
        iSize cast.u string.cutIndex <$ <<$ ## B sb A
          sb.appendStr
          >$ removeTrailingZeros <$
          $1 .length 0 != and $1 "0":s string.eq ! if
            '.' sb.appendC
             >$ sb.appendStr
          else >$ ..drop end
        return
      else
        >>$
          "0.":s sb.appendStr
          >$ -_ for ..drop '0' sb.appendC end
        >$ removeTrailingZeros sb.appendStr
      end
    toFree .if slice.free ..drop end
  end
end
namespace: i64
  proc( stringBuilder i64 i32 : base bool #+signed+# -> stringBuilder ) =>: export: sbAppend??
    char8 64 array : mut: buffer
    #+signed+# and $ 0 < if
      >$ '-' sb.appendC <$ -_
    end
      buffer@ slice.wrapMutable >$ base number.uintToStr
    sb.appendStr
  end
  proc( stringBuilder
    i64 #+val+#
    i32 : base
    char8 : padChar iSize : minDigits
  -> stringBuilder ) =>: export: paddedSbAppendU
    char8 64 array : mut: buffer
    minDigits 64 u> if
      <$ minDigits 64 - for ..drop padChar sb.appendC end >$
    end
      buffer@ slice.wrapMutable >$ base padChar minDigits 64 iSize.min number.uintToPaddedStr
    sb.appendStr
  end
  proc( stringBuilder i64 i32 #+base+# -> stringBuilder ) =>: export: sbAppend?
    true sbAppend??
  end
  proc( stringBuilder i64 i32 #+base+# -> stringBuilder ) =>: export: sbAppendU?
    false sbAppend??
  end
  proc( stringBuilder i64 -> stringBuilder ) =>: export: sbAppend
    10 true sbAppend??
  end
  proc( stringBuilder i64 -> stringBuilder ) =>: export: sbAppendU
    10 false sbAppend??
  end
  proc( stringBuilder i64 -> stringBuilder ) =>: export: sbAppendX
    16 true sbAppend??
  end
  proc( stringBuilder i64 -> stringBuilder ) =>: export: sbAppendUX
    16 false sbAppend??
  end
end
