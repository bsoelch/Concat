namespace: f128
  proc(
    char8 slice.mut
    f128 ## val
    i32 : base ## base
  -> string i32 ) =>: export: digits
    MANTISSA_BITS base number.baseDigits =:: maxDigits
    $1 .length maxDigits iSize cast.u u> if
      ## TODO: separate mode for high-precision printing
      "unimplemented: high-precision printing" ..panic
    end
    base i128 number.floatDigits
  end

  proc( stringBuilder f128 i32 : mut: precision i32 : base bool : sci -> stringBuilder ) =>: export: sbAppend???
    char8 MANTISSA_BITS array : mut: buffer
    $ .hi 0 < if -_ >$ '-' sb.appendC <$ end
    number.sbEnsureFinite .else return end
    precision 0x4000 u> if 0x4000 precision= end ## digits needed for integer representation of largest number in base 2
    precision 0 == if
      MANTISSA_BITS base number.baseDigits precision=
    end
    buffer@ slice.wrapMutable precision base sci number.sbAppendF
  end

  proc( stringBuilder f128 -> stringBuilder ) =>: export: sbAppend
    0 10 false sbAppend???
  end
  proc( stringBuilder f128 i32 #+base+# -> stringBuilder ) =>: export: sbAppend?
    0 >$ false sbAppend???
  end
  proc( stringBuilder f128 -> stringBuilder ) =>: export: sbAppendF
    0 10 false sbAppend???
  end
  proc( stringBuilder f128 i32 #+prec+# -> stringBuilder ) =>: export: sbAppendF?
    10 false sbAppend???
  end
  proc( stringBuilder f128 i32 #+prec+# i32 #+base+# -> stringBuilder ) =>: export: sbAppendF??
    false sbAppend???
  end
  proc( stringBuilder f128 -> stringBuilder ) =>: export: sbAppendE
    0 10 true sbAppend???
  end
  proc( stringBuilder f128 i32 #+prec+# -> stringBuilder ) =>: export: sbAppendE?
    10 true sbAppend???
  end
  proc( stringBuilder f128 i32 #+prec+# i32 #+base+# -> stringBuilder ) =>: export: sbAppendE??
    true sbAppend???
  end
  proc( stringBuilder f128 -> stringBuilder ) =>: export: sbAppendX
    0 16 false sbAppend???
  end
  proc( stringBuilder f128 i32 #+prec+# -> stringBuilder ) =>: export: sbAppendX?
    16 false sbAppend???
  end
  proc( stringBuilder f128 -> stringBuilder ) =>: export: sbAppendEX
    0 16 true sbAppend???
  end
  proc( stringBuilder f128 i32 #+prec+# -> stringBuilder ) =>: export: sbAppendEX?
    16 true sbAppend???
  end
  proc( stringBuilder f128 -> stringBuilder ) =>: export: sbAppendB
    0 2 false sbAppend???
  end
  proc( stringBuilder f128 i32 #+prec+# -> stringBuilder ) =>: export: sbAppendB?
    2 false sbAppend???
  end
  proc( stringBuilder f128 -> stringBuilder ) =>: export: sbAppendEB
    0 2 true sbAppend???
  end
  proc( stringBuilder f128 i32 #+prec+# -> stringBuilder ) =>: export: sbAppendEB?
    2 true sbAppend???
  end
end
namespace: number
  overload: digits
    ## f16.digits
    f32.digits
    f64.digits
    f128.digits
  end
end
