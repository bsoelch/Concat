import stringBuilder

namespace: sb
  "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz" =:: stringChars

  proc( stringBuilder : buffer i64 : i i32 : base bool : signed -> stringBuilder ) =>: export: appendI??
    base 2 < base 62 > | if
      ## TODO error handling
      buffer return
    end
    i8 64 array new =:: mut: chrBuff
    buffer
      i
      ..dup 0 < signed & if
        ..swap '-' appendC ..swap
        -_
      else ..dup 0 == _if
        ..drop '0' appendC return
      end
      63 ..swap ## index in chrBuff
        while ..dup 0 != do
          ..swap ## <buffer> <i> <chrIndex>
            ..over base ..umod stringChars ..swap []
            ..over chrBuff @ ..swap [] =
            1 -
          ..swap
          base ..udiv
        end ..drop
        while 1 + ..dup 64 < do
          ..swap ## <chrIndex> <buffer>
            ..over chrBuff @ ..swap [] appendC
          ..swap
        end
      ..drop
    return
  end
  proc( stringBuilder i64 #+value+# i32 #+base+# -> stringBuilder ) =>: export: appendI?
    true appendI??
  end
  proc( stringBuilder i64 #+value+# -> stringBuilder ) =>: export: appendBin
    2  appendI?
  end
  proc( stringBuilder i64 #+value+# -> stringBuilder ) =>: export: appendI
    10 appendI?
  end
  proc( stringBuilder i64 #+value+# -> stringBuilder ) =>: export: appendX
    16 appendI?
  end
  proc( stringBuilder i64 #+value+# -> stringBuilder ) =>: export: appendUBin
    2 false appendI??
  end
  proc( stringBuilder i64 #+value+# -> stringBuilder ) =>: export: appendU
    10 false appendI??
  end
  proc( stringBuilder i64 #+value+# -> stringBuilder ) =>: export: appendUHex
    16 false appendI??
  end
end
