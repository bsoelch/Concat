import stringBuilder

namespace: sb
  "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz" =:: stringChars

  proc( stringBuilder : buffer i64 : i i32 : base bool : signed -> stringBuilder ) =>: export: appendI??
    base 2 < base 62 > | if
      ## TODO error handling
      buffer return
    end
    char8 64 array new =:: mut: chrBuff
    buffer
      i
      ..dup 0 < signed & if
        ..swap '-' appendC ..swap
        -_
      else ..dup 0 == _if
        ..drop '0' appendC return
      end
      63 ..swap ## index in chrBuff
        while ..dup 0 != do
          ..swap ## <buffer> <i> <chrIndex>
            ..over base u% stringChars ..swap []
            ..over chrBuff@ ..swap =[]
            1 -
          ..swap
          base u/
        end ..drop
        while 1 + ..dup 64 < do
          ..swap ## <chrIndex> <buffer>
            ..over chrBuff@ ..swap [] appendC
          ..swap
        end
      ..drop
    return
  end
  proc( stringBuilder i64 #+value+# i32 #+base+# -> stringBuilder ) =>: export: appendI?
    true appendI??
  end
  proc( stringBuilder i64 #+value+# i32 #+base+# -> stringBuilder ) =>: export: appendU?
    false appendI??
  end
  proc( stringBuilder i64 #+value+# -> stringBuilder ) =>: export: appendBin
    2  appendI?
  end
  ## TODO? versions for i8/i16
  proc( stringBuilder i64 #+value+# -> stringBuilder ) =>: export: appendI64
    10 appendI?
  end
  proc( stringBuilder i32 #+value+# -> stringBuilder ) =>: export: appendI32
    i64 cast.s 10 appendI?
  end
  proc( stringBuilder i32 #+value+# -> stringBuilder ) =>: export: appendX32
    i64 cast.u 16 appendI?
  end
  proc( stringBuilder i64 #+value+# -> stringBuilder ) =>: export: appendX64
    i64 cast.s 16 appendI?
  end
  proc( stringBuilder i64 #+value+# -> stringBuilder ) =>: export: appendUBin
    2 false appendI??
  end
  proc( stringBuilder i32 #+value+# -> stringBuilder ) =>: export: appendU32
    i64 cast.u 10 false appendI??
  end
  proc( stringBuilder i64 #+value+# -> stringBuilder ) =>: export: appendU64
    10 false appendI??
  end
  proc( stringBuilder i32 #+value+# -> stringBuilder ) =>: export: appendUX32
    i64 cast.u 16 false appendI??
  end
  proc( stringBuilder i64 #+value+# -> stringBuilder ) =>: export: appendUX64
    16 false appendI??
  end
  overload: export: appendI
    appendI32
    appendI64
  end
  overload: export: appendU
    appendU32
    appendU64
  end
  overload: export: appendX
    appendX32
    appendX64
  end
  overload: export: appendUX
    appendUX32
    appendUX64
  end
  overload: export: appendUHex
    appendUX32
    appendUX64
  end
end
namespace: sb.operators
  overload: <<+
    sb.appendI
  end
  overload: <<U+
    sb.appendU
  end
  overload: <<B+
    sb.appendBin
  end
  overload: <<UB+
    sb.appendUBin
  end
  ## TODO? seperate versions for upper/lower-case hex
  overload: <<X+
    sb.appendX
  end
  overload: <<UX+
    sb.appendUX
  end
end
