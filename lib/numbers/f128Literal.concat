import numbers/f128
namespace: f128.static
  proc( char8 _ ptr : chars i64 : k -> f128 ) =>: static: export: shaddow: parse
    char8 128 array : errMessageBuffer
    chars k string.create =:: str
    str 0 f128.parse =:: err
    err .NONE ?? or err .INT ?? if
      return
    else err .OVERFLOW ?? _if
      errMessageBuffer@ $ ..length i32 cast sb.fromBuffer
        "float literal overflows size for type f128: `" sb.appendS
        str sb.appendStr
        '`' sb.appendC
      sb.asStr ..compiler.warning
      return
    end
    errMessageBuffer@ $ ..length i32 cast sb.fromBuffer
      "invalid float constant: `" sb.appendS
      str sb.appendStr
      '`' sb.appendC
    sb.asStr ..compiler.error
  end
end
