## XXX? bit-cast operation

## TODO include floating point limits
namespace: f32
  union( f32  : f i32 : i ) =:: Converter
  proc( f32 -> i32 ) =>: export: bits
    Converter cast .i return
  end
  proc( i32 -> f32 ) =>: export: fromBits
    Converter cast .f return
  end
  0x8000'0000:u =:: export: SIGN_FLAG
  0x7f80'0000:u =:: export: EXP_MASK
  0x007f'ffff:u =:: export: MANTISSA_MASK
  0x0080'0000:u =:: export: HIDDEN_BIT
  23 =:: export: MANTISSA_BITS
  23 =:: export: EXP_SHIFT
  0xff =:: export: SHIFTED_EXP_MASK
  127 =:: export: EXP_BIAS

  -0xf.fffffX1f:f32 =:: export: MIN
  0xf.fffffX1f:f32 =:: export: MAX
  proc( -> f32 ) =>: export: NaN
    EXP_MASK MANTISSA_MASK | fromBits
  end
  proc( -> f32 ) =>: export: Infinity
    EXP_MASK fromBits
  end
  proc( -> f32 ) =>: export: -Infinity
    SIGN_FLAG EXP_MASK | fromBits
  end
  proc( f32 : x -> bool ) =>: export: isNaN
    x isFinite if false return end
    x bits MANTISSA_MASK & 0 !=
  end
  proc( f32 : x -> bool ) =>: export: isInfinite
    x isFinite if false return end
    x bits MANTISSA_MASK & 0 ==
  end
  proc( f32 : x -> bool ) =>: export: isFinite
    x bits EXP_MASK & EXP_MASK !=
  end

  proc( f32 : x -> f32 ) =>: export: truncate
    x bits =:: i
    i MANTISSA_MASK & =:: m
    i EXP_SHIFT >>> SHIFTED_EXP_MASK & EXP_BIAS - =:: e
    e 0 < if ## absolute value < 1
      i SIGN_FLAG & fromBits return
    end
    e MANTISSA_BITS >= if
      ## smallest bit has magnitude > 1
      x return
    end
    i MANTISSA_MASK ~ &
      m MANTISSA_MASK MANTISSA_BITS e - << & |
    fromBits return
  end
  proc( f32 : x -> f32 ) =>: export: floor
    x truncate =:: y
    x 0 < and x y != if
      y 1 f32 cast - return
    end
    y return
  end
  proc( f32 : x -> f32 ) =>: export: ceil
    x truncate =:: y
    x 0 > and x y != if
      y 1 f32 cast + return
    end
    y return
  end
  ## half-even rounding
  proc( f32 : x -> f32 ) =>: export: round
    x bits =:: i
    i MANTISSA_MASK & =:: m
    i EXP_SHIFT >>> SHIFTED_EXP_MASK & EXP_BIAS - =:: e
    e -1 < if ## absolute value < 0.5
      i SIGN_FLAG & fromBits return
    else e -1 == _if ## 1 < |x| <= 0.5
      m 0 == if ## |x|=0.5
        i SIGN_FLAG & fromBits return
      end
      x 0 < if -1.0 f32 cast else 1.0 f32 cast end return
    end
    e MANTISSA_BITS >= if
      ## smallest bit has magnitude > 1
      x return
    end
    m -1:i32 32 MANTISSA_BITS - e + >>> & =:: fract
    1:u32 MANTISSA_BITS 1 - e - << =:: half
    i MANTISSA_MASK ~ &
      m MANTISSA_MASK MANTISSA_BITS e - << & |
    fromBits =:: trunc
    fract 0 == if
      trunc return ## already an integer
    end
    x 0 < if -1.0 f32 cast else 1.0 f32 cast end =:: delta
    fract half < if
      trunc return
    end
    fract half > if
      trunc delta + return
    end
    m HIDDEN_BIT | half 1 << & 0 != if ## half and odd
      trunc delta + return
    end
    trunc return
  end

  proc( f32 : a -> f32 ) =>: export: abs
    a bits SIGN_FLAG ~ & fromBits return
  end
  proc( f32 : a f32 : b -> f32 ) =>: export: min
    a b < if a else b end
  end
  proc( f32 : a f32 : b -> f32 ) =>: export: max
    a b > if a else b end
  end

  proc( f32 : a f32 : b -> f32 ) =>: export: rem
    a b / truncate =:: d
    a d b * - return
  end
  proc( f32 : a f32 : b -> f32 ) =>: export: floorDiv
    a b / floor return
  end
  proc( f32 : a f32 : b -> f32 ) =>: export: mod
    a b / floor =:: d
    a d b * - return
  end
end
namespace: f64
  union( f64  : d i64 : i ) =:: Converter
  proc( f64 -> i64 ) =>: export: bits
    Converter cast .i return
  end
  proc( i64 -> f64 ) =>: export: fromBits
    Converter cast .d return
  end
  0x8000'0000'0000'0000:u =:: export: SIGN_FLAG
  0x7ff0'0000'0000'0000:u =:: export: EXP_MASK
  0x000f'ffff'ffff'ffff:u =:: export: MANTISSA_MASK
  0x0010'0000'0000'0000:u =:: export: HIDDEN_BIT
  52 =:: export: MANTISSA_BITS
  52 =:: export: EXP_SHIFT
  0x7ff =:: export: SHIFTED_EXP_MASK
  1023 =:: export: EXP_BIAS

  -0xf.ffffffffffff8Xff =:: export: MIN
  0xf.ffffffffffff8Xff =:: export: MAX
  proc( -> f64 ) =>: export: NaN
    EXP_MASK MANTISSA_MASK | fromBits
  end
  proc( -> f64 ) =>: export: Infinity
    EXP_MASK fromBits
  end
  proc( -> f64 ) =>: export: -Infinity
    SIGN_FLAG EXP_MASK | fromBits
  end
  proc( f64 : x -> bool ) =>: export: isNaN
    x isFinite if false return end
    x bits MANTISSA_MASK & 0 !=
  end
  proc( f64 : x -> bool ) =>: export: isInfinite
    x isFinite if false return end
    x bits MANTISSA_MASK & 0 ==
  end
  proc( f64 : x -> bool ) =>: export: isFinite
    x bits EXP_MASK & EXP_MASK !=
  end

  proc( f64 : x -> f64 ) =>: export: truncate
    x bits =:: i
    i MANTISSA_MASK & =:: m
    i EXP_SHIFT >>> SHIFTED_EXP_MASK & EXP_BIAS - =:: e
    e 0 < if ## absolute value < 1
      i SIGN_FLAG & fromBits return
    end
    e MANTISSA_BITS >= if
      ## smallest bit has magnitude > 1
      x return
    end
    i MANTISSA_MASK ~ &
      m MANTISSA_MASK MANTISSA_BITS e - << & |
    fromBits return
  end
  proc( f64 : x -> f64 ) =>: export: floor
    x truncate =:: y
    x 0 < and x y != if
      y 1 - return
    end
    y return
  end
  proc( f64 : x -> f64 ) =>: export: ceil
    x truncate =:: y
    x 0 > and x y != if
      y 1 + return
    end
    y return
  end
  ## half-even rounding
  proc( f64 : x -> f64 ) =>: export: round
    x bits =:: i
    i MANTISSA_MASK & =:: m
    i EXP_SHIFT >>> SHIFTED_EXP_MASK & EXP_BIAS - =:: e
    e -1 < if ## absolute value < 0.5
      i SIGN_FLAG & fromBits return
    else e -1 == _if ## 1 < |x| <= 0.5
      m 0 == if ## |x|=0.5
        i SIGN_FLAG & fromBits return
      end
      x 0 < if -1.0 else 1.0 end return
    end
    e MANTISSA_BITS >= if
      ## smallest bit has magnitude > 1
      x return
    end
    m -1:i64 64 MANTISSA_BITS - e + >>> & =:: fract
    1:u64 MANTISSA_BITS 1 - e - << =:: half
    i MANTISSA_MASK ~ &
      m MANTISSA_MASK MANTISSA_BITS e - << & |
    fromBits =:: trunc
    fract 0 == if
      trunc return ## already an integer
    end
    x 0 < if -1.0 else 1.0 end =:: delta
    fract half < if
      trunc return
    end
    fract half > if
      trunc delta + return
    end
    m HIDDEN_BIT | half 1 << & 0 != if ## half and odd
      trunc delta + return
    end
    trunc return
  end

  proc( f64 : a -> f64 ) =>: export: abs
    a bits SIGN_FLAG ~ & fromBits return
  end
  proc( f64 : a f64 : b -> f64 ) =>: export: min
    a b < if a else b end
  end
  proc( f64 : a f64 : b -> f64 ) =>: export: max
    a b > if a else b end
  end

  proc( f64 : a f64 : b -> f64 ) =>: export: rem
    a b / truncate =:: d
    a d b * - return
  end
  proc( f64 : a f64 : b -> f64 ) =>: export: floorDiv
    a b / floor return
  end
  proc( f64 : a f64 : b -> f64 ) =>: export: mod
    a b / floor =:: d
    a d b * - return
  end
end

overload: %
  f32.rem
  f64.rem
end
overload: export: //
  f32.floorDiv
  f64.floorDiv
end
overload: export: %%
  f32.mod
  f64.mod
end
