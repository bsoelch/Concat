namespace: i8
  -0x80:i8 i8 =: export: MIN
   0x7f:i8 i8 =: export: MAX
   0xff:u16 i16 =: export: UMAX
   0xff:i16 i16 =: export: MASK
  proc( i8 : a i8 : b -> i8 ) =>: export: min
    a b < if a else b end
  end
  proc( i8 : a i8 : b -> i8 ) =>: export: max
    a b > if a else b end
  end
  proc( i8 : a -> i8 ) =>: export: abs
    a 0 < if a -_ else a end
  end
end
namespace: i16
  -0x8000:i16 i16 =: export: MIN
   0x7fff:i16 i16 =: export: MAX
   0xffff:u32 i32 =: export: UMAX
   0xffff     i32 =: export: MASK
  proc( i16 : a i16 : b -> i16 ) =>: export: min
    a b < if a else b end
  end
  proc( i16 : a i16 : b -> i16 ) =>: export: max
    a b > if a else b end
  end
  proc( i16 : a -> i16 ) =>: export: abs
    a 0 < if a -_ else a end
  end
end
namespace: i32
  -0x8000_0000 i32 =: export: MIN
   0x7fff_ffff i32 =: export: MAX
   0xffff_ffff:u64 i64 =: export: UMAX
   0xffff_ffff     i64 =: export: MASK
  proc( i32 : a i32 : b -> i32 ) =>: export: min
    a b < if a else b end
  end
  proc( i32 : a i32 : b -> i32 ) =>: export: max
    a b > if a else b end
  end
  proc( i32 : a -> i32 ) =>: export: abs
    a 0 < if a -_ else a end
  end
  proc( i32 : a i32 : b -> i32 ) =>: export: floorDiv
    a b /
      a b % ? and a 0 < b 0 < ^ if
        1 -
      end
    return
  end
  proc( i32 : a i32 : b -> i32 ) =>: export: mod
    b 0 > if
      a b %
        ..dup 0 < if b + end
      return
    else
      a b %
        ..dup 0 > if b + end
      return
    end
  end

  ## position of the highest nonzero-bit (zero-indexed), returns -1 if the input is zero
  proc( i32 -> i32 ) =>: export: highestSetBit
    =:: mut: x
    0
      x 0xffff'0000:u32 & ? if
        16 +
        x 16 >>> x =
      end
      x 0xff00:u32 & ? if
        8 +
        x 8 >>> x =
      end
      x 0xf0:u32 & ? if
        4 +
        x 4 >>> x =
      end
      x 0b1100:u32 & ? if
        2 +
        x 2 >>> x =
      end
      x 0b10:u32 & ? if
        1 +
        x 1 >>> x =
      end
    x 1 - i32 cast + return
  end
end
namespace: i64
  -0x8000_0000_0000_0000 i64 =: export: MIN
   0x7fff_ffff_ffff_ffff i64 =: export: MAX
   0xffff_ffff_ffff_ffff:u i64 =: export: UMAX
  proc( i64 : a i64 : b -> i64 ) =>: export: min
    a b < if a else b end
  end
  proc( i64 : a i64 : b -> i64 ) =>: export: max
    a b > if a else b end
  end
  proc( i64 : a -> i64 ) =>: export: abs
    a 0 < if a -_ else a end
  end
  proc( i64 : a i64 : b -> i64 ) =>: export: floorDiv
    a b /
      a b % ? and a 0 < b 0 < ^ if
        1 -
      end
    return
  end
  proc( i64 : a i64 : b -> i64 ) =>: export: mod
    b 0 > if
      a b %
        ..dup 0 < if b + end
      return
    else
      a b %
        ..dup 0 > if b + end
      return
    end
  end

  ## position of the highest nonzero-bit (zero-indexed), returns -1 if the input is zero
  proc( i64 -> i32 ) =>: export: highestSetBit
    =:: mut: x
    0
      x 0xffff'ffff'0000'0000:u64 & ? if
        32 +
        x 32 >>> x =
      end
      x 0xffff'0000:u64 & ? if
        16 +
        x 16 >>> x =
      end
      x 0xff00:u64 & ? if
        8 +
        x 8 >>> x =
      end
      x 0xf0:u64 & ? if
        4 +
        x 4 >>> x =
      end
      x 0b1100:u64 & ? if
        2 +
        x 2 >>> x =
      end
      x 0b10:u64 & ? if
        1 +
        x 1 >>> x =
      end
    x 1 - i32 cast + return
  end
  ## a + b + carry -> newCarry res
  proc( bool : carry i64 : a i64 : b -> bool i64 ) =>: export: addc
    a b +
      ..dup b ..u< =:: mut: resCarry
      carry if
        1 +
        resCarry ..over 0 == | resCarry =
      end
    resCarry ..swap return
  end
  ## a - (b + carry) -> newCarry res
  proc( bool : carry i64 : a i64 : b -> bool i64 ) =>: export: subb
    a b ..u< =:: mut: resCarry
    a b -
      carry if
        1 -
        resCarry ..over 0 == | resCarry =
      end
    resCarry ..swap return
  end
  proc( i64 : a i64 : b -> i64 i64 ) =>: export: umul2
    a i32.MASK &  i64 =: aLow
    a 32 >>> i64 =: aHi
    b i32.MASK &  i64 =: bLow
    b 32 >>> i64 =: bHi
    aLow bLow * =:: x00
    aLow bHi  * =:: x01
    aHi  bLow * =:: x10
    aHi  bHi  * =:: x11
    x01 x10 + =:: mid
    false
      x00 mid 32 << addc =:: low
      x11 mid 32 >>> addc =:: hi
    ! assert "umul2 does not overflow"
    hi low return
  end
end

overload: export: //
  i32.floorDiv
  i64.floorDiv
end
overload: export: %%
  i32.mod
  i64.mod
end
