namespace: i8
  -0x80i8 i8 =: export: MIN
   0x7fi8 i8 =: export: MAX
   0xffu8 i8 =: export: UMAX
   0xffi16 i16 =: export: MASK
  proc( i8 : a i8 : b -> i8 ) =>: export: min
    a b < if a else b end
  end
  proc( i8 : a i8 : b -> i8 ) =>: export: max
    a b > if a else b end
  end
  proc( i8 : a -> i8 ) =>: export: abs
    a 0 < if a -_ else a end
  end
end
namespace: i16
  -0x8000i16 i16 =: export: MIN
   0x7fffi16 i16 =: export: MAX
   0xffffu16 i16 =: export: UMAX
   0xffff    i32 =: export: MASK
  proc( i16 : a i16 : b -> i16 ) =>: export: min
    a b < if a else b end
  end
  proc( i16 : a i16 : b -> i16 ) =>: export: max
    a b > if a else b end
  end
  proc( i16 : a -> i16 ) =>: export: abs
    a 0 < if a -_ else a end
  end
end
namespace: i32
  -0x8000_0000 i32 =: export: MIN
   0x7fff_ffff i32 =: export: MAX
   0xffff_ffffu i32 =: export: UMAX
   0xffff_ffff  i64 =: export: MASK
  proc( i32 : a i32 : b -> i32 ) =>: export: min
    a b < if a else b end
  end
  proc( i32 : a i32 : b -> i32 ) =>: export: max
    a b > if a else b end
  end
  proc( i32 : a -> i32 ) =>: export: abs
    a 0 < if a -_ else a end
  end
  proc( i32 : a i32 : b -> i32 ) =>: export: floorDiv
    a b /
      a b % ? if a 0 < b 0 < ^ _if
        1 -
      end
    return
  end
  proc( i32 : a i32 : b -> i32 ) =>: export: mod
    b 0 > if
      a b %
        ..dup 0 < if b + end
      return
    else
      a b %
        ..dup 0 > if b + end
      return
    end
  end
end
namespace: i64
  -0x8000_0000_0000_0000 i64 =: export: MIN
   0x7fff_ffff_ffff_ffff i64 =: export: MAX
   0xffff_ffff_ffff_ffffu i64 =: export: UMAX
  proc( i64 : a i64 : b -> i64 ) =>: export: min
    a b < if a else b end
  end
  proc( i64 : a i64 : b -> i64 ) =>: export: max
    a b > if a else b end
  end
  proc( i64 : a -> i64 ) =>: export: abs
    a 0 < if a -_ else a end
  end
  proc( i64 : a i64 : b -> i64 ) =>: export: floorDiv
    a b /
      a b % ? if a 0 < b 0 < ^ _if
        1 -
      end
    return
  end
  proc( i64 : a i64 : b -> i64 ) =>: export: mod
    b 0 > if
      a b %
        ..dup 0 < if b + end
      return
    else
      a b %
        ..dup 0 > if b + end
      return
    end
  end
end

#:if:exp
overload: export: //
  i32.floorDiv
  i64.floorDiv
end
overload: export: %%
  i32.mod
  i64.mod
end
#:end
