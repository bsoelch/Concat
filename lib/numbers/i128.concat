import core/integers
import numbers

struct(
  i64 : hi
  i64 : low
) =:: export: i128

## TODO make sure to use unsigned comparisson for comparing parts of i128
namespace: i128
  { 0 : hi 0 : low } i128 =: export: ZERO
  { 0 : hi 1 : low } i128 =: export: ONE
  { i64.MIN : hi 0 : low } i128 =: export: MIN
  { i64.MAX : hi -1 : low } i128 =: export: MAX

  proc( i32 : low -> i128 ) =>: export: fromI32
    low 0 < if -1:i64 else 0:i64 end low i64 cast.s i128 new
  end
  proc( i64 : low -> i128 ) =>: export: fromI64
    low 0 < if -1:i64 else 0:i64 end low i128 new
  end
  proc( i64 : low -> i128 ) =>: export: fromU64
    0 low i128 new
  end
  proc( i64 : hi i64 : low -> i128 ) =>: export: create
    hi low i128 new
  end

  proc( i128 : a -> i128 ) =>: export: flip
    ## i128
      a .hi i64.flip
      a .low i64.flip
    i128 new
  end
  proc( i128 : a i128 : b -> i128 ) =>: export: and
    ## i128
      a .hi b .hi i64.and
      a .low b .low i64.and
    i128 new
  end
  proc( i128 : a i128 : b -> i128 ) =>: export: or
    ## i128
      a .hi b .hi i64.or
      a .low b .low i64.or
    i128 new
  end
  proc( i128 : a i128 : b -> i128 ) =>: export: xor
    ## i128
      a .hi b .hi i64.xor
      a .low b .low i64.xor
    i128 new
  end
  proc( i128 : a i128 : b -> i128 ) =>: export: shl
    a b .low i32 cast.u shl_i32
  end
  proc( i128 : a i64 : b -> i128 ) =>: export: shl_i64
    a b i32 cast.u shl_i32
  end
  proc( i128 : a i32 : b -> i128 ) =>: export: shl_i32
    b 127 & =:: shift
    shift 0 == if
      a return
    else shift 64 >= _if
      ## i128
        a .low shift 64 - <<
        0
      i128 new return
    end
    ## i128
      a .hi shift << a .low 64 shift - >>> |
      a .low shift <<
    i128 new
  end
  proc( i128 : a i128 : b -> i128 ) =>: export: lshr
    a b .low i32 cast.u lshr_i32
  end
  proc( i128 : a i64 : b -> i128 ) =>: export: lshr_i64
    a b i32 cast.u lshr_i32
  end
  proc( i128 : a i32 : b -> i128 ) =>: export: lshr_i32
    b 127 & =:: shift
    shift 0 == if
      a return
    else shift 64 >= _if
      ## i128
        0
        a .hi shift 64 - >>>
      i128 new return
    end
    ## i128
      a .hi shift >>>
      a .low shift >>> a .hi 64 shift - << |
    i128 new
  end
  proc( i128 : a i128 : b -> i128 ) =>: export: ashr
    a b .low i32 cast.u ashr_i32
  end
  proc( i128 : a i64 : b -> i128 ) =>: export: ashr_i64
    a b i32 cast.u ashr_i32
  end
  proc( i128 : a i32 : b -> i128 ) =>: export: ashr_i32
    b 127 & =:: shift
    shift 0 == if
      a return
    else shift 64 >= _if
      ## i128
        a .hi 0 < if -1:i64 else 0:i64 end
        a .hi shift 64 - >>
      i128 new return
    end
    ## i128
      a .hi shift >>
      a .low shift >>> a .hi 64 shift - << |
    i128 new
  end
  proc( i128 : x -> i32 ) =>: export: highestSetBit
    x .hi 0 == if
      x .low i64.highestSetBit return
    end
    x .hi i64.highestSetBit 64 + return
  end
  proc( i128 : a i128 : b -> i32 ) =>: export: ucmp
    a .hi b .hi u< if
      -1 return
    else a .hi b .hi u> _if
      1 return
    end
    a .low b .low u< if
      -1 return
    else a .low b .low u> _if
      1 return
    else
      0 return
    end
  end
  proc( i128 : a i128 : b -> i32 ) =>: export: cmp
    a .hi 0 < b .hi 0 < == if ## same sign
      a b ucmp return
    end
    a .hi 0 < if -1 else 1 end return
  end

  proc( i128 : a i128 : b -> bool ) =>: export: eq
    a b cmp 0 ==
  end
  proc( i128 : a i128 : b -> bool ) =>: export: ne
    a b cmp 0 !=
  end
  proc( i128 : a i128 : b -> bool ) =>: export: ult
    a b ucmp 0 <
  end
  proc( i128 : a i128 : b -> bool ) =>: export: ule
    a b ucmp 0 <=
  end
  proc( i128 : a i128 : b -> bool ) =>: export: uge
    a b ucmp 0 >=
  end
  proc( i128 : a i128 : b -> bool ) =>: export: ugt
    a b ucmp 0 >
  end
  proc( i128 : a i128 : b -> bool ) =>: export: lt
    a b cmp 0 <
  end
  proc( i128 : a i128 : b -> bool ) =>: export: le
    a b cmp 0 <=
  end
  proc( i128 : a i128 : b -> bool ) =>: export: ge
    a b cmp 0 >=
  end
  proc( i128 : a i128 : b -> bool ) =>: export: gt
    a b cmp 0 >
  end
  proc( i128 : a -> bool ) =>: export: toBool
    a .hi ? a .low ? |
  end
  proc( i128 : a -> i128 ) =>: export: neg
    ## i128
      a .hi i64.flip a .low 0 == if 1 + end
      a .low i64.neg
    i128 new
  end
  ## XXX? use i64.addc for add
  proc( i128 : a i128 : b -> i128 ) =>: export: add
    a .low b .low i64.add =:: lowSum
    ## i128
      a .hi b .hi i64.add  lowSum a .low u< if 1 + end
      lowSum
    i128 new
  end
  proc( i128 : a i128 : b -> i128 ) =>: export: sub
    ## i128
      a .hi b .hi i64.sub  a .low b .low u< if 1 - end
      a .low b .low i64.sub
    i128 new
  end
end
namespace: i128
  proc( i128 : a i128 : b -> i128 ) =>: export: mul
    ## (a+b*2^64) (c+d*2^64) = a*c+2^64*(a*d+b*c)+2^128*(b*d)
    a .low b .low i64.umul2 =:: x00low =:: x00hi
    ## i128
      x00hi a .hi b .low * + a .low b .hi * +
      x00low
    i128 new
  end
  proc( i128 : a i128 : b -> i128 i128 ) =>: export: umul2
    a .hi  b .hi  i64.umul2 =:: x11low =:: x11hi
    a .hi  b .low i64.umul2 =:: x10low =:: x10hi
    a .low b .hi  i64.umul2 =:: x01low =:: x01hi
    a .low b .low i64.umul2 =:: x00low =:: x00hi
    x00low =:: res0
    x00hi  =:: mut: res1
    x11low =:: mut: res2
    x11hi  =:: mut: res3
    false
      res1 x01low i64.addc res1=
      res2 x01hi  i64.addc res2=
      res3 0      i64.addc res3=
    ..drop
    false
      res1 x10low i64.addc res1=
      res2 x10hi  i64.addc res2=
      res3 0      i64.addc res3=
    ..drop
    res3 res2 i128 new res1 res0 i128 new return
  end
  proc(
    i128 : a
    i64 : b
  ->
    i64 #+division+#
    i64 #+remainder+#
  ) =>: export: udivMod64to64
    a .hi b i64 cast.u u< "result first in i64" assert
    ## TODO? dedicated algorithm (? use x64 div instruction if available)
    a b fromU64 udivMod >$ .low >$ .low
  end
  proc(
    i128 : a
    i64 : b
  ->
    i128 #+division+#
    i64 #+remainder+#
  ) =>: export: udivMod64
    ## TODO? dedicated algorithm
    a b fromU64 udivMod .low
  end
  proc(
    i128 : a
    i128 : b
  ->
    i128 #+division+#
    i128 #+remainder+#
  ) =>: export: udivMod
    a b ucmp 0 < if
      ## return
        0 0 i128 new
        a
      return
    end
    a .hi 0 == if ## both fit in 64 bits
      a .low b .low i64.udivMod
        >$ fromU64
      >$ fromU64 return
    end
    ## TODO? handle more special cases
    ## (b.hi=0,b.low=0,b=2^k,...)
    a highestSetBit b highestSetBit - =:: shift
    a =:: mut: remainderA
    0 0 i128 new =:: mut: res
    b shift << =:: mut: shiftedB
    shift 64 >= if
      ## i128
        1:i64 shift 64 - <<
        0
      i128 new
    else
      ## i128
        0
        1:i64 shift <<
      i128 new
    end =:: mut: bit
    while bit .hi bit .low | ? do
      remainderA shiftedB ucmp 0 >= if
        remainderA shiftedB - remainderA=
        res bit | res=
      end
      shiftedB 1 >>> shiftedB=
      bit 1 >>> bit=
    end
    res remainderA return
  end
  proc(
    i128 : a
    i128 : b
  -> i128 ) =>: export: udiv
    a b udivMod ..drop
  end
  proc(
    i128 : a
    i128 : b
  -> i128 ) =>: export: umod
    a b udivMod ..swap ..drop
  end
  proc(
    i128 : a
    i64 : b
  ->
    i128 #+division+#
    i64 #+remainder+#
  ) =>: export: divRem64
    ## TODO? dedicated algorithm
    a b fromU64 divRem .low
  end
  proc(
    i128 : a0
    i128 : b0
  ->
    i128 #+division+#
    i128 #+remainder+#
  ) =>: export: divRem
    false =:: mut: divSign
    a0 .hi 0 < =:: remSign
    a0 .hi 0 < if
      true divSign=
      a0 -_
    else
      a0
    end =:: a
    b0 .hi 0 < if
      divSign ! divSign=
      b0 -_
    else
      b0
    end =:: b
    a b udivMod =:: mut: remVal =:: mut: divVal
    ## return
      divVal divSign if -_ end
      remVal remSign if -_ end
    return
  end
  proc(
    i128 : a
    i128 : b
  -> i128 ) =>: export: div
    a b divRem ..drop
  end
  proc(
    i128 : a
    i128 : b
  -> i128 ) =>: export: rem
    a b divRem ..swap ..drop
  end

  proc(
    string : str
    i32 : base
    bool : unsigned
  -> i128 number.ParserError ) =>: export: parse
    using number.
    false =:: mut: overflow
    false =:: mut: signedOverflow
    str
      parseSign =:: sign
      ..dup .length 0:iSize == if ..drop
        0 0 i128 new ParserError .EMPTY return
      end
      base 0 == if
        resolveBase
      else
        base
      end =:: mBase
      mBase 0 < if ..drop
        0 0 i128 new ParserError .INVALID_CHAR return
      else mBase 2 < or mBase 62 > _if ..drop
        0 0 i128 new ParserError .INVALID_BASE return
      end
      -1:i64 -1:i64 i128 new =:: maxUnsigned
      unsigned if
        maxUnsigned
      else sign _if
        -0x8000_0000_0000_0000:i64 0:i64 i128 new
      else
        0x7fff_ffff_ffff_ffff:i64 -1:i64 i128 new
      end =:: maxVal
      0 0 i128 new =:: mut: res
      0 mBase i64 cast.u i128 new =:: baseI128
      maxUnsigned baseI128 u/ =:: maxSafeUnsigned
      maxVal baseI128 u/ =:: maxSafe ## XXX? udiv i128 by i64
      0:iSize while ..dup ..over.2 .length u< do =:: i
        ..dup i string.charAt =:: c
        i 0:iSize iSize.sgt and c '_' == or c '\'' == if
          i 1:iSize + continue ## ignore _ and ' in numbers
        end
        c mBase parseDigit
          $ .DIGIT ! if
            .IGNORED and i 0:iSize iSize.sgt if ..drop i 1:iSize + continue end
            ..drop.2
            0 0 i128 new ParserError .INVALID_CHAR return
          else ..drop end
        i64 cast.u i128.fromU64 =:: delta
        res maxSafeUnsigned u> if
          true overflow=
        else res maxSafe u> _if
          true signedOverflow=
        end
        res
          baseI128 * ## XXX mul i128 by i64  ## XXX add/sub i128 to/from i64
          res maxSafeUnsigned i128.eq and $ maxUnsigned delta - u> if
            true overflow=
          else res maxSafe i128.eq and $ maxVal delta - u> _if
            true signedOverflow=
          end
          delta +
        res=
        i 1:iSize +
      end ..drop
    ..drop
    res
      sign and -_ unsigned if ParserError .SIGN return end
      overflow if ParserError .OVERFLOW return end
      signedOverflow if ParserError .UNSIGNED return end
    ParserError .NONE return
  end
end
## TODO appendI128?? ## base, signed
namespace: std.literals
  proc( char8 ptr.raw : chars iSize : k -> i128 ) =>: static: export: :i128
    char8 128 array : mut: errMessageBuffer
    chars k string.create =:: str
    str 0 false i128.parse =:: err
    err .NONE or err .UNSIGNED if
      return
    else err .OVERFLOW _if
      errMessageBuffer@ sb.wrapBuffer
        "integer literal overflows size for type i128: `" sb.appendS
        str sb.appendStr
        '`' sb.appendC
      sb.asStr ..compiler.warning
      return
    end
    errMessageBuffer@ sb.wrapBuffer
      "invalid integer constant: `" sb.appendS
      str sb.appendStr
      '`' sb.appendC
    sb.asStr ..compiler.error
  end
end
namespace: i64
  proc( i64 : a i64 : b -> i128 ) =>: export: pmul
    a i32 cast.u b i32 cast.u i32.pmul =:: abLow
    a 32 >>> i32 cast.u b 32 >>> i32 cast.u i32.pmul =:: abHi
    a i32 cast.u a 32 >>> i32 cast.u ^
      b i32 cast.u b 32 >>> i32 cast.u ^
    i32.pmul abLow ^ abHi ^ =:: abMid ## (a0^a1)*(b0^b1) = a0b0^a1b0^a0b1^a1b1
    abHi abMid 32 >>> ^ abLow abMid 32 << ^ i128.create
  end
end

## define operator overloads
overload: -_ i128.neg end
overload: + i128.add end
overload: - i128.sub end
overload: * i128.mul end
overload: / i128.div end
overload: % i128.rem end
## overload: // i128.floorDiv end
## overload: %% i128.mod end
overload: u/ i128.udiv end
overload: u% i128.umod end
overload: ~ i128.flip end
overload: & i128.and end
overload: | i128.or end
overload: ^ i128.xor end
overload: << i128.shl i128.shl_i64 i128.shl_i32 end
overload: >>> i128.lshr i128.lshr_i64 i128.lshr_i32 end
overload: >> i128.ashr i128.ashr_i64 i128.ashr_i32 end
overload: == i128.eq end
overload: != i128.ne end
overload: <=> i128.cmp end
overload: u< i128.ult end
overload: u<= i128.ule end
overload: u>= i128.uge end
overload: u> i128.ugt end
overload: < i128.lt end
overload: <= i128.le end
overload: >= i128.ge end
overload: > i128.gt end
overload: ? i128.toBool end

