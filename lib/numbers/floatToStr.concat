namespace: number
  { 0 0 1.0 0.6309297535714575 0.5 0.43067655807339306 0.38685280723454163 0.3562071871080222 0.3333333333333333
    0.31546487678572877 0.3010299956639812 0.2890648263178879 0.27894294565112987 0.27023815442731974
    0.26264953503719357 0.2559580248098155 0.25 0.24465054211822604 0.23981246656813146 0.23540891336663824
    0.23137821315975915 0.227670248696953 0.22424382421757544 0.22106472945750374 0.21810429198553155
    0.21533827903669653 0.21274605355336318 0.2103099178571525 0.20801459767650948 0.20584683246043448
    0.2037950470905062 0.20184908658209985 0.2 0.19823986317056053 0.1965616322328226 0.1949590218937863
    0.19342640361727081 0.19195872000656014 0.1905514124267734 0.18920035951687003 0.18790182470910757
    0.18665241123894338 0.1854490234153689 0.18428883314870617 0.18316925091363362 0.18208790046993825
    0.1810425967800402 0.18003132665669264 0.17905223175104137 0.1781035935540111 0.17718382013555792
    0.17629143438888212 0.17542506358195453 0.17458343004804494 0.17376534287144002 0.1729696904450771
    0.17219543379409813 0.17144160057391347 0.17070727966372012 0.16999161628691403 0.16929380759878143
    0.1686130986895011 0.16794877895704194
  } =:: INV_BASE_LOGS
  ## get digits of positie finite float
  proc( type.float : auto: F
    char8 slice.mut
    F ## val
    i32 : base ## base
  -> string i32 ) =>: export: floatDigits ## temporarely marked as exported
    base 2 < or base 62 > if
      ..drop.2 string.empty 0 return
    end
    ## buf val
    $ 0 == if ..drop
      '0' $1 slice.fill
      slice.freeze string.fromChars 0 return
    end
    $ number.exponent f64 cast INV_BASE_LOGS@ base [] * i32 cast.s =:: mut: exp ## estimate for log_base(val)
    base F f128 == if f128.fromI32 else F cast end
      $ =:: shadow: base
    exp -_ number.powI * ## TODO: handle over/underflow
    ## estimate was off by 1
    $ F f128 == if f128.ONE else 1 F cast end < if
      exp 1 - exp=
      base *
    else $ base > _if
      exp 1 + exp=
      base /
    end
    ## TODO: the later digits are a bit off, is there a way to improve this without needing arbitary precission arithmetic
    ## buf val index
    0:iSize while $ $3 .length u< do
      >$  ## buf index val
        $ number.floor ## buf index val digit
          $ F f128 == if f128.toI32 else i32 cast end <<$
        - base * >$ digitChars >$ [] $3 $3 =[]
      <$
    finally 1 + end ..drop.2
    slice.freeze string.fromChars exp return
  end
  ## TODO: float-to-string conversion
end

proc( i32 -> char8 ) =>: getDigit
  "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz" ..swap []
end

namespace: f64
  0x0.0000000000001P-1022 =:: MIN_POSITIVE
end

namespace: sb
  ## appends the C-style hexadecimal representation of an IEEE double to a stringBuilder
  proc( stringBuilder : sb f64 : f -> stringBuilder ) =>: export: appendIeeeDouble
    f =:: mut: value
    -1022:i64 =:: MIN_POW
    1023:i64 =:: MAX_POW
    13 =:: DIGIT_COUNT
    sb
      value f64.isFinite ! if
        value f64.isNaN if
          "NAN" sb.appendS return
        else value 0 > _if
          "INFINITY" sb.appendS return
        else
          "-INFINITY" sb.appendS return
        end
      else value 0.0 == _if
        1 value / 0 < if ## distinguish positive and negative zero
          "-0.0" sb.appendS return
        else
          "0.0" sb.appendS return
        end
      end
      value 0 < if
        '-' sb.appendC
        value -_ value=
      end
      "0x" sb.appendS
      value math.log2 math.floor i64 cast =:: mut: e
      e MIN_POW < if
        MIN_POW e=
      else e MAX_POW > _if
        MAX_POW e=
      end
      2 e f64 cast math.pow =:: mut: p
      value p / value=
      value math.floor =:: mut: d
      d i32 cast getDigit sb.appendC
      '.' sb.appendC
      0 while ..dup DIGIT_COUNT < do
        ..swap
          value d - 16 * value=
          value math.floor d=
          d i32 cast getDigit sb.appendC
        ..swap 1 +
      end ..drop
      'P' sb.appendC
      e sb.appendI
    return
  end
  proc( stringBuilder : sb f64 : f i32 : precision i32 : base bool : sci -> stringBuilder ) =>: export: appendFloat???
    f =:: mut: value
    base 2 < base 62 > | if
      ## TODO error handling
      sb return
    end
    sb
      value f64.isFinite ! if
        value f64.isNaN if
          "[NaN]" sb.appendS return
        else value 0 > _if
          "[Infinity]" sb.appendS return
        else
          "-[Infinity]" sb.appendS return
        end
      else value 0.0 == value -0.0 == | _if
        "0" sb.appendS return
      end
      value 0 < if
        '-' sb.appendC
        value -_ value=
      end
      base f64 cast =:: baseF
      value math.log baseF math.log / math.floor i32 cast =:: mut: e
      e =:: mut: e_max
      baseF e f64 cast math.pow =:: mut: p
      i32 64 array new =:: mut: buff
      0 =:: mut: n
      0b1e-110100 #+2^-52+# value * =:: mut: eps ##XXX? better implementation of eps
      eps 0 == if ## adjust size of small numbers
        baseF e 1 + f64 cast math.pow p=
        value p / baseF * value=
        f64.MIN_POSITIVE p / eps=
        1 p=
      end
      p f64.isInfinite if ## adjust size for big numbers
        baseF e 1 - f64 cast math.pow p=
        value baseF / value=
        eps baseF / eps=
      end
      while p eps > do
        value p / math.floor =:: d
        d i32 cast buff@ n =[]
        n 1 + n=
        ## XXX break loop if n large enough
        value d p * - value=
        p baseF / p=
        e 1 + e=
      end
      precision 0 <= precision n >= | if
        n 1 -
      else
        precision
      end n=
      n 0 == if 1 n= end
      buff@ n [] base 2 / >= if
        buff@ n 1 - []
          1 +
        buff@ n 1 - =[]
      end
      false =:: mut: inc
      n 1 - =:: mut: j
      while j 0 >= do
        inc if
          buff@ j []
            1 +
            $ base < if
              false inc=
            end
          buff@ j =[]
        end
        buff@ j [] base >= if
          true inc=
          buff@ j [] base - buff@ j =[]
        end
        j 1 - j=
      end
      inc if
        buff@ 1 @[] buff@ n iSize cast.u mem.move ..drop
        1 buff@ 0 =[]
        n 1 + n=
        e_max 1 + e_max=
      end
      while n 1 - e_max > and buff@ n 1 - [] 0 == do
        n 1 - n=
      end
      sci or e_max n >= or e_max -5 < if
        while n 1 - 0 > and buff@ n 1 - [] 0 == do
          n 1 - n=
        end
        buff@ 0 [] getDigit sb.appendC
        n 1 > if
          '.' sb.appendC
          1 while ..dup n < do
             ..swap
               buff@ ..over.2 [] getDigit sb.appendC
             ..swap 1 +
          end ..drop
        end
        base 10 <= if 'E' else base 30 <= _if 'X' else '#' end sb.appendC
        e_max 0 >= if '+' sb.appendC end
        e_max base i32.sbAppend?
      else e_max 0 >= _if
        0 while ..dup n < do =:: i
          buff@ i [] getDigit sb.appendC
          i e_max == and i n 1 - < if
            '.' sb.appendC
          end
          i 1 +
        end ..drop
      else
        "0." sb.appendS
        -1 e_max - while ..dup 0 > do
          ..swap
            '0' sb.appendC
          ..swap 1 -
        end ..drop
        0 while ..dup n < do
          ..swap
            buff@ ..over.2 [] getDigit sb.appendC
          ..swap 1 +
        end ..drop
      end
    return
  end
  proc( stringBuilder f64 #+value+# -> stringBuilder ) =>: export: appendF
    0 10 false appendFloat???
  end
  proc( stringBuilder f16 #+value+# -> stringBuilder ) =>: export: appendF16
    f16.asF64 3 10 false appendFloat???
  end
  proc( stringBuilder f32 #+value+# -> stringBuilder ) =>: export: appendF32
    f64 cast 7 10 false appendFloat???
  end
  proc( stringBuilder f64 #+value+# i32 #+precision+# -> stringBuilder ) =>: export: appendF?
    10 false appendFloat???
  end
  proc( stringBuilder f64 #+value+# -> stringBuilder ) =>: export: appendE
    0 10 true appendFloat???
  end
  proc( stringBuilder f64 #+value+# i32 #+precision+# -> stringBuilder ) =>: export: appendE?
    10 true appendFloat???
  end
