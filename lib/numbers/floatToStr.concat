  end
  proc( stringBuilder f64 #+value+# i32 #+precision+# -> stringBuilder ) =>: export: appendXF?
    16 false appendFloat???
  end
  proc( stringBuilder f64 #+value+# -> stringBuilder ) =>: export: appendXE
    0 16 true appendFloat???
  end
  proc( stringBuilder f64 #+value+# i32 #+precision+# -> stringBuilder ) =>: export: appendXE?
    16 true appendFloat???
  end
  proc( stringBuilder f64 #+value+# -> stringBuilder ) =>: export: appendBF
    0 2 false appendFloat???
  end
  proc( stringBuilder f64 #+value+# i32 #+precision+# -> stringBuilder ) =>: export: appendBF?
    2 false appendFloat???
  end
  proc( stringBuilder f64 #+value+# -> stringBuilder ) =>: export: appendBE
    0 2 true appendFloat???
  end
  proc( stringBuilder f64 #+value+# i32 #+precision+# -> stringBuilder ) =>: export: appendBE?
    2 true appendFloat???
  end
