import numbers/printInt ## TODO better name (printInt does not contain print procs for ints)
import numbers/printFloat
import stringIO

namespace: io
  proc( i32 : i -> ) =>: export: printX32
    char8 12 array : buffer ## -80000000
    buffer@ sb.wrapBuffer
      i sb.appendX
    io.stdOut >$ sb.asStr io.fputStr ..drop
  end
  proc( i32 : i -> ) =>: export: printI32
    char8 12 array : buffer ## -4294967296\n
    buffer@ sb.wrapBuffer
      i sb.appendI
    io.stdOut >$ sb.asStr io.fputStr ..drop
  end
  proc( i32 : i -> ) =>: export: printlnI32
    char8 12 array : buffer
    buffer@ sb.wrapBuffer
      i sb.appendI
      '\n' sb.appendC
    io.stdOut >$ sb.asStr io.fputStr ..drop
  end
  proc( i64 : i -> ) =>: export: printX64
    char8 24 array : buffer ## -8000000000000000
    buffer@ sb.wrapBuffer
      i sb.appendX
    io.stdOut >$ sb.asStr io.fputStr ..drop
  end
  proc( i64 : i -> ) =>: export: printI64
    char8 24 array : buffer ## -9223372036854775808\n
    buffer@ sb.wrapBuffer
      i sb.appendI
    io.stdOut >$ sb.asStr io.fputStr ..drop
  end
  proc( i64 : i -> ) =>: export: printlnI64
    char8 24 array : buffer
    buffer@ sb.wrapBuffer
      i sb.appendI
      '\n' sb.appendC
    io.stdOut >$ sb.asStr io.fputStr ..drop
  end
  proc( i8 : i -> ) =>: export: printI8   i i32 cast printI32 end
  proc( i8 : i -> ) =>: export: printlnI8 i i32 cast printlnI32 end
  proc( i16 : i -> ) =>: export: printI16   i i32 cast printI32 end
  proc( i16 : i -> ) =>: export: printlnI16 i i32 cast printlnI32 end
  proc( f64 : f -> ) =>: export: printF64
    char8 24 array : buffer
    buffer@ sb.wrapBuffer
      f sb.appendF
    io.stdOut >$ sb.asStr io.fputStr ..drop
  end
  proc( f64 : f -> ) =>: export: printlnF64
    char8 24 array : buffer ## TODO? is 24 chars be enough
    buffer@ sb.wrapBuffer
      f sb.appendF
      '\n' sb.appendC
    io.stdOut >$ sb.asStr io.fputStr ..drop
  end
  proc( f32 : f -> ) =>: export: printF32
    char8 16 array : buffer
    buffer@ sb.wrapBuffer
      f f64 cast 7 sb.appendF?
    io.stdOut >$ sb.asStr io.fputStr ..drop
  end
  proc( f32 : f -> ) =>: export: printlnF32
    char8 16 array : buffer ## TODO? is 16 chars be enough
    buffer@ sb.wrapBuffer
      f f64 cast 7 sb.appendF?
      '\n' sb.appendC
    io.stdOut >$ sb.asStr io.fputStr ..drop
  end
  overload: export: print printI8 printI16 printI32 printI64 printF32 printF64 end
  overload: export: printX printX32 printX64 end ## TODO? support printX for other types
  overload: export: println printlnI8 printlnI16 printlnI32 printlnI64 printlnF32 printlnF64 end
end
