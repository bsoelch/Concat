import core/integers
import core/floats

import stringBuilder
import numbers/printInt
import math

proc( i32 -> char8 ) =>: getDigit
  "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz" ..swap []
end

namespace: f64
  0x0.0000000000001P-1022 =:: MIN_POSITIVE
end

namespace: sb
  ## appends the C-style hexadecimal representation of an IEEE double to a stringBuilder
  proc( stringBuilder : sb f64 : f -> stringBuilder ) =>: export: appendIeeeDouble
    f =:: mut: value
    -1022:i64 =:: MIN_POW
    1023:i64 =:: MAX_POW
    13 =:: DIGIT_COUNT
    sb
      value f64.isFinite ! if
        value f64.isNaN if
          "NAN" sb.appendS return
        else value 0 > _if
          "INFINITY" sb.appendS return
        else
          "-INFINITY" sb.appendS return
        end
      else value 0.0 == _if
        1 value / 0 < if ## distinguish positive and negative zero
          "-0.0" sb.appendS return
        else
          "0.0" sb.appendS return
        end
      end
      value 0 < if
        '-' sb.appendC
        value -_ value=
      end
      "0x" sb.appendS
      value math.log2 math.floor i64 cast =:: mut: e
      e MIN_POW < if
        MIN_POW e=
      else e MAX_POW > _if
        MAX_POW e=
      end
      2 e f64 cast math.pow =:: mut: p
      value p / value=
      value math.floor =:: mut: d
      d i32 cast getDigit sb.appendC
      '.' sb.appendC
      0 while ..dup DIGIT_COUNT < do
        ..swap
          value d - 16 * value=
          value math.floor d=
          d i32 cast getDigit sb.appendC
        ..swap 1 +
      end ..drop
      'P' sb.appendC
      e sb.appendI
    return
  end
  proc( stringBuilder : sb f64 : f i32 : precision i32 : base bool : sci -> stringBuilder ) =>: export: appendFloat???
    f =:: mut: value
    base 2 < base 62 > | if
      ## TODO error handling
      sb return
    end
    sb
      value f64.isFinite ! if
        value f64.isNaN if
          "[NaN]" sb.appendS return
        else value 0 > _if
          "[Infinity]" sb.appendS return
        else
          "-[Infinity]" sb.appendS return
        end
      else value 0.0 == value -0.0 == | _if
        "0" sb.appendS return
      end
      value 0 < if
        '-' sb.appendC
        value -_ value=
      end
      base f64 cast =:: baseF
      value math.log baseF math.log / math.floor i32 cast =:: mut: e
      e =:: mut: e_max
      baseF e f64 cast math.pow =:: mut: p
      i32 64 array new =:: mut: buff
      0 =:: mut: n
      0b1e-110100 #+2^-52+# value * =:: mut: eps ##XXX? better implementation of eps
      eps 0 == if ## adjust size of small numbers
        baseF e 1 + f64 cast math.pow p=
        value p / baseF * value=
        f64.MIN_POSITIVE p / eps=
        1 p=
      end
      p f64.isInfinite if ## adjust size for big numbers
        baseF e 1 - f64 cast math.pow p=
        value baseF / value=
        eps baseF / eps=
      end
      while p eps > do
        value p / math.floor =:: d
        d i32 cast buff@ n =[]
        n 1 + n=
        ## XXX break loop if n large enough
        value d p * - value=
        p baseF / p=
        e 1 + e=
      end
      precision 0 <= precision n >= | if
        n 1 -
      else
        precision
      end n=
      n 0 == if 1 n= end
      buff@ n [] base 2 / >= if
        buff@ n 1 - []
          1 +
        buff@ n 1 - =[]
      end
      false =:: mut: inc
      n 1 - =:: mut: j
      while j 0 >= do
        inc if
          buff@ j []
            1 +
            $ base < if
              false inc=
            end
          buff@ j =[]
        end
        buff@ j [] base >= if
          true inc=
          buff@ j [] base - buff@ j =[]
        end
        j 1 - j=
      end
      inc if
        buff@ i32 _ ptr.mut cast 1 + buff@ n i64 cast.u mem.move ..drop
        1 buff@ 0 =[]
        n 1 + n=
        e_max 1 + e_max=
      end
      while n 1 - e_max > and buff@ n 1 - [] 0 == do
        n 1 - n=
      end
      sci or e_max n >= or e_max -5 < if
        while n 1 - 0 > and buff@ n 1 - [] 0 == do
          n 1 - n=
        end
        buff@ 0 [] getDigit sb.appendC
        n 1 > if
          '.' sb.appendC
          1 while ..dup n < do
             ..swap
               buff@ ..over.2 [] getDigit sb.appendC
             ..swap 1 +
          end ..drop
        end
        base 10 <= if 'E' else base 30 <= _if 'X' else '#' end sb.appendC
        e_max 0 >= if '+' sb.appendC end
        e_max i64 cast.s base appendI?
      else e_max 0 >= _if
        0 while ..dup n < do =:: i
          buff@ i [] getDigit sb.appendC
          i e_max == and i n 1 - < if
            '.' sb.appendC
          end
          i 1 +
        end ..drop
      else
        "0." sb.appendS
        -1 e_max - while ..dup 0 > do
          ..swap
            '0' sb.appendC
          ..swap 1 -
        end ..drop
        0 while ..dup n < do
          ..swap
            buff @ ..over.2 [] getDigit sb.appendC
          ..swap 1 +
        end ..drop
      end
    return
  end
  proc( stringBuilder f64 #+value+# -> stringBuilder ) =>: export: appendF
    0 10 false appendFloat???
  end
  proc( stringBuilder f64 #+value+# i32 #+precision+# -> stringBuilder ) =>: export: appendF?
    10 false appendFloat???
  end
  proc( stringBuilder f64 #+value+# -> stringBuilder ) =>: export: appendE
    0 10 true appendFloat???
  end
  proc( stringBuilder f64 #+value+# i32 #+precision+# -> stringBuilder ) =>: export: appendE?
    10 true appendFloat???
  end
  proc( stringBuilder f64 #+value+# -> stringBuilder ) =>: export: appendXF
    0 16 false appendFloat???
  end
  proc( stringBuilder f64 #+value+# i32 #+precision+# -> stringBuilder ) =>: export: appendXF?
    16 false appendFloat???
  end
  proc( stringBuilder f64 #+value+# -> stringBuilder ) =>: export: appendXE
    0 16 true appendFloat???
  end
  proc( stringBuilder f64 #+value+# i32 #+precision+# -> stringBuilder ) =>: export: appendXE?
    16 true appendFloat???
  end
  proc( stringBuilder f64 #+value+# -> stringBuilder ) =>: export: appendBF
    0 2 false appendFloat???
  end
  proc( stringBuilder f64 #+value+# i32 #+precision+# -> stringBuilder ) =>: export: appendBF?
    2 false appendFloat???
  end
  proc( stringBuilder f64 #+value+# -> stringBuilder ) =>: export: appendBE
    0 2 true appendFloat???
  end
  proc( stringBuilder f64 #+value+# i32 #+precision+# -> stringBuilder ) =>: export: appendBE?
    2 true appendFloat???
  end
end
