proc( i32 => i8 ) =: getDigit
  "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz" #swap []
end

#namespace double
  0x0.0000000000001P-1022 =:: MIN_POSITIVE
#end

#namespace sb
## appends the C-style hexadecimal representation of an IEEE double to a stringBuilder
proc( stringBuilder : sb double : f => stringBuilder ) =: public appendIeeeDouble
  f =:: mut value
  -1022 =:: MIN_POW
  1023 =:: MAX_POW
  13 =:: DIGIT_COUNT
  sb
    value double.isFinite ! if
      value double.isNaN if
        "NAN" sb.appendS return
      else value 0 > _if
        "INFINITY" sb.appendS return
      else
        "-INFINITY" sb.appendS return
      end
    else value 0.0 == value -0.0 == | _if
      "0" sb.appendS return
    end
    value 0 < if
      '-' sb.appendC
      value neg value =
    end
    "0x" sb.appendS
    value math.log2 math.floor i64 cast =:: mut e
    e MIN_POW < if
      MIN_POW e =
    else e MAX_POW > _if
      MAX_POW e =
    end
    2 e double cast math.pow =:: mut p
    value p / value =
    value math.floor =:: mut d
    d i32 cast getDigit sb.appendC
    '.' sb.appendC
    0 while #dup DIGIT_COUNT < do
      #swap
        value d - 16 * value =
        value math.floor d = 
        d i32 cast getDigit sb.appendC
      #swap 1 +
    end #drop
    'P' sb.appendC
    e sb.appendI
  return
end
