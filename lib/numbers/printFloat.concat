    else
      precision
    end n =
    n 0 == if 1 n = end
    buff @ n [] base 2 / >= if
      n 1 - =:: mut j
      true =:: mut inc
      while inc j 0 >= & do
        buff @ j [] 1 +  buff @ j [] =
        buff @ j [] base >= if
          buff @ j [] base -  buff @ j [] =
        else
          false inc =
        end
        j 1 - j =
      end
      inc if
        buff @ i32 _ ptr mut cast 1 + buff @ n mem.move #drop
        1 buff @ 0 [] =
        n 1 + n =
        e_max 1 + e_max =
      end
    end
    while n 1 - e_max > buff @ n 1 - [] 0 == & do
      n 1 - n =
    end
    sci e_max n >= | e_max -5 < | if
      while n 1 - 0 > buff @ n 1 - [] 0 == & do
        n 1 - n =
      end
      buff @ 0 [] getDigit sb.appendC
      n 1 > if
        '.' sb.appendC
        1 while #dup n < do
           #swap
             buff @ #over:2 [] getDigit sb.appendC
           #swap 1 +
        end #drop
      end
      base 10 <= if 'E' else base 30 <= _if 'X' else '#' end sb.appendC
      e_max 0 >= if '+' sb.appendC end
      e_max  base appendInt?
    else e_max 0 >= _if
