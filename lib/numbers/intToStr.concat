namespace: i128
  proc( stringBuilder i128 i32 : base bool #+signed+# -> stringBuilder ) =>: export: sbAppend??
    char8 128 array : mut: buffer
    #+signed+# and $ i128.ZERO < if
      >$ '-' sb.appendC <$ i128.neg
    end
      buffer@ slice.wrapMutable >$ base number.uintToStr
    sb.appendStr
  end
  proc( stringBuilder i128 i32 #+base+# -> stringBuilder ) =>: export: sbAppend?
    true sbAppend??
  end
