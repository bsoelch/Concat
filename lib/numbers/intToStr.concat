namespace: iSize
  iSize ..types.size i64 ..types.size == if
    proc( stringBuilder iSize i32 : base bool #+signed+# -> stringBuilder ) : alias: export: sbAppend?? i64.sbAppend??
    proc( stringBuilder iSize i32 : base -> stringBuilder ) : alias: export: sbAppend? i64.sbAppend?
    proc( stringBuilder iSize i32 : base -> stringBuilder ) : alias: export: sbAppendU? i64.sbAppendU?
    proc( stringBuilder iSize -> stringBuilder ) : alias: export: sbAppend i64.sbAppend
    proc( stringBuilder iSize -> stringBuilder ) : alias: export: sbAppendU i64.sbAppendU
    proc( stringBuilder iSize -> stringBuilder ) : alias: export: sbAppendX i64.sbAppendX
    proc( stringBuilder iSize -> stringBuilder ) : alias: export: sbAppendUX i64.sbAppendUX
  else iSize ..types.size i32 ..types.size == _if
    proc( stringBuilder iSize i32 : base bool #+signed+# -> stringBuilder ) : alias: export: sbAppend?? i32.sbAppend??
    proc( stringBuilder iSize i32 : base -> stringBuilder ) : alias: export: sbAppend? i32.sbAppend?
    proc( stringBuilder iSize i32 : base -> stringBuilder ) : alias: export: sbAppendU? i32.sbAppendU?
    proc( stringBuilder iSize -> stringBuilder ) : alias: export: sbAppend i32.sbAppend
    proc( stringBuilder iSize -> stringBuilder ) : alias: export: sbAppendU i32.sbAppendU
    proc( stringBuilder iSize -> stringBuilder ) : alias: export: sbAppendX i32.sbAppendX
    proc( stringBuilder iSize -> stringBuilder ) : alias: export: sbAppendUX i32.sbAppendUX
  else
    "iSize should have 32 or 64 bits" ..compiler.error
  end
end
## TODO: remove old versions
namespace: sb
  proc( stringBuilder : buffer i64 : i i32 : base bool : signed -> stringBuilder ) =>: export: appendI??
    base 2 < base 62 > | if
      ## TODO error handling
      buffer return
    end
    char8 64 array new =:: mut: chrBuff
    buffer
      i
      ..dup 0 < signed & if
        ..swap '-' appendC ..swap
        -_
      else ..dup 0 == _if
        ..drop '0' appendC return
      end
      63 ..swap ## index in chrBuff
        while ..dup 0 != do
          ..swap ## <buffer> <i> <chrIndex>
            ..over base u% number.digitChars ..swap []
            ..over chrBuff@ ..swap =[]
            1 -
          ..swap
          base u/
        end ..drop
        while 1 + ..dup 64 < do
          ..swap ## <chrIndex> <buffer>
            ..over chrBuff@ ..swap [] appendC
          ..swap
        end
      ..drop
    return
  end
  proc( stringBuilder i64 #+value+# i32 #+base+# -> stringBuilder ) =>: export: appendI?
    true appendI??
  end
  proc( stringBuilder i64 #+value+# i32 #+base+# -> stringBuilder ) =>: export: appendU?
    false appendI??
  end
  proc( stringBuilder i64 #+value+# -> stringBuilder ) =>: export: appendBin
    2  appendI?
  end
  proc( stringBuilder i64 #+value+# -> stringBuilder ) =>: export: appendI64
    10 appendI?
  end
  proc( stringBuilder i32 #+value+# -> stringBuilder ) =>: export: appendI32
    i64 cast.s 10 appendI?
  end
  proc( stringBuilder iSize #+value+# -> stringBuilder ) =>: export: appendZ
    i64 cast.u 10 appendI?
  end
  proc( stringBuilder i32 #+value+# -> stringBuilder ) =>: export: appendX32
    i64 cast.s 16 appendI?
  end
  proc( stringBuilder i64 #+value+# -> stringBuilder ) =>: export: appendX64
    i64 cast.s 16 appendI?
  end
  proc( stringBuilder i64 #+value+# -> stringBuilder ) =>: export: appendUBin
    2 false appendI??
  end
  proc( stringBuilder i32 #+value+# -> stringBuilder ) =>: export: appendU32
    i64 cast.u 10 false appendI??
  end
  proc( stringBuilder i64 #+value+# -> stringBuilder ) =>: export: appendU64
    10 false appendI??
  end
  proc( stringBuilder i32 #+value+# -> stringBuilder ) =>: export: appendUX32
    i64 cast.u 16 false appendI??
  end
  proc( stringBuilder i64 #+value+# -> stringBuilder ) =>: export: appendUX64
    16 false appendI??
  end
  overload: export: appendI
    appendI32
    appendI64
    appendZ
  end
  overload: export: appendU
    appendU32
    appendU64
  end
  overload: export: appendX
    appendX32
    appendX64
  end
  overload: export: appendUX
    appendUX32
    appendUX64
  end
  overload: export: appendUHex
    appendUX32
    appendUX64
  end
## append with padding: TODO? add padding support to main int-to-string procedure
  proc( stringBuilder i32 : val i32 : base char8 : padChar iSize : minDigits -> stringBuilder ) =>: export: appendPaddedU32
    val i64 cast.u base padChar minDigits appendPaddedU64
  end
  proc( stringBuilder i64 : val i32 : base char8 : padChar iSize : minDigits -> stringBuilder ) =>: export: appendPaddedU64
    char8 64 array : mut: buffer
    minDigits 0 == if
      val base sb.appendU? return
    end
    buffer@ sb.wrapBuffer
      val base sb.appendU?
    sb.asStr =:: strVal
    minDigits sb.ensureCap
    strVal .length minDigits u< if
      minDigits strVal .length - for ..drop padChar sb.appendC end
    end
    strVal sb.appendStr
  end
  overload: export: appendPaddedU
    appendPaddedU32
    appendPaddedU64
  end
end
