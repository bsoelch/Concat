import numbers/i128
namespace: i128.static
  proc( char8 _ ptr : chars i64 : k -> i128 ) =>: static: export: shaddow: parse
    char8 128 array : errMessageBuffer
    chars k string.create =:: str
    str 0 false i128.parse =:: err
    err .NONE ?? or err .UNSIGNED ?? if
      return
    else err .OVERFLOW ?? _if
      errMessageBuffer@ $ ..length i32 cast sb.fromBuffer
        "integer literal overflows size for type i128: `" sb.appendS
        str sb.appendStr
        '`' sb.appendC
      sb.asStr ..compiler.warning
      return
    end
    errMessageBuffer@ $ ..length i32 cast sb.fromBuffer
      "invalid integer constant: `" sb.appendS
      str sb.appendStr
      '`' sb.appendC
    sb.asStr ..compiler.error
  end
end
