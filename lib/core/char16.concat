"bool" *import
"i16" *import
i16 =:: export: char16
namespace: char16
  proc( char16 char16 -> i16 ) : export: alias: diff i16.sub
  proc( char16 char16 -> bool ) : export: alias: eq i16.eq
  proc( char16 char16 -> bool ) : export: alias: ne i16.ne
  proc( char16 char16 -> bool ) : export: alias: lt i16.lt
  proc( char16 char16 -> bool ) : export: alias: le i16.le
  proc( char16 char16 -> bool ) : export: alias: ge i16.ge
  proc( char16 char16 -> bool ) : export: alias: gt i16.gt

  proc( char16 char16 -> i32 ) : export: alias: cmp i16.cmp
end

overload: export: -     char16.diff end
overload: export: ==    char16.eq   end
overload: export: !=    char16.ne   end
overload: export: <     char16.lt   end
overload: export: <=    char16.le   end
overload: export: >=    char16.ge   end
overload: export: >     char16.gt   end
overload: export: <=>   char16.cmp  end
