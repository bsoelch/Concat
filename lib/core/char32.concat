import core/bool
import core/i32
i32 =:: export: char32
namespace: char32
  proc( char32 char32 -> i32 ) : export: alias: diff i32.sub
  proc( char32 char32 -> bool ) : export: alias: eq i32.eq
  proc( char32 char32 -> bool ) : export: alias: ne i32.ne
  proc( char32 char32 -> bool ) : export: alias: lt i32.lt
  proc( char32 char32 -> bool ) : export: alias: le i32.le
  proc( char32 char32 -> bool ) : export: alias: ge i32.ge
  proc( char32 char32 -> bool ) : export: alias: gt i32.gt

  proc( char32 char32 -> i32 ) : export: alias: cmp i32.cmp
end

overload: export: -     char32.diff end
overload: export: ==    char32.eq   end
overload: export: !=    char32.ne   end
overload: export: <     char32.lt   end
overload: export: <=    char32.le   end
overload: export: >=    char32.ge   end
overload: export: >     char32.gt   end
overload: export: <=>   char32.cmp  end
