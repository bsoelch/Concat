import core/i32
import core/i64
import core/ptr
import core/type

namespace: intItr
  ( type.integer : I -> type ) =>: export: rangeItr
    struct( I : i I : limit )
  end
  proc( type.integer : auto: I I : start I : limit -> I rangeItr ) =>: export: createRange
    start limit I rangeItr new
  end
  proc( type.integer : auto: I I rangeItr -> I rangeItr ) =>: export: prepareRange end
  proc( type.integer : auto: I I rangeItr : itr -> bool ) =>: export: checkRange
    itr .i itr .limit !=
  end
  proc( type.integer : auto: I I rangeItr : itr -> I ) =>: export: getRange
    itr .i
  end
  proc( type.integer : auto: I I rangeItr : itr -> I rangeItr ) =>: export: stepRange
    itr .i 1 + itr .limit I rangeItr new
  end
  proc( type.integer : auto: I I rangeItr : itr -> ) =>: export: endRange end

  ( type.integer : I -> type ) =>: export: revItr
    struct( I : i )
  end
  proc( type.integer : auto: I I : start -> I revItr ) =>: export: createRev
    start I revItr new
  end
  proc( type.integer : auto: I I revItr -> I revItr ) =>: export: prepareRev end
  proc( type.integer : auto: I I revItr : itr -> bool ) =>: export: checkRev
    itr .i 0 !=
  end
  proc( type.integer : auto: I I revItr : itr -> I ) =>: export: getRev
    itr .i 1 -
  end
  proc( type.integer : auto: I I revItr : itr -> I revItr ) =>: export: stepRev
    itr .i 1 - I revItr new
  end
  proc( type.integer : auto: I I revItr : itr -> ) =>: export: endRev end
end

namespace: i32
  namespace: itr
    proc( i32 : n -> i32 intItr.rangeItr ) =>: export: prepare
      0 n intItr.createRange
    end
  end
  proc( i32 -> i32 intItr.revItr ) =>: export: reversed
    intItr.createRev
  end
end
namespace: i64
  namespace: itr
    proc( i64 : n -> i64 intItr.rangeItr ) =>: export: prepare
      0 n intItr.createRange
    end
  end
  proc( i64 -> i64 intItr.revItr ) =>: export: reversed
    intItr.createRev
  end
end
namespace: iSize
  namespace: itr
    proc( iSize : n -> iSize intItr.rangeItr ) =>: export: prepare
      0 n intItr.createRange
    end
  end
  proc( iSize -> iSize intItr.revItr ) =>: export: reversed
    intItr.createRev
  end
end

namespace: ptr
  ( type : T -> type ) =>: export: Itr
    struct( T ptr.raw : head T ptr.raw : tail )
  end
  namespace: itr
    proc( type : auto: T T ptr : p -> T Itr ) =>: prepare0D
      "iteration over pointer to single value" ..compiler.warning
      ## Itr
        p
        p T ptr.raw cast 1 @[]
      T Itr new return
    end
    proc( type : auto: T i64 : auto: k  T k ptr : p -> T Itr ) =>: export: prepare
      ## Itr
        p
        p T ptr.raw cast k @[]
      T Itr new return
    end
    proc( type : auto: T  T Itr -> T Itr ) =>: export: prepareItr end
    proc( type : auto: T T Itr : itr -> bool ) =>: export: check
      itr .head itr .tail !=
    end
    proc( type : auto: T T Itr : itr -> T ) =>: export: shadow: get
      itr .head []
    end
    proc( type : auto: T T Itr : itr -> T Itr ) =>: export: step
      itr .head 1 @[] itr .tail T Itr new
    end
    proc( type : auto: T T Itr : itr -> ) =>: export: endItr end
  end
end
## collection of usefull iterators over continous memory section
namespace: array
  ( type : T -> type ) =>: export: ReverseItr
    T ptr.Itr
  end
  ( type : T -> type ) =>: export: PtrItr
    T ptr.Itr
  end
  ( type : T -> type ) =>: export: ReversePtrItr
    T ptr.Itr
  end
  ( type : T -> type ) =>: export: MutItr
    struct( T ptr.raw.mut : head T ptr.raw : tail )
  end
  ( type : T -> type ) =>: export: MutPtrItr
    T MutItr
  end
  ( type : T -> type ) =>: export: ReverseMutPtrItr
    T MutItr
  end
  ( type : T -> type ) =>: export: IndexItr32
    struct( T ptr.raw : base i32 : offset i32 : length )
  end
  ( type : T -> type ) =>: export: IndexItr32mut
    struct( T ptr.raw.mut : base i32 : offset i32 : length )
  end
  ( type : T -> type ) =>: export: IndexItr64
    struct( T ptr.raw : base i64 : offset i64 : length )
  end
  ( type : T -> type ) =>: export: IndexItr64mut
    struct( T ptr.raw.mut : base i64 : offset i64 : length )
  end
  ## TODO ReversedIndexItr
  ## TODO? MapItr, ReversedMapItr ( make list.mapItr / slice.mapItr wrappers )

  ## TODO implement IndexItr
  proc( type : auto: T type.index : auto: I
    T ptr.raw : p I : len
  -> T ptr.Itr ) =>: export: getItr
    p  p len @[] T ptr.Itr new
  end
  proc( type : auto: T type.index : auto: I
    T ptr.raw : p I : len
  -> T PtrItr ) =>: export: ptrItr
    p  p len @[] T PtrItr new
  end
  proc( type : auto: T type.index : auto: I
    T ptr.raw.mut : p I : len
  -> T MutPtrItr ) =>: export: mutPtrItr
    p  p len @[] T MutPtrItr new
  end
  overload: export: @itr ptrItr mutPtrItr end
  ## TODO? is there a save way to point head of reversed iter at element
  proc( type : auto: T type.index : auto: I
    T ptr.raw : p I : len
  -> T ReverseItr ) =>: export: reversed
    p len @[]  p T ReverseItr new
  end
  proc( type : auto: T type.index : auto: I
    T ptr.raw : p I : len
  -> T ReversePtrItr ) =>: export: reversedPtrItr
    p len @[]  p T ReversePtrItr new
  end
  proc( type : auto: T type.index : auto: I
    T ptr.raw.mut : p I : len
  -> T ReverseMutPtrItr ) =>: export: reversedMutPtrItr
    p len @[]  p T ReverseMutPtrItr new
  end
  overload: export: @reversed reversedPtrItr reversedMutPtrItr end

  namespace: itr
    ## TODO? is there a way to compress these functions
    proc( type : auto: T  T PtrItr -> T PtrItr ) =>: export: preparePtr end
    proc( type : auto: T  T MutPtrItr -> T MutPtrItr ) =>: export: prepareMutPtr end
    proc( type : auto: T  T ReverseItr -> T ReverseItr ) =>: export: prepareReverse end
    proc( type : auto: T  T ReversePtrItr -> T ReversePtrItr ) =>: export: prepareReversePtr end
    proc( type : auto: T
      T ReverseMutPtrItr
    -> T ReverseMutPtrItr ) =>: export: prepareReverseMutPtr end

    proc( type : auto: T  T PtrItr : i -> bool ) =>: export: checkPtr
      i .head i .tail < return
    end
    proc( type : auto: T  T MutPtrItr : i -> bool ) =>: export: checkMutPtr
      i .head i .tail < return
    end
    proc( type : auto: T  T ReverseItr : i -> bool ) =>: export: checkReverse
      i .head i .tail > return
    end
    proc( type : auto: T  T ReversePtrItr : i -> bool ) =>: export: checkReversePtr
      i .head i .tail > return
    end
    proc( type : auto: T  T ReverseMutPtrItr : i -> bool ) =>: export: checkReverseMutPtr
      i .head i .tail > return
    end

    proc( type : auto: T T PtrItr : itr -> T ptr ) =>: export: shadow: getPtr
      itr .head T ptr cast!
    end
    proc( type : auto: T T MutPtrItr : itr -> T ptr.mut ) =>: export: shadow: getMutPtr
      itr .head T ptr.mut cast!
    end
    proc( type : auto: T T ReverseItr : itr -> T ) =>: export: shadow: getReverse
      itr .head -1:iSize []
    end
    proc( type : auto: T T ReversePtrItr : itr -> T ptr ) =>: export: shadow: getReversePtr
      itr .head -1:iSize @[] T ptr cast!
    end
    proc( type : auto: T T ReverseMutPtrItr : itr -> T ptr.mut ) =>: export: shadow: getReverseMutPtr
      itr .head -1:iSize @[] T ptr.mut cast!
    end

    proc( type : auto: T T PtrItr : itr -> T PtrItr ) =>: export: stepPtr
      itr $ .head 1 @[] >$ .head=
    end
    proc( type : auto: T T MutPtrItr : itr -> T MutPtrItr ) =>: export: stepMutPtr
      itr $ .head 1 @[] >$ .head=
    end
    proc( type : auto: T T ReverseItr : itr -> T ReverseItr ) =>: export: stepReverse
      itr $ .head -1:iSize @[] >$ .head=
    end
    proc( type : auto: T T ReversePtrItr : itr -> T ReversePtrItr ) =>: export: stepReversePtr
      itr $ .head -1:iSize @[] >$ .head=
    end
    proc( type : auto: T
      T ReverseMutPtrItr : itr
    -> T ReverseMutPtrItr ) =>: export: stepReverseMutPtr
      itr $ .head -1:iSize @[] >$ .head=
    end

    proc( type : auto: T T PtrItr : itr -> ) =>: export: endPtr end
    proc( type : auto: T T MutPtrItr : itr -> ) =>: export: endMutPtr end
    proc( type : auto: T T ReverseItr : itr -> ) =>: export: endReverse end
    proc( type : auto: T T ReversePtrItr : itr -> ) =>: export: endReversePtr end
    proc( type : auto: T T ReverseMutPtrItr : itr -> ) =>: export: endReverseMutPtr end
  end
end

overload: export: ..itr.prepare
  intItr.prepareRev
  intItr.prepareRange
  i32.itr.prepare
  i64.itr.prepare
  iSize.itr.prepare
  ptr.itr.prepare0D
  ptr.itr.prepare
  ptr.itr.prepareItr
  array.itr.preparePtr
  array.itr.prepareMutPtr
  array.itr.prepareReverse
  array.itr.prepareReversePtr
  array.itr.prepareReverseMutPtr
end
overload: export: ..itr.check
  intItr.checkRev
  intItr.checkRange
  ptr.itr.check
  array.itr.checkPtr
  array.itr.checkMutPtr
  array.itr.checkReverse
  array.itr.checkReversePtr
  array.itr.checkReverseMutPtr
end
overload: export: ..itr.get
  intItr.getRev
  intItr.getRange
  ptr.itr.get
  array.itr.getPtr
  array.itr.getMutPtr
  array.itr.getReverse
  array.itr.getReversePtr
  array.itr.getReverseMutPtr
end
overload: export: ..itr.step
  intItr.stepRev
  intItr.stepRange
  ptr.itr.step
  array.itr.stepPtr
  array.itr.stepMutPtr
  array.itr.stepReverse
  array.itr.stepReversePtr
  array.itr.stepReverseMutPtr
end
overload: export: ..itr.end
  intItr.endRev
  intItr.endRange
  ptr.itr.endItr
  array.itr.endPtr
  array.itr.endMutPtr
  array.itr.endReverse
  array.itr.endReversePtr
  array.itr.endReverseMutPtr
end
