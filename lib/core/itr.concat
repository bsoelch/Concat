namespace: i32
  struct( i32 : i i32 : limit ) =:: i32Itr
  namespace: itr
    proc( i32 : n -> i32Itr ) =>: prepare
      0 n i32Itr new return
    end
    proc( i32Itr : itr -> bool ) =>: check
      itr .i itr .limit <
    end
    proc( i32Itr : itr -> i32 ) =>: get
      itr .i
    end
    proc( i32Itr : itr -> i32Itr ) =>: step
      itr .i 1 + itr .limit i32Itr new
    end
    proc( i32Itr : itr -> ) =>: endItr end
  end
end

namespace: i64
  struct( i64 : i i64 : limit ) =:: i64Itr
  namespace: itr
    proc( i64 : n -> i64Itr ) =>: prepare
      0 n i64Itr new return
    end
    proc( i64Itr : itr -> bool ) =>: check
      itr .i itr .limit <
    end
    proc( i64Itr : itr -> i64 ) =>: get
      itr .i
    end
    proc( i64Itr : itr -> i64Itr ) =>: step
      itr .i 1 + itr .limit i64Itr new
    end
    proc( i64Itr : itr -> ) =>: endItr end
  end
end

namespace: ptr
  ( type : T -> type ) =>: ptrItr
    struct( T _ ptr : current T _ ptr : tail )
  end
  namespace: itr
    proc( type : auto: T i64 : auto: k  T k ptr : p -> T ptrItr ) =>: prepare
      ## ptrItr
        p
        p T _ ptr cast k +
      T ptrItr new return
    end
    #+
    proc( type : auto: T i64 : auto: k  T k array : a -> T ptrItr ) =>: prepareArray
      ## ptrItr
        a@
        a@ T _ ptr cast k +
      T ptrItr new return
    end
    +#
    proc( type : auto: T T ptrItr : itr -> bool ) =>: check
      itr .current itr .tail <
    end
    proc( type : auto: T T ptrItr : itr -> T ) =>: get
      itr .current []
    end
    proc( type : auto: T T ptrItr : itr -> T ptrItr ) =>: step
      itr .current 1 + itr .tail T ptrItr new
    end
    proc( type : auto: T T ptrItr : itr -> ) =>: endItr end
  end
end
overload: ..itr.prepare
  i32.itr.prepare
  i64.itr.prepare
  ptr.itr.prepare
end
overload: ..itr.check
  i32.itr.check
  i64.itr.check
  ptr.itr.check
end
overload: ..itr.get
  i32.itr.get
  i64.itr.get
  ptr.itr.get
end
overload: ..itr.step
  i32.itr.step
  i64.itr.step
  ptr.itr.step
end
overload: ..itr.end
  i32.itr.endItr
  i64.itr.endItr
  ptr.itr.endItr
end
