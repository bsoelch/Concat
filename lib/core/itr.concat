import core/i32
import core/i64
import core/ptr
namespace: i32
  struct( i32 : i i32 : limit ) =:: export: i32Itr
  namespace: itr
    proc( i32 : n -> i32Itr ) =>: export: prepare
      0 n i32Itr new return
    end
    proc( i32Itr -> i32Itr ) =>: export: prepareItr end
    proc( i32Itr : itr -> bool ) =>: export: check
      itr .i itr .limit <
    end
    proc( i32Itr : itr -> i32 ) =>: export: get
      itr .i
    end
    proc( i32Itr : itr -> i32Itr ) =>: export: step
      itr .i 1 + itr .limit i32Itr new
    end
    proc( i32Itr : itr -> ) =>: export: endItr end
  end
end

namespace: i64
  struct( i64 : i i64 : limit ) =:: export: i64Itr
  namespace: itr
    proc( i64 : n -> i64Itr ) =>: export: prepare
      0 n i64Itr new return
    end
    proc( i64Itr -> i64Itr ) =>: export: prepareItr end
    proc( i64Itr : itr -> bool ) =>: export: check
      itr .i itr .limit <
    end
    proc( i64Itr : itr -> i64 ) =>: export: get
      itr .i
    end
    proc( i64Itr : itr -> i64Itr ) =>: export: step
      itr .i 1 + itr .limit i64Itr new
    end
    proc( i64Itr : itr -> ) =>: export: endItr end
  end
end
namespace: iSize
  struct( iSize : i iSize : limit ) =:: export: iSizeItr
  namespace: itr
    proc( iSize : n -> iSizeItr ) =>: export: prepare
      0:iSize n iSizeItr new return
    end
    proc( iSizeItr -> iSizeItr ) =>: export: prepareItr end
    proc( iSizeItr : itr -> bool ) =>: export: check
      itr .i itr .limit u<
    end
    proc( iSizeItr : itr -> iSize ) =>: export: get
      itr .i
    end
    proc( iSizeItr : itr -> iSizeItr ) =>: export: step
      itr .i 1:iSize + itr .limit iSizeItr new
    end
    proc( iSizeItr : itr -> ) =>: export: endItr end
  end
end

namespace: ptr
  ( type : T -> type ) =>: export: Itr
    struct( T ptr.raw : head T ptr.raw : tail )
  end
  namespace: itr
    proc( type : auto: T T ptr : p -> T Itr ) =>: prepare0D
      "iteration over pointer to single value" ..compiler.warning
      ## Itr
        p
        p T ptr.raw cast 1 @[]
      T Itr new return
    end
    proc( type : auto: T i64 : auto: k  T k ptr : p -> T Itr ) =>: export: prepare
      ## Itr
        p
        p T ptr.raw cast k @[]
      T Itr new return
    end
    proc( type : auto: T  T Itr -> T Itr ) =>: export: prepareItr end
    proc( type : auto: T T Itr : itr -> bool ) =>: export: check
      itr .head itr .tail !=
    end
    proc( type : auto: T T Itr : itr -> T ) =>: export: shadow: get
      itr .head []
    end
    proc( type : auto: T T Itr : itr -> T Itr ) =>: export: step
      itr .head 1 @[] itr .tail T Itr new
    end
    proc( type : auto: T T Itr : itr -> ) =>: export: endItr end
  end
end
overload: export: ..itr.prepare
  i32.itr.prepare
  i32.itr.prepareItr
  i64.itr.prepare
  i64.itr.prepareItr
  iSize.itr.prepare
  iSize.itr.prepareItr
  ptr.itr.prepare0D
  ptr.itr.prepare
  ptr.itr.prepareItr
end
overload: export: ..itr.check
  i32.itr.check
  i64.itr.check
  iSize.itr.check
  ptr.itr.check
end
overload: export: ..itr.get
  i32.itr.get
  i64.itr.get
  iSize.itr.get
  ptr.itr.get
end
overload: export: ..itr.step
  i32.itr.step
  i64.itr.step
  iSize.itr.step
  ptr.itr.step
end
overload: export: ..itr.end
  i32.itr.endItr
  i64.itr.endItr
  iSize.itr.endItr
  ptr.itr.endItr
end
