proc( char8 _ ptr iSize -> i8  ) : export: static: alias: :i8  ..builtIn.parse.i8
proc( char8 _ ptr iSize -> i16 ) : export: static: alias: :i16 ..builtIn.parse.i16
proc( char8 _ ptr iSize -> i32 ) : export: static: alias: :i32 ..builtIn.parse.i32
proc( char8 _ ptr iSize -> i64 ) : export: static: alias: :i64 ..builtIn.parse.i64
..builtIn.parse.f16:? if
  proc( char8 _ ptr iSize -> f16 ) : export: static: alias: :f16 ..builtIn.parse.f16
end
proc( char8 _ ptr iSize -> f32 ) : export: static: alias: :f32 ..builtIn.parse.f32
proc( char8 _ ptr iSize -> f64 ) : export: static: alias: :f64 ..builtIn.parse.f64
