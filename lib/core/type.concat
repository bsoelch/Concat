namespace: type
  typeSet( ..types.isPrimitive@ ) =:: export: primitive
  typeSet( ..types.isPointer@ ) =:: export: pointer
  typeSet( ..types.isArray@ ) =:: export: array
  typeSet( ..types.isEnum@ ) =:: export: enum
  typeSet( ..types.isTaggedUnion@ ) =:: export: union

  typeSet( i8 i16 i32 i64 ) =:: export: integer
  typeSet( f32 f64 ) =:: export: float
  typeSet( integer float ) =:: export: number
  typeSet( iSize i32 i64 ) =:: export: index
  typeSet( integer char8 char16 char32 ) =:: export: intLike

  proc( type : T -> bool ) =>: export: static: isNamedPrimitive
    ## FIXME: this procedure should return false for unnamed primitives
    ##  due to an interpreter bug using and-or statements in the interpreter is currently not possible
    T ..types.unwrapNamed ..types.isPrimitive
  end
  typeSet( isNamedPrimitive@ ) =:: export: namedPrimitive
end
