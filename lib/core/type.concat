namespace: type
  proc( type type -> bool ) : export: alias: equals ..types.equals
  proc( type type -> bool ) =>: notEquals
    ..types.equals !
  end

  type .with( ..types.isPrimitive ) =:: export: primitive
  type .with( ..types.isPointer ) =:: export: pointer
  type .with( ..types.isValuePointer ) =:: export: valuePointer
  type .with( ..types.isArray ) =:: export: array
  type .with( ..types.isEnum ) =:: export: enum
  type .with( ..types.isTaggedUnion ) =:: export: union

  proc( type : T -> bool ) =>: export: static: isPointerValue
    T ..types.unwrapNamed ..types.isValuePointer
  end
  type .with( ..types.unwrapNamed ..types.isValuePointer ) =:: export: pointerValue
  proc( type : T -> bool ) =>: export: static: isNamedPointer
    T ..types.unwrapNamed ..types.isPointer
  end
  type .with( ..types.unwrapNamed ..types.isPointer ) =:: export: namedPointer

  proc( type : T -> bool ) =>: export: static: isNamedEnum
    T ..types.unwrapNamed ..types.isEnum
  end
  type .with( ..types.unwrapNamed ..types.isEnum ) =:: export: namedEnum

  oneOf( i8 i16 i32 i64 ) =:: export: integer
  oneOf( f32 f64 ) =:: export: float
  oneOf( integer ... float ... ) =:: export: number
  oneOf( iSize i32 i64 ) =:: export: index
  oneOf( integer ... char8 ) =:: export: intLike

  proc( type : T -> bool ) =>: export: static: isNamedPrimitive
    T ..types.isNamed and T ..types.unwrapNamed ..types.isPrimitive end
  end
  type .with( isNamedPrimitive ) =:: export: namedPrimitive

  type .with( ..types.isUnionElement ) =:: export: unionElement
  ## wrapper to delay generic resolving
  ( type : U -> type ) =>: export: nowrap: unionElementType
    U ..types.getUnionElement
  end
  ( type : U -> type ) =>: export: nowrap: unionElementUnion
    U ..types.getUnionElementUnion
  end
  proc( type : T -> bool ) =>: export: static: isUnionElementPointer
    T ..types.isPointer and
      T ..types.arrayElement ..types.isUnionElement
    end
  end
  type .with( isUnionElementPointer ) =:: export: unionElementPointer
  ( type : U -> type ) =>: export: nowrap: unionElementPtrType
    U ..types.arrayElement
      $ ..types.isUnionElement if ## array-element can return type.undefined which leads to error when creating pointer
        ..types.getUnionElement
        U ..types.isMutable if
          ptr.mut
        else
          ptr
        end
      end
    return
  end
  ( type : U -> type ) =>: export: nowrap: unionElementUnionPtr
    U ..types.arrayElement
      $ ..types.isUnionElement if ## array-element can return type.undefined which leads to error when creating pointer
        ..types.getUnionElementUnion
        U ..types.isMutable if
          ptr.mut
        else
          ptr
        end
      end
    return
  end
end
overload: merge: == type.equals end
overload: merge: != type.notEquals end
