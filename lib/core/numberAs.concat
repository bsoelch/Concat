## loss-free conversion, ? return optional on lossy conversion
overload: as
  i8.asI16 i8.asI32 i8.asI64 i8.asI128 i8.asF32 i8.asF64 i8.asF128
  i16.asI32 i16.asI64 i16.asI128 i16.asF32 i16.asF64 i16.asF128
  i32.asI64 i32.asI128 i32.asF64 i32.asF128
  i64.asI128 i64.asF128
  f32.asF64
end
namespace: as
  overload: u
    i8.asI16u i8.asI32u i8.asI64u i8.asI128u i8.asF32u i8.asF64u i8.asF128u
    i16.asI32u i16.asI64u i16.asI128u i16.asF32u i16.asF64u i16.asF128u
    i32.asI64u i32.asI128u i32.asF64u i32.asF128u
    i64.asI128u i64.asF128u
  end
end
## to: potentially lossy direct conversion
overload: to
  i8.asI16 i8.asI32 i8.asI64 i8.asI128 i8.asF32 i8.asF64 i8.asF128
  i16.toI8 i16.asI32 i16.asI64 i16.asI128 i16.asF32 i16.asF64 i16.asF128
  i32.toI8 i32.toI16 i32.toF32 i32.asI64 i32.asI128 i32.asF64 i32.asF128
  i64.toI8 i64.toI16 i64.toI32 i64.toF32 i64.toF64 i64.asI128 i64.asF128
  i128.toF128
  f32.toI8 f32.toI16 f32.toI32 f32.toI64 f32.asF64
  f64.toI8 f64.toI16 f64.toI32 f64.toI64 f64.toF32
end
namespace: to
  overload: u
    i8.asI16u i8.asI32u i8.asI64u i8.asI128u i8.asF32u i8.asF64u i8.asF128u
    i16.asI32u i16.asI64u i16.asI128u i16.asF32u i16.asF64u i16.asF128u
    i32.asI64u i32.asI128u i32.toF32u i32.asF64u i32.asF128u
    i64.asI128u i64.toF32u i64.toF64u i64.asF128u
    i128.toF128u
    f32.toI8u f32.toI16u f32.toI32u f32.toI64u
    f64.toI8u f64.toI16u f64.toI32u f64.toI64u
  end
end
