"integers" import
"floats" import
namespace: i8
  proc( i8 oneOf( i16 ) : static: _ -> i16 ) =>: asI16
    ..builtIn.cvt.s8.i16
  end
  proc( i8 oneOf( i32 ) : static: _ -> i32 ) =>: asI32
    ..builtIn.cvt.s8.i32
  end
  proc( i8 oneOf( i64 ) : static: _ -> i64 ) =>: asI64
    ..builtIn.cvt.s8.i64
  end
  proc( i8 oneOf( f32 ) : static: _ -> f32 ) =>: asF32
    ..builtIn.cvt.s8.f32
  end
  proc( i8 oneOf( f64 ) : static: _ -> f64 ) =>: asF64
    ..builtIn.cvt.s8.f64
  end
  proc( i8 oneOf( i16 ) : static: _ -> i16 ) =>: asI16u
    ..builtIn.cvt.u8.i16
  end
  proc( i8 oneOf( i32 ) : static: _ -> i32 ) =>: asI32u
    ..builtIn.cvt.u8.i32
  end
  proc( i8 oneOf( i64 ) : static: _ -> i64 ) =>: asI64u
    ..builtIn.cvt.u8.i64
  end
  proc( i8 oneOf( f32 ) : static: _ -> f32 ) =>: asF32u
    ..builtIn.cvt.u8.f32
  end
  proc( i8 oneOf( f64 ) : static: _ -> f64 ) =>: asF64u
    ..builtIn.cvt.u8.f64
  end
  proc( i8 oneOf( i128 ) : static: _ -> i128 ) =>: asI128
    i64 cast.s i128.fromI64
  end
  proc( i8 oneOf( i128 ) : static: _ -> i128 ) =>: asI128u
    i64 cast.u i128.fromU64
  end
  proc( i8 oneOf( f128 ) : static: _ -> f128 ) =>: asF128
    i64 cast.s f128.fromI64
  end
  proc( i8 oneOf( f128 ) : static: _ -> f128 ) =>: asF128u
    i64 cast.u f128.fromU64
  end
end
