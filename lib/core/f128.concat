import core/integers
import core/f32
import core/f64

struct(
  i64 : low
  i64 : hi
) =:: export: f128

namespace: f128
  0x8000'0000'0000'0000:i64 =:: export: SIGN_FLAG_HI
  0x7fff'0000'0000'0000:i64 =:: export: EXP_MASK_HI
  0x0001'0000'0000'0000:i64 =:: export: HIDDEN_BIT_HI
  0x0000'ffff'ffff'ffff:i64 =:: export: MANTISSA_MASK_HI
  48:i64 =:: export: EXP_SHIFT_HI
  0x7fff:i64 =:: export: SHIFTED_EXP_MASK
  0x3fff:i64 =:: export: EXP_BIAS
  48:i64 =:: export: MANTISSA_BITS_HI
  112:i64 =:: export: MANTISSA_BITS
  0x7fff'ffff'ffff'ffff:i64 =:: export: NAN_HI
  0xffff'ffff'ffff'ffff:i64 =:: export: NAN_LOW
  EXP_MASK_HI =:: export: INF_HI
  0:i64 =:: export: INF_LOW

  { 0 : low 0 : hi } f128 =: export: ZERO
  { 0 : low EXP_BIAS EXP_SHIFT_HI << : hi } f128 =: export: ONE
  { 0 : low EXP_BIAS EXP_SHIFT_HI << SIGN_FLAG_HI | : hi } f128 =: export: MINUS_ONE
  { 0 : low EXP_BIAS 1 + EXP_SHIFT_HI << : hi } f128 =: export: TWO
  { 0 : low EXP_BIAS 1 + 1 << 1 | EXP_SHIFT_HI 1 - << : hi } f128 =: export: THREE
  { 0 : low EXP_BIAS 1 - EXP_SHIFT_HI << : hi } f128 =: export: HALF

  { 0xc908'b2fb'1366'ea95:i64 : low 0x3FFF'6a09'e667'f3bc:i64 : hi } f128 =: export: SQRT2
  { 0xf357'93c7'6730'07e6:i64 : low 0x3FFE'62e4'2fef'a39e:i64 : hi } f128 =: export: LOG2
  { 0xe177'7d0f'fda0'd23a:i64 : low 0x3FFE'7154'7652'b82f:i64 : hi } f128 =: export: LOG2_INV

  proc( f128 -> i32 ) =>: export: exponent
    $ .hi EXP_SHIFT_HI >>> SHIFTED_EXP_MASK & i32 cast.u
      $ 0 == if ## subnormal
        >$ bits $ .hi MANTISSA_MASK_HI & >$ .hi= i128.highestSetBit 1 + MANTISSA_BITS i32 cast.u - +
      else >$ ..drop end
    EXP_BIAS i32 cast.u -
  end

  proc( i64 : low i64 : hi -> f128 ) =>: export: create
    low hi f128 new
  end
  ## TODO make sure to use unsigned comparisson for comparing parts of f128
  proc( i32 : n -> f128 ) =>: export: fromI32
    n i128.fromI32 false fromI128_internal
  end
  proc( i64 : n -> f128 ) =>: export: fromI64
    n i128.fromI64 false fromI128_internal
  end
  proc( i64 : n -> f128 ) =>: export: fromU64
    n i128.fromU64 false fromI128_internal
  end
  proc( i128 -> f128 ) =>: export: fromI128
    true fromI128_internal
  end
  proc( i128 -> f128 ) =>: export: fromU128
    false fromI128_internal
  end
  proc( i128 : n bool : signed -> f128 ) =>: fromI128_internal
    n .hi n .low | 0 == if
      0 0 f128.create return
    end
    n i128.highestSetBit i64 cast.u =:: mut: bitCount
    bitCount MANTISSA_BITS - =:: shift
    signed and n .hi 0 < end =:: sign
    n
      sign if -_ end
      shift 0 > if
        ..dup .low 1 shift << 1 - & =:: lowBits
        shift >>>
        1:i64 shift 1 - << =:: half
        lowBits half u> or lowBits half == and ..dup .low 1 & ? if
          i128.ONE + ## round up
        end
        ..dup .hi 1:i64 EXP_SHIFT_HI 1 + << & ? if
          1 >>>
          bitCount 1 + bitCount=
        end
      else shift 0 < _if
        shift -_ <<
      end
    =:: scaledValue
    ## f128
      scaledValue .low
      scaledValue .hi MANTISSA_MASK_HI & bitCount EXP_BIAS + EXP_SHIFT_HI << | sign if SIGN_FLAG_HI | end
    f128.create
  end

  ## TODO: correctly handle negative numbers
  proc( f128 -> i32 ) =>: export: toU32
    $ isNaN or $ .hi 0 < if ..drop 0 return end
    $ .hi EXP_SHIFT_HI >>> SHIFTED_EXP_MASK & EXP_BIAS - =:: exp
    exp 0 < if ..drop 0 return end
    exp 32 > if ..drop i32.UMAX i32 cast.u return end
    .hi MANTISSA_MASK_HI & HIDDEN_BIT_HI |
      MANTISSA_BITS_HI exp - >>>
    i32 cast.u return
  end
  proc( f128 -> i64 ) =>: export: toU64
    $ isNaN or $ .hi 0 < if ..drop 0 return end
    $ .hi EXP_SHIFT_HI >>> SHIFTED_EXP_MASK & EXP_BIAS - =:: exp
    exp 0 < if ..drop 0 return end
    exp 64 > if ..drop i64.UMAX return end
    exp MANTISSA_BITS_HI <= if
      .hi MANTISSA_MASK_HI & HIDDEN_BIT_HI |
        MANTISSA_BITS_HI exp - >>>
      return
    end
    $ .hi MANTISSA_MASK_HI & HIDDEN_BIT_HI | exp MANTISSA_BITS_HI - <<
      >$ .low 64 exp MANTISSA_BITS_HI - - >>> |
    return
  end
  proc( f128 -> i128 ) =>: export: toU128
    $ isNaN or $ .hi 0 < if ..drop i128.ZERO return end
    $ .hi EXP_SHIFT_HI >>> SHIFTED_EXP_MASK & EXP_BIAS - =:: exp
    exp 0 < if ..drop i128.ZERO return end
    exp 128 > if ..drop i128.UMAX return end
    exp MANTISSA_BITS_HI <= if
      .hi MANTISSA_MASK_HI & HIDDEN_BIT_HI |
        MANTISSA_BITS_HI exp - >>>
      i128.fromU64 return
    end
    exp MANTISSA_BITS < if
      $ .low >$ .hi MANTISSA_MASK_HI & HIDDEN_BIT_HI | i128.create MANTISSA_BITS exp - >>>
    else
      $ .low >$ .hi MANTISSA_MASK_HI & HIDDEN_BIT_HI | i128.create exp MANTISSA_BITS - <<
    end
    return
  end
  proc( f128 -> i32 ) =>: export: toI32
    $ .hi 0 < if
      abs toU32 i32.MIN -_ i32.umin -_
    else
      toU32 i32.MAX i32.umin
    end
  end
  proc( f128 -> i64 ) =>: export: toI64
    $ .hi 0 < if
      abs toU64 i64.MIN -_ i64.umin -_
    else
      toU64 i64.MAX i64.umin
    end
  end
  proc( f128 -> i128 ) =>: export: toI128
    $ .hi 0 < if
      abs toU128 i128.MIN -_ i128.umin -_
    else
      toU128 i128.MAX i128.umin
    end
  end
  proc( f32 -> f128 ) =>: export: fromF32
    "unimplemented" ..panic
  end
  proc( f64 -> f128 ) =>: export: fromF64
    "unimplemented" ..panic
  end
  ## TODO! rounding
  ## TODO: test subnormal number handling in conversions
  proc( f128 -> f32 ) =>: export: toF32
    $ .hi EXP_SHIFT_HI >>> SHIFTED_EXP_MASK & =:: exp
    exp SHIFTED_EXP_MASK == if ## NaN or infinity
      $ .hi SIGN_FLAG_HI & 32 >>> i32 cast.u
        f32.EXP_MASK |
        >$ .hi MANTISSA_MASK_HI & MANTISSA_BITS_HI i32 cast.u f32.MANTISSA_BITS - >>> i32 cast.u |
      f32.fromBits return
    end
    exp i32 cast.s EXP_BIAS i32 cast.s f32.EXP_BIAS - - =:: shadow: exp
    exp 0 < if ## subnormal
      exp f32.MANTISSA_BITS -_ < if
        .hi SIGN_FLAG_HI & 32 >>> i32 cast.u f32.fromBits return
      else
        $ .hi SIGN_FLAG_HI & 32 >>> i32 cast.u
          >$ .hi MANTISSA_MASK_HI & HIDDEN_BIT_HI |
            MANTISSA_BITS_HI i32 cast.u f32.MANTISSA_BITS - exp + >>>
          i32 cast.u |
        f32.fromBits return
      end
    else exp f32.SHIFTED_EXP_MASK > _if ## overflow
      .hi 0 < if f32.-Infinity else f32.Infinity end return
    end
    $ .hi SIGN_FLAG_HI & 32 >>> i32 cast.u
      exp f32.EXP_SHIFT << |
      >$ .hi MANTISSA_MASK_HI & MANTISSA_BITS_HI i32 cast.u f32.MANTISSA_BITS - >>> i32 cast.u |
    f32.fromBits return
  end
  proc( f128 -> f64 ) =>: export: toF64
    $ .hi EXP_SHIFT_HI >>> SHIFTED_EXP_MASK & =:: exp
    exp SHIFTED_EXP_MASK == if ## NaN or infinity
      $ .hi SIGN_FLAG_HI &
        f64.EXP_MASK |
        $1 .hi MANTISSA_MASK_HI & f64.MANTISSA_BITS MANTISSA_BITS_HI - << |
        >$ .low 64 f64.MANTISSA_BITS MANTISSA_BITS_HI - - >>> |
      f64.fromBits return
    end
    exp EXP_BIAS f64.EXP_BIAS - - =:: shadow: exp
    exp 0 < if ## subnormal
      exp f64.MANTISSA_BITS -_ < if
        .hi SIGN_FLAG_HI & f64.fromBits return
      else exp MANTISSA_BITS_HI f64.MANTISSA_BITS - < _if
        $ .hi SIGN_FLAG_HI &
          >$ .hi MANTISSA_MASK_HI & HIDDEN_BIT_HI |
            MANTISSA_BITS_HI f64.MANTISSA_BITS - exp + >>>
          |
        f64.fromBits return
      else
        $ .hi SIGN_FLAG_HI &
          $1 .hi MANTISSA_MASK_HI & HIDDEN_BIT_HI | f64.MANTISSA_BITS MANTISSA_BITS_HI - exp + << |
          >$ .low 64 f64.MANTISSA_BITS MANTISSA_BITS_HI - - exp - >>> |
        f64.fromBits return
      end
    else exp f64.SHIFTED_EXP_MASK > _if ## overflow
      .hi 0 < if f64.-Infinity else f64.Infinity end return
    end
    $ .hi SIGN_FLAG_HI &
      exp f64.EXP_SHIFT << |
      $1 .hi MANTISSA_MASK_HI & f64.MANTISSA_BITS MANTISSA_BITS_HI  - << |
      >$ .low 64 MANTISSA_BITS_HI f64.MANTISSA_BITS - + >>> |
    f64.fromBits return
  end

  proc( i128 : n -> f128 ) =>: export: fromBits
    n .low n .hi f128.create return
  end
  proc( f128 : x -> i128 ) =>: export: bits
    x .low x .hi i128.create return
  end

  proc( -> f128 ) =>: export: NaN
    NAN_LOW NAN_HI f128.create return
  end
  proc( -> f128 ) =>: export: Infinity
    INF_LOW INF_HI f128.create return
  end
  proc( -> f128 ) =>: export: -Infinity
    ## f128
      INF_LOW
      INF_HI SIGN_FLAG_HI |
    f128.create return
  end

  proc( f128 : x -> bool ) =>: export: isNaN
    x .hi EXP_MASK_HI & EXP_MASK_HI == and
      x .low ? or x .hi MANTISSA_MASK_HI & ?
    end return
  end
  proc( f128 : x -> bool ) =>: export: isInfinite
    x .hi EXP_MASK_HI & EXP_MASK_HI == and
      x .low ? ! and x .hi MANTISSA_MASK_HI & ? !
    end return
  end
  proc( f128 : x -> bool ) =>: export: isFinite
    x .hi EXP_MASK_HI & EXP_MASK_HI != return
  end
  proc( f128 -> bool ) =>: export: isNormal
    .hi EXP_MASK_HI & $ EXP_MASK_HI != >$ 0 != &
  end

  proc( f128 : x -> f128 ) =>: export: truncate
    x .hi EXP_SHIFT_HI >>> SHIFTED_EXP_MASK & EXP_BIAS - =:: e
    e 0 < if ## absolute value < 1
      0 x .hi SIGN_FLAG_HI & f128.create return
    end
    e MANTISSA_BITS >= if
      ## smallest bit has magnitude > 1
      x return
    else e MANTISSA_BITS_HI >= _if
      x .low -1:i64 MANTISSA_BITS_HI e - << &
        x .hi
      f128.create
    else
      0
        x .hi MANTISSA_MASK_HI ~ &
        x .hi MANTISSA_MASK_HI & -1 MANTISSA_BITS e - << & |
      f128.create
    end
  end
  proc( f128 : x -> f128 ) =>: export: floor
    x truncate =:: y
    x .hi 0 < and x y != if
      y ONE - return
    end
    y return
  end
  proc( f128 : x -> f128 ) =>: export: ceil
    x truncate =:: y
    x .hi 0 > and x y != if
      y ONE + return
    end
    y return
  end
  ## half-even rounding
  proc( f128 : x -> f128 ) =>: export: round
    x .hi MANTISSA_MASK_HI & =:: m_hi
    x .hi EXP_SHIFT_HI >>> SHIFTED_EXP_MASK & EXP_BIAS - =:: e
    e -1 < if ## absolute value < 0.5
      0 x .hi SIGN_FLAG_HI & f128.create return
    else e -1 == _if ## 1 < |x| <= 0.5
      m_hi 0 == and x .low 0 == if ## |x|=0.5
        0 x .hi SIGN_FLAG_HI & f128.create return
      end
      ONE
        $ .hi x .hi SIGN_FLAG_HI & | >$ .hi=
      return
    end
    e MANTISSA_BITS >= if
      ## smallest bit has magnitude > 1
      x return
    end
    x .low m_hi HIDDEN_BIT_HI | i128.create =:: m
    m i128.UMAX 128 MANTISSA_BITS - e + >>> & =:: fract
    i128.ONE MANTISSA_BITS 1 - e - << =:: half
    e MANTISSA_BITS_HI >= if
      x .low -1:i64 MANTISSA_BITS_HI e - << &
        x .hi
      f128.create
    else
      0
        x .hi MANTISSA_MASK_HI ~ &
        x .hi MANTISSA_MASK_HI & -1 MANTISSA_BITS e - << & |
      f128.create
    end =:: trunc
    fract i128.ZERO == or fract half < if
      trunc return ## already an integer
    end
    ONE
      $ .hi x .hi SIGN_FLAG_HI & | >$ .hi=
    =:: delta
    trunc
      fract half > or m half 1 << & i128.ZERO != if ## half and odd
        delta +
      end
    return
  end

  ## strictly ordered comparison of values
  ## differences to IEEE comparison:
  ##   * compares -0 < 0
  ##   * NaN == NaN , NaN > Infinity
  proc( f128 : x f128 : y -> i32 ) =>: export: compare
    ## different signs
    x .hi SIGN_FLAG_HI & y .hi SIGN_FLAG_HI & != if
      x .hi SIGN_FLAG_HI & ? if -1 else 1 end return
    end
    x isNaN and y isNaN if
      0 return ## treat all NaNs as equal
    end
    x .hi SIGN_FLAG_HI & ? if -1 else 1 end =:: sign
    x .hi SIGN_FLAG_HI ~ & =:: xHi
    y .hi SIGN_FLAG_HI ~ & =:: yHi
    xHi yHi != if
      xHi yHi u< if sign -_ else sign end return
    end
    x .low y .low u< if
      sign -_
    else x .low y .low u> _if
      sign
    else 0 end return
  end
  ## IEEE compliant comparison,
  ## if x or y is NaN  the return value will be  0 false
  ## otherwise the result of compare followed by true will be returned
  proc( f128 : x f128 : y -> i32 bool ) =>: export: compareIEEE ## TODO? better name
    x isNaN and y isNaN if
      0 false return
    end
    ## TODO? should -0 == 0
    x y compare true return
  end

  proc( f128 -> bool ) =>: export: toBool
    $ .hi SIGN_FLAG_HI ~ & 0 !=
      >$ .low 0 !=
    |
  end
  proc( f128 f128 -> bool ) =>: export: eq
    compareIEEE if 0 == return end ..drop false return
  end
  proc( f128 f128 -> bool ) =>: export: ne
    compareIEEE if 0 != return end ..drop false return
  end
  proc( f128 f128 -> bool ) =>: export: lt
    compareIEEE if 0 < return end ..drop false return
  end
  proc( f128 f128 -> bool ) =>: export: le
    compareIEEE if 0 <= return end ..drop false return
  end
  proc( f128 f128 -> bool ) =>: export: ge
    compareIEEE if 0 >= return end ..drop false return
  end
  proc( f128 f128 -> bool ) =>: export: gt
    compareIEEE if 0 > return end ..drop false return
  end

  ## shift mantissa of subnormal number to left until hidden bit is non-zero
  ## returns number of shifted bits
  proc( f128 : x -> f128 i32 ) =>: normalizeMantissa
    x .hi EXP_MASK_HI & ? if
      x 0 return ## already normalized
    end
    x .hi MANTISSA_MASK_HI & =:: mut: xHi
    x .low =:: mut: xLow
    0 =:: mut: shift
    0 =:: mut: baseShift
    xHi 0 == if
      xLow HIDDEN_BIT_HI MANTISSA_MASK_HI | <= if
        xLow xHi=
        0 xLow=
        64 baseShift=
      else
        xLow 16 >>> xHi=
        xLow 48 << xLow=
        48 baseShift=
      end
    end
    ## shift high bits
    xHi 0x1'ffff'fffe'0000 & ? ! if
      ## nothing in high 31+1 bits of mantissa
      xHi 32 << xHi=
      shift 32 + shift=
    end
    xHi 0x1fffe00000000 & ? ! if
      ## nothing in high 15+1 bits of mantissa
      xHi 16 << xHi=
      shift 16 + shift=
    end
    xHi 0x1fe0000000000 & ? ! if
      ## nothing in high 7+1 bits of mantissa
      xHi 8 << xHi=
      shift 8 + shift=
    end
    xHi 0x1e00000000000 & ? ! if
      ## nothing in high 3+1 bits of mantissa
      xHi 4 << xHi=
      shift 4 + shift=
    end
    xHi 0x1800000000000 & ? ! if
      ## nothing in high 1+1 bits of mantissa
      xHi 2 << xHi=
      shift 2 + shift=
    end
    xHi 0x1000000000000 & ? ! if
      ## nothing in hidden bit of mantissa
      xHi 1 << xHi=
      shift 1 + shift=
    end
    ## return
      ## f128
        xLow shift <<
        xHi
          shift ? if xLow 64 shift - >>> | end
        x .hi SIGN_FLAG_HI & |
      f128.create
      baseShift shift +
    return
  end

  proc( f128 : x -> f128 ) =>: export: neg
    ## f128
      x .low
      x .hi SIGN_FLAG_HI ^
    f128.create
  end
  proc( f128 : x -> f128 ) =>: export: abs
    ## f128
      x .low
      x .hi SIGN_FLAG_HI ~ &
    f128.create
  end
  proc( f128 : x f128 : y -> f128 ) =>: export: add
    x .hi SIGN_FLAG_HI & ? y .hi SIGN_FLAG_HI & ? != if
      x y neg sub return
    end
    x .hi SIGN_FLAG_HI & =:: sign
    x isNaN or y isNaN if
      ## NaN +y x+NaN -> NaN
      NAN_LOW sign NAN_HI | f128.create return
    else x isInfinite or y isInfinite _if
      ## Inf +y x+Inf -> Inf
      INF_LOW sign INF_HI | f128.create return
    end
    x .hi y .hi u< or x .hi y .hi == and x .low y .low u< if
      y x
    else
      x y
    end  =:: b =:: a ## a >= b
    a .hi EXP_SHIFT_HI >>> SHIFTED_EXP_MASK & =:: exp0A
    b .hi EXP_SHIFT_HI >>> SHIFTED_EXP_MASK & =:: exp0B
    exp0A exp0B MANTISSA_BITS 1 + + > if
      a return ## adding b does not change value of a
    end
    a .hi MANTISSA_MASK_HI &
      exp0A ? if HIDDEN_BIT_HI | end
    =:: aHi
    a .low =:: mut: aLow
    b .hi MANTISSA_MASK_HI &
      exp0B ? if HIDDEN_BIT_HI | end
    =:: mut: bHi
    b .low =:: mut: bLow
    exp0A 1 i64.max =:: mut: exp
    exp0B 1 i64.max =:: expB
    false =:: mut: nz
    false =:: mut: nextBit
    ## exp == expA >= expB
    exp expB > if
      exp expB - i32 cast.u =:: shift
      shift 64 >= if
        1:i64 shift 64 1 - - << =:: nextBitMask
        bLow
          bHi nextBitMask 1 - & |
        ? nz=
        bHi nextBitMask & ? nextBit=
        bHi shift 64 - >>> bLow=
        0 bHi=
      else
        1:i64 shift 1 - << =:: nextBitMask
        bLow nextBitMask 1 - & ? nz=
        bLow nextBitMask & ? nextBit=
        bLow shift >>>
          bHi 64 shift - << |
        bLow=
        bHi shift >>> bHi=
      end
    end
    false
      aLow bLow i64.addc =:: mut: lowSum
      aHi bHi i64.addc =:: mut: hiSum
    ! "no overflow" assert
    ## check for overflow of mantissa
    hiSum HIDDEN_BIT_HI MANTISSA_MASK_HI | > if
      nz nextBit | nz=
      lowSum 1 & ? nextBit=
      lowSum 1 >>>
        hiSum 63 << |
      lowSum=
      hiSum 1 >>> hiSum=
      exp 1 + exp=
    end
    ## rounding
    nextBit and nz or lowSum 1 & ? if
      ## round up if next bit is 1 and lower bits nonzero or number odd
      lowSum 1 + lowSum=
      lowSum 0 == if
        hiSum 1 + hiSum=
      end
    end
    ## overflow due to rounding
    hiSum HIDDEN_BIT_HI MANTISSA_MASK_HI | > if
      ## when rounding overflows, then lowSum is zero
      hiSum 63 << lowSum=
      hiSum 1 >>> hiSum=
      exp 1 + exp=
    end
    exp SHIFTED_EXP_MASK >= if
      ## number overflowed
      INF_LOW sign INF_HI | f128.create return
    end
    ## f128
      lowSum
      sign exp EXP_SHIFT_HI << | hiSum MANTISSA_MASK_HI & |
    f128.create return
  end
  proc( f128 : x f128 : y -> f128 ) =>: export: sub
    x .hi SIGN_FLAG_HI & ? y .hi SIGN_FLAG_HI & ? != if
      x y neg add return
    end
    x isNaN or y isNaN if
      NaN return
    else x isInfinite _if
      y isInfinite if
        NaN return ##  Inf-Int = NaN
      else
        x return
      end
    else y isInfinite _if
      y neg return
    end
    x .hi y .hi u< or x .hi y .hi == and x .low y .low u< end =:: swapped
    swapped if y x else x y end =:: b =:: a ## a >= b
    x .hi SIGN_FLAG_HI & =:: mut: sign
    a .hi EXP_SHIFT_HI >>> SHIFTED_EXP_MASK & =:: exp0A
    b .hi EXP_SHIFT_HI >>> SHIFTED_EXP_MASK & =:: exp0B
    exp0A exp0B MANTISSA_BITS 1 + + > if
      a
        swapped if neg end
      return ## subtracting b does not change value of a
    end
    a .hi MANTISSA_MASK_HI &
      exp0A ? if HIDDEN_BIT_HI | end
    =:: aHi
    a .low =:: aLow
    b .hi MANTISSA_MASK_HI &
      exp0B ? if HIDDEN_BIT_HI | end
    =:: mut: bHi
    b .low =:: mut: bLow
    exp0A 1 i64.max =:: mut: exp
    exp0B 1 i64.max =:: expB
    false =:: mut: nz
    false =:: mut: nextBit
    ## exp == expA >= expB
    exp expB > if
      exp expB - i32 cast.u =:: shift
      shift 64 >= if
        1:i64 shift 64 1 - - << =:: nextBitMask
        bLow
          bHi nextBitMask 1 - & |
        ? nz=
        bHi nextBitMask & ? nextBit=
        bHi shift 64 - >>> bLow=
        0 bHi=
      else
        1:i64 shift 1 - << =:: nextBitMask
        bLow nextBitMask 1 - & ? nz=
        bLow nextBitMask & ? nextBit=
        bLow shift >>>
          bHi 64 shift - << |
        bLow=
        bHi shift >>> bHi=
      end
    end
    aHi bHi >= or aHi bHi == and aLow bLow >= end "a>=b" assert
    aHi bHi -
      bLow aLow > if 1 - end ## underflow
    =:: mut: hiDiff
    aLow bLow - =:: mut: lowDiff
    ## rounding
    nextBit and nz or lowDiff 1 & ? if
      ## round up/down if next bit is 1 and lower bits nonzero or number odd
      swapped if
        lowDiff 1 + lowDiff=
        lowDiff 0 == if
          hiDiff 1 + hiDiff=
        end
      else
        lowDiff 1 - lowDiff=
        lowDiff 0 == if
          hiDiff 1 - hiDiff=
        end
      end
    end
    lowDiff hiDiff | 0 == if
      0 0 f128.create return
    end
    exp 0 == if
      ## f128
        lowDiff
        sign hiDiff |
      f128.create return
    end
    lowDiff hiDiff f128.create normalizeMantissa =:: delta =:: mag
    exp delta i64 cast.s - exp=
    ## handle subnormal numbers
    ## shifts increased by 1 to undo shifting of top bit into hidden bit
    ## no rounding necessary as total right shift at most left shift from normalization
    exp -64 <= if
      ## f128
        mag .hi exp -_ 64 - 1 + >>>
        sign
      f128.create return
    else exp 0 <= _if
      ## f128
        mag .low 1 exp - >>>
          mag .hi << exp 64 + 1 +
        |
        sign mag .hi 1 exp - >>> |
      f128.create return
    end
    ## f128
      mag .low
      sign exp EXP_SHIFT_HI << | mag .hi MANTISSA_MASK_HI & |
    f128.create return
  end

  proc( f128 : x f128 : y -> f128 ) =>: export: mul
    x .hi y .hi ^ SIGN_FLAG_HI & =:: sign
    x isNaN or y isNaN if ## NaN * y ,  x* NaN -> NaN
      NAN_LOW NAN_HI sign | f128.create return
    else x isInfinite or y isInfinite _if
      x .hi SIGN_FLAG_HI ~ & x .low | ? ! or
          y .hi  SIGN_FLAG_HI ~ & y .low | ? ! if
        NAN_LOW NAN_HI sign | f128.create return
      end
      ## Inf * y ,  x* Inf -> Inf
      INF_LOW INF_HI sign | f128.create return
    end
    ## normalizeMantissa is no-op if number is normal
    x normalizeMantissa =:: shiftX =:: x1
    y normalizeMantissa =:: shiftY =:: y1
    shiftX i64 cast.s x1 .hi EXP_SHIFT_HI >>> SHIFTED_EXP_MASK & + =:: expX
    shiftY i64 cast.s y1 .hi EXP_SHIFT_HI >>> SHIFTED_EXP_MASK & + =:: expY
    x1 .hi MANTISSA_MASK_HI & HIDDEN_BIT_HI | =:: xHi
    y1 .hi MANTISSA_MASK_HI & HIDDEN_BIT_HI | =:: yHi
    xHi x1 .low | ? ! if ## 0 * y
      0 sign f128.create return
    else yHi y1 .low | ? ! _if ## x * 0
      0 sign f128.create return
    end
    ## 256 bit product of mantissas
      x1 .low xHi i128.create
      y1 .low yHi i128.create
    i128.umul2 =:: resLow =:: resHi
    ## truncate result to 113 bits
    resHi .hi 33 >>> ? =:: overflow
    overflow if
      resHi .hi 33 >>> 1 == "res < 2^226" assert
      15
    else
      16
    end =:: shiftR
    ## shift number such that top 113 bits are in hi:low
    resHi .hi  shiftR << resHi  .low 64 shiftR - >>> | =:: mut: hi
    resHi .low shiftR << resLow .hi  64 shiftR - >>> | =:: mut: low
    1:i64 64 shiftR - 1 - << =:: nextBitMask0
    resLow .low
      resLow .hi nextBitMask0 1 - & |
    ? =:: mut: nz
    resLow .hi nextBitMask0 & ? =:: mut: nextBit
    ## sum contains bias twice -> subtract to compensate
    expX expY + overflow if 1 + end EXP_BIAS - =:: exp
    ## handle subnormal numbers
    exp 0 <= if
      ## + 1 for hidden bit
      1 exp - =:: shift
      shift 112 > if
        0 sign f128.create return
      else shift 64 > _if
        1:i64 shift 64 - 1 - << =:: nextBitMask
        nz
          nextBit |
          low ? |
          hi nextBitMask 1 - & ? |
        nz=
        hi nextBitMask & ? nextBit=
        hi shift 64 - >>> low=
        0 hi=
      else shift 64 == _if
        nz
          nextBit |
          low 1:i64 63 << 1 - & ? |
        nz=
        low 1:i64 63 << & ? nextBit=
        hi low=
        0 hi=
      else
        1:i64 shift 1 - << =:: nextBitMask
        nz
          nextBit |
          low nextBitMask 1 - & ? |
        nz=
        low nextBitMask & ? nextBit=
        low shift >>>
          hi 64 shift - << |
        low=
        hi shift >>> hi=
      end
    end
    ## rounding
    nextBit and nz or low 1 & ? if
      ## round up if next bit 1 and remainder >0.5 or remainder ==0.5 and number odd
      low 1 + low=
      low 0 == if ## overflow
        hi 1 + hi=
        hi HIDDEN_BIT_HI 1 << & ? if
          hi 63 << low=
          hi 1 >>> hi=
        end
      end
    end
    exp SHIFTED_EXP_MASK >= if ## overflow
      INF_LOW sign INF_HI | f128.create return
    else exp 0 <= _if ## subnormal number
      ## f128
        low
        sign hi MANTISSA_MASK_HI & |
      f128.create return
    end
    ## f128
      low
      sign exp EXP_SHIFT_HI << | hi MANTISSA_MASK_HI & |
    f128.create return
  end

  ## XXX prevent double-rounding when converting result of calculation to f128
  proc( f128 : x  -> f128 ) =>: export: inv
    x f160.fromF128 f160.inv f160.toF128 return
  end
  proc( f128 : x f128 : y -> f128 ) =>: export: div
    ## x*1/y calculated with increased precission to improve accuracy
    x f160.fromF128
      y f160.fromF128 f160.inv
    f160.mul f160.toF128 return
  end
  ## TODO rem,mod

  ## TODO: handle subnormal numbers
  ## approximation of natural logarithm within 5% of actual value
  proc( f128 -> f128 ) =>: export: approxLog
    $ exponent f128.fromI32 LOG2 * <$
      $ .hi EXP_MASK_HI ~ & EXP_BIAS EXP_SHIFT_HI << | >$ .hi=
      $ SQRT2 > if >$ ONE + <$ HALF * end
      ONE - $ $ * - ## log(1+x) ~ x - x^2/2
    +
  end
  ## approximation of base 2 logarithm within 5% of actual value
  proc( f128 -> f128 ) =>: export: approxLog2
    $ exponent f128.fromI32 <$
      $ .hi EXP_MASK_HI ~ & EXP_BIAS EXP_SHIFT_HI << | >$ .hi=
      $ SQRT2 > if >$ ONE + <$ HALF * end
      ONE - $ $ * - LOG2_INV * ## log(1+x) ~ x - x^2/2
    +
  end
end

## f160: procedures for internal calculations with higher precission
## ! uses saturating arithmetic on overflow
## normalized number: 127+1 bit mantissa, 32 bit exponent
struct(
  i128 : magnitude
  i32 : exp
  bool : sign
) =:: export: f160
## TODO? use i128-arithmetic for f160 operations
namespace: f160
  15:i64 =:: F128_SHIFT
  proc( f128 : x -> f160 ) =>:  export: fromF128
    x .hi f128.SIGN_FLAG_HI & ? =:: sign
    x .hi f128.EXP_SHIFT_HI >>> f128.SHIFTED_EXP_MASK & f128.EXP_BIAS - =:: exp
    exp f128.SHIFTED_EXP_MASK f128.EXP_BIAS - == if ## NaN / Infinity
      ## TODO? handle NaN/Infinity
    else exp f128.EXP_BIAS -_ == _if ## subnormal numbers
      x f128.normalizeMantissa =:: shift =:: x1 ## 0x0001
      x1 .hi F128_SHIFT <<
        x1 .low 64 F128_SHIFT - >>> |
      =:: hi
      x1 .low F128_SHIFT << =:: low
      low hi i128.create exp shift i64 cast.s - i32 cast  sign f160 new return
    end
    x .hi f128.MANTISSA_MASK_HI & f128.HIDDEN_BIT_HI | F128_SHIFT <<
      x .low 64 F128_SHIFT - >>> |
    =:: hi
    x .low F128_SHIFT << =:: low
    low hi i128.create exp i32 cast sign f160 new return
  end
  proc( f160 : x -> f128 ) =>: export: toF128
    x .exp i64 cast.s =:: exp
    exp f128.SHIFTED_EXP_MASK f128.EXP_BIAS - >= if ## overflow
      x .sign if f128.-Infinity else f128.Infinity end return
    end
    F128_SHIFT
      exp f128.EXP_BIAS -_ <= if ## underflow
        exp f128.EXP_BIAS + -
      end
    =:: shift
    shift 128 >= if
      0 x .sign if f128.SIGN_FLAG_HI else 0 end f128.create return
    end
    false =:: mut: nz
    false =:: mut: nextBit
    shift 64 >= if
      x .magnitude .hi shift 64 - >>>
      0
      1:i64 shift 64 - 1 - << =:: nextBitMask
      x .magnitude .low
        x .magnitude .hi nextBitMask 1 - & |
      ? nz=
      x .magnitude .hi nextBitMask & ? nextBit=
    else
      x .magnitude .low shift >>> x .magnitude .hi 64 shift - << |
      x .magnitude .hi shift >>>
      1:i64 shift 1 - << =:: nextBitMask
      x .magnitude .low nextBitMask 1 - & ? nz=
      x .magnitude .low nextBitMask & ? nextBit=
    end =:: mut: hi =:: mut: low
    ## rounding
    nextBit and nz or low 1 & ? if
      ## round up if next bit 1 and remainder >0.5 or remainder ==0.5 and number odd
      low 1 + low=
      low 0 == if ## overflow
        hi 1 + hi=
      end
    end
    hi f128.HIDDEN_BIT_HI 1 << & ? =:: overflow
    overflow if
      exp f128.SHIFTED_EXP_MASK f128.EXP_BIAS - >= if  ## overflows finite number
        x .sign if f128.-Infinity else f128.Infinity end return
      end
      hi 63 << low=
      hi 1 >>> hi=
    end
    ## f128
      low
      hi f128.MANTISSA_MASK_HI &
        exp f128.EXP_BIAS + overflow if 1 + end f128.EXP_SHIFT_HI << |
      x .sign if f128.SIGN_FLAG_HI | end
    f128.create return
  end
  ## multiply two 128 bit mantissas x and y
  ##  returns the mantissa of x*y and a boolean indicating if the exponent increased
  proc( f160 : x f160 : y -> f160 ) =>:  export: mul
    x .magnitude i128.ZERO == or y .magnitude i128.ZERO == if
      ## f160
        i128.ZERO 0
        x .sign y .sign ^
      f160 new return
    end
    ## 256 bit product of mantissas
      x .magnitude
      y .magnitude
    i128.umul2 =:: resLow =:: resHi
    ## ensure top bit is one
    resHi .hi  =:: mut: hi
    resHi .low =:: mut: low
    resHi .hi 63 >>> ? =:: highBit
    highBit if
      resLow .hi 63 >>> ?
      resLow .hi 1:i64 63 << 1 - & resLow .low | ?
    else
      hi 1 <<
        low 63 >>> |
      hi=
      low 1 <<
        resLow .hi 63 >>> |
      low=
      1:i64 62 << =:: nextBitMask
      resLow .hi nextBitMask & ?
      resLow .hi nextBitMask 1 - & resLow .low | ?
    end =:: nz =:: nextBit
    false =:: mut: overflow
    ## rounding
    nextBit and nz or low 1 & ? if
      ## round up if next bit 1 and remainder >0.5 or remainder ==0.5 and number odd
      low 1 + low=
      low 0 == if ## overflow
        hi 1 + hi=
        hi 0 == if
          true overflow=
          1:i64 63 << hi=
        end
      end
    end
    x .exp i64 cast y .exp i64 cast + highBit if 1 + end overflow if 1 + end =:: exp
    exp -0x8000'0000 < if
      ## f160
        i128.ZERO 0
        x .sign y .sign ^
      f160 new return
    else exp 0x7fff'ffff > _if
      ## f160
        -1:i64 -1:i64 i128.create
        0x7fff'ffff
        x .sign y .sign ^
      f160 new return
    end
    ## f160
      low hi i128.create
      exp i32 cast
      x .sign y .sign ^
    f160 new return
  end
  proc( f160 : x -> f160 ) =>:  export: neg
    x .magnitude x .exp x .sign ! f160 new
  end
  proc( f160 : x  f160 : y -> f160 ) =>:  export: add
    x .sign y .sign != if
      x y neg sub return
    end
    x .exp y .exp < if
      y x
    else
      x y
    end =:: b =:: a
    b .magnitude .hi =:: mut: bHi
    b .magnitude .low =:: mut: bLow
    false =:: mut: nz
    false =:: mut: nextBit
    ## a .exp >= b .exp
    b .exp a .exp < if
      a .exp b .exp - =:: shift
      shift 128 > if
        a return
      end
      shift 128 == if
        bLow
          bHi 1:i64 63 << 1 - & |
        ? nz=
        bHi 63 >>> ? nextBit=
        0 bHi=
        0 bLow=
      else shift 64 >= _if
        1:i64 shift 64 1 - - << =:: nextBitMask
        bLow
          bHi nextBitMask 1 - & |
        ? nz=
        bHi nextBitMask & ? nextBit=
        bHi shift 64 - >>> bLow=
        0 bHi=
      else
        1:i64 shift 1 - << =:: nextBitMask
        bLow nextBitMask 1 - & ? nz=
        bLow nextBitMask & ? nextBit=
        bLow shift >>>
          bHi 64 shift - << |
        bLow=
        bHi shift >>> bHi=
      end
    end
    false
      a .magnitude .low bLow i64.addc =:: mut: low
      a .magnitude .hi  bHi  i64.addc =:: mut: hi
    =:: mut: carry
    carry if
      nz nextBit | nz=
      low 1 & ? nextBit=
      low 1 >>>
        hi 63 << |
      low=
      hi 1 >>>
        1:i64 63 << |
      hi=
    end
    ## rounding
    nextBit and nz or low 1 & ? if
      low 1 + low=
      low 0 == if
        hi 1 + hi=
        hi 0 == if
          true carry=
          1:i64 63 << hi=
        end
      end
    end
    carry and a .exp 0x7fff'ffff == if
      ## f160
        -1:i64 -1:i64 i128.create
        0x7fff'ffff
        a .sign
      f160 new return
    end
    ## f160
      low hi i128.create
      a .exp carry if 1 + end
      a .sign
    f160 new return
  end
  proc( f160 : x  f160 : y -> f160 ) =>: export: sub
    x .sign y .sign != if
      x y neg add return
    end
    x .exp y .exp < or
      x .exp y .exp == and x .magnitude y .magnitude u<
    end =:: swapped
    swapped if y x else x y end =:: b =:: a
    b .magnitude .low =:: mut: bLow
    b .magnitude .hi =:: mut: bHi
    false =:: mut: nz
    false =:: mut: nextBit
    ## a .exp >= b .exp
    b .exp a .exp < if
      a .exp b .exp - =:: shift
      shift 128 > if
        a
          swapped if neg end
        return
      end
      shift 128 == if
        bLow
          bHi 1:i64 63 << 1 - & |
        ? nz=
        bHi 63 >>> ? nextBit=
        0 bHi=
        0 bLow=
      else shift 64 >= _if
        1:i64 shift 64 - 1 - << =:: nextBitMask
        bLow
          bHi nextBitMask 1 - & |
        ? nz=
        bHi nextBitMask & ? nextBit=
        bHi shift 64 - >>> bLow=
        0 bHi=
      else
        1:i64 shift 1 - << =:: nextBitMask
        bLow nextBitMask 1 - & ? nz=
        bLow nextBitMask & ? nextBit=
        bLow shift >>>
          bHi 64 shift - << |
        bLow=
        bHi shift >>> bHi=
      end
    end
    a .magnitude .hi bHi u> or a .magnitude.hi bHi == and a .magnitude .low bLow u>= end "a>=b" assert
    false
      a .magnitude .low bLow i64.subb =:: mut: low
      a .magnitude .hi  bHi  i64.subb =:: mut: hi
    ..drop
    ## rounding
    nextBit and nz or low 1 & ? if
      ## round up/down if next bit is 1 and lower bits nonzero or number odd
      swapped if
        low 1 + low=
        low 0 == if
          hi 1 + hi=
          ## number cannot overflow in subtraction
        end
      else
        low 1 - low=
        low 0 == if
          hi 1 - hi=
        end
      end
    end
    hi low | 0 == if
      ## f160
        i128.ZERO 0
        a .sign swapped ^
      f160 new return
    end
    hi 0x8000'0000'0000'0000:i64 & ? if
      0
    else hi 0 == _if
      63 low i64.highestSetBit - =:: shift
      low shift << hi=
      0 low=
      64 shift +
    else
      63 hi i64.highestSetBit - =:: shift
      hi shift <<
        low 64 shift - >>> |
      hi=
      low shift << low=
      shift
    end =:: shift
    a .exp -0x8000'0000 shift + < if ## underflow
      ## f160
        i128.ZERO 0
        a .sign swapped ^
      f160 new return
    end
    ## f160
      low hi i128.create
      a .exp shift -
      a .sign swapped ^
    f160 new return
  end
  ## TODO check if result is always correct
  #+
    Computes the inverse of x, assumes that 0.5<=x<1.
    uses Newton-Raphson-Division (https://en.wikipedia.org/wiki/Division_algorithm#Newton%E2%80%93Raphson_division)
  +#
  proc( f160 : x  -> f160 ) =>: normalized_inv ## TODO check constants
    x .magnitude .hi 1 << x .magnitude .low | ? ! if ## only non-zero bit is top bit of x.hi
      ## x == 0.5 -> skip algorithm
      x
        1 >$ .exp=
      return
    end
    0xb4b4'b4b4'b4b4'b4b5:i64 0xb4b4'b4b4'b4b4'b4b4:i64 i128.create 1 false f160 new =:: p ## 48/17
    0xf0f0'f0f0'f0f0'f0f1:i64 0xf0f0'f0f0'f0f0'f0f0:i64 i128.create 0 false f160 new =:: q ## 32/17
    0:i64                     0x8000'0000'0000'0000:i64 i128.create 0 false f160 new =:: one ## 1
    ## 1. estimate 1/x as 48/17 - 32/17 * x
    p x q * -
      ## 2. iteratate: y2 = y1 + y1(1 - y1 *x)
      ## 5 steps should be enough
      #+y+# $ one $1 x * - * +
      #+y+# $ one $1 x * - * +
      #+y+# $ one $1 x * - * +
      #+y+# $ one $1 x * - * +
      #+y+# $ one $1 x * - * +
    return
  end
  proc( f160 : x  -> f160 ) =>: inv
    x .magnitude i128.ZERO == if ## 1/0
      -1 -1 i128.create 0x7fff'ffff x .sign f160 new return
    end
    ## normalize number to interval [0.5,1)
    x .magnitude -1 false f160 new normalized_inv =:: y
    ## 1 / x = 2^( -1 - xExp) / ( x * 2^( -1 - xExp) ) = 2^( -1 - xExp) * y
    y .magnitude y .exp x .exp - 1 - x .sign f160 new return
  end
  ## TODO? div
end

## define operator overloads
overload: -_ f128.neg f160.neg end
overload: + f128.add f160.add end
overload: - f128.sub f160.sub end
overload: * f128.mul f160.mul end
overload: / f128.div end
## overload: % f128.rem end
## overload: // f128.floorDiv end
## overload: %% f128.mod end
overload: <=> f128.compare end
overload: == f128.eq end
overload: != f128.ne end
overload: < f128.lt end
overload: <= f128.le end
overload: >= f128.ge end
overload: > f128.gt end
overload: ? f128.toBool end
