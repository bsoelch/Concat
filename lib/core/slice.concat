import core/ptr
import core/optional
( type : T -> type ) =>: export: slice
  struct( T ptr.raw : data iSize : length )
end
namespace: slice
  ( type : T -> type ) =>: export: mut
    struct( T ptr.raw.mut : data iSize : length )
  end

  proc( type : T -> T slice ) =>: export: empty
    { { } : data 0:iSize : length } return
  end
  proc( type : T -> T slice.mut ) =>: export: emptyMutable
    { { } : data 0:iSize : length } return
  end
  proc( type : auto: T T ptr.raw  i32 -> T slice ) =>: export: create_32
    iSize cast.s create_Z
  end
  proc( type : auto: T T ptr.raw  i64 -> T slice ) =>: export: create_64
    iSize cast.s create_Z
  end
  proc( type : auto: T T ptr.raw  iSize -> T slice ) =>: export: create_Z
    T slice new return
  end
  overload: export: create create_32 create_64 create_Z end
  proc(
    type : auto: T
    iSize : auto: k
    T k ptr : elts
  -> T slice ) =>: export: wrap
    elts k create return
  end
  proc( type : auto: T T slice.mut : a -> T slice ) =>: export: freeze
    a .data a .length slice.create_Z
  end
  proc( type : auto: T T ptr.raw.mut  iSize -> T slice.mut ) =>: export: shadow: create_mut
    T slice.mut new return
  end
  proc( type : auto: T T ptr.raw.mut  i32 -> T slice.mut ) =>: export: shadow: create_32mut
    iSize cast.s create_mut
  end
  proc( type : auto: T T ptr.raw.mut  i64 -> T slice.mut ) =>: export: shadow: create_64mut
    iSize cast.s create_mut
  end
  proc(
    type : auto: T
    iSize : auto: k
    T k ptr.mut : elts
  -> T slice.mut ) =>: export: shadow: wrapMutable
    elts k create_mut return
  end
  overload: export: shadow: createMutable create_mut create_32mut create_64mut end

  proc( type : auto: T T slice : elts iSize : index -> T optional ) =>: export: get_Z
    index elts .length u>= if T optional.empty return end
    elts .data index [] optional.wrap return
  end
  proc( type : auto: T T slice.mut : elts iSize : index -> T optional ) =>: export: get_mut
    index elts .length u>= if T optional.empty return end
    elts .data index [] optional.wrap return
  end
  proc( type : auto: T T slice : elts i32 : index -> T optional ) =>: export: get_32
    elts index iSize cast.u get_Z
  end
  proc( type : auto: T T slice : elts i64 : index -> T optional ) =>: export: get_64
    elts index iSize cast.u get_Z
  end
  proc( type : auto: T T slice.mut : elts i32 : index -> T optional ) =>: export: get_32mut
    elts index iSize cast.u get_mut
  end
  proc( type : auto: T T slice.mut : elts i64 : index -> T optional ) =>: export: get_64mut
    elts index iSize cast.u get_mut
  end
  overload: export: get
    get_Z
    get_mut
    get_32
    get_64
    get_32mut
    get_64mut
  end
  proc( iSize : index iSize : length -> ) =>: checkIndex
    index length u>= if
      "slice index outside range" ..panic
    end
  end
  proc( type : auto: T T slice : elts iSize : index -> T ) =>: export: getValue_Z
    index elts .length checkIndex
    elts .data index [] return
  end
  proc( type : auto: T T slice.mut : elts iSize : index -> T ) =>: export: getValue_mut
    index elts .length checkIndex
    elts .data index [] return
  end
  proc( type : auto: T T slice : elts i32 : index -> T ) =>: export: getValue_32
    elts index iSize cast.u getValue_Z
  end
  proc( type : auto: T T slice : elts i64 : index -> T ) =>: export: getValue_64
    elts index iSize cast.u getValue_Z
  end
  proc( type : auto: T T slice.mut : elts i32 : index -> T ) =>: export: getValue_32mut
    elts index iSize cast.u getValue_mut
  end
  proc( type : auto: T T slice.mut : elts i64 : index -> T ) =>: export: getValue_64mut
    elts index iSize cast.u getValue_mut
  end
  overload: export: getValue
    getValue_Z
    getValue_mut
    getValue_32
    getValue_64
    getValue_32mut
    getValue_64mut
  end
  proc(
    type : auto: T
    T slice : elts
    iSize : index
  -> T ptr optional ) =>: export: at_Z
    index elts .length u>= if
      T ptr optional.empty return
    end
    elts .data index @[] T ptr cast! optional.wrap return
  end
  proc(
    type : auto: T
    T slice : elts
    i32 : index
  -> T ptr optional ) =>: export: at_32
    elts index iSize cast.u at_Z
  end
  proc(
    type : auto: T
    T slice : elts
    i64 : index
  -> T ptr optional ) =>: export: at_64
    elts index iSize cast.u at_Z
  end
  proc(
    type : auto: T
    T slice.mut : elts
    iSize : index
  -> T ptr.mut optional ) =>: export: at_mut
    index elts .length u>= if
      T ptr.mut optional.empty return
    end
    elts .data index @[] T ptr.mut cast! optional.wrap return
  end
  proc(
    type : auto: T
    T slice.mut : elts
    i32 : index
  -> T ptr.mut optional ) =>: export: at_32mut
    elts index iSize cast.u at_mut
  end
  proc(
    type : auto: T
    T slice.mut : elts
    i64 : index
  -> T ptr.mut optional ) =>: export: at_64mut
    elts index iSize cast.u at_mut
  end
  overload: export: at
    at_Z at_mut at_32 at_64 at_32mut at_64mut
  end
  proc(
    type : auto: T
    T slice : elts
    iSize : index
  -> T ptr ) =>: export: atValue_Z
    index elts .length checkIndex
    elts .data index @[] T ptr cast! return
  end
  proc(
    type : auto: T
    T slice : elts
    i32 : index
  -> T ptr ) =>: export: atValue_32
    elts index iSize cast.u atValue_Z
  end
  proc(
    type : auto: T
    T slice : elts
    i64 : index
  -> T ptr ) =>: export: atValue_64
    elts index iSize cast.u atValue_Z
  end
  proc(
    type : auto: T
    T slice.mut : elts
    iSize : index
  -> T ptr.mut ) =>: export: atValue_mut
    index elts .length checkIndex
    elts .data index @[] T ptr.mut cast! return
  end
  proc(
    type : auto: T
    T slice.mut : elts
    i64 : index
  -> T ptr.mut ) =>: export: atValue_64mut
    elts index iSize cast.s atValue_mut
  end
  proc(
    type : auto: T
    T slice.mut : elts
    i32 : index
  -> T ptr.mut ) =>: export: atValue_32mut
    elts index iSize cast.s atValue_mut
  end
  overload: export: atValue
    atValue_Z atValue_mut atValue_32 atValue_64 atValue_32mut atValue_64mut
  end
  proc( type : auto: T T : elt T slice.mut : elts iSize : index -> ) =>: export: set_Z
    index elts .length checkIndex
    elt elts .data index =[]
  end
  proc( type : auto: T T : elt T slice.mut : elts i64 : index -> ) =>: export: set_64
    elt elts index iSize cast.u set_Z
  end
  proc( type : auto: T T : elt T slice.mut : elts i32 : index -> ) =>: export: set_32
    elt elts index iSize cast.u set_Z
  end
  overload: export: set
    set_Z set_32 set_64
  end

end
