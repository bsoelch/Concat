( i64 : static: bitCount -> type ) =>: export: bitarray
  bitCount 63:i64 + 63:i64 ~ & =:: blockCount ## round up to next multiple of 64
  i64 bitCount array
end
i8  =:: export: bits8
i16 =:: export: bits16
i32 =:: export: bits32
i64 =:: export: bits64
## TODO? bits128

namespace: bitarray._internal
  typeSet( bits8 bits16 bits32 bits64 ) =:: bitsN
  proc( bitsN : static: auto: bitsType
    bitsType : data
    i32 : index
  -> bool ) =>: get
    bitsType ..types.size 8 * =:: static: bitCount
    bitCount 32 <= if i32 else bitsType ..types.unwrapNamed end =:: intType
    1 intType cast.u index << =:: bitMask
    data intType cast.u bitMask & ?
  end
  proc( bitsN : static: auto: bitsType
    bool : value
    bitsType : data
    i32 : index
  -> bitsType ) =>: set
    bitsType ..types.size 8 * =:: static: bitCount
    bitCount 32 <= if i32 else bitsType ..types.unwrapNamed end =:: intType
    1 intType cast.u index << =:: bitMask
    data intType cast.u
      value if
          bitMask |
      else
          bitMask ~ &
      end
    bitsType cast.u
  end
  proc( bitsN : static: auto: bitsType
    bitsType : data
  -> bool ) =>: any
    bitsType ..types.unwrapNamed =:: intType
    data intType cast ?
  end
  proc( bitsN : static: auto: bitsType
    bitsType : data
  -> bool ) =>: all
    bitsType ..types.unwrapNamed =:: intType
    data intType cast ~ ? !
  end
end

## TODO check indices
## TODO first,last (get index of .. set bit)
## TODO clear, and,or,flip (at index, all bits)
## TODO is there a way to merge the duplicate code?
namespace: bits8
  proc( -> bits8 ) =>: export: create
    0:i8 bits8 cast
  end
  proc( bits8 : data i32 : index -> bool ) =>: export: get
    data index bitarray._internal.get
  end
  proc( bool : value bits8 : data i32 : index -> bits8 ) =>: export: set
    value data index bitarray._internal.set
  end
  proc( bits8 : data -> bool ) =>: export: any
    data bitarray._internal.any
  end
  proc( bits8 : data -> bool ) =>: export: all
    data bitarray._internal.all
  end
  proc( bits8 -> bits8 ) : export: alias: not i8.flip
  proc( bits8 bits8 -> bits8 ) : export: alias: and i8.and
  proc( bits8 bits8 -> bits8 ) : export: alias: or  i8.or
  proc( bits8 bits8 -> bits8 ) : export: alias: xor i8.xor
end
