( i64 : static: bitCount -> type ) =>: bitarray
  bitCount 63:i64 + 63:i64 ~ & =:: blockCount ## round up to next multiple of 64
  i64 bitCount array
end
i8  =:: bits8
i16 =:: bits16
i32 =:: bits32
i64 =:: bits64
## TODO? bits128

namespace: bitarray._internal
  typeSet( bits8 bits16 bits32 bits64 ) =:: bitsN
  proc( bitsN : static: auto: bitsType
    bitsType : data
    i32 : index
  -> bool ) =>: get
    bitsType ..types.size 8 * =:: static: bitCount
    bitCount 32 <= if i32 else bitsType ..types.unwrapNamed end =:: intType
    1 intType cast.u index << =:: bitMask
    data intType cast.u bitMask & ?
  end
  proc( bitsN : static: auto: bitsType
    bool : value
    bitsType : data
    i32 : index
  -> bitsType ) =>: set
    bitsType ..types.size 8 * =:: static: bitCount
    bitCount 32 <= if i32 else bitsType ..types.unwrapNamed end =:: intType
    1 intType cast.u index << =:: bitMask
    data intType cast.u
      value if
          bitMask |
      else
          bitMask ~ &
      end
    bitsType cast.u
  end
  proc( bitsN : static: auto: bitsType
    bitsType : data
  -> bool ) =>: any
    bitsType ..types.unwrapNamed =:: intType
    data intType cast ?
  end
  proc( bitsN : static: auto: bitsType
    bitsType : data
  -> bool ) =>: all
    bitsType ..types.unwrapNamed =:: intType
    data intType cast ~ ? !
  end
end

