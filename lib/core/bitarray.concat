  proc( -> bits16 ) =>: export: create
    0:i16 bits16 cast
  end
  proc( bits16 : data i32 : index -> bool ) =>: export: get
    data index bitarray._internal.get
  end
  proc( bool : value bits16 : data i32 : index -> bits16 ) =>: export: set
    value data index bitarray._internal.set
  end
  proc( bits16 : data -> bool ) =>: export: any
