  proc( -> bits16 ) =>: export: create
    0:i16 bits16 cast
  end
  proc( bits16 : data i32 : index -> bool ) =>: export: get
    data index bitarray._internal.get
  end
  proc( bool : value bits16 : data i32 : index -> bits16 ) =>: export: set
    value data index bitarray._internal.set
  end
  proc( bits16 : data -> bool ) =>: export: any
    data bitarray._internal.any
  end
  proc( bits16 : data -> bool ) =>: export: all
    data bitarray._internal.all
  end
  proc( bits16 -> bits16 ) : export: alias: not i16.flip
  proc( bits16 bits16 -> bits16 ) : export: alias: and i16.and
  proc( bits16 bits16 -> bits16 ) : export: alias: or  i16.or
  proc( bits16 bits16 -> bits16 ) : export: alias: xor i16.xor
end
namespace: bits32
  proc( -> bits32 ) =>: export: create
    0:i32 bits32 cast
  end
  proc( bits32 : data i32 : index -> bool ) =>: export: get
    data index bitarray._internal.get
  end
  proc( bool : value bits32 : data i32 : index -> bits32 ) =>: export: set
    value data index bitarray._internal.set
  end
  proc( bits32 : data -> bool ) =>: export: any
    data bitarray._internal.any
  end
  proc( bits32 : data -> bool ) =>: export: all
    data bitarray._internal.all
  end
  proc( bits32 -> bits32 ) : export: alias: not i32.flip
  proc( bits32 bits32 -> bits32 ) : export: alias: and i32.and
  proc( bits32 bits32 -> bits32 ) : export: alias: or  i32.or
  proc( bits32 bits32 -> bits32 ) : export: alias: xor i32.xor
end
namespace: bits64
  proc( -> bits64 ) =>: export: create
    0:i64 bits64 cast
  end
  proc( bits64 : data i32 : index -> bool ) =>: export: get
    data index bitarray._internal.get
  end
  proc( bool : value bits64 : data i32 : index -> bits64 ) =>: export: set
    value data index bitarray._internal.set
  end
  proc( bits64 : data -> bool ) =>: export: any
    data bitarray._internal.any
  end
  proc( bits64 : data -> bool ) =>: export: all
    data bitarray._internal.all
  end
  proc( bits64 -> bits64 ) : export: alias: not i64.flip
  proc( bits64 bits64 -> bits64 ) : export: alias: and i64.and
  proc( bits64 bits64 -> bits64 ) : export: alias: or  i64.or
  proc( bits64 bits64 -> bits64 ) : export: alias: xor i64.xor
end
namespace: bitarray
  proc( i64 : static: bitCount -> bitCount bitarray ) =>: export: create
    bitCount bitarray new return ## create empty array
  end
  proc( i64 : static: auto: len
    len bitarray : data
    i64 : index
  -> bool ) =>: export: get
    len bitarray ..types.unwrapNamed =:: baseType
    index 63 & =:: bitIndex
    1:i64 bitIndex << =:: bitMask
    index 64 / =:: blockIndex
    data baseType cast blockIndex [] bitMask & ?
  end
  proc( i64 : static: auto: len
    bool : value
    len bitarray : data
    i64 : index
  -> len bitarray ) =>: export: set
    len bitarray ..types.unwrapNamed =:: baseType
    data baseType cast =:: mut: localData
    index 63 & =:: bitIndex
    1:i64 bitIndex << =:: bitMask
    index 64 / =:: blockIndex
    value if
      localData blockIndex []
        bitMask |
      localData@ blockIndex =[]
    else
      localData blockIndex []
        bitMask ~ &
      localData@ blockIndex =[]
    end
    localData len bitarray cast return
  end
  ## TODO any, all
  ## TODO not, and, or, xor
end
overload: ~ bits8.not bits16.not bits32.not bits64.not end
overload: & bits8.and bits16.and bits32.and bits64.and end
overload: | bits8.or  bits16.or  bits32.or  bits64.or  end
overload: ^ bits8.xor bits16.xor bits32.xor bits64.xor end
