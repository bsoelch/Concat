namespace: bits64
  proc( -> bits64 ) =>: export: create
    0:i64 bits64 cast
  end
  proc( bits64 : data i32 : index -> bool ) =>: export: get
    data index bitarray._internal.get
  end
  proc( bool : value bits64 : data i32 : index -> bits64 ) =>: export: set
    value data index bitarray._internal.set
  end
  proc( bits64 : data -> bool ) =>: export: any
    data bitarray._internal.any
  end
  proc( bits64 : data -> bool ) =>: export: all
    data bitarray._internal.all
  end
end
namespace: bitarray
  proc( i64 : static: bitCount -> bitCount bitarray ) =>: export: create
    bitCount bitarray new return ## create empty array
  end
  proc( i64 : static: auto: len
    len bitarray : data
    i64 : index
  -> bool ) =>: export: get
    len bitarray ..types.unwrapNamed =:: baseType
    index 63 & =:: bitIndex
    1:i64 bitIndex << =:: bitMask
    index 64 / =:: blockIndex
    data baseType cast blockIndex [] bitMask & ?
  end
  proc( i64 : static: auto: len
    bool : value
    len bitarray : data
    i64 : index
  -> len bitarray ) =>: export: set
    len bitarray ..types.unwrapNamed =:: baseType
    data baseType cast =:: mut: localData
    index 63 & =:: bitIndex
    1:i64 bitIndex << =:: bitMask
    index 64 / =:: blockIndex
    value if
      localData blockIndex []
        bitMask |
      localData@ blockIndex =[]
    else
      localData blockIndex []
        bitMask ~ &
      localData@ blockIndex =[]
    end
    localData len bitarray cast return
  end
  ## TODO any, all
end
