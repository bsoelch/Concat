namespace: bits8
  proc( -> bits8 ) =>: export: create
    0:i8 bits8 cast
  end
  proc( bits8 : data i32 : index -> bool ) =>: export: get
    data index bitarray._internal.get
  end
  proc( bool : value bits8 : data i32 : index -> bits8 ) =>: export: set
    value data index bitarray._internal.set
  end
  proc( bits8 : data -> bool ) =>: export: any
    data bitarray._internal.any
  end
  proc( bits8 : data -> bool ) =>: export: all
    data bitarray._internal.all
  end
end
