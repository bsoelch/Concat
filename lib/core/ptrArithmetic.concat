
namespace: ptr
  proc( type : auto: T T _ ptr : p T _ ptr : q -> i32 ) =>: export: cmp
    p i64 cast! q i64 cast! i64.ucmp
  end
  proc( type : auto: T T _ ptr : p T _ ptr : q -> bool ) =>: export: lt
    p i64 cast! q i64 cast! i64.ult
  end
  proc( type : auto: T T _ ptr : p T _ ptr : q -> bool ) =>: export: le
    p i64 cast! q i64 cast! i64.ule
  end
  proc( type : auto: T T _ ptr : p T _ ptr : q -> bool ) =>: export: eq
    p i64 cast! q i64 cast! i64.eq
  end
  proc( type : auto: T T _ ptr : p T _ ptr : q -> bool ) =>: export: ne
    p i64 cast! q i64 cast! i64.ne
  end
  proc( type : auto: T T _ ptr : p T _ ptr : q -> bool ) =>: export: ge
    p i64 cast! q i64 cast! i64.uge
  end
  proc( type : auto: T T _ ptr : p T _ ptr : q -> bool ) =>: export: gt
    p i64 cast! q i64 cast! i64.ugt
  end

  proc( type : auto: T T _ ptr : p i64 : offset -> T _ ptr ) =>: export: add
    p i64 cast! offset T ..type.size * + T _ ptr cast!
  end
  proc( type : auto: T T _ ptr : p i64 : offset -> T _ ptr ) =>: export: sub
    p i64 cast! offset T ..type.size * - T _ ptr cast!
  end
  proc( type : auto: T T _ ptr : p T _ ptr : q -> i64 ) =>: export: diff
    p i64 cast! q i64 cast! - T ..type.size ..udiv
  end

  proc( type : auto: T T ptr T ptr -> i32 ) =>: cmp0D
    ..compiler.error "comparisson of value pointers is not supported"
    ..compiler.info "to use comparison operators on value pointers cast to raw pointers first"
    ..unreachable
  end
  proc( type : auto: T T ptr : p T ptr : q -> bool ) =>: lt0D
    ..compiler.error "comparisson of value pointers is not supported"
    ..compiler.info "to use comparison operators on value pointers cast to raw pointers first"
    ..unreachable
  end
  proc( type : auto: T T ptr : p T ptr : q -> bool ) =>: le0D
    ..compiler.error "comparisson of value pointers is not supported"
    ..compiler.info "to use comparison operators on value pointers cast to raw pointers first"
    ..unreachable
  end
  proc( type : auto: T T ptr : p T ptr : q -> bool ) =>: ge0D
    ..compiler.error "comparisson of value pointers is not supported"
    ..compiler.info "to use comparison operators on value pointers cast to raw pointers first"
    ..unreachable
  end
  proc( type : auto: T T ptr : p T ptr : q -> bool ) =>: gt0D
    ..compiler.error "comparisson of value pointers is not supported"
    ..compiler.info "to use comparison operators on value pointers cast to raw pointers first"
    ..unreachable
  end

  proc( type : auto: T T ptr : p i64 : offset -> T ptr ) =>: add0D
    ..compiler.error "pointer arithmetic on value pointers is not supported"
    ..unreachable
  end
  proc( type : auto: T T ptr : p i64 : offset -> T ptr ) =>: sub0D
    ..compiler.error "pointer arithmetic on value pointers is not supported"
    ..unreachable
  end
  proc( type : auto: T T ptr : p T ptr : q -> i64 ) =>: diff0D
    ..compiler.error "pointer arithmetic on value pointers is not supported"
    ..unreachable
  end
  ## XXX? prohibit arithmetic on array pointers
  namespace: mut
    proc( type : auto: T T _ ptr.mut : p i64 : offset -> T _ ptr.mut ) =>: shaddow: export: add
      p i64 cast! offset T ..type.size * + T _ ptr.mut cast!
    end
    proc( type : auto: T T _ ptr.mut : p i64 : offset -> T _ ptr.mut ) =>: shaddow: export: sub
      p i64 cast! offset T ..type.size * - T _ ptr.mut cast!
    end
    proc( type : auto: T T ptr.mut : p i64 : offset -> T ptr.mut ) =>: shaddow: add0D
      ..compiler.error "pointer arithmetic of value pointers is not supported"
      ..unreachable
    end
    proc( type : auto: T T ptr.mut : p i64 : offset -> T ptr.mut ) =>: shaddow: sub0D
      ..compiler.error "pointer arithmetic of value pointers is not supported"
      ..unreachable
    end
  end
end
overload: export: +
  ptr.add
  ptr.add0D
  ptr.mut.add
  ptr.mut.add0D
end
overload: export: -
  ptr.sub
  ptr.sub0D
  ptr.mut.sub
  ptr.mut.sub0D
  ptr.diff
  ptr.diff0D
end
overload: export: <
  ptr.lt
  ptr.lt0D
end
overload: export: <=
  ptr.le
  ptr.le0D
end
overload: export: ==
  ptr.eq
end
overload: export: !=
  ptr.ne
end
overload: export: >=
  ptr.ge
  ptr.ge0D
end
overload: export: >
  ptr.gt
  ptr.gt0D
end
overload: export: <=>
  ptr.cmp
  ptr.cmp0D
end
