import core/f16
import core/f32
import core/f64
import core/f128
namespace: number
  overload: export: isFinite
    f16.isFinite
    f32.isFinite
    f64.isFinite
    f128.isFinite
  end
  overload: export: isNaN
    f16.isNaN
    f32.isNaN
    f64.isNaN
    f128.isNaN
  end
  overload: export: exponent
    f16.exponent
    f32.exponent
    f64.exponent
    f128.exponent
  end
  overload: export: floor
    f16.floor
    f32.floor
    f64.floor
    f128.floor
  end
  overload: export: round
    f16.round
    f32.round
    f64.round
    f128.round
  end
end
