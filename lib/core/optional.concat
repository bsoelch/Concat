"type" *import

( type : V -> type ) =>: export: optional
  V type.isPointerValue if
    ( V : val )
  else
    union( _ : None V : Some )
  end
end
namespace: optional
  0:iSize =:: NULL_PTR
  proc( type : V -> V optional ) =>: emptyV
    V optional .None return
  end
  proc( type.pointerValue : V -> V optional ) =>: emptyP
    NULL_PTR V cast! V optional new
  end
  overload: export: empty emptyV emptyP end
  proc( type : auto: V  V -> V optional ) =>: wrapV
    V optional .Some return
  end
  proc( type.pointerValue : auto: V  V -> V optional ) =>: wrapP
    V optional new return
  end
  overload: export: wrap wrapV wrapP end

  proc( type : auto: V V optional -> bool ) =>: isEmptyV
    .None ? return
  end
  proc( type.pointerValue : auto: V V optional -> bool ) =>: isEmptyP
    .val iSize cast! NULL_PTR ==
  end
  overload: export: isEmpty isEmptyV isEmptyP end
  proc( type : auto: V  V optional -> bool ) =>: hasDataV
    .Some ? return
  end
  proc( type.pointerValue : auto: V  V optional -> bool ) =>: hasDataP
    .val iSize cast! NULL_PTR !=
  end
  overload: export: hasData hasDataV hasDataP end
  proc( type : auto: T  T optional -> T ) =>: getV
    ..raw .Some
  end
  proc( type.pointerValue : auto: T  T optional -> T ) =>: getP
    .val
  end
  overload: export: get getV getP end
  proc( type : auto: T  T optional -> T ) =>: export: unwrapV
    .Some .else
      "unwrap of empty optional" ..panic
    end
  end
  proc( type.pointerValue : auto: T  T optional -> T ) =>: export: unwrapP
    .val $ iSize cast! NULL_PTR == if
      "unwrap of empty optional" ..panic
    end
  end
  overload: export: unwrap unwrapV unwrapP end
  proc( type : auto: T T optional optional -> T optional ) =>: export: flat
    .else T optional.empty end
  end

  proc( type : auto: T  T optional -> T optional ) =>: prepareIf end
  proc( type : auto: T  T optional : ignore -> ) =>: elseVal end

  ## optional with inverted boolean conversion
  ( type : V -> type ) =>: export: inv
    V optional
  end
  proc( type : auto: T  T optional -> T optional.inv ) =>: export: invert T optional.inv cast end
  namespace: inv
    proc( type : auto: T  T optional.inv -> T optional ) =>: export: shadow: invert T optional cast end
    proc( type : auto: T  T optional.inv -> T ) =>: export: shadow: get T optional cast optional.get end
    proc( type : auto: T  T optional.inv -> bool ) =>: export: shadow: hasData T optional cast optional.hasData end
    proc( type : auto: T  T optional.inv -> bool ) =>: export: shadow: isEmpty T optional cast optional.isEmpty end
    proc( type : auto: T  T optional.inv -> T optional.inv ) =>: shadow: prepareIf
      T optional cast optional.prepareIf T optional.inv cast
    end
    proc( type : auto: T  T optional.inv -> ) =>: shadow: ifVal T optional cast optional.elseVal end
  end
end

overload: export: <unwrap>
  optional.unwrap
end
overload: export: !
  optional.invert
  optional.inv.invert
end
overload: export: ?
  optional.hasData
  optional.inv.isEmpty
end
overload: export: ..if.prepare
  optional.prepareIf
  optional.inv.prepareIf
end
overload: export: ..if.check
  optional.hasData
  optional.inv.isEmpty
end
overload: export: ..if.ifVal
  optional.get
  optional.inv.ifVal
end
overload: export: ..if.elseVal
  optional.elseVal
  optional.inv.get
end
