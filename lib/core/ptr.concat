import core/i64
import core/type
namespace: ptr
  proc( type : auto: T iSize : auto: k T k ptr : _ -> iSize ) =>: export: length
    k
  end
  proc( type : auto: T T ptr.raw : p -> T ) =>: export: get
    p ..builtIn.get.ptr
  end
  proc( type : auto: T T : newVal T ptr.raw.mut : p -> ) =>: export: set
    newVal p ..builtIn.set.ptr
  end

  proc( type : auto: T T ptr.raw : p iSize : index -> T ptr.raw ) =>: export: at
    p index ..type.iSize cast ..builtIn.offset.ptr
  end
  proc( type : auto: T T ptr.raw : p i32 : index -> T ptr.raw ) =>: export: at32
    p index ..builtIn.offset.ptr.i32
  end
  proc( type : auto: T T ptr.raw : p i64 : index -> T ptr.raw ) =>: export: at64
    p index ..builtIn.offset.ptr.i64
  end
  proc( type : auto: T T ptr.raw : p iSize : index -> T ) =>: export: getOffset
    p index ..type.iSize cast ..builtIn.offset.ptr ..builtIn.get.ptr
  end
  proc( type : auto: T T ptr.raw : p i32 : index -> T ) =>: export: get32
    p index ..builtIn.offset.ptr.i32 ..builtIn.get.ptr
  end
  proc( type : auto: T T ptr.raw : p i64 : index -> T ) =>: export: get64
    p index ..builtIn.offset.ptr.i64 ..builtIn.get.ptr
  end
  proc( type : auto: T T : newVal T ptr.raw.mut : p iSize : index -> ) =>: export: setOffset
    newVal p index ..type.iSize cast ..builtIn.offset.ptr.mut ..builtIn.set.ptr
  end
  proc( type : auto: T T : newVal T ptr.raw.mut : p i32 : index -> ) =>: export: set32
    newVal p index ..builtIn.offset.ptr.mut.i32 ..builtIn.set.ptr
  end
  proc( type : auto: T T : newVal T ptr.raw.mut : p i64 : index -> ) =>: export: set64
    newVal p index ..builtIn.offset.ptr.mut.i64 ..builtIn.set.ptr
  end

  proc( iSize : index iSize : size -> ) =>: checkIndex
    index size u>= if "pointer index outside allowed range" ..panic end
    ## TODO better error message (print actual index)
    ## TODO? is it possible print message at call-position of pointer access
  end
  proc(
    type : auto: T iSize : auto: k
    T k ptr : p
    iSize : index
  -> T ptr ) =>: export: atChecked
    index k checkIndex
    p index ..type.iSize cast ..builtIn.offset.ptr T ptr cast!
  end
  proc(
    type : auto: T iSize : auto: k
    T k ptr : p
    i32 : index
  -> T ptr ) =>: export: at32checked
    index iSize cast.u k checkIndex
    p index ..builtIn.offset.ptr.i32 T ptr cast!
  end
  proc(
    type : auto: T iSize : auto: k
    T k ptr : p
    i64 : index
  -> T ptr ) =>: export: at64checked
    index iSize cast.u k checkIndex
    p index ..builtIn.offset.ptr.i64 T ptr cast!
  end
  proc(
    type : auto: T iSize : auto: k
    T k ptr : p
    iSize : index
  -> T ) =>: export: getChecked
    index iSize cast.u k checkIndex
    p index ..type.iSize cast ..builtIn.offset.ptr ..builtIn.get.ptr
  end
  proc(
    type : auto: T iSize : auto: k
    T k ptr : p
    i32 : index
  -> T ) =>: export: get32checked
    index iSize cast.u k checkIndex
    p index ..builtIn.offset.ptr.i32 ..builtIn.get.ptr
  end
  proc(
    type : auto: T iSize : auto: k
    T k ptr : p
    i64 : index
  -> T ) =>: export: get64checked
    index iSize cast.u k checkIndex
    p index ..builtIn.offset.ptr.i64 ..builtIn.get.ptr
  end
  proc(
    type : auto: T iSize : auto: k
    T k array : p
    iSize : index
  -> T ) =>: export: getArray
    index k checkIndex
    p@ index ..type.iSize cast ..builtIn.offset.ptr ..builtIn.get.ptr
  end
  proc(
    type : auto: T iSize : auto: k
    T k array : p
    i32 : index
  -> T ) =>: export: getArray32
    index iSize cast.u k checkIndex
    p =:: t ## TODO use address of p once taking address to generic ptr-arg is supported
    t@ index ..builtIn.offset.ptr.i32 ..builtIn.get.ptr
  end
  proc(
    type : auto: T iSize : auto: k
    T k array : p
    i64 : index
  -> T ) =>: export: getArray64
    index iSize cast.u k checkIndex
    p =:: t
    t@ index ..builtIn.offset.ptr.i64 ..builtIn.get.ptr
  end
  proc(
    type : auto: T iSize : auto: k
    T : newVal
    T k ptr.mut : p
    iSize : index
  -> ) =>: export: setChecked
    index k checkIndex
    newVal p index ..type.iSize cast ..builtIn.offset.ptr.mut ..builtIn.set.ptr
  end
  proc(
    type : auto: T iSize : auto: k
    T : newVal
    T k ptr.mut : p
    i32 : index
  -> ) =>: export: set32checked
    index iSize cast.u k checkIndex
    newVal p index ..builtIn.offset.ptr.mut.i32 ..builtIn.set.ptr
  end
  proc(
    type : auto: T iSize : auto: k
    T : newVal
    T k ptr.mut : p
    i64 : index
  -> ) =>: export: set64checked
    index iSize cast.u k checkIndex
    newVal p index ..builtIn.offset.ptr.mut.i64 ..builtIn.set.ptr
  end

  proc( type : auto: T T ptr.raw : p T ptr.raw : q -> i32 ) =>: export: cmp
    p iSize cast! q iSize cast! iSize.cmp
  end
  proc( type : auto: T T ptr.raw : p T ptr.raw : q -> bool ) =>: export: lt
    p iSize cast! q iSize cast! iSize.lt
  end
  proc( type : auto: T T ptr.raw : p T ptr.raw : q -> bool ) =>: export: le
    p iSize cast! q iSize cast! iSize.le
  end
  proc( type.pointer : auto: P  P : p P : q -> bool ) =>: export: eq
    p iSize cast! q iSize cast! iSize.eq
  end
  proc( type.pointer : auto: P  P : p P : q -> bool ) =>: export: ne
    p iSize cast! q iSize cast! iSize.ne
  end
  proc( type : auto: T T ptr.raw : p T ptr.raw : q -> bool ) =>: export: ge
    p iSize cast! q iSize cast! iSize.ge
  end
  proc( type : auto: T T ptr.raw : p T ptr.raw : q -> bool ) =>: export: gt
    p iSize cast! q iSize cast! iSize.gt
  end

  proc( type : auto: T T ptr.raw : p T ptr.raw : q -> iSize ) =>: export: diff
    p iSize cast! q iSize cast! - T ..types.stride u/
  end

  proc( type : auto: T T ptr T ptr -> i32 ) =>: cmp0D
    "comparisson of fixed-size pointers is not supported" ..compiler.error
    "to use comparison operators cast to raw pointers first" ..compiler.info
    ..unreachable
  end
  proc( type : auto: T T ptr : p T ptr : q -> bool ) =>: lt0D
    "comparisson of fixed-size pointers is not supported" ..compiler.error
    "to use comparison operators cast to raw pointers first" ..compiler.info
    ..unreachable
  end
  proc( type : auto: T T ptr : p T ptr : q -> bool ) =>: le0D
    "comparisson of fixed-size pointers is not supported" ..compiler.error
    "to use comparison operators cast to raw pointers first" ..compiler.info
    ..unreachable
  end
  proc( type : auto: T T ptr : p T ptr : q -> bool ) =>: ge0D
    "comparisson of fixed-size pointers is not supported" ..compiler.error
    "to use comparison operators cast to raw pointers first" ..compiler.info
    ..unreachable
  end
  proc( type : auto: T T ptr : p T ptr : q -> bool ) =>: gt0D
    "comparisson of fixed-size pointers is not supported" ..compiler.error
    "to use comparison operators cast to raw pointers first" ..compiler.info
    ..unreachable
  end

  ## XXX? prohibit arithmetic on array pointers
  namespace: mut
    proc( type : auto: T T ptr.raw.mut : p -> T ) =>: shadow: export: get
      p ..builtIn.get.ptr.mut
    end

    proc( type : auto: T T ptr.raw.mut : p iSize : offset -> T ptr.raw.mut ) =>: shadow: export: at
      p offset ..type.iSize cast ..builtIn.offset.ptr.mut
    end
    proc( type : auto: T T ptr.raw.mut : p i32 : offset -> T ptr.raw.mut ) =>: shadow: export: at32
      p offset ..builtIn.offset.ptr.mut.i32
    end
    proc( type : auto: T T ptr.raw.mut : p i64 : offset -> T ptr.raw.mut ) =>: shadow: export: at64
      p offset ..builtIn.offset.ptr.mut.i64
    end
    proc(
      type : auto: T iSize : auto: k
      T k ptr.mut : p
      iSize : index
    -> T ptr.mut ) =>: shadow: export: atChecked
      index k checkIndex
      p index ..type.iSize cast ..builtIn.offset.ptr.mut T ptr.mut cast!
    end
    proc(
      type : auto: T iSize : auto: k
      T k ptr.mut : p
      i32 : index
    -> T ptr.mut ) =>: shadow: export: at32checked
      index iSize cast.u k checkIndex
      p index ..builtIn.offset.ptr.mut.i32 T ptr.mut cast!
    end
    proc(
      type : auto: T iSize : auto: k
      T k ptr.mut : p
      i64 : index
    -> T ptr.mut ) =>: shadow: export: at64checked
      index iSize cast.u k checkIndex
      p index ..builtIn.offset.ptr.mut.i64 T ptr.mut cast!
    end
  end
end
namespace: iSize
  ( iSize : a iSize : b -> iSize ) =>: export: add
    a ..type.iSize cast b ..type.iSize cast + iSize cast
  end
  ( iSize : a iSize : b -> iSize ) =>: export: sub
    a ..type.iSize cast b ..type.iSize cast - iSize cast
  end
  ( iSize : a -> iSize ) =>: export: neg
    a ..type.iSize cast -_ iSize cast
  end
  ( iSize : a iSize : b -> iSize ) =>: export: mul
    a ..type.iSize cast b ..type.iSize cast * iSize cast
  end
  ( iSize : a iSize : b -> iSize ) =>: export: div
    a ..type.iSize cast b ..type.iSize cast u/ iSize cast
  end
  ( iSize : a iSize : b -> iSize ) =>: export: shr
    a ..type.iSize cast b ..type.iSize cast >>> iSize cast
  end
  ( iSize : a i32 : shift -> iSize ) =>: export: shrI32
    a ..type.iSize cast shift >>> iSize cast
  end
  ( iSize : a iSize : b -> iSize ) =>: export: shl
    a ..type.iSize cast b ..type.iSize cast << iSize cast
  end
  ( iSize : a i32 : shift -> iSize ) =>: export: shlI32
    a ..type.iSize cast shift << iSize cast
  end
  ( iSize : a iSize : b -> iSize ) =>: export: mod
    a ..type.iSize cast b ..type.iSize cast u% iSize cast
  end
  ( iSize : a iSize : b -> bool ) =>: export: lt
    a ..type.iSize cast b ..type.iSize cast u<
  end
  ( iSize : a iSize : b -> bool ) =>: export: le
    a ..type.iSize cast b ..type.iSize cast u<=
  end
  ( iSize : a iSize : b -> bool ) =>: export: eq
    a ..type.iSize cast b ..type.iSize cast ==
  end
  ( iSize : a iSize : b -> bool ) =>: export: ne
    a ..type.iSize cast b ..type.iSize cast !=
  end
  ( iSize : a iSize : b -> bool ) =>: export: ge
    a ..type.iSize cast b ..type.iSize cast u>=
  end
  ( iSize : a iSize : b -> bool ) =>: export: gt
    a ..type.iSize cast b ..type.iSize cast u>
  end
  ( iSize : a iSize : b -> bool ) =>: export: slt
    a ..type.iSize cast b ..type.iSize cast <
  end
  ( iSize : a iSize : b -> bool ) =>: export: sle
    a ..type.iSize cast b ..type.iSize cast <=
  end
  ( iSize : a iSize : b -> bool ) =>: export: sge
    a ..type.iSize cast b ..type.iSize cast >=
  end
  ( iSize : a iSize : b -> bool ) =>: export: sgt
    a ..type.iSize cast b ..type.iSize cast >
  end
  ( iSize : a iSize : b -> i32 ) =>: export: cmp
    a ..type.iSize cast b ..type.iSize cast u> ?1
    a ..type.iSize cast b ..type.iSize cast u< ?1 -
  end
  ( iSize : a iSize : b -> iSize ) =>: export: min
    a b u< if a else b end
  end
  ( iSize : a iSize : b -> iSize ) =>: export: max
    a b u> if a else b end
  end
end

overload: export: []
  ptr.get
  ptr.getOffset
  ptr.get32
  ptr.get64
  ptr.getArray
  ptr.getArray32
  ptr.getArray64
  ptr.getChecked
  ptr.get32checked
  ptr.get64checked
end
overload: export: =[]
  ptr.set
  ptr.setOffset
  ptr.set32
  ptr.set64
  ptr.setChecked
  ptr.set32checked
  ptr.set64checked
end
overload: export: @[]
  ptr.at
  ptr.at32
  ptr.at64
  ptr.mut.at
  ptr.mut.at32
  ptr.mut.at64
  ptr.atChecked
  ptr.at32checked
  ptr.at64checked
  ptr.mut.atChecked
  ptr.mut.at32checked
  ptr.mut.at64checked
end

overload: export: +
  iSize.add
end
overload: export: -
  iSize.sub
end
overload: export: -_
  iSize.neg
end
overload: export: *
  iSize.mul
end
overload: export: /
  iSize.div
end
overload: export: u/
  iSize.div
end
overload: export: %
  iSize.mod
end
overload: export: u%
  iSize.mod
end
overload: export: >>>
  iSize.shr
  iSize.shrI32
end
overload: export: <<
  iSize.shl
  iSize.shlI32
end
overload: export: <
  ptr.lt
  ptr.lt0D
end
overload: export: <=
  ptr.le
  ptr.le0D
end
overload: export: ==
  ptr.eq
  iSize.eq
end
overload: export: !=
  ptr.ne
  iSize.ne
end
overload: export: >=
  ptr.ge
  ptr.ge0D
end
overload: export: >
  ptr.gt
  ptr.gt0D
end
overload: export: <=>
  ptr.cmp
  ptr.cmp0D
end
overload: export: u<
  ptr.lt
  ptr.lt0D
  iSize.lt
end
overload: export: u<=
  ptr.le
  ptr.le0D
  iSize.le
end
overload: export: u>=
  ptr.ge
  ptr.ge0D
  iSize.ge
end
overload: export: u>
  ptr.gt
  ptr.gt0D
  iSize.gt
end
