import core/i64
import core/type
namespace: ptr
  proc( type : auto: T iSize : auto: k T k ptr : _ -> iSize ) =>: export: length
    k
  end
  proc( type : auto: T T ptr.raw : p -> T ) =>: export: get
    p ..builtIn.get.ptr
  end
  proc( type : auto: T T : newVal T ptr.raw.mut : p -> ) =>: export: set
    newVal p ..builtIn.set.ptr
  end

  proc( type : auto: T T ptr.raw : p iSize : index -> T ptr.raw ) =>: export: at
    p index ..compiler.version 602 < if ..type.iSize cast end ..builtIn.offset.ptr
  end
  proc( type : auto: T T ptr.raw : p i32 : index -> T ptr.raw ) =>: export: at32
    p index iSize cast at
  end
  proc( type : auto: T T ptr.raw : p i64 : index -> T ptr.raw ) =>: export: at64
    p index iSize cast at
  end
  proc( type : auto: T T ptr.raw : p iSize : index -> T ) =>: export: getOffset
    p index ..compiler.version 602 < if ..type.iSize cast end ..builtIn.offset.ptr ..builtIn.get.ptr
  end
  proc( type : auto: T T ptr.raw : p i32 : index -> T ) =>: export: get32
    p index iSize cast getOffset
  end
  proc( type : auto: T T ptr.raw : p i64 : index -> T ) =>: export: get64
    p index iSize cast getOffset
  end
  proc( type : auto: T T : newVal T ptr.raw.mut : p iSize : index -> ) =>: export: setOffset
    newVal p index ..compiler.version 602 < if ..type.iSize cast end ..builtIn.offset.ptr.mut ..builtIn.set.ptr
  end
  proc( type : auto: T T : newVal T ptr.raw.mut : p i32 : index -> ) =>: export: set32
    newVal p index iSize cast.u setOffset
  end
  proc( type : auto: T T : newVal T ptr.raw.mut : p i64 : index -> ) =>: export: set64
    newVal p index iSize cast.u setOffset
  end

  proc( iSize : index iSize : size -> ) =>: checkIndex
    index size u>= if "pointer index outside allowed range" ..panic end
    ## TODO better error message (print actual index)
    ## TODO? is it possible print message at call-position of pointer access
  end
  proc(
    type : auto: T iSize : auto: k
    T k ptr : p
    iSize : index
  -> T ptr ) =>: export: atChecked
    index k checkIndex
    p index ..compiler.version 602 < if ..type.iSize cast end ..builtIn.offset.ptr T ptr cast!
  end
  proc(
    type : auto: T iSize : auto: k
    T k ptr : p
    i32 : index
  -> T ptr ) =>: export: at32checked
    p index iSize cast.u atChecked
  end
  proc(
    type : auto: T iSize : auto: k
    T k ptr : p
    i64 : index
  -> T ptr ) =>: export: at64checked
    p index iSize cast.u atChecked
  end
  proc(
    type : auto: T iSize : auto: k
    T k ptr : p
    iSize : index
  -> T ) =>: export: getChecked
    index iSize cast.u k checkIndex
    p index ..compiler.version 602 < if ..type.iSize cast end ..builtIn.offset.ptr ..builtIn.get.ptr
  end
  proc(
    type : auto: T iSize : auto: k
    T k ptr : p
    i32 : index
  -> T ) =>: export: get32checked
    p index iSize cast.u getChecked
  end
  proc(
    type : auto: T iSize : auto: k
    T k ptr : p
    i64 : index
  -> T ) =>: export: get64checked
    p index iSize cast.u getChecked
  end
  proc(
    type : auto: T iSize : auto: k
    T k array : p
    iSize : index
  -> T ) =>: export: getArray
    index k checkIndex
    p@ index ..compiler.version 602 < if ..type.iSize cast end ..builtIn.offset.ptr ..builtIn.get.ptr
  end
  proc(
    type : auto: T iSize : auto: k
    T k array : p
    i32 : index
  -> T ) =>: export: getArray32
    p index iSize cast.u getArray
  end
  proc(
    type : auto: T iSize : auto: k
    T k array : p
    i64 : index
  -> T ) =>: export: getArray64
    p index iSize cast.u getArray
  end
  proc(
    type : auto: T iSize : auto: k
    T : newVal
    T k ptr.mut : p
    iSize : index
  -> ) =>: export: setChecked
    index k checkIndex
    newVal p index ..compiler.version 602 < if ..type.iSize cast end ..builtIn.offset.ptr.mut ..builtIn.set.ptr
  end
  proc(
    type : auto: T iSize : auto: k
    T : newVal
    T k ptr.mut : p
    i32 : index
  -> ) =>: export: set32checked
    newVal p index iSize cast.u setChecked
  end
  proc(
    type : auto: T iSize : auto: k
    T : newVal
    T k ptr.mut : p
    i64 : index
  -> ) =>: export: set64checked
    newVal p index iSize cast.u setChecked
  end

  proc( type : auto: T T ptr.raw : p T ptr.raw : q -> i32 ) =>: export: cmp
    p iSize cast! q iSize cast! iSize.cmp
  end
  proc( type : auto: T T ptr.raw : p T ptr.raw : q -> bool ) =>: export: lt
    p iSize cast! q iSize cast! iSize.lt
  end
  proc( type : auto: T T ptr.raw : p T ptr.raw : q -> bool ) =>: export: le
    p iSize cast! q iSize cast! iSize.le
  end
  proc( type.namedPointer : auto: P  P : p P : q -> bool ) =>: export: eq
    p iSize cast! q iSize cast! iSize.eq
  end
  proc( type.namedPointer : auto: P  P : p P : q -> bool ) =>: export: ne
    p iSize cast! q iSize cast! iSize.ne
  end
  proc( type : auto: T T ptr : p T ptr : q -> bool ) =>: eq0
    p iSize cast! q iSize cast! iSize.eq ## proc-pointer cannot be cast to raw-pointer -> need separate version
  end
  proc( type : auto: T T ptr.raw : p T ptr.raw : q -> bool ) =>: eqRaw
    p iSize cast! q iSize cast! iSize.eq
  end
  proc( type : auto: T T ptr : p T ptr : q -> bool ) =>: ne0
    p iSize cast! q iSize cast! iSize.ne
  end
  proc( type : auto: T T ptr.raw : p T ptr.raw : q -> bool ) =>: neRaw
    p iSize cast! q iSize cast! iSize.ne
  end
  proc( type : auto: T T ptr.raw : p T ptr.raw : q -> bool ) =>: export: ge
    p iSize cast! q iSize cast! iSize.ge
  end
  proc( type : auto: T T ptr.raw : p T ptr.raw : q -> bool ) =>: export: gt
    p iSize cast! q iSize cast! iSize.gt
  end

  proc( type : auto: T T ptr.raw : p T ptr.raw : q -> iSize ) =>: export: diff
    p iSize cast! q iSize cast! - T ..types.stride u/
  end

  proc( type : auto: T T ptr T ptr -> i32 ) =>: cmp0D
    "comparisson of fixed-size pointers is not supported" ..compiler.error
    "to use comparison operators cast to raw pointers first" ..compiler.info
    ..unreachable
  end
  proc( type : auto: T T ptr : p T ptr : q -> bool ) =>: lt0D
    "comparisson of fixed-size pointers is not supported" ..compiler.error
    "to use comparison operators cast to raw pointers first" ..compiler.info
    ..unreachable
  end
  proc( type : auto: T T ptr : p T ptr : q -> bool ) =>: le0D
    "comparisson of fixed-size pointers is not supported" ..compiler.error
    "to use comparison operators cast to raw pointers first" ..compiler.info
    ..unreachable
  end
  proc( type : auto: T T ptr : p T ptr : q -> bool ) =>: ge0D
    "comparisson of fixed-size pointers is not supported" ..compiler.error
    "to use comparison operators cast to raw pointers first" ..compiler.info
    ..unreachable
  end
  proc( type : auto: T T ptr : p T ptr : q -> bool ) =>: gt0D
    "comparisson of fixed-size pointers is not supported" ..compiler.error
    "to use comparison operators cast to raw pointers first" ..compiler.info
    ..unreachable
  end

  ## TODO? prohibit arithmetic on array pointers
  namespace: mut
    proc( type : auto: T T ptr.raw.mut : p -> T ) =>: shadow: export: get
      p ..builtIn.get.ptr
    end

    proc( type : auto: T T ptr.raw.mut : p iSize : offset -> T ptr.raw.mut ) =>: shadow: export: at
      p offset ..compiler.version 602 < if ..type.iSize cast end ..builtIn.offset.ptr.mut
    end
    proc( type : auto: T T ptr.raw.mut : p i32 : offset -> T ptr.raw.mut ) =>: shadow: export: at32
      p offset iSize cast.u at
    end
    proc( type : auto: T T ptr.raw.mut : p i64 : offset -> T ptr.raw.mut ) =>: shadow: export: at64
      p offset iSize cast.u at
    end
    proc(
      type : auto: T iSize : auto: k
      T k ptr.mut : p
      iSize : index
    -> T ptr.mut ) =>: shadow: export: atChecked
      index k checkIndex
      p index ..compiler.version 602 < if ..type.iSize cast end ..builtIn.offset.ptr.mut T ptr.mut cast!
    end
    proc(
      type : auto: T iSize : auto: k
      T k ptr.mut : p
      i32 : index
    -> T ptr.mut ) =>: shadow: export: at32checked
      p index iSize cast.u atChecked
    end
    proc(
      type : auto: T iSize : auto: k
      T k ptr.mut : p
      i64 : index
    -> T ptr.mut ) =>: shadow: export: at64checked
      p index iSize cast.u atChecked
    end
  end
end
namespace: iSize
  iSize ..types.unwrapNamed i64 == if
    ( char8 ptr.raw iSize -> iSize ) : static: export: alias: parse ..builtIn.parse.i64
    ( iSize : a iSize : b -> iSize ) : export: alias: add ..builtIn.add.i64
    ( iSize : a iSize : b -> iSize ) : export: alias: sub ..builtIn.sub.i64
    ( iSize : a -> iSize ) : export: alias: neg ..builtIn.neg.i64
    ( iSize : a iSize : b -> iSize ) : export: alias: mul ..builtIn.mul.i64
    ( iSize : a iSize : b -> iSize ) : export: alias: div ..builtIn.udiv.i64
    ( iSize : a iSize : b -> iSize ) : export: alias: mod ..builtIn.umod.i64
    ( iSize : a iSize : b -> iSize ) : export: alias: shr ..builtIn.lshr.i64
    ( iSize : a i32 : b -> iSize ) : export: alias: shrI32 ..builtIn.lshr.i64i32
    ( iSize : a iSize : b -> iSize ) : export: alias: shl ..builtIn.shl.i64
    ( iSize : a i32 : b -> iSize ) : export: alias: shlI32 ..builtIn.shl.i64i32
    ( iSize : a iSize : b -> iSize ) : export: alias: and ..builtIn.and.i64
    ( iSize : a iSize : b -> iSize ) : export: alias: or ..builtIn.or.i64
    ( iSize : a iSize : b -> iSize ) : export: alias: xor ..builtIn.xor.i64
    ( iSize : a iSize : b -> bool ) : export: alias: eq ..builtIn.eq.i64
    ( iSize : a iSize : b -> bool ) : export: alias: ne ..builtIn.ne.i64
    ( iSize : a iSize : b -> bool ) : export: alias: lt ..builtIn.ult.i64
    ( iSize : a iSize : b -> bool ) : export: alias: le ..builtIn.ule.i64
    ( iSize : a iSize : b -> bool ) : export: alias: ge ..builtIn.uge.i64
    ( iSize : a iSize : b -> bool ) : export: alias: gt ..builtIn.ugt.i64
    ( iSize : a iSize : b -> bool ) : export: alias: slt ..builtIn.lt.i64
    ( iSize : a iSize : b -> bool ) : export: alias: sle ..builtIn.le.i64
    ( iSize : a iSize : b -> bool ) : export: alias: sge ..builtIn.ge.i64
    ( iSize : a iSize : b -> bool ) : export: alias: sgt ..builtIn.gt.i64
  else iSize ..types.unwrapNamed i32 == _if
    ( char8 ptr.raw iSize -> iSize ) : static: export: alias: parse ..builtIn.parse.i32
    ( iSize : a iSize : b -> iSize ) : export: alias: add ..builtIn.add.i32
    ( iSize : a iSize : b -> iSize ) : export: alias: sub ..builtIn.sub.i32
    ( iSize : a -> iSize ) : export: alias: neg ..builtIn.neg.i32
    ( iSize : a iSize : b -> iSize ) : export: alias: mul ..builtIn.mul.i32
    ( iSize : a iSize : b -> iSize ) : export: alias: div ..builtIn.udiv.i32
    ( iSize : a iSize : b -> iSize ) : export: alias: mod ..builtIn.umod.i32
    ( iSize : a iSize : b -> iSize ) : export: alias: shr ..builtIn.lshr.i32
    ( iSize : a i32 : b -> iSize ) : export: alias: shrI32 ..builtIn.lshr.i32
    ( iSize : a iSize : b -> iSize ) : export: alias: shl ..builtIn.shl.i32
    ( iSize : a i32 : b -> iSize ) : export: alias: shlI32 ..builtIn.shl.i32
    ( iSize : a iSize : b -> iSize ) : export: alias: and ..builtIn.and.i32
    ( iSize : a iSize : b -> iSize ) : export: alias: or ..builtIn.or.i32
    ( iSize : a iSize : b -> iSize ) : export: alias: xor ..builtIn.xor.i32
    ( iSize : a iSize : b -> bool ) : export: alias: eq ..builtIn.eq.i32
    ( iSize : a iSize : b -> bool ) : export: alias: ne ..builtIn.ne.i32
    ( iSize : a iSize : b -> bool ) : export: alias: lt ..builtIn.ult.i32
    ( iSize : a iSize : b -> bool ) : export: alias: le ..builtIn.ule.i32
    ( iSize : a iSize : b -> bool ) : export: alias: ge ..builtIn.uge.i32
    ( iSize : a iSize : b -> bool ) : export: alias: gt ..builtIn.ugt.i32
    ( iSize : a iSize : b -> bool ) : export: alias: slt ..builtIn.lt.i32
    ( iSize : a iSize : b -> bool ) : export: alias: sle ..builtIn.le.i32
    ( iSize : a iSize : b -> bool ) : export: alias: sge ..builtIn.ge.i32
    ( iSize : a iSize : b -> bool ) : export: alias: sgt ..builtIn.gt.i32
  else
    "iSize should be i64 or i32" ..panic
  end
  ( iSize -> bool ) =>: export: toBool
    0 !=
  end
  ( iSize : a iSize : b -> i32 ) =>: export: cmp
    a b u> ?1 a b u< ?1 -
  end
  ( iSize : a iSize : b -> iSize ) =>: export: min
    a b u< if a else b end
  end
  ( iSize : a iSize : b -> iSize ) =>: export: max
    a b u> if a else b end
  end
  ( iSize : a iSize : b -> iSize ) =>: export: smin
    a b slt if a else b end
  end
  ( iSize : a iSize : b -> iSize ) =>: export: smax
    a b sgt if a else b end
  end
end
( char8 ptr.raw iSize -> iSize ) : static: alias: export: :iSize iSize.parse

overload: export: []
  ptr.get
  ptr.getOffset
  ptr.get32
  ptr.get64
  ptr.getArray
  ptr.getArray32
  ptr.getArray64
  ptr.getChecked
  ptr.get32checked
  ptr.get64checked
end
overload: export: =[]
  ptr.set
  ptr.setOffset
  ptr.set32
  ptr.set64
  ptr.setChecked
  ptr.set32checked
  ptr.set64checked
end
overload: export: @[]
  ptr.at
  ptr.at32
  ptr.at64
  ptr.mut.at
  ptr.mut.at32
  ptr.mut.at64
  ptr.atChecked
  ptr.at32checked
  ptr.at64checked
  ptr.mut.atChecked
  ptr.mut.at32checked
  ptr.mut.at64checked
end

overload: export: +
  iSize.add
end
overload: export: -
  iSize.sub
end
overload: export: -_
  iSize.neg
end
overload: export: *
  iSize.mul
end
overload: export: /
  iSize.div
end
overload: export: u/
  iSize.div
end
overload: export: %
  iSize.mod
end
overload: export: u%
  iSize.mod
end
overload: export: >>>
  iSize.shr
  iSize.shrI32
end
overload: export: <<
  iSize.shl
  iSize.shlI32
end
overload: export: &
  iSize.and
end
overload: export: |
  iSize.or
end
overload: export: ^
  iSize.xor
end
overload: export: ?
  iSize.toBool
end
overload: export: <
  ptr.lt
  ptr.lt0D
end
overload: export: <=
  ptr.le
  ptr.le0D
end
overload: export: ==
  ptr.eq0 ## don't allow renaming of arguments
  ptr.eqRaw
  iSize.eq
end
overload: export: !=
  ptr.ne0
  ptr.neRaw
  iSize.ne
end
overload: export: >=
  ptr.ge
  ptr.ge0D
end
overload: export: >
  ptr.gt
  ptr.gt0D
end
overload: export: <=>
  ptr.cmp
  ptr.cmp0D
  iSize.cmp
end
overload: export: u<
  ptr.lt
  ptr.lt0D
  iSize.lt
end
overload: export: u<=
  ptr.le
  ptr.le0D
  iSize.le
end
overload: export: u>=
  ptr.ge
  ptr.ge0D
  iSize.ge
end
overload: export: u>
  ptr.gt
  ptr.gt0D
  iSize.gt
end
