"../../list" *import
"../../stringBuilder" *import
"../../mem" *import
"../../exec" *import
"../../file" *import
"../../sys" *import

## interface to gnu-libc version of exec
namespace: c
  i32 =:: pid_t
  ( char8 ptr.raw iSize -> pid_t ) : static: alias: :pid_t ..builtIn.parse.i32
  0:pid_t =:: FORK_CHILD
  -1:pid_t =:: FORK_FAILURE
  proc.c( ..ctype.int : options ..ctype.int ptr.mut : status pid_t : id  -> pid_t ) : extern: waitpid
  proc.c( -> pid_t ) : extern: fork
  ## allow inner pointers to be mutable for compatability with libc
  proc.c(
    ..ctype.char ptr.raw.mut ptr.raw : args
    ..ctype.char ptr.raw : path ## execute file at given path
  -> ..ctype.int ) : extern: execv
  proc.c(
    ..ctype.char ptr.raw.mut ptr.raw : args
    ..ctype.char ptr.raw : file ## search file in PATH folders
  -> ..ctype.int ) : extern: execvp
  proc.c(
    ..ctype.char ptr.raw.mut ptr.raw : env
    ..ctype.char ptr.raw.mut ptr.raw : args
    ..ctype.char ptr.raw : file
  -> ..ctype.int ) : extern: execvpe
  ## should work on most platforms, but is not guaranteed by the C/POSIX standard 
  proc( i32 : status -> i32 ) =>: WIFEXITED
    status 0x7f & ? if 0 else 1 end
  end
  proc( i32 : status -> i32 ) =>: WEXITSTATUS
    status 8 >> 0xff &
  end
end
namespace: exec
  proc( ExecContext : context -> i32 RunState ) =>: export: run
    c.fork =:: childId
    childId c.FORK_FAILURE == if
      -1 RunState .FORK_FAILURE return
    end
    childId c.FORK_CHILD == if
      context .stdInPath .length 0 != if
        context .stdInPath file.setStdIn ..drop
      end
      context .stdOutPath .length 0 != if
        context .stdOutPath context .redirectMode RedirectMode.APPEND_STD_OUT & ? file.setStdOut ..drop
      end
      context .stdErrPath .length 0 != if
        context .stdErrPath context .redirectMode RedirectMode.APPEND_STD_ERR & ? file.setStdErr ..drop
      end
      ## child process
      context .argOffsets .length 1:iSize +
        ..ctype.char ptr.raw.mut
      mem.alloc =:: argsPtr
      context .argOffsets .length for =:: i
        context .argBuffer .data
          context .argOffsets i []
        @[]
          ..ctype.char ptr.raw.mut cast!
        argsPtr i =[]
      end
      c.nullPtr ..ctype.char ptr.raw.mut cast! argsPtr context .argOffsets .length =[]
      ## execvp
        argsPtr
        context .argBuffer .data ..ctype.char ptr.raw cast!
      c.execvp ..drop ## call only exits on failure
      -1 sys.exit ## do not continue child if exec fails
    end
    ## parent process
    ..ctype.int : mut: status
    ## waitpid
      0 ..ctype.int cast
      status@
      childId
    c.waitpid i32 cast -1 == if
      -1 RunState .WAIT_FAILURE return
    end
    ## TODO? check for other exit statuses
    status i32 cast c.WIFEXITED ? ! if
      status i32 cast RunState .PROCESS_FAILURE return
    end
    ## return
      status i32 cast c.WEXITSTATUS 0xff &
      RunState .SUCCESS
    return
  end
end
