import core/ptr
import core/integers
import mem
import stringBuilder

namespace: io
  i32 type =: export: IOError
  ( char8 ptr.raw iSize -> IOError ) : static: alias: export: :IOError ..builtIn.parse.i32
  0:IOError  =:: export: FILE_ERROR_NONE
  -1:IOError =:: export: FILE_ERR_END_OF_FILE
  1:IOError  =:: export: FILE_ERR_IO
  2:IOError  =:: export: FILE_ERR_PATH_OVERFLOW
  3:IOError  =:: export: FILE_ERR_OPEN_MODE
  4:IOError  =:: export: FILE_ERR_FILE_NOT_FOUND
  5:IOError  =:: export: FILE_ERR_FILE_IS_DIR
  6:IOError  =:: export: FILE_ERR_FILE_ALREADY_EXISTS
  7:IOError  =:: export: FILE_ERR_ACCESS_DENIED
  8:IOError  =:: export: FILE_ERR_INVALID_FILE

  i32 type =: export: OpenMode
  ( char8 ptr.raw iSize -> IOError ) : static: alias: export: :OpenMode ..builtIn.parse.i32
  1:OpenMode =:: export: OPEN_READ
  2:OpenMode =:: export: OPEN_WRITE
  4:OpenMode =:: export: OPEN_APPEND

  namespace: OpenMode
    proc( OpenMode : a OpenMode : b -> OpenMode ) =>: and
      a i32 cast b i32 cast i32.and OpenMode cast
    end
    proc( OpenMode : a OpenMode : b -> OpenMode ) =>: or
      a i32 cast b i32 cast i32.or OpenMode cast
    end
    proc( OpenMode -> bool ) =>: toBool
      i32 cast i32.toBool
    end
  end
  overload: merge: &  OpenMode.and    end
  overload: merge: |  OpenMode.or     end
  overload: merge: ?  OpenMode.toBool end

  ..ctype.struct ptr.mut =:: export: FILE ## XXX ? wrapper type
end

namespace: c
  ## wrapper functions to allow interoperability with lib-c code
  proc.c( -> io.FILE ) : extern: concatIOHelper_stdin
  proc.c( -> io.FILE ) : extern: concatIOHelper_stdout
  proc.c( -> io.FILE ) : extern: concatIOHelper_stderr
  proc.c( -> ) : extern: concatIOHelper_resetErrno
  proc.c( -> io.IOError ) : extern: concatIOHelper_checkErrno
  proc.c(
    ..ctype.char ptr.raw : mode
    ..ctype.char ptr.raw : path
  -> io.FILE ) : extern: fopen
  proc.c( io.FILE -> ) : extern: clearerr
  proc.c( io.FILE -> ..ctype.int ) : extern: feof
  proc.c( io.FILE -> ..ctype.int ) : extern: ferror
  proc.c(
    io.FILE : file
    ..ctype.size : eltCount
    ..ctype.size : eltSize
    ..ctype.void ptr.raw.mut : buffer
  -> ..ctype.size ) : extern: fread
  proc.c(
    io.FILE : file
    ..ctype.size : eltCount
    ..ctype.size : eltSize
    ..ctype.void ptr.raw : buffer
  -> ..ctype.size ) : extern: fwrite
  proc.c( io.FILE : file -> ..ctype.int ) : extern: fflush
  proc.c( io.FILE : file -> ..ctype.int ) : extern: fclose
end

namespace: io
  proc( -> FILE ) =>: export: stdIn
    c.concatIOHelper_stdin
  end
  proc( -> FILE ) =>: export: stdOut
    c.concatIOHelper_stdout
  end
  proc( -> FILE ) =>: export: stdErr
    c.concatIOHelper_stderr
  end

  char8 4096 array : mut: fileNameBuffer ## XXX make buffer thread safe
  proc(
    char8 ptr.raw : fileName
    iSize : nameLength
    OpenMode : mode
  -> FILE IOError ) =>: export: fopen
    nameLength 0:iSize != and fileName nameLength 1:iSize - [] '\x00' == if ## name not null-terminated
      fileName
    else
      nameLength fileNameBuffer@ ptr.length u>= if
        c.nullPtr FILE cast! FILE_ERR_PATH_OVERFLOW return
      end
      ## mem.copy
        fileNameBuffer@
        fileName
        nameLength
      mem.copy ..drop
      '\x00' fileNameBuffer@ nameLength =[]
      fileNameBuffer@ char8 ptr.raw cast
    end =:: path
    "r+b\x00" char8 ptr.raw =: mut: openMode
    mode OPEN_READ & ? if
      mode OPEN_APPEND & ? if
        "a+b\x00" openMode=
      else mode OPEN_WRITE & ? ! _if
        "rb\x00" openMode=
      end
    else mode ? _if
      mode OPEN_APPEND & ? if
        "ab\x00" openMode=
      else mode OPEN_WRITE & ? _if
        "wb\x00" openMode=
      end
    end
    c.concatIOHelper_resetErrno
    ##fopen
      openMode ..ctype.char ptr cast!
      path ..ctype.char ptr cast!
    c.fopen
    ..dup ( ) ptr cast! c.isNull if
      c.concatIOHelper_checkErrno
    else
      FILE_ERROR_NONE
    end
  end
  proc(
    iSize : auto: k
    char8 k ptr : fileName
    OpenMode : mode
  -> FILE IOError ) =>: export: fopenS
    fileName k mode fopen return
  end
  proc(
    type : auto: T
    FILE : file
    T ptr.raw.mut : buffer
    iSize : off
    iSize : count
  -> iSize IOError ) =>: export: fread
    file ( ) ptr cast! c.isNull if
      0:iSize FILE_ERR_INVALID_FILE return
    end
    file c.clearerr
    c.concatIOHelper_resetErrno
    ## fread
      file
      count  ..ctype.size cast
      count 1:iSize == if T ..types.size else T ..types.stride end ..ctype.size cast
      buffer off @[] ..ctype.void ptr.mut cast!
    c.fread iSize cast
      ## XXX remove explicit cast of return value
      file c.feof i32 cast ? if
        FILE_ERR_END_OF_FILE return
      end
      file c.ferror i32 cast ? if
        c.concatIOHelper_checkErrno return
      end
    FILE_ERROR_NONE return
  end
  proc(
    type : auto: T
    FILE : file
    T ptr.raw : buffer
    iSize : off
    iSize : count
  -> iSize IOError ) =>: export: fwrite
    file ( ) ptr cast! c.isNull if
      0:iSize FILE_ERR_INVALID_FILE return
    end
    file c.clearerr
    c.concatIOHelper_resetErrno
    ## fread
      file
      count ..ctype.size cast
      count 1:iSize == if T ..types.size else T ..types.stride end  ..ctype.size cast
      buffer off @[] ..ctype.void ptr cast!
    c.fwrite iSize cast
      ## XXX remove explicit cast of return value
      file c.feof i32 cast ? if
        FILE_ERR_END_OF_FILE return
      end
      file c.ferror i32 cast ? if
        c.concatIOHelper_checkErrno return
      end
    FILE_ERROR_NONE return
  end
  proc( FILE : file -> IOError ) =>: export: fflush
    file ( ) ptr cast! c.isNull if
      FILE_ERR_INVALID_FILE return
    end
    c.concatIOHelper_resetErrno
    ## XXX remove explicit cast of return value
    file c.fflush i32 cast ? if
      c.concatIOHelper_checkErrno return
    end
    FILE_ERROR_NONE return
  end
  proc( FILE : file -> IOError ) =>: export: fclose
    file ( ) ptr cast! c.isNull if
      FILE_ERR_INVALID_FILE return
    end
    c.concatIOHelper_resetErrno
    ## XXX remove explicit cast of return value
    file c.fclose i32 cast ? if
      c.concatIOHelper_checkErrno return
    end
    FILE_ERROR_NONE return
  end
  ## XXX fseek/ftell


  proc( FILE : file char8 : chr -> IOError ) =>: export: fputc
    ## TODO? add support for pointers to stack values
    chr =:: tmp
    file tmp@ 0:iSize 1:iSize fwrite ..swap ..drop return
  end
  proc( FILE : file  iSize : k  char8 ptr.raw : str -> IOError ) =>: export: fputArray
    0:iSize =:: mut: off
    k =:: mut: remaining
    str char8 ptr.raw cast =:: data
    while remaining 0:iSize != do
      file data off remaining fwrite
        $ FILE_ERROR_NONE != if ## error
            >$ ..drop return
          end
        ..drop
        $ remaining u<= "remaining does not undeflow" assert
        remaining $1 - remaining=
      off >$ + off=
    end
    FILE_ERROR_NONE return
  end
  proc( FILE : file  iSize : auto: k  char8 k ptr : str -> IOError ) =>: export: fputs
    file k str fputArray
  end

  proc( char8 : c -> IOError ) =>: export: putc
    stdOut c fputc
  end
  proc( iSize : auto: k  char8 k ptr : str -> IOError ) =>: export: puts
    k 1:iSize + sb.create
      str sb.appendS
      '\n' sb.appendC
    =:: chars
      stdOut chars .length chars .data fputArray =:: errId
    chars sb.free ..drop
    errId return
  end
  proc( -> char8 IOError ) =>: export: getChar
    char8 : res
    io.stdIn res@ 0:iSize 1:iSize fread =:: err =:: count
    count 0:iSize == and err FILE_ERROR_NONE == if
      res FILE_ERR_IO return ## could not read byte
    end
    res err
  end
end
