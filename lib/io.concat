#namespace io
  type : extern _FILE
  _FILE ptr mut =:: public FILE
  
  i32 type =: public IOError
  i32 type =: public OpenMode
  
  0  IOError =: public FILE_ERROR_NONE
  -1 IOError =: public FILE_ERR_END_OF_FILE 
  1  IOError =: public FILE_ERR_IO
  2  IOError =: public FILE_ERR_PATH_OVERFLOW
  3  IOError =: public FILE_ERR_OPEN_MODE
  4  IOError =: public FILE_ERR_FILE_NOT_FOUND
  5  IOError =: public FILE_ERR_FILE_IS_DIR
  6  IOError =: public FILE_ERR_FILE_ALREADY_EXISTS
  7  IOError =: public FILE_ERR_ACCESS_DENIED
  8  IOError =: public FILE_ERR_INVALID_FILE

  1 OpenMode =: public OPEN_READ
  2 OpenMode =: public OPEN_WRITE
  4 OpenMode =: public OPEN_APPEND
  
  
  proc( => FILE ) : extern public stdIn
  proc( => FILE ) : extern public stdOut
  proc( => FILE ) : extern public stdErr
  
  proc( i8 _ ptr : fileName i64 : nameLength OpenMode : mode => FILE IOError ) : extern public fopen
  proc( i64 : static k  i8 k ptr : fileName  OpenMode : mode => FILE IOError ) =: public fopenS
    fileName k mode fopen return
  end
  ## file buffer off count -> nRead errCode
  proc( FILE : file i8 _ ptr mut : buffer i64 : off i64 : count => i64 IOError ) : extern public fread
  ## file buffer off count -> nWritten errCode
  proc( FILE : file i8 _ ptr     : buffer i64 : off i64 : count => i64 IOError ) : extern public fwrite
  proc( FILE => IOError ) : extern public fflush
  proc( FILE => IOError ) : extern public fclose
  ## XXX fseek
  
  proc( FILE : file i8 : chr => IOError ) =: public fputc
    file chr addrOf 0 1 fwrite #swap #drop return
  end
  proc( FILE : file  i64 : static k  i8 k ptr : str => IOError ) =: public fputs
    0 i64 =: mut off
    k =:: mut count
    str i8 _ ptr cast =:: data
    while count 0 > do
      file data off count fwrite 
        #dup FILE_ERROR_NONE != if ## error
            #swap #drop return
          end
        #drop
        count #over - count =
      off #swap + off =
    end
    FILE_ERROR_NONE return
  end
  proc( FILE : file => FILE IOError ) =: public fstart
    file FILE_ERROR_NONE return
  end
  proc( FILE : file IOError : err  i64 : static k  i8 k ptr : str => FILE  IOError ) =: public fappendS
    err FILE_ERROR_NONE != if
      file err return
    end
    file #dup str fputs return
  end
  proc( FILE : file IOError : err i8 : c => FILE  IOError ) =: public fappendC
    err FILE_ERROR_NONE != if
      file err return
    end
    file #dup c fputc return
  end
  
  proc( i64 : static k  i8 k ptr : str => IOError ) =: public puts
    stdOut fstart 
      str  fappendS 
      "\n" fappendS
    #swap #drop return
  end
#end
