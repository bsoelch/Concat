import core/ptrArithmetic
import core/integers
import mem
import stringBuilder

namespace: io
  i32 type =: export: IOError
  0:IOError  =:: export: FILE_ERROR_NONE
  -1:IOError =:: export: FILE_ERR_END_OF_FILE
  1:IOError  =:: export: FILE_ERR_IO
  2:IOError  =:: export: FILE_ERR_PATH_OVERFLOW
  3:IOError  =:: export: FILE_ERR_OPEN_MODE
  4:IOError  =:: export: FILE_ERR_FILE_NOT_FOUND
  5:IOError  =:: export: FILE_ERR_FILE_IS_DIR
  6:IOError  =:: export: FILE_ERR_FILE_ALREADY_EXISTS
  7:IOError  =:: export: FILE_ERR_ACCESS_DENIED
  8:IOError  =:: export: FILE_ERR_INVALID_FILE

  i32 type =: export: OpenMode
  1:OpenMode =:: export: OPEN_READ
  2:OpenMode =:: export: OPEN_WRITE
  4:OpenMode =:: export: OPEN_APPEND

  namespace: OpenMode
    proc( OpenMode : a OpenMode : b -> OpenMode ) =>: and
      a i32 cast b i32 cast i32.and OpenMode cast
    end
    proc( OpenMode : a OpenMode : b -> OpenMode ) =>: or
      a i32 cast b i32 cast i32.or OpenMode cast
    end
    proc( OpenMode -> bool ) =>: toBool
      i32 cast i32.toBool
    end
  end
  overload: &  OpenMode.and    end
  overload: |  OpenMode.or     end
  overload: ?  OpenMode.toBool end

  ..ctype.struct ptr.mut =:: export: FILE ## XXX ? wrapper type
end

namespace: c
  ## wrapper functions to allow interoperability with lib-c code
  proc( -> io.FILE ) : extern: concatIOHelper_stdin
  proc( -> io.FILE ) : extern: concatIOHelper_stdout
  proc( -> io.FILE ) : extern: concatIOHelper_stderr
  proc( -> ) : extern: concatIOHelper_resetErrno
  proc( -> io.IOError ) : extern: concatIOHelper_checkErrno
  proc(
    ..ctype.char _ ptr : path
    ..ctype.char _ ptr : mode
  -> io.FILE ) : extern: fopen
  proc( io.FILE -> ) : extern: clearerr
  proc( io.FILE -> ..ctype.int ) : extern: feof
  proc( io.FILE -> ..ctype.int ) : extern: ferror
  proc(
    ..ctype.void _ ptr.mut : buffer
    ..ctype.size : eltSize
    ..ctype.size : eltCount
    io.FILE : file
  -> ..ctype.size ) : extern: fread
  proc(
    ..ctype.void _ ptr : buffer
    ..ctype.size : eltSize
    ..ctype.size : eltCount
    io.FILE : file
  -> ..ctype.size ) : extern: fwrite
  proc( io.FILE : file -> ..ctype.int ) : extern: fflush
  proc( io.FILE : file -> ..ctype.int ) : extern: fclose
end

namespace: io
  proc( -> FILE ) =>: export: stdIn
    c.concatIOHelper_stdin
  end
  proc( -> FILE ) =>: export: stdOut
    c.concatIOHelper_stdout
  end
  proc( -> FILE ) =>: export: stdErr
    c.concatIOHelper_stderr
  end

  char8 4096 array : mut: fileNameBuffer ## XXX make buffer thread safe
  proc(
    char8 _ ptr : fileName
    i64 : nameLength
    OpenMode : mode
  -> FILE IOError ) =>: export: fopen
    fileName nameLength 1 - [] '\x00' == if ## name not null-terminated
      fileName
    else
      nameLength fileNameBuffer@ ..length >= if
        c.nullPtr FILE cast! FILE_ERR_PATH_OVERFLOW return
      end
      ## mem.copy
        fileNameBuffer@
        fileName
        nameLength
      mem.copy ..drop
      '\x00' fileNameBuffer@ nameLength [] =
      fileNameBuffer@ char8 _ ptr cast
    end =:: path
    "r+b\x00" char8 _ ptr =: mut: openMode
    mode OPEN_READ & ? if
      mode OPEN_APPEND & ? if
        "a+b\x00" openMode =
      else mode OPEN_WRITE & ? ! _if
        "rb\x00" openMode =
      end
    else mode ? _if
      mode OPEN_APPEND & ? if
        "ab\x00" openMode =
      else mode OPEN_WRITE & ? _if
        "wb\x00" openMode =
      end
    end
    c.concatIOHelper_resetErrno
    ##fopen
      path ..ctype.char ptr cast!
      openMode ..ctype.char ptr cast!
    c.fopen
    ..dup ( ) ptr cast! c.isNull if
      c.concatIOHelper_checkErrno
    else
      FILE_ERROR_NONE
    end
  end
  proc(
    i64 : auto: k
    char8 k ptr : fileName
    OpenMode : mode
  -> FILE IOError ) =>: export: fopenS
    fileName k mode fopen return
  end
  proc(
    type : auto: T
    FILE : file
    T _ ptr.mut : buffer
    i64 : off
    i64 : count
  -> i64 IOError ) =>: export: fread
    file ( ) ptr cast! c.isNull if
      0 FILE_ERR_INVALID_FILE return
    end
    file c.clearerr
    c.concatIOHelper_resetErrno
    ## fread
      buffer off + ..ctype.void ptr.mut cast!
      count 1 == if T ..types.size else T ..types.stride end  ..ctype.size cast
      count  ..ctype.size cast
      file
    c.fread i64 cast
      ## XXX remove explicit cast of return value
      file c.feof i32 cast ? if
        FILE_ERR_END_OF_FILE return
      end
      file c.ferror i32 cast ? if
        c.concatIOHelper_checkErrno return
      end
    FILE_ERROR_NONE return
  end
  proc(
    type : auto: T
    FILE : file
    T _ ptr : buffer
    i64 : off
    i64 : count
  -> i64 IOError ) =>: export: fwrite
    file ( ) ptr cast! c.isNull if
      0 FILE_ERR_INVALID_FILE return
    end
    file c.clearerr
    c.concatIOHelper_resetErrno
    ## fread
      buffer off + ..ctype.void ptr cast!
      count 1 == if T ..types.size else T ..types.stride end  ..ctype.size cast
      count ..ctype.size cast
      file
    c.fwrite i64 cast
      ## XXX remove explicit cast of return value
      file c.feof i32 cast ? if
        FILE_ERR_END_OF_FILE return
      end
      file c.ferror i32 cast ? if
        c.concatIOHelper_checkErrno return
      end
    FILE_ERROR_NONE return
  end
  proc( FILE : file -> IOError ) =>: export: fflush
    file ( ) ptr cast! c.isNull if
      FILE_ERR_INVALID_FILE return
    end
    c.concatIOHelper_resetErrno
    ## XXX remove explicit cast of return value
    file c.fflush i32 cast ? if
      c.concatIOHelper_checkErrno return
    end
    FILE_ERROR_NONE return
  end
  proc( FILE : file -> IOError ) =>: export: fclose
    file ( ) ptr cast! c.isNull if
      FILE_ERR_INVALID_FILE return
    end
    c.concatIOHelper_resetErrno
    ## XXX remove explicit cast of return value
    file c.fclose i32 cast ? if
      c.concatIOHelper_checkErrno return
    end
    FILE_ERROR_NONE return
  end
  ## XXX fseek/ftell


  proc( FILE : file char8 : chr -> IOError ) =>: export: fputc
    ## TODO? add support for pointers to stack values
    chr =:: tmp
    file tmp@ 0 1 fwrite ..swap ..drop return
  end
  proc( FILE : file  i64 : k  char8 _ ptr : str -> IOError ) =>: export: fputArray
    0 i64 =: mut: off
    k =:: mut: count
    str char8 _ ptr cast =:: data
    while count 0 > do
      file data off count fwrite
        ..dup FILE_ERROR_NONE != if ## error
            ..swap ..drop return
          end
        ..drop
        count ..over - count =
      off ..swap + off =
    end
    FILE_ERROR_NONE return
  end
  proc( FILE : file  i64 : auto: k  char8 k ptr : str -> IOError ) =>: export: fputs
    file k str fputArray
  end

  proc( char8 : c -> IOError ) =>: export: putc
    stdOut c fputc
  end
  proc( i64 : auto: k  char8 k ptr : str -> IOError ) =>: export: puts
    k 1 + sb.create
      str sb.appendS
      '\n' sb.appendC
    =:: chars
      stdOut chars .length chars .data fputArray =:: errId
    chars sb.free ..drop
    errId return
  end
  proc( -> char8 IOError ) =>: export: getChar
    char8 : res
    io.stdIn res@ 0 1 fread =:: err =:: count
    count 0 == and err FILE_ERROR_NONE == if
      res FILE_ERR_IO return ## could not read byte
    end
    res err
  end
end

