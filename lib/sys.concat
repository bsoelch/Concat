"mem" *import ## for c.isNull
"string" *import
namespace: c ## XXX? special file for general C procedures
  proc.c( ..ctype.int -> ) : extern: noReturn: exit
  proc.c( char8 ptr.raw -> i64 ) : extern: strlen
end
namespace: sys
  proc( i64 : i -> string ) =>: export: getArg
    i sys.argc u>= if string.empty return end
    sys.argv i [] $ c.strlen string.create return
  end
  proc( i32 -> ) =>: export: noReturn: exit
    ..ctype.int cast c.exit
  end
end
