namespace: c
  proc( -> ..ctype.void _ ptr mut ) =>: export: nullPtr
    0 ..ctype.void _ ptr mut cast! return
  end
  #:if:old
  #template type : T #end
  proc( T _ ptr : p -> bool ) =>: export: isNull
  #:else
  proc( type : auto: T T _ ptr : p -> bool ) =>: export: isNull
  #:end
    ## ==
    p ..ctype.void _ ptr cast!
    nullPtr ..ctype.void _ ptr cast!
    == return
  end
  proc(
    ..ctype.size : size
  -> ..ctype.void _ ptr mut ) : extern: malloc
  proc(
    ..ctype.size : count
    ..ctype.size : size
  -> ..ctype.void _ ptr mut ) : extern: calloc
  proc(
    ..ctype.void _ ptr mut : prev
    ..ctype.size : size
  -> ..ctype.void _ ptr mut ) : extern: realloc
  proc( ..ctype.void _ ptr mut : src -> ) : extern: free
  proc(
    ..ctype.void _ ptr mut : target
    ..ctype.void _ ptr : src
    ..ctype.size : count
  -> ..ctype.void _ ptr mut ) : extern: memcpy
  proc(
    ..ctype.void _ ptr mut : target
    ..ctype.void _ ptr : src
    ..ctype.size : count
  -> ..ctype.void _ ptr mut ) : extern: memmove
  proc(
    ..ctype.void _ ptr mut : target
    ..ctype.int  : value
    ..ctype.size : count
  -> ..ctype.void _ ptr mut ) : extern: memset
  proc(
    ..ctype.void _ ptr : a
    ..ctype.void _ ptr : b
    ..ctype.size : count
  -> ..ctype.int ) : extern: memcmp
end
namespace: mem
  proc(
    ..ctype.void _ ptr mut : p
  -> ..ctype.void _ ptr mut ) =>: checkPtr
    p c.nullPtr == if ## check for null-ptr
      ..unreachable ## TODO handle error
    end
    p return
  end
  #:if:old
  #template type : T #end
  proc( -> T _ ptr mut ) =>: export: nullPtr
  #:else
  proc( type : T -> T _ ptr mut ) =>: export: nullPtr
  #:end
    c.nullPtr T _ ptr mut cast! return
  end
  #:if:old
  #template type : T #end
  proc( i64 : n -> T _ ptr mut ) =>: export: alloc
  #:else
  proc( i64 : n type : T -> T _ ptr mut ) =>: export: alloc
  #:end
    n 0 == if
      c.nullPtr T _ ptr mut cast! return
    end
    n T ..type.stride * c.malloc checkPtr T _ ptr mut cast! return
  end
  #:if:old
  #template type : T #end
  proc( i64 : n -> T _ ptr mut ) =>: export: calloc
  #:else
  proc( i64 : n type : T -> T _ ptr mut ) =>: export: calloc
  #:end
    n 0 == if
      c.nullPtr T _ ptr mut cast! return
    end
    n T ..type.stride c.calloc checkPtr T _ ptr mut cast! return
  end
  #:if:old
  #template type : T #end
  proc( T _ ptr mut : prev i64 : n -> T _ ptr mut ) =>: export: realloc
  #:else
  proc(
    type : auto: T
    T _ ptr mut : prev
    i64 : n
  -> T _ ptr mut ) =>: export: realloc
  #:end
    n 0 == if
      prev free
      c.nullPtr T _ ptr mut cast! return
    end
    ## realloc
      prev ..ctype.void _ ptr mut cast!
      T ..type.stride n *
    c.realloc checkPtr T _ ptr mut cast! return
  end
  #:if:old
  #template type : T #end
  proc( T _ ptr mut : p -> ) =>: export: free
  #:else
  proc( type : auto: T T _ ptr mut : p -> ) =>: export: free
  #:end
    p ..ctype.void ptr mut cast! c.free
  end
  ## set memory to zero
  #:if:old
  #template type : T #end
  proc( T _ ptr mut : src  i64 : n -> T _ ptr mut ) =>: export: clear
  #:else
  proc(
    type : auto: T
    T _ ptr mut : src
    i64 : n
  -> T _ ptr mut ) =>: export: clear
  #:end
    n 0 <= if
      src return
    end
    ## memset
      src ..ctype.void _ ptr mut cast!
      0
      T ..type.stride n 1 - * T ..type.size +
    c.memset checkPtr T _ ptr mut cast! return
  end
  #:if:old
  #template type : T #end
  proc( T _ ptr mut : target T _ ptr : src i64 : n -> T _ ptr mut ) =>: export: copy
  #:else
  proc(
    type : auto: T
    T _ ptr mut : target
    T _ ptr : src
    i64 : n
  -> T _ ptr mut ) =>: export: copy
  #:end
    n 0 <= if
      target return
    end
    ## memcpy
      target ..ctype.void _ ptr mut cast!
      src ..ctype.void _ ptr cast!
      T ..type.stride n 1 - * T ..type.size +
    c.memcpy checkPtr T _ ptr mut cast! return
  end
  #:if:old
  #template type : T #end
  proc( T _ ptr mut : target T _ ptr : src i64 : n -> T _ ptr mut ) =>: export: move
  #:else
  proc(
    type : auto: T
    T _ ptr mut : target
    T _ ptr : src
    i64 : n
  -> T _ ptr mut ) =>: export: move
  #:end
    n 0 <= if
      target return
    end
    ## memmove
      target ..ctype.void _ ptr mut cast!
      src ..ctype.void _ ptr cast!
      T ..type.stride n 1 - * T ..type.size +
    c.memmove checkPtr T _ ptr mut cast! return
  end
  #:if:old
  #template type : T #end
  proc( T _ ptr : a  T _ ptr : b  i64 : n   -> i32 ) =>: export: compare
  #:else
  proc(
    type : auto: T
    T _ ptr : a
    T _ ptr : b
    i64 : n
  -> i32 ) =>: export: compare
  #:end
    n 0 <= if
      0 return
    end
    ## memcmp
      a ..ctype.void _ ptr cast!
      b ..ctype.void _ ptr cast!
      T ..type.stride n 1 - * T ..type.size +
    c.memcmp return
  end
  #:if:old
  #template type : T #end
  proc( T _ ptr mut : data i64 : count T : elt -> ) =>: export: fill
  #:else
  proc(
    type : auto: T
    T _ ptr mut : data
    i64 : count
    T : elt
  -> ) =>: export: fill
  #:end
    0 while ..dup count < do
      elt data ..over.2 [] =
      1 +
    end ..drop
  end
end
