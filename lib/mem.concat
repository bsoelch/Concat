#namespace c
  proc( => ..ctype.void _ ptr mut ) =: public nullPtr
    0 ..ctype.void _ ptr mut cast! return
  end
  #template type : T #end
  proc( T _ ptr : p => bool ) =: public isNull
    ## ==
    p ..ctype.void _ ptr cast!
    nullPtr ..ctype.void _ ptr cast!
    == return
  end
  proc(
    ..ctype.size : size
  => ..ctype.void _ ptr mut ) : externC malloc
  proc(
    ..ctype.size : count
    ..ctype.size : size
  => ..ctype.void _ ptr mut ) : externC calloc
  proc(
    ..ctype.void _ ptr mut : prev
    ..ctype.size : size
  => ..ctype.void _ ptr mut ) : externC realloc
  proc( ..ctype.void _ ptr mut : src => ) : externC free
  proc(
    ..ctype.void _ ptr mut : target
    ..ctype.void _ ptr : src
    ..ctype.size : count
  => ..ctype.void _ ptr mut ) : externC memcpy
  proc(
    ..ctype.void _ ptr mut : target
    ..ctype.void _ ptr : src
    ..ctype.size : count
  => ..ctype.void _ ptr mut ) : externC memmove
  proc(
    ..ctype.void _ ptr mut : target
    ..ctype.int  : value
    ..ctype.size : count
  => ..ctype.void _ ptr mut ) : externC memset
  proc(
    ..ctype.void _ ptr : a
    ..ctype.void _ ptr : b
    ..ctype.size : count
  => ..ctype.int ) : externC memcmp
#end
#namespace mem
  proc(
    ..ctype.void _ ptr mut : p
  => ..ctype.void _ ptr mut ) =: checkPtr
    p c.nullPtr == if ## check for null-ptr
      ..unreachable ## TODO handle error
    end
    p return
  end
  #template type : T #end
  proc( i64 : n => T _ ptr mut ) =: public alloc
    n 0 == if
      c.nullPtr T _ ptr mut cast! return
    end
    n T ..type.stride * c.malloc checkPtr T _ ptr mut cast! return
  end
  #template type : T #end
  proc( i64 : n => T _ ptr mut ) =: public calloc
    n 0 == if
      c.nullPtr T _ ptr mut cast! return
    end
    n T ..type.stride c.calloc checkPtr T _ ptr mut cast! return
  end
  #template type : T #end
  proc( T _ ptr mut : prev i64 : n => T _ ptr mut ) =: public realloc
    n 0 == if
      prev free
      c.nullPtr T _ ptr mut cast! return
    end
    prev ..ctype.void _ ptr mut cast! T ..type.stride n * c.realloc checkPtr T _ ptr mut cast! return
  end
  #template type : T #end
  proc( T _ ptr mut : p => ) =: public free
    p ..ctype.void ptr mut cast! c.free
  end
  ## set memory to zero
  #template type : T #end
  proc( T _ ptr mut : src  i64 : n => T _ ptr mut ) =: public clear
    src ..ctype.void _ ptr mut cast! 0 T ..type.stride n * c.memset checkPtr T _ ptr mut cast! return
  end
  #template type : T #end
  proc( T _ ptr mut : target T _ ptr : src i64 : n => T _ ptr mut ) =: public copy
    ## memcpy
      target ..ctype.void _ ptr mut cast!
      src ..ctype.void _ ptr cast!
      T ..type.stride n *
    c.memcpy checkPtr T _ ptr mut cast! return
  end
  #template type : T #end
  proc( T _ ptr mut : target T _ ptr : src i64 : n => T _ ptr mut ) =: public move
    ## memmove
      target ..ctype.void _ ptr mut cast!
      src ..ctype.void _ ptr cast!
      T ..type.stride n *
    c.memmove checkPtr T _ ptr mut cast! return
  end
  #template type : T #end
  proc( T _ ptr : a  T _ ptr : b  i64 : n   => i32 ) =: public compare
    ## memcmp
      a ..ctype.void _ ptr cast!
      b ..ctype.void _ ptr cast!
      T ..type.stride n *
    c.memcmp return
  end
  #template type : T #end
  proc( T _ ptr mut : data i64 : count T : elt => ) =: public fill
    0 while #dup count < do
      elt data #over:2 [] =
      1 +
    end #drop
  end
#end
