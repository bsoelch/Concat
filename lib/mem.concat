#namespace c
  type : VOID
  proc( => VOID _ ptr mut ) =: nullPtr
    0 VOID _ ptr mut cast! return
  end
  proc( ..ctype.size : size => VOID _ ptr mut ) : externC malloc
  proc(
    ..ctype.size : count
    ..ctype.size : size
  => VOID _ ptr mut ) : externC calloc
  proc(
    VOID _ ptr mut : prev
    ..ctype.size : size
  => VOID _ ptr mut ) : externC realloc
  proc( VOID _ ptr mut : src => ) : externC free
  proc(
    VOID _ ptr mut : target
    VOID _ ptr : src
    ..ctype.size : count
  => VOID _ ptr mut ) : externC memcpy
  proc(
    VOID _ ptr mut : target
    VOID _ ptr : src
    ..ctype.size : count
  => VOID _ ptr mut ) : externC memmove
  proc(
    VOID _ ptr mut : target
    ..ctype.int  : value
    ..ctype.size : count
  => VOID _ ptr mut ) : externC memset
  proc(
    VOID _ ptr : a
    VOID _ ptr : b
    ..ctype.size : count
  => ..ctype.int ) : externC memcmp
#end
#namespace mem
  proc( c.VOID _ ptr mut : p => c.VOID _ ptr mut ) =: checkPtr
    p c.nullPtr == if ## check for null-ptr
      ..unreachable ## TODO handle error
    end
    p return
  end
  #template type : T #end
  proc( i64 : n => T _ ptr mut ) =: public alloc
    n 0 == if
      c.nullPtr T _ ptr mut cast! return
    end
    n T ..type.stride * c.malloc checkPtr T _ ptr mut cast! return
  end
  #template type : T #end
  proc( i64 : n => T _ ptr mut ) =: public calloc
    n 0 == if
      c.nullPtr T _ ptr mut cast! return
    end
    n T ..type.stride c.calloc checkPtr T _ ptr mut cast! return
  end
  #template type : T #end
  proc( T _ ptr mut : prev i64 : n => T _ ptr mut ) =: public realloc
    n 0 == if
      prev free
      c.nullPtr T _ ptr mut cast! return
    end
    prev c.VOID _ ptr mut cast! T ..type.stride n * c.realloc checkPtr T _ ptr mut cast! return
  end
  #template type : T #end
  proc( T _ ptr mut : p => ) =: public free
    p c.VOID ptr mut cast! c.free
  end
  ## set memory to zero
  #template type : T #end
  proc( T _ ptr mut : src  i64 : n => T _ ptr mut ) =: public clear
    src c.VOID _ ptr mut cast! 0 T ..type.stride n * c.memset checkPtr T _ ptr mut cast! return
  end
  #template type : T #end
  proc( T _ ptr mut : target T _ ptr : src i64 : n => T _ ptr mut ) =: public copy
    ## memcpy
      target c.VOID _ ptr mut cast!
      src c.VOID _ ptr cast!
      T ..type.stride n *
    c.memcpy checkPtr T _ ptr mut cast! return
  end
  #template type : T #end
  proc( T _ ptr mut : target T _ ptr : src i64 : n => T _ ptr mut ) =: public move
    ## memmove
      target c.VOID _ ptr mut cast!
      src c.VOID _ ptr cast!
      T ..type.stride n *
    c.memmove checkPtr T _ ptr mut cast! return
  end
  #template type : T #end
  proc( T _ ptr : a  T _ ptr : b  i64 : n   => i32 ) =: public compare
    ## memcmp
      a c.VOID _ ptr cast!
      b c.VOID _ ptr cast!
      T ..type.stride n *
    c.memcmp return
  end
  #template type : T #end
  proc( T _ ptr mut : data i64 : count T : elt => ) =: public fill
    0 while #dup count < do
      elt data #over:2 [] =
      1 +
    end #drop
  end
#end
