namespace: c
  ## XXX? move general C procedures to seperate file
  proc( -> ..ctype.void _ ptr.mut ) =>: export: nullPtr
    0 ..ctype.void _ ptr.mut cast! return
  end
  proc( type : auto: T T _ ptr : p -> bool ) =>: export: isNull
    ## ==
    p ..ctype.void _ ptr cast!
    nullPtr ..ctype.void _ ptr cast!
    == return
  end
  proc.c(
    ..ctype.size : size
  -> ..ctype.void _ ptr.mut ) : extern: malloc
  proc.c(
    ..ctype.size : size
    ..ctype.size : count
  -> ..ctype.void _ ptr.mut ) : extern: calloc
  proc.c(
    ..ctype.size : size
    ..ctype.void _ ptr.mut : prev
  -> ..ctype.void _ ptr.mut ) : extern: realloc
  proc.c( ..ctype.void _ ptr.mut : src -> ) : extern: free
  proc.c(
    ..ctype.size : count
    ..ctype.void _ ptr : src
    ..ctype.void _ ptr.mut : target
  -> ..ctype.void _ ptr.mut ) : extern: memcpy
  proc.c(
    ..ctype.size : count
    ..ctype.void _ ptr : src
    ..ctype.void _ ptr.mut : target
  -> ..ctype.void _ ptr.mut ) : extern: memmove
  proc.c(
    ..ctype.size : count
    ..ctype.int  : value
    ..ctype.void _ ptr.mut : target
  -> ..ctype.void _ ptr.mut ) : extern: memset
  proc.c(
    ..ctype.size : count
    ..ctype.void _ ptr : b
    ..ctype.void _ ptr : a
  -> ..ctype.int ) : extern: memcmp
end
namespace: mem
  proc(
    ..ctype.void _ ptr.mut : p
  -> ..ctype.void _ ptr.mut ) =>: checkPtr
    p c.nullPtr == if ## check for null-ptr
      "unexpected null-pointer" ..panic
    end
    p return
  end
  proc( type : T -> T _ ptr.mut ) =>: export: nullPtr
    c.nullPtr T _ ptr.mut cast! return
  end
  proc( i64 : n type : T -> T _ ptr.mut ) =>: export: alloc
    n 0 == if
      c.nullPtr T _ ptr.mut cast! return
    end
    ## malloc
      n T ..types.stride * ..ctype.size cast
    c.malloc checkPtr T _ ptr.mut cast! return
  end
  proc( i64 : n type : T -> T _ ptr.mut ) =>: export: calloc
    n 0 == if
      c.nullPtr T _ ptr.mut cast! return
    end
    ## calloc
      T ..types.stride ..ctype.size cast
      n ..ctype.size cast
    c.calloc checkPtr T _ ptr.mut cast! return
  end
  proc(
    type : auto: T
    T _ ptr.mut : prev
    i64 : n
  -> T _ ptr.mut ) =>: export: realloc
    n 0 == if
      prev free
      c.nullPtr T _ ptr.mut cast! return
    end
    ## realloc
      T ..types.stride n *  ..ctype.size cast
      prev ..ctype.void _ ptr.mut cast!
    c.realloc checkPtr T _ ptr.mut cast! return
  end
  proc( type : auto: T T _ ptr.mut : p -> ) =>: export: free
    p ..ctype.void ptr.mut cast! c.free
  end
  ## set memory to zero
  proc(
    type : auto: T
    T _ ptr.mut : src
    i64 : n
  -> T _ ptr.mut ) =>: export: clear
    n 0 <= if
      src return
    end
    ## memset
      n 1 == if T ..types.size else T ..types.stride n * end ..ctype.size cast
      0 ..ctype.int cast
      src ..ctype.void _ ptr.mut cast!
    c.memset checkPtr T _ ptr.mut cast! return
  end
  proc(
    type : auto: T
    T _ ptr.mut : target
    T _ ptr : src
    i64 : n
  -> T _ ptr.mut ) =>: export: copy
    n 0 <= if
      target return
    end
    src target == if
      ## no copy needed
      target return
    end
    ## memcpy
      n 1 == if T ..types.size else T ..types.stride n * end ..ctype.size cast
      src ..ctype.void _ ptr cast!
      target ..ctype.void _ ptr.mut cast!
    c.memcpy checkPtr T _ ptr.mut cast! return
  end
  proc(
    type : auto: T
    T _ ptr.mut : target
    T _ ptr : src
    i64 : n
  -> T _ ptr.mut ) =>: export: move
    n 0 <= if
      target return
    end
    src target == if
      ## no copy needed
      target return
    end
    ## memmove
      n 1 == if T ..types.size else T ..types.stride n * end ..ctype.size cast
      src ..ctype.void _ ptr cast!
      target ..ctype.void _ ptr.mut cast!
    c.memmove checkPtr T _ ptr.mut cast! return
  end
  proc(
    type : auto: T
    T _ ptr : a
    T _ ptr : b
    i64 : n
  -> i32 ) =>: export: compare
    n 0 <= if
      0 return
    end
    ## memcmp
      n 1 == if T ..types.size else T ..types.stride n * end ..ctype.size cast
      b ..ctype.void _ ptr cast!
      a ..ctype.void _ ptr cast!
    c.memcmp i32 cast return
  end
  proc(
    type : auto: T
    T _ ptr.mut : data
    i64 : count
    T : elt
  -> ) =>: export: fill
    0:i64 while ..dup count < do
      elt data ..over.2 =[]
      1 +
    end ..drop
  end
end
