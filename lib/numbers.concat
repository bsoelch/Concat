import core/integers
import core/floats

import numbers/printFloat
import numbers/printInt
import string

namespace: number
  proc( type : auto: T  T : x i64 : p -> T ) =>: export: powI
    p 0 == if
      1 T cast return
    else p 0 < _if
      1 T cast x p -_ powI / return
    end
    x =:: mut: xPow
    1 T cast
      p while ..dup 0 != do
        ..dup 1 & 0 != if
        ..swap
          xPow *
        ..swap
        end
        1 >>
        xPow xPow * xPow=
      end ..drop
    return
  end
  2 =:: export: MIN_BASE
  62 =:: export: MAX_BASE
  enum( DIGIT IGNORED INVALID ) =:: export: DigitType
  proc( char8 : chr i32 : base -> i32 DigitType ) =>: export: parseDigit
    chr '0' >= and chr '9' <= if
      chr '0' - i32 cast.u
        $ base < if
          DigitType .DIGIT
        else
          DigitType .INVALID
        end
      return
    else chr 'A' >= and chr 'Z' <= _if
      chr 'A' - i32 cast.u 10 +
        $ base < if
          DigitType .DIGIT
        else
          DigitType .INVALID
        end
      return
    else chr 'a' >= and chr 'z' <= _if
      chr 'a' - i32 cast.u
        base 36 > if 36 else 10 end +
        $ base < if
          DigitType .DIGIT
        else
          DigitType .INVALID
        end
      return
    end
    -1
      chr '_' == or chr '\'' == if
        DigitType .IGNORED
      else
        DigitType .INVALID
      end
    return
  end
  proc( string -> string i32 ) =>: export: resolveBase
    $ .length 2 < if
      10 return
    end
    $ 0 string.charAt '0' == if
      $ 1 string.charAt =:: intType
      intType 'x' == or intType 'X' == if
        2 string.tail 16 return
      else intType 'b' == or intType 'B' == _if
        2 string.tail 2 return
      else intType 'o' == or intType 'O' == _if
        2 string.tail 8 return
      ## XXX? error on non-digit inputs?
      end
    end
    ## arbitrary base numbers <BASE>b<NUMBER>
    $ 1 string.charAt 'b' == or $ 1 string.charAt 'B' == if
      $ 0 string.charAt '0' - i32 cast.u =:: mut: b
      b 0 < or b 9 > if
        2 string.tail -1 return ## invalid base
      end
      2 string.tail b return
    end
    $ .length 3 > and $ 2 string.charAt 'b' == if ## two digits before b
      $ 0 string.charAt '0' - i32 cast.u =:: mut: b1
      $ 1 string.charAt '0' - i32 cast.u =:: mut: b2
      b1 0 < or b1 9 > or b2 0 < or b2 9 > if
        3 string.tail -1 return ## invalid base
      end
      b1 10 * b2 + =:: b
      3 string.tail b return
    end
    10 return
  end
  enum( NONE INT SIGN INVALID_BASE EMPTY INVALID_CHAR UNSIGNED OVERFLOW ) =:: export: ParserError
  proc( ParserError -> string ) =>: export: errorString
    switch
      NONE case "" string.wrap return
      INT  case "float is integer" string.wrap return
      SIGN case "unsigned number has sign" string.wrap return
      INVALID_BASE case "invalid base" string.wrap return
      EMPTY case "empty" string.wrap return
      INVALID_CHAR case "invalid character" string.wrap return
      UNSIGNED case "signed overflow" string.wrap return
      OVERFLOW case "overflow" string.wrap return
    end
  end
  proc( string : str -> string bool ) =>: export: parseSign
    str
      $ .length 0 == if
        false
      else $ 0 string.charAt '-' == _if
        1 string.tail true
      else $ 0 string.charAt '+' == _if
        1 string.tail false
      else
        false
      end
    return
  end
  proc( string : str  i32 : base bool : unsigned -> i64 ParserError ) =>: tryParseIntInternal
    0 i64 =: mut: res
    false =:: mut: overflow
    false =:: mut: signedOverflow
    str
      parseSign =:: sign
      ..dup .length 0 == if
        ..drop 0 ParserError .EMPTY return
      end
      base 0 == if
        resolveBase
      else
        base
      end =:: mBase
      mBase 0 < if ..drop
        0 ParserError .INVALID_CHAR return
      else mBase 2 < or mBase 62 > _if ..drop
        0 ParserError .INVALID_BASE return
      end
      -1:i64 =:: maxUnsignedVal
      sign if -0x8000_0000_0000_0000 else 0x7fff_ffff_ffff_ffff end =:: maxSignedVal
      unsigned if maxUnsignedVal else maxSignedVal end =:: maxVal
      maxVal mBase u/ =:: maxSafe
      maxUnsignedVal mBase u/ =:: maxSafeUnsigned
      0:i64 while $ $2 .length < do =:: i
        $ i string.charAt mBase parseDigit
          $ .DIGIT ?? ! if
            .IGNORED ?? and i 0 > if ..drop i 1 + continue end
            ..drop.2
            0 ParserError .INVALID_CHAR return
          else ..drop end
        i64 cast.u =:: delta
        res maxSafeUnsigned u> if
          true overflow=
        else res maxSafe u> _if
          true signedOverflow=
        end
        res
          mBase i64 cast.u *
          res maxSafeUnsigned == and $ maxUnsignedVal delta - u> if
            true overflow=
          else res maxSafe == and $ maxVal delta - u> _if
            true signedOverflow=
          end
          delta +
        res= ## add digit to number
        i 1 +
      end ..drop
    ..drop
    res
      sign and -_ unsigned if ParserError .SIGN return end
      overflow if ParserError .OVERFLOW return end
      signedOverflow if ParserError .UNSIGNED return end
    ParserError .NONE return
  end
  proc( string : str  i32 : base -> i64 ParserError ) =>: export: tryParseInt
    str base false tryParseIntInternal
  end
  proc( string : str  i32 : base -> i64 ParserError ) =>: export: tryParseUInt
    str base true tryParseIntInternal
  end
  proc( char8 : chr i32 : base -> bool ) =>: export: isExpChar
    chr switch
      'e' 'E' case
        base 15 < return
      'x' 'X' case
        base 10 > base 34 < & return
      '#' case
        true return
      default
        false return
    end
  end
  proc( string : str i32 : base -> f64 ParserError ) =>: export: tryParseFloat
    0:i64 =:: mut: c
    false bool =: mut: hasDot
    0:i64 =:: mut: e
    0:i64 =:: mut: val
    1:i64 59 << =:: mut: maxVal ## higher precision than f64, no overflow in base 62
    false =:: mut: cStyleHex
    str
      parseSign =:: sign
      ..dup .length 0 == if
        ..drop 0 f64 cast ParserError .EMPTY return
      end
      base 0 == if
        resolveBase
      else
        base
      end =:: mut: mBase
      mBase 0 < if ..drop
        f64.NaN ParserError .INVALID_CHAR return
      else mBase 2 < or mBase 62 > _if ..drop
        f64.NaN ParserError .INVALID_BASE return
      end
      0:i64 while ..dup ..over.2 .length < do =:: i
        ..dup i string.charAt '.' == if
          i 0 == or hasDot if ..drop ## . cannot be first character
            f64.NaN ParserError .INVALID_CHAR return
          end
          true hasDot=
        else ..dup i string.charAt mBase isExpChar _if
          i 0 == if ..drop ##-exp char cannot be first character
            f64.NaN ParserError .INVALID_CHAR return
          end
          i 1 + e=
          i break
        else ..dup i string.charAt ..dup 'p' == ..swap 'P' == | mBase 16 == & _if
          i 0 == if ..drop ##-exp char cannot be first character
            f64.NaN ParserError .INVALID_CHAR return
          end
          i 1 + e=
          true cStyleHex=
          10 mBase= ## exponent written in base 10
          c 4 * c= ## scale c to power of 2
          i break
        else
          $ i string.charAt mBase parseDigit
            $ .DIGIT ?? ! if
              .IGNORED ?? and i 0 > if ..drop i 1 + continue end
              ..drop.2
              f64.NaN ParserError .INVALID_CHAR return
            else ..drop end
          i64 cast.u =:: digit
          val maxVal < if
            val mBase i64 cast.u * digit + val=
            hasDot if
              c 1 - c=
            end
          else hasDot ! _if
            c 1 - c=
          end
        end
        i 1 +
      end ..drop
      e 0 > if
        ..dup e string.tail mBase tryParseInt
          ..dup .NONE ?? ! if =:: err
            ..drop.2 f64.NaN err return
          end ..drop
        c + c=
      end
    ..drop
    cStyleHex if ## calculate powers of 2 instead of powers of base
      2 mBase=
    end
    val f64 cast
      sign if -_ end
    c -100 < if
       ## split of factor of base^64 to prevent underflow of intermediate results
       mBase f64 cast c 64 + powI *
       mBase f64 cast 64 powI /
    else
       mBase f64 cast c powI *
    end
    hasDot or e 0 > if ParserError .NONE return else ParserError .INT return end
  end
end
