import numbers/printFloat
import numbers/printInt
import numbers/limits
import numbers/float
import string

namespace: i32
  proc( i32 : a i32 : b -> i32 ) =>: export: min
    a b < if a else b end
  end
  proc( i32 : a i32 : b -> i32 ) =>: export: max
    a b > if a else b end
  end
  proc( i32 : a -> i32 ) =>: export: abs
    a 0 < if a -_ else a end
  end
end
namespace: i64
  proc( i64 : a i64 : b -> i64 ) =>: export: min
    a b < if a else b end
  end
  proc( i64 : a i64 : b -> i64 ) =>: export: max
    a b > if a else b end
  end
  proc( i64 : a -> i64 ) =>: export: abs
    a 0 < if a -_ else a end
  end
end

namespace: number
  #:ifnot:exp
  #template type : T #end
  proc( T : x i64 : p -> T ) =>: export: powI
  #:else
  proc( type : auto: T  T : x i64 : p -> T ) =>: export: powI
  #:end
    p 0 == if
      1 T cast return
    else p 0 < _if
      1 T cast x / p -_ powI return
    end
    x =:: mut: xPow
    1 T cast
      p while ..dup 0 != do
        ..dup 1 & 0 != if
        ..swap
          xPow *
        ..swap
        end
        1 >>
        xPow xPow * xPow =
      end ..drop
    return
  end
  2 =:: export: MIN_BASE
  62 =:: export: MAX_BASE
  proc( i8 : chr i32 : base -> i32 ) =>: export: parseDigit
    chr '0' >= chr '9' <= & if
      chr '0' - return
    else chr 'A' >= chr 'Z' <= & _if
      chr 'A' - 10 + return
    else chr 'a' >= chr 'z' <= & _if
      chr 'a' -
        base 36 > if 36 else 10 end +
      return
    end
    -1 return
  end
  proc( string -> string i32 ) =>: export: resolveBase
    ..dup .length 2 < if
      10 return
    end
    ..dup 0 string.charAt '0' == if
      ..dup 1 string.charAt switch
        'b' 'B' case
          2 string.tail 2 return
        'o' 'O' case
          2 string.tail 8 return
        'x' 'X' case
          2 string.tail 16 return
        default
          ## default case needed due to bug in old compiler
          break
      end
    end
    ## arbitrary base numbers <BASE>b<NUMBER>
    ..dup 1 string.charAt 'b' ==
        ..over 1 string.charAt 'B' ==  | if
      ..dup 0 string.charAt '0' - i32 =: mut: b
      b 2 < b 9 > | if
        10 return ## invalid base -> return unmodified string
      end
      2 string.tail b return
    end
    ..dup .length 3 > if ..dup 2 string.charAt 'b' == if ## two digits before b
      ..dup 0 string.charAt '0' - =:: mut: b1
      ..dup 1 string.charAt '0' - =:: mut: b2
      b1 0 < b1 9 > | b2 0 < b2 9 > | | if
        10 return ## invalid base -> return unmodified string
      end
      b1 10 * b2 + =:: b
      b MAX_BASE > if
        10 return ## invalid base -> return unmodified string
      end
      3 string.tail b return
    end end
    10 return
  end
  enum( NONE INT SIGN INVALID_BASE EMPTY INVALID_CHAR OVERFLOW ) =:: export: ParserError
  proc( string : str  i32 : base bool : unsigned -> i64 ParserError ) =>: tryParseIntInternal
    false =:: mut: sign
    base =:: mut: mBase
    base 0 != base 2 < base 62 > | & if
      0 ParserError .INVALID_BASE return
    end
    0 i64 =: mut: res
    false =:: mut: overflow
    str
      ..dup .length 0 == if
        ..drop 0 ParserError .EMPTY return
      end
      ..dup 0 string.charAt '-' == if
        true sign =
        1 string.tail
      else ..dup 0 string.charAt '+' == _if
        1 string.tail
      end
      ..dup .length 0 == if
        ..drop 0 ParserError .EMPTY return
      end
      mBase 0 == if
        resolveBase mBase =
      end
      unsigned if -1 i64 cast else sign _if -0x8000_0000_0000_0000 else 0x7fff_ffff_ffff_ffff end =:: maxVal
      maxVal mBase ..udiv =:: maxSafe
      0 while ..dup ..over.2 .length < do
        ..over ..over string.charAt
          ..over 0 > ..over '_' == ..over.2 '\'' == | & if
            ..drop ## ignore _ and ' in numbers
            1 + continue
          end
        mBase parseDigit
          ..dup 0 < ..over mBase >= | if
            ..drop.3 0 ParserError .INVALID_CHAR return
          end
        res maxSafe > if
          true overflow =
        end
        res
          mBase *
          res maxSafe == if ## check last digit if previous value was exactly maxSafe
            maxVal ..over - ..over.2 < if
              true overflow =
            end
          end
          +
        res = ## add digit to number
        1 +
      end ..drop
    ..drop
    res
      sign if -_ end
    sign unsigned & if ParserError .SIGN return end
    overflow if ParserError .OVERFLOW return end
    ParserError .NONE return
  end
  proc( string : str  i32 : base -> i64 ParserError ) =>: export: tryParseInt
    str base false tryParseIntInternal
  end
  proc( string : str  i32 : base -> i64 ParserError ) =>: export: tryParseUInt
    str base true tryParseIntInternal
  end
  proc( i8 : chr i32 : base -> bool ) =>: isExpChar
    chr switch
      'e' 'E' case
        base 15 < return
      'x' 'X' case
        base 10 > base 34 < & return
      '#' case
        true return
      default
        false return
    end
  end
  proc( string : str i32 : base -> f64 ParserError ) =>: export: tryParseFloat
    false =:: mut: sign
    base =:: mut: mBase
    base 0 != base 2 < base 62 > | & if
      f64.NaN ParserError .INVALID_BASE return
    end
    0 i64 =: mut: c
    false bool =: mut: d
    0 i64 =: mut: e
    0 i64 =: mut: val
    1 i64 cast 56 << i64 =: mut: maxVal ## higher precision than f64, no overflow in base 62
    false =:: mut: cStyleHex
    str
      ..dup .length 0 == if
        ..drop 0 f64 cast ParserError .EMPTY return
      end
      ..dup 0 string.charAt '-' == if
        true sign =
        1 string.tail
      else ..dup 0 string.charAt '+' == _if
        1 string.tail
      end
      ..dup .length 0 == if
        ..drop 0 f64 cast ParserError .EMPTY return
      end
      mBase 0 == if
        resolveBase mBase =
      end
      0 while ..dup ..over.2 .length < do
        ..over ..over string.charAt '.' == if
          ..dup 0 == d | if ## . cannot be first character
            ..drop.2 f64.NaN ParserError .INVALID_CHAR return
          end
          true d =
        else ..over ..over string.charAt mBase isExpChar _if
          ..dup 0 == if ##-exp char cannot be first character
            ..drop.2 f64.NaN ParserError .INVALID_CHAR return
          end
          ..dup 1 + e =
          break
        else ..over ..over string.charAt ..dup 'p' == ..swap 'P' == | mBase 16 == & _if
          ..dup 0 == if ##-exp char cannot be first character
            ..drop.2 f64.NaN ParserError .INVALID_CHAR return
          end
          ..dup 1 + e =
          true cStyleHex =
          10 mBase = ## exponent written in base 10
          c 4 * c = ## scale c to power of 2
          break
        else ..over ..over string.charAt mBase parseDigit
          ..dup 0 < ..over mBase >= | if
            ..drop.3 f64.NaN ParserError .INVALID_CHAR return
          end
          val maxVal < if
            val mBase * + val =
            d if
              c 1 - c =
            end
          else ..drop d ! _if
            c 1 - c =
          end
        end
        1 +
      end ..drop
      e 0 > if
        ..dup e string.tail mBase tryParseInt
          ..dup .NONE ?? ! if =:: err
            ..drop.2 f64.NaN err return
          end ..drop
        c + c =
      end
    ..drop
    cStyleHex if ## calculate powers of 2 instead of powers of base
      2 mBase =
    end
    val f64 cast
      sign if -_ end
    mBase f64 cast  c -100 < if
       ## calculate power of 1/base instead of negative power of base and
       ## split of last factor to prevent underflow of intermediate results
       1 f64 cast ..swap /
       -1 c - powI *  mBase f64 cast /
    else
       c powI *
    end
    d  e 0 > | if ParserError .NONE return else ParserError .INT return end
  end
end
