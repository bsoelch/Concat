import core/integers
import core/floats

import numbers/floatToStr
import numbers/intToStr

## TODO? move to core
proc( char8 ptr.raw : chars iSize : k -> i128 ) =>: static: export: :i128
  char8 128 array : mut: errMessageBuffer
  chars k string.create =:: str
  str 0 i128.parse .Ok .if
    return
  else .Unsigned ._if
    return
  else ..drop end
  errMessageBuffer@ sb.wrapBuffer
    "invalid integer constant: `" sb.appendS
    str sb.appendStr
    '`' sb.appendC
  sb.asStr ..compiler.error i128.ZERO
end
proc( char8 ptr.raw : chars iSize : k -> f128 ) =>: static: export: :f128
  char8 128 array : mut: errMessageBuffer
  chars k string.create =:: str
  str 0 f128.parse .Ok .if
    return
  else ..drop end
  errMessageBuffer@ sb.wrapBuffer
    "invalid float constant: `" sb.appendS
    str sb.appendStr
    '`' sb.appendC
  sb.asStr ..compiler.error f128.ZERO
end
