import core/integers
import core/floats

import numbers/floatToStr
import numbers/intToStr
import string

namespace: number
  proc( type : auto: T  T : x i64 : p -> T ) =>: export: powI
    T f128 == if f128.ONE else 1 T cast end =:: ONE
    p 0 == if
      ONE return
    else p 0 < _if
      ONE x p -_ powI / return
    end
    x =:: mut: xPow
    ONE
      p while ..dup 0 != do
        ..dup 1 & 0 != if
        ..swap
          xPow *
        ..swap
        end
        1 >>
        xPow xPow * xPow=
      end ..drop
    return
  end
  2 =:: export: MIN_BASE
  62 =:: export: MAX_BASE
  enum( DIGIT IGNORED INVALID ) =:: export: DigitType
  proc( char8 : chr i32 : base -> i32 DigitType ) =>: export: parseDigit
    chr '0' >= and chr '9' <= if
      chr '0' - i32 cast.u
        $ base < if
          DigitType .DIGIT
        else
          DigitType .INVALID
        end
      return
    else chr 'A' >= and chr 'Z' <= _if
      chr 'A' - i32 cast.u 10 +
        $ base < if
          DigitType .DIGIT
        else
          DigitType .INVALID
        end
      return
    else chr 'a' >= and chr 'z' <= _if
      chr 'a' - i32 cast.u
        base 36 > if 36 else 10 end +
        $ base < if
          DigitType .DIGIT
        else
          DigitType .INVALID
        end
      return
    end
    -1
      chr '_' == or chr '\'' == if
        DigitType .IGNORED
      else
        DigitType .INVALID
      end
    return
  end
  proc( string i32 : base -> string i32 ) =>: export: resolveBase
    base 0 != if base return end
    $ .length 2:iSize u< if
      10 return
    end
    $ 0 string.charAt '0' == if
      $ 1 string.charAt =:: intType
      intType 'x' == or intType 'X' == if
        2 string.tail 16 return
      else intType 'b' == or intType 'B' == _if
        2 string.tail 2 return
      else intType 'o' == or intType 'O' == _if
        2 string.tail 8 return
      end
    end
    ## arbitrary base numbers <BASE>b<NUMBER>
    $ 1 string.charAt 'b' == or $ 1 string.charAt 'B' == if
      $ 0 string.charAt '0' - i32 cast.u =:: mut: b
      b 0 >= and b 9 <= if
        2 string.tail b return
      end
    else $ .length 3:iSize u> and $ 2 string.charAt 'b' == _if ## two digits before b
      $ 0 string.charAt '0' - i32 cast.u =:: mut: b1
      $ 1 string.charAt '0' - i32 cast.u =:: mut: b2
      b1 0 >= and b1 9 <= and b2 0 >= and b2 9 <= if
        b1 10 * b2 + =:: b
        3 string.tail b return
      end
    end
    10 return
  end
  enum( NONE INT SIGN INVALID_BASE EMPTY INVALID_CHAR UNSIGNED OVERFLOW ) =:: export: ParserError
  proc( ParserError -> string ) =>: export: errorString
    switch
      NONE case "" string.wrap return
      INT  case "float is integer" string.wrap return
      SIGN case "unsigned number has sign" string.wrap return
      INVALID_BASE case "invalid base" string.wrap return
      EMPTY case "empty" string.wrap return
      INVALID_CHAR case "invalid character" string.wrap return
      UNSIGNED case "signed overflow" string.wrap return
      OVERFLOW case "overflow" string.wrap return
    end
  end
  proc( string : str -> string bool ) =>: export: parseSign
    str
      $ .length 0:iSize == if
        false
      else $ 0 string.charAt '-' == _if
        1 string.tail true
      else $ 0 string.charAt '+' == _if
        1 string.tail false
      else
        false
      end
    return
  end
  proc( string : str  i32 : base bool : unsigned -> i64 ParserError ) =>: tryParseIntInternal
    0 i64 =: mut: res
    false =:: mut: overflow
    false =:: mut: signedOverflow
    str
      parseSign =:: sign
      ..dup .length 0:iSize == if
        ..drop 0 ParserError .EMPTY return
      end
      base resolveBase =:: mBase
      mBase 2 u< or mBase 62 u> if ..drop
        0 ParserError .INVALID_BASE return
      end
      -1:i64 =:: maxUnsignedVal
      sign if -0x8000_0000_0000_0000 else 0x7fff_ffff_ffff_ffff end =:: maxSignedVal
      unsigned if maxUnsignedVal else maxSignedVal end =:: maxVal
      maxVal mBase u/ =:: maxSafe
      maxUnsignedVal mBase u/ =:: maxSafeUnsigned
      0:iSize while $ $2 .length u< do =:: i
        $ i string.charAt mBase parseDigit
          $ .DIGIT ! if
            .IGNORED and i 0:iSize iSize.sgt if ..drop i 1:iSize + continue end
            ..drop.2
            0 ParserError .INVALID_CHAR return
          else ..drop end
        i64 cast.u =:: delta
        res maxSafeUnsigned u> if
          true overflow=
        else res maxSafe u> _if
          true signedOverflow=
        end
        res
          mBase i64 cast.u *
          res maxSafeUnsigned == and $ maxUnsignedVal delta - u> if
            true overflow=
          else res maxSafe == and $ maxVal delta - u> _if
            true signedOverflow=
          end
          delta +
        res= ## add digit to number
        i 1:iSize +
      end ..drop
    ..drop
    res
      sign and -_ unsigned if ParserError .SIGN return end
      overflow if ParserError .OVERFLOW return end
      signedOverflow if ParserError .UNSIGNED return end
    ParserError .NONE return
  end
  proc( string : str  i32 : base -> i64 ParserError ) =>: export: tryParseInt
    str base false tryParseIntInternal
  end
  proc( string : str  i32 : base -> i64 ParserError ) =>: export: tryParseUInt
    str base true tryParseIntInternal
  end
  proc( char8 : chr i32 : base -> bool ) =>: export: isExpChar
    chr switch
      'e' 'E' case
        base 15 < return
      'x' 'X' case
        base 10 > base 34 < & return
      '#' case
        true return
      default
        false return
    end
  end
  proc( string : str i32 : base -> f64 ParserError ) =>: export: tryParseFloat
    0:i64 =:: mut: c
    false bool =: mut: hasDot
    0:iSize =:: mut: e
    0:i64 =:: mut: val
    1:i64 59 << =:: mut: maxVal ## higher precision than f64, no overflow in base 62
    false =:: mut: cStyleHex
    str
      parseSign =:: sign
      ..dup .length 0:iSize == if
        ..drop 0 f64 cast ParserError .EMPTY return
      end
      base resolveBase =:: mut: mBase
      mBase 2 u< or mBase 62 u> if ..drop
        f64.NaN ParserError .INVALID_BASE return
      end
      0:iSize while ..dup ..over.2 .length u< do =:: i
        ..dup i string.charAt '.' == if
          i 0:iSize == or hasDot if ..drop ## . cannot be first character
            f64.NaN ParserError .INVALID_CHAR return
          end
          true hasDot=
        else ..dup i string.charAt mBase isExpChar _if
          i 0:iSize == if ..drop ##-exp char cannot be first character
            f64.NaN ParserError .INVALID_CHAR return
          end
          i 1:iSize + e=
          i break
        else ..dup i string.charAt ..dup 'p' == ..swap 'P' == | mBase 16 == & _if
          i 0:iSize == if ..drop ##-exp char cannot be first character
            f64.NaN ParserError .INVALID_CHAR return
          end
          i 1:iSize + e=
          true cStyleHex=
          10 mBase= ## exponent written in base 10
          c 4 * c= ## scale c to power of 2
          i break
        else
          $ i string.charAt mBase parseDigit
            $ .DIGIT ! if
              .IGNORED and i 0:iSize iSize.sgt if ..drop i 1:iSize + continue end
              ..drop.2
              f64.NaN ParserError .INVALID_CHAR return
            else ..drop end
          i64 cast.u =:: digit
          val maxVal < if
            val mBase i64 cast.u * digit + val=
            hasDot if
              c 1 - c=
            end
          else hasDot ! _if
            c 1 + c=
          end
        end
        i 1:iSize +
      end ..drop
      e 0:iSize iSize.sgt if
        ..dup e string.tail mBase tryParseInt
          ..dup .NONE ! if =:: err
            ..drop.2 f64.NaN err return
          end ..drop
        c + c=
      end
    ..drop
    cStyleHex if ## calculate powers of 2 instead of powers of base
      2 mBase=
    end
    val f64 cast
      sign if -_ end
    c -100 < if
       ## split of factor of base^64 to prevent underflow of intermediate results
       mBase f64 cast c 64 + powI *
       mBase f64 cast 64 powI /
    else
       mBase f64 cast c powI *
    end
    hasDot or e 0:iSize iSize.sgt if ParserError .NONE return else ParserError .INT return end
  end
end
namespace: i128
  proc(
    string : str
    i32 : base
    bool : unsigned
  -> i128 number.ParserError ) =>: export: parse
    using number.
    false =:: mut: overflow
    false =:: mut: signedOverflow
    str
      parseSign =:: sign
      ..dup .length 0:iSize == if ..drop
        0 0 i128 new ParserError .EMPTY return
      end
      base resolveBase =:: mBase
      mBase 2 u< or mBase 62 u> if ..drop
        i128.ZERO ParserError .INVALID_BASE return
      end
      -1:i64 -1:i64 i128 new =:: maxUnsigned
      unsigned if
        maxUnsigned
      else sign _if
        -0x8000_0000_0000_0000:i64 0:i64 i128 new
      else
        0x7fff_ffff_ffff_ffff:i64 -1:i64 i128 new
      end =:: maxVal
      0 0 i128 new =:: mut: res
      maxUnsigned mBase u/ =:: maxSafeUnsigned
      maxVal mBase u/ =:: maxSafe ## XXX? udiv i128 by i64
      0:iSize while ..dup ..over.2 .length u< do =:: i
        ..dup i string.charAt =:: c
        i 0:iSize iSize.sgt and c '_' == or c '\'' == if
          i 1:iSize + continue ## ignore _ and ' in numbers
        end
        c mBase parseDigit
          $ .DIGIT ! if
            .IGNORED and i 0:iSize iSize.sgt if ..drop i 1:iSize + continue end
            ..drop.2
            0 0 i128 new ParserError .INVALID_CHAR return
          else ..drop end
        i64 cast.u i128.fromU64 =:: delta
        res maxSafeUnsigned u> if
          true overflow=
        else res maxSafe u> _if
          true signedOverflow=
        end
        res
          mBase i128.fromU32 *
          res maxSafeUnsigned i128.eq and $ maxUnsigned delta - u> if
            true overflow=
          else res maxSafe i128.eq and $ maxVal delta - u> _if
            true signedOverflow=
          end
          delta +
        res=
        i 1:iSize +
      end ..drop
    ..drop
    res
      sign and -_ unsigned if ParserError .SIGN return end
      overflow if ParserError .OVERFLOW return end
      signedOverflow if ParserError .UNSIGNED return end
    ParserError .NONE return
  end
end
namespace: f128
  proc( string : str i32 : base -> f128 number.ParserError ) =>: export: parse
    using number.
    false =:: mut: sign
    0:i64 =:: mut: c
    false bool =: mut: hasDot
    0:iSize =:: mut: e
    0 0 i128 new =:: mut: val
    1:i64 56 << 0 i128 new =:: mut: maxVal ## higher precision than f128, no overflow in base 62
    false =:: mut: cStyleHex
    str
      ..dup .length 0:iSize == if
        ..drop 0 0 f128 new ParserError .EMPTY return
      end
      ..dup 0 string.charAt '-' == if
        true sign=
        1 string.tail
      else ..dup 0 string.charAt '+' == _if
        1 string.tail
      end
      ..dup .length 0:iSize == if
        ..drop 0 0 f128 new ParserError .EMPTY return
      end
      base resolveBase =:: mut: mBase
      mBase 2 u< or mBase 62 u> if ..drop
        f128.NaN ParserError .INVALID_BASE return
      end
      0:iSize while ..dup ..over.2 .length u< do =:: i
        ..dup i string.charAt '.' == if
          i 0:iSize == or hasDot if ..drop ## . cannot be first character
            f128.NaN ParserError .INVALID_CHAR return
          end
          true hasDot=
        else ..dup i string.charAt mBase isExpChar _if
          i 0:iSize == if ..drop ##-exp char cannot be first character
            f128.NaN ParserError .INVALID_CHAR return
          end
          i 1:iSize + e=
          i break
        else ..dup i string.charAt ..dup 'p' == ..swap 'P' == | mBase 16 == & _if
          i 0:iSize == if ..drop ##-exp char cannot be first character
            f128.NaN ParserError .INVALID_CHAR return
          end
          i 1:iSize + e=
          true cStyleHex=
          10 mBase= ## exponent written in base 10
          c 4 * c= ## scale c to power of 2
          i break
        else
          $ i string.charAt mBase parseDigit
            $ .DIGIT ! if
              .IGNORED and i 0:iSize iSize.sgt if ..drop i 1:iSize + continue end
              ..drop.2
            f128.NaN ParserError .INVALID_CHAR return
            else ..drop end
          i64 cast.u i128.fromU64 =:: digit
          val maxVal < if
            val mBase i128.fromU32 * digit + val=
            hasDot if
              c 1 - c=
            end
          else hasDot ! _if
            c 1 - c=
          end
        end
        i 1:iSize +
      end ..drop
      e 0:iSize iSize.sgt if
        ..dup e string.tail mBase tryParseInt
          ..dup .NONE ! if =:: err
            ..drop.2 f128.NaN err return
          end ..drop
        c + c=
      end
    ..drop
    cStyleHex if ## calculate powers of 2 instead of powers of base
      2 mBase=
    end
    val f128.fromI128
      sign if -_ end
    c 0 >= if
       mBase f128.fromI32 c powI *
    else c -1024 > _if
       mBase f128.fromI32 c -_ powI /
    else
       ## split of factor of base^64 to prevent underflow of intermediate results
       mBase f128.fromI32 c 1024 + -_ powI /
       mBase f128.fromI32 1024 powI /
    end
    hasDot or e 0:iSize iSize.sgt if ParserError .NONE return else ParserError .INT return end
  end
end
## TODO? move to core
## ? move number parser (as generic) to core/numbers
## make number parser accessible as <numType>.parse
proc( char8 ptr.raw : chars iSize : k -> i128 ) =>: static: export: :i128
  char8 128 array : mut: errMessageBuffer
  chars k string.create =:: str
  str 0 false i128.parse =:: err
  err .NONE or err .UNSIGNED if
    return
  else err .OVERFLOW _if
    errMessageBuffer@ sb.wrapBuffer
      "integer literal overflows size for type i128: `" sb.appendS
      str sb.appendStr
      '`' sb.appendC
    sb.asStr ..compiler.warning
    return
  end
  errMessageBuffer@ sb.wrapBuffer
    "invalid integer constant: `" sb.appendS
    str sb.appendStr
    '`' sb.appendC
  sb.asStr ..compiler.error
end
proc( char8 ptr.raw : chars iSize : k -> f128 ) =>: static: export: :f128
  char8 128 array : mut: errMessageBuffer
  chars k string.create =:: str
  str 0 f128.parse =:: err
  err .NONE or err .INT if
    return
  else err .OVERFLOW _if
    errMessageBuffer@ sb.wrapBuffer
      "float literal overflows size for type f128: `" sb.appendS
      str sb.appendStr
      '`' sb.appendC
    sb.asStr ..compiler.warning
    return
  end
  errMessageBuffer@ sb.wrapBuffer
    "invalid float constant: `" sb.appendS
    str sb.appendStr
    '`' sb.appendC
  sb.asStr ..compiler.error
end
