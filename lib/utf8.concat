#include stringBuilder


#namespace utf8
  i32 =:: public codePoint
  -1 codePoint =: public UNKNOWN_CODEPOINT
  0x10FFFF codePoint =: public MAX_CODEPOINT
#end

#namespace sb
  proc( stringBuilder : sb utf8.codePoint : cp => stringBuilder ) =: public appendCodePoint
    cp 0 < if ## invalid code point
      sb return
    end
    cp 0x80 < if ## 0*** ****
      sb cp i8 cast sb.appendC return
    end
    cp 0x800 < if ## 110* **** 10** ****
      sb
        cp 6 >>   0xc0 | i8 cast sb.appendC
        cp 0x3f & 0x80 | i8 cast sb.appendC
      return
    end
    cp 0x10000 < if ## 1110 **** 10** **** 10** ****
      sb
        cp 12 >>        0xe0 | i8 cast sb.appendC
        cp  6 >> 0x3f & 0x80 | i8 cast sb.appendC
        cp       0x3f & 0x80 | i8 cast sb.appendC
      return
    end
    cp 0x200000 < if ## 1111 0*** 10** **** 10** **** 10** ****
      sb
        cp 18 >>        0xf0 | i8 cast sb.appendC
        cp 12 >> 0x3f & 0x80 | i8 cast sb.appendC
        cp  6 >> 0x3f & 0x80 | i8 cast sb.appendC
        cp       0x3f & 0x80 | i8 cast sb.appendC
      return
    end
    ## not valid code-points but still UTF-8 encodable
    cp 0x4000000 < if ## 1111 10** 10** **** 10** **** 10** **** 10** ****
      sb
        cp 24 >>        0xf8 | i8 cast sb.appendC
        cp 18 >> 0x3f & 0x80 | i8 cast sb.appendC
        cp 12 >> 0x3f & 0x80 | i8 cast sb.appendC
        cp  6 >> 0x3f & 0x80 | i8 cast sb.appendC
        cp       0x3f & 0x80 | i8 cast sb.appendC
      return
    end
    ## 1111 110* 10** **** 10** **** 10** **** 10** **** 10** ****
    sb
      cp 30 >>        0xfc | i8 cast sb.appendC
      cp 24 >> 0x3f & 0x80 | i8 cast sb.appendC
      cp 18 >> 0x3f & 0x80 | i8 cast sb.appendC
      cp 12 >> 0x3f & 0x80 | i8 cast sb.appendC
      cp  6 >> 0x3f & 0x80 | i8 cast sb.appendC
      cp       0x3f & 0x80 | i8 cast sb.appendC
    return
  end
#end
#namespace utf8
  proc( codePoint => bool ) =: public isValid
    #dup 0 >= #swap MAX_CODEPOINT <= & return
  end
  proc( string  : str i64 : index => string i64 codePoint ) =: public nextCodePoint
    index str .length >= if
      str str .length UNKNOWN_CODEPOINT return
    end
    str index string.charAt 0 >= if ## 0x00 - 0x7f
      str index 1 + str index string.charAt codePoint cast return
    end
    index =:: mut i
    while str i string.charAt 0xc0 & 0x80 == do
      i 1 + i =
      i str .length >= if
        str str .length UNKNOWN_CODEPOINT return
      end
    end
    str i string.charAt 0xff & =:: c
    ## TODO read multi-byte unicode sequences
    c 0b1110_0000 < if ## 110 ...
    
    end
    c 0b1111_0000 < if ## 1110 ...
    
    end
    c 0b1111_1000 < if ## 1111 0...
    
    end
    c 0b1111_1100 < if ## 1111 10...
    
    end
    c 0b1111_1110 < if ## 1111 110...
    
    end    
    str i 1 + UNKNOWN_CODEPOINT return
  end

#end
