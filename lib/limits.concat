
#namespace i32
  -0x8000_0000 i32 =: public MIN
   0x7fff_ffff i32 =: public MAX
#end
#namespace i64
  -0x8000_0000_0000_0000 i64 =: public MIN
   0x7fff_ffff_ffff_ffff i64 =: public MAX
#end
#namespace float
  ## XXX min/max/eps
  proc( => float ) =: public Infinity 
    1 float cast 0 float cast / return
  end
  proc( => float ) =: public -Infinity 
    -1 float cast 0 float cast / return
  end
  proc( => float ) =: public NaN 
    0 float cast 0 float cast / return
  end
#end
#namespace double
  ## XXX min/max/eps
  proc( => double ) =: public Infinity 
    1 double cast 0 double cast / return
  end
  proc( => float ) =: public -Infinity 
    -1 double cast 0 double cast / return
  end
  proc( => float ) =: public NaN 
    0 double cast 0 double cast / return
  end
#end
