import core/itr
import core/integers
import core/ptr

import mem
import arrayView
import optional
import list

## XXX allow auto-cast from list -> arrayView
#+
arena allocator
  * allows to allocate memory in mostly linear
  * can allocate single elements or arrays of a given type
  * all elements allocated after a specific point can be freed at once
  * if strictOrder is false some elements may be freed out of order
+#
namespace: arenaAlloc ## XXX? rename to `arena`
  enum( CONTINUE ALLOC ) =:: SliceType
  ( type : T -> type ) =>: ArenaSlice
    struct(
      T _ ptr.mut : data
      i32 : mut: eltCount
      SliceType : sliceType
    )
  end
end
( type : T -> type ) =>: export: ArenaAllocator
  struct(
    T arenaAlloc.ArenaSlice list : mut: slices
    ( T ptr -> ) ptr optional : freeElt
    i32 : mut: fullSlices ## number of completely filled slices at bottom of allocated area
    i32 : sliceSizeShift ## XXX? use i8 instead?
    bool : strictOrder
  )
end
namespace: arenaAlloc
  proc(
    type : auto: T
    ## size of a given memory slice, will be rounded to the nearest power of two
    i32 : sliceSize
    ( T ptr -> ) ptr optional : freeElt
    ## new elements have be be allocated in strictly increasing order, this may be less memory efficient
    bool : strictOrder
  -> T ArenaAllocator ) =>: create_internal
    ## XXX? nearest of next largest power of 2
    ## XXX? find better way to convert slice size to power of 2
    8 =:: mut: sizeBits ## 2**8= 256
    sliceSize 8 >>> while $ 1 > do
      sizeBits 1 + sizeBits@ =
      1 >>>
    end ..drop
    ## ArenaAllocator
      16 T ArenaSlice list.create
      freeElt
      0
      sizeBits
      strictOrder
    T ArenaAllocator new
  end
  proc(
    type : auto: T
    ## size of a given memory slice, will be rounded to the nearest power of two
    i32 : sliceSize
    ## new elements have be be allocated in strictly increasing order, this may be less memory efficient
    bool : strictOrder
    ( T ptr -> ) ptr : freeElt
  -> T ArenaAllocator ) =>: create_FS
    sliceSize freeElt optional.wrap strictOrder create_internal
  end
  proc(
    type : auto: T
    ## size of a given memory slice, will be rounded to the nearest power of two
    i32 : sliceSize
    ( T ptr -> ) ptr : freeElt
  -> T ArenaAllocator ) =>: create_F
    sliceSize freeElt optional.wrap false create_internal
  end
  proc(
    ## size of a given memory slice, will be rounded to the nearest power of two
    i32 : sliceSize
    ## new elements have be be allocated in strictly increasing order, this may be less memory efficient
    bool : strictOrder
    type : T
  -> T ArenaAllocator ) =>: create_S
    sliceSize ( T ptr -> ) ptr optional.empty strictOrder create_internal
  end
  proc(
    ## size of a given memory slice, will be rounded to the nearest power of two
    i32 : sliceSize
    type : T
  -> T ArenaAllocator ) =>: create_0
    sliceSize ( T ptr -> ) ptr optional.empty false create_internal
  end
  overload: export: create
    create_0
    create_F
    create_S
    create_FS
  end

  proc( type : auto: T T ArenaAllocator : arena -> i64 ) =>: export: currentCap
    arena .slices .length arena .sliceSizeShift << return
  end
  proc(
    type : auto: T
    T ArenaAllocator : arena0
    i64 : newCap
  -> T ArenaAllocator ) =>: export: ensureCap
    newCap arena0 currentCap <= if arena0 return end
    1 arena0 .sliceSizeShift << =:: sliceSize
    newCap
      sliceSize 1 - i64 cast.u +
      arena0 .sliceSizeShift >>>
    =:: minSlices
    arena0 .slices .length minSlices >= if  arena0 return end
    arena0 =:: mut: arena
    arena .slices
      minSlices list.ensureCap
      minSlices $1 .length - for ..drop
        sliceSize i64 cast.u T mem.alloc 0 SliceType .ALLOC T ArenaSlice new list.append
      end
    arena@ .slices=
    arena return
  end
  proc(
    type : auto: T
    T ArenaAllocator : arena0
    i32 : count
  -> T ArenaAllocator T _ ptr.mut ) =>: alloc_internal
    count 0 >= "count is non-negative" assert
    count 0 == if arena0 0 T _ ptr.mut cast! return end
    1 arena0 .sliceSizeShift << =:: sliceSize
    arena0 =:: mut: arena
    arena .strictOrder ! if
      ## search for gaps in previous slices
      arena .fullSlices i64 cast.u while $ arena .slices .length < do =:: i
        arena .slices i list.at .data =:: slice
        slice [] .eltCount sliceSize == if
          ## slice full -> skip on next allocation
          arena .fullSlices 1 + arena@ .fullSlices=
        end
        slice [] .eltCount count + sliceSize u<= if
          arena slice [] .data slice [] .eltCount i64 cast.u +
            slice [] .eltCount count + slice .eltCount=
          return
        end
      finally i 1 + end ..drop
    end
    arena .slices .length 0 > and
        arena .slices $ .length 1 - list.at .data =:: lastSlice
        lastSlice [] .eltCount count + sliceSize u<= if
      ## return
        arena
        lastSlice [] .data lastSlice [] .eltCount i64 cast.u +
          lastSlice [] .eltCount count + lastSlice .eltCount=
      return
    end
    ## new data does not fit into last slice
    count i64 cast.u sliceSize i64 cast.u 1 - + arena0 .sliceSizeShift >>> =:: newSlices
    newSlices 1 >= "at least one new slice" assert
    newSlices arena0 .sliceSizeShift << T mem.alloc =:: sliceData
    arena .slices
      sliceData count sliceSize i32.umin SliceType .ALLOC T ArenaSlice new list.append
      count sliceSize - =:: mut: newCount
      sliceData sliceSize i64 cast.u + =:: mut: newOffset
      newSlices 1 - for ..drop
        newCount 0 > "remaining count >0" assert
        ## ArenaSlice
          newOffset
          newCount sliceSize i32.umin
        SliceType .CONTINUE T ArenaSlice new list.append
        newOffset sliceSize i64 cast.u + newOffset@ =
        newCount sliceSize - newCount@ =
      end
    arena@ .slices=
    arena sliceData return
  end

  proc(
    type : auto: T
    T ArenaAllocator : arena
  -> T ArenaAllocator T ptr.mut ) =>: export: alloc
    arena 1 alloc_internal T ptr.mut cast!
  end
  proc(
    type : auto: T
    T ArenaAllocator : arena
    i32 : size
  -> T ArenaAllocator T arrayView.mut ) =>: export: allocArray
    size 0 == if
      arena T array.emptyMutable return
    end
    arena size alloc_internal size array.createMutable
  end

  ## XXX? distinguish: Value -> index (?push) and Value -> ptr (?copy)
  proc(
    type : auto: T
    T ArenaAllocator : arena
    T : value
  -> T ArenaAllocator T ptr.mut ) =>: export: copyValue
    value =:: valData ##XXX remove intermediate step once address of arguments are fully supported
    arena 1 alloc_internal
      valData@ 1 mem.copy T ptr.mut cast!
    return
  end
  proc(
    type : auto: T
    T ArenaAllocator : arena
    T ptr : value
  -> T ArenaAllocator T ptr.mut ) =>: export: copyPtr
    arena 1 alloc_internal
      value 1 mem.copy T ptr.mut cast!
    return
  end
  proc(
    type : auto: T
    i32 : auto: k
    T ArenaAllocator : arena
    T k ptr : values
  -> T ArenaAllocator T k ptr.mut ) =>: export: copyPtrs
    arena k alloc_internal
      values k i64 cast.u mem.copy T k ptr.mut cast!
    return
  end
  proc(
    type : auto: T
    T ArenaAllocator : arena
    T arrayView : values
  -> T ArenaAllocator T arrayView.mut ) =>: export: copyArray
    arena values .length i32 cast.u alloc_internal
      values .data values .length mem.copy values .length array.createMutable
    return
  end
  proc(
    type : auto: T
    T ArenaAllocator : arena
    T arrayView.mut : values
  -> T ArenaAllocator T arrayView.mut ) =>: export: copyMutableArray
    arena values .length i32 cast.u alloc_internal
      values .data values .length mem.copy values .length array.createMutable
    return
  end
  proc(
    type : auto: T
    T ArenaAllocator : arena
    T list : values
  -> T ArenaAllocator T arrayView.mut ) =>: export: copyList
    arena values .length i32 cast.u alloc_internal
      values .data values .length mem.copy values .length array.createMutable
    return
  end

  ## TODO get value(s) at offset
  ## TODO versions of push returning index instead of pointer

  proc( type : auto: T T ArenaAllocator : arena -> i64 ) =>: export: offset
    arena .slices .length
      $ =:: sliceCount
      sliceCount 0 > if
        1 - arena .sliceSizeShift <<
        arena .slices
          sliceCount 1 -
        list.at .data [] .eltCount i64 cast.u +
      end
    return
  end
  proc(
    type : auto: T
    T ArenaAllocator : arena0
    i64 : newLength
  -> T ArenaAllocator ) =>: export: reset
    newLength 1:i64 arena0 .sliceSizeShift << 1 - & i32 cast =:: newEltCount
    newLength
      arena0 .sliceSizeShift >>>
      newEltCount 0 u> if 1 + end
    =:: newSliceCount
    newSliceCount arena0 .slices .length <= "reset point inside allocated slice" assert
    arena0 =:: mut: arena ## XXX? prevent copy of old slice data
    arena .slices =:: mut: slices
    arena .freeElt =:: freeElt
    0 =:: mut: continueChunkCount ## continue chunks after last chunk
    slices .length 1 - while $ newSliceCount >= do =:: i
      slices i list.at .data =:: slice
      freeElt optional.hasData if
        slice [] .eltCount 1 - while $ 0 >= do =:: j
          slice [] .data j i64 cast.u + T ptr cast! freeElt .data ()
        finally j 1 - end ..drop
      end
      slice [] .sliceType switch
        ALLOC case
          0 continueChunkCount@ =
          slice [] .data mem.free
          break
        CONTINUE case
          continueChunkCount 1 + continueChunkCount@ = break
      end
    finally i 1 - end ..drop
    slices
      newSliceCount continueChunkCount i64 cast.u + list.setLength
    slices@ =
    newEltCount 0 == if
      arena .fullSlices
        ## adjust number of full slices
        newSliceCount i32 cast i32.min
      arena@ .fullSlices=
      slices arena@ .slices=
      arena return
    end
    newSliceCount 0 > "arena with elements has slice" assert
    arena .fullSlices
      ## adjust number of full slices
      newSliceCount i32 cast 1 - i32.min
    arena@ .fullSlices=
    ## shrink last slice if neccessary
    slices newSliceCount 1 - list.at .data =:: lastSlice
    lastSlice [] .eltCount newEltCount >= "reset point inside allocated memory" assert
    freeElt optional.hasData if
      lastSlice [] .eltCount 1 - while $ newEltCount >= do =:: j
        lastSlice [] .data j i64 cast.u + T ptr cast! freeElt .data ()
      finally j 1 - end ..drop
    end
    lastSlice [] .eltCount newEltCount > if
      newEltCount lastSlice .eltCount=
    end
    slices arena@ .slices=
    arena return
  end
  proc(
    type : auto: T
    T ArenaAllocator : arena0
  -> T ArenaAllocator ) =>: export: free
    ## free allocated memory
    arena0 0 reset =:: mut: arena
    ## free internal list
    arena .slices list.free arena@ .slices=
    arena return
  end
end

## Arena Allocator for mixed types
## TODO? special type-constant for max-aligned type
## TODO? switch to i8-allocator& align elements seperately
i64 =:: MaxAlign
MaxAlign ArenaAllocator =:: export: MixedArenaAllocator
namespace: mixedArena
  proc( i64 -> i32 ) =>: alignSize
    MaxAlign ..types.stride 1 - + MaxAlign ..types.stride u/ i32 cast
  end
  proc(
    ## size of a given memory slice, will be rounded to the nearest power of two
    i32 : sliceSize
    ## new elements have be be allocated in strictly increasing order, this may be less memory efficient
    bool : strictOrder
  -> MixedArenaAllocator ) =>: export: create_S
    ## create_internal
      sliceSize i64 cast.u MaxAlign ..types.stride u/ i32 cast
      ( MaxAlign ptr -> ) ptr optional.empty
      strictOrder
    arenaAlloc.create_internal MixedArenaAllocator cast
  end
  proc(
    ## size of a given memory slice, will be rounded to the nearest power of two
    i32 : sliceSize
  -> MixedArenaAllocator ) =>: export: create_0
    ## create_internal
      sliceSize i64 cast.u MaxAlign ..types.stride u/ i32 cast
      ( MaxAlign ptr -> ) ptr optional.empty
      false
    arenaAlloc.create_internal MixedArenaAllocator cast
  end
  overload: export: create create_0 create_S end

  proc(
    MixedArenaAllocator : arena
    type : T
  -> MixedArenaAllocator T ptr.mut ) =>: export: alloc
    arena MaxAlign ArenaAllocator cast
      T ..types.stride alignSize arenaAlloc.alloc_internal =:: res
    MixedArenaAllocator cast
    res T ptr.mut cast!
  end
  proc(
    MixedArenaAllocator : arena
    i32 : size
    type : T
  -> MixedArenaAllocator T arrayView.mut ) =>: export: allocArray
    size 0 == if
      arena T array.emptyMutable return
    end
    arena MaxAlign ArenaAllocator cast
      T ..types.stride size i64 cast.u * alignSize arenaAlloc.alloc_internal =:: res
    MixedArenaAllocator cast
    res T _ ptr.mut cast! size array.createMutable
  end

  proc(
    type : auto: T
    MixedArenaAllocator : arena
    T : value
  -> MixedArenaAllocator T ptr.mut ) =>: export: copyValue
    value =:: valData ##XXX remove intermediate step once address of arguments are fully supported
    arena T alloc
      valData@ 1 mem.copy T ptr.mut cast!
    return
  end
  proc(
    type : auto: T
    MixedArenaAllocator : arena
    T ptr : value
  -> MixedArenaAllocator T ptr.mut ) =>: export: copyPtr
    arena T alloc
      value 1 mem.copy T ptr.mut cast!
    return
  end
  proc(
    type : auto: T
    i32 : auto: k
    MixedArenaAllocator : arena
    T k ptr : values
  -> MixedArenaAllocator T k ptr.mut ) =>: export: copyPtrs
    arena k T allocArray .data
      values k i64 cast.u mem.copy T k ptr.mut cast!
    return
  end
  proc(
    type : auto: T
    MixedArenaAllocator : arena
    T arrayView : values
  -> MixedArenaAllocator T arrayView.mut ) =>: export: copyArray
    arena values .length i32 cast.u T allocArray .data
      values .data values .length mem.copy values .length array.createMutable
    return
  end
  proc(
    type : auto: T
    MixedArenaAllocator : arena
    T arrayView.mut : values
  -> MixedArenaAllocator T arrayView.mut ) =>: export: copyMutableArray
    arena values .length i32 cast.u T allocArray .data
      values .data values .length mem.copy values .length array.createMutable
    return
  end
  proc(
    type : auto: T
    MixedArenaAllocator : arena
    T list : values
  -> MixedArenaAllocator T arrayView.mut ) =>: export: copyList
    arena values .length i32 cast.u T allocArray .data
      values .data values .length mem.copy values .length array.createMutable
    return
  end

  proc( MixedArenaAllocator : arena -> i64 ) =>: export: offset
    arena MaxAlign ArenaAllocator cast arenaAlloc.offset
  end
  proc(
    MixedArenaAllocator : arena
    i64 : newLength
  -> MixedArenaAllocator ) =>: export: reset
    arena MaxAlign ArenaAllocator cast
      newLength arenaAlloc.reset
    MixedArenaAllocator cast
  end

  proc(
    MixedArenaAllocator : arena0
  -> MixedArenaAllocator ) =>: export: free
    ## free allocated memory
    arena0 MaxAlign ArenaAllocator cast 0 arenaAlloc.reset =:: mut: arena
    ## free internal list
    arena .slices list.free arena@ .slices=
    arena MixedArenaAllocator cast return
  end
end
