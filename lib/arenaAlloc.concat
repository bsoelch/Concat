import core/itr
import core/integers
import core/ptr

import mem
import slice
import optional
import list

#+
arena allocator
  * allows to allocate memory in mostly linear
  * can allocate single elements or arrays of a given type
  * all elements allocated after a specific point can be freed at once
  * if strictOrder is false some elements may be freed out of order
+#
namespace: arenaAlloc ## XXX? rename to `arena`
  enum( CONTINUE ALLOC ) =:: ChunkType
  ( type : T -> type ) =>: ArenaChunk
    struct(
      T ptr.raw.mut : data
      i32 : mut: eltCount
      ChunkType : chunkType
    )
  end
end
( type : T -> type ) =>: export: ArenaAllocator
  struct(
    T arenaAlloc.ArenaChunk list : mut: chunks
    ( T ptr -> ) ptr optional : freeElt
    i32 : mut: fullChunks ## number of completely filled chunks at bottom of allocated area
    i32 : chunkSizeShift ## XXX? use i8 instead?
    bool : strictOrder
  )
end
namespace: arenaAlloc
  proc(
    type : auto: T
    ## size of a given memory chunk, will be rounded to the nearest power of two
    i32 : chunkSize
    ( T ptr -> ) ptr optional : freeElt
    ## new elements have be be allocated in strictly increasing order, this may be less memory efficient
    bool : strictOrder
  -> T ArenaAllocator ) =>: create_internal
    ## XXX? nearest of next largest power of 2
    ## XXX? find better way to convert chunk size to power of 2
    8 =:: mut: sizeBits ## 2**8= 256
    chunkSize 8 >>> while $ 1 > do
      sizeBits 1 + sizeBits=
      1 >>>
    end ..drop
    ## ArenaAllocator
      16 T ArenaChunk list.create
      freeElt
      0
      sizeBits
      strictOrder
    T ArenaAllocator new
  end
  proc(
    type : auto: T
    ## size of a given memory chunk, will be rounded to the nearest power of two
    i32 : chunkSize
    ## new elements have be be allocated in strictly increasing order, this may be less memory efficient
    bool : strictOrder
    ( T ptr -> ) ptr : freeElt
  -> T ArenaAllocator ) =>: create_FS
    chunkSize freeElt optional.wrap strictOrder create_internal
  end
  proc(
    type : auto: T
    ## size of a given memory chunk, will be rounded to the nearest power of two
    i32 : chunkSize
    ( T ptr -> ) ptr : freeElt
  -> T ArenaAllocator ) =>: create_F
    chunkSize freeElt optional.wrap false create_internal
  end
  proc(
    ## size of a given memory chunk, will be rounded to the nearest power of two
    i32 : chunkSize
    ## new elements have be be allocated in strictly increasing order, this may be less memory efficient
    bool : strictOrder
    type : T
  -> T ArenaAllocator ) =>: create_S
    chunkSize ( T ptr -> ) ptr optional.empty strictOrder create_internal
  end
  proc(
    ## size of a given memory chunk, will be rounded to the nearest power of two
    i32 : chunkSize
    type : T
  -> T ArenaAllocator ) =>: create_0
    chunkSize ( T ptr -> ) ptr optional.empty false create_internal
  end
  overload: export: create
    create_0
    create_F
    create_S
    create_FS
  end

  proc( type : auto: T T ArenaAllocator : arena -> i64 ) =>: export: currentCap
    arena .chunks .length arena .chunkSizeShift << return
  end
  proc(
    type : auto: T
    T ArenaAllocator : arena0
    i64 : newCap
  -> T ArenaAllocator ) =>: export: ensureCap
    newCap arena0 currentCap <= if arena0 return end
    1 arena0 .chunkSizeShift << =:: chunkSize
    newCap
      chunkSize 1 - i64 cast.u +
      arena0 .chunkSizeShift >>>
    =:: minChunks
    arena0 .chunks .length minChunks >= if  arena0 return end
    arena0 =:: mut: arena
    arena .chunks
      minChunks list.ensureCap
      minChunks $1 .length - for ..drop
        chunkSize i64 cast.u T mem.alloc 0 ChunkType .ALLOC T ArenaChunk new list.append
      end
    arena@ .chunks=
    arena return
  end
  proc(
    type : auto: T
    T ArenaAllocator : arena0
    i32 : count
  -> T ArenaAllocator T ptr.raw.mut ) =>: alloc_internal
    count 0 >= "count is non-negative" assert
    count 0 == if arena0 0 T ptr.raw.mut cast! return end
    1 arena0 .chunkSizeShift << =:: chunkSize
    arena0 =:: mut: arena
    arena .strictOrder ! if
      ## search for gaps in previous chunks
      arena .fullChunks while $ iSize cast.u arena .chunks .length u< do =:: i
        arena .chunks i @[] =:: chunk
        chunk [] .eltCount chunkSize == if
          ## chunk full -> skip on next allocation
          arena .fullChunks 1 + arena@ .fullChunks=
        end
        chunk [] .eltCount count + chunkSize u<= if
          arena chunk [] .data chunk [] .eltCount @[]
            chunk [] .eltCount count + chunk .eltCount=
          return
        end
      finally i 1 + end ..drop
    end
    arena .chunks .length 0:iSize != and
        arena .chunks $ .length 1:iSize - @[] =:: lastChunk
        lastChunk [] .eltCount count + chunkSize u<= if
      ## return
        arena
        lastChunk [] .data lastChunk [] .eltCount @[]
          lastChunk [] .eltCount count + lastChunk .eltCount=
      return
    end
    ## new data does not fit into last chunk
    count iSize cast.u chunkSize iSize cast.u 1:iSize - + arena0 .chunkSizeShift >>> =:: newChunks
    newChunks 1:iSize u>= "at least one new chunk" assert
    newChunks arena0 .chunkSizeShift << T mem.alloc =:: chunkData
    arena .chunks
      chunkData count chunkSize i32.umin ChunkType .ALLOC T ArenaChunk new list.append
      count chunkSize - =:: mut: newCount
      chunkData chunkSize @[] =:: mut: newOffset
      newChunks 1:iSize - for ..drop
        newCount 0 > "remaining count >0" assert
        ## ArenaChunk
          newOffset
          newCount chunkSize i32.umin
        ChunkType .CONTINUE T ArenaChunk new list.append
        newOffset chunkSize @[] newOffset=
        newCount chunkSize - newCount=
      end
    arena@ .chunks=
    arena chunkData return
  end

  proc(
    type : auto: T
    T ArenaAllocator : arena
  -> T ArenaAllocator T ptr.mut ) =>: export: alloc
    arena 1 alloc_internal T ptr.mut cast!
  end
  proc(
    type : auto: T
    T ArenaAllocator : arena
    i32 : size
  -> T ArenaAllocator T slice.mut ) =>: export: allocSlice
    size 0 == if
      arena T slice.emptyMutable return
    end
    arena size alloc_internal size slice.createMutable
  end

  ## XXX? distinguish: Value -> index (?push) and Value -> ptr (?copy)
  proc(
    type : auto: T
    T ArenaAllocator : arena
    T : value
  -> T ArenaAllocator T ptr.mut ) =>: export: copyValue
    value =:: valData ##XXX remove intermediate step once address of arguments are fully supported
    arena 1 alloc_internal
      valData@ 1:iSize mem.copy T ptr.mut cast!
    return
  end
  proc(
    type : auto: T
    T ArenaAllocator : arena
    T ptr : value
  -> T ArenaAllocator T ptr.mut ) =>: export: copyPtr
    arena 1 alloc_internal
      value 1:iSize mem.copy T ptr.mut cast!
    return
  end
  proc(
    type : auto: T
    i32 : auto: k
    T ArenaAllocator : arena
    T k ptr : values
  -> T ArenaAllocator T k ptr.mut ) =>: export: copyPtrs
    arena k alloc_internal
      values k iSize cast.u mem.copy T k ptr.mut cast!
    return
  end
  proc(
    type : auto: T
    T ArenaAllocator : arena
    T slice : values
  -> T ArenaAllocator T slice.mut ) =>: export: copySlice
    arena values .length i32 cast.u alloc_internal
      values .data values .length mem.copy values .length slice.createMutable
    return
  end
  proc(
    type : auto: T
    T ArenaAllocator : arena
    T slice.mut : values
  -> T ArenaAllocator T slice.mut ) =>: export: copyMutableSlice
    arena values .length i32 cast.u alloc_internal
      values .data values .length mem.copy values .length slice.createMutable
    return
  end
  proc(
    type : auto: T
    T ArenaAllocator : arena
    T list : values
  -> T ArenaAllocator T slice.mut ) =>: export: copyList
    arena values .length alloc_internal
      values .data values .length mem.copy values .length slice.createMutable
    return
  end

  ## TODO get value(s) at offset
  ## TODO versions of push returning index instead of pointer

  proc( type : auto: T T ArenaAllocator : arena -> i64 ) =>: export: offset
    arena .chunks .length i64 cast.u
      $ =:: chunkCount
      chunkCount 0 > if
        1 - arena .chunkSizeShift <<
        arena .chunks
          chunkCount 1 -
        @[] .eltCount [] i64 cast.u +
      end
    return
  end
  proc(
    type : auto: T
    T ArenaAllocator : arena0
    i64 : newLength
  -> T ArenaAllocator ) =>: export: reset
    newLength 1:i64 arena0 .chunkSizeShift << 1 - & i32 cast =:: newEltCount
    newLength
      arena0 .chunkSizeShift >>>
      newEltCount 0 u> if 1 + end
    =:: newChunkCount
    newChunkCount arena0 .chunks .length i64 cast.u <= "reset point inside allocated chunk" assert
    arena0 =:: mut: arena ## XXX? prevent copy of old chunk data
    arena .chunks =:: mut: chunks
    arena .freeElt =:: freeElt
    0 =:: mut: continueChunkCount ## continue chunks after last chunk
    chunks .length i64 cast.u 1 - while $ newChunkCount >= do =:: i
      chunks i @[] =:: chunk
      freeElt .if =:: eltData
        chunk [] .eltCount 1 - while $ 0 >= do =:: j
          chunk [] .data j @[] T ptr cast! eltData ()
        finally j 1 - end ..drop
      end
      chunk [] .chunkType switch
        ALLOC case
          0 continueChunkCount=
          chunk [] .data mem.free
          break
        CONTINUE case
          continueChunkCount 1 + continueChunkCount= break
      end
    finally i 1 - end ..drop
    chunks
      newChunkCount continueChunkCount i64 cast.u + list.setLength
    chunks=
    newEltCount 0 == if
      arena .fullChunks
        ## adjust number of full chunks
        newChunkCount i32 cast i32.min
      arena@ .fullChunks=
      chunks arena@ .chunks=
      arena return
    end
    newChunkCount 0 > "arena with elements has chunk" assert
    arena .fullChunks
      ## adjust number of full chunks
      newChunkCount i32 cast 1 - i32.min
    arena@ .fullChunks=
    ## shrink last chunk if neccessary
    chunks newChunkCount 1 -  @[] =:: lastChunk
    lastChunk [] .eltCount newEltCount >= "reset point inside allocated memory" assert
    freeElt .if =:: eltData
      lastChunk [] .eltCount 1 - while $ newEltCount >= do =:: j
        lastChunk [] .data j @[] T ptr cast! eltData ()
      finally j 1 - end ..drop
    end
    lastChunk [] .eltCount newEltCount > if
      newEltCount lastChunk .eltCount=
    end
    chunks arena@ .chunks=
    arena return
  end
  proc(
    type : auto: T
    T ArenaAllocator : arena0
  -> T ArenaAllocator ) =>: export: free
    ## free allocated memory
    arena0 0 reset =:: mut: arena
    ## free internal list
    arena .chunks list.free arena@ .chunks=
    arena return
  end
end

## Arena Allocator for mixed types
## TODO? special type-constant for max-aligned type
## TODO? switch to i8-allocator& align elements seperately
i64 =:: MaxAlign ## TODO? allow choosing alignment on creation
MaxAlign ArenaAllocator =:: export: MixedArenaAllocator
namespace: mixedArena
  proc( iSize -> i32 ) =>: alignSize
    MaxAlign ..types.stride 1:iSize - + MaxAlign ..types.stride u/ i32 cast
  end
  proc(
    ## size of a given memory chunk, will be rounded to the nearest power of two
    i32 : chunkSize
    ## new elements have be be allocated in strictly increasing order, this may be less memory efficient
    bool : strictOrder
  -> MixedArenaAllocator ) =>: export: create_S
    ## create_internal
      chunkSize iSize cast.u MaxAlign ..types.stride u/ i32 cast
      ( MaxAlign ptr -> ) ptr optional.empty
      strictOrder
    arenaAlloc.create_internal MixedArenaAllocator cast
  end
  proc(
    ## size of a given memory chunk, will be rounded to the nearest power of two
    i32 : chunkSize
  -> MixedArenaAllocator ) =>: export: create_0
    ## create_internal
      chunkSize iSize cast.u MaxAlign ..types.stride u/ i32 cast
      ( MaxAlign ptr -> ) ptr optional.empty
      false
    arenaAlloc.create_internal MixedArenaAllocator cast
  end
  overload: export: create create_0 create_S end

  proc(
    MixedArenaAllocator : arena
    type : T
  -> MixedArenaAllocator T ptr.mut ) =>: export: alloc
    arena MaxAlign ArenaAllocator cast
      T ..types.stride alignSize arenaAlloc.alloc_internal =:: res
    MixedArenaAllocator cast
    res T ptr.mut cast!
  end
  proc(
    MixedArenaAllocator : arena
    i32 : size
    type : T
  -> MixedArenaAllocator T slice.mut ) =>: export: allocSlice
    size 0 == if
      arena T slice.emptyMutable return
    end
    arena MaxAlign ArenaAllocator cast
      T ..types.stride size iSize cast.u * alignSize arenaAlloc.alloc_internal =:: res
    MixedArenaAllocator cast
    res T ptr.raw.mut cast! size slice.createMutable
  end

  proc(
    type : auto: T
    MixedArenaAllocator : arena
    T : value
  -> MixedArenaAllocator T ptr.mut ) =>: export: copyValue
    value =:: valData ##XXX remove intermediate step once address of arguments are fully supported
    arena T alloc
      valData@ 1:iSize mem.copy T ptr.mut cast!
    return
  end
  proc(
    type : auto: T
    MixedArenaAllocator : arena
    T ptr : value
  -> MixedArenaAllocator T ptr.mut ) =>: export: copyPtr
    arena T alloc
      value 1:iSize mem.copy T ptr.mut cast!
    return
  end
  proc(
    type : auto: T
    i32 : auto: k
    MixedArenaAllocator : arena
    T k ptr : values
  -> MixedArenaAllocator T k ptr.mut ) =>: export: copyPtrs
    arena k T allocSlice .data
      values k iSize cast.u mem.copy T k ptr.mut cast!
    return
  end
  proc(
    type : auto: T
    MixedArenaAllocator : arena
    T slice : values
  -> MixedArenaAllocator T slice.mut ) =>: export: copySlice
    arena values .length i32 cast.u T allocSlice .data
      values .data values .length mem.copy values .length slice.createMutable
    return
  end
  proc(
    type : auto: T
    MixedArenaAllocator : arena
    T slice.mut : values
  -> MixedArenaAllocator T slice.mut ) =>: export: copyMutableSlice
    arena values .length i32 cast.u T allocSlice .data
      values .data values .length mem.copy values .length slice.createMutable
    return
  end
  proc(
    type : auto: T
    MixedArenaAllocator : arena
    T list : values
  -> MixedArenaAllocator T slice.mut ) =>: export: copyList
    arena values .length i32 cast.u T allocSlice .data
      values .data values .length mem.copy values .length slice.createMutable
    return
  end

  proc( MixedArenaAllocator : arena -> i64 ) =>: export: offset
    arena MaxAlign ArenaAllocator cast arenaAlloc.offset
  end
  proc(
    MixedArenaAllocator : arena
    i64 : newLength
  -> MixedArenaAllocator ) =>: export: reset
    arena MaxAlign ArenaAllocator cast
      newLength arenaAlloc.reset
    MixedArenaAllocator cast
  end

  proc(
    MixedArenaAllocator : arena0
  -> MixedArenaAllocator ) =>: export: free
    ## free allocated memory
    arena0 MaxAlign ArenaAllocator cast 0 arenaAlloc.reset =:: mut: arena
    ## free internal list
    arena .chunks list.free arena@ .chunks=
    arena MixedArenaAllocator cast return
  end
end
