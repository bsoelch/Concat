import stringBuilder
import io
using std.literals.

namespace: io
  proc( string : fileName  OpenMode : mode -> FILE IOError ) =>: export: fopenStr
    fileName .data fileName .length mode fopen return
  end
  proc( FILE : file string : str -> IOError ) =>: export: fputStr
    0:iSize =:: mut: off
    str .length =:: mut: remaining
    str .data =:: data
    while remaining 0:iSize != do
      file data off remaining fwrite
        ..dup FILE_ERROR_NONE != if ## error
            ..swap ..drop return
          end
        ..drop
        $ remaining u<= "remaining does not undeflow" assert
        remaining ..over - remaining=
      off ..swap + off=
    end
    FILE_ERROR_NONE return
  end
  proc( FILE : file stringBuilder : str -> IOError ) =>: export: fputSb
    file  str sb.asStr fputStr return
  end
  proc( FILE : file IOError : err string : str -> FILE  IOError ) =>: export: fappendStr
    err FILE_ERROR_NONE != if
      file err return
    end
    file ..dup str fputStr return
  end
  proc( FILE : file IOError : err stringBuilder : str -> FILE  IOError ) =>: export: fappendSb
    err FILE_ERROR_NONE != if
      file err return
    end
    file ..dup str sb.asStr fputStr return
  end
end
namespace: sb
  using io.
  proc( stringBuilder : sb FILE : file -> stringBuilder IOError ) =>: export: appendFile
    16:iSize =:: mut: delta
    FILE_ERROR_NONE IOError =: mut: err
    sb
      while err FILE_ERROR_NONE == do
        $ .length delta + ensureCap
        file $1 .data $2 .length delta fread
          err=
        =:: count
        $ .length count + sb.setLength
        count delta == and delta 8192:iSize u<= if
          delta 2:iSize * delta=
        end
      end
      err FILE_ERR_END_OF_FILE == if
        FILE_ERROR_NONE
      else
        err
      end
    return
  end
end
namespace: io
  proc( char8 : c -> ) =>: export: printC
    c io.putc ..drop
  end
  proc( string : s -> ) =>: export: printS
    io.stdOut s io.fputStr ..drop
  end
  proc( bool -> ) =>: export: printB
    if "true":s else "false":s end printS
  end
  overload: export: print printC printS printB end
  proc( char8 : c -> ) =>: export: printlnC
    c printC
    '\n' io.putc ..drop
  end
  proc( bool -> ) =>: export: printlnB
    if "true":s else "false":s end printlnS
  end
  proc( string : s -> ) =>: export: printlnS
    s printS
    '\n' io.putc ..drop
  end
  overload: export: println printlnC printlnS printlnB end
end
