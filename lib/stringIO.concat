import stringBuilder
import io

namespace: io
  proc( string : fileName  OpenMode : mode => FILE IOError ) =: export fopenStr
    fileName .data fileName .length mode fopen return
  end
  proc( FILE : file string : str => IOError ) =: export fputStr
    0 i64 =: mut off
    str .length i64 =: mut count
    str .data =:: data
    while count 0 > do
      file data off count fwrite
        #dup FILE_ERROR_NONE != if ## error
            #swap #drop return
          end
        #drop
        count #over - count =
      off #swap + off =
    end
    FILE_ERROR_NONE return
  end
  proc( FILE : file stringBuilder : str => IOError ) =: export fputSb
    file  str sb.asStr fputStr return
  end
  proc( FILE : file IOError : err string : str => FILE  IOError ) =: export fappendStr
    err FILE_ERROR_NONE != if
      file err return
    end
    file #dup str fputStr return
  end
  proc( FILE : file IOError : err stringBuilder : str => FILE  IOError ) =: export fappendSb
    err FILE_ERROR_NONE != if
      file err return
    end
    file #dup str sb.asStr fputStr return
  end
end
namespace: sb
  #using io
  proc( stringBuilder : sb FILE : file => stringBuilder IOError ) =: export appendFile
    16 =:: mut delta
    FILE_ERROR_NONE IOError =: mut err
    sb
      while err FILE_ERROR_NONE == do
        #dup .length delta + ensureCap
        file #over .data #over:2 .length delta fread
          err =
        =:: count
        #dup .length count + sb.setLength
        count delta ==  delta 8192 <= & if
          delta 2 * delta =
        end
      end
      err FILE_ERR_END_OF_FILE == if
        FILE_ERROR_NONE
      else
        err
      end
    return
  end
end
