"list" import
"stringBuilder" import
"mem" import

namespace: exec
  namespace: RedirectMode
    0x1 =:: export: APPEND_STD_OUT
    0x2 =:: export: APPEND_STD_ERR
  end
  struct(
    i32 list : mut: argOffsets
    stringBuilder : mut: argBuffer
    string : stdInPath
    string : stdOutPath
    string : stdErrPath
    i32 : redirectMode
  ) =:: export: ExecContext
  proc( string : command -> ExecContext ) =>: export: build
    ## ExecContext
      16 i32 list.create
        0 list.append
      command sb.fromStr
        '\x00' sb.appendC
      string.empty
      string.empty
      string.empty
      0
    ExecContext new return
  end
  proc( ExecContext : context string : argument -> ExecContext ) =>: export: add
    context
      $ .argOffsets
        $1 .argBuffer .length i32 cast.u list.append
      >$ .argOffsets=
      $ .argBuffer
        argument sb.appendStr
        '\x00' sb.appendC
      >$ .argBuffer=
    return
  end
  proc( ExecContext : context string : argument -> ExecContext ) : alias: export: append add
  proc( ExecContext string -> ExecContext ) =>: export: setStdIn
    >$ .stdInPath=
  end
  proc( ExecContext string -> ExecContext ) =>: export: setStdOut
    >$ .stdOutPath=
  end
  proc( ExecContext string -> ExecContext ) =>: export: setStdErr
    >$ .stdErrPath=
  end
  proc( ExecContext string -> ExecContext ) =>: export: appendStdOut
    >$ .stdOutPath=
    $ .redirectMode RedirectMode.APPEND_STD_OUT | >$ .redirectMode=
  end
  proc( ExecContext string -> ExecContext ) =>: export: appendStdErr
    >$ .stdErrPath=
    $ .redirectMode RedirectMode.APPEND_STD_ERR | >$ .redirectMode=
  end
  enum( SUCCESS FORK_FAILURE EXEC_FAILURE WAIT_FAILURE PROCESS_FAILURE ) =:: export: RunState
  proc( ExecContext : context -> i32 RunState ) : export: run
  proc( i32 : retCode RunState : state -> bool ) =>: export: check
    state .SUCCESS and retCode 0 == end
  end
end
## TODO conditional compilation depending on target
"sys/glibc/exec" import
