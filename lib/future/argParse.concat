import stringBuilder
import print
import sys
using std.literals.

namespace: args
  enum( DEFAULT EXTENDED SPECIAL IGNORE ) =:: export: HelpLevel
  struct(
    string : name
    iSize : infoLocation
  ) =:: ArgName
  namespace: ArgName
    proc( ArgName : a ArgName : b -> i32 ) =>: cmp
      a .name b .name string.compare
    end
  end
  ( type : T -> type ) =>: setValue
    struct( T ptr.mut : dst T : val )
  end
  ( type : T -> type ) =>: appendValue
    struct( T list ptr.mut : dst T : val )
  end
  namespace: setValue
    proc( type : auto: T  T setValue : val -> ) =>: set
      val .val val .dst =[]
    end
    proc( type : auto: T  T setValue : val -> ) =>: bitEnable
      val .dst [] val .val | val .dst =[]
    end
    proc( type : auto: T  T setValue : val -> ) =>: bitDisable
      val .dst [] val .val ~ & val .dst =[]
    end
    proc( type : auto: T  T appendValue : val -> ) =>: append
      val .dst [] val .val list.append val .dst =[]
    end
  end
  struct( bool ptr.mut : flag string list ptr.mut : tail ) =:: FlagAndTail
  union(
    ## 0 parameters
    HelpLevel : Help
    bool ptr.mut : Enable
    bool ptr.mut : Disable
    bool list ptr.mut : AppendTrue
    bool list ptr.mut : AppendFalse
    FlagAndTail : EnableAndTail
    FlagAndTail : DisableAndTail
    i8  setValue : SetI8
    i16 setValue : SetI16
    i32 setValue : SetI32
    i64 setValue : SetI64
    string setValue : SetString
    i8  setValue : BitEnableI8
    i16 setValue : BitEnableI16
    i32 setValue : BitEnableI32
    i64 setValue : BitEnableI64
    i8  setValue : BitDisableI8
    i16 setValue : BitDisableI16
    i32 setValue : BitDisableI32
    i64 setValue : BitDisableI64
    i8  appendValue : AppendI8
    i16 appendValue : AppendI16
    i32 appendValue : AppendI32
    i64 appendValue : AppendI64
    string appendValue : AppendString
    ## 1 parameter
    string ptr.mut : Set
    string list ptr.mut : Append
    ## n parameters
    string list ptr.mut : SetAll
    string list ptr.mut : AppendAll
  ) =:: ArgInfo
  proc( i8  ptr.mut i8  -> ArgInfo ) =>: argInfoSetValI8  i8   setValue new ArgInfo .SetI8  end
  proc( i16 ptr.mut i16 -> ArgInfo ) =>: argInfoSetValI16 i16  setValue new ArgInfo .SetI16 end
  proc( i32 ptr.mut i32 -> ArgInfo ) =>: argInfoSetValI32 i32  setValue new ArgInfo .SetI32 end
  proc( i64 ptr.mut i64 -> ArgInfo ) =>: argInfoSetValI64 i64  setValue new ArgInfo .SetI64 end
  proc( string ptr.mut string -> ArgInfo ) =>: argInfoSetValString string  setValue new ArgInfo .SetString end
  overload: argInfoSetVal argInfoSetValI8 argInfoSetValI16 argInfoSetValI32 argInfoSetValI64 argInfoSetValString end
  proc( i8  ptr.mut i8  -> ArgInfo ) =>: argInfoBitEnableValI8  i8   setValue new ArgInfo .BitEnableI8  end
  proc( i16 ptr.mut i16 -> ArgInfo ) =>: argInfoBitEnableValI16 i16  setValue new ArgInfo .BitEnableI16 end
  proc( i32 ptr.mut i32 -> ArgInfo ) =>: argInfoBitEnableValI32 i32  setValue new ArgInfo .BitEnableI32 end
  proc( i64 ptr.mut i64 -> ArgInfo ) =>: argInfoBitEnableValI64 i64  setValue new ArgInfo .BitEnableI64 end
  overload: argInfoBitEnableVal argInfoBitEnableValI8 argInfoBitEnableValI16 argInfoBitEnableValI32 argInfoBitEnableValI64 end
  proc( i8  ptr.mut i8  -> ArgInfo ) =>: argInfoBitDisableValI8  i8   setValue new ArgInfo .BitDisableI8  end
  proc( i16 ptr.mut i16 -> ArgInfo ) =>: argInfoBitDisableValI16 i16  setValue new ArgInfo .BitDisableI16 end
  proc( i32 ptr.mut i32 -> ArgInfo ) =>: argInfoBitDisableValI32 i32  setValue new ArgInfo .BitDisableI32 end
  proc( i64 ptr.mut i64 -> ArgInfo ) =>: argInfoBitDisableValI64 i64  setValue new ArgInfo .BitDisableI64 end
  overload: argInfoBitDisableVal argInfoBitDisableValI8 argInfoBitDisableValI16 argInfoBitDisableValI32 argInfoBitDisableValI64 end
  proc( i8  list ptr.mut i8  -> ArgInfo ) =>: argInfoAppendValI8  i8   appendValue new ArgInfo .AppendI8  end
  proc( i16 list ptr.mut i16 -> ArgInfo ) =>: argInfoAppendValI16 i16  appendValue new ArgInfo .AppendI16 end
  proc( i32 list ptr.mut i32 -> ArgInfo ) =>: argInfoAppendValI32 i32  appendValue new ArgInfo .AppendI32 end
  proc( i64 list ptr.mut i64 -> ArgInfo ) =>: argInfoAppendValI64 i64  appendValue new ArgInfo .AppendI64 end
  proc( string list ptr.mut string -> ArgInfo ) =>: argInfoAppendValString string appendValue new ArgInfo .AppendString end
  overload: argInfoAppendVal argInfoAppendValI8 argInfoAppendValI16 argInfoAppendValI32 argInfoAppendValI64 argInfoAppendValString end
  union(
    _ : None
    string ptr.mut : Set
    string list ptr.mut : Append
  ) =:: StringArgLocation
  struct(
    string : argPrefixes
    string : usage
    ArgName list : argNames
    ArgInfo list : argInfos
    stringBuilder : helpDefault
    stringBuilder : helpExtended
    stringBuilder : helpSpecial
    StringArgLocation : headLocation
    StringArgLocation : miscLocation
    StringArgLocation : tailLocation
  ) =:: ArgParser
  proc( -> ArgParser ) =>: export: start
    "-":s
      "":s
      ArgName list.empty
      ArgInfo list.empty
      sb.empty
      sb.empty
      sb.empty
      StringArgLocation .None
      StringArgLocation .None
      StringArgLocation .None
    ArgParser new
  end
  proc( ArgParser string -> ArgParser ) =>: export: prefixes
    >$ .argPrefixes=
  end
  proc( ArgParser string -> ArgParser ) =>: export: usage
    >$ .usage=
  end
  proc( ArgParser : args string : name -> ) =>: checkArgName
    ## TODO use stderr
    name .length 0 == if
      "Warning: empty-argument name":s io.println
      return
    end
    args .argPrefixes name 0 string.charAt string.contains ! if
      "Warning: argument `":s io.print
      name io.print
      "` does not start with a valid argument prefix":s io.println
    end
  end
  proc( ArgParser string : name ArgInfo : argInfo -> ArgParser ) =>: addArg
    $ name checkArgName
    $ .argInfos
      $ .length =:: argIndex
      argInfo list.append
    >$ .argInfos=
    $ .argNames
      name argIndex ArgName new list.append
    >$ .argNames=
  end
  proc( ArgParser -> ArgParser ) =>: export: warnUnparsed

  end
  proc( string list ptr.mut  i64 -> i64 ) =>: consumeTail
    $1 [] <$
      while $ sys.argc < do =:: i
        i sys.getArg list.append
      finally i 1 + end <<$
    >$ =[]
  end
  proc( ArgInfo : argInfo i64 : index -> i64 ) =>: parseArgument
    argInfo switch
      Help case ..unreachable
      Enable .case true >$ =[] break
      Disable .case false >$ =[] break
      EnableAndTail .case =:: dst
        true dst .flag =[]
        dst .tail index 1 + consumeTail return
      break
      DisableAndTail .case =:: dst
        false dst .flag =[]
        dst .tail index 1 + consumeTail return
      break
      AppendTrue .case $ [] true list.append >$ =[] break
      AppendFalse .case $ [] false list.append >$ =[] break
      SetI8 .case setValue.set break
      SetI16 .case setValue.set break
      SetI32 .case setValue.set break
      SetI64 .case setValue.set break
      SetString .case setValue.set break
      BitEnableI8 .case setValue.bitEnable break
      BitEnableI16 .case setValue.bitEnable break
      BitEnableI32 .case setValue.bitEnable break
      BitEnableI64 .case setValue.bitEnable break
      BitDisableI8 .case setValue.bitDisable break
      BitDisableI16 .case setValue.bitDisable break
      BitDisableI32 .case setValue.bitDisable break
      BitDisableI64 .case setValue.bitDisable break
      AppendI8 .case setValue.append break
      AppendI16 .case setValue.append break
      AppendI32 .case setValue.append break
      AppendI64 .case setValue.append break
      AppendString .case setValue.append break
    ## 1 parameter
      Set .case
        index 1 + =:: shadow: index
        index sys.getArg >$ =[]
        index return
      break
      Append .case
        index 1 + =:: shadow: index
        $ []
          index sys.getArg list.append
        >$ =[]
        index return
      break
      SetAll .case =:: dst
        "unimplemented" ..panic
      break
      AppendAll .case =:: dst
        "unimplemented" ..panic
      break
    end
    index return
  end
  proc( ArgParser : args -> ) =>: export: parse
    args .argNames ArgName.cmp@ list.sort
    0 sys.getArg =:: progName
    false =:: mut: hadArg
    false =:: mut: hadError
    HelpLevel .IGNORE =:: mut: printHelp
    string list.empty =:: mut: tailValues
    1:i64 while $ sys.argc < do =:: mut: i
      i sys.getArg =:: arg
      arg .length 0 == if continue end
      arg 0 string.charAt =:: c0
      args .argPrefixes c0 string.contains if
        true hadArg=
        tailValues .length 0 != if
          args .miscLocation switch
            None case break
            Set .case tailValues list.removeLast >$ tailValues= >$ =[] continue
            Append .case $ [] tailValues list.appendAll >$ =[] continue
          end
          tailValues list.clear tailValues=
        end
        args .argNames list.asSlice
          arg 0 ArgName new
          ArgName.cmp@
        slice.binarySearch switch
          Match .case =:: index
            args .argInfos
              args .argNames index [] .infoLocation
            [] .Help .if =:: level
              printHelp .IGNORE or level ..tag printHelp ..tag > if
                level printHelp=
              end
            else
              i parseArgument i=
            end
          break
          Missing case
            "unexpected argument: ":s io.println
            arg io.println
            true hadError=
          break
        end
      else
        hadArg if ## don't know yet if misc or tail
          tailValues arg list.append tailValues=
        else
          args .headLocation switch
            None case break
            Set .case arg >$ =[] continue
            Append .case $ [] arg list.append >$ =[] continue
          end ## no location for head -> store as misc
          args .miscLocation switch
            None case break
            Set .case arg >$ =[] continue
            Append .case $ [] arg list.append >$ =[] continue
          end
        end
      end
    finally i 1 + end ..drop
    tailValues .length 0 != if
      args .tailLocation switch
        None case ## no location for tail -> store as misc
          args .miscLocation switch
            None case break
            Set .case tailValues list.removeLast <$ tailValues= >$ =[] break
            Append .case $ [] tailValues list.appendAll >$ =[] break
          end
        break
        Set .case tailValues list.removeLast <$ tailValues= >$ =[] break
        Append .case $ [] tailValues list.appendAll >$ =[] break
      end
    end
    tailValues list.free ..drop
    printHelp .IGNORE ! or hadError if
      "\nusage: ":s io.print
      progName io.print ' ' io.print
      args .usage io.println '\n' io.print
      args .helpDefault sb.asStr io.println
      printHelp switch
        DEFAULT IGNORE case break
        EXTENDED case
          args .helpExtended sb.asStr io.println
        break
        SPECIAL case
          args .helpExtended sb.asStr io.println
          args .helpSpecial sb.asStr io.println
        break
      end
    end
  end
end
namespace: arg
  struct(
    string : helpText
    args.HelpLevel : helpLevel
  ) =:: Common
  namespace: Common
    proc( -> Common ) =>: export: default
      string.empty args.HelpLevel .DEFAULT Common new
    end
  end
  type .with( 0 ..types.getElement Common == ) =:: ArgDataType
  proc( ArgDataType : auto: A  A string -> A ) =>: export: helpText
    >$ .common.helpText=
  end
  proc( ArgDataType : auto: A  A args.HelpLevel -> A ) =>: export: helpLevel
    >$ .common.helpLevel=
  end
  proc( args.ArgParser string : argName Common : argInfo  -> args.ArgParser stringBuilder optional ) =>: export: startHelpText
    argInfo .helpLevel switch
      DEFAULT case $ .helpDefault break
      EXTENDED case $ .helpExtended break
      SPECIAL case $ .helpSpecial break
      IGNORE case stringBuilder optional.empty return
    end
      "  ":s sb.appendStr
      argName sb.appendStr
    optional.wrap return
  end
  proc( args.ArgParser stringBuilder Common : argInfo  -> args.ArgParser ) =>: export: endHelpText
    " : ":s sb.appendStr
      argInfo .helpText sb.appendStr
      '\n' sb.appendC
    argInfo .helpLevel switch
      DEFAULT case >$ .helpDefault= break
      EXTENDED case >$ .helpExtended= break
      SPECIAL case >$ .helpSpecial= break
      IGNORE case ..unreachable
    end
  end
  proc( args.ArgParser string : argName Common : argInfo  -> args.ArgParser ) =>: export: addHelpText
    argName argInfo startHelpText .if
      argInfo endHelpText
    end
  end
  proc( ArgDataType : auto: A  A string : other -> A ) =>: export: disables

  end
  struct(
    Common : common
    bool : negated
    string list ptr.mut optional : consumeTail
  ) =:: Flag
  proc( -> Flag ) =>: export: flag
    Common.default false string list ptr.mut optional.empty Flag new
  end
  namespace: flag
    proc( Flag -> Flag ) =>: export: negate
      $ .negated ! >$ .negated=
    end
    proc( Flag string list ptr.mut -> Flag ) =>: export: consumeTail
      optional.wrap >$ .consumeTail=
    end
    proc( args.ArgParser
      Flag : argInfo
      bool ptr.mut : location
      string : argName
    -> args.ArgParser ) =>: export: setArg
      argInfo .consumeTail .if
        argName location >>$ args.FlagAndTail new argInfo .negated
          if args.ArgInfo .DisableAndTail else args.ArgInfo .EnableAndTail end
        args.addArg
      else
        argName location argInfo .negated if args.ArgInfo .Disable else args.ArgInfo .Enable end args.addArg
      end
      argName argInfo .common startHelpText .else return end
        argInfo .consumeTail ? if " [arg]*":s sb.appendStr end
      argInfo .common endHelpText
    end
    proc( args.ArgParser
      Flag : argInfo
      bool list ptr.mut : location
      string : argName
    -> args.ArgParser ) =>: export: collectArg
      argInfo .consumeTail ? if "cannot collect flag that consumes tail" ..panic end
      argName location argInfo .negated if args.ArgInfo .AppendFalse else args.ArgInfo .AppendTrue end args.addArg
      argName argInfo .common addHelpText
    end
  end
  proc( type.namedInteger : I -> type ) =>: FlagGroupElement
    struct( string : name I : shadow: value bool : enable )
  end
  proc( type.namedInteger : I -> type ) =>: FlagGroup
    struct(
      Common : common
      I FlagGroupElement list : options
      string : enableAll
      I : enableAllValue
    )
  end
  proc( type.namedInteger : static: I -> I FlagGroup ) =>: export: flagGroup
    Common.default I FlagGroupElement list.empty string.empty 0 I cast I FlagGroup new
  end
  namespace: flagGroup
    proc( type.namedInteger : auto: I
      I FlagGroup
      string : name I : shadow: value
    -> I FlagGroup ) =>: export: enable
      $ .options name value true I FlagGroupElement new list.append >$ .options=
      $ .enableAllValue value | >$ .enableAllValue=
    end
    proc( type.namedInteger : auto: I
      I FlagGroup string
    -> I FlagGroup ) =>: export: enableAll
      >$ .enableAll=
    end
    proc( type.namedInteger : auto: I  args.ArgParser
      I FlagGroup : argInfo
      I ptr.mut : location
    -> args.ArgParser ) =>: export: setArg
      I ..types.unwrapNamed =:: BaseInt
      argInfo .options for =:: elt
        elt .name
        location BaseInt ptr.mut cast!
          elt .value BaseInt cast
          elt .enable ! if argInfo .enableAllValue BaseInt cast  ^ end
        BaseInt args.argInfoSetVal args.addArg
      end
      argInfo .enableAll .length 0 != if
        argInfo .enableAll
        location BaseInt ptr.mut cast!
          argInfo .enableAllValue BaseInt cast
        args.argInfoSetVal args.addArg
        argInfo .enableAll argInfo .common startHelpText .else return end
        true
      else
        "  ":s argInfo .common startHelpText .else return end
        false
      end =:: mut: needComma
        argInfo .options for .name
          needComma if <$ ", ":s sb.appendStr >$ else true needComma= end
          sb.appendStr
        end
      argInfo .common endHelpText
    end
    proc( type.namedInteger : auto: I  args.ArgParser
      I FlagGroup : argInfo
      I ptr.mut : location
    -> args.ArgParser ) =>: export: collectArg
      I ..types.unwrapNamed =:: BaseInt
      argInfo .options for =:: elt
        elt .name
        location BaseInt ptr.mut cast!
          elt .value BaseInt cast
        elt .enable if
          args.argInfoBitEnableVal
        else
          args.argInfoBitDisableVal
        end args.addArg
      end
      argInfo .enableAll .length 0 != if
        argInfo .enableAll
        location BaseInt ptr.mut cast!
          argInfo .enableAllValue BaseInt cast
        args.argInfoSetVal args.addArg
        argInfo .enableAll argInfo .common startHelpText .else return end
        true
      else
        "  ":s argInfo .common startHelpText .else return end
        false
      end =:: mut: needComma
        argInfo .options for .name
          needComma if <$ ", ":s sb.appendStr >$ else true needComma= end
          sb.appendStr
        end
      argInfo .common endHelpText
    end
  end
  struct(
    Common : common
    string : enable
    string : disable
  ) =:: FlagToggle
  proc( string : enable string : disable -> FlagToggle ) =>: export: flagToggle
    Common.default enable disable FlagToggle new
  end
  namespace: flagToggle
    proc( args.ArgParser
      FlagToggle : argInfo
      bool ptr.mut : location
    -> args.ArgParser ) =>: export: setArg
      argInfo .enable location args.ArgInfo .Enable args.addArg
      argInfo .disable location args.ArgInfo .Disable args.addArg
      argInfo .enable argInfo .common startHelpText .else return end
        ", ":s sb.appendStr argInfo .disable sb.appendStr
      argInfo .common endHelpText
    end
    proc( args.ArgParser
      FlagToggle : argInfo
      bool list ptr.mut : location
    -> args.ArgParser ) =>: export: collectArg
      argInfo .enable location args.ArgInfo .AppendTrue args.addArg
      argInfo .disable location args.ArgInfo .AppendFalse args.addArg
      argInfo .enable argInfo .common startHelpText .else return end
        ", ":s sb.appendStr argInfo .disable sb.appendStr
      argInfo .common endHelpText
    end
  end
  struct(
    Common : common
  ) =:: ValueArg
  proc( -> ValueArg ) =>: export: value
    Common.default ValueArg new
  end
  namespace: value
    proc( args.ArgParser
      ValueArg : argInfo
      string ptr.mut : location
      string : argName
    -> args.ArgParser ) =>: export: setArg
      argName location args.ArgInfo .Set args.addArg
      argName argInfo .common startHelpText .else return end
        " [arg]":s sb.appendStr ## TODO allow to customize arg name
      argInfo .common endHelpText
    end
    proc( args.ArgParser
      ValueArg : argInfo
      string list ptr.mut : location
      string : argName
    -> args.ArgParser ) =>: export: collectArg
      argName location args.ArgInfo .Append args.addArg
      argName argInfo .common startHelpText .else return end
        " [arg]":s sb.appendStr ## TODO allow to customize arg name
      argInfo .common endHelpText
    end
  end
  struct(
    Common : common
  ) =:: ValuesArg
  proc( -> ValuesArg ) =>: export: values
    Common.default ValuesArg new
  end
  namespace: values
    proc( args.ArgParser
      ValuesArg : argInfo
      string list ptr.mut : location
      string : argName
    -> args.ArgParser ) =>: export: setArg
      argName location args.ArgInfo .SetAll args.addArg
      argName argInfo .common startHelpText .else return end
        " [arg]*":s sb.appendStr ## TODO allow to customize arg name
      argInfo .common endHelpText
    end
    proc( args.ArgParser
      ValuesArg : argInfo
      string list ptr.mut : location
      string : argName
    -> args.ArgParser ) =>: export: collectArg
      argName location args.ArgInfo .AppendAll args.addArg
      argName argInfo .common startHelpText .else return end
        " [arg]*":s sb.appendStr ## TODO allow to customize arg name
      argInfo .common endHelpText
    end
  end
  proc( type : T -> type ) =>: SelectArgOption
    struct( string : name T : shadow: value )
  end
  proc( type : T -> type ) =>: SelectArg
    struct(
      Common : common
      T SelectArgOption list : options
      T optional : defaultValue
    )
  end
  proc( type : static: T -> T SelectArg ) =>: export: select
    Common.default T SelectArgOption list.empty T optional.empty T SelectArg new
  end
  namespace: select
    proc( type : auto: T T SelectArg T -> T SelectArg ) =>: export: default
      optional.wrap >$ .defaultValue=
    end
    proc( type : auto: T T SelectArg string : name T : val -> T SelectArg ) =>: export: option
      $ .options name val T SelectArgOption new list.append >$ .options=
    end
    proc( type : static: T -> type ) =>: static: nowrap: argBaseType
      T string == if
        string return
      else
        T ..types.unwrapNamed =:: BaseType
      BaseType type.isInteger _if
        BaseType return
      else BaseType type.isEnum _if
        BaseType ..types.unionTag ..types.unwrapNamed return
      else
        "SelectArg is currently only supported for integers, enums and strings" ..compiler.error
      end
    end
    proc( type : auto: T  args.ArgParser
      T SelectArg : argInfo
      T ptr.mut : location
    -> args.ArgParser ) =>: export: setArg
      T argBaseType =:: BaseType
      argInfo .options for =:: elt
        elt .name
        location BaseType ptr.mut cast!
          elt .value T type.isNamedEnum if ..tag end BaseType cast
        args.argInfoSetVal args.addArg
      end
      argInfo .defaultValue .if location =[] end
      string.empty argInfo .common startHelpText .else return end
        argInfo .options for .name sb.appendStr ", ":s sb.appendStr end
        argInfo .options .length 0 != if $ .length 2 - >$ .length= end ## remove last comma
      argInfo .common endHelpText
    end
    proc( type.namedInteger : auto: I  args.ArgParser
      I SelectArg : argInfo
      I list ptr.mut : location
    -> args.ArgParser ) =>: export: collectArg
      T argBaseType =:: BaseType
      argInfo .options for =:: elt
        elt .name
        location BaseType list ptr.mut cast!
          elt .value T type.isNamedEnum if ..tag end BaseType cast
        args.argInfoAddVal args.addArg
      end
      string.empty argInfo .common startHelpText .else return end
        argInfo .options for .name sb.appendStr ", ":s sb.appendStr end
        argInfo .options .length 0 != if $ .length 2 - >$ .length end ## remove last comma
      argInfo .common endHelpText
    end
  end
  struct(
    Common : common
  ) =:: MiscArgs
  proc( -> MiscArgs ) =>: export: misc
    Common.default MiscArgs new
  end
  namespace: misc
    proc( MiscArgs -> MiscArgs ) =>: export: require

    end
    proc( args.ArgParser
      MiscArgs : argInfo
      string ptr.mut : location
    -> args.ArgParser ) =>: export: setArg
      location >$ .miscLocation.Set=
    end
    proc( args.ArgParser
      MiscArgs : argInfo
      string list ptr.mut : location
    -> args.ArgParser ) =>: export: collectArg
      location >$ .miscLocation.Append=
    end
  end
  struct(
    Common : common
  ) =:: HeadArgs
  proc( -> HeadArgs ) =>: export: head
    Common.default HeadArgs new
  end
  namespace: head
    proc( HeadArgs -> HeadArgs ) =>: export: require

    end
    proc( args.ArgParser
      HeadArgs : argInfo
      string ptr.mut : location
    -> args.ArgParser ) =>: export: setArg
      location >$ .headLocation.Set=
    end
    proc( args.ArgParser
      HeadArgs : argInfo
      string list ptr.mut : location
    -> args.ArgParser ) =>: export: collectArg
      location >$ .headLocation.Append=
    end
  end
  struct(
    Common : common
  ) =:: TailArgs
  proc( -> TailArgs ) =>: export: tail
    Common.default TailArgs new
  end
  namespace: tail
    proc( TailArgs -> TailArgs ) =>: export: require

    end
    proc( args.ArgParser
      TailArgs : argInfo
      string ptr.mut : location
    -> args.ArgParser ) =>: export: setArg
      location >$ .tailLocation.Set=
    end
    proc( args.ArgParser
      TailArgs : argInfo
      string list ptr.mut : location
    -> args.ArgParser ) =>: export: collectArg
      location >$ .tailLocation.Append=
    end
  end

  proc( args.ArgParser string : argName args.HelpLevel : level -> args.ArgParser ) =>: export: help
      argName level args.ArgInfo .Help args.addArg
      $ .helpDefault
        "  ":s sb.appendStr argName sb.appendStr
        level switch
          DEFAULT  case " : print this help text\n":s sb.appendStr break
          EXTENDED case " : print extended help text\n":s sb.appendStr break
          SPECIAL IGNORE case " : print full help text\n":s sb.appendStr break
        end
      >$ .helpDefault=
  end
  overload: export: set
    flag.setArg flagToggle.setArg flagGroup.setArg
    value.setArg values.setArg
    select.setArg
    misc.setArg
  end
  overload: export: collect
    flag.collectArg flagToggle.collectArg flagGroup.collectArg
    value.collectArg values.collectArg
    select.collectArg
    misc.collectArg
  end
end
