import stringBuilder
import print
using std.literals.

namespace: args
  enum( DEFAULT EXTENDED SPECIAL IGNORE ) =:: export: HelpLevel
  struct(
    string : name
    iSize : infoLocation
  ) =:: ArgName
  namespace: ArgName
    proc( ArgName : a ArgName : b -> i32 ) =>: cmp
      a .name b .name string.compare
    end
  end
  ( type : T -> type ) =>: setValue
    struct( T ptr.mut : dst T : val )
  end
  ( type : T -> type ) =>: appendValue
    struct( T list ptr.mut : dst T : val )
  end
  union(
    ## 0 parameters
    HelpLevel : Help
    bool ptr.mut : Enable
    bool ptr.mut : Disable
    bool list ptr.mut : AppendTrue
    bool list ptr.mut : AppendFalse
    i8  setValue : SetI8
    i16 setValue : SetI16
    i32 setValue : SetI32
    i64 setValue : SetI64
    string setValue : SetString
    i8  setValue : BitEnableI8
    i16 setValue : BitEnableI16
    i32 setValue : BitEnableI32
    i64 setValue : BitEnableI64
    i8  setValue : BitDisableI8
    i16 setValue : BitDisableI16
    i32 setValue : BitDisableI32
    i64 setValue : BitDisableI64
    i8  appendValue : AppendI8
    i16 appendValue : AppendI16
    i32 appendValue : AppendI32
    i64 appendValue : AppendI64
    string appendValue : AppendString
    ## 1 parameter
    string ptr.mut : Set
    string list ptr.mut : Append
    ## n parameters
    string list ptr.mut : SetAll
    string list ptr.mut : AppendAll
  ) =:: ArgInfo
  proc( i8  ptr.mut i8  -> ArgInfo ) =>: argInfoSetValI8  i8   setValue new ArgInfo .SetI8  end
  proc( i16 ptr.mut i16 -> ArgInfo ) =>: argInfoSetValI16 i16  setValue new ArgInfo .SetI16 end
  proc( i32 ptr.mut i32 -> ArgInfo ) =>: argInfoSetValI32 i32  setValue new ArgInfo .SetI32 end
  proc( i64 ptr.mut i64 -> ArgInfo ) =>: argInfoSetValI64 i64  setValue new ArgInfo .SetI64 end
  proc( string ptr.mut string -> ArgInfo ) =>: argInfoSetValString string  setValue new ArgInfo .SetString end
  overload: argInfoSetVal argInfoSetValI8 argInfoSetValI16 argInfoSetValI32 argInfoSetValI64 argInfoSetValString end
  proc( i8  ptr.mut i8  -> ArgInfo ) =>: argInfoBitEnableValI8  i8   setValue new ArgInfo .BitEnableI8  end
  proc( i16 ptr.mut i16 -> ArgInfo ) =>: argInfoBitEnableValI16 i16  setValue new ArgInfo .BitEnableI16 end
  proc( i32 ptr.mut i32 -> ArgInfo ) =>: argInfoBitEnableValI32 i32  setValue new ArgInfo .BitEnableI32 end
  proc( i64 ptr.mut i64 -> ArgInfo ) =>: argInfoBitEnableValI64 i64  setValue new ArgInfo .BitEnableI64 end
  overload: argInfoBitEnableVal argInfoBitEnableValI8 argInfoBitEnableValI16 argInfoBitEnableValI32 argInfoBitEnableValI64 end
  proc( i8  ptr.mut i8  -> ArgInfo ) =>: argInfoBitDisableValI8  i8   setValue new ArgInfo .BitDisableI8  end
  proc( i16 ptr.mut i16 -> ArgInfo ) =>: argInfoBitDisableValI16 i16  setValue new ArgInfo .BitDisableI16 end
  proc( i32 ptr.mut i32 -> ArgInfo ) =>: argInfoBitDisableValI32 i32  setValue new ArgInfo .BitDisableI32 end
  proc( i64 ptr.mut i64 -> ArgInfo ) =>: argInfoBitDisableValI64 i64  setValue new ArgInfo .BitDisableI64 end
  overload: argInfoBitDisableVal argInfoBitDisableValI8 argInfoBitDisableValI16 argInfoBitDisableValI32 argInfoBitDisableValI64 end
  proc( i8  list ptr.mut i8  -> ArgInfo ) =>: argInfoAppendValI8  i8   appendValue new ArgInfo .AppendI8  end
  proc( i16 list ptr.mut i16 -> ArgInfo ) =>: argInfoAppendValI16 i16  appendValue new ArgInfo .AppendI16 end
  proc( i32 list ptr.mut i32 -> ArgInfo ) =>: argInfoAppendValI32 i32  appendValue new ArgInfo .AppendI32 end
  proc( i64 list ptr.mut i64 -> ArgInfo ) =>: argInfoAppendValI64 i64  appendValue new ArgInfo .AppendI64 end
  proc( string list ptr.mut string -> ArgInfo ) =>: argInfoAppendValString string appendValue new ArgInfo .AppendString end
  overload: argInfoAppendVal argInfoAppendValI8 argInfoAppendValI16 argInfoAppendValI32 argInfoAppendValI64 argInfoAppendValString end
  union(
    _ : None
    string ptr.mut : Set
    string list ptr.mut : Append
  ) =:: StringArgLocation
  struct(
    string : argPrefixes
    string : usage
    ArgName list : argNames
    ArgInfo list : argInfos
    stringBuilder : helpDefault
    stringBuilder : helpExtended
    stringBuilder : helpSpecial
    StringArgLocation : headLocation
    StringArgLocation : miscLocation
    StringArgLocation : tailLocation
  ) =:: ArgParser
  proc( -> ArgParser ) =>: export: start
    "-":s
      ArgName list.empty
      ArgInfo list.empty
      sb.empty
      sb.empty
      sb.empty
      StringArgLocation .None
      StringArgLocation .None
      StringArgLocation .None
    ArgParser new
  end
  proc( ArgParser string -> ArgParser ) =>: export: prefixes
    >$ .argPrefixes=
  end
  proc( ArgParser -> ArgParser ) =>: export: usage
    >$ .usage=
  end
  proc( ArgParser string : name -> ArgParser ) =>: checkArgName
    ## TODO use stderr
    name .length 0 == if
      "Warning: empty-argument name":s io.println
      return
    end
    $ .argPrefixes name 0 string.charAt string.contains ! if
      "Warning: argument `":s io.print
      name io.print
      "` does not start with a valid argument prefix":s io.println
    end
  end
  proc( ArgParser string : name ArgInfo : argInfo -> ArgParser ) =>: addArg
    name checkArgName
    $ .argInfos
      $ .length =:: argIndex
      argInfo list.append
    >$ .argInfos=
    $ .argNames
      name argIndex ArgName new list.append
    >$ .argNames=
  end
  proc( ArgParser -> ArgParser ) =>: export: warnUnparsed

  end
  proc( ArgParser : args -> ) =>: export: parse

  end
end
namespace: arg
  struct(
    string : helpText
    args.HelpLevel : helpLevel
  ) =:: Common
  namespace: Common
    proc( -> Common ) =>: export: default
      string.empty args.HelpLevel .DEFAULT Common new
    end
  end
  type .with( 0 ..types.getElement Common == ) =:: ArgDataType
  proc( ArgDataType : auto: A  A string -> A ) =>: export: helpText
    >$ .common.helpText=
  end
  proc( ArgDataType : auto: A  A args.HelpLevel -> A ) =>: export: helpLevel
    >$ .common.helpLevel=
  end
  proc( ArgDataType : auto: A  A string : other -> A ) =>: export: disables

  end
  proc( ArgDataType : auto: A  A string list ptr.mut : shadow: tail -> A ) =>: export: consumeTail

  end
  struct(
    Common : common
  ) =:: Flag
  proc( -> Flag ) =>: export: flag
    Common.default Flag new
  end
  namespace: flag
    proc( args.ArgParser
      Flag : argInfo
      bool ptr.mut : location
      string : argName
    -> args.ArgParser ) =>: export: setArg
      argName location args.ArgInfo .Enable args.addArg
      ## TODO handle help-text
    end
    proc( args.ArgParser
      Flag : argInfo
      bool list ptr.mut : location
      string : argName
    -> args.ArgParser ) =>: export: collectArg
      argName location args.ArgInfo .AppendTrue args.addArg
      ## TODO handle help-text
    end
  end
  proc( type.namedInteger : I -> type ) =>: FlagGroupElement
    struct( string : name I : shadow: value bool : enable )
  end
  proc( type.namedInteger : I -> type ) =>: FlagGroup
    struct(
      Common : common
      I FlagGroupElement list : options
      string : enableAll
      I : enableAllValue
    )
  end
  proc( type.namedInteger : static: I -> I FlagGroup ) =>: export: flagGroup
    Common.default I FlagGroupElement list.empty string.empty 0 I cast I FlagGroup new
  end
  namespace: flagGroup
    proc( type.namedInteger : auto: I
      I FlagGroup
      string : name I : shadow: value
    -> I FlagGroup ) =>: export: enable
      $ .options name value true I FlagGroupElement new list.append >$ .options=
      $ .enableAllValue value | >$ .enableAllValue=
    end
    proc( type.namedInteger : auto: I
      I FlagGroup string
    -> I FlagGroup ) =>: export: enableAll
      >$ .enableAll=
    end
    proc( type.namedInteger : auto: I  args.ArgParser
      I FlagGroup : argInfo
      I ptr.mut : location
    -> args.ArgParser ) =>: export: setArg
      I ..types.unwrapNamed =:: BaseInt
      argInfo .options for =:: elt
        elt .name
        location BaseInt ptr.mut cast!
          elt .value BaseInt cast
          elt .enable ! if argInfo .enableAllValue BaseInt cast  ^ end 
        BaseInt args.argInfoSetVal args.addArg
      end
      argInfo .enableAll .length 0 != if
        argInfo .enableAll
        location BaseInt ptr.mut cast!
          argInfo .enableAllValue BaseInt cast
        args.argInfoSetVal args.addArg
      end
      ## TODO handle help-text
    end
    proc( type.namedInteger : auto: I  args.ArgParser
      I FlagGroup : argInfo
      I ptr.mut : location
    -> args.ArgParser ) =>: export: collectArg
      I ..types.unwrapNamed =:: BaseInt
      argInfo .options for =:: elt
        elt .name
        location BaseInt ptr.mut cast!
          elt .value BaseInt cast
        elt .enable if
          args.argInfoBitEnableVal
        else
          args.argInfoBitDisableVal
        end args.addArg
      end
      argInfo .enableAll .length 0 != if
        argInfo .enableAll
        location BaseInt ptr.mut cast!
          argInfo .enableAllValue BaseInt cast
        args.argInfoSetVal args.addArg
      end
      ## TODO handle help-text
    end
  end
  struct(
    Common : common
    string : enable
    string : disable
  ) =:: FlagToggle
  proc( string : enable string : disable -> FlagToggle ) =>: export: flagToggle
    Common.default enable disable FlagToggle new
  end
  namespace: flagToggle
    proc( args.ArgParser
      FlagToggle : argInfo
      bool ptr.mut : location
    -> args.ArgParser ) =>: export: setArg
      argInfo .enable location args.ArgInfo .Enable args.addArg
      argInfo .disable location args.ArgInfo .Disable args.addArg
      ## TODO handle help-text
    end
    proc( args.ArgParser
      FlagToggle : argInfo
      bool list ptr.mut : location
    -> args.ArgParser ) =>: export: collectArg
      argInfo .enable location args.ArgInfo .AppendTrue args.addArg
      argInfo .disable location args.ArgInfo .AppendFalse args.addArg
      ## TODO handle help-text
    end
  end
  struct(
    Common : common
  ) =:: ValueArg
  proc( -> ValueArg ) =>: export: value
    Common.default ValueArg new
  end
  namespace: value
    proc( args.ArgParser
      ValueArg : argInfo
      string ptr.mut : location
      string : argName
    -> args.ArgParser ) =>: export: setArg
      argName location args.ArgInfo .Set args.addArg
      ## TODO handle help-text
    end
    proc( args.ArgParser
      ValueArg : argInfo
      string list ptr.mut : location
      string : argName
    -> args.ArgParser ) =>: export: collectArg
      argName location args.ArgInfo .Append args.addArg
      ## TODO handle help-text
    end
  end
  struct(
    Common : common
  ) =:: ValuesArg
  proc( -> ValuesArg ) =>: export: values
    Common.default ValuesArg new
  end
  namespace: values
    proc( args.ArgParser
      ValuesArg : argInfo
      string list ptr.mut : location
      string : argName
    -> args.ArgParser ) =>: export: setArg
      argName location args.ArgInfo .SetAll args.addArg
      ## TODO handle help-text
    end
    proc( args.ArgParser
      ValuesArg : argInfo
      string list ptr.mut : location
      string : argName
    -> args.ArgParser ) =>: export: collectArg
      argName location args.ArgInfo .AppendAll args.addArg
      ## TODO handle help-text
    end
  end
  proc( type : T -> type ) =>: SelectArgOption
    struct( string : name T : shadow: value )
  end
  proc( type : T -> type ) =>: SelectArg
    struct(
      Common : common
      T SelectArgOption list : options
      T optional : defaultValue
    )
  end
  proc( type : static: T -> T SelectArg ) =>: export: select
    Common.default T SelectArgOption list.empty T optional.empty T SelectArg new
  end
  namespace: select
    proc( type : auto: T T SelectArg T -> T SelectArg ) =>: export: default
      optional.wrap >$ .defaultValue=
    end
    proc( type : auto: T T SelectArg string : name T : val -> T SelectArg ) =>: export: option
      $ .options name val T SelectArgOption new list.append >$ .options=
    end
    proc( type : static: T -> type ) =>: static: nowrap: argBaseType
      T string == if
        string return
      else
        T ..types.unwrapNamed =:: BaseType
      BaseType type.isInteger _if
        BaseType return
      else BaseType type.isEnum _if
        BaseType ..types.unionTag ..types.unwrapNamed return
      else
        "SelectArg is currently only supported for integers, enums and strings" ..compiler.error
      end
    end
    proc( type : auto: T  args.ArgParser
      T SelectArg : argInfo
      T ptr.mut : location
    -> args.ArgParser ) =>: export: setArg
      T argBaseType =:: BaseType
      argInfo .options for =:: elt
        elt .name
        location BaseType ptr.mut cast!
          elt .value T type.isNamedEnum if ..tag end BaseType cast
        args.argInfoSetVal args.addArg
      end
      argInfo .defaultValue .if location =[] end
    end
    proc( type.namedInteger : auto: I  args.ArgParser
      I SelectArg : argInfo
      I list ptr.mut : location
    -> args.ArgParser ) =>: export: collectArg
      T argBaseType =:: BaseType
      argInfo .options for =:: elt
        elt .name
        location BaseType list ptr.mut cast!
          elt .value T type.isNamedEnum if ..tag end BaseType cast
        args.argInfoAddVal args.addArg
      end
    end
  end
  struct(
    Common : common
  ) =:: MiscArgs
  proc( -> MiscArgs ) =>: export: misc
    Common.default MiscArgs new
  end
  namespace: misc
    proc( MiscArgs -> MiscArgs ) =>: export: require

    end
    proc( args.ArgParser
      MiscArgs : argInfo
      string ptr.mut : location
    -> args.ArgParser ) =>: export: setArg
      location >$ .miscLocation.Set=
      ## TODO handle help-text
    end
    proc( args.ArgParser
      MiscArgs : argInfo
      string list ptr.mut : location
    -> args.ArgParser ) =>: export: collectArg
      location >$ .miscLocation.Append=
    end
  end
  struct(
    Common : common
  ) =:: HeadArgs
  proc( -> HeadArgs ) =>: export: head
    Common.default HeadArgs new
  end
  namespace: head
    proc( HeadArgs -> HeadArgs ) =>: export: require

    end
    proc( args.ArgParser
      HeadArgs : argInfo
      string ptr.mut : location
    -> args.ArgParser ) =>: export: setArg
      location >$ .headLocation.Set=
      ## TODO handle help-text
    end
    proc( args.ArgParser
      HeadArgs : argInfo
      string list ptr.mut : location
    -> args.ArgParser ) =>: export: collectArg
      location >$ .headLocation.Append=
    end
  end
  struct(
    Common : common
  ) =:: TailArgs
  proc( -> TailArgs ) =>: export: tail
    Common.default TailArgs new
  end
  namespace: tail
    proc( TailArgs -> TailArgs ) =>: export: require

    end
    proc( args.ArgParser
      TailArgs : argInfo
      string ptr.mut : location
    -> args.ArgParser ) =>: export: setArg
      location >$ .tailLocation.Set=
      ## TODO handle help-text
    end
    proc( args.ArgParser
      TailArgs : argInfo
      string list ptr.mut : location
    -> args.ArgParser ) =>: export: collectArg
      location >$ .tailLocation.Append=
    end
  end

  proc( args.ArgParser string : argName args.HelpLevel : level -> args.ArgParser ) =>: export: help
      argName level args.ArgInfo .Help args.addArg
  end
  overload: export: set
    flag.setArg flagToggle.setArg flagGroup.setArg
    value.setArg values.setArg
    select.setArg
    misc.setArg
  end
  overload: export: collect
    flag.collectArg flagToggle.collectArg flagGroup.collectArg
    value.collectArg values.collectArg
    select.collectArg
    misc.collectArg
  end
end
