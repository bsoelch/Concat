import future/int

namespace: float
  iSize =:: export: ExpData
  enum( EXACT FLOAT ) =:: export: FloatType
  namespace: ExpData
    proc( iSize : shadow: exponent FloatType : shadow: floatType -> ExpData ) =>: fromExponent
      exponent 1 << floatType ..tag iSize cast.u | ExpData cast.u
    end
    proc( ExpData : x iSize : a -> ExpData ) =>: scale
      x iSize cast.s a 1 << + ExpData cast.s
    end
    proc( ExpData -> iSize ) =>: exponent
      iSize cast.s 1 iSize.ashr ## signed shift
    end
    proc( ExpData -> bool ) =>: isExact
      iSize cast.u 1 & FloatType .EXACT ..tag iSize cast.u ==
    end
  end
  iSize =:: export: Precission
  namespace: Precission
    0 Precission cast =:: export: INFINITE
    proc( iSize -> Precission ) =>: fromBits
      1 iSize.max Precission cast
    end
    proc( Precission : a Precission : b -> Precission ) =>: max
      a INFINITE == if b return end
      b INFINITE == if a return end
      a iSize cast.u b iSize cast.u iSize.max Precission cast.u
    end
  end
  enum(
    HALF_EVEN ## (default) round < 0.5 down, > 0.5 up, 0.5 to even number
    HALF_ODD ## round < 0.5 down, > 0.5 up, 0.5 to odd number
    HALF_DOWN ## round < 0.5 down, > 0.5 up, 0.5 towards zero
    HALF_UP  ## round < 0.5 down, > 0.5 up, 0.5 away from zero
    HALF_FLOOR ## round < 0.5 down, > 0.5 up, 0.5 towards -infinity
    HALF_CEIL ## round < 0.5 down, > 0.5 up, 0.5 towards infinity
    DOWN ## round towards from zero
    UP ## round away from zero
    FLOOR ## round towards -infinity
    CEIL ## round towards infinity
  ) =:: RoundingMode
end
struct( int : magnitude float.ExpData : exponent ) =:: export: float

namespace: float
  int.ZERO      0 FloatType .EXACT ExpData.fromExponent float new =:: export: ZERO
  int.ONE       0 FloatType .EXACT ExpData.fromExponent float new =:: export: ONE
  int.MINUS_ONE 0 FloatType .EXACT ExpData.fromExponent float new =:: export: MINUS_ONE

  ## TODO: support rounding modes
  proc( int : magnitude iSize : exponent Precission : shadow: precission -> float ) =>: export: create
    precission Precission.INFINITE != and magnitude int.bitLength precission iSize cast.u u> if
      ## TODO round value
    end
    magnitude
      exponent
      precission Precission.INFINITE == if FloatType .EXACT else FloatType .FLOAT end ExpData.fromExponent
    float new
  end
## internal data management
  proc( float : a -> Precission ) =>: export: getPrecission
    a .exponent ExpData.isExact if
      Precission.INFINITE
    else
      a .magnitude int.bitLength Precission.fromBits
    end
  end
  proc( float i64 -> float ) =>: export: setPrecission
    "setPrecission" ..panic
  end
  proc( float iSize -> float ) =>: export: scale
    $1 .exponent <$ ExpData.scale >$ .exponent=
  end
  ## TODO? float -> mag * 2^exp (mag scaled to int)
  ## TODO? float -> mag * 2^exp (mag = 0 or 1 <= mag < 2)

## reference management
  proc( float : a -> float ) =>: export: copy
    a .magnitude int.copy a .exponent float new
  end
  proc( float -> ) =>: export: free
    .magnitude int.free
  end
