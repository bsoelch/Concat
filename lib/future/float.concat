## conversion from/to string
  ## TODO: support custom precission in operations
  ## two different string formats:
  ##  <base-prefix> <digit>+ ( '.' <digit>+ )?
  ##  <base-prefix> <digit> ( '.' <digit>+ )? <exp-char> [+-]? <digit>+
  proc( string : str i32 : base -> float number.ParserError ) =>: export: parse
    "unimplemented: parse" ..panic
  end
  proc( stringBuilder float : val i32 : base -> stringBuilder ) =>: export: sbBaseAppend
    val .exponent 0 iSize.sle if
      val .magnitude int.sign 0 < if '-' sb.appendC end
      val .magnitude int.copy int.abs =:: magnitude
      magnitude int.copy val .exponent -_ int.shr base int.sbBaseAppend ## integer part
      val .exponent 0 != if ## fractional part
        '.' sb.appendC
        ## TODO correctly handle fractional part
        ## 1. determine number of digits in given base
        ## 2. take fractional bits and scale by (base/2)^digitCount
        ## 3. round result to int
        ## 4. print int with leading zeros to match expected digit count
        ## --- tmp soltuion
        magnitude val .exponent -_ int.lowBits
          int.ONE val .exponent -_ int.shl int.mul
        base int.sbBaseAppend
      else magnitude int.free end
      return
    end
    "unimplemented: sbBaseAppend" ..panic
  end
  proc( stringBuilder float -> stringBuilder ) =>: export: sbAppend
    10 sbBaseAppend
  end
  proc( stringBuilder float -> stringBuilder ) =>: export: sbAppendX
    16 sbBaseAppend
  end
