## conversion from/to string
  ## TODO: support custom precission in operations
  ## two different string formats:
  ##  <base-prefix> <digit>+ ( '.' <digit>+ )?
  ##  <base-prefix> <digit> ( '.' <digit>+ )? <exp-char> [+-]? <digit>+
  proc( string : str i32 : base -> float number.ParserError ) =>: export: parse
    "unimplemented: parse" ..panic
  end
  { 0 0 1024 646 512 441 396 364 341 323 308 296 285 276 268 262 256 250 245
    241 236 233 229 226 223 220 217 215 213 210 208 206 204 202 201 199 198
    196 195 193 192 191 189 188 187 186 185 184 183 182 181 180 179 178 177
  177 176 175 174 174 173 172 171 } =:: BASE_DIGITS_1024BITS
  proc( iSize : bits i32 : base -> iSize ) =>: baseDigitsForBits
    ## TODO: use higher acuracy version if bit-count gets too high
    ## result should always be floor(bits*(log(2)/log(base)))
    bits BASE_DIGITS_1024BITS base [] iSize cast.u * 1024 u/
  end
  ## TODO special case handling for pow2 bases
  ## TODO: printing currently leakes memory (printed int-values), should print consume its argument?
  proc( stringBuilder float : val i32 : base -> stringBuilder ) =>: export: sbBaseAppendFixed
    val .exponent ExpData.exponent =:: exponent
    exponent 0 iSize.sle if
      val .magnitude int.sign 0 < if '-' sb.appendC end
      val .magnitude int.copy int.abs =:: magnitude
      exponent -_ =:: fracBits
      magnitude int.copy fracBits int.shr base int.sbBaseAppend ## integer part
      exponent 0 != if ## fractional part
        '.' sb.appendC
        magnitude fracBits int.lowBits =:: fracVal
        fracBits base baseDigitsForBits =:: fracDigits
        ## scale fractional bits by (base/2)^digitCount
        fracVal
          base int.fromI32 fracDigits i32 cast.u int.pow int.mul
          fracBits int.shr ## TODO rounding
        base '0' fracDigits int.sbPaddedBaseAppend
      else magnitude int.free end
      return
    else
      val .magnitude int.copy
        int.ONE exponent int.shl int.mul
      base int.sbBaseAppend ## integer part
    end
  end
  proc( stringBuilder float : val i32 : base -> stringBuilder ) =>: export: sbBaseAppendSci
    "unimplemented: sbBaseAppendSci" ..panic
  end
  proc( stringBuilder float : val i32 : base -> stringBuilder ) =>: export: sbBaseAppend
    val .exponent ExpData.exponent =:: exponent
    ## print as fixed-point if -bitlen-5 < exp <= 0
    exponent 0 iSize.sle and exponent -_ val .magnitude int.bitLength 5 + u< if
      val base sbBaseAppendFixed
    else
      val base sbBaseAppendSci
    end
  end
  proc( stringBuilder float -> stringBuilder ) =>: export: sbAppend
    10 sbBaseAppend
  end
  proc( stringBuilder float -> stringBuilder ) =>: export: sbAppendX
    16 sbBaseAppend
  end
