## comparisons
  proc( float : a float : b -> i32 ) =>: export: cmp
    "unimplemented: cmp" ..panic
  end
  proc( float : a float : b -> i32 ) =>: export: ucmp
    "unimplemented: ucmp" ..panic
  end
  proc( float : a float : b -> float ) =>: export: min
    a b cmp 0 < if
      b free a return
    else
      a free b return
    end
  end
  proc( float : a float : b -> float ) =>: export: max
    a b cmp 0 < if
      a free b return
    else
      b free a return
    end
  end
  proc( float : a float : b -> float ) =>: export: umin
    a b ucmp 0 < if
      b free a return
    else
      a free b return
    end
  end
  proc( float : a float : b -> float ) =>: export: umax
    a b ucmp 0 < if
      a free b return
    else
      b free a return
    end
  end
## arithmetic
  proc( float -> bool ) =>: export: isZero
    .magnitude int.isZero
  end
  ## -1 0 1
  proc( float -> i32 ) =>: export: sign
    .magnitude int.sign
  end
  proc( float -> float ) =>: export: abs
    $ .magnitude int.abs >$ .magnitude=
  end
  proc( float -> float ) =>: export: negate
    $ .magnitude int.negate >$ .magnitude=
  end
  ## TODO: add helpers for mixed operations
  proc( float : a float : b -> float ) =>: export: add
    a .magnitude =:: mut: aMag
    b .magnitude =:: mut: bMag
    a .exponent b .exponent iSize.sgt if
      bMag a .exponent b .exponent - int.shl bMag=
    else a .exponent  b .exponent iSize.slt _if
      aMag b .exponent a .exponent - int.shl aMag=
    end
    aMag bMag int.add
      a .exponent b .exponent iSize.max
      a .precission b .precission Precission.max
    float.create return
  end
  proc( float : a float : b -> float ) =>: export: sub
    a .magnitude =:: mut: aMag
    b .magnitude =:: mut: bMag
    a .exponent b .exponent iSize.sgt if
      bMag a .exponent b .exponent - int.shl bMag=
    else a .exponent  b .exponent iSize.slt _if
      aMag b .exponent a .exponent - int.shl aMag=
    end
    aMag bMag int.sub
      a .exponent b .exponent iSize.max
      a .precission b .precission Precission.max
    float.create return
  end
  ## TODO? error on exponent overflow/underflow
  proc( float : a float : b -> float ) =>: export: mul
    a .magnitude b .magnitude int.mul
      a .exponent b .exponent +
      a .precission b .precission Precission.max
    float.create return
  end
  proc( float : a -> float ) =>: export: square
    a .magnitude int.square
      a .exponent 2 *
      a .precission
    float.create return
  end
