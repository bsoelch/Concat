## bit-wise operations
  ## flipping all bits of doubly-infinite bit-sequence exactly gives negated number
  ## e.g. 1 <-> ...111110.1111111... <-> ...111111.0 <-> -1
  proc( float -> float ) : export: alias: bitNot negate
