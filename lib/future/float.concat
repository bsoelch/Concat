import future/int

namespace: float
  iSize =:: export: ExpData
  enum( EXACT FLOAT ) =:: export: FloatType
  namespace: ExpData
    proc( iSize : shadow: exponent FloatType : shadow: floatType -> ExpData ) =>: fromExponent
      exponent 1 << floatType ..tag iSize cast.u | ExpData cast.u
    end
    proc( ExpData : x iSize : a -> ExpData ) =>: scale
      x iSize cast.s a 1 << + ExpData cast.s
    end
    proc( ExpData -> iSize ) =>: exponent
      iSize cast.s 1 iSize.ashr ## signed shift
    end
    proc( ExpData -> bool ) =>: isExact
      iSize cast.u 1 & FloatType .EXACT ..tag iSize cast.u ==
    end
  end
  iSize =:: export: Precission
  iSize ..types.size i32 ..types.size == if
    56:iSize
  else
    64:iSize
  end =:: DEFAULT_PRECISSION
  namespace: Precission
    0 Precission cast =:: export: INFINITE
    proc( iSize -> Precission ) =>: export: fromBits
      1 iSize.max Precission cast
    end
    proc( Precission -> iSize optional ) =>: export: toBits
      $ INFINITE == if ..drop iSize optional.empty return end
      iSize cast.u optional.wrap
    end
    proc( Precission : a Precission : b -> Precission ) =>: max
      a INFINITE == if b return end
      b INFINITE == if a return end
      a iSize cast.u b iSize cast.u iSize.max Precission cast.u
    end
  end
  enum(
    HALF_EVEN ## (default) round < 0.5 down, > 0.5 up, 0.5 to even number
    HALF_ODD ## round < 0.5 down, > 0.5 up, 0.5 to odd number
    HALF_DOWN ## round < 0.5 down, > 0.5 up, 0.5 towards zero
    HALF_UP  ## round < 0.5 down, > 0.5 up, 0.5 away from zero
    HALF_FLOOR ## round < 0.5 down, > 0.5 up, 0.5 towards -infinity
    HALF_CEIL ## round < 0.5 down, > 0.5 up, 0.5 towards infinity
    DOWN ## round towards from zero
    UP ## round away from zero
    FLOOR ## round towards -infinity
    CEIL ## round towards infinity
  ) =:: RoundingMode
end
struct( int : magnitude float.ExpData : exponent ) =:: export: float

namespace: float
  int.ZERO      0 FloatType .EXACT ExpData.fromExponent float new =:: export: ZERO
  int.ONE       0 FloatType .EXACT ExpData.fromExponent float new =:: export: ONE
  int.TWO       0 FloatType .EXACT ExpData.fromExponent float new =:: export: TWO
  int.THREE     0 FloatType .EXACT ExpData.fromExponent float new =:: export: THREE
  int.MINUS_ONE 0 FloatType .EXACT ExpData.fromExponent float new =:: export: MINUS_ONE
  ## TODO: support rounding modes
  proc( int : magnitude iSize : exponent Precission : shadow: precission -> float ) =>: export: create
    magnitude
      exponent
      precission Precission.INFINITE == if FloatType .EXACT else FloatType .FLOAT end ExpData.fromExponent
    float new
    precission Precission.toBits .and =:: precBits magnitude int.bitLength precBits u> if
      precBits setPrecission
    end
  end
## internal data management
  proc( float : a -> Precission ) =>: export: getPrecission
    a .exponent ExpData.isExact if
      Precission.INFINITE
    else
      a .magnitude int.bitLength Precission.fromBits
    end
  end
  proc( float iSize : precBits -> float ) =>: export: setPrecission
    precBits RoundingMode .HALF_EVEN roundTo
    $ .magnitude int.bitLength precBits - =:: delta
    delta 0 iSize.sgt if
      $ .magnitude delta int.shr >$ .magnitude=
      $ .exponent delta ExpData.scale >$ .exponent=
    else delta 0 iSize.slt _if
      $ .magnitude delta -_ int.shl >$ .magnitude=
      $ .exponent delta ExpData.scale >$ .exponent=
    end
  end
  proc( float iSize -> float ) =>: export: scale
    $1 .exponent <$ ExpData.scale >$ .exponent=
  end
  ## TODO? float -> mag * 2^exp (mag scaled to int)
  ## TODO? float -> mag * 2^exp (mag = 0 or 1 <= mag < 2)

## reference management
  proc( float : a -> float ) =>: export: copy
    a .magnitude int.copy a .exponent float new
  end
  proc( float -> ) =>: export: free
    .magnitude int.free
  end
## rounding
  proc( float -> float ) =>: export: floor
    RoundingMode .FLOOR roundWith
  end
  proc( float -> float ) =>: export: ceil
    RoundingMode .CEIL roundWith
  end
  proc( float -> float ) =>: export: truncate
    RoundingMode .DOWN roundWith
  end
  proc( float -> float ) =>: export: roundEven
    RoundingMode .HALF_EVEN roundWith
  end
  proc( float RoundingMode : mode -> float ) =>: export: roundWith
    ## round number
    mode roundWithImpl
    ## set fractional part to zero
    $ .exponent ExpData.exponent =:: exponent
    exponent 0 iSize.sge if return end
    $ .magnitude exponent -_ int.clearLowBits >$ .magnitude=
  end
  overload: export: round roundEven roundWith end
  ## round the integer part but keep the float-part unchanged
  proc( float RoundingMode : mode -> float ) =>: export: roundWithImpl
    mode .DOWN if return end
    $ sign =:: shadow: sign
    mode .FLOOR and sign 0 > if return end
    mode .CEIL and sign 0 < if return end
    $ .exponent ExpData.exponent =:: exponent
    exponent 0 iSize.sge if return end ## no fractional part
    $ .magnitude exponent -_ int.checkLowBits =:: lowBits
    lowBits .ZERO if return end ## nothing to round
    ## check if value needs to be incremented
    mode switch
      HALF_EVEN case ## (default) round < 0.5 down, > 0.5 up, 0.5 to even number
        lowBits .LESS_THAN_HALF or lowBits .HALF and $ .magnitude exponent -_ int.checkBit ! if return end break
      HALF_ODD case ## round < 0.5 down, > 0.5 up, 0.5 to odd number
        lowBits .LESS_THAN_HALF or lowBits .HALF and $ .magnitude exponent -_ int.checkBit if return end break
      HALF_DOWN case ## round < 0.5 down, > 0.5 up, 0.5 towards zero
        lowBits .LESS_THAN_HALF or lowBits .HALF if return end break
      HALF_UP  case ## round < 0.5 down, > 0.5 up, 0.5 away from zero
        lowBits .LESS_THAN_HALF if return end break
      HALF_FLOOR case ## round < 0.5 down, > 0.5 up, 0.5 towards -infinity
        lowBits .LESS_THAN_HALF or lowBits .HALF and sign 0 > if return end break
      HALF_CEIL case ## round < 0.5 down, > 0.5 up, 0.5 towards infinity
        lowBits .LESS_THAN_HALF or lowBits .HALF and sign 0 < if return end break
      DOWN case ..unreachable
      UP FLOOR CEIL case break ## always increment value
    end
    ## update int-part according to value
    $ .magnitude exponent -_ int.incrementBit >$ .magnitude=
  end
  proc( float -> float ) =>: export: frac
    $ .exponent ExpData.exponent =:: exponent
    exponent 0 iSize.sge if free ZERO return end
    exponent -_ =:: fracBits
    $ .magnitude fracBits int.lowBits >$ .magnitude=
  end
  proc( float : f -> bool ) =>: export: isInt
    f .exponent ExpData.exponent =:: exponent
    exponent 0 iSize.sge if false return end
    f .magnitude exponent -_ int.checkLowBits .ZERO
  end
  proc( float iSize : precissionBits RoundingMode : mode -> float ) =>: export: roundTo
    $ .exponent ExpData.exponent =:: oldExponent
    ## scale to precission bits in integer part
    precissionBits $1 .magnitude int.bitLength - FloatType .EXACT ExpData.fromExponent >$ .exponent=
    mode roundWith ## round to int
    ## scale back to original scale
    oldExponent FloatType .FLOAT ExpData.fromExponent >$ .exponent=
  end
## conversions
  proc( int -> float ) =>: export: fromInt
    0 FloatType .EXACT ExpData.fromExponent float new
  end
  proc( i32 -> float ) =>: export: fromI32
    int.fromI32 fromInt
  end
  proc( i32 -> float ) =>: export: fromU32
    int.fromU32 fromInt
  end
  proc( i64 -> float ) =>: export: fromI64
    int.fromI64 fromInt
  end
  proc( i64 -> float ) =>: export: fromU64
    int.fromU64 fromInt
  end
  proc( float -> int ) =>: export: toIntTrunc
    RoundingMode .DOWN toIntRound
  end
  proc( float RoundingMode : mode -> int ) =>: export: toIntRound
    mode roundWithImpl
      $ .exponent ExpData.exponent =:: exponent
    .magnitude
      exponent 0 iSize.sgt if
        exponent int.shl
      else exponent 0 iSize.slt _if
        exponent -_ int.shr
      end
    return
  end
  overload: export: toInt toIntTrunc toIntRound end
  proc( float -> int optional ) =>: export: asInt
    "unimplemented: asInt" ..panic
  end
  proc( float -> i64 optional ) =>: export: asU64
    "unimplemented: asU64" ..panic
  end
  ## TODO: conversions from/to primitive
## conversion from/to string
  ## TODO: support custom precission in operations
  ## two different string formats:
  ##  <base-prefix> <digit>+ ( '.' <digit>+ )?
  ##  <base-prefix> <digit> ( '.' <digit>+ )? <exp-char> [+-]? <digit>+
  proc( string : str i32 : base -> float number.ParserError ) =>: export: parse
    using number.ParserError
    str
      number.parseSign =:: hasSign
      base number.resolveBase =:: shadow: base
      base 2 u< or base 62 u> if ..drop
        ZERO ParserError .INVALID_BASE return
      end
    =:: digits
    0:iSize =:: mut: digitCount
    0:iSize =:: mut: fracDigitCount
    false =:: mut: hasDot
    digits string.chars for
      hasDot ! and $ '.' == if
        ..drop true hasDot= continue
      end
      ## TODO handle exponents
      base number.parseDigit switch
        DIGIT case ..drop
          digitCount 1 + digitCount=
          hasDot if fracDigitCount 1 + fracDigitCount= end
        continue
        IGNORED case ..drop continue
        INVALID case ..drop ZERO ParserError .INVALID_CHAR return
      end
    end
    digits digitCount base int.parseRaw fromInt
      fracDigitCount 0 != if
        base i32.isPow2 if ## base is power of two
          base i32.highestSetBit 1 + -_ iSize cast.s scale
        else
          base int.fromU32 fracDigitCount i32 cast.u int.pow fromInt
            $1 .magnitude int.bitLength $1 .magnitude int.bitLength iSize.max DEFAULT_PRECISSION iSize.max
              $ =:: valPrec
            5 + setPrecission
          div valPrec setPrecission
        end
      end
    ParserError .NONE return
  end
  { 0 0 1024 646 512 441 396 364 341 323 308 296 285 276 268 262 256 250 245
    241 236 233 229 226 223 220 217 215 213 210 208 206 204 202 201 199 198
    196 195 193 192 191 189 188 187 186 185 184 183 182 181 180 179 178 177
  177 176 175 174 174 173 172 171 } =:: BASE_DIGITS_1024BITS
  proc( iSize : bits i32 : base -> iSize ) =>: baseDigitsForBits
    ## TODO: use higher acuracy version if bit-count gets too high
    ## result should always be floor(bits*(log(2)/log(base)))
    bits BASE_DIGITS_1024BITS base [] iSize cast.u * 1024 u/
  end
  ## TODO special case handling for pow2 bases
  proc( stringBuilder float : val i32 : base -> stringBuilder ) =>: export: sbBaseAppendFixed
    val .exponent ExpData.exponent =:: exponent
    exponent 0 iSize.sle if
      val sign 0 < if '-' sb.appendC end
      val abs =:: shadow: val
      exponent -_ =:: fracBits
      fracBits base baseDigitsForBits =:: fracDigits
      fracDigits 0 == if ## not enough precission for a fractional digit
        val RoundingMode .HALF_EVEN toInt base int.sbBaseAppend ## round to int
        return
      end
      val copy RoundingMode .DOWN toInt base int.sbBaseAppend ## integer part
      val isInt ! if ## fractional part
        '.' sb.appendC
        val float.frac =:: fracVal
        ## scale fractional bits by (base/2)^digitCount
        fracVal
          base int.fromI32 fracDigits i32 cast.u int.pow fromInt mul
          RoundingMode .HALF_EVEN toInt
        base '0' fracDigits int.sbPaddedBaseAppend
        ## TODO: print-mode that includes digits up to precission
        ## discard trailing 0s
        $ .length while $1 $1 1 - sb.charAt '0' == do 1 - end sb.setLength
      else val free end
      return
    else
      val .magnitude exponent int.shl base int.sbBaseAppend ## integer part
    end
  end
  proc( stringBuilder float : val i32 : base -> stringBuilder ) =>: export: sbBaseAppendSci
    "unimplemented: sbBaseAppendSci" ..panic
  end
  proc( stringBuilder float : val i32 : base -> stringBuilder ) =>: export: sbBaseAppend
    val .exponent ExpData.exponent =:: exponent
    ## print as fixed-point if -(bitlen(val)+3*bitlen(base)) < exp < bitlen(base)
    base i32.highestSetBit 1 + iSize cast.u =:: baseBits
    exponent baseBits iSize.slt and exponent val .magnitude int.bitLength baseBits 3 * + -_ iSize.sgt if
      val base sbBaseAppendFixed
    else
      val base sbBaseAppendSci
    end
  end
  proc( stringBuilder float -> stringBuilder ) =>: export: sbAppend
    10 sbBaseAppend
  end
  proc( stringBuilder float -> stringBuilder ) =>: export: sbAppendX
    16 sbBaseAppend
  end
## comparisons
  proc( float : a float : b -> i32 ) =>: export: cmp
    a .magnitude int.sign =:: aSign
    b .magnitude int.sign =:: bSign
    aSign bSign != if
      aSign bSign - return
    end
    a b ucmp aSign * return
  end
  proc( float : a float : b -> i32 ) =>: export: ucmp
    a .exponent ExpData.exponent =:: aExp
    b .exponent ExpData.exponent =:: bExp
    aExp a .magnitude int.bitLength + bExp b .magnitude int.bitLength + iSize.cmp =:: sCmp
    sCmp 0 != if
      sCmp return
    end
    ## TODO need shifted integer comparisson
    "unimplemented: ucmp" ..panic
  end
  proc( float : a float : b -> float ) =>: export: min
    a b cmp 0 < if
      b free a return
    else
      a free b return
    end
  end
  proc( float : a float : b -> float ) =>: export: max
    a b cmp 0 < if
      a free b return
    else
      b free a return
    end
  end
  proc( float : a float : b -> float ) =>: export: umin
    a b ucmp 0 < if
      b free a return
    else
      a free b return
    end
  end
  proc( float : a float : b -> float ) =>: export: umax
    a b ucmp 0 < if
      a free b return
    else
      b free a return
    end
  end
## arithmetic
  proc( float -> bool ) =>: export: isZero
    .magnitude int.isZero
  end
  ## -1 0 1
  proc( float -> i32 ) =>: export: sign
    .magnitude int.sign
  end
  proc( float -> float ) =>: export: abs
    $ .magnitude int.abs >$ .magnitude=
  end
  proc( float -> float ) =>: export: negate
    $ .magnitude int.negate >$ .magnitude=
  end
  ## TODO: add helpers for operations on mixed types
  proc( float : a float : b -> float ) =>: export: add
    a .magnitude =:: mut: aMag
    b .magnitude =:: mut: bMag
    a .exponent ExpData.exponent =:: aExp
    b .exponent ExpData.exponent =:: bExp
    a getPrecission b getPrecission Precission.max =:: resPrecission
    aExp bExp iSize.sgt if
      aMag aExp bExp - int.shl aMag=
    else aExp bExp iSize.slt _if
      bMag bExp aExp - int.shl bMag=
    end
    aMag bMag int.add
      aExp bExp iSize.smin
      resPrecission
    float.create return
  end
  proc( float : a float : b -> float ) =>: export: sub
    a .magnitude =:: mut: aMag
    b .magnitude =:: mut: bMag
    a .exponent ExpData.exponent =:: aExp
    b .exponent ExpData.exponent =:: bExp
    a getPrecission b getPrecission Precission.max =:: resPrecission
    aExp bExp iSize.sgt if
      aMag aExp bExp - int.shl aMag=
    else aExp bExp iSize.slt _if
      bMag bExp aExp - int.shl bMag=
    end
    aMag bMag int.sub
      aExp bExp iSize.smin
      resPrecission
    float.create return
  end
  ## TODO? error on exponent overflow/underflow
  proc( float : a float : b -> float ) =>: export: mul
    a .exponent ExpData.exponent =:: aExp
    b .exponent ExpData.exponent =:: bExp
    a getPrecission b getPrecission Precission.max =:: resPrecission
    a .magnitude b .magnitude int.mul
      aExp bExp +
      resPrecission
    float.create return
  end
  proc( float : a -> float ) =>: export: square
    a .exponent ExpData.exponent =:: aExp
    a getPrecission =:: prec
    a .magnitude int.square
      aExp 2 *
      prec
    float.create return
  end
  proc( float : x -> float ) =>: export: sqrt
    x .magnitude int.bitLength
      $ =:: srcBits
      x .exponent ExpData.isExact if
        DEFAULT_PRECISSION iSize.max
      end
    =:: precission
    x copy
      precission setPrecission
    $ copy invert =:: xInv
    ## initial estimate: scale top coefficient to match expected scale
      $ .exponent ExpData.exponent srcBits - 2 / ## (bitlen+exp)/2 - bitlen
      FloatType .FLOAT ExpData.fromExponent >$ .exponent=
    ## iteration step: y =  y + y(1-y^2/A)/2 (precompute 1/A to needed precission)
      ## TODO: what is a good lower bound for the number of iteration steps
      precission i64 cast.u i64.highestSetBit 1 + for ..drop
        $ copy ONE $1 copy square xInv copy mul sub mul -1 scale add
      end
      $ copy ONE $1 copy square xInv mul sub mul -1 scale add
    return
  end
  proc( float : x -> float ) =>: export: cbrt
    x .magnitude int.bitLength
      $ =:: srcBits
      x .exponent ExpData.isExact if
        DEFAULT_PRECISSION iSize.max
      end
    =:: precission
    THREE copy
      precission 1 + setPrecission
    invert =:: oneThird
    x copy
      precission setPrecission
    $ copy invert =:: xInv
    ## initial estimate: scale top coefficient to match expected scale
      $ .exponent ExpData.exponent srcBits 2 * - 3 / ## (bitlen+exp)/3 - bitlen = (exp-2*bitlen)/3
      FloatType .FLOAT ExpData.fromExponent >$ .exponent=
    ## iteration step: y =  y + y(1-y^3/A)/3 (precompute 1/A to needed precission)
      ## TODO: what is a good lower bound for the number of iteration steps
      precission i64 cast.u i64.highestSetBit 1 + for ..drop
        $ copy ONE $1 copy $ copy square mul xInv copy mul sub mul oneThird copy mul add
      end
      $ copy ONE $1 copy $ copy square mul xInv mul sub mul oneThird mul add
    return
  end
  proc( float : x -> float ) =>: export: invert
    x .magnitude int.bitLength
      x .exponent
        $ ExpData.exponent $2 + -_ =:: scaleFactor
      ExpData.isExact if
        x $1 -_ FloatType .EXACT ExpData.fromExponent >$ .exponent=
        >$ DEFAULT_PRECISSION iSize.max <$
      else
        x $1 -_ FloatType .FLOAT ExpData.fromExponent >$ .exponent=
      end =:: shadow: x
    =:: precission
    ## compute Newton-Raphson inverse (https://en.wikipedia.org/wiki/Division_algorithm#Newton%E2%80%93Raphson_division)
    0x2'd2d_2d2d_2d2d:i64 0x2d2d_2d2d_2d2d_2d2d:i64 i128.create int.fromU128
      -108:iSize float.Precission.INFINITE
    float.create =:: p ## 48/17
    0x1'e1e_1e1e_1e1e:i64 0x1e1e_1e1e_1e1e_1e1e:i64 i128.create int.fromU128
      -108:iSize float.Precission.INFINITE
    float.create =:: q ## 32/17
    ## initial estimate: y0 = 48/17 - 32/17 * x  [error at most 1/17+2^-100]
    p q x copy mul sub ## TODO? combined mul-add / mul-sub operations
      precission setPrecission
    ## iteration step: y =  y + y*( 1 - y*x )  -> doubles number of correct digits
      ## precission after N steps is 2^S * log 17 -1 -> need aproximately:  ceil(log2 (P/4 +1)) steps
      ## TODO? compute early steps with lower precission to reduce required computation time, two steps with full precission should be enough to get accurate result from value computed with half precission
      precission 4 / 1 + i64 cast.u i64.highestSetBit 1 + for ..drop
        $ copy ONE $1 copy x copy mul sub mul add
      end
      $ copy ONE $1 copy x mul sub mul add
      $ .exponent scaleFactor ExpData.scale >$ .exponent=
    return
  end
  proc( float : a float : b -> float ) =>: export: div
    a getPrecission b getPrecission Precission.max =:: resPrecission
    ## TODO: ensure precission of b is a least precission/bit-length of a
    a
      b resPrecission Precission.toBits .if setPrecission end invert
    mul
  end
  proc( float : a float : b -> float #+div+# float #+rem+# ) =>: export: divRem
    ## rem = a-b*floor(a/b)
    ## TODO! compute division with higher precission to get full-precission for remainder
    a copy b copy div floor
      a b $2 copy mul sub
    return
  end
  proc( float float -> float ) =>: export: rem
    divRem >$ free
  end
  proc( iSize : precission -> float ) =>: export: ln2
    ## ? use caching + netwon method to get on demand value of ln2 to arbitary precission
    "unimplemented: ln2" ..panic
  end
  ## TODO? seperate special-case function for 1/ln2
  proc( float : x -> float ) =>: export: exp
    x MINUS_ONE cmp 0 < if ## TODO what is a good threshold for exp(-x) -> 1/exp(x)? (-0.5 ?)
      x negate exp invert return
    end
    x .magnitude int.bitLength
      x .exponent ExpData.isExact if
        DEFAULT_PRECISSION iSize.max
      end
    =:: precission
    x ONE cmp 0 > if ## TODO? reduce limit to about sqrt(2)/2
      x
        precission 5 + ln2 ## TODO find good precission value for ln2 to get accurate final result
      divRem =:: q =:: p ## x = p*ln2 + q ## TODO: change range to -ln2/2 <= q <= ln2/2 instead of 0 <= q <= ln2
      q exp p asU64 <unwrap> iSize cast.u scale return ## exp x = (exp q)*2^p
    end
    ## -1 < x < 1
    ONE =:: mut: res
    x copy =:: mut: p
     2:iSize while p .magnitude int.bitLength p .exponent ExpData.exponent + precission -_ iSize.sge do =:: N
      res p copy add res=
      p x mul N i64 cast.u fromU64 div p=
    finally N 1 + end ..drop
    res p add res=
      x free
    res return
  end
  ## directly compute exp(x)-1, improved accuracy for values arround zero compared to exp(x)-1
  proc( float : x -> float ) =>: export: exp1m
    x abs ONE cmp 0 > if ## |x| > 1 -> fall back to using regular exp (TODO? is x < -0.5 | x > 1.5  a better threshold)
      x exp ONE sub return
    end
    x .magnitude int.bitLength
      $ x .exponent ExpData.exponent + =:: xScale
      x .exponent ExpData.isExact if
        DEFAULT_PRECISSION iSize.max
      end
    =:: precission
    ## -1 <= x <= 1
    ZERO =:: mut: res
    x copy =:: mut: p
     2:iSize while p .magnitude int.bitLength p .exponent ExpData.exponent xScale - + precission -_ iSize.sge do =:: N
      res p copy add res=
      p x mul N i64 cast.u fromU64 div p=
    finally N 1 + end ..drop
    res p add res=
      x free
    res return
  end

  ## TODO compute logarithms:
  ##   1. split x = p * 2^k (2/3<=p<4/3), k in N
  ##   2. log x = (log p) + k*(log 2)
  proc( float -> float ) =>: export: log2
    ## x = p*2^k => log2 x = log2 p + k = log1p(p-1)/ln2 + k
    "unimplemented: log2" ..panic
  end
  proc( float -> float ) =>: export: log
    ## x = p*2^k => log x = log p + k*ln2 = log1p(p-1) + k*ln2
    "unimplemented: log" ..panic
  end
  ## directly compute log(1+y), improves accuracy compared to indirect computations
  proc( float : y -> float ) =>: export: log1p
    y MINUS_ONE cmp 0 <= if
      "logarithm only supported for positive number" ..panic
    end
    y ONE cmp 0 > if ## y > 1 -> fall back to using regular log
      y ONE sub log return
    end
    ## taylor approximate log1p y  using  x -> x + (exp1m x - y)/(exp1m x + 1)
    y copy
      1 for ..drop ## TODO! find good iteration count
        $ copy exp1m =:: e1m
          e1m copy ONE add
          e1m y copy sub
        >$ div add
      end
      y free
    return
  end
  proc( float -> float ) : export: alias: ln log
  proc( float : x float : b -> float ) =>: export: logB
    x log2 b log2 div
  end
  proc( float : b float : p -> float ) =>: export: pow
    ## TODO? special casing for integer powers
    ## TODO? special handling for negative powers
    b log p mul exp
  end
## bit-wise operations
  ## flipping all bits of doubly-infinite bit-sequence exactly gives negated number
  ## e.g. 1 <-> ...111110.1111111... <-> ...111111.0 <-> -1
