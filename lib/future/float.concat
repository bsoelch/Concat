  proc( float : a float : b -> float ) =>: export: min
    a b cmp 0 < if
      b free a return
    else
      a free b return
    end
  end
  proc( float : a float : b -> float ) =>: export: max
    a b cmp 0 < if
      a free b return
    else
      b free a return
    end
  end
  proc( float : a float : b -> float ) =>: export: umin
    a b ucmp 0 < if
      b free a return
    else
      a free b return
    end
  end
  proc( float : a float : b -> float ) =>: export: umax
    a b ucmp 0 < if
      a free b return
    else
      b free a return
    end
  end
## arithmetic
  proc( float -> bool ) =>: export: isZero
    .magnitude int.isZero
  end
  ## -1 0 1
  proc( float -> i32 ) =>: export: sign
    .magnitude int.sign
  end
  proc( float -> float ) =>: export: abs
    $ .magnitude int.abs >$ .magnitude=
  end
  proc( float -> float ) =>: export: negate
    $ .magnitude int.negate >$ .magnitude=
  end
  ## TODO: add helpers for mixed operations
  proc( float : a float : b -> float ) =>: export: add
    a .magnitude =:: mut: aMag
    b .magnitude =:: mut: bMag
    a .exponent ExpData.exponent =:: aExp
    b .exponent ExpData.exponent =:: bExp
    a getPrecission b getPrecission Precission.max =:: resPrecission
    aExp bExp iSize.sgt if
      bMag aExp bExp - int.shl bMag=
    else aExp bExp iSize.slt _if
      aMag bExp aExp - int.shl aMag=
    end
    aMag bMag int.add
      aExp bExp iSize.max
      resPrecission
    float.create return
  end
  proc( float : a float : b -> float ) =>: export: sub
    a .magnitude =:: mut: aMag
    b .magnitude =:: mut: bMag
    a .exponent ExpData.exponent =:: aExp
    b .exponent ExpData.exponent =:: bExp
    a getPrecission b getPrecission Precission.max =:: resPrecission
    aExp bExp iSize.sgt if
      bMag aExp bExp - int.shl bMag=
    else aExp bExp iSize.slt _if
      aMag bExp aExp - int.shl aMag=
    end
    aMag bMag int.sub
      aExp bExp iSize.max
      resPrecission
    float.create return
  end
  ## TODO? error on exponent overflow/underflow
  proc( float : a float : b -> float ) =>: export: mul
    a .exponent ExpData.exponent =:: aExp
    b .exponent ExpData.exponent =:: bExp
    a getPrecission b getPrecission Precission.max =:: resPrecission
    a .magnitude b .magnitude int.mul
      aExp bExp +
      resPrecission
    float.create return
  end
  proc( float : a -> float ) =>: export: square
    a .exponent ExpData.exponent =:: aExp
    a getPrecission =:: prec
    a .magnitude int.square
      aExp 2 *
      prec
    float.create return
  end
