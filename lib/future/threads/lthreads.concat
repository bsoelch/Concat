import mem
import linux/syscalls

## thread implementation on top of linux syscalls
namespace: sys
  proc.c( -> ( -> ) ptr ptr.raw ) : extern: getBasePointer
  proc.c( -> ) : extern: cctThreadInit
end
namespace: thread
  i64 =:: export: ThreadId

  proc( -> ) =>: export: exit
    ## TODO? cleanup thread, notify parent, ...
    0 linux.sys_exit
    ..unreachable
  end
  proc( ThreadId -> bool ) =>: export: join
    "unimplemented" ..panic
  end

  proc( i64 : stackSize -> i64 i64 ) =>: createStack
    0x1000:i64 =:: pageSize
    ## sys_mmap
      0 linux.mmap.NO_FILE
      linux.mmap.MAP_PRIVATE linux.mmap.MAP_ANONYMOUS | linux.mmap.MAP_STACK |
      linux.mmap.PROT_NONE
      stackSize pageSize +
      linux.nullPtr
    linux.sys_mmap i64 cast! =:: stackMem
    stackMem 0 > "stackMem is a valid pointer" assert
    stackMem pageSize + =:: stackSpace
    ## sys_protect
      linux.mmap.PROT_READ linux.mmap.PROT_WRITE |
      stackSize
      stackSpace ..ctype.void ptr.raw.mut cast!
    linux.sys_protect ? ! "sys_protect succeeds" assert
    stackMem stackSize + ( -> ) ptr ptr.raw.mut cast! =:: stackHead
    threadExit@ stackHead -1 =[]
    stackMem stackSize ( -> ) ptr ..types.size i64 cast.u -
  end
  proc( i64 : stackMem i64 : stackSize -> i64 ) =>: cloneProcess
    using linux.clone.
    CloneArgs : mut: cloneArgs
    cloneArgs@ 1:iSize mem.clear ..drop
    cloneArgs
      CLONE_VM CLONE_FS | CLONE_FILES | CLONE_SIGHAND | CLONE_THREAD | >$ .flags=
      stackMem >$ .stack=
      stackSize >$ .stackSize=
    cloneArgs=
    CloneArgs ..types.size i64 cast.u cloneArgs@ linux.sys_clone3
    ## TODO error handling
  end

  ## FIXME: update assembly to handle passing arg to thread
  proc( type .with( ..types.size iSize ..types.size u<= ) : auto: T
    ( T -> ) ptr : f
    T : arg
  -> ThreadId optional ) =>: export: create
    0x10000:i64 createStack =:: stackSize =:: stackMem
    stackMem stackSize + iSize ptr.raw.mut cast! =:: stackHead
    arg iSize ..bitcast stackHead -1 =[]
    target iSize cast! stackHead -2 =[]
    stackMem stackSize iSize ..types.size 2 * i64 cast.u - cloneProcess
      $ 0 < if ..drop ThreadId optional.empty return end
    ThreadId cast optional.wrap
  end

  ## runs a new thread at the call location of this procedure
  ## assumes stack-frame layout of System-V calling convention
  ##   * rbp points to start of current stack-frame
  ##   * directly below rbp is the return address
  ##   * the value at address [rbp] points to start of previous stackframe
  ##
  ##   parentBase retAddr parentStack [parentBase] parentRet
  ##   ^basePtr                       ^parentBase
  proc( -> i64 ) =>: export: clone
    sys.getBasePointer =:: basePtr
    0x10000:i64 createStack =:: stackSize =:: stackMem
    ## copy stack-frame of caller into thread stack
    stackMem stackSize + ( -> ) ptr ptr.raw.mut cast! =:: mut: stackHead
    basePtr [] ( -> ) ptr ptr.raw cast! =:: parentBase
    basePtr parentBase ptr.diff i64 cast =:: parentFrameSize
    stackHead -1 @[] ( -> ) ptr cast! =:: newBaseP
    newBaseP stackHead -1 =[]
    stackHead parentFrameSize 1 + -_ @[]
      basePtr 1 @[]
      parentFrameSize iSize cast.u
    mem.copy stackHead=
    ## setup thread initialisation
    ## clone will return to cctThreadInit, which updates the base-pointer and returns to the caller
    newBaseP stackHead -1 =[]
    sys.cctThreadInit@ stackHead proc.c( -> ) ptr ptr.raw.mut cast! -2 =[]
    stackMem stackSize ( -> ) ptr ..types.size i64 cast.u parentFrameSize 3 + * - cloneProcess
  end
end
