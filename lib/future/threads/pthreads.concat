"threads" import
"pthreads.c" ..include
namespace: thread
  i64 =:: export: ThreadId
end
namespace: c
  proc.c( iSize proc.c( iSize -> ) ptr thread.ThreadId ptr.mut -> ..ctype.int ) : extern: cct_helper_createPThread
  proc.c( thread.ThreadId -> ..ctype.int ) : extern: cct_helper_joinPThread
  proc.c( -> ) : extern: cct_helper_exitPThread
end
namespace: thread
  #+proc( ThreadArgType : auto: T
    proc.c( T -> ) ptr : f
    T : arg
  -> ThreadId optional )+# ThreadCreateType ..types.unwrapNamed =>: export: create
    ThreadId : mut: res
    arg union.raw( T : Val iSize : Data ) .Val .Data
      f proc.c( iSize -> ) ptr cast!
      res@
    c.cct_helper_createPThread i32 cast 0 != if
      ThreadId optional.empty return
    end
    res optional.wrap return
  end
  proc( ThreadId -> bool ) =>: export: join
    c.cct_helper_joinPThread i32 cast 0 !=
  end
  proc( -> ) =>:  export: exit
    c.cct_helper_exitPThread
  end
end
