"mutex" import
namespace: thread
  type : export: ThreadId
  type .with( ..types.size iSize ..types.size u<= ) =:: export: ThreadArgType
  proc( ThreadArgType : auto: T
    proc.c( T -> ) ptr : f
    T : arg
  -> ThreadId optional ) =:: export: ThreadCreateType ## FIXME! temporary type declaration until equality for generic procs works as expected correctly
  ThreadCreateType ..types.unwrapNamed : export: create
  proc( ThreadId -> bool ) : export: join
  proc( -> ) : export: exit  
end
true or ..compiler.system.glibc if
  "pthreads" import
else ..compiler.system.linux _if
  "lthreads" import
else
  "threads are not supported on this system" ..compiler.error
end
