"mutexAMD64.s" ..include
namespace: c
  proc.c( i32 ptr.mut -> ) : extern: cctLockAcquire
  proc.c( i32 ptr.mut -> bool ) : extern: cctLockTryAcquire
  proc.c( i32 ptr.mut -> bool ) : extern: cctLockRelease
  ## TODO? make built-in
  proc.c( -> ) : extern: cctThreadYield
end
namespace: thread
  proc( -> ) =>: export: yield
    c.cctThreadYield
  end
  i32 ptr.mut =:: Lock
  proc( i32 ptr.mut -> Lock ) =>: export: createLock
    Lock cast
  end
  proc( Lock -> ) =>: export: acquireLock
    i32 ptr.mut cast c.cctLockAcquire
  end
  #+ returns false is successfull and true if lock already active
    example usage:
    while lock tryAcquireLock do
      ## suspend thread
    end
    ... locked
  +#
  proc( Lock -> bool ) =>: export: tryAcquireLock
    i32 ptr.mut cast c.cctLockTryAcquire
  end
  proc( Lock -> ) =>: export: releaseLock
    i32 ptr.mut cast c.cctLockRelease if
      "released lock was not held" ..panic
    end
  end
end
