## arithmetic
  proc( int -> bool ) =>: export: isZero
    $ .length 0 != if false return end
    $ .data IntData.asInt
      .else false return end
    0 == return
  end
  ## -1 0 1
  proc( int -> i32 ) =>: export: sign
    $ isZero if 0 return end
    .data IntData.getSign if -1 else 1 end return
  end
  proc( int -> int ) =>: export: abs
    $ .data false IntData.setSign >$ .data=
  end
  proc( int -> int ) =>: export: negate
    $ .data IntData.flipSign >$ .data=
  end
  proc( int : a int : b -> int ) =>: export: add
    a sign
      $ 0 == if ..drop a free b return end
    =:: aSign
    b sign
      $ 0 == if ..drop b free a return end
    =:: bSign
    aSign bSign != if a b negate sub return end
    a bitLength b bitLength iSize.max 1 + =:: resultBits
    ## handle small results
    resultBits MAX_INLINE_BITS < if
      resultBits 64 < if
        a abs asU64 b abs asU64 + fromU64 aSign 0 < if negate end
      else resultBits 128 < _if
        a abs asU128 b abs asU128 + fromU128 aSign 0 < if negate end
      end
    end
    Digit MAX_INLINE_DIGITS array : mut: bufA
    Digit MAX_INLINE_DIGITS array : mut: bufB
    a bufA@ asSlice =:: aData
    b bufB@ asSlice =:: bData
    resultBits DIGIT_BITS 1 - + DIGIT_BITS / =:: resultDigits
    a resultDigits asWritableBuffer .else
    b resultDigits asWritableBuffer ._else
    else
      resultDigits prepareCap
    end =:: dstData
    aData bData dstData _impl.add =:: resData
    resData .data IntData.fromPtr aSign 0 < IntData.setSign resData .length int new
  end
  proc( int : a i32 : b -> int ) =>: export: addI32
    b 0 == if a return end
    a sign
      $ 0 == if ..drop a free b fromI32 return end
    =:: aSign
    "unimplemented: addI32" ..panic
  end
  proc( int i32 -> int ) =>: export: addU32
    "unimplemented: addU32" ..panic
  end
  proc( int i32 -> int ) =>: export: addU32internal
    "unimplemented: addU32internal" ..panic
  end
  proc( int i64 -> int ) =>: export: addI64
    "unimplemented: addI64" ..panic
  end
  proc( int i32 -> int ) =>: export: addU64
    "unimplemented: addU64" ..panic
  end
  proc( int i128 -> int ) =>: export: addI128
    "unimplemented: addI64" ..panic
  end
  proc( int i128 -> int ) =>: export: addU128
    "unimplemented: addU64" ..panic
  end
  proc( int int -> int ) =>: export: sub
    a sign
      $ 0 == if ..drop a free b negate return end
    =:: aSign
    b sign
      $ 0 == if ..drop b free a return end
    =:: bSign
    aSign bSign != if a b negate add return end
    a bitLength b bitLength iSize.max =:: resultBits
    ## handle small results
    resultBits MAX_INLINE_BITS < if
      resultBits 64 < if
        a abs asU64 b abs asU64 - fromU64 aSign 0 < if negate end
      else resultBits 128 < _if
        a abs asU128 b abs asU128 - fromU128 aSign 0 < if negate end
      end
    end
    Digit MAX_INLINE_DIGITS array : mut: bufA
    Digit MAX_INLINE_DIGITS array : mut: bufB
    a bufA@ asSlice =:: aData
    b bufB@ asSlice =:: bData
    resultBits DIGIT_BITS 1 - + DIGIT_BITS / =:: resultDigits
    a resultDigits asWritableBuffer .else
    b resultDigits asWritableBuffer ._else
    else
      resultDigits prepareCap
    end =:: dstData
    aData bData _impl.cmp =:: cmp
    cmp 0 < if
      aData bData dstData _impl.add =:: resData
      resData .data IntData.fromPtr aSign 0 < IntData.setSign resData .length int new
    else cmp 0 > _if
      bData aData dstData _impl.add =:: resData
      resData .data IntData.fromPtr aSign 0 > IntData.setSign resData .length int new
    else
      ZERO
    end
  end
  proc( int int -> int ) =>: export: mul
    "unimplemented: mul" ..panic
  end
  proc( int int -> int ) =>: export: square
    "unimplemented: square" ..panic
  end
  enum( DIV REM DIV_REM FLOOR_DIV MOD DIV_MOD ) =:: DivideResult
  proc( int : a int : b DivideResult -> int : div int : rem ) =>: divRem0
    ## 1. handle signs
    ## 2. handle small numbers
    ## 3. choose good division algorithm
    ## 4. create result
    "unimplemented: divRem" ..panic
