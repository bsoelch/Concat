  proc( stringBuilder : sb int : i => stringBuilder ) =: public dumpHex
    sb
      i .sign 0 < if
        '-' sb.appendC
      end
      i .cap 0 == if
        i .data .i sb.appendUHex return
      end
      true =:: mut first
      i .size 1 - while #dup 0 >= do
        #swap
          i .data .p #over:2 [] u32.MASK & =:: D
          first ! if
            '\'' sb.appendC
            D 0 == if
              "00000000" sb.appendS
              #swap 1 - continue
            end
            0xf000_0000 while #dup D & 0 == do
              #swap
                '0' sb.appendC
              #swap 4 >>u
            end #drop
          end
          D sb.appendUHex
        #swap 1 -
        false first =
      end #drop
    return
  end
  proc( i32 arrayView : data => ) =: dumpIntData
    17 data .length * sb.create
      true =:: mut first
      data .length 1 - while #dup 0 >= do
        #swap
          data #over:2 array.get u32.MASK & =:: D
          first ! if
            '\'' sb.appendC
            D 0 == if
              "00000000" sb.appendS
              #swap 1 - continue
            end
            0xf000_0000 while #dup D & 0 == do
              #swap
                '0' sb.appendC
              #swap 4 >>u
            end #drop
          end
          D sb.appendUHex
        #swap 1 -
        false first =
      end #drop
      '\n' sb.appendC
      io.stdOut #over io.fputSb #drop
    sb.free #drop
  end

