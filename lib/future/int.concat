import mem
import slice
import optional
import string
import list
import stringBuilder
import numbers/i128

namespace: int
  iSize ..types.size i32 ..types.size >= "iSize has at least 32 bits" assert
  iSize ..types.size i32 ..types.size == =:: BITS_32

  i64 =:: Digit
  64 =:: DIGIT_BITS
  namespace: Digit
    proc( bool : carry Digit : a Digit : b -> bool Digit ) : alias: addc i64.addc
    proc( bool : carry Digit : a Digit : b -> bool Digit ) : alias: subb i64.subb
  end

  iSize =:: IntData
  namespace: IntData
    3:iSize =:: MASK_TAG
    2:iSize =:: SHIFT_TAG

    1:iSize =:: MASK_TYPE
    0:iSize =:: TYPE_INT
    1:iSize =:: TYPE_PTR
    2:iSize =:: FLAG_SIGN
    proc( IntData -> Digit ptr.raw.mut optional ) =>: asPtr
      iSize cast $ MASK_TYPE & TYPE_PTR == if
        MASK_TAG ~ & Digit ptr.raw.mut cast! optional.wrap return
      end ..drop Digit ptr.raw.mut optional.empty
    end
    proc( Digit ptr.raw.mut -> IntData ) =>: fromPtr
      iSize cast!
        $ MASK_TAG & ? ! "pointer is alligned" assert
        TYPE_PTR |
      IntData cast
    end
    proc( IntData -> iSize optional ) =>: asInt
      iSize cast $ MASK_TYPE & TYPE_INT == if
        SHIFT_TAG >>> optional.wrap return
      end ..drop iSize optional.empty
    end
    proc( iSize -> IntData optional ) =>: fromInt
      $ iSize ..types.size 8 * SHIFT_TAG - >>> 0 != if
        IntData optional.empty return
      end
      SHIFT_TAG << TYPE_INT | IntData cast optional.wrap
    end
    proc( IntData -> bool ) =>: getSign
      iSize cast FLAG_SIGN & ?
    end
    proc( IntData bool -> IntDatal ) =>: setSign
      if
        iSize cast FLAG_SIGN | IntData cast
      else
        iSize cast FLAG_SIGN ~ & IntData cast
      end
    end
    proc( IntData -> IntDatal ) =>: flipSign
      iSize cast FLAG_SIGN ^ IntData cast
    end
  end
end
## two representations:
## int place integer ( high low )
## heap integer ( data length )  data points to array of digits preceeded by two slots for capacity and ref-count
struct(
  int.IntData : data   ## high
  iSize       : length ## low
) =:: export: int
namespace: int
  BITS_32 if 64 else 128 end IntData.SHIFT_TAG - =:: MAX_INLINE_BITS
  DIGIT_BITS MAX_INLINE_BITS $1 1 - + >$ u/ =:: MAX_INLINE_DIGITS
## internal data management
  2:iSize =:: INFO_SLOTS
  -1:iSize =:: CAP_INDEX
  -2:iSize =:: REF_COUNT_INDEX
  proc( iSize : low iSize : high bool : sign -> int optional ) =>: tryCreateInplace
    high IntData.fromInt .if
      sign IntData.setSign low int new optional.wrap return
    end
    int optional.empty return
  end
  proc( Digit slice : digits bool : sign -> int ) =>: fromDigits
    digits .length while $ 0 != do
      digits $1 1 - [] 0 != if break end
    finally 1 - end 1 + =:: digitCount
    digitCount INFO_SLOTS +
      3 + -4 & ## align size to multiple of 4
    =:: slotCount
    slotCount Digit mem.alloc INFO_SLOTS @[] =:: basePtr
    slotCount INFO_SLOTS - Digit cast.u basePtr CAP_INDEX =[]
    1 Digit cast.u basePtr REF_COUNT_INDEX =[]
    basePtr digits .data digitCount mem.copy ..drop
    basePtr IntData.fromPtr sign IntData.setSign digitCount int new
  end
  proc( int bool : newSign -> int ) =>: setSign
    $ .data newSign IntData.setSign >$ .data=
  end
  proc( iSize : maxDigits -> int ) =>: prepareCap
    ## prepare int that can hold up to max-digits
    "unimplemented: prepareCap" ..panic
  end
  proc( int : val iSize : maxDigits -> Digit slice.mut optional ) =>: asWritableBuffer
    val .data IntData.asPtr .else ..drop
      Digit slice.mut optional.empty return
    end =:: basePtr
    basePtr REF_COUNT_INDEX [] 1 u> if ## reference not unique
      Digit slice.mut optional.empty return
    end
    basePtr CAP_INDEX [] =:: dataCap
    dataCap iSize cast.u maxDigits u< if ## not enough capacity
      Digit slice.mut optional.empty return
    end
    basePtr dataCap slice.create
  end
  proc( int : val Digit MAX_INLINE_DIGITS ptr.mut : localBuffer -> Digit slice ) =>: asSlice
    a .data IntData.asPtr .if
      a .length slice.create
    else a .data IntData .asInt ._if i64 cast.u =:: hi
      BITS_32 if
        a .length i64 cast.u hi 32 << | localBuffer .0=
      else
        a .length localBuffer .0=
        hi localBuffer .1=
      end
    else
      "unexpected int-data-type" ..panic
    end
  end
## reference management
  proc( int -> int ) =>: export: copy
    "unimplemented: copy" ..panic
  end
  proc( int -> ) =>: export: free
    "unimplemented: free" ..panic
  end
## create from integer
  proc( i32 : val -> int ) =>: export: fromI32
    val 0 < $ =:: sign if -_ end =:: shadow: val
    val iSize cast.u 0 sign tryCreateInplace optional.unwrap
  end
  proc( i32 : val -> int ) =>: export: fromU32
    val iSize cast.u 0 false tryCreateInplace optional.unwrap
  end
  proc( i64 : val -> int ) =>: export: fromI64
    val 0 < $ =:: sign
      if -_ end
    fromU64 sign setSign
  end
  proc( i128 : val -> int ) =>: export: fromI128
    val 0 < $ =:: sign
      if -_ end
    fromU128 sign setSign
  end
  proc( i128 : val -> int ) =>: export: fromU128
    val .high 0 == if
      val .low fromU64
    else
      Digit 2 array : mut: digits
      digits@
        val .low Digit cast $1 .0=
        val .hi  Digit cast $1 .1=
      slice.wrap false fromDigits
    end
  end
  BITS_32 if
    proc( i64 : val -> int ) =>: export: fromU64
      val i32 cast iSize cast.u val 32 >>> i32 cast iSize cast.u sign tryCreateInplace .else
        val Digit cast =:: digit
        digit@ slice.wrap false fromDigits
      end
    end
  else
    proc( i64 : val -> int ) =>: export: fromU64
      val iSize cast.u 0 false tryCreateInplace optional.unwrap
    end
  end
  0 fromI32 =:: ZERO
  1 fromI32 =:: ONE
  -1 fromI32 =:: NEGATIVE_ONE
  ## FIXME! correct reference management for int values
  proc( int : a -> i32 optional ) =>: asI32
    a asU32 .else
      i32 optional.empty return
    end
      $ i32.MAX u> if ..drop i32 optional.empty return end
    a sign * optional.wrap return
  end
  proc( int : a -> i64 optional ) =>: asI64
    a asU64 .else
      i64 optional.empty return
    end
      $ i64.MAX u> if ..drop i64 optional.empty return end
    a sign i64 cast.s * optional.wrap return
  end
  proc( int -> i128 optional ) =>: asI128
    a asU128 .else
      i128 optional.empty return
    end
      $ i128.MAX u> if ..drop i128 optional.empty return end
    a sign i128.fromI32 * optional.wrap return
  end
  proc( int : a -> i32 optional ) =>: asU32
    a .data IntData.asInt .if
      0 == and a .length i64 cast.u i32.UMAX u<= if
        a .length i32 cast optional.wrap return
      end
    else a .length 1 == _if
      a .data IntData.asPtr optional.unwrap 0 [] =:: digit0
      digit0 i64 cast.u i32.UMAX u<= if
        digit0 i32 cast optional.wrap return
      end
    else a .length 0 == _if
      0 optional.wrap return
    end
    i32 optional.empty return
  end
  BITS_32 if
    proc( int -> i64 optional ) =>: asU64
      a .data IntData.asInt .if i64 cast.u =:: hi
        hi 32 << a .length i64 cast.u | optional.wrap return
      else a .length 1 == _if
        a .data IntData.asPtr optional.unwrap 0 [] =:: digit0
        digit0 i64 cast.u optional.wrap return
      else a .length 0 == _if
        0 optional.wrap return
      end
      i64 optional.empty return
    end
    proc( int -> i128 optional ) =>: asU128
      a .data IntData.asInt .if i64 cast.u =:: hi
        hi 32 << a .length i64 cast.u | i128.fromU64 optional.wrap return
      else a .length 2 == _if
        a .data IntData.asPtr optional.unwrap 0 [] =:: digit0
        a .data IntData.asPtr optional.unwrap 1 [] =:: digit1
        digit1 i64 cast digit0 i64 cast i128.create optional.wrap return
      else a .length 1 == _if
        a .data IntData.asPtr optional.unwrap 0 [] =:: digit0
        digit0 i64 cast i128.fromU64 optional.wrap return
      else a .length 0 == _if
        0 optional.wrap return
      end
      i128 optional.empty return
    end
  else
    proc( int : a -> i64 optional ) =>: asU64
      a .data IntData.asInt .if
        0 == if
          a .length i64 cast optional.wrap return
        end
      else a .length 1 == _if
        a .data IntData.asPtr optional.unwrap 0 [] =:: digit0
        digit0 i64 cast optional.wrap return
      else a .length 0 == _if
        0 optional.wrap return
      end
      i64 optional.empty return
    end
    proc( int -> i128 optional ) =>: asU128
      a .data IntData.asInt .if i64 cast.u =:: hi
        hi a .length i64 cast i128.create optional.wrap return
      else a .length 2 == _if
        a .data IntData.asPtr optional.unwrap 0 [] =:: digit0
        a .data IntData.asPtr optional.unwrap 1 [] =:: digit1
        digit1 i64 cast digit0 i64 cast i128.create optional.wrap return
      else a .length 1 == _if
        a .data IntData.asPtr optional.unwrap 0 [] =:: digit0
        digit0 i64 cast i128.fromU64 optional.wrap return
      else a .length 0 == _if
        0 optional.wrap return
      end
      i128 optional.empty return
    end
  end
