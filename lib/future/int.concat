## arithmetic
  proc( int -> bool ) =>: export: isZero
    $ .length 0 != if false return end
    $ .data IntData.asInt
      .else false return end
    0 == return
  end
  ## -1 0 1
  proc( int -> i32 ) =>: export: sign
    $ isZero if 0 return end
    .data IntData.getSign if -1 else 1 end return
  end
  proc( int -> int ) =>: export: abs
    $ .data false IntData.setSign >$ .data=
  end
  proc( int -> int ) =>: export: negate
    $ .data IntData.flipSign >$ .data=
  end
  proc( int int -> int ) =>: export: add
    "unimplemented: add" ..panic
  end
