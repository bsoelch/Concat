    a .length 1 - while #dup 0 > do
      a #over 1 - array.get u32.MASK & i64 cast bitShift << buffer | buffer =
      buffer 32 >>u i32 cast target #over:2 offset + [] =
      buffer 32 << buffer =
      1 -
    end #drop
    buffer 32 >>u i32 cast target offset + [] =
    target offset mem.clear #drop
    extend if
      newLen 1 + return
    end
    newLen return
  end
