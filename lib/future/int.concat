  namespace: _impl
    proc( Digit slice : a Digit slice : b Digit slice.mut : res ) =>: add
      false
        a .length b .length iSize.min for =:: i
          a i [] b i [] Digit.addc res i =[]
        end
        a .length b .length u> if
          b .length while $ a .length u< do =:: i
            a i [] 0 Digit.addc res i =[]
          finally i 1 + end ..drop
        else a .length b .length u< _if
          a .length while $ b .length u< do =:: i
            b i [] 0 Digit.addc res i =[]
          finally i 1 + end ..drop
        end
        a .length b .length iSize.max =:: last
      if
        1 res last =[]
        res
          last 1 + >$ .length=
        return
      else
        res
          last >$ .length=
        return
      end
    end
    proc( Digit slice : a Digit slice : b -> i32 ) =>: cmp
      a .length b .length != if
        a .length b .length iSize.cmp return
      end
      a .data b .data == if 0 return end
      a .length while $ 1 - <$ 0 != do =:: i
        a i [] b i [] Digit.cmp =:: c
        c 0 != if c return end
      finally i end ..drop
      0 return
    end
    proc( Digit slice : a Digit slice : b Digit slice.mut : res ) =>: sub
      a .length b .length u>= "a >= b" assert
      false
        a .length b .length for =:: i
          a i [] b i [] Digit.subb res i =[]
        end
        b .length while $ a .length u< do =:: i
          a i [] 0 Digit.subb res i =[]
        finally i 1 + end ..drop
      ! "a >= b" assert
      ## remove leading zeros
      a .length while $ 1 - <$ 0 != do =:: i
        res i [] ? if i 1 + break end
      finally i end =:: newLength
      res
        newLength >$ .length=
      return
    end
  end
end

