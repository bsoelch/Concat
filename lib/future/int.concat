  #+
    creates an int from a string

    algorithm based on openjdk version of BigInteger(String) constructor
  +#
  proc( string : str i32 : base => int number.ParserError ) =: public fromString
    #using number
    1i8 =:: mut sign
    base =:: mut mBase
    base 0 != base 2 < base 62 > | & if
      ZERO ParserError .INVALID_BASE return
    end
    str
      #dup .length 0 == if
        #drop ZERO ParserError .EMPTY return
      end
      #dup 0 string.charAt '-' == if
        -1i8 sign =
        1 string.tail
      else #dup 0 string.charAt '+' == _if
        1 string.tail
      end
      #dup .length 0 == if
        #drop ZERO ParserError .EMPTY return
      end
      mBase 0 == if
        resolveBase mBase =
      end
      #dup .length sb.create =:: mut mStr
      0 while #dup #over:2 .length < do
        #over #over string.charAt
          #dup '_' == #over '\'' == | if #drop
            1 + continue
          end
        mStr #swap sb.appendC mStr =
        1 +
      end #drop
    #drop
    mStr .length 0 == if
      mStr sb.free #drop
      ZERO ParserError .EMPTY return
    end
    mStr .length bitsPerDigit @ mBase [] 10 >>u * =:: nBits
    nBits 64 <= if
      mStr sb.asStr mBase tryParseUInt #swap sign uwrap #swap
        mStr sb.free #drop
      return
    end
    nBits 32 / 1 + =:: cap
    cap i32 mem.alloc =:: data
    maxSafeI32Digits @ mBase [] =:: blockSize
    maxSafeI32Pow @ mBase [] i32 cast =:: blockScale
    blockScale 0 == =:: i32_blocks ## block size is (multiple of) 2^32
    mStr .length blockSize % =:: firstBlock
    1 i64 =: mut size
    firstBlock 0 > if
      mStr sb.asStr firstBlock string.head mBase tryParseUInt
        #dup ParserError .NONE != if #swap #drop
          mStr sb.free #drop
          ZERO #swap return
        end #drop
      i32 cast data 0 [] =
    else
      0 size =
    end
    firstBlock =:: mut offset
    while offset mStr .length < do
      i32_blocks if
        data size array.create 32 data leftShiftInternal size =
      else
        ## multU32
          data size array.create
          blockScale
          data
        multU32 size =
      end
      ## addU32
        data size array.create
        mStr sb.asStr offset blockSize string.slice mBase tryParseUInt
          #dup ParserError .NONE != if #swap #drop #swap #drop
            mStr sb.free #drop
            ZERO #swap return
          end #drop
        i32 cast
        data
      addU32 size =
      offset blockSize + offset =
    end
    mStr sb.free #drop
    data size cap sign int new ParserError .NONE return
  end
