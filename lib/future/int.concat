    isNegative if
      a offset array.get reverseShift << 0 != needIncrement | needIncrement =
    end
    a offset array.get u32.MASK & i64 cast bitShift >>u =:: mut buffer
    1 while #dup newLen < do
      a #over offset + array.get u32.MASK & i64 cast reverseShift << buffer | buffer =
      buffer u32.MASK & i32 cast target #over:2 1 - [] =
