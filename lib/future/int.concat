  proc( int int -> int ) =>: export: bitOr
    a sign =:: aSign
    b sign =:: bSign
    aSign 0 == if
      a free b return
    else bSign 0 == _if
      b free a return
    end
    aSign 0 < or bSign 0 < if
      a bitLength b bitLength iSize.max
    else
      a bitLength b bitLength iSize.min
