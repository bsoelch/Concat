  namespace: _impl
    proc( Digit slice.mut : res -> Digit slice.mut ) =>: removeLeadingZeros
      res .length while $ 1 - <$ 0 != do =:: i
        res i [] ? if i 1 + break end
      finally i end =:: newLength
      res
        newLength >$ .length=
      return
    end

    proc( Digit slice : a Digit slice : b Digit slice.mut : res ) =>: add
      false
        a .length b .length iSize.min for =:: i
          a i [] b i [] Digit.addc res i =[]
        end
        a .length b .length u> if
          b .length while $ a .length u< do =:: i
            a i [] 0 Digit.addc res i =[]
          finally i 1 + end ..drop
        else a .length b .length u< _if
          a .length while $ b .length u< do =:: i
            b i [] 0 Digit.addc res i =[]
          finally i 1 + end ..drop
        end
        a .length b .length iSize.max =:: last
      if
        1 res last =[]
        res
          last 1 + >$ .length=
        return
      else
        res
          last >$ .length=
        return
      end
    end
    proc( Digit slice : a Digit slice : b -> i32 ) =>: cmp
      a .length b .length != if
        a .length b .length iSize.cmp return
      end
      a .data b .data == if 0 return end
      a .length while $ 1 - <$ 0 != do =:: i
        a i [] b i [] Digit.cmp =:: c
        c 0 != if c return end
      finally i end ..drop
      0 return
    end
    proc( Digit slice : a Digit slice : b Digit slice.mut : res ) =>: sub
      a .length b .length u>= "a >= b" assert
      false
        a .length b .length for =:: i
          a i [] b i [] Digit.subb res i =[]
        end
        b .length while $ a .length u< do =:: i
          a i [] 0 Digit.subb res i =[]
        finally i 1 + end ..drop
      ! "a >= b" assert
      ## remove leading zeros
      res
        a .length >$ .length=
        removeLeadingZeros
      return
    end
  end

  struct( Digit slice : digits i32 : sign bool : hadNonzero ) =:: DigitIterator
  namespace: DigitIterator
    proc( Digit slice : digits i32 : sign -> DigitIterator ) =>: create
      digits sign false DigitIterator new
    end
    proc( DigitIterator -> DigitIterator Digit ) =>: next
      $ digits .length 0 == if
        sign 0 < if -1 Digit cast.s else 0 Digit cast.s end return
      end
      $ .digits 0 [] =:: nextDigit
      $ .digits 1 slice.tail >$ .digits=
      sign 0 >= if
        nextDigit return
      end
      $ .hadNonzero if
        nextDigit ~ return
      end
      nextDigit ? >$ .hadNonzero=
      nextDigit -_ return
    end
  end
  proc( Digit slice : a i32 : aSign Digit slice : b i32 : bSign Digit slice.mut : res ) =>: bitAnd
    a aSign DigitIterator.create =:: mut: aItr
    b bSign DigitIterator.create =:: mut: bItr
    ## compute digit-wise and
    res .length for =:: i
      aItr DigitIterator.next >$ aItr=
        bItr DigitIterator.next >$ bItr=
      & res i =[]
    end
    aSign 0 < and bSign 0 < if
      ## decode twos complement if result is negative
      res slice.freeze -1 DigitIterator.create =:: mut: resItr
      res .length for =:: i
        resItr
          DigitIterator.next res i =[]
        resItr=
      end
    end
    res removeLeadingZeros return
  end
  proc( Digit slice : a i32 : aSign Digit slice : b i32 : bSign Digit slice.mut : res ) =>: bitOr
    a aSign DigitIterator.create =:: mut: aItr
    b bSign DigitIterator.create =:: mut: bItr
    ## compute digit-wise and
    res .length for =:: i
      aItr DigitIterator.next >$ aItr=
        bItr DigitIterator.next >$ bItr=
      | res i =[]
    end
    aSign 0 < or bSign 0 < if
      ## decode twos complement if result is negative
      res slice.freeze -1 DigitIterator.create =:: mut: resItr
      res .length for =:: i
        resItr
          DigitIterator.next res i =[]
        resItr=
      end
    end
    res removeLeadingZeros return
  end
  proc( Digit slice : a i32 : aSign Digit slice : b i32 : bSign Digit slice.mut : res ) =>: bitXor
    a aSign DigitIterator.create =:: mut: aItr
    b bSign DigitIterator.create =:: mut: bItr
    ## compute digit-wise and
    res .length for =:: i
      aItr DigitIterator.next >$ aItr=
        bItr DigitIterator.next >$ bItr=
      ^ res i =[]
    end
    aSign bSign * 0 < if
      ## decode twos complement if result is negative
      res slice.freeze -1 DigitIterator.create =:: mut: resItr
      res .length for =:: i
        resItr
          DigitIterator.next res i =[]
        resItr=
      end
    end
    res removeLeadingZeros return
  end
