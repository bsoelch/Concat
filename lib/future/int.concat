  proc( int : a i64 : b -> int ) =>: export: andI64
    a asI64 .if
      b & fromI64
    else a asI128 .if
      b i128.fromI64 & fromI128
    end =:: shadow: a
    Digit MAX_INLINE_DIGITS array : mut: buf
    a buf@ asSlice =:: aDigits
    b 0 >= if
      aDigits 0 []
        a sign 0 < if -_ end
        b &
      fromU64
        a free
      return
    else
      a a .length asWritableBuffer .if =:: buf
        buf 0 []
          a sign 0 < if -_ end
          b -_ &
        buf 0 =[]
        buf .data
      else
        resultDigits prepareCap =:: buf
        aDigits 0 []
          a sign 0 < if -_ end
          b -_ &
        buf 0 =[]
        buff 1 slice.tail .data aDigits 1 slice.tail .data a .length 1 - mem.copy ..drop
        buf .data
      end .data IntData.fromPtr a .length int new
        a free
      return
    end
  end
  proc( int i64 -> int ) =>: export: andU64
    a asI64 .if
      b & fromI64
    else a asI128 .if
      b i128.fromU64 & fromI128
    end =:: shadow: a
    Digit MAX_INLINE_DIGITS array : mut: buf
    a buf@ asSlice 0 []
      a sign 0 < if -_ end
      b &
    fromU64
      a free
    return
  end
