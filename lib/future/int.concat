  proc( int int -> int : div int : rem ) =>: export: divRem
    DivideResult .DIV_REM divRem0
  end
  proc( int int -> int ) =>: export: div
    DivideResult .DIV divRem0 free
  end
  proc( int int -> int ) =>: export: rem
    DivideResult .REM divRem0 >$ free
  end
  proc( int int -> int : div int : rem ) =>: export: divMod
    DivideResult .DIV_MOD divRem0
  end
  proc( int int -> int ) =>: export: floorDiv
