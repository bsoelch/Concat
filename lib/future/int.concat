#namespace i64
proc( i64 i64 => i64 ) =: max
  #over #over > if
    #drop return
  else
    #swap #drop return
  end
end
proc( i64 i64 => i64 ) =: min
  #over #over < if
    #drop return
  else
    #swap #drop return
  end
end
#end
#namespace u32
  0xffff_ffffi64 =:: MASK
  proc( i32 => i32 ) =: leadingZeros
    =:: mut i
    i 0 < if 0 return end
    i 0 == if 32 return end
    31
      i 16 >> 0 != if 16 - i 16 >> i = end
      i 8 >> 0 != if 8 - i 8 >> i = end
      i 4 >> 0 != if 4 - i 4 >> i = end
      i 2 >> 0 != if 2 - i 2 >> i = end
      i 1 >> 0 != if 1 - i 1 >> i = end
  end
#end

