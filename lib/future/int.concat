  proc( int : mut: a int : mut: b -> int ) =>: export: gcd
    a abs a=
    b abs b=
    a b cmp 0 < if
      b a b= a=
    end ## a >= b
    while b isZero ! do
      a b copy mod =:: r ## a = q*b + r
        b a=
      b=
    end
      b free
    a return
  end
  proc( int : mut: p i32 : mut: e -> int ) =>: export: pow
    ONE =:: mut: res
    while
      e 1 & if
        res p copy * res=
      end
      e 1 >>> e=
    e 0 != do
      p square p=
    end
      p free
    res return
  end
  proc( int : mut: p int : mut: e int : m -> int ) =>: export: modPow
    ONE =:: mut: res
    b m copy mod b=
    while
      e 1 andU32 if
        res
          p copy *
          m copy mod
        res=
      end
      e 1 shrU32 e=
    e isZero ! do
      p square p=
    end
      p free
      m free
    res return
  end
