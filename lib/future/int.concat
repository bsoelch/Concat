      a .length digitShift - iSize cast.u =:: newLength
      bitShift 0 == if
        ## shifted by multiple of digit size
        res .data a .data digitShift @[] newLength mem.move ..drop
        res
          newLength >$ .length=
        return
      end
      digitShift =:: mut: srcIndex
      0 =:: mut: dstIndex
      0 Digit cast.u
        a srcIndex [] bitShift Digit.shrc ..drop
        while
          srcIndex 1 + srcIndex=
          srcIndex a .length u<
        do
          a srcIndex [] bitShift Digit.shrc res dstIndex =[]
        finally
          dstIndex 1 + dstIndex=
        end
      res dstIndex =[]
      res
        newLength >$ .length=
      removeLeadingZeros return
    end
  end
end
