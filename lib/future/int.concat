import mem
import slice
import optional
import string
import list
import stringBuilder
import numbers
import numbers/i128
import numbers/intToStr

namespace: int
  iSize ..types.size i32 ..types.size u>= "iSize has at least 32 bits" assert
  iSize ..types.size i32 ..types.size == =:: BITS_32

  i64 =:: Digit
  64:iSize =:: DIGIT_BITS
  namespace: Digit
    proc( bool : carry Digit : a Digit : b -> bool Digit ) : alias: addc i64.addc
    proc( bool : carry Digit : a Digit : b -> bool Digit ) : alias: subb i64.subb
    proc( Digit -> bool ) : alias: toBool i64.toBool
    proc( Digit -> Digit ) : alias: neg i64.neg
    proc( Digit Digit -> Digit ) : alias: add i64.add
    proc( Digit Digit -> Digit ) : alias: sub i64.sub
    proc( Digit Digit -> Digit ) : alias: mul i64.mul
    proc( Digit Digit -> i32 ) : alias: cmp i64.cmp
    proc( Digit -> Digit ) : alias: flip i64.flip
    proc( Digit Digit -> Digit ) : alias: and i64.and
    proc( Digit Digit -> Digit ) : alias: or i64.or
    proc( Digit Digit -> Digit ) : alias: xor i64.xor
## helpers for combined operations
    ## TODO? move helper implementations to core/i64
    proc( Digit : carry Digit : a Digit : b -> Digit : hi Digit : low ) =>: mulAdd
      a i64 cast.u b i64 cast.u i64.umul2 =:: mulLow =:: mulHi
      false
        mulLow carry i64 cast.u i64.addc Digit cast.u =:: resLow
        mulHi 0 i64.addc Digit cast.u =:: resHi
      ..drop
      resHi resLow
    end
    ## 0 AAAAAAAA 3 -> AAAAA000 AAA
    ## AAAAA000 BBBBBBBB 3 -> BBBBB000 AAAAABBB
    proc( Digit : carry Digit : a i32 : count -> Digit : newCarry Digit : newA ) =>: shlc
      a i64 cast.u count << Digit cast.u
      a i64 cast.u count -_ >>> carry i64 cast.u | Digit cast.u
    end
    ## 0 AAAAAAAA 3 -> AAAAA AAA00000
    ## AAAAA BBBBBBBB 3 -> BBBBB BBBAAAAA
    proc( Digit : carry Digit : a i32 : count -> Digit : newCarry Digit : newA ) =>: shrc
      a i64 cast.u count >>> Digit cast.u
      a i64 cast.u count -_ << carry i64 cast.u | Digit cast.u
    end
  end

  iSize =:: IntData
  namespace: IntData
    3:iSize =:: MASK_TAG
    2:iSize =:: SHIFT_TAG

    1:iSize =:: MASK_TYPE
    0:iSize =:: TYPE_INT
    1:iSize =:: TYPE_PTR
    2:iSize =:: FLAG_SIGN
    proc( IntData -> Digit ptr.raw.mut optional ) =>: asPtr
      iSize cast $ MASK_TYPE & TYPE_PTR == if
        MASK_TAG ~ & Digit ptr.raw.mut cast! optional.wrap return
      end ..drop Digit ptr.raw.mut optional.empty
    end
    proc( Digit ptr.raw.mut -> IntData ) =>: fromPtr
      iSize cast!
        $ MASK_TAG & ? ! "pointer is alligned" assert
        TYPE_PTR |
      IntData cast
    end
    proc( IntData -> iSize optional ) =>: asInt
      iSize cast $ MASK_TYPE & TYPE_INT == if
        SHIFT_TAG >>> optional.wrap return
      end ..drop iSize optional.empty
    end
    proc( iSize -> IntData optional ) =>: fromInt
      $ iSize ..types.size 8 * SHIFT_TAG - >>> 0 != if ..drop
        IntData optional.empty return
      end
      SHIFT_TAG << TYPE_INT | IntData cast optional.wrap
    end
    proc( IntData -> bool ) =>: getSign
      iSize cast FLAG_SIGN & ?
    end
    proc( IntData bool -> IntData ) =>: setSign
      if
        iSize cast FLAG_SIGN | IntData cast
      else
        iSize cast FLAG_SIGN ~ & IntData cast
      end
    end
    proc( IntData -> IntData ) =>: flipSign
      iSize cast FLAG_SIGN ^ IntData cast
    end
  end
end
overload: merge: ? int.Digit.toBool end
overload: merge: -_ int.Digit.neg end
overload: merge: + int.Digit.add end
overload: merge: - int.Digit.sub end
overload: merge: * int.Digit.mul end
overload: merge: ~ int.Digit.flip end
overload: merge: & int.Digit.and end
overload: merge: | int.Digit.or end
overload: merge: ^ int.Digit.xor end
## two representations:
## int place integer ( high low )
## heap integer ( data length )  data points to array of digits preceeded by two slots for capacity and ref-count
struct(
  int.IntData : data   ## high
  iSize       : length ## low
) =:: export: int
namespace: int
  BITS_32 if 64:iSize else 128:iSize end IntData.SHIFT_TAG - =:: MAX_INLINE_BITS
  DIGIT_BITS MAX_INLINE_BITS $1 1 - + >$ u/ =:: MAX_INLINE_DIGITS
## internal data management
  2:iSize =:: INFO_SLOTS
  -1:iSize =:: CAP_INDEX
  -2:iSize =:: REF_COUNT_INDEX
  proc( iSize : low iSize : high bool : shadow: sign -> int optional ) =>: tryCreateInplace
    high IntData.fromInt .if
      sign IntData.setSign low int new optional.wrap return
    end
    int optional.empty return
  end
  proc( iSize : maxDigits -> Digit slice.mut ) =>: prepareCap
    maxDigits INFO_SLOTS +
      3 + -4 & ## align size to multiple of 4
    =:: slotCount
    slotCount Digit mem.alloc INFO_SLOTS @[] =:: basePtr
    slotCount INFO_SLOTS - Digit cast.u basePtr CAP_INDEX =[]
    1 Digit cast.u basePtr REF_COUNT_INDEX =[]
    basePtr maxDigits slice.createMutable
  end
  proc( Digit slice : digits bool : shadow: sign -> int ) =>: fromDigits
    digits .length while $ 0 != do
      digits $1 1 - [] i64 cast.u 0 != if break end
    finally 1 - end =:: digitCount
    digitCount 0 == if ZERO return end
    digitCount prepareCap =:: targetDigits
    targetDigits .data digits .data digitCount mem.copy ..drop
    targetDigits .data IntData.fromPtr sign IntData.setSign digitCount int new
  end
  proc( i64 slice : digits bool : shadow: sign -> int ) =>: export: fromI64slice
    digits .data Digit ptr.raw cast digits .length slice.create sign fromDigits
  end
  proc( i32 slice : digits bool : shadow: sign -> int ) =>: export: fromI32slice
    "unimplemented: fromI32slice" ..panic
  end
  overload: fromSlice fromI64slice fromI32slice end
  proc( int bool : newSign -> int ) =>: setSign
    $ .data newSign IntData.setSign >$ .data=
  end
  proc( int : val iSize : maxDigits -> Digit slice.mut optional ) =>: asWritableBuffer
    val .data IntData.asPtr .else
      Digit slice.mut optional.empty return
    end =:: basePtr
    basePtr REF_COUNT_INDEX [] i64 cast.u
      $ 1 u> if ..drop ## reference not unique
        Digit slice.mut optional.empty return
      end
    1 + Digit cast.u basePtr REF_COUNT_INDEX =[]
    basePtr CAP_INDEX [] i64 cast.u =:: dataCap
    dataCap iSize cast.u maxDigits u< if ## not enough capacity
      Digit slice.mut optional.empty return
    end
    basePtr dataCap slice.createMutable optional.wrap
  end
  proc( int : a Digit MAX_INLINE_DIGITS ptr.mut : localBuffer -> Digit slice ) =>: asSlice
    a .data IntData.asPtr .if
      a .length slice.create
    else a .data IntData.asInt ._if i64 cast.u =:: hi
      BITS_32 if
        a .length i64 cast.u hi 32 << | localBuffer .0=
        localBuffer 1 slice.create
      else
        a .length Digit cast.u localBuffer .0=
        hi Digit cast.u localBuffer .1=
        localBuffer
          hi ? if 2 else 1 end
        slice.create
      end
    else
      "unexpected int-data-type" ..panic
    end
  end
## reference management
  proc( int : a -> int ) =>: export: copy
    a .data IntData.asInt ? if
      a return ## nothing to copy
    else a .data IntData.asPtr ._if
      $ REF_COUNT_INDEX []
        i64 cast.u 1 + Digit cast.u ## ? atomic increment
      >$ REF_COUNT_INDEX =[]
      a return
    else
      "unexpected int-data-type" ..panic
    end
  end
  proc( int : a -> ) =>: export: free
    a .data IntData.asInt ? if
      return ## nothing to copy
    else a .data IntData.asPtr ._if
      $ REF_COUNT_INDEX [] i64 cast.u
        1 - ## ? atomic decrement
        $ 0 == if ..drop ## freed all references
          INFO_SLOTS -_ @[] mem.free
          return
        end
      Digit cast.u >$ REF_COUNT_INDEX =[]
    else
      "unexpected int-data-type" ..panic
    end
  end
## create from integer
  proc( i32 : val -> int ) =>: export: fromI32
    val
      $ 0 < $ =:: shadow: sign if -_ end
    iSize cast.u 0 sign tryCreateInplace optional.unwrap
  end
  proc( i32 : val -> int ) =>: export: fromU32
    val iSize cast.u 0 false tryCreateInplace optional.unwrap
  end
  proc( i64 : val -> int ) =>: export: fromI64
    val
      $ 0 < $ =:: shadow: sign if -_ end
    fromU64 sign setSign
  end
  proc( i128 : val -> int ) =>: export: fromI128
    val
      $ i128.ZERO < $ =:: shadow: sign if -_ end
    fromU128 sign setSign
  end
  proc( i128 : val -> int ) =>: export: fromU128
    val .hi 0 == if
      val .low fromU64
    else
      BITS_32 ! and val .low iSize cast.u val .hi iSize cast.u false tryCreateInplace .if
        return
      end
      Digit 2 array : mut: digits
      digits@
        val .low Digit cast $1 .0=
        val .hi  Digit cast $1 .1=
      slice.wrap false fromDigits
    end
  end
  BITS_32 if
    proc( i64 : val -> int ) =>: export: fromU64
      val i32 cast iSize cast.u val 32 >>> i32 cast iSize cast.u sign tryCreateInplace .else
        val Digit cast =:: digit
        digit@ slice.wrap false fromDigits
      end
    end
  else
    proc( i64 : val -> int ) =>: export: fromU64
      val iSize cast.u 0 false tryCreateInplace optional.unwrap
    end
  end
  ## TODO! interpreter currently cannot handle running IntData.fromInt at compile-time
  { 0 IntData cast 0 } int =: ZERO
  { 0 IntData cast 1 } int =: ONE
  ##0 fromI32 =:: ZERO
  ##1 fromI32 =:: ONE
  ##-1 fromI32 =:: NEGATIVE_ONE
  ( type : I -> type ) =>: export: IntConversionResult
    union(
      I : Ok
      int : Err
    )
  end
  namespace: IntConv
    proc( type : auto: T  T IntConversionResult -> T ) =>: export: unwrap
      .Ok unionElement.unwrap
    end
    proc( type : auto: T  T IntConversionResult -> T IntConversionResult ) =>: prepareIf  end
    proc( type : auto: T  T IntConversionResult -> bool ) =>: check  .Ok ? end
    proc( type : auto: T  T IntConversionResult -> T ) =>: ifVal  .Ok ..raw end
    proc( type : auto: T  T IntConversionResult -> int ) =>: elseVal  .Err ..raw end
  end
  proc( int : a -> i32 IntConversionResult ) =>: export: asI32
    a copy asI32u .Ok .else ..drop
      a free
      a i32 IntConversionResult .Err return
    end
      $ i32.MAX u> if ..drop a i32 IntConversionResult .Err return end
      a free
    a sign * i32 IntConversionResult .Ok return
  end
  proc( int : a -> i32 IntConversionResult ) =>: export: asU32
    a sign 0 < if
      a i32 IntConversionResult .Err return
    end
    a asI32u
  end
  proc( int : a -> i64 IntConversionResult ) =>: export: asI64
    a copy asI64u .Ok .else ..drop
      a free
      a i64 IntConversionResult .Err return
    end
      $ i64.MAX u> if ..drop a i64 IntConversionResult .Err return end
      a free
    a sign i64 cast.s * i64 IntConversionResult .Ok return
  end
  proc( int : a -> i64 IntConversionResult ) =>: export: asU64
    a sign 0 < if
      a i64 IntConversionResult .Err return
    end
    a asI64u
  end
  proc( int : a -> i128 IntConversionResult ) =>: export: asI128
    a copy asI128u .Ok .else ..drop
      a free
      a i128 IntConversionResult .Err return
    end
      $ i128.MAX u> if ..drop a i128 IntConversionResult .Err return end
      a free
    a sign i128.fromI32 * i128 IntConversionResult .Ok return
  end
  proc( int : a -> i32 IntConversionResult ) =>: asI32u
    a .data IntData.asInt .if
      0 == and a .length i64 cast.u i32.UMAX u<= if
        a .length i32 cast i32 IntConversionResult .Ok return
      end
    else a .length 1 == _if
      a .data IntData.asPtr optional.unwrap 0 [] =:: digit0
      digit0 i64 cast.u i32.UMAX u<= if
        a free
        digit0 i32 cast i32 IntConversionResult .Ok return
      end
    else a .length 0 == _if
      a free
      0 i32 IntConversionResult .Ok return
    end
    a i32 IntConversionResult .Err return
  end
  proc( int : a -> i128 IntConversionResult ) =>: export: asU128
    a sign 0 < if
      a i128 IntConversionResult .Err return
    end
    a asI128u
  end
  proc( int : a -> i64 IntConversionResult ) =>: asI64u
    a .data IntData.asInt .if
      BITS_32 if i64 cast.u =:: hi
        hi 32 << a .length i64 cast.u | i64 IntConversionResult .Ok return
      else 0 == _if
        a .length i64 cast i64 IntConversionResult .Ok return
      end
    else a .length 1 == _if
      a .data IntData.asPtr optional.unwrap 0 [] =:: digit0
      a free
      digit0 i64 cast i64 IntConversionResult .Ok return
    else a .length 0 == _if
      a free
      0 i64 IntConversionResult .Ok return
    end
    a i64 IntConversionResult .Err return
  end
  proc( int : a -> i128 IntConversionResult ) =>: export: asI128u
    a .data IntData.asInt .if i64 cast.u =:: hi
      BITS_32 if
        hi 32 << a .length i64 cast.u | i128.fromU64 i128 IntConversionResult .Ok return
      else
        hi a .length i64 cast i128.create i128 IntConversionResult .Ok return
      end
    else a .length 2 == _if
      a .data IntData.asPtr optional.unwrap 0 [] =:: digit0
      a .data IntData.asPtr optional.unwrap 1 [] =:: digit1
      a free
      digit1 i64 cast digit0 i64 cast i128.create i128 IntConversionResult .Ok return
    else a .length 1 == _if
      a .data IntData.asPtr optional.unwrap 0 [] =:: digit0
      a free
      digit0 i64 cast i128.fromU64 i128 IntConversionResult .Ok return
    else a .length 0 == _if
      a free
      i128.ZERO i128 IntConversionResult .Ok return
    end
    a i128 IntConversionResult .Err return
  end
  proc( int : a -> i32 ) =>: export: toI32
    a $ sign 0 < if toI32u -_ else toI32u end
  end
  proc( int : a -> i32 ) =>: toI32u
    a .data IntData.asInt ? if
      a .length i32 cast return
    else a .data IntData.asPtr ._if
      a .length 0 != if 0 [] i32 cast else ..drop 0 end
        a free
      return
    else
      "unexpected type for int-data" ..panic
    end
  end
  proc( int : a -> i64 ) =>: export: toI64
    a $ sign 0 < if toI64u -_ else toI64u end
  end
  proc( int : a -> i64 ) =>: toI64u
    a .data IntData.asInt .if
      BITS_32 if i64 cast.u =:: hi
        hi 32 << a .length i64 cast.u | return
      else ..drop
        a .length i64 cast.u return
      end
    else a .data IntData.asPtr ._if
      a .length 0 != if 0 [] i64 cast else ..drop 0 end
        a free
      i64 cast return
    else
      "unexpected type for int-data" ..panic
    end
  end
  proc( int : a -> i128 ) =>: export: toI128
    a $ sign 0 < if toI128u -_ else toI128u end
  end
  proc( int : a -> i128 ) =>: toI128u
    a .data IntData.asInt .if i64 cast.u =:: hi
      BITS_32 if
        hi 32 << a .length i64 cast.u | i128.fromU64 return
      else
        hi a .length i64 cast i128.create return
      end
    else a .data IntData.asPtr ._if =:: aData
      a .length 2 u>= if
        aData 1 [] i64 cast.u aData 0 [] i64 cast.u i128.create
      else a .length 1 == _if
        aData 0 [] i64 cast.u i128.fromU64
      else i128.ZERO end
        a free
      return
    else
      "unexpected type for int-data" ..panic
    end
  end
  ## TODO? conversion from/to float
## conversion from/to string
  proc( string : val i32 : base -> int optional ) =>: export: parse
    "unimplemented: parse" ..panic ## return int NumberParseResult instead of optional
  end
  proc( stringBuilder int : val i32 : base -> stringBuilder ) =>: export: sbBaseAppend
    val asI64 .if
      base sb.appendI? return
    ## TODO? 128bit sb.append
    end =:: shadow: val
    base number.MIN_BASE < or base number.MAX_BASE > if
      ## TODO: error handling
      return
    end
    val sign 0 < if '-' sb.appendC end
    Digit MAX_INLINE_DIGITS array : mut: buf
    val buf@ asSlice
      base switch
        2  case base _impl.sbAlignedPow2Append break
        4  case base _impl.sbAlignedPow2Append break
        16 case base _impl.sbAlignedPow2Append break
        8  case base _impl.sbPow2Append break
        32 case base _impl.sbPow2Append break
        default base _impl.sbBaseAppend break
      end
    return
  end
  proc( stringBuilder int -> stringBuilder ) =>: export: sbAppend
    10 sbBaseAppend
  end
  proc( stringBuilder int -> stringBuilder ) =>: export: sbAppendX
    16 sbBaseAppend
  end
## arithmetic
  proc( int : a -> bool ) =>: export: isZero
    a .length 0 != if false return end
    a .data IntData.asInt
      .else true return end
    0 == return
  end
  ## -1 0 1
  proc( int -> i32 ) =>: export: sign
    $ isZero if ..drop 0 return end
    .data IntData.getSign if -1 else 1 end return
  end
  proc( int -> int ) =>: export: abs
    $ .data false IntData.setSign >$ .data=
  end
  proc( int -> int ) =>: export: negate
    $ .data IntData.flipSign >$ .data=
  end
  proc( int : a int : b -> int ) =>: export: add
    a sign
      $ 0 == if ..drop a free b return end
    =:: aSign
    b sign
      $ 0 == if ..drop b free a return end
    =:: bSign
    aSign bSign != if a b negate sub return end
    a bitLength b bitLength iSize.max 1 + =:: resultBits
    ## handle small results
    resultBits MAX_INLINE_BITS u< if
      resultBits 64 u< if
        a asI64u IntConv.unwrap
          b asI64u IntConv.unwrap +
        fromU64
          aSign 0 < if negate end
        return
      else resultBits 128 u< _if
        a asI128u IntConv.unwrap
          b asI128u IntConv.unwrap +
        fromU128
          aSign 0 < if negate end
        return
      else "expected less than 128 inline bits" ..panic end
    end
    Digit MAX_INLINE_DIGITS array : mut: bufA
    Digit MAX_INLINE_DIGITS array : mut: bufB
    a bufA@ asSlice =:: aData
    b bufB@ asSlice =:: bData
    resultBits DIGIT_BITS 1 - + DIGIT_BITS / =:: resultDigits
    a resultDigits asWritableBuffer .else
    b resultDigits asWritableBuffer ._else
      resultDigits prepareCap
    end =:: dstData
    aData bData dstData _impl.add =:: resData
    resData .data IntData.fromPtr aSign 0 < IntData.setSign resData .length int new
      a free b free
    return
  end
  proc( int : a int : b -> int ) =>: export: sub
    a sign
      $ 0 == if ..drop a free b negate return end
    =:: aSign
    b sign
      $ 0 == if ..drop b free a return end
    =:: bSign
    aSign bSign != if a b negate add return end
    a bitLength b bitLength iSize.max =:: resultBits
    ## handle small results
    resultBits MAX_INLINE_BITS u< if
      resultBits 64 u< if
        a asI64u IntConv.unwrap
          b asI64u IntConv.unwrap -
        fromU64
          aSign 0 < if negate end
        return
      else resultBits 128 u< _if
        a asI128u IntConv.unwrap
          b asI128u IntConv.unwrap -
        fromU128
          aSign 0 < if negate end
        return
      end
    end
    Digit MAX_INLINE_DIGITS array : mut: bufA
    Digit MAX_INLINE_DIGITS array : mut: bufB
    a bufA@ asSlice =:: aData
    b bufB@ asSlice =:: bData
    resultBits DIGIT_BITS 1 - + DIGIT_BITS / =:: resultDigits
    a resultDigits asWritableBuffer .else
    b resultDigits asWritableBuffer ._else
      resultDigits prepareCap
    end =:: dstData
    aData bData _impl.cmp =:: c
    c 0 < if
      aData bData dstData _impl.sub =:: resData
      resData .data IntData.fromPtr aSign 0 < IntData.setSign resData .length int new
    else c 0 > _if
      bData aData dstData _impl.sub =:: resData
      resData .data IntData.fromPtr aSign 0 > IntData.setSign resData .length int new
    else
      ZERO
    end
      a free b free
    return
  end
  proc( int i32 -> int ) =>: export: addI32
    i64 cast.s addI64
  end
  proc( int i32 -> int ) =>: export: subI32
    i64 cast.s subI64
  end
  proc( int i32 -> int ) =>: export: addU32
    i64 cast.u addU64
  end
  proc( int i32 -> int ) =>: export: subU32
    i64 cast.u subU64
  end
  proc( int : a i64 : b -> int ) =>: export: addI64
    b 0 == if a return end
    b 0 < if
      a b -_ subU64
    else
      a b addU64
    end
  end
  proc( int : a i64 : b -> int ) =>: export: subI64
    b 0 == if a return end
    b 0 < if
      a b -_ addU64
    else
      a b subU64
    end
  end
  proc( int : a i64 : b -> int ) =>: export: addU64
    a sign 0 < if a negate b subU64 negate return end
    a asI64u .if
      b + fromU64 return
    else asI128u ._if
      b i128.fromU64 + fromU128 return
    end b fromU64 add
  end
  proc( int : a i64 : b -> int ) =>: export: subU64
    a sign 0 < if a negate b addU64 negate return end
    a asI64u .if
      b - fromU64 return
    else asI128u ._if
      b i128.fromU64 - fromU128 return
    end b fromU64 sub
  end
  proc( int : a i128 : b -> int ) =>: export: addI128
    b i128.ZERO == if a return end
    b i128.ZERO < if
      a b -_ subU128
    else
      a b addU128
    end
  end
  proc( int : a i128 : b -> int ) =>: export: subI128
    b i128.ZERO == if a return end
    b i128.ZERO < if
      a b -_ addU128
    else
      a b subU128
    end
  end
  proc( int : a i128 : b -> int ) =>: export: addU128
    a sign 0 < if a negate b subU128 negate return end
    a asI128u .if
      b + fromU128 return
    end b fromU128 add
  end
  proc( int : a i128 : b -> int ) =>: export: subU128
    a sign 0 < if a negate b addU128 negate return end
    a asI128u .if
      b - fromU128 return
    end b fromU128 sub
  end

  proc( int : a int : b -> int ) =>: export: mul
    a sign
      $ 0 == if ..drop a free b free ZERO return end
    =:: aSign
    b sign
      $ 0 == if ..drop a free b free ZERO return end
    =:: bSign
    a bitLength b bitLength + =:: resultBits
    ## handle small results
    resultBits MAX_INLINE_BITS u< if
      resultBits 64 u< if
        a asI64u IntConv.unwrap
          b asI64u IntConv.unwrap *
        fromU64
          aSign bSign * 0 < if negate end
        return
      else resultBits 128 u< _if
        a asI128u IntConv.unwrap
          b asI128u IntConv.unwrap *
        fromU128
          aSign bSign * 0 < if negate end
        return
      end
    end
    Digit MAX_INLINE_DIGITS array : mut: bufA
    Digit MAX_INLINE_DIGITS array : mut: bufB
    a bufA@ asSlice =:: aData
    b bufB@ asSlice =:: bData
    resultBits DIGIT_BITS 1 - + DIGIT_BITS / =:: resultDigits
    aData .data bData .data == =:: isSquare
    isSquare if
      a .length b .length == "same data implies same length" assert
      b free
    end
      a resultDigits asWritableBuffer .else
      b resultDigits asWritableBuffer ._else
        resultDigits prepareCap
      end =:: dstData
    isSquare if
      aData dstData _impl.square =:: resData
