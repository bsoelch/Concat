  end
  proc( int : a i64 : b -> int ) =>: export: addI64
    b 0 == if a return end
    b 0 < if
      a b -_ subU64
    else
      a b addU64
    end
  end
  proc( int : a i64 : b -> int ) =>: export: subI64
    b 0 == if a return end
    b 0 < if
      a b -_ addU64
    else
      a b subU64
    end
  end
  proc( int : a i64 : b -> int ) =>: export: addU64
    a sign 0 < if a negate b subU64 negate return end
    a asU64 .if
      b + fromU64 return
    else asU128 ._if
      b i128.fromU64 + fromU128 return
    end =:: shadow: a
    Digit MAX_INLINE_DIGITS array : mut: bufA
    b Digit cast =:: bDigit
    a bufA@ asSlice =:: aData
    bDigit@ slice.wrap =:: bData
    a resultDigits asWritableBuffer .else
      resultDigits prepareCap
    end =:: dstData
    aData bData dstData _impl.add =:: resData
    resData .data IntData.fromPtr resData .length int new
      a free
    return
  end
  proc( int : a i64 : b -> int ) =>: export: subU64
    a sign 0 < if a negate b addU64 negate return end
    a asU64 .if
      b - fromU64 return
    else asU128 ._if
      b i128.fromU64 - fromU128 return
    end =:: shadow: a
    ## when this point is reached a is greather than b
    Digit MAX_INLINE_DIGITS array : mut: bufA
    b Digit cast =:: bDigit
    a bufA@ asSlice =:: aData
    bDigit@ slice.wrap =:: bData
    a resultDigits asWritableBuffer .else
      resultDigits prepareCap
    end =:: dstData
    aData bData dstData _impl.sub =:: resData
    resData .data IntData.fromPtr resData .length int new
      a free
    return
  end
  proc( int : a i128 : b -> int ) =>: export: addI128
    b 0 == if a return end
    b 0 < if
      a b -_ subU128
    else
      a b addU128
    end
  end
  proc( int : a i128 : b -> int ) =>: export: subI128
    b 0 == if a return end
    b 0 < if
      a b -_ addU128
    else
      a b subU128
    end
  end
  proc( int : a i128 : b -> int ) =>: export: addU128
    a sign 0 < if a negate b subU128 negate return end
    a asU128 .if
      b + fromU128 return
    end
    Digit MAX_INLINE_DIGITS array : mut: bufA
    b Digit cast =:: bDigit
    a bufA@ asSlice =:: aData
    bDigit@ slice.wrap =:: bData
    a resultDigits asWritableBuffer .else
      resultDigits prepareCap
    end =:: dstData
    aData bData dstData _impl.add =:: resData
    resData .data IntData.fromPtr resData .length int new
      a free
    return
  end
  proc( int : a i128 : b -> int ) =>: export: subU128
    a sign 0 < if a negate b addU128 negate return end
    a asU128 .if
      b - fromU128 return
    end
    ## when this point is reached a is greather than b
    Digit MAX_INLINE_DIGITS array : mut: bufA
    b Digit cast =:: bDigit
    a bufA@ asSlice =:: aData
    bDigit@ slice.wrap =:: bData
    a resultDigits asWritableBuffer .else
      resultDigits prepareCap
    end =:: dstData
    aData bData dstData _impl.sub =:: resData
    resData .data IntData.fromPtr resData .length int new
      a free
    return
  end

