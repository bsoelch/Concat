## comparisons
  proc( int int -> i32 ) =>: export: cmp
    a sign
      $ 0 == if b sign -_ return end
    =:: aSign
    b sign
      $ 0 == if a sign return end
    =:: bSign
    aSign bSign != if
      aSign bSign - return
    end
    a b ucmp aSign *
  end
  proc( int int -> i32 ) =>: export: ucmp
    Digit MAX_INLINE_DIGITS array : mut: bufA
    Digit MAX_INLINE_DIGITS array : mut: bufB
    a bufA@ asSlice b bufB@ asSlice _impl.cmp
  end
## bitwise operations
  proc( int -> iSize ) =>: export: bitLength
    "unimplemented: bitLength" ..panic
  end
  proc( int -> int ) =>: export: bitNot
    1 addI32 negate
  end
  ## TODO: reduce code duplication between logic ops
  proc( int int -> int ) =>: export: bitAnd
    a sign =:: aSign
    b sign =:: bSign
    aSign 0 == or bSign 0 == if
      a free b free ZERO return
    end
    aSign 0 < and bSign 0 < if
      a bitLength b bitLength iSize.max
    else
      a bitLength b bitLength iSize.min
    end =:: resultBits
    Digit MAX_INLINE_DIGITS array : mut: bufA
    Digit MAX_INLINE_DIGITS array : mut: bufB
    a bufA@ asSlice =:: aData
    b bufB@ asSlice =:: bData
    resultBits DIGIT_BITS 1 - + DIGIT_BITS / =:: resultDigits
    resultDigits MAX_INLINE_DIGITS <= if
      Digit MAX_INLINE_DIGITS array : mut: resBuf
      aData aSign bData bSign resBuf@ resultDigits slice.createMutable _impl.bitAnd =:: resData
        a free b free
      resData .length switch
        0 case ZERO return
        1 case resData 0 [] fromU64 aSign 0 < and bSign 0 < if negate end return
        2 case resData 1 [] resData 0 [] i128.create fromU128 aSign 0 < and bSign 0 < if negate end return
        default "unexpected number of digits" ..panic
      end
    end
    a resultDigits asWritableBuffer .else
    b resultDigits asWritableBuffer ._else
      resultDigits prepareCap
    end =:: dstData
    aData aSign bData bSign dstData _impl.bitAnd =:: resData
    resData .data IntData.fromPtr aSign bData * 0 < IntData.setSign resData .length int new
      a free b free
    return
  end
