## math library in pure concat
"../core/floats" import

namespace: f64
  0x0.b17217f7d1cf =:: LOG2_HI
  0x0.00000000000079abc9e3b39803f =:: LOG2_LOW
  0x3.243f6a8885a308d3 =:: export: PI
  0x3.243f6a8885a3 =:: PI_HI
  0x0.00000000000008d313198a2e037 =:: PI_LOW
  0x0.517cc1b727220a95 =:: export: PI_INV
  0x6.487ed5110b4611a6 =:: export: TAU
  0x0.28be60db9391054a =:: export: TAU_INV
  0x2.b7e151628aed2a6b =:: export: E
  0x1.9e3779b97f4a7c16 =:: export: PHI

  proc( f64 : x -> f64 ) =>: export: sqrt
    x 0 < if
      NaN return
    end
    x 0 == if
      x return
    end
    x bits =:: i
    i MANTISSA_MASK & =:: mut: m
    i EXP_SHIFT >>> SHIFTED_EXP_MASK & =:: mut: e
    e SHIFTED_EXP_MASK == if
      x return ## NaN or Infinity
    end
    e 0 == if
      ## normalize subnormal numbers
      x 0x1.0XF * bits =:: i2 ## * 2^64
      i2 MANTISSA_MASK & m=
      i2 EXP_SHIFT >>> SHIFTED_EXP_MASK & 60 - e=
    end
    ## XXX? find more precise approach
    ## get estimate by dividing exponent by two
    e EXP_BIAS - 1 >> EXP_BIAS + SHIFTED_EXP_MASK & =:: newE
    newE EXP_SHIFT << m | fromBits
      ## newton iteration for square root
      ## 5 steps should be enough
      #+y+# x ..over / + 0.5 *
      #+y+# x ..over / + 0.5 *
      #+y+# x ..over / + 0.5 *
      #+y+# x ..over / + 0.5 *
      #+y+# x ..over / + 0.5 *
    return
  end

  proc( f64 : x -> f64 ) =>: export: cbrt
    x 0 == if
      x return
    end
    x bits =:: i
    i SIGN_FLAG & =:: s
    i MANTISSA_MASK & =:: mut: m
    i EXP_SHIFT >>> SHIFTED_EXP_MASK & =:: mut: e
    e SHIFTED_EXP_MASK == if
      x return ## NaN or Infinity
    end
    e 0 == if
      ## normalize subnormal numbers
      x 0x1.0XF * bits =:: i2 ## * 2^64
      i2 MANTISSA_MASK & m=
      i2 EXP_SHIFT >>> SHIFTED_EXP_MASK & 60 - e=
    end
    ## get estimate by dividing exponent by three
    e EXP_BIAS - 3 / EXP_BIAS + SHIFTED_EXP_MASK & =:: newE
    newE EXP_SHIFT << m | s | fromBits =:: mut: y
    ## TODO find more precise approach
    ##  newton iteration for cube root ( x/y-y² = 0 )
    ## 4 steps should be enough
    x y y * / =:: mut: q
    q y - y * y y + q + / y + y=
    x y y * / q=
    q y - y * y y + q + / y + y=
    x y y * / q=
    q y - y * y y + q + / y + y=
    x y y * / q=
    q y - y * y y + q + / y + y=
    y return
  end

  proc( f64 : x -> f64 ) =>: export: exp
    x isNaN if
      x abs return
    end
    x 0x2c5.c85fdf473de > if ## 709.78
      Infinity return
    end
    x -0x2e9.221aa5a60a2 < if ## -745.13
      0.0 return
    end
    ## XXX? higher precission for redured result
    ## using this range 0.5 ln2 <= r <= 1.5 ln2 ensure algorithm is exact for input 1
    ##   if this can be guaraneed for -0.5 ln 2 <= r <= 0.5 ln2 use that range instead
    ## x = k*log2 + r, 0.5 ln2 <= r <= 1.5 ln2
    x LOG2_INV * 0.5 - floor =:: k
    x k LOG2_HI * - k LOG2_LOW * - =:: r
    ## compute exp(r) using taylor expansion
    r r * =:: r2
    ## XXX? find shorter polynomial
    ## even terms
     ## XXX? is term 18 needed
     ## 0xb.413c31dcbecbbddX-E r2 * ## 1/18!
      0xd.73f9f399dc0f88eX-C r2 * ## 1/16!
      0xc.9cba54603e4e905X-A + r2 * ## 1/14!
      0x8.f76c77fc6c4bdaaX-8 + r2 * ## 1/12!
      0x4.9f93edde27d71cbX-6 + r2 * ## 1/10!
      0x1.a01a01a01a01a01X-4 + r2 * ## 1/8!
      0x5.b05b05b05b05b05X-3 + r2 * ## 1/6!
      0xa.aaaaaaaaaaaaaaaX-2 + r2 * ## 1/4!
      0x0.8 + r2 * ## 1/2!
      1 +
    =:: yEven
    ## odd terms
      0xc.a963b81856a5359X-D r2 * ## 1/17!
      0xd.73f9f399dc0f88eX-B + r2 * ## 1/15!
      0xb.092309d43684be5X-9 + r2 * ## 1/13!
      0x6.b99159fd5138e3fX-7 + r2 * ## 1/11!
      0x2.e3bc74aad8e671fX-5 + r2 * ## 1/9!
      0xd.00d00d00d00d00dX-4 + r2 * ## 1/7!
      0x2.222222222222222X-2 + r2 * ## 1/5!
      0x2.aaaaaaaaaaaaaaaX-1 + r2 * ## 1/3!
      1 + r *
    =:: yOdd
    yEven yOdd + bits =:: i
    i MANTISSA_MASK & =:: m
    i EXP_SHIFT >>> SHIFTED_EXP_MASK & k i64 cast + =:: e
    e 0 <= if ## subnormal numbers
      ## TODO rounding
      m HIDDEN_BIT | 1 e - >>> fromBits return
    end
    e EXP_SHIFT << m | fromBits return
  end

  proc( f64 : x -> f64 ) =>: export: log
    x 0 < if
      NaN return
    end
    x 0 == if
      x return
    end
    x bits =:: i
    i MANTISSA_MASK & =:: mut: m
    i EXP_SHIFT >>> SHIFTED_EXP_MASK & =:: mut: e
    e SHIFTED_EXP_MASK == if
      x return ## NaN or Infinity
    end
    e EXP_BIAS - =:: mut: k
    e 0 == if
      ## normalize subnormal numbers
      x 0x1.0XF * bits =:: i2 ## * 2^64
      i2 MANTISSA_MASK & m=
      i2 EXP_SHIFT >>> SHIFTED_EXP_MASK & 60 - e=
    end
    ## x = r* 2^k -> log x = k*log2 + log r , sqrt(2)/2 <= r <= sqrt(2)
    m EXP_BIAS EXP_SHIFT << | ## 1. set exponent to 0
      f64.fromBits
       ## 2. ensure number is in correct range
      ..dup SQRT2 > if ..drop ## sqrt(2)
        m EXP_BIAS 1 - EXP_SHIFT << | f64.fromBits
        k 1 + k=
      end
    =:: r
    r 1 - =:: t ## r = 1+t
    t 2 t + / =:: s ## log (1+t) = log(1+s)-log(1-s)  -0.1765 <= s <= 0.1716
    s s * =:: s2
    ## XXX? find shorter polynomial
    ## log(1+s)-log(1-s) = 2s+ 2/3 s**3 + .... + 2/19 s ** 19 + eps
      0x0.0d79435e50d79435 s2 *   ## 1/19
      0x0.0f0f0f0f0f0f0f0f + s2 * ## 1/17
      0x0.1111111111111111 + s2 * ## 1/15
      0x0.13b13b13b13b13b1 + s2 * ## 1/13
      0x0.1745d1745d1745d2 + s2 * ## 1/11
      0x0.1c71c71c71c71c72 + s2 * ## 1/9
      0x0.2492492492492492 + s2 * ## 1/7
      0x0.3333333333333333 + s2 * ## 1/5
      0x0.5555555555555555 + s2 * ## 1/3
      1 + s s + *
      ## undo shift by 2^k
      k 0 == if return end
      k f64 cast LOG2 * +
    return
  end

  ## XXX pow, ? exp1m, log1p, log2

  proc( f64 : x -> f64 ) =>: export: sin
    x isFinite ! if
      NaN return
    end
    ## XXX? higher precission for large values?
    0.0 =:: mut: k
    x   =:: mut: r
    r 1.6 > or r -1.6 < if
      x PI_INV * 0.5 + floor k=
      x k PI_HI * - k PI_LOW * - r=
      r PI > or r PI -_ < if
        ## reduction failed by more thanfactor of 2 -> no meaningfull result
        NaN return
      end
    end
    ## compute sin(r) using taylor expansion
    r r * =:: r2
    ## XXX? find shorter polynomial
    ## sin(x) = x -x³/3!+x⁵/5!- ...
      ## XXX? is term 19 needed?
     -0x9.7a4da340a0ab926X-F r2 * ## -1/19!
      0xc.a963b81856a5359X-D + r2 * ## 1/17!
     -0xd.73f9f399dc0f88eX-B + r2 * ## -1/15!
      0xb.092309d43684be5X-9 + r2 * ## 1/13!
     -0x6.b99159fd5138e3fX-7 + r2 * ## -1/11!
      0x2.e3bc74aad8e671fX-5 + r2 * ## 1/9!
     -0xd.00d00d00d00d00dX-4 + r2 * ## -1/7!
      0x2.222222222222222X-2 + r2 * ## 1/5!
     -0x2.aaaaaaaaaaaaaaaX-1 + r2 * ## -1/3!
      1 + r *
      k i64 cast 1 & ? if -_ end
    return
  end
  ## XXX? result for +- pi/2 is slightly off from libc
  proc( f64 : x -> f64 ) =>: export: cos
    x isFinite ! if
      NaN return
    end
    ## XXX? higher precission for large values?
    ## x = k*pi + r  -pi/2 <= r <= pi/2
    0.0 =:: mut: k
    x   =:: mut: r
    r 1.6 > or r -1.6 < if
      x PI_INV * 0.5 + floor k=
      x k PI_HI * - k PI_LOW * - r=
      r PI > or r PI -_ < if
        ## reduction failed by more thanfactor of 2 -> no meaningfull result
        NaN return
      end
    end
    ## compute cos(r) using taylor expansion
    r r * =:: r2
    ## XXX? find shorter polynomial
    ## cos(x) = 1 -x²/2!+x⁴/4!- ...
      ## XXX? is term 20 needed?
      ##0x7.950ae900808941fX-10 r2 * ## 1/20!
      0x7.950ae900808941fX-10 r2 * ## 1/20!
     -0xb.413c31dcbecbbddX-E + r2 * ## -1/18!
      0xd.73f9f399dc0f88eX-C + r2 * ## 1/16!
     -0xc.9cba54603e4e905X-A + r2 * ## -1/14!
      0x8.f76c77fc6c4bdaaX-8 + r2 * ## 1/12!
     -0x4.9f93edde27d71cbX-6 + r2 * ## -1/10!
      0x1.a01a01a01a01a01X-4 + r2 * ## 1/8!
     -0x5.b05b05b05b05b05X-3 + r2 * ## -1/6!
      0xa.aaaaaaaaaaaaaaaX-2 + r2 * ## 1/4!
     -0x0.8 + r2 * ## -1/2!
      1 +
      k i64 cast 1 & ? if -_ end
    return
  end
  ## XXX tan, asin,acos,atan, sinh,...

  ## XXX ? complex-math
end
