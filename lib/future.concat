## code that will probably be added to the standard library in a future version
#include string
#include arrayView

proc( i8 => bool ) =: public isWhitespace
  switch
    ' ' '\n' '\t' '\v' '\f' '\r' case
      true return
    default
      false return
  end
end

#namespace array
  #template type : T #end
  proc( T arrayView : src => T arrayView ) =: public clone
    src .length T mem.alloc
      src .data src .length mem.copy
    src .length array.create return
  end
#end

