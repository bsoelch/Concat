## code that will probably be added to the standard library in a future version
#include string
#include arrayView

proc( char => bool ) =: public isWhitespace
  switch
    ' ' '\n' '\t' '\v' '\f' '\r' case
      true return
    default
      false return
  end
end

proc( i8 : chr => i32 ) =: public parseDigit
  chr '0' >= chr '9' <= & if
    chr '0' - return
  else chr 'A' >= chr 'Z' <= & _if
    chr 'A' - 10 + return
  else chr 'a' >= chr 'z' <= & _if
    chr 'a' - 10 + return
  end
  -1 return
end

## XXX rename to ParseNumberError
enum( NONE INT INVALID_BASE EMPTY INVALID_CHAR OVERFLOW ) =:: public ParseIntError
## XXX allow parsing of unsigned integers
proc( string : str  i32 : base => i64 ParseIntError ) =: public tryParseInt
  false =:: mut sign
  base =:: mut mBase
  base 0 != base 2 < base 62 > | & if
    0 ParseIntError .INVALID_BASE return
  end
  0 i64 =: mut res
  false =:: mut overflow
  str
    #dup 0 string.charAt '-' == if
      true sign =
      1 string.tail
    else #dup 0 string.charAt '+' == _if
      1 string.tail
    end
    #dup .length 0 == if
      #drop 0 ParseIntError .EMPTY return
    end
    mBase 0 == if
      10 mBase =
      #dup 0 string.charAt '0' == if
        #dup 1 string.charAt 'x' == if
          16 mBase =
          2 string.tail
        else #dup 1 string.charAt 'b' == _if
          2 mBase =
          2 string.tail
        end
      end
    end
    sign if -0x8000_0000_0000_0000 else 0x7fff_ffff_ffff_ffff end mBase /u =:: maxSafe
    0 while #dup #over:2 .length < do
      #over #over string.charAt
        #over 0 > #over '_' == #over:2 '\'' == | & if
          #drop ## ignore _ and ' in numbers
          1 + continue
        end
      parseDigit
        #dup 0 < #over mBase >= | if
          #drop:3 0 ParseIntError .INVALID_CHAR return
        end
      res
        #dup maxSafe > if
          true overflow =
        end
        mBase * +
      res = ## add digit to number
      1 +
    end #drop
  #drop
  res
    sign if neg end
  overflow if ParseIntError .OVERFLOW return else ParseIntError .NONE return end
end
#namespace float
  proc( => float ) =: NaN 
    0 float cast 0 float cast / return
  end
#end
#template type : T #end
proc( T : x i64 : p => T ) =: powI
  p 0 == if
    1 T cast return
  else p 0 < _if
    1 T cast  x p neg powI / return
  end
  x =:: mut xPow
  1 T cast 
    p while #dup 0 != do
      #dup 1 & 0 != if
      #swap
        xPow *
      #swap
      end
      1 >>
      xPow xPow * xPow =
    end #drop
  return
end

proc( i8 : chr i32 : base => bool ) =: isExpChar
  chr switch
    'e' 'E' case
      base 15 < return
    'x' 'X' case
      base 34 < return
    '#' case 
      true return
    default
      false return
  end
end
proc( string : str i32 : base => float ParseIntError ) =: tryParseFloat
  false =:: mut sign
  base =:: mut mBase
  base 0 != base 2 < base 62 > | & if
    float.NaN ParseIntError .INVALID_BASE return
  end
  0 i64 =: mut c
  false bool =: mut d
  0 i64 =: mut e 
  0 i64 =: mut val
  1 i64 cast 56 << i64 =: mut maxVal ## higher precision than float, no overflow in base 62
  false =:: mut cStyleHex
  str
    #dup 0 string.charAt '-' == if
      true sign =
      1 string.tail
    else #dup 0 string.charAt '+' == _if
      1 string.tail
    end
    #dup .length 0 == if
      #drop 0 float cast ParseIntError .EMPTY return
    end
    mBase 0 == if
      10 mBase =
      #dup 0 string.charAt '0' == if
        #dup 1 string.charAt 'x' == if
          16 mBase =
          2 string.tail
        else #dup 1 string.charAt 'b' == _if
          2 mBase =
          2 string.tail
        end
      end
    end
    0 while #dup #over:2 .length < do
      #over #over string.charAt '.' == if
        d if
          #drop:2 float.NaN ParseIntError .INVALID_CHAR return
        end
        true d =
      else #over #over string.charAt mBase isExpChar _if
        #dup 1 + e =
        break
      else #over #over string.charAt #dup 'p' == #swap 'P' == | mBase 16 == & _if
        #dup 1 + e =
        true cStyleHex =
        10 mBase = ## exponent written in base 10
        c 4 * c = ## scale c to power of 2
        break
      else #over #over string.charAt parseDigit
        #dup 0 < #over mBase >= | if
          #drop:3 float.NaN ParseIntError .INVALID_CHAR return
        end
        val maxVal < if
          val mBase * + val =
          d if
            c 1 - c =
          end
        else #drop d ! _if
          c 1 - c =
        end
      end
      1 +
    end #drop
    e 0 > if
      #dup e string.tail mBase tryParseInt
        #dup ParseIntError .NONE != if =:: err
          #drop:2 float.NaN err return
        end #drop
      c + c =
    end
  #drop
  cStyleHex if ## calculate powers of 2 instead of powers of base
    2 mBase =
  end
  val float cast
    sign if neg end
  mBase float cast  c -100 < if 
     ## calculate power of 1/base instead of negative power of base and
     ## split of last factor to prevent underflow of intermediate results
     1 float cast #swap / 
     -1 c - powI *  mBase float cast /
  else float cast 
     c powI *
  end
  d  e 0 > | if ParseIntError .NONE return else ParseIntError .INT return end 
end
#+ XXX -> add to tests when float-parser in library
entryPoint:
  5 2 powI print
  2 float cast 100 powI print
  "1.25" string.wrap 10 tryParseFloat #drop print

  "f.ffffffffffff8X+ff"  string.wrap 16 tryParseFloat ParseIntError .NONE == print print
  "-f.ffffffffffff8X+ff"  string.wrap 16 tryParseFloat ParseIntError .NONE == print print
  "0.00000000000004X-ff" string.wrap 16 tryParseFloat ParseIntError .NONE == print print
  "-0.00000000000004X-ff" string.wrap 16 tryParseFloat ParseIntError .NONE == print print
  
  "0x1000p-10"  string.wrap 0 tryParseFloat ParseIntError .NONE == print print
  
  "123456789"  string.wrap 0 tryParseFloat ParseIntError .NONE == print print
end
