import mem
import optional

( type : T -> type ) =>: export: arrayView
  struct( T _ ptr : data i64 : length )
end

## TODO writable array view

namespace: array
  proc( type : T -> T arrayView ) =>: export: empty
    { { } : data 0 : length } return
  end
  proc( type : auto: T T _ ptr  i32 -> T arrayView ) =>: export: create_32
    i64 cast.s create_64
  end
  proc( type : auto: T T _ ptr  i64 -> T arrayView ) =>: export: create_64
    T arrayView new return
  end
  overload: export: create create_32 create_64 end
  proc(
    type : auto: T
    i64 : auto: k
    T k ptr : elts
  -> T arrayView ) =>: export: wrap
    elts k create return
  end

  proc( type : auto: T T arrayView : elts i32 : index -> T ) =>: export: get_32
    elts index i64 cast.u get_64
  end
  proc( type : auto: T T arrayView : elts i64 : index -> T ) =>: export: get_64
    index 0 < index elts .length >= | if
      ## TODO error handling
      ..unreachable
    end
    elts .data index [] return
  end
  overload: export: get
    get_32
    get_64
  end
  proc(
    type : auto: T
    T arrayView : elts
    i64 : index
  -> T ptr optional ) =>: export: at
    index 0 < index elts .length >= | if
      T ptr optional.empty return
    end
    elts .data index + T ptr cast! optional.wrap return
  end
  proc(
    type : auto: T
    T arrayView : elts
    T : elt
  -> i64 ) =>: export: indexOf
    0:i64 while ..dup elts .length < do
      elts .data ..over [] elt == if
        return
      end
      1 +
    end
    ..drop
    -1 return
  end
  proc(
    type : auto: T
    T arrayView : elts
    T : elt
  -> i64 ) =>: export: lastIndexOf
    elts .length 1 - ## index
    while ..dup 0 >= do
      elts .data ..over [] elt == if
        return
      end
      1 -
    end
    return
  end
  proc(
    type : auto: T
    T arrayView : elts
    T : elt
  -> bool ) =>: export: contains
    elts elt indexOf -1 != return
  end

  proc(
    type : auto: T
    T arrayView : a
    T arrayView : b
    proc( T ptr T ptr -> bool ) ptr : eq
  -> i64 ) =>: export: indexOfArray
    a .length b .length < if
      -1 return
    end
    ## TODO? use faster algorithm
    0 while ..dup a .length b .length - <= do =:: i
      true =:: mut: match
      0 while ..dup b .length < do =:: j
        ## eq
          a i j + array.at .data
          b j array.at .data
        eq () ! if
          false match =
          j break
        end
        j 1 +
      end ..drop
      match if
        i return
      end
      i 1 +
    end ..drop
    -1 return
  end
  ## find lowest index of array,
  ## if the array is not a sub-sequence contain the smallest possible start index
  proc(
    type : auto: T
    type : auto: C
    T arrayView : a
    T arrayView : b
    proc( T ptr T ptr C -> bool ) ptr : eq
    C : context
  -> i64 ) =>: export: indexOfArrayStart
    ## TODO? use faster algorithm
    0:i64 while ..dup a .length <= do =:: i
      true =:: mut: match
      0:i64 while ..dup b .length < do =:: j
        i j + a .length >= if
          j break
        end
        ## eq
          a i j + array.at .data
          b j array.at .data
          context
        eq () ! if
          false match =
          j break
        end
        j 1 +
      end ..drop
      match if
        i return
      end
      i 1 +
    end ..drop
    ..unreachable
  end

  ## first n characters
  proc(
    type : auto: T
    T arrayView : elts
    i64 : n
  -> T arrayView ) =>: export: head
    n 0 <= if
      T empty return
    end
    n elts .length >= if
      elts return
    end
    elts .data  n create return
  end
  ## everything excluding the first n characters
  proc(
    type : auto: T
    T arrayView : elts
    i64 : n
  -> T arrayView ) =>: export: tail
    n 0 <= if
      elts return
    end
    n elts .length >= if
      T empty return
    end
    elts .data n +  elts .length n -  create return
  end
  ## equivalent to:  <from> tail <len> head
  proc(
    type : auto: T
    T arrayView : elts
    i64 : from
    i64 : len
  -> T arrayView ) =>: export: slice
    len 0 <= if
      T empty return
    end
    from elts .length >= if
      T empty return
    end
    from 0 <= if
      elts  len head return
    end
    from len + elts .length >= if
      elts .data from +  elts .length from -  create return
    end
    elts .data from +  len  create return
  end
  proc(
    type : auto: T
    T arrayView : elts
    i64 : index
  -> T arrayView T arrayView ) =>: export: cutIndex
    elts index tail
    elts index head
    return
  end
  proc(
    type : auto: T
    T arrayView : elts
    i64 : index
  -> T arrayView T arrayView ) =>: export: splitIndex
    index 0 < if
      T empty elts return
    end
    elts index 1 + tail
    elts index head
    return
  end
  proc(
    type : auto: T
    T arrayView : elts
    T : elt
  -> T arrayView T arrayView ) =>: export: split
    elts
      elts elt indexOf
    splitIndex return
  end
  proc(
    type : auto: T
    T arrayView : elts
    T : elt
  -> T arrayView T arrayView ) =>: export: splitLast
    elts
      elts elt lastIndexOf
      ..dup -1 == if ..drop.2
        elts T empty return
      end
    splitIndex return
  end
end
