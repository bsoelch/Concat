import mem
import list
import optional

namespace: map
  i32 =:: NodeId
  0:NodeId =:: NO_NODE
  ( type : K type : V -> type ) =>: Node
    struct( K : key V : mut: value NodeId : mut: next bool : isEmpty )
  end
end

( type : K type : V -> type ) =>: export: hashMap
  struct(
    K V map.Node list : mut: nodeBuffer
    map.NodeId _ ptr.mut : mut: data ## ids are zero for empty or one-based indices in the node buffer
    proc( K -> i32 ) ptr : hash
    proc( K K -> bool ) ptr : eq
    i32 : hashMask ## capacity of data (assumed to be power of 2) -1
    map.NodeId : freeNodes
  )
end

namespace: map
  proc(
    type : auto: K
    proc( K -> i32 ) ptr : hash
    proc( K K -> bool ) ptr : eq
    i32 : initCap
    type : V
  -> K V hashMap ) =>: export: create
    ## set all bits below highest bit to 1, ensure capacity is at least 64
    initCap 1 - 0x3f |
      $ 1 >>> | $ 2 >>> | $ 4 >>> |
      $ 8 >>> | $ 16 >>> |
    =:: hashMask
    hashMask i64 cast 1 + =:: pow2cap
    ## hashMap
      pow2cap K V Node list.create
      pow2cap NodeId mem.calloc
      hash
      eq
      hashMask
      NO_NODE
    K V hashMap new return
  end
  proc(
    type : auto: K
    type : auto: V
    K V hashMap : src
  -> K V hashMap ) =>: export: copy
    src .hashMask i64 cast 1 + =:: capacity
    ## hashMap
      src .nodeBuffer list.copy
      capacity NodeId mem.alloc
        src .data
        capacity
      mem.copy
      src .hash
      src .eq
      src .hashMask
      src .freeNodes
    K V hashMap new return
  end

  proc(
    type : auto: K
    type : auto: V
    K V hashMap ptr.mut : data
  -> ) =>: export: clear
    data [] .nodeBuffer
      list.clear
    data .nodeBuffer=
    data [] .hashMask i64 cast 1 + =:: capacity
    data [] .data capacity mem.clear ..drop
    ## TODO version that allows calling cleanup procedure on all values still in map
  end
  proc(
    type : auto: K
    type : auto: V
    K V hashMap ptr.mut : data
  -> ) =>: export: free
    data [] .nodeBuffer
      list.free
    data .nodeBuffer=
    data [] .data mem.free
    0 data .hashMask=
  end
  proc(
    type : auto: K
    type : auto: V
    proc( K -> ) ptr : freeKey
    proc( V -> ) ptr : freeValue
    K V hashMap ptr.mut : data
  -> ) =>: export: freeAll
    data [] .nodeBuffer for =:: node
      node .isEmpty ! if
        node .key freeKey ()
        node .value freeValue ()
      end
    end
    data [] .nodeBuffer
      list.free
    data .nodeBuffer=
    data [] .data mem.free
    0 data .hashMask=
  end

  proc(
    type : auto: K
    type : auto: V
    NodeId ptr.mut : parent
    K V hashMap ptr.mut : map
  -> NodeId ) =>: nextNodeId
    ## reuse free node if available
    map [] .freeNodes NO_NODE != if
      map [] .freeNodes =:: freeNodeId
        map [] .nodeBuffer
          freeNodeId i64 cast 1 -
        list.at .data =:: freeNode
        freeNode [] .next map .freeNodes=
        NO_NODE freeNode .next= ## unlink returned node
      freeNodeId
    else
      map [] .nodeBuffer .length 1 + NodeId cast
    end =:: newId
      newId parent =[]
    newId return
  end
  enum( FIND CREATE DELETE ) =:: FindOperation
  proc(
    type : auto: K
    type : auto: V
    K V hashMap ptr.mut : map
    K : key
    FindOperation : operation
  -> NodeId ) =>: find
    map [] .hashMask 0 == if ## TODO ensure cap/ error message
       NO_NODE return
    end
    key map [] .hash () map [] .hashMask & =:: keyHash
    map [] .data keyHash @[] NodeId ptr.mut cast! =:: mut: nodeIdLoc
    nodeIdLoc [] NO_NODE == if
      operation .CREATE ?? if
        nodeIdLoc map nextNodeId return
      end
      NO_NODE return
    end
    while
      nodeIdLoc [] =:: nodeId
      nodeId NO_NODE !=
    do
      map [] .nodeBuffer nodeId i64 cast 1 - list.at .data =:: node
      node [] .key key map [] .eq () if
        operation .DELETE ?? if
          ## unlink node from map
          node [] .next nodeIdLoc =[]
          true node .isEmpty=
          map [] .freeNodes node .next=
          nodeId map .freeNodes=
        end
        nodeId return
      end
      node .next nodeIdLoc=
    end
    operation .CREATE ?? if
      nodeIdLoc map nextNodeId return
    end
    NO_NODE return
  end

  proc(
    type : auto: K
    type : auto: V
    K V hashMap ptr.mut : data
    K : key
  -> V optional ) =>: export: get
    data key FindOperation .FIND find =:: nodeId
    nodeId NO_NODE == if
      V optional.empty return
    end
    data [] .nodeBuffer nodeId i64 cast 1 - list.get .value optional.wrap return
  end
  proc(
    type : auto: K
    type : auto: V
    K V hashMap ptr.mut : data
    K : key
  -> V ptr.mut optional ) =>: export: at
    data key FindOperation .FIND find =:: nodeId
    nodeId NO_NODE == if
      V ptr.mut optional.empty return
    end
    data [] .nodeBuffer nodeId i64 cast 1 - list.at .data .value optional.wrap return
  end
  proc(
    type : auto: K
    type : auto: V
    K V hashMap ptr.mut : data
    K : key
    V : value
  -> V optional ) =>: export: put
    data key FindOperation .CREATE find =:: nodeId
      nodeId i32 cast data [] .nodeBuffer .length > if
        data [] .nodeBuffer
          key value NO_NODE false K V Node new list.append
        data .nodeBuffer=
        V optional.empty return
      end
    data [] .nodeBuffer nodeId i32 cast 1 - list.at .data
      $ [] .value =:: prevValue
      value $1 .value=
    =:: nodeData
    nodeData [] .isEmpty if
      false nodeData .isEmpty=
      key nodeData .key=
      V optional.empty return
    end
    prevValue optional.wrap return
  end
  proc(
    type : auto: K
    type : auto: V
    K V hashMap ptr.mut : data
    K : key
  -> V optional ) =>: export: remove
    data key FindOperation .DELETE find =:: nodeId
    nodeId NO_NODE == if
      V optional.empty return
    end
    data [] .nodeBuffer
      nodeId i32 cast 1 -
    list.at .data [] .value optional.wrap return
  end

  ( type : K type : V -> type ) =>: Iterator
    struct( K V hashMap ptr : map i32 : mut: index NodeId : mut: next )
  end
  namespace: itr
    proc(
      type : auto: K
      type : auto: V
      K V hashMap ptr.mut : map
    -> K V Iterator ) =>: export: start
      0:i32 while ..dup map [] .hashMask <= do =:: i
        map [] .data i [] NO_NODE != if
          map i 1 + map [] .data i [] K V Iterator new return
        end
        i 1 +
      end ..drop
      map map [] .hashMask 1 + NO_NODE K V Iterator new return
    end
    proc(
      type : auto: K
      type : auto: V
      K V Iterator
    -> K V Iterator bool ) =>: export: hasNext
      ..dup .next NO_NODE != return
    end
    proc(
      type : auto: K
      type : auto: V
      K V Iterator
    -> K V Iterator ( K ptr V ptr.mut ) ) =>: export: next
      =:: mut: itr
      itr .map [] .nodeBuffer
        itr .next i64 cast 1 -
      list.at .data =:: res
      res [] .next itr@ .next=
      itr .next NO_NODE == if
        while itr .index itr .map [] .hashMask <= do
          itr .map [] .data itr .index [] NO_NODE != if
            itr .map [] .data itr .index [] itr@ .next=
            itr .index 1 + itr@ .index=
            break
          end
          itr .index 1 + itr@ .index=
        end
      end
      itr res .key res .value ( K ptr V ptr.mut ) new return
    end
  end
end
