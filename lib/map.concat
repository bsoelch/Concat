import mem
import list
import optional

namespace: map
  i64 =:: NodeId ## XXX? should NodeId be a sperate type
  ( type : K type : V -> type ) =>: Node
    struct( K : key V : mut: value  NodeId : mut: next )
  end
end

( type : K type : V -> type ) =>: export: hashMap
  struct(
    K V map.Node list : mut: nodeBuffer
    map.NodeId _ ptr.mut : mut: data
    i64 : mut: cap
    proc( K -> i32 ) ptr : hash
    proc( K K -> bool ) ptr : eq
  )
end

namespace: map
  proc(
    type : auto: K
    proc( K -> i32 ) ptr : hash
    proc( K K -> bool ) ptr : eq
    i64 : initCap
    type : V
  -> K V hashMap ) =>: export: create
    initCap K V Node list.create
    initCap NodeId mem.calloc
    initCap ## XXX find smallest power of 2 larger than cap, store shift distance
    hash
    eq
    K V hashMap new return
  end
  proc(
    type : auto: K
    type : auto: V
    K V hashMap : src
  -> K V hashMap ) =>: export: copy
    ## hashMap
      src .nodeBuffer list.copy
      src .cap NodeId mem.alloc
        src .data
        src .cap
      mem.copy
      src .cap
      src .hash
      src .eq
    K V hashMap new return
  end

  proc(
    type : auto: K
    type : auto: V
    K V hashMap ptr.mut : data
  -> ) =>: export: free
    data [] .nodeBuffer
      list.free
    data [] .nodeBuffer =
    data [] .data mem.free
    0 data [] .cap =
  end
  proc(
    type : auto: K
    type : auto: V
    proc( K -> ) ptr : freeKey
    proc( V -> ) ptr : freeValue
    K V hashMap ptr.mut : data
  -> ) =>: export: freeAll
    data [] .nodeBuffer
      0 while ..dup ..over.2 .length < do
        ..over ..over list.get
          ..dup .key freeKey ()
        .value freeValue ()
        1 +
      end ..drop
      list.free
    data [] .nodeBuffer =
    data [] .data mem.free
    0 data [] .cap =
  end

  proc(
    type : auto: K
    type : auto: V
    K V hashMap ptr.mut : data
    K : key
    bool : newNode
  -> NodeId ) =>: find
    data [] .cap 0 == if ## TODO ensure cap/ error message
       0:NodeId return
    end
    key data [] .hash () i64 cast.u data [] .cap u% ## sync types in loop
      data [] .data ..over []
        ..dup 0:NodeId == if ..drop
          newNode if
            data [] .nodeBuffer .length 1 +
              ..dup NodeId cast data [] .data ..over.3 [] =
            ..swap ..drop
            NodeId cast return
          end
          ..drop 0:NodeId return
        end
        i64 cast while ..dup 0 > do ..swap ..drop
          data [] .nodeBuffer ..over i64 cast 1 - list.get
            ..dup .key key data [] .eq () if ..drop
              NodeId cast return
            end
          .next i64 cast
        end ..drop
      newNode if
        data [] .nodeBuffer .length 1 +
          ..dup NodeId cast data [] .nodeBuffer ..over.3 1 - list.at .data [] .next =
        ..swap ..drop
        NodeId cast return
      end
    ..drop 0:NodeId return
  end

  proc(
    type : auto: K
    type : auto: V
    K V hashMap ptr.mut : data
    K : key
  -> V optional ) =>: export: get
    data key false find
      ..dup 0:NodeId == if ..drop
        V optional.empty return
      end
    data [] .nodeBuffer ..swap i64 cast 1 - list.get .value optional.wrap return
  end
  proc(
    type : auto: K
    type : auto: V
    K V hashMap ptr.mut : data
    K : key
  -> V ptr.mut optional ) =>: export: at
    data key false find
      ..dup 0:NodeId == if ..drop
        V ptr.mut optional.empty return
      end
    data [] .nodeBuffer ..swap i64 cast 1 - list.at ..dup optional.isEmpty if ..drop
      V ptr.mut optional.empty return
    end
    .data [] .value @ optional.wrap return
  end
  proc(
    type : auto: K
    type : auto: V
    K V hashMap ptr.mut : data
    K : key
    V : value
  -> V optional ) =>: export: put
    data key true find
      ..dup i64 cast data [] .nodeBuffer .length > if ..drop
        data [] .nodeBuffer
          key value 0:NodeId K V Node new list.append
        data [] .nodeBuffer =
        V optional.empty return
      end
    data [] .nodeBuffer ..swap i64 cast 1 - list.at .data
      ..dup [] .value ..swap
      value ..swap [] .value =
    optional.wrap return
  end

  ( type : K type : V -> type ) =>: Iterator
    struct( K V hashMap ptr : map i64 : mut: index NodeId : mut: next )
  end
  namespace: itr
    proc(
      type : auto: K
      type : auto: V
      K V hashMap ptr.mut : map
    -> K V Iterator ) =>: export: start
      0:i64 while ..dup map [] .cap < do =:: i
        map [] .data i [] 0:NodeId != if
          map i 1 + map [] .data i [] K V Iterator new return
        end
        i 1 +
      end ..drop
      map map [] .cap 0:NodeId K V Iterator new return
    end
    proc(
      type : auto: K
      type : auto: V
      K V Iterator
    -> K V Iterator bool ) =>: export: hasNext
      ..dup .next 0:NodeId != return
    end
    proc(
      type : auto: K
      type : auto: V
      K V Iterator
    -> K V Iterator ( K ptr V ptr.mut ) ) =>: export: next
      =:: mut: itr
      itr .map [] .nodeBuffer
        itr .next i64 cast 1 -
      list.at .data =:: res
      res [] .next itr .next =
      itr .next 0:NodeId == if
        while itr .index itr .map [] .cap < do
          itr .map [] .data itr .index [] 0:NodeId != if
            itr .map [] .data itr .index [] itr .next =
            itr .index 1 + itr .index =
            break
          end
          itr .index 1 + itr .index =
        end
      end
      itr res [] .key @ res [] .value @ ( K ptr V ptr.mut ) new return
    end
  end
end
