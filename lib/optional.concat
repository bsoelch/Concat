#template type : V #end
enum( empty V : data ) =:: export optional
namespace: optional
  #template type : V #end
  proc( V optional -> bool ) =>: export isEmpty
    .empty ?? return
  end
  #template type : V #end
  proc( V optional -> bool ) =>: export hasData
    .data ?? return
  end
  #template type : V #end
  proc( -> V optional ) =>: export empty
    V optional .empty return
  end
  #template type : V #end
  proc( V -> V optional ) =>: export wrap
    V optional .data new return
  end
end
