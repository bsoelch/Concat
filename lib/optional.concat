( type : V -> type ) =>: export: optional
  union( _ : empty V : data )
end
namespace: optional
  proc( type : auto: V V optional -> bool ) =>: export: isEmpty
    .empty ?? return
  end
  proc( type : auto: V  V optional -> bool ) =>: export: hasData
    .data ?? return
  end
  proc( type : V -> V optional ) =>: export: empty
    V optional .empty return
  end
  proc( type : auto: V  V -> V optional ) =>: export: wrap
    V optional .data return
  end

  proc( type : auto: T  T optional -> T ) =>: export: get
    .data
  end

  proc( type : auto: T  T optional -> T optional ) =>: prepareIf end
  proc( type : auto: T  T optional : ignore -> ) =>: elseVal end
end

overload: export: ?
  optional.hasData
end
overload: export: ..if.prepare
  optional.prepareIf
end
overload: export: ..if.check
  optional.hasData
end
overload: export: ..if.ifVal
  optional.get
end
overload: export: ..if.elseVal
  optional.elseVal
end
