"mem" import

namespace: array
  proc(
    type : auto: T
    type : auto: C
    T ptr.raw.mut : src
    T ptr.raw.mut : buff
    iSize : offset
    iSize : size
    proc( T T C -> i32 ) ptr : cmp
    C : context
    i32 : depth
  -> ) =>: mergeSortRec
    size 1:iSize u< if
      return
    end
    size 2:iSize / =:: mid
    size 2:iSize u< if ## data in src
      depth 1 & 0 == if
        return ## data in src & data to src
      end
      src offset [] buff offset =[]
    end
    src buff offset mid cmp context depth 1 + mergeSortRec
    src buff offset mid + size mid - cmp context depth 1 + mergeSortRec
    depth 1 & 0 == if
      buff src
    else
      src buff
    end =:: to =:: from
    0:iSize =:: mut: i
    mid =:: mut: j
    0:iSize =:: mut: k
    while i mid u< j size u< & do
      ## cmp
        from offset i + []
        from offset j + []
        context
      cmp () 0 <= if
        from offset i + [] to offset k + =[]
        i 1:iSize + i=
      else
        from offset j + [] to offset k + =[]
        j 1:iSize + j=
      end
      k 1:iSize + k=
    end
    while i mid u< do
      from offset i + [] to offset k + =[]
      i 1:iSize + i=
      k 1:iSize + k=
    end
    while j size u< do
      from offset j + [] to offset k + =[]
      j 1:iSize + j=
      k 1:iSize + k=
    end
  end
  proc(
    type : auto: T
    type : auto: C
    T ptr.raw.mut : data
    iSize : size
    proc( T T C -> i32 ) ptr : cmp
    C : context
  -> ) =>: export: sort
    size T mem.alloc =:: buffer
    data buffer 0:iSize size cmp context 0 mergeSortRec
    buffer mem.free
  end
  proc(
    type : auto: T
    T ptr.raw.mut : data
    iSize : size
  -> ) =>: export: reverse
    size 1:iSize - =:: last
    size 2:iSize / =:: mid
    0:iSize while $ mid u< do =:: i
      data i []
        data last i - []
        data i =[]
      data last i - =[]
      i 1:iSize +
    end ..drop
  end

  ## returns the index of the largest element in the list that is less than or equal to `value`
  ## if no value is smaller zero is returned
  ## assumes the list is sorted in increasing order
  proc( type : auto: K  type : auto: T  type : auto: C
    T ptr.raw : data
    iSize : size
    proc( K T C -> i32 ) ptr : cmp
    K : value
    C : context
  -> iSize ) =>: export: firstBelow ## TODO better name
    0:iSize =:: mut: shadow: head
    size =:: mut: shadow: tail
    size 2:iSize / =:: mut: mid
    while mid head u> do
      value data mid [] context cmp () =:: c
      c 0 == if
        mid return
      else c 0 > _if
        mid head=
      else
        mid tail=
      end
      head tail + 2:iSize / mid=
    end
    tail size u< and value data head [] context cmp () 0 > if
      tail return
    end
    head return
  end
end
