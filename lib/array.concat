import mem
import itrs/array

namespace: array
  proc(
    type : auto: T
    type : auto: C
    T _ ptr.mut : src
    T _ ptr.mut : buff
    i64 : offset
    i64 : size
    proc( T T C -> i32 ) ptr : cmp
    C : context
    i32 : depth
  -> ) =>: mergeSortRec
    size 1 < if
      return
    end
    size 2 / =:: mid
    size 2 < if ## data in src
      depth 1 & 0 == if
        return ## data in src & data to src
      end
      src offset [] buff offset []=
    end
    src buff offset mid cmp context depth 1 + mergeSortRec
    src buff offset mid + size mid - cmp context depth 1 + mergeSortRec
    depth 1 & 0 == if
      buff src
    else
      src buff
    end =:: to =:: from
    0:i64 =:: mut: i
    mid =:: mut: j
    0:i64 =:: mut: k
    while i mid < j size < & do
      ## cmp
        from offset i + + []
        from offset j + + []
        context
      cmp () 0 <= if
        from offset i + [] to offset k + []=
        i 1 + i@ =
      else
        from offset j + [] to offset k + []=
        j 1 + j@ =
      end
      k 1 + k@ =
    end
    while i mid < do
      from offset i + [] to offset k + []=
      i 1 + i@ =
      k 1 + k@ =
    end
    while j size < do
      from offset j + [] to offset k + []=
      j 1 + j@ =
      k 1 + k@ =
    end
  end
  proc(
    type : auto: T
    type : auto: C
    T _ ptr.mut : data
    i64 : size
    proc( T T C -> i32 ) ptr : cmp
    C : context
  -> ) =>: export: sort
    size T mem.alloc =:: buffer
    data buffer 0 size cmp context 0 mergeSortRec
    buffer mem.free
  end
  proc(
    type : auto: T
    T _ ptr.mut : data
    i64 : size
  -> ) =>: export: reverse
    size 1 - =:: last
    size 2 / =:: mid
    0:i64 while ..dup mid < do =:: i
      data i []
        data last i - []
        data i []=
      data last i - []=
      i 1 +
    end ..drop
  end

  ## returns the index of the largest element in the list that is less than or equal to `value`
  ## if no value is smaller zero is returned
  ## assumes the list is sorted in increasing order
  proc( type : auto: K  type : auto: T  type : auto: C
    T _ ptr : data
    i64 : size
    proc( K T C -> i32 ) ptr : cmp
    K : value
    C : context
  -> i64 ) =>: export: firstBelow ## TODO better name
    0:i64 =:: mut: shadow: head
    size =:: mut: shadow: tail
    size 2 / =:: mut: mid
    while mid head > do
      value data mid [] context cmp () =:: c
      c 0 == if
        mid return
      else c 0 > _if
        mid head@ =
      else
        mid tail@ =
      end
      head tail + 2 / mid@ =
    end
    tail size < and value data head [] context cmp () 0 > if
      tail return
    end
    head return
  end
end
