#include stringBuilder
#include numbers/sb

0x7ff0_0000_0000_0000 =:: EXPONENT_MASK
52 =:: EXPONENT_SHIFT
0x7ff =:: EXPONENT_MASK_SHIFTED
1023 =:: EXP_BIAS
-1023 =:: ZERO_EXP
1024 =:: INF_EXP
0x000f_ffff_ffff_ffff =:: MANTIASSA_MASK
0x000f_0000_0000_0000 =:: MANTIASSA_HI_BLOCK

#namespace double
union( double : mut a i64 : mut b ) =:: converter
proc( double => i64 ) =: getBits ## XXX? platform independent way to get bits
  converter : mut conv
  conv .a =
  conv .b return
end
#end

#namespace sb
proc( stringBuilder : sb double : f => stringBuilder ) =: public appendIeeeDouble
  f double.getBits =:: bits
  bits 0 < =:: sgn
  bits EXPONENT_SHIFT >> EXPONENT_MASK_SHIFTED & EXP_BIAS - =:: exp
  bits MANTIASSA_MASK & =:: mantissa
  sb
    sgn if
      '-' sb.appendC
    end
    exp INF_EXP == if
      mantissa 0 == if
        "INFINITY" sb.appendS
      else
        "NAN" sb.appendS
      end
      return
    end
    "0x" sb.appendS
    exp ZERO_EXP == if
      "0." sb.appendS
      MANTIASSA_HI_BLOCK while #dup mantissa & 0 == do
        #swap
        '0' sb.appendC
        #swap 4 >>
      end #drop
    else
      "1." sb.appendS
    end
    mantissa sb.appendX
    'P' sb.appendC
    exp ZERO_EXP == if
      exp 1 + sb.appendI
    else
      exp sb.appendI
    end
  return
end
#end
