"stringBuilder" *import

## TODO! rewrite unicode library
char8  slice =:: export: string8
char16 slice =:: export: string16
char32 slice =:: export: string32
## XXX? implement procedures for string16, string32
namespace: string16
  { { } : data 0:iSize : length } string16 =: export: empty

  proc( char16 ptr.raw  iSize -> string16 ) =>: export: create
    string16 new return
  end

  proc( char16 slice -> string16 ) =>: export: fromSlice
    string16 cast
  end
  proc( string16 -> char16 slice ) =>: export: toSlice
    char16 slice cast
  end
  proc( i16 slice : arr -> string16 ) =>: export: fromIntSlice
    arr .data char16 ptr.raw cast arr .length create
  end
  proc( string16 : str -> i16 slice ) =>: export: toIntSlice
    str .data i16 ptr.raw cast str .length slice.create
  end

  proc( string16 : str iSize : index -> char16 ) =>: export: get_Z
    str char16 slice cast index [] return
  end
  proc( string16 : str i32 : index -> char16 ) =>: export: get_32
    str char16 slice cast index [] return
  end
  proc( string16 : str i64 : index -> char16 ) =>: export: get_64
    str char16 slice cast index [] return
  end
  overload: export: get
    get_Z
    get_32
    get_64
  end
  proc( string16 : a string16 : b -> bool ) =>: export: eq
    a toSlice b toSlice slice.eq return
  end
end
namespace: string32
  { { } : data 0:iSize : length } string32 =: export: empty

  proc( char32 ptr.raw  iSize -> string32 ) =>: export: create
    string32 new return
  end

  proc( char32 slice -> string32 ) =>: export: fromSlice
    string32 cast
  end
  proc( string32 -> char32 slice ) =>: export: toSlice
    char32 slice cast
  end
  proc( i32 slice : arr -> string32 ) =>: export: fromIntSlice
    arr .data char32 ptr.raw cast arr .length create
  end
  proc( string32 : str -> i32 slice ) =>: export: toIntSlice
    str .data i32 ptr.raw cast str .length slice.create
  end

  proc( string32 : str iSize : index -> char32 ) =>: export: get_Z
    str char32 slice cast index [] return
  end
  proc( string32 : str i32 : index -> char32 ) =>: export: get_32
    str char32 slice cast index [] return
  end
  proc( string32 : str i64 : index -> char32 ) =>: export: get_64
    str char32 slice cast index [] return
  end
  overload: export: get
    get_Z
    get_32
    get_64
  end
  proc( string32 : a string32 : b -> bool ) =>: export: eq
    a toSlice b toSlice slice.eq return
  end
end

namespace: std.literals
  proc( char8 ptr.raw : p iSize : k -> char8 ) =>: static: export: :char8
    k 1 != or p [] 0x7f u> if
      "string is not representable as a single utf8-character" ..compiler.error
    end
    p []
  end
  proc( char8 ptr.raw : p iSize : k -> char16 ) =>: static: export: :char16
    p k string new 0 utf8.nextCodepoint =:: codepoint
    >$ .length == and codepoint isValid && codepoint 0x10000:Codepoint < if
      codepoint char16 cast return
    end
    "string is not representable as a single utf16-character" ..compiler.error
  end
  proc( char8 ptr.raw : p iSize : k -> char32 ) =>: static: export: :char32
    p k string new 0 utf8.nextCodepoint =:: codepoint
    >$ .length == and codepoint isValid if
      codepoint char16 cast return
    end
    "string is not representable as a single unicode-codepoint" ..compiler.error
  end
  proc( char8 ptr.raw : p iSize : k -> string8 ) =>: static: export: :string8
    p k string new
      0:iSize while $1 .length $1 u> do
        nextCodepoint isValid ! if ..drop.2
          "string is not valid utf8" ..compiler.error
        end
      end
    ..drop
    p k string8 new return
  end
  ## TODO? add optional conversion to valid unicode to main libray
  proc( char8 ptr.raw : p iSize : k -> string16 ) =>: static: export: :string16
    "unimplemented" ..panic ## current implementation cannot run at compile time
    char16 k array : mut: buffer
    buffer@ list.wrap =:: mut: str16
    p k string new
      0:iSize while $1 .length $1 u> do
        nextCodepoint =:: cp
        cp isValid ! if ..drop.2
          "source string is not valid utf8" ..compiler.error
        end
        str16 utf16.appendCodepoint str16=
      end
    ..drop
    ## TODO! copy data to static memory
    str16 .data str16 .length string16 new
  end
  proc( char8 ptr.raw : p iSize : k -> string32 ) =>: static: export: :string32
    "unimplemented" ..panic ## current implementation cannot run at compile time
    char32 k array : mut: buffer
    buffer@ list.wrap =:: mut: str32
    p k string new
      0:iSize while $1 .length $1 u> do
        nextCodepoint =:: cp
        cp isValid ! if ..drop.2
          "source string is not valid utf8" ..compiler.error
        end
        str32 cp list.append str32=
      end
    ..drop
    ## TODO! copy data to static memory
    str32 .data str32 .length string16 new
  end
  ( char8 ptr.raw iSize -> char8 ) : static: export: alias: :c8 :char8
  ( char8 ptr.raw iSize -> char16 ) : static: export: alias: :c16 :char16
  ( char8 ptr.raw iSize -> char32 ) : static: export: alias: :c32 :char32
  ( char8 ptr.raw iSize -> string8 ) : static: export: alias: :s8 :string8
  ( char8 ptr.raw iSize -> string16 ) : static: export: alias: :s16 :string16
  ( char8 ptr.raw iSize -> string32 ) : static: export: alias: :s32 :string32
end

namespace: unicode
  i32 =:: export: Codepoint
  ( char8 ptr.raw iSize -> Codepoint ) : static: export: alias: :Codepoint ..builtIn.parse.i32
  -0x1000:Codepoint =:: export: UNKNOWN_CODEPOINT
  0:Codepoint =:: export: MIN_CODEPOINT
  0x10FFFF:Codepoint =:: export: MAX_CODEPOINT
  namespace: Codepoint
    proc( Codepoint Codepoint -> bool ) : alias: lt i32.lt
    proc( Codepoint Codepoint -> bool ) : alias: le i32.le
    proc( Codepoint Codepoint -> bool ) : alias: eq i32.eq
    proc( Codepoint Codepoint -> bool ) : alias: ne i32.ne
    proc( Codepoint Codepoint -> bool ) : alias: ge i32.ge
    proc( Codepoint Codepoint -> bool ) : alias: gt i32.gt
  end
end
overload:  < unicode.Codepoint.lt end
overload: <= unicode.Codepoint.le end
overload: == unicode.Codepoint.eq end
overload: != unicode.Codepoint.ne end
overload: >= unicode.Codepoint.ge end
overload:  > unicode.Codepoint.gt end

namespace: sb
  proc( stringBuilder : sb unicode.Codepoint : cp -> stringBuilder ) =>: export: appendCodepoint
    cp i32 cast 0 < if ## invalid code point
      cp i32 cast -0x100 > if ## -0xff - -0x01 -> fixed bit encoding
        sb cp i32 cast -_ char8 cast sb.appendC return
      end
      sb return
    end
    cp i32 cast 0x80 < if ## 0*** ****
      sb cp char8 cast sb.appendC return
    end
    cp i32 cast 0x800 < if ## 110* **** 10** ****
      sb
        cp i32 cast 6 >>   0xc0 | char8 cast sb.appendC
        cp i32 cast 0x3f & 0x80 | char8 cast sb.appendC
      return
    end
    cp i32 cast 0x10000 < if ## 1110 **** 10** **** 10** ****
      sb
        cp i32 cast 12 >>        0xe0 | char8 cast sb.appendC
        cp i32 cast  6 >> 0x3f & 0x80 | char8 cast sb.appendC
        cp i32 cast       0x3f & 0x80 | char8 cast sb.appendC
      return
    end
    cp i32 cast 0x200000 < if ## 1111 0*** 10** **** 10** **** 10** ****
      sb
        cp i32 cast 18 >>        0xf0 | char8 cast sb.appendC
        cp i32 cast 12 >> 0x3f & 0x80 | char8 cast sb.appendC
        cp i32 cast  6 >> 0x3f & 0x80 | char8 cast sb.appendC
        cp i32 cast       0x3f & 0x80 | char8 cast sb.appendC
      return
    end
    ## not valid code-points but still UTF-8 encodable
    cp i32 cast 0x4000000 < if ## 1111 10** 10** **** 10** **** 10** **** 10** ****
      sb
        cp i32 cast 24 >>        0xf8 | char8 cast sb.appendC
        cp i32 cast 18 >> 0x3f & 0x80 | char8 cast sb.appendC
        cp i32 cast 12 >> 0x3f & 0x80 | char8 cast sb.appendC
        cp i32 cast  6 >> 0x3f & 0x80 | char8 cast sb.appendC
        cp i32 cast       0x3f & 0x80 | char8 cast sb.appendC
      return
    end
    ## 1111 110* 10** **** 10** **** 10** **** 10** **** 10** ****
    sb
      cp i32 cast 30 >>        0xfc | char8 cast sb.appendC
      cp i32 cast 24 >> 0x3f & 0x80 | char8 cast sb.appendC
      cp i32 cast 18 >> 0x3f & 0x80 | char8 cast sb.appendC
      cp i32 cast 12 >> 0x3f & 0x80 | char8 cast sb.appendC
      cp i32 cast  6 >> 0x3f & 0x80 | char8 cast sb.appendC
      cp i32 cast       0x3f & 0x80 | char8 cast sb.appendC
    return
  end
end
namespace: utf8
  using unicode.
  proc( Codepoint : c -> bool ) =>: export: isValid
    c MIN_CODEPOINT >= and c MAX_CODEPOINT <= end return
  end
  proc( string  : str iSize : index -> string iSize Codepoint ) =>: export: nextCodepoint ## XXX? strict UTF8 version than only reads valid codepoints
    index str .length u>= if
      str str .length UNKNOWN_CODEPOINT return
    end
    index =:: mut: i
    str i string.charAt i32 cast.u 0xff & =:: mut: c
    c 0xc0 & 0x80 == or c 0xfe >= if ## invalid starting character
      str index 1:iSize + c -_ Codepoint cast return
    end
    c 0x80 < if ## 0x00 - 0x7f
      str index 1:iSize + c Codepoint cast return
    end
    0x80 =:: mut: mask
    0 =:: mut: count
    while c mask & 0 != do
      mask 1 >>> mask=
      count 1 + count=
    end
    c mask 1 - & =:: mut: cp
    c =:: c0
    i =:: i0
    i count iSize cast.u + str .length u> if ## not enough characters
      str i0 1:iSize + c0 -_ Codepoint cast return
    end
    while count 1 > do
      cp 6 << cp=
      i 1:iSize + i=
      str i string.charAt i32 cast.u 0xff & c=
      c 0xc0 & 0x80 != if ## invalid character in sequence
        str i0 1:iSize + c0 -_ Codepoint cast return
      end
      cp c 0x3f & | cp=
      count 1 - count=
    end
    cp 0x80 < if ## overlong single char
      str i0 1:iSize + c0 -_ Codepoint cast return
    end
    count 2 > cp 0x800 < & if ## overlong character
      str i0 1:iSize + c0 -_ Codepoint cast return
    end
    count 3 > cp 0x10000 < & if ## overlong character
      str i0 1:iSize + c0 -_ Codepoint cast return
    end
    count 4 > cp 0x200000 < & if ## overlong character
      str i0 1:iSize + c0 -_ Codepoint cast return
    end
    count 5 > cp 0x4000000 < & if ## overlong character
      str i0 1:iSize + c0 -_ Codepoint cast return
    end
    str i 1:iSize + cp Codepoint cast return
  end

  proc(
    char32 list : buffer
    string
  -> char32 list ) =>: export: toUTF32
    buffer
      $1 .length list.ensureCap
    =:: mut: utf32chars
    0:iSize while $1 .length $1 u> do
      nextCodepoint =:: cp
      ## XXX? check codepoint for correct encoding?
      utf32chars cp char32 cast list.append utf32chars=
    end ..drop.2
    utf32chars return
  end
  proc(
    char16 list : buffer
    string
  -> char16 list ) =>: export: toUTF16
    buffer
      $1 .length list.ensureCap
    =:: mut: utf16chars
    0:iSize while $1 .length $1 u> do
      nextCodepoint =:: cp
      utf16chars
        cp utf16.appendCodepoint
      utf16chars=
    end ..drop.2
    utf16chars return
  end
end
namespace: utf16
  using unicode.
  0xD800:i32 =:: MIN_SURROGATE
  0xDFFF:i32 =:: MAX_SURROGATE
  0xFC00:i32 =:: SURROGATE_MASK
  0xD800:i32 =:: HI_SURROGATE_FLAG
  0xDC00:i32 =:: LOW_SURROGATE_FLAG
  0x03FF:i32 =:: SURROGATE_DATA_MASK
  10:i32 =:: SURROGATE_SHIFT
  0x10000:i32 =:: SURROGATE_BIAS
  proc( string16  : str iSize : index -> string16 iSize unicode.Codepoint ) =>: export: nextCodepoint
    index str .length u>= if
      str str .length UNKNOWN_CODEPOINT return
    end
    str index string16.get i32 cast.u =:: mut: c
    c MIN_SURROGATE < or c MAX_SURROGATE > if ## normal character
      str index 1:iSize + c Codepoint cast return
    end
    c SURROGATE_MASK & LOW_SURROGATE_FLAG == if ## unpaired low surrogate
      str index 1:iSize + c -_ Codepoint cast return
    end
    index 1:iSize + str .length u>= if ## not enough characters
      str index 1:iSize + c -_ Codepoint cast return
    end
    str index 1:iSize + string16.get i32 cast.u =:: lower
    lower SURROGATE_MASK & LOW_SURROGATE_FLAG != if ## invalid low surrogate
      str index 1:iSize + c -_ Codepoint cast return
    end
    str
      index 2:iSize +
    c SURROGATE_DATA_MASK & SURROGATE_SHIFT <<
      lower SURROGATE_DATA_MASK & |
    SURROGATE_BIAS + Codepoint cast return
  end
  proc( char16 list Codepoint : cp -> char16 list ) =>: export: appendCodepoint
    cp MIN_CODEPOINT < or cp MAX_CODEPOINT > if
      cp i32 cast -_ =:: value
      value MIN_SURROGATE >= and value MAX_SURROGATE <= if
        ## unpaired surrogate
        value char16 cast list.append return
      end
      ## skip invalid characters
      ## XXX? better error handling behavior
    else cp i32 cast 0xffff <= _if
      cp char16 cast list.append
    else ## surrogate pair
      cp i32 cast 0x10000 - =:: offset
      0xD800 offset 10 >>>  | char16 cast list.append ## hi
      0xDC00 offset 0x3ff & | char16 cast list.append ## low
    end
  end
   proc(
    stringBuilder : buffer
    string16
  -> stringBuilder ) =>: export: toUTF8
    buffer
      $1 .length sb.ensureCap
    =:: mut: utf8chars
    0:iSize while $1 .length $1 u> do
      nextCodepoint =:: cp
      utf8chars cp sb.appendCodepoint utf8chars=
    end ..drop.2
    utf8chars return
  end
end
