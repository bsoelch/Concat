import list

namespace: list
  ( type : T -> type ) =>: ListFilterItr
    (
      T ptr.raw.mut : shadow: head
      T ptr.raw : shadow: tail
      Capacity : oldCap
      T ptr.raw.mut : srcPos
      T ptr.raw.mut : dstPos
    )
  end
  proc( type : auto: T
    T list : elts
  -> T ListFilterItr ) =>: export: itrFilter
    ## MapItr
      elts .data
      elts .data elts .length @[]
      elts .capacity
      elts .data
      elts .data
    T ListFilterItr new
  end
  proc( type : auto: T
    T list : mut: elts
    ( T -> bool ) ptr : f
  -> T list ) =>: export: fFilter
    elts itrFilter for f () end return
  end
  overload: export: filter itrFilter fFilter end

  namespace: filterItr
    proc( type : auto: T  T ListFilterItr -> T ListFilterItr ) =>: prepare end
    proc( type : auto: T
      T ListFilterItr : itr
    -> bool ) =>: export: check
      itr .srcPos itr .tail <
    end
    proc( type : auto: T
      T ListFilterItr : itr
    -> T ) =>: export: shadow: get
      itr .srcPos []
    end
    proc( type : auto: T
      bool : keepVal
      T ListFilterItr : itr
    -> T ListFilterItr ) =>: export: step
      itr
        keepVal if
          $ .srcPos [] $1 .dstPos =[]
          $ .dstPos 1 @[] >$ .dstPos=
        end
        $ .srcPos 1 @[] >$ .srcPos=
      return
    end
    proc( type : auto: T
      T ListFilterItr : itr
    -> T list ) =>: export: endFilter
      itr .head itr .dstPos itr .head ptr.diff itr .oldCap T list new
    end
  end
end
overload: export: ..itr.prepare
  list.filterItr.prepare
end
overload: export: ..itr.check
  list.filterItr.check
end
overload: export: ..itr.get
  list.filterItr.get
end
overload: export: ..itr.step
  list.filterItr.step
end
overload: export: ..itr.end
  list.filterItr.endFilter
end
