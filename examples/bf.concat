#+
simple Brainfuck interpreter
+#
import string
import stringLiteral
import list
import io

proc( string -> i8 ) =>: runBf_0
  0x100 runBf_C
end
proc( i64 : ip string : code -> i64 ) =>: skipLoop
  1 =:: mut: n
  ip 1 + while $ code .length < do =:: i
    code i string.charAt '[' == if
      n 1 + n@ =
    else code i string.charAt ']' == _if
      n 1 - n@ =
      n 0 <= if i return end
    end
  finally i 1 + end return
end
proc( string : code i64 : tapeCap -> i8 ) =>: runBf_C
  tapeCap 0 > "tape is non-empty" assert
  tapeCap i8 mem.calloc =:: tape
  64 i64 list.create =:: mut: stack
  tapeCap 2 / =:: mut: mp
  0:i64 =:: mut: ip
  while ip code .length < do
    code ip string.charAt switch
      '+' case tape mp [] 1 + tape mp []= break
      '-' case tape mp [] 1 - tape mp []= break
      '>' case mp 1 + tapeCap %% mp@ = break
      '<' case mp 1 - tapeCap %% mp@ = break
      '.' case tape mp [] char8 cast io.putc ..drop break
      ',' case
          io.getChar io.FILE_ERROR_NONE == if
            i8 cast tape mp []=
          else ..drop
            0:i8 tape mp []=
          end
          break
      '[' case
        tape mp [] ? if
          stack ip list.append stack@ =
          continue
        end
        ip code skipLoop ip@ =
        break
      ']' case
        stack list.peek .data [] =:: loopStart
        tape mp [] ? if
          loopStart ip@ =
          continue
        else
          stack list.pop ..drop stack@ =
        end       
        break
    end
  finally ip 1 + ip@ = end
  tape mp []
    tape mem.free
    stack list.free ..drop
  return
end
overload: runBf runBf_0 runBf_C end

proc( -> ) =>: main
  "+[-->-[>>+>-----<<]<--<---]>-.>>>+.>>..+++[.>]<<<<.+++.------.<<-.>>>>+.":s runBf ..drop
  "++[>+++++<-]>.":s runBf ..drop
end
