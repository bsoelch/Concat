#+
Computes the n-th Fibonacci number
+#
import numbers/printNumbers

proc( i64 : mut: n -> i64 ) =>: fib
  0:i64 1:i64
    while n 0 > do
      $1 + >$
    finally n 1 - n= end
  ..drop
end

proc( -> ) =>: main
  1 fib io.println
  2 fib io.println
  3 fib io.println
  4 fib io.println
  5 fib io.println
  10 fib io.println
  20 fib io.println
end
