import stringIO
import numbers
import chars
import string
using std.literals.

import "common.concat"

struct( FilePosition : mut: currentPos FilePosition : mut: wordStart ) =:: export: FileState

## TODO? special tokens for keywords
union(
  _ : Empty
  _ : Eof
  string : Identifier
  string : String
  string : RawString
  string : Char
  ## tokens for literals <literal>:<literalType>
  string : LiteralType
  string : Literal
  string : LiteralString
  string : LiteralRawString
  string : LiteralChar
) =:: export: Token

namespace: sb
  proc( stringBuilder : sb Token : token -> stringBuilder ) =>: export: appendToken
    token switch
      Empty case
        sb "empty" sb.appendS return
      Eof case
        sb "unexpected end of file" sb.appendS return
      Identifier .case =:: id
        sb
          "identifier \"" sb.appendS
          id sb.appendStr
          '\"' sb.appendC
        return
      LiteralType .case =:: val
        sb
          "literal type :\"" sb.appendS
          val sb.appendStr
          '\"' sb.appendC
        return
      Literal .case =:: val
        sb
          "literal \"" sb.appendS
          val sb.appendStr
          '\"' sb.appendC
        return
      String .case =:: val
        sb
          "string \"" sb.appendS
          val sb.appendStr
          '\"' sb.appendC
        return
      RawString .case =:: val
        sb
          "raw string `" sb.appendS
          val sb.appendStr
          '`' sb.appendC
        return
      Char .case =:: val
        sb
          "char \"" sb.appendS
          val sb.appendStr
          '\"' sb.appendC
        return
      LiteralString .case =:: val
        sb
          "literal string \"" sb.appendS
          val sb.appendStr
          "\":" sb.appendS
        return
      LiteralRawString .case =:: val
        sb
          "raw string `" sb.appendS
          val sb.appendStr
          "`:" sb.appendS
        return
      LiteralChar .case =:: val
        sb
          "literal char \"" sb.appendS
          val sb.appendStr
          "\":" sb.appendS
        return
    end
  end
  proc( stringBuilder : sb FilePosition : pos -> stringBuilder ) =>: export: appendPos
    sb
      pos .fileName sb.appendStr
      ':' sb.appendC
      pos .line sb.appendI
      ':' sb.appendC
      pos .posInLine sb.appendI
    return
  end
end

proc( char8 : chr  FilePosition ptr.mut : currentPos -> ) =>: export: updateFilePos
  chr '\n' == if
      currentPos [] .line 1 + currentPos .line=
    1 currentPos .posInLine=
  else
    currentPos [] .posInLine 1 + currentPos .posInLine=
  end
end

proc( string : code FileState ptr.mut : fileState -> string Token ) =>: export: nextToken
  code .length 0:iSize == if
    string.empty Token .Empty return
  end
  code 0 string.charAt ':' == =:: isLiteralType
  0:iSize while $ code .length u< do =:: i ## skip comments and whitespaces
    code i string.charAt =:: c
    ## only update position if char is skipped
    c char.isWhitespace if
      c fileState .currentPos updateFilePos
      i 1:iSize + continue
    end
    c '#' == and i 1:iSize + code .length u< if
      code i 1:iSize + string.charAt =:: nxt
      nxt '#' == if ## XXX? allow '# ' as line comment
        c fileState .currentPos updateFilePos
        nxt fileState .currentPos updateFilePos
        ## line comment
        i 2:iSize + while $ code .length u< do
          code $1 string.charAt =:: c2
          1:iSize + ## checked character
          c2 fileState .currentPos updateFilePos
          c2 '\n' == if break end
        end continue
      else nxt '+' == _if
        c fileState .currentPos updateFilePos
        nxt fileState .currentPos updateFilePos
        ## block-comment
        1 =:: mut: k
        i 2:iSize + while $ code .length 1:iSize - u< do
          code $1 string.charAt =:: c2
          c2 fileState .currentPos updateFilePos
          c2 '+' == and code $1 1:iSize + string.charAt '#' == if
            '#' fileState .currentPos updateFilePos
            k 1 - k=
            k 0 == if 2:iSize + break end
            2:iSize + continue
          else c2 '#' == and code $1 1:iSize + string.charAt '+' == _if
            '+' fileState .currentPos updateFilePos
            k 1 + k=
            2:iSize + continue
          end
          1:iSize +
        end continue
      end
    end
    i break ## neither whitespace nor comment
  end
    isLiteralType if ## skip leading `:` of literal type
      ':' fileState .currentPos updateFilePos
      1:iSize +
    end
  =:: startIndex
  fileState [] .currentPos fileState .wordStart=
  code .length startIndex u<= if
    string.empty Token .Empty return
  end
  code startIndex string.charAt =:: c0
  c0 char.isDigit or c0 '-' == and
    code .length startIndex 1 + u> and code startIndex 1 + string.charAt char.isDigit
  end =:: isNumber
  c0 '"' == or c0 '\'' == if
    c0 fileState .currentPos updateFilePos
    false =:: mut: escape
    startIndex 1:iSize +
      $ =:: i0
    while $ code .length u< do =:: i
      code i string.charAt =:: c
      c fileState .currentPos updateFilePos
      escape if
        false escape= continue
      end
      c c0 == if
        code i0 i i0 - string.getSlice =:: body
        code i 1:iSize + string.tail
        body
          i 1:iSize + code .length u< and code i 1:iSize + string.charAt ':' == if
            c0 '\'' == if Token .LiteralChar else Token .LiteralString end
            return
          end
          c0 '\'' == if Token .Char else Token .String end
        return
      else c '\\' == _if
        true escape=
      end
    finally i 1:iSize + end ..drop
    string.empty Token .Eof return
  else c0 '`' == _if
    c0 fileState .currentPos updateFilePos
    startIndex 1:iSize +
      $ =:: i0
    while $ code .length u< do =:: mut: i
      code i string.charAt =:: c
      c fileState .currentPos updateFilePos
      c '`' == if
        code i0 i i0 - string.getSlice =:: body
        i 1 + i=
        i code .length u< and code i string.charAt '`' == if
          '`' fileState .currentPos updateFilePos
          continue ## escaped `
        end
        code i string.tail body
          i code .length u< and code i string.charAt ':' == if
            Token .LiteralRawString return
          end
        Token .RawString return
      end
    finally i 1 + end ..drop
    string.empty Token .Eof return
  end
  startIndex
    $ =:: i0
  while $ code .length u< do =:: i
    code i string.charAt =:: c
    c char.isWhitespace or
        c '#' == and i 1:iSize + code .length u< and "#+":s code i 1:iSize + string.charAt string.contains if
      isLiteralType ! if
        i i0 u> "identifier contains at least one character" assert
      end
      code i0 i i0 - string.getSlice =:: idName
      code i string.tail idName
      isLiteralType if
        Token .LiteralType
      else
        Token .Identifier
      end return
    end
    ## identifier followed by start of string
    i i0 u> and c '"' == or c '`' == or c '\'' == and isNumber ! if
      code i0 i i0 - string.getSlice =:: idName
      code i string.tail idName
      isLiteralType if
        Token .LiteralType
      else
        Token .Identifier
      end return
    end
    ## : within identifer not followed by space or :
    c ':' == and
        i i0 u> and code i 1:iSize - string.charAt '.' != and ## don't split on : after .
        code i0 string.charAt '#' != and ## don't split on : in ids starting with #
        i 1:iSize + code .length u< and ## don't split at EOF
        code i 1:iSize - string.charAt ':' != and code i 1:iSize + string.charAt ':' != and ## don't split on ::
        code i 1:iSize + string.charAt char.isWhitespace ! if ## not followed by space
      code i0 i i0 - string.getSlice =:: idName
      code i string.tail idName
      isLiteralType if
        Token .LiteralType
      else
        Token .Literal
      end return
    end
    c fileState .currentPos updateFilePos
    i 1:iSize +
  end ..drop
  i0 code .length u< if
    string.empty code i0 string.tail Token .Identifier return
  end
  string.empty Token .Empty return
end
