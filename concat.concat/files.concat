#include stringIO
#include numbers
#include chars

#include "common.concat"

struct( FilePosition : mut currentPos FilePosition : mut wordStart ) =:: public FileState

enum( EMPTY string : IDENTIFER string : STRING string : CHAR ) =:: public Token

#namespace sb
  proc( stringBuilder : sb Token : token => stringBuilder ) =: public appendToken
    token switch
      EMPTY case
        sb "empty" sb.appendS return
      IDENTIFER case
        sb
          "identifier \"" sb.appendS
          token .IDENTIFER sb.appendStr
          '\"' sb.appendC
        return
      STRING case
        sb
          "string \"" sb.appendS
          token .STRING sb.appendStr
          '\"' sb.appendC
        return
      CHAR case
        sb "char \"" sb.appendS
          token .CHAR sb.appendStr
          '\"' sb.appendC
        return
    end
  end
  proc( stringBuilder : sb FilePosition : pos => stringBuilder ) =: public appendPos
    sb
      pos .fileName sb.appendStr
      ':' sb.appendC
      pos .line sb.appendI
      ':' sb.appendC
      pos .posInLine sb.appendI
    return
  end
#end

proc( string => ) =: public printTokens
  "test" #dup ..length string.create 0 1 FilePosition new #dup FileState new =:: mut state
  while
    state addrOf nextToken
    128 sb.create
      #swap sb.appendToken
      " at " sb.appendS
      state .wordStart sb.appendPos
      '\n' sb.appendC
    io.stdOut #swap io.fputSb #drop
    #dup .length 0 >
  do end #drop
end

proc( i8 : chr  FilePosition ptr mut : currentPos => ) =: public updateFilePos
  chr '\n' == if
      currentPos [] .line 1 + currentPos [] .line =
    1 currentPos [] .posInLine =
  else
    currentPos [] .posInLine 1 + currentPos [] .posInLine =
  end
end
proc( string : code FileState ptr mut : fileState => string ) =: skipSpaces
  0 while #dup code .length < code #over:2 string.charAt char.isWhitespace & do
    code #over string.charAt fileState [] .currentPos @ updateFilePos
    1 +
  end
  code #swap string.tail return
end
proc( string : code FileState ptr mut : fileState => string Token ) =: public nextToken
  code .length 0 <= if
    string.empty Token .EMPTY return
  end
  code fileState skipSpaces ## cut of leading white-spaces
  #dup .length 0 <= if #drop
    string.empty Token .EMPTY return
  end
    while
      #dup .length 2 < if break end
      #dup 0 string.charAt '#' == #over 1 string.charAt '#' == & if ## line comment
        '#' fileState [] .currentPos @ updateFilePos
        '#' fileState [] .currentPos @ updateFilePos
        2 while #dup #over:2 .length < #over:2 #over:2 string.charAt '\n' != & do
          #over #over string.charAt fileState [] .currentPos @ updateFilePos
          1 +
        end
        string.tail fileState skipSpaces
        true
      else false end #swap
      #dup 0 string.charAt '#' == #over 1 string.charAt '+' == & if ## block comment
        '#' fileState [] .currentPos @ updateFilePos
        '+' fileState [] .currentPos @ updateFilePos
        2 while #dup #over:2 .length <  #over:2 #over:2 1 - string.charAt '+' !=  #over:3 #over:3 string.charAt '#' != |  & do
          #over #over string.charAt fileState [] .currentPos @ updateFilePos
          1 +
        end
        #over #over string.charAt fileState [] .currentPos @ updateFilePos
        1 +
        string.tail fileState skipSpaces
        #swap #drop true
      else #swap end
    do end
    fileState [] .currentPos fileState [] .wordStart =
    #dup 0 string.charAt fileState [] .currentPos @ updateFilePos
    #dup 0 string.charAt '"' == if ## string
      1 string.tail
      0 while #dup #over:2 .length < #over:2 #over:2 string.charAt '"' != & do
        #over #over string.charAt '\\' == if ##escape characters
          #over #over string.charAt fileState [] .currentPos @ updateFilePos
          1 +
        end
        #over #over string.charAt fileState [] .currentPos @ updateFilePos
        1 +
      end
      #over #over string.charAt fileState [] .currentPos @ updateFilePos
      string.splitIndex Token .STRING new return
    end
    #dup 0 string.charAt '\'' == if ## char
      1 string.tail
      0 while #dup #over:2 .length < #over:2 #over:2 string.charAt '\'' != & do
        #over #over string.charAt '\\' == if ##escape characters
          #over #over string.charAt fileState [] .currentPos @ updateFilePos
          1 +
        end
        #over #over string.charAt fileState [] .currentPos @ updateFilePos
        1 +
      end
      #over #over string.charAt fileState [] .currentPos @ updateFilePos
      string.splitIndex Token .CHAR new return
    end
    1 while #dup #over:2 .length < #over:2 #over:2 string.charAt char.isWhitespace ! & do
      #over #over string.charAt fileState [] .currentPos @ updateFilePos
      1 +
    end
  string.cutIndex
    #dup .length 0 == if
      #drop Token .EMPTY return
    end
  Token .IDENTIFER new return
end
