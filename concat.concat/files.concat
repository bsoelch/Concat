import stringIO
import numbers
import chars

import "common.concat"

struct( FilePosition : mut: currentPos FilePosition : mut: wordStart ) =:: export: FileState

## XXX? special tokens for keywords
enum( DEFAULT UTF8 UTF16 UTF32 INT_LITERAL UNKNOWN ) =:: export: StringLiteralType
struct( string : value StringLiteralType : stringType ) =:: StringToken
union(
  _ : EMPTY
  _ : EOF
  string : IDENTIFIER
  StringToken : STRING
  StringToken : RAW_STRING
  StringToken : CHAR
) =:: export: Token

enum( RAW_STRING STRING STRING_ESCAPE IDENTIFIER ) =:: ParserState

namespace: sb
  proc( stringBuilder : sb Token : token -> stringBuilder ) =>: export: appendToken
    token switch
      EMPTY case
        sb "empty" sb.appendS return
      EOF case
        sb "unexpected end of file" sb.appendS return
      IDENTIFIER case
        sb
          "identifier \"" sb.appendS
          token .IDENTIFIER sb.appendStr
          '\"' sb.appendC
        return
      STRING case ## XXX print string literal types
        sb
          token .STRING .stringType sb.appendStringType
          "string \"" sb.appendS
          token .STRING .value sb.appendStr
          '\"' sb.appendC
        return
      RAW_STRING case
        sb
          token .RAW_STRING .stringType sb.appendStringType
          "raw string `" sb.appendS
          token .STRING .value sb.appendStr
          '`' sb.appendC
        return
      CHAR case
        sb
          token .CHAR .stringType sb.appendStringType
          "char \"" sb.appendS
          token .CHAR .value sb.appendStr
          '\"' sb.appendC
        return
    end
  end
  proc( stringBuilder : sb FilePosition : pos -> stringBuilder ) =>: export: appendPos
    sb
      pos .fileName sb.appendStr
      ':' sb.appendC
      pos .line sb.appendI
      ':' sb.appendC
      pos .posInLine sb.appendI
    return
  end
  proc( stringBuilder : sb StringLiteralType : stringType -> stringBuilder ) =>: export: appendStringType
    stringType switch
      DEFAULT case sb return
      UTF8  case sb "utf8 "  sb.appendS return
      UTF16 case sb "utf16 " sb.appendS return
      UTF32 case sb "utf32 " sb.appendS return
      UNKNOWN case sb "unknown " sb.appendS return
      INT_LITERAL case sb "int-literal " sb.appendS return
    end
  end
end

proc( string -> ) =>: export: printTokens
  "test" ..dup ..length string.create 0 1 FilePosition new ..dup FileState new =:: mut: state
  while
    state @ nextToken
    128 sb.create
      ..swap sb.appendToken
      " at " sb.appendS
      state .wordStart sb.appendPos
      '\n' sb.appendC
    io.stdOut ..swap io.fputSb ..drop
    ..dup .length 0 >
  do end ..drop
end


proc( char8 : chr  FilePosition ptr.mut : currentPos -> ) =>: export: updateFilePos
  chr '\n' == if
      currentPos [] .line 1 + currentPos [] .line =
    1 currentPos [] .posInLine =
  else
    currentPos [] .posInLine 1 + currentPos [] .posInLine =
  end
end
proc( string -> StringLiteralType ) =>: checkStringPrefix
  $ .length 0 == if ..drop
    StringLiteralType .DEFAULT return
  else $ "utf8" string.wrap string.eq _if ..drop
    StringLiteralType .UTF8  return
  else $ "utf16" string.wrap string.eq _if ..drop
    StringLiteralType .UTF16 return
  else $ "utf32" string.wrap string.eq _if ..drop
    StringLiteralType .UTF32 return
  else $ 0 string.charAt '0' >= and $ 0 string.charAt '9' <= _if ..drop
    StringLiteralType .INT_LITERAL return ## first char of prefix is digit -> int-literal
  else $ 0 string.charAt '-' == and $ .length 1 > and
      $ 1 string.charAt '0' >= and $ 1 string.charAt '9' <= _if ..drop
    StringLiteralType .INT_LITERAL return ## prefix starts with - followed by digit -> int-literal
  else ..drop
    StringLiteralType .UNKNOWN return
  end
end
proc( string : code FileState ptr.mut : fileState -> string Token ) =>: export: nextToken
  code .length 0 <= if
    string.empty Token .EMPTY return
  end
  ParserState .IDENTIFIER =:: mut: state
  '"' =:: mut: stringStart
  StringLiteralType .DEFAULT =:: mut: stringType
  0:i64 while $ code .length < do =:: i ## skip comments and whitespaces
    code i string.charAt =:: c
    ## only update position if char is skipped
    c char.isWhitespace if
      c fileState [] .currentPos@ updateFilePos
      i 1 + continue
    end
    c '#' == and i 1 + code .length < if
      code i 1 + string.charAt =:: nxt
      nxt '#' == if ## XXX? allow '# ' as line comment
        c fileState [] .currentPos@ updateFilePos
        nxt fileState [] .currentPos@ updateFilePos
        ## line comment
        i 2 + while $ code .length < do
          code $1 string.charAt =:: c2
          1 + ## checked character
          c2 fileState [] .currentPos@ updateFilePos
          c2 '\n' == if break end
        end continue
      else nxt '+' == _if
        c fileState [] .currentPos@ updateFilePos
        nxt fileState [] .currentPos@ updateFilePos
        ## block-comment
        1 =:: mut: k
        i 2 + while $ code .length 1 - < do
          code $1 string.charAt =:: c2
          c2 fileState [] .currentPos@ updateFilePos
          c2 '+' == and code $1 1 + string.charAt '#' == if
            '#' fileState [] .currentPos@ updateFilePos
            k 1 - k =
            k 0 == if 2 + break end
            2 + continue
          else c2 '#' == and code $1 1 + string.charAt '+' == _if
            '+' fileState [] .currentPos@ updateFilePos
            k 1 + k =
            2 + continue
          end
          1 +
        end continue
      end
    end
    i break ## neither whitespace nor comment
  end
    $ =:: mut: i0
    fileState [] .currentPos fileState [] .wordStart =
  while $ code .length < do =:: i
    code i string.charAt =:: c
    state .IDENTIFIER ?? and c char.isWhitespace or
        c '#' == and i 1 + code .length < and "#+" string.wrap code i 1 + string.charAt string.contains if
      i i0 > assert "identifer contains at least one character"
      code i0 i i0 - string.slice =:: idName
      code i string.tail idName Token .IDENTIFIER return
    end
    c fileState [] .currentPos@ updateFilePos
    state .STRING_ESCAPE ?? if
      ParserState .STRING state =
      i 1 + continue
    end
    state .RAW_STRING ?? if
      c '`' == if
        i 1 + code .length < and code i 1 + string.charAt '`' == if
          '`' fileState [] .currentPos@ updateFilePos
          i 2 + continue ## escaped `
        end
        code i0 i i0 - string.slice =:: body
        code i 1 + string.tail body stringType StringToken new Token .RAW_STRING return
      end
      i 1 + continue
    end
    state .STRING ?? if
      c stringStart == if
        code i0 i i0 - string.slice =:: body
        code i 1 + string.tail
        body stringType StringToken new
          stringStart '\'' == if Token .CHAR else Token .STRING end
        return
      else c '\\' == _if
        ParserState .STRING_ESCAPE state =
      end
      i 1 + continue
    end
    c '\'' == or c '"' == or c '`' == if  ## char/string-literal
      code i0 i i0 - string.slice checkStringPrefix stringType =
      stringType .INT_LITERAL ?? if i 1 + continue end
      i 1 + i0 =
      c stringStart =
      c '`' == if ParserState .RAW_STRING else ParserState .STRING end state =
    end
    i 1 +
  end ..drop
  state .IDENTIFIER ?? and i0 code .length < if
    string.empty code i0 string.tail Token .IDENTIFIER return
  end
  i0 code .length < if ## unexpected end of file
    string.empty Token .EOF return
  end
  string.empty Token .EMPTY return
end
