import sys
import string
import numbers
import exec
import file
import argParse

import "parser.concat"
import "typeCheck.concat"
import "usageAnalysis.concat"
import "prepareCompile.concat"
import "generator_qbe.concat"
import "generator_asm.concat"

sb.empty =:: mut: srcPath
sb.empty =:: mut: targetPath
sb.empty =:: mut: outPath
sb.empty =:: mut: tmpPath
string.empty =:: mut: baseName
string.empty =:: mut: basePath
string.empty =:: mut: libPath
string list.empty =:: mut: linkTo

i16 =:: DumpPhases
namespace: DumpPhases
  0x0000 DumpPhases cast =:: NONE
  0x0001 DumpPhases cast =:: PARSER
  0x0002 DumpPhases cast =:: TYPE_CHECKER
  0x0004 DumpPhases cast =:: USAGE_ANALYSIS
  0x0008 DumpPhases cast =:: ALIAS_DETECTION
  0x0010 DumpPhases cast =:: PRE_COMPILER
  0xFFFF DumpPhases cast =:: ALL
  proc( DumpPhases DumpPhases -> DumpPhases ) : alias: and i16.and
  proc( DumpPhases -> bool ) : alias: toBool i16.toBool
end
overload: ? DumpPhases.toBool end
overload: & DumpPhases.and end
DumpPhases.NONE =:: mut: dumpPhases
false =:: mut: verbose
true =:: mut: compileGeneratedCode
string list.empty =:: mut: runArgs
## TODO? flag for cleaning up intermediate files
false =:: mut: runCompiledProgram

proc( -> ) =>: parseArgs
  string.empty =:: mut: outPath0
  string list.empty =:: mut: sourceFiles
  string list.empty =:: mut: libPaths
  OptLevel .DEFAULT =:: mut: optLevel
  0 sys.getArg =:: path
  args.start
    "-":s args.prefixes ## set argument prefix
    "[src-file]+ (-o [output-file])? [option]*":s args.usage
    arg.value ## take next argument as value
      "[output-file]":s arg.value.setArgName
      "output file":s arg.helpText
    outPath0@ "-o":s arg.set
    DumpPhases arg.flagGroup ## consume following value-args, check for specific values
      "-Tparser":s DumpPhases.PARSER arg.flagGroup.enable
      "-Ttype-checker":s DumpPhases.TYPE_CHECKER arg.flagGroup.enable
      "-Tusage-analysis":s DumpPhases.USAGE_ANALYSIS arg.flagGroup.enable
      "-Talias-detection":s DumpPhases.ALIAS_DETECTION arg.flagGroup.enable
      "-Tpre-compiler":s DumpPhases.PRE_COMPILER arg.flagGroup.enable
      "-T":s arg.flagGroup.enableAll
      "dump compiler outputs after phases":s arg.helpText
      args.HelpLevel .EXTENDED arg.helpLevel
    dumpPhases@ arg.collect
    arg.values ## take folowing values as list
      "[lib-path]":s arg.values.setArgName
      "libary path(s)":s arg.helpText
    libPaths@ "-l":s arg.collect
    arg.values
      "[file-path]":s arg.values.setArgName
      "additional files to pass to the linker":s arg.helpText
    linkTo@ "-L":s arg.collect
    arg.flag ## set a flag if arg appears
      "treat warnings as errors":s arg.helpText
    _W_ERROR_@ "-W":s arg.set
    "-Wunused":s "-Wno-unused":s arg.flagToggle ## toggle a flag depending on argument
      "warn for unused identifiers":s arg.helpText
      args.HelpLevel .EXTENDED arg.helpLevel
    _W_UNUSED_@ arg.set
    arg.flag
      "verbose mode":s arg.helpText
      args.HelpLevel .EXTENDED arg.helpLevel
    verbose@ "-v":s arg.set
    arg.flag
      arg.flag.negate
      "output generated target code":s arg.helpText
      args.HelpLevel .EXTENDED arg.helpLevel
    compileGeneratedCode@ "-S":s arg.set
    arg.flag
      "run compiled code, using subsequent arguments as program arguments":s arg.helpText
      runArgs@ arg.flag.consumeTail
      "[program-arg]":s arg.flag.setArgName
    runCompiledProgram@ "-R":s arg.set
    arg.flag
      "enable experimental features":s arg.helpText
    _EXPERIMENTAL_@ "-X":s arg.set
    arg.flag
      "enable experimental support for value-types in QBE-backend":s arg.helpText
    _QBE_VAL_TYPES_@ "-Xval-types":s arg.set
    OptLevel arg.select ## select value depending on which arg appear last
      OptLevel .DEFAULT arg.select.default
      "-O0":s OptLevel .NONE arg.select.option
      "-Odefault":s OptLevel .DEFAULT arg.select.option
      "-O":s OptLevel .OPTIMIZE arg.select.option
      "-Ox":s OptLevel .EXPERIMENTAL arg.select.option
      "optimization level":s arg.helpText
    optLevel@ arg.set
    arg.flag
      arg.flag.negate
      "disable core imports":s arg.helpText
      args.HelpLevel .EXTENDED arg.helpLevel
    _INCLUDE_CORE_@ "--no-core":s arg.set
    "--export-globals":s "--no-export-globals":s arg.flagToggle
      "export global identifiers":s arg.helpText
    EXPORT_GLOBALS@ arg.set
    arg.flag
      arg.flag.negate
      "don't increment version counter":s arg.helpText
      args.HelpLevel .SPECIAL arg.helpLevel
    _INCREMENT_VERSION_@ "--no-inc-version":s arg.set
    BackEnd arg.select ## ? store untyped specialisations for 1,2,4,8,16 bytes types err for larger sizes
      ## -> convert input to opaque values
      BackEnd .QBE arg.select.default
      "--asm":s BackEnd .ASM arg.select.option
      "--qbe":s BackEnd .QBE arg.select.option
      "select compiler backend":s arg.helpText
    _BACKEND_@ arg.set
    "-h":s args.HelpLevel .DEFAULT arg.help
    "--help":s args.HelpLevel .DEFAULT arg.help
    "--help+":s args.HelpLevel .EXTENDED arg.help
    "--help++":s args.HelpLevel .SPECIAL arg.help
    arg.misc
      "source files":s arg.helpText
      "need at least one source file":s arg.misc.require ## at least one value has to be given
    sourceFiles@ arg.collect
  args.parse if
    1 sys.exit
  end
  optLevel optimizerFlags.setOptLevel
  srcPath
    sourceFiles .length 1 u> if
      "compilation with multiple sources is not supported":s io.println
      sourceFiles for io.println end
      1 sys.exit
    end
    sourceFiles 0 [] sb.appendStr
  srcPath=
  sourceFiles list.free ..drop
  srcPath sb.asStr '.' string.lastIndexOf =:: mut: iDot
  srcPath sb.asStr '/' string.lastIndexOf =:: iSlash ## TODO? support windows paths ('\' instead of '/')
  iDot .and =:: dotIndex iSlash .and dotIndex >$ u< if
    iSize optional.empty iDot=
  end
  targetPath
    outPath0 .length 0 != if
      outPath0 sb.appendStr
    else
      srcPath sb.asStr iDot string.head sb.appendStr
    end
  targetPath=
  targetPath sb.asStr baseName=
  outPath
    outPath0 .length 0 != and compileGeneratedCode ! if
      targetPath sb.appendSb
    else
      baseName sb.appendStr
      _BACKEND_ switch
        QBE case ".ssa\x00" sb.appendS break
        ASM case ".s\x00" sb.appendS break
      end
    end
  outPath=
  iSlash .if =:: slashIndex
    srcPath sb.asStr slashIndex 1:iSize + string.head string.copy
  else
    "./":s
  end basePath=
  libPaths .length 0 == if
    "./lib/":s
  else
    libPaths .length 1 u> if
      "using multiple library paths are not supported":s io.println
    end
    libPaths 0 []
  end libPath=
  ## TODO? check if libPath exists
  libPath $ .length 1:iSize - string.charAt =:: l0
  l0 '/' != and l0 '\\' != if
    file.stdErr "library path has to end with '/' or '\\'\n":s file.write ..drop
    1 sys.exit
  end
  libPaths list.free ..drop
end

proc( CompilerError list ptr.mut : errors -> ) =>: checkErrors
  errors [] .length 0:iSize == if
    return
  end
  errors [] errorCmp@ list.sort
  false =:: mut: hasError
  1024 sb.create
    errors [] for =:: err
      err sb.appendCompilerError
      err .errType .ERROR if
        true hasError=
      else _W_ERROR_ err .errType .WARNING & _if
        true hasError=
      end
    end
    file.stdErr
      $1 sb.asStr file.write
    file.close
  sb.free ..drop
  hasError if
    1 sys.exit
    ..unreachable
  end
  errors [] list.clear errors =[]
end

proc( -> ProgramContext ) =>: parseAndTypeCheck
  srcPath libPath basePath dumpPhases ? parseProgram
    =:: mut: typeCheckState
  =:: mut: prog
  sb.empty srcPath= ## clear source-path to avoid accidental double free
  prog@ typeCheckState@ updateTypeCheckerPointers
  dumpPhases DumpPhases.PARSER & ? if
    tmpPath sb.free
      baseName sb.appendStr
      ".tokens.parser":s sb.appendStr
    tmpPath=
    1024 sb.create
      prog@ sb.appendProgram
    =:: parsedOps
    tmpPath sb.asStr file.OpenMode .WRITE file.open
      parsedOps sb.asStr file.write
    file.close
    parsedOps sb.free ..drop
  end
  prog@ .errors checkErrors
  ## new type-checker
  typeCheckState@ typeCheckProgram
  prog return
end
proc( -> ) =>: main ## TODO check return value of fopen
  parseArgs
  verbose if
    "compiling ":s io.print
    srcPath sb.asStr io.println
    "-----------------------------------------":s io.println
  end
  ## TODO cleanup program memory after compilation
  parseAndTypeCheck =:: mut: prog
  dumpPhases DumpPhases.TYPE_CHECKER & ? if
    1024 sb.create
      prog@ sb.appendProgram
    =:: parsedOps
    tmpPath sb.free
      baseName sb.appendStr
      ".tokens.typeChecker":s sb.appendStr
    tmpPath=
    tmpPath sb.asStr file.OpenMode .WRITE file.open
      parsedOps sb.asStr file.write
      "\n-----------------\n":s file.write
    file.close
    parsedOps sb.free ..drop
  end
  prog@ .errors checkErrors
  prog@ usageAnalysis
  dumpPhases DumpPhases.USAGE_ANALYSIS & ? if
    1024 sb.create
      prog@ sb.appendProgram
    =:: parsedOps
    tmpPath sb.free
      baseName sb.appendStr
      ".tokens.usageAnalysis":s sb.appendStr
    tmpPath=
    tmpPath sb.asStr file.OpenMode .WRITE file.open
      parsedOps sb.asStr file.write
    file.close
    parsedOps sb.free ..drop
  end
  prog@ aliasDetection
  dumpPhases DumpPhases.ALIAS_DETECTION & ? if
    1024 sb.create
      prog@ sb.appendProgram
    =:: parsedOps
    tmpPath sb.free
      baseName sb.appendStr
      ".tokens.aliasDetection":s sb.appendStr
    tmpPath=
    tmpPath sb.asStr file.OpenMode .WRITE file.open
      parsedOps sb.asStr file.write
    file.close
    parsedOps sb.free ..drop
  end
  prog@ prepareCompile
  dumpPhases DumpPhases.PRE_COMPILER & ? if
    1024 sb.create
      prog@ sb.appendProgram
    =:: parsedOps
    tmpPath sb.free
      baseName sb.appendStr
      ".tokens.preCompile":s sb.appendStr
    tmpPath=
    tmpPath sb.asStr file.OpenMode .WRITE file.open
      parsedOps sb.asStr file.write
    file.close
    parsedOps sb.free ..drop
  end
  prog@ .errors checkErrors
  outPath sb.asStr file.OpenMode .WRITE file.open
    _BACKEND_ switch
      QBE case prog@ compileToQBE break
      ASM case prog@ compileToASM break
    end
  file.close
  prog@ .errors checkErrors
  prog freeProgramContext ..drop
  0 =:: mut: retCode
  compileGeneratedCode if
    ## call compiler on generated code in sub-process
    _BACKEND_ switch
      QBE case
        tmpPath sb.clear
          baseName sb.appendStr
          ".s":s sb.appendStr
        tmpPath=
        verbose if
          "compile generated QBE-code:":s io.println
          "-----------------------------------------":s io.println
        end
        "qbe":s exec.build
          "-o":s exec.add tmpPath sb.asStr exec.add
          outPath sb.asStr exec.add
        exec.run exec.check ! if
          false runCompiledProgram=
          ## TODO? print errors to stderr
          "Error: compilation of QBE-code failed":s io.println
          1 retCode=
          break
        end
        verbose if
          "compile generated Assembly-code:":s io.println
          "-----------------------------------------":s io.println
        end
        "gcc":s exec.build
          "-g":s exec.add "-lm":s exec.add
          tmpPath sb.asStr exec.add
          tmpPath sb.clear
            libPath sb.appendStr
            "extern.c":s sb.appendStr
          tmpPath=
          tmpPath sb.asStr exec.add
          linkTo for exec.add end
          "-o":s exec.add targetPath sb.asStr exec.add
        exec.run exec.check ! if
          false runCompiledProgram=
          "Error: compilation of Assembly failed":s io.println
          1 retCode=
          break
        end
        break
      ASM case
        verbose if
          "compile generated Assembly-code:":s io.println
          "-----------------------------------------":s io.println
        end
        tmpPath sb.clear
          libPath sb.appendStr
          "extern.c":s sb.appendStr
        tmpPath=
        "gcc":s exec.build
          "-g":s exec.add "-lm":s exec.add
          outPath sb.asStr exec.add
          tmpPath sb.asStr exec.add
          linkTo for exec.add end
          "-o":s exec.add targetPath sb.asStr exec.add
        exec.run exec.check ! if
          false runCompiledProgram=
          "Error: compilation of Assembly failed":s io.println
          1 retCode=
          break
        end
        break
    end
    runCompiledProgram if
      tmpPath sb.clear
        targetPath sb.asStr '/' string.contains ! if
          "./":s sb.appendStr
        end
        targetPath sb.appendSb
      tmpPath=
      verbose if
        "run compiled code:":s io.println
        "-----------------------------------------":s io.println
      end
      tmpPath sb.asStr exec.build exec.run .SUCCESS if
        retCode=
      else ..drop
        verbose if
          "could not run program ":s io.print
          baseName io.println
        end
      end
    end
  end
  outPath sb.free ..drop
  tmpPath sb.free ..drop
  targetPath sb.free ..drop
  retCode sys.exit
end
