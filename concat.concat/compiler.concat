#include "parser.concat"
#include "typeCheck.concat"
#include "generators.concat"

entryPoint:
  ..argc 1 > if
    0 sb.create 1 ..getArg string.create sb.appendStr
  else
    "./test.concat" sb.wrap
  end =:: rootFile
  rootFile parseProgram =:: mut prog

  prog .errors .length 0 == if
    prog @ typeCheckProgram
  end
  prog .errors .length 0 > if
    0 while #dup prog .progFiles .length < do
      prog .progFiles #over list.at .data
        #dup [] .localOps list.clear #over [] .localOps =
        #dup [] .globalOps list.clear #over [] .globalOps =
        #dup [] .templateOps list.clear #over [] .templateOps =
      #drop
      1 +
    end #drop
  end
  prog @ getDeclaredTypes =:: types
  "./types.txt\x00" io.OPEN_WRITE io.fopenS #drop =:: typesFile
  1024 sb.create
    0 while #dup types .length < do
      #swap
        types #over:2 list.get prog .idContext .labelContext @ prog .idContext .typeContext @ sb.appendType
        '\n' sb.appendC
      #swap 1 +
    end #drop
  typesFile #swap io.fputSb #drop
  typesFile io.fclose #drop
  1024 sb.create
    prog sb.appendProgram
  =:: parsedOps
  "./out.txt\x00" io.OPEN_WRITE io.fopenS #drop
    #dup parsedOps io.fputSb #drop
  io.fclose #drop
  parsedOps sb.free #drop
end
