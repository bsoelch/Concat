import sys
import string
import numbers
import exec

using std.literals.

import "parser.concat"
import "typeCheck.concat"
import "prepareCompile.concat"
import "generator_qbe.concat"
import "generator_asm.concat"

stringBuilder : mut: srcPath
stringBuilder : mut: targetPath
stringBuilder : mut: outPath
stringBuilder : mut: tmpPath
string : mut: baseName
string : mut: basePath
string : mut: libPath
string optional : mut: errorFile
## XXX? more controll of compilation states after which tokens will be dumped
false =:: mut: dumpTokens
false =:: mut: verbose
true =:: mut: compileGeneratedCode
## TODO? flag for cleaning up intermediate files
false =:: mut: runCompiledProgram

## make new compiler flags accessible in code through `..compiler.flag.<...>`
proc( string : path -> ) =>: printUsage
  "usage: " sb.copyPtr
    path sb.appendStr
    " \"inputFile\" [-o \"outputFile\"]\n" sb.appendS
    "options:\n" sb.appendS
    "  -h: print help text\n" sb.appendS
    "  -o \"fileName\": set output file  (default: \"./out.c\")\n" sb.appendS
    "  -T: dump tokens in intermediate steps to file\n" sb.appendS
    "  -l \"fileName\": set path to standard library (default: \"./lib/\")\n" sb.appendS ## XXX allow more than one library path
    "  -e \"fileName\": write all compiler errors to the given file\n" sb.appendS
    "  -W: treat warnings as errors\n" sb.appendS
    "  -v: vebose mode\n" sb.appendS
    "  -S: compile generated code\n" sb.appendS
    "  -R: run compiled code\n" sb.appendS
    "  --no-core: don't include libray core by default \n" sb.appendS
    io.stdOut ..over io.fputSb ..drop
  sb.free ..drop
end
enum( NONE IN OUT LIB_PATH ERR_PATH ) =:: ArgParserState
proc( -> ) =>: parseArgs
  false =:: mut: printedUsage
  false =:: mut: hasSrc
  false =:: mut: hasOut
  false =:: mut: hasLib
  0 sb.create srcPath=
  0 sb.create targetPath=
  0 sb.create outPath=
  0 sb.create tmpPath=
  string optional.empty errorFile=
  0 sys.getArg string.create =:: path
  ArgParserState .IN =:: mut: state
  1:i64 while ..dup sys.argc < do
    ..dup sys.getArg string.create =:: arg
    arg .length 0 == if
      1 + continue
    end
    arg 0 string.charAt '-' == if
      arg .length 2 < if
        io.stdErr "invalid argument \"-\"" io.fputs ..drop
        1 + continue
      end
      arg 1 string.charAt switch
        'h' case
          printedUsage if continue end
          path printUsage
          true printedUsage=
          continue
        'o' case
          arg .length 2 > if break end
          ArgParserState .OUT state=
          continue
        'T' case
          true dumpTokens=
          continue
        'l' case
          arg .length 2 > if break end
          ArgParserState .LIB_PATH state=
          continue
        'e' case
          arg .length 2 > if break end
          ArgParserState .ERR_PATH state=
          continue
        'W' case
          arg .length 2 > if break end
          true _W_ERROR_=
          continue
        'v' case
          true verbose=
          continue
        'S' case
          false compileGeneratedCode=
          continue
        'R' case ## run code
          true runCompiledProgram=
          continue
        'X' case ## experimental features
          arg .length 2 > if break end
          true _EXPERIMENTAL_=
          continue
        'O' case ## optimization level
          arg .length 2 == if
            1
          else arg "-Odefault":s string.eq _if
            optimizerFlags.optLevelDefault
            continue
          else arg "-Ox":s string.eq _if
            optimizerFlags.optLevelExperimental
            continue
          else
            arg 2 string.tail 10 number.tryParseInt .NONE ?? ! if
              ..drop 1 ## parsing as int failed
            end
          end =:: opLevel
          opLevel 0 <= if
            optimizerFlags.optLevel0
            continue
          else opLevel 1 >= _if
            optimizerFlags.optLevel1
            continue
          end
          break
        '-' case
          arg "--no-core":s string.eq if
            false _INCLUDE_CORE_= continue
          else arg "--export-global":s string.eq _if
            true EXPORT_GLOBALS= continue
          else arg "--no-inc-version":s string.eq _if
            false _INCREMENT_VERSION_= continue
          else arg "--asm":s string.eq _if
            BackEnd .ASM _BACKEND_= continue
          end
          break
        default break
      end
      "unknown compiler option: \"" sb.copyPtr
        arg sb.appendStr
        "\"\n" sb.appendS
        io.stdErr ..over io.fputSb ..drop
      sb.free ..drop
      continue
    end
    state switch
      NONE case
        "expected compiler option got \"" sb.copyPtr
          arg sb.appendStr
          "\"\n" sb.appendS
          io.stdErr ..over io.fputSb ..drop
        sb.free ..drop
        break
      IN case
        srcPath sb.clear arg sb.appendStr srcPath=
        true hasSrc=
        ArgParserState .NONE state=
        break
      OUT case
        targetPath sb.clear arg sb.appendStr targetPath=
        true hasOut=
        hasSrc if ArgParserState .NONE else ArgParserState .IN end state=
        break
      ERR_PATH case
        arg optional.wrap errorFile=
        hasSrc if ArgParserState .NONE else ArgParserState .IN end state=
        break
      LIB_PATH case
        arg libPath=
        true hasLib=
        hasSrc if ArgParserState .NONE else ArgParserState .IN end state=
        break
    end
  finally 1 + end ..drop
  hasSrc ! if
    printedUsage if
      0 sys.exit
      ..unreachable
    end
    io.stdErr "no input file specified\n" io.fputs ..drop
    path printUsage
    srcPath sb.free
    outPath sb.free
    1 sys.exit
    ..unreachable
  end
  srcPath sb.asStr '.' string.lastIndexOf =:: mut: iDot
  srcPath sb.asStr '/' string.lastIndexOf =:: iSlash ##XXX? support windows paths ('\' instead of '/')
  iDot iSlash < if
    -1 iDot=
  end
  hasOut ! if
    targetPath
      srcPath sb.asStr
        iDot 0 > if
          iDot string.head
        end sb.appendStr
    targetPath=
  end
  targetPath sb.asStr baseName=
  outPath sb.clear
    hasOut and compileGeneratedCode ! if
      targetPath sb.appendSb
    else
      baseName sb.appendStr
      _BACKEND_ switch
        QBE case ".ssa\x00" sb.appendS break
        ASM case ".s\x00" sb.appendS break
      end
    end
  outPath=
  iSlash 0 < if
    "./":s
  else
    srcPath sb.asStr iSlash 1 + string.head
  end basePath=
  hasLib ! if
    "./lib/":s libPath=
  else libPath ..dup .length 1 - string.charAt ..dup '/' != ..swap '\\' != & _if
    io.stdErr "library path has to end with '/' or '\\'\n" io.fputs ..drop
    srcPath sb.free
    outPath sb.free
    1 sys.exit
    ..unreachable
  end
  ## XXX check if libPath exists
end

proc( CompilerError list ptr.mut : errors -> ) =>: checkErrors
  errors [] .length 0 == if
    return
  end
  errors [] errorCmp@ list.sort
  false =:: mut: hasError
  1024 sb.create
    0:i32 while ..dup errors [] .length < do
      ..swap
        errors [] ..over.2 list.at .data =:: err
        err [] sb.appendCompilerError
        err [] .errType .ERROR ?? if
          true hasError=
        else _W_ERROR_ err [] .errType .WARNING ?? & _if
          true hasError=
        end
      ..swap 1 +
    end ..drop
    errorFile optional.hasData if errorFile .data io.OPEN_WRITE io.fopenStr ..drop else io.stdErr end
      ..dup ..over.2 io.fputSb ..drop
    errorFile optional.hasData if io.fclose ..drop else ..drop end ## don't close stdErr
  sb.free ..drop
  hasError if
    1 sys.exit
    ..unreachable
  end
  errors [] list.clear errors =[]
end

proc( -> ProgramContext ) =>: parseAndTypeCheck
  srcPath libPath basePath dumpTokens parseProgram
    =:: mut: typeCheckState
  =:: mut: prog
  prog@ typeCheckState@ updateTypeCheckerPointers
  dumpTokens if
    tmpPath sb.free
      baseName sb.appendStr
      ".tokens.parser":s sb.appendStr
    tmpPath=
    1024 sb.create
      prog@ sb.appendProgram
    =:: parsedOps
    tmpPath sb.asStr io.OPEN_WRITE io.fopenStr ..drop
      ..dup parsedOps io.fputSb ..drop
    io.fclose ..drop
    parsedOps sb.free ..drop
  end
  prog@ .errors checkErrors
  ## new type-checker
  typeCheckState@ typeCheckProgram
  prog return
end
proc( -> ) =>: main ## TODO check return value of fopen
  verbose if
    "compiling ":s io.print
    srcPath sb.asStr io.println
    "-----------------------------------------":s io.println
  end
  parseArgs
  ## TODO cleanup program memory after compilation
  parseAndTypeCheck =:: mut: prog
  dumpTokens if
    1024 sb.create
      prog@ sb.appendProgram
    =:: parsedOps
    tmpPath sb.free
      baseName sb.appendStr
      ".tokens.typeChecker":s sb.appendStr
    tmpPath=
    tmpPath sb.asStr io.OPEN_WRITE io.fopenStr ..drop
      ..dup parsedOps io.fputSb ..drop
      ..dup "\n-----------------\n" io.fputs ..drop
    io.fclose ..drop
    parsedOps sb.free ..drop
  end
  prog@ .errors checkErrors
  prog@ prepareCompile
  ## TODO seperate file for each compilation step
  dumpTokens if
    1024 sb.create
      prog@ sb.appendProgram
    =:: parsedOps
    tmpPath sb.free
      baseName sb.appendStr
      ".tokens.preCompile":s sb.appendStr
    tmpPath=
    tmpPath sb.asStr io.OPEN_WRITE io.fopenStr ..drop
      ..dup parsedOps io.fputSb ..drop
    io.fclose ..drop
    parsedOps sb.free ..drop
  end
  prog@ .errors checkErrors
  outPath sb.asStr io.OPEN_WRITE io.fopenStr ..drop  =:: targetFile
    _BACKEND_ switch
      QBE case targetFile prog@ compileToQBE break
      ASM case
        ## TODO make intermediatePath compiler-argument like paths for dumping tokens
        baseName .length 5 + sb.create
          baseName sb.appendStr
          ".asm\x00" sb.appendS
        =:: intermediatePath
        intermediatePath sb.asStr
          io.OPEN_WRITE io.fopenStr ..drop
        optional.wrap =:: intermediateFile?
        ## TODO? split compileToASM in two steps
        ## 1. compile to "pseudo-asm"
        ## 2. compile "pseudo-asm" to "real" asm
        targetFile intermediateFile? prog@ compileToASM
        intermediateFile? optional.hasData if
          intermediateFile? .data io.fclose ..drop
        end
        intermediatePath sb.free ..drop
        break
    end
  targetFile io.fclose ..drop
  prog@ .errors checkErrors
  prog freeProgramContext ..drop
  0 =:: mut: retCode
  compileGeneratedCode if
    ## call compiler on generated code in sub-process
    _BACKEND_ switch
      QBE case
        tmpPath sb.clear
          baseName sb.appendStr
          ".s":s sb.appendStr
        tmpPath=
        verbose if
          "compile generated QBE-code:":s io.println
          "-----------------------------------------":s io.println
        end
        "qbe":s exec.build
          outPath sb.asStr exec.add
          "-o":s exec.add tmpPath sb.asStr exec.add
        exec.run exec.check ! if
          false runCompiledProgram=
          ## TODO? print errors to stderr
          "Error: compilation of QBE-code failed":s io.println
          1 retCode=
          break
        end
        verbose if
          "compile generated Assembly-code:":s io.println
          "-----------------------------------------":s io.println
        end
        "gcc":s exec.build
          "-g":s exec.add "-lm":s exec.add
          tmpPath sb.asStr exec.add "extern.c":s exec.add
          "-o":s exec.add targetPath sb.asStr exec.add
        exec.run exec.check ! if
          false runCompiledProgram=
          "Error: compilation of Assembly failed":s io.println
          1 retCode=
          break
        end
        break
      ASM case
        verbose if
          "compile generated Assembly-code:":s io.println
          "-----------------------------------------":s io.println
        end
        "gcc":s exec.build
          "-g":s exec.add "-lm":s exec.add
          outPath sb.asStr exec.add "extern.c":s exec.add
          "-o":s exec.add targetPath sb.asStr exec.add
        exec.run exec.check ! if
          false runCompiledProgram=
          "Error: compilation of Assembly failed":s io.println
          1 retCode=
          break
        end
        break
    end
    runCompiledProgram if
      tmpPath sb.clear
        targetPath sb.asStr '/' string.contains ! if
          "./":s sb.appendStr
        end
        targetPath sb.appendSb
      tmpPath=
      verbose if
        "run compiled code:":s io.println
        "-----------------------------------------":s io.println
      end
      tmpPath sb.asStr exec.build exec.run .SUCCESS ?? if
        retCode=
      else ..drop
        verbose if
          "could not run program ":s io.print
          baseName io.println
        end
      end
    end
  end
  outPath sb.free ..drop
  tmpPath sb.free ..drop
  srcPath sb.free ..drop
  targetPath sb.free ..drop
  retCode sys.exit
end
