#include sys

#include "parser.concat"
#include "typeCheck.concat"
#include "generator_c.concat"

entryPoint:
  ..argc 1 > if
    0 sb.create 1 ..getArg string.create sb.appendStr
  else
    "./test.concat" sb.wrap
  end =:: rootFile
  rootFile parseProgram =:: mut prog

  prog .errors .length 0 == if
    prog @ typeCheckProgram
  end
  prog .errors .length 0 == if
    "./out.c\x00" io.OPEN_WRITE io.fopenS #drop ## TODO check return value
      #dup prog @ compileToC
    io.fclose #drop
  end
  prog .errors .length 0 > if
    1024 sb.create
      0 while #dup prog .errors .length < do
        #swap
          prog .errors #over:2 list.at .data [] sb.appendCompilerError
        #swap 1 +
      end #drop
      "./out.txt\x00" io.OPEN_WRITE io.fopenS #drop
        #dup #over:2 io.fputSb #drop
      io.fclose #drop
    sb.free #drop
    1 sys.exit
    ..unreachable
  end
  1024 sb.create
    prog sb.appendProgram
  =:: parsedOps
  "./out.txt\x00" io.OPEN_WRITE io.fopenS #drop
    #dup parsedOps io.fputSb #drop
  io.fclose #drop
  parsedOps sb.free #drop
end
