        1 + continue
      end
      candidate [] .arguments constContext constArrayAsArray =:: candidateArgs
      candidateArgs .length arguments .length != if
        1 + continue
      end
      true =:: mut match
      0 while ..dup arguments .length < do
        ## constantEquals
          candidateArgs ..over array.get
          arguments ..over.2 array.get
          labelContext
        constantEquals ! if
          false match =
          break
        end
        1 +
      end ..drop
      match if
        #+index+# Type .generatedType false return
      end
      1 +
    end ..drop
    typeContext [] .generatedTypes
      ..dup .length GeneratedId cast =:: newId
      ## GeneratedType
        generator
        arguments constContext constArray
        Type .undefined
      GeneratedType new list.append
    typeContext [] .generatedTypes =
    newId Type .generatedType true return
  end

  proc(
    LabelId : base
    ConstValue arrayView : arguments
    Type : value
    TypeContext ptr mut : typeContext
    ConstantContext ptr mut : constContext
  -> bool ) =>: export initializeGeneratedType
    ## findGeneratedType
      base
      arguments
      typeContext
      constContext
    findGeneratedType ..drop .generatedType =:: id
    typeContext [] .generatedTypes id list.at .data =:: prevType
    prevType [] .generated .undefined ?? ! if
      true return
    end
    value prevType [] .generated =
    false return
  end

  proc( Type : generator TypeContext ptr : context -> Type ) =>: export getGeneratedType
    generator =:: mut t
    t .namedType ?? if
      t context unwrapNamedKeepGenerated t =
    end
    t .generatedType ?? ! if
      generator return
    end
    context [] .generatedTypes t .generatedType list.at .data =:: genData
    genData [] .generated return
  end

  proc( Type : generator TypeContext ptr : context -> LabelId ) =>: export getGeneratorLabel
    generator =:: mut t
    t .namedType ?? if
      t context unwrapNamedKeepGenerated t =
    end
    t .generatedType ?? ! if
      id.LABEL_ID_NONE return
    end
    context [] .generatedTypes t .generatedType list.at .data =:: genData
    genData [] .generator return
  end
  proc( Type : generator TypeContext ptr : context -> ConstantArray ) =>: export getGeneratorArgs
    generator =:: mut t
    t .namedType ?? if
      t context unwrapNamedKeepGenerated t =
    end
    t .generatedType ?? ! if
      emptyConstArray return
    end
    context [] .generatedTypes t .generatedType list.at .data =:: genData
    genData [] .arguments return
  end

  proc( Type : base bool : mutable TypeContext ptr mut : context -> Type ) =>: export newReferenceType
    0 while ..dup context [] .compositeData .length < do
      context [] .compositeData ..over list.get =:: typeData
      base typeData typeEquals if
        break
      end
      1 +
    end =:: id
    id context [] .compositeData .length == if
      context [] .compositeData
        base list.append
      context [] .compositeData =
    end
    id mutable if Type .mutableReference else Type .reference end return
  end


  ## generic,template & auto-types
  proc( i32 : id -> Type ) =>: export newAutoType
    id Type .autoType return
  end
  proc( Type -> bool ) =>: export isAutoType
    .autoType ?? return
  end
  proc( i32 : id -> Type ) =>: export newGenericType
    id Type .genericType return
  end
  proc( i32 : id -> Type ) =>: export newTemplateType
    id Type .templateType return
  end

  proc( Type -> i32 ) =>: export getTypeId
    ..dup switch
      autoType case .autoType return
      genericType case .genericType return
      templateType case .templateType return
      generatedType case .generatedType return
      pointer case .pointer return
      arrayType case .arrayType return
      struct case .struct return
      union case .union return
      enum case .enum return
      procIn case .procIn return
      procOut case .procOut return
      procedure case .procedure return
      namedType case .namedType return
      reference case .reference return
      mutableReference case .mutableReference return
      arrayIndex case .arrayIndex return
      undefined empty primitiveType cType case ..drop -1 return
    end
  end

  proc( Type : src TypeContext ptr : context -> bool ) =>: export isMultiValueType
    src context unwrapNamed
      ..dup context isComposite if ..drop
        true return
      end
      ..dup context isArray if ..drop
        true return
      end
      ## pointer is only a single value
    ..drop
    false return
  end


  proc( Type : t0 TypeContext ptr : context -> bool ) =>: export isGeneric
    t0 context unwrapNamed =:: t
    t switch
      genericType templateType case true return
      undefined empty primitiveType procedure reference mutableReference cType
      namedType autoType generatedType arrayIndex enum pointer arrayType
        procIn procOut struct union case
         false return
    end
  end
  proc( Type : t0 TypeContext ptr : context -> bool #+has template+# bool #+has static arg+# ) =>: export containsGeneric
    t0 context unwrapNamed =:: t
    t switch
      undefined empty primitiveType autoType arrayIndex cType case
        false false return
      reference mutableReference case
        t context getBaseType context containsGeneric return
      pointer arrayType case
        context [] .arrayTypes t ..dup .pointer ?? if .pointer else .arrayType end list.get =:: arrayType
        arrayType .base context containsGeneric =:: mut isStatic =:: mut isTemplate
        isTemplate isStatic & arrayType .fixedSize ! | if
          isTemplate isStatic return
        end
        0 while ..dup arrayType .dims < do
          context [] .arraySizes arrayType .sizeOffset ..over.2 + list.get .sizeType
            ..dup .staticArg ?? if
              true isStatic =
            end
          .templateArg ?? if
              true isTemplate =
          end
          1 +
        end ..drop
        isTemplate isStatic return
      struct enum union procIn procOut case
        t context compositeData .data [] .flags ..dup COMP_FLAG_TEMPLATE & ? ..swap COMP_FLAG_STATIC_ARGS & ? return
      generatedType case
        false false return ## TODO check if type contains generic
      procedure case
        context [] .procTypes t .procedure list.get
          ..dup .in context containsGeneric =:: isStatic =:: isTemplate
          .out context containsGeneric isStatic | ..swap isTemplate | ..swap return
      namedType case
        t context unwrapNamed context containsGeneric return
      genericType case
        false true return
      templateType case
        true false return
    end
  end

  proc( Type : src bool : mutable TypeContext ptr mut : context -> Type ) =>: export getAddressType
    src context isArray if
      src context unwrapNamed =:: unwraped
      unwraped context getBaseType true unwraped context getArraySize true mutable context newArrayType ..drop return
    end
    src context isProcedure if
      src context asUnlabeledProc ..drop
    else
      src
    end
    true ArraySize array.empty true mutable context newArrayType ..drop return
  end

  proc( Type : src Type : target bool : reshape TypeContext ptr : context -> bool ) =>: sizeCompatible
    using types
    target context isFixedSize ! if
      true return
    end
    src context isFixedSize ! if
      false return
    end
    src context getArraySize =:: srcSize
    target context getArraySize =:: targetSize
    srcSize .length targetSize .length < if srcSize .length else targetSize .length end =:: commonPart
    1 i64 =: mut srcTotal
    1 i64 =: mut targetTotal
    0 while ..dup commonPart < do
      srcSize ..over array.get .sizeType targetSize ..over.2 array.get .sizeType != if ..drop
        false return
      end
      reshape if
        srcSize ..over array.get .sizeType .int ?? if
          srcTotal srcSize ..over array.get .value * srcTotal =
          targetTotal targetSize ..over array.get .value * targetTotal =
        else srcTotal targetTotal != _if ..drop
          false return
        end
        1 + continue
      end
      srcSize ..over array.get .value targetSize ..over.2 array.get .value != if ..drop
        false return
      end
      1 +
    end ..drop
    reshape if ## TODO look at remaining sizes
      srcTotal targetTotal == return
    end
    srcSize .length while ..dup targetSize .length < do
      targetSize ..over array.get .sizeType .int ?? ! targetSize ..over.2 array.get .value 1 != | if ..drop
        false return
      end
      1 +
    end ..drop
    true return
  end
  1i8 =:: NAMED_UNWRAP_SRC
  0i8 =:: NAMED_UNWRAP_NONE
  -1i8 =:: NAMED_UNWRAP_TARGET
  proc( Type : src Type : to TypeContext ptr : context -> bool ) =>: export canAutoCast
    src to context NAMED_UNWRAP_NONE canAutoCast_internal
  end
  proc( Type : src Type : to TypeContext ptr : context i8 : namedDirection -> bool ) =>: canAutoCast_internal
    to =:: mut target
    src target types.typeEquals if
      true return
    end
    ## allow auto-cast from/to direct descendant of named type
    src .namedType ?? if namedDirection NAMED_UNWRAP_TARGET != _if
      src context flatUnwrapNamed target context NAMED_UNWRAP_SRC canAutoCast_internal _if
      true return
    end
    target .namedType ?? if namedDirection NAMED_UNWRAP_SRC != _if
      src target context flatUnwrapNamed context NAMED_UNWRAP_TARGET canAutoCast_internal _if
      true return
    end
    ## convert c-types to types
    target .cType ?? if
      src target .cType cTypeAsType context namedDirection canAutoCast_internal return
    end
    src .cType ?? if
      src .cType cTypeAsType target context namedDirection canAutoCast_internal return
    end
    src context types.isNumber target context types.isNumber & if
      src context types.numberPrecision target context types.numberPrecision <=
      src context types.numberSize target context types.numberSize <= & return
    end
    src context types.isPointer target context types.isPointer & if
    src context types.isMutable target context types.isMutable ! | src context types.getBaseType target context types.getBaseType types.typeEquals & if
      src target false context sizeCompatible return
    end end
    target context types.isUnion if
      target context types.compositeElts =:: elts
      0 while ..dup elts .length < do
        src elts ..over.2 compositeElts.get context types.canAutoCast if ..drop
          true return
        end
        1 +
      end ..drop
    end
    src context types.isReference if src context getBaseType to context canAutoCast _if
      true return
    end
    false return
  end
  proc( Type : a Type : b bool : forceCast TypeContext ptr : context -> bool ) =>: export canCast
    a context types.unwrapNamed =:: mut src
    b context types.unwrapNamed =:: mut target
    src target context canAutoCast if
      true return
    end
    ## converting c-types to types
    target .cType ?? if
      src b .cType cTypeAsType context canAutoCast return
    end
    src .cType ?? if
      src .cType cTypeAsType target context canAutoCast return
    end
    target .arrayIndex ?? if src context types.isInt ! _if
      false return ## can only cast integers to index
    end
    src context types.isNumber target context types.isNumber & if
      true return
    end
    src context types.isPointer target context types.isPointer & if
    src context types.isMutable target context types.isMutable ! | src context types.getBaseType target context types.getBaseType types.typeEquals & if
      src target true context sizeCompatible if
        true return
      end
    end end
    src context types.isReference if src context getBaseType target forceCast context canCast _if
      true return
    end
    forceCast ! if
      false return
    end
    src context types.isPointer target context types.isPointer & if
      true return ## XXX check for compatible element sizes?, compatible mutability
    end
    src context types.isPointer target context types.isInt & if
      true return
    end
    src context types.isInt target context types.isPointer & if
      true return
    end
    false return
  end
  proc( Type : a Type : b TypeContext ptr mut : context -> Type bool ) =>: export mergeTypes
    a b types.typeEquals if
      a false return
    end
    ## merge named types to common content type
    a .namedType ?? if
      a context flatUnwrapNamed b context mergeTypes ! if
        false return
      else ..drop end
    end
    b .namedType ?? if
      a b context flatUnwrapNamed context mergeTypes ! if
        false return
      else ..drop end
    end
    ## unwrap references
    a context types.isReference if
      a context getBaseType b context mergeTypes ! if
        false return
      else ..drop end
    end
    b context types.isReference if
      a b context getBaseType context mergeTypes ! if
        false return
      else ..drop end
    end
    a context types.isNumber b context types.isNumber & if
      a b context commonNumberType return
    end
    a context types.isPointer b context types.isPointer & if
     a context types.getBaseType b context types.getBaseType types.typeEquals _if
      a context types.isMutable b context types.isMutable & =:: mutable
      a context types.getArraySize =:: aSizes
      b context types.getArraySize =:: bSizes
      a context types.isFixedSize b context types.isFixedSize &
        aSizes .length bSizes .length == &
      =:: mut fixedSize
      aSizes .length bSizes .length < if aSizes .length else bSizes .length end =:: s
      0 =:: mut commonPrefix
      while commonPrefix s < do
        aSizes commonPrefix array.get =:: aElt
        bSizes commonPrefix array.get =:: bElt
        aElt .sizeType bElt .sizeType != if
          false fixedSize =
          break
        end
        aElt .value bElt .value != if
          false fixedSize =
          break
        end
        commonPrefix 1 + commonPrefix =
      end
      ## newArrayType
        a context types.getBaseType
        true
        aSizes commonPrefix array.head
        fixedSize
        mutable
        context
      newArrayType return
    end
    a context types.isUnion if b a context canAutoCast _if
      a false return
    end
    b context types.isUnion if a b context canAutoCast _if
      b false return
    end
    Type .undefined true return
  end
end
## type context
struct(
  LabelContext             : mut labelContext
  types.ArrayType     list : mut arrayTypes
  types.ArraySize     list : mut arraySizes
  types.TupleInfo     list : mut tupleTypes
  types.UnionInfo     list : mut unionTypes
  Type                list : mut compositeData
  i64                 list : mut tupleOffsets
  types.ProcType      list : mut procTypes
  types.NamedType     list : mut namedTypes
  types.GeneratedType list : mut generatedTypes
  LabelId             list : mut elementLabels
) =:: export TypeContext
namespace: types
  proc( -> TypeContext ) =>: export newTypeContext
    ## TypeContext
      id.newLabelContext
      128 ArrayType     list.create ## arrayTypes
      128 ArraySize     list.create ## arraySizes
      128 TupleInfo     list.create ## tupleTypes
      128 UnionInfo     list.create ## unionTypes
      128 Type          list.create ## compositeData
      128 i64           list.create ## tupleOffsets
      128 ProcType      list.create ## procTypes
      128 NamedType     list.create ## namedTypes
      128 GeneratedType list.create ## generatedTypes
      128 LabelId       list.create ## elementLabels
    TypeContext new return
  end
  proc( TypeContext : context -> TypeContext ) =>: export freeTypeContent
    context =:: mut cleared
      cleared .labelContext id.freeLabelContext cleared .labelContext =
      cleared .arrayTypes     list.free cleared .arrayTypes =
      cleared .arraySizes     list.free cleared .arraySizes =
      cleared .tupleTypes     list.free cleared .tupleTypes =
      cleared .unionTypes     list.free cleared .unionTypes =
      cleared .compositeData  list.free cleared .compositeData =
      cleared .tupleOffsets   list.free cleared .tupleOffsets =
      cleared .procTypes      list.free cleared .procTypes =
      cleared .namedTypes     list.free cleared .namedTypes =
      cleared .elementLabels  list.free cleared .elementLabels =
    cleared return
  end
end
namespace: sb
  proc( stringBuilder types.PrimitiveType -> stringBuilder ) =>: appendPrimitiveType
    switch
      BOOL case
        "bool" appendS return
      I8 case
        "i8" appendS return
      I16 case
        "i16" appendS return
      I32 case
        "i32" appendS return
      I64 case
        "i64" appendS return
      FLOAT32 case
        "f32" appendS return
      FLOAT64 case
        "f64" appendS return
      TYPE case
        "type" appendS return
    end
  end
  proc( stringBuilder types.CType -> stringBuilder ) =>: appendCType
    switch
      VOID case
        "..ctype.void" appendS return
      BOOL case
        "..ctype.bool" appendS return
      CHAR case
        "..ctype.char" appendS return
      S_CHAR case
        "..ctype.schar" appendS return
      U_CHAR case
        "..ctype.uchar" appendS return
      SHORT case
        "..ctype.short" appendS return
      U_SHORT case
        "..ctype.ushort" appendS return
      INT case
        "..ctype.int" appendS return
      U_INT case
        "..ctype.uint" appendS return
      LONG case
        "..ctype.long" appendS return
      U_LONG case
        "..ctype.ulong" appendS return
      LONGLONG case
        "..ctype.longlong" appendS return
      U_LONGLONG case
        "..ctype.ulonglong" appendS return
      SIZE case
        "..ctype.size" appendS return
      FLOAT case
        "..ctype.float" appendS return
      DOUBLE case
        "..ctype.double" appendS return
    end
  end
  proc( stringBuilder : sb types.ArraySize : size -> stringBuilder  ) =>: export appendArraySize
    sb
      size .sizeType switch
        int case
          ' ' sb.appendC
          size .value sb.appendI
          break
        staticArg case
          " staticArg(" sb.appendS
          size .value sb.appendI
          ")" sb.appendS
          break
        templateArg case
          " templateArg(" sb.appendS
          size .value sb.appendI
          ")" sb.appendS
          break
      end
    return
  end
  proc( stringBuilder : sb types.ArraySize arrayView : sizes -> stringBuilder  ) =>: export appendArraySizes
    sb
      0 while ..dup sizes .length < do
        ..swap
          sizes ..over.2 array.get appendArraySize
        ..swap 1 +
      end ..drop
    return
  end
  proc(
    stringBuilder : sb
    Type : t
    TypeContext ptr : context
    bool : allowRecurse
  -> stringBuilder ) =>: export appendTypeRecursive
    context [] .labelContext @ =:: labelContext
    t switch
      undefined case
        sb "undefined" appendS return
      empty case
        sb "empty" appendS return
      primitiveType case
        sb t .primitiveType appendPrimitiveType return
      cType case
        sb t .cType appendCType return
      arrayIndex case
        t .arrayIndex =:: sizeIndex
        sb
          "index(" appendS
          context [] .arraySizes sizeIndex list.get appendArraySize
          " )" appendS
        return
      pointer case
        sb
          ## appendTypeRecursive
            t context types.getBaseType
            context
            allowRecurse
          appendTypeRecursive
          t context types.getArraySize appendArraySizes
          t context types.isFixedSize if
            " ptr" appendS
          else
            " _ ptr" appendS
          end
          t context types.isMutable if
            " mut" appendS
          end
        return
      arrayType case
        sb
          ## appendTypeRecursive
            t context types.getBaseType
            context
            allowRecurse
          appendTypeRecursive
          t context types.getArraySize appendArraySizes
          " array" appendS
        return
      struct enum union case
        sb
          t .struct ?? if
            "struct[" appendS
          else t .union ?? _if
            "union[" appendS
          else
            "enum[" appendS
          end
          t types.getTypeId appendI
          "]( "    appendS
          allowRecurse if
            t context appendComposite
          else
            "... " appendS
          end
         ")" appendS
       return
      procIn case
        sb t context appendComposite return
      procOut case
        sb t context appendComposite return
      procedure case
        sb
          "proc["      appendS
          t .procedure appendI
          "]( "        appendS
          allowRecurse if
            context [] .procTypes t .procedure list.get =:: procType
            procType .in context allowRecurse appendTypeRecursive
            "-> " appendS
            procType .out context allowRecurse appendTypeRecursive
          else
            "... " appendS
          end
          ")" appendS
        return
      namedType case
        sb
          "named[" appendS
          t .namedType    appendI
          "]( "    appendS
          ## appendNamedType
            context [] .namedTypes t .namedType list.get
            context
            allowRecurse
          appendNamedType
        " )" appendS
        return
      autoType case
        sb
          "auto["     appendS
          t .autoType appendI
          "]"         appendS
        return
      genericType case
        t .genericType =:: labelId
        sb
          _EXPERIMENTAL_ if
            labelId labelContext appendLabelName
            "[generic " appendS
          else
            "generic[" appendS
          end
          labelId  appendI
          "]"  appendS
        return
      templateType case
        sb
          "template["     appendS
          t .templateType appendI
          "]"             appendS
        return
      generatedType case
        t .generatedType
        context [] .generatedTypes ..swap list.at .data =:: typeData
        sb
          "? " appendS ## TODO append arguments
          typeData [] .generator labelContext sb.appendLabelName
          allowRecurse if
            " [ "     appendS
              typeData [] .generated context allowRecurse appendTypeRecursive
            " ]"     appendS
          end
        return
      reference case
        sb
          ## appendTypeRecursive
            context [] .compositeData t .reference list.get
            context
            allowRecurse
          appendTypeRecursive
        " reference" appendS
        return
      mutableReference case
        sb
          ## appendTypeRecursive
            context [] .compositeData t .mutableReference list.get
            context
            allowRecurse
          appendTypeRecursive
        " reference mut" appendS
        return
    end
  end
  proc( stringBuilder Type TypeContext ptr -> stringBuilder ) =>: export appendType
    true appendTypeRecursive return
  end
end
