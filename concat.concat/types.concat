    srcSize #over array.get .sizeType targetSize #over:2 array.get .sizeType != if #drop
      false return
    end
    reshape if
      srcSize #over array.get .sizeType .int ?? if
        srcTotal srcSize #over array.get .value * srcTotal =
        targetTotal targetSize #over array.get .value * targetTotal =
      else srcTotal targetTotal != _if #drop
        false return
      end
      1 + continue
    end
    srcSize #over array.get .value targetSize #over:2 array.get .value != if #drop
      false return
    end
    1 +
  end #drop
  reshape if ## TODO look at remaining sizes
    srcTotal targetTotal == return
  end
  srcSize .length while #dup targetSize .length < do
    targetSize #over array.get .sizeType .int ?? ! targetSize #over:2 array.get .value 1 != | if #drop
      false return
    end
    1 +
  end #drop
  true return
end
1i8 =:: NAMED_UNWRAP_SRC
0i8 =:: NAMED_UNWRAP_NONE
-1i8 =:: NAMED_UNWRAP_TARGET
proc( Type : src Type : to TypeContext ptr : context => bool ) =: public canAutoCast
  src to context NAMED_UNWRAP_NONE canAutoCast_internal
end
proc( Type : src Type : to TypeContext ptr : context i8 : namedDirection => bool ) =: canAutoCast_internal
  to =:: mut target
  src target types.typeEquals if
    true return
  end
  ## allow auto-cast from/to direct descendant of named type
  src .namedType ?? if namedDirection NAMED_UNWRAP_TARGET != _if
    src context flatUnwrapNamed target context NAMED_UNWRAP_SRC canAutoCast_internal _if
    true return
  end
  target .namedType ?? if namedDirection NAMED_UNWRAP_SRC != _if
    src target context flatUnwrapNamed context NAMED_UNWRAP_TARGET canAutoCast_internal _if
    true return
  end
  ## convert c-types to types
  target .cType ?? if
    src target .cType cTypeAsType context namedDirection canAutoCast_internal return
  end
  src .cType ?? if
    src .cType cTypeAsType target context namedDirection canAutoCast_internal return
  end
  src context types.isNumber target context types.isNumber & if
    src context types.numberPrecision target context types.numberPrecision <=
    src context types.numberSize target context types.numberSize <= & return
  end
  src context types.isPointer src context types.isArray | target context types.isPointer & if
  src context types.isMutable target context types.isMutable ! | src context types.getBaseType target context types.getBaseType types.typeEquals & if
    src target false context sizeCompatible return
  end end
  target context types.isUnion if
    target context types.compositeElts =:: elts
    0 while #dup elts .length < do
      src elts #over:2 compositeElts.get context types.canAutoCast if #drop
        true return
      end
      1 +
    end #drop
  end
  src context types.isReference if src context getBaseType to context canAutoCast _if
    true return
  end
  false return
end
proc( Type : a Type : b bool : forceCast TypeContext ptr : context => bool ) =: public canCast
  a context types.unwrapNamed =:: mut src
  b context types.unwrapNamed =:: mut target
  src target context canAutoCast if
    true return
  end
  ## converting c-types to types
  target .cType ?? if
    src b .cType cTypeAsType context canAutoCast return
  end
  src .cType ?? if
    src .cType cTypeAsType target context canAutoCast return
  end
  target .arrayIndex ?? if src context types.isInt ! _if
    false return ## can only cast integers to index
  end
  src context types.isNumber target context types.isNumber & if
    true return
  end
  src context types.isPointer src context types.isArray | target context types.isPointer & if
  src context types.isMutable target context types.isMutable ! | src context types.getBaseType target context types.getBaseType types.typeEquals & if
    src target true context sizeCompatible if
      true return
    end
  end end
  src context types.isReference if src context getBaseType target forceCast context canCast _if
    true return
  end
  forceCast ! if
    false return
  end
  src context types.isPointer target context types.isPointer & if
    true return ## XXX check for compatible element sizes?, compatible mutability
  end
  src context types.isPointer target context types.isInt & if
    true return
  end
  src context types.isInt target context types.isPointer & if
    true return
  end
  false return
end
#end
## type context
struct(
  types.ArrayType     list : mut arrayTypes
  types.ArraySize     list : mut arraySizes
  types.TupleInfo     list : mut tupleTypes
  types.UnionInfo     list : mut unionTypes
  Type                list : mut compositeData
  i64                 list : mut tupleOffsets
  types.ProcType      list : mut procTypes
  types.NamedType     list : mut namedTypes
  types.GeneratedType list : mut generatedTypes
  LabelId             list : mut elementLabels
) TypeContext =
#namespace types
proc( => TypeContext ) =: public newTypeContext
  128 ArrayType     list.create ## arrayTypes
  128 ArraySize     list.create ## arraySizes
  128 TupleInfo     list.create ## tupleTypes
  128 UnionInfo     list.create ## unionTypes
  128 Type          list.create ## compositeData
  128 i64           list.create ## tupleOffsets
  128 ProcType      list.create ## procTypes
  128 NamedType     list.create ## namedTypes
  128 GeneratedType list.create ## generatedTypes
  128 LabelId       list.create ## elementLabels
  TypeContext new return
end
proc( TypeContext : context => TypeContext ) =: public clearTypeContent
  context
    #dup .arrayTypes     list.free #over .arrayTypes =
    #dup .arraySizes     list.free #over .arraySizes =
    #dup .tupleTypes     list.free #over .tupleTypes =
    #dup .unionTypes     list.free #over .unionTypes =
    #dup .compositeData  list.free #over .compositeData =
    #dup .tupleOffsets   list.free #over .tupleOffsets =
    #dup .procTypes      list.free #over .procTypes =
    #dup .namedTypes     list.free #over .namedTypes =
    #dup .elementLabels  list.free #over .elementLabels =
  return
end
#end
#namespace sb
proc( stringBuilder types.PrimitiveType => stringBuilder ) =: appendPrimitiveType
  switch
    BOOL case
      "bool" appendS return
    I8 case
      "i8" appendS return
    I16 case
      "i16" appendS return
    I32 case
      "i32" appendS return
    I64 case
      "i64" appendS return
    FLOAT32 case
      "float" appendS return
    FLOAT64 case
      "double" appendS return
    TYPE case
      "type" appendS return
  end
end
proc( stringBuilder types.CType => stringBuilder ) =: appendCType
  switch
    VOID case
      "..ctype.void" appendS return
    BOOL case
      "..ctype.bool" appendS return
    CHAR case
      "..ctype.char" appendS return
    S_CHAR case
      "..ctype.schar" appendS return
    U_CHAR case
      "..ctype.uchar" appendS return
    SHORT case
      "..ctype.short" appendS return
    U_SHORT case
      "..ctype.ushort" appendS return
    INT case
      "..ctype.int" appendS return
    U_INT case
      "..ctype.uint" appendS return
    LONG case
      "..ctype.long" appendS return
    U_LONG case
      "..ctype.ulong" appendS return
    LONGLONG case
      "..ctype.longlong" appendS return
    U_LONGLONG case
      "..ctype.ulonglong" appendS return
    SIZE case
      "..ctype.size" appendS return
    FLOAT case
      "..ctype.float" appendS return
    DOUBLE case
      "..ctype.double" appendS return
  end
end
proc( stringBuilder : sb types.ArraySize arrayView : sizes => stringBuilder  ) =: public appendArraySize
  sb
    0 while #dup sizes .length < do
      #swap
        sizes #over:2 array.at .data =:: s
        s [] .sizeType switch
          int case
            ' ' sb.appendC
            s [] .value sb.appendI
            break
          staticArg case
            " staticArg(" sb.appendS
            s [] .value sb.appendI
            ")" sb.appendS
            break
          templateArg case
            " templateArg(" sb.appendS
            s [] .value sb.appendI
            ")" sb.appendS
            break
        end
      #swap 1 +
    end #drop
  return
end
proc( stringBuilder Type LabelContext ptr TypeContext ptr bool => stringBuilder ) =: public appendTypeRecursive
  =:: allowRecurse
  =:: context
  =:: labelContext
  #dup switch
    undefined case #drop
      "undefined" appendS return
    empty case #drop
      "empty" appendS return
    primitiveType case
      .primitiveType appendPrimitiveType return
    cType case
      .cType appendCType return
    arrayIndex case .arrayIndex =:: sizeIndex
      "index(" appendS
      context [] .arraySizes sizeIndex list.at .data array.wrap appendArraySize
      " )" appendS
      return
    pointer case =:: t
      t context types.getBaseType labelContext context allowRecurse appendTypeRecursive
      t context types.getArraySize appendArraySize
      t context types.isFixedSize if
        " ptr" appendS
      else
        " _ ptr" appendS
      end
      t context types.isMutable if
        " mut" appendS
      end
      return
    arrayType case =:: t
      t context types.getBaseType labelContext context allowRecurse appendTypeRecursive
      t context types.getArraySize appendArraySize
      " array" appendS return
    struct enum union case =:: data
      data .struct ?? if
        "struct[" appendS
      else data .union ?? _if
        "union[" appendS
      else
        "enum[" appendS
      end
      data types.getTypeId appendI
      "]( "    appendS
      allowRecurse if
        data labelContext context appendComposite
      else
        "... " appendS
      end
     ")" appendS
     return
    procIn case
      labelContext context appendComposite return
    procOut case
      labelContext context appendComposite return
    procedure case
      .procedure
      #swap
        "proc[" appendS
        #over    appendI
        "]( "    appendS
      #swap
        allowRecurse if
          context [] .procTypes #swap list.get #swap
          #over .in labelContext context allowRecurse appendTypeRecursive
          "=> " appendS
          #swap .out labelContext context allowRecurse appendTypeRecursive
        else #drop
          "... " appendS
        end
       ")" appendS
       return
    namedType case
      .namedType
      #swap
        "named[" appendS
        #over    appendI
        "]( "    appendS
      #swap
      context [] .namedTypes #swap list.get labelContext context allowRecurse appendNamedType
      " )" appendS
      return
    autoType case
      #swap "auto["     appendS
        #swap .autoType appendI
                "]"     appendS
      return
    genericType case
      #swap "generic["     appendS
        #swap .genericType appendI
                   "]"     appendS
      return
    templateType case
      #swap "template["     appendS
        #swap .templateType appendI
                    "]"     appendS
      return
    generatedType case
      .generatedType
      context [] .generatedTypes #swap list.at .data =:: typeData
      "? " appendS ## TODO append arguments
      typeData [] .generator labelContext sb.appendLabelName
      " [ "     appendS
        typeData [] .generated labelContext context allowRecurse appendTypeRecursive
      " ]"     appendS
      return
    reference case
      context [] .compositeData #swap .reference list.get labelContext context allowRecurse appendTypeRecursive
      " reference" appendS
      return
    mutableReference case
      context [] .compositeData #swap .mutableReference list.get labelContext context allowRecurse appendTypeRecursive
      " reference mut" appendS
      return
  end
end
proc( stringBuilder Type LabelContext ptr TypeContext ptr => stringBuilder ) =: public appendType
  true appendTypeRecursive return
end
#end
