import list
import arrayView
import string
import stringBuilder

import "labels.concat"
import "constants.concat"


namespace: types
  enum( BOOL I8 I16 I32 I64 FLOAT32 FLOAT64 TYPE ) =:: PrimitiveType
  i32 =:: ArrayId
  i32 =:: export TupleId ## exported for access from identifiers.concat
  i32 =:: export UnionId
  i32 =:: EnumId
  i32 =:: ProcId
  i32 =:: NamedTypeId
  i32 =:: GeneratedId
  i32 =:: ReferenceId
  i32 =:: SizeId
  ## primitive C-types for C interoperability
  enum(
    VOID BOOL
    CHAR S_CHAR U_CHAR
    SHORT U_SHORT
    INT U_INT
    LONG LONGLONG U_LONG U_LONGLONG SIZE
    FLOAT DOUBLE
    ## XXX? add support for long double
  ) =:: CType
end

enum(
                        undefined
                        empty
  types.PrimitiveType : primitiveType
        types.ArrayId : pointer
        types.ArrayId : arrayType
        types.TupleId : struct
        types.UnionId : union
        types.TupleId : procIn
        types.TupleId : procOut
        types.UnionId : enum
         types.ProcId : procedure
    types.NamedTypeId : namedType
    types.ReferenceId : reference
    types.ReferenceId : mutableReference
                  i32 : autoType
                  i32 : genericType
                  i32 : templateType
    types.GeneratedId : generatedType
         types.SizeId : arrayIndex
          types.CType : cType
) =:: export Type

namespace: types
  proc( Type : a Type : b -> bool ) =>: export typeEquals
    a b != if
      false return
    end
    a switch
      undefined empty case
        true return ## there is only one undefined/empty type
      primitiveType case
        a .primitiveType b .primitiveType == return
      pointer case
        a .pointer b .pointer == return
      arrayType case
        a .arrayType b .arrayType == return
      struct case
        a .struct b .struct == return
      procIn case
        a .procIn b .procIn == return
      procOut case
        a .procOut b .procOut == return
      enum case
        a .enum b .enum == return
      union case
        a .union b .union == return
      procedure case
        a .procedure b .procedure == return
      namedType case
        a .namedType b .namedType == return
      autoType case
        a .autoType b .autoType == return
      genericType case
        a .genericType b .genericType == return
      templateType case
        a .templateType b .templateType == return
      generatedType case
        a .generatedType b .generatedType == return
      reference case
        a .reference b .reference == return
      mutableReference case
        a .mutableReference b .mutableReference == return
      arrayIndex case
        a .arrayIndex b .arrayIndex == return
      cType case
        a .cType b .cType == return
    end
  end
  1011001 =:: bigPrime
  proc( PrimitiveType -> i32 ) =>: primitiveId
    switch
      BOOL case 1 return
      I8 case 2 return
      I16 case 3 return
      I32 case 4 return
      I64 case 5 return
      FLOAT32 case 6 return
      FLOAT64 case 7 return
      TYPE case 8 return
    end
  end
  proc( CType -> i32 ) =>: cTypeId
    switch
      VOID case 0 return
      BOOL case 1 return
      CHAR case 2 return
      S_CHAR case 3 return
      U_CHAR case 4 return
      SHORT  case 5 return
      U_SHORT case 6 return
      INT case 7 return
      U_INT case 8 return
      LONG  case 9 return
      LONGLONG  case 10 return
      U_LONG  case 11 return
      U_LONGLONG  case 12 return
      SIZE case 13 return
      FLOAT case 14 return
      DOUBLE case 15 return
    end
  end
  proc( Type : a -> i32 ) =>: export typeHash
    a switch
      undefined case
        0 return ## there is only one undefined
      empty case
        1 return ## there is only one empty type
      primitiveType case
        bigPrime 2 * a .primitiveType primitiveId + return
      pointer case
        bigPrime 3 * a .pointer + return
      arrayType case
        bigPrime 5 * a .arrayType + return
      struct case
        bigPrime 7 * a .struct + return
      procIn case
        bigPrime 11 * a .procIn + return
      procOut case
        bigPrime 13 * a .procOut + return
      enum case
        bigPrime 17 * a .enum + return
      union case
        bigPrime 19 * a .union + return
      procedure case
        bigPrime 23 * a .procedure + return
      namedType case
        bigPrime 29 * a .namedType + return
      autoType case
        bigPrime 31 * a .autoType + return
      genericType case
        bigPrime 37 * a .genericType + return
      templateType case
        bigPrime 41 * a .templateType + return
      generatedType case
        bigPrime 43 * a .generatedType + return
      reference case
        bigPrime 47 * a .reference + return
      mutableReference case
        bigPrime 53 * a .mutableReference + return
      arrayIndex case
        bigPrime 59 * a .arrayIndex + return
      cType case
        bigPrime 61 * a .cType cTypeId + return
    end
  end
end

type : export TypeContext
namespace: types
  ## primitive types
  namespace: primitive
    PrimitiveType .BOOL      Type .primitiveType Type =: export BOOL
    PrimitiveType .I8        Type .primitiveType Type =: export I8
    PrimitiveType .I16       Type .primitiveType Type =: export I16
    PrimitiveType .I32       Type .primitiveType Type =: export I32
    PrimitiveType .I64       Type .primitiveType Type =: export I64
    PrimitiveType .FLOAT32   Type .primitiveType Type =: export FLOAT32
    PrimitiveType .FLOAT64   Type .primitiveType Type =: export FLOAT64
    PrimitiveType .TYPE      Type .primitiveType Type =: export TYPE
    ## compiler internal type-aliases for special purpose types
    PrimitiveType .I64       Type .primitiveType Type =: export I_SIZE ## size-off memory-sections
    PrimitiveType .I64       Type .primitiveType Type =: export I_PTR  ## integer that can hold a pointer
  end
  proc( Type -> bool ) =>: export isPrimitive
    .primitiveType ?? return
  end
  proc( Type : t TypeContext ptr : context -> PrimitiveType ) =>: export primitiveValue
    t context unwrapNamed
      ..dup .arrayIndex ?? if ..drop
        primitive.I_SIZE .primitiveType return
      end
    .primitiveType return
  end
  proc( Type : t0 TypeContext ptr : context -> bool ) =>: export isEmpty ## TODO? should pointer to empty be empty
    t0 context unwrapNamed =:: t
    t switch
       empty case true return
       arrayType reference mutableReference case
         ## arrays/reference of empty values are empty
         t context getBaseType context isEmpty return
       undefined primitiveType procedure cType pointer
         namedType autoType genericType templateType
         generatedType arrayIndex enum case false return
       procIn procOut struct union case
         t context compositeFlags COMP_FLAG_EMPTY & ? return
    end
  end

  proc( Type TypeContext ptr -> bool ) =>: export isBoolean
    unwrapNamed
      ..dup isPrimitive ! if ..drop
        false return
      end .primitiveType
      .BOOL ?? return
  end
  proc( Type TypeContext ptr -> bool ) =>: export isInt
    unwrapNamed
      ..dup .arrayIndex ?? if ..drop
        true return
      end
      ..dup isPrimitive ! if ..drop
        false return
      end .primitiveType
      switch
        BOOL FLOAT32 FLOAT64 TYPE case
          false return
        I8 I16 I32 I64 case
          true return
      end
  end
  proc( Type TypeContext ptr -> bool ) =>: export isFloat
    unwrapNamed
      ..dup isPrimitive ! if ..drop
        false return
      end .primitiveType
      switch
        BOOL I8 I16 I32 I64 TYPE case
          false return
        FLOAT32 FLOAT64 case
          true return
      end
  end
  proc( Type TypeContext ptr -> bool ) =>: export isNumber
    unwrapNamed
      ..dup .arrayIndex ?? if ..drop
        true return
      end
      ..dup isPrimitive ! if ..drop
        false return
      end .primitiveType
      switch
        BOOL TYPE case
          false return
        I8 I16 I32 I64 FLOAT32 FLOAT64 case
          true return
      end
  end
  proc( Type TypeContext ptr -> bool ) =>: export isSmallType
    unwrapNamed
    switch
      primitiveType pointer empty reference mutableReference
        arrayIndex enum cType case true return
      ## TODO only union with no values is small
      arrayType struct union procIn procOut procedure ## TODO? count structs/unions with size < 128 as small types
      undefined namedType autoType genericType templateType generatedType case false return
    end
  end
  proc( Type TypeContext ptr -> i32 ) =>: export numberPrecision
    unwrapNamed
      ..dup .arrayIndex ?? if ..drop
        primitive.I_SIZE
      else ..dup isPrimitive ! _if ..drop
        -1 return
      end .primitiveType
      switch
        BOOL TYPE case
          -1 return
        I8 case
          7 return
        I16 case
          15 return
        I32 case
          31 return
        I64 case
          63 return
        FLOAT32 case
          24 return ## IEEE binary-32
        FLOAT64 case
          53 return ## IEEE binary-64
      end
  end
  64 =:: export MAX_INT_WIDTH
  #+largest integer n s.t. 2^n-1 fits in the type+#
  proc( Type TypeContext ptr -> i32 ) =>: export numberSize
    unwrapNamed
      ..dup .arrayIndex ?? if ..drop
        primitive.I_SIZE
      else ..dup isPrimitive ! _if ..drop
        -1 return
      end .primitiveType
      switch
        BOOL TYPE case
          -1 return
        I8 case
          7 return
        I16 case
          15 return
        I32 case
          31 return
        I64 case
          63 return
        FLOAT32 case
          127 return ## IEEE binary-32
        FLOAT64 case
          1023 return ## IEEE binary-64
      end
  end
  proc( i32 : size i32 : precission -> Type bool ) =>: findNumberType
    size 7 <= precission 7 <= & if
      primitive.I8 false return
    end
    size 15 <= precission 15 <= & if
      primitive.I16 false return
    end
    size 31 <= precission 31 <= & if
      primitive.I32 false return
    end
    size 63 <= precission 63 <= & if
      primitive.I64 false return
    end
    size 127 <= precission 24 <= & if
      primitive.FLOAT32 false return
    end
    size 1023 <= precission 53 <= & if
      primitive.FLOAT64 false return
    end
    Type .undefined true return
  end
  proc( Type : a Type : b TypeContext ptr : context -> Type bool ) =>: export commonIntType
    a context types.isInt ! b context types.isInt ! | if
      Type .undefined true return
    end
    a context numberPrecision b context numberPrecision < if
      b false return
    else
      a false return
    end
  end
  proc( Type : a Type : b TypeContext ptr : context -> Type bool ) =>: export commonNumberType
    a context types.isNumber ! b context types.isNumber ! | if
      Type .undefined true return
    end
    a context types.numberPrecision b context types.numberPrecision
      ..over ..over < if ..swap end ..drop
    =:: minPrecision
    a context types.numberSize b context types.numberSize
      ..over ..over < if ..swap end ..drop
    =:: minSize
    minSize minPrecision findNumberType return
  end
  ## ctypes
  namespace: ctype
    CType .VOID        Type .cType Type =: export VOID
    CType .BOOL        Type .cType Type =: export BOOL
    CType .CHAR        Type .cType Type =: export CHAR
    CType .S_CHAR      Type .cType Type =: export S_CHAR
    CType .U_CHAR      Type .cType Type =: export U_CHAR
    CType .SHORT       Type .cType Type =: export SHORT
    CType .U_SHORT     Type .cType Type =: export U_SHORT
    CType .INT         Type .cType Type =: export INT
    CType .U_INT       Type .cType Type =: export U_INT
    CType .LONG        Type .cType Type =: export LONG
    CType .U_LONG      Type .cType Type =: export U_LONG
    CType .LONGLONG    Type .cType Type =: export LONGLONG
    CType .U_LONGLONG  Type .cType Type =: export U_LONGLONG
    CType .SIZE        Type .cType Type =: export SIZE
    CType .FLOAT       Type .cType Type =: export FLOAT
    CType .DOUBLE      Type .cType Type =: export DOUBLE
  end
  proc( CType -> Type ) =>: export cTypeAsType
    switch
      VOID case Type .empty return
      BOOL case primitive.BOOL return
      CHAR S_CHAR U_CHAR case primitive.I8 return
      SHORT U_SHORT case primitive.I16 return
      INT U_INT case primitive.I32 return
      LONG U_LONG LONGLONG U_LONGLONG SIZE case primitive.I64 return
      FLOAT case primitive.FLOAT32 return
      DOUBLE case primitive.FLOAT64 return
    end
  end

  ## size and alignment
  proc( PrimitiveType -> i32 ) =>: sizeOfPrimitive
    switch
      TYPE case
        0 return
      BOOL I8 case
        1 return
      I16 case
        2 return
      I32 FLOAT32 case
        4 return
      I64 FLOAT64 case
        8 return
    end
  end
  proc( CType -> i32 ) =>: sizeOfCType
    switch ## sizes for linux-x86-gcc
      VOID case 0 return
      BOOL CHAR S_CHAR U_CHAR case 1 return
      SHORT U_SHORT case 2 return
      INT U_INT case 4 return
      LONG LONGLONG U_LONG U_LONGLONG SIZE case 8 return
      FLOAT case 4 return
      DOUBLE case 8 return
    end
  end
  8 =:: PTR_SIZE
  8 =:: PTR_ALIGN
  8 =:: I_SIZE_SIZE
  8 =:: I_SIZE_ALIGN
  ## alignment of type in bytes, will be a power of two
  proc( Type : t TypeContext ptr : context -> i64 ) =>: export alignOf
    t switch
      undefined empty autoType genericType templateType case
        0 return
      primitiveType case
        t .primitiveType sizeOfPrimitive return
      cType case
        t .cType sizeOfCType return
      arrayIndex case
        I_SIZE_SIZE return
      pointer reference mutableReference procedure case
        PTR_SIZE return
      arrayType case
        t context getBaseType context alignOf return
      struct enum union procIn procOut case
        t context compositeData .data =:: compData
        compData [] .alignment return
      namedType case
        t context unwrapNamed context alignOf return
      generatedType case
        t context getGeneratedType context alignOf return
    end
  end
  ## return next multiple of a >= s, assumes that a is a power of 2
  proc( i64 : s i64 : a -> i64 ) =>: alignSize
    s
      a 1 - +
      a 1 - ~ &
    return
  end
  proc( Type : t bool : aligned TypeContext ptr : context -> i64 ) =>: computeSize
    t switch
      empty undefined autoType genericType templateType case
        0 return
      primitiveType case
        t .primitiveType sizeOfPrimitive return
      cType case
        t .cType sizeOfCType return
      arrayIndex case
        I_SIZE_SIZE return
      pointer reference mutableReference procedure case
        PTR_SIZE return
      arrayType case
        t context getArraySize =:: dims
        t context getBaseType context strideOf =:: mut size
        0 while ..dup dims .length < do
          dims ..over array.get =:: dim
          dim .sizeType .int ?? if
            size dim .value * size =
          else ..drop
            0 return ## XXX? better result for dynamic size arrays
          end
          1 +
        end ..drop
        size return
      struct enum union procIn procOut case
        t context compositeData .data =:: compData
        compData [] .size
          aligned if
            compData [] .alignment alignSize
          end
        return
      namedType case
        t context unwrapNamed aligned context computeSize return
      generatedType case
        t context getGeneratedType aligned context computeSize return
    end
  end
  ## size of value in bytes
  proc( Type : t TypeContext ptr : context -> i64 ) =>: export sizeOf
    t false context computeSize ## TODO dependent on backend: C:aligned=true, QBE/ASM:aligned=false
  end
  ## size padded to next multiple of alignment
  proc( Type : t TypeContext ptr : context -> i64 ) =>: export strideOf
    t true context computeSize
  end
  ## array & pointer types
  enum( int templateArg staticArg ) =:: export ArraySizeType
  struct( i64 : value ArraySizeType : sizeType ) =:: export ArraySize
  struct( Type : base i64 : sizeOffset i64 : dims bool : fixedSize bool : mut ptrOnly bool : mutable ) =:: ArrayType

  proc( Type TypeContext ptr -> bool ) =>: export isPointer
    unwrapNamed .pointer ?? return
  end
  proc( Type TypeContext ptr -> bool ) =>: export isArray
    unwrapNamed .arrayType ?? return
  end
  proc( Type TypeContext ptr -> bool ) =>: export isReference
    unwrapNamed
    ..dup .reference ?? ..swap .mutableReference ?? | return
  end
  proc(
    Type : box
    TypeContext ptr : context
  -> Type ) =>: export unwrapReference
    box context isReference ! if
      box return
    end
    box
      ..dup .reference ?? if
        context [] .compositeData
          ..swap .reference
        list.get return
      end
      ..dup .mutableReference ?? if
        context [] .compositeData
          ..swap .mutableReference
        list.get return
      end
    ..unreachable
  end
  proc( Type TypeContext ptr -> bool ) =>: export isFixedSize
    =:: context
    context unwrapNamed
    ..dup .pointer ?? if
      context [] .arrayTypes ..swap .pointer list.get .fixedSize return
    end
    ..dup .arrayType ?? if
      context [] .arrayTypes ..swap .arrayType list.get .fixedSize return
    end ..drop
    false return
  end
  proc( Type TypeContext ptr -> bool ) =>: export isFixedSizePtr
    =:: context
    context unwrapNamed
    ..dup .pointer ?? if
      context [] .arrayTypes ..swap .pointer list.get .fixedSize return
    end ..drop
    false return
  end
  proc( Type TypeContext ptr -> bool ) =>: export isRawPointer
    =:: context
    context unwrapNamed
    ..dup .pointer ?? if
      context [] .arrayTypes ..swap .pointer list.get .fixedSize ! return
    end ..drop
    false return
  end
  proc( Type : box TypeContext ptr : context -> Type ) =>: export getBaseType
    box context unwrapNamed
      ..dup context isPointer if
        context [] .arrayTypes ..swap .pointer list.get .base return
      end
      ..dup context isArray if
        context [] .arrayTypes ..swap .arrayType list.get .base return
      end
      ..dup .reference ?? if
        context [] .compositeData ..swap .reference list.get return
      end
      ..dup .mutableReference ?? if
        context [] .compositeData ..swap .mutableReference list.get return
      end
    ..drop
    Type .undefined return
  end
  proc( Type : box TypeContext ptr : context -> i64 ) =>: export getArrayDims
    box context unwrapNamed
      ..dup context isPointer if
        context [] .arrayTypes ..swap .pointer list.get =:: arrayType
        arrayType .dims
          arrayType .fixedSize ! if 1 + end
        return
      end
      ..dup context isArray if
        context [] .arrayTypes ..swap .arrayType list.get =:: arrayType
        arrayType .dims
          arrayType .fixedSize ! if 1 + end
        return
      end
    ..drop
    0 return
  end
  proc( Type : box TypeContext ptr : context -> ArraySize arrayView ) =>: export getArraySize
    box context unwrapNamed
      ..dup context isPointer if
        context [] .arrayTypes ..swap .pointer list.get =:: arrayType
        context [] .arraySizes arrayType .sizeOffset arrayType .dims list.slice return
      end
      ..dup context isArray if
        context [] .arrayTypes ..swap .arrayType list.get =:: arrayType
        context [] .arraySizes arrayType .sizeOffset arrayType .dims list.slice return
      end
      ..dup .arrayIndex ?? if
        context [] .arraySizes ..swap .arrayIndex list.at .data array.wrap return
      end
    ..drop
    ArraySize array.empty return
  end
  ## type of the n-th array index (counted from left to right, zero indexed)
  ## the returned bool is true if no index has been found
  proc( Type : box i32 : n TypeContext ptr : context -> Type bool ) =>: export getIndexType
    n 0 < if
      Type .undefined true return
    end
    box context unwrapNamed
      ..dup context isPointer if
        context [] .arrayTypes ..swap .pointer list.get
      else ..dup context isArray _if
        context [] .arrayTypes ..swap .arrayType list.get
      else ..drop
       Type .undefined true return
      end
    =:: arrayType
    arrayType .fixedSize ! if
      n 0 == if
        primitive.I_SIZE false return
      end
      n
    else
      n 1 +
    end =:: delta
    delta arrayType .dims > if
       Type .undefined true return
    end
    arrayType .sizeOffset arrayType .dims + delta - types.SizeId cast Type .arrayIndex false return
  end

  proc( Type TypeContext ptr -> bool ) =>: export isMutable
    =:: context
    context unwrapNamed
      ..dup context isPointer if
        context [] .arrayTypes ..swap .pointer list.get .mutable return
      end
    .mutableReference ?? return
  end
  proc( Type ptr mut : t bool : mutable TypeContext ptr mut : context -> bool ) =>: export setMutability
    t [] context isMutable  mutable == if
      false return
    end
    t [] .pointer ?? if
      context [] .arrayTypes t [] .pointer list.get =:: arrayType
      ## newArrayType
        t [] context getBaseType
        true
        arrayType .fixedSize if
          context [] .arraySizes arrayType .sizeOffset arrayType .dims list.slice
          true
        else
          ArraySize array.empty
          false
        end
        mutable
      context newArrayType if
        ..drop true return
      end t [] =
      false return
    end
    ## XXX ? allow marking named pointer types as mutable
    true return
  end
  proc( ArraySize arrayView : a ArraySize arrayView : b -> bool ) =>: arraySizeEqual
    a .length b .length != if
      false return
    end
    0 while ..dup a .length < do
      a ..over array.get .sizeType b ..over.2 array.get .sizeType != if
        ..drop false return
      end
      a ..over array.get .value b ..over.2 array.get .value != if
        ..drop false return
      end
      1 +
    end ..drop
    true return
  end
  proc(
    Type : target
    bool : isPtr
    ArraySize arrayView : sizes
    bool : fixedSize
    bool : makeMutable
    TypeContext ptr mut : context
  -> Type bool ) =>: export newArrayType
    context [] .labelContext @ =:: labelContext
    isPtr if makeMutable else false end =:: mutable
    target =:: mut base
    base .undefined ?? if
      Type .undefined true return
    end
    ## procedure types are only allowed as base for fixed-size 0 dimensional pointers
    base context isProcedure if
      isPtr ! sizes .length 0 > | if
        Type .undefined true return
      end
      base
        context asUnlabeledProc if ..drop
          Type .undefined true return
        end
      base =
    end
    context [] .arrayTypes @ =:: arrays
    0 while ..dup arrays [] .length < do
      arrays [] ..over list.get
        ..dup .mutable   mutable   != if ..drop
          1 + continue
        end
        ..dup .fixedSize fixedSize != if ..drop
          1 + continue
        end
        fixedSize if ..dup .dims sizes .length != if ..drop
          1 + continue
        end end
        ..dup .base base typeEquals ! if ..drop
          1 + continue
        end
        context [] .arraySizes ..over .sizeOffset ..over.2 .dims list.slice sizes arraySizeEqual ! if ..drop
          1 + continue
        end
      .ptrOnly isPtr & arrays [] ..over.2 list.at .data [] .ptrOnly = ## update ptrOnly flag
      ## found match
      isPtr if ArrayId cast Type .pointer else ArrayId cast Type .arrayType end false return
    end ..drop
    context [] .arraySizes
      ..dup .length =:: sizeOffset
      sizes list.appendArray
    context [] .arraySizes =
    arrays []
      base sizeOffset sizes .length fixedSize isPtr mutable ArrayType new list.append
    arrays [] =
    arrays [] .length 1 - isPtr if ArrayId cast Type .pointer else ArrayId cast Type .arrayType end
    false return
  end

  ## XXX flags are exported for access from identifiers.concat
  i32 =:: LabelOffset
  -1 LabelOffset =: export UNLABELED

  ## composite types
  i32 =:: export CompositeFlags
   0 =:: export COMP_FLAG_NONE
   1 =:: export COMP_FLAG_EMPTY
   2 =:: export COMP_FLAG_ONLY_EMPTY
   3 =:: export COMP_MASK_ONLY_EMPTY
   4 =:: export COMP_FLAG_STATIC_ARGS
   8 =:: export COMP_FLAG_TEMPLATE
  15 =:: export COMP_MASK_COMMON_FLAGS
  12 =:: export COMP_GENERIC_MASK
  16 =:: export TUPLE_FLAG_IS_STRUCT
  32 =:: export TUPLE_FLAG_IS_PROC_IN
  64 =:: export TUPLE_FLAG_IS_PROC_OUT
  struct(
    i64 : eltCount
    i64 : eltsOffset
    LabelOffset : labelOffset
    i64 : alignment
    i64 : size
    CompositeFlags : mut flags
  ) =:: export CompositeInfo
  struct(
    CompositeInfo : mut compositeInfo
    i64  : offsetsStart
  ) =:: TupleInfo
  struct(
    CompositeInfo : compositeInfo
    i64 : enumLabelOffset
    Type  : labelType
  ) =:: UnionInfo

  proc( Type TypeContext ptr -> bool ) =>: export isComposite
    unwrapNamed
    switch
      struct enum union procIn procOut case
        true return
      undefined empty primitiveType pointer arrayType procedure
        namedType autoType genericType templateType generatedType
        reference mutableReference arrayIndex cType case
        false return
    end
  end
  proc( Type TypeContext ptr -> bool ) =>: export isTuple
    unwrapNamed .struct ?? return
  end
  proc( Type TypeContext ptr -> bool ) =>: export isEnum
    unwrapNamed .enum ?? return
  end
  proc( Type TypeContext ptr -> bool ) =>: export isUnion
    unwrapNamed .union ?? return
  end
  proc( Type TypeContext ptr -> bool ) =>: export isProcOut
    unwrapNamed .procOut ?? return
  end
  proc( Type : composite TypeContext ptr : context -> CompositeInfo ptr optional ) =>: compositeData
    composite context unwrapNamed
      ..dup switch
        struct case
          context [] .tupleTypes ..swap .struct
            list.at .data [] .compositeInfo @
          CompositeInfo ptr cast optional.wrap return
          break
        procIn case
          context [] .tupleTypes ..swap .procIn
            list.at .data [] .compositeInfo @
          CompositeInfo ptr cast optional.wrap return
          break
        procOut case
          context [] .tupleTypes ..swap .procOut
            list.at .data [] .compositeInfo @
          CompositeInfo ptr cast optional.wrap return
          break
        union case
          context [] .unionTypes ..swap .union
            list.at .data [] .compositeInfo @
          CompositeInfo ptr cast optional.wrap return
          break
        enum case
          context [] .unionTypes ..swap .enum
            list.at .data [] .compositeInfo @
          CompositeInfo ptr cast optional.wrap return
          break
        undefined empty primitiveType pointer arrayType procedure
         namedType autoType genericType templateType generatedType
         reference mutableReference arrayIndex cType case
          ..drop CompositeInfo ptr optional.empty return
      end
  end
  proc( Type : composite TypeContext ptr : context -> i64 ) =>: export compositeEltCount
    composite context compositeData
      ..dup optional.isEmpty if ..drop
        0 return
      end
