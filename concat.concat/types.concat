import core
import list
import slice
import string
import stringBuilder

import "labels.concat"
import "constants.concat"

namespace: types
  enum(
    BOOL
    I8 I16 I32 I64
    CHAR8 CHAR16 CHAR32
    F32 F64
    TYPE
  ) =:: export: PrimitiveType
  i32 =:: ArrayId
  i32 =:: TupleId
  i32 =:: UnionId
  i32 =:: InitializerId
  i32 =:: ProcTypeId
  i32 =:: NamedTypeId
  i32 =:: GeneratedId
  i32 =:: export: TypeSetId
  ## primitive C-types for C interoperability
  enum(
    VOID BOOL
    CHAR S_CHAR U_CHAR
    SHORT U_SHORT
    INT U_INT
    LONG LONGLONG U_LONG U_LONGLONG SIZE
    FLOAT DOUBLE
    ## XXX? add support for long double
    STRUCT UNION
  ) =:: CType
  enum(
    U7  S8  U8  ## largest numbers castable to i8;  -> i32 by default
    U15 S16 U16 ## largest numbers castable to i16; -> i32 by default
    U24 S25   ## largest numbers castable to f32 ( -2^24 <= k <= 2^24 ); -> i32 by default
    U31 S32 U32 ## -> i32
    U53 S54   ## largest numbers castable to f64 ( -2^53 <= k <= 2^53 ); -> i64 by default
    U63 S64 U64 ## -> i64
    ## XXX? support for 128Bit integer literals
  ) =:: IntLiteral
  union(
    ProcId : typeTrait
    Type : typeId
  ) =:: export: TypeSetEntry
  struct(
    i32 : elementsOffset
    i32 : elementCount
  ) =:: export: TypeSet
end

union(
                    _ : undefined
                    _ : empty
  types.PrimitiveType : primitiveType
     types.IntLiteral : intLiteral
        types.ArrayId : pointer
        types.ArrayId : mutablePointer
        types.ArrayId : rawPointer
        types.ArrayId : mutableRawPointer
        types.ArrayId : arrayType
        types.TupleId : struct
        types.UnionId : union
        types.TupleId : procIn
        types.TupleId : procOut
        types.UnionId : enum
  types.InitializerId : initializer
     types.ProcTypeId : procedure
    types.NamedTypeId : namedType
                  i32 : autoType
              LabelId : genericType
      types.TypeSetId : typeSet
    types.GeneratedId : generatedType
          types.CType : cType
                  i32 : align
) =:: export: Type

namespace: types
  proc( Type : a Type : b -> bool ) =>: export: typeEquals
    a ..label b ..label != if
      false return
    end
    a switch
      undefined empty case
        true return ## there is only one undefined/empty type
      primitiveType case
        a .primitiveType b .primitiveType == return
      intLiteral case
        a .intLiteral b .intLiteral == return
      pointer case
        a .pointer b .pointer == return
      mutablePointer case
        a .mutablePointer b .mutablePointer == return
      rawPointer case
        a .rawPointer b .rawPointer == return
      mutableRawPointer case
        a .mutableRawPointer b .mutableRawPointer == return
      arrayType case
        a .arrayType b .arrayType == return
      struct case
        a .struct b .struct == return
      procIn case
        a .procIn b .procIn == return
      procOut case
        a .procOut b .procOut == return
      enum case
        a .enum b .enum == return
      union case
        a .union b .union == return
      initializer case
        a .initializer b .initializer == return
      procedure case
        a .procedure b .procedure == return
      namedType case
        a .namedType b .namedType == return
      autoType case
        a .autoType b .autoType == return
      genericType case
        a .genericType b .genericType == return
      generatedType case
        a .generatedType b .generatedType == return
      cType case
        a .cType b .cType == return
      align case
        a .align b .align == return
      typeSet case
        a .typeSet b .typeSet == return
    end
  end
  1011001 =:: bigPrime
  proc( PrimitiveType -> i32 ) =>: primitiveId
    switch
      BOOL case 1 return
      I8 case 2 return
      I16 case 3 return
      I32 case 4 return
      I64 case 5 return
      CHAR8 case 6 return
      CHAR16 case 7 return
      CHAR32 case 8 return
      F32 case 9 return
      F64 case 10 return
      TYPE case 11 return
    end
  end
  proc( IntLiteral -> i32 ) =>: intLiteralId
    switch
      U7  case  1 return
      S8  case  2 return
      U8  case  3 return
      U15 case  4 return
      S16 case  5 return
      U16 case  6 return
      U24 case  7 return
      S25 case  8 return
      U31 case  9 return
      S32 case 10 return
      U32 case 11 return
      U53 case 12 return
      S54 case 13 return
      U63 case 14 return
      S64 case 15 return
      U64 case 16 return
    end
  end
  proc( CType -> i32 ) =>: cTypeId
    switch
      VOID case 0 return
      BOOL case 1 return
      CHAR case 2 return
      S_CHAR case 3 return
      U_CHAR case 4 return
      SHORT  case 5 return
      U_SHORT case 6 return
      INT case 7 return
      U_INT case 8 return
      LONG  case 9 return
      LONGLONG  case 10 return
      U_LONG  case 11 return
      U_LONGLONG  case 12 return
      SIZE case 13 return
      FLOAT case 14 return
      DOUBLE case 15 return
      STRUCT case 16 return
      UNION case 17 return
    end
  end
  proc( Type : a -> i32 ) =>: export: typeHash
    a switch
      undefined case
        0 return ## there is only one undefined
      empty case
        1 return ## there is only one empty type
      primitiveType case
        bigPrime 2 * a .primitiveType primitiveId + return
      pointer case
        bigPrime 3 * a .pointer i32 cast + return
      arrayType case
        bigPrime 5 * a .arrayType i32 cast + return
      struct case
        bigPrime 7 * a .struct i32 cast + return
      procIn case
        bigPrime 11 * a .procIn i32 cast + return
      procOut case
        bigPrime 13 * a .procOut i32 cast + return
      enum case
        bigPrime 17 * a .enum i32 cast + return
      union case
        bigPrime 19 * a .union i32 cast + return
      procedure case
        bigPrime 23 * a .procedure i32 cast + return
      namedType case
        bigPrime 29 * a .namedType i32 cast + return
      autoType case
        bigPrime 31 * a .autoType + return
      genericType case
        bigPrime 37 * a .genericType i32 cast + return
      generatedType case
        bigPrime 43 * a .generatedType i32 cast + return
      cType case
        bigPrime 47 * a .cType cTypeId + return
      intLiteral case
        bigPrime 53 * a .intLiteral intLiteralId + return
      initializer case
        bigPrime 59 * a .initializer i32 cast + return
      rawPointer case
        bigPrime 61 * a .rawPointer i32 cast + return
      align case
        bigPrime 67 * a .align + return
      typeSet case
        bigPrime 71 * a .typeSet i32 cast + return
      mutablePointer case
        bigPrime 73 * a .mutablePointer i32 cast + return
      mutableRawPointer case
        bigPrime 79 * a .mutableRawPointer i32 cast + return
    end
  end
end

type : export: TypeContext
namespace: types
  ## primitive types
  namespace: primitive
    PrimitiveType .BOOL Type .primitiveType Type =: export: BOOL
    PrimitiveType .I8   Type .primitiveType Type =: export: I8
    PrimitiveType .I16  Type .primitiveType Type =: export: I16
    PrimitiveType .I32  Type .primitiveType Type =: export: I32
    PrimitiveType .I64  Type .primitiveType Type =: export: I64
    PrimitiveType .CHAR8  Type .primitiveType Type =: export: CHAR8
    PrimitiveType .CHAR16 Type .primitiveType Type =: export: CHAR16
    PrimitiveType .CHAR32 Type .primitiveType Type =: export: CHAR32
    PrimitiveType .F32  Type .primitiveType Type =: export: F32
    PrimitiveType .F64  Type .primitiveType Type =: export: F64
    PrimitiveType .TYPE Type .primitiveType Type =: export: TYPE
    ## compiler internal type-aliases for special purpose types
    PrimitiveType .I64  Type .primitiveType Type =: export: I_SIZE ## size-off memory-sections
    PrimitiveType .I64  Type .primitiveType Type =: export: I_PTR  ## integer that can hold a pointer
    PrimitiveType .I64  Type .primitiveType Type =: export: I_MAX  ## largest native integer type
  end
  primitive.I_SIZE =:: mut: export: I_SIZE
  primitive.I_PTR =:: mut: export: I_PTR
  namespace: intLiteral
    IntLiteral .U7  Type .intLiteral Type =: export: U7
    IntLiteral .S8  Type .intLiteral Type =: export: S8
    IntLiteral .U8  Type .intLiteral Type =: export: U8
    IntLiteral .U15 Type .intLiteral Type =: export: U15
    IntLiteral .S16 Type .intLiteral Type =: export: S16
    IntLiteral .U16 Type .intLiteral Type =: export: U16
    IntLiteral .U24 Type .intLiteral Type =: export: U24
    IntLiteral .S25 Type .intLiteral Type =: export: S25
    IntLiteral .U31 Type .intLiteral Type =: export: U31
    IntLiteral .S32 Type .intLiteral Type =: export: S32
    IntLiteral .U32 Type .intLiteral Type =: export: U32
    IntLiteral .U53 Type .intLiteral Type =: export: U53
    IntLiteral .S54 Type .intLiteral Type =: export: S54
    IntLiteral .U63 Type .intLiteral Type =: export: U63
    IntLiteral .S64 Type .intLiteral Type =: export: S64
    IntLiteral .U64 Type .intLiteral Type =: export: U64
  end
  proc( Type -> bool ) =>: export: isPrimitive
    .primitiveType ?? return
  end
  proc( Type : t TypeContext ptr : context -> PrimitiveType ) =>: export: primitiveValue
    t context unwrapNamed
      ## XXX? unwrap c-types
    .primitiveType return
  end
  proc( Type : t0 TypeContext ptr : context -> bool ) =>: export: isEmpty ## TODO? should pointer to empty be empty
    t0 context unwrapNamed =:: t
    t switch
       empty align case true return
       arrayType case
         ## arrays of empty values are empty
         t context getBaseType context isEmpty return
       undefined primitiveType procedure cType pointer mutablePointer mutableRawPointer rawPointer
         namedType autoType genericType intLiteral
         generatedType enum typeSet case false return
       procIn procOut struct union initializer case
         t context compositeFlags COMP_FLAG_EMPTY & ? return
    end
  end

  proc( PrimitiveType -> bool ) =>: isIntPrimitive
    switch
      BOOL F32 F64 TYPE CHAR8 CHAR16 CHAR32 case
        false return
      I8 I16 I32 I64 case
        true return
    end
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isInt
    unwrapNamed
      ..dup .intLiteral ?? if ..drop
        true return
      end
      ..dup isPrimitive ! if ..drop
        false return
      end .primitiveType isIntPrimitive
  end
  ## integer or cType integer
  proc( Type TypeContext ptr : context -> bool ) =>: export: isIntLike
    context unwrapNamed =:: t
    t context isInt if true return end
    t .cType ?? if
      t .cType switch
        S_CHAR CHAR U_CHAR SHORT U_SHORT INT U_INT
          LONG U_LONG LONGLONG U_LONGLONG SIZE case true return
        VOID BOOL FLOAT DOUBLE STRUCT UNION case false return
      end
    end
    false return
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isSignedInt
    unwrapNamed
      ..dup .cType ?? if
        .cType switch
          S_CHAR SHORT INT LONG LONGLONG case true return
          VOID BOOL CHAR U_CHAR U_SHORT U_INT U_LONG U_LONGLONG SIZE
            FLOAT DOUBLE STRUCT UNION case false return
        end
      end
      ..dup .intLiteral ?? if
        .intLiteral switch
          U7 U15 U24 U31 U53 U63 S8 S16 S25 S32 S54 S64 case true return
          U8 U16 U32 U64 case false return
        end
      end
      ..drop false return
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isUnsignedInt
    unwrapNamed
      ..dup .cType ?? if
        .cType switch
          U_CHAR U_SHORT U_INT U_LONG U_LONGLONG SIZE case true return
          VOID BOOL CHAR S_CHAR SHORT INT LONG LONGLONG
            FLOAT DOUBLE STRUCT UNION case false return
        end
      end
      ..dup .intLiteral ?? if
        .intLiteral switch
          U7 U8 U15 U16 U24 U31 U32 U53 U63 U64 case true return
          S8 S16 S25 S32 S54 S64 case false return
        end
      end
      ..drop false return
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isFloat
    unwrapNamed
      ..dup isPrimitive ! if ..drop
        false return
      end .primitiveType
      switch
        BOOL I8 I16 I32 I64 CHAR8 CHAR16 CHAR32 TYPE case
          false return
        F32 F64 case
          true return
      end
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isNumber
    unwrapNamed
      ..dup isPrimitive ! if ..drop
        false return
      end .primitiveType
      switch
        BOOL TYPE CHAR8 CHAR16 CHAR32 case
          false return
        I8 I16 I32 I64 F32 F64 case
          true return
      end
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isChar
    unwrapNamed
      $ .primitiveType ?? if
        .primitiveType switch
          BOOL TYPE I8 I16 I32 I64 F32 F64 case
            false return
          CHAR8 CHAR16 CHAR32 case
            true return
        end
      end
      ..drop
    false return
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isIntOrChar
    unwrapNamed
      $ .primitiveType ?? if
        .primitiveType switch
          BOOL TYPE F32 F64 case
            false return
          I8 I16 I32 I64 CHAR8 CHAR16 CHAR32 case
            true return
        end
      end
      ..drop
    false return
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isNumberOrChar
    unwrapNamed
      ..dup isPrimitive ! if ..drop
        false return
      end .primitiveType
      switch
        BOOL TYPE case
          false return
        I8 I16 I32 I64 F32 F64 CHAR8 CHAR16 CHAR32 case
          true return
      end
  end
  proc( Type -> bool ) =>: export: isLiteral
    switch
       intLiteral initializer case true return
       empty arrayType
           undefined primitiveType procedure cType pointer
           namedType autoType genericType rawPointer
           generatedType enum align mutablePointer mutableRawPointer
           procIn procOut struct union typeSet case
         false return
    end
  end
  proc( Type : t TypeContext ptr.mut : context -> Type ) =>: export: literalToType
    t switch
       intLiteral case t .intLiteral intLiteralAsInt return
       initializer case
        context [] .initializerTypes
          t .initializer i64 cast list.at .data =:: initInfo
        context [] .tupleTypes
          initInfo [] .asTuple i64 cast list.at .data =:: tupleInfo
        tupleInfo .compositeInfo .eltCount [] =:: eltCount
        initInfo .arrayType .undefined ?? ! if
          initInfo [] .arrayType context literalToType =:: baseType
          eltCount i64 cast.u ArraySize .Int =:: size
          ## newArrayType
            baseType
            ArrayType .ARRAY
            size
          context newArrayType
            ! "can create array" assert
          return
        end
        tupleInfo .compositeInfo .flags [] COMP_FLAG_CONTAINS_LITERAL & ? if
          eltCount Type list.create =:: mut: newElements ## XXX? reuse type-buffer
          context [] .compositeData tupleInfo .compositeInfo .eltsOffset [] eltCount list.getSlice =:: oldElts
          newElements
            0:i32 while $ eltCount < do =:: i
              oldElts i slice.get context literalToType list.append
            finally i 1 + end ..drop
          newElements=
          tupleInfo .compositeInfo .labelOffset [] =:: labelOffset
          ## newTuple
            newElements list.asSlice
            labelOffset UNLABELED == if
              LabelId slice optional.empty
            else
              context [] .elementLabels labelOffset i32 cast eltCount list.getSlice optional.wrap
            end
            context
          newTuple
            ! "can create tuple" assert
            newElements list.free newElements=
          return
          ## TODO correctly convert element types if elements are literals
        end
        initInfo .asTuple [] Type .struct return
       empty arrayType
           undefined primitiveType procedure cType pointer
           namedType autoType genericType rawPointer
           generatedType enum align mutablePointer mutableRawPointer
           procIn procOut struct union typeSet case
         t return
    end
  end

  ## does value fit in 2*64-bit values
  proc( Type TypeContext ptr.mut -> bool ) =>: export: isSmallType
    sizeOf =:: size
    size switch
      fixed case
        size .fixed 16 <= return ## more than 2*i64
      dynamicArray case false return
      unknown case ..unreachable ## TODO? error message
    end
  end
  ## can value be pushed onto stack
  proc( Type TypeContext ptr.mut -> bool ) =>: export: referenceOnly
    isSmallType ! return ## XXX ? allow larger stack values
  end

  64 =:: export: MAX_INT_WIDTH
  i64.MAX =:: export: MAX_SIGNED_INT
  proc( Type : src Type : target TypeContext ptr : context -> bool ) =>: canAutoCastIntLiteral
    src .intLiteral ?? ! or target context types.isNumber ! if
      true return
    end
    src .intLiteral switch
      U7  case false  7:i64 break
      S8  case true   8:i64 break
      U8  case false  8:i64 break
      U15 case false 15:i64 break
      S16 case true  16:i64 break
      U16 case false 16:i64 break
      U24 case false 24:i64 break
      S25 case true  24:i64 break
      U31 case false 31:i64 break
      S32 case true  32:i64 break
      U32 case false 32:i64 break
      U53 case false 53:i64 break
      S54 case true  53:i64 break
      U63 case false 63:i64 break
      S64 case true  64:i64 break
      U64 case false 64:i64 break
    end =:: srcBits =:: srcSigned
    target context primitiveValue =:: targetPrimitive
    targetPrimitive isIntPrimitive if
      targetPrimitive sizeOfPrimitive 8 * =:: targetBits
      srcBits targetBits <= return
    else targetPrimitive .F32 ?? _if
      srcBits 24 <= return
    else targetPrimitive .F64 ?? _if
      srcBits 53 <= return
    end
    ..unreachable
  end
  proc( Type : src Type : target TypeContext ptr : context -> bool ) =>: canAutoCastNumber
    src context types.isNumber ! target context types.isNumber ! | if
      true return
    end
    src context primitiveValue =:: srcPrimitive
    target context primitiveValue =:: targetPrimitive
    srcPrimitive targetPrimitive == if
      true return
    end
    srcPrimitive isIntPrimitive and targetPrimitive isIntPrimitive if
      srcPrimitive sizeOfPrimitive =:: srcBytes
      targetPrimitive sizeOfPrimitive =:: targetBytes
      srcBytes targetBytes == return ## cast I... <-> U...
    end
    false return
  end
  ## ctypes
  namespace: ctype
    CType .VOID        Type .cType Type =: export: VOID
    CType .BOOL        Type .cType Type =: export: BOOL
    CType .CHAR        Type .cType Type =: export: CHAR
    CType .S_CHAR      Type .cType Type =: export: S_CHAR
    CType .U_CHAR      Type .cType Type =: export: U_CHAR
    CType .SHORT       Type .cType Type =: export: SHORT
    CType .U_SHORT     Type .cType Type =: export: U_SHORT
    CType .INT         Type .cType Type =: export: INT
    CType .U_INT       Type .cType Type =: export: U_INT
    CType .LONG        Type .cType Type =: export: LONG
    CType .U_LONG      Type .cType Type =: export: U_LONG
    CType .LONGLONG    Type .cType Type =: export: LONGLONG
    CType .U_LONGLONG  Type .cType Type =: export: U_LONGLONG
    CType .SIZE        Type .cType Type =: export: SIZE
    CType .FLOAT       Type .cType Type =: export: FLOAT
    CType .DOUBLE      Type .cType Type =: export: DOUBLE
    CType .STRUCT      Type .cType Type =: export: STRUCT
    CType .UNION       Type .cType Type =: export: UNION
  end
  proc( CType -> Type ) =>: export: cTypeAsType
    switch
      VOID STRUCT UNION case Type .empty return
      BOOL case primitive.BOOL return
      CHAR S_CHAR U_CHAR case primitive.I8 return
      SHORT U_SHORT case primitive.I16 return
      INT U_INT case primitive.I32 return
      LONG LONGLONG U_LONG U_LONGLONG SIZE case primitive.I64 return
      FLOAT case primitive.F32 return
      DOUBLE case primitive.F64 return
    end
  end
  proc( types.IntLiteral -> Type ) =>: export: intLiteralAsInt
    switch
      U7 S8 U8 U15 S16 U16 case primitive.I32 return
      U24 S25 U31 S32 U32  case primitive.I32 return
      U53 S54 U63 S64 U64  case primitive.I64 return
    end
  end

  ## size and alignment
  union( _ : unknown i64 : fixed i64 : dynamicArray ) =:: export: TypeSize
  8:i64 =:: PTR_SIZE
  8:i64 =:: PTR_ALIGN
  8:i64 =:: I_SIZE_SIZE
  8:i64 =:: I_SIZE_ALIGN
  proc( PrimitiveType -> i64 ) =>: export: sizeOfPrimitive
    switch
      TYPE case
        0 return
      BOOL I8 CHAR8 case
        1 return
      I16 CHAR16 case
        2 return
      I32 F32 CHAR32 case
        4 return
      I64 F64 case
        8 return
    end
  end
  proc( IntLiteral -> i64 ) =>: intLiteralBytes
    switch
      U7 S8 U8            case 1 return
      U15 S16 U16         case 2 return
      U24 S25 U31 S32 U32 case 4 return
      U53 S54 U63 S64 U64 case 8 return
    end
  end
  proc( IntLiteral -> i64 ) =>: export: sizeOfIntLiteral
    switch
      U7 S8 U8 U15 S16 U16 case 4 return
      U24 S25 U31 S32 U32  case 4 return
      U53 S54 U63 S64 U64  case 8 return
    end
  end
  proc( CType -> i64 ) =>: sizeOfCType
    switch ## sizes for linux-x86-gcc
      BOOL CHAR S_CHAR U_CHAR VOID case 1 return
      SHORT U_SHORT case 2 return
      INT U_INT case 4 return
      LONG LONGLONG U_LONG U_LONGLONG SIZE case 8 return
      FLOAT case 4 return
      DOUBLE case 8 return
      STRUCT UNION case 0 return ## structs should not be used directly
    end
  end

  proc(
    Type : t
    TupleId : tupleId
    TypeContext ptr.mut : typeContext
  -> bool ) =>: tryComputeTupleSize
    typeContext [] .tupleTypes
      tupleId i64 cast
    list.at .data =:: tupleInfo
    tupleInfo [] .compositeInfo .flags COMP_SIZE_KNOWN & ? if
      false return ## size already known
    end
    t typeContext compositeElts  =:: elts
    ## TODO sort elements by alignment
    1:i64 =:: mut: alignment
    0:i64 =:: mut: size
    elts .length i64 list.create =:: mut: offsetBuffer ## XXX? store buffer in context
    elts for =:: elt
      ## size and alignment
      elt typeContext alignOf =:: eltAlignData
      elt typeContext sizeOf =:: eltSizeData
      eltAlignData .fixed ?? ! eltSizeData .fixed ?? ! | if
        offsetBuffer list.free ..drop
        true return ## elements are not fixed size
      end
      eltAlignData .fixed =:: eltAlign
      eltSizeData .fixed =:: eltSize
      eltAlign alignment > if
        eltAlign alignment=
      end
      size eltAlign alignSize =:: eltOffset
      eltOffset eltSize + size=
      offsetBuffer
        eltOffset list.append
      offsetBuffer=
    end
    ## XXX? compress tupleOffsets list ( search for previous occurrence of current elements )
    typeContext [] .tupleOffsets
      ..dup .length i32 cast.u tupleInfo .offsetsStart=
      offsetBuffer list.appendAll
    typeContext .tupleOffsets=
    offsetBuffer list.free ..drop
    alignment tupleInfo .compositeInfo .alignment=
    size tupleInfo .compositeInfo .size=
    tupleInfo [] .compositeInfo .flags
      COMP_SIZE_KNOWN |
    tupleInfo .compositeInfo .flags=
    false return
  end
  proc(
    Type : t
    UnionId : unionId
    TypeContext ptr.mut : typeContext
  -> bool ) =>: tryComputeUnionSize
    typeContext [] .unionTypes
      unionId i64 cast
    list.at .data =:: unionInfo
    unionInfo [] .compositeInfo .flags COMP_SIZE_KNOWN & ? if
      false return ## size already known
    end
    t typeContext compositeElts =:: elts
    1:i64 =:: mut: alignment
    0:i64 =:: mut: size
    elts for =:: elt
      ## size and alignment
      elt typeContext sizeOf =:: eltSizeData
      elt typeContext alignOf =:: eltAlignData
      eltAlignData .fixed ?? ! eltSizeData .fixed ?? ! | if
        true return ## elements are not fixed size
      end
      eltAlignData .fixed =:: eltAlign
      eltSizeData .fixed =:: eltSize
      eltAlign alignment > if
        eltAlign alignment=
      end
      eltSize size > if
        eltSize size=
      end
    end
    unionInfo [] .labelType typeContext isEmpty ! if
      unionInfo [] .labelType typeContext alignOf .fixed =:: labelAlign
      labelAlign alignment > if
        labelAlign alignment=
      end
      size
        labelAlign alignSize
        ..dup unionInfo .enumLabelOffset=
        unionInfo [] .labelType typeContext sizeOf .fixed +
      size=
    end
    alignment unionInfo .compositeInfo .alignment=
    size unionInfo .compositeInfo .size=
    unionInfo [] .compositeInfo .flags
      COMP_SIZE_KNOWN |
    unionInfo .compositeInfo .flags=
    false return
  end
  proc(
    Type : composite
    TypeContext ptr.mut : typeContext
  -> bool ) =>: tryComputeSize
    composite switch
      struct case
        composite composite .struct typeContext tryComputeTupleSize return
      procIn case
        composite composite .procIn typeContext tryComputeTupleSize return
      procOut case
        composite composite .procOut typeContext tryComputeTupleSize return
      enum case
        composite composite .enum typeContext tryComputeUnionSize return
      union case
        composite composite .union typeContext tryComputeUnionSize return
      initializer case
        ## tryComputeUnionSize
          composite
          typeContext [] .initializerTypes
            composite .initializer i64 cast
          list.at .data [] .asTuple
        typeContext tryComputeTupleSize return
      undefined empty autoType genericType rawPointer mutableRawPointer
      primitiveType intLiteral cType arrayType
      pointer mutablePointer procedure align typeSet
      namedType generatedType case ..unreachable ## XXX? use assertion
    end
  end
  ## alignment of type in bytes, will be a power of two
  proc( Type : t TypeContext ptr.mut : context -> TypeSize ) =>: export: alignOf
    t switch
      undefined autoType genericType typeSet case
        TypeSize .unknown return
      empty case
        1 TypeSize .fixed return
      align case
        t .align i64 cast.u TypeSize .fixed return
      primitiveType case
        t .primitiveType sizeOfPrimitive TypeSize .fixed return
      intLiteral case
        t .intLiteral sizeOfIntLiteral TypeSize .fixed return
      cType case
        t .cType sizeOfCType TypeSize .fixed return
      pointer mutablePointer rawPointer mutableRawPointer procedure case
        PTR_SIZE TypeSize .fixed return
      arrayType case
        t context getBaseType context alignOf return
      struct enum union procIn procOut initializer case
        t context tryComputeSize if
          TypeSize .unknown return
        end
        t context compositeData .data =:: compData
        compData [] .alignment TypeSize .fixed return
      namedType case
        t context unwrapNamed context alignOf return
      generatedType case
        t context getGeneratedType context alignOf return
    end
  end
  ## return next multiple of a >= s, assumes that a is a power of 2
  proc( i64 : s i64 : a -> i64 ) =>: export: alignSize
    s
      a 1 - +
      a 1 - ~ &
    return
  end
  proc(
    Type : t
    bool : aligned
    TypeContext ptr.mut : context
  -> TypeSize ) =>: computeSize
    t switch
      undefined autoType genericType typeSet case
        TypeSize .unknown return
      empty case
        0 TypeSize .fixed return
      align case
        aligned if t .align i64 cast.u else 0:i64 end TypeSize .fixed return
      primitiveType case
        t .primitiveType sizeOfPrimitive TypeSize .fixed return
      intLiteral case ## XXX? don't use fixed size for int literals
        t .intLiteral sizeOfIntLiteral TypeSize .fixed return
      cType case
        t .cType sizeOfCType TypeSize .fixed return
      pointer mutablePointer rawPointer mutableRawPointer procedure case
        PTR_SIZE TypeSize .fixed return
      arrayType case
        t context getArraySize =:: arraySize
        t context getBaseType context strideOf =:: baseSize
        baseSize .fixed ?? ! if
          TypeSize .unknown return
        end
        arraySize switch
          None case baseSize return
          Int case baseSize .fixed arraySize .Int *  TypeSize .fixed return
          ## TODO! distinguish generic-size and runtimke dynamic size
          Dynamic case baseSize .fixed TypeSize .dynamicArray return
          GenericArg case baseSize .fixed TypeSize .dynamicArray return
        end
        break
      struct enum union procIn procOut initializer case
        t context tryComputeSize if
          TypeSize .unknown return
        end
        t context compositeData .data =:: compData
        compData [] .size
          aligned if
            compData [] .alignment alignSize
          end
        TypeSize .fixed return
      namedType case
        t context unwrapNamed aligned context computeSize return
      generatedType case
        t context getGeneratedType aligned context computeSize return
    end
  end
  ## size of value in bytes
  proc( Type : t TypeContext ptr.mut : context -> TypeSize ) =>: export: sizeOf
    t false context computeSize ## TODO? should size be smaller than stride
  end
  ## size padded to next multiple of alignment
  proc( Type : t TypeContext ptr.mut : context -> TypeSize ) =>: export: strideOf
    t true context computeSize
  end

  ## array & pointer types
  union( _ : None _ : Dynamic i64 : Int LabelId : GenericArg ) =:: export: ArraySize
  struct(
    Type : base
    ArraySize : size
  ) =:: ArrayData

  proc( Type TypeContext ptr -> bool ) =>: export: isPointer
    unwrapNamed =:: t
    t .pointer ?? or t .mutablePointer ?? or t .rawPointer ?? or t .mutableRawPointer ?? end return
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isArray
    unwrapNamed .arrayType ?? return
  end
  ## pointer to array-type ( fixed size and not 0D )
  proc( Type : t TypeContext ptr : context -> bool ) =>: export: isArrayPointer
    t context unwrapNamed =:: base
    base .pointer ?? if
      base .pointer
    else base .mutablePointer ?? _if
      base .mutablePointer
    else ## raw-pointer cannot be array-pointer
      false return
    end =:: arrayId
    context [] .arrayTypes arrayId iSize cast list.at .data [] .size =:: ptrSize
    ptrSize .None ?? if
      false return
    end
    true return
  end
  proc( Type : t TypeContext ptr : context -> bool ) =>: export: isArrayLiteral
    t context unwrapNamed =:: base
    base .initializer ?? ! if
      false return
    end
    context [] .initializerTypes
      base .initializer i64 cast list.at .data []
    .arrayType .undefined ?? ! return
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isFixedSize
     unwrapNamed =:: t
     t .pointer ?? or t .mutablePointer ?? or t .arrayType ?? end return
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isFixedSizePtr
     unwrapNamed =:: t
     t .pointer ?? or t .mutablePointer ?? end return
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isRawPointer
     unwrapNamed =:: t
     t .rawPointer ?? or t .mutableRawPointer ?? end return
  end
  proc( Type : box TypeContext ptr : context -> Type ) =>: export: getBaseType
    box context unwrapNamed
      $ .pointer ?? if .pointer
      else $ .mutablePointer ?? _if .mutablePointer
      else $ .rawPointer ?? _if .rawPointer
      else $ .mutableRawPointer ?? _if .mutableRawPointer
      else $ .arrayType ?? _if .arrayType
      else
        ..drop  Type .undefined return
      end
    context [] .arrayTypes >$ i64 cast list.get .base return
  end
  proc( Type : box TypeContext ptr : context -> ArraySize ) =>: export: getArraySize
    box context unwrapNamed
      $ .pointer ?? if .pointer
      else $ .mutablePointer ?? _if .mutablePointer
      else $ .rawPointer ?? _if .rawPointer
      else $ .mutableRawPointer ?? _if .mutableRawPointer
      else $ .arrayType ?? _if .arrayType
      else ..drop
        ArraySize .None return
      end
    context [] .arrayTypes >$ i32 cast list.get .size return
  end

  proc( Type TypeContext ptr -> bool ) =>: export: isMutable
    =:: context
    context unwrapNamed
      $ .mutablePointer ?? or $ .mutableRawPointer ?? end
    >$ ..drop
    return
  end
  proc( ArraySize : a ArraySize : b -> bool ) =>: arraySizeEqual
    a ..label b ..label != if
      false return
    end
    a switch
      None Dynamic case true return
      Int case a .Int b .Int == return
      GenericArg case a .GenericArg b .GenericArg == return
    end
  end
  enum( POINTER MUTABLE_POINTER RAW_POINTER MUTABLE_RAW_POINTER ARRAY ) =:: export: ArrayType
  proc(
    Type : target
    ArrayType : arrayType
    ArraySize : size
    TypeContext ptr.mut : context
  -> Type bool ) =>: export: newArrayType
    context .labelContext =:: labelContext
    ## XXX? error on var-size array
    target =:: mut: base
    base .undefined ?? if
      Type .undefined true return
    end
    size .None ?? and base .arrayType ?? if
      arrayType .POINTER ?? if
        base .arrayType Type .pointer false return
      else arrayType .MUTABLE_POINTER ?? _if
        base .arrayType Type .mutablePointer false return
      end
    end
    ## TODO! prevent dynamic-size array & fixed size raw_pointer
    ## procedure types are only allowed as base for fixed-size 0 dimensional pointers
    base context isProcedure if
      ## allow rawPointers and pointer of length 1 for generic matching
      arrayType .ARRAY ?? or size .None ?? ! if
        Type .undefined true return
      end
      base
        context asUnlabeledProc if ..drop
          Type .undefined true return
        end
      base=
    end
    context .arrayTypes =:: arrays
    0:iSize while $ arrays [] .length u< do
      arrays [] $1 list.get
        $ .size size arraySizeEqual ! if ..drop
          1:iSize + continue
        end
        $ .base base typeEquals ! if ..drop
          1:iSize + continue
        end
      ..drop
      ## found match
      ArrayId cast
        arrayType switch
          POINTER case Type .pointer break
          MUTABLE_POINTER case Type .mutablePointer break
          RAW_POINTER case Type .rawPointer break
          MUTABLE_RAW_POINTER case Type .mutableRawPointer break
          ARRAY case Type .arrayType break
        end
      false return
    end ..drop
    arrays []
      base size ArrayData new list.append
    arrays =[]
    arrays [] .length 1:iSize - ArrayId cast
      arrayType switch
        POINTER case Type .pointer break
        MUTABLE_POINTER case Type .mutablePointer break
        RAW_POINTER case Type .rawPointer break
        MUTABLE_RAW_POINTER case Type .mutableRawPointer break
        ARRAY case Type .arrayType break
      end
    false return
  end

  ## initializer type as array/tuple, without chainging element types
  ## used for correctly resolving procedure signatures
  proc( Type : t TypeContext ptr.mut : context ArrayType : arrayType -> Type ) =>: initializerAsArrayOrPtr
    t .initializer ?? ! if Type .undefined return end
    context [] .initializerTypes
      t .initializer i64 cast list.at .data =:: initInfo
    context [] .tupleTypes
      initInfo [] .asTuple i64 cast list.at .data =:: tupleInfo
    tupleInfo .compositeInfo .eltCount [] =:: eltCount
    eltCount i64 cast.u ArraySize .Int =:: size
    ## newArrayType
      initInfo [] .arrayType
      arrayType
      size
    context newArrayType
      ! "can create array" assert
    return
  end
  proc( Type : t TypeContext ptr.mut : context -> Type ) =>: export: initializerAsArray
    t context ArrayType .ARRAY initializerAsArrayOrPtr
  end
  proc( Type : t TypeContext ptr.mut : context -> Type ) =>: export: initializerAsPointer
    t context ArrayType .POINTER initializerAsArrayOrPtr
  end
  proc( Type : t TypeContext ptr.mut : context -> Type ) =>: export: initializerAsTuple
    t .initializer ?? ! if Type .undefined return end
    context [] .initializerTypes
      t .initializer i64 cast list.at .data =:: initInfo
    initInfo [] .asTuple Type .struct return
  end

  i32 =:: LabelOffset
  -1:LabelOffset =:: export: UNLABELED

  ## composite types
  i32 =:: export: CompositeFlags
    0:CompositeFlags =:: COMP_FLAG_NONE
    1:CompositeFlags =:: export: COMP_FLAG_EMPTY ## TODO remove uses outside this file
    2:CompositeFlags =:: export: COMP_FLAG_ONLY_EMPTY
    3:CompositeFlags =:: COMP_MASK_ONLY_EMPTY
    4:CompositeFlags =:: COMP_FLAG_STATIC_ARGS
   12:CompositeFlags =:: COMP_GENERIC_MASK
   15:CompositeFlags =:: COMP_MASK_CONTENT_FLAGS
   16:CompositeFlags =:: COMP_SIZE_KNOWN
   32:CompositeFlags =:: COMP_FLAG_CONTAINS_LITERAL
   64:CompositeFlags =:: TUPLE_FLAG_IS_STRUCT
  128:CompositeFlags =:: TUPLE_FLAG_IS_PROC_IN
  256:CompositeFlags =:: TUPLE_FLAG_IS_PROC_OUT
  namespace: CompositeFlags
    proc( CompositeFlags CompositeFlags -> CompositeFlags ) : alias: and i32.and
    proc( CompositeFlags CompositeFlags -> CompositeFlags ) : alias: or  i32.or
    proc( CompositeFlags CompositeFlags -> CompositeFlags ) : alias: xor i32.xor
    proc( CompositeFlags -> CompositeFlags ) : alias: flip i32.flip
    proc( CompositeFlags -> bool ) : alias: toBool i32.toBool
  end
  overload: merge: & CompositeFlags.and    end
  overload: merge: | CompositeFlags.or     end
  overload: merge: ^ CompositeFlags.xor    end
  overload: merge: ~ CompositeFlags.flip   end
  overload: merge: ? CompositeFlags.toBool end

  struct(
    i32 : eltCount
    i32 : eltsOffset
    LabelOffset : labelOffset
    i64 : alignment
    i64 : size
    CompositeFlags : flags
  ) =:: export: CompositeInfo
  struct(
    CompositeInfo : compositeInfo
    i32  : offsetsStart
  ) =:: TupleInfo
  struct(
    TupleId : asTuple
    Type : arrayType
  ) =:: InitializerInfo
  struct(
    CompositeInfo : compositeInfo
    i64 : enumLabelOffset
    Type  : labelType
  ) =:: UnionInfo

  proc( Type TypeContext ptr -> bool ) =>: export: isComposite
    unwrapNamed
    switch
      struct enum union procIn procOut initializer case
        true return
      undefined empty primitiveType pointer mutablePointer arrayType procedure
        namedType autoType genericType generatedType intLiteral align
        cType rawPointer mutableRawPointer typeSet case
        false return
    end
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isTuple
    unwrapNamed .struct ?? return
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isEnum
    unwrapNamed .enum ?? return
  end
  ## TODO change name: enum can no longer hold values
  proc( Type TypeContext ptr : typeContext -> bool ) =>: export: isTaggedUnion
    typeContext unwrapNamed ..dup switch
      enum case
        .enum break
      union case
        .union break
      struct procIn procOut undefined empty primitiveType pointer arrayType procedure
       namedType autoType genericType generatedType intLiteral initializer rawPointer
       cType align typeSet mutablePointer mutableRawPointer case ..drop
         false return
    end =:: unionId
    typeContext [] .unionTypes unionId i64 cast list.at .data =:: unionInfo
    unionInfo [] .labelType .empty ?? ! ## enum or tagged union
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isUnion
    unwrapNamed .union ?? return
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isProcOut
    unwrapNamed .procOut ?? return
  end
  proc( Type : composite TypeContext ptr : context -> CompositeInfo ptr optional ) =>: compositeData
    composite context unwrapNamed
      ..dup switch
        struct case
          context [] .tupleTypes ..swap .struct i64 cast
            list.at .data .compositeInfo
          CompositeInfo ptr cast optional.wrap return
          break
        procIn case
          context [] .tupleTypes ..swap .procIn i64 cast
            list.at .data .compositeInfo
          CompositeInfo ptr cast optional.wrap return
          break
        procOut case
          context [] .tupleTypes ..swap .procOut i64 cast
            list.at .data .compositeInfo
          CompositeInfo ptr cast optional.wrap return
          break
        union case
          context [] .unionTypes ..swap .union i64 cast
            list.at .data .compositeInfo
          CompositeInfo ptr cast optional.wrap return
          break
        enum case
          context [] .unionTypes ..swap .enum i64 cast
            list.at .data .compositeInfo
          CompositeInfo ptr cast optional.wrap return
          break
        initializer case =:: initInfo
          context [] .tupleTypes
            context [] .initializerTypes
              initInfo .initializer i64 cast list.at .data
            [] .asTuple i64 cast
          list.at .data .compositeInfo
          CompositeInfo ptr cast optional.wrap return
          break
        undefined empty primitiveType pointer arrayType procedure
         namedType autoType genericType generatedType intLiteral align
         cType rawPointer typeSet mutablePointer mutableRawPointer case
          ..drop CompositeInfo ptr optional.empty return
      end
  end
  proc( Type : composite TypeContext ptr : context -> i32 ) =>: export: compositeEltCount
    composite context compositeData
      ..dup optional.isEmpty if ..drop
        0 return
      end
    .data [] .eltCount return
  end
  proc( Type : composite i32 : index TypeContext ptr : context -> LabelId ) =>: export: compositeGetLabel
    composite context unwrapNamed
      ..dup switch
        struct enum union procIn procOut initializer case
          break
        undefined empty primitiveType pointer arrayType procedure
         namedType autoType genericType generatedType intLiteral align
         cType rawPointer typeSet mutablePointer mutableRawPointer case
          ..drop id.LABEL_ID_NONE return
      end
    context compositeData
      ..dup optional.isEmpty if ..drop
        id.LABEL_ID_NONE return
      end
    .data =:: typeData
    typeData [] .labelOffset =:: offset
    offset UNLABELED == if
      id.LABEL_ID_NONE return
    end
    index 0 < or index typeData [] .eltCount >= if
      id.LABEL_ID_NONE return
    end
    context [] .elementLabels offset i32 cast index + list.get return
  end
  proc(
    Type : composite
    LabelId : name
    TypeContext ptr : context
  -> i32 ) =>: export: compositeFindLabel
    context .labelContext =:: labelContext
    composite context unwrapNamed
      ..dup switch
        struct enum union procIn procOut initializer case
          break
        undefined empty primitiveType pointer arrayType procedure
         namedType autoType genericType generatedType intLiteral align
         cType rawPointer mutablePointer mutableRawPointer typeSet case
          ..drop -1 return
      end
    context compositeData
      ..dup optional.isEmpty if ..drop
        -1 return
      end
    .data =:: labels
    labels [] .labelOffset UNLABELED == if
      -1 return
    end
    0:i32 while ..dup labels [] .eltCount < do =:: i
      ## labelNamesEq
        name
        context [] .elementLabels
          labels [] .labelOffset i32 cast i +
        list.get
      labelContext id.labelNamesEq if
        i return
      end
      i 1 +
    end ..drop
    -1 return
  end
  proc(
    Type : tuple
    i32 : index
    TypeContext ptr.mut : typeContext
  -> i64 optional ) =>: export: tupleElementOffset
    tuple typeContext unwrapNamed ..dup switch
      struct case
        .struct break
      procIn case
        .procIn break
      procOut case
        .procOut break
      enum union undefined empty primitiveType pointer arrayType procedure
       namedType autoType genericType generatedType intLiteral initializer align
       cType rawPointer mutablePointer mutableRawPointer typeSet case ..drop
         i64 optional.empty return
    end =:: tupleId
    tuple tupleId typeContext tryComputeTupleSize if
      i64 optional.empty return
    end
    typeContext [] .tupleTypes tupleId i64 cast list.at .data =:: tupleInfo
    index 0 < or index tupleInfo [] .compositeInfo .eltCount >= if
      i64 optional.empty return
    end
    typeContext [] .tupleOffsets
      index tupleInfo [] .offsetsStart +
    list.get optional.wrap return
  end
  proc(
    Type : enum
    TypeContext ptr.mut : typeContext
  -> Type i64 optional ) =>: export: enumLabelInfo
    enum typeContext unwrapNamed ..dup switch
      enum case
        .enum break
      union case
        .union break
      struct procIn procOut undefined empty primitiveType pointer arrayType procedure
       namedType autoType genericType generatedType intLiteral initializer align
       cType rawPointer mutablePointer mutableRawPointer typeSet case ..drop
         Type .empty i64 optional.empty return
    end =:: enumId
    enum enumId typeContext tryComputeUnionSize =:: isError
    typeContext [] .unionTypes enumId i64 cast list.at .data =:: enumInfo
    enumInfo [] .labelType
      isError if
        i64 optional.empty
      else
        enumInfo [] .enumLabelOffset optional.wrap
      end
    return
  end
  proc( Type : composite i32 : index TypeContext ptr : context -> Type ) =>: export: compositeGetElement
    composite context compositeData =:: compData?
    index 0 < or compData? optional.isEmpty or index compData? .data [] .eltCount >= if
      Type .undefined return
    end
    compData? .data =:: compData
    compData [] .flags COMP_FLAG_ONLY_EMPTY & ? if
      Type .empty return
    end
    context [] .compositeData compData [] .eltsOffset index + list.get return
  end
  Type list.empty =:: mut: emptyTypeBuffer
  proc( Type : composite TypeContext ptr : context -> Type slice ) =>: export: compositeElts
    composite context compositeData =:: compData?
    compData? optional.isEmpty if
      Type slice.empty return
    end
    compData? .data =:: compData
    compData [] .flags COMP_FLAG_ONLY_EMPTY & ? if
      emptyTypeBuffer
        compData [] .eltCount list.ensureCap
      emptyTypeBuffer=
      while emptyTypeBuffer .length compData [] .eltCount iSize cast.u u< do
        emptyTypeBuffer
          Type .empty list.append
        emptyTypeBuffer=
      end
      emptyTypeBuffer 0 compData [] .eltCount list.getSlice return
    end
    context [] .compositeData compData [] .eltsOffset compData [] .eltCount list.getSlice return
  end
  proc( Type : composite TypeContext ptr : context -> CompositeFlags ) =>: export: compositeFlags
    composite context compositeData
      ..dup optional.isEmpty if ..drop
        0:CompositeFlags return
      end
    .data [] .flags return
  end

  ## XXX remove i32 parameter once new call resolver is implemented
  proc( Type ptr : a Type ptr : b i32 : ignore -> bool ) =>: typePtrEq
    a [] b [] typeEquals
  end
  proc(
    Type slice : elts
    TypeContext ptr.mut : context
  -> i32 CompositeFlags ) =>: computeEltsOffset
    true =:: mut: emptyData ## composite is empty
    true =:: mut: onlyEmpty ## composite only contains Type .empty
    COMP_FLAG_NONE =:: mut: flags
    elts for =:: elt
      elt .empty ?? ! if
        false onlyEmpty=
      end
      elt context isEmpty ! if
        false emptyData=
      end
      elt context containsGeneric if
        flags COMP_FLAG_STATIC_ARGS | flags=
      end
      elt isLiteral if
        flags COMP_FLAG_CONTAINS_LITERAL | flags=
      end
    end
    onlyEmpty if
      0 COMP_MASK_ONLY_EMPTY flags | return
    else emptyData _if
       flags COMP_FLAG_EMPTY | flags=
    end
    context [] .compositeData list.asSlice
      elts
      typePtrEq@
      0
    slice.indexOfSlicePrefix =:: mut: offset
    offset elts .length + context [] .compositeData .length u< if
      offset i32 cast flags return
    end
    context [] .compositeData
      elts ## skip overlap
        context [] .compositeData .length offset - slice.tail
      list.appendSlice
    context .compositeData=
    offset i32 cast flags return
  end
  proc(
    LabelId ptr : a
    LabelId ptr : b
    LabelContext ptr.mut : labelContext
  -> bool ) =>: labelPtrEq
    ## XXX? treat labels with same name and flags as equal
    a [] b [] == if
      true return
    end
    a [] labelContext id.labelFlags id.FLAG_DUMMY & ? and
        b [] labelContext id.labelFlags id.FLAG_DUMMY & ? if
      ## treat dummy labels with same name as equal
      a [] b [] labelContext id.labelNamesEq return
    end
    false return
  end
  proc(
    LabelId slice optional : labels?
    TypeContext ptr.mut : context
  -> LabelOffset ) =>: computeLabelOffset
    context .labelContext =:: labelContext
    labels? optional.isEmpty if
      UNLABELED return
    end
    labels? .data =:: labels
    true =:: mut: unlabled
    labels for
      id.LABEL_ID_NONE != if
        false unlabled=
        break
      end
    end
    unlabled if
      UNLABELED return
    end
    context [] .elementLabels list.asSlice
      labels
      labelPtrEq@
      labelContext
    slice.indexOfSlicePrefix =:: mut: offset
    offset labels .length + context [] .elementLabels .length u< if
      offset LabelOffset cast return
    end
    context [] .elementLabels
      labels ## skip overlap
        context [] .elementLabels .length offset - slice.tail
      list.appendSlice
    context .elementLabels=
    offset LabelOffset cast return
  end

  proc(
    Type slice : elts
    LabelId slice optional : labels
    CompositeFlags : flags0
    TypeContext ptr.mut : context
  -> TupleId ) =>: findTupleInfo
    context .labelContext =:: labelContext
    elts context computeEltsOffset flags0 | =:: flags =:: eltsOffset
    labels context computeLabelOffset =:: labelOffset
    context [] .tupleTypes =:: tuples
    tuples .length for =:: tupleIndex
      tuples tupleIndex list.at .data =:: t
      t [] .compositeInfo .eltCount iSize cast.u elts .length == and
          t [] .compositeInfo .eltsOffset eltsOffset == and
          t [] .compositeInfo .labelOffset labelOffset == and
          t [] .compositeInfo .flags COMP_MASK_CONTENT_FLAGS &
            flags COMP_MASK_CONTENT_FLAGS &
          == if
        t [] .compositeInfo .flags flags | t .compositeInfo .flags=
        tupleIndex TupleId cast return
      end
    end
    tuples .length TupleId cast =:: newId
    context [] .tupleTypes
      ## TupleInfo
        ## CompositeInfo
          elts .length i32 cast
          eltsOffset
          labelOffset
          -1
          -1
          flags
        CompositeInfo new
        -1
      TupleInfo new list.append
    context .tupleTypes=
    newId return
  end
  ## creates struct
  proc(
    Type slice : elts
    LabelId slice optional : labels
    TypeContext ptr.mut : context
  -> Type bool ) =>: export: newTuple
    elts .length 0:iSize == if
      ## empty tuple -> empty type handled by parser
      Type .undefined true return
    end
    ## findTupleInfo
      elts
      labels
      TUPLE_FLAG_IS_STRUCT
      context
    findTupleInfo Type .struct false return
  end
  proc(
    Type slice : elts
    LabelId slice optional : labels
    TypeContext ptr.mut : context
  -> Type ) =>: export: newInitializerType
    ## findTupleInfo
      elts
      labels
      TUPLE_FLAG_IS_STRUCT ## TODO? create seperate flag
      context
    findTupleInfo =:: tupleId
    ## check for existing initializer with same elements
    context [] .initializerTypes =:: initializers
    0:iSize while $ initializers .length u< do =:: i
      initializers i list.at .data =:: t
      t [] .asTuple tupleId == if
        i InitializerId cast Type .initializer return
      end
    finally i 1:iSize + end ..drop
    ##  check if initializer can be array
    elts .length 0:iSize != if
      elts 0 slice.get
    else ## TODO? special type for empty array?
      primitive.I32 ## TODO? better default type for empty array
    end =:: mut: arrayType
    0:iSize while $ elts .length u< do =:: i
      elts i slice.get =:: eltType
      labels optional.hasData and
        labels .data i slice.get id.LABEL_ID_NONE != if
        ## if there is a labeled element the initializer is not an array
        Type .undefined arrayType=
        i break
      end
      arrayType eltType context mergeTypes ! if
        #+mergedType+# arrayType=
      else ..drop
        Type .undefined arrayType=
        i break
      end
    finally i 1:iSize + end ..drop
    context [] .initializerTypes
      $ .length =:: initializerId
      ## InitializerInfo
        tupleId
        arrayType
      InitializerInfo new list.append
    context .initializerTypes=
    initializerId InitializerId cast Type .initializer return
  end
  proc(
    Type slice : elts
    LabelId slice optional : labels
    bool : isOut
    TypeContext ptr.mut : context
  -> Type ) =>: export: newProcArgs
    ## findTupleInfo
      elts
      labels
      isOut if TUPLE_FLAG_IS_PROC_OUT else TUPLE_FLAG_IS_PROC_IN end
      context
    findTupleInfo
    isOut if Type .procOut else Type .procIn end
    return
  end
  proc(
    Type slice : elts
    LabelId slice optional : labels
    TypeContext ptr.mut : context
    bool : isTagged
  -> UnionId ) =>: export: findEnumOrUnion
    elts context computeEltsOffset =:: flags =:: eltsOffset
    labels context computeLabelOffset =:: labelOffset
    isTagged ! if
      Type .empty
    else elts .length 0x80:iSize u< _if
      primitive.I8
    else elts .length 0x8000:iSize u< _if
      primitive.I16
    else
      primitive.I32
    end =:: labelType
    0:i64 =:: mut: enumLabelOffset
    context [] .unionTypes =:: unions
    0:iSize while $ unions .length u< do
      unions $1 list.at .data =:: t
      t [] .compositeInfo .eltCount iSize cast.u elts .length == and
      t [] .compositeInfo .eltsOffset eltsOffset == and
      t [] .compositeInfo .labelOffset labelOffset == and
      t [] .labelType labelType typeEquals and
      t [] .compositeInfo .flags flags == if
        break
      end
      1:iSize +
    end =:: unionId
    unionId unions .length == if
     context [] .unionTypes
       ## UnionInfo
        ## CompositeInfo
          elts .length i32 cast
          eltsOffset
          labelOffset
          -1
          -1
          flags
        CompositeInfo new
        0
        labelType
       UnionInfo new list.append
     context .unionTypes=
    end
    unionId UnionId cast return
  end
  proc(
    Type slice : elts
    LabelId slice optional : labels
    TypeContext ptr.mut : context
  -> Type bool ) =>: export: newEnum
    elts .length 0:iSize ==  labels optional.isEmpty | if
      Type .undefined true return
    end
    ## findEnumOrUnion
      elts
      labels
      context
      true
    findEnumOrUnion Type .enum false return
  end
  proc(
    Type slice : elts
    LabelId slice optional : labels
    bool : isTagged
    TypeContext ptr.mut : context
  -> Type bool ) =>: export: newUnion
    elts .length 0:iSize == labels optional.isEmpty | if
      Type .undefined true return
    end
    ## findEnumOrUnion
      elts
      labels
      context
      isTagged
    findEnumOrUnion Type .union false return
  end
end
namespace: sb
  proc(
    stringBuilder : sb
    Type : t
    bool : printEmptyTypes
    i32 : depth
    TypeContext ptr : context
  -> stringBuilder ) =>: appendComposite
    context .labelContext =:: labelContext
    sb
      t context types.compositeData .data =:: comp
      comp [] .labelOffset types.UNLABELED == =:: unlabeled
      0:i32 while ..dup comp [] .eltCount < do
        ..swap
          t $2 context types.compositeGetElement =:: eltType
          unlabeled if
            eltType context depth 1 - appendTypeRecursive
            ' ' appendC
            ..swap 1 + continue
          end
          t ..over.2 context types.compositeGetLabel =:: label
          label id.LABEL_ID_NONE !=
            label labelContext id.labelFlags id.FLAG_DUMMY & ? ! &
          =:: printLabel
          printEmptyTypes eltType context types.isEmpty ! | if
            eltType context depth 1 - appendTypeRecursive
            printLabel if
              " : " appendS
            else
              ' ' appendC
            end
          end
          printLabel if
            label labelContext id.labelFlags id.FLAG_MUTABLE & ? if
              "mut: " appendS
            end
            label labelContext id.labelFlags id.FLAG_AUTO & ? if
              "auto: " appendS
            end
            label labelContext id.labelFlags id.FLAG_STATIC & ? if
              "static: " appendS
            end
            label labelContext appendLabelName
            ' ' appendC
          end
        ..swap
        1 +
      end ..drop
    return
  end
end
namespace: types

  ## procedure types
  struct( Type : in Type : out CallingConvention : callingConvention ) =:: ProcType

  proc( Type TypeContext ptr -> bool ) =>: export: isProcedure
    unwrapNamed .procedure ?? return
  end
  proc( Type : mType TypeContext ptr : context -> bool ) =>: export: isCallable
    mType context unwrapNamed
      $ context isFixedSizePtr if
        context getBaseType
      end
    .procedure ?? return
  end
  proc( Type : proc TypeContext ptr : context -> Type bool ) =>: export: getProcIn
    proc context unwrapNamed
      ..dup context isProcedure ! if ..drop
        Type .undefined true return
      end
    context [] .procTypes ..swap .procedure i64 cast list.get .in false return
  end
  proc( Type : proc TypeContext ptr : context -> Type bool ) =>: export: getProcOut
    proc context unwrapNamed
      ..dup context isProcedure ! if ..drop
        Type .undefined true return
      end
    context [] .procTypes ..swap .procedure i64 cast list.get .out false return
  end
  proc( Type : proc TypeContext ptr : context -> CallingConvention bool ) =>: export: getCallConvention
    proc context unwrapNamed
      ..dup context isProcedure ! if ..drop
        CallingConvention.DEFAULT true return
      end
    context [] .procTypes ..swap .procedure i64 cast list.get .callingConvention false return
  end
  proc( Type : proc TypeContext ptr : context -> Type bool ) =>: export: getProcRet
    proc context getProcOut if true return end =:: outType
    proc context getCallConvention if ..drop Type .undefined true return end =:: callConvention
    callConvention switch
      CCALL PTRCALL case
        outType context compositeElts =:: elts
        elts .length 0:iSize == if
          Type .empty false return
        end
        elts elts .length 1:iSize - slice.get false return
      CONCAT case
        outType context compositeEltCount =:: eltCount
        eltCount 0 == if
          Type .empty false return
        else eltCount 1 == _if
          outType 0 context compositeGetElement false return
        end
        outType false return
    end
  end
  proc( Type : proc TypeContext ptr : context -> Type slice bool ) =>: export: getProcOutArgs
    proc context getProcOut if ..drop Type slice.empty true return end =:: outType
    proc context getCallConvention if ..drop Type slice.empty true return end =:: callConvention
    callConvention switch
      CCALL CONCAT case Type slice.empty false return
      PTRCALL case
        outType context compositeElts =:: elts
        elts .length 0:iSize == if
          Type slice.empty false return
        end
        elts elts .length 1:iSize - slice.head false return
    end
  end
  proc( Type : in Type : out CallingConvention : callConvention TypeContext ptr.mut : context -> Type bool ) =>: export: newProcedure
    in .undefined ?? or out .undefined ?? if
      Type .undefined true return
    end
    callConvention .CCALL ?? and out context compositeEltCount 1 > if
      Type .undefined true return ## XXX? better error handling
    end
    context .procTypes =:: procs
    0:iSize while $ procs [] .length u< do =:: i
      procs [] i list.at .data =:: elt
      elt [] .callingConvention callConvention == and
      elt [] .in in typeEquals and
      elt [] .out out typeEquals if
        i ProcTypeId cast Type .procedure false return
      end
      i 1:iSize +
    end ..drop
    procs []
      in out callConvention ProcType new list.append
    procs =[]
    procs [] .length 1:iSize - ProcTypeId cast Type .procedure
    false return
  end
  proc(
    Type : proc
    TypeContext ptr.mut : context
  -> Type bool ) =>: export: asUnlabeledProc
    proc context unwrapNamed
      ..dup context isCallable ! if ..drop
        proc true return
      end
      false =:: mut: isPtr
      ..dup context isPointer if
        context getBaseType
        true isPtr=
      end
    =:: mProc
    context [] .procTypes mProc .procedure i64 cast list.get =:: procData
    context [] .tupleTypes procData .in .procIn i64 cast list.at .data [] .compositeInfo =:: mut: inType
    inType .labelOffset UNLABELED == if
      proc false return
    end
    ## newProcArgs
      context [] .compositeData
        inType .eltsOffset
        inType .eltCount
      list.getSlice
      LabelId slice optional.empty
      false
      context
    newProcArgs
    procData .out procData .callingConvention context newProcedure if ..drop proc true return end
    isPtr if
      ArrayType .POINTER ArraySize .None context newArrayType return
    end
    false return
  end

  ## named types
  struct( Type : data LabelId : name ) =:: NamedType
  proc(
    LabelId : label
    TypeContext ptr.mut : context
  -> types.NamedTypeId ) =>: findNamedType
    0:iSize while $ context [] .namedTypes .length u< do =:: i
      context [] .namedTypes i list.at .data =:: elt
      elt [] .name label == if
        i types.NamedTypeId cast return
      end
      i 1:iSize +
    end ..drop
    context [] .namedTypes
      ## NamedType
        Type .undefined
        label
      NamedType new list.append
    context .namedTypes=
    context [] .namedTypes .length 1:iSize - NamedTypeId cast return
  end
  proc(
    LabelId : label
    TypeContext ptr.mut : context
  -> Type ) =>: export: declareNamedType
    label context findNamedType Type .namedType return
  end

  proc(
    Type : value
    LabelId : label
    TypeContext ptr.mut : context
  -> Type bool ) =>: export: initializeNamedType
    label context findNamedType =:: id
    context [] .namedTypes id i64 cast list.at .data =:: named
    named [] .data Type .undefined typeEquals ! if
      id Type .namedType true return
    end
    value named .data=
    id Type .namedType false return
  end
  proc(
    Type : value
    LabelId : label
    TypeContext ptr.mut : context
  -> Type ) =>: export: newNamedType
    ## TODO? find better way to handle generic named types in new compiler
    context [] .namedTypes
      ## NamedType
        value
        label
      NamedType new list.append
    context .namedTypes=
    context [] .namedTypes .length 1:iSize - NamedTypeId cast Type .namedType return
  end
  proc( Type -> bool ) =>: export: isNamedType
    .namedType ?? return
  end
  ## completely unwrap named type
  proc( Type TypeContext ptr -> Type ) =>: export: unwrapNamed
    =:: context
    while
      ..dup .namedType ?? if
        context [] .namedTypes
          ..swap .namedType i64 cast
        list.at .data [] .data
        continue
      else ..dup .generatedType ?? _if
        context [] .generatedTypes
          ..swap .generatedType i64 cast
        list.at .data [] .generated
        continue
      end
    false do end
    return
  end
  ## unwrap only top level named type
  proc( Type TypeContext ptr -> Type ) =>: export: flatUnwrapNamed
    =:: context
    ..dup .namedType ?? if
      context [] .namedTypes
        ..swap .namedType i64 cast
      list.at .data [] .data
    end
    return
  end
  ## completely unwrap named type
  proc(
    Type
    TypeContext ptr
  -> Type ) =>: export: unwrapNamedKeepGenerated
    =:: context
    while
      ..dup .namedType ?? if
        context [] .namedTypes
          ..swap .namedType i64 cast
        list.at .data [] .data
        continue
      end
    false do end
    return
  end
  proc( Type TypeContext ptr -> LabelId ) =>: export: namedTypeName
    =:: context
    ..dup .namedType ?? if
      context [] .namedTypes ..swap .namedType i64 cast list.get .name return
    end
    ..drop id.LABEL_ID_NONE return
  end
end

namespace: sb
  proc(
    stringBuilder : sb
    types.NamedType : named
    TypeContext ptr : context
    i32 : depth
  -> stringBuilder ) =>: appendNamedType
    context .labelContext =:: labelContext
    sb
      '"' sb.appendC
      named .name labelContext sb.appendLabelPath
      '"' sb.appendC
      depth 0 > if
        " [ " sb.appendS
        ## appendTypeRecursive
          named .data context types.flatUnwrapNamed
          context
          depth 1 -
        appendTypeRecursive
        " ]"  sb.appendS
      end
    return
  end
end
namespace: types

  ## generated types

  struct(
    LabelId : generator
    ConstValue slice : arguments
    Type : generated
  ) =:: GeneratedType


  proc( Type -> bool ) =>: export: isGeneratedType
    .generatedType ?? return
  end
  #+ finds the generated type for the given type generator and arguments
     returns the type and a boolean that is true if a new GeneratedType was created +#
  proc(
    LabelId : generatorName
    ConstValue slice : arguments
    bool : create
    TypeContext ptr.mut : typeContext
    ConstantContext ptr.mut : constContext
  -> Type bool ) =>: export: findGeneratedType
    typeContext .labelContext =:: labelContext
    typeContext [] .generatedTypes =:: genTypes
    0:iSize while $ genTypes .length u< do
      genTypes $1 list.at .data =:: candidate
      candidate [] .generator generatorName != if
        1:iSize + continue
      end
      candidate [] .arguments =:: candidateArgs
      candidateArgs .length arguments .length != if
        1:iSize + continue
      end
      true =:: mut: match
      0:iSize while $ arguments .length u< do
        ## constantEquals
          candidateArgs $1 slice.get
          arguments $2 slice.get
          labelContext
        constantEquals ! if
          false match=
          break
        end
        1:iSize +
      end ..drop
      match if
        #+index+# GeneratedId cast Type .generatedType false return
      end
      1:iSize +
    end ..drop
    create if
      typeContext [] .generatedTypes
        $ .length GeneratedId cast =:: newId
        ## GeneratedType
          generatorName
          arguments constContext constArray
          Type .undefined
        GeneratedType new list.append
      typeContext .generatedTypes=
      newId GeneratedId cast Type .generatedType true return
    end
    Type .undefined true return
  end

  proc(
    LabelId : generatorName
    ConstValue slice : arguments
    Type : value
    TypeContext ptr.mut : typeContext
    ConstantContext ptr.mut : constContext
  -> Type ) =>: export: initializeGeneratedType
    ## findGeneratedType
      generatorName
      arguments
      true
      typeContext
      constContext
    findGeneratedType ..drop =:: prevType
    value
      typeContext [] .generatedTypes
        prevType .generatedType i64 cast
      list.at .data
    .generated=
    prevType return
  end

  proc( Type : generator TypeContext ptr : context -> Type ) =>: export: getGeneratedType
    generator =:: mut: t
    t .namedType ?? if
      t context unwrapNamedKeepGenerated t=
    end
    t .generatedType ?? ! if
      generator return
    end
    context [] .generatedTypes t .generatedType i64 cast list.at .data =:: genData
    genData [] .generated return
  end

  proc( Type : generator TypeContext ptr : context -> LabelId ) =>: export: getGeneratorLabel
    generator =:: mut: t
    t .namedType ?? if
      t context unwrapNamedKeepGenerated t=
    end
    t .generatedType ?? ! if
      id.LABEL_ID_NONE return
    end
    context [] .generatedTypes t .generatedType i64 cast list.at .data =:: genData
    genData [] .generator return
  end
  proc( Type : generator TypeContext ptr : context -> ConstValue slice ) =>: export: getGeneratorArgs
    generator =:: mut: t
    t .namedType ?? if
      t context unwrapNamedKeepGenerated t=
    end
    t .generatedType ?? ! if
      ConstValue slice.empty return
    end
    context [] .generatedTypes t .generatedType i64 cast list.at .data =:: genData
    genData [] .arguments return
  end

  ## generic & auto-types
  proc( i32 : id -> Type ) =>: export: newAutoType
    id Type .autoType return
  end
  proc( Type -> bool ) =>: export: isAutoType
    .autoType ?? return
  end
  proc( LabelId : id -> Type ) =>: export: newGenericType
    id Type .genericType return
  end

  proc(
    LabelId : name
    TypeSetEntry slice : elements
    TypeContext ptr.mut : context
  -> Type ) =>: export: newTypeSet
    ## TODO check if type-set already exists
    ##  ? check if type-set contains duplicate values
    context [] .typeSetEntries
      $ .length =:: offset
      elements list.appendSlice
    context .typeSetEntries=
    context [] .typeSets
      $ .length =:: setId
      ## TypeSet
        offset i32 cast
        elements .length i32 cast
      TypeSet new list.append
    context .typeSets=
    setId TypeSetId cast Type .typeSet return
  end
  proc( Type TypeContext ptr : context -> bool ) =>: export: isTypeSet
    context unwrapNamed .typeSet ?? return
  end
  ## TODO? better name "is this type a type" sounds weird
  proc( Type : t TypeContext ptr : context -> bool ) =>: export: isType
    t context unwrapNamed =:: baseType
    baseType .typeSet ?? or baseType primitive.TYPE typeEquals end return
  end
  proc( Type : t TypeContext ptr : context -> TypeSetEntry slice ) =>: export: getTypeSetEntries
    t context unwrapNamed =:: t0
    t0 .typeSet ?? ! if
      TypeSetEntry slice.empty return
    end
    t0 .typeSet =:: id
    context [] .typeSets id i64 cast list.get =:: typeSet
    context [] .typeSetEntries
      typeSet .elementsOffset i64 cast
      typeSet .elementCount i64 cast
    list.getSlice return
  end

  proc( Type -> i32 ) =>: export: getTypeId
    ..dup switch
      autoType case .autoType return
      genericType case .genericType i32 cast return
      generatedType case .generatedType i32 cast return
      pointer case .pointer i32 cast return
      mutablePointer case .mutablePointer i32 cast return
      rawPointer case .rawPointer i32 cast return
      mutableRawPointer case .mutableRawPointer i32 cast return
      arrayType case .arrayType i32 cast return
      struct case .struct i32 cast return
      union case .union i32 cast return
      enum case .enum i32 cast return
      initializer case .initializer i32 cast return
      procIn case .procIn i32 cast return
      procOut case .procOut i32 cast return
      procedure case .procedure i32 cast return
      namedType case .namedType i32 cast return
      align case .align return
      typeSet case .typeSet i32 cast return
      undefined empty primitiveType intLiteral cType case ..drop -1 return
    end
  end

  proc( Type : t0 TypeContext ptr : context -> bool ) =>: export: isGeneric
    t0 context unwrapNamed .genericType ?? return
  end
  proc( Type : t0 TypeContext ptr : context -> bool #+has static arg+# ) =>: export: containsGeneric
    t0 context unwrapNamedKeepGenerated =:: t
    t switch
      undefined empty primitiveType autoType cType intLiteral align typeSet case
        false return
      pointer mutablePointer rawPointer mutableRawPointer arrayType case
        context [] .arrayTypes
          t
            $ .pointer ?? if
              .pointer
            else $ .mutablePointer ?? _if
              .mutablePointer
            else $ .rawPointer ?? _if
              .rawPointer
            else $ .mutableRawPointer ?? _if
              .mutableRawPointer
            else
              .arrayType
            end
          i64 cast
        list.get =:: arrayType
        arrayType .size .GenericArg ?? if
          true return
        end
        arrayType .base context containsGeneric if
          true return
        end
        false return
      struct enum union procIn procOut initializer case
        t context compositeData .data [] .flags COMP_FLAG_STATIC_ARGS & ? return
      generatedType case
        context [] .generatedTypes t .generatedType i64 cast.u list.at .data =:: genType
        ## a generatedType is generic if one of its arguments is generic
        genType .arguments [] .length for =:: i
          genType [] .arguments i slice.get =:: arg
          ConstValue ..length 23:iSize == "no new constants" assert
          arg .GenericArg ?? or arg .TypeId ?? and arg .TypeId context containsGeneric if
            true return
          end
        end
        false return
      procedure case
        context [] .procTypes
          t .procedure i64 cast
        list.get =:: proc
        proc .in context containsGeneric or
          proc .out context containsGeneric
        end return
      namedType case
        t context unwrapNamed context containsGeneric return
      genericType case
        true return
    end
  end

  proc( Type : t0 TypeContext ptr : context -> bool ) =>: export: isInitializer
    t0 context unwrapNamed .initializer ?? return
  end

  proc( Type : src bool : mutable TypeContext ptr.mut : context -> Type ) =>: export: getAddressType
    src context isArray if
      src context unwrapNamed =:: unwraped
      unwraped context getBaseType
        mutable if ArrayType .MUTABLE_POINTER else ArrayType .POINTER end
        unwraped context getArraySize
      context newArrayType ..drop return
    end
    src context isProcedure if
      src context asUnlabeledProc ..drop
    else
      src
    end
      mutable if ArrayType .MUTABLE_POINTER else ArrayType .POINTER end
      ArraySize .None
    context newArrayType ..drop return
  end
  proc( Type : src TypeContext ptr.mut : context -> Type ) =>: export: ptrTarget
    src context isPointer ! if
      Type .undefined return
    end
    src context isArrayPointer if
      src context unwrapNamed =:: unwraped
      unwraped context getBaseType
        ArrayType .ARRAY
        unwraped context getArraySize
      context newArrayType ..drop return
    end
    src context getBaseType return
  end

  proc( Type : src Type : target TypeContext ptr : context -> bool ) =>: sizeCompatible
    using types.
    src context isFixedSize ! and target context isFixedSize if
      false return ## cannot cast non-fixed pointer to fixed poiner
    end
    target context isFixedSize ! if
      true return
    end
    src context getArraySize =:: srcSize
    target context getArraySize =:: targetSize
    srcSize targetSize arraySizeEqual if
      true return
    end
    ## allow cast  T ptr -> T 1 ptr
    srcSize .None ?? and targetSize .Int ?? and targetSize .Int 1 == if
      true return
    end
    false return
  end

  proc(
    PrimitiveType : a
    PrimitiveType : b
  -> bool ) =>: canCastPrimitivePtrArg
    a ..label b ..label == if true return end
    a switch
      I8  case b .CHAR8  ?? return
      I16 case b .CHAR16 ?? return
      I32 case b .CHAR32 ?? return
      CHAR8  case b .I8  ?? return
      CHAR16 case b .I16 ?? return
      CHAR32 case b .I32 ?? return
      BOOL I64 F32 F64 TYPE case false return
    end
  end
  proc(
    Type : mut: src
    Type : mut: target
    bool : allowRename
    bool : mutableParent
    TypeContext ptr : context
  -> bool ) =>: canCastPtr
    allowRename if
      src context unwrapNamed src=
      target context unwrapNamed target=
    end
    src target types.typeEquals if
      true return
    end
    allowRename and src .primitiveType ?? and target .primitiveType ?? and
      src .primitiveType target .primitiveType canCastPrimitivePtrArg if
      true return
    end
    ## TODO! allow cast  T k array l ptr -> T  k l *  ptr
    src context types.isPointer ! or target context types.isPointer ! if
      false return
    end
    target context types.isMutable =:: mutableTarget
    src context types.isMutable =:: mutableSrc
    mutableParent if ## cannot convert mutable to immutable if parent is mutable
      mutableSrc mutableTarget !=
    else
      mutableSrc ! mutableTarget &
    end or src target context sizeCompatible ! if
      false return
    end
    ## canCastPtr
      src context types.getBaseType
      target context types.getBaseType
      allowRename
      mutableParent mutableTarget |
    context canCastPtr return
  end
  ## XXX? allow reordering fields
  proc( Type : src Type : target TypeContext ptr.mut : context -> bool ) =>: canCastTupleInitializer
    context .labelContext =:: labelContext
    src context unwrapNamed =:: srcBase
    target context unwrapNamed =:: targetBase
    srcBase .struct ?? if
      srcBase .struct
    else srcBase .initializer ?? _if
      context [] .initializerTypes
        srcBase .initializer i64 cast list.at .data
      .asTuple []
    else
      false return
    end =:: srcId
    targetBase .struct ?? ! if false return end
    targetBase .struct =:: targetId
    srcId targetId == if
      true return
    end
    context [] .tupleTypes srcId i64 cast list.at .data =:: srcInfo
    context [] .tupleTypes targetId i64 cast list.at .data =:: targetInfo
    srcInfo .compositeInfo [] .eltCount targetInfo .compositeInfo [] .eltCount != if
      false return
    end
    srcInfo .compositeInfo .labelOffset [] =:: srcLabels
    targetInfo .compositeInfo .labelOffset [] =:: targetLabels
    srcLabels UNLABELED == targetLabels UNLABELED == != if
      false return ## eigther both labeled or both unlabled
    end
    ## XXX? wrapper function for getting tuple elements/labels from id
    srcLabels UNLABELED != =:: labeled
    srcInfo .compositeInfo .eltCount [] =:: eltCount
    context [] .compositeData
      srcInfo .compositeInfo .eltsOffset []
      srcInfo .compositeInfo .eltCount []
    list.getSlice =:: srcElts
    context [] .compositeData
      targetInfo .compositeInfo .eltsOffset []
      targetInfo .compositeInfo .eltCount []
    list.getSlice =:: targetElts
    eltCount for =:: i
      srcElts i slice.get targetElts i slice.get context canAutoCast ! if
        false return
      end
      labeled and
          ## labelNamesEq
            context [] .elementLabels srcLabels i32 cast i + list.get
            context [] .elementLabels targetLabels i32 cast i + list.get
            labelContext
          id.labelNamesEq ! if
        false return
      end
    end
    true return
  end
  proc( Type : src Type : target TypeContext ptr.mut : context -> bool ) =>: export: canAutoCastInitializer
    target context unwrapNamed =:: targetBase
    src context compositeEltCount =:: srcSize
    srcSize 0 == =:: srcEmpty
    srcEmpty and targetBase context types.isRawPointer if
      true return ## empty initializer to raw 1D pointer
    end
    ## XXX? allow cast from empty initializer to union with single empty entry
    targetBase context types.isMutable if
      false return ## cannot cast non-empty initializer to mutable pointer
    end
    targetBase context types.isArray or targetBase context types.isArrayPointer if
      context [] .initializerTypes src .initializer i64 cast list.at .data =:: initInfo
      targetBase context getBaseType =:: eltType
      initInfo .arrayType [] eltType context canAutoCast and
        targetBase context getArraySize =:: targetSize
        targetSize .Int ?? and targetSize .Int srcSize i64 cast.u == if
          true return
      end
    end
    targetBase context types.isTuple if
      src targetBase context canCastTupleInitializer return
    else targetBase context types.isPointer
        and targetBase context getArraySize .None ??
        and targetBase context getBaseType context unwrapNamed =:: baseType
        baseType context types.isTuple _if
      src baseType context canCastTupleInitializer return
    end
    false return
  end

  proc( Type : src0 Type : target0 TypeContext ptr.mut : context -> bool ) =>: export: canAlias
    src0 context unwrapNamed =:: src
    target0 context unwrapNamed =:: target
    src target types.typeEquals if
      true return ## same type-different names
    end
    ## procedure: compare call-convention, arguments and return-values
    src .procedure ?? and target .procedure ?? if
      ## canAlias
        src context getCallConvention ..drop
        target context getCallConvention ..drop
      == and
      ## canAlias
        src context getProcIn ..drop
        target context getProcIn ..drop
      context canAlias and
      ## canAlias
        src context getProcOut ..drop
        target context getProcOut ..drop
      context canAlias end return
    end
    src .procIn ?? and target .procIn ?? end or
        src .procOut ?? and target .procOut ?? if
      src context compositeElts =:: srcElts
      target context compositeElts =:: targetElts
      srcElts .length targetElts .length != if
        false return
      end
      srcElts .length for =:: i
        srcElts i slice.get targetElts i slice.get context canAlias ! if
          false return
        end
      end
      true return
    end
    false return
  end

  proc( Type : src Type : target TypeContext ptr.mut : context -> bool ) =>: export: canAutoCast
    src target types.typeEquals if
      true return
    end
    src context types.isType and target context types.isType if
      true return ## allow automatic conversions between different version of "type"-types
    end
    src .initializer ?? if
      src target context canAutoCastInitializer return
    end
    src .namedType ?? or target .namedType ?? if
      false return
    end
    ## no auto-cast from/to c-type to minimize platform specific behaviour
    src .cType ?? or target .cType ?? if
      false return
    end
    src .intLiteral ?? target context types.isNumber & if
      src target context types.canAutoCastIntLiteral return
    end
    src context types.isNumber target context types.isNumber & if
      src target context types.canAutoCastNumber return
    end
    src context types.isPointer and target context types.isPointer if
      src target false false context canCastPtr return
    end
    false return
  end
  proc( Type : a Type : b bool : forceCast TypeContext ptr.mut : context -> bool ) =>: export: canCast
    a context types.unwrapNamed =:: mut: src
    b context types.unwrapNamed =:: mut: target
    src target context canAutoCast if
      true return
    end
    ## converting c-types to types
    target .cType ?? if
      forceCast ! if
        target .cType .STRUCT ?? if false return end
        target .cType .UNION  ?? if false return end
      end
      src target .cType cTypeAsType forceCast context canCast return
    end
    src .cType ?? if
      forceCast ! if
        src .cType .STRUCT ?? if false return end
        src .cType .UNION  ?? if false return end
      end
      src .cType cTypeAsType target forceCast context canCast return
    end
    ## char <-> int
    src context isChar and target context isInt if
      true return
    end
    src context isInt and target context isChar if
      true return
    end
    src context types.isNumber or src .intLiteral ?? and target context types.isNumber if
      true return
    end
    src context types.isPointer and target context types.isPointer and
        src target true false context canCastPtr if
      true return
    end
    forceCast ! if
      false return
    end
    src context types.isPointer target context types.isPointer & if
      true return ## XXX check for compatible element sizes?, compatible mutability
    end
    src context types.isPointer target context types.isInt & if
      true return
    end
    src context types.isInt target context types.isPointer & if
      true return
    end
    false return
  end
  proc( Type : src Type : target TypeContext ptr.mut : context -> bool ) =>: export: canBitCast
    src context sizeOf $ .fixed ?? if .fixed else ..drop false return end =:: srcSize
    target context sizeOf $ .fixed ?? if .fixed else ..drop false return end =:: targetSize
    ## TODO? should there by any other restrictions on bit-casts
    srcSize targetSize == or
      ## allow int-literals to be smaller than target-type
      src .intLiteral ?? and src .intLiteral intLiteralBytes targetSize <= and
        primitive.I_MAX .primitiveType sizeOfPrimitive targetSize >= end
    return
  end
  proc( Type : a Type : b TypeContext ptr.mut : context -> Type bool ) =>: export: mergeTypes
    a b types.typeEquals if
      a false return
    end
    ## don't merge different named types
    a .namedType ?? or b .namedType ?? if
      Type .undefined true return
    end
    a context types.isPointer and b context types.isPointer and
        a context types.getBaseType b context types.getBaseType types.typeEquals if
      a context types.isMutable b context types.isMutable & =:: mutable
      a context types.getArraySize =:: aSize
      b context types.getArraySize =:: bSize
      a context types.isFixedSize b context types.isFixedSize & =:: mut: fixedSize
      ## newArrayType
        a context types.getBaseType
        mutable if
          fixedSize if ArrayType .MUTABLE_POINTER else ArrayType .MUTABLE_RAW_POINTER end
        else
          fixedSize if ArrayType .POINTER else ArrayType .RAW_POINTER end
        end
        aSize bSize arraySizeEqual if aSize else ArraySize .Dynamic end
        context
      newArrayType return
    end
    a .intLiteral ?? and b context types.isNumber and
        a b context canAutoCastIntLiteral if
      b false return
    end
    b .intLiteral ?? and a context types.isNumber and
        b a context canAutoCastIntLiteral if
      a false return
    end
    a .intLiteral ?? and b .intLiteral ?? if
      ## XXX directly merge literal types?
      a b .intLiteral intLiteralAsInt context mergeTypes if ..drop
          a .intLiteral intLiteralAsInt b context mergeTypes return
        end
      false return
    end
    ## TODO handle initializer types
    Type .undefined true return
  end
end
## type context
struct(
  LabelContext               : labelContext
  types.ArrayData       list : arrayTypes
  types.ArraySize       list : arraySizes
  types.TupleInfo       list : tupleTypes
  types.UnionInfo       list : unionTypes
  types.InitializerInfo list : initializerTypes
  Type                  list : compositeData
  i64                   list : tupleOffsets
  types.ProcType        list : procTypes
  types.NamedType       list : namedTypes
  types.GeneratedType   list : generatedTypes
  LabelId               list : elementLabels
  types.TypeSetEntry    list : typeSetEntries
  types.TypeSet         list : typeSets
) =:: export: TypeContext
namespace: types
  proc( -> TypeContext ) =>: export: newTypeContext
    ## TypeContext
      id.newLabelContext
      128 ArrayData       list.create ## arrayTypes
      128 ArraySize       list.create ## arraySizes
      128 TupleInfo       list.create ## tupleTypes
      128 UnionInfo       list.create ## unionTypes
      128 InitializerInfo list.create ## initializerTypes
      128 Type            list.create ## compositeData
      128 i64             list.create ## tupleOffsets
      128 ProcType        list.create ## procTypes
      128 NamedType       list.create ## namedTypes
      128 GeneratedType   list.create ## generatedTypes
      128 LabelId         list.create ## elementLabels
      128 TypeSetEntry    list.create ## typeSetEntries
      128 TypeSet         list.create ## typeSets
    TypeContext new return
  end
  proc( TypeContext : context -> TypeContext ) =>: export: freeTypeContext
    context
      $ .labelContext id.freeLabelContext >$ .labelContext=
      $ .arrayTypes       list.free >$ .arrayTypes=
      $ .arraySizes       list.free >$ .arraySizes=
      $ .tupleTypes       list.free >$ .tupleTypes=
      $ .unionTypes       list.free >$ .unionTypes=
      $ .initializerTypes list.free >$ .initializerTypes=
      $ .compositeData    list.free >$ .compositeData=
      $ .tupleOffsets     list.free >$ .tupleOffsets=
      $ .procTypes        list.free >$ .procTypes=
      $ .namedTypes       list.free >$ .namedTypes=
      $ .elementLabels    list.free >$ .elementLabels=
      $ .typeSetEntries   list.free >$ .typeSetEntries=
      $ .typeSets         list.free >$ .typeSets=
    return
  end
end
namespace: sb
  proc( stringBuilder types.PrimitiveType -> stringBuilder ) =>: appendPrimitiveType
    switch
      BOOL case "bool" appendS return
      I8   case "i8"   appendS return
      I16  case "i16"  appendS return
      I32  case "i32"  appendS return
      I64  case "i64"  appendS return
      CHAR8  case "char8"  appendS return
      CHAR16 case "char16" appendS return
      CHAR32 case "char32" appendS return
      F32  case "f32"  appendS return
      F64  case "f64"  appendS return
      TYPE case "type" appendS return
    end
  end
  proc( stringBuilder types.IntLiteral -> stringBuilder ) =>: appendIntLiteralType
    switch
      U7  case "..intLiteral.u7"   appendS return
      S8  case "..intLiteral.s8"   appendS return
      U8  case "..intLiteral.u8"   appendS return
      U15 case "..intLiteral.u15"  appendS return
      S16 case "..intLiteral.s16"  appendS return
      U16 case "..intLiteral.u16"  appendS return
      U24 case "..intLiteral.u24"  appendS return
      S25 case "..intLiteral.s25"  appendS return
      U31 case "..intLiteral.u31"  appendS return
      S32 case "..intLiteral.s32"  appendS return
      U32 case "..intLiteral.u32"  appendS return
      U53 case "..intLiteral.u53"  appendS return
      S54 case "..intLiteral.s54"  appendS return
      U63 case "..intLiteral.u63"  appendS return
      S64 case "..intLiteral.s64"  appendS return
      U64 case "..intLiteral.u64"  appendS return
    end
  end
  proc( stringBuilder types.CType -> stringBuilder ) =>: appendCType
    switch
      VOID case
        "..ctype.void" appendS return
      BOOL case
        "..ctype.bool" appendS return
      CHAR case
        "..ctype.char" appendS return
      S_CHAR case
        "..ctype.schar" appendS return
      U_CHAR case
        "..ctype.uchar" appendS return
      SHORT case
        "..ctype.short" appendS return
      U_SHORT case
        "..ctype.ushort" appendS return
      INT case
        "..ctype.int" appendS return
      U_INT case
        "..ctype.uint" appendS return
      LONG case
        "..ctype.long" appendS return
      U_LONG case
        "..ctype.ulong" appendS return
      LONGLONG case
        "..ctype.longlong" appendS return
      U_LONGLONG case
        "..ctype.ulonglong" appendS return
      SIZE case
        "..ctype.size" appendS return
      FLOAT case
        "..ctype.float" appendS return
      DOUBLE case
        "..ctype.double" appendS return
      STRUCT case
        "..ctype.struct" appendS return
      UNION case
        "..ctype.union" appendS return
    end
  end
  proc(
    stringBuilder : sb
    types.ArraySize : size
    LabelContext ptr : labelContext
  -> stringBuilder  ) =>: export: appendSliceSize
    sb
      size switch
        None case break
        Dynamic case " _" sb.appendS break
        Int case
          ' ' sb.appendC
          size .Int sb.appendI
          break
        GenericArg case
          ' ' sb.appendC
          size .GenericArg labelContext appendLabelName
          "[ " sb.appendS
          size .GenericArg i64 cast.s sb.appendI
          ":LabelId ]" sb.appendS
          break
      end
    return
  end
  proc(
    stringBuilder : sb
    Type : t
    TypeContext ptr : context
    i32 : depth
  -> stringBuilder ) =>: export: appendTypeRecursive
    context .labelContext =:: labelContext
    t switch
      undefined case
        sb "undefined" appendS return
      empty case
        sb "empty" appendS return
      primitiveType case
        sb t .primitiveType appendPrimitiveType return
      intLiteral case
        sb t .intLiteral appendIntLiteralType return
      cType case
        sb t .cType appendCType return
      pointer mutablePointer rawPointer mutableRawPointer case
        sb
          ## appendTypeRecursive
            t context types.getBaseType
            context
            depth
          appendTypeRecursive
          t context types.getArraySize labelContext appendSliceSize
          t .pointer ?? if
            " ptr" appendS
          else t .mutablePointer ?? _if
            " ptr.mut" appendS
          else t .rawPointer ?? _if
            " ptr.raw" appendS
          else
            " ptr.raw.mut" appendS
          end
        return
      arrayType case
        sb
          ## appendTypeRecursive
            t context types.getBaseType
            context
            depth
          appendTypeRecursive
          t context types.getArraySize labelContext appendSliceSize
          " array" appendS
        return
      struct enum union initializer case ## TODO? seperate printing for enum
        sb
          t .struct ?? if
            "struct[" appendS
          else t .union ?? _if
            "union[" appendS
          else t .enum ?? _if
            "enum[" appendS
          else
            "initializer[" appendS
          end
          t types.getTypeId appendI
          "]( "    appendS
          depth 0 > if
            t t .enum ?? ! depth context appendComposite
          else
            "... " appendS
          end
         ")" appendS
       return
      procIn case
        sb t true depth context appendComposite return
      procOut case
        sb t true depth context appendComposite return
      procedure case
        context [] .procTypes t .procedure i64 cast list.get =:: procType
        sb
          procType .callingConvention switch
            CONCAT PTRCALL case "proc["   appendS break
            CCALL  case "proc.c[" appendS break
          end
          t .procedure i64 cast appendI
          "]( "        appendS
          procType .in context depth appendTypeRecursive
          "-> " appendS
          procType .out context depth appendTypeRecursive
          ")" appendS
        return
      namedType case
        sb
          "named[" appendS
          t .namedType i64 cast appendI
          "]( "    appendS
          ## appendNamedType
            context [] .namedTypes t .namedType i64 cast list.get
            context
            depth
          appendNamedType
        " )" appendS
        return
      autoType case
        sb
          "auto["     appendS
          t .autoType appendI
          "]"         appendS
        return
      genericType case
        t .genericType =:: labelId
        sb
          labelId labelContext appendLabelName
          "[ " appendS
          labelId  i64 cast appendI
          ":LabelId ]"  appendS
        return
      generatedType case
        t .generatedType i64 cast
        context [] .generatedTypes ..swap list.at .data =:: typeData
        sb
          typeData [] .arguments .length for =:: i
            typeData [] .arguments i slice.get context sb.appendConstant
            ' ' sb.appendC
          end
          typeData [] .generator labelContext sb.appendLabelPath
          depth 0 > if
            " [ "     appendS
              typeData [] .generated context depth 1 - appendTypeRecursive
            " ]"     appendS
          end
        return
      align case
        sb
          "..type.align" sb.appendS
          t .align sb.appendI
        return
      typeSet case
        sb
          "typeSet( " sb.appendS
          depth 0 >= if
            t context types.getTypeSetEntries for =:: e
              e switch
                typeId case
                  e .typeId context depth 1 - appendTypeRecursive
                  ' ' sb.appendC
                  break
                typeTrait case
                  ## TODO? print procedure name
                  e .typeTrait i64 cast sb.appendI
                  ":ProcId " sb.appendS
                  break
              end
            end
          else t context types.getTypeSetEntries .length 0:iSize != _if
            "..." sb.appendS
          end
          " )" sb.appendS
        return
    end
  end
  proc( stringBuilder Type TypeContext ptr -> stringBuilder ) =>: export: appendType
    0 appendTypeRecursive return ## XXX? change default value to 1
  end
end
