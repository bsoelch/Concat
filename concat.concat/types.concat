#include list

enum( UNDEFINED BOOL I8 I32 I64 FLOAT TYPE ) =:: public PrimitiveType

i32 =:: public ArrayId
i32 =:: public CompositeId
i32 =:: public ProcId
i32 =:: public NamedTypeId

enum( 
  PrimitiveType : primitive
        ArrayId : ptr
        ArrayId : array 
    CompositeId : tuple
