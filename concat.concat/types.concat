#include list
#include arrayView
#include string
#include stringBuilder

#include "labels.concat"
#include "constants.concat"


#namespace types
enum( BOOL I8 I16 I32 I64 FLOAT32 FLOAT64 TYPE ) =:: PrimitiveType
i32 =:: ArrayId
i32 =:: public TupleId ## public for access from identifiers.concat
i32 =:: public UnionId
i32 =:: EnumId
i32 =:: ProcId
i32 =:: NamedTypeId
i32 =:: GeneratedId
i32 =:: ReferenceId
i32 =:: SizeId
## primitive C-types for C interoperability
enum(
  VOID BOOL
  CHAR S_CHAR U_CHAR
  SHORT U_SHORT
  INT U_INT
  LONG LONGLONG U_LONG U_LONGLONG SIZE
  FLOAT DOUBLE
  ## XXX? add support for long double
) =:: CType
#end

enum(
                        undefined
                        empty
  types.PrimitiveType : primitiveType
        types.ArrayId : pointer
        types.ArrayId : arrayType
        types.TupleId : struct
        types.UnionId : union
        types.TupleId : procIn
        types.TupleId : procOut
        types.UnionId : enum
         types.ProcId : procedure
    types.NamedTypeId : namedType
    types.ReferenceId : reference
    types.ReferenceId : mutableReference
                  i32 : autoType
                  i32 : genericType
                  i32 : templateType
    types.GeneratedId : generatedType
         types.SizeId : arrayIndex
          types.CType : cType
) Type =

#namespace types
proc( Type : a Type : b => bool ) =: public typeEquals
  a b != if
    false return
  end
  a switch
    undefined empty case
      true return ## there is only one undefined/empty type
    primitiveType case
      a .primitiveType b .primitiveType == return
    pointer case
      a .pointer b .pointer == return
    arrayType case
      a .arrayType b .arrayType == return
    struct case
      a .struct b .struct == return
    procIn case
      a .procIn b .procIn == return
    procOut case
      a .procOut b .procOut == return
    enum case
      a .enum b .enum == return
    union case
      a .union b .union == return
    procedure case
      a .procedure b .procedure == return
    namedType case
      a .namedType b .namedType == return
    autoType case
      a .autoType b .autoType == return
    genericType case
      a .genericType b .genericType == return
    templateType case
      a .templateType b .templateType == return
    generatedType case
      a .generatedType b .generatedType == return
    reference case
      a .reference b .reference == return
    mutableReference case
      a .mutableReference b .mutableReference == return
    arrayIndex case
      a .arrayIndex b .arrayIndex == return
    cType case
      a .cType b .cType == return
  end
end
1011001 =:: bigPrime
proc( PrimitiveType => i32 ) =: primitiveId
  switch
    BOOL case 1 return
    I8 case 2 return
    I16 case 3 return
    I32 case 4 return
    I64 case 5 return
    FLOAT32 case 6 return
    FLOAT64 case 7 return
    TYPE case 8 return
  end
end
proc( CType => i32 ) =: cTypeId
  switch
    VOID case 0 return
    BOOL case 1 return
    CHAR case 2 return
    S_CHAR case 3 return
    U_CHAR case 4 return
    SHORT  case 5 return
    U_SHORT case 6 return
    INT case 7 return
    U_INT case 8 return
    LONG  case 9 return
    LONGLONG  case 10 return
    U_LONG  case 11 return
    U_LONGLONG  case 12 return
    SIZE case 13 return
    FLOAT case 14 return
    DOUBLE case 15 return
  end
end
proc( Type : a => i32 ) =: public typeHash
  a switch
    undefined case
      0 return ## there is only one undefined
    empty case
      1 return ## there is only one empty type
    primitiveType case
      bigPrime 2 * a .primitiveType primitiveId + return
    pointer case
      bigPrime 3 * a .pointer + return
    arrayType case
      bigPrime 5 * a .arrayType + return
    struct case
      bigPrime 7 * a .struct + return
    procIn case
      bigPrime 11 * a .procIn + return
    procOut case
      bigPrime 13 * a .procOut + return
    enum case
      bigPrime 17 * a .enum + return
    union case
      bigPrime 19 * a .union + return
    procedure case
      bigPrime 23 * a .procedure + return
    namedType case
      bigPrime 29 * a .namedType + return
    autoType case
      bigPrime 31 * a .autoType + return
    genericType case
      bigPrime 37 * a .genericType + return
    templateType case
      bigPrime 41 * a .templateType + return
    generatedType case
      bigPrime 43 * a .generatedType + return
    reference case
      bigPrime 47 * a .reference + return
    mutableReference case
      bigPrime 53 * a .mutableReference + return
    arrayIndex case
      bigPrime 59 * a .arrayIndex + return
    cType case
      bigPrime 61 * a .cType cTypeId + return
  end
end

#end
type : public TypeContext
#namespace types

## primitive types
#namespace primitive
  PrimitiveType .BOOL      Type .primitiveType new Type =: public BOOL
  PrimitiveType .I8        Type .primitiveType new Type =: public I8
  PrimitiveType .I16       Type .primitiveType new Type =: public I16
  PrimitiveType .I32       Type .primitiveType new Type =: public I32
  PrimitiveType .I64       Type .primitiveType new Type =: public I64
  PrimitiveType .FLOAT32   Type .primitiveType new Type =: public FLOAT32
  PrimitiveType .FLOAT64   Type .primitiveType new Type =: public FLOAT64
  PrimitiveType .TYPE      Type .primitiveType new Type =: public TYPE
  ## compiler internal type-aliases for special purpose types
  PrimitiveType .I64       Type .primitiveType new Type =: public I_SIZE ## size-off memory-sections
  PrimitiveType .I64       Type .primitiveType new Type =: public I_PTR  ## integer that can hold a pointer
#end
proc( Type => bool ) =: public isPrimitive
  .primitiveType ?? return
end
proc( Type : t0 TypeContext ptr : context => bool ) =: public isEmpty ## TODO? should pointer to empty be empty
  t0 context unwrapNamed =:: t
  t switch
     empty case true return
     pointer arrayType case ## arrays of / pointers to empty values are empty
       t context getBaseType context isEmpty return
     undefined primitiveType procedure reference mutableReference cType
       namedType autoType genericType templateType generatedType arrayIndex enum case false return
     procIn procOut struct union case
       t context compositeFlags COMP_FLAG_EMPTY & ? return
  end
end
## type is empty if all generics used in type are set to empty
proc( Type : t0 TypeContext ptr : context => bool ) =: public maybeEmpty
  t0 context unwrapNamed =:: t
  t switch
     empty genericType templateType case true return
     pointer arrayType reference mutableReference case ## arrays of / pointers to empty values are empty
       t context getBaseType context isEmpty return
     undefined primitiveType procedure enum cType
       namedType autoType generatedType arrayIndex case false return
     procIn procOut struct union case t context compositeFlags COMP_FLAG_EMPTY & ? return
  end
end
proc( Type TypeContext ptr => bool ) =: public isBoolean
  unwrapNamed
    #dup isPrimitive ! if #drop
      false return
    end .primitiveType
    .BOOL ?? return
end
proc( Type TypeContext ptr => bool ) =: public isInt
  unwrapNamed
    #dup .arrayIndex ?? if #drop
      true return
    end
    #dup isPrimitive ! if #drop
      false return
    end .primitiveType
    switch
      BOOL FLOAT32 FLOAT64 TYPE case
        false return
      I8 I16 I32 I64 case
        true return
    end
end
proc( Type TypeContext ptr => bool ) =: public isFloat
  unwrapNamed
    #dup isPrimitive ! if #drop
      false return
    end .primitiveType
    switch
      BOOL I8 I16 I32 I64 TYPE case
        false return
      FLOAT32 FLOAT64 case
        true return
    end
end
proc( Type TypeContext ptr => bool ) =: public isNumber
  unwrapNamed
    #dup .arrayIndex ?? if #drop
      true return
    end
    #dup isPrimitive ! if #drop
      false return
    end .primitiveType
    switch
      BOOL TYPE case
        false return
      I8 I16 I32 I64 FLOAT32 FLOAT64 case
        true return
    end
end
proc( Type TypeContext ptr => bool ) =: public isSmallType
  unwrapNamed
  switch
    primitiveType pointer empty reference mutableReference
      arrayIndex enum cType case true return
    ## TODO only union with no values is small
    arrayType struct union procIn procOut procedure ## TODO? count structs/unions with size < 128 as small types
    undefined namedType autoType genericType templateType generatedType case false return
  end
end
proc( Type TypeContext ptr => i32 ) =: public numberPrecision
  unwrapNamed
    #dup .arrayIndex ?? if #drop
      primitive.I_SIZE
    else #dup isPrimitive ! _if #drop
      -1 return
    end .primitiveType
    switch
      BOOL TYPE case
        -1 return
      I8 case
        7 return
      I16 case
        15 return
      I32 case
        31 return
      I64 case
        63 return
      FLOAT32 case
        24 return ## IEEE float-32
      FLOAT64 case
        53 return ## IEEE float-64
    end
end
64 =:: public MAX_INT_WIDTH
#+largest integer n s.t. 2^n-1 fits in the type+#
proc( Type TypeContext ptr => i32 ) =: public numberSize
  unwrapNamed
    #dup .arrayIndex ?? if #drop
      primitive.I_SIZE
    else #dup isPrimitive ! _if #drop
      -1 return
    end .primitiveType
    switch
      BOOL TYPE case
        -1 return
      I8 case
        7 return
      I16 case
        15 return
      I32 case
        31 return
      I64 case
        63 return
      FLOAT32 case
        127 return ## IEEE float-32
      FLOAT64 case
        1023 return ## IEEE float-64
    end
end
proc( Type : a Type : b TypeContext ptr : context => Type ) =: public commonIntType
  a context types.isInt ! b context types.isInt ! | if
    Type .undefined return
  end
  a context numberPrecision b context numberPrecision < if
    b return
  else
    a return
  end
end
proc( Type : a Type : b TypeContext ptr : context => Type ) =: public commonNumberType
  a context types.isNumber ! b context types.isNumber ! | if
    Type .undefined return
  end
  a context numberPrecision b context numberPrecision <=
  a context numberSize b context numberSize <= & if
    b return
  end
  a context numberPrecision b context numberPrecision >=
  a context numberSize b context numberSize >= & if
    a return
  end
  Type .undefined return
end
## ctypes
#namespace ctype
  CType .VOID        Type .cType new Type =: public VOID
  CType .BOOL        Type .cType new Type =: public BOOL
  CType .CHAR        Type .cType new Type =: public CHAR
  CType .S_CHAR      Type .cType new Type =: public S_CHAR
  CType .U_CHAR      Type .cType new Type =: public U_CHAR
  CType .SHORT       Type .cType new Type =: public SHORT
  CType .U_SHORT     Type .cType new Type =: public U_SHORT
  CType .INT         Type .cType new Type =: public INT
  CType .U_INT       Type .cType new Type =: public U_INT
  CType .LONG        Type .cType new Type =: public LONG
  CType .U_LONG      Type .cType new Type =: public U_LONG
  CType .LONGLONG    Type .cType new Type =: public LONGLONG
  CType .U_LONGLONG  Type .cType new Type =: public U_LONGLONG
  CType .SIZE        Type .cType new Type =: public SIZE
  CType .FLOAT       Type .cType new Type =: public FLOAT
  CType .DOUBLE      Type .cType new Type =: public DOUBLE
#end
proc( CType => Type ) =: cTypeAsType
  switch
    VOID case Type .empty return
    BOOL case primitive.BOOL return
    CHAR S_CHAR U_CHAR case primitive.I8 return
    SHORT U_SHORT case primitive.I16 return
    INT U_INT case primitive.I32 return
    LONG U_LONG LONGLONG U_LONGLONG SIZE case primitive.I64 return
    FLOAT case primitive.FLOAT32 return
    DOUBLE case primitive.FLOAT64 return
  end
end

## size and alignment
proc( PrimitiveType => i32 ) =: sizeOfPrimitive
  switch
    TYPE case
      0 return
    BOOL I8 case
      1 return
    I16 case
      2 return
    I32 FLOAT32 case
      4 return
    I64 FLOAT64 case
      8 return
  end
end
proc( CType => i32 ) =: sizeOfCType
  switch ## sizes for linux-x86-gcc
    VOID case 0 return
    BOOL CHAR S_CHAR U_CHAR case 1 return
    SHORT U_SHORT case 2 return
    INT U_INT case 4 return
    LONG LONGLONG U_LONG U_LONGLONG SIZE case 8 return
    FLOAT case 4 return
    DOUBLE case 8 return
  end
end
8 =:: PTR_SIZE
8 =:: PTR_ALIGN
8 =:: I_SIZE_SIZE
8 =:: I_SIZE_ALIGN
## alignment of type in bytes, will be a power of two
proc( Type : t TypeContext ptr : context => i64 ) =: public alignOf
  t switch
    undefined empty autoType genericType templateType case
      0 return
    primitiveType case
      t .primitiveType sizeOfPrimitive return
    cType case
      t .cType sizeOfCType return
    arrayIndex case
      I_SIZE_SIZE return
    pointer reference mutableReference procedure case
      PTR_SIZE return
    arrayType case
      t context getBaseType context alignOf return
    struct enum union procIn procOut case
      t context compositeData .data =:: compData
      compData [] .alignment return
    namedType case
      t context unwrapNamed context alignOf return
    generatedType case
      t context getGeneratedType context alignOf return
  end
end
## return next multiple of a >= s, assumes that a is a power of 2
proc( i64 : s i64 : a => i64 ) =: alignSize
  s
    a 1 - +
    a 1 - ~ &
  return
end
proc( Type : t bool : aligned TypeContext ptr : context => i64 ) =: computeSize
  t switch
    empty undefined autoType genericType templateType case
      0 return
    primitiveType case
      t .primitiveType sizeOfPrimitive return
    cType case
      t .cType sizeOfCType return
    arrayIndex case
      I_SIZE_SIZE return
    pointer reference mutableReference procedure case
      PTR_SIZE return
    arrayType case
      t context getArraySize =:: dims
      t context getBaseType context strideOf =:: mut size
      0 while #dup dims .length < do
        dims #over array.get =:: dim
        dim .sizeType .int ?? if
          size dim .value * size =
        else #drop
          0 return ## XXX? better result for dynamic size arrays
        end
        1 +
      end #drop
      size return
    struct enum union procIn procOut case
      t context compositeData .data =:: compData
      compData [] .size
        aligned if
          compData [] .alignment alignSize
        end
      return
    namedType case
      t context unwrapNamed aligned context computeSize return
    generatedType case
      t context getGeneratedType aligned context computeSize return
  end
end
## size of value in bytes
proc( Type : t TypeContext ptr : context => i64 ) =: public sizeOf
  t false context computeSize ## TODO dependent on backend: C:aligned=true, QBE/ASM:aligned=false
end
## size padded to next multiple of alignment
proc( Type : t TypeContext ptr : context => i64 ) =: public strideOf
  t true context computeSize
end
## array & pointer types
enum( int templateArg staticArg ) =:: public ArraySizeType
struct( i64 : value ArraySizeType : sizeType ) =:: public ArraySize
struct( Type : base i64 : sizeOffset i64 : dims bool : fixedSize bool : mut ptrOnly bool : mutable ) =:: ArrayType

proc( Type TypeContext ptr => bool ) =: public isPointer
  unwrapNamed .pointer ?? return
end
proc( Type TypeContext ptr => bool ) =: public isArray
  unwrapNamed .arrayType ?? return
end
proc( Type TypeContext ptr => bool ) =: public isReference
  unwrapNamed
  #dup .reference ?? #swap .mutableReference ?? | return
end
proc( Type TypeContext ptr => bool ) =: public isFixedSize
  =:: context
  context unwrapNamed
  #dup .pointer ?? if
    context [] .arrayTypes #swap .pointer list.get .fixedSize return
  end
  #dup .arrayType ?? if
    context [] .arrayTypes #swap .arrayType list.get .fixedSize return
  end #drop
  false return
end
proc( Type TypeContext ptr => bool ) =: public isFixedSizePtr
  =:: context
  context unwrapNamed
  #dup .pointer ?? if
    context [] .arrayTypes #swap .pointer list.get .fixedSize return
  end #drop
  false return
end
proc( Type TypeContext ptr => bool ) =: public isRawPointer
  =:: context
  context unwrapNamed
  #dup .pointer ?? if
    context [] .arrayTypes #swap .pointer list.get .fixedSize ! return
  end #drop
  false return
end
proc( Type : box TypeContext ptr : context => Type ) =: public getBaseType
  box context unwrapNamed
    #dup context isPointer if
      context [] .arrayTypes #swap .pointer list.get .base return
    end
    #dup context isArray if
      context [] .arrayTypes #swap .arrayType list.get .base return
    end
    #dup .reference ?? if
      context [] .compositeData #swap .reference list.get return
    end
    #dup .mutableReference ?? if
      context [] .compositeData #swap .mutableReference list.get return
    end
  #drop
  Type .undefined return
end
proc( Type : box TypeContext ptr : context => i64 ) =: public getArrayDims
  box context unwrapNamed
    #dup context isPointer if
      context [] .arrayTypes #swap .pointer list.get =:: arrayType
      arrayType .dims
        arrayType .fixedSize ! if 1 + end
      return
    end
    #dup context isArray if
      context [] .arrayTypes #swap .arrayType list.get =:: arrayType
      arrayType .dims
        arrayType .fixedSize ! if 1 + end
      return
    end
  #drop
  0 return
end
proc( Type : box TypeContext ptr : context => ArraySize arrayView ) =: public getArraySize
  box context unwrapNamed
    #dup context isPointer if
      context [] .arrayTypes #swap .pointer list.get =:: arrayType
      context [] .arraySizes arrayType .sizeOffset arrayType .dims list.slice return
    end
    #dup context isArray if
      context [] .arrayTypes #swap .arrayType list.get =:: arrayType
      context [] .arraySizes arrayType .sizeOffset arrayType .dims list.slice return
    end
    #dup .arrayIndex ?? if
      context [] .arraySizes #swap .arrayIndex list.at .data array.wrap return
    end
  #drop
  ArraySize array.empty return
end
## type of the n-th array index (counted from left to right, zero indexed)
## the returned bool is true if no index has been found
proc( Type : box i32 : n TypeContext ptr : context => Type bool ) =: public getIndexType
  n 0 < if
    Type .undefined true return
  end
  box context unwrapNamed
    #dup context isPointer if
      context [] .arrayTypes #swap .pointer list.get
    else #dup context isArray _if
      context [] .arrayTypes #swap .arrayType list.get
    else #drop
     Type .undefined true return
    end
  =:: arrayType
  arrayType .fixedSize ! if
    n 0 == if
      primitive.I_SIZE false return
    end
    n
  else
    n 1 +
  end =:: delta
  delta arrayType .dims > if
     Type .undefined true return
  end
  arrayType .sizeOffset arrayType .dims + delta - types.SizeId cast Type .arrayIndex new false return
end

proc( Type TypeContext ptr => bool ) =: public isMutable
  =:: context
  context unwrapNamed
    #dup context isPointer if
      context [] .arrayTypes #swap .pointer list.get .mutable return
    end
  .mutableReference ?? return
end
proc( Type ptr mut : t bool : mutable TypeContext ptr mut : context => bool ) =: public setMutability
  t [] context isMutable  mutable == if
    false return
  end
  t [] .pointer ?? if
    context [] .arrayTypes t [] .pointer list.get =:: arrayType
    ## newArrayType
      t [] context getBaseType
      true
      arrayType .fixedSize if
        context [] .arraySizes arrayType .sizeOffset arrayType .dims list.slice
        true
      else
        ArraySize array.empty
        false
      end
      mutable
    context newArrayType if
      #drop true return
    end t [] =
    false return
  end
  ## XXX ? allow marking named pointer types as mutable
  true return
end
proc( ArraySize arrayView : a ArraySize arrayView : b => bool ) =: arraySizeEqual
  a .length b .length != if
    false return
  end
  0 while #dup a .length < do
    a #over array.get .sizeType b #over:2 array.get .sizeType != if
      #drop false return
    end
    a #over array.get .value b #over:2 array.get .value != if
      #drop false return
    end
    1 +
  end #drop
  true return
end
proc(
  Type : target
  bool : isPtr
  ArraySize arrayView : sizes
  bool : fixedSize
  bool : makeMutable
  TypeContext ptr mut : context
=> Type bool ) =: public newArrayType
  isPtr if makeMutable else false end =:: mutable
  isPtr ! sizes .length 0 == & if
    Type .undefined true return
  end
  target =:: mut base
  base .undefined ?? if
    Type .undefined true return
  end
  ## procedure types are only allowed as base for fixed-size 0 dimensional pointers
  base context isProcedure if
    isPtr ! fixedSize ! | sizes .length 0 > | if
      Type .undefined true return
    end
    base
      context asUnlabeledProc if #drop
        Type .undefined true return
      end
    base =
  end
  context [] .arrayTypes @ =:: arrays
  0 while #dup arrays [] .length < do
    arrays [] #over list.get
      #dup .mutable   mutable   != if #drop
        1 + continue
      end
      #dup .fixedSize fixedSize != if #drop
        1 + continue
      end
      fixedSize if #dup .dims sizes .length != if #drop
        1 + continue
      end end
      #dup .base base typeEquals ! if #drop
        1 + continue
      end
      context [] .arraySizes #over .sizeOffset #over:2 .dims list.slice sizes arraySizeEqual ! if #drop
        1 + continue
      end
    .ptrOnly isPtr & arrays [] #over:2 list.at .data [] .ptrOnly = ## update ptrOnly flag
    ## found match
    isPtr if ArrayId cast Type .pointer new else ArrayId cast Type .arrayType new end false return
  end #drop
  context [] .arraySizes
    #dup .length =:: sizeOffset
    sizes list.appendArray
  context [] .arraySizes =
  arrays []
    base sizeOffset sizes .length fixedSize isPtr mutable ArrayType new list.append
  arrays [] =
  arrays [] .length 1 - isPtr if ArrayId cast Type .pointer new else ArrayId cast Type .arrayType new end
  false return
end

## XXX flags are public for access from identifiers.concat
i32 =:: LabelOffset
-1 LabelOffset =: public UNLABELED

## composite types
i32 =:: public CompositeFlags
 0 =:: public COMP_FLAG_NONE
 1 =:: public COMP_FLAG_EMPTY
 2 =:: public COMP_FLAG_ONLY_EMPTY
 3 =:: public COMP_MASK_ONLY_EMPTY
 4 =:: public COMP_FLAG_STATIC_ARGS
 8 =:: public COMP_FLAG_TEMPLATE
15 =:: public COMP_MASK_COMMON_FLAGS
12 =:: public COMP_GENERIC_MASK
16 =:: public TUPLE_FLAG_IS_STRUCT
32 =:: public TUPLE_FLAG_IS_PROC_IN
64 =:: public TUPLE_FLAG_IS_PROC_OUT
struct(
  i64 : eltCount
  i64 : eltsOffset
  LabelOffset : labelOffset
  i64 : alignment
  i64 : size
  CompositeFlags : mut flags
) =:: public CompositeInfo
struct(
  CompositeInfo : mut compositeInfo
  i64  : offsetsStart
) =:: TupleInfo
struct(
  CompositeInfo : compositeInfo
  i64 : enumLabelOffset
  Type  : labelType
) =:: UnionInfo

proc( Type TypeContext ptr => bool ) =: public isComposite
  unwrapNamed
  switch
    struct enum union procIn procOut case
      true return
    undefined empty primitiveType pointer arrayType procedure
      namedType autoType genericType templateType generatedType
      reference mutableReference arrayIndex cType case
      false return
  end
end
proc( Type TypeContext ptr => bool ) =: public isTuple
  unwrapNamed .struct ?? return
end
proc( Type TypeContext ptr => bool ) =: public isEnum
  unwrapNamed .enum ?? return
end
proc( Type TypeContext ptr => bool ) =: public isUnion
  unwrapNamed .union ?? return
end
proc( Type TypeContext ptr => bool ) =: public isProcOut
  unwrapNamed .procOut ?? return
end
proc( Type : composite TypeContext ptr : context => CompositeInfo ptr optional ) =: compositeData
  composite context unwrapNamed
    #dup switch
      struct case
        context [] .tupleTypes #swap .struct
          list.at .data [] .compositeInfo @
        CompositeInfo ptr cast optional.wrap return
        break
      procIn case
        context [] .tupleTypes #swap .procIn
          list.at .data [] .compositeInfo @
        CompositeInfo ptr cast optional.wrap return
        break
      procOut case
        context [] .tupleTypes #swap .procOut
          list.at .data [] .compositeInfo @
        CompositeInfo ptr cast optional.wrap return
        break
      union case
        context [] .unionTypes #swap .union
          list.at .data [] .compositeInfo @
        CompositeInfo ptr cast optional.wrap return
        break
      enum case
        context [] .unionTypes #swap .enum
          list.at .data [] .compositeInfo @
        CompositeInfo ptr cast optional.wrap return
        break
      undefined empty primitiveType pointer arrayType procedure
       namedType autoType genericType templateType generatedType
       reference mutableReference arrayIndex cType case
        #drop CompositeInfo ptr optional.empty return
    end
end
proc( Type : composite TypeContext ptr : context => i64 ) =: public compositeEltCount
  composite context compositeData
    #dup optional.isEmpty if #drop
      0 return
    end
  .data [] .eltCount return
end
proc( Type : composite i32 : index TypeContext ptr : context => LabelId ) =: public compositeGetLabel
  composite context unwrapNamed
    #dup switch
      struct enum union procIn procOut case
        break
      undefined empty primitiveType pointer arrayType procedure
       namedType autoType genericType templateType generatedType
        reference mutableReference arrayIndex cType case
        #drop id.LABEL_ID_NONE return
    end
  context compositeData
    #dup optional.isEmpty if #drop
      id.LABEL_ID_NONE return
    end
  .data [] .labelOffset =:: offset
  offset UNLABELED == if
    id.LABEL_ID_NONE return
  end
  context [] .elementLabels offset index + list.get return
end
proc( Type : composite LabelId : name LabelContext ptr : labelContext TypeContext ptr : context => i32 ) =: public compositeFindLabel
  composite context unwrapNamed
    #dup switch
      struct enum union procIn procOut case
        break
      undefined empty primitiveType pointer arrayType procedure
       namedType autoType genericType templateType generatedType
       reference mutableReference arrayIndex cType case
        #drop -1 return
    end
  context compositeData
    #dup optional.isEmpty if #drop
      -1 return
    end
  .data =:: labels
  labels [] .labelOffset UNLABELED == if
