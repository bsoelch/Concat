import core
import list
import slice
import string
import stringBuilder
import arenaAlloc
import map
using std.literals.

import "names.concat"
import "constants.concat"

namespace: types
  enum(
    BOOL
    I8 I16 I32 I64
    F16 F32 F64
    TYPE
  ) =:: export: PrimitiveType
  type : ArrayData
  type : CompositeInfo
  type : TupleInfo
  type : UnionInfo
  type : UnionElementInfo
  type : EnumInfo
  type : InitializerInfo
  type : ProcType
  type : GeneratedTypeName
  type : SetType
  type : RefinementType
  ArrayData ptr =:: ArrayId
  TupleInfo ptr.mut =:: TupleId
  UnionInfo ptr.mut =:: UnionId
  UnionElementInfo ptr =:: UnionElementId
  EnumInfo ptr =:: EnumId
  InitializerInfo ptr.mut =:: InitializerId
  ProcType ptr =:: ProcTypeId
  GeneratedTypeName ptr =:: GeneratedTypeId
  SetType ptr =:: export: SetTypeId
  RefinementType ptr =:: export: RefinementTypeId
  ## primitive C-types for C interoperability
  enum(
    VOID BOOL
    CHAR S_CHAR U_CHAR
    SHORT U_SHORT
    INT U_INT
    LONG LONGLONG U_LONG U_LONGLONG SIZE
    FLOAT DOUBLE
    ## XXX? add support for long double
    STRUCT UNION
  ) =:: CType
  enum(
    U7  S8  U8  ## largest numbers castable to i8;  -> i32 by default
    ## TODO? add U/S values for largest value fitting in f16
    U15 S16 U16 ## largest numbers castable to i16; -> i32 by default
    U24 S25   ## largest numbers castable to f32 ( -2^24 <= k <= 2^24 ); -> i32 by default
    U31 S32 U32 ## -> i32
    U53 S54   ## largest numbers castable to f64 ( -2^53 <= k <= 2^53 ); -> i64 by default
    U63 S64 U64 ## -> i64
    ## XXX? support for 128Bit integer literals
  ) =:: IntLiteral
end

union(
                      _ : Undefined
                      _ : Empty
    types.PrimitiveType : PrimitiveType
       types.IntLiteral : IntLiteral
            types.CType : CType
                    i32 : Align
          types.ArrayId : Pointer
          types.ArrayId : MutablePointer
          types.ArrayId : RawPointer
          types.ArrayId : MutableRawPointer
          types.ArrayId : ArrayType
          types.TupleId : Struct
          types.TupleId : TaggedUnion
          types.UnionId : RawUnion
   types.UnionElementId : UnionElement
           types.EnumId : Enum
    types.InitializerId : Initializer
       types.ProcTypeId : Procedure
        types.SetTypeId : SetType
 types.RefinementTypeId : RefinementType
                NameId : GenericType
                NameId : NamedType
  types.GeneratedTypeId : GeneratedType
) =:: export: Type

namespace: types
  proc( ArrayId : a ArrayId : b -> i32 ) =>: arrayTypeCmp
    a b == if 0 return end
    a ArrayData ptr cast =:: aData
    b ArrayData ptr cast =:: bData
    aData [] .size bData [] .size arraySizeCmp
      $ ? if return else ..drop end
    aData [] .base bData [] .base typeCmp return
  end
  ## TODO ensure type-hash function returns distinct values for common small types
  ## TODO? cache results of hash-computation
  proc( ArrayId : a -> i32 ) =>: arrayTypeHash
    a ArrayData ptr cast =:: aData
    aData [] .size arraySizeHash 31 * aData [] .base typeHash +
  end
  ## TODO? should flags be required to be equal
  ##  * figure out why identical types can have different flags
  proc( CompositeInfo ptr : a CompositeInfo ptr : b -> i32 ) =>: compositeTypeCmp
    a b == if 0 return end
    a .elements [] .length b .elements [] .length != if
      a .elements [] .length b .elements [] .length iSize.cmp return
    end
    ## TODO? should types that only differ by missing eltNames (id.NONE vs no identifier) be treated differently
    a [] .eltNames ? b [] .eltNames ? != if
      a [] .eltNames ? if 1 else -1 end return
    end
    a [] .elements b [] .elements typeCmp@ slice.cmp
      $ ? if return else ..drop end
    a [] .eltNames .if
      b .eltNames [] optional.unwrap NameId.cmpNameO@ slice.cmp return
    end
    0 return
  end
  proc( CompositeInfo ptr : a -> i32 ) =>: compositeTypeHash
    0:i32
      a [] .eltNames .if NameId.hashNameO@ slice.hash
        >$ 31 * +
      end
      31 * a [] .elements typeHash@ slice.hash +
    return
  end
  proc( TupleId : a TupleId : b -> i32 ) =>: tupleTypeCmp
    a b == if 0 return end
    a TupleInfo ptr cast =:: aData
    b TupleInfo ptr cast =:: bData
    aData .compositeInfo bData .compositeInfo compositeTypeCmp
  end
  proc( TupleId : a -> i32 ) =>: tupleTypeHash
    a TupleInfo ptr cast =:: aData
    aData .compositeInfo compositeTypeHash
  end
  proc( UnionId : a UnionId : b -> i32 ) =>: unionTypeCmp
    a b == if 0 return end
    a UnionInfo ptr cast =:: aData
    b UnionInfo ptr cast =:: bData
    aData .compositeInfo bData .compositeInfo compositeTypeCmp
  end
  proc( UnionId : a -> i32 ) =>: unionTypeHash
    a UnionInfo ptr cast =:: aData
    aData .compositeInfo compositeTypeHash return
  end
  proc( UnionElementId : a UnionElementId : b -> i32 ) =>: unionElementCmp
    a b == if 0 return end
    a UnionElementInfo ptr cast =:: aData
    b UnionElementInfo ptr cast =:: bData
    aData [] .index bData [] .index != if
      aData [] .index bData [] .index i32.cmp return
    end
    aData [] .base bData [] .base typeCmp
  end
  proc( UnionElementId : a -> i32 ) =>: unionElementHash
    a UnionElementInfo ptr cast =:: aData
    aData [] .index
      31 * aData [] .base typeHash +
    return
  end
  proc( EnumId : a EnumId : b -> i32 ) =>: enumTypeCmp
    a b == if 0 return end
    a EnumInfo ptr cast [] =:: aData
    b EnumInfo ptr cast [] =:: bData
    aData .tagType bData .tagType typeCmp
      $ ? if return else ..drop end
    aData .eltNames bData .eltNames NameId.cmpName@ slice.cmp return
  end
  proc( EnumId : a -> i32 ) =>: enumTypeHash
    a EnumInfo ptr cast [] =:: aData
    aData .tagType typeHash
      31 * aData .eltNames NameId.hashName@ slice.hash +
    return
  end
  proc( InitializerId : a InitializerId : b -> i32 ) =>: initializerTypeCmp
    a b == if 0 return end
    a .asTuple TupleId cast b .asTuple TupleId cast tupleTypeCmp
  end
  proc( InitializerId : a -> i32 ) =>: initializerTypeHash
    a .asTuple TupleId cast tupleTypeHash
  end
  proc( ProcTypeId : a ProcTypeId : b -> i32 ) =>: procTypeCmp
    a b == if 0 return end
    a ProcType ptr cast =:: aData
    b ProcType ptr cast =:: bData
    aData [] .callingConvention bData [] .callingConvention != if
      aData [] .callingConvention ..tag bData [] .callingConvention ..tag <=> return
    end
    aData [] .inTypes .length bData [] .inTypes .length != if
      aData [] .inTypes .length bData [] .inTypes .length iSize.cmp return
    end
    aData [] .outTypes .length bData [] .outTypes .length != if
      aData [] .outTypes .length bData [] .outTypes .length iSize.cmp return
    end
    aData [] .eltNames .length bData [] .eltNames .length != if
      aData [] .eltNames .length bData [] .eltNames .length iSize.cmp return
    end
    aData [] .inTypes bData [] .inTypes typeCmp@ slice.cmp
      $ ? if return else ..drop end
    aData [] .outTypes bData [] .outTypes typeCmp@ slice.cmp
      $ ? if return else ..drop end
    aData [] .eltNames bData [] .eltNames NameId.cmpNameO@ slice.cmp return
  end
  proc( ProcTypeId : a -> i32 ) =>: export: procTypeHash
    a ProcType ptr cast =:: aData
    aData [] .callingConvention ..tag i32 cast.u
      31 * aData [] .inTypes typeHash@ slice.hash +
      31 * aData [] .outTypes typeHash@ slice.hash +
      31 * aData [] .eltNames NameId.hashNameO@ slice.hash +
    return
  end
  proc( GeneratedTypeId : a GeneratedTypeId : b -> i32 ) =>: export: generatedTypeCmp
    a b == if 0 return end
    a GeneratedTypeName ptr cast [] b GeneratedTypeName ptr cast [] genNameCmp
  end
  proc( GeneratedTypeId : a -> i32 ) =>: export: generatedTypeHash
    a GeneratedTypeName ptr cast [] genNameHash
  end
  proc( SetTypeId : a SetTypeId : b -> i32 ) =>: setTypeCmp
    a b == if 0 return end
    a SetType ptr cast =:: aData
    b SetType ptr cast =:: bData
    aData [] .baseType bData [] .baseType typeCmp
      $ ? if return else ..drop end
    aData [] .elements bData [] .elements constantCmp@ slice.cmp return
  end
  proc( SetTypeId : a -> i32 ) =>: setTypeHash
    a SetType ptr cast =:: aData
    aData [] .baseType typeHash
      31 * aData [] .elements constantHash@ slice.hash +
    return
  end
  proc( RefinementTypeId : a RefinementTypeId : b -> i32 ) =>: refinementTypeCmp
    a b == if 0 return end
    a RefinementType ptr cast =:: aData
    b RefinementType ptr cast =:: bData
    aData [] .typeTrait bData [] .typeTrait ProcId.cmp
      $ ? if return end
    ..drop
    aData [] .baseType bData [] .baseType typeCmp return
  end
  proc( RefinementTypeId : a -> i32 ) =>: refinementTypeHash
    a RefinementType ptr cast =:: aData
    aData [] .baseType typeHash
      31 * aData [] .typeTrait ProcId.hash +
    return
  end
  proc( Type : a Type : b -> bool ) =>: export: typeEquals
    a b typeCmp 0 ==
  end
  proc( Type : a Type : b -> i32 ) =>: export: typeCmp
    a ..tag b ..tag != if
      a ..tag b ..tag <=> return
    end
    a switch
      Undefined  Empty case
        0 return ## there is only one undefined/empty type
      PrimitiveType .case
        primitiveId b .PrimitiveType unionElement.unwrap primitiveId i32.cmp return
      IntLiteral .case
        intLiteralId b .IntLiteral unionElement.unwrap intLiteralId i32.cmp return
      CType .case
        cTypeId b .CType unionElement.unwrap cTypeId i32.cmp return
      Align .case
        b .Align unionElement.unwrap i32.cmp return
      NamedType .case
        b .NamedType unionElement.unwrap NameId.cmp return
      GenericType .case
        b .GenericType unionElement.unwrap NameId.cmp return
      Pointer .case
        b .Pointer unionElement.unwrap arrayTypeCmp return
      MutablePointer .case
        b .MutablePointer unionElement.unwrap arrayTypeCmp return
      RawPointer .case
        b .RawPointer unionElement.unwrap arrayTypeCmp return
      MutableRawPointer .case
        b .MutableRawPointer unionElement.unwrap arrayTypeCmp return
      ArrayType .case
        b .ArrayType unionElement.unwrap arrayTypeCmp return
      Struct .case
        b .Struct unionElement.unwrap tupleTypeCmp return
      Enum .case
        b .Enum unionElement.unwrap enumTypeCmp return
      TaggedUnion .case
        b .TaggedUnion unionElement.unwrap tupleTypeCmp return
      RawUnion .case
        b .RawUnion unionElement.unwrap unionTypeCmp return
      UnionElement .case
        b .UnionElement unionElement.unwrap unionElementCmp return
      Initializer .case
        b .Initializer unionElement.unwrap initializerTypeCmp return
      Procedure .case
        b .Procedure unionElement.unwrap  procTypeCmp return
      GeneratedType .case
        b .GeneratedType unionElement.unwrap generatedTypeCmp return
      SetType .case
        b .SetType unionElement.unwrap setTypeCmp return
      RefinementType .case
        b .RefinementType unionElement.unwrap refinementTypeCmp return
    end
  end
  proc( PrimitiveType -> i32 ) =>: primitiveId
    switch
      BOOL case 1 return
      I8 case 2 return
      I16 case 3 return
      I32 case 4 return
      I64 case 5 return
      F16 case 6 return
      F32 case 7 return
      F64 case 8 return
      TYPE case 9 return
    end
  end
  proc( IntLiteral -> i32 ) =>: intLiteralId
    switch
      U7  case  1 return
      S8  case  2 return
      U8  case  3 return
      U15 case  4 return
      S16 case  5 return
      U16 case  6 return
      U24 case  7 return
      S25 case  8 return
      U31 case  9 return
      S32 case 10 return
      U32 case 11 return
      U53 case 12 return
      S54 case 13 return
      U63 case 14 return
      S64 case 15 return
      U64 case 16 return
    end
  end
  proc( CType -> i32 ) =>: cTypeId
    switch
      VOID case 0 return
      BOOL case 1 return
      CHAR case 2 return
      S_CHAR case 3 return
      U_CHAR case 4 return
      SHORT  case 5 return
      U_SHORT case 6 return
      INT case 7 return
      U_INT case 8 return
      LONG  case 9 return
      LONGLONG  case 10 return
      U_LONG  case 11 return
      U_LONGLONG  case 12 return
      SIZE case 13 return
      FLOAT case 14 return
      DOUBLE case 15 return
      STRUCT case 16 return
      UNION case 17 return
    end
  end
  ## TODO? use larger primes to reduce collisions for small entries
  proc( Type : a -> i32 ) =>: export: typeHash
    a switch
      Undefined case
        0 return ## there is only one undefined
      Empty case
        1 return ## there is only one empty type
      PrimitiveType .case primitiveId 1 + 2 * return
      IntLiteral .case intLiteralId 1 + 3 * return
      CType .case cTypeId 1 + 5 * return
      Align .case 1 + 7 * return
      NamedType .case NameId.hash 1 + 11 * return
      GenericType .case NameId.hash 1 + 13 * return
      ArrayType .case arrayTypeHash 17 * return
      Pointer .case arrayTypeHash 19 * return
      RawPointer .case arrayTypeHash 23 * return
      MutablePointer .case arrayTypeHash 29 * return
      MutableRawPointer .case arrayTypeHash 31 * return
      Struct .case tupleTypeHash 37 * return
      Enum .case enumTypeHash 41 * return
      TaggedUnion .case tupleTypeHash 43 * return
      Procedure .case procTypeHash 47 * return
      GeneratedType .case generatedTypeHash 53 * return
      Initializer .case initializerTypeHash 59 * return
      UnionElement .case unionElementHash 61 * return
      RawUnion .case unionTypeHash 67 * return
      SetType .case setTypeHash 71 * return
      RefinementType .case refinementTypeHash 73 * return
    end
  end
end

type : export: TypeContext
namespace: types
  ## primitive types
  namespace: primitive
    PrimitiveType .BOOL Type .PrimitiveType Type =: export: BOOL
    PrimitiveType .I8   Type .PrimitiveType Type =: export: I8
    PrimitiveType .I16  Type .PrimitiveType Type =: export: I16
    PrimitiveType .I32  Type .PrimitiveType Type =: export: I32
    PrimitiveType .I64  Type .PrimitiveType Type =: export: I64
    PrimitiveType .F16  Type .PrimitiveType Type =: export: F16
    PrimitiveType .F32  Type .PrimitiveType Type =: export: F32
    PrimitiveType .F64  Type .PrimitiveType Type =: export: F64
    PrimitiveType .TYPE Type .PrimitiveType Type =: export: TYPE
    ## compiler internal type-aliases for special purpose types
    PrimitiveType .I8   Type .PrimitiveType Type =: export: CHAR8
    PrimitiveType .I64  Type .PrimitiveType Type =: export: I_SIZE ## integer with size to hold pointers/sizes
    PrimitiveType .I64  Type .PrimitiveType Type =: export: I_MAX  ## largest native integer type
  end
  primitive.I_SIZE =:: mut: export: I_SIZE
  primitive.I_SIZE =:: mut: export: CHAR8
  namespace: intLiteral
    IntLiteral .U7  Type .IntLiteral Type =: export: U7
    IntLiteral .S8  Type .IntLiteral Type =: export: S8
    IntLiteral .U8  Type .IntLiteral Type =: export: U8
    IntLiteral .U15 Type .IntLiteral Type =: export: U15
    IntLiteral .S16 Type .IntLiteral Type =: export: S16
    IntLiteral .U16 Type .IntLiteral Type =: export: U16
    IntLiteral .U24 Type .IntLiteral Type =: export: U24
    IntLiteral .S25 Type .IntLiteral Type =: export: S25
    IntLiteral .U31 Type .IntLiteral Type =: export: U31
    IntLiteral .S32 Type .IntLiteral Type =: export: S32
    IntLiteral .U32 Type .IntLiteral Type =: export: U32
    IntLiteral .U53 Type .IntLiteral Type =: export: U53
    IntLiteral .S54 Type .IntLiteral Type =: export: S54
    IntLiteral .U63 Type .IntLiteral Type =: export: U63
    IntLiteral .S64 Type .IntLiteral Type =: export: S64
    IntLiteral .U64 Type .IntLiteral Type =: export: U64
  end
  proc( Type -> bool ) =>: export: isPrimitive
    .PrimitiveType ? return
  end
  proc( Type : t TypeContext ptr : context -> PrimitiveType ) =>: export: primitiveValue
    t context unwrapNamed
      ## TODO? unwrap c-types
    .PrimitiveType .else
      "called primitive value on non-primitive type" ..panic
    end return
  end
  proc( Type : t0 TypeContext ptr : context -> bool ) =>: export: isEmpty ## TODO? should pointer to empty be empty
    t0 context unwrapNamed =:: t
    t switch
       Empty Align case true return
       ArrayType case
         ## arrays of empty values are empty
         t context getBaseType context isEmpty return
       Undefined PrimitiveType Procedure  CType Pointer MutablePointer MutableRawPointer RawPointer
         NamedType GenericType IntLiteral UnionElement
         GeneratedType Enum RefinementType TaggedUnion case false return
       SetType .case .elements [] .length 0 == return
       Struct Initializer RawUnion case
         t context compositeFlags COMP_FLAG_EMPTY & ? return
    end
  end

  proc( PrimitiveType -> bool ) =>: isIntPrimitive
    switch
      BOOL F16 F32 F64 TYPE case
        false return
      I8 I16 I32 I64 case
        true return
    end
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isInt
    unwrapNamed
      $ .IntLiteral ? if ..drop
        true return
      end
    .PrimitiveType .else ..drop
      false return
    end isIntPrimitive
  end
  ## integer or cType integer
  proc( Type TypeContext ptr : context -> bool ) =>: export: isIntLike
    context unwrapNamed =:: t
    t .CType .if
      switch
        S_CHAR CHAR U_CHAR SHORT U_SHORT INT U_INT
          LONG U_LONG LONGLONG U_LONGLONG SIZE case true return
        VOID BOOL FLOAT DOUBLE STRUCT UNION case false return
      end
    else
      context isInt return
    end
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isSignedInt
    unwrapNamed
      .CType .if
        switch
          S_CHAR SHORT INT LONG LONGLONG case true return
          VOID BOOL CHAR U_CHAR U_SHORT U_INT U_LONG U_LONGLONG SIZE
            FLOAT DOUBLE STRUCT UNION case false return
        end
      else .IntLiteral ._if
        switch
          U7 U15 U24 U31 U53 U63 S8 S16 S25 S32 S54 S64 case true return
          U8 U16 U32 U64 case false return
        end
      else ..drop end
    false return
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isUnsignedInt
    unwrapNamed
      .CType .if
        switch
          U_CHAR U_SHORT U_INT U_LONG U_LONGLONG SIZE case true return
          VOID BOOL CHAR S_CHAR SHORT INT LONG LONGLONG
            FLOAT DOUBLE STRUCT UNION case false return
        end
      else .IntLiteral ._if
        switch
          U7 U8 U15 U16 U24 U31 U32 U53 U63 U64 case true return
          S8 S16 S25 S32 S54 S64 case false return
        end
      else ..drop end
    false return
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isFloat
    unwrapNamed
      .PrimitiveType .if
        switch
          BOOL I8 I16 I32 I64 TYPE case
            false return
          F16 F32 F64 case
            true return
        end
      else ..drop end
    false return
  end
  ## internally f16 is represented as int in QBE backend
  proc( Type TypeContext ptr -> bool ) =>: export: isTrueFloat
    unwrapNamed
      .PrimitiveType .if
        switch
          BOOL I8 I16 I32 I64 F16 TYPE case
            false return
          F32 F64 case
            true return
        end
      else ..drop end
    false return
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isNumber
    unwrapNamed
      .PrimitiveType .if
        switch
          BOOL TYPE case
            false return
          I8 I16 I32 I64 F16 F32 F64 case
            true return
        end
      else ..drop end
    false return
  end
  proc( Type TypeContext ptr : _ -> bool ) =>: export: isChar
    CHAR8 typeEquals return
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isIntOrChar ## TODO better name
    unwrapNamed
      .PrimitiveType .if
        switch
          BOOL TYPE F16 F32 F64 case
            false return
          I8 I16 I32 I64 case
            true return
        end
      else ..drop end
    false return
  end
  proc( Type -> bool ) =>: export: isLiteral
    switch
       IntLiteral Initializer case true return
       Empty ArrayType UnionElement RawUnion
           Undefined PrimitiveType Procedure  CType Pointer
           NamedType GenericType RawPointer
           GeneratedType Enum Align MutablePointer MutableRawPointer
           Struct TaggedUnion SetType RefinementType case
         false return
    end
  end
  proc( Type : t TypeContext ptr.mut : context -> Type ) =>: export: literalToType
    t switch
       IntLiteral .case intLiteralAsInt return
       Initializer .case InitializerInfo ptr.mut cast =:: initInfo
        ## TODO? store initialiter elements directly in initialiter data
        initInfo .asTuple TupleInfo ptr cast =:: tupleInfo
        tupleInfo .compositeInfo .elements [] .length =:: eltCount
        initInfo .arrayType .Undefined  ? ! if
          initInfo [] .arrayType context literalToType =:: baseType
          eltCount i64 cast.u ArraySize .Int =:: size
          ## newArrayType
            baseType
            ArrayType .ARRAY
            size
          context newArrayType .else
            "failed to create array-type" ..panic
          end return
        end
        tupleInfo .compositeInfo .flags [] COMP_FLAG_CONTAINS_LITERAL & ? if
          context [] .memory
            eltCount i32 cast.u Type mixedArena.allocSlice =:: newElements
          context .memory=
          tupleInfo .compositeInfo [] .elements =:: oldElts
          0:iSize while $ eltCount u< do =:: i
            oldElts i [] context literalToType newElements i =[]
          finally i 1:iSize + end ..drop
          ## newTuple
            newElements slice.freeze
            tupleInfo .compositeInfo [] .eltNames
            context
          newTuple  .else
            "failed to create tuple-type" ..panic
          end return
        end
        initInfo .asTuple TupleId cast Type .Struct return
       Empty  ArrayType UnionElement RawUnion
           Undefined  PrimitiveType Procedure CType Pointer
           NamedType GenericType RawPointer
           GeneratedType Enum Align MutablePointer MutableRawPointer
           Struct TaggedUnion SetType RefinementType case
         t return
    end
  end

  ## does value fit in 2*64-bit values
  proc( Type TypeContext ptr.mut -> bool ) =>: export: isSmallType
    sizeOf =:: size
    size switch
      Fixed .case 16 <= return ## more than 2*i64
      DynamicArray case false return
      Unknown case ..unreachable ## TODO? error message
    end
  end
  ## can value be pushed onto stack
  proc( Type TypeContext ptr.mut -> bool ) =>: export: referenceOnly
    isSmallType ! return ## XXX ? allow larger stack values
  end
  64 =:: export: MAX_INT_WIDTH
  i64.MAX =:: export: MAX_SIGNED_INT
  proc( Type : src Type : target TypeContext ptr : context -> bool ) =>: canAutoCastIntLiteral
    target context types.isNumber ! or src .IntLiteral ! .if
      true return
    end switch
      U7  case false  7:i64 break
      S8  case true   8:i64 break
      U8  case false  8:i64 break
      U15 case false 15:i64 break
      S16 case true  16:i64 break
      U16 case false 16:i64 break
      U24 case false 24:i64 break
      S25 case true  24:i64 break
      U31 case false 31:i64 break
      S32 case true  32:i64 break
      U32 case false 32:i64 break
      U53 case false 53:i64 break
      S54 case true  53:i64 break
      U63 case false 63:i64 break
      S64 case true  64:i64 break
      U64 case false 64:i64 break
    end =:: srcBits =:: srcSigned
    target context primitiveValue =:: targetPrimitive
    targetPrimitive isIntPrimitive if
      targetPrimitive sizeOfPrimitive 8 * =:: targetBits
      srcBits targetBits <= return
    else targetPrimitive .F16 _if
      true return ## TODO support cast to F16
    else targetPrimitive .F32 _if
      srcBits 24 <= return
    else targetPrimitive .F64 _if
      srcBits 53 <= return
    end
    ..unreachable
  end
  proc( Type : src Type : target TypeContext ptr : context -> bool ) =>: canAutoCastNumber
    src context types.isNumber ! target context types.isNumber ! | if
      true return
    end
    src context primitiveValue =:: srcPrimitive
    target context primitiveValue =:: targetPrimitive
    srcPrimitive targetPrimitive == if
      true return
    end
    srcPrimitive isIntPrimitive and targetPrimitive isIntPrimitive if
      srcPrimitive sizeOfPrimitive =:: srcBytes
      targetPrimitive sizeOfPrimitive =:: targetBytes
      srcBytes targetBytes == return ## cast I... <-> U...
    end
    false return
  end
  ## ctypes
  namespace: ctype
    CType .VOID        Type .CType Type =: export: VOID
    CType .BOOL        Type .CType Type =: export: BOOL
    CType .CHAR        Type .CType Type =: export: CHAR
    CType .S_CHAR      Type .CType Type =: export: S_CHAR
    CType .U_CHAR      Type .CType Type =: export: U_CHAR
    CType .SHORT       Type .CType Type =: export: SHORT
    CType .U_SHORT     Type .CType Type =: export: U_SHORT
    CType .INT         Type .CType Type =: export: INT
    CType .U_INT       Type .CType Type =: export: U_INT
    CType .LONG        Type .CType Type =: export: LONG
    CType .U_LONG      Type .CType Type =: export: U_LONG
    CType .LONGLONG    Type .CType Type =: export: LONGLONG
    CType .U_LONGLONG  Type .CType Type =: export: U_LONGLONG
    CType .SIZE        Type .CType Type =: export: SIZE
    CType .FLOAT       Type .CType Type =: export: FLOAT
    CType .DOUBLE      Type .CType Type =: export: DOUBLE
    CType .STRUCT      Type .CType Type =: export: STRUCT
    CType .UNION       Type .CType Type =: export: UNION
  end
  proc( CType -> Type ) =>: export: cTypeAsType
    switch
      VOID STRUCT UNION case Type .Empty  return
      BOOL case primitive.BOOL return
      CHAR S_CHAR U_CHAR case primitive.I8 return
      SHORT U_SHORT case primitive.I16 return
      INT U_INT case primitive.I32 return
      LONG LONGLONG U_LONG U_LONGLONG SIZE case primitive.I64 return
      FLOAT case primitive.F32 return
      DOUBLE case primitive.F64 return
    end
  end
  proc( types.IntLiteral -> Type ) =>: export: intLiteralAsInt
    switch
      U7 S8 U8 U15 S16 U16 case primitive.I32 return
      U24 S25 U31 S32 U32  case primitive.I32 return
      U53 S54 U63 S64 U64  case primitive.I64 return
    end
  end

  ## size and alignment
  union( _ : Unknown i64 : Fixed i64 : DynamicArray ) =:: export: TypeSize
  8:i64 =:: PTR_SIZE
  8:i64 =:: PTR_ALIGN
  8:i64 =:: I_SIZE_SIZE
  8:i64 =:: I_SIZE_ALIGN
  proc( PrimitiveType -> i64 ) =>: export: sizeOfPrimitive
    switch
      TYPE case
        0 return
      BOOL I8 case
        1 return
      I16 F16 case
        2 return
      I32 F32 case
        4 return
      I64 F64 case
        8 return
    end
  end
  proc( IntLiteral -> i64 ) =>: intLiteralBytes
    switch
      U7 S8 U8            case 1 return
      U15 S16 U16         case 2 return
      U24 S25 U31 S32 U32 case 4 return
      U53 S54 U63 S64 U64 case 8 return
    end
  end
  proc( IntLiteral -> i64 ) =>: export: sizeOfIntLiteral
    switch
      U7 S8 U8 U15 S16 U16 case 4 return
      U24 S25 U31 S32 U32  case 4 return
      U53 S54 U63 S64 U64  case 8 return
    end
  end
  proc( CType -> i64 ) =>: sizeOfCType
    switch ## sizes for linux-x86-gcc
      BOOL CHAR S_CHAR U_CHAR VOID case 1 return
      SHORT U_SHORT case 2 return
      INT U_INT case 4 return
      LONG LONGLONG U_LONG U_LONGLONG SIZE case 8 return
      FLOAT case 4 return
      DOUBLE case 8 return
      STRUCT UNION case 0 return ## structs should not be used directly
    end
  end

  proc(
    Type : t
    TupleId : tupleId
    TypeContext ptr.mut : typeContext
  -> bool ) =>: tryComputeTupleSize
    tupleId TupleInfo ptr.mut cast =:: tupleInfo
    tupleInfo [] .compositeInfo .flags COMP_SIZE_KNOWN & ? if
      false return ## size already known
    end
    t typeContext compositeElts =:: elts
    1:i64 =:: mut: alignment
    0:i64 =:: mut: size
    typeContext [] .memory
      $ mixedArena.offset =:: memOffset
      elts .length i32 cast.u i64 mixedArena.allocSlice =:: offsetBuffer
    typeContext .memory=
    0:iSize =:: mut: offsetCount
    elts for =:: elt
      ## size and alignment
      elt typeContext alignOf .Fixed .else ..drop
        typeContext [] .memory memOffset mixedArena.reset typeContext .memory=
        true return ## elements are not fixed size
      end =:: eltAlign
      elt typeContext sizeOf .Fixed .else ..drop
        typeContext [] .memory memOffset mixedArena.reset typeContext .memory=
        true return ## elements are not fixed size
      end =:: eltSize
      eltAlign alignment > if
        eltAlign alignment=
      end
      size eltAlign alignSize =:: eltOffset
      eltOffset eltSize + size=
      eltOffset offsetBuffer offsetCount =[]
      offsetCount 1:iSize + offsetCount=
    end
    ## TODO? compress offset list ( reuse first few slots for common offset patterns: 0, 8, 16, 24, 0, 4, 8, 12
    offsetBuffer slice.freeze tupleInfo .elementOffsets=
    alignment tupleInfo .compositeInfo .alignment=
    size tupleInfo .compositeInfo .size=
    tupleInfo [] .compositeInfo .flags
      COMP_SIZE_KNOWN |
    tupleInfo .compositeInfo .flags=
    false return
  end
  proc(
    Type : t
    UnionId : unionId
    TypeContext ptr.mut : typeContext
  -> bool ) =>: tryComputeUnionSize
    unionId UnionInfo ptr.mut cast =:: unionInfo
    unionInfo [] .compositeInfo .flags COMP_SIZE_KNOWN & ? if
      false return ## size already known
    end
    t typeContext compositeElts =:: elts
    1:i64 =:: mut: alignment
    0:i64 =:: mut: size
    elts for =:: elt
      ## size and alignment
      elt typeContext sizeOf .Fixed .else ..drop
        false return
      end =:: eltSize
      elt typeContext alignOf .Fixed .else ..drop
        false return
      end =:: eltAlign
      eltAlign alignment > if
        eltAlign alignment=
      end
      eltSize size > if
        eltSize size=
      end
    end
    alignment unionInfo .compositeInfo .alignment=
    size unionInfo .compositeInfo .size=
    unionInfo [] .compositeInfo .flags
      COMP_SIZE_KNOWN |
    unionInfo .compositeInfo .flags=
    false return
  end
  proc(
    Type : composite
    TypeContext ptr.mut : typeContext
  -> bool ) =>: tryComputeSize
    composite switch
      Struct TaggedUnion .case composite >$ typeContext tryComputeTupleSize return
      RawUnion .case composite >$ typeContext tryComputeUnionSize return
      Initializer .case
        ## tryComputeUnionSize
          composite
          >$ InitializerInfo ptr.mut cast .asTuple TupleId cast
        typeContext tryComputeTupleSize return
      Undefined Empty GenericType RawPointer MutableRawPointer
      PrimitiveType IntLiteral CType ArrayType Enum UnionElement
      Pointer MutablePointer Procedure Align SetType RefinementType
      NamedType GeneratedType case ..unreachable ## XXX? use assertion
    end
  end
  ## alignment of type in bytes, will be a power of two
  proc( Type : t TypeContext ptr.mut : context -> TypeSize ) =>: export: alignOf
    t switch
      Undefined GenericType case
        TypeSize .Unknown return
      Empty case
        1 TypeSize .Fixed return
      Align .case i64 cast.u TypeSize .Fixed return
      PrimitiveType .case sizeOfPrimitive TypeSize .Fixed return
      IntLiteral .case sizeOfIntLiteral TypeSize .Fixed return
      CType .case sizeOfCType TypeSize .Fixed return
      Pointer MutablePointer RawPointer MutableRawPointer Procedure  case
        PTR_SIZE TypeSize .Fixed return
      ArrayType case
        t context getBaseType context alignOf return
      Struct TaggedUnion RawUnion Initializer case
        t context tryComputeSize if
          TypeSize .Unknown return
        end
        t context compositeData .Composite .else
          "unexpected composite-type" ..panic
        end =:: compData
        compData [] .alignment TypeSize .Fixed return
      UnionElement .case UnionElementInfo ptr cast [] .base context alignOf return
      Enum .case EnumInfo ptr cast [] .tagType context alignOf return
      NamedType case
        t context unwrapNamed context alignOf return
      GeneratedType case
        t context getGeneratedType context alignOf return
      SetType .case
        .baseType [] context alignOf return
      RefinementType .case
        .baseType [] context alignOf return
    end
  end
  ## return next multiple of a >= s, assumes that a is a power of 2
  proc( i64 : s i64 : a -> i64 ) =>: export: alignSize
    s
      a 1 - +
      a 1 - ~ &
    return
  end
  proc(
    Type : t
    bool : aligned
    TypeContext ptr.mut : context
  -> TypeSize ) =>: computeSize
    t switch
      Undefined GenericType case
        TypeSize .Unknown return
      Empty  case
        0 TypeSize .Fixed return
      Align .case =:: alignment
        aligned if alignment i64 cast.u else 0:i64 end TypeSize .Fixed return
      PrimitiveType .case sizeOfPrimitive TypeSize .Fixed return
      ## TODO? don't use fixed size for int literals
      IntLiteral .case sizeOfIntLiteral TypeSize .Fixed return
      CType .case sizeOfCType TypeSize .Fixed return
      Pointer MutablePointer RawPointer MutableRawPointer Procedure  case
        PTR_SIZE TypeSize .Fixed return
      ArrayType case
        t context getArraySize =:: arraySize
        t context getBaseType context strideOf =:: baseSize
        baseSize .Fixed .else ..drop
          TypeSize .Unknown return
        end =:: baseSizeVal
        arraySize switch
          None case baseSize return
          Int .case baseSizeVal *  TypeSize .Fixed return
          ## TODO! distinguish generic-size and runtime dynamic size
          Dynamic case baseSizeVal TypeSize .DynamicArray return
          GenericArg case baseSizeVal TypeSize .DynamicArray return
        end
        break
      Struct TaggedUnion RawUnion Initializer case
        t context tryComputeSize if
          TypeSize .Unknown return
        end
        t context compositeData .Composite .else
          "unexpected composite-type" ..panic
        end =:: compData
        compData [] .size
          aligned if
            compData [] .alignment alignSize
          end
        TypeSize .Fixed return
      UnionElement .case UnionElementInfo ptr cast [] .base aligned context computeSize return
      Enum .case EnumInfo ptr cast .tagType [] aligned context computeSize return
      NamedType case
        t context unwrapNamed aligned context computeSize return
      GeneratedType case
        t context getGeneratedType aligned context computeSize return
      SetType .case
        .baseType [] aligned context computeSize return
      RefinementType .case
        .baseType [] aligned context computeSize return
    end
  end
  ## size of value in bytes
  proc( Type : t TypeContext ptr.mut : context -> TypeSize ) =>: export: sizeOf
    t false context computeSize ## TODO? should size be smaller than stride
  end
  ## size padded to next multiple of alignment
  proc( Type : t TypeContext ptr.mut : context -> TypeSize ) =>: export: strideOf
    t true context computeSize
  end

  ## array & pointer types
  union( _ : None _ : Dynamic i64 : Int NameId : GenericArg ) =:: export: ArraySize
  struct(
    Type : base
    ArraySize : size
  ) =:: ArrayData

  proc( Type TypeContext ptr -> bool ) =>: export: isPointer
    unwrapNamed switch
      Pointer MutablePointer RawPointer MutableRawPointer case true return
      default false return
    end
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isArray
    unwrapNamed .ArrayType ? return
  end
  ## pointer to array-type ( fixed size and not 0D )
  proc( Type : t TypeContext ptr : context -> bool ) =>: export: isArrayPointer
    t context unwrapNamed
      .Pointer .else
      .MutablePointer ._else ..drop
      ## raw-pointer cannot be array-pointer
        false return
      end
    =:: arrayId
    arrayId ArrayData ptr cast [] .size =:: ptrSize
    ptrSize .None ? if
      false return
    end
    true return
  end
  proc( Type : t TypeContext ptr : context -> bool ) =>: export: isArrayLiteral
    t context unwrapNamed =:: base
    base .Initializer .else ..drop
      false return
    end InitializerInfo ptr cast [] .arrayType .Undefined  ? ! return
  end
  ## TODO? better name for "fixed-size"
  proc( Type TypeContext ptr -> bool ) =>: export: isFixedSize
     unwrapNamed =:: t
     t .Pointer ? or t .MutablePointer ? or t .ArrayType ? end return
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isFixedSizePtr
     unwrapNamed =:: t
     t .Pointer ? or t .MutablePointer ? end return
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isRawPointer
     unwrapNamed =:: t
     t .RawPointer ? or t .MutableRawPointer ? end return
  end
  proc( Type : box TypeContext ptr : context -> Type ) =>: export: getBaseType
    box context unwrapNamed switch
      Pointer MutablePointer RawPointer MutableRawPointer ArrayType .case
        ArrayData ptr cast [] .base return
      default Type .Undefined  return
    end
  end
  proc( Type : box TypeContext ptr : context -> ArraySize ) =>: export: getArraySize
    box context unwrapNamed
      switch
        Pointer MutablePointer RawPointer MutableRawPointer ArrayType .case break
        default ArraySize .None return
      end
    ArrayData ptr cast [] .size return
  end

  proc( Type TypeContext ptr -> bool ) =>: export: isMutable
    unwrapNamed
      $ .MutablePointer ? or $ .MutableRawPointer ? end
    >$ ..drop
    return
  end
  proc( ArraySize : a ArraySize : b -> bool ) =>: arraySizeEqual
    a ..tag b ..tag != if
      false return
    end
    a switch
      None Dynamic case true return
      Int .case b .Int unionElement.unwrap == return
      GenericArg .case b .GenericArg unionElement.unwrap NameId.eq return
    end
  end
  proc( ArraySize : a -> i32 ) =>: arraySizeHash
    a switch
      None case 1 return
      Dynamic case 2 return
      Int .case i32 cast.u 1 + 3 * return
      GenericArg .case NameId.hash 1 + -5 * return
    end
  end
  proc( ArraySize : a ArraySize : b -> i32 ) =>: arraySizeCmp
    a ..tag b ..tag != if
      a ..tag b ..tag <=> return
    end
    a switch
      None Dynamic case 0 return
      Int .case b .Int unionElement.unwrap i64.cmp return
      GenericArg .case b .GenericArg unionElement.unwrap NameId.cmp return
    end
  end
  enum( POINTER MUTABLE_POINTER RAW_POINTER MUTABLE_RAW_POINTER ARRAY ) =:: export: ArrayType
  ## TODO? switch to returning Type optional instead of Type+bool
  proc(
    Type : target
    ArrayType : arrayType
    ArraySize : size
    TypeContext ptr.mut : context
  -> Type optional ) =>: export: newArrayType
    context .nameContext =:: nameContext
    target =:: mut: base
    base .Undefined  ? if
      Type optional.empty  return
    end
    size .None ? and base .ArrayType .if
      arrayType .POINTER if
        Type .Pointer optional.wrap return
      else arrayType .MUTABLE_POINTER _if
        Type .MutablePointer optional.wrap return
      else ..drop end
    end
    ## TODO? prevent dynamic-size array & fixed size raw_pointer
    ## procedure types are only allowed as base for fixed-size 0 dimensional pointers
    base context isProcedure if
      ## TODO? allow pointer of length 1 for generic matching
      arrayType .ARRAY or size .None ? ! if
        Type optional.empty return
      end
      base
        context asUnlabeledProc
      base=
    end
    context [] .memory
      base size ArrayData new mixedArena.copyValue =:: arrayId
    context .memory=
    arrayId ArrayId cast
      arrayType switch
        POINTER case Type .Pointer break
        MUTABLE_POINTER case Type .MutablePointer break
        RAW_POINTER case Type .RawPointer break
        MUTABLE_RAW_POINTER case Type .MutableRawPointer break
        ARRAY case Type .ArrayType break
      end
    optional.wrap return
  end

  ## initializer type as array/tuple, without changing element types
  ## used for correctly resolving procedure signatures
  proc( Type : t TypeContext ptr.mut : context ArrayType : arrayType -> Type ) =>: initializerAsArrayOrPtr
    t .Initializer .else
      ..drop Type .Undefined  return
    end InitializerInfo ptr cast =:: initInfo
    initInfo .asTuple TupleInfo ptr cast =:: tupleInfo
    tupleInfo .compositeInfo .elements [] .length =:: eltCount
    eltCount i64 cast.u ArraySize .Int =:: size
    ## newArrayType
      initInfo [] .arrayType
      arrayType
      size
    context newArrayType .else
      "failed to create array-type" ..panic
    end return
  end
  proc( Type : t TypeContext ptr.mut : context -> Type ) =>: export: initializerAsArray
    t context ArrayType .ARRAY initializerAsArrayOrPtr
  end
  proc( Type : t TypeContext ptr.mut : context -> Type ) =>: export: initializerAsPointer
    t context ArrayType .POINTER initializerAsArrayOrPtr
  end
  proc( Type : t TypeContext ptr.mut : context -> Type ) =>: export: initializerAsTuple
    t .Initializer .else ..drop
      Type .Undefined  return
    end InitializerInfo ptr.mut cast .asTuple TupleId cast Type .Struct return
  end

  ## composite types
  i32 =:: CompositeFlags
  ( char8 ptr.raw iSize -> CompositeFlags ) : static: alias: :CompositeFlags ..builtIn.parse.i32
  ## TODO update flags
    0:CompositeFlags =:: COMP_FLAG_NONE
    2:CompositeFlags =:: COMP_FLAG_EMPTY
    4:CompositeFlags =:: COMP_FLAG_STATIC_ARGS
   15:CompositeFlags =:: COMP_MASK_CONTENT_FLAGS
   16:CompositeFlags =:: COMP_SIZE_KNOWN
   32:CompositeFlags =:: COMP_FLAG_CONTAINS_LITERAL
  namespace: CompositeFlags
    proc( CompositeFlags CompositeFlags -> CompositeFlags ) : alias: and i32.and
    proc( CompositeFlags CompositeFlags -> CompositeFlags ) : alias: or  i32.or
    proc( CompositeFlags CompositeFlags -> CompositeFlags ) : alias: xor i32.xor
    proc( CompositeFlags -> CompositeFlags ) : alias: flip i32.flip
    proc( CompositeFlags -> bool ) : alias: toBool i32.toBool
  end
  overload: merge: & CompositeFlags.and    end
  overload: merge: | CompositeFlags.or     end
  overload: merge: ^ CompositeFlags.xor    end
  overload: merge: ~ CompositeFlags.flip   end
  overload: merge: ? CompositeFlags.toBool end

  struct(
    Type slice : elements
    NameId optional slice optional : eltNames
    CompositeFlags : flags
    i64 : alignment
    i64 : size
  ) =:: CompositeInfo
  struct(
    CompositeInfo : compositeInfo
    i64 slice : elementOffsets
  ) =:: TupleInfo
  struct(
    TupleInfo : asTuple
    Type : arrayType
  ) =:: InitializerInfo
  struct(
    CompositeInfo : compositeInfo
  ) =:: UnionInfo
  struct(
    NameId slice : eltNames
    Type  : tagType
  ) =:: EnumInfo
  struct(
    Type : base
    i32  : index
  ) =:: UnionElementInfo
  proc( Type TypeContext ptr : context -> bool ) =>: export: isComposite
    context unwrapNamed
    switch
      Enum Struct TaggedUnion RawUnion Initializer UnionElement case
        true return
      Undefined Empty PrimitiveType Pointer MutablePointer ArrayType Procedure
        NamedType GenericType GeneratedType IntLiteral Align
        CType RawPointer MutableRawPointer case
        false return
      SetType .case .baseType [] context isComposite return
      RefinementType .case .baseType [] context isComposite return
    end
  end
  ## TODO: rename all uses of Tuple to Struct (Tuple and Struct are the same)
  proc( Type TypeContext ptr -> bool ) =>: export: isTuple
    unwrapNamed .Struct ? return
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isEnum
    unwrapNamed .Enum ? return
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isUnion
    unwrapNamed =:: t
    t .TaggedUnion ? or t .RawUnion ? end return
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isTaggedUnion
    unwrapNamed .TaggedUnion ?
  end
  proc( Type TypeContext ptr : typeContext -> bool ) =>: export: isEnumOrTaggedUnion
    typeContext unwrapNamed switch
      Enum TaggedUnion case true return
      Struct Undefined Empty PrimitiveType Pointer ArrayType Procedure RawUnion
       NamedType GenericType GeneratedType IntLiteral Initializer RawPointer
       CType Align MutablePointer MutableRawPointer UnionElement case
         false return
      SetType .case .baseType [] typeContext isEnumOrTaggedUnion return
      RefinementType .case .baseType [] typeContext isEnumOrTaggedUnion return
    end
  end
  proc( Type TypeContext ptr : typeContext -> bool ) =>: export: isRawUnion
    typeContext unwrapNamed .RawUnion ?
  end
  proc( Type TypeContext ptr : context -> bool ) =>: export: isUnionElement
    .UnionElement ? return
  end
  union(
    _ : None
    CompositeInfo ptr : Composite
    EnumInfo ptr : Enum
  ) =:: CompositeData
  proc( Type : composite TypeContext ptr : context -> CompositeData ) =>: compositeData
    composite context unwrapNamed
      switch
        Struct TaggedUnion .case TupleInfo ptr cast .compositeInfo CompositeData .Composite return
        RawUnion .case UnionInfo ptr cast .compositeInfo CompositeData .Composite return
        UnionElement .case UnionElementInfo ptr cast [] .base context compositeData return
        Initializer .case
          InitializerInfo ptr cast .asTuple .compositeInfo CompositeData .Composite return
        Enum .case EnumInfo ptr cast CompositeData .Enum return
        Undefined Empty PrimitiveType Pointer ArrayType Procedure
         NamedType GenericType GeneratedType IntLiteral Align
         CType RawPointer MutablePointer MutableRawPointer case
          CompositeData .None return
        SetType .case .baseType [] context compositeData return
        RefinementType .case .baseType [] context compositeData return
      end
  end
  proc( Type : composite TypeContext ptr : context -> i32 ) =>: export: compositeEltCount
    composite context compositeData switch
      None case 0 return
      Enum .case .eltNames [] .length i32 cast return
      Composite .case .elements [] .length i32 cast return
    end
  end
  proc( Type : composite TypeContext ptr : context -> ArraySize ) =>: export: getEltCount
    composite context isArray if
      composite context getArraySize
    else
      composite context compositeData switch
        None case ArraySize .None return
        Enum .case .eltNames [] .length i64 cast.u ArraySize .Int return
        Composite .case .elements [] .length i64 cast.u ArraySize .Int return
      end
    end
  end
  proc( Type : composite i32 : index TypeContext ptr : context -> NameId optional ) =>: export: compositeGetEltName
    composite context compositeData switch
      None case NameId optional.empty return
      Enum .case [] .eltNames index slice.get return
      Composite .case
        [] .eltNames .else
          NameId optional.empty return
        end index slice.get optional.flat return
      break
    end
  end
  proc(
    Type : composite
    string : name
    TypeContext ptr : context
  -> i32 optional ) =>: export: compositeFindName
    context .nameContext =:: nameContext
    composite context compositeData switch
      None case i32 optional.empty return
      Enum .case [] .eltNames slice.wrapAll break
      Composite .case
        [] .eltNames .else
          i32 optional.empty return
        end
      break
    end =:: eltNames
    ## TODO? move linear search in slice to standard library
    eltNames name ( NameId optional : elt string : shadow: name -> bool ) =>
      elt .and name >$ id.identifierNameEq end
    end slice.indexOfEq2 ( iSize -> i32 ) => i32 cast end optional.map
  end
  proc(
    Type : tuple
    i32 : index
    TypeContext ptr.mut : typeContext
  -> i64 optional ) =>: export: tupleElementOffset
    tuple typeContext unwrapNamed switch
      Struct TaggedUnion .case break
      Enum RawUnion UnionElement Undefined Empty PrimitiveType Pointer ArrayType Procedure
       NamedType GenericType GeneratedType IntLiteral Initializer Align
       CType RawPointer MutablePointer MutableRawPointer case
         i64 optional.empty return
       SetType .case .baseType [] index typeContext tupleElementOffset return
       RefinementType .case .baseType [] index typeContext tupleElementOffset return
    end =:: tupleId
    tuple tupleId typeContext tryComputeTupleSize if
      i64 optional.empty return
    end
    tupleId TupleInfo ptr cast =:: tupleInfo
    index 0 < or index iSize cast.u tupleInfo [] .compositeInfo .elements .length u>= if
      i64 optional.empty return
    end
    tupleInfo [] .elementOffsets index [] optional.wrap return
  end
  proc(
    Type : enum
    TypeContext ptr.mut : typeContext
  -> Type i64 optional ) =>: export: enumTagInfo
    enum typeContext unwrapNamed switch
      Enum .case EnumInfo ptr cast [] .tagType 0:i64  optional.wrap return
      TaggedUnion .case .compositeInfo [] .elements 1 []
        enum 1 typeContext tupleElementOffset return
      RawUnion case Type .Empty i64 optional.empty return
      UnionElement .case .base [] typeContext enumTagInfo return
      Struct Undefined  Empty PrimitiveType Pointer ArrayType Procedure
       NamedType GenericType GeneratedType IntLiteral Initializer Align
       CType RawPointer MutablePointer MutableRawPointer case
         Type .Empty i64 optional.empty return
       SetType .case .baseType [] typeContext enumTagInfo return
       RefinementType .case .baseType [] typeContext enumTagInfo return
    end
  end
  proc( Type : composite TypeContext ptr : context -> CompositeFlags ) =>: compositeFlags
    composite context compositeData switch
      Composite .case [] .flags return
      None Enum case 0:CompositeFlags return
    end
  end
  proc( Type : composite i32 : index TypeContext ptr : context -> Type ) =>: export: compositeGetElement
    composite context compositeData switch
      Composite .case break
      None case Type .Undefined  return
      Enum case Type .Empty return
    end =:: compData
    index 0 < or index iSize cast.u compData [] .elements .length u>= if
      Type .Undefined  return
    end
    compData [] .elements index [] return
  end
  proc( Type : composite TypeContext ptr : context -> Type slice ) =>: export: compositeElts
    composite context compositeData switch
      Composite .case [] .elements return
      None Enum case Type slice.empty return
    end
  end
  proc( Type : composite i32 : index TypeContext ptr.mut : context -> Type optional ) =>: export: newUnionElement
    composite context asRawUnion .else
      Type optional.empty return
    end context compositeData switch
      None case Type optional.empty return
      Enum case Type optional.empty return
      Composite .case break
    end =:: compData
    index 0 < or index iSize cast.u compData [] .elements .length u>= if
      Type optional.empty return
    end
    context [] .memory
      ## UnionElementInfo
        composite
        index
      UnionElementInfo new mixedArena.copyValue =:: elementId
    context .memory=
    elementId UnionElementId cast Type .UnionElement optional.wrap return
  end
  proc( Type TypeContext ptr -> Type optional ) =>: export: getUnionElementUnion
    unwrapNamed .UnionElement .if
      UnionElementInfo ptr cast [] .base optional.wrap
    else ..drop
      Type optional.empty
    end
  end
  proc( Type TypeContext ptr : context -> Type ) =>: export: getUnionElementType
    context unwrapNamed .UnionElement .if
      UnionElementInfo ptr cast =:: element
      element [] .base context types.asRawUnion .if
        element [] .index context compositeGetElement
      else Type .Undefined end
    else ..drop
      Type .Undefined
    end
  end
  proc( Type TypeContext ptr -> i32 ) =>: export: getUnionElementIndex
    unwrapNamed .UnionElement .if
      UnionElementInfo ptr cast [] .index
    else ..drop
      0
    end
  end

  proc(
    Type slice : elts
    TypeContext ptr.mut : context
  -> CompositeFlags ) =>: computeCompositeFlags
    true =:: mut: emptyData ## composite is empty
    COMP_FLAG_NONE
      elts for =:: elt
        elt context isEmpty ! if
          false emptyData=
        end
        elt context containsGeneric if
          COMP_FLAG_STATIC_ARGS |
        end
        elt isLiteral if
          COMP_FLAG_CONTAINS_LITERAL |
        end
      end
      emptyData if
         COMP_FLAG_EMPTY |
      end
    return
  end

  proc(
    MixedArenaAllocator
    NameId optional slice optional : eltNames
  -> MixedArenaAllocator NameId optional slice optional ) =>: copyEltNames
    eltNames .if
      ## truncate eltNames
      $ .length =:: mut: N
      while N 0 != and $ N 1 - [] ? ! do
        N 1 - N=
      end
      N 0 == if ..drop ## no named identifier
        NameId optional slice optional.empty return
      end
      N slice.head mixedArena.copySlice slice.freeze optional.wrap
    else eltNames end
  end
  ## creates struct
  proc(
    Type slice : elts
    NameId optional slice optional : eltNames
    TypeContext ptr.mut : context
  -> Type optional ) =>: export: newTuple
    elts context computeCompositeFlags =:: flags
    context [] .memory
      elts mixedArena.copySlice slice.freeze =:: eltCopy
      eltNames copyEltNames =:: namesCopy
      ## TupleInfo
        ## CompositeInfo
          eltCopy
          namesCopy
          flags
          -1
          -1
        CompositeInfo new
        i64 slice.empty
      TupleInfo new mixedArena.copyValue =:: tupleId
    context .memory=
    tupleId TupleId cast Type .Struct optional.wrap return
  end
  proc(
    Type slice : elts
    NameId optional slice optional : eltNames
    TypeContext ptr.mut : context
  -> Type ) =>: export: newInitializerType
    ##  check if initializer can be array
    elts .length 0:iSize != if
      elts 0 []
    else ## TODO? special type for empty array?
      primitive.I32 ## TODO? better default type for empty array
    end =:: mut: arrayType
    0:iSize while $ elts .length u< do =:: i
      elts i [] =:: eltType
      eltNames .and i slice.get .and ? if
        ## if there is a named element the initializer is not an array
        Type .Undefined  arrayType=
        i break
      end
      arrayType eltType context mergeTypes .if
        #+mergedType+# arrayType=
      else
        Type .Undefined  arrayType=
        i break
      end
    finally i 1:iSize + end ..drop
    elts context computeCompositeFlags =:: flags
    context [] .memory
      ## InitializerInfo
      elts mixedArena.copySlice slice.freeze =:: eltCopy
      eltNames copyEltNames =:: namesCopy
        ## TupleInfo
          ## CompositeInfo
            eltCopy
            namesCopy
            flags
            -1
            -1
          CompositeInfo new
          i64 slice.empty
        TupleInfo new
        arrayType
      InitializerInfo new mixedArena.copyValue =:: initializerId
    context .memory=
    initializerId InitializerId cast Type .Initializer return
  end
  enum( TAGGED RAW ) =:: export: UnionType
  proc(
    iSize : eltCount
    UnionType : unionType
  -> Type ) =>: export: computeEnumTagType
    unionType .RAW if
      Type .Empty
    else eltCount 0x80:iSize u< _if
      primitive.I8
    else eltCount 0x8000:iSize u< _if
      primitive.I16
    else
      primitive.I32
    end return
  end
  proc(
    Type optional : baseType
    NameId slice : eltNames
    TypeContext ptr.mut : context
  -> Type optional ) =>: export: newEnum
    eltNames .length 0:iSize == if
      Type optional.empty return
    end
    context [] .memory
      eltNames mixedArena.copySlice slice.freeze
        baseType .else
          eltNames .length UnionType .TAGGED computeEnumTagType
        end
      EnumInfo new mixedArena.copyValue =:: enumId
    context .memory=
    enumId EnumId cast Type .Enum optional.wrap return
  end
  proc(
    Type slice : elts
    NameId slice : eltNames
    UnionType : unionType
    TypeContext ptr.mut : context
  -> Type optional ) =>: export: newUnion
    elts .length 0:iSize == or elts .length eltNames .length != if
      Type optional.empty return
    end
    context [] .memory
      elts mixedArena.copySlice slice.freeze =:: eltCopy
      eltNames mixedArena.copySlice slice.freeze optional.wrap =:: namesCopy
      ## CompositeInfo
        eltCopy
        namesCopy ( NameId slice -> NameId optional slice ) => slice.wrapAll end optional.map
        elts context computeCompositeFlags
        -1
        -1
      CompositeInfo new UnionInfo new mixedArena.copyValue =:: unionData
    context .memory=
    unionData UnionId cast Type .RawUnion =:: rawValue
    unionType .RAW if
      rawValue optional.wrap return
    end
    Type 2 array : mut: elements
    rawValue elements@ 0 =[]
    eltNames .length unionType computeEnumTagType elements@ 1 =[]
    ## newTuple
      elements@ slice.wrap
      NameId optional slice optional.empty
    context newTuple .and .Struct .if
      Type .TaggedUnion optional.wrap
    else
      Type optional.empty
    end
  end
  proc(
    Type : unionType
    TypeContext ptr : context
  -> Type optional ) =>: export: asRawUnion
    unionType context unwrapNamed .TaggedUnion .if
      .compositeInfo [] .elements 0 slice.get return
    else .RawUnion ? _if
      unionType optional.wrap return
    end
    Type optional.empty return
  end
end
namespace: sb
  proc(
    stringBuilder
    NameId : nameId
  -> stringBuilder ) =>: appendTypeElementName
    " : " appendS
    nameId id.identifierFlags id.FLAG_MUTABLE & ? if
      "mut: " appendS
    end
    nameId id.identifierFlags id.FLAG_AUTO & ? if
      "auto: " appendS
    end
    nameId id.identifierFlags id.FLAG_STATIC & ? if
      "static: " appendS
    end
    nameId appendIdentifierName
  end
  proc(
    stringBuilder : sb
    Type : t
    i32 : depth
    TypeContext ptr : context
  -> stringBuilder ) =>: appendComposite
    context .nameContext =:: nameContext
    sb
      t context types.compositeData .Composite .else
        "unexpected composite-type" ..panic
      end =:: comp
      comp [] .eltNames ? ! =:: unnamed
      0:i32 while $ iSize cast.u comp [] .elements .length u< do
        >$
          t $2 context types.compositeGetElement =:: eltType
          unnamed if
            eltType context depth 1 - appendTypeRecursive
            ' ' appendC
            <$ 1 + continue
          end
          eltType context types.isEmpty if
            "_" sb.appendS
          else
            eltType context depth 1 - appendTypeRecursive
          end
          t $2 context types.compositeGetEltName .if
            appendTypeElementName
          end
          ' ' appendC
        <$
        1 +
      end ..drop
    return
  end
  proc(
    stringBuilder
    types.EnumInfo : enumInfo
    NameContext ptr : nameContext
  -> stringBuilder ) =>: appendEnumElements
    enumInfo .eltNames for appendIdentifierName ' ' sb.appendC end
  end
end
namespace: types
  ## procedure types
  struct(
    Type slice : inTypes
    Type slice : outTypes
    NameId optional slice : eltNames
    CallingConvention : callingConvention
  ) =:: ProcType

  proc( Type TypeContext ptr -> bool ) =>: export: isProcedure
    unwrapNamed .Procedure  ? return
  end
  proc( Type : mType TypeContext ptr : context -> bool ) =>: export: isCallable
    mType context unwrapNamed
      $ context isFixedSizePtr if
        context getBaseType
      end
    .Procedure  ? return
  end
  proc( Type : procType TypeContext ptr.mut : typeContext -> bool ) =>: export: isTypeGeneratorProc
    procType typeContext types.getProcOut .else
      false return
    end =:: procOutTypes
    procOutTypes .length 1:iSize == and procOutTypes 0 [] typeContext types.isType end
  end
  proc( Type : proc TypeContext ptr : context -> ProcType ptr optional ) =>: getProcData
    proc context unwrapNamed
      .Procedure .else ..drop
        ProcType ptr optional.empty return
      end
    ProcType ptr cast optional.wrap return
  end
  proc( Type : proc TypeContext ptr : context -> Type slice optional ) =>: export: getProcIn
    proc context getProcData .if
      [] .inTypes optional.wrap return
    else
      Type slice optional.empty return
    end
  end
  proc( Type : proc TypeContext ptr : context -> NameId optional slice ) =>: export: getProcEltNames
    proc context getProcData .else
      NameId optional slice.empty return
    end [] .eltNames
  end
  proc( Type : proc TypeContext ptr : context -> NameId optional slice ) =>: export: getProcArgNames
    proc context getProcData .else
      NameId optional slice.empty return
    end =:: procData
    procData [] .eltNames procData [] .inTypes .length slice.head
  end
  proc( Type : proc TypeContext ptr : context -> NameId optional slice ) =>: export: getProcRetNames
    proc context getProcData .else
      NameId optional slice.empty return
    end =:: procData
    procData [] .eltNames procData [] .inTypes .length slice.tail
  end
  proc( Type : proc i32 : argIndex TypeContext ptr : context -> NameId optional ) =>: export: getProcArgName
    proc context getProcArgNames argIndex slice.get optional.flat
  end
  proc( Type : proc NameId : argName TypeContext ptr : context -> i32 optional ) =>: export: findProcArgName
    proc context getProcArgNames argName ( NameId optional NameId : shadow: argName -> bool ) =>
      .and argName id.identifierNamesEq end
    end slice.indexOfEq2 ( iSize -> i32 ) => i32 cast end optional.map
  end
  proc( Type : proc TypeContext ptr : context -> Type slice optional ) =>: export: getProcOut
    proc context getProcData .if
      [] .outTypes optional.wrap return
    else
      Type slice optional.empty return
    end
  end
  proc( Type : proc TypeContext ptr : context -> CallingConvention ) =>: export: getCallConvention
    proc context getProcData .if
      [] .callingConvention return
    else
      CallingConvention.DEFAULT return
    end
  end
  union(
    _ : Empty
    Type : Value
    Type : Tuple
  ) =:: export: ProcRet
  proc( Type : proc TypeContext ptr.mut : context -> ProcRet ) =>: export: getProcRet
    proc context getProcData .else
      ProcRet .Empty return
    end
      $ [] .callingConvention =:: callConvention
    .outTypes [] =:: outTypes
    callConvention switch
      CCALL PTRCALL case
        outTypes .length 0:iSize == if
          ProcRet .Empty return
        end
        outTypes $ .length 1:iSize - [] =:: retVal
        retVal context isEmpty if
          ProcRet .Empty return
        end
        retVal ProcRet .Value return
      CONCAT case
        outTypes .length 0:iSize == if
          ProcRet .Empty return
        end
        outTypes .length 1:iSize == if
          outTypes 0 [] ProcRet .Value return
        end
        ## TODO! filter out empty elements
        ## TODO reuse slice memory if possible
        outTypes
          NameId optional slice optional.empty
        context newTuple .else
          "failed to create tuple-type" ..panic
        end ProcRet .Tuple return
    end
  end
  proc( Type : proc TypeContext ptr : context -> Type slice ) =>: export: getProcOutArgs
    proc context getProcData .else
      Type slice.empty return
    end
      $ [] .callingConvention =:: callConvention
    .outTypes [] =:: outTypes
    callConvention switch
      CCALL CONCAT case Type slice.empty return
      PTRCALL case
        outTypes .length 0:iSize == if
          Type slice.empty return
        end
        outTypes outTypes .length 1:iSize - slice.head return
    end
  end
  proc( Type slice : in Type slice : out NameId optional slice : eltNames CallingConvention : callConvention TypeContext ptr.mut : context -> Type optional ) =>: export: newProcedure
    callConvention .CCALL and out .length 1:iSize u> if
      Type optional.empty return ## XXX? better error handling
    end
    context [] .memory
      in mixedArena.copySlice slice.freeze =:: inCopy
      out mixedArena.copySlice slice.freeze =:: outCopy
      eltNames mixedArena.copySlice slice.freeze =:: eltNamesCopy
      inCopy outCopy eltNamesCopy callConvention ProcType new mixedArena.copyValue =:: procId
    context .memory=
    procId ProcTypeId cast Type .Procedure  optional.wrap return
  end
  proc(
    Type : proc
    TypeContext ptr.mut : context
  -> Type ) =>: export: asUnlabeledProc
    proc context unwrapNamed
      $ context isCallable ! if ..drop
        proc return
      end
      false =:: mut: isPtr
      $ context isPointer if
        context getBaseType
        true isPtr=
      end
    =:: mProc
    mProc .Procedure .else
      "unexpected callable type" ..panic
    end ProcType ptr cast =:: procData
    procData [] .eltNames .length 0:iSize == if
      proc return
    end
    context [] .memory
      ## ProcType
        procData [] .inTypes
        procData [] .outTypes
        NameId optional slice.empty
        procData [] .callingConvention
      ProcType new mixedArena.copyValue =:: procId
    context .memory=
    procId ProcTypeId cast Type .Procedure
      isPtr if
        ArrayType .POINTER ArraySize .None context newArrayType .else
          "failed to create array-type" ..panic
        end return
      end
    return
  end

  ## named types
  proc(
    NameId : nameId
    TypeContext ptr.mut : context
  -> Type ) =>: export: declareNamedType
    nameId Type .NamedType return
  end

  proc(
    Type : value
    NameId : nameId
    TypeContext ptr.mut : context
  -> Type optional ) =>: export: initializeNamedType
    context .namedTypes nameId value map.put .if =:: oldValue
      context .namedTypes nameId oldValue map.put ..drop
      Type optional.empty return
    end
    nameId Type .NamedType optional.wrap return
  end

  proc( Type -> bool ) =>: export: isNamedType
    .NamedType ? return
  end
  ## completely unwrap named type
  proc( Type TypeContext ptr : context -> Type ) =>: export: unwrapNamed
    ## TODO figgure out where an empty named/generator types are unwrapped
    while
      .NamedType .if
        context .namedTypes >$ map.get
          .else Type .Undefined  return end
        continue
      else .GeneratedType ._if
        context .generatedTypes >$ GeneratedTypeName ptr cast [] map.get
          .and .value .else Type .Undefined  return end
        continue
      end
    false do end
    return
  end
  ## unwrap only top level named type
  proc( Type TypeContext ptr : context -> Type ) =>: export: flatUnwrapNamed
    .NamedType .if
      context .namedTypes >$ map.get
        .else Type .Undefined  end
      return
    end
  end
  ## completely unwrap named type
  proc(
    Type
    TypeContext ptr : context
  -> Type ) =>: export: unwrapNamedKeepGenerated
    while
      .NamedType .if
        context .namedTypes >$ map.get
          .else Type .Undefined  return end
        continue
      end
    false do end
    return
  end
  proc( Type TypeContext ptr : context -> NameId optional ) =>: export: namedTypeName
    .NamedType .if optional.wrap else ..drop
      NameId optional.empty return
    end
  end
end

namespace: sb
  proc(
    stringBuilder : sb
    NameId : name
    TypeContext ptr : context
    i32 : depth
  -> stringBuilder ) =>: appendNamedType
    context .nameContext =:: nameContext
    sb
      '"' sb.appendC
      name nameContext sb.appendIdentifierPath
      '"' sb.appendC
      depth 0 > if
        " [ " sb.appendS
        ## appendTypeRecursive
          context .namedTypes name map.get .else Type .Undefined end
          context
          depth 1 -
        appendTypeRecursive
        " ]"  sb.appendS
      end
    return
  end
end
namespace: types
  ## generated types

  struct(
    NameId : generator
    ConstValue slice : arguments
  ) =:: GeneratedTypeName
  struct(
    GeneratedTypeId : key
    Type optional : value
  ) =:: GeneratedTypeValue

  proc( GeneratedTypeName : a GeneratedTypeName : b -> bool ) =>: genNameEq
    a .generator b .generator NameId.eq ! if false return end
    a .arguments b .arguments constantEquals@ slice.eq
  end
  proc( GeneratedTypeName : a -> i32 ) =>: genNameHash
    a .generator NameId.hash
      31 * a .arguments constantHash@ slice.hash +
    return
  end
  proc( GeneratedTypeName : a GeneratedTypeName : b -> i32 ) =>: genNameCmp
    a .generator b .generator NameId.eq ! if
      a .generator b .generator NameId.cmp return
    end
    a .arguments b .arguments constantCmp@ slice.cmp
  end

  proc( Type -> bool ) =>: export: isGeneratedType
    .GeneratedType ? return
  end

  union(
    _ : None
    Type : Created
    Type : Stored
  ) =:: export: GeneratedTypeState
  #+ finds the generated type for the given type generator and arguments
     returns the type and a boolean that is true if a new GeneratedType was created +#
  proc(
    NameId : generatorName
    ConstValue slice : arguments
    bool : create
    TypeContext ptr.mut : typeContext
    ConstantContext ptr.mut : constContext
  -> GeneratedTypeState ) =>: export: findGeneratedType
    typeContext .nameContext =:: nameContext
    generatorName id.getBaseName .else generatorName end =:: shadow: generatorName
    generatorName arguments GeneratedTypeName new =:: genName
    typeContext .generatedTypes genName map.get .if =:: prevValue
      generatorName id.identifierFlags id.FLAG_NO_WRAP & ? and prevValue .value .if
        GeneratedTypeState .Stored return
      end
      prevValue .key Type .GeneratedType GeneratedTypeState .Stored return
    end
    create if
      typeContext [] .memory
        arguments mixedArena.copySlice slice.freeze =:: newArgs
        generatorName newArgs GeneratedTypeName new =:: newName
        newName mixedArena.copyValue GeneratedTypeId cast =:: newKey
      typeContext .memory=
      typeContext .generatedTypes
        newName
        ## GeneratedTypeValue
          newKey
          Type optional.empty
        GeneratedTypeValue new
      map.put ..drop
      newKey Type .GeneratedType GeneratedTypeState .Created return
    end
    GeneratedTypeState .None return
  end

  proc(
    NameId : generatorName
    ConstValue slice : arguments
    Type : value
    TypeContext ptr.mut : typeContext
    ConstantContext ptr.mut : constContext
  -> Type ) =>: export: initializeGeneratedType
    generatorName id.getBaseName .else generatorName end =:: shadow: generatorName
    ## findGeneratedType
      generatorName
      arguments
      true
      typeContext
      constContext
    findGeneratedType switch
      Stored Created .case break
      None case ..unreachable
    end =:: prevType
    value .Undefined ? or prevType .GeneratedType ! .if
      prevType return
    end =:: prevGeneratorName
    value optional.wrap
      typeContext .generatedTypes
        prevGeneratorName GeneratedTypeName ptr cast []
      map.at optional.unwrap
    .value=
    generatorName id.identifierFlags id.FLAG_NO_WRAP & ? if
      value return
    end
    prevType return
  end

  proc( Type : generator TypeContext ptr : context -> Type ) =>: export: getGeneratedType
    generator
      $ .NamedType ? if context unwrapNamedKeepGenerated end
    =:: t
    t .GeneratedType .else ..drop
      generator return
    end =:: genTypeName
    context .generatedTypes genTypeName GeneratedTypeName ptr cast [] map.get
      .and .value .else Type .Undefined  end
    return
  end

  proc( Type : generator TypeContext ptr : context -> NameId optional ) =>: export: getGeneratorName
    generator =:: mut: t
    t .NamedType ? if
      t context unwrapNamedKeepGenerated t=
    end
    t .GeneratedType .else ..drop
      NameId optional.empty return
    end GeneratedTypeName ptr cast [] .generator optional.wrap return
  end
  proc( Type : generator TypeContext ptr : context -> ConstValue slice ) =>: export: getGeneratorArgs
    generator =:: mut: t
    t .NamedType ? if
      t context unwrapNamedKeepGenerated t=
    end
    t .GeneratedType .else ..drop
      ConstValue slice.empty return
    end GeneratedTypeName ptr cast [] .arguments return
  end

  struct(
    Type : baseType
    ConstValue slice : elements
  ) =:: SetType
  struct(
    Type : baseType
    ProcId : typeTrait
  ) =:: RefinementType
  proc(
    Type : baseType
    ConstValue slice : elements
    TypeContext ptr.mut : context
  -> Type ) =>: export: newSetType
    ## TODO? check if set-type contains duplicate values
    ## TODO? sort elements
    context [] .memory
      ## TODO: is shallow copy of type-elements save
      elements mixedArena.copySlice =:: sliceElements
      sliceElements constantCmp@ slice.sort
      baseType context literalToType
        sliceElements slice.freeze
      SetType new mixedArena.copyValue =:: setType
    context .memory=
    setType SetTypeId cast Type .SetType  return
  end
  proc( Type TypeContext ptr : context -> bool ) =>: export: isSetType
    context unwrapNamed .SetType ? return
  end
  proc( Type : t TypeContext ptr : context -> ConstValue slice ) =>: export: getSetTypeEntries
    t context unwrapNamed
      .SetType  .else ..drop
        ConstValue slice.empty return
      end
    SetType ptr cast [] .elements return
  end
  proc( ConstValue : val Type : t TypeContext ptr : context -> bool ) =>: export: checkSetType
    t context unwrapNamed
      .SetType  .else ..drop
        false return
      end
    SetType ptr cast [] .elements val constantEquals@ slice.containsEq return
  end
  proc(
    Type : baseType
    ProcId : typeTrait
    TypeContext ptr.mut : context
  -> Type ) =>: export: newRefinementType
    context [] .memory
      baseType typeTrait RefinementType new mixedArena.copyValue =:: refType
    context .memory=
    refType RefinementTypeId cast Type .RefinementType  return
  end
  proc( Type TypeContext ptr : context -> bool ) =>: export: isRefinementType
    context unwrapNamed .RefinementType ? return
  end
  proc( Type TypeContext ptr : context -> bool ) =>: export: isSetOrRefinementType
    context unwrapNamed =:: t0
    t0 .RefinementType ? or t0 .SetType ? end return
  end
  proc( Type : box TypeContext ptr : context -> Type ) =>: export: unwrapRefinement
    box context unwrapNamed switch
      SetType .case .baseType [] return
      RefinementType .case .baseType [] return
      default box return
    end
  end
  proc( Type TypeContext ptr : context -> ProcId optional ) =>: export: getTypeTrait
    context unwrapNamed
      .RefinementType  .else ..drop
        ProcId optional.empty return
      end
    RefinementType ptr cast [] .typeTrait optional.wrap return
  end
  ## is this type a refinement of type TYPE-type
  proc( Type TypeContext ptr : context -> bool ) =>: export: isTypeRefinement ## TODO? better name
    context unwrapNamed
      .SetType .if
        .baseType [] context isType
      else .RefinementType ._if
        .baseType [] context isType
      else ..drop false end
    return
  end

  ## TODO? better name "is this type a type" sounds weird
  proc( Type : t TypeContext ptr : context -> bool ) =>: export: isType
    t context unwrapNamed =:: baseType
    baseType primitive.TYPE typeEquals or baseType context isTypeRefinement end return
  end

  proc( NameId : id -> Type ) =>: export: newGenericType
    id Type .GenericType return
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isGeneric
    unwrapNamed .GenericType ? return
  end
  proc( Type : t -> NameId optional ) =>: export: getGenericTypeId
    t .GenericType .if optional.wrap else ..drop NameId optional.empty end
  end
  proc( Type : t0 TypeContext ptr : context -> bool #+has static arg+# ) =>: export: containsGeneric
    t0 context unwrapNamedKeepGenerated =:: t
    t switch
      Undefined Empty PrimitiveType CType IntLiteral Align case
        false return
      Pointer MutablePointer RawPointer MutableRawPointer ArrayType .case
        ArrayData ptr cast [] =:: arrayType
        arrayType .size .GenericArg ? if
          true return
        end
        arrayType .base context containsGeneric if
          true return
        end
        false return
      Struct Enum TaggedUnion RawUnion Initializer UnionElement case
        t context compositeFlags COMP_FLAG_STATIC_ARGS & ? return
      GeneratedType .case GeneratedTypeName ptr cast =:: genType
        ## a GeneratedType is generic if one of its arguments is generic
        genType .arguments [] .length for =:: i
          genType [] .arguments i [] =:: arg
          ConstValue ..length 23:iSize == "no new constants" assert
          arg .GenericArg ? or arg .TypeId .and context containsGeneric if
            true return
          end
        end
        false return
      Procedure  .case ProcType ptr cast =:: procType
        ## TODO cache result of computation?
        procType [] .inTypes for
          context containsGeneric if
            true return
          end
        end
        procType [] .outTypes for
          context containsGeneric if
            true return
          end
        end
        false return
      NamedType case
        t context unwrapNamed context containsGeneric return
      GenericType case
        true return
      SetType .case =:: setTypeId
        setTypeId .baseType [] context containsGeneric if
          true return
        end
        setTypeId .elements [] for =:: elt
          elt .GenericArg ? if true return end
          elt .TypeId .and context containsGeneric if true return end
        end
        ## TODO? cache result in type-data
      false return
      RefinementType .case .baseType [] context containsGeneric return
    end
  end

  proc( Type : t0 TypeContext ptr : context -> bool ) =>: export: isInitializer
    t0 context unwrapNamed .Initializer ? return
  end

  proc( Type : src bool : mutable TypeContext ptr.mut : context -> Type ) =>: export: getAddressType
    src context isArray if
      src context unwrapNamed =:: unwraped
      ## TODO? directly reuse ArrayData instead of calling newArrayType
      unwraped context getBaseType
        mutable if ArrayType .MUTABLE_POINTER else ArrayType .POINTER end
        unwraped context getArraySize
      context newArrayType .else
        "failed to create array-type" ..panic
      end return
    end
    src .Undefined ? if
      src return
    end
    src context isProcedure if
      src context asUnlabeledProc
    else
      src
    end
      mutable if ArrayType .MUTABLE_POINTER else ArrayType .POINTER end
      ArraySize .None
    context newArrayType .else
      "failed to create array-type" ..panic
    end return
  end
  proc( Type : src TypeContext ptr.mut : context -> Type ) =>: export: ptrTarget
    src context isPointer ! if
      Type .Undefined  return
    end
    src context isArrayPointer if
      ## TODO? directly reuse ArrayData instead of calling newArrayType
      src context unwrapNamed =:: unwraped
      unwraped context getBaseType
        ArrayType .ARRAY
        unwraped context getArraySize
      context newArrayType .else
        "failed to create array-type" ..panic
      end return
    end
    src context getBaseType return
  end

  proc( Type : src Type : target TypeContext ptr : context -> bool ) =>: sizeCompatible
    using types.
    src context isFixedSize ! and target context isFixedSize if
      false return ## cannot cast non-fixed pointer to fixed poiner
    end
    target context isFixedSize ! if
      true return
    end
    src context getArraySize =:: srcSize
    target context getArraySize =:: targetSize
    srcSize targetSize arraySizeEqual if
      true return
    end
    ## allow cast  T ptr -> T 1 ptr
    srcSize .None ? and targetSize .Int .and 1 == if
      true return
    end
    false return
  end

  proc(
    Type : mut: src
    Type : mut: target
    bool : allowRename
    bool : mutableParent
    bool : allowArray
    TypeContext ptr : context
  -> bool ) =>: canCastPtr
    allowRename if
      src context unwrapNamed src=
      target context unwrapNamed target=
    end
    src target types.typeEquals if
      true return
    end
    ## allow casting union-element pointer to union pointer
    allowRename and src context types.getUnionElementUnion .and context unwrapNamed target typeEquals if
      true return
    end
    allowArray and src context types.isArray if
      src context types.getBaseType
        target
        allowRename mutableParent allowArray
      context canCastPtr return
    end
    ## TODO! allow cast  T k array l ptr -> T  k l *  ptr
    src context types.isPointer ! or target context types.isPointer ! if
      false return
    end
    target context types.isMutable =:: mutableTarget
    src context types.isMutable =:: mutableSrc
    mutableParent if ## cannot convert mutable to immutable if parent is mutable
      mutableSrc mutableTarget !=
    else
      mutableSrc ! mutableTarget &
    end or src target context sizeCompatible ! if
      false return
    end
    ## canCastPtr
      src context types.getBaseType
      target context types.getBaseType
      allowRename
      mutableParent mutableTarget |
      target context types.isRawPointer
    context canCastPtr return
  end
  ## TODO? allow reordering fields
  proc( Type : src Type : target TypeContext ptr.mut : context -> bool ) =>: canCastTupleInitializer
    context .nameContext =:: nameContext
    src context unwrapNamed =:: srcBase
    target context unwrapNamed =:: targetBase
    srcBase .Struct .if
      TupleInfo ptr cast
    else .Initializer ._if
      InitializerInfo ptr cast .asTuple
    else ..drop
      false return
    end =:: srcInfo
    targetBase .Struct .else ..drop
      false return
    end TupleInfo ptr cast =:: targetInfo
    srcInfo targetInfo == if
      true return
    end
    srcInfo .compositeInfo [] .elements =:: srcElts
    targetInfo .compositeInfo [] .elements =:: targetElts
    srcElts .length targetElts .length != if
      false return
    end
    srcInfo .compositeInfo .eltNames [] =:: srcEltNames?
    targetInfo .compositeInfo .eltNames [] =:: targetEltNames?
    srcEltNames? optional.hasData or targetEltNames? optional.hasData end =:: named
    srcElts .length for =:: i
      srcElts i [] targetElts i [] context canAutoCast ! if
        false return
      end
      named if
        ## identifierNamesEq
          srcEltNames? .if i slice.get optional.flat else NameId optional.empty end
          targetEltNames? .if i slice.get optional.flat else NameId optional.empty end
        id.identifierNamesEqO ! if
          false return
        end
      end
    end
    true return
  end
  proc( Type : src Type : target TypeContext ptr.mut : context -> bool ) =>: export: canAutoCastInitializer
    target context unwrapNamed =:: targetBase
    src context compositeEltCount =:: srcSize
    srcSize 0 == =:: srcEmpty
    srcEmpty and targetBase context types.isRawPointer if
      true return ## empty initializer to raw 1D pointer
    end
    ## XXX? allow cast from empty initializer to union with single empty entry
    targetBase context types.isMutable if
      false return ## cannot cast non-empty initializer to mutable pointer
    end
    targetBase context types.isArray or targetBase context types.isArrayPointer or
        targetBase context types.isRawPointer if
      src .Initializer .else
        "expected initializer-type" ..panic
      end InitializerInfo ptr cast =:: initInfo
      targetBase context getBaseType =:: eltType
      initInfo .arrayType [] eltType context canAutoCast and
        targetBase context types.isRawPointer or
        targetBase context getArraySize =:: targetSize
        targetSize .Int .and srcSize i64 cast.u == if
          true return
      end
    end
    targetBase context types.isTuple if
      src targetBase context canCastTupleInitializer return
    else targetBase context types.isPointer
        and targetBase context getArraySize .None ?
        and targetBase context getBaseType context unwrapNamed =:: baseType
        baseType context types.isTuple _if
      src baseType context canCastTupleInitializer return
    end
    false return
  end

  proc( Type : src Type : target TypeContext ptr.mut : context -> bool ) =>: export: canAlias
    src context unwrapNamed =:: shadow: src
    target context unwrapNamed =:: shadow: target
    src target types.typeEquals if
      true return ## same type-different names
    end
    ## procedure: compare call-convention, arguments and return-values
    src .Procedure ? and target .Procedure  ? if
      src context getCallConvention target context getCallConvention != if
        false return
      end
      src context getProcIn .else "proc without in" ..panic end =:: srcIn
      target context getProcIn .else "proc without in" ..panic end =:: targetIn
      srcIn .length targetIn .length != if
        false return
      end
      srcIn .length for =:: i
        srcIn i [] targetIn i [] context canAlias ! if
          false return
        end
      end
      src context getProcOut .else "proc without out" ..panic end =:: srcOut
      target context getProcOut .else "proc without out" ..panic end =:: targetOut
      srcOut .length targetOut .length != if
        false return
      end
      srcOut .length for =:: i
        srcOut i [] targetOut i [] context canAlias ! if
          false return
        end
      end
      true return
    end
    false return
  end

  proc( Type : src Type : target TypeContext ptr.mut : context -> bool ) =>: export: canAutoCast
    src target types.typeEquals if
      true return
    end
    src context types.isSetOrRefinementType and src context unwrapRefinement target typeEquals if
      true return ## allow automatic conversions from type-refinement to base-type
    end
    src context types.isSetType and target context types.isSetType and
        src context unwrapRefinement target context unwrapRefinement typeEquals and
        target context getSetTypeEntries
          src context getSetTypeEntries
        constantEquals@ slice.isSubSequence if
      true return ## conversion to super-set type
    end
    src .Initializer ? if
      src target context canAutoCastInitializer return
    end
    src .IntLiteral ? and target I_SIZE typeEquals if
      src target context types.canAutoCastIntLiteral return
    end
    src .NamedType ? or target .NamedType ? if
      false return
    end
    ## no auto-cast from/to c-type to minimize platform specific behaviour
    src .CType ? or target .CType ? if
      false return
    end
    src .IntLiteral ? and target context types.isNumber if
      src target context types.canAutoCastIntLiteral return
    end
    src context types.isNumber and target context types.isNumber if
      src target context types.canAutoCastNumber return
    end
    ## TODO? allow proc-pointer assignment when arg-names differ
    src context types.isPointer and target context types.isPointer if
      src target false false false context canCastPtr return
    end
    src context types.isProcedure and target context types.isProcedure if
      src context types.getProcIn .else "proc has in" ..panic end =:: srcIn
      target context types.getProcIn .else "proc has in" ..panic end =:: targetIn
      src context types.getProcOut .else "proc has out" ..panic end =:: srcOut
      target context types.getProcOut .else "proc has out" ..panic end =:: targetOut
      srcIn targetIn typeEquals@ slice.eq and srcOut targetOut typeEquals@ slice.eq end return
    end
    src context types.isProcedure and target context types.isPointer and
        target context types.getBaseType =:: targetBase
        targetBase context types.isProcedure if
      src targetBase context canAutoCast return
    end
    false return
  end
  proc( Type : a Type : b bool : forceCast TypeContext ptr.mut : context -> bool ) =>: export: canCast
    a context types.unwrapNamed =:: mut: src
    b context types.unwrapNamed =:: mut: target
    src target context canAutoCast if
      true return
    end
    ## converting c-types to types
    target .CType .if =:: targetCType
      forceCast ! if
        targetCType .STRUCT if false return end
        targetCType .UNION  if false return end
      end
      src targetCType cTypeAsType forceCast context canCast return
    else ..drop end
    src .CType .if =:: srcCType
      forceCast ! if
        srcCType .STRUCT if false return end
        srcCType .UNION  if false return end
      end
      srcCType cTypeAsType target forceCast context canCast return
    else ..drop end
    target context types.isNumber and src context types.isNumber or src .IntLiteral ? if
      true return
    end
    src context types.isPointer and target context types.isPointer and
        src target true false false context canCastPtr if
      true return
    end
    ## allow cast union-element -> union
    src context types.getUnionElementUnion .and context types.unwrapNamed target typeEquals if
      true return
    end
    forceCast ! if
      false return
    end
    src context types.isPointer target context types.isPointer & if
      true return ## XXX check for compatible element sizes?, compatible mutability
    end
    src context types.isPointer target context types.isInt & if
      true return
    end
    src context types.isInt target context types.isPointer & if
      true return
    end
    false return
  end
  proc( Type : src Type : target TypeContext ptr.mut : context -> bool ) =>: export: canBitCast
    src context sizeOf .Fixed .else ..drop false return end =:: srcSize
    target context sizeOf .Fixed .else ..drop false return end =:: targetSize
    ## TODO? should there by any other restrictions on bit-casts
    srcSize targetSize == or
      ## allow int-literals to be smaller than target-type
      src .IntLiteral .and intLiteralBytes targetSize <= and
        primitive.I_MAX context primitiveValue sizeOfPrimitive targetSize >= end
    return
  end
  proc( Type : a Type : b TypeContext ptr.mut : context -> Type optional ) =>: export: mergeTypes
    a b types.typeEquals if
      a optional.wrap return
    end
    a .IntLiteral ? and b I_SIZE typeEquals and a b context types.canAutoCastIntLiteral if
      I_SIZE optional.wrap return
    end
    a I_SIZE typeEquals and b .IntLiteral ? and b a context types.canAutoCastIntLiteral if
      I_SIZE optional.wrap return
    end
    ## don't merge different named types
    a .NamedType ? or b .NamedType ? if
      Type optional.empty return
    end
    a context types.isPointer and b context types.isPointer and
        a context types.getBaseType b context types.getBaseType types.typeEquals if
      a context types.isMutable b context types.isMutable & =:: mutable
      a context types.getArraySize =:: aSize
      b context types.getArraySize =:: bSize
      a context types.isFixedSize b context types.isFixedSize & =:: mut: fixedSize
      ## newArrayType
        a context types.getBaseType
        mutable if
          fixedSize if ArrayType .MUTABLE_POINTER else ArrayType .MUTABLE_RAW_POINTER end
        else
          fixedSize if ArrayType .POINTER else ArrayType .RAW_POINTER end
        end
        aSize bSize arraySizeEqual if aSize else ArraySize .Dynamic end
        context
      newArrayType return
    end
    a .IntLiteral ? and b context types.isNumber and
        a b context canAutoCastIntLiteral if
      b optional.wrap return
    end
    b .IntLiteral ? and a context types.isNumber and
        b a context canAutoCastIntLiteral if
      a optional.wrap return
    end
    a .IntLiteral .and =:: aLiteral b .IntLiteral .if =:: bLiteral
      ## XXX directly merge literal types?
      a bLiteral intLiteralAsInt context mergeTypes $ ? if
        return
      else ..drop
        aLiteral intLiteralAsInt b context mergeTypes return
      end
    end
    ## TODO handle initializer types
    Type optional.empty return
  end
end
## type context
struct(
  NameContext        : nameContext
  MixedArenaAllocator : memory
  NameId Type hashMap : namedTypes
  types.GeneratedTypeName types.GeneratedTypeValue hashMap : generatedTypes
) =:: export: TypeContext
namespace: types
  proc( -> TypeContext ) =>: export: newTypeContext
    ## TypeContext
      id.newNameContext
      4096 mixedArena.create
      NameId.hash@ NameId.eq@ 1024 Type map.create
      genNameHash@ genNameEq@ 1024 types.GeneratedTypeValue map.create
    TypeContext new return
  end
  proc( TypeContext : mut: context -> TypeContext ) =>: export: freeTypeContext
    context@ .namedTypes map.free
    context@ .generatedTypes map.free
    context
      $ .nameContext id.freeNameContext >$ .nameContext=
      $ .memory mixedArena.free >$ .memory=
    return
  end
end
namespace: sb
  proc( stringBuilder types.PrimitiveType -> stringBuilder ) =>: appendPrimitiveType
    switch
      BOOL case "bool" appendS return
      I8   case "i8"   appendS return
      I16  case "i16"  appendS return
      I32  case "i32"  appendS return
      I64  case "i64"  appendS return
      F16  case "f16"  appendS return
      F32  case "f32"  appendS return
      F64  case "f64"  appendS return
      TYPE case "type" appendS return
    end
  end
  proc( stringBuilder types.IntLiteral -> stringBuilder ) =>: appendIntLiteralType
    switch
      U7  case "..intLiteral.u7"   appendS return
      S8  case "..intLiteral.s8"   appendS return
      U8  case "..intLiteral.u8"   appendS return
      U15 case "..intLiteral.u15"  appendS return
      S16 case "..intLiteral.s16"  appendS return
      U16 case "..intLiteral.u16"  appendS return
      U24 case "..intLiteral.u24"  appendS return
      S25 case "..intLiteral.s25"  appendS return
      U31 case "..intLiteral.u31"  appendS return
      S32 case "..intLiteral.s32"  appendS return
      U32 case "..intLiteral.u32"  appendS return
      U53 case "..intLiteral.u53"  appendS return
      S54 case "..intLiteral.s54"  appendS return
      U63 case "..intLiteral.u63"  appendS return
      S64 case "..intLiteral.s64"  appendS return
      U64 case "..intLiteral.u64"  appendS return
    end
  end
  proc( stringBuilder types.CType -> stringBuilder ) =>: appendCType
    switch
      VOID case
        "..ctype.void" appendS return
      BOOL case
        "..ctype.bool" appendS return
      CHAR case
        "..ctype.char" appendS return
      S_CHAR case
        "..ctype.schar" appendS return
      U_CHAR case
        "..ctype.uchar" appendS return
      SHORT case
        "..ctype.short" appendS return
      U_SHORT case
        "..ctype.ushort" appendS return
      INT case
        "..ctype.int" appendS return
      U_INT case
        "..ctype.uint" appendS return
      LONG case
        "..ctype.long" appendS return
      U_LONG case
        "..ctype.ulong" appendS return
      LONGLONG case
        "..ctype.longlong" appendS return
      U_LONGLONG case
        "..ctype.ulonglong" appendS return
      SIZE case
        "..ctype.size" appendS return
      FLOAT case
        "..ctype.float" appendS return
      DOUBLE case
        "..ctype.double" appendS return
      STRUCT case
        "..ctype.struct" appendS return
      UNION case
        "..ctype.union" appendS return
    end
  end
  proc(
    stringBuilder : sb
    types.ArraySize : size
    NameContext ptr : nameContext
  -> stringBuilder  ) =>: export: appendSliceSize
    sb
      size switch
        None case break
        Dynamic case " _" sb.appendS break
        Int .case =:: sizeInt
          ' ' sb.appendC
          sizeInt sb.appendI
          break
        GenericArg .case =:: genSize
          '`' sb.appendC
          genSize appendIdentifierName
          '`' sb.appendC
          break
      end
    return
  end
  proc(
    stringBuilder : sb
    Type : t
    TypeContext ptr : context
    i32 : depth
  -> stringBuilder ) =>: export: appendTypeRecursive
    context .nameContext =:: nameContext
    t switch
      Undefined  case
        sb "undefined" appendS return
      Empty case
        sb "empty" appendS return
      PrimitiveType .case =:: primitive
        sb primitive appendPrimitiveType return
      IntLiteral .case =:: literal
        sb literal appendIntLiteralType return
      CType .case =:: CType
        sb CType appendCType return
      ArrayType Pointer MutablePointer RawPointer MutableRawPointer case
        sb
          ## appendTypeRecursive
            t context types.getBaseType
            context
            depth
          appendTypeRecursive
          t context types.getArraySize nameContext appendSliceSize
          t .Pointer ? if
            " ptr" appendS
          else t .MutablePointer ? _if
            " ptr.mut" appendS
          else t .ArrayType ? _if
            " array" appendS
          else t .RawPointer ? _if
            " ptr.raw" appendS
          else
            " ptr.raw.mut" appendS
          end
        return
      Struct TaggedUnion RawUnion Initializer case
        sb
          t .Struct ? if
            "struct( " appendS
          else t .TaggedUnion ? _if
            "union( " appendS
          else t .RawUnion ? _if
            "union.raw( " appendS
          else
            "initializer( " appendS
          end
          depth 0 > if
            t depth context appendComposite
          else
            "... " appendS
          end
         ")" appendS
       return
      Enum .case =:: enumType
        sb
          "enum( " appendS
          enumType types.EnumInfo ptr cast [] context .nameContext appendEnumElements
          ")" appendS
        return
      UnionElement .case types.UnionElementInfo ptr cast =:: element
        element [] .base =:: baseType
        sb
          baseType context depth appendTypeRecursive
          '.' sb.appendC
          baseType context types.asRawUnion .else baseType end
            element [] .index
          context types.compositeGetEltName optional.unwrap appendIdentifierName
        return
      Procedure  .case types.ProcType ptr cast [] =:: procType
        sb
          procType .callingConvention switch
            CONCAT PTRCALL case "proc( " appendS break
            CCALL  case "proc.c( " appendS break
          end
          0:iSize =:: mut: eltIndex
          procType .inTypes for
            context depth appendTypeRecursive
            eltIndex procType .eltNames .length u< if
              procType .eltNames eltIndex [] .if appendTypeElementName end
              eltIndex 1:iSize + eltIndex=
            end
            ' ' sb.appendC
          end
          "-> " appendS
          procType .outTypes for
            context depth appendTypeRecursive
            eltIndex procType .eltNames .length u< if
              procType .eltNames eltIndex [] .if appendTypeElementName end
              eltIndex 1:iSize + eltIndex=
            end
            ' ' sb.appendC
          end
          ")" appendS
        return
      NamedType .case =:: typeName
        sb
          ## appendNamedType
            typeName
            context
            depth
          appendNamedType
        return
      GenericType .case =:: nameId
        sb
          '`' sb.appendC
          nameId appendIdentifierName
          '`' sb.appendC
        return
      GeneratedType .case types.GeneratedTypeName ptr cast =:: genTypeName
        sb
          genTypeName .arguments [] .length for =:: i
            genTypeName [] .arguments i [] context sb.appendConstant
            ' ' sb.appendC
          end
          genTypeName [] .generator nameContext sb.appendIdentifierPath
          depth 0 > if
            " [ "     appendS
              context .generatedTypes
                genTypeName []
              map.get .if
                .value .if
                  context depth 1 - appendTypeRecursive
                else
                  '?' sb.appendC
                end
              else
                "??" sb.appendS
              end
            " ]"     appendS
          end
        return
      Align .case =:: alignment
        sb
          "..type.align" sb.appendS
          alignment sb.appendI
        return
      SetType case
        sb
          "oneOf( " sb.appendS
          depth 0 >= if
            t context types.getSetTypeEntries for
              context sb.appendConstant ## TODO! find way to preserve recursion depth through mutual call
              ' ' sb.appendC
            end
          else t context types.getSetTypeEntries .length 0:iSize != _if
            "... " sb.appendS
          end
          ")" sb.appendS
        return
      RefinementType case
        sb
          t context types.unwrapRefinement context depth 1 - appendTypeRecursive
          " .with( " sb.appendS
            t context types.getTypeTrait .if
              ProcId.getName nameContext sb.appendIdentifierPath '@' sb.appendC
            else
              '?' sb.appendC
            end
          " )" sb.appendS
        return
    end
  end
  proc( stringBuilder Type TypeContext ptr -> stringBuilder ) =>: export: appendType
    0 appendTypeRecursive return ## TODO? change default value to 1
  end
  proc(
    stringBuilder
    Type : t
    TypeContext ptr.mut : context
    i32 : mut: level
    i32 : levels
  -> stringBuilder ) =>: export: appendTypeLayoutRecursive
    context .nameContext =:: nameContext
    ## string 16
    ##    0 | char8 ptr.raw | 8
    ##    8 | "iSize"       | 8
    t context appendType " | ":s sb.appendStr
    $ .length =:: l0
    t context types.sizeOf switch
      Fixed .case sb.appendI break
      DynamicArray .case sb.appendI " array":s sb.appendStr return
      Unknown case '?' sb.appendC return
    end
    $ .length l0 - =:: sizeWidth
    level levels u>= if return end
    level 1 + level=
    t context types.isTuple if
      t context types.compositeEltCount for =:: i
        '\n' sb.appendC level sb.indent
        $ .length =:: l1
        t i context types.tupleElementOffset .if sb.appendI else '?' sb.appendC end
        $ .length l1 - =:: w
        w sizeWidth u< if
          sizeWidth w - i32 cast.u sb.indent
        end
        " | ":s sb.appendStr
        t i context types.compositeGetElement context level levels appendTypeLayoutRecursive
      end
    else t context types.isUnion _if
      t context types.compositeElts for =:: elt
        '\n' sb.appendC level sb.indent
        elt context level levels appendTypeLayoutRecursive
      end
    end
  end
  proc( stringBuilder Type i32 : depth TypeContext ptr.mut -> stringBuilder ) =>: export: appendTypeLayout
    0 depth appendTypeLayoutRecursive return
  end
end
