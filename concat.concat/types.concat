#include list
#include arrayView
#include string
#include stringBuilder

#include "labels.concat"

#namespace types
enum( BOOL I8 I16 I32 I64 FLOAT32 FLOAT64 TYPE ) =:: PrimitiveType
i32 =:: public ArrayId
i32 =:: public CompositeId
i32 =:: public ProcId
i32 =:: public NamedTypeId
#end

enum(
                        undefined
  types.PrimitiveType : primitiveType
        types.ArrayId : pointer
        types.ArrayId : arrayType
    types.CompositeId : tuple
    types.CompositeId : struct
    types.CompositeId : union
    types.CompositeId : labeledProcIn
    types.CompositeId : procIn
    types.CompositeId : procOut
    types.CompositeId : enum
         types.ProcId : procedure
    types.NamedTypeId : namedType
                  i32 : autoType
                  i32 : genericType
                  i32 : templateType
) =:: public Type
#namespace types
proc( Type : a Type : b => bool ) =: public typeEquals
  a b != if
    false return
  end
  a switch
    undefined case
      true return ## there is only one undefined
    primitiveType case
      a .primitiveType b .primitiveType == return
    pointer case
      a .pointer b .pointer == return
    arrayType case
      a .arrayType b .arrayType == return
    tuple case
      a .tuple b .tuple == return
    struct case
      a .struct b .struct == return
    union case
      a .union b .union == return
    labeledProcIn case
      a .labeledProcIn b .labeledProcIn == return
    procIn case
      a .procIn b .procIn == return
    procOut case
      a .procOut b .procOut == return
    enum case
      a .enum b .enum == return
    procedure case
      a .procedure b .procedure == return
    namedType case
      a .namedType b .namedType == return
    autoType case
      a .autoType b .autoType == return
    genericType case
      a .genericType b .genericType == return
    templateType case
      a .templateType b .templateType == return
  end
end
1011001 =:: bigPrime
proc( PrimitiveType => i32 ) =: primitiveId
  switch
    BOOL case 0 return
    I8 case 1 return
    I16 case 2 return
    I32 case 3 return
    I64 case 4 return
    FLOAT32 case 5 return
    FLOAT64 case 6 return
    TYPE case 7 return
  end
end
proc( Type : a => i32 ) =: public typeHash
  a switch
    undefined case
      0 return ## there is only one undefined
    primitiveType case
      bigPrime a .primitiveType primitiveId + return
    pointer case
      bigPrime 2 * a .pointer + return
    arrayType case
      bigPrime 3 * a .arrayType + return
    tuple case
      bigPrime 4 * a .tuple + return
    struct case
      bigPrime 5 * a .struct + return
    union case
      bigPrime 6 * a .union + return
    labeledProcIn case
      bigPrime 7 * a .labeledProcIn + return
    procIn case
      bigPrime 8 * a .procIn + return
    procOut case
      bigPrime 9 * a .procOut + return
    enum case
      bigPrime 10 * a .enum + return
    procedure case
      bigPrime 12 * a .procedure + return
    namedType case
      bigPrime 14 * a .namedType + return
    autoType case
      bigPrime 15 * a .autoType + return
    genericType case
      bigPrime 16 * a .genericType + return
    templateType case
      bigPrime 17 * a .templateType + return
  end
end

#end
type : public TypeContext
#namespace types

## primitive types
#namespace primitive
  PrimitiveType .BOOL      Type .primitiveType new Type =: public BOOL
  PrimitiveType .I8        Type .primitiveType new Type =: public I8
  PrimitiveType .I16       Type .primitiveType new Type =: public I16
  PrimitiveType .I32       Type .primitiveType new Type =: public I32
  PrimitiveType .I64       Type .primitiveType new Type =: public I64
  PrimitiveType .FLOAT32   Type .primitiveType new Type =: public FLOAT32
  PrimitiveType .FLOAT64   Type .primitiveType new Type =: public FLOAT64
  PrimitiveType .TYPE      Type .primitiveType new Type =: public TYPE
  ## compiler internal type-aliases for special purpose types
  PrimitiveType .I64       Type .primitiveType new Type =: public I_SIZE ## size-off memory-sections
  PrimitiveType .I64       Type .primitiveType new Type =: public I_PTR  ## integer that can hold a pointer
#end
proc( Type => bool ) =: public isPrimitive
  Type .primitiveType == return
end
proc( Type TypeContext ptr => bool ) =: public isEmpty
  unwrapNamed
  Type .undefined == return
end
proc( Type TypeContext ptr => bool ) =: public isBoolean
  unwrapNamed
    #dup isPrimitive ! if #drop
      false return
    end .primitiveType
    PrimitiveType .BOOL == return
end
proc( Type TypeContext ptr => bool ) =: public isInt
  unwrapNamed
    #dup isPrimitive ! if #drop
      false return
    end .primitiveType
    switch
      BOOL FLOAT32 FLOAT64 TYPE case
        false return
      I8 I16 I32 I64 case
        true return
    end
end
proc( Type TypeContext ptr => bool ) =: public isFloat
  unwrapNamed
    #dup isPrimitive ! if #drop
      false return
    end .primitiveType
    switch
      BOOL I8 I16 I32 I64 TYPE case
        false return
      FLOAT32 FLOAT64 case
        true return
    end
end
proc( Type TypeContext ptr => bool ) =: public isNumber
  unwrapNamed
    #dup isPrimitive ! if #drop
      false return
    end .primitiveType
    switch
      BOOL TYPE case
        false return
      I8 I16 I32 I64 FLOAT32 FLOAT64 case
        true return
    end
end
proc( Type TypeContext ptr => bool ) =: public isSmallType
  unwrapNamed
  switch
    primitiveType pointer enum case true return
    arrayType tuple struct union labeledProcIn procIn procOut procedure ## TODO? count tuples with size < 128 as small types
    undefined namedType autoType genericType templateType case false return
  end
end
proc( Type TypeContext ptr => i32 ) =: public numberPrecision
  unwrapNamed
    #dup isPrimitive ! if #drop
      -1 return
    end .primitiveType
    switch
      BOOL TYPE case
        -1 return
      I8 case
        7 return
      I16 case
        15 return
      I32 case
        31 return
      I64 case
        63 return
      FLOAT32 case
        24 return ## IEEE float-32
      FLOAT64 case
        53 return ## IEEE float-64
    end
end
64 =:: public MAX_INT_WIDTH
#+largest integer n s.t. 2^n-1 fits in the type+#
proc( Type TypeContext ptr => i32 ) =: public numberSize
  unwrapNamed
    #dup isPrimitive ! if #drop
      -1 return
    end .primitiveType
    switch
      BOOL TYPE case
        -1 return
      I8 case
        7 return
      I16 case
        15 return
      I32 case
        31 return
      I64 case
        63 return
      FLOAT32 case
        127 return ## IEEE float-32
      FLOAT64 case
        1023 return ## IEEE float-64
    end
end
proc( Type : a Type : b TypeContext ptr mut : context => Type ) =: public commonIntType
  a context types.isInt ! b context types.isInt ! | if
    Type .undefined return
  end
  a context numberPrecision b context numberPrecision < if
    b return
  else
    a return
  end
end
proc( Type : a Type : b TypeContext ptr mut : context => Type ) =: public commonNumberType
  a context types.isNumber ! b context types.isNumber ! | if
    Type .undefined return
  end
  a context numberPrecision b context numberPrecision <=
  a context numberSize b context numberSize <= & if
    b return
  end
  a context numberPrecision b context numberPrecision >=
  a context numberSize b context numberSize >= & if
    a return
  end
  Type .undefined return
end

## array & pointer types
enum( int templateArg staticArg ) =:: public ArraySizeType
struct( i64 : value ArraySizeType : sizeType ) =:: public ArraySize
struct( Type : base i64 : sizeOffset i64 : dims bool : fixedSize bool : mut ptrOnly bool : mutable ) =:: ArrayType

proc( Type TypeContext ptr => bool ) =: public isPointer
  unwrapNamed
  Type .pointer == return
end
proc( Type TypeContext ptr => bool ) =: public isArray
  unwrapNamed
  Type .arrayType == return
end
proc( Type TypeContext ptr => bool ) =: public isFixedSize
  =:: context
  context unwrapNamed
  #dup Type .pointer == if
    context [] .arrayTypes #swap .pointer list.get .fixedSize return
  end
  #dup Type .arrayType == if
    context [] .arrayTypes #swap .arrayType list.get .fixedSize return
  end #drop
  false return
end
proc( Type TypeContext ptr => bool ) =: public isFixedSizePtr
  =:: context
  context unwrapNamed
  #dup Type .pointer == if
    context [] .arrayTypes #swap .pointer list.get .fixedSize return
  end #drop
  false return
end
proc( Type TypeContext ptr => bool ) =: public isRawPointer
  =:: context
  context unwrapNamed
  #dup Type .pointer == if
    context [] .arrayTypes #swap .pointer list.get .fixedSize ! return
  end #drop
  false return
end
proc( Type : box TypeContext ptr : context => Type ) =: public getBaseType
  box context unwrapNamed
    #dup context isPointer if
      context [] .arrayTypes #swap .pointer list.get .base return
    end
    #dup context isArray if
      context [] .arrayTypes #swap .arrayType list.get .base return
    end
  #drop
  Type .undefined return
end
proc( Type : box TypeContext ptr : context => i64 ) =: public getArrayDims
  box context unwrapNamed
    #dup context isPointer if
      context [] .arrayTypes #swap .pointer list.get =:: arrayType
      arrayType .fixedSize ! if 1 return end
      arrayType .dims return
    end
    #dup context isArray if
      context [] .arrayTypes #swap .arrayType list.get =:: arrayType
      arrayType .fixedSize ! if 1 return end
      arrayType .dims return
    end
  #drop
  0 return
end
proc( Type : box TypeContext ptr : context => ArraySize arrayView ) =: public getArraySize
  box context unwrapNamed
    #dup context isPointer if
      context [] .arrayTypes #swap .pointer list.get =:: arrayType
      context [] .arraySizes arrayType .sizeOffset arrayType .dims list.slice return
    end
    #dup context isArray if
      context [] .arrayTypes #swap .arrayType list.get =:: arrayType
      context [] .arraySizes arrayType .sizeOffset arrayType .dims list.slice return
    end
  #drop
  ArraySize array.empty return
end
proc( Type TypeContext ptr => bool ) =: public isMutable
  =:: context
  context unwrapNamed
    #dup context isPointer if
      context [] .arrayTypes #swap .pointer list.get .mutable return
    end
  #drop false return
end
proc( Type ptr mut : t bool : mutable TypeContext ptr mut : context => bool ) =: public setMutability
  t [] context isMutable  mutable == if
    false return
  end
  t [] Type .pointer == if
    context [] .arrayTypes t [] .pointer list.get =:: arrayType
    ## newArrayType
      t [] context getBaseType
      true
      arrayType .fixedSize if
        context [] .arraySizes arrayType .sizeOffset arrayType .dims list.slice
        true
      else
        ArraySize array.empty
        false
      end
      mutable
    context newArrayType if
      #drop true return
    end t [] =
    false return
  end
  ## XXX ? allow marking named pointer types as mutable
  true return
end
proc( ArraySize arrayView : a ArraySize arrayView : b => bool ) =: arraySizeEqual
  a .length b .length != if
    false return
  end
  0 while #dup a .length < do
    a #over array.get .sizeType b #over:2 array.get .sizeType != if
      #drop false return
    end
    a #over array.get .value b #over:2 array.get .value != if
      #drop false return
    end
    1 +
  end #drop
  true return
end
proc( Type : target bool : isPtr ArraySize arrayView : sizes bool : fixedSize bool : mutable  TypeContext ptr mut : context => Type bool ) =: public newArrayType
  isPtr ! sizes .length 0 == & if
    Type .undefined true return
  end
  target =:: mut base
  base Type .undefined  == if
    Type .undefined true return
  end
  ## procedure types are only allowed as base for fixed-size 0 dimensional pointers
  base context isProcedure if
    isPtr ! fixedSize ! | sizes .length 0 > | if
      Type .undefined true return
    end
    base
      context asUnlabeledProc if #drop
        Type .undefined true return
      end
    base =
  end
  context [] .arrayTypes addrOf =:: arrays
  0 while #dup arrays [] .length < do
    arrays [] #over list.get
      #dup .mutable   mutable   != if #drop
        1 + continue
      end
      #dup .fixedSize fixedSize != if #drop
        1 + continue
      end
      fixedSize if #dup .dims sizes .length != if #drop
        1 + continue
      end end
      #dup .base base typeEquals ! if #drop
        1 + continue
      end
      context [] .arraySizes #over .sizeOffset #over:2 .dims list.slice sizes arraySizeEqual ! if #drop
        1 + continue
      end
    .ptrOnly isPtr & arrays [] #over:2 list.at .data [] .ptrOnly = ## update ptrOnly flag
    ## found match
    isPtr if ArrayId cast Type .pointer new else ArrayId cast Type .arrayType new end false return
  end #drop
  context [] .arraySizes
    #dup .length =:: sizeOffset
    sizes list.appendArray
  context [] .arraySizes =
  arrays []
    base sizeOffset sizes .length fixedSize isPtr mutable ArrayType new list.append
  arrays [] =
  arrays [] .length 1 - isPtr if ArrayId cast Type .pointer new else ArrayId cast Type .arrayType new end
  false return
end

i32 =:: LabelOffset
-1 LabelOffset =: public UNLABELED
## composite types
i32 =:: CompositeFlag
1   CompositeFlag =: COMP_FLAG_TUPLE
2   CompositeFlag =: COMP_FLAG_ENUM
4   CompositeFlag =: COMP_FLAG_UNION
8   CompositeFlag =: COMP_FLAG_PROC_IN
16  CompositeFlag =: COMP_FLAG_PROC_OUT
63  CompositeFlag =: public COMP_CLASS_MASK
64  CompositeFlag =: public COMP_FLAG_VOID_ONLY
128 CompositeFlag =: public COMP_FLAG_STATIC_ARGS
256 CompositeFlag =: public COMP_FLAG_TEMPLATE
384 CompositeFlag =: public COMP_GENERIC_MASK
struct( i64 : eltsOffset LabelOffset : _labelOffset i64 : eltCount CompositeFlag : mut flags ) =:: CompositeType

proc( Type TypeContext ptr => bool ) =: public isComposite
  unwrapNamed
  switch
    tuple struct union labeledProcIn procIn procOut enum case
      true return
    undefined primitiveType pointer arrayType procedure namedType autoType genericType templateType case
      false return
  end
end
proc( Type TypeContext ptr => bool ) =: public isTuple
  unwrapNamed
  #dup Type .tuple == #swap Type .struct == | return
end
proc( Type TypeContext ptr => bool ) =: public isEnum
  unwrapNamed
  Type .enum == return
end
proc( Type TypeContext ptr => bool ) =: public isUnion
  unwrapNamed
  Type .union == return
end
proc( Type : composite TypeContext ptr mut : context => CompositeType ptr mut optional ) =: compositeData
  composite context unwrapNamed
    #dup switch
      tuple case
        .tuple
        break
      struct case
        .struct
        break
      union case
        .union
        break
      labeledProcIn case
        .labeledProcIn
        break
      procIn case
        .procIn
        break
      procOut case
        .procOut
        break
      enum case
        .enum
        break
      undefined primitiveType pointer arrayType procedure namedType autoType genericType templateType case
        #drop CompositeType ptr mut optional.empty return
    end
  context [] .compositeTypes #swap list.at return
end
proc( Type : composite TypeContext ptr mut : context => i64 ) =: public compositeEltCount
  composite context compositeData
    #dup optional.isEmpty if #drop
      0 return
    end
  .data [] .eltCount return
end
proc( Type : composite i32 : index TypeContext ptr mut : context => LabelId ) =: public compositeGetLabel
  composite context unwrapNamed
    #dup switch
      struct union labeledProcIn enum case
        break
      undefined primitiveType pointer arrayType procedure namedType autoType genericType templateType tuple procIn procOut case
        #drop id.LABEL_ID_NONE return
    end
  context compositeData
    #dup optional.isEmpty if #drop
      id.LABEL_ID_NONE return
    end
  .data [] ._labelOffset =:: offset
  offset UNLABELED == if
    id.LABEL_ID_NONE return
  end
  context [] .elementLabels offset index + list.get return
end
proc( Type : composite string : name LabelContext ptr mut : labelContext TypeContext ptr mut : context => i32 ) =: public compositeFindLabel
  composite context unwrapNamed
    #dup switch
      struct union labeledProcIn enum case
        break
      undefined primitiveType pointer arrayType procedure namedType autoType genericType templateType tuple procIn procOut case
        #drop -1 return
    end
  context compositeData
    #dup optional.isEmpty if #drop
      -1 return
    end
  .data =:: labels
  0 while #dup labels [] .eltCount < do
    context [] .elementLabels labels [] ._labelOffset #over:2 + list.get labelContext id.labelName #dup optional.hasData if .data name string.eq if
      return
    end else #drop end
    1 +
  end #drop
  -1 return
end
proc( Type : union Type : elt LabelContext ptr mut : labelContext TypeContext ptr mut : context => i32 bool ) =: public findUnionTypeIndex
  union context compositeElts =:: elts
  0 while #dup elts .length < do
    elt elts #over:2 array.get typeEquals if
      false return
    end
    1 +
  end #drop
  0 while #dup elts .length < do
    elt elts #over:2 array.get context canAutoCast if
      false return
    end
    1 +
  end #drop
  -1 true return
end
proc( Type : composite i64 : index TypeContext ptr mut : context => Type ) =: public compositeGetElement
  composite context compositeData
    #dup optional.isEmpty if #drop
      Type .undefined return
    end
  .data [] .eltsOffset index + context [] .compositeData #swap list.get return
end
proc( Type : composite TypeContext ptr mut : context => Type arrayView ) =: public compositeElts
  composite context compositeData
    #dup optional.isEmpty if #drop
      Type array.empty return
    end
  .data =:: data
  context [] .compositeData .data data [] .eltsOffset + data [] .eltCount array.create return
end
proc( Type : composite TypeContext ptr mut : context => CompositeFlag ) =: public compositeFlags
  composite context compositeData
    #dup optional.isEmpty if #drop
      0 return
    end
  .data [] .flags return
end

proc( Type arrayView : a Type arrayView : b => i32 ) =: typesOffset
  a .length b .length < if
    -1 return
  end
  0 while #dup a .length b .length - <= do
    true =:: mut match
    0 while #dup b .length < do
      a #over:2 #over:2 + array.get b #over:3 #over:3 + array.get typeEquals ! if
        false match =
        break
      end
      1 +
    end #drop
    match if
      return
    end
    1 +
  end #drop
  -1 return
end
proc( LabelOffset : offset LabelId arrayView optional : labels TypeContext ptr mut : context => bool ) =: labelsEqual
  offset UNLABELED == if ## unlabeled -> on labels
    labels optional.isEmpty return
  end
  labels optional.isEmpty if
    false return
  end
  labels .data =:: newLabels
  context [] .elementLabels list.asArray offset array.tail =:: prevLabels
  prevLabels .length newLabels .length < if
    false return
  end
  0 while #dup newLabels .length < do
    prevLabels #over array.get newLabels #over:2 array.get != if #drop ## XXX compare strings instead of labelIds
      false return
    end
    1 +
  end #drop
  true return
end
proc( CompositeFlag : classFlag Type arrayView : elts LabelId arrayView optional : labels TypeContext ptr mut : context => CompositeId ) =: public newCompositeType
  classFlag CompositeFlag =: mut flags
  true =:: mut isVoid
  0 while #dup elts .length < do
    elts #over array.get
      #dup Type .undefined != if
        false isVoid =
      end
      #dup context containsGeneric if
        flags COMP_FLAG_STATIC_ARGS | flags =
      end
      #+2nd return value+# if
        flags COMP_FLAG_TEMPLATE | flags =
      end
    #drop
    1 +
  end #drop
  isVoid if
    flags COMP_FLAG_VOID_ONLY | flags =
  end
  context [] .compositeTypes addrOf =:: composites
  0 while #dup composites [] .length < do
    composites [] #over list.get
      #dup .eltCount elts .length != if #drop
        1 + continue
      end
      #dup ._labelOffset labels context labelsEqual ! if #drop
        1 + continue
      end
      context [] .compositeData #over .eltsOffset #over:2 .eltCount list.slice elts typesOffset 0 != if #drop
        1 + continue
      end
    .flags flags | composites [] #over:2 list.at .data [] .flags = ## update flags
    ## found match
    CompositeId cast return
  end #drop
  context [] .compositeData
    #dup .length =:: eltsOffset
    elts list.appendArray
  context [] .compositeData =
  LabelOffset : labelOffset
  labels optional.isEmpty if
    UNLABELED labelOffset =
  else
    context [] .elementLabels
      #dup .length LabelOffset cast labelOffset =
      labels .data list.appendArray
    context [] .elementLabels =
  end
  composites []
    eltsOffset labelOffset elts .length flags CompositeType new list.append
  composites [] =
  composites [] .length 1 - CompositeId cast
  return
end
## creates struct or tuple
proc( Type arrayView : elts LabelId arrayView optional : labels TypeContext ptr mut : context => Type bool ) =: public newTuple
  elts .length 0 == if
    Type .undefined true return
  end
  COMP_FLAG_TUPLE elts labels context newCompositeType
  labels optional.isEmpty if Type .tuple new else Type .struct new end
  false return
end
proc( Type arrayView : elts LabelId arrayView optional : labels bool : isOut TypeContext ptr mut : context => Type ) =: public newProcArgs
  isOut if COMP_FLAG_PROC_OUT else COMP_FLAG_PROC_IN end elts labels context newCompositeType
  isOut if Type .procOut new else labels optional.isEmpty _if Type .procIn new else Type .labeledProcIn new end ## XXX? labeled proc out
  return
end
proc( Type arrayView : elts LabelId arrayView optional : labels TypeContext ptr mut : context => Type bool ) =: public newEnum
  elts .length 0 ==  labels optional.isEmpty | if
    Type .undefined true return
  end
  COMP_FLAG_TUPLE elts labels context newCompositeType Type .enum new false return
end
proc( Type arrayView : elts LabelId arrayView optional : labels TypeContext ptr mut : context => Type bool ) =: public newUnion
  elts .length 0 == labels optional.isEmpty | if
    Type .undefined true return
  end
  COMP_FLAG_UNION elts labels context newCompositeType Type .union new false return
end
#end
#namespace sb
proc( stringBuilder types.CompositeType LabelContext ptr TypeContext ptr => stringBuilder ) =: appendComposite
  =:: context
  =:: labelContext
  =:: comp
  comp ._labelOffset types.UNLABELED == =:: unlabeled
  0 while #dup comp .eltCount < do
    #swap
      context [] .compositeData #over:2 comp .eltsOffset + list.at .data =:: eltType
      unlabeled if
        eltType [] labelContext context false appendTypeRecursive
        ' ' appendC
        #swap 1 + continue
      end
      context [] .elementLabels comp ._labelOffset #over:3 + list.get =:: label
      label labelContext id.labelName =:: labelName
      eltType [] context types.isEmpty ! if
        eltType [] labelContext context false appendTypeRecursive
        labelName optional.hasData if
          " : " appendS
        else
          ' ' appendC
        end
      end
      labelName optional.hasData if
        label labelContext id.labelFlags id.FLAG_MUTABLE & 0 != if
          "mut " appendS
        end
        labelName .data appendStr
        ' ' appendC
      end
    #swap
    1 +
  end #drop
  return
end
#end
#namespace types

## procedure types
struct( Type : in Type : out ) =:: ProcType

proc( Type TypeContext ptr => bool ) =: public isProcedure
  unwrapNamed
  Type .procedure == return
end
proc( Type : mType TypeContext ptr : context => bool ) =: public isCallable
  mType context unwrapNamed
    #dup context isPointer if
      context getBaseType
    end
  Type .procedure == return
end
proc( Type : proc TypeContext ptr : context => Type bool ) =: public getProcIn
  proc context unwrapNamed
    #dup context isProcedure ! if #drop
      Type .undefined true return
    end
  context [] .procTypes #swap .procedure list.get .in false return
end
proc( Type : proc TypeContext ptr : context => Type bool ) =: public getProcOut
  proc context unwrapNamed
    #dup context isProcedure ! if #drop
      Type .undefined true return
    end
  context [] .procTypes #swap .procedure list.get .out false return
end
proc( Type : proc CallingConvention : callConvention TypeContext ptr mut : context => Type bool ) =: public getProcRet
  proc context getProcOut if true return end =:: outType
  callConvention switch
    STRUCT case outType false return
    POINTER case
      outType context compositeElts =:: elts
      elts .length 0 == if
        Type .undefined false return
      end
      elts elts .length 1 - array.get =:: lastArg
      lastArg context isSmallType if lastArg else Type .undefined end false return
  end
end
proc( Type : in Type : out TypeContext ptr mut : context => Type bool ) =: public newProcedure
  in Type .undefined == out Type .undefined == | if
    Type .undefined true return
  end
  context [] .procTypes addrOf =:: procs
  0 while #dup procs [] .length < do
    procs [] #over list.get .in in typeEquals
    procs [] #over:2 list.get .out out typeEquals & if
      ProcId cast Type .procedure new false return
    end
    1 +
  end #drop
  procs []
    in out ProcType new list.append
  procs [] =
  procs [] .length 1 - ProcId cast Type .procedure new
  false return
end
proc( Type : proc TypeContext ptr mut : context => Type bool ) =: public asUnlabeledProc
  proc context unwrapNamed
    #dup context isCallable ! if #drop
      proc true return
    end
    false =:: mut isPtr
    #dup context isPointer if
      context getBaseType
      true isPtr =
    end
  =:: mProc
  context [] .procTypes mProc .procedure list.get
    #dup .in Type .procIn == if #drop
      proc false return
    end
    context [] .compositeTypes #over .in .labeledProcIn list.get =:: mut inType
    context [] .compositeData inType .eltsOffset inType .eltCount list.slice LabelId arrayView optional.empty false context newProcArgs
  #swap .out context newProcedure if #drop proc true return end
    isPtr if
      true ArraySize array.empty true false context newArrayType return
    end
  false return
end
proc( Type : proc TypeContext ptr mut : context => bool ) =: public hasStaticArgs
 true return ## TODO implement hasStaticArgs
end

## named types
struct( Type : mut data LabelId : name TemplateId : templateId i32 : mut implId ) =:: NamedType
proc( Type LabelId TemplateId TypeContext ptr mut => Type ) =: public newNamedType
  =:: context
  -1 NamedType new context [] .namedTypes #swap list.append context [] .namedTypes =
  context [] .namedTypes .length 1 - NamedTypeId cast Type .namedType new return
end
proc( Type => bool ) =: public isNamedType
  Type .namedType == return
end
proc( Type TypeContext ptr => Type ) =: public unwrapNamed
  =:: context
  while #dup Type .namedType == do
    context [] .namedTypes #swap .namedType list.at .data [] .data
  end
  return
end
proc( Type TypeContext ptr => LabelId ) =: public namedTypeName
  =:: context
  #dup Type .namedType == if
    context [] .namedTypes #swap .namedType list.get .name return
  end
  #drop id.LABEL_ID_NONE return
end
proc( Type TypeContext ptr => LabelId ) =: public getImplId
  =:: context
  #dup Type .namedType == if
    context [] .namedTypes #swap .namedType list.get .implId return
  end
  #drop -1 return
end
proc( Type : named Type : value i32 : implId TypeContext ptr mut : context => bool ) =: public setNamedType
  named Type .namedType == if
    context [] .namedTypes named .namedType list.at .data
      #dup [] .data Type .undefined typeEquals if
        value #over [] .data =
        implId #swap [] .implId =
        false return
      end
    #drop
  end
  true return
end

#end
#namespace sb
proc( stringBuilder types.NamedType LabelContext ptr TypeContext ptr bool => stringBuilder ) =: appendNamedType
  =:: allowRecurse
  =:: context
  =:: labelContext
  #swap
    '"' sb.appendC
    #over .name labelContext id.labelName .data sb.appendStr
    '"' sb.appendC
    " [ " sb.appendS
    #swap .data context types.unwrapNamed labelContext context allowRecurse appendTypeRecursive
    " ]"  sb.appendS
  return
end
#end
#namespace types

## generic,template & auto-types
proc( i32 : id => Type ) =: public newAutoType
  id Type .autoType new return
end
proc( Type => bool ) =: public isAutoType
  Type .autoType == return
end
proc( i32 : id => Type ) =: public newGenericType
  id Type .genericType new return
end
proc( i32 : id => Type ) =: public newTemplateType
  id Type .templateType new return
end

proc( Type => i32 ) =: public getTypeId
  #dup switch
    autoType case .autoType return
    genericType case .genericType return
    templateType case .templateType return
    pointer case .pointer return
    arrayType case .arrayType return
    tuple case .tuple return
    struct case .struct return
    union case .union return
    labeledProcIn case .labeledProcIn return
    procIn case .procIn return
    procOut case .procOut return
    enum case .enum return
    procedure case .procedure return
    namedType case .namedType return
    undefined primitiveType case #drop -1 return
  end
end

proc( Type : src TypeContext ptr mut : context => bool ) =: public isMultiValueType
  src context unwrapNamed
    #dup context isComposite if #drop
      true return
    end
    #dup context isArray if #drop
      true return
    end
    ## pointer is only a single value
  #drop
  false return
end

proc( Type : t0 TypeContext ptr mut : context => bool #+has template+# bool #+has static arg+# ) =: public containsGeneric
  t0 context unwrapNamed =:: t
  t switch
    undefined primitiveType autoType case
      false false return
    pointer arrayType case
      context [] .arrayTypes t #dup Type .pointer == if .pointer else .arrayType end list.get =:: arrayType
      arrayType .base context containsGeneric =:: mut isStatic =:: mut isTemplate
      isTemplate isStatic & arrayType .fixedSize ! | if
        isTemplate isStatic return
      end
      0 while #dup arrayType .dims < do
        context [] .arraySizes arrayType .sizeOffset #over:2 + list.get .sizeType
          #dup ArraySizeType .staticArg == if
            true isStatic =
          end
        ArraySizeType .templateArg == if
            true isTemplate =
        end
        1 +
      end #drop
      isTemplate isStatic return
    tuple struct union labeledProcIn procIn procOut enum case
      t context compositeData .data [] .flags #dup COMP_FLAG_TEMPLATE & 0 != #swap COMP_FLAG_STATIC_ARGS & 0 != return
    procedure case
      context [] .procTypes t .procedure list.get
        #dup .in context containsGeneric =:: isStatic =:: isTemplate
        .out context containsGeneric isStatic | #swap isTemplate | #swap return
    namedType case
      t context unwrapNamed context containsGeneric return
    genericType case
      false true return
    templateType case
      true false return
  end
end

proc( Type : src bool : mutable TypeContext ptr mut : context => Type ) =: public getAddressType
  src context isArray if
    src context unwrapNamed =:: unwraped
    unwraped context getBaseType true unwraped context getArraySize true mutable context newArrayType #drop return
  end
  src context isProcedure if
    src context asUnlabeledProc #drop
  else
    src
  end
  true ArraySize array.empty true mutable context newArrayType #drop return
end

proc( Type : src Type : target bool : reshape TypeContext ptr : context => bool ) =: sizeCompatible
  #using types
  target context isFixedSize ! if
    true return
  end
  src context isFixedSize ! if
    false return
  end
  src context getArraySize =:: srcSize
  target context getArraySize =:: targetSize
  srcSize .length targetSize .length < if srcSize .length else targetSize .length end =:: commonPart
  1 i64 =: mut srcTotal
  1 i64 =: mut targetTotal
  0 while #dup commonPart < do
    srcSize #over array.get .sizeType targetSize #over:2 array.get .sizeType != if #drop
      false return
    end
    reshape if
      srcSize #over array.get .sizeType ArraySizeType .int == if
        srcTotal srcSize #over array.get .value * srcTotal =
        targetTotal targetSize #over array.get .value * targetTotal =
      else srcTotal targetTotal != _if #drop
        false return
      end
      1 + continue
    end
    srcSize #over array.get .value targetSize #over:2 array.get .value != if #drop
      false return
    end
    1 +
  end #drop
  reshape if ## TODO look at remaining sizes
    srcTotal targetTotal == return
  end
  srcSize .length while #dup targetSize .length < do
    targetSize #over array.get .sizeType ArraySizeType .int != targetSize #over:2 array.get .value 1 != | if #drop
      false return
    end
    1 +
  end #drop
  true return
end
proc( Type : src Type : to TypeContext ptr mut : context => bool ) =: public canAutoCast
  to =:: mut target
  src types.isNamedType ! target types.isNamedType & if
    target context types.unwrapNamed target =
  end
  src target types.typeEquals if
    true return
  end
  src context types.isNumber target context types.isNumber & if
    src context types.numberPrecision target context types.numberPrecision <=
    src context types.numberSize target context types.numberSize <= & return
  end
  src context types.isPointer src context types.isArray | target context types.isPointer & if
  src context types.isMutable target context types.isMutable ! | src context types.getBaseType target context types.getBaseType types.typeEquals & if
    src target false context sizeCompatible return
  end end
  target context types.isUnion if
    target context types.compositeElts =:: elts
    0 while #dup elts .length < do
      src elts #over:2 array.get context types.canAutoCast if #drop
        true return
      end
      1 +
    end #drop
  end
  src types.isPrimitive ! target types.isPrimitive ! | if
    false return
  end
  false return
end
proc( Type : a Type : b bool : forceCast TypeContext ptr mut : context => bool ) =: public canCast
  a context types.unwrapNamed =:: mut src
  b context types.unwrapNamed =:: mut target
  src target context canAutoCast if
    true return
  end
  src context types.isNumber target context types.isNumber & if
    true return
  end
  src context types.isPointer src context types.isArray | target context types.isPointer & if
  src context types.isMutable target context types.isMutable ! | src context types.getBaseType target context types.getBaseType types.typeEquals & if
    src target true context sizeCompatible if
      true return
    end
  end end
  forceCast ! if
    false return
  end
  src context types.isPointer target context types.isPointer & if
    true return ## XXX check for compatible element sizes?, compatible mutability
  end
  src context types.isPointer target context types.isInt & if
    true return
  end
  src context types.isInt target context types.isPointer & if
    true return
  end
  false return
end
#end
## type context
struct(
  types.ArrayType     list : mut arrayTypes
  types.ArraySize     list : mut arraySizes
  types.CompositeType list : mut compositeTypes
  Type                list : mut compositeData
  types.ProcType      list : mut procTypes
  types.NamedType     list : mut namedTypes
  LabelId             list : mut elementLabels
) TypeContext =
#namespace types
proc( => TypeContext ) =: public newTypeContext
  128 ArrayType     list.create ## arrayTypes
  128 ArraySize     list.create ## arraySizes
  128 CompositeType list.create ## compositeTypes
  128 Type          list.create ## compositeData
  128 ProcType      list.create ## procTypes
  128 NamedType     list.create ## namedTypes
  128 LabelId       list.create ## elementLabels
  TypeContext new return
end
proc( TypeContext : context => TypeContext ) =: public clearTypeContent
  context
    #dup .arrayTypes     list.free #over .arrayTypes =
    #dup .arraySizes     list.free #over .arraySizes =
    #dup .compositeTypes list.free #over .compositeTypes =
    #dup .compositeData  list.free #over .compositeData =
    #dup .procTypes      list.free #over .procTypes =
    #dup .namedTypes     list.free #over .namedTypes =
    #dup .elementLabels  list.free #over .elementLabels =
  return
end
#end
#namespace sb
proc( stringBuilder types.PrimitiveType => stringBuilder ) =: appendPrimitiveType
  switch
    BOOL case
      "bool" appendS return
    I8 case
      "i8" appendS return
    I16 case
      "i16" appendS return
    I32 case
      "i32" appendS return
    I64 case
      "i64" appendS return
    FLOAT32 case
      "float" appendS return
    FLOAT64 case
      "double" appendS return
    TYPE case
      "type" appendS return
  end
end
proc( stringBuilder : sb types.ArraySize arrayView : sizes => stringBuilder  ) =: public appendArraySize
  sb
    0 while #dup sizes .length < do
      #swap
        sizes #over:2 array.at .data =:: s
        s [] .sizeType switch
          int case
            ' ' sb.appendC
            s [] .value sb.appendI
            break
          staticArg case
            " staticArg(" sb.appendS
            s [] .value sb.appendI
            ")" sb.appendS
            break
          templateArg case
            " templateArg(" sb.appendS
            s [] .value sb.appendI
            ")" sb.appendS
            break
        end
      #swap 1 +
    end #drop
  return
end
proc( stringBuilder Type LabelContext ptr TypeContext ptr bool => stringBuilder ) =: public appendTypeRecursive
  =:: allowRecurse
  =:: context
  =:: labelContext
  #dup switch
    undefined case #drop
      "undefined" appendS return
    primitiveType case
      .primitiveType appendPrimitiveType return
    pointer case =:: t
      t context types.getBaseType labelContext context allowRecurse appendTypeRecursive
      t context types.isFixedSize if
        t context types.getArraySize appendArraySize
        " ptr" appendS
      else
        " _ ptr" appendS
      end
      t context types.isMutable if
        " mut" appendS
      end
      return
    arrayType case =:: t
      t context types.getBaseType labelContext context allowRecurse appendTypeRecursive
      t context types.getArraySize appendArraySize
      " array" appendS return
    tuple case
      .tuple
      #swap
        "tuple[" appendS
        #over    appendI
        "]( "    appendS
      #swap
        allowRecurse if
          context [] .compositeTypes #swap list.get labelContext context appendComposite
        else #drop
          "... " appendS
        end
       ")" appendS
       return
    struct case
      .struct
      #swap
        "struct[" appendS
        #over    appendI
        "]( "    appendS
      #swap
        allowRecurse if
          context [] .compositeTypes #swap list.get labelContext context appendComposite
        else #drop
          "... " appendS
        end
       ")" appendS
       return
    union case
      .union
      #swap
        "union[" appendS
        #over    appendI
        "]( "    appendS
      #swap
        allowRecurse if
          context [] .compositeTypes #swap list.get labelContext context appendComposite
        else #drop
          "... " appendS
        end
       ")" appendS
       return
    enum case
      .enum
      #swap
        "enum[" appendS
        #over    appendI
        "]( "    appendS
      #swap
        allowRecurse if
          context [] .compositeTypes #swap list.get labelContext context appendComposite
        else #drop
          "... " appendS
        end
       ")" appendS
       return
    labeledProcIn case
       .labeledProcIn context [] .compositeTypes #swap list.get labelContext context appendComposite return
    procIn case
      .procIn context [] .compositeTypes #swap list.get labelContext context appendComposite return
    procOut case
      .procOut context [] .compositeTypes #swap list.get labelContext context appendComposite return
    procedure case
      .procedure
      #swap
        "proc[" appendS
        #over    appendI
        "]( "    appendS
      #swap
        allowRecurse if
          context [] .procTypes #swap list.get #swap
          #over .in labelContext context allowRecurse appendTypeRecursive
          "=> " appendS
          #swap .out labelContext context allowRecurse appendTypeRecursive
        else #drop
          "... " appendS
        end
       ")" appendS
       return
    namedType case
      .namedType
      #swap
        "named[" appendS
        #over    appendI
        "]( "    appendS
      #swap
      context [] .namedTypes #swap list.get labelContext context allowRecurse appendNamedType
      " )" appendS
      return
    autoType case
      #swap "auto["     appendS
        #swap .autoType appendI
                "]"     appendS
      return
    genericType case
      #swap "generic["     appendS
        #swap .genericType appendI
                   "]"     appendS
      return
    templateType case
      #swap "template["     appendS
        #swap .templateType appendI
                    "]"     appendS
      return
  end
end
proc( stringBuilder Type LabelContext ptr TypeContext ptr => stringBuilder ) =: public appendType
  true appendTypeRecursive return
end
#end
