      '"' sb.appendC
      named .name labelContext sb.appendLabelName
      '"' sb.appendC
      " [ " sb.appendS
      ## appendTypeRecursive
        named .data context types.flatUnwrapNamed
        context
        allowRecurse
      appendTypeRecursive
      " ]"  sb.appendS
    return
  end
