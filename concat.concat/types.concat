import core
import list
import slice
import string
import stringBuilder
import arenaAlloc
import map

import "labels.concat"
import "constants.concat"

namespace: types
  enum(
    BOOL
    I8 I16 I32 I64
    CHAR8 CHAR16 CHAR32
    F32 F64
    TYPE
  ) =:: export: PrimitiveType
  type : ArrayData
  type : CompositeInfo
  type : TupleInfo
  type : UnionInfo
  type : EnumInfo
  type : InitializerInfo
  type : ProcType
  type : GeneratedTypeName
  type : export: TypeSet
  ArrayData ptr =:: ArrayId
  TupleInfo ptr.mut =:: TupleId
  UnionInfo ptr.mut =:: UnionId
  EnumInfo ptr =:: EnumId
  InitializerInfo ptr.mut =:: InitializerId
  ProcType ptr =:: ProcTypeId
  GeneratedTypeName ptr =:: GeneratedTypeId
  TypeSet ptr =:: export: TypeSetId
  ## primitive C-types for C interoperability
  enum(
    VOID BOOL
    CHAR S_CHAR U_CHAR
    SHORT U_SHORT
    INT U_INT
    LONG LONGLONG U_LONG U_LONGLONG SIZE
    FLOAT DOUBLE
    ## XXX? add support for long double
    STRUCT UNION
  ) =:: CType
  enum(
    U7  S8  U8  ## largest numbers castable to i8;  -> i32 by default
    U15 S16 U16 ## largest numbers castable to i16; -> i32 by default
    U24 S25   ## largest numbers castable to f32 ( -2^24 <= k <= 2^24 ); -> i32 by default
    U31 S32 U32 ## -> i32
    U53 S54   ## largest numbers castable to f64 ( -2^53 <= k <= 2^53 ); -> i64 by default
    U63 S64 U64 ## -> i64
    ## XXX? support for 128Bit integer literals
  ) =:: IntLiteral
  union(
    ProcId : typeTrait
    Type : typeId
  ) =:: export: TypeSetEntry
  struct(
    TypeSetEntry slice : elements
  ) =:: export: TypeSet
  
  proc( TypeSetEntry : a TypeSetEntry : b -> bool ) =>: export: typeSetEntryEqual
    a ..label b ..label != if false return end
    a switch
      typeTrait case a .typeTrait b .typeTrait == return
      typeId case a .typeId b .typeId typeEquals return
    end
  end
  proc( TypeSetEntry : a -> i32 ) =>: export: typeSetEntryHash
    a switch
      typeTrait case a .typeTrait i32 cast.u 1 + 2 * return
      typeId case a .typeId typeHash 1 + 3 * return
    end
  end
  proc( TypeSet : a TypeSet : b -> bool ) =>: export: typeSetEqual
    a .elements b .elements typeSetEntryEqual@ slice.eq
  end
  proc( TypeSet : a -> i32 ) =>: export: typeSetHash
    a .elements typeSetEntryHash@ slice.hash
  end
end

union(
                      _ : undefined
                      _ : empty
    types.PrimitiveType : primitiveType
       types.IntLiteral : intLiteral
            types.CType : cType
                    i32 : align
          types.ArrayId : pointer
          types.ArrayId : mutablePointer
          types.ArrayId : rawPointer
          types.ArrayId : mutableRawPointer
          types.ArrayId : arrayType
          types.TupleId : struct
          types.UnionId : union
           types.EnumId : enum
    types.InitializerId : initializer
       types.ProcTypeId : procedure
        types.TypeSetId : typeSet
                    i32 : autoType
                LabelId : genericType
                LabelId : namedType
  types.GeneratedTypeId : generatedType
) =:: export: Type

namespace: types
  proc( ArrayId : a ArrayId : b -> bool ) =>: arrayTypeEqual
    a b == if true return end
    a ArrayData ptr cast =:: aData
    b ArrayData ptr cast =:: bData
    aData [] .size bData [] .size arraySizeEqual and
      aData [] .base bData [] .base typeEquals
    end return
  end
  ## TODO ensure type-hash function returns distinct values for common small types
  ## TODO? cache results of hash-computation 
  proc( ArrayId : a -> i32 ) =>: arrayTypeHash
    a ArrayData ptr cast =:: aData
    aData [] .size arraySizeHash 31 * aData [] .base typeHash +
  end
  ## TODO? should flags be required to be equal
  ##  * figure out why identical types can have different flags
  proc( CompositeInfo ptr : a CompositeInfo ptr : b -> bool ) =>: compositeTypeEqual
    a b == if true return end
    a .elements [] .length b .elements [] .length != if false return end
    a [] .labels ? b [] .labels ? != if false return end
    a [] .elements b [] .elements typeEquals@ slice.eq ! if false return end
    a [] .labels ? ! if
      a .labels [] .data b .labels [] .data labelEq@ slice.eq return
    end
    true return
  end
  proc( CompositeInfo ptr : a -> i32 ) =>: compositeTypeHash
    0:i32
      a [] .labels ? if
        31 * a [] .labels .data labelHash@ slice.hash +
      end
      31 * a [] .elements typeHash@ slice.hash +
    return
  end
  proc( TupleId : a TupleId : b -> bool ) =>: export: tupleTypeEqual
    a b == if true return end
    a TupleInfo ptr cast =:: aData
    b TupleInfo ptr cast =:: bData
    aData .compositeInfo bData .compositeInfo compositeTypeEqual
  end
  proc( TupleId : a -> i32 ) =>: export: tupleTypeHash
    a TupleInfo ptr cast =:: aData
    aData .compositeInfo compositeTypeHash
  end
  proc( UnionId : a UnionId : b -> bool ) =>: export: unionTypeEqual
    a b == if true return end
    a UnionInfo ptr cast =:: aData
    b UnionInfo ptr cast =:: bData
    aData [] .labelType bData [] .labelType typeEquals ! if
      false return
    end
    aData .compositeInfo bData .compositeInfo compositeTypeEqual
  end
  proc( UnionId : a -> i32 ) =>: export: unionTypeHash
    a UnionInfo ptr cast =:: aData
    aData [] .labelType typeHash
      31 * aData .compositeInfo compositeTypeHash +
    return
  end
  proc( EnumId : a EnumId : b -> bool ) =>: export: enumTypeEqual
    a b == if true return end
    a EnumInfo ptr cast [] =:: aData
    b EnumInfo ptr cast [] =:: bData
    aData .labelType bData .labelType typeEquals ! if
      false return
    end
    aData .labels bData .labels labelEq@ slice.eq return
  end
  proc( EnumId : a -> i32 ) =>: export: enumTypeHash
    a EnumInfo ptr cast [] =:: aData
    aData .labelType typeHash
      31 * aData .labels labelHash@ slice.hash +
    return
  end
  proc( InitializerId : a InitializerId : b -> bool ) =>: export: initializerTypeEqual
    a b == if true return end
    a .asTuple TupleId cast b .asTuple TupleId cast tupleTypeEqual
  end
  proc( InitializerId : a -> i32 ) =>: export: initializerTypeHash
    a .asTuple TupleId cast tupleTypeHash
  end
  proc( ProcTypeId : a ProcTypeId : b -> bool ) =>: export: procTypeEqual
    a b == if true return end
    a ProcType ptr cast =:: aData
    b ProcType ptr cast =:: bData
    aData [] .callingConvention bData [] .callingConvention != if false return end
    aData [] .inTypes .length bData [] .inTypes .length != if false return end
    aData [] .outTypes .length bData [] .outTypes .length != if false return end
    aData [] .labels .length bData [] .labels .length != if false return end
    aData [] .inTypes bData [] .inTypes typeEquals@ slice.eq and
    aData [] .outTypes bData [] .outTypes typeEquals@ slice.eq and
      aData [] .labels bData [] .labels labelEq@ slice.eq
    end return
  end
  proc( ProcTypeId : a -> i32 ) =>: export: procTypeHash
    a ProcType ptr cast =:: aData
    aData [] .callingConvention ..label i32 cast.u
      31 * aData [] .inTypes typeHash@ slice.hash +
      31 * aData [] .outTypes typeHash@ slice.hash +
      31 * aData [] .labels labelHash@ slice.hash +
    return
  end
  proc( GeneratedTypeId : a GeneratedTypeId : b -> bool ) =>: export: generatedTypeEqual
    a b == or
      a GeneratedTypeName ptr cast [] b GeneratedTypeName ptr cast [] genNameEq
    end
  end
  proc( GeneratedTypeId : a -> i32 ) =>: export: generatedTypeHash
    a GeneratedTypeName ptr cast [] genNameHash
  end
  proc( Type : a Type : b -> bool ) =>: export: typeEquals
    a ..label b ..label != if
      false return
    end
    a switch
      undefined empty case
        true return ## there is only one undefined/empty type
      primitiveType case
        a .primitiveType b .primitiveType == return
      intLiteral case
        a .intLiteral b .intLiteral == return
      cType case
        a .cType b .cType == return
      align case
        a .align b .align == return
      autoType case
        a .autoType b .autoType == return
      namedType case
        a .namedType b .namedType == return
      genericType case
        a .genericType b .genericType == return
      pointer case
        a .pointer b .pointer arrayTypeEqual return
      mutablePointer case
        a .mutablePointer b .mutablePointer arrayTypeEqual return
      rawPointer case
        a .rawPointer b .rawPointer arrayTypeEqual return
      mutableRawPointer case
        a .mutableRawPointer b .mutableRawPointer arrayTypeEqual return
      arrayType case
        a .arrayType b .arrayType arrayTypeEqual return
      struct case
        a .struct b .struct tupleTypeEqual return
      enum case
        a .enum b .enum enumTypeEqual return
      union case
        a .union b .union unionTypeEqual return
      initializer case
        a .initializer b .initializer initializerTypeEqual return
      procedure case
        a .procedure b .procedure procTypeEqual return
      generatedType case
        a .generatedType b .generatedType generatedTypeEqual return
      typeSet case
        a .typeSet b .typeSet == or
          a .typeSet TypeSet ptr cast [] b .typeSet TypeSet ptr cast [] typeSetEqual
        end return
    end
  end
  proc( PrimitiveType -> i32 ) =>: primitiveId
    switch
      BOOL case 1 return
      I8 case 2 return
      I16 case 3 return
      I32 case 4 return
      I64 case 5 return
      CHAR8 case 6 return
      CHAR16 case 7 return
      CHAR32 case 8 return
      F32 case 9 return
      F64 case 10 return
      TYPE case 11 return
    end
  end
  proc( IntLiteral -> i32 ) =>: intLiteralId
    switch
      U7  case  1 return
      S8  case  2 return
      U8  case  3 return
      U15 case  4 return
      S16 case  5 return
      U16 case  6 return
      U24 case  7 return
      S25 case  8 return
      U31 case  9 return
      S32 case 10 return
      U32 case 11 return
      U53 case 12 return
      S54 case 13 return
      U63 case 14 return
      S64 case 15 return
      U64 case 16 return
    end
  end
  proc( CType -> i32 ) =>: cTypeId
    switch
      VOID case 0 return
      BOOL case 1 return
      CHAR case 2 return
      S_CHAR case 3 return
      U_CHAR case 4 return
      SHORT  case 5 return
      U_SHORT case 6 return
      INT case 7 return
      U_INT case 8 return
      LONG  case 9 return
      LONGLONG  case 10 return
      U_LONG  case 11 return
      U_LONGLONG  case 12 return
      SIZE case 13 return
      FLOAT case 14 return
      DOUBLE case 15 return
      STRUCT case 16 return
      UNION case 17 return
    end
  end
  ## TODO? use larger primes to reduce collisions for small entries
  proc( Type : a -> i32 ) =>: export: typeHash
    a switch
      undefined case
        0 return ## there is only one undefined
      empty case
        1 return ## there is only one empty type
      primitiveType case
        2 a .primitiveType primitiveId 1 + * return
      intLiteral case
        3 a .intLiteral intLiteralId 1 + * return
      cType case
        5 a .cType cTypeId 1 + * return
      align case
        7 a .align 1 + * return
      autoType case
        11 a .autoType i32 cast 1 + * return
      namedType case
        13 a .namedType i32 cast 1 + * return
      genericType case
        17 a .genericType i32 cast 1 + * return
      arrayType case
        19 a .arrayType arrayTypeHash * return
      pointer case
        23 a .pointer arrayTypeHash * return
      rawPointer case
        29 a .rawPointer arrayTypeHash * return
      mutablePointer case
        31 a .mutablePointer arrayTypeHash * return
      mutableRawPointer case
        37 a .mutableRawPointer arrayTypeHash * return
      struct case
        41 a .struct tupleTypeHash * return
      enum case
        43 a .enum enumTypeHash * return
      union case
        47 a .union unionTypeHash * return
      procedure case
        53 a .procedure procTypeHash * return
      generatedType case
        59 a .generatedType generatedTypeHash * return
      initializer case
        61 a .initializer initializerTypeHash * return
      typeSet case
        67 a .typeSet TypeSet ptr cast [] typeSetHash * return
    end
  end
end

type : export: TypeContext
namespace: types
  ## primitive types
  namespace: primitive
    PrimitiveType .BOOL Type .primitiveType Type =: export: BOOL
    PrimitiveType .I8   Type .primitiveType Type =: export: I8
    PrimitiveType .I16  Type .primitiveType Type =: export: I16
    PrimitiveType .I32  Type .primitiveType Type =: export: I32
    PrimitiveType .I64  Type .primitiveType Type =: export: I64
    PrimitiveType .CHAR8  Type .primitiveType Type =: export: CHAR8
    PrimitiveType .CHAR16 Type .primitiveType Type =: export: CHAR16
    PrimitiveType .CHAR32 Type .primitiveType Type =: export: CHAR32
    PrimitiveType .F32  Type .primitiveType Type =: export: F32
    PrimitiveType .F64  Type .primitiveType Type =: export: F64
    PrimitiveType .TYPE Type .primitiveType Type =: export: TYPE
    ## compiler internal type-aliases for special purpose types
    PrimitiveType .I64  Type .primitiveType Type =: export: I_SIZE ## integer with size to hold pointers/sizes
    PrimitiveType .I64  Type .primitiveType Type =: export: I_MAX  ## largest native integer type
  end
  primitive.I_SIZE =:: mut: export: I_SIZE
  namespace: intLiteral
    IntLiteral .U7  Type .intLiteral Type =: export: U7
    IntLiteral .S8  Type .intLiteral Type =: export: S8
    IntLiteral .U8  Type .intLiteral Type =: export: U8
    IntLiteral .U15 Type .intLiteral Type =: export: U15
    IntLiteral .S16 Type .intLiteral Type =: export: S16
    IntLiteral .U16 Type .intLiteral Type =: export: U16
    IntLiteral .U24 Type .intLiteral Type =: export: U24
    IntLiteral .S25 Type .intLiteral Type =: export: S25
    IntLiteral .U31 Type .intLiteral Type =: export: U31
    IntLiteral .S32 Type .intLiteral Type =: export: S32
    IntLiteral .U32 Type .intLiteral Type =: export: U32
    IntLiteral .U53 Type .intLiteral Type =: export: U53
    IntLiteral .S54 Type .intLiteral Type =: export: S54
    IntLiteral .U63 Type .intLiteral Type =: export: U63
    IntLiteral .S64 Type .intLiteral Type =: export: S64
    IntLiteral .U64 Type .intLiteral Type =: export: U64
  end
  proc( Type -> bool ) =>: export: isPrimitive
    .primitiveType ?? return
  end
  proc( Type : t TypeContext ptr : context -> PrimitiveType ) =>: export: primitiveValue
    t context unwrapNamed
      ## TODO? unwrap c-types
    .primitiveType return
  end
  proc( Type : t0 TypeContext ptr : context -> bool ) =>: export: isEmpty ## TODO? should pointer to empty be empty
    t0 context unwrapNamed =:: t
    t switch
       empty align case true return
       arrayType case
         ## arrays of empty values are empty
         t context getBaseType context isEmpty return
       undefined primitiveType procedure cType pointer mutablePointer mutableRawPointer rawPointer
         namedType autoType genericType intLiteral
         generatedType enum typeSet case false return
       struct union initializer case
         t context compositeFlags COMP_FLAG_EMPTY & ? return
    end
  end

  proc( PrimitiveType -> bool ) =>: isIntPrimitive
    switch
      BOOL F32 F64 TYPE CHAR8 CHAR16 CHAR32 case
        false return
      I8 I16 I32 I64 case
        true return
    end
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isInt
    unwrapNamed
      ..dup .intLiteral ?? if ..drop
        true return
      end
      ..dup isPrimitive ! if ..drop
        false return
      end .primitiveType isIntPrimitive
  end
  ## integer or cType integer
  proc( Type TypeContext ptr : context -> bool ) =>: export: isIntLike
    context unwrapNamed =:: t
    t context isInt if true return end
    t .cType ?? if
      t .cType switch
        S_CHAR CHAR U_CHAR SHORT U_SHORT INT U_INT
          LONG U_LONG LONGLONG U_LONGLONG SIZE case true return
        VOID BOOL FLOAT DOUBLE STRUCT UNION case false return
      end
    end
    false return
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isSignedInt
    unwrapNamed
      ..dup .cType ?? if
        .cType switch
          S_CHAR SHORT INT LONG LONGLONG case true return
          VOID BOOL CHAR U_CHAR U_SHORT U_INT U_LONG U_LONGLONG SIZE
            FLOAT DOUBLE STRUCT UNION case false return
        end
      end
      ..dup .intLiteral ?? if
        .intLiteral switch
          U7 U15 U24 U31 U53 U63 S8 S16 S25 S32 S54 S64 case true return
          U8 U16 U32 U64 case false return
        end
      end
      ..drop false return
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isUnsignedInt
    unwrapNamed
      ..dup .cType ?? if
        .cType switch
          U_CHAR U_SHORT U_INT U_LONG U_LONGLONG SIZE case true return
          VOID BOOL CHAR S_CHAR SHORT INT LONG LONGLONG
            FLOAT DOUBLE STRUCT UNION case false return
        end
      end
      ..dup .intLiteral ?? if
        .intLiteral switch
          U7 U8 U15 U16 U24 U31 U32 U53 U63 U64 case true return
          S8 S16 S25 S32 S54 S64 case false return
        end
      end
      ..drop false return
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isFloat
    unwrapNamed
      ..dup isPrimitive ! if ..drop
        false return
      end .primitiveType
      switch
        BOOL I8 I16 I32 I64 CHAR8 CHAR16 CHAR32 TYPE case
          false return
        F32 F64 case
          true return
      end
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isNumber
    unwrapNamed
      ..dup isPrimitive ! if ..drop
        false return
      end .primitiveType
      switch
        BOOL TYPE CHAR8 CHAR16 CHAR32 case
          false return
        I8 I16 I32 I64 F32 F64 case
          true return
      end
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isChar
    unwrapNamed
      $ .primitiveType ?? if
        .primitiveType switch
          BOOL TYPE I8 I16 I32 I64 F32 F64 case
            false return
          CHAR8 CHAR16 CHAR32 case
            true return
        end
      end
      ..drop
    false return
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isIntOrChar
    unwrapNamed
      $ .primitiveType ?? if
        .primitiveType switch
          BOOL TYPE F32 F64 case
            false return
          I8 I16 I32 I64 CHAR8 CHAR16 CHAR32 case
            true return
        end
      end
      ..drop
    false return
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isNumberOrChar
    unwrapNamed
      ..dup isPrimitive ! if ..drop
        false return
      end .primitiveType
      switch
        BOOL TYPE case
          false return
        I8 I16 I32 I64 F32 F64 CHAR8 CHAR16 CHAR32 case
          true return
      end
  end
  proc( Type -> bool ) =>: export: isLiteral
    switch
       intLiteral initializer case true return
       empty arrayType
           undefined primitiveType procedure cType pointer
           namedType autoType genericType rawPointer
           generatedType enum align mutablePointer mutableRawPointer
           struct union typeSet case
         false return
    end
  end
  proc( Type : t TypeContext ptr.mut : context -> Type ) =>: export: literalToType
    t switch
       intLiteral case t .intLiteral intLiteralAsInt return
       initializer case
        t .initializer InitializerInfo ptr.mut cast =:: initInfo
        ## TODO? store initialiter elements directly in initialiter data
        initInfo .asTuple TupleInfo ptr cast =:: tupleInfo
        tupleInfo .compositeInfo .elements [] .length =:: eltCount
        initInfo .arrayType .undefined ?? ! if
          initInfo [] .arrayType context literalToType =:: baseType
          eltCount i64 cast.u ArraySize .Int =:: size
          ## newArrayType
            baseType
            ArrayType .ARRAY
            size
          context newArrayType .data return
        end
        tupleInfo .compositeInfo .flags [] COMP_FLAG_CONTAINS_LITERAL & ? if
          context [] .memory
            eltCount i32 cast.u Type mixedArena.allocSlice =:: newElements
          context .memory=
          tupleInfo .compositeInfo [] .elements =:: oldElts
          0:iSize while $ eltCount u< do =:: i
            oldElts i [] context literalToType newElements i =[]
          finally i 1:iSize + end ..drop
          ## newTuple
            newElements slice.freeze
            tupleInfo .compositeInfo [] .labels
            context
          newTuple .data return
        end
        initInfo .asTuple TupleId cast Type .struct return
       empty arrayType
           undefined primitiveType procedure cType pointer
           namedType autoType genericType rawPointer
           generatedType enum align mutablePointer mutableRawPointer
           struct union typeSet case
         t return
    end
  end

  ## does value fit in 2*64-bit values
  proc( Type TypeContext ptr.mut -> bool ) =>: export: isSmallType
    sizeOf =:: size
    size switch
      fixed case
        size .fixed 16 <= return ## more than 2*i64
      dynamicArray case false return
      unknown case ..unreachable ## TODO? error message
    end
  end
  ## can value be pushed onto stack
  proc( Type TypeContext ptr.mut -> bool ) =>: export: referenceOnly
    isSmallType ! return ## XXX ? allow larger stack values
  end
  64 =:: export: MAX_INT_WIDTH
  i64.MAX =:: export: MAX_SIGNED_INT
  proc( Type : src Type : target TypeContext ptr : context -> bool ) =>: canAutoCastIntLiteral
    src .intLiteral ?? ! or target context types.isNumber ! if
      true return
    end
    src .intLiteral switch
      U7  case false  7:i64 break
      S8  case true   8:i64 break
      U8  case false  8:i64 break
      U15 case false 15:i64 break
      S16 case true  16:i64 break
      U16 case false 16:i64 break
      U24 case false 24:i64 break
      S25 case true  24:i64 break
      U31 case false 31:i64 break
      S32 case true  32:i64 break
      U32 case false 32:i64 break
      U53 case false 53:i64 break
      S54 case true  53:i64 break
      U63 case false 63:i64 break
      S64 case true  64:i64 break
      U64 case false 64:i64 break
    end =:: srcBits =:: srcSigned
    target context primitiveValue =:: targetPrimitive
    targetPrimitive isIntPrimitive if
      targetPrimitive sizeOfPrimitive 8 * =:: targetBits
      srcBits targetBits <= return
    else targetPrimitive .F32 ?? _if
      srcBits 24 <= return
    else targetPrimitive .F64 ?? _if
      srcBits 53 <= return
    end
    ..unreachable
  end
  proc( Type : src Type : target TypeContext ptr : context -> bool ) =>: canAutoCastNumber
    src context types.isNumber ! target context types.isNumber ! | if
      true return
    end
    src context primitiveValue =:: srcPrimitive
    target context primitiveValue =:: targetPrimitive
    srcPrimitive targetPrimitive == if
      true return
    end
    srcPrimitive isIntPrimitive and targetPrimitive isIntPrimitive if
      srcPrimitive sizeOfPrimitive =:: srcBytes
      targetPrimitive sizeOfPrimitive =:: targetBytes
      srcBytes targetBytes == return ## cast I... <-> U...
    end
    false return
  end
  ## ctypes
  namespace: ctype
    CType .VOID        Type .cType Type =: export: VOID
    CType .BOOL        Type .cType Type =: export: BOOL
    CType .CHAR        Type .cType Type =: export: CHAR
    CType .S_CHAR      Type .cType Type =: export: S_CHAR
    CType .U_CHAR      Type .cType Type =: export: U_CHAR
    CType .SHORT       Type .cType Type =: export: SHORT
    CType .U_SHORT     Type .cType Type =: export: U_SHORT
    CType .INT         Type .cType Type =: export: INT
    CType .U_INT       Type .cType Type =: export: U_INT
    CType .LONG        Type .cType Type =: export: LONG
    CType .U_LONG      Type .cType Type =: export: U_LONG
    CType .LONGLONG    Type .cType Type =: export: LONGLONG
    CType .U_LONGLONG  Type .cType Type =: export: U_LONGLONG
    CType .SIZE        Type .cType Type =: export: SIZE
    CType .FLOAT       Type .cType Type =: export: FLOAT
    CType .DOUBLE      Type .cType Type =: export: DOUBLE
    CType .STRUCT      Type .cType Type =: export: STRUCT
    CType .UNION       Type .cType Type =: export: UNION
  end
  proc( CType -> Type ) =>: export: cTypeAsType
    switch
      VOID STRUCT UNION case Type .empty return
      BOOL case primitive.BOOL return
      CHAR S_CHAR U_CHAR case primitive.I8 return
      SHORT U_SHORT case primitive.I16 return
      INT U_INT case primitive.I32 return
      LONG LONGLONG U_LONG U_LONGLONG SIZE case primitive.I64 return
      FLOAT case primitive.F32 return
      DOUBLE case primitive.F64 return
    end
  end
  proc( types.IntLiteral -> Type ) =>: export: intLiteralAsInt
    switch
      U7 S8 U8 U15 S16 U16 case primitive.I32 return
      U24 S25 U31 S32 U32  case primitive.I32 return
      U53 S54 U63 S64 U64  case primitive.I64 return
    end
  end

  ## size and alignment
  union( _ : unknown i64 : fixed i64 : dynamicArray ) =:: export: TypeSize
  8:i64 =:: PTR_SIZE
  8:i64 =:: PTR_ALIGN
  8:i64 =:: I_SIZE_SIZE
  8:i64 =:: I_SIZE_ALIGN
  proc( PrimitiveType -> i64 ) =>: export: sizeOfPrimitive
    switch
      TYPE case
        0 return
      BOOL I8 CHAR8 case
        1 return
      I16 CHAR16 case
        2 return
      I32 F32 CHAR32 case
        4 return
      I64 F64 case
        8 return
    end
  end
  proc( IntLiteral -> i64 ) =>: intLiteralBytes
    switch
      U7 S8 U8            case 1 return
      U15 S16 U16         case 2 return
      U24 S25 U31 S32 U32 case 4 return
      U53 S54 U63 S64 U64 case 8 return
    end
  end
  proc( IntLiteral -> i64 ) =>: export: sizeOfIntLiteral
    switch
      U7 S8 U8 U15 S16 U16 case 4 return
      U24 S25 U31 S32 U32  case 4 return
      U53 S54 U63 S64 U64  case 8 return
    end
  end
  proc( CType -> i64 ) =>: sizeOfCType
    switch ## sizes for linux-x86-gcc
      BOOL CHAR S_CHAR U_CHAR VOID case 1 return
      SHORT U_SHORT case 2 return
      INT U_INT case 4 return
      LONG LONGLONG U_LONG U_LONGLONG SIZE case 8 return
      FLOAT case 4 return
      DOUBLE case 8 return
      STRUCT UNION case 0 return ## structs should not be used directly
    end
  end

  proc(
    Type : t
    TupleId : tupleId
    TypeContext ptr.mut : typeContext
  -> bool ) =>: tryComputeTupleSize
    tupleId TupleInfo ptr.mut cast =:: tupleInfo
    tupleInfo [] .compositeInfo .flags COMP_SIZE_KNOWN & ? if
      false return ## size already known
    end
    t typeContext compositeElts =:: elts
    1:i64 =:: mut: alignment
    0:i64 =:: mut: size
    typeContext [] .memory
      $ mixedArena.offset =:: memOffset
      elts .length i32 cast.u i64 mixedArena.allocSlice =:: offsetBuffer
    typeContext .memory=
    0:iSize =:: mut: offsetCount
    elts for =:: elt
      ## size and alignment
      elt typeContext alignOf =:: eltAlignData
      elt typeContext sizeOf =:: eltSizeData
      eltAlignData .fixed ?? ! eltSizeData .fixed ?? ! | if
        typeContext [] .memory
          memOffset mixedArena.reset
        typeContext .memory=
        true return ## elements are not fixed size
      end
      eltAlignData .fixed =:: eltAlign
      eltSizeData .fixed =:: eltSize
      eltAlign alignment > if
        eltAlign alignment=
      end
      size eltAlign alignSize =:: eltOffset
      eltOffset eltSize + size=
      eltOffset offsetBuffer offsetCount =[]
      offsetCount 1:iSize + offsetCount=
    end
    ## TODO? compress offset list ( reuse first few slots for common offset patterns: 0, 8, 16, 24, 0, 4, 8, 12
    offsetBuffer slice.freeze tupleInfo .elementOffsets=
    alignment tupleInfo .compositeInfo .alignment=
    size tupleInfo .compositeInfo .size=
    tupleInfo [] .compositeInfo .flags
      COMP_SIZE_KNOWN |
    tupleInfo .compositeInfo .flags=
    false return
  end
  proc(
    Type : t
    UnionId : unionId
    TypeContext ptr.mut : typeContext
  -> bool ) =>: tryComputeUnionSize
    unionId UnionInfo ptr.mut cast =:: unionInfo
    unionInfo [] .compositeInfo .flags COMP_SIZE_KNOWN & ? if
      false return ## size already known
    end
    t typeContext compositeElts =:: elts
    1:i64 =:: mut: alignment
    0:i64 =:: mut: size
    elts for =:: elt
      ## size and alignment
      elt typeContext sizeOf =:: eltSizeData
      elt typeContext alignOf =:: eltAlignData
      eltAlignData .fixed ?? ! eltSizeData .fixed ?? ! | if
        true return ## elements are not fixed size
      end
      eltAlignData .fixed =:: eltAlign
      eltSizeData .fixed =:: eltSize
      eltAlign alignment > if
        eltAlign alignment=
      end
      eltSize size > if
        eltSize size=
      end
    end
    unionInfo [] .labelType typeContext isEmpty ! if
      unionInfo [] .labelType typeContext alignOf .fixed =:: labelAlign
      labelAlign alignment > if
        labelAlign alignment=
      end
      size
        labelAlign alignSize
        ..dup unionInfo .enumLabelOffset=
        unionInfo [] .labelType typeContext sizeOf .fixed +
      size=
    end
    alignment unionInfo .compositeInfo .alignment=
    size unionInfo .compositeInfo .size=
    unionInfo [] .compositeInfo .flags
      COMP_SIZE_KNOWN |
    unionInfo .compositeInfo .flags=
    false return
  end
  proc(
    Type : composite
    TypeContext ptr.mut : typeContext
  -> bool ) =>: tryComputeSize
    composite switch
      struct case
        composite composite .struct typeContext tryComputeTupleSize return
      union case
        composite composite .union typeContext tryComputeUnionSize return
      initializer case
        ## tryComputeUnionSize
          composite
          composite .initializer InitializerInfo ptr.mut cast .asTuple TupleId cast
        typeContext tryComputeTupleSize return
      undefined empty autoType genericType rawPointer mutableRawPointer
      primitiveType intLiteral cType arrayType enum
      pointer mutablePointer procedure align typeSet
      namedType generatedType case ..unreachable ## XXX? use assertion
    end
  end
  ## alignment of type in bytes, will be a power of two
  proc( Type : t TypeContext ptr.mut : context -> TypeSize ) =>: export: alignOf
    t switch
      undefined autoType genericType typeSet case
        TypeSize .unknown return
      empty case
        1 TypeSize .fixed return
      align case
        t .align i64 cast.u TypeSize .fixed return
      primitiveType case
        t .primitiveType sizeOfPrimitive TypeSize .fixed return
      intLiteral case
        t .intLiteral sizeOfIntLiteral TypeSize .fixed return
      cType case
        t .cType sizeOfCType TypeSize .fixed return
      pointer mutablePointer rawPointer mutableRawPointer procedure case
        PTR_SIZE TypeSize .fixed return
      arrayType case
        t context getBaseType context alignOf return
      struct union initializer case
        t context tryComputeSize if
          TypeSize .unknown return
        end
        t context compositeData .Composite =:: compData
        compData [] .alignment TypeSize .fixed return
      enum case
        t .enum EnumInfo ptr cast [] .labelType context alignOf return
      namedType case
        t context unwrapNamed context alignOf return
      generatedType case
        t context getGeneratedType context alignOf return
    end
  end
  ## return next multiple of a >= s, assumes that a is a power of 2
  proc( i64 : s i64 : a -> i64 ) =>: export: alignSize
    s
      a 1 - +
      a 1 - ~ &
    return
  end
  proc(
    Type : t
    bool : aligned
    TypeContext ptr.mut : context
  -> TypeSize ) =>: computeSize
    t switch
      undefined autoType genericType typeSet case
        TypeSize .unknown return
      empty case
        0 TypeSize .fixed return
      align case
        aligned if t .align i64 cast.u else 0:i64 end TypeSize .fixed return
      primitiveType case
        t .primitiveType sizeOfPrimitive TypeSize .fixed return
      intLiteral case ## XXX? don't use fixed size for int literals
        t .intLiteral sizeOfIntLiteral TypeSize .fixed return
      cType case
        t .cType sizeOfCType TypeSize .fixed return
      pointer mutablePointer rawPointer mutableRawPointer procedure case
        PTR_SIZE TypeSize .fixed return
      arrayType case
        t context getArraySize =:: arraySize
        t context getBaseType context strideOf =:: baseSize
        baseSize .fixed ?? ! if
          TypeSize .unknown return
        end
        arraySize switch
          None case baseSize return
          Int case baseSize .fixed arraySize .Int *  TypeSize .fixed return
          ## TODO! distinguish generic-size and runtime dynamic size
          Dynamic case baseSize .fixed TypeSize .dynamicArray return
          GenericArg case baseSize .fixed TypeSize .dynamicArray return
        end
        break
      struct union initializer case
        t context tryComputeSize if
          TypeSize .unknown return
        end
        t context compositeData .Composite =:: compData
        compData [] .size
          aligned if
            compData [] .alignment alignSize
          end
        TypeSize .fixed return
      enum case
        t .enum EnumInfo ptr cast .labelType [] aligned context computeSize return
      namedType case
        t context unwrapNamed aligned context computeSize return
      generatedType case
        t context getGeneratedType aligned context computeSize return
    end
  end
  ## size of value in bytes
  proc( Type : t TypeContext ptr.mut : context -> TypeSize ) =>: export: sizeOf
    t false context computeSize ## TODO? should size be smaller than stride
  end
  ## size padded to next multiple of alignment
  proc( Type : t TypeContext ptr.mut : context -> TypeSize ) =>: export: strideOf
    t true context computeSize
  end

  ## array & pointer types
  union( _ : None _ : Dynamic i64 : Int LabelId : GenericArg ) =:: export: ArraySize
  struct(
    Type : base
    ArraySize : size
  ) =:: ArrayData

  proc( Type TypeContext ptr -> bool ) =>: export: isPointer
    unwrapNamed =:: t
    t .pointer ?? or t .mutablePointer ?? or t .rawPointer ?? or t .mutableRawPointer ?? end return
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isArray
    unwrapNamed .arrayType ?? return
  end
  ## pointer to array-type ( fixed size and not 0D )
  proc( Type : t TypeContext ptr : context -> bool ) =>: export: isArrayPointer
    t context unwrapNamed =:: base
    base .pointer ?? if
      base .pointer
    else base .mutablePointer ?? _if
      base .mutablePointer
    else ## raw-pointer cannot be array-pointer
      false return
    end =:: arrayId
    arrayId ArrayData ptr cast [] .size =:: ptrSize
    ptrSize .None ?? if
      false return
    end
    true return
  end
  proc( Type : t TypeContext ptr : context -> bool ) =>: export: isArrayLiteral
    t context unwrapNamed =:: base
    base .initializer ?? ! if
      false return
    end
    base .initializer InitializerInfo ptr cast [] .arrayType .undefined ?? ! return
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isFixedSize
     unwrapNamed =:: t
     t .pointer ?? or t .mutablePointer ?? or t .arrayType ?? end return
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isFixedSizePtr
     unwrapNamed =:: t
     t .pointer ?? or t .mutablePointer ?? end return
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isRawPointer
     unwrapNamed =:: t
     t .rawPointer ?? or t .mutableRawPointer ?? end return
  end
  proc( Type : box TypeContext ptr : context -> Type ) =>: export: getBaseType
    box context unwrapNamed
      $ .pointer ?? if .pointer
      else $ .mutablePointer ?? _if .mutablePointer
      else $ .rawPointer ?? _if .rawPointer
      else $ .mutableRawPointer ?? _if .mutableRawPointer
      else $ .arrayType ?? _if .arrayType
      else
        ..drop  Type .undefined return
      end
    ArrayData ptr cast [] .base return
  end
  proc( Type : box TypeContext ptr : context -> ArraySize ) =>: export: getArraySize
    box context unwrapNamed
      $ .pointer ?? if .pointer
      else $ .mutablePointer ?? _if .mutablePointer
      else $ .rawPointer ?? _if .rawPointer
      else $ .mutableRawPointer ?? _if .mutableRawPointer
      else $ .arrayType ?? _if .arrayType
      else ..drop
        ArraySize .None return
      end
    ArrayData ptr cast [] .size return
  end

  proc( Type TypeContext ptr -> bool ) =>: export: isMutable
    unwrapNamed
      $ .mutablePointer ?? or $ .mutableRawPointer ?? end
    >$ ..drop
    return
  end
  proc( ArraySize : a ArraySize : b -> bool ) =>: arraySizeEqual
    a ..label b ..label != if
      false return
    end
    a switch
      None Dynamic case true return
      Int case a .Int b .Int == return
      GenericArg case a .GenericArg b .GenericArg == return
    end
  end
  proc( ArraySize : a -> i32 ) =>: arraySizeHash
    a switch
      None case 1 return
      Dynamic case 2 return
      Int case a .Int i32 cast.u 1 + 3 * return
      GenericArg case a .GenericArg i32 cast.u 1 + -5 * return
    end
  end
  enum( POINTER MUTABLE_POINTER RAW_POINTER MUTABLE_RAW_POINTER ARRAY ) =:: export: ArrayType
  ## TODO? switch to returning Type optional instead of Type+bool
  proc(
    Type : target
    ArrayType : arrayType
    ArraySize : size
    TypeContext ptr.mut : context
  -> Type optional ) =>: export: newArrayType
    context .labelContext =:: labelContext
    target =:: mut: base
    base .undefined ?? if
      Type optional.empty return
    end
    size .None ?? and base .arrayType ?? if
      arrayType .POINTER ?? if
        base .arrayType Type .pointer optional.wrap return
      else arrayType .MUTABLE_POINTER ?? _if
        base .arrayType Type .mutablePointer optional.wrap return
      end
    end
    ## TODO? prevent dynamic-size array & fixed size raw_pointer
    ## procedure types are only allowed as base for fixed-size 0 dimensional pointers
    base context isProcedure if
      ## TODO? allow pointer of length 1 for generic matching
      arrayType .ARRAY ?? or size .None ?? ! if
        Type optional.empty return
      end
      base
        context asUnlabeledProc
      base=
    end
    context [] .memory
      base size ArrayData new mixedArena.copyValue =:: arrayId
    context .memory=
    arrayId ArrayId cast
      arrayType switch
        POINTER case Type .pointer break
        MUTABLE_POINTER case Type .mutablePointer break
        RAW_POINTER case Type .rawPointer break
        MUTABLE_RAW_POINTER case Type .mutableRawPointer break
        ARRAY case Type .arrayType break
      end
    optional.wrap return
  end

  ## initializer type as array/tuple, without changing element types
  ## used for correctly resolving procedure signatures
  proc( Type : t TypeContext ptr.mut : context ArrayType : arrayType -> Type ) =>: initializerAsArrayOrPtr
    t .initializer ?? ! if Type .undefined return end
    t .initializer InitializerInfo ptr cast =:: initInfo
    initInfo .asTuple TupleInfo ptr cast =:: tupleInfo
    tupleInfo .compositeInfo .elements [] .length =:: eltCount
    eltCount i64 cast.u ArraySize .Int =:: size
    ## newArrayType
      initInfo [] .arrayType
      arrayType
      size
    context newArrayType .data return
  end
  proc( Type : t TypeContext ptr.mut : context -> Type ) =>: export: initializerAsArray
    t context ArrayType .ARRAY initializerAsArrayOrPtr
  end
  proc( Type : t TypeContext ptr.mut : context -> Type ) =>: export: initializerAsPointer
    t context ArrayType .POINTER initializerAsArrayOrPtr
  end
  proc( Type : t TypeContext ptr.mut : context -> Type ) =>: export: initializerAsTuple
    t .initializer ?? ! if Type .undefined return end
    t .initializer InitializerInfo ptr.mut cast .asTuple TupleId cast Type .struct return
  end

  ## composite types
  i32 =:: CompositeFlags
  ## TODO update flags
    0:CompositeFlags =:: COMP_FLAG_NONE
    2:CompositeFlags =:: COMP_FLAG_EMPTY
    4:CompositeFlags =:: COMP_FLAG_STATIC_ARGS
   15:CompositeFlags =:: COMP_MASK_CONTENT_FLAGS
   16:CompositeFlags =:: COMP_SIZE_KNOWN
   32:CompositeFlags =:: COMP_FLAG_CONTAINS_LITERAL
  namespace: CompositeFlags
    proc( CompositeFlags CompositeFlags -> CompositeFlags ) : alias: and i32.and
    proc( CompositeFlags CompositeFlags -> CompositeFlags ) : alias: or  i32.or
    proc( CompositeFlags CompositeFlags -> CompositeFlags ) : alias: xor i32.xor
    proc( CompositeFlags -> CompositeFlags ) : alias: flip i32.flip
    proc( CompositeFlags -> bool ) : alias: toBool i32.toBool
  end
  overload: merge: & CompositeFlags.and    end
  overload: merge: | CompositeFlags.or     end
  overload: merge: ^ CompositeFlags.xor    end
  overload: merge: ~ CompositeFlags.flip   end
  overload: merge: ? CompositeFlags.toBool end

  struct(
    Type slice : elements
    LabelId slice optional : labels
    CompositeFlags : flags
    i64 : alignment
    i64 : size
  ) =:: CompositeInfo
  struct(
    CompositeInfo : compositeInfo
    i64 slice : elementOffsets
  ) =:: TupleInfo
  struct(
    TupleInfo : asTuple
    Type : arrayType
  ) =:: InitializerInfo
  struct(
    CompositeInfo : compositeInfo
    i64 : enumLabelOffset
    Type  : labelType
  ) =:: UnionInfo
  struct(
    LabelId slice : labels
    Type  : labelType
  ) =:: EnumInfo
  proc( Type TypeContext ptr -> bool ) =>: export: isComposite
    unwrapNamed
    switch
      enum struct union initializer case
        true return
      undefined empty primitiveType pointer mutablePointer arrayType procedure
        namedType autoType genericType generatedType intLiteral align
        cType rawPointer mutableRawPointer typeSet case
        false return
    end
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isTuple
    unwrapNamed .struct ?? return
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isEnum
    unwrapNamed .enum ?? return
  end
  ## TODO change name: enum can no longer hold values (? isEnumOrUnion)
  ## * check usage: should enum be matched by this function
  proc( Type TypeContext ptr : typeContext -> bool ) =>: export: isTaggedUnion
    typeContext unwrapNamed $ switch
      enum case ..drop true return
      union case .union UnionInfo ptr cast [] .labelType .empty ?? ! return
      struct undefined empty primitiveType pointer arrayType procedure
       namedType autoType genericType generatedType intLiteral initializer rawPointer
       cType align typeSet mutablePointer mutableRawPointer case ..drop
         false return
    end
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isUnion
    unwrapNamed .union ?? return
  end
  union(
    _ : None
    CompositeInfo ptr : Composite
    EnumInfo ptr : Enum
  ) =:: CompositeData
  proc( Type : composite TypeContext ptr : context -> CompositeData ) =>: compositeData
    composite context unwrapNamed
      ..dup switch
        struct case .struct TupleInfo ptr cast .compositeInfo CompositeData .Composite return
        union case .union UnionInfo ptr cast .compositeInfo CompositeData .Composite return
        initializer case .initializer
          InitializerInfo ptr cast .asTuple .compositeInfo CompositeData .Composite return
        enum case .enum EnumInfo ptr cast CompositeData .Enum return
        undefined empty primitiveType pointer arrayType procedure
         namedType autoType genericType generatedType intLiteral align
         cType rawPointer typeSet mutablePointer mutableRawPointer case
          ..drop CompositeData .None return
      end
  end
  proc( Type : composite TypeContext ptr : context -> i32 ) =>: export: compositeEltCount
    composite context compositeData $ switch
      None case ..drop 0 return
      Enum case .Enum .labels [] .length i32 cast return
      Composite case .Composite .elements [] .length i32 cast return
    end
  end
  proc( Type : composite i32 : index TypeContext ptr : context -> LabelId ) =>: export: compositeGetLabel
    composite context compositeData $ switch
      None case ..drop id.LABEL_ID_NONE return
      Enum case .Enum [] .labels break
      Composite case .Composite
        [] .labels $ ? if .data else ..drop
          id.LABEL_ID_NONE return
        end
      break
    end =:: labels
    index 0 < or index iSize cast.u labels .length u>= if
      id.LABEL_ID_NONE return
    end
    labels index [] return
  end
  proc(
    Type : composite
    LabelId : name
    TypeContext ptr : context
  -> i32 optional ) =>: export: compositeFindLabel
    context .labelContext =:: labelContext
    composite context compositeData $ switch
      None case ..drop i32 optional.empty return
      Enum case .Enum [] .labels break
      Composite case .Composite
        [] .labels $ ? if .data else ..drop
          i32 optional.empty return
        end
      break
    end =:: labels
    ## TODO? move linear search in slice to standard library
    0:i32 while $ iSize cast.u labels .length u< do =:: i
      ## labelNamesEq
        name
        labels i []
      labelContext id.labelNamesEq if
        i optional.wrap return
      end
      i 1 +
    end ..drop
    i32 optional.empty return
  end
  proc(
    Type : tuple
    i32 : index
    TypeContext ptr.mut : typeContext
  -> i64 optional ) =>: export: tupleElementOffset
    tuple typeContext unwrapNamed ..dup switch
      struct case .struct break
      enum union undefined empty primitiveType pointer arrayType procedure
       namedType autoType genericType generatedType intLiteral initializer align
       cType rawPointer mutablePointer mutableRawPointer typeSet case ..drop
         i64 optional.empty return
    end =:: tupleId
    tuple tupleId typeContext tryComputeTupleSize if
      i64 optional.empty return
    end
    tupleId TupleInfo ptr cast =:: tupleInfo
    index 0 < or index iSize cast.u tupleInfo [] .compositeInfo .elements .length u>= if
      i64 optional.empty return
    end
    tupleInfo [] .elementOffsets index [] optional.wrap return
  end
  proc(
    Type : enum
    TypeContext ptr.mut : typeContext
  -> Type i64 optional ) =>: export: enumLabelInfo
    enum typeContext unwrapNamed $ switch
      enum case .enum EnumInfo ptr cast [] .labelType 0:i64  optional.wrap return
      union case .union break
      struct undefined empty primitiveType pointer arrayType procedure
       namedType autoType genericType generatedType intLiteral initializer align
       cType rawPointer mutablePointer mutableRawPointer typeSet case ..drop
         Type .empty i64 optional.empty return
    end =:: unionId
    enum unionId typeContext tryComputeUnionSize =:: isError
    unionId UnionInfo ptr cast =:: enumInfo
    enumInfo [] .labelType
      isError if
        i64 optional.empty
      else
        enumInfo [] .enumLabelOffset optional.wrap
      end
    return
  end
  proc( Type : composite i32 : index TypeContext ptr : context -> Type ) =>: export: compositeGetElement
    composite context compositeData $ switch
      None case ..drop Type .undefined return
      Enum case ..drop Type .empty return
      Composite case .Composite break
    end =:: compData
    index 0 < or index iSize cast.u compData [] .elements .length u>= if
      Type .undefined return
    end
    compData [] .elements index [] return
  end
  proc( Type : composite TypeContext ptr : context -> Type slice ) =>: export: compositeElts
    composite context compositeData $ switch
      None Enum case ..drop Type slice.empty return
      Composite case .Composite [] .elements return
    end
  end
  proc( Type : composite TypeContext ptr : context -> CompositeFlags ) =>: compositeFlags
    composite context compositeData $ switch
      None Enum case ..drop 0:CompositeFlags return
      Composite case .Composite [] .flags return
    end
  end

  proc(
    Type slice : elts
    TypeContext ptr.mut : context
  -> CompositeFlags ) =>: computeCompositeFlags
    true =:: mut: emptyData ## composite is empty
    COMP_FLAG_NONE
      elts for =:: elt
        elt context isEmpty ! if
          false emptyData=
        end
        elt context containsGeneric if
          COMP_FLAG_STATIC_ARGS |
        end
        elt isLiteral if
          COMP_FLAG_CONTAINS_LITERAL |
        end
      end
      emptyData if
         COMP_FLAG_EMPTY |
      end
    return
  end

  ## creates struct
  proc(
    Type slice : elts
    LabelId slice optional : labels
    TypeContext ptr.mut : context
  -> Type optional ) =>: export: newTuple
    elts .length 0:iSize == if
      ## empty tuple -> empty type handled by parser
      Type optional.empty return
    end
    elts context computeCompositeFlags =:: flags
    context [] .memory
      elts mixedArena.copySlice slice.freeze =:: eltCopy
      labels $ ? if
        .data mixedArena.copySlice slice.freeze optional.wrap
      end =:: labelCopy
      ## TupleInfo
        ## CompositeInfo
          eltCopy
          labelCopy
          flags
          -1
          -1
        CompositeInfo new
        i64 slice.empty
      TupleInfo new mixedArena.copyValue =:: tupleId
    context .memory=
    tupleId TupleId cast Type .struct optional.wrap return
  end
  proc(
    Type slice : elts
    LabelId slice optional : labels
    TypeContext ptr.mut : context
  -> Type ) =>: export: newInitializerType
    ##  check if initializer can be array
    elts .length 0:iSize != if
      elts 0 slice.get
    else ## TODO? special type for empty array?
      primitive.I32 ## TODO? better default type for empty array
    end =:: mut: arrayType
    0:iSize while $ elts .length u< do =:: i
      elts i slice.get =:: eltType
      labels optional.hasData and
        labels .data i slice.get id.LABEL_ID_NONE != if
        ## if there is a labeled element the initializer is not an array
        Type .undefined arrayType=
        i break
      end
      arrayType eltType context mergeTypes $ ? if
        #+mergedType+# .data arrayType=
      else ..drop
        Type .undefined arrayType=
        i break
      end
    finally i 1:iSize + end ..drop
    elts context computeCompositeFlags =:: flags
    context [] .memory
      ## InitializerInfo
      elts mixedArena.copySlice slice.freeze =:: eltCopy
      labels $ ? if
        .data mixedArena.copySlice slice.freeze optional.wrap
      end =:: labelCopy
        ## TupleInfo
          ## CompositeInfo
            eltCopy
            labelCopy
            flags
            -1
            -1
          CompositeInfo new
          i64 slice.empty
        TupleInfo new
        arrayType
      InitializerInfo new mixedArena.copyValue =:: initializerId
    context .memory=
    initializerId InitializerId cast Type .initializer return
  end
  proc(
    iSize : eltCount
    bool : isTagged
  -> Type ) =>: export: computeEnumLabelType
    isTagged ! if
      Type .empty
    else eltCount 0x80:iSize u< _if
      primitive.I8
    else eltCount 0x8000:iSize u< _if
      primitive.I16
    else
      primitive.I32
    end return
  end
  proc(
    Type optional : baseType
    LabelId slice : labels
    TypeContext ptr.mut : context
  -> Type optional ) =>: export: newEnum
    labels .length 0:iSize == if
      Type optional.empty return
    end
    context [] .memory
      labels mixedArena.copySlice slice.freeze
        baseType $ ? if .data else ..drop
          labels .length true computeEnumLabelType
        end
      EnumInfo new mixedArena.copyValue =:: enumId
    context .memory=
    enumId EnumId cast Type .enum optional.wrap return
  end
  proc(
    Type slice : elts
    LabelId slice : labels
    bool : isTagged
    TypeContext ptr.mut : context
  -> Type optional ) =>: export: newUnion
    elts .length 0:iSize == or elts .length labels .length != if
      Type optional.empty return
    end
    context [] .memory
      ## UnionInfo
        elts mixedArena.copySlice slice.freeze =:: eltCopy
        labels mixedArena.copySlice slice.freeze optional.wrap =:: labelCopy
        ## CompositeInfo
          eltCopy
          labelCopy 
          elts context computeCompositeFlags
          -1
          -1
        CompositeInfo new
        0
        labels .length true computeEnumLabelType
      UnionInfo new mixedArena.copyValue =:: unionId
    context .memory=
    unionId UnionId cast Type .union optional.wrap return
  end
end
namespace: sb
  proc(
    stringBuilder
    LabelId : label
    LabelContext ptr : labelContext
  -> stringBuilder ) =>: appendTypeElementLabel
    " : " appendS
    label labelContext id.labelFlags id.FLAG_MUTABLE & ? if
      "mut: " appendS
    end
    label labelContext id.labelFlags id.FLAG_AUTO & ? if
      "auto: " appendS
    end
    label labelContext id.labelFlags id.FLAG_STATIC & ? if
      "static: " appendS
    end
    label labelContext appendLabelName
  end
  proc(
    stringBuilder : sb
    Type : t
    i32 : depth
    TypeContext ptr : context
  -> stringBuilder ) =>: appendComposite
    context .labelContext =:: labelContext
    sb
      t context types.compositeData .Composite =:: comp
      comp [] .labels ? ! =:: unlabeled
      0:i32 while $ iSize cast.u comp [] .elements .length u< do
        >$
          t $2 context types.compositeGetElement =:: eltType
          unlabeled if
            eltType context depth 1 - appendTypeRecursive
            ' ' appendC
            <$ 1 + continue
          end
          t $2 context types.compositeGetLabel =:: label
          label id.LABEL_ID_NONE !=
            label labelContext id.labelFlags id.FLAG_DUMMY & ? ! &
          =:: printLabel
          eltType context types.isEmpty if
            "_" sb.appendS
          else
            eltType context depth 1 - appendTypeRecursive
          end
          printLabel if
            label labelContext appendTypeElementLabel
          end
          ' ' appendC
        <$
        1 +
      end ..drop
    return
  end
  proc(
    stringBuilder
    types.EnumInfo : enumInfo
    LabelContext ptr : labelContext
  -> stringBuilder ) =>: appendEnumElements
    enumInfo .labels for labelContext appendLabelName ' ' sb.appendC end
  end
end
namespace: types
  ## procedure types
  struct(
    Type slice : inTypes
    Type slice : outTypes 
    LabelId slice : labels
    CallingConvention : callingConvention
  ) =:: ProcType

  proc( Type TypeContext ptr -> bool ) =>: export: isProcedure
    unwrapNamed .procedure ?? return
  end
  proc( Type : mType TypeContext ptr : context -> bool ) =>: export: isCallable
    mType context unwrapNamed
      $ context isFixedSizePtr if
        context getBaseType
      end
    .procedure ?? return
  end
  proc( Type : proc TypeContext ptr : context -> ProcType ptr optional ) =>: getProcData
    proc context unwrapNamed
      $ context isProcedure ! if ..drop
        ProcType ptr optional.empty return
      end
    .procedure ProcType ptr cast optional.wrap return
  end
  proc( Type : proc TypeContext ptr : context -> Type slice optional ) =>: export: getProcIn
    proc context getProcData $ optional.hasData if .data
      [] .inTypes optional.wrap return
    else ..drop
      Type slice optional.empty return
    end
  end
  proc( Type : proc TypeContext ptr : context -> LabelId slice ) =>: export: getProcLabels
    proc context getProcData $ optional.hasData if
      .data [] .labels
    else ..drop
      LabelId slice.empty return
    end
  end
  proc( Type : proc TypeContext ptr : context -> LabelId slice ) =>: export: getProcArgLabels
    proc context getProcData $ optional.hasData if .data else ..drop
      LabelId slice.empty return
    end =:: procData
    procData [] .labels procData [] .inTypes .length slice.head
  end
  proc( Type : proc TypeContext ptr : context -> LabelId slice ) =>: export: getProcRetLabels
    proc context getProcData $ optional.hasData if .data else ..drop
      LabelId slice.empty return
    end =:: procData
    procData [] .labels procData [] .inTypes .length slice.tail
  end
  proc( Type : proc i32 : argIndex TypeContext ptr : context -> LabelId ) =>: export: getProcArgLabel
    proc context getProcArgLabels =:: labels
    argIndex 0 < or argIndex iSize cast.u labels .length u>= if
      id.LABEL_ID_NONE return
    end
    labels argIndex []
  end
  proc( Type : proc LabelId : argName TypeContext ptr : context -> i32 optional ) =>: export: findProcArgLabel
    proc context getProcArgLabels =:: labels
    0:i32 while $ iSize cast.u labels .length u< do =:: i
      ## labelNamesEq
        argName
        labels i []
      context .labelContext id.labelNamesEq if
        i optional.wrap return
      end
      i 1 +
    end ..drop
    i32 optional.empty return
  end
  proc( Type : proc TypeContext ptr : context -> Type slice optional ) =>: export: getProcOut
    proc context getProcData $ optional.hasData if .data
      [] .outTypes optional.wrap return
    else ..drop
      Type slice optional.empty return
    end
  end
  proc( Type : proc TypeContext ptr : context -> CallingConvention ) =>: export: getCallConvention
    proc context getProcData $ optional.hasData if .data
      [] .callingConvention return
    else ..drop
      CallingConvention.DEFAULT return
    end
  end
  union(
    _ : Empty
    Type : Value
    Type : Tuple
  ) =:: export: ProcRet
  proc( Type : proc TypeContext ptr.mut : context -> ProcRet ) =>: export: getProcRet
    proc context getProcData $ ? if .data else ..drop
      ProcRet .Empty return
    end
      $ [] .callingConvention =:: callConvention
    .outTypes [] =:: outTypes
    callConvention switch
      CCALL PTRCALL case
        outTypes .length 0:iSize == if
          ProcRet .Empty return
        end
        outTypes $ .length 1:iSize - [] =:: retVal
        retVal context isEmpty if
          ProcRet .Empty return
        end
        retVal ProcRet .Value return
      CONCAT case
        outTypes .length 0:iSize == if
          ProcRet .Empty return
        end
        outTypes .length 1:iSize == if
          outTypes 0 [] ProcRet .Value return
        end
        ## TODO! filter out empty elements
        ## TODO reuse slice memory if possible
        outTypes
          LabelId slice optional.empty
        context newTuple .data ProcRet .Tuple return
    end
  end
  proc( Type : proc TypeContext ptr : context -> Type slice ) =>: export: getProcOutArgs
    proc context getProcData $ ? if .data else ..drop
      Type slice.empty return
    end
      $ [] .callingConvention =:: callConvention
    .outTypes [] =:: outTypes
    callConvention switch
      CCALL CONCAT case Type slice.empty return
      PTRCALL case
        outTypes .length 0:iSize == if
          Type slice.empty return
        end
        outTypes outTypes .length 1:iSize - slice.head return
    end
  end
  proc( Type slice : in Type slice : out LabelId slice : labels CallingConvention : callConvention TypeContext ptr.mut : context -> Type optional ) =>: export: newProcedure
    callConvention .CCALL ?? and out .length 1:iSize u> if
      Type optional.empty return ## XXX? better error handling
    end
    context [] .memory
      in mixedArena.copySlice slice.freeze =:: inCopy
      out mixedArena.copySlice slice.freeze =:: outCopy
      labels mixedArena.copySlice slice.freeze =:: labelsCopy
      inCopy outCopy labelsCopy callConvention ProcType new mixedArena.copyValue =:: procId
    context .memory=
    procId ProcTypeId cast Type .procedure optional.wrap return
  end
  proc(
    Type : proc
    TypeContext ptr.mut : context
  -> Type ) =>: export: asUnlabeledProc
    proc context unwrapNamed
      $ context isCallable ! if ..drop
        proc return
      end
      false =:: mut: isPtr
      $ context isPointer if
        context getBaseType
        true isPtr=
      end
    =:: mProc
    mProc .procedure ProcType ptr cast =:: procData
    procData [] .labels .length 0:iSize == if
      proc return
    end
    context [] .memory
      ## ProcType
        procData [] .inTypes
        procData [] .outTypes
        LabelId slice.empty
        procData [] .callingConvention
      ProcType new mixedArena.copyValue =:: procId
    context .memory=
    procId ProcTypeId cast Type .procedure
      isPtr if
        ArrayType .POINTER ArraySize .None context newArrayType .data return
      end
    return
  end

  ## named types
  proc(
    LabelId : label
    TypeContext ptr.mut : context
  -> Type ) =>: export: declareNamedType
    label Type .namedType return
  end

  proc(
    Type : value
    LabelId : label
    TypeContext ptr.mut : context
  -> Type optional ) =>: export: initializeNamedType
    context .namedTypes label value map.put =:: oldValue
    oldValue ? if
      context .namedTypes label oldValue .data map.put ..drop
      Type optional.empty return
    end
    label Type .namedType optional.wrap return
  end

  proc( Type -> bool ) =>: export: isNamedType
    .namedType ?? return
  end
  ## completely unwrap named type
  proc( Type TypeContext ptr : context -> Type ) =>: export: unwrapNamed
    ## TODO figgure out where an empty named/generator types are unwrapped
    while
      $ .namedType ?? if
        context .namedTypes >$ .namedType map.get
          $ ? if .data else ..drop Type .undefined return end
        continue
      else $ .generatedType ?? _if
        context .generatedTypes >$ .generatedType GeneratedTypeName ptr cast [] map.get
          $ ? if .data .value else ..drop Type .undefined return end
          $ ? if .data else ..drop Type .undefined return end
        continue
      end
    false do end
    return
  end
  ## unwrap only top level named type
  proc( Type TypeContext ptr : context -> Type ) =>: export: flatUnwrapNamed
    $ .namedType ?? if
      context .namedTypes >$ .namedType map.get .data
    end
    return
  end
  ## completely unwrap named type
  proc(
    Type
    TypeContext ptr : context
  -> Type ) =>: export: unwrapNamedKeepGenerated
    while
      $ .namedType ?? if
        context .namedTypes >$ .namedType map.get
          $ ? if .data else ..drop Type .undefined return end
        continue
      end
    false do end
    return
  end
  proc( Type TypeContext ptr : context -> LabelId ) =>: export: namedTypeName
    $ .namedType ?? if
      .namedType return
    end
    ..drop id.LABEL_ID_NONE return
  end
end

namespace: sb
  proc(
    stringBuilder : sb
    LabelId : name
    TypeContext ptr : context
    i32 : depth
  -> stringBuilder ) =>: appendNamedType
    context .labelContext =:: labelContext
    sb
      '"' sb.appendC
      name labelContext sb.appendLabelPath
      '"' sb.appendC
      depth 0 > if
        " [ " sb.appendS
        ## appendTypeRecursive
          context .namedTypes name map.get .data
          context
          depth 1 -
        appendTypeRecursive
        " ]"  sb.appendS
      end
    return
  end
end
namespace: types
  ## generated types

  struct(
    LabelId : generator
    ConstValue slice : arguments
  ) =:: GeneratedTypeName
  struct(
    GeneratedTypeId : key
    Type optional : value
  ) =:: GeneratedTypeValue

  ## FIXME: double-check hash calculation for generated types
  proc( GeneratedTypeName : a GeneratedTypeName : b -> bool ) =>: genNameEq
    a .generator b .generator != if false return end
    a .arguments b .arguments constantEquals@ slice.eq
  end
  proc( GeneratedTypeName : a -> i32 ) =>: genNameHash
    a .generator i32 cast.u
      31 * a .arguments constantHash@ slice.hash +
    return
  end

  proc( Type -> bool ) =>: export: isGeneratedType
    .generatedType ?? return
  end

  union(
    _ : None
    Type : Created
    Type : Stored
  ) =:: export: GeneratedTypeState
  #+ finds the generated type for the given type generator and arguments
     returns the type and a boolean that is true if a new GeneratedType was created +#
  proc(
    LabelId : generatorName
    ConstValue slice : arguments
    bool : create
    TypeContext ptr.mut : typeContext
    ConstantContext ptr.mut : constContext
  -> GeneratedTypeState ) =>: export: findGeneratedType
    typeContext .labelContext =:: labelContext
    generatorName arguments GeneratedTypeName new =:: genName
    typeContext .generatedTypes genName map.get =:: prevValue
    prevValue optional.hasData if
      prevValue .data .key Type .generatedType GeneratedTypeState .Stored return
    end
    create if
      typeContext [] .memory
        arguments mixedArena.copySlice slice.freeze =:: newArgs
        generatorName newArgs GeneratedTypeName new mixedArena.copyValue GeneratedTypeId cast =:: newKey
      typeContext .memory=
      typeContext .generatedTypes
        genName
        ## GeneratedTypeValue
          newKey
          Type optional.empty
        GeneratedTypeValue new
      map.put ..drop
      newKey Type .generatedType GeneratedTypeState .Created return
    end
    GeneratedTypeState .None return
  end

  proc(
    LabelId : generatorName
    ConstValue slice : arguments
    Type : value
    TypeContext ptr.mut : typeContext
    ConstantContext ptr.mut : constContext
  -> Type ) =>: export: initializeGeneratedType
    ## findGeneratedType
      generatorName
      arguments
      true
      typeContext
      constContext
    findGeneratedType $ switch
      Stored case .Stored break
      Created case .Created break
      None case ..unreachable
    end =:: prevType
    value optional.wrap
      typeContext .generatedTypes
        prevType .generatedType GeneratedTypeName ptr cast []
      map.at .data
    .value=
    prevType return
  end

  proc( Type : generator TypeContext ptr : context -> Type ) =>: export: getGeneratedType
    generator =:: mut: t
    t .namedType ?? if
      t context unwrapNamedKeepGenerated t=
    end
    t .generatedType ?? ! if
      generator return
    end
    context .generatedTypes t .generatedType GeneratedTypeName ptr cast [] map.get
      $ ? if
        .data .value $ ? if .data else ..drop Type .undefined end
      else ..drop
        Type .undefined
      end
    return
  end

  proc( Type : generator TypeContext ptr : context -> LabelId ) =>: export: getGeneratorLabel
    generator =:: mut: t
    t .namedType ?? if
      t context unwrapNamedKeepGenerated t=
    end
    t .generatedType ?? ! if
      id.LABEL_ID_NONE return
    end
    t .generatedType GeneratedTypeName ptr cast [] .generator return
  end
  proc( Type : generator TypeContext ptr : context -> ConstValue slice ) =>: export: getGeneratorArgs
    generator =:: mut: t
    t .namedType ?? if
      t context unwrapNamedKeepGenerated t=
    end
    t .generatedType ?? ! if
      ConstValue slice.empty return
    end
    t .generatedType GeneratedTypeName ptr cast [] .arguments return
  end

  ## generic & auto-types
  proc( i32 : id -> Type ) =>: export: newAutoType
    id Type .autoType return
  end
  proc( Type -> bool ) =>: export: isAutoType
    .autoType ?? return
  end
  proc( Type : t -> i32 ) =>: export: getAutoTypeId
    t .autoType ?? if t .autoType else -1 end return
  end

  proc(
    LabelId : name
    TypeSetEntry slice : elements
    TypeContext ptr.mut : context
  -> Type ) =>: export: newTypeSet
    ## TODO? check if type-set contains duplicate values
    context [] .memory
      ## type-set entries can be copyied without internal updates
      elements mixedArena.copySlice =:: sliceElements
      sliceElements slice.freeze TypeSet new mixedArena.copyValue =:: typeSet
    context .memory=
    typeSet TypeSetId cast Type .typeSet return
  end
  proc( Type TypeContext ptr : context -> bool ) =>: export: isTypeSet
    context unwrapNamed .typeSet ?? return
  end
  ## TODO? better name "is this type a type" sounds weird
  proc( Type : t TypeContext ptr : context -> bool ) =>: export: isType
    t context unwrapNamed =:: baseType
    baseType .typeSet ?? or baseType primitive.TYPE typeEquals end return
  end
  proc( Type : t TypeContext ptr : context -> TypeSetEntry slice ) =>: export: getTypeSetEntries
    t context unwrapNamed =:: t0
    t0 .typeSet ?? ! if
      TypeSetEntry slice.empty return
    end
    t0 .typeSet TypeSet ptr cast [] .elements return
  end

  proc( LabelId : id -> Type ) =>: export: newGenericType
    id Type .genericType return
  end
  proc( Type TypeContext ptr -> bool ) =>: export: isGeneric
    unwrapNamed .genericType ?? return
  end
  proc( Type : t -> LabelId ) =>: export: getGenericTypeId
    t .genericType ?? if t .genericType else id.LABEL_ID_NONE end return
  end
  proc( Type : t0 TypeContext ptr : context -> bool #+has static arg+# ) =>: export: containsGeneric
    t0 context unwrapNamedKeepGenerated =:: t
    t switch
      undefined empty primitiveType autoType cType intLiteral align typeSet case
        false return
      pointer mutablePointer rawPointer mutableRawPointer arrayType case
        t $ .pointer ?? if
            .pointer
          else $ .mutablePointer ?? _if
            .mutablePointer
          else $ .rawPointer ?? _if
            .rawPointer
          else $ .mutableRawPointer ?? _if
            .mutableRawPointer
          else
            .arrayType
          end
        ArrayData ptr cast [] =:: arrayType
        arrayType .size .GenericArg ?? if
          true return
        end
        arrayType .base context containsGeneric if
          true return
        end
        false return
      struct enum union initializer case
        t context compositeFlags COMP_FLAG_STATIC_ARGS & ? return
      generatedType case
        t .generatedType GeneratedTypeName ptr cast =:: genType
        ## a generatedType is generic if one of its arguments is generic
        genType .arguments [] .length for =:: i
          genType [] .arguments i slice.get =:: arg
          ConstValue ..length 23:iSize == "no new constants" assert
          arg .GenericArg ?? or arg .TypeId ?? and arg .TypeId context containsGeneric if
            true return
          end
        end
        false return
      procedure case
        t .procedure ProcType ptr cast =:: procType
        ## TODO cache result of computation?
        procType [] .inTypes for
          context containsGeneric if
            true return
          end
        end
        procType [] .outTypes for
          context containsGeneric if
            true return
          end
        end
        false return
      namedType case
        t context unwrapNamed context containsGeneric return
      genericType case
        true return
    end
  end

  proc( Type : t0 TypeContext ptr : context -> bool ) =>: export: isInitializer
    t0 context unwrapNamed .initializer ?? return
  end

  proc( Type : src bool : mutable TypeContext ptr.mut : context -> Type ) =>: export: getAddressType
    src context isArray if
      src context unwrapNamed =:: unwraped
      ## TODO? directly reuse ArrayData instead of calling newArrayType
      unwraped context getBaseType
        mutable if ArrayType .MUTABLE_POINTER else ArrayType .POINTER end
        unwraped context getArraySize
      context newArrayType .data return
    end
    src context isProcedure if
      src context asUnlabeledProc
    else
      src
    end
      mutable if ArrayType .MUTABLE_POINTER else ArrayType .POINTER end
      ArraySize .None
    context newArrayType .data return
  end
  proc( Type : src TypeContext ptr.mut : context -> Type ) =>: export: ptrTarget
    src context isPointer ! if
      Type .undefined return
    end
    src context isArrayPointer if
      ## TODO? directly reuse ArrayData instead of calling newArrayType
      src context unwrapNamed =:: unwraped
      unwraped context getBaseType
        ArrayType .ARRAY
        unwraped context getArraySize
      context newArrayType .data return
    end
    src context getBaseType return
  end

  proc( Type : src Type : target TypeContext ptr : context -> bool ) =>: sizeCompatible
    using types.
    src context isFixedSize ! and target context isFixedSize if
      false return ## cannot cast non-fixed pointer to fixed poiner
    end
    target context isFixedSize ! if
      true return
    end
    src context getArraySize =:: srcSize
    target context getArraySize =:: targetSize
    srcSize targetSize arraySizeEqual if
      true return
    end
    ## allow cast  T ptr -> T 1 ptr
    srcSize .None ?? and targetSize .Int ?? and targetSize .Int 1 == if
      true return
    end
    false return
  end

  proc(
    PrimitiveType : a
    PrimitiveType : b
  -> bool ) =>: canCastPrimitivePtrArg
    a ..label b ..label == if true return end
    a switch
      I8  case b .CHAR8  ?? return
      I16 case b .CHAR16 ?? return
      I32 case b .CHAR32 ?? return
      CHAR8  case b .I8  ?? return
      CHAR16 case b .I16 ?? return
      CHAR32 case b .I32 ?? return
      BOOL I64 F32 F64 TYPE case false return
    end
  end
  proc(
    Type : mut: src
    Type : mut: target
    bool : allowRename
    bool : mutableParent
    TypeContext ptr : context
  -> bool ) =>: canCastPtr
    allowRename if
      src context unwrapNamed src=
      target context unwrapNamed target=
    end
    src target types.typeEquals if
      true return
    end
    allowRename and src .primitiveType ?? and target .primitiveType ?? and
      src .primitiveType target .primitiveType canCastPrimitivePtrArg if
      true return
    end
    ## TODO! allow cast  T k array l ptr -> T  k l *  ptr
    src context types.isPointer ! or target context types.isPointer ! if
      false return
    end
    target context types.isMutable =:: mutableTarget
    src context types.isMutable =:: mutableSrc
    mutableParent if ## cannot convert mutable to immutable if parent is mutable
      mutableSrc mutableTarget !=
    else
      mutableSrc ! mutableTarget &
    end or src target context sizeCompatible ! if
      false return
    end
    ## canCastPtr
      src context types.getBaseType
      target context types.getBaseType
      allowRename
      mutableParent mutableTarget |
    context canCastPtr return
  end
  ## XXX? allow reordering fields
  proc( Type : src Type : target TypeContext ptr.mut : context -> bool ) =>: canCastTupleInitializer
    context .labelContext =:: labelContext
    src context unwrapNamed =:: srcBase
    target context unwrapNamed =:: targetBase
    srcBase .struct ?? if
      srcBase .struct TupleInfo ptr cast
    else srcBase .initializer ?? _if
      srcBase .initializer InitializerInfo ptr cast .asTuple
    else
      false return
    end =:: srcInfo
    targetBase .struct ?? ! if false return end
    targetBase .struct TupleInfo ptr cast =:: targetInfo
    srcInfo targetInfo == if
      true return
    end
    srcInfo .compositeInfo [] .elements =:: srcElts
    targetInfo .compositeInfo [] .elements =:: targetElts
    srcElts .length targetElts .length != if
      false return
    end
    srcInfo .compositeInfo .labels [] =:: srcLabels?
    targetInfo .compositeInfo .labels [] =:: targetLabels?
    srcLabels? optional.isEmpty targetLabels? optional.isEmpty != if
      false return ## eigther both labeled or both unlabled
    end
    ## XXX? wrapper function for getting tuple elements/labels from id
    srcLabels? optional.hasData =:: labeled
    srcElts .length for =:: i
      srcElts i [] targetElts i [] context canAutoCast ! if
        false return
      end
      labeled and
          ## labelNamesEq
            srcLabels? .data i []
            targetLabels? .data i []
            labelContext
          id.labelNamesEq ! if
        false return
      end
    end
    true return
  end
  proc( Type : src Type : target TypeContext ptr.mut : context -> bool ) =>: export: canAutoCastInitializer
    target context unwrapNamed =:: targetBase
    src context compositeEltCount =:: srcSize
    srcSize 0 == =:: srcEmpty
    srcEmpty and targetBase context types.isRawPointer if
      true return ## empty initializer to raw 1D pointer
    end
    ## XXX? allow cast from empty initializer to union with single empty entry
    targetBase context types.isMutable if
      false return ## cannot cast non-empty initializer to mutable pointer
    end
    targetBase context types.isArray or targetBase context types.isArrayPointer if
      src .initializer InitializerInfo ptr cast =:: initInfo
      targetBase context getBaseType =:: eltType
      initInfo .arrayType [] eltType context canAutoCast and
        targetBase context getArraySize =:: targetSize
        targetSize .Int ?? and targetSize .Int srcSize i64 cast.u == if
          true return
      end
    end
    targetBase context types.isTuple if
      src targetBase context canCastTupleInitializer return
    else targetBase context types.isPointer
        and targetBase context getArraySize .None ??
        and targetBase context getBaseType context unwrapNamed =:: baseType
        baseType context types.isTuple _if
      src baseType context canCastTupleInitializer return
    end
    false return
  end

  proc( Type : src0 Type : target0 TypeContext ptr.mut : context -> bool ) =>: export: canAlias
    src0 context unwrapNamed =:: src
    target0 context unwrapNamed =:: target
    src target types.typeEquals if
      true return ## same type-different names
    end
    ## procedure: compare call-convention, arguments and return-values
    src .procedure ?? and target .procedure ?? if
      src context getCallConvention target context getCallConvention != if
        false return
      end
      src context getProcIn .data =:: srcIn
      target context getProcIn .data =:: targetIn
      srcIn .length targetIn .length != if
        false return
      end
      srcIn .length for =:: i
        srcIn i [] targetIn i [] context canAlias ! if
          false return
        end
      end
      src context getProcOut .data =:: srcOut
      target context getProcOut .data =:: targetOut
      srcOut .length targetOut .length != if
        false return
      end
      srcOut .length for =:: i
        srcOut i [] targetOut i [] context canAlias ! if
          false return
        end
      end
      true return
    end
    false return
  end

  proc( Type : src Type : target TypeContext ptr.mut : context -> bool ) =>: export: canAutoCast
    src target types.typeEquals if
      true return
    end
    src context types.isType and target context types.isType if
      true return ## allow automatic conversions between different version of "type"-types
    end
    src .initializer ?? if
      src target context canAutoCastInitializer return
    end
    src .namedType ?? or target .namedType ?? if
      false return
    end
    ## no auto-cast from/to c-type to minimize platform specific behaviour
    src .cType ?? or target .cType ?? if
      false return
    end
    src .intLiteral ?? target context types.isNumber & if
      src target context types.canAutoCastIntLiteral return
    end
    src context types.isNumber target context types.isNumber & if
      src target context types.canAutoCastNumber return
    end
    src context types.isPointer and target context types.isPointer if
      src target false false context canCastPtr return
    end
    false return
  end
  proc( Type : a Type : b bool : forceCast TypeContext ptr.mut : context -> bool ) =>: export: canCast
    a context types.unwrapNamed =:: mut: src
    b context types.unwrapNamed =:: mut: target
    src target context canAutoCast if
      true return
    end
    ## converting c-types to types
    target .cType ?? if
      forceCast ! if
        target .cType .STRUCT ?? if false return end
        target .cType .UNION  ?? if false return end
      end
      src target .cType cTypeAsType forceCast context canCast return
    end
    src .cType ?? if
      forceCast ! if
        src .cType .STRUCT ?? if false return end
        src .cType .UNION  ?? if false return end
      end
      src .cType cTypeAsType target forceCast context canCast return
    end
    ## char <-> int
    src context isChar and target context isInt if
      true return
    end
    src context isInt and target context isChar if
      true return
    end
    src context types.isNumber or src .intLiteral ?? and target context types.isNumber if
      true return
    end
    src context types.isPointer and target context types.isPointer and
        src target true false context canCastPtr if
      true return
    end
    forceCast ! if
      false return
    end
    src context types.isPointer target context types.isPointer & if
      true return ## XXX check for compatible element sizes?, compatible mutability
    end
    src context types.isPointer target context types.isInt & if
      true return
    end
    src context types.isInt target context types.isPointer & if
      true return
    end
    false return
  end
  proc( Type : src Type : target TypeContext ptr.mut : context -> bool ) =>: export: canBitCast
    src context sizeOf $ .fixed ?? if .fixed else ..drop false return end =:: srcSize
    target context sizeOf $ .fixed ?? if .fixed else ..drop false return end =:: targetSize
    ## TODO? should there by any other restrictions on bit-casts
    srcSize targetSize == or
      ## allow int-literals to be smaller than target-type
      src .intLiteral ?? and src .intLiteral intLiteralBytes targetSize <= and
        primitive.I_MAX .primitiveType sizeOfPrimitive targetSize >= end
    return
  end
  proc( Type : a Type : b TypeContext ptr.mut : context -> Type optional ) =>: export: mergeTypes
    a b types.typeEquals if
      a optional.wrap return
    end
    ## don't merge different named types
    a .namedType ?? or b .namedType ?? if
      Type optional.empty return
    end
    a context types.isPointer and b context types.isPointer and
        a context types.getBaseType b context types.getBaseType types.typeEquals if
      a context types.isMutable b context types.isMutable & =:: mutable
      a context types.getArraySize =:: aSize
      b context types.getArraySize =:: bSize
      a context types.isFixedSize b context types.isFixedSize & =:: mut: fixedSize
      ## newArrayType
        a context types.getBaseType
        mutable if
          fixedSize if ArrayType .MUTABLE_POINTER else ArrayType .MUTABLE_RAW_POINTER end
        else
          fixedSize if ArrayType .POINTER else ArrayType .RAW_POINTER end
        end
        aSize bSize arraySizeEqual if aSize else ArraySize .Dynamic end
        context
      newArrayType return
    end
    a .intLiteral ?? and b context types.isNumber and
        a b context canAutoCastIntLiteral if
      b optional.wrap return
    end
    b .intLiteral ?? and a context types.isNumber and
        b a context canAutoCastIntLiteral if
      a optional.wrap return
    end
    a .intLiteral ?? and b .intLiteral ?? if
      ## XXX directly merge literal types?
      a b .intLiteral intLiteralAsInt context mergeTypes $ ? if
        return
      else ..drop
        a .intLiteral intLiteralAsInt b context mergeTypes return
      end
    end
    ## TODO handle initializer types
    Type optional.empty return
  end
end
## type context
struct(
  LabelContext        : labelContext
  MixedArenaAllocator : memory
  LabelId Type hashMap : namedTypes
  types.GeneratedTypeName types.GeneratedTypeValue hashMap : generatedTypes
) =:: export: TypeContext
namespace: types
  proc( -> TypeContext ) =>: export: newTypeContext
    ## TypeContext
      id.newLabelContext
      4096 mixedArena.create
      labelHash@ labelEq@ 1024 Type map.create
      genNameHash@ genNameEq@ 1024 types.GeneratedTypeValue map.create
    TypeContext new return
  end
  proc( TypeContext : mut: context -> TypeContext ) =>: export: freeTypeContext
    context@ .namedTypes map.free
    context@ .generatedTypes map.free
    context
      $ .labelContext id.freeLabelContext >$ .labelContext=
      $ .memory mixedArena.free >$ .memory=
    return
  end
end
namespace: sb
  proc( stringBuilder types.PrimitiveType -> stringBuilder ) =>: appendPrimitiveType
    switch
      BOOL case "bool" appendS return
      I8   case "i8"   appendS return
      I16  case "i16"  appendS return
      I32  case "i32"  appendS return
      I64  case "i64"  appendS return
      CHAR8  case "char8"  appendS return
      CHAR16 case "char16" appendS return
      CHAR32 case "char32" appendS return
      F32  case "f32"  appendS return
      F64  case "f64"  appendS return
      TYPE case "type" appendS return
    end
  end
  proc( stringBuilder types.IntLiteral -> stringBuilder ) =>: appendIntLiteralType
    switch
      U7  case "..intLiteral.u7"   appendS return
      S8  case "..intLiteral.s8"   appendS return
      U8  case "..intLiteral.u8"   appendS return
      U15 case "..intLiteral.u15"  appendS return
      S16 case "..intLiteral.s16"  appendS return
      U16 case "..intLiteral.u16"  appendS return
      U24 case "..intLiteral.u24"  appendS return
      S25 case "..intLiteral.s25"  appendS return
      U31 case "..intLiteral.u31"  appendS return
      S32 case "..intLiteral.s32"  appendS return
      U32 case "..intLiteral.u32"  appendS return
      U53 case "..intLiteral.u53"  appendS return
      S54 case "..intLiteral.s54"  appendS return
      U63 case "..intLiteral.u63"  appendS return
      S64 case "..intLiteral.s64"  appendS return
      U64 case "..intLiteral.u64"  appendS return
    end
  end
  proc( stringBuilder types.CType -> stringBuilder ) =>: appendCType
    switch
      VOID case
        "..ctype.void" appendS return
      BOOL case
        "..ctype.bool" appendS return
      CHAR case
        "..ctype.char" appendS return
      S_CHAR case
        "..ctype.schar" appendS return
      U_CHAR case
        "..ctype.uchar" appendS return
      SHORT case
        "..ctype.short" appendS return
      U_SHORT case
        "..ctype.ushort" appendS return
      INT case
        "..ctype.int" appendS return
      U_INT case
        "..ctype.uint" appendS return
      LONG case
        "..ctype.long" appendS return
      U_LONG case
        "..ctype.ulong" appendS return
      LONGLONG case
        "..ctype.longlong" appendS return
      U_LONGLONG case
        "..ctype.ulonglong" appendS return
      SIZE case
        "..ctype.size" appendS return
      FLOAT case
        "..ctype.float" appendS return
      DOUBLE case
        "..ctype.double" appendS return
      STRUCT case
        "..ctype.struct" appendS return
      UNION case
        "..ctype.union" appendS return
    end
  end
  proc(
    stringBuilder : sb
    types.ArraySize : size
    LabelContext ptr : labelContext
  -> stringBuilder  ) =>: export: appendSliceSize
    sb
      size switch
        None case break
        Dynamic case " _" sb.appendS break
        Int case
          ' ' sb.appendC
          size .Int sb.appendI
          break
        GenericArg case
          ' ' sb.appendC
          size .GenericArg labelContext appendLabelName
          "[ " sb.appendS
          size .GenericArg i64 cast.s sb.appendI
          ":LabelId ]" sb.appendS
          break
      end
    return
  end
  proc(
    stringBuilder : sb
    Type : t
    TypeContext ptr : context
    i32 : depth
  -> stringBuilder ) =>: export: appendTypeRecursive
    context .labelContext =:: labelContext
    t switch
      undefined case
        sb "undefined" appendS return
      empty case
        sb "empty" appendS return
      primitiveType case
        sb t .primitiveType appendPrimitiveType return
      intLiteral case
        sb t .intLiteral appendIntLiteralType return
      cType case
        sb t .cType appendCType return
      arrayType pointer mutablePointer rawPointer mutableRawPointer case
        sb
          ## appendTypeRecursive
            t context types.getBaseType
            context
            depth
          appendTypeRecursive
          t context types.getArraySize labelContext appendSliceSize
          t .pointer ?? if
            " ptr" appendS
          else t .mutablePointer ?? _if
            " ptr.mut" appendS
          else t .arrayType ?? _if
            " array" appendS
          else t .rawPointer ?? _if
            " ptr.raw" appendS
          else
            " ptr.raw.mut" appendS
          end
        return
      struct union initializer case
        sb
          t .struct ?? if
            "struct( " appendS
          else t .union ?? _if
            "union( " appendS
          else
            "initializer( " appendS
          end
          depth 0 > if
            t depth context appendComposite
          else
            "... " appendS
          end
         ")" appendS
       return
      enum case
        sb
          "enum( " appendS
          t .enum types.EnumInfo ptr cast [] context .labelContext appendEnumElements
          ")" appendS
        return
      procedure case
        t .procedure types.ProcType ptr cast [] =:: procType
        sb
          procType .callingConvention switch
            CONCAT PTRCALL case "proc( "   appendS break
            CCALL  case "proc.c( " appendS break
          end
          0:iSize =:: mut: labelIndex
          procType .inTypes for
            context depth appendTypeRecursive
            labelIndex procType .labels .length u< if
              procType .labels labelIndex []  labelContext appendTypeElementLabel
              labelIndex 1:iSize + labelIndex=
            end
            ' ' sb.appendC
          end
          "-> " appendS
          procType .outTypes for
            context depth appendTypeRecursive
            labelIndex procType .labels .length u< if
              procType .labels labelIndex []  labelContext appendTypeElementLabel
              labelIndex 1:iSize + labelIndex=
            end
            ' ' sb.appendC
          end
          ")" appendS
        return
      namedType case
        sb
          "named[" appendS
          t .namedType i64 cast appendI
          "]( "    appendS
          ## appendNamedType
            t .namedType
            context
            depth
          appendNamedType
        " )" appendS
        return
      autoType case
        sb
          "auto["     appendS
          t .autoType appendI
          "]"         appendS
        return
      genericType case
        t .genericType =:: labelId
        sb
          labelId labelContext appendLabelName
          "[ " appendS
          labelId  i64 cast appendI
          ":LabelId ]"  appendS
        return
      generatedType case
        t .generatedType types.GeneratedTypeName ptr cast =:: genTypeName
        sb
          genTypeName .arguments [] .length for =:: i
            genTypeName [] .arguments i slice.get context sb.appendConstant
            ' ' sb.appendC
          end
          genTypeName [] .generator labelContext sb.appendLabelPath
          depth 0 > if
            " [ "     appendS
              context .generatedTypes
                genTypeName []
              map.get $ ? if .data
                .value $ ? if .data
                  context depth 1 - appendTypeRecursive
                else ..drop
                  '?' sb.appendC
                end
              else ..drop
                "??" sb.appendS
              end
            " ]"     appendS
          end
        return
      align case
        sb
          "..type.align" sb.appendS
          t .align sb.appendI
        return
      typeSet case
        sb
          "typeSet( " sb.appendS
          depth 0 >= if
            t context types.getTypeSetEntries for =:: e
              e switch
                typeId case
                  e .typeId context depth 1 - appendTypeRecursive
                  ' ' sb.appendC
                  break
                typeTrait case
                  ## TODO? print procedure name
                  e .typeTrait i64 cast sb.appendI
                  ":ProcId " sb.appendS
                  break
              end
            end
          else t context types.getTypeSetEntries .length 0:iSize != _if
            "..." sb.appendS
          end
          " )" sb.appendS
        return
    end
  end
  proc( stringBuilder Type TypeContext ptr -> stringBuilder ) =>: export: appendType
    0 appendTypeRecursive return ## XXX? change default value to 1
  end
end
