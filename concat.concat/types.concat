    0 while #dup arguments .length < do
      ## constantEquals
        candidateArgs #over array.get
        arguments #over:2 array.get
        labelContext
      constantEquals ! if
        false match =
        break
      end
      1 +
    end #drop
    match if
      #+index+# Type .generatedType new false return
    end
    1 +
  end #drop
  ## TODO check if combination of base and arguments already exists
  typeContext [] .generatedTypes
    #dup .length GeneratedId cast =:: newId
    ## GeneratedType
      generator
      arguments constContext constArray
      Type .undefined
    GeneratedType new list.append
  typeContext [] .generatedTypes =
  newId Type .generatedType new true return
end

