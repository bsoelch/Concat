    CompositeId : procIn
    CompositeId : procOut
    CompositeId : enum
    CompositeId : enumLabel
         ProcId : procedure
    NamedTypeId : namedType
    NamedTypeId : namedLabel
            i32 : autoType
            i32 : genericType
            i32 : templateType
) =:: public Type


