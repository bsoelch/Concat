            localMemory case
              valType .REFERENCE ?? if asm.OpType .MOVE else asm.OpType .LOAD end
                targetRegister asm.Operand .register
                varLoc .localMemory asm.Operand .localMemory
              context appendOp2
              break
            localAddr case
              asm.OpType .MOVE
                targetRegister asm.Operand .register
                varLoc .localAddr asm.Operand .localMemory
              context appendOp2
              break
            globalMemory case
              valType .REFERENCE ?? if asm.OpType .MOVE else asm.OpType .LOAD end
                targetRegister asm.Operand .register
                varLoc .globalMemory asm.Operand .globalMemory
              context appendOp2
              break
            globalAddr case
              asm.OpType .MOVE
                targetRegister asm.Operand .register
