#################
## Assembly
#################

##  [int-float:1bit][size:2bits][regId:5bits] (sizes: 0->i8,f16 1->i16,f32  2->i32,f64  3->i64,v128)
## int:   64bit: r0-r30, r31 -> rsp ; 32bit: w0-w30, w31 -> wsp ; 16bit: w0s-w30s, [w31s -> ?] ; 8bit: w0b-w30b, [w31b -> NO_REG]
## float: 128bit: v0-v31 ; 64bit: d0-d31 ; 32bit: s0-s31 ; 16bit: h0-h31
i8 =:: RegisterId
32 =:: MAX_DATA_REGISTERS ## 16 int + 16 float (extend allowed register-range?)
0x80:i32 =:: REG_FLAG_FLOAT ## mark float registers by setting high bit
0x60:i32 =:: REG_SIZE_MASK
5:i32 =:: REG_SIZE_SHIFT
0xE0:i32 =:: REG_TYPE_MASK
0x00:i32 =:: REG_TYPE_I8
0x20:i32 =:: REG_TYPE_I16
0x40:i32 =:: REG_TYPE_I32
0x60:i32 =:: REG_TYPE_I64
0x80:i32 =:: REG_TYPE_F16
0xA0:i32 =:: REG_TYPE_F32
0xC0:i32 =:: REG_TYPE_F64
0xE0:i32 =:: REG_TYPE_V128 ## TODO? is V128 type usefull
0x1f:i32 =:: REG_ID_MASK
REG_FLAG_FLOAT REG_ID_MASK | =:: BASE_REG_MASK
REG_ID_MASK =:: RSP_ID
REG_TYPE_I64 REG_ID_MASK | =:: RSP
REG_TYPE_I32 REG_ID_MASK | =:: WSP
REG_TYPE_I8 REG_ID_MASK | RegisterId =: NO_REG ## TODO? should register-id 0 be a valid register

proc( char8 ptr.raw : str iSize : len -> RegisterId ) =>: static: :reg64i
  str len ..builtIn.parse.i32 REG_ID_MASK & REG_TYPE_I64 | RegisterId cast
end
proc( char8 ptr.raw : str iSize : len -> RegisterId ) =>: static: :reg32i
  str len ..builtIn.parse.i32 REG_ID_MASK & REG_TYPE_I32 | RegisterId cast
end
proc( char8 ptr.raw : str iSize : len -> RegisterId ) =>: static: :reg128v
  str len ..builtIn.parse.i32 REG_ID_MASK & REG_TYPE_V128 | RegisterId cast
end
proc( char8 ptr.raw : str iSize : len -> RegisterId ) =>: static: :reg64f
  str len ..builtIn.parse.i32 REG_ID_MASK & REG_TYPE_F64 | RegisterId cast
end
proc( char8 ptr.raw : str iSize : len -> RegisterId ) =>: static: :reg32f
  str len ..builtIn.parse.i32 REG_ID_MASK & REG_TYPE_F32 | RegisterId cast
end

proc( RegisterId -> bool ) =>: isFloatReg
  i32 cast.u REG_FLAG_FLOAT & ?
end
proc( RegisterId -> i32 ) =>: getRegType
  i32 cast.u REG_TYPE_MASK &
end
## TODO? rename val-type version
#+proc( RegisterId i32 : regType -> RegisterId ) =>: setRegType
  i32 cast.u
    REG_TYPE_MASK & ~
    regType REG_TYPE_MASK & |
  RegisterId cast
end+#
proc( RegisterId -> i32 ) =>: getRegSize
  i32 cast.u =:: regData
  regData REG_SIZE_MASK & REG_SIZE_SHIFT >>>
    regData REG_FLAG_FLOAT & ? if 1 + end
  =:: sizeShift
  1 sizeShift <<
end
proc( RegisterId : a RegisterId : b -> bool ) =>: baseRegEq
  a i32 cast.u b i32 cast.u ^ BASE_REG_MASK & 0 ==
end
namespace: sb
  proc( stringBuilder RegisterId : reg -> stringBuilder ) =>: appendRegister
    reg i32 cast.u =:: regId
    regId BASE_REG_MASK & RSP_ID == if
      regId switch
        RSP case "rsp" sb.appendS return
        WSP case "wsp" sb.appendS return
        default "r??" sb.appendS return
      end
    end
    regId REG_TYPE_MASK & switch
      REG_TYPE_I8 case 'w' sb.appendC regId REG_ID_MASK & sb.appendI 'b' sb.appendC return
      REG_TYPE_I16 case 'w' sb.appendC regId REG_ID_MASK & sb.appendI 's' sb.appendC return
      REG_TYPE_I32 case 'w' sb.appendC regId REG_ID_MASK & sb.appendI return
      REG_TYPE_I64 case 'r' sb.appendC regId REG_ID_MASK & sb.appendI return
      REG_TYPE_F16 case 'h' sb.appendC regId REG_ID_MASK & sb.appendI return
      REG_TYPE_F32 case 's' sb.appendC regId REG_ID_MASK & sb.appendI return
      REG_TYPE_F64 case 'd' sb.appendC regId REG_ID_MASK & sb.appendI return
      REG_TYPE_V128 case 'v' sb.appendC regId REG_ID_MASK & sb.appendI return
    end
  end
end

union(
  _ : empty
  _ : forceClear ## marker for registers than should be cleared when merging (for caller saved registers)
  _ : preserveValue ## marker for registers that should be reserved when resetting state (for callee saved registers on return)
  LabelId : variable
  LabelId : variableReference
  LabelId : variableLow  ## low half of variable
  LabelId : variableHi   ## hi half of variable
  i32 : stackSlotReference ## index counted from bottom of stack
  i32 : stackSlot ## index counted from bottom of stack
  i32 : stackSlotHi   ## hi half of stack-slot
  i32 : stackSlotLow  ## low half of stack-slot
) =:: RegisterContent
namespace: RegisterContent
  proc( RegisterContent : a RegisterContent : b -> bool ) =>: eq
    a ..label b ..label != if
      false return
    end
    a switch
      empty forceClear preserveValue case true return
      variable case a .variable b .variable == return
      variableLow case a .variableLow b .variableLow == return
      variableHi case a .variableHi b .variableHi == return
      variableReference case a .variableReference b .variableReference == return
      stackSlotReference case a .stackSlotReference b .stackSlotReference == return
      stackSlot case a .stackSlot b .stackSlot == return
      stackSlotHi case a .stackSlotHi b .stackSlotHi == return
      stackSlotLow case a .stackSlotLow b .stackSlotLow == return
    end
  end
end
struct(
  RegisterContent : currentValue
  RegisterId : register ## store register in padding after value-union
  i32 : lastUsed
) =:: RegisterState

struct( RegisterId : low RegisterId : hi ) =:: RegisterPair
union(
  RegisterId : argRegister
  RegisterPair : argRegisters
  i32 : argStack
  i32 : argStackInt
  i32 : argStackFloat
  i32 : argStackComposite
) =:: ArgumentLocation

## TODO? 32-bit mode, ARM64 support
namespace: AMD64
   ## ensure int-data registers for continous range put rax:rdx to registers 0,1
   0:reg64i =:: RAX
   1:reg64i =:: RDX
   2:reg64i =:: RDI
   3:reg64i =:: RSI
   4:reg64i =:: RCX
   5:reg64i =:: R8
   6:reg64i =:: R9
   7:reg64i =:: R10
   8:reg64i =:: R11
   9:reg64i =:: RBX
  10:reg64i =:: R12
  11:reg64i =:: R13
  12:reg64i =:: RBP
  13:reg64i =:: R14
  14:reg64i =:: R15
  RAX i32 cast.u REG_ID_MASK & =:: RAX_ID
  RBX i32 cast.u REG_ID_MASK & =:: RBX_ID
  RCX i32 cast.u REG_ID_MASK & =:: RCX_ID
  RDX i32 cast.u REG_ID_MASK & =:: RDX_ID
  RDI i32 cast.u REG_ID_MASK & =:: RDI_ID
  RSI i32 cast.u REG_ID_MASK & =:: RSI_ID
  RBP i32 cast.u REG_ID_MASK & =:: RBP_ID
  R8  i32 cast.u REG_ID_MASK & =:: R8_ID
  R9  i32 cast.u REG_ID_MASK & =:: R9_ID
  R10 i32 cast.u REG_ID_MASK & =:: R10_ID
  R11 i32 cast.u REG_ID_MASK & =:: R11_ID
  R12 i32 cast.u REG_ID_MASK & =:: R12_ID
  R13 i32 cast.u REG_ID_MASK & =:: R13_ID
  R14 i32 cast.u REG_ID_MASK & =:: R14_ID
  R15 i32 cast.u REG_ID_MASK & =:: R15_ID

  { RDI RSI RDX RCX R8 R9 } =:: INT_ARG_REGISTERS
  { RAX RDX } =:: INT_RET_REGISTERS
  { 0:reg128v 1:reg128v 2:reg128v 3:reg128v 4:reg128v 5:reg128v 6:reg128v 7:reg128v } =:: FLOAT_ARG_REGISTERS
  { 0:reg128v 1:reg128v } =:: FLOAT_RET_REGISTERS
  { RAX RDX RDI RSI RCX R8 R9 R10 R11 RBX R12 R13 } =:: INT_DATA_REGISTERS
  RAX_ID =:: INT_REG_MIN
  R13_ID =:: INT_REG_MAX
  { R14 R15 } =:: INT_TMP_REGISTERS
  { 0:reg128v  1:reg128v  2:reg128v  3:reg128v  4:reg128v  5:reg128v  6:reg128v  7:reg128v
    8:reg128v  9:reg128v 10:reg128v 11:reg128v 12:reg128v 13:reg128v } =:: FLOAT_DATA_REGISTERS
  0 =:: FLOAT_REG_MIN
  13 =:: FLOAT_REG_MAX
  { 14:reg128v 15:reg128v } =:: FLOAT_TMP_REGISTERS
  INT_DATA_REGISTERS ..length i32 cast =:: INT_REG_COUNT
  FLOAT_DATA_REGISTERS ..length i32 cast =:: FLOAT_REG_COUNT
  ## TODO use heap allocated buffers for data registers (buffer for main registers, tmp-buffers for args/ret)
  proc(
    RegisterState MAX_DATA_REGISTERS ptr.mut : buffer
  -> i32 RegisterState slice.mut ) =>: initDataRegisters
    INT_REG_COUNT FLOAT_REG_COUNT + MAX_DATA_REGISTERS <= "MAX_DATA_REGISTERS >= regCount" assert
    INT_REG_COUNT for =:: i
      ## RegisterState
        RegisterContent .empty
        INT_DATA_REGISTERS i []
        -1
      RegisterState new buffer i =[]
    end
    FLOAT_REG_COUNT for =:: i
      ## RegisterState
        RegisterContent .empty
        FLOAT_DATA_REGISTERS i []
        -1
      RegisterState new buffer i INT_REG_COUNT + =[]
    end
    INT_REG_COUNT buffer FLOAT_REG_COUNT INT_REG_COUNT + slice.createMutable
  end
  proc( RegisterId : regId -> i32 ) =>: intDataRegIndex
    regId i32 cast REG_ID_MASK & INT_REG_MIN i32 cast - =:: regOffset
    regOffset INT_REG_MAX i32 cast.u u> if
      -1 return
    end
    regOffset return
  end
  proc( RegisterId : regId -> i32 ) =>: floatDataRegIndex
    regId i32 cast REG_ID_MASK & FLOAT_REG_MIN i32 cast - =:: regOffset
    regOffset FLOAT_REG_MAX i32 cast.u u> if
      -1 return
    end
    regOffset return
  end
  proc( RegisterId : regId -> i32 ) =>: dataRegIndex
    regId isFloatReg if
      regId floatDataRegIndex $ 0 >= if INT_DATA_REGISTERS ..length i32 cast + end return
    else
      regId intDataRegIndex return
    end
  end
  ## TODO make dependent on procedure signature & calling convention
  ## all argument registers use the largest possible size of the given register-id
  proc( i32 : index -> RegisterId ) =>: getIntArgumentRegister
    index 0 < or index INT_ARG_REGISTERS ..length i32 cast >= if
      NO_REG return
    end
    INT_ARG_REGISTERS index [] return
  end
  proc( i32 : index -> RegisterId ) =>: getFloatArgumentRegister
    index 0 < or index FLOAT_ARG_REGISTERS ..length i32 cast >= if
      NO_REG return
    end
    FLOAT_ARG_REGISTERS index [] return
  end
  proc( RegisterId : regId -> bool ) =>: isCalleeSaved
    regId i32 cast.u REG_TYPE_MASK ~ & REG_TYPE_I64 | RegisterId cast switch
      RBX RSP RBP R12 R13 R14 R15 case true return
    end
    false return
  end

  ## TODO! pass limits on register count as arguments
  proc(
    Type slice : valTypes
    RegisterId slice : intRegs
    RegisterId slice : floatRegs
    bool : seperateMemoryByType
    ArgumentLocation slice.mut : mut: argBuffer
    TypeContext ptr.mut : typeContext
  ->
    ArgumentLocation slice.mut
    i32 ## composite mem count
    i32 ## float mem count
    i32 ## int mem count
  ) =>: computeValueLocations
    0:iSize =:: mut: intArgCount
    0:iSize =:: mut: floatArgCount
    0 =:: mut: intMemCount ## ? use named return values
    0 =:: mut: floatMemCount
    0 =:: mut: compositeMemCount
    valTypes .length 1:iSize - while $ 0:iSize iSize.sge do =:: index
      valTypes index [] =:: val
      val typeContext toValType =:: valType
      valType switch
        EMPTY case continue
        I8 I16 I32 I64 PTR REFERENCE BITS32 BITS64 case ## int-like
          intArgCount intRegs .length u< if
            intRegs intArgCount [] ArgumentLocation .argRegister
            intArgCount 1:iSize + intArgCount=
          else seperateMemoryByType _if
            intMemCount ArgumentLocation .argStackInt
            intMemCount 1 + intMemCount=
          else
            intMemCount ArgumentLocation .argStack
            intMemCount 1 + intMemCount=
          end argBuffer index =[]
          break
        F32 F64 BITS32F BITS64F case ## float
          floatArgCount floatRegs .length u< if
            floatRegs floatArgCount [] ArgumentLocation .argRegister
            floatArgCount 1:iSize + floatArgCount=
          else seperateMemoryByType _if
            floatMemCount ArgumentLocation .argStackFloat
            floatMemCount 1 + floatMemCount=
          else ## use int for all stack values
            intMemCount ArgumentLocation .argStack
            intMemCount 1 + intMemCount=
          end argBuffer index =[]
          break
        ## ! handling of bit128 types differs depending on calling convention, especially how to handle mixed types and arguments that do no fit in registers
        BITS128 case
          intArgCount 1:iSize + intRegs .length u< if
            intRegs intArgCount [] intRegs intArgCount 1:iSize + [] RegisterPair new ArgumentLocation .argRegisters
            intArgCount 2:iSize + intArgCount=
          else seperateMemoryByType _if
            compositeMemCount ArgumentLocation .argStackComposite
            compositeMemCount 1 + compositeMemCount=
          else
            intMemCount ArgumentLocation .argStack
            intMemCount 2 + intMemCount= ## takes 2 stack-slots
          end argBuffer index =[]
          break
        BITS128IF BITS128FI case
          intArgCount intRegs .length u< and floatArgCount floatRegs .length u< if
            intRegs intArgCount [] floatRegs floatArgCount [] RegisterPair new ArgumentLocation .argRegisters
            floatArgCount 1:iSize + floatArgCount=
            intArgCount 1:iSize + intArgCount=
          else seperateMemoryByType _if
            compositeMemCount ArgumentLocation .argStackComposite
            compositeMemCount 1 + compositeMemCount=
          else
            intMemCount ArgumentLocation .argStack
            intMemCount 2 + intMemCount= ## takes 2 stack-slots
          end argBuffer index =[]
          break
        BITS128F case
          floatArgCount 1:iSize + floatRegs .length u< if
            floatRegs floatArgCount [] floatRegs floatArgCount 1:iSize + [] RegisterPair new ArgumentLocation .argRegisters
            floatArgCount 2:iSize + floatArgCount=
          else seperateMemoryByType _if
            compositeMemCount ArgumentLocation .argStackComposite
            compositeMemCount 1 + compositeMemCount=
          else
            intMemCount ArgumentLocation .argStack
            intMemCount 2 + intMemCount= ## takes 2 stack-slots
          end argBuffer index =[]
          break
      end
    finally index 1:iSize - end ..drop
    argBuffer compositeMemCount floatMemCount intMemCount return
  end
  proc(
    Type slice : retTypes
    ArgumentLocation list ptr.mut : argBuffer
    RegisterState MAX_DATA_REGISTERS ptr.mut : regBuffer
    TypeContext ptr.mut : typeContext
  -> ArgumentLocation slice.mut RegisterState slice.mut ) =>: computeReturnLocations
    ## TODO? ensure buffer is unused
    argBuffer [] retTypes .length list.setLength argBuffer =[]
    retTypes
      INT_RET_REGISTERS@ slice.wrap
      FLOAT_RET_REGISTERS@ slice.wrap
      true
      argBuffer [] list.asMutableSlice
    typeContext computeValueLocations ..drop.3 =:: retLocs
    regBuffer initDataRegisters =:: regData =:: intRegsOffset
    ## TODO is this the correct iteration order?
    retLocs .length 1:iSize - while $ 0:iSize iSize.sge do =:: index
      retLocs index [] =:: retLoc
      retTypes index [] typeContext toValType =:: retValType
      retLoc .argRegister ?? if
        retLoc .argRegister AMD64.dataRegIndex =:: regIndex
        index i32 cast retValType .REFERENCE ?? if
          RegisterContent .stackSlotReference else RegisterContent .stackSlot
        end regData regIndex @[] .currentValue=
        regData regIndex [] .register retValType setRegType regData regIndex @[] .register=
      else retLoc .argRegisters ?? _if
        retLoc .argRegisters .low AMD64.dataRegIndex =:: lowRegIndex
        retLoc .argRegisters .hi AMD64.dataRegIndex =:: hiRegIndex
        index i32 cast RegisterContent .stackSlotLow regData lowRegIndex @[] .currentValue=
        index i32 cast RegisterContent .stackSlotHi regData hiRegIndex @[] .currentValue=
        regData lowRegIndex [] .register retValType getLowValType setRegType regData lowRegIndex @[] .register=
        regData hiRegIndex [] .register retValType getHiValType setRegType regData hiRegIndex @[] .register=
      end
    finally index 1:iSize - end ..drop
    retLocs regData
  end
  proc(
    Type : procType
    ArgumentLocation list ptr.mut : argBuffer
    RegisterState MAX_DATA_REGISTERS ptr.mut : argRegBuffer
    RegisterState MAX_DATA_REGISTERS ptr.mut : retRegBuffer
    i32 : opIndex
    i32 : stackSize
    TypeContext ptr.mut : typeContext
  -> ArgumentLocation slice.mut RegisterState slice.mut RegisterState slice.mut ) =>: computeArgumentLocations
    procType typeContext types.getProcIn .data =:: inTypes
    procType typeContext types.getProcOut .data =:: outTypes
    ## TODO? ensure buffer is unused
    argBuffer [] outTypes .length list.setLength argBuffer =[]
    outTypes
      INT_RET_REGISTERS@ slice.wrap
      FLOAT_RET_REGISTERS@ slice.wrap
      true
      argBuffer [] list.asMutableSlice
    typeContext computeValueLocations
      =:: intMemCount
      =:: floatMemCount
      =:: compositeMemCount
    =:: retLocs
    stackSize inTypes .length i32 cast - =:: stackOffset
    stackOffset 0 >= "enough values for call" assert
    argBuffer [] retLocs .length inTypes .length + list.setLength argBuffer =[]
    intMemCount floatMemCount + compositeMemCount + 0 == "handling memory return is not supported" assert
    inTypes
      INT_ARG_REGISTERS@ slice.wrap
      FLOAT_ARG_REGISTERS@ slice.wrap
      false
      argBuffer [] list.asMutableSlice retLocs .length slice.tail
    typeContext computeValueLocations ..drop.3 =:: argLocs
    ## TODO handle locations for additional arguments (retMemPointers, retValueLocations)
    ## ? prioritize ret-locs over values when passing to registers, ? pass (first) retValueLocs in special registers
    argRegBuffer initDataRegisters =:: argRegData =:: intRegsOffset
    ## TODO is this the correct iteration order?
    argLocs .length 1:iSize - while $ 0:iSize iSize.sge do =:: index
      argLocs index [] =:: argLoc
      inTypes index [] typeContext toValType =:: argValType
      argLoc .argRegister ?? if ## TODO? check if reference
        argLoc .argRegister AMD64.dataRegIndex =:: regIndex
        stackOffset index i32 cast + argValType .REFERENCE ?? if
          RegisterContent .stackSlotReference else RegisterContent .stackSlot
        end argRegData regIndex @[] .currentValue=
        argRegData regIndex [] .register argValType setRegType argRegData regIndex @[] .register=
      else argLoc .argRegisters ?? _if
        argLoc .argRegisters .low AMD64.dataRegIndex =:: lowRegIndex
        argLoc .argRegisters .hi AMD64.dataRegIndex =:: hiRegIndex
        stackOffset index i32 cast + RegisterContent .stackSlotLow argRegData lowRegIndex @[] .currentValue=
        stackOffset index i32 cast + RegisterContent .stackSlotHi argRegData hiRegIndex @[] .currentValue=
        argRegData lowRegIndex [] .register argValType getLowValType setRegType argRegData lowRegIndex @[] .register=
        argRegData hiRegIndex [] .register argValType getHiValType setRegType argRegData hiRegIndex @[] .register=
      end
    finally index 1:iSize - end ..drop
    retRegBuffer initDataRegisters =:: retRegData intRegsOffset == "int regs offset is consistent" assert
    retLocs .length 1:iSize - while $ 0:iSize iSize.sge do =:: index
      retLocs index [] =:: retLoc
      outTypes index [] typeContext toValType =:: retValType
      retLoc .argRegister ?? if ## TODO? check if reference
        retLoc .argRegister AMD64.dataRegIndex =:: regIndex
        stackOffset index i32 cast + retValType .REFERENCE ?? if
          RegisterContent .stackSlotReference else RegisterContent .stackSlot
        end retRegData regIndex @[] .currentValue=
        retRegData regIndex [] .register retValType setRegType retRegData regIndex @[] .register=
        opIndex retRegData regIndex @[] .lastUsed=
        argRegData regIndex @[] .currentValue .empty ?? if
          ## reserve register slots for return values
          RegisterContent .forceClear argRegData regIndex @[] .currentValue=
        end
      else retLoc .argRegisters ?? _if
        retLoc .argRegisters .low AMD64.dataRegIndex =:: lowRegIndex
        retLoc .argRegisters .hi AMD64.dataRegIndex =:: hiRegIndex
        ## TODO? exact common code to procedure
        stackOffset index i32 cast + RegisterContent .stackSlotLow retRegData lowRegIndex @[] .currentValue=
        stackOffset index i32 cast + RegisterContent .stackSlotHi retRegData hiRegIndex @[] .currentValue=
        retRegData lowRegIndex [] .register retValType getLowValType setRegType retRegData lowRegIndex @[] .register=
        retRegData hiRegIndex [] .register retValType getHiValType setRegType retRegData hiRegIndex @[] .register=
        opIndex retRegData lowRegIndex @[] .lastUsed=
        opIndex retRegData hiRegIndex @[] .lastUsed=
        argRegData lowRegIndex @[] .currentValue .empty ?? if
          ## reserve register slots for return values
          RegisterContent .forceClear argRegData lowRegIndex @[] .currentValue=
        end
        argRegData hiRegIndex @[] .currentValue .empty ?? if
          ## reserve register slots for return values
          RegisterContent .forceClear argRegData hiRegIndex @[] .currentValue=
        end
      end
    finally index 1:iSize - end ..drop
    argRegData .length for =:: index
      argRegData index [] .register =:: regId
      retRegData index [] .register regId baseRegEq "argument and return registers have same order" assert
      regId isCalleeSaved if
        retRegData index @[] .currentValue .empty ?? "callee-saved register is not used for return value" assert
        argRegData index @[] .currentValue .empty ?? if ## allow arguments to be callee-saved registers
          RegisterContent .preserveValue argRegData index @[] .currentValue=
        end
        RegisterContent .preserveValue retRegData index @[] .currentValue=
      else argRegData index @[] .currentValue .empty ?? _if
        RegisterContent .forceClear argRegData index @[] .currentValue=
      end
    end
    argLocs retRegData argRegData
  end
end

## TODO? distinguish bits128f (2x f64) and bits128v (1x v128)
## TODO? seperate val-types for (uniform) packed values
## bits64 f32x2 i32x2 i16x4 i8x8 | bits32 i16x2 i8x4 | ? bits16 i8x2
## ? keep track of registers for elements of composite seperately
## -> need to ensure ids are correctly updated when register is modified
enum(
  EMPTY I8 I16 I32 I64 F32 F64 PTR REFERENCE
  BITS32 BITS32F BITS64 BITS64F BITS128 BITS128IF BITS128FI BITS128F
) =:: ValType
proc( Type : dataType TypeContext ptr.mut : typeContext -> ValType ) =>: toValType
  dataType switch
    namedType case
      dataType typeContext types.unwrapNamed typeContext toValType return
    generatedType case
      dataType typeContext types.getGeneratedType typeContext toValType return
    primitiveType case
      dataType .primitiveType switch
        TYPE case ValType .EMPTY return
        BOOL I8 CHAR8 case ValType .I8 return
        I16 CHAR16 case ValType .I16 return
        I32 CHAR32 case ValType .I32 return
        I64 case ValType .I64 return
        F32 case ValType .F32 return
        F64 case ValType .F64 return
      end
      break
    intLiteral case
      dataType .intLiteral types.intLiteralAsInt typeContext toValType return
    enum case
      dataType typeContext types.enumLabelInfo ..drop typeContext toValType return
      break
    cType case
      dataType .cType
        types.cTypeAsType
      typeContext toValType return
    pointer mutablePointer rawPointer mutableRawPointer case
      ValType .PTR return ## TODO? distinquish pointer and procedure pointer
    arrayType case
      dataType typeContext types.referenceOnly if
        ValType .REFERENCE return
      end
      dataType typeContext types.sizeOf .fixed =:: byteSize
      byteSize 16 <= "values larger than 128 bits are pased by reference" assert
      dataType typeContext types.getBaseType =:: eltType
      eltType typeContext toValType =:: eltVal
      eltVal switch
        EMPTY BITS128 BITS128IF BITS128FI BITS128F case
          eltVal return ## emtpy or already 128-bit
        F32 F64 BITS32F BITS64F case
          byteSize 8 > if
            ValType .BITS128F return
          else byteSize 4 > _if
            ValType .BITS64F return
          else
            ValType .BITS32F return
          end break
        I8 I16 I32 I64 PTR REFERENCE BITS32 BITS64 case
          byteSize 8 > if
            ValType .BITS128 return
          else byteSize 4 > _if
            ValType .BITS64 return
          else
            ValType .BITS32 return
          end break
      end
      break
    struct case
      dataType typeContext types.referenceOnly if
        ValType .REFERENCE return
      end
      dataType typeContext types.sizeOf .fixed =:: byteSize
      byteSize 16 <= "values larger than 128 bits are pased by reference" assert
      true =:: mut: floatOnlyLow
      true =:: mut: floatOnlyHi
      dataType typeContext types.compositeElts =:: eltTypes
      eltTypes .length i32 cast for =:: i
        eltTypes i [] =:: eltType
        eltType typeContext toValType isFloatValType ! if
          byteSize 8 < if
            false floatOnlyLow=
            break
          end
          dataType i typeContext types.tupleElementOffset .data =:: eltOffset
          eltOffset 8 < if
            false floatOnlyLow=
          end
          eltOffset 8 >= or eltOffset eltType typeContext types.sizeOf .fixed + 8 > if
            false floatOnlyHi=
            break
          end
        end
      end
      byteSize 8 > if
        floatOnlyLow if
          floatOnlyHi if
            ValType .BITS128F return
          else
            ValType .BITS128IF return
          end
        else
          floatOnlyHi if
            ValType .BITS128FI return
          else
            ValType .BITS128 return
          end
        end
      else byteSize 4 > _if
        floatOnlyLow if
          ValType .BITS64F return
        else
          ValType .BITS64 return
        end
      else
        floatOnlyLow if
          ValType .BITS32F return
        else
          ValType .BITS32 return
        end
      end
      break
    union case
      dataType typeContext types.referenceOnly if
        ValType .REFERENCE return
      end
      dataType typeContext types.sizeOf .fixed =:: size
      size 16 <= "values larger than 128 bits are pased by reference" assert
      ## TODO! treat small unions as values
      ValType .REFERENCE return
    undefined empty genericType autoType procedure
    align typeSet initializer case
      ValType .EMPTY return
  end
end
## split val-type in hi and low half
proc( ValType : valType -> ValType ) =>: getHiValType
  valType switch
    EMPTY I8 I16 I32 I64 F32 F64 PTR REFERENCE BITS32 BITS32F BITS64 BITS64F case ValType .EMPTY return
    BITS128 BITS128IF case ValType .I64 return
    BITS128FI BITS128F case ValType .F64 return
  end
end
proc( ValType : valType -> ValType ) =>: getLowValType
  valType switch
    EMPTY I8 I16 I32 I64 F32 F64 PTR REFERENCE BITS32 BITS32F BITS64 BITS64F case ValType .EMPTY return
    BITS128 BITS128FI case ValType .I64 return
    BITS128IF BITS128F case ValType .F64 return
  end
end
proc( ValType : valType -> bool ) =>: isIntValType
  valType switch
    I8 I16 I32 I64 PTR case true return
    EMPTY BITS128 BITS128FI F32 F64 BITS128IF BITS128F REFERENCE
      BITS32 BITS64 BITS32F BITS64F case false return
  end
end
proc( ValType : valType -> bool ) =>: isFloatValType
  valType switch
    F32 F64 BITS32F BITS64F BITS128F case true return
    EMPTY I8 I16 I32 I64 PTR BITS128 BITS128FI BITS128IF REFERENCE
      BITS32 BITS64 case false return
  end
end
proc( ValType : valType -> bool ) =>: isMultiRegValType
  valType switch
    BITS128 BITS128FI BITS128IF BITS128F case true return
    EMPTY I8 I16 I32 I64 PTR F32 F64 REFERENCE
     BITS32F BITS32 BITS64 BITS64F case false return
  end
end
proc( ValType : valType -> bool ) =>: isPrimitiveValType
  valType switch
    I8 I16 I32 I64 PTR F32 F64 case true return
    EMPTY BITS32F BITS32 BITS64 BITS64F BITS128 BITS128FI
      BITS128IF BITS128F REFERENCE case false return
  end
end
proc( ValType : valType -> i32 ) =>: valTypeBits
  valType switch
    EMPTY case 0 return
    I8 case 8 return
    I16 case 16 return
    I32 F32 BITS32 BITS32F case 32 return
    I64 F64 PTR REFERENCE BITS64 BITS64F case 64 return ## TODO? system dependent pointer size
    BITS128 BITS128F BITS128FI BITS128IF case 128 return
  end
end
proc( RegisterId : regId ValType : valType -> RegisterId ) =>: setRegType
  regId NO_REG == if regId return end
  regId i32 cast.u REG_TYPE_MASK ~ & =:: regData
  valType switch
    EMPTY case regId return
    I8 case REG_TYPE_I8 break
    I16 case REG_TYPE_I16 break
    I32 BITS32 case REG_TYPE_I32 break
    I64 PTR REFERENCE BITS64 case REG_TYPE_I64 break ## TODO? system dependent pointer size
    F32 BITS32F case REG_TYPE_F32 break
    F64 BITS64F case REG_TYPE_F64 break
    BITS128 BITS128F case REG_TYPE_V128 break
    BITS128FI BITS128IF case "mixed-data in single register" ..panic
  end regData | =:: newRegData
  newRegData REG_FLAG_FLOAT & regId i32 cast.u REG_FLAG_FLOAT & == "setRegType does not change between int and float register" assert
  newRegData RegisterId cast return
end
proc( i32 -> ValType ) =>: regTypeAsValType
  switch
    REG_TYPE_I8 case ValType .I8 return
    REG_TYPE_I16 case ValType .I16 return
    REG_TYPE_I32 case ValType .I32 return
    REG_TYPE_I64 case ValType .I64 return
    REG_TYPE_F16 case "f16 is not supported" ..panic
    REG_TYPE_F32 case ValType .F32 return
    REG_TYPE_F64 case ValType .F64 return
    REG_TYPE_V128 case ValType .BITS128F return ## TODO? should V128 be treated as float
    default "unexpected register-type" ..panic
  end
end
enum( SIGNED_MIN SIGNED_MAX UNSIGNED_MIN UNSIGNED_MAX ) =:: BoundType
proc( ValType : numType BoundType : bound -> i64 ) =>: getIntBound
  bound switch
    SIGNED_MIN case
      numType switch
        I8 case i8.MIN i64 cast.s return
        I16 case i16.MIN i64 cast.s return
        I32 case i32.MIN i64 cast.s return
        I64 case i64.MIN return
        default "invalid integer type" ..panic
      end
      break
    SIGNED_MAX case
      numType switch
        I8 case i8.MAX i64 cast.s return
        I16 case i16.MAX i64 cast.s return
        I32 case i32.MAX i64 cast.s return
        I64 case i64.MAX return
        default "invalid integer type" ..panic
      end
      break
    UNSIGNED_MIN case
      0 return
    UNSIGNED_MAX case
      numType switch
        I8 case i8.UMAX i64 cast.u return
        I16 case i16.UMAX i64 cast.u return
        I32 case i32.UMAX i64 cast.u return
        I64 case i64.UMAX return
        default "invalid integer type" ..panic
      end
      break
  end
end

namespace: sb
  proc( stringBuilder ValType -> stringBuilder ) =>: appendValType
    switch
      EMPTY case "empty":s break
      I8  case "i8":s  break
      I16 case "i16":s break
      I32 case "i32":s break
      I64 case "i64":s break
      F32 case "f32":s break
      F64 case "f64":s break
      PTR case "ptr":s break
      REFERENCE case "reference":s break
      BITS32    case "bits32":s    break
      BITS32F   case "bits32f":s   break
      BITS64    case "bits64":s    break
      BITS64F   case "bits64f":s   break
      BITS128   case "bits128":s   break
      BITS128F  case "bits128f":s  break
      BITS128IF case "bits128if":s break
      BITS128FI case "bits128fi":s break
    end sb.appendStr return
  end
end

namespace: asm
  enum(
    ## memory
    MOVE LOAD STORE COPY PUSH POP ## TODO? add alignment parameter to copy
    ## TODO? macro instuctions for loading/storing two registers at once
    OFFSET CLEAR
    INSERT EXTRACT
    ## controll-flow
    LABEL
    JMP JMPIF CALL RET
    ## embedded information
    DATA PADDING_BYTES
    ## conversions
    EXTS EXTU TRUNC
    EXTF TRUNCF ## TODO? merge to 2 conersion operations ( `cvts` and `cvtu` )
    I2F U2F F2I F2U
    ## arithmetic
    NEG NOT ADD SUB MUL DIV MOD UDIV UMOD
    AND OR XOR BOOLNOT BITNOT SHL ASHR LSHR
    ## comparision
    CMP ## compare type if given as parameter
    ## special arithmetic
    MIN MAX
    ADC SBB MULH MUL2 DIVMOD UDIVMOD
  ) =:: OpType
  ## TODO? version to check for NaN?
  enum( Z NZ EQ NE LT LE GE GT ULT ULE UGE UGT ) =:: CompareType
  struct( RegisterId : reg i32 : offset ) =:: RegAndOffset
  struct( LabelId : label i32 : offset ) =::  LabelAndOffset
  struct( i32 : const i32 : offset ) =:: ConstAndOffset
  i8 =:: BitMoveFlags
  namespace: BitMove
    0b11:BitMoveFlags =:: DST_TYPE_MASK
    0b00:BitMoveFlags =:: DST_TYPE_EMPTY
    0b01:BitMoveFlags =:: DST_TYPE_OVERWRITE
    0b10:BitMoveFlags =:: DST_TYPE_OVERWRITE_REG
    0b11111111:BitMoveFlags =:: DST_TYPE_EXTRACT
    ## destinations are counted from low to high
    0 =:: DST1_SHIFT
    2 =:: DST2_SHIFT
    proc( BitMoveFlags : flags i32 : shift -> BitMoveFlags ) =>: shr
      flags i32 cast.u shift >>> BitMoveFlags cast
    end
    proc( BitMoveFlags : flags i32 : shift -> BitMoveFlags ) =>: shl
      flags i32 cast.u shift << BitMoveFlags cast
    end
    proc( BitMoveFlags BitMoveFlags -> BitMoveFlags ) : alias: and i8.and
    proc( BitMoveFlags BitMoveFlags -> BitMoveFlags ) : alias: or i8.or
    proc( BitMoveFlags -> bool ) : alias: toBool i8.toBool
  end
  overload: merge: << BitMove.shl end
  overload: merge: >> BitMove.shr end
  overload: merge: & BitMove.and end
  overload: merge: | BitMove.or end
  overload: merge: ? BitMove.toBool end
  struct( ## offsets and size in bytes
    i8 : offset
    i8 : count
    BitMoveFlags : flags
  ) =:: BitMoveInfo
  ( LabelId : labelId i32 : implId ) =:: GlobalLabel
  union(
    _ : empty
    _ : unknown
    CompareType : cmpType
    RegisterId : register
    i64 : constInt ## TODO? replace 64-bit constants with index in constant list (keep size of operand small)
    f32 : constF32
    f64 : constF64
    i32 : constPtr ## label of k-th pointer constant
    ConstAndOffset : constPtrAndOffset ## label of k-th pointer constant
    i32 : stackData ## stack memory location for single value (64bit / slot)
    i32 : stackData128 ## stack memory location for 128bit value
    i32 : stackData128Hi  ## stack memory location for high half of 128bit value
    i32 : stackData128Low ## stack memory location for low  half of 128bit value
    ## TODO? shared storage for memory arguments, ? store number of previous arguments
    i32 : intArgument
    i32 : floatArgument
    ## XXX ? memory+s*offset1+offset2 , s=1,2,4,8
    RegAndOffset : regAndOffset
    LabelId : localMemory
    LabelAndOffset : localMemoryAndOffset
    LabelId : globalMemory
    i32 : localLabel
    GlobalLabel : globalLabel
    RegAndOffset : jumpTableElement ## memory at localLabel<offset> + 8*<register> (used for jump-tables)
    ValType : valType
    BitMoveInfo : bitMoveInfo
  ) =:: Operand
  proc( Operand : op -> ValType ) =>: guessValType
    op switch
      empty unknown cmpType bitMoveInfo case ValType .EMPTY return
      register case op .register getRegType regTypeAsValType return
      constF32 case ValType .F32 return
      constF64 case ValType .F64 return
      constInt case ValType .EMPTY return ## TODO? ensure int is not interpreted as float
      constPtr constPtrAndOffset stackData stackData128 stackData128Hi stackData128Low intArgument floatArgument
      localMemory localMemoryAndOffset globalMemory regAndOffset localLabel globalLabel jumpTableElement case ValType .PTR return
      valType case op .valType return
    end
  end
end
5 =:: MAX_ASM_OPERANDS
struct(
  asm.Operand MAX_ASM_OPERANDS array : operands ## are four operands enough  [jmpif  lt r1 r2 @targetLabel]
  ## TODO use register types to encode type of operation
  asm.OpType : opType
) =:: AsmOp
enum( Code Data ) =:: SectionType
enum( AssertFail Panic ) =:: RuntimeErrorType
union(
  _ : Unknown
  _ : Entry
  _ : ExitEntry
  AsmOp : Op
  FileId : DebugStartFile
  FileId : DebugUsesFile
  ProcedureImpl : StartProc
  SectionType : Section
  _ : LeaveProc
  _ : EndProc
  Operation : DebugStartOp
  RuntimeErrorType : Error
  i32 : Align
  string : DebugError
) =:: Atomic
-1 =:: NO_LABEL
proc(
  asm.OpType : opType
-> AsmOp ) =>: asmOp0
  ## AsmOp
    { asm.Operand .empty asm.Operand .empty asm.Operand .empty asm.Operand .empty asm.Operand .empty }
    opType
  AsmOp new return
end
proc(
  asm.OpType : opType
  asm.Operand : arg1
-> AsmOp ) =>: asmOp1
  asm.Operand MAX_ASM_OPERANDS array new =:: mut: args
  arg1 args@ 0 =[]
  ## AsmOp
    args
    opType
  AsmOp new return
end
proc(
  asm.OpType : opType
  asm.Operand : arg1 asm.Operand : arg2
-> AsmOp ) =>: asmOp2
  asm.Operand MAX_ASM_OPERANDS array new =:: mut: args
  arg1 args@ 0 =[]
  arg2 args@ 1 =[]
  ## AsmOp
    args
    opType
  AsmOp new return
end
proc(
  asm.OpType : opType
  asm.Operand : arg1 asm.Operand : arg2 asm.Operand : arg3
-> AsmOp ) =>: asmOp3
  asm.Operand MAX_ASM_OPERANDS array new =:: mut: args
  arg1 args@ 0 =[]
  arg2 args@ 1 =[]
  arg3 args@ 2 =[]
  ## AsmOp
    args
    opType
  AsmOp new return
end
proc(
  asm.OpType : opType
  asm.Operand : arg1 asm.Operand : arg2 asm.Operand : arg3 asm.Operand : arg4
-> AsmOp ) =>: asmOp4
  asm.Operand MAX_ASM_OPERANDS array new =:: mut: args
  arg1 args@ 0 =[]
  arg2 args@ 1 =[]
  arg3 args@ 2 =[]
  arg4 args@ 3 =[]
  ## AsmOp
    args
    opType
  AsmOp new return
end
proc(
  asm.OpType : opType
  asm.Operand : arg1 asm.Operand : arg2 asm.Operand : arg3 asm.Operand : arg4 asm.Operand : arg5
-> AsmOp ) =>: asmOp5
  asm.Operand MAX_ASM_OPERANDS array new =:: mut: args
  arg1 args@ 0 =[]
  arg2 args@ 1 =[]
  arg3 args@ 2 =[]
  arg4 args@ 3 =[]
  arg5 args@ 4 =[]
  ## AsmOp
    args
    opType
  AsmOp new return
end
namespace: AMD64
  proc( asm.OpType : opType -> RegisterId optional ) =>: fixedTargetInt
    opType switch
      DIV UDIV case RAX optional.wrap return
      MOD UMOD case RDX optional.wrap return
      DIVMOD UDIVMOD case RAX optional.wrap return
      MULH case RDX optional.wrap return
      MUL2 case RAX optional.wrap return
      default RegisterId optional.empty return
    end
  end
  proc(
    asm.OpType : opType
    i32 : stackSize
    RegisterState MAX_DATA_REGISTERS ptr.mut : buffer
  -> RegisterState slice.mut ) =>: fixedInputInt
    opType switch
      DIV UDIV MOD UMOD DIVMOD UDIVMOD MULH MUL2 case ## rdx empty, rax: left input
        buffer initDataRegisters =:: regs ..drop
          stackSize 2 - RegisterContent .stackSlot regs RAX intDataRegIndex @[] .currentValue=
          RegisterContent .forceClear regs RDX intDataRegIndex @[] .currentValue=
        regs return
      SHL ASHR LSHR case ## rhs in rcx
        buffer initDataRegisters =:: regs ..drop
          stackSize 1 - RegisterContent .stackSlot regs RCX intDataRegIndex @[] .currentValue=
        regs return
      default RegisterState slice.emptyMutable return
    end
  end
end

namespace: sb
  proc( stringBuilder : sb asm.OpType : opType -> stringBuilder ) =>: appendOpType
    sb
      opType switch
        CLEAR case "clear":s break
        MOVE case "move":s break
        LOAD case "load":s break
        STORE case "store":s break
        COPY case "copy":s break
        OFFSET case "offset":s break
        PUSH case "push":s break
        POP case "pop":s break
        INSERT case "insert":s break
        EXTRACT case "extract":s break
        LABEL case "label":s break
        DATA case "data":s break
        PADDING_BYTES case "pad_bytes":s break
        JMP case "jmp":s break
        JMPIF case "jmpif":s break
        CALL case "call":s break
        RET case "ret":s break
        EXTS case "exts":s break
        EXTU case "extu":s break
        TRUNC case "trunc":s break
        EXTF case "extf":s break
        TRUNCF case "truncf":s break
        I2F case "i2f":s break
        U2F case "u2f":s break
        F2I case "f2i":s break
        F2U case "f2u":s break
        NEG case "neg":s break
        NOT case "not":s break
        ADD case "add":s break
        SUB case "sub":s break
        MUL case "mul":s break
        DIV case "div":s break
        MOD case "mod":s break
        UDIV case "udiv":s break
        UMOD case "umod":s break
        AND case "and":s break
        OR case "or":s break
        XOR case "xor":s break
        BOOLNOT case "boolnot":s break
        BITNOT case "bitnot":s break
        SHL case "shl":s break
        ASHR case "ashr":s break
        LSHR case "lshr":s break
        CMP case "cmp":s break
        MIN case "min":s break
        MAX case "max":s break
        ADC case "adc":s break
        SBB case "sbb":s break
        MULH case "mulh":s break
        MUL2 case "mul2":s break
        DIVMOD case "divmod":s break
        UDIVMOD case "udivmod":s break
      end
    appendStr
  end
  proc( stringBuilder : sb asm.CompareType : cmpType -> stringBuilder ) =>: appendCmpType
    sb
      cmpType switch
        NZ case "nz":s break
        Z  case "z":s break
        EQ case "eq":s break
        NE case "ne":s break
        LT case "lt":s break
        LE case "le":s break
        GE case "ge":s break
        GT case "gt":s break
        ULT case "ult":s break
        ULE case "ule":s break
        UGE case "uge":s break
        UGT case "ugt":s break
      end
    appendStr
  end
  proc( stringBuilder : sb asm.Operand : val LabelContext ptr : labelContext -> stringBuilder ) =>: appendAsmOperand
    sb
      val switch
        empty case break
        unknown case "?" sb.appendS break
        cmpType case
          val .cmpType sb.appendCmpType
          break
        register case
          val .register sb.appendRegister
          break
        constInt case
          val .constInt sb.appendI
          break
        constF32 case
          val .constF32 sb.appendF32
          break
        constF64 case
          val .constF64 sb.appendF
          break
        constPtr case
          "@ptr" sb.appendS val .constPtr sb.appendI
          break
        constPtrAndOffset case
          "@ptr" sb.appendS val .constPtrAndOffset .const sb.appendI
          ':' sb.appendC val .constPtrAndOffset .offset i64 cast.u sb.appendI
          break
        stackData case
          "@stackMem" sb.appendS val .stackData sb.appendI
          break
        stackData128 case
          "@stack128Mem" sb.appendS val .stackData128 sb.appendI
          break
        stackData128Hi case
          "@stack128Mem" sb.appendS val .stackData128Hi sb.appendI 'h' sb.appendC
          break
        stackData128Low case
          "@stack128Mem" sb.appendS val .stackData128Low sb.appendI 'l' sb.appendC
          break
        intArgument case
          "@argI" sb.appendS val .intArgument sb.appendI
          break
        floatArgument case
          "@argF" sb.appendS val .floatArgument sb.appendI
          break
        localMemory case
          "@mem" sb.appendS val .localMemory i64 cast.u sb.appendI
          break
        localMemoryAndOffset case
          "@mem" sb.appendS val .localMemoryAndOffset .label i64 cast.u sb.appendI
          ':' sb.appendC val .localMemoryAndOffset .offset i64 cast.u sb.appendI
          break
        globalMemory case
          '$' sb.appendC val .globalMemory labelContext sb.appendLabelName
          break
        regAndOffset case
          '(' sb.appendC val .regAndOffset .reg sb.appendRegister
            '+' sb.appendC val .regAndOffset .offset sb.appendI ')' sb.appendC
          break
        localLabel case
          ".localLabel" sb.appendS val .localLabel i64 cast.u sb.appendI
          break
        globalLabel case
          '$' sb.appendC val .globalLabel .labelId labelContext sb.appendLabelName
          val .globalLabel .implId -1 != if
            ':' sb.appendC val .globalLabel .implId sb.appendI
          end
          break
        jumpTableElement case
          "[.localLabel" sb.appendS
            val .jumpTableElement .offset i64 cast.u sb.appendI
            "+8*" sb.appendS ## TODO? don't hardcode size
            val .jumpTableElement .reg sb.appendRegister
          ']' sb.appendC
          break
        valType case
          val .valType sb.appendValType
          break
        bitMoveInfo case
          val .bitMoveInfo .offset i32 cast.u sb.appendI ':' sb.appendC
          val .bitMoveInfo .count i32 cast.u sb.appendI
          val .bitMoveInfo .flags asm.BitMove.DST_TYPE_EXTRACT != if
            ':' sb.appendC
            ## TODO? better handling of flags (? is there a way to avoid printing type of 2nd des if there is only one dst)
            val .bitMoveInfo .flags asm.BitMove.DST1_SHIFT >> asm.BitMove.DST_TYPE_MASK & switch
              asm.BitMove.DST_TYPE_EMPTY case '0' sb.appendC break
              asm.BitMove.DST_TYPE_OVERWRITE case 'X' sb.appendC break
              asm.BitMove.DST_TYPE_OVERWRITE_REG case 'R' sb.appendC break
              default '?' sb.appendC break
            end
            val .bitMoveInfo .flags asm.BitMove.DST2_SHIFT >> asm.BitMove.DST_TYPE_MASK & switch
              asm.BitMove.DST_TYPE_EMPTY case '0' sb.appendC break
              asm.BitMove.DST_TYPE_OVERWRITE case 'X' sb.appendC break
              asm.BitMove.DST_TYPE_OVERWRITE_REG case 'R' sb.appendC break
              default '?' sb.appendC break
            end
          end
          break
      end
    return
  end
  proc( stringBuilder : sb AsmOp : op LabelContext ptr : labelContext -> stringBuilder ) =>: appendAsmOp
    sb
      op .opType sb.appendOpType
      op .operands ..length for =:: i
        op .operands i [] =:: operand
        operand .empty ?? if continue end
        ' ' sb.appendC operand labelContext sb.appendAsmOperand
      end
    return
  end
  proc( stringBuilder : sb Atomic : atom ProgramContext ptr : program -> stringBuilder ) =>: appendAtomic
    program .idContext .typeContext .labelContext =:: labelContext
    atom switch
      Unknown case sb "  ?\n" appendS return
      Op case sb "  " sb.appendS atom .Op labelContext appendAsmOp '\n' sb.appendC return
      DebugUsesFile case sb return
      DebugStartFile case
        sb "## " sb.appendS
          program [] .progFiles atom .DebugStartFile i64 cast [] .fileName sb.appendSb
        '\n' sb.appendC return
      StartProc case sb "  enter\n" sb.appendS return
      LeaveProc case sb "  leave\n" sb.appendS return
      Entry case sb "  _entry:\n" sb.appendS return
      ExitEntry case sb " _exit:\n" sb.appendS return
      Section case atom .Section switch
          Code case sb "section code\n" sb.appendS return
          Data case sb "section data\n" sb.appendS return
        end break
      EndProc case sb "\n" sb.appendS return
      DebugStartOp case
        sb
          "## " sb.appendS
          atom .DebugStartOp program sb.appendOp
        return
      DebugError case
        sb
          "!error " sb.appendS
          atom .DebugError sb.appendStr
          '\n' sb.appendC
        return
      Error case atom .Error switch
          AssertFail case sb "  assertFail\n" sb.appendS return
          Panic case sb "  panic\n" sb.appendS return
        end break
      Align case sb "align " sb.appendS atom .Align sb.appendI '\n' sb.appendC return
    end
  end
end
################
## Conversion to real assembly
################
namespace: AMD64
  ## TODO? compile to list of Atomics as intermediate step (expanding of macro-ops to "real" amd64 ops)
  ## TODO? seperate mode for binary output
  struct(
    ProgramContext ptr.mut : program
    LabelId i64 hashMap : variableOffsets
    f64 list : f64Consts
    f32 list : f32Consts
    ## TODO map for used variables
    stringBuilder : procedureTail
    i32 : tmpLabelCount ## number of temporary labels ! when using gas tmp-labels are not local to function
  ) =:: AsmCompilerContext
  "cct_":s =:: CONCAT_PREFIX
  "ccti_error_assert":s =:: CCT_ERROR_ASSERT
  "ccti_error_panic":s =:: CCT_ERROR_PANIC
  "ccti_f32_sign_mask":s =:: CCT_F32_SIGN_MASK
  "ccti_f64_sign_mask":s =:: CCT_F64_SIGN_MASK

  proc( stringBuilder asm.CompareType : cmpType -> stringBuilder ) =>: appendCmpFlags
    cmpType switch
      NZ case "nz":s break
      Z  case "z":s break
      EQ case "e":s break
      NE case "ne":s break
      LT case "l":s break
      LE case "le":s break
      GE case "ge":s break
      GT case "g":s break
      ULT case "b":s break
      ULE case "be":s break
      UGE case "ae":s break
      UGT case "a":s break
    end sb.appendStr
  end
  proc( stringBuilder asm.OpType : opType -> stringBuilder ) =>: appendOpNameInt
    opType switch
      MOVE case "mov":s break
      PUSH case "push":s break
      POP case "pop":s break
      JMP case "jmp":s break
      JMPIF case "j":s break
      CALL case "call":s break
      RET case "ret":s break
      EXTS case "movsx":s break
      EXTU case "movzx":s break
      EXTF case "cvtss2sd":s break
      TRUNCF case "cvtsd2ss":s break
      NEG case "neg":s break
      ADD case "add":s break
      SUB case "sub":s break
      MUL MULH MUL2 case "imul":s break ## TODO? opCodes for unsigned mul2/mulh
      DIV case "idiv":s break
      MOD case "idiv":s break
      UDIV case "div":s break
      UMOD case "div":s break
      AND case "and":s break
      OR case "or":s break
      XOR case "xor":s break
      BITNOT case "not":s break
      SHL case "shl":s break
      ASHR case "sar":s break
      LSHR case "shr":s break
      CMP case "cmp":s break
      ADC case "adc":s break
      SBB case "sbb":s break
      DIVMOD case "idiv":s break
      UDIVMOD case "div":s break
      default "unspoorted operation for interger arithmetic" ..panic
    end sb.appendStr
  end
  ## requires avx
  proc( stringBuilder ValType : valType asm.OpType : opType -> stringBuilder ) =>: appendOpNameFloat
    opType switch
      MOVE case "movs":s break
      EXTF case "cvtss2s":s break
      TRUNCF case "cvtsd2s":s break
      ## neg is handled using xorps / xorpd
      ADD case "vadds":s break
      SUB case "vsubs":s break
      MUL case "vmuls":s break
      DIV case "vdivs":s break ## TODO? is there a float mod instruction
      CMP case "ucomis":s break
      MIN case "vmins":s break
      MAX case "vmaxs":s break
      default "unsupported operation for float arithmetic" ..panic
    end sb.appendStr
    valType .F32 ?? if 's' sb.appendC else 'd' sb.appendC end
  end

  proc( stringBuilder string : baseName i32 : regSize -> stringBuilder ) =>: appendNamedIntRegister
    regSize 16 > if
      regSize 32 == if 'e' else 'r' end sb.appendC
    end
    baseName sb.appendStr
    regSize 8 == if
      'l' sb.appendC
    else baseName .length 1:iSize == _if
      'x' sb.appendC
    end
  end
  proc( stringBuilder string : baseName i32 : regSize -> stringBuilder ) =>: appendNumberedIntRegister
    baseName sb.appendStr
    regSize 64 < if
      regSize 32 == if
        'd' sb.appendC
      else regSize 16 == _if
        'w' sb.appendC
      else
        'b' sb.appendC
      end
    end
  end
  proc( stringBuilder RegisterId : regId -> stringBuilder ) =>: appendRegister
    regId i32 cast.u REG_TYPE_MASK & switch
      REG_TYPE_F16 REG_TYPE_F32 REG_TYPE_F64 REG_TYPE_V128 case
        "xmm" sb.appendS regId i32 cast.u REG_ID_MASK & sb.appendI return
      REG_TYPE_I8  case 8 break
      REG_TYPE_I16 case 16 break
      REG_TYPE_I32 case 32 break
      REG_TYPE_I64 case 64 break
      default "invalid register type" ..panic
    end =:: regSize
    regId i32 cast.u REG_ID_MASK & switch
      RAX_ID case "a":s regSize appendNamedIntRegister return
      RBX_ID case "b":s regSize appendNamedIntRegister return
      RCX_ID case "c":s regSize appendNamedIntRegister return
      RDX_ID case "d":s regSize appendNamedIntRegister return
      RSP_ID case "sp":s regSize appendNamedIntRegister return
      RBP_ID case "bp":s regSize appendNamedIntRegister return
      RDI_ID case "di":s regSize appendNamedIntRegister return
      RSI_ID case "si":s regSize appendNamedIntRegister return
      R8_ID case "r8":s regSize appendNumberedIntRegister return
      R9_ID case "r9":s regSize appendNumberedIntRegister return
      R10_ID case "r10":s regSize appendNumberedIntRegister return
      R11_ID case "r11":s regSize appendNumberedIntRegister return
      R12_ID case "r12":s regSize appendNumberedIntRegister return
      R13_ID case "r13":s regSize appendNumberedIntRegister return
      R14_ID case "r14":s regSize appendNumberedIntRegister return
      R15_ID case "r15":s regSize appendNumberedIntRegister return
      default ..unreachable
    end
  end
  proc( stringBuilder asm.GlobalLabel : globalLabel LabelContext ptr.mut : labelContext -> stringBuilder ) =>: appendGlobalName
    globalLabel .labelId =:: label
    label labelContext id.labelFlags id.FLAG_EXTERN & ? if
      ## use unmodified name for extern values
      label labelContext sb.appendLabelName
      return
    end
    CONCAT_PREFIX sb.appendStr
    label labelContext id.labelFlags id.FLAG_EXPORT & ? ! if
      label labelContext id.getLabelFile i64 cast sb.appendI
      "_F" sb.appendS
    end
    label labelContext sb.appendAsciifiedLabelPath
    globalLabel .implId 0 >= if
      ## TODO? generate signature from static arguments instead of using implementationId
      "_I" sb.appendS
      globalLabel .implId sb.appendI
    end
  end
  proc( stringBuilder asm.Operand : val ValType : valType AsmCompilerContext ptr.mut : context -> stringBuilder ) =>: appendOperand
    context [] .program =:: program
    program .idContext .typeContext =:: typeContext
    typeContext .labelContext =:: labelContext
    val switch
      empty case return
      unknown cmpType bitMoveInfo case break
      register case val .register valType setRegType appendRegister return
      constInt case val .constInt sb.appendI return
      constPtr case "ccti_ptr" sb.appendS val .constPtr sb.appendI return
      constPtrAndOffset case
        "(ccti_ptr" sb.appendS val .constPtrAndOffset .const sb.appendI
        "+" sb.appendS val .constPtrAndOffset .offset sb.appendI ')' sb.appendC
        return
      constF32 case
        valType .PTR ?? if
          "0x" sb.appendS val .constF32 f32.bits sb.appendUX
          " /*" sb.appendS val .constF32 sb.appendF32 "*/" sb.appendS
        else
          "f32const" sb.appendS context .f32Consts [] .length sb.appendI
          context [] .f32Consts
            val .constF32 list.append
          context .f32Consts=
        end
        return
      constF64 case
        valType .PTR ?? if
          "0x" sb.appendS val .constF64 f64.bits sb.appendUX
          " /*" sb.appendS val .constF64 sb.appendF "*/" sb.appendS
        else
          "f64const" sb.appendS context .f64Consts [] .length sb.appendI
          context [] .f64Consts
            val .constF64 list.append
          context .f64Consts=
        end
        return
      stackData case break
      stackData128 case break
      stackData128Hi case break
      stackData128Low case break
      intArgument case break
      floatArgument case break
      localMemory localMemoryAndOffset case
        valType switch
          EMPTY case break
          I8 case "BYTE PTR " sb.appendS break
          I16 case "WORD PTR " sb.appendS break
          I32 F32 BITS32 BITS32F case "DWORD PTR " sb.appendS break
          I64 F64 PTR REFERENCE BITS64 BITS64F case "QWORD PTR " sb.appendS break
          BITS128F case "XMMWORD PTR " sb.appendS break
          BITS128 BITS128IF BITS128FI case break ## value is not stored in single register
        end
        "[rbp-" sb.appendS context .variableOffsets
          val .localMemory ?? if val .localMemory else val .localMemoryAndOffset .label end
        map.get .data
          ## rbp-baseOffset+subOffset -> rbp-(baseOffset-subOffset)
          val .localMemoryAndOffset ?? if val .localMemoryAndOffset .offset i64 cast.u - end
        sb.appendI ']' sb.appendC
        return
      globalMemory case break
      regAndOffset case
        '[' sb.appendC val .regAndOffset .reg appendRegister
          '+' sb.appendC val .regAndOffset .offset sb.appendI
        ']' sb.appendC return
      localLabel case ".L" sb.appendS val .localLabel i64 cast.u sb.appendI return
      globalLabel case val .globalLabel labelContext appendGlobalName return
      jumpTableElement case "[.L" sb.appendS val .jumpTableElement .offset i64 cast.u sb.appendI
            "+8*" sb.appendS val .jumpTableElement .reg appendRegister ## TODO? don't hardcode size
          ']' sb.appendC return
      valType case "type operands are not supported" ..panic
    end
    "??" sb.appendS
    return
  end
  proc( asm.Operand -> bool ) =>: isAddress
    switch
      register constInt constF32 constF64 case false return
      constPtr constPtrAndOffset stackData stackData128 stackData128Hi stackData128Low intArgument floatArgument
      localMemory localMemoryAndOffset globalMemory regAndOffset localLabel globalLabel jumpTableElement case true return
      empty unknown cmpType valType bitMoveInfo case "unsupported operand for value" ..panic
    end
  end

  proc( stringBuilder RegisterId : mut: reg -> stringBuilder ) =>: clearRegister
    reg isFloatReg if
      reg i32 cast.u REG_TYPE_MASK ~ & REG_TYPE_V128 | RegisterId cast reg=
      "  xorps " sb.appendS reg appendRegister  ", " sb.appendS reg appendRegister '\n' sb.appendC
    else
      reg i32 cast.u REG_TYPE_MASK ~ & REG_TYPE_I32 | RegisterId cast reg=
      "  xor " sb.appendS reg appendRegister  ", " sb.appendS reg appendRegister '\n' sb.appendC
    end
  end

  proc( asm.Operand slice : operands -> ValType ) =>: commonValType
    ValType .EMPTY =:: mut: commonType
    operands for =:: op
      op asm.guessValType =:: val
      commonType .EMPTY ?? if
        val commonType=
      else val .EMPTY ?? ! and commonType val != _if
        ValType .EMPTY return ## TODO? warning/error if no common type found
      end
    end
    commonType return
  end
  ## extend i8 and i16 to i32
  proc( ValType -> ValType ) =>: extendSmallInts
    $ .I8 ?? or $ .I16 ?? if ..drop ValType .I32 return end
  end

  proc( stringBuilder
    RegisterId : dst
    asm.BitMoveFlags : moveType
    RegisterId : srcLow
    RegisterId : srcHi
    i32 : srcOffset
    i32 : byteIndex
    i32 : copiedBytes
    AsmCompilerContext ptr.mut : context
  -> stringBuilder ) =>: registerInsert
    dst getRegSize =:: dstBytes
    dst isFloatReg if "bit-move to float registers is not implemented" ..panic end
    srcOffset 0 >= "source offset is non-negative" assert
    srcOffset 0 == and copiedBytes dstBytes == if ## copied bytes completely fill target -> can use move directly
      ## TODO! support move simd <-> int reg
      "  mov " sb.appendS
        dst appendRegister ", " sb.appendS
      srcLow dst getRegType regTypeAsValType setRegType appendRegister '\n' sb.appendC
      return
    end
    moveType asm.BitMove.DST_TYPE_OVERWRITE_REG & ? if
      dst
    else
      INT_TMP_REGISTERS 0 []
    end =:: mut: dataReg
    ## TODO! support move simd <-> int reg
    srcOffset 0 == if
      copiedBytes 4 > if ValType .I64 else ValType .I32 end =:: targetValType
      dataReg targetValType setRegType dataReg=
      srcHi NO_REG == "copied value fits into one register" assert
      copiedBytes 2 <= if "  movzx " sb.appendS else "  mov " sb.appendS end
        dataReg appendRegister ", " sb.appendS
      srcLow targetValType setRegType appendRegister '\n' sb.appendC
      copiedBytes copiedBytes -_ & copiedBytes ==
    else srcHi NO_REG == _if
      copiedBytes srcOffset + =:: movedBytes
      movedBytes 4 > if ValType .I64 else ValType .I32 end =:: shiftedValType
      dataReg shiftedValType setRegType dataReg=
      movedBytes 2 <= if "  movzx " sb.appendS else "  mov " sb.appendS end
        dataReg appendRegister ", " sb.appendS
      srcLow shiftedValType setRegType appendRegister '\n' sb.appendC
      "  shr " sb.appendS dataReg appendRegister ", " sb.appendS
        srcOffset 8 * sb.appendI
      '\n' sb.appendC
      movedBytes movedBytes -_ & movedBytes ==
    else
      srcLow getRegSize =:: lowSize
      srcOffset lowSize < and srcOffset copiedBytes + lowSize > end "multi-reg source uses both regs" assert
      srcHi dst baseRegEq if ## destination overlaps with high register
        dataReg dst == "dst-reg = srcReg -> dataReg = dst-reg" assert
        copiedBytes 4 > if ValType .I64 else ValType .I32 end =:: targetValType
        dataReg targetValType setRegType dataReg=
        "  shld " sb.appendS dataReg appendRegister ", " sb.appendS
          srcLow targetValType setRegType appendRegister ", " sb.appendS
          lowSize srcOffset - 8 * sb.appendI
        '\n' sb.appendC
      else
        dataReg lowSize 4 > if ValType .I64 else ValType .I32 end setRegType dataReg=
        "  mov " sb.appendS dataReg appendRegister ", " sb.appendS srcLow appendRegister '\n' sb.appendC
        " shrd " sb.appendS dataReg appendRegister ", " sb.appendS
          srcHi appendRegister ", " sb.appendS
          srcOffset 8 * sb.appendI
        '\n' sb.appendC
      end
      copiedBytes dstBytes <
    end =:: hiBytesEmpty
    ## if offset: 1. move src+offset to tmp 2. shift tmp to remove offset
    dataReg dstBytes 4 > if ValType .I64 else ValType .I32 end setRegType dataReg=
    hiBytesEmpty or byteIndex copiedBytes + dstBytes >= if
      byteIndex 0 > if
        "  shl " sb.appendS dataReg appendRegister ", " sb.appendS
          byteIndex 8 * sb.appendI '\n' sb.appendC
      end
    else copiedBytes 4 <= _if
      copiedBytes 3 == if
        ## ensure high bytes are empty
        "  and " sb.appendS dataReg appendRegister ", 0x" sb.appendS
          1:i64 copiedBytes 8 * << 1 - sb.appendUX
        '\n' sb.appendC
      else ## 1, 2, 4
        ## ensure high bytes are empty
        copiedBytes 4 == if "  mov " sb.appendS else "  movzx " sb.appendS end
          dataReg ValType .I32 setRegType appendRegister ", " sb.appendS
          dataReg copiedBytes switch
            1 case ValType .I8 break
            2 case ValType .I16 break
            4 case ValType .I32 break
            default "unexpected number of copied bytes" ..panic
          end setRegType appendRegister
        '\n' sb.appendC
      end
      byteIndex 0 > if
        "  shl " sb.appendS dataReg appendRegister ", " sb.appendS
          byteIndex 8 * sb.appendI '\n' sb.appendC
      end
    else
      ## shift high bytes away
      "  shl " sb.appendS dataReg appendRegister ", " sb.appendS
        dstBytes copiedBytes - 8 * sb.appendI '\n' sb.appendC
      dstBytes copiedBytes - byteIndex - =:: rightShift
      rightShift 0 > "rightShift==0 handled by first if branch" assert
      ## shift to correct position
      "  shr " sb.appendS dataReg appendRegister ", " sb.appendS
        rightShift 8 * sb.appendI '\n' sb.appendC
    end
    moveType asm.BitMove.DST_TYPE_OVERWRITE_REG & ? if
      return
    end
    moveType asm.BitMove.DST_TYPE_OVERWRITE & ? if
      ## TODO? handle case where target reg is not 64-bit int reg
      copiedBytes byteIndex + 8 == if ## cleared registers are at top of reg
        byteIndex 4 > if
          "  shl " sb.appendS dst appendRegister ", " sb.appendS copiedBytes 8 * sb.appendI " /*clear high bits*/\n" sb.appendS
          "  shr " sb.appendS dst appendRegister ", " sb.appendS copiedBytes 8 * sb.appendI '\n' sb.appendC
        else byteIndex 4 == _if
          "  mov " sb.appendS dst ValType .I32 setRegType appendRegister ", " sb.appendS
            dst ValType .I32 setRegType appendRegister '\n' sb.appendC
        else
          "  and " sb.appendS dst appendRegister ",  0x" sb.appendS 1 byteIndex 8 * << 1 - sb.appendUX '\n' sb.appendC
        end
      else byteIndex 0 == _if
        "  shr " sb.appendS dst appendRegister ", " sb.appendS copiedBytes 8 * sb.appendI " /*clear low bits*/\n" sb.appendS
        "  shl " sb.appendS dst appendRegister ", " sb.appendS copiedBytes 8 * sb.appendI '\n' sb.appendC
      else
        "  mov " sb.appendS
          INT_TMP_REGISTERS 1 [] appendRegister
          ", 0x" sb.appendS  1:i64 copiedBytes 8 * << 1 - byteIndex 8 * << ~ sb.appendUX
        '\n' sb.appendC
        "  and " sb.appendS dst appendRegister
          INT_TMP_REGISTERS 1 [] appendRegister
        '\n' sb.appendC
      end
    end
    "  or " sb.appendS dst appendRegister ", " sb.appendS dataReg appendRegister '\n' sb.appendC
  end

  ## TODO cleanup code: create proc for appending instruction given op-type and operands
  proc( stringBuilder AsmOp : op AsmCompilerContext ptr.mut : context -> stringBuilder ) =>: compileAsmOp
    context [] .program =:: program
    program .idContext .typeContext =:: typeContext
    typeContext .labelContext =:: labelContext
    op .opType switch
      LABEL case op .operands 0 [] ValType .EMPTY context appendOperand ":\n" sb.appendS return
      MOVE LOAD STORE case
        ## TODO? automatically extend small values to break dependency chains
        ## TODO? special handling for moving 0 to register
        op .operands 0 [] asm.guessValType =:: dstType
        op .operands 1 [] asm.guessValType =:: srcType
        op .opType .MOVE ?? if
          op@ .operands 2 slice.create commonValType
        else op .opType .LOAD ?? _if
          dstType
        else
          srcType
        end =:: opValType
        ## TODO extend i8, i16 value to i32 (to break dependency)
        op .opType .MOVE ?? and op .operands 1 [] isAddress if
          "  lea " sb.appendS
        else
          opValType switch
            EMPTY case
              srcType .F32 ?? and dstType .I32 ?? if
                "  movd " sb.appendS break
              else srcType .I32 ?? and dstType .F32 ?? _if
                "  movd " sb.appendS break
              else srcType .I64 ?? and dstType .F64 ?? _if
                "  movq " sb.appendS break
              else srcType .F64 ?? and dstType .I64 ?? _if
                "  movq " sb.appendS break
              else srcType .I64 ?? and dstType .PTR ?? _if
                "  mov " sb.appendS break
              else srcType .PTR ?? and dstType .I64 ?? _if
                "  mov " sb.appendS break
              end
              "!error unknown/incompatiable value-type for move\n" sb.appendS break
            I8 I16 case
              op .opType .STORE ?? or op .operands 0 [] .register ?? ! or op .operands 1 [] .constInt ?? if
                "  mov " sb.appendS
              else
                "  movzx " sb.appendS
              end break
            I32 I64 PTR BITS32 BITS64 case "  mov " sb.appendS break
            F32 BITS32F case "  movss " sb.appendS break
            F64 BITS64F case "  movsd " sb.appendS break
            BITS128F case "  movups " sb.appendS break ## packed floats
            BITS128 BITS128IF BITS128FI case "  movdqu " sb.appendS break ## packed ints
            default
              "!error unsupported value types for move\n" sb.appendS break
          end
        end
           ## TODO? general method for getting operand as address
          op .opType .STORE ?? and op .operands 0 [] isAddress ! if
            '[' sb.appendC op .operands 0 [] ValType .PTR context appendOperand "], " sb.appendS
          else
            op .operands 0 []
              opValType
              $1 .register ?? and op .opType .STORE ?? ! if extendSmallInts end
            context appendOperand ", " sb.appendS
          end
          op .opType .LOAD ?? and op .operands 1 [] isAddress ! if
            '[' sb.appendC op .operands 1 [] ValType .PTR  context appendOperand "]\n" sb.appendS
          else
            op .operands 1 [] opValType context appendOperand '\n' sb.appendC
          end
        return
      CLEAR case ## TODO? 3/4 parameter versions: clear reg, offset, count ; clear reg1, reg2, offset, count
        op .operands 0 [] =:: dst
        dst .register ?? if
          dst .register clearRegister return
        end
        "clearing non-register values is not supported" ..panic
        break
      ## extract/insert bits from/to register or register-pair
      ## there are 3 forms each of insert/extract
      ## insert dst, src, [index:count:flags]               / extract dst, src, [index:count]
      ## insert dst1, dst2, src, [index:count:flags]        / extract dst, src1, src2, [index:count]
      ## insert dst1, dst2, src1, src2, [index:count:flags] / extract dst1, dst2, src1, src2, [index:count]
      INSERT EXTRACT case
        NO_REG =:: mut: srcLow
        NO_REG =:: mut: srcHi
        ## TODO? don't crash on invalid input types
        op .operands 0 [] .register =:: mut: dstLow
        NO_REG =:: mut: dstHi
        op .operands 2 [] .bitMoveInfo ?? if ## 2-operand form
          op .operands 1 [] .register srcLow=
          op .operands 2 [] .bitMoveInfo
        else op .operands 3 [] .bitMoveInfo ?? _if ## 3-operand form
          op .opType .INSERT ?? if
            op .operands 1 [] .register dstHi=
            op .operands 2 [] .register srcLow=
          else
            op .operands 1 [] .register srcLow=
            op .operands 2 [] .register srcHi=
          end
          op .operands 3 [] .bitMoveInfo
        else op .operands 4 [] .bitMoveInfo ?? _if ## 4-operand form
          op .operands 1 [] .register dstHi=
          op .operands 2 [] .register srcLow=
          op .operands 3 [] .register srcLow=
          op .operands 4 [] .bitMoveInfo
        else
          "!error: expected at least one operand of insert/extract to be bitMoveInfo\n" sb.appendS
          return
        end =:: bitMoveInfo
        op .opType .INSERT ?? if
          bitMoveInfo .offset i32 cast.u
          0
        else
          0
          bitMoveInfo .offset i32 cast.u
        end =:: srcOffset =:: byteIndex
        bitMoveInfo .count i32 cast.u =:: byteCount
        dstLow getRegSize =:: lowBytes
        lowBytes dstHi getRegSize + =:: totalBytes
        byteCount 0 > byteCount totalBytes <= & "count inside allowed range" assert
        byteIndex 0 >= byteIndex byteCount + totalBytes <= & "index inside allowed range" assert
        srcLow isFloatReg and dstLow isFloatReg if ## float/vector -> float/vector
          bitMoveInfo .flags asm.BitMove.DST1_SHIFT >> asm.BitMove.DST_TYPE_MASK & =:: dstType
          srcHi NO_REG == and dstHi NO_REG == end "insert/extract: multi-register float values are not supported" assert
          srcOffset byteIndex | byteCount | 0x7 & switch ## seperate value by minimum alignement
            0 case ## 8-byte aligned
              byteIndex 0 == and srcOffset 0 == and byteCount 8 == and lowBytes 8 == or
                  dstType asm.BitMove.DST_TYPE_OVERWRITE_REG == if ## overwrite dst
                "  movsd " sb.appendS
                  dstLow appendRegister ", " sb.appendS
                srcLow appendRegister '\n' sb.appendC
                return
              end
              ## f64 values: use MOVHLPS to extract high part of 128-bit register
              op .opType .INSERT ?? if
                "unimplemented: insert f64" ..panic
              else
                "unimplemented: extract f64" ..panic
              end
              break
            4 case ## 4-byte aligned
              byteIndex 0 == and srcOffset 0 == and byteCount lowBytes == or
                  dstType asm.BitMove.DST_TYPE_OVERWRITE_REG == and byteCount 4 == or byteCount 8 == if ## overwrite dst
                byteCount 4 == if "  movss " sb.appendS else "  movsd " sb.appendS end
                  dstLow appendRegister ", " sb.appendS
                srcLow appendRegister '\n' sb.appendC
                return
              end
              ## extract a single f32: vshufps, reorganize f32: multiple vshufps ops
              op .opType .INSERT ?? if
                byteCount 4 == "unimplemented: inserting multiple f32 values" assert
                FLOAT_TMP_REGISTERS 0 [] =:: tmpReg
                ## TODO! check if seclection bits are correct
                "  vshufps " sb.appendS
                  tmpReg appendRegister ", " sb.appendS
                  srcLow appendRegister ", " sb.appendS
                  dstLow appendRegister ", " sb.appendS
                byteIndex 8 < if ## [S1:S2:D1:D2]
                  "0b01000100\n" sb.appendS
                else ## [S1:S2:D3:D4]
                  "0b11100100\n" sb.appendS
                end
                "  vshufps " sb.appendS
                  dstLow appendRegister ", " sb.appendS
                byteIndex switch
                    0 case
                      tmpReg appendRegister ", " sb.appendS
                      dstLow appendRegister ", " sb.appendS
                      "0b11101100\n" sb.appendS
                      break
                    4 case
                      tmpReg appendRegister ", " sb.appendS
                      dstLow appendRegister ", " sb.appendS
                      "0b11100010\n" sb.appendS
                      break
                    8 case
                      dstLow appendRegister ", " sb.appendS
                      tmpReg appendRegister ", " sb.appendS
                      "0b11000100\n" sb.appendS
                      break
                    12 case
                      dstLow appendRegister ", " sb.appendS
                      tmpReg appendRegister ", " sb.appendS
                      "0b00100100\n" sb.appendS
                      break
                    default "unexpected offset for f32" ..panic
                  end
                return
              else
                byteCount 4 == "unimplemented: extracting multiple f32 values" assert
                "  vshufps " sb.appendS
                  dstLow appendRegister ", " sb.appendS
                  srcLow appendRegister ", " sb.appendS
                  srcLow appendRegister ", " sb.appendS
                  srcOffset switch
                    0 case "0b00\n" sb.appendS break
                    4 case "0b01\n" sb.appendS break
                    8 case "0b10\n" sb.appendS break
                    12 case "0b11\n" sb.appendS break
                    default "unexpected offset for f32" ..panic
                  end
                return
              end
              break
            6 2 case "f16 values are not supported" ..panic ## 2-byte aligned
            default "unaligned float value" ..panic ## 1-byte aligned
          end
        end
        ## TODO different operations depending on operand types
        ## float/vector -> int / int -> float
        ## TODO handle same register(s) being used as source and target
        byteIndex lowBytes < if ## insert data into low-register
          byteCount lowBytes byteIndex - i32.min =:: copiedBytes
          dstLow
            bitMoveInfo .flags asm.BitMove.DST1_SHIFT >> asm.BitMove.DST_TYPE_MASK &
            srcLow srcHi
            srcOffset
            byteIndex
            copiedBytes
          context registerInsert
        end ## no else: bytes may get copied to both targets
        byteIndex byteCount + lowBytes > if ## insert data into hi-register
          dstHi NO_REG != "target-register exists" assert
          dstHi isFloatReg if "inserting into float registers is not implemented" ..panic end
          byteIndex lowBytes - =:: hiIndex
          hiIndex 0 < if
            0 srcOffset hiIndex -
          else
            hiIndex srcOffset
          end =:: srcOffsetHi =:: copyIndex
          byteCount lowBytes byteIndex - i32.min =:: copiedBytes
          dstHi
            bitMoveInfo .flags asm.BitMove.DST2_SHIFT >> asm.BitMove.DST_TYPE_MASK &
            srcLow srcHi
            srcOffsetHi
            copyIndex
            copiedBytes
          context registerInsert
        end
        return
      COPY case
        op .operands 0 [] =:: mut: dst
        op .operands 1 [] =:: mut: src
        op .operands 2 [] =:: size
        INT_TMP_REGISTERS 0 [] ValType .I64 setRegType =:: tmpI
        FLOAT_TMP_REGISTERS 0 [] ValType .BITS128 setRegType =:: tmpV
        size .constInt ?? "unimplemented: copy with dynamic size" assert
        ## TODO? check if src and dst have right shape
        0:i64 =:: mut: offset
        ## unwrap local memory to get correct address
        src .localMemory ?? if
          context .variableOffsets src .localMemory map.get .data -_
          RBP asm.Operand .register src=
        else  src .regAndOffset ?? _if
          src .regAndOffset .offset i64 cast.s
          src .regAndOffset .reg asm.Operand .register src=
        else 0:i64 end =:: srcOffset
        dst .localMemory ?? if
          context .variableOffsets dst .localMemory map.get .data -_
          RBP asm.Operand .register dst=
        else  dst .regAndOffset ?? _if
          dst .regAndOffset .offset i64 cast.s
          dst .regAndOffset .reg asm.Operand .register dst=
        else 0:i64 end =:: dstOffset
        size .constInt =:: total
        size .constInt =:: mut: remaining
        while remaining 16 >= do
          "  movdqu " sb.appendS tmpV appendRegister ", XMMWORD PTR [" sb.appendS
            src ValType .PTR context appendOperand
            '+' sb.appendC offset srcOffset + sb.appendI
          "]\n" sb.appendS
          "  movups XMMWORD PTR [" sb.appendS ## TODO? is there a reason why gcc uses movdqu followed by movups
            dst ValType .PTR context appendOperand
            '+' sb.appendC offset dstOffset + sb.appendI
          "], " sb.appendS tmpV appendRegister '\n' sb.appendC
        finally remaining 16 - remaining= offset 16 + offset= end
        remaining 0 == if
          return
        end
        ## TODO reduce duplicate code
        remaining 8 > if
          total 16 >= if
            "  movdqu " sb.appendS tmpV appendRegister ", XMMWORD PTR [" sb.appendS
              src ValType .PTR context appendOperand
              '+' sb.appendC total 16 - srcOffset + sb.appendI
            "]\n" sb.appendS
            "  movups XMMWORD PTR [" sb.appendS
              dst ValType .PTR context appendOperand
              '+' sb.appendC total 16 - dstOffset + sb.appendI
            "], " sb.appendS tmpV appendRegister '\n' sb.appendC
            return
          else
            "  mov " sb.appendS tmpI appendRegister ", QWORD PTR [" sb.appendS
              src ValType .PTR context appendOperand
              '+' sb.appendC offset srcOffset + sb.appendI
            "]\n" sb.appendS
            "  mov QWORD PTR [" sb.appendS
              dst ValType .PTR context appendOperand
              '+' sb.appendC offset dstOffset + sb.appendI
            "], " sb.appendS tmpI appendRegister '\n' sb.appendC
            remaining 8 - remaining=
            offset 8 + offset=
          end
        end ## no else
        remaining 4 > if
          total 8 >= if
            "  mov " sb.appendS tmpI appendRegister ", QWORD PTR [" sb.appendS
              src ValType .PTR context appendOperand
              '+' sb.appendC total 8 - srcOffset + sb.appendI
            "]\n" sb.appendS
            "  mov QWORD PTR [" sb.appendS
              dst ValType .PTR context appendOperand
              '+' sb.appendC total 8 - dstOffset + sb.appendI
            "], " sb.appendS tmpI appendRegister '\n' sb.appendC
            return
          else
            "  mov " sb.appendS tmpI ValType .I32 setRegType appendRegister ", DWORD PTR [" sb.appendS
              src ValType .PTR context appendOperand
              '+' sb.appendC offset srcOffset + sb.appendI
            "]\n" sb.appendS
            "  mov DWORD PTR [" sb.appendS
              dst ValType .PTR context appendOperand
              '+' sb.appendC offset dstOffset + sb.appendI
            "], " sb.appendS tmpI ValType .I32 setRegType appendRegister '\n' sb.appendC
            remaining 4 - remaining=
            offset 4 + offset=
          end
        end ## no else
        remaining 2 > if
          total 4 >= if
            "  mov " sb.appendS tmpI ValType .I32 setRegType appendRegister ", DWORD PTR [" sb.appendS
              src ValType .PTR context appendOperand
              '+' sb.appendC total 4 - srcOffset + sb.appendI
            "]\n" sb.appendS
            "  mov DWORD PTR [" sb.appendS
              dst ValType .PTR context appendOperand
              '+' sb.appendC total 4 - dstOffset + sb.appendI
            "], " sb.appendS tmpI ValType .I32 setRegType appendRegister '\n' sb.appendC
            return
          else
            "  movzx " sb.appendS tmpI ValType .I32 setRegType appendRegister ", WORD PTR [" sb.appendS
              src ValType .PTR context appendOperand
              '+' sb.appendC offset srcOffset + sb.appendI
            "]\n" sb.appendS
            "  mov WORD PTR [" sb.appendS
              dst ValType .PTR context appendOperand
              '+' sb.appendC offset dstOffset + sb.appendI
            "], " sb.appendS tmpI ValType .I16 setRegType appendRegister '\n' sb.appendC
            remaining 2 - remaining=
            offset 2 + offset=
          end
        end ## no else
        remaining 2 == if
          "  movzx " sb.appendS tmpI ValType .I32 setRegType appendRegister ", WORD PTR [" sb.appendS
            src ValType .PTR context appendOperand
            '+' sb.appendC offset srcOffset + sb.appendI
          "]\n" sb.appendS
          "  mov WORD PTR [" sb.appendS
            dst ValType .PTR context appendOperand
            '+' sb.appendC offset dstOffset + sb.appendI
          "], " sb.appendS tmpI ValType .I16 setRegType appendRegister '\n' sb.appendC
          return
        else remaining 0 > _if ## remaining == 1
          "  movzx " sb.appendS tmpI ValType .I32 setRegType appendRegister ", BYTE PTR [" sb.appendS
            src ValType .PTR context appendOperand
            '+' sb.appendC offset srcOffset + sb.appendI
          "]\n" sb.appendS
          "  mov BYTE PTR [" sb.appendS
            dst ValType .PTR context appendOperand
            '+' sb.appendC offset dstOffset + sb.appendI
          "], " sb.appendS tmpI ValType .I8 setRegType appendRegister '\n' sb.appendC
        end
        return
      OFFSET case
        ## target, base, offset
        ## target, base, index, scale
        ## target, base, index, scale, offset
        op .operands 0 [] =:: target
        op .operands 1 [] =:: base
        op .operands 2 [] =:: mut: index
        op .operands 3 [] =:: scale
        op .operands 4 [] =:: offset
        ## TODO? verify that arguments have correct types
        INT_TMP_REGISTERS 0 [] =:: tmpReg
        target .register ?? "target is register" assert
        1 =:: mut: eltScale
        scale .constInt ?? if
          scale .constInt switch
            1 2 4 8 case scale .constInt i32 cast eltScale= break
            default
              "  imul " sb.appendS
                tmpReg appendRegister ", " sb.appendS
                index ValType .I64 context appendOperand ", " sb.appendS
                scale .constInt sb.appendI
              '\n' sb.appendC
              tmpReg asm.Operand .register index=
            break
          end
        else scale .empty ?? ! _if
          index .register ?? if
            index .register
          else
            "  mov " sb.appendS
              tmpReg appendRegister ", " sb.appendS
              index ValType .I64 context appendOperand
            '\n' sb.appendC
            tmpReg asm.Operand .register index=
            tmpReg
          end =:: mulReg
          "  imul " sb.appendS
            mulReg appendRegister ", " sb.appendS
            scale ValType .I64 context appendOperand
          '\n' sb.appendC
        end
        "  lea " sb.appendS
          target ValType .PTR context appendOperand
          ", [" sb.appendS
          base ValType .PTR context appendOperand
          '+' sb.appendC
          eltScale 1 > if
            eltScale sb.appendI
            '*' sb.appendC
          end
          index ValType .I64 context appendOperand
          offset .empty ?? ! if
            '+' sb.appendC
            offset ValType .I64 context appendOperand
          end
        "]\n" sb.appendS return
      PUSH case ## TODO? extend pushed values to 64-bits
        ## TODO? handle push/pop for floats
        "  push " sb.appendS op .operands 0 [] ValType .PTR context appendOperand '\n' sb.appendC return
      POP case
        "  pop " sb.appendS op .operands 0 [] ValType .PTR context appendOperand '\n' sb.appendC return
      DATA case ## TODO? optional 3rd operand to specify repetition count
        op .operands 0 [] .valType switch ## TODO are these the correct (platform independent) sizes
          I8  case "  .byte " sb.appendS op .operands 1 [] ValType .PTR context appendOperand '\n' sb.appendC return
          I16 case "  .2byte " sb.appendS op .operands 1 [] ValType .PTR context appendOperand '\n' sb.appendC return
          F32 I32 case "  .4byte " sb.appendS op .operands 1 [] ValType .PTR context appendOperand '\n' sb.appendC return
          F64 I64 PTR case "  .8byte " sb.appendS op .operands 1 [] ValType .PTR context appendOperand '\n' sb.appendC return
          default "/*unsupported data type*/" sb.appendS return
        end
        break
      PADDING_BYTES case
        op .operands 0 [] .constInt =:: count
        count 0 <= if return end
        "  .byte 0" sb.appendS
          count 1 - for ..drop ", 0" sb.appendS end
        '\n' sb.appendC return
      EXTS case
        ## TODO use procedure to get val-type for operand
        op .operands 1 [] asm.guessValType =:: srcType
        op .operands 0 [] asm.guessValType extendSmallInts =:: targetType
        "  movsx " sb.appendS
          op .operands 0 [] targetType context appendOperand ", " sb.appendS
          op .operands 1 [] srcType context appendOperand '\n' sb.appendC
        return
      EXTU case
        op .operands 1 [] asm.guessValType =:: srcType
        op .operands 0 [] asm.guessValType extendSmallInts
          $ .I64 ?? if ..drop
            ValType .I32
          end ## zero-extending to i64 is the same as extending to i32
        =:: targetType
        srcType targetType == if "  mov " sb.appendS else "  movzx " sb.appendS end
          op .operands 0 [] targetType context appendOperand ", " sb.appendS
          op .operands 1 [] srcType context appendOperand '\n' sb.appendC
        return
      TRUNC case break ## noting to do
      EXTF case
        "  cvtss2sd " sb.appendS
          op .operands 0 [] ValType .F64 context appendOperand ", " sb.appendS
          op .operands 1 [] ValType .F32 context appendOperand '\n' sb.appendC
        return
      TRUNCF case
        "  cvtsd2ss " sb.appendS
          op .operands 0 [] ValType .F32 context appendOperand ", " sb.appendS
          op .operands 1 [] ValType .F64 context appendOperand '\n' sb.appendC
        return
      I2F case
        op .operands 1 [] asm.guessValType
          $ .I8 ?? or $ .I16 ?? if =:: srcVal
            "  movsx " sb.appendS op .operands 1 [] ValType .I32 context appendOperand ", " sb.appendS
            op .operands 1 [] srcVal context appendOperand '\n' sb.appendC
            ValType .I32
          end
        =:: srcType
        op .operands 0 [] asm.guessValType =:: targetType
        ## break dependency chain
        op .operands 0 [] .register clearRegister
        targetType .F32 ?? if "  cvtsi2ss " sb.appendS else "  cvtsi2sd " sb.appendS end
          op .operands 0 [] targetType context appendOperand ", " sb.appendS
          op .operands 1 [] srcType context appendOperand '\n' sb.appendC
        return
      U2F case
        op .operands 1 [] asm.guessValType =:: srcType
        srcType
          $ .I8 ?? or $ .I16 ?? if =:: srcVal
            "  movzx " sb.appendS op .operands 1 [] ValType .I32 context appendOperand ", " sb.appendS
            op .operands 1 [] srcVal context appendOperand '\n' sb.appendC
            ValType .I32
          else $ .I32 ?? _if ..drop
            "  mov " sb.appendS op .operands 1 [] ValType .I32 context appendOperand ", " sb.appendS
            op .operands 1 [] ValType .I32 context appendOperand '\n' sb.appendC
            ValType .I64
          end
        =:: srcRegType
        op .operands 0 [] asm.guessValType =:: targetType
        ## break dependency chain
        op .operands 0 [] .register clearRegister
        srcType .I64 ?? if
          ## TODO? does always truncating last bit leat to rounding errors?
          "  shr " sb.appendS op .operands 1 [] srcRegType context appendOperand ", 1\n" sb.appendS
        end
        targetType .F32 ?? if "  cvtsi2ss " sb.appendS else "  cvtsi2sd " sb.appendS end
            op .operands 0 [] targetType context appendOperand ", " sb.appendS
        op .operands 1 [] srcRegType context appendOperand '\n' sb.appendC
        srcType .I64 ?? if
          targetType .F32 ?? if "  addss " sb.appendS else "  addsd " sb.appendS end
            op .operands 0 [] targetType context appendOperand ", " sb.appendS
          op .operands 0 [] targetType context appendOperand '\n' sb.appendC
        end
        return
      F2I case ## TODO? should float -> int conversion truncate or round
        op .operands 1 [] asm.guessValType =:: srcType
        op .operands 0 [] asm.guessValType =:: targetType
        ## extend target register to correct size
        targetType extendSmallInts =:: targetRegType
        context [] .tmpLabelCount
          $ =:: tmpLabelId
          1 +
        context .tmpLabelCount=
        targetType BoundType .SIGNED_MIN getIntBound =:: minVal
        targetType BoundType .SIGNED_MAX getIntBound =:: maxVal
        INT_TMP_REGISTERS 0 [] targetRegType setRegType =:: tmpI
        FLOAT_TMP_REGISTERS 0 [] srcType setRegType =:: tmpF
        ## clear target
        op .operands 0 [] .register clearRegister
        srcType valTypeBits targetType valTypeBits > if
          srcType .F32 ?? if "  movss " sb.appendS else "  movsd " sb.appendS end
            tmpF appendRegister ", " sb.appendS
          op .operands 1 [] srcType context appendOperand '\n' sb.appendC
          srcType .F32 ?? if "  maxss " sb.appendS else "  maxsd " sb.appendS end
            tmpF appendRegister ", " sb.appendS
            minVal srcType .F32 ?? if f32 cast.s asm.Operand .constF32 else f64 cast.s asm.Operand .constF64 end
          srcType context appendOperand '\n' sb.appendC
          srcType .F32 ?? if "  minss " sb.appendS else "  minsd " sb.appendS end
            tmpF appendRegister ", " sb.appendS
            maxVal srcType .F32 ?? if f32 cast.s asm.Operand .constF32 else f64 cast.s asm.Operand .constF64 end
          srcType context appendOperand '\n' sb.appendC
          srcType .F32 ?? if "  cvttss2si " sb.appendS else "  cvttsd2si " sb.appendS end
            op .operands 0 [] targetRegType context appendOperand ", " sb.appendS
          tmpF appendRegister '\n' sb.appendC
        else
          srcType .F32 ?? if "  cvttss2si " sb.appendS else "  cvttsd2si " sb.appendS end
            op .operands 0 [] targetRegType context appendOperand ", " sb.appendS
          op .operands 1 [] srcType context appendOperand '\n' sb.appendC
          srcType .F32 ?? if "  ucomiss " sb.appendS else "  ucomisd " sb.appendS end
            op .operands 1 [] srcType context appendOperand ", " sb.appendS
            maxVal srcType .F32 ?? if f32 cast.s asm.Operand .constF32 else f64 cast.s asm.Operand .constF64 end
          srcType context appendOperand '\n' sb.appendC
          "  mov " sb.appendS tmpI appendRegister ", " sb.appendS
          maxVal asm.Operand .constInt targetRegType context appendOperand '\n' sb.appendC
          "  cmovae " sb.appendS op .operands 0 [] targetRegType context appendOperand ", " sb.appendS
          tmpI appendRegister '\n' sb.appendC
        end
        tmpI clearRegister
        srcType .F32 ?? if "  ucomiss " sb.appendS else "  ucomisd " sb.appendS end
          op .operands 1 [] srcType context appendOperand ", " sb.appendS
        op .operands 1 [] srcType context appendOperand '\n' sb.appendC
        "  cmovp " sb.appendS op .operands 0 [] targetRegType context appendOperand ", " sb.appendS
        tmpI appendRegister '\n' sb.appendC
        return
      F2U case
        op .operands 1 [] asm.guessValType =:: srcType
        op .operands 0 [] asm.guessValType =:: targetType
        targetType ## use signed conversion to next larger int if possible
          $ .I8 ?? or $ .I16 ?? if
            ..drop ValType .I32
          else $ .I32 ?? _if
            ..drop ValType .I64
          end
        =:: targetRegType
        context [] .tmpLabelCount
          $ =:: tmpLabelId
          2 +
        context .tmpLabelCount=
        targetType BoundType .UNSIGNED_MAX getIntBound =:: maxVal
        INT_TMP_REGISTERS 0 [] targetRegType setRegType =:: tmpI
        INT_TMP_REGISTERS 1 [] targetRegType setRegType =:: tmpI2
        FLOAT_TMP_REGISTERS 0 [] srcType setRegType =:: tmpF
        FLOAT_TMP_REGISTERS 1 [] srcType setRegType =:: tmpF2
        srcType valTypeBits targetType valTypeBits > if
          tmpF clearRegister
          srcType .F32 ?? if "  maxss " sb.appendS else "  maxsd " sb.appendS end
            op .operands 1 [] srcType context appendOperand ", " sb.appendS
          tmpF appendRegister '\n' sb.appendC
          srcType .F32 ?? if "  minss " sb.appendS else "  minsd " sb.appendS end
            op .operands 1 [] srcType context appendOperand ", " sb.appendS
            maxVal srcType .F32 ?? if f32 cast.u asm.Operand .constF32 else f64 cast.u asm.Operand .constF64 end
          srcType context appendOperand '\n' sb.appendC
          srcType .F32 ?? if "  cvttss2si " sb.appendS else "  cvttsd2si " sb.appendS end
            op .operands 0 [] targetRegType context appendOperand ", " sb.appendS
          op .operands 1 [] srcType context appendOperand '\n' sb.appendC
        else
          i64.MIN =:: MIN_SIGNED
          targetType .I64 ?? if ## direct conversion to unsigned only available with avx512
            srcType .F32 ?? if "  vsubss " sb.appendS else "  vsubsd " sb.appendS end
              tmpF2 appendRegister ", " sb.appendS
            op .operands 1 [] srcType context appendOperand ", " sb.appendS
            MIN_SIGNED srcType .F32 ?? if f32 cast.u asm.Operand .constF32 else f64 cast.u asm.Operand .constF64 end
            srcType context appendOperand '\n' sb.appendC
            srcType .F32 ?? if "  cvttss2si " sb.appendS else "  cvttsd2si " sb.appendS end
              tmpI2 appendRegister ", " sb.appendS
            tmpF2 appendRegister '\n' sb.appendC
            "  mov " sb.appendS tmpI appendRegister ", " sb.appendS
            MIN_SIGNED asm.Operand .constInt srcType context appendOperand '\n' sb.appendC
            "  or " sb.appendS tmpI2 appendRegister ", " sb.appendS
            tmpI appendRegister '\n' sb.appendC
            srcType .F32 ?? if "  ucomiss " sb.appendS else "  ucomisd " sb.appendS end
              op .operands 1 [] srcType context appendOperand ", " sb.appendS
              maxVal srcType .F32 ?? if f32 cast.u asm.Operand .constF32 else f64 cast.u asm.Operand .constF64 end
            srcType context appendOperand '\n' sb.appendC
            "  mov " sb.appendS tmpI appendRegister ", " sb.appendS
            maxVal asm.Operand .constInt targetRegType context appendOperand '\n' sb.appendC
            "  cmovae " sb.appendS tmpI2 appendRegister ", " sb.appendS
            tmpI appendRegister '\n' sb.appendC
          end
          srcType .F32 ?? if "  cvttss2si " sb.appendS else "  cvttsd2si " sb.appendS end
            op .operands 0 [] targetRegType context appendOperand ", " sb.appendS
          op .operands 1 [] srcType context appendOperand '\n' sb.appendC
          tmpI clearRegister
          tmpF clearRegister
          srcType .F32 ?? if "  ucomiss " sb.appendS else "  ucomisd " sb.appendS end
            op .operands 1 [] srcType context appendOperand ", " sb.appendS
          tmpF appendRegister '\n' sb.appendC
          "  cmovb " sb.appendS op .operands 0 [] targetRegType context appendOperand ", " sb.appendS
          tmpI appendRegister '\n' sb.appendC
          srcType .F32 ?? if "  ucomiss " sb.appendS else "  ucomisd " sb.appendS end
          targetType .I64 ?? if
            tmpF2 appendRegister ", " sb.appendS tmpF appendRegister '\n' sb.appendC
            "  cmovae " sb.appendS op .operands 0 [] targetRegType context appendOperand ", " sb.appendS
            tmpI2 appendRegister '\n' sb.appendC
          else
            op .operands 1 [] srcType context appendOperand ", " sb.appendS
              maxVal srcType .F32 ?? if f32 cast.u asm.Operand .constF32 else f64 cast.u asm.Operand .constF64 end
            srcType context appendOperand '\n' sb.appendC
            "  mov " sb.appendS tmpI appendRegister ", " sb.appendS
            maxVal asm.Operand .constInt targetRegType context appendOperand '\n' sb.appendC
            "  cmovae " sb.appendS op .operands 0 [] targetRegType context appendOperand ", " sb.appendS
            tmpI appendRegister '\n' sb.appendC
          end
        end
        return
      NOT case ## special handling for not
        op .operands 0 [] =:: target
        op .operands 1 [] =:: src
        op@ .operands 2 slice.create commonValType =:: opValType
        target .register ?? "target is register" assert ## TODO? allow memory location as target
        src .register ?? and target .register src .register == end =:: srcIsTarget
        srcIsTarget ! if ## clear target to break memory dependency
          target .register clearRegister
        end
        "  test " sb.appendS
          src opValType context appendOperand ", " sb.appendS
          src opValType context appendOperand '\n' sb.appendC
        "  sete " sb.appendS
          target ValType .I8 context appendOperand '\n' sb.appendC
        srcIsTarget if ## zero-extend to break memory dependency
          "  movzx " sb.appendS
            target ValType .I32 context appendOperand ", " sb.appendS
            target ValType .I8 context appendOperand '\n' sb.appendC
        end
        return
      NEG BITNOT case ## unary-operators
        op .operands 0 [] =:: target
        op .operands 1 [] =:: src
        op@ .operands 2 slice.create commonValType =:: opValType
        opValType extendSmallInts =:: targetType
        target .register ?? "target is register" assert ## TODO? allow non-register target when op-code exists
        src .register ?? ! or target .register src .register != if
          opValType isFloatValType if
            opValType .F32 ?? if "  movss " sb.appendS else "  movsd " sb.appendS end
          else targetType opValType != _if
            "  movzx " sb.appendS ## zero-extend when moving to break dependency chain
          else
            "  mov " sb.appendS
          end
            target targetType context appendOperand ", " sb.appendS
            src opValType context appendOperand '\n' sb.appendC
        end
        opValType isFloatValType if
          op .opType .NEG ?? "bitnot is not supported for floats" assert
          opValType .F32 ?? if "  xorps " sb.appendS else "  xorpd " sb.appendS end
            target opValType context appendOperand ", " sb.appendS
            opValType .F32 ?? if CCT_F32_SIGN_MASK else CCT_F64_SIGN_MASK end sb.appendStr
          '\n' sb.appendC
          return
        end
        "  " sb.appendS op .opType appendOpNameInt ' ' sb.appendC
          target targetType context appendOperand '\n' sb.appendC
        return
      BOOLNOT case ## boolean not
        op .operands 0 [] =:: target
        op .operands 1 [] =:: src
        op@ .operands 2 slice.create commonValType =:: opValType
        target .register ?? "target is register" assert ## TODO? allow non-register target when op-code exists
        opValType .I8 ?? "bool has val-type i8" assert
        src .register ?? ! or target .register src .register != if
          "  movzx " sb.appendS
            target ValType .I32 context appendOperand ", " sb.appendS
          src ValType .I8 context appendOperand '\n' sb.appendC
        end
        "  xor " sb.appendS target ValType .I32 context appendOperand ", 1\n" sb.appendS
        return
      AND OR XOR ADD MUL SUB MIN MAX case ## binary-operators
        ## TODO? use 3-operand version of operation (if existent for operands)
        op .operands 0 [] =:: target
        op .operands 1 [] =:: left
        op .operands 2 [] =:: right
        op@ .operands 3 slice.create commonValType extendSmallInts =:: opValType
        target .register ?? "target is register" assert ## TODO? allow non-register target when op-code exists
        opValType isFloatValType if ## TODO? use 2 operand version of left operand is equal to target
          left .register ?? "left operand is register" assert
          "  " sb.appendS opValType op .opType appendOpNameFloat ' ' sb.appendC
            target opValType context appendOperand ", " sb.appendS
            left opValType context appendOperand ", " sb.appendS
            right opValType context appendOperand '\n' sb.appendC
          return
        end
        INT_TMP_REGISTERS 0 [] opValType setRegType =:: tmpReg
        left .register ?? and target .register left .register == if
          left right
        else right .register ?? and target .register right .register == _if
          op .opType .SUB ?? if ## operation not symmetric
            ## sub r, l, r -> mov tmp, l ; sub tmp, r ; mov r, tmp
            "  mov " sb.appendS
              tmpReg appendRegister ", " sb.appendS
              left opValType context appendOperand '\n' sb.appendC
            tmpReg asm.Operand .register right
          else ## symmetric operation
            "  xchg " sb.appendS
              left opValType context appendOperand ", " sb.appendS
            right opValType context appendOperand '\n' sb.appendC
            right left
          end
        else
          "  mov " sb.appendS
            target opValType context appendOperand ", " sb.appendS
            left opValType context appendOperand '\n' sb.appendC
          target right
        end =:: arg2 =:: arg1
        "  " sb.appendS op .opType appendOpNameInt ' ' sb.appendC
          arg1 opValType context appendOperand ", " sb.appendS
          arg2 opValType context appendOperand '\n' sb.appendC
        arg1 .register ?? and arg1 .register tmpReg == if
          "  mov " sb.appendS
            target opValType context appendOperand ", " sb.appendS
          tmpReg appendRegister '\n' sb.appendC
        end
        return
      SHL ASHR LSHR case ## shifts ( rhs is assumed to be in rcx )
        op .operands 0 [] =:: target
        op .operands 1 [] =:: left
        op .operands 2 [] =:: right
        op@ .operands 3 slice.create commonValType =:: opValType
        opValType extendSmallInts =:: targetType
        ## register locations should have been assigned correctly be register allocator
        right .register RCX == "right argument is passed in rcx" assert
        target .register ?? "target is register" assert ## TODO? allow non-register target when op-code exists
        ## TODO? keep track if value is currently sign/zero extended to avoid unnecessary extension
        opValType targetType != or left .register ?? ! or target .register left .register != if
          opValType targetType != if
            op .opType .ASHR ?? if "  movsx " sb.appendS else "  movzx " sb.appendS end
          else
            "  mov " sb.appendS
          end
            target targetType context appendOperand ", " sb.appendS
          left opValType context appendOperand '\n' sb.appendC
        end
        "  " sb.appendS op .opType appendOpNameInt ' ' sb.appendC
          target targetType context appendOperand ", " sb.appendS
          right ValType .I8 context appendOperand '\n' sb.appendC
        return
      DIV MOD UDIV UMOD MULH case ## division operators ( lhs assumed to be in rax, output in rax/rdx)
        op .operands 0 [] =:: target
        op .operands 1 [] =:: left
        op .operands 2 [] =:: right
        op@ .operands 3 slice.create commonValType =:: opValType
        opValType isFloatValType if
          left .register ?? "left operand is register" assert
          "  " sb.appendS opValType op .opType appendOpNameFloat ' ' sb.appendC
            target opValType context appendOperand ", " sb.appendS
            left opValType context appendOperand ", " sb.appendS
            right opValType context appendOperand '\n' sb.appendC
          return
        end
        opValType extendSmallInts =:: targetType
        opValType targetType != if
          "unimplemented: CodeGen: div with i16/i8 operands" ..panic
        end
        ## register locations should have been assigned correctly be register allocator
        left .register i32 cast.u REG_ID_MASK & RAX_ID == "left argument is passed in rax" assert
        target .register i32 cast.u REG_ID_MASK &
          op .opType .DIV ?? or op .opType .UDIV ?? if RAX_ID else RDX_ID end
        == "target is register rax/rdx" assert
        op .opType switch
          DIV MOD case targetType .I64 ?? if "  cqo\n" sb.appendS else "  cdq\n" sb.appendS end break
          UDIV UMOD case RDX clearRegister break
          MULH case break
          default ..unreachable
        end
        "  " sb.appendS op .opType appendOpNameInt ' ' sb.appendC
          right targetType context appendOperand '\n' sb.appendC
        return
      ## DIVMOD UDIVMUD MUL2 UMUL2 use same regiter sheme with 2 inputs/outputs
      CMP case
        op .operands 0 [] .cmpType =:: cmpType
        op .operands 1 [] =:: target
        op@ .operands 2 @[] 2 slice.create commonValType =:: opValType
        opValType isFloatValType if
          INT_TMP_REGISTERS 0 [] ValType .I32 setRegType =:: tmpReg
          target .register clearRegister ## TODO? is it better to extend register after setcc?
          cmpType .EQ ?? if
            tmpReg clearRegister
          end
          ## TODO? special handling if lhs and rhs are the same in EQ or NE (directly check for NaN)
          opValType .F32 ?? if
            "  ucomiss " sb.appendS
          else
            "  ucomisd " sb.appendS
          end
          cmpType .LT ?? or cmpType .LE ?? if ## swap arguments
            op .operands 3 [] opValType context appendOperand ", " sb.appendS
            op .operands 2 [] opValType context appendOperand '\n' sb.appendC
          else
            op .operands 2 [] opValType context appendOperand ", " sb.appendS
            op .operands 3 [] opValType context appendOperand '\n' sb.appendC
          end
          cmpType switch
            GT LT case "  seta " sb.appendS target ValType .I8 context appendOperand '\n' sb.appendC return
            GE LE case "  setae " sb.appendS target ValType .I8 context appendOperand '\n' sb.appendC return
            EQ case
              "  sete " sb.appendS target ValType .I8 context appendOperand '\n' sb.appendC
              "  cmovp " sb.appendS target ValType .I32 context appendOperand
              ", " sb.appendS tmpReg appendRegister '\n' sb.appendC
              return
            NE case
              "  mov " sb.appendS tmpReg appendRegister ", 1\n" sb.appendS
              "  setne " sb.appendS target ValType .I8 context appendOperand '\n' sb.appendC
              "  cmovp " sb.appendS target ValType .I32 context appendOperand
              ", " sb.appendS tmpReg appendRegister '\n' sb.appendC
              return
            default "unsupported comparison type for floats" ..panic
          end
        end
        "  cmp " sb.appendS
          op .operands 2 [] opValType context appendOperand ", " sb.appendS
          op .operands 3 [] opValType context appendOperand '\n' sb.appendC
        "  set" sb.appendS cmpType appendCmpFlags ' ' sb.appendC
          target ValType .I8 context appendOperand '\n' sb.appendC
        "  movzx " sb.appendS target ValType .I32 context appendOperand ", " sb.appendS
          target ValType .I8 context appendOperand '\n' sb.appendC
        return
      JMP case
        "  jmp " sb.appendS op .operands 0 [] ValType .PTR context appendOperand '\n' sb.appendC return
      JMPIF case
        op .operands 0 [] =:: cmpType
        op .operands 3 [] .empty ?? if ## <cmpType> <value> <target>
          "  test " sb.appendS
            op .operands 1 [] ValType .EMPTY context appendOperand ", " sb.appendS
            op .operands 1 []  ValType .EMPTY context appendOperand '\n' sb.appendC
          op .operands 2 []
        else ## <cmpType> <src1> <src2> <target>
          op@ .operands 1 @[] 2 slice.create commonValType =:: opValType
          ## TODO? handle floats
          "  cmp " sb.appendS
            op .operands 1 [] opValType context appendOperand ", " sb.appendS
            op .operands 2 [] opValType context appendOperand '\n' sb.appendC
          op .operands 3 []
        end =:: target
        "  j" sb.appendS cmpType .cmpType appendCmpFlags ' ' sb.appendC
          target ValType .PTR context appendOperand
        '\n' sb.appendC return
      CALL case ## TODO? distinguish pointer and FPTR
        "  call " sb.appendS op .operands 0 [] ValType .PTR context appendOperand '\n' sb.appendC return
      RET case "  ret\n" sb.appendS return
      ADC SBB MUL2 DIVMOD UDIVMOD case "/* unimplemented operation */\n" sb.appendS return
    end
    "/* unimplemented operation: " sb.appendS
      op .opType sb.appendOpType
    " */\n" sb.appendS
  end
  proc( stringBuilder Atomic : atom AsmCompilerContext ptr.mut : context -> stringBuilder ) =>: compileAtom
    context [] .program =:: program
    program .idContext .typeContext =:: typeContext
    typeContext .labelContext =:: labelContext
    atom switch
      Unknown case "!error unkown operation\n" sb.appendS return
      Op case atom .Op context compileAsmOp return
      DebugUsesFile case
        ".file " sb.appendS atom .DebugUsesFile i64 cast sb.appendI " \"" sb.appendS
          program [] .progFiles atom .DebugUsesFile i64 cast @[] .fileName [] sb.asStr sb.appendEscapedStrC
        "\"\n" sb.appendS return
      DebugStartFile case
        "\n/* " sb.appendS
          program [] .progFiles atom .DebugStartFile i64 cast [] .fileName sb.appendSb
        "*/\n" sb.appendS return
      DebugStartOp case
        atom .DebugStartOp .pos =:: pos
        "/* " sb.appendS
          atom .DebugStartOp program sb.appendOp sb.pop ..drop
        " */\n  .loc " sb.appendS
          pos .fileId i64 cast sb.appendI ' ' sb.appendC
          pos .line sb.appendI ' ' sb.appendC pos .posInLine sb.appendI
        '\n' sb.appendC return
      DebugError case
        "!error " sb.appendS
        atom .DebugError sb.appendStr
        '\n' sb.appendC
        return
      Section case atom .Section switch
          Code case ".text\n" sb.appendS return
          Data case ".data\n" sb.appendS return
        end break
      Align case "  .balign " sb.appendS atom .Align sb.appendI '\n' sb.appendC return
      StartProc case
        atom .StartProc =:: implInfo
        program [] .procedures
          implInfo .procId i64 cast list.at .data
        =:: procInfo
        procInfo [] .labelId labelContext id.labelFlags id.FLAG_EXPORT id.FLAG_EXTERN | & ? if
          "  .globl " sb.appendS
          procInfo [] .labelId labelContext sb.appendLabelName
          '\n' sb.appendC
        end
        ## TODO if proc is exported add .globl <procLabel>
        ## TODO! only push callee-saved registers that are actually used
        "  push rbx\n  push r12\n  push r13\n  push r14\n  push r15\n" sb.appendS
        "  push rbp\n  mov rbp, rsp\n  and rsp, -16\n" sb.appendS ## ensure stack is 16-byte aligned
        ## TODO create allocations for stack-memory
        context .variableOffsets map.clear ## clear variables from previous procedure
         ## allocate space for variables
        implInfo .implementationId 0 >= if
          procInfo [] .implementation .code .implementations
            implInfo .implementationId list.at .data [] .variables
        else
          procInfo [] .implementation .code .variables
        end =:: variables
        ## TODO sort variables by alignment?
        0:i64 =:: mut: stackOffset
        variables for =:: varInfo
          ## TODO skip arguments passed though memory address
          varInfo .valueType =:: valType
          valType typeContext types.alignOf .fixed =:: alignment
          valType typeContext types.sizeOf .fixed
            ## round up sizes of multi-register values to 16-bytes to allow direct load/store of two registers
            $ 8 > and $ 16 < if ..drop 16 end ## TODO? is this neccessary
          =:: size
          stackOffset alignment 1 - + alignment -_ & stackOffset= ## round offset to alignment
          stackOffset size + stackOffset=
          context .variableOffsets varInfo .label stackOffset map.put ..drop
           "/* " sb.appendS
            varInfo .label labelContext sb.appendLabelName ": " sb.appendS stackOffset sb.appendI
          " */\n" sb.appendS
        end
        stackOffset 0 > if
          stackOffset 15 + -16 & stackOffset= ## align to multiple of 16
          "  sub rsp, " sb.appendS stackOffset sb.appendI '\n' sb.appendC ## allocate stack space
        end
        return
      LeaveProc case
        ## TODO only restore registers that have been pushed
        "  mov rsp, rbp\n  pop rbp\n" sb.appendS
        "  pop r15\n  pop r14\n  pop r13\n  pop r12\n  pop rbx\n" sb.appendS
        return
      EndProc case
        context [] .procedureTail sb.appendSb
        context [] .procedureTail sb.clear context .procedureTail=
        "\n" sb.appendS
      return
      Entry case
        ## TODO? option to have entry without lib-c wrapper
          "  .globl main\nmain:\n" sb.appendS
          ## TODO initialize arguments if neccessary
        return
      ExitEntry case
          "  xor eax,eax\n  ret\n\n" sb.appendS
        return
      Error case
        atom .Error switch ## use call to have error location in call-stack
          AssertFail case "  call " sb.appendS CCT_ERROR_ASSERT sb.appendStr '\n' sb.appendC return
          Panic case "  call " sb.appendS CCT_ERROR_PANIC sb.appendStr '\n' sb.appendC return
        end break
    end
  end
  ## TODO compute used variables & stack-memeory slots in pre-compilation phase
  proc( stringBuilder Atomic list : ops ProgramContext ptr.mut : program -> stringBuilder ) =>: buildProgram
    ## AsmCompilerContext
      program
      labelHash@ labelEq@ 1024 i64 map.create
      64 f64 list.create
      64 f32 list.create
      512 sb.create
      0
    AsmCompilerContext new =:: mut: context
    "  .intel_syntax noprefix\n" sb.appendS
    ops for =:: op
      op context@ compileAtom
    end
    context@ .variableOffsets map.free
    ".data\n  .balign 16\n" sb.appendS
    CCT_F32_SIGN_MASK sb.appendStr ":\n  .4byte 0x80000000\n  .4byte 0\n  .4byte 0\n  .4byte 0\n" sb.appendS
    CCT_F64_SIGN_MASK sb.appendStr ":\n  .8byte 0x8000000000000000\n  .8byte 0\n" sb.appendS
    context .f64Consts .length for =:: i
      "f64const" sb.appendS i sb.appendI ":\n  .8byte 0x" sb.appendS
        context .f64Consts i [] f64.bits sb.appendUX
      " /* " sb.appendS context .f64Consts i [] sb.appendF " */\n" sb.appendS
    end
    context .f32Consts .length for =:: i
      "f32const" sb.appendS i sb.appendI ":\n  .4byte 0x" sb.appendS
        context .f32Consts i [] f32.bits sb.appendUX
      " /* " sb.appendS context .f32Consts i [] f64 cast sb.appendF " */\n" sb.appendS
    end
    ## default error handlers (assume arguments first 3 arguments are <msg> <msg-len> <pos-ptr> )
    ".text\nccti_shift_args:" sb.appendS
    3 while $ 0 >= do =:: i
      "\n  mov " sb.appendS
      i 1 + AMD64.getIntArgumentRegister appendRegister
      ", " sb.appendS
      i AMD64.getIntArgumentRegister appendRegister
    finally i 1 - end ..drop
    "\n  ret\n" sb.appendS
    ## TODO? support non SysV calling convention
    ## TODO include position in print
    ## TODO? ommit unused handlers
    CCT_ERROR_ASSERT sb.appendStr ":\n" sb.appendS
    "  call ccti_shift_args\n" sb.appendS
    "  lea rdi, ccti_err_assert_msg\n  xchg rsi, rdx\n  call printf\n" sb.appendS
    "  mov rdi, 1\n  jmp exit\n" sb.appendS
    CCT_ERROR_PANIC sb.appendStr ":\n" sb.appendS
    "  call ccti_shift_args\n" sb.appendS
    "  lea rdi, ccti_err_panic_msg\n  xchg rsi, rdx\n  call printf\n" sb.appendS
    "  mov rdi, 1\n  jmp exit\n" sb.appendS
    ".data\n" sb.appendS
    "ccti_err_assert_msg:\n.string	\"assertion failed \\\"%.*s\\\"\\n\"\n" sb.appendS
    "ccti_err_panic_msg:\n.string	\"panic \\\"%.*s\\\"\\n\"\n" sb.appendS
    ".section .note.GNU-stack,\"\",@progbits\n" sb.appendS
    ## TODO! cleanup context
  end
end
#################
## CodeGenerator
#################
union(
  _ : memory ## procedure internal stack-memory
  RegisterId : register
  RegisterId : registerHi ## high part in register, low part in memory
  RegisterId : registerLow ## low part in register, hi part in memory
  RegisterPair : registers
) =:: StackValueLocation
## TODO marker for values that appear multiple times in stack (delay copy until next loop start)
struct(
  StackValueLocation : location
  ValType : valType
) =:: StackValue
struct( LabelId : label RegisterId : reg ) =:: LabelAndReg
union(
  RegisterId : register
  RegisterPair : registers
  LabelAndReg : localAndLowReg
  LabelAndReg : localAndHiReg
  LabelAndReg : globalAndLowReg
  LabelAndReg : globalAndHiReg
  ## TODO atReg, atReg+offset
  i32 : intArgument
  i32 : floatArgument
  i32 : compositeArgument
  LabelId : localMemory
  LabelId : localAddr
  LabelId : globalMemory
  LabelId : globalAddr
  i64 : intConstant
  f64 : floatConstant
  i32 : ptrConstant
  ## TODO? float-constant, composite-constant, constant-location
) =:: ValueLocation

##? valuegroup -> bits64
## TODO? keep track of all reads&writes to given variable
##  * allows to better prioritive different values
##  * allows to free variable register if value is no longer used

## simplify register assignment:
## TODO 0. find read/write locations of variables (allows to free registers for variables that are not read until next write)
## 1. store all stack-slots / cached variables in different registers
## 2. run copy elimination in parallel (mark register pairs holding same value, split values at loop start)
## ?? overcommit register ids if there are many registers sharing the same value, if copy elimination does not eliminate all versions move least used normal register to stack when value in overflow register is needed
#+
before final output:
  remove all writes to registers/local memory that are not read before next write
  discard all memory blocks that are never read or converted to pointer
TODO add target specific optimizations as finaly step before output
  -> fuze/split operations
  -> use target specific operations
+#

## TODO? merge branches instead of resetting to first value
## * in type-check phase: count else/continue/case branches
## * one reg-state for eacha branch
## * merge such that minimum total moves
struct(
  BlockId : blockId
  i32 : startLabelId
  i32 : doLabelId
  i32 : finallyLabelId
  i32 : endLabelId
  ## TODO remember which registers are read within loop (without beeing overwritten first, do not need to be restored)
  RegisterState slice.mut : regData ## storage for register data (heap allocated)
  ## regData: [WHILE][DO][CONTINUE][BREAK]
  i32 : doRegsOffset ## offset for reg-data in do-branch
  i32 : continueRegsOffset ## offset for reg-data in continue-branches
  i32 : breakRegsOffset ## offset for reg-data in break-branches
  iSize : whileStackSize
  iSize : doStackSize
  iSize : endStackSize
  iSize : continueStackSize
) =:: WhileBlockInfo
struct(
  BlockId : blockId
  i32 : ifLabelId
  i32 : elseLabelId
  i32 : endLabelId
  RegisterState slice.mut : regData ## storage for register data (heap allocated)
  ## regData: [ELSE-start][IF-start][Branch-end]
  i32 : ifStartRegsOffset
  i32 : elseRegsOffset ## offset for reg-data in else-branch
  iSize : ifStackSize
  iSize : endStackSize
  bool : hasIf
) =:: IfBlockInfo
struct(
  BlockId : blockId
  i32 : endLabelId
  RegisterState slice.mut : regData ## storage for register data (heap allocated)
  iSize : endStackSize
) =:: AndOrBlockInfo
struct(
  BlockId : blockId
  i32 : endLabelId
  ## TODO? support multiple branches in inlined proc
) =:: InlineProcBlockInfo
struct(
  BlockId : blockId
  i32 : endLabelId
  i32 slice.mut : caseLabelIds ## [case-labels] [default-label]
  RegisterState slice.mut : regData ## storage for register data (heap allocated)
  ## regData: [SWITCH-start][BRANCH-end] ## TODO? one state for each branch
  i32 : endRegsOffset
  iSize : switchStackSize
  iSize : endStackSize
  i32 : caseIndex ## current case-id
) =:: SwitchBlockInfo
union(
  WhileBlockInfo : While
  IfBlockInfo : If
  AndOrBlockInfo : AndOr
  SwitchBlockInfo : Switch
  InlineProcBlockInfo : InlineProc
) =:: BlockInfo

struct(
  ConstValue : constValue
  Type : constType
  ## TODO? remember location
) =:: PointerConstant

## TODO? keep track of registers holding constant values
struct(
  ProgramContext ptr.mut : program
  RegisterState slice.mut : dataRegisters
  StackValue list : stack ## TODO? seperate stacks for ints, floats, and double-register values
  LabelId ValueLocation hashMap : variableLocations
  BlockInfo list : openBlocks
  ArgumentLocation list : argBuffer
  PointerConstant list : pointerConstants
  Atomic list : procTail
  i32 : intDataRegCount
  i32 : labelCount
  bool : reachable
) =:: CompilerContext

## TODO? directly convert to platform specific assembly when appending operation
proc(
  Atomic list
  asm.OpType : opType
  CompilerContext ptr.mut : context
-> Atomic list ) =>: appendOp0
  opType asmOp0 Atomic .Op list.append
end
proc(
  Atomic list
  asm.OpType : opType
  asm.Operand : arg1
  CompilerContext ptr.mut : context
-> Atomic list ) =>: appendOp1
  opType arg1 asmOp1 Atomic .Op list.append
end
proc(
  Atomic list
  asm.OpType : opType
  asm.Operand : arg1 asm.Operand : arg2
  CompilerContext ptr.mut : context
-> Atomic list ) =>: appendOp2
  opType arg1 arg2 asmOp2 Atomic .Op list.append
end
proc(
  Atomic list
  asm.OpType : opType
  asm.Operand : arg1 asm.Operand : arg2 asm.Operand : arg3
  CompilerContext ptr.mut : context
-> Atomic list ) =>: appendOp3
  opType arg1 arg2 arg3 asmOp3 Atomic .Op list.append
end
proc(
  Atomic list
  asm.OpType : opType
  asm.Operand : arg1 asm.Operand : arg2 asm.Operand : arg3 asm.Operand : arg4
  CompilerContext ptr.mut : context
-> Atomic list ) =>: appendOp4
  opType arg1 arg2 arg3 arg4 asmOp4 Atomic .Op list.append
end
proc(
  Atomic list
  asm.OpType : opType
  asm.Operand : arg1 asm.Operand : arg2 asm.Operand : arg3 asm.Operand : arg4 asm.Operand : arg5
  CompilerContext ptr.mut : context
-> Atomic list ) =>: appendOp5
  opType arg1 arg2 arg3 arg4 arg5 asmOp5 Atomic .Op list.append
end

proc( Type : valueType ConstValue : val CompilerContext ptr.mut : context -> i32 ) =>: newPtrConstant
  context [] .pointerConstants
    $ .length i32 cast.u =:: constId
    val valueType PointerConstant new list.append
  context .pointerConstants=
  constId return
end

proc( LabelId : valId RegisterId : register bool : isReference i32 : opIndex CompilerContext ptr.mut : context -> ) =>: cacheVariable ## TODO? disable variable chaching until system can support pointer-aliases (? and sub-elements)
  context .variableLocations
    valId
    register ValueLocation .register
  map.put =:: prevLocation?
  ## remove previous location from register data
  ## TODO? common procedure for clearing previous data
  prevLocation? optional.hasData and
      prevLocation? .data =:: prevLocation
      prevLocation .registers ?? ! "CodeGen: single register value not stored in register pair" assert
      prevLocation .register ?? if
    prevLocation .register context resetRegisterById
  end
  ## update register storage
  register context findRegister
    $ optional.isEmpty if ..drop return end
  .data =:: registerData
  opIndex registerData .lastUsed=
  registerData .currentValue .empty ?? "caching variable does not overwrite register" assert
  valId
    isReference if
      RegisterContent .variableReference
    else
      RegisterContent .variable
    end
  registerData .currentValue=
end
proc( LabelId : valId RegisterPair : registers i32 : opIndex CompilerContext ptr.mut : context -> ) =>: cacheVariable2
  context .variableLocations
    valId
    registers .hi NO_REG == if
      valId registers .low LabelAndReg new ValueLocation .localAndLowReg
    else registers .low NO_REG == _if
      valId registers .hi LabelAndReg new ValueLocation .localAndHiReg
    else
      registers ValueLocation .registers
    end
  map.put =:: prevLocation?
  ## remove previous location from register data
  prevLocation? optional.hasData and
      prevLocation? .data =:: prevLocation
      prevLocation .register ?? ! "CodeGen: multi register value not stored in single register" assert
      prevLocation .registers ?? if
    prevLocation .registers .low context resetRegisterById
    prevLocation .registers .hi context resetRegisterById
  end
  ## update register storage
  registers .low NO_REG != if
    registers .low context findRegister $ optional.hasData if .data =:: lowRegisterData
      opIndex lowRegisterData .lastUsed=
      lowRegisterData .currentValue [] .variableLow ?? ! or lowRegisterData .currentValue [] .variableLow valId != if
        lowRegisterData .currentValue [] .empty ?? "caching variable does not overwrite register" assert
        valId RegisterContent .variableLow lowRegisterData .currentValue=
      end
    else ..drop end
  end
  registers .hi NO_REG != if
    registers .hi context findRegister
      $ optional.isEmpty if ..drop return end
    .data =:: hiRegisterData
    opIndex hiRegisterData .lastUsed=
    hiRegisterData .currentValue [] .variableHi ?? ! or hiRegisterData .currentValue [] .variableHi valId != if
      hiRegisterData .currentValue [] .empty ?? "caching variable does not overwrite register" assert
      valId RegisterContent .variableHi hiRegisterData .currentValue=
    end
  end
end
proc( RegisterState : state -> RegisterState ) =>: resetRegister
  state
    RegisterContent .empty >$ .currentValue=
    -1 >$ .lastUsed=
  return
end
proc( RegisterId : regId CompilerContext ptr.mut : context -> ) =>: resetRegisterById
  regId context findRegister =:: regState?
  regState? optional.isEmpty if return end
  regState? .data [] resetRegister regState? .data =[]
end
proc( LabelId : valId CompilerContext ptr.mut : context -> ValueLocation ptr.mut optional ) =>: atCachedVarLocation
  context .variableLocations valId map.at
end
proc( LabelId : valId bool : isGlobal CompilerContext ptr.mut : context -> ValueLocation ) =>: getVarLocation
  context .variableLocations
    valId
  map.get =:: location?
  location? optional.hasData if
    ## TODO update dependent cache if multi-value cache is accessed after back-jump
    ##    * variable mutable -> removes all other cached values
    ##    * variable immutable -> removes all mutable cached values
    location? .data return
  end
  valId
    isGlobal if
      ValueLocation .globalMemory
    else
      ValueLocation .localMemory
    end
  return
end
proc( LabelId : valId CompilerContext ptr.mut : context -> ) =>: removeCachedVar
  context .variableLocations valId map.remove =:: removed?
  removed? optional.hasData if
    removed? .data switch
      register case removed? .data .register context resetRegisterById break
      localAndLowReg case removed? .data .localAndLowReg .reg context resetRegisterById break
      localAndHiReg case removed? .data .localAndHiReg .reg context resetRegisterById break
      globalAndLowReg case removed? .data .globalAndLowReg .reg context resetRegisterById break
      globalAndHiReg case removed? .data .globalAndHiReg .reg context resetRegisterById break
      registers case removed? .data .registers =:: regs
        regs .low context resetRegisterById
        regs .hi context resetRegisterById
        break
      ## nothing to do
      intArgument floatArgument compositeArgument localMemory localAddr globalMemory globalAddr
      intConstant floatConstant ptrConstant case break
    end
  end
end

proc(
  RegisterId : reg
  CompilerContext ptr.mut : context
-> RegisterState ptr.mut optional ) =>: findRegister ## TODO? better name
  reg NO_REG == if
    RegisterState ptr.mut optional.empty return
  end
  reg AMD64.dataRegIndex =:: regIndex
  regIndex 0 >= if
    context [] .dataRegisters regIndex @[] =:: regData
    reg regData .register= ## update register size
    regData optional.wrap return
  end
  RegisterState ptr.mut optional.empty return
end

proc(
  CompilerContext ptr.mut : context
-> ) =>: resetRegisters
  context [] .stack list.clear context .stack=
  context .variableLocations map.clear
  context .dataRegisters [] .length for =:: i
    context [] .dataRegisters i []
      resetRegister
    context [] .dataRegisters i =[]
  end
end

proc( i32 : stackSlot CompilerContext ptr.mut : context -> StackValue ptr.mut optional ) =>: stackSlotData
  stackSlot iSize cast.u context [] .stack .length u>= if
    StackValue ptr.mut optional.empty return
  end
  context [] .stack stackSlot list.at
end
proc(
  Atomic list
  RegisterState : regState
  ## TODO option to allow moving value to empty register (if available) instead of memory
  CompilerContext ptr.mut : context
-> Atomic list RegisterState ) =>: clearRegister
  ## save previous value
  regState .currentValue switch
    empty forceClear preserveValue case break
    stackSlot case
      regState .currentValue .stackSlot =:: stackSlot
      stackSlot context stackSlotData =:: stackData?
      stackData? optional.isEmpty if
        "CodeGen: stack access out of bounds":s Atomic .DebugError list.append
        regState resetRegister return
      end
      stackData? .data =:: stackData
      stackData [] .location switch
        register case
          stackData .location [] .register =:: register
          register regState .register != if
            "CodeGen: stack-data and register state out of sync":s Atomic .DebugError list.append
          end
          asm.OpType .MOVE
            stackSlot asm.Operand .stackData
            register asm.Operand .register
          context appendOp2
          StackValueLocation .memory stackData .location=
          break
        memory registers registerHi registerLow case
          "CodeGen: stack-data and register-states are out of sync":s Atomic .DebugError list.append
      end
      StackValueLocation .memory stackData .location=
      break
    stackSlotReference case
      "CodeGen: unimplemented: clear stack-reference":s Atomic .DebugError list.append
      break
    stackSlotHi case
      regState .currentValue .stackSlotHi =:: stackSlot
      stackSlot context stackSlotData =:: stackData?
      stackData? optional.isEmpty if
        "CodeGen: stack access out of bounds":s Atomic .DebugError list.append
        regState resetRegister return
      end
      stackData? .data =:: stackData
      stackData [] .location switch
        registerHi case
          stackData .location [] .registerHi =:: register
          register regState .register != if
            "CodeGen: stack-data and register state out of sync":s Atomic .DebugError list.append
          end
          asm.OpType .MOVE
            stackSlot asm.Operand .stackData128Hi
            register asm.Operand .register
          context appendOp2
          StackValueLocation .memory stackData .location=
          break
        registers case
          stackData .location [] .registers .hi regState .register != if
            "CodeGen: stack-data and register state out of sync":s Atomic .DebugError list.append
          end
          asm.OpType .MOVE
            stackSlot asm.Operand .stackData128Hi
            stackData .location [] .registers .hi asm.Operand .register
          context appendOp2
          stackData .location [] .registers .low StackValueLocation .registerLow stackData .location=
          break
        memory register registerLow case
          "CodeGen: stack-data and register-states are out of sync":s Atomic .DebugError list.append
      end
      StackValueLocation .memory stackData .location=
      break
    stackSlotLow case
      regState .currentValue .stackSlotLow =:: stackSlot
      stackSlot context stackSlotData =:: stackData?
      stackData? optional.isEmpty if
        "CodeGen: stack access out of bounds":s Atomic .DebugError list.append
        regState resetRegister return
      end
      stackData? .data =:: stackData
      stackData [] .location switch
        registerLow case
          stackData .location [] .registerLow =:: register
          register regState .register != if
            "CodeGen: stack-data and register state out of sync":s Atomic .DebugError list.append
          end
          asm.OpType .MOVE
            stackSlot asm.Operand .stackData128Low
            register asm.Operand .register
          context appendOp2
          StackValueLocation .memory stackData .location=
          break
        registers case
          stackData .location [] .registers .low regState .register != if
            "CodeGen: stack-data and register state out of sync":s Atomic .DebugError list.append
          end
          asm.OpType .MOVE
            stackSlot asm.Operand .stackData128Low
            stackData .location [] .registers .low asm.Operand .register
          context appendOp2
          stackData .location [] .registers .hi StackValueLocation .registerHi stackData .location=
          break
        memory register registerHi case
          "CodeGen: stack-data and register-states are out of sync":s Atomic .DebugError list.append
      end
      break
      ## TODO? check if correct value was removed
    variable case context .variableLocations regState .currentValue .variable map.remove ..drop break
    variableReference case
      context .variableLocations regState .currentValue .variableReference map.remove ..drop
      break
    variableHi variableLow case
      regState .currentValue .variableHi ?? if
        regState .currentValue .variableHi
      else
        regState .currentValue .variableLow
      end =:: varName
      context .variableLocations varName map.remove =:: prevValue?
      prevValue? optional.isEmpty if
        "CodeGen: stack-data and register state out of sync":s Atomic .DebugError list.append
        break
      end
      prevValue? .data =:: prevValue
      prevValue switch
        registers case
          context .variableLocations varName
            ## TODO distinguish local and global vars
            regState .currentValue .variableHi ?? if
              varName prevValue .registers .low LabelAndReg new ValueLocation .localAndLowReg
            else
              varName prevValue .registers .hi LabelAndReg new ValueLocation .localAndHiReg
            end
          map.put ..drop
          break
        localAndHiReg globalAndHiReg case
          regState .currentValue .variableHi ?? ! if ## hi-part <-> low part
            "CodeGen: stack-data and register state out of sync":s Atomic .DebugError list.append
          end
          break
        localAndLowReg globalAndLowReg case
          regState .currentValue .variableLow ?? ! if ## hi-part <-> low part
            "CodeGen: stack-data and register state out of sync":s Atomic .DebugError list.append
          end
          break
        default
          "CodeGen: stack-data and register state out of sync":s Atomic .DebugError list.append
          break
      end
      break
  end
  regState resetRegister
end


proc(
  Atomic list : ops
  i32 : opIndex
  RegisterState slice.mut : candidates
  CompilerContext ptr.mut : context
-> Atomic list RegisterId ) =>: nextFreeRegister
  candidates 0 @[] =::  mut: bestCandidate
  0:iSize =:: mut: candiateIndex
  1:iSize while $ candidates .length u< and bestCandidate [] .lastUsed 0 >= do =:: i
    candidates i [] .lastUsed bestCandidate [] .lastUsed < if
      candidates i @[] bestCandidate=
      i candiateIndex=
    end
  finally i 1:iSize + end ..drop
  ops
    ## clear values cache register
    bestCandidate [] context clearRegister bestCandidate =[]
    opIndex bestCandidate .lastUsed=
  bestCandidate [] .register return
end

proc(
  Atomic list
  ValType : valType
  i32 : opIndex
  CompilerContext ptr.mut : context
-> Atomic list RegisterId ) =>: nextRegister
  valType isMultiRegValType if
    "value does not fit into single register":s Atomic .DebugError list.append
    NO_REG return ## not a register
  end
  opIndex context [] .dataRegisters
    context [] .intDataRegCount valType isFloatValType if slice.tail else slice.head end
  context nextFreeRegister valType setRegType
end

proc( CompilerContext ptr.mut : context -> ) =>: printStack
  context [] .program .idContext .typeContext .labelContext =:: labelContext
  "--------------------------":s io.println
  char8 16 array : nameBuffer
  context [] .stack for =:: elt
    ## TODO? print val-type
    elt .location switch
      memory case "memory":s io.println break
      register case
        "register ":s io.print
        nameBuffer@ sb.wrapBuffer
          elt .location .register sb.appendRegister
        sb.asStr io.println break
      registerHi case
        "registers _:":s io.print
        nameBuffer@ sb.wrapBuffer
          elt .location .registerHi sb.appendRegister
        sb.asStr io.println break
      registerLow case
        "registers ":s io.print
        nameBuffer@ sb.wrapBuffer
          elt .location .registerLow sb.appendRegister
        sb.asStr io.print ":_":s io.println break
      registers case
        "registers ":s io.print
        nameBuffer@ sb.wrapBuffer
          elt .location .registers .low sb.appendRegister ':' sb.appendC
          elt .location .registers .hi sb.appendRegister
        sb.asStr io.println break
    end
  end
  "--------------------------":s io.println
end
proc( CompilerContext ptr.mut : context -> ) =>: printRegisters
  context [] .program .idContext .typeContext .labelContext =:: labelContext
  "--------------------------":s io.println
  context [] .dataRegisters for =:: regData
    regData .currentValue .empty ?? if continue end
    char8 8 array : nameBuffer
    nameBuffer@ sb.wrapBuffer
      regData .register sb.appendRegister
    sb.asStr io.print
    regData .currentValue switch
      variable case " var: ":s io.print regData .currentValue .variable labelContext id.getLabelName io.println break
      variableReference case
        " @var: ":s io.print regData .currentValue .variableReference labelContext id.getLabelName io.println break
      variableHi case " var.hi: ":s io.print regData .currentValue .variableHi labelContext id.getLabelName io.println break
      variableLow case " var.low: ":s io.print regData .currentValue .variableLow labelContext id.getLabelName io.println break
      stackSlot case " stack: ":s io.print regData .currentValue .stackSlot io.println break
      stackSlotReference case " @stack: ":s io.print regData .currentValue .stackSlotReference io.println break
      stackSlotHi case " stack.hi: ":s io.print regData .currentValue .stackSlotHi io.println break
      stackSlotLow case " stack.low: ":s io.print regData .currentValue .stackSlotLow io.println break
      forceClear case " force clear":s io.println break
      preserveValue case " preserve value":s io.println break
      empty case ..unreachable
    end
    regData .lastUsed io.println
  end
  "--------------------------":s io.println
end

proc( RegisterState slice.mut : buffer CompilerContext ptr.mut : context -> ) =>: rememberRegisters
  context [] .dataRegisters =:: regs
  buffer .length regs .length u>= "CodeGen: buffer large enough to store registers" assert
  buffer .data regs .data regs .length mem.copy ..drop ## copy register data
end
enum( MERGE MERGE_FALLTHROUGH RESET ) =:: RegisterRestoreMode
proc(
  Atomic list
  RegisterState slice.mut : buffer
  iSize : newStackSize
  RegisterRestoreMode : mode
  FilePosition : pos
  CompilerContext ptr.mut : context
-> Atomic list ) =>: restoreRegisters
  context [] .program =:: program
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  context [] .dataRegisters =:: regs
  false =:: mut: usedEmptyReg
  mode .RESET ?? if
    ## set stack-size
    ## TODO ensure procedure does not access valus in invalid state
    context [] .stack
      newStackSize list.setLength
    context .stack=
  else
    newStackSize context [] .stack .length != if
      "CodeGen: branches have same stack size" sb.copyPtr
      pos program .errors appendError
      context [] .stack
        newStackSize list.setLength
      context .stack=
    end
  end
  buffer .length regs .length u>= "CodeGen: buffer large enough to store registers" assert
  ## TODO? smarter algorithm (reduce number of moves)
  ## 1. clear all registers holding value not appearing in new state
  ##   -> more free registers, less unneccessary moves
  ## 2. move all values where source is register and target is currently free
  regs .length i32 cast for =:: i
    regs i [] .register isFloatReg =:: isFloat
    regs i [] .currentValue =:: currentValue
    buffer i [] .currentValue =:: expectedValue
    expectedValue currentValue RegisterContent.eq if ## already correct value in register
      expectedValue .empty ?? ! if
        buffer i [] .lastUsed
          mode .RESET ?? ! if regs i [] .lastUsed i32.max end
        regs i @[] .lastUsed= ## mark resister as used
      end
      continue
    end
    expectedValue .preserveValue ?? if
      continue
    end
    ## current value is wrong -> clear out register
    mode .RESET ?? if
      regs i [] resetRegister regs i =[]
    else expectedValue .empty ?? _if ## .forceClear is considered non-empty
      ## keep values in empty registers to avoid unnecessary moves
      currentValue .empty ?? ! usedEmptyReg=
    else currentValue .empty ?? ! _if
      -1 =:: mut: freeSlot
      isFloat if
        context [] .intDataRegCount regs .length i32 cast
      else
        0 context [] .intDataRegCount
      end =:: maxIndex =:: minIndex
      minIndex while $ maxIndex < do =:: j
        j i == if continue end
        ## TODO smarter algorithm
        ##  * move to correct buffer slot if currently empty
        ##  * prefer slots that empty in buffer
        regs j [] .currentValue .empty ?? if
          currentValue buffer j [] .currentValue RegisterContent.eq if
            ## expected target for value
            j freeSlot=
            j break
          else buffer j [] .currentValue .empty ?? or buffer j [] .currentValue .preserveValue ?? _if
            j freeSlot=
            j break
          else freeSlot -1 == _if
            j freeSlot=
          end
        end
      finally j 1 + end ..drop
      freeSlot 0 >= if
        regs freeSlot [] .register =:: mut: targetRegister
        regs i [] .register =:: srcRegister
        ## temporarily move value to free register
        currentValue regs freeSlot @[] .currentValue=
        regs i [] .lastUsed regs freeSlot @[] .lastUsed=
        currentValue switch
          variable case
            currentValue .variable idContext id.getIdentifier
              ! "CodeGen: identifier exists" assert
            =:: idData
            currentValue .variable context atCachedVarLocation .data =:: varLoc
            varLoc [] .register ?? ! or varLoc [] .register srcRegister != if
              "CodeGen: variable-cache and registers out of sync":s Atomic .DebugError list.append
            end
            idData [] .valueType typeContext toValType
              targetRegister $1 setRegType targetRegister=
            targetRegister varLoc .register=
            break
          variableReference case
            currentValue .variableReference idContext id.getIdentifier
              ! "CodeGen: identifier exists" assert
            =:: idData
            currentValue .variableReference context atCachedVarLocation .data =:: varLoc
            varLoc [] .register ?? ! or varLoc [] .register srcRegister != if
              "CodeGen: variable-cache and registers out of sync":s Atomic .DebugError list.append
            end
            ValType .REFERENCE
              targetRegister $1 setRegType targetRegister=
            targetRegister varLoc .register=
            break
          variableHi variableLow case
            currentValue .variableHi ?? if
              currentValue .variableHi
            else
              currentValue .variableLow
            end =:: varName
            varName idContext id.getIdentifier
              ! "CodeGen: identifier exists" assert
            =:: idData
            idData [] .valueType typeContext toValType
              currentValue .variableHi ?? if getHiValType else getLowValType end
              targetRegister $1 setRegType targetRegister=
             =:: valType
            varName context atCachedVarLocation .data =:: varLoc
            varLoc [] switch
              registers case
                currentValue .variableHi ?? if
                  targetRegister varLoc .registers .hi=
                else
                  targetRegister varLoc .registers .low=
                end
                break
              localAndHiReg case
                currentValue .variableHi ?? ! if
                  "CodeGen: variable-cache and registers out of sync":s Atomic .DebugError list.append
                end
                targetRegister varLoc .localAndHiReg .reg=
                break
              localAndLowReg case
                currentValue .variableLow ?? ! if
                  "CodeGen: variable-cache and registers out of sync":s Atomic .DebugError list.append
                end
                targetRegister varLoc .localAndLowReg .reg=
                break
              default
                "CodeGen: variable-cache and registers out of sync":s Atomic .DebugError list.append
                break
            end
            valType break
          stackSlotReference stackSlot case
            currentValue .stackSlotReference ?? if
              currentValue .stackSlotReference
            else
              currentValue .stackSlot
            end context stackSlotData =:: stackData?
            stackData? optional.isEmpty if
              "CodeGen: stack access out of bounds":s Atomic .DebugError list.append
              ValType .EMPTY break
            end
            stackData? .data =:: stackData
            stackData .location [] .register srcRegister != if
              "CodeGen: stack and registers out of sync":s Atomic .DebugError list.append
            end
            stackData [] .valType
            targetRegister $1 setRegType targetRegister=
            targetRegister stackData .location .register=
            break
          stackSlotHi stackSlotLow case
            currentValue .stackSlotHi ?? =:: isHi
            isHi if
              currentValue .stackSlotHi
            else
              currentValue .stackSlotLow
            end context stackSlotData =:: stackData?
            stackData? optional.isEmpty if
              "CodeGen: stack access out of bounds":s Atomic .DebugError list.append
              ValType .EMPTY break
            end
            stackData? .data =:: stackData
            stackData [] .valType
              isHi if getHiValType else getLowValType end
            =:: valType
            targetRegister valType setRegType targetRegister=
            stackData .location [] switch
              registers case
                isHi if
                  stackData .location [] .registers .hi srcRegister != if
                    "CodeGen: stack and registers out of sync":s Atomic .DebugError list.append
                  end
                  targetRegister stackData .location .registers .hi=
                else
                  stackData .location [] .registers .low srcRegister != if
                    "CodeGen: stack and registers out of sync":s Atomic .DebugError list.append
                  end
                  targetRegister stackData .location .registers .low=
                end
                break
              registerLow case
                isHi or stackData .location [] .registerLow srcRegister != if
                  "CodeGen: stack and registers out of sync":s Atomic .DebugError list.append
