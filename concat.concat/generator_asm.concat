import list
import string
import file
using std.literals.

import "program.concat"
import "measure.concat"
import "asm/asm.concat"
import "asm/amd64.concat"

enum( EMPTY BOOL I8 I16 I32 I64 F32 F64 POINTER PROC_POINTER ) =:: ValType
namespace: ValType
  proc( Type : t -> ValType ) =>: fromType
    t switch
      PrimitiveType .case switch
        BOOL I8 case ValType .I8 return
        I16 case ValType .I16 return
        I32 case ValType .I32 return
        I64 case ValType .I64 return
        F32 case ValType .F32 return
        F64 case ValType .F64 return
        TYPE case ValType .EMPTY return
      end break
      default "unsupported type" ..panic
    end
  end
  proc( ValType : valType -> bool ) =>: isInt
    valType switch
      BOOL I8 I16 I32 I64 POINTER PROC_POINTER case true return
      EMPTY F32 F64 case false return
    end
  end
  proc( ValType : valType -> bool ) =>: isFloat
    valType switch
      F32 F64 case true return
      EMPTY BOOL I8 I16 I32 I64 POINTER PROC_POINTER case false return
    end
  end
  proc( ValType : valType -> bool ) =>: isAddress
    valType switch
      POINTER PROC_POINTER case true return
      EMPTY BOOL I8 I16 I32 I64 F32 F64 case false return
    end
  end
end
struct(
  asm.Value : value
  ValType : valType
) =:: TypedValue
union(
  TypedValue : Val
  ( TypedValue TypedValue ) : Val2
  ( TypedValue TypedValue TypedValue ) : Val3
) =:: StackValue
namespace: StackValue
  proc( asm.Value : v ValType : t -> StackValue ) =>: val
    v t TypedValue new StackValue .Val
  end
  proc( asm.Value : v1 ValType : t1 asm.Value : v2 ValType : t2 -> StackValue ) =>: val2
    v1 t1 TypedValue new v2 t2 TypedValue new ( TypedValue TypedValue ) new StackValue .Val2
  end
  proc(
    asm.Value : v1 ValType : t1
    asm.Value : v2 ValType : t2
    asm.Value : v3 ValType : t3
  -> StackValue ) =>: val3
    v1 t1 TypedValue new
      v2 t2 TypedValue new
      v3 t3 TypedValue new
    ( TypedValue TypedValue TypedValue ) new StackValue .Val3
  end
  proc( StackValue -> TypedValue ) =>: get1
    switch
      Val .case return
      Val2 .case .0 return
      Val3 .case .0 return
    end
  end
  proc( StackValue -> TypedValue optional ) =>: get2
    switch
      Val case TypedValue optional.empty return
      Val2 .case .1 optional.wrap return
      Val3 .case .1 optional.wrap return
    end
  end
  proc( StackValue -> TypedValue optional ) =>: get3
    switch
      Val Val2 case TypedValue optional.empty return
      Val3 .case .2 optional.wrap return
    end
  end
end
struct(
  StackValue slice.mut : stack
) =:: RegisterState
struct(
  RegisterState : registerState
  i32 : asmLabel
) =:: LabelState
union(
  _ : None
  iSize : Stack
  iSize : Stack2
  iSize : Stack3
  LabelId : LocalVariable
  LabelId : GlobalVariable
  i32 : LocalMemory
) =:: ValueLocation
namespace: ValueLocation
  proc( ValueLocation : a ValueLocation : b -> bool ) =>: eq
    a ..label b ..label != if false return end
    a switch
      None case true return
      Stack .case b .Stack unionElement.unwrap == return
      Stack2 .case b .Stack2 unionElement.unwrap == return
      Stack3 .case b .Stack3 unionElement.unwrap == return
      LocalVariable .case b .LocalVariable unionElement.unwrap == return
      GlobalVariable .case b .LocalVariable unionElement.unwrap == return
      LocalMemory .case b .LocalMemory unionElement.unwrap == return
    end
  end
end
union(
  _ : None
  ValueLocation : Val
  ( ValueLocation ValueLocation ) : Val2
  ValueLocation list : Vals
) =:: RegisterUse
struct(
  RegisterUse : uses
  bool : moving
) =:: RegisterInfo
struct(
  ValueLocation : permanentLocation
  ValueLocation : cachedLocation
) =:: VariableLocation
struct(
  ProgramContext ptr.mut : program
  asm.Context : asmContext
  LocalLabelId LabelState hashMap : labelStates
  asm.RegisterId RegisterInfo hashMap : registerInfo
  LabelId VariableLocation hashMap : variableInfo
  asm.RegisterId list : availableIntRegisters
  asm.RegisterId list : availableFloatRegisters
  asm.Atom list : tmpOps
  StackValue list : stack
  i32 : labelCount
  bool : reachable
) =:: CompilerContext

proc( asm.RegisterId : regId CompilerContext ptr.mut : context -> ) =>: usedRegister
  regId context [] .asmContext .isIntRegister () if
    context [] .availableIntRegisters
      regId list.removeValue ..drop
    context .availableIntRegisters=
  else
    context [] .availableFloatRegisters
      regId list.removeValue ..drop
    context .availableFloatRegisters=
  end
end
proc( asm.RegisterId : regId CompilerContext ptr.mut : context -> ) =>: freeRegister
  regId context [] .asmContext .isIntRegister () if
    context [] .availableIntRegisters
      $ list.asSlice regId slice.contains ! if
        regId list.append
      end
    context .availableIntRegisters=
  else
    context [] .availableFloatRegisters
      $ list.asSlice regId slice.contains ! if
        regId list.append
      end
    context .availableFloatRegisters=
  end
end
proc( asm.RegisterId : regId ValueLocation : loc CompilerContext ptr.mut : context -> ) =>: addLocation
  loc .None ? if return end
  context .registerInfo regId map.at .else
    context .registerInfo regId loc RegisterUse .Val false RegisterInfo new map.put ..drop
    regId context usedRegister
    return
  end =:: regInfo
  regInfo [] .uses switch
    None case
      loc RegisterUse .Val
      regId context usedRegister
    break
    Val .case loc ( ValueLocation ValueLocation ) new RegisterUse .Val2 break
    Val2 .case =:: vals
      8 ValueLocation list.create
        vals .0 list.append
        vals .1 list.append
        loc list.append
      RegisterUse .Vals
    break
    Vals .case
      loc list.append RegisterUse .Vals
    break
  end regInfo .uses=
end
proc( asm.RegisterId : regId ValueLocation : loc CompilerContext ptr.mut : context -> ) =>: removeLocation
  loc .None ? if return end
  context .registerInfo regId map.at .else
    return
  end =:: regInfo
  regInfo [] .uses switch
    None case return
    Val .case =:: oldVal
      oldVal loc ValueLocation.eq if
        regId context freeRegister
        RegisterUse .None
      else
        oldVal RegisterUse .Val
      end
    break
    Val2 .case =:: oldVals
      oldVals .0 loc ValueLocation.eq if
        oldVals .1 RegisterUse .Val
      else oldVals .1 loc ValueLocation.eq _if
        oldVals .0 RegisterUse .Val
      else
        oldVals RegisterUse .Val2
      end
    break
    Vals .case
      loc ValueLocation.eq@ list.removeValue if
        $ .length 0 == if
          list.free ..drop
          regId context freeRegister
          RegisterUse .None
        else $ .length 1 == _if
          $ 0 [] RegisterUse .Val
          >$ list.free ..drop
        else
          RegisterUse .Vals
        end
      else
        RegisterUse .Vals
      end
    break
  end regInfo .uses=
  ## TODO! support removing register location
  ## TODO make available once there are no more locations in use
end
proc( TypedValue : val ValueLocation : loc CompilerContext ptr.mut : context -> ) =>: copyValueElt
  val .value .Register .if
    loc context addLocation
  else ..drop end
end
proc( TypedValue : val ValueLocation : loc CompilerContext ptr.mut : context -> ) =>: discardValueElt
  val .value .Register .if
    loc context removeLocation
  else ..drop end
end
## TODO? generic procedure for applying proc to all elements of StackValue
proc( StackValue : val ValueLocation : loc CompilerContext ptr.mut : context -> ) =>: copyValue
  val switch
    Val .case loc context copyValueElt break
    Val2 .case
      $ .0 loc context copyValueElt
      .1 loc .Stack .if ValueLocation .Stack2 end context copyValueElt
    break
    Val3 .case
      $ .0 loc context copyValueElt
      $ .1 loc .Stack .if ValueLocation .Stack2 end context copyValueElt
      .2 loc .Stack .if ValueLocation .Stack3 end context copyValueElt
    break
  end
end
proc( StackValue : val ValueLocation : loc CompilerContext ptr.mut : context -> ) =>: discardValue
  val switch
    Val .case loc context discardValueElt break
    Val2 .case
      $ .0 loc context discardValueElt
      .1 loc .Stack .if ValueLocation .Stack2 end context discardValueElt
    break
    Val3 .case
      $ .0 loc context discardValueElt
      $ .1 loc .Stack .if ValueLocation .Stack2 end context discardValueElt
      .2 loc .Stack .if ValueLocation .Stack3 end context discardValueElt
    break
  end
end

proc( ConstValue : constant ValType : valType  CompilerContext ptr.mut : context -> ) =>: pushConstant
  context [] .stack
    constant switch
      Bool .case
        ?1 i64 cast.u asm.Value .Int valType StackValue.val list.append
      break
      Char .case
        i64 cast.u asm.Value .Int valType StackValue.val list.append
      break
      Int .case
        asm.Value .Int valType StackValue.val list.append
      break
      Float .case
        asm.Value .Float valType StackValue.val list.append
      break
      default "unsupported value-constant" ..panic
    end
  context .stack=
end

proc( asm.RegisterId ValType : valType CompilerContext ptr.mut : context -> asm.RegisterId ) =>: setRegSize
  ## TODO: make sizes for bool & pointer target specific
  valType switch
    EMPTY case return
    BOOL case asm.RegisterId.SIZE_8 break
    I8 case asm.RegisterId.SIZE_8 break
    I16 case asm.RegisterId.SIZE_16 break
    I32 F32 case asm.RegisterId.SIZE_32 break
    I64 F64 case asm.RegisterId.SIZE_64 break
    POINTER PROC_POINTER case asm.RegisterId.SIZE_64 break
  end asm.RegisterId.setSize
end
proc( ValType : valType CompilerContext ptr.mut : context -> asm.RegisterId ) =>: nextFreeRegister
  ## TODO correctly find free registers
  valType ValType.isInt if
    context [] .availableIntRegisters list.pop .if
      >$ context .availableIntRegisters=
      valType context setRegSize return
    end
    "unimplemented: freeing reigister" ..panic
  else valType ValType.isFloat _if
    context [] .availableFloatRegisters list.pop .if
      >$ context .availableFloatRegisters=
      valType context setRegSize return
    end
    "unimplemented: freeing reigister" ..panic
  end
  "unsupported value for register" ..panic
end

proc( CompilerContext ptr.mut : context -> i32 ) =>: nextLocalLabel
  context [] .labelCount
    $ 1 + context .labelCount=
  return
end

proc(
  ProcedureImpl : procImpl
  CompilerContext ptr.mut : context
-> string ) =>: getProcName
  context [] .program =:: program
  program .errors =:: errors
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  ## TODO correctly mangle procedure names
  program [] .procedures procImpl .procId iSize cast.u [] .labelId labelContext id.getLabelName
end

proc(
  asm.Atom list
  ValType : moveType
  asm.Value : dst
  asm.Value : src
  CompilerContext ptr.mut : context
-> asm.Atom list ) =>: opMove
  context .asmContext .targetId switch
    AMD64 case
      moveType ValType.isInt if
        AMD64.op.MOV
          dst .Register .if
            src .Register .if
              asm.op2
            else .Int ._if
              asm.op2
            else
              "unsupported source for mov" ..panic
            end
          else
            "can only move to register" ..panic ## TODO support move to memory
          end
        list.append return
      end
    break
  end
  "unimplemented configuration for: mov" ..panic
end

proc(
  asm.Atom list
  ValType : argType
  FilePosition ptr : pos
  CompilerContext ptr.mut : context
-> asm.Atom list asm.RegisterId asm.Value ) =>: amd64GetBinOpArgs
  ## TODO? extend registers to 32-bit for arithmetic operations to prevent partial register write
  pos context popValue
    .and .Val .else "expected single value" ..panic end
  .value =:: arg2 ## TODO! ensure that arg2 is not overwritten by move to register
  pos context popValue
    .and .Val .else "expected single value" ..panic end
  ValueLocation .None context moveToRegister =:: arg1
  arg1 arg2
end
enum( ADD SUB MUL ) =:: BinOp
{ AMD64.op.ADD AMD64.op.SUB AMD64.op.IMUL } =:: AMD64_BIN_OPS
proc( BinOp : op -> asm.OpCode ) =>: binOpCodeAMD64
  AMD64_BIN_OPS op ..label iSize cast.u []
end
## TODO! check stack-size before bin-op / cmp
proc(
  asm.Atom list
  ValType : argType
  BinOp : opType
  FilePosition ptr : pos
  CompilerContext ptr.mut : context
-> asm.Atom list ) =>: opBinOp
  context .asmContext .targetId switch
    AMD64 case
      argType pos context amd64GetBinOpArgs =:: arg2 =:: arg1
      ## TODO: prefer arg1 as dst if register is available
      ## TODO: ensure that arg2 is not used as dst for 2-argument op-codes (lea can be used as 3-operand add: `lea dst, [arg1+arg2]`)
      argType context nextFreeRegister =:: dst
      ## TODO? create proc for nextReg+push
      dst asm.Value .Register argType StackValue.val context pushValue
      arg1 dst != if
        AMD64.op.MOV dst arg1 asm.op2 list.append
      end
      argType ValType.isInt if
        opType binOpCodeAMD64
          dst
          arg2 .Register .if
            asm.op2
          else .Int ._if
            asm.op2
          else
            "unsupported arg for binary-operation" ..panic
          end
        list.append
        return
      end
    break
  end
  "unimplemented configuration for: cmp" ..panic
end
enum( EQ NE LT LE GE GT ULT ULE UGE UGT ) =:: CmpType
proc(
  asm.Atom list
  ValType : argType
  CmpType : cmpType
  FilePosition ptr : pos
  CompilerContext ptr.mut : context
-> asm.Atom list ) =>: opCmp
  context .asmContext .targetId switch
    AMD64 case
      argType pos context amd64GetBinOpArgs =:: arg2 =:: arg1
      ValType .BOOL context nextFreeRegister =:: dst
      dst asm.Value .Register ValType .BOOL StackValue.val context pushValue
      ## TODO? option to merge cmp+jump
      argType ValType.isInt if
        AMD64.op.CMP
          arg1
          arg2 .Register .if
            asm.op2
          else .Int ._if
            asm.op2
          else
            "unsupported arg for cmp" ..panic
          end
        list.append
        ## TODO? use "xor, cmp, set" instead of "cmp, set, movzx" if dst does not overlap arg
        AMD64.op.SETGT dst asm.op1 list.append
        AMD64.op.MOVZX dst $ asm.RegisterId.SIZE_32 asm.RegisterId.setSize >$ asm.op2 list.append
        return
      end
    break
  end
  "unimplemented configuration for: cmp" ..panic
end

proc(
  asm.Atom list
  TypedValue : val
  ValueLocation : loc
  CompilerContext ptr.mut : context
-> asm.Atom list asm.RegisterId ) =>: moveToRegister
  val .value .Register .if return else ..drop end
  val .valType context nextFreeRegister =:: reg
  reg loc context addLocation
  ## TODO update register-id size for returned register
  val .valType reg asm.Value .Register val .value context opMove
  reg return
end
proc(
  asm.Atom list
  TypedValue : val
  ValueLocation : loc
  CompilerContext ptr.mut : context
-> asm.Atom list TypedValue ) =>: freezeTypedValue
  val .value switch
    None case "unsupported value" ..panic
    Int case
      val loc context moveToRegister asm.Value .Register
    break
    Float case "unsupported value" ..panic
    Register .case =:: regId
      ## TODO! ensure register is unique
      val .value
    break
  end val .value=
end
proc(
  asm.Atom list
  CompilerContext ptr.mut : context
-> asm.Atom list RegisterState ) =>: rememberState
  ## TODO ensure all values are in (unique) register or memory
  context [] .stack .length for =:: i
    context [] .stack i [] switch
      Val .case
        i ValueLocation .Stack context freezeTypedValue
      StackValue .Val break
      Val2 .case
        >$ $1 .0 i ValueLocation .Stack context freezeTypedValue >>$ .0=
        >$ $1 .1 i ValueLocation .Stack2 context freezeTypedValue >>$ .1=
      StackValue .Val2 break
      Val3 .case
        >$ $1 .0 i ValueLocation .Stack context freezeTypedValue >>$ .0=
        >$ $1 .1 i ValueLocation .Stack2 context freezeTypedValue >>$ .1=
        >$ $1 .2 i ValueLocation .Stack3 context freezeTypedValue >>$ .2=
      StackValue .Val3 break
    end context [] .stack i =[]
  end
  context [] .stack list.asSlice slice.copy RegisterState new
end
proc(
  RegisterState : state
  CompilerContext ptr.mut : context
-> ) =>: resetState
  context [] .stack list.clear context .stack=
  state .stack for context pushValue end
end
proc(
  ValueLocation : location
  CompilerContext ptr.mut : context
-> TypedValue optional ) =>: findStorageLocation
  location switch
    None case TypedValue optional.empty return
    Stack .case =:: index
      context [] .stack index list.get .else
        TypedValue optional.empty return
      end StackValue.get1 optional.wrap
    return
    Stack2 .case =:: index
      context [] .stack index list.get .else
        TypedValue optional.empty return
      end StackValue.get2
    return
    Stack3 .case =:: index
      context [] .stack index list.get .else
        TypedValue optional.empty return
      end StackValue.get3
    return
    LocalVariable GlobalVariable LocalMemory case
      "unsupported value location" ..panic
  end
end
proc(
  ValueLocation : location
  RegisterState : targetState
-> TypedValue optional ) =>: findTargetStorageLocation
  location switch
    None case TypedValue optional.empty return
    Stack .case =:: index
      targetState .stack index slice.get .else
        TypedValue optional.empty return
      end StackValue.get1 optional.wrap
    return
    Stack2 .case =:: index
      targetState .stack index slice.get .else
        TypedValue optional.empty return
      end StackValue.get2
    return
    Stack3 .case =:: index
      targetState .stack index slice.get .else
        TypedValue optional.empty return
      end StackValue.get3
    return
    LocalVariable GlobalVariable LocalMemory case
      "unsupported value location" ..panic
  end
end
proc(
  asm.Atom list
  ValueLocation : loc
  TypedValue : src
  TypedValue : dst
  RegisterState : targetState
  FilePosition ptr : pos
  CompilerContext ptr.mut : context
-> asm.Atom list ) =>: restoreValue
  context [] .program =:: program
  program .errors =:: errors
  src .valType dst .valType != if
    "stack-values are out of sync" sb.copyPtr pos errors appendError
    return
  end
  src .value dst .value asm.Value.equal if
    return ## nothing to do if values are equal
  end
  ## 2. mark value as moving
  src .value .Register .if =:: srcReg
    context .registerInfo srcReg map.at .if
      true >$ .moving= ## TODO mark register as no longer moving once move is complete
    end
  else .Int ? ! and src .value .Float ? ! _if
    "unsupported source value: " sb.copyPtr
      dst .value context [] .asmContext asm.appendValue
    pos errors appendError
  end
  dst .value .Register .if =:: dstReg
    ## 3. clear destination slot if neccessary (detect move-loops)
    context .registerInfo dstReg map.at .if =:: regInfo
      regInfo [] .moving if
        ## TODO! update Value Locations
        ## moveValue function that
        ## 1. moves value
        ## 2. updates locations
        ## 3. clears moving flag on source value
        src .valType
          src .valType context nextFreeRegister asm.Value .Register
          src .value
        context opMove
        false regInfo .moving=
        return
      end
      regInfo [] .uses switch
        None case break
        Val .case =:: regUse
          regUse targetState findTargetStorageLocation .if =:: dstTarget
            regUse dst dstTarget targetState pos context restoreValue
            ## TODO update source register location
          end
        break
        default ## TODO for multi-use: pick most convenient target among uses
          "multi-use registers are not yet supported" sb.copyPtr
            dst .value context [] .asmContext asm.appendValue
          pos errors appendWarning
        break
      end
    end
  else ..drop
    "unsupported destination value: " sb.copyPtr
      dst .value context [] .asmContext asm.appendValue
    pos errors appendError
  end
  ## 4. move to destination
  ## TODO! update Value Locations
  src .valType dst .value src .value context opMove
end
proc(
  asm.Atom list
  RegisterState : state
  FilePosition ptr : pos
  CompilerContext ptr.mut : context
-> asm.Atom list ) =>: restoreState
  context [] .program =:: program
  program .errors =:: errors
  state .stack =:: oldStack
  context .stack [] .length oldStack .length != if
    "register-states out of sync" sb.copyPtr pos errors appendError
    state context resetState return
  end
  oldStack .length for =:: i
    oldStack i [] =:: targetVal
    context [] .stack i [] =:: srcVal
    srcVal ..label targetVal ..label != if
      "stack-values are out of sync" sb.copyPtr pos errors appendError
      state context resetState return
    end
    srcVal switch
      Val .case =:: srcElt
        i ValueLocation .Stack srcElt targetVal .Val unionElement.unwrap state pos context restoreValue
      break
      Val2 .case =:: srcElts
        targetVal .Val2 unionElement.unwrap =:: targetElts
        i ValueLocation .Stack srcElts .0 targetElts .0 state pos context restoreValue
        i ValueLocation .Stack2 srcElts .1 targetElts .1 state pos context restoreValue
      break
      Val3 .case =:: srcElts
        targetVal .Val3 unionElement.unwrap =:: targetElts
        i ValueLocation .Stack srcElts .0 targetElts .0 state pos context restoreValue
        i ValueLocation .Stack2 srcElts .1 targetElts .1 state pos context restoreValue
        i ValueLocation .Stack3 srcElts .2 targetElts .2 state pos context restoreValue
      break
    end
  end
end
proc(
  asm.Atom list
  LocalLabelId : labelId
  FilePosition ptr : pos
  CompilerContext ptr.mut : context
-> asm.Atom list i32 ) =>: syncLabelState
  context .labelStates labelId map.get .else
    context rememberState =:: regState
    context nextLocalLabel =:: asmLabel
    context .labelStates
      labelId
      regState asmLabel LabelState new
    map.put ..drop
    asmLabel return
  end =:: labelState
  context [] .reachable if
    labelState .registerState pos context restoreState
  else
    labelState .registerState context resetState
  end
  labelState .asmLabel
end

proc(
  FilePosition ptr : pos
  CompilerContext ptr.mut : context
-> StackValue optional ) =>: popValue
  context [] .program =:: program
  program .errors =:: errors
  context [] .stack list.pop >$ context .stack= .else
    "stack underflow" sb.copyPtr pos errors appendError
    StackValue optional.empty return
  end =:: popped
  context [] .stack .length ValueLocation .Stack =:: valLoc
  popped valLoc context discardValue
  popped optional.wrap
end
proc(
  StackValue : value
  CompilerContext ptr.mut : context
-> ) =>: pushValue
  context [] .stack .length ValueLocation .Stack =:: valLoc
  context [] .stack
    value list.append
  context .stack=
  value valLoc context copyValue
end
proc(
  i32 : index
  CompilerContext ptr.mut : context
-> StackValue optional ) =>: peekValue
  context [] .stack $ .length 1 - index iSize cast.u - list.get
end

proc(
  asm.Atom list
  BuiltIn : builtIn
  FilePosition ptr : pos
  CompilerContext ptr.mut : context
-> asm.Atom list ) =>: compileBuiltIn
  context [] .program =:: program
  program .errors =:: errors
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  ## TODO reduce amount of duplicate code needed to handle built-ins
  builtIn switch
    GT_I32 case ValType .I32 CmpType .GT pos context opCmp return
    GT_I64 case ValType .I64 CmpType .GT pos context opCmp return
    ADD_I32 case ValType .I32 BinOp .ADD pos context opBinOp return
    ADD_I64 case ValType .I64 BinOp .ADD pos context opBinOp return
    SUB_I32 case ValType .I32 BinOp .SUB pos context opBinOp return
    SUB_I64 case ValType .I64 BinOp .SUB pos context opBinOp return
    default break
  end
  "unsupported built-in: " sb.copyPtr
    builtIn sb.appendBuiltIn
  pos errors appendError
end
proc(
  asm.Atom list
  Operation ptr : op
  i32 : opIndex
  CompilerContext ptr.mut : context
-> asm.Atom list ) =>: compileOp
  context [] .program =:: program
  program .errors =:: errors
  program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  op .val switch
    NOP case return
    Constant .case [] op [] .dataType ValType.fromType context pushConstant return
    BuiltIn .case [] op [] .pos context compileBuiltIn return
    ImplementProcedure .case [] =:: implId
      implId context getProcName asm.enter list.append
      program [] .procedures implId .procId iSize cast.u @[] =:: procData
      procData .implementation .Code .else
        "only code-procs should have impl-id" ..panic
      end =:: procImpl
      implId .implementationId 0 >= if
        procImpl [] .implementations implId .implementationId @[] =:: procInfo
        procInfo [] .procType procInfo [] .variables
      else
        procData [] .procType procImpl [] .variables
      end =:: variables =:: procType
      ## TODO? remember memory-slot info
      0 variables for =:: var =:: i
        context .variableInfo var .label
          ## VariableLocation
            i ValueLocation .LocalMemory
            ValueLocation .None
          VariableLocation new
        map.put ..drop
      finally i 1 + end ..drop
      ## move procedure args into stack-slots/memory
      procType typeContext types.getProcIn .else
        "proc without in" ..panic
      end =:: inTypes
      ## TODO correctly handle (target specific) calling convention
      0 =:: mut: intCount
      0 =:: mut: floatCount
      inTypes .length 1 - while $ 0 iSize.sge do =:: i
        inTypes i [] ValType.fromType =:: argValType
        procType i i32 cast.u typeContext types.getProcArgLabel =:: argLabel
        argValType ValType.isInt if
          intCount AMD64.reg.intArg .if
            argValType context setRegSize asm.Value .Register argValType StackValue.val
          else
            "memory arguments are not supported" ..panic
          end
          intCount 1 + intCount=
        else argValType ValType.isFloat _if
          floatCount AMD64.reg.floatArg .if
            argValType context setRegSize asm.Value .Register argValType StackValue.val
          else
            "memory arguments are not supported" ..panic
          end
          floatCount 1 + floatCount=
        else
          "unsupported valType" ..panic
        end =:: argValue
        context .variableInfo argLabel map.at .if =:: argVar
          "unimplemented: named arguments" ..panic
        else ## variable does not exist
          argValue context pushValue
        end
      finally i 1 - end ..drop
    return
    LocalLabel .case =:: labelInfo
      labelInfo .labelType switch
        HINT_START case return
        HINT_END case
          context .labelStates labelInfo [] .labelId map.remove ..drop
        return
        LABEL_START LABEL_END LABEL_MIDDLE case break
      end
      labelInfo [] .labelId op [] .pos context syncLabelState asm.localLabel list.append
      true context .reachable=
      labelInfo .labelType [] .LABEL_END if
        context .labelStates labelInfo [] .labelId map.remove ..drop
      end
    return
    LocalJump .case =:: labelInfo
      ## TODO make jump-code target independent? prepare-jump / jump procedures
      labelInfo [] .cmpType switch
        NONE case break
        TRUE FALSE case
          op [] .pos context popValue
            .and .Val .else "expected single value" ..panic end
          ValueLocation .None context moveToRegister asm.RegisterId.SIZE_8 | =:: arg
          AMD64.op.TEST arg arg asm.op2 list.append
        break
        EQ NE LT LE GE GT ULT ULE UGE UGT case
          op [] .dataType ValType.fromType =:: argType
          ## TODO merge duplicate code with opCmp
          argType op [] .pos context amd64GetBinOpArgs =:: arg2 =:: arg1
          ## TODO! handle float compare (! use comiss + ja/jb)
          AMD64.op.CMP
            arg1
            arg2 .Register .if
              asm.op2
            else .Int ._if
              asm.op2
            else
              "unsupported arg for cmp" ..panic
            end
          list.append
        break
      end
      labelInfo [] .labelId op [] .pos context syncLabelState =:: jumpLabel
      labelInfo [] .cmpType switch
        NONE case AMD64.op.JMP break
        TRUE case AMD64.op.JNZ break
        FALSE case AMD64.op.JZ break
        EQ case AMD64.op.JEQ break
        NE case AMD64.op.JNE break
        LT case AMD64.op.JLT break
        LE case AMD64.op.JLE break
        GE case AMD64.op.JGE break
        GT case AMD64.op.JGT break
        default "unimplemented: jump-type" ..panic break
      end jumpLabel asm.LocalLabel cast asm.op1 list.append
      labelInfo .cmpType [] .NONE ! context .reachable=
    return
    BlockEnd .case .blockType .PROCEDURE if
       asm.endProc list.append return
    end break
    Return case
      ## TODO ensure return values are in correct registers
      asm.leave list.append
      false context .reachable=
    return
    StackMod .case =:: modData
      modData [] .modType switch
        COPY case
          modData [] .n context peekValue .else
            "stack underflow" sb.copyPtr op [] .pos errors appendError
            return
          end context pushValue
        return
        ROTATE case
          modData [] .n =:: offset
          offset i32.abs 1 + =:: eltCount
          context [] .stack .length eltCount iSize cast.u u< if
            "CodeGen: stack underflow in rotate, stackSize: " sb.copyPtr
              context [] .stack .length sb.appendI
            op [] .pos errors appendError
            return
          end
          eltCount 3 <= if
            StackValue 3 array : buffer
            buffer@ list.wrapBuffer
          else
            eltCount StackValue list.create
          end
            eltCount for ..drop
              op [] .pos context popValue .else
                "stack underflow" ..panic ## should not be rechached due to pre-checking size
              end list.append
            end
            offset 0 > if
              list.removeLast =:: lowValue
              $ .length for ..drop
                list.removeLast context pushValue
              end
              lowValue context pushValue
            else
              $ 0 [] context pushValue
              $ .length 1:iSize - for ..drop
                list.removeLast context pushValue
              end
            end
          list.free ..drop
        return
        DROP case
          modData [] .n for ..drop
            op [] .pos context popValue ..drop
          end
        return
      end
    break
    default break
  end
  "unsupported operation: " sb.copyPtr
    op [] program sb.appendOp
  op [] .pos errors appendError
end

proc( CompilerContext ptr.mut : context -> asm.Atom list ) =>: beginProcedure
  context [] .stack list.clear context .stack=
  context .labelStates map.clear
  context .registerInfo map.clear
  context .variableInfo map.clear
  context [] .availableIntRegisters list.clear
    AMD64.reg.GP_INT_REGISTERS list.appendSlice
  context .availableIntRegisters=
  context [] .availableIntRegisters list.reverse
  context [] .availableFloatRegisters
    AMD64.reg.FLOAT_REGISTERS list.appendSlice
  context .availableFloatRegisters=
  context [] .availableFloatRegisters list.reverse
  context [] .tmpOps list.clear
  true context .reachable=
  asm.Atom list.emptyNoReallloc context .tmpOps= ## ensure tmp-ops on compiler are not modified while on stack
end
proc(
  asm.Atom list : code
  asm.Atom list : procOps
  CompilerContext ptr.mut : context
-> asm.Atom list ) =>: finishProcedure
  code
    ## TODO post-processing (proc-header / update references / proc epilogoue)
    procOps for
      list.append
    end
    procOps context .tmpOps=
  return
end

proc( file.File : target ProgramContext ptr.mut : program -> file.File ) =>: export: compileToASM
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  ## CompilerContext
    program
    AMD64.asmContext
    LocalLabelId.hash@ LocalLabelId.eq@ 512 LabelState map.create
    ( asm.RegisterId -> i32 ) => asm.RegisterId.BASE_SHIFT >>> i32 cast end
      ( asm.RegisterId asm.RegisterId -> bool ) =>
        asm.RegisterId.BASE_MASK & >$ asm.RegisterId.BASE_MASK &
        ==
      end
      64
    RegisterInfo map.create
    labelHash@ labelEq@ 1024 VariableLocation map.create
    asm.RegisterId list.empty
    asm.RegisterId list.empty
    1024 asm.Atom list.create
    64 StackValue list.create
    0
    false
  CompilerContext new =:: mut: contextData
  contextData@ =:: context
  ## TODO? compile procedures seperately
  1024 asm.Atom list.create
    program [] .procedures for =:: proc
      proc .implementation .Code .else ..drop continue end =:: impl
      impl .codeState .UNUSED if continue end
      impl .codeState .COMPILED if
        context beginProcedure
          impl .code .length for i32 cast.u =:: opIndex
            impl .code opIndex @[] opIndex context compileOp
          end
        context finishProcedure
      end
      impl .implementations for =:: genericImpl
        genericImpl .codeState .COMPILED if
          context beginProcedure
            genericImpl .code .length for i32 cast.u =:: opIndex
              genericImpl .code opIndex @[] opIndex context compileOp
            end
          context finishProcedure
        end
      end
    end
  =:: ops
  target
    ops .length 8 * sb.create
      ops for
        contextData .asmContext asm.appendAtom
      end
      >$ $1 sb.asStr file.write <$
    sb.free ..drop
    ops list.free ..drop
    ## TODO cleanup context
  return
end
