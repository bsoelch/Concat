end

proc( Type : ptrType ConstValue : val CompilerContext ptr.mut : context -> i32 ) =>: newPtrConstant
  context [] .pointerConstants
    $ .length =:: constId
    val ptrType PointerConstant new list.append
  context .pointerConstants=
  constId return
end

proc( LabelId : valId RegisterId : register i32 : opIndex CompilerContext ptr.mut : context -> ) =>: cacheVariable
  context .variableLocations
    valId
    register ValueLocation .register
  map.put =:: prevLocation?
  ## remove previous location from register data
  prevLocation? optional.hasData and
      prevLocation? .data =:: prevLocation
      prevLocation .registers ?? ! "CodeGen: single register value not stored inregister pair" assert
      prevLocation .register ?? and
      prevLocation .register context findRegister =:: prevRegisterData?
      prevRegisterData? optional.hasData if
    prevRegisterData? .data =:: prevRegisterData
    prevRegisterData [] resetRegister prevRegisterData =[]
  end
  ## update register storage
  register context findRegister
    $ optional.isEmpty if ..drop return end
  .data =:: registerData
  opIndex registerData .lastUsed=
  registerData .currentValue .empty ?? "caching variable does not overwrite register" assert
  valId RegisterContent .variable registerData .currentValue=
end
proc( LabelId : valId RegisterPair : register i32 : opIndex CompilerContext ptr : context -> ) =>: cacheVariable2
  ## TODO cache double-register value
  "CodeGen: unimplemented" ..panic
end
proc( RegisterState : state -> RegisterState ) =>: resetRegister
  state
    RegisterContent .empty >$ .currentValue=
    -1 >$ .lastUsed=
  return
end
proc( LabelId : valId CompilerContext ptr.mut : context -> ValueLocation ptr.mut optional ) =>: atCachedVarLocation
  context .variableLocations valId map.at
end
proc( LabelId : valId bool : isGlobal CompilerContext ptr.mut : context -> ValueLocation ) =>: getVarLocation
  context .variableLocations
    valId
  map.get =:: location?
  location? optional.hasData if
    ## TODO update dependent cache if multi-value cache is accessed after back-jump
    ##    * variable mutable -> removes all other cached values
    ##    * variable immutable -> removes all mutable cached values
    location? .data return
  end
  valId
    isGlobal if
      ValueLocation .globalMemory
    else
      ValueLocation .localMemory
    end
  return
end
proc( LabelId : valId CompilerContext ptr.mut : context -> ) =>: removeCachedVar
  context .variableLocations valId map.remove =:: removed?
  removed? optional.hasData if
    removed? .data switch
      register case removed? .data .register context findRegister =:: prevRegisterData?
        prevRegisterData? optional.hasData if
          prevRegisterData? .data =:: prevRegisterData
          prevRegisterData [] resetRegister prevRegisterData =[]
        end
        break
      registerHi registerLow registers case "CodeGen: multi-register values are not implemented" ..panic
      ## nothing to do
      intArgument floatArgument localMemory localAddr globalMemory globalAddr intConstant floatConstant ptrConstant case break
    end
  end
end

proc(
  RegisterId : reg
  CompilerContext ptr.mut : context
-> RegisterState ptr.mut optional ) =>: findRegister ## TODO? better name
  reg NO_REG == if
    RegisterState ptr.mut optional.empty return
  end
  reg AMD64.dataRegIndex =:: regIndex
  regIndex 0 >= if
    context [] .dataRegisters regIndex @[] =:: regData
    reg regData .register= ## update register size
    regData optional.wrap return
  end
  RegisterState ptr.mut optional.empty return
end

proc(
  CompilerContext ptr.mut : context
-> ) =>: resetRegisters
  context [] .stack list.clear context .stack=
  context .variableLocations map.clear
  context .dataRegisters [] .length for =:: i
    context [] .dataRegisters i []
      resetRegister
    context [] .dataRegisters i =[]
  end
end

proc( i32 : stackSlot CompilerContext ptr.mut : context -> StackValue ptr.mut ) =>: stackSlotData
  stackSlot 0 < or stackSlot context [] .stack .length >= if
    "CodeGen: stack-data and register-states are out of sync" ..panic
  end
  context [] .stack stackSlot list.at .data
end
proc(
  Atomic list
  RegisterState : regState
  ## TODO option to allow moving value to empty register (if available) instead of memory
  CompilerContext ptr.mut : context
-> Atomic list RegisterState ) =>: clearRegister
  ## save previous value
  regState .currentValue switch
    empty forceClear preserveValue case break
    stackSlot case
      regState .currentValue .stackSlot =:: stackSlot
      stackSlot context stackSlotData =:: stackData
      stackData [] .location switch
        register case
          stackData .location [] .register =:: register
          register regState .register != if
            "CodeGen: stack-data and register state match":s Atomic .DebugError list.append
          end
          asm.OpType .MOVE
            stackSlot asm.Operand .stackData
            register asm.Operand .register
          context appendOp2
          StackValueLocation .memory stackData .location=
          break
        memory registers registerHi registerLow case
          "CodeGen: stack-data and register-states are out of sync" ..panic
      end
      StackValueLocation .memory stackData .location=
      break
    stackSlotHi case
      regState .currentValue .stackSlotHi =:: stackSlot
      stackSlot context stackSlotData =:: stackData
      stackData [] .location switch
        registerHi case
          stackData .location [] .registerHi =:: register
          register regState .register != if
            "CodeGen: stack-data and register state match":s Atomic .DebugError list.append
          end
          asm.OpType .MOVE
            stackSlot asm.Operand .stackData128Hi
            register asm.Operand .register
          context appendOp2
          StackValueLocation .memory stackData .location=
          break
        registers case
          stackData .location [] .registers .hi regState .register != if
            "CodeGen: stack-data and register state match":s Atomic .DebugError list.append
          end
          asm.OpType .MOVE
            stackSlot asm.Operand .stackData128Hi
            stackData .location [] .registers .hi asm.Operand .register
          context appendOp2
          stackData .location [] .registers .low StackValueLocation .registerLow stackData .location=
          break
        memory register registerLow case
          "CodeGen: stack-data and register-states are out of sync" ..panic
      end
      StackValueLocation .memory stackData .location=
      break
    stackSlotLow case
      regState .currentValue .stackSlotLow =:: stackSlot
      stackSlot context stackSlotData =:: stackData
      stackData [] .location switch
        registerLow case
          stackData .location [] .registerLow =:: register
          register regState .register != if
            "CodeGen: stack-data and register state match":s Atomic .DebugError list.append
          end
          asm.OpType .MOVE
            stackSlot asm.Operand .stackData128Low
            register asm.Operand .register
          context appendOp2
          StackValueLocation .memory stackData .location=
          break
        registers case
          stackData .location [] .registers .low regState .register != if
            "CodeGen: stack-data and register state match":s Atomic .DebugError list.append
          end
          asm.OpType .MOVE
            stackSlot asm.Operand .stackData128Low
            stackData .location [] .registers .low asm.Operand .register
          context appendOp2
          stackData .location [] .registers .hi StackValueLocation .registerHi stackData .location=
          break
        memory register registerHi case
          "CodeGen: stack-data and register-states are out of sync" ..panic
      end
      break
    variable case
      context .variableLocations regState .currentValue .variable map.remove ..drop ## TODO check if correct value was removed
      break
  end
  regState resetRegister
end


proc(
  Atomic list : ops
  i32 : opIndex
  RegisterState slice.mut : candidates
  CompilerContext ptr.mut : context
-> Atomic list RegisterId ) =>: nextFreeRegister
  candidates 0 @[] =::  mut: bestCandidate
  0:i64 =:: mut: candiateIndex
  1:i64 while $ candidates .length < and bestCandidate [] .lastUsed 0 >= do =:: i
    candidates i [] .lastUsed bestCandidate [] .lastUsed < if
      candidates i @[] bestCandidate=
      i candiateIndex=
    end
  finally i 1 + end ..drop
  ops
    ## clear values cache register
    bestCandidate [] context clearRegister bestCandidate =[]
    opIndex bestCandidate .lastUsed=
  bestCandidate [] .register return
end

proc(
  Atomic list
  ValType : valType
  i32 : opIndex
  CompilerContext ptr.mut : context
-> Atomic list RegisterId ) =>: nextRegister
  opIndex context [] .dataRegisters
    context [] .intDataRegCount valType isFloatValType if slice.tail else slice.head end
  context nextFreeRegister valType setRegType
end

proc( CompilerContext ptr.mut : context -> ) =>: printRegisters
  context [] .program .idContext .typeContext .labelContext =:: labelContext
  "--------------------------":s io.println
  context [] .dataRegisters for =:: regData
    regData .currentValue .empty ?? if continue end
    char8 8 array : nameBuffer
    nameBuffer@ sb.wrapBuffer
      regData .register sb.appendRegister
    sb.asStr io.print
    regData .currentValue switch
      variable case " var: ":s io.print regData .currentValue .variable labelContext id.getLabelName io.println break
      stackSlot case " stack: ":s io.print regData .currentValue .stackSlot io.println break
      stackSlotHi case " stack.ho: ":s io.print regData .currentValue .stackSlotHi io.println break
      stackSlotLow case " stack.low: ":s io.print regData .currentValue .stackSlotLow io.println break
      forceClear case " force clear":s io.println break
      preserveValue case " preserve value":s io.println break
      empty case ..unreachable
    end
    regData .lastUsed io.println
  end
  "--------------------------":s io.println
end

proc( RegisterState slice.mut : buffer CompilerContext ptr.mut : context -> ) =>: rememberRegisters
  context [] .dataRegisters =:: regs
  buffer .length regs .length >= "CodeGen: buffer large enough to store registers" assert
  buffer .data regs .data regs .length mem.copy ..drop ## copy register data
end
## TODO? perocedure for updating single register
enum( MERGE MERGE_FALLTHROUGH RESET ) =:: RegisterRestoreMode
proc(
  Atomic list
  RegisterState slice.mut : buffer
  i32 : newStackSize
  RegisterRestoreMode : mode
  FilePosition : pos
  CompilerContext ptr.mut : context
-> Atomic list ) =>: restoreRegisters
  context [] .program =:: program
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  context [] .dataRegisters =:: regs
  false =:: mut: usedEmptyReg
  mode .RESET ?? if
    ## set stack-size
    ## TODO ensure procedure does not access valus in invalid state
    context [] .stack
      newStackSize list.setLength
    context .stack=
  else
    newStackSize context [] .stack .length != if
      "CodeGen: branches have same stack size" sb.copyPtr
      pos program .errors appendError
      context [] .stack
        newStackSize list.setLength
      context .stack=
    end
  end
  buffer .length regs .length >= "CodeGen: buffer large enough to store registers" assert
  ## TODO? smarter algorithm (reduce number of moves)
  ## 1. clear all registers holding value not appearing in new state
  ##   -> more free registers, less unneccessary moves
  ## 2. move all values where source is register and target is currently free
  regs .length i32 cast for =:: i
    regs i [] .register isFloatReg =:: isFloat
    regs i [] .currentValue =:: currentValue
    buffer i [] .currentValue =:: expectedValue
    expectedValue currentValue RegisterContent.eq if ## already correct value in register
      expectedValue .empty ?? ! if
        buffer i [] .lastUsed
          mode .RESET ?? ! if regs i [] .lastUsed i32.max end
        regs i @[] .lastUsed= ## mark resister as used
      end
      continue
    end
    expectedValue .preserveValue ?? if
      continue
    end
    ## current value is wrong -> clear out register
    mode .RESET ?? if
      regs i [] resetRegister regs i =[]
    else expectedValue .empty ?? _if ## .forceClear is considered non-empty
      ## keep values in empty registers to avoid unnecessary moves
      currentValue .empty ?? ! usedEmptyReg=
    else currentValue .empty ?? ! _if
      -1 =:: mut: freeSlot
      isFloat if
        context [] .intDataRegCount regs .length i32 cast
      else
        0 context [] .intDataRegCount
      end =:: maxIndex =:: minIndex
      minIndex while $ maxIndex < do =:: j
        j i == if continue end
        ## TODO smarter algorithm
        ##  * move to correct buffer slot if currently empty
        ##  * prefer slots that empty in buffer
        regs j [] .currentValue .empty ?? if
          currentValue buffer j [] .currentValue RegisterContent.eq if
            ## expected target for value
            j freeSlot=
            j break
          else buffer j [] .currentValue .empty ?? or buffer j [] .currentValue .preserveValue ?? _if
            j freeSlot=
            j break
          else freeSlot -1 == _if
            j freeSlot=
          end
        end
      finally j 1 + end ..drop
      freeSlot 0 >= if
        regs freeSlot [] .register =:: mut: targetRegister
        regs i [] .register =:: srcRegister
        ## temporarily move value to free register
        currentValue regs freeSlot @[] .currentValue=
        currentValue switch
          variable case
            currentValue .variable idContext id.getIdentifier
              ! "CodeGen: identifier exists" assert
            =:: idData
            currentValue .variable context atCachedVarLocation .data =:: varLoc
            varLoc [] .register srcRegister != if
              "CodeGen: variable-cache and registers in sync":s Atomic .DebugError list.append
            end
            idData [] .valueType typeContext toValType
              targetRegister $1 setRegType targetRegister=
            targetRegister varLoc .register=
            break
          stackSlot case
            currentValue .stackSlot context stackSlotData =:: stackData
            stackData .location [] .register srcRegister != if
              "CodeGen: stack and registers in sync":s Atomic .DebugError list.append
            end
            stackData [] .valType
            targetRegister $1 setRegType targetRegister=
            targetRegister stackData .location .register=
            break
          stackSlotHi stackSlotLow case "unimplemented" ..panic
          empty forceClear preserveValue case ..unreachable
        end =:: valType
        asm.OpType .MOVE
          targetRegister asm.Operand .register
          srcRegister valType setRegType asm.Operand .register
        context appendOp2
        regs i [] resetRegister regs i =[]
        usedEmptyReg freeSlot i < | usedEmptyReg=
      else
        regs i [] context clearRegister regs i =[]
      end
    end
    ## copy expected value into register
    ## TODO? delay copying of memory values (to keep space of moved values)
    buffer i [] .register =:: targetRegister
    buffer i [] .lastUsed
      mode .RESET ?? ! if regs i [] .lastUsed i32.max end
    regs i @[] .lastUsed=
    expectedValue switch
      preserveValue case ..unreachable
      empty case continue ## do not change register
      forceClear case
        regs i [] .currentValue .empty ?? "register is cleared" assert
        continue
      variable case
        expectedValue .variable idContext id.getIdentifier
          ! "CodeGen: identifier exists" assert
        =:: idData
        mode .RESET ?? ! if
          expectedValue .variable idData .idType [] .GLOBAL_VAR ?? context getVarLocation =:: varLoc
          varLoc switch
            register case
              asm.OpType .MOVE
                targetRegister asm.Operand .register
                varLoc .register asm.Operand .register
              context appendOp2
              break
            localMemory case
              asm.OpType .LOAD
                targetRegister asm.Operand .register
                varLoc .localMemory asm.Operand .localMemory
              context appendOp2
              break
            localAddr case
              asm.OpType .MOVE
                targetRegister asm.Operand .register
                varLoc .localAddr asm.Operand .localMemory
              context appendOp2
              break
            globalMemory case
              asm.OpType .LOAD
                targetRegister asm.Operand .register
                varLoc .globalMemory asm.Operand .globalMemory
              context appendOp2
              break
            globalAddr case
              asm.OpType .MOVE
                targetRegister asm.Operand .register
                varLoc .globalAddr asm.Operand .globalMemory
              context appendOp2
              break
            registerHi registerLow registers case "unimplemented" ..panic
            default "CodeGen: unsupported variable location" ..panic
          end
        end
        expectedValue .variable targetRegister buffer i [] .lastUsed context cacheVariable ## update variable location
        break
      stackSlot case
        expectedValue .stackSlot =:: stackSlot
        stackSlot context stackSlotData =:: stackData
        mode .RESET ?? if
          targetRegister stackData .location .register=
          break
        end
        stackData [] .location switch
          register case
            stackData .location [] .register =:: register
            asm.OpType .MOVE
              targetRegister asm.Operand .register
              register asm.Operand .register
            context appendOp2
            StackValueLocation .memory stackData .location=
            register context findRegister .data =:: regState
            regState [] resetRegister regState =[] ## clear previous location
            break
          memory case
            asm.OpType .MOVE
              targetRegister asm.Operand .register
              stackSlot asm.Operand .stackData
            context appendOp2
            StackValueLocation .memory stackData .location=
            break
          registers registerHi registerLow case
            "CodeGen: stack-data and register-states are out of sync" ..panic
        end
        targetRegister stackData .location .register=
        break
      stackSlotHi stackSlotLow case "unimplemented" ..panic
    end
    expectedValue regs i @[] .currentValue=
    targetRegister regs i @[] .register=
  end
  usedEmptyReg if ## cleanup tmp-vars that were moved to previously cleared slots
    regs .length for =:: i
      buffer i [] .currentValue .forceClear ?? or mode .MERGE ?? and buffer i [] .currentValue .empty ?? if
        regs i [] context clearRegister regs i =[]
      end
    end
  end
end

proc( CompilerContext ptr.mut : context -> i32 ) =>: nextLabelId
  context [] .labelCount
    $ 1 + context .labelCount=
  return
end
proc(
  BlockId : blockId
  i32 : startLabelId
  CompilerContext ptr.mut : context
-> WhileBlockInfo ptr.mut ) =>: openWhileBlock
  context .dataRegisters [] .length i32 cast =:: regCount
  context [] .openBlocks
    ## WhileBlockInfo
      blockId
      startLabelId
      NO_LABEL NO_LABEL NO_LABEL
      regCount 4 * i64 cast.u RegisterState mem.alloc regCount 4 * slice.createMutable
      regCount
      regCount 2 *
      regCount 3 *
      -1 -1 -1 -1
    WhileBlockInfo new BlockInfo .While list.append
  context .openBlocks=
  context [] .openBlocks list.peek .data .While
end
proc(
  BlockId : blockId
  CompilerContext ptr.mut : context
-> IfBlockInfo ptr.mut ) =>: openIfBlock
  context .dataRegisters [] .length i32 cast =:: regCount
  context [] .openBlocks
    ## IfBlockInfo
      blockId
      NO_LABEL
      NO_LABEL
      NO_LABEL
      regCount 3 * i64 cast.u RegisterState mem.alloc regCount 3 * slice.createMutable
      regCount
      regCount 2 *
      -1
      -1
      false
    IfBlockInfo new BlockInfo .If list.append
  context .openBlocks=
  context [] .openBlocks list.peek .data .If
end
proc(
  BlockId : blockId
  CompilerContext ptr.mut : context
-> AndOrBlockInfo ptr.mut ) =>: openAndOrBlock
  context .dataRegisters [] .length i32 cast =:: regCount
  context [] .openBlocks
    ## IfBlockInfo
      blockId
      NO_LABEL
      regCount i64 cast.u RegisterState mem.alloc regCount slice.createMutable
      -1
    AndOrBlockInfo new BlockInfo .AndOr list.append
  context .openBlocks=
  context [] .openBlocks list.peek .data .AndOr
end
proc(
  BlockId : blockId
  i32 : caseCount
  CompilerContext ptr.mut : context
-> SwitchBlockInfo ptr.mut ) =>: openSwitchBlock
  context .dataRegisters [] .length i32 cast =:: regCount
  context [] .openBlocks
    ## SwitchBlockInfo
      blockId
      NO_LABEL
      caseCount 1 + i64 cast.u i32 mem.alloc
        $ caseCount 1 + i64 cast.u NO_LABEL mem.fill
      caseCount 1 + slice.createMutable
      regCount 2 *  i64 cast.u RegisterState mem.alloc regCount 2 * slice.createMutable
      regCount
      -1 -1
      0
    SwitchBlockInfo new BlockInfo .Switch list.append
  context .openBlocks=
  context [] .openBlocks list.peek .data .Switch
end

enum( WHILE SWITCH ) =:: BreakType
proc(
  BlockId : blockId
  BreakType : breakType
  CompilerContext ptr.mut : context
-> BlockInfo ptr.mut optional ) =>: findBreakableBlock
  context [] .program =:: program
  program .errors =:: errors
  context [] .openBlocks list.atReversed for =:: block
    breakType .WHILE ?? and block [] .While ?? and
        block [] .While .blockId blockId == if
      block optional.wrap return
    end
    breakType .SWITCH ?? and block [] .Switch ?? and
        block [] .Switch .blockId blockId == if
      block optional.wrap return
    end
  end
  BlockInfo ptr.mut optional.empty return
end

proc(
  Atomic list
  ValType : valType
  asm.Operand : switchValOperand
  LabelData slice : labels
  i32 slice : caseLabelIds
  i64 : lower ## input is >= lower
  i64 : upper ## input is <= upper
  bool : signed ## use signed comparisson
  CompilerContext ptr.mut : context
-> Atomic list ) =>: generateDecisionTree
  labels 0 [] .value switchLabelAsInt =:: minLabel
  labels $ .length 1 - [] .value switchLabelAsInt =:: maxLabel
  caseLabelIds .length 1 - i32 cast =:: defaultLabelId
  ## TODO? compress contiguous ranges jumping to same label
  labels .length 3 <= if
    upper lower - labels .length 1 - == =:: contiguous ## all values between lower and upper are labels
    labels contiguous if $ .length 1 - slice.head end for =:: l
      asm.OpType .JMPIF
        asm.CompareType .EQ asm.Operand .cmpType
        switchValOperand
        l .value switchLabelAsInt asm.Operand .constInt
        caseLabelIds l .caseId [] asm.Operand .localLabel
      context appendOp4
    end
    asm.OpType .JMP
      contiguous if
        caseLabelIds labels $ .length 1 - [] .caseId []
      else
        defaultLabelId
      end asm.Operand .localLabel
    context appendOp1
    return
  end
  labels .length 2 / =:: centerId
  labels centerId [] .value switchLabelAsInt =:: midValue
  context nextLabelId =:: branchLabel
  asm.OpType .JMPIF
    signed if asm.CompareType .GE else asm.CompareType .UGE end asm.Operand .cmpType
    switchValOperand
    midValue asm.Operand .constInt
    branchLabel asm.Operand .localLabel
  context appendOp4
  ## less than mid-value
    valType
    switchValOperand
    labels centerId slice.head
    caseLabelIds
    lower
    midValue 1 -
    signed
    context
  generateDecisionTree
  asm.OpType .LABEL
    branchLabel asm.Operand .localLabel
  context appendOp1
  ## greater or equal to mid-value
    valType
    switchValOperand
    labels centerId slice.tail
    caseLabelIds
    midValue
    upper
    signed
    context
  generateDecisionTree
  return
end
proc(
  Atomic list
  StackValue : val
  SwitchBlockInfo ptr : blockInfo
  SwitchData ptr.mut : switchData
  CompilerContext ptr.mut : context
-> Atomic list ) =>: generateSwitchTable
  switchData [] .labels =:: labels
  labels 0 [] .value switchLabelAsInt =:: minLabel
  labels $ .length 1 - [] .value switchLabelAsInt =:: maxLabel
  blockInfo [] .caseLabelIds $ .length 1 - [] =:: defaultLabel
  val .location switch
    register case
        val .location .register asm.Operand .register
      break
    memory case ## TODO is this the right offset
        context [] .stack .length 1 + asm.Operand .stackData
      break
    registers registerHi registerLow case "unexpected format for condition parameter" ..panic
  end =:: switchValOperand
  switchValOperand .register =:: switchOpReg ## TODO ensure target value is register
  ## 0-4 -> linear check
  ## TODO find good way to decide which switch-type to use
  ## TODO? mixed switch: tree for sparse values, table for long continues ranges of values
  labels .length 3 > and maxLabel minLabel - labels .length i64 cast.u $ 4 / + <= if
    context nextLabelId =:: jumpTableId
    ## jump-table
    minLabel 0 != if
      asm.OpType .SUB
        switchValOperand
        switchValOperand
        minLabel asm.Operand .constInt
      context appendOp3
    end
    asm.OpType .JMPIF
      asm.CompareType .UGT asm.Operand .cmpType
      switchValOperand
      maxLabel minLabel - asm.Operand .constInt
      defaultLabel asm.Operand .localLabel
    context appendOp4
    asm.OpType .JMP
      switchOpReg jumpTableId asm.RegAndOffset new asm.Operand .jumpTableElement
    context appendOp1
    ## TODO? do not use magic number of table alignment
    8 Atomic .Align list.append ## align jump-table to element size
    asm.OpType .LABEL
      jumpTableId asm.Operand .localLabel
    context appendOp1
    0 =:: mut: labelIndex
    minLabel while $ maxLabel <= do =:: tableValue
      labels labelIndex [] .value switchLabelAsInt =:: labelValue
      asm.OpType .DATA
        ValType .PTR asm.Operand .valType
        labelValue tableValue == if
          blockInfo [] .caseLabelIds labels labelIndex [] .caseId []
          labelIndex 1 + labelIndex=
        else
          defaultLabel
        end asm.Operand .localLabel
      context appendOp2
    finally tableValue 1 + end ..drop
  else
    val .valType
      switchValOperand
      labels list.asSlice
      blockInfo [] .caseLabelIds slice.freeze
      i64.MIN ## TODO pass correct bounds for input type & signdness
      i64.MAX
      val .valType .I64 ?? ## smaller values have been zero-extended before sorting
      context
    generateDecisionTree
  end
end

proc(
  RegisterId : mut: regId
  ValType : valType
  CompilerContext ptr.mut : context
-> ) =>: pushRegister
  regId valType setRegType regId=
  regId context findRegister .data =:: regState
  regState .currentValue .empty ?? "CodeGen: pushed register is currently unassigned" assert
  context .stack [] .length RegisterContent .stackSlot regState .currentValue=
  context [] .stack
    regId StackValueLocation .register valType StackValue new list.push
  context .stack=
end
proc(
  Atomic list
  ValType : valType
  ValueLocation : location
  i32 : opIndex
  CompilerContext ptr.mut : context
-> Atomic list ) =>: pushValue
  ## TODO make dependent on valType
  location switch
    register case
      location .register context findRegister =:: regState
      regState optional.hasData and regState .data .currentValue [] .empty ?? if
        opIndex regState .data .lastUsed=
        location .register valType context pushRegister
      else ## arg register is not a valid data register
        valType opIndex context nextRegister =:: targetRegister
        asm.OpType .MOVE
          targetRegister asm.Operand .register
          location .register asm.Operand .register
        context appendOp2
        targetRegister valType context pushRegister
      end
      return
    registers registerHi registerLow case
      break
    intConstant case
      valType opIndex context nextRegister =:: targetRegister
      asm.OpType .MOVE
        targetRegister asm.Operand .register
        location .intConstant asm.Operand .constInt
      context appendOp2
      targetRegister valType context pushRegister
      return
    floatConstant case
      valType opIndex context nextRegister =:: targetRegister
      asm.OpType .MOVE
        targetRegister valType setRegType asm.Operand .register
        location .floatConstant asm.Operand .constFloat
      context appendOp2
      targetRegister valType context pushRegister
      return
    ptrConstant case
      valType opIndex context nextRegister =:: targetRegister
      asm.OpType .MOVE
        targetRegister asm.Operand .register
        location .ptrConstant asm.Operand .constPtr
      context appendOp2
      targetRegister valType context pushRegister
      return
    intArgument case
      break
    floatArgument case
      break
    localAddr case
      valType opIndex context nextRegister =:: targetRegister
      asm.OpType .MOVE
        targetRegister asm.Operand .register
        location .localAddr asm.Operand .localMemory
      context appendOp2
      targetRegister valType context pushRegister
      return
    localMemory case ## TODO handle composite values
      valType opIndex context nextRegister =:: targetRegister
      asm.OpType .LOAD
        targetRegister asm.Operand .register
        location .localMemory asm.Operand .localMemory
      context appendOp2
      targetRegister valType context pushRegister
      return
    globalMemory globalAddr case
      break
  end
  Atomic .Unknown list.append return
end
proc(
  Atomic list : ops
  ValType optional : argType
  FilePosition : pos
  CompilerContext ptr.mut : context
-> Atomic list StackValue optional ) =>: popValue
  context [] .program .errors =:: errors
  context [] .stack .length 0 == if
    ops StackValue optional.empty return
  end
  context [] .stack
    list.pop =:: popped
  context .stack=
  argType optional.hasData and popped .valType argType .data != if
    "unexpected value type expected: " sb.copyPtr
      argType .data sb.appendValType
      " got: " sb.appendS
      popped .valType sb.appendValType
    pos errors appendError
    ops StackValue optional.empty return
  end
  ## update status of popped registers
  popped .location switch
    register case
      popped .location .register context findRegister =:: regState
      regState .data [] resetRegister regState .data =[]
      break
    registerHi case
      popped .location .registerHi context findRegister =:: regState
      regState .data [] resetRegister regState .data =[]
      break
    registerLow case
      popped .location .registerLow context findRegister =:: regState
      regState .data [] resetRegister regState .data =[]
      break
    registers case
      popped .location .registers .hi context findRegister =:: hiReg
      popped .location .registers .low context findRegister =:: lowReg
      hiReg .data [] resetRegister hiReg .data =[]
      lowReg .data [] resetRegister lowReg .data =[]
      break
    memory case break ## nothing to do
  end
  ops popped optional.wrap return
end


enum( autoCast Cast Cast! bitCast ) =:: CastType

proc(
  Atomic list
  CastType : castType
  SignType : mut: signType
  Type : mut: src
  i32 : offset
  Type : mut: target
  i32 : opIndex
  FilePosition : pos
  CompilerContext ptr.mut : context
-> Atomic list ) =>: compileCast
  context [] .program =:: program
  program .errors =:: errors
  program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  src typeContext types.unwrapNamed
    $ .cType ?? if .cType types.cTypeAsType end
    $ .intLiteral ?? if .intLiteral types.intLiteralAsInt end
  src=
  target typeContext types.unwrapNamed
    $ .cType ?? if .cType types.cTypeAsType end
    $ .intLiteral ?? if .intLiteral types.intLiteralAsInt end
  target=
  ## TODO? distinquish code and data pointers / pointers with different alignment
  src target types.typeEquals or src typeContext types.isPointer and target typeContext types.isPointer if
    return ## nothing to do
  end
  signType .NONE ?? if
    src typeContext types.isUnsignedInt or src typeContext types.isChar if
        SignType .UNSIGNED signType=
      else src typeContext types.isSignedInt _if
        SignType .SIGNED signType=
      else target typeContext types.isUnsignedInt or target typeContext types.isChar _if
        SignType .UNSIGNED signType=
      else target typeContext types.isSignedInt _if
        SignType .SIGNED signType=
      end
  end
