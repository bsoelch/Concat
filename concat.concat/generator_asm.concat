proc(
  BlockId : blockId
  i32 : caseCount
  CompilerContext ptr.mut : context
-> SwitchBlockInfo ptr.mut ) =>: openSwitchBlock
  context .dataRegisters [] .length i32 cast =:: regCount
  context [] .openBlocks
    ## SwitchBlockInfo
      blockId
      NO_LABEL
      caseCount 1 + iSize cast.u i32 mem.alloc
        $ caseCount 1 + iSize cast.u NO_LABEL mem.fill
      caseCount 1 + slice.createMutable
      regCount 2 *  iSize cast.u RegisterState mem.alloc regCount 2 * slice.createMutable
      regCount
      -1:iSize -1:iSize
      0
    SwitchBlockInfo new BlockInfo .Switch list.append
  context .openBlocks=
  context [] .openBlocks list.peek .data .Switch
end

enum( WHILE SWITCH INLINE ) =:: BreakType
proc(
  BlockId : blockId
  BreakType : breakType
  CompilerContext ptr.mut : context
-> BlockInfo ptr.mut optional ) =>: findBreakableBlock
  context [] .program =:: program
  program .errors =:: errors
  context [] .openBlocks list.atReversed for =:: block
    breakType .WHILE ?? and block [] .While ?? and
        block [] .While .blockId blockId == if
      block optional.wrap return
    end
    breakType .SWITCH ?? and block [] .Switch ?? and
        block [] .Switch .blockId blockId == if
      block optional.wrap return
    end
    breakType .INLINE ?? and block [] .InlineProc ?? and
        block [] .InlineProc .blockId blockId == if
      block optional.wrap return
    end
  end
  BlockInfo ptr.mut optional.empty return
end

proc(
  Atomic list
  ValType : valType
  asm.Operand : switchValOperand
  LabelData slice : labels
  i32 slice : caseLabelIds
  i64 : lower ## input is >= lower
  i64 : upper ## input is <= upper
  bool : signed ## use signed comparisson
  CompilerContext ptr.mut : context
-> Atomic list ) =>: generateDecisionTree
  labels 0 [] .value switchLabelAsInt =:: minLabel
  labels $ .length 1:iSize - [] .value switchLabelAsInt =:: maxLabel
  caseLabelIds .length 1:iSize - i32 cast =:: defaultLabelId
  ## TODO? compress contiguous ranges jumping to same label
  labels .length 3:iSize u<= if
    upper lower - labels .length i64 cast 1 - == =:: contiguous ## all values between lower and upper are labels
    labels contiguous if $ .length 1:iSize - slice.head end for =:: l
      asm.OpType .JMPIF
        asm.CompareType .EQ asm.Operand .cmpType
        switchValOperand
        l .value switchLabelAsInt asm.Operand .constInt
        caseLabelIds l .caseId [] asm.Operand .localLabel
      context appendOp4
    end
    asm.OpType .JMP
      contiguous if
        caseLabelIds labels $ .length 1:iSize - [] .caseId []
      else
        defaultLabelId
      end asm.Operand .localLabel
    context appendOp1
    return
  end
  labels .length 2:iSize / =:: centerId
  labels centerId [] .value switchLabelAsInt =:: midValue
  context nextLabelId =:: branchLabel
  asm.OpType .JMPIF
    signed if asm.CompareType .GE else asm.CompareType .UGE end asm.Operand .cmpType
    switchValOperand
    midValue asm.Operand .constInt
    branchLabel asm.Operand .localLabel
  context appendOp4
  ## less than mid-value
    valType
    switchValOperand
    labels centerId slice.head
    caseLabelIds
    lower
    midValue 1 -
    signed
    context
  generateDecisionTree
  asm.OpType .LABEL
    branchLabel asm.Operand .localLabel
  context appendOp1
  ## greater or equal to mid-value
    valType
    switchValOperand
    labels centerId slice.tail
    caseLabelIds
    midValue
    upper
    signed
    context
  generateDecisionTree
  return
end
proc(
  Atomic list
  StackValue : val
  SwitchBlockInfo ptr : blockInfo
  SwitchData ptr.mut : switchData
  CompilerContext ptr.mut : context
-> Atomic list ) =>: generateSwitchTable
  switchData [] .labels =:: labels
  labels 0 [] .value switchLabelAsInt =:: minLabel
  labels $ .length 1:iSize - [] .value switchLabelAsInt =:: maxLabel
  blockInfo [] .caseLabelIds $ .length 1:iSize - [] =:: defaultLabel
  val .location switch
    register case
        val .location .register asm.Operand .register
      break
    memory case ## TODO is this the right offset
        context [] .stack .length i32 cast.u 1 + asm.Operand .stackData
      break
    registers registerHi registerLow case "unexpected format for condition parameter" ..panic
  end =:: switchValOperand
  switchValOperand .register =:: switchOpReg ## TODO ensure target value is register
  ## 0-4 -> linear check
  ## TODO find good way to decide which switch-type to use
  ## TODO? mixed switch: tree for sparse values, table for long continues ranges of values
  labels .length 3:iSize u> and maxLabel minLabel - labels .length i64 cast.u $ 4 / + <= if
    context nextLabelId =:: jumpTableId
    ## jump-table
    minLabel 0 != if
      asm.OpType .SUB
        switchValOperand
        switchValOperand
        minLabel asm.Operand .constInt
      context appendOp3
    end
    asm.OpType .JMPIF
      asm.CompareType .UGT asm.Operand .cmpType
      switchValOperand
      maxLabel minLabel - asm.Operand .constInt
      defaultLabel asm.Operand .localLabel
    context appendOp4
    asm.OpType .JMP
      switchOpReg jumpTableId asm.RegAndOffset new asm.Operand .jumpTableElement
    context appendOp1
    ## TODO? do not use magic number of table alignment
    8 Atomic .Align list.append ## align jump-table to element size
    asm.OpType .LABEL
      jumpTableId asm.Operand .localLabel
    context appendOp1
    0 =:: mut: labelIndex
    minLabel while $ maxLabel <= do =:: tableValue
      labels labelIndex [] .value switchLabelAsInt =:: labelValue
      asm.OpType .DATA
        ValType .PTR asm.Operand .valType
        labelValue tableValue == if
          blockInfo [] .caseLabelIds labels labelIndex [] .caseId []
          labelIndex 1 + labelIndex=
        else
          defaultLabel
        end asm.Operand .localLabel
      context appendOp2
    finally tableValue 1 + end ..drop
  else
    val .valType
      switchValOperand
      labels list.asSlice
      blockInfo [] .caseLabelIds slice.freeze
      i64.MIN ## TODO pass correct bounds for input type & signdness
      i64.MAX
      val .valType .I64 ?? ## smaller values have been zero-extended before sorting
      context
    generateDecisionTree
  end
end

proc(
  StackValue : val
  CompilerContext ptr.mut : context
-> bool ) =>: pushStackValue
  false =:: mut: regOutOfSync
  val .location switch
    register case
      val .location .register context findRegister .data =:: regData
      regData .currentValue [] .stackSlotReference ?? if
        context [] .stack .length i32 cast.u regData .currentValue .stackSlotReference=
        val .location .register ValType .PTR setRegType regData .register=
        break
      else
        regData .currentValue [] .stackSlot ?? ! regOutOfSync=
        val .location .register val .valType setRegType regData .register=
      end
      context [] .stack .length i32 cast.u regData .currentValue .stackSlot=
      break
    registerHi case
      val .location .registerHi context findRegister .data =:: regData
      regData .currentValue [] .stackSlotHi ?? ! regOutOfSync=
      context [] .stack .length i32 cast.u regData .currentValue .stackSlotHi=
      val .location .registerHi val .valType getHiValType setRegType regData .register=
      break
    registerLow case
      val .location .registerLow context findRegister .data =:: regData
      regData .currentValue [] .stackSlotLow ?? ! regOutOfSync=
      context [] .stack .length i32 cast.u regData .currentValue .stackSlotLow=
      val .location .registerLow val .valType getLowValType setRegType regData .register=
      break
    registers case
      val .location .registers .hi context findRegister .data =:: regDataHi
      regDataHi .currentValue [] .stackSlotHi ?? ! regOutOfSync=
      context [] .stack .length i32 cast.u regDataHi .currentValue .stackSlotHi=
      val .location .registers .hi val .valType getHiValType setRegType regDataHi .register=
      val .location .registers .low context findRegister .data =:: regDataLow
      regDataLow .currentValue [] .stackSlotLow ?? ! regOutOfSync=
      context [] .stack .length i32 cast.u regDataLow .currentValue .stackSlotLow=
      val .location .registers .low val .valType getLowValType setRegType regDataLow .register=
      break
    memory case break
  end
  context [] .stack
    val list.push
  context .stack=
  regOutOfSync return
end
proc(
  RegisterId : mut: regId
  ValType : valType
  CompilerContext ptr.mut : context
-> ) =>: pushRegister
  regId valType setRegType regId=
  regId context findRegister .data =:: regState
  regState .currentValue .empty ?? "CodeGen: pushed register is currently unassigned" assert
  context .stack [] .length i32 cast.u
    valType .REFERENCE ?? if
      RegisterContent .stackSlotReference
    else
      RegisterContent .stackSlot
    end
  regState .currentValue=
  context [] .stack
    regId StackValueLocation .register valType StackValue new list.push
  context .stack=
end
proc(
  RegisterId : mut: lowReg
  RegisterId : mut: hiReg
  ValType : valType
  CompilerContext ptr.mut : context
-> ) =>: pushRegisters
  lowReg valType getLowValType setRegType lowReg=
  hiReg valType getHiValType setRegType hiReg=
  lowReg context findRegister .data =:: lowState
  lowState .currentValue .empty ?? "CodeGen: pushed register is currently unassigned" assert
  context .stack [] .length i32 cast.u RegisterContent .stackSlotLow lowState .currentValue=
  hiReg context findRegister .data =:: hiState
  hiState .currentValue .empty ?? "CodeGen: pushed register is currently unassigned" assert
  context .stack [] .length i32 cast.u RegisterContent .stackSlotHi hiState .currentValue=
  context [] .stack
    lowReg hiReg RegisterPair new StackValueLocation .registers valType StackValue new list.push
  context .stack=
end
proc(
  Atomic list
  ValType : valType
  ValueLocation : location
  i32 : opIndex
  CompilerContext ptr.mut : context
-> Atomic list ) =>: pushValue
  context .program [] .idContext .typeContext =:: typeContext
  location switch
    register case
      ## TODO better way to detect when value is reference, ? own ValueLocation(s) for reference
      valType $ isMultiRegValType if ..drop ValType .REFERENCE end =:: regValType
      location .register context findRegister =:: regState
      regState optional.hasData and regState .data .currentValue [] .empty ?? if
        opIndex regState .data .lastUsed=
        location .register regValType context pushRegister
      else ## arg register is not a valid data register
        regValType opIndex context nextRegister =:: targetRegister
        asm.OpType .MOVE
          targetRegister asm.Operand .register
          location .register asm.Operand .register
        context appendOp2
        targetRegister regValType context pushRegister
      end
      return
    registers case
      location .registers =:: regs
      regs .low context findRegister =:: lowState
      regs .hi context findRegister =:: hiState
      lowState optional.hasData and lowState .data .currentValue [] .empty ?? if
        opIndex lowState .data .lastUsed=
        regs .low
      else ## TODO ensure that new nextRegister for low-state does not consume high state
        valType getLowValType opIndex context nextRegister =:: targetRegister
        asm.OpType .MOVE
          targetRegister asm.Operand .register
          regs .low asm.Operand .register
        context appendOp2
        targetRegister
      end =:: lowReg
      hiState optional.hasData and hiState .data .currentValue [] .empty ?? if
        opIndex hiState .data .lastUsed=
        regs .hi
      else
        valType getHiValType opIndex context nextRegister =:: targetRegister
        asm.OpType .MOVE
          targetRegister asm.Operand .register
          regs .hi asm.Operand .register
        context appendOp2
        targetRegister
      end =:: hiReg
      lowReg hiReg valType context pushRegisters
      return
    localAndLowReg localAndHiReg case
      break
    intConstant case
      valType opIndex context nextRegister =:: targetRegister
      asm.OpType .MOVE
        targetRegister asm.Operand .register
        location .intConstant asm.Operand .constInt
      context appendOp2
      targetRegister valType context pushRegister
      return
    floatConstant case
      valType opIndex context nextRegister =:: targetRegister
      asm.OpType .MOVE
        targetRegister valType setRegType asm.Operand .register
        location .floatConstant valType .F32 ?? if f32 cast asm.Operand .constF32 else asm.Operand .constF64 end
      context appendOp2
      targetRegister valType context pushRegister
      return
    ptrConstant case
      valType opIndex context nextRegister =:: targetRegister
      asm.OpType .MOVE
        targetRegister asm.Operand .register
        location .ptrConstant asm.Operand .constPtr
      context appendOp2
      targetRegister valType context pushRegister
      return
    intArgument case
      break
    floatArgument case
      break
    compositeArgument case
      break
    localAddr case
      valType opIndex context nextRegister =:: targetRegister
      asm.OpType .MOVE
        targetRegister asm.Operand .register
        location .localAddr asm.Operand .localMemory
      context appendOp2
      targetRegister valType context pushRegister
      return
    localMemory case ## TODO handle composite values
      valType isMultiRegValType if
        valType getHiValType =:: hiVal
        valType getLowValType =:: lowVal
        lowVal opIndex context nextRegister =:: lowRegister
        hiVal opIndex context nextRegister =:: hiRegister
        asm.OpType .LOAD
          lowRegister asm.Operand .register
          location .localMemory asm.Operand .localMemory
        context appendOp2
        asm.OpType .LOAD
          hiRegister asm.Operand .register
          location .localMemory lowRegister getRegSize asm.LabelAndOffset new asm.Operand .localMemoryAndOffset
        context appendOp2
        lowRegister hiRegister valType context pushRegisters
        return
      end
      valType opIndex context nextRegister =:: targetRegister
      valType .REFERENCE ?? if
        asm.OpType .MOVE
      else
        asm.OpType .LOAD
      end
        targetRegister asm.Operand .register
        location .localMemory asm.Operand .localMemory
      context appendOp2
      targetRegister valType context pushRegister
      return
    globalMemory globalAddr globalAndLowReg globalAndHiReg case
      break
  end
  Atomic .Unknown list.append return
end
union( _ : none ValType : value ValType : valueOrReference ) =:: CheckValue ## TODO? better name
proc(
  Atomic list : ops
  CheckValue : argType
  FilePosition : pos
  CompilerContext ptr.mut : context
-> Atomic list StackValue optional ) =>: popValue
  context [] .program .errors =:: errors
  context [] .stack .length 0:iSize == if
    ops StackValue optional.empty return
  end
  context [] .stack
    list.pop =:: popped
  context .stack=
  argType .value ?? and popped .valType argType .value != end or
      argType .valueOrReference ?? and  popped .valType .REFERENCE ?? ! and
      popped .valType argType .valueOrReference != if
    "unexpected value type expected: " sb.copyPtr
      argType .value ?? if argType .value else argType .valueOrReference end sb.appendValType
      " got: " sb.appendS
      popped .valType sb.appendValType
    pos errors appendError
    ops StackValue optional.empty return
  end
  ## update status of popped registers
  popped .location switch
    register case
      popped .location .register context resetRegisterById
      break
    registerHi case
      popped .location .registerHi context resetRegisterById
      break
    registerLow case
      popped .location .registerLow context resetRegisterById
      break
    registers case
      popped .location .registers .low context resetRegisterById
      popped .location .registers .hi context resetRegisterById
      break
    memory case break ## nothing to do
  end
  ops popped optional.wrap return
end


enum( autoCast Cast Cast! bitCast ) =:: CastType

proc(
  Atomic list
  CastType : castType
  SignType : mut: signType
  Type : mut: src
  i32 : offset
  Type : mut: target
  i32 : opIndex
  FilePosition : pos
  CompilerContext ptr.mut : context
-> Atomic list ) =>: compileCast
  context [] .program =:: program
  program .errors =:: errors
  program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  src typeContext types.unwrapNamed
    $ .cType ?? if .cType types.cTypeAsType end
    $ .intLiteral ?? if .intLiteral types.intLiteralAsInt end
  src=
  target typeContext types.unwrapNamed
    $ .cType ?? if .cType types.cTypeAsType end
    $ .intLiteral ?? if .intLiteral types.intLiteralAsInt end
  target=
  ## TODO? distinquish code and data pointers / pointers with different alignment
  src target types.typeEquals or src typeContext types.isPointer and target typeContext types.isPointer if
    return ## nothing to do
  end
  signType .NONE ?? if
    src typeContext types.isUnsignedInt or src typeContext types.isChar if
        SignType .UNSIGNED signType=
      else src typeContext types.isSignedInt _if
        SignType .SIGNED signType=
      else target typeContext types.isUnsignedInt or target typeContext types.isChar _if
        SignType .UNSIGNED signType=
      else target typeContext types.isSignedInt _if
        SignType .SIGNED signType=
      end
  end
  offset iSize cast.u context .stack [] .length u>= if
    "CodeGen: stack underflow in cast" sb.copyPtr
    pos errors appendError
    return
  end
  context [] .stack $ .length 1:iSize - offset iSize cast.u - @[] =:: stackEntry
  stackEntry .location .register ?? ! if
    "CodeGen: unimplemented non-register cast-source" ..panic
    ## TODO move source to register
  end
  src typeContext types.isIntOrChar and target typeContext types.isIntOrChar if
    src typeContext types.primitiveValue types.sizeOfPrimitive =:: srcBytes
    target typeContext types.primitiveValue types.sizeOfPrimitive =:: targetBytes
    target typeContext toValType stackEntry .valType=
    srcBytes targetBytes == if return end
    target typeContext toValType =:: targetType
    targetType stackEntry .valType=
    stackEntry .location [] .register targetType setRegType =:: targetReg
    srcBytes targetBytes < if
      signType .UNSIGNED ?? if asm.OpType .EXTU else asm.OpType .EXTS end
    else
      asm.OpType .TRUNC
    end
      targetReg asm.Operand .register
      stackEntry .location [] .register asm.Operand .register
    context appendOp2
    targetReg stackEntry .location .register=
    targetReg context findRegister ..drop ## update register type
    return
  end
  castType .bitCast ?? and src typeContext types.isNumberOrChar and target typeContext types.isNumberOrChar if
    src typeContext types.primitiveValue types.sizeOfPrimitive =:: srcBytes
    target typeContext types.primitiveValue types.sizeOfPrimitive =:: targetBytes
    stackEntry .location [] .register =:: mut: targetRegister
    ## TODO? is there a need to keep track of system endianness for float <-> int bit-casts
    ## TODO? should bitcast be defined to emulate a little endian system
    ## 1. float -> int
    src typeContext types.isFloat if
      srcBytes switch
        1 case ValType .I8  break
        2 case ValType .I16 break
        4 case ValType .I32 break
        8 case ValType .I64 break
        default "unexpected size for int" ..panic
      end opIndex context nextRegister =:: intReg
      asm.OpType .MOVE
        intReg asm.Operand .register
        targetRegister asm.Operand .register
      context appendOp2
      intReg targetRegister=
    end
    ## 2. zero-extend/truncate
    srcBytes targetBytes != if
      targetBytes switch
        1 case ValType .I8  break
        2 case ValType .I16 break
        4 case ValType .I32 break
        8 case ValType .I64 break
        default "unexpected size for int" ..panic
      end =:: targetIntVal
      targetRegister targetIntVal setRegType =:: newRegSize
      srcBytes targetBytes < if
        asm.OpType .EXTU
          newRegSize asm.Operand .register
          targetRegister asm.Operand .register
        context appendOp2
      else srcBytes targetBytes > _if
        asm.OpType .TRUNC
          newRegSize asm.Operand .register
          targetRegister asm.Operand .register
        context appendOp2
      end
      newRegSize targetRegister=
    end
    ## 3. int -> float
    target typeContext types.isFloat if
      targetBytes switch
        2 case "f16 is not supported" ..panic
        4 case ValType .F32 break
        8 case ValType .F64 break
        default "unexpected size for float" ..panic
      end =:: targetFloatVal
      src typeContext types.isFloat if
        stackEntry .location [] .register targetFloatVal setRegType
      else
        targetFloatVal opIndex context nextRegister
      end =:: floatReg
      asm.OpType .MOVE
        floatReg asm.Operand .register
        targetRegister asm.Operand .register
      context appendOp2
      floatReg targetRegister=
    end
    target typeContext toValType stackEntry .valType=
    stackEntry .location [] .register targetRegister baseRegEq ! if
      stackEntry .location [] .register context findRegister .data =:: srcReg
      srcReg [] .currentValue targetRegister context findRegister .data .currentValue=
      srcReg [] resetRegister srcReg =[]
    else
      targetRegister context findRegister ..drop ## update register type
    end
    targetRegister stackEntry .location .register=
    return
  end
  src typeContext types.isFloat and target typeContext types.isFloat if
    src typeContext types.primitiveValue types.sizeOfPrimitive =:: srcBytes
    target typeContext types.primitiveValue types.sizeOfPrimitive =:: targetBytes
    target typeContext toValType =:: targetType
    targetType stackEntry .valType=
    stackEntry .location [] .register targetType setRegType =:: targetReg
    srcBytes targetBytes == if return end
    srcBytes targetBytes < if asm.OpType .EXTF else asm.OpType .TRUNCF end
      targetReg asm.Operand .register
      stackEntry .location [] .register asm.Operand .register
    context appendOp2
    targetReg stackEntry .location .register=
    targetReg context findRegister ..drop ## update register type
    return
  end
  src typeContext types.isInt and target typeContext types.isFloat if
    src typeContext types.primitiveValue types.sizeOfPrimitive =:: srcBytes
    target typeContext types.primitiveValue types.sizeOfPrimitive =:: targetBytes
    target typeContext toValType =:: targetVal
    targetVal opIndex context nextRegister =:: targetRegister
    signType .UNSIGNED ?? if asm.OpType .U2F else asm.OpType .I2F end
      targetRegister asm.Operand .register
      stackEntry .location [] .register asm.Operand .register
    context appendOp2
    ## TODO avoid manually updating register data (? movStackValue regId, regId operation )
    stackEntry .location [] .register context findRegister .data =:: srcReg
    srcReg [] .currentValue targetRegister context findRegister .data .currentValue=
    srcReg [] resetRegister srcReg =[]
    targetRegister stackEntry .location .register=
    targetVal stackEntry .valType=
    return
  end
  src typeContext types.isFloat and target typeContext types.isInt if
    src typeContext types.primitiveValue types.sizeOfPrimitive =:: srcBytes
    target typeContext types.primitiveValue =:: primitiveTarget
    primitiveTarget types.sizeOfPrimitive =:: targetBytes
    src typeContext toValType =:: srcVal
    srcVal opIndex context nextRegister =:: tmpReg
    stackEntry .location [] .register asm.Operand .register =:: srcLoc
    target typeContext toValType =:: targetVal
    targetVal opIndex context nextRegister =:: targetRegister
    signType .UNSIGNED ?? if asm.OpType .F2U else asm.OpType .F2I end
      targetRegister asm.Operand .register
      srcLoc
    context appendOp2
    ## TODO avoid manually updating register data
    stackEntry .location [] .register context findRegister .data =:: srcReg
    srcReg [] .currentValue targetRegister context findRegister .data .currentValue=
    srcReg [] resetRegister srcReg =[]
    targetRegister stackEntry .location .register=
    targetVal stackEntry .valType=
    return
  end
  ## ptr <-> int
  src typeContext types.isPointer and target typeContext types.isInt if
    types.primitive.I_SIZE .primitiveType types.sizeOfPrimitive =:: srcBytes
    target typeContext types.primitiveValue types.sizeOfPrimitive =:: targetBytes
    target typeContext toValType stackEntry .valType=
    srcBytes targetBytes == if return end
    target typeContext toValType =:: targetType
    targetType stackEntry .valType=
    stackEntry .location [] .register targetType setRegType =:: targetReg
    srcBytes targetBytes < if
      signType .UNSIGNED ?? if asm.OpType .EXTU else asm.OpType .EXTS end
    else
      asm.OpType .TRUNC
    end
      targetReg asm.Operand .register
      stackEntry .location [] .register asm.Operand .register
    context appendOp2
    targetReg stackEntry .location .register=
    targetReg context findRegister ..drop ## update register type
    return
  end
  src typeContext types.isInt and target typeContext types.isPointer if
    src typeContext types.primitiveValue types.sizeOfPrimitive =:: srcBytes
    types.primitive.I_SIZE .primitiveType types.sizeOfPrimitive =:: targetBytes
    target typeContext toValType stackEntry .valType=
    srcBytes targetBytes == if return end
    target typeContext toValType =:: targetType
    targetType stackEntry .valType=
    stackEntry .location [] .register targetType setRegType =:: targetReg
    srcBytes targetBytes < if
      signType .UNSIGNED ?? if asm.OpType .EXTU else asm.OpType .EXTS end
    else
      asm.OpType .TRUNC
    end
      targetReg asm.Operand .register
      stackEntry .location [] .register asm.Operand .register
    context appendOp2
    targetReg stackEntry .location .register=
    targetReg context findRegister ..drop ## update register type
    return
  end
  ## TODO support different casts
  Atomic .Unknown list.append
end

proc(
  Atomic list : ops
  asm.OpType : opType
  ValType : argType
  FilePosition : pos
  i32 : opIndex
  CompilerContext ptr.mut : context
-> Atomic list ) =>: compileUnaryOperator
  ops
    argType CheckValue .value pos context popValue =:: argValue?
    argValue? optional.isEmpty if return end
    argValue? .data =:: argValue
  =:: mut: newOps
  ## TODO check if argument caches any variables, if not reuse same register(s)
  argType switch
    EMPTY case break
    I8 I16 I32 I64 PTR F32 F64 case
      newOps
        argType opIndex context nextRegister =:: targetRegister
        opType
          targetRegister asm.Operand .register
          argValue .location switch ## TODO? extract for procedure
            register case argValue .location .register asm.Operand .register break
            memory case context [] .stack .length i32 cast.u asm.Operand .stackData break
            registers registerHi registerLow case ..unreachable ## wrong data-format
          end
        context appendOp2
        ## pushValue
          argType
          targetRegister ValueLocation .register
          opIndex
          context
        pushValue
      return
    REFERENCE case
      break
    BITS32 BITS32F BITS64 BITS64F BITS128 BITS128IF BITS128FI BITS128F case
      break
  end
  newOps
    Atomic .Unknown list.append
  return
end
proc(
  Atomic list : ops
  asm.OpType : opType
  ValType : argType
  FilePosition : pos
  i32 : opIndex
  CompilerContext ptr.mut : context
-> Atomic list ) =>: compileBinaryOperator
  RegisterState MAX_DATA_REGISTERS array : argRegBuffer
  context .stack [] .length =:: stackSize
  ops
    argType isIntValType if
      opType stackSize i32 cast.u argRegBuffer@ AMD64.fixedInputInt =:: inputLocs
      inputLocs .length 0:iSize iSize.sgt if
        inputLocs stackSize RegisterRestoreMode .MERGE_FALLTHROUGH pos context restoreRegisters
      end
    end
    argType CheckValue .value pos context popValue =:: arg2?
    arg2? optional.isEmpty if return end
    arg2? .data =:: arg2
    argType CheckValue .value pos context popValue =:: arg1?
    arg1? optional.isEmpty if return end
    arg1? .data =:: arg1
  =:: mut: newOps
  ## TODO check if first argument caches any variables, if not reuse same register(s)
  argType switch
    EMPTY case break
    I8 I16 I32 I64 PTR F32 F64 case
      newOps
        argType isIntValType and
            opType AMD64.fixedTargetInt =:: target?
            target? optional.hasData if
          target? .data argType setRegType
        else
          argType opIndex context nextRegister
        end =:: targetRegister
        opType
          targetRegister asm.Operand .register
          arg1 .location switch ## TODO? extract for procedure
            register case arg1 .location .register asm.Operand .register break
            memory case context [] .stack .length i32 cast.u asm.Operand .stackData break
            registers registerHi registerLow case ..unreachable ## wrong data-format
          end
          arg2 .location switch ## TODO? extract for procedure
            register case arg2 .location .register asm.Operand .register break
            memory case context [] .stack .length i32 cast.u asm.Operand .stackData break
            registers registerHi registerLow case ..unreachable ## wrong data-format
          end
        context appendOp3
        ## pushValue
          argType
          targetRegister ValueLocation .register
          opIndex
          context
        pushValue
      return
    REFERENCE case
      break
    BITS32 BITS32F BITS64 BITS64F BITS128 BITS128IF BITS128FI BITS128F case
      break
  end
  newOps
    Atomic .Unknown list.append
  return
end
proc(
  Atomic list : ops
  asm.CompareType : cmpType
  ValType : argType
  FilePosition : pos
  i32 : opIndex
  CompilerContext ptr.mut : context
-> Atomic list ) =>: compileComparisonOperator
  ops
    argType CheckValue .value pos context popValue =:: arg2?
    arg2? optional.isEmpty if return end
    arg2? .data =:: arg2
    argType CheckValue .value pos context popValue =:: arg1?
    arg1? optional.isEmpty if return end
    arg1? .data =:: arg1
  =:: mut: newOps
  ## TODO check if first argument caches any variables, if not reuse same register(s)
  argType switch
    EMPTY case break
    I8 I16 I32 I64 PTR F32 F64 case
      newOps
        argType opIndex context nextRegister =:: targetRegister
        asm.OpType .CMP
          cmpType asm.Operand .cmpType
          targetRegister asm.Operand .register
          arg1 .location switch ## TODO? extract for procedure
            register case arg1 .location .register asm.Operand .register break
            memory case context [] .stack .length i32 cast.u asm.Operand .stackData break
            registers registerHi registerLow case ..unreachable ## wrong data-format
          end
          arg2 .location switch ## TODO? extract for procedure
            register case arg2 .location .register asm.Operand .register break
            memory case context [] .stack .length i32 cast.u asm.Operand .stackData break
            registers registerHi registerLow case ..unreachable ## wrong data-format
          end
        context appendOp4
        ## pushValue
          ValType .I8
          targetRegister ValueLocation .register
          opIndex
          context
        pushValue
      return
    REFERENCE case
      break
    BITS32 BITS32F BITS64 BITS64F BITS128 BITS128IF BITS128FI BITS128F case
      break
  end
  newOps
    Atomic .Unknown list.append
  return
end

proc(
  Atomic list : ops
  BuiltIn : builtIn
  Type : opType
  FilePosition : pos
  i32 : opIndex
  CompilerContext ptr.mut : context
-> Atomic list ) =>: compileBuiltIn
  using: Op asm.OpType
  using: Cmp asm.CompareType
  context [] .program =:: program
  program .errors =:: errors
  program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  opType typeContext types.getProcIn .data =:: inTypes
  inTypes .length 0:iSize != if
    opType 0 typeContext types.getProcArgLabel
        labelContext id.labelFlags id.FLAG_STATIC & ? if
      1:i32
    else
      0:i32
    end =:: firstArg
    inTypes firstArg []
  else
      opType typeContext types.getProcOut .data =:: outTypes
      outTypes .length 0:iSize != _if
    outTypes 0 []
  else
    Type .undefined
  end =:: baseType
  baseType typeContext toValType =:: baseVal
  builtIn switch
    NEG_I8 NEG_I16 NEG_I32 NEG_I64 NEG_F32 NEG_F64 case
      ops Op .NEG baseVal pos opIndex context compileUnaryOperator return
    ADD_I8 ADD_I16 ADD_I32 ADD_I64 ADD_F32 ADD_F64 case
      ops Op .ADD baseVal pos opIndex context compileBinaryOperator return
    SUB_I8 SUB_I16 SUB_I32 SUB_I64 SUB_F32 SUB_F64 C8_DIFF C16_DIFF C32_DIFF case
     ## TODO? ensure char-diff arguments are zero extended
      ops Op .SUB baseVal pos opIndex context compileBinaryOperator return
    MUL_I32 MUL_I64 MUL_F32 MUL_F64 case
      ops Op .MUL baseVal pos opIndex context compileBinaryOperator return
    DIV_I32 DIV_I64 DIV_F32 DIV_F64 case
      ops Op .DIV baseVal pos opIndex context compileBinaryOperator return
    REM_I32 REM_I64 case
      ops Op .MOD baseVal pos opIndex context compileBinaryOperator return
    UDIV_I32 UDIV_I64 case
      ops Op .UDIV baseVal pos opIndex context compileBinaryOperator return
    UMOD_I32 UMOD_I64 case
      ops Op .UMOD baseVal pos opIndex context compileBinaryOperator return
    NOT_BOOL case
      ops Op .BOOLNOT baseVal pos opIndex context compileUnaryOperator return
    FLIP_I8 FLIP_I16 FLIP_I32 FLIP_I64 case
      ops Op .BITNOT baseVal pos opIndex context compileUnaryOperator return
    AND_BOOL AND_I8 AND_I16 AND_I32 AND_I64 case
      ops Op .AND baseVal pos opIndex context compileBinaryOperator
      return
    OR_BOOL  OR_I8 OR_I16 OR_I32 OR_I64 case
      ops Op .OR baseVal pos opIndex context compileBinaryOperator
      return
    XOR_BOOL XOR_I8 XOR_I16 XOR_I32 XOR_I64 case
      ops Op .XOR baseVal pos opIndex context compileBinaryOperator
      return
    SHL_I8 SHL_I16 SHL_I32 SHL_I64 case
      ops Op .SHL baseVal pos opIndex context compileBinaryOperator
      return
    LSHR_I8 LSHR_I16 LSHR_I32 LSHR_I64 case
      ops Op .LSHR baseVal pos opIndex context compileBinaryOperator
      return
    ASHR_I8 ASHR_I16 ASHR_I32 ASHR_I64 case
      ops Op .ASHR baseVal pos opIndex context compileBinaryOperator
      return
    EQ_BOOL EQ_I8 EQ_I16 EQ_I32 EQ_I64 EQ_F32 EQ_F64 EQ_C8 EQ_C16 EQ_C32 case
      ops Cmp .EQ baseVal pos opIndex context compileComparisonOperator
      return
    NE_BOOL NE_I8 NE_I16 NE_I32 NE_I64 NE_F32 NE_F64 NE_C8 NE_C16 NE_C32 case
      ops Cmp .NE baseVal pos opIndex context compileComparisonOperator
      return
    LT_I8 LT_I16 LT_I32 LT_I64 LT_F32 LT_F64 case
      ops Cmp .LT baseVal pos opIndex context compileComparisonOperator
      return
    ULT_I8 ULT_I16 ULT_I32 ULT_I64 LT_C8 LT_C16 LT_C32 case
      ops Cmp .ULT baseVal pos opIndex context compileComparisonOperator
      return
    LE_I8 LE_I16 LE_I32 LE_I64 LE_F32 LE_F64 case
      ops Cmp .LE baseVal pos opIndex context compileComparisonOperator
      return
    ULE_I8 ULE_I16 ULE_I32 ULE_I64 LE_C8 LE_C16 LE_C32 case
      ops Cmp .ULE baseVal pos opIndex context compileComparisonOperator
      return
    GT_I8 GT_I16 GT_I32 GT_I64 GT_F32 GT_F64 case
      ops Cmp .GT baseVal pos opIndex context compileComparisonOperator
      return
    UGT_I8 UGT_I16 UGT_I32 UGT_I64 GT_C8 GT_C16 GT_C32 case
      ops Cmp .UGT baseVal pos opIndex context compileComparisonOperator
      return
    GE_I8 GE_I16 GE_I32 GE_I64 GE_F32 GE_F64 case
      ops Cmp .GE baseVal pos opIndex context compileComparisonOperator
      return
    UGE_I8 UGE_I16 UGE_I32 UGE_I64 GE_C8 GE_C16 GE_C32 case
      ops Cmp .UGE baseVal pos opIndex context compileComparisonOperator
      return
    DIV_I64I32 REM_I64I32 UDIV_I64I32 UMOD_I64I32 SHL_I64I32 LSHR_I64I32 ASHR_I64I32 case break ## TODO move to standard libray
    GET_PTR GET_PTR_MUT case
      ops
        CheckValue .none pos context popValue =:: argValue?
        argValue? optional.isEmpty if return end
        argValue? .data =:: argValue
        baseType typeContext types.getBaseType typeContext toValType =:: eltVal
        eltVal opIndex context nextRegister =:: targetRegister
        ## TODO handle non-primitive types
        Op .LOAD
          targetRegister asm.Operand .register
          argValue .location switch ## TODO? extract for procedure
            register case argValue .location .register asm.Operand .register break
            memory case context [] .stack .length i32 cast.u asm.Operand .stackData break
            registers registerHi registerLow case ..unreachable ## wrong data-format
          end
        context appendOp2
        targetRegister eltVal context pushRegister
      return
    SET_PTR case
      ops
        ValType .PTR CheckValue .value pos context popValue =:: address?
        address? optional.isEmpty if return end
        address? .data =:: address
        baseVal CheckValue .valueOrReference pos context popValue =:: value?
        value? optional.isEmpty if return end
        value? .data =:: value
        value .valType .REFERENCE ?? if
          "unimplemented: set-ptr with reference value" ..panic
        end
        Op .STORE
          ## TODO update/clear cache for values associated with pointer
          address .location switch
            register case address .location .register asm.Operand .register break
            memory case context [] .stack .length i32 cast.u asm.Operand .stackData break
            registers registerHi registerLow case ..unreachable ## wrong data-format
          end
          value .location switch
            register case value .location .register asm.Operand .register break
            memory case context [] .stack .length i32 cast.u asm.Operand .stackData break
            registers registerHi registerLow case ..unreachable ## wrong data-format
          end
        context appendOp2
      return
    OFFSET_PTR_I32 OFFSET_PTR_MUT_I32 OFFSET_PTR_I64 OFFSET_PTR_MUT_I64 OFFSET_PTR OFFSET_PTR_MUT case
      builtIn .OFFSET_PTR_I32 ?? or builtIn .OFFSET_PTR_MUT_I32 ?? if
        ValType .I32
      else
        ValType .I64
      end =:: offsetType
      ops
        offsetType CheckValue .value pos context popValue =:: offset?
        baseType typeContext types.getBaseType =:: eltType
        offset? optional.isEmpty if return end
        offset? .data =:: offset
        ## TODO? use 32-bit offset if pointer size is 32-bit
        offset .location .register ?? if
          offset .location .register ValType .I64 setRegType
        else
          ValType .I64 opIndex context nextRegister
        end =:: offsetRegister
        ## extend size to 64-bits
        offsetType .I32 ?? if ## TODO? move extending of register to platform dependent code
          Op .EXTS
            offsetRegister asm.Operand .register
            offset .location switch
              register case offset .location .register asm.Operand .register break
              memory case context [] .stack .length i32 cast.u asm.Operand .stackData break
              registers registerHi registerLow case ..unreachable ## wrong data-format
            end
          context appendOp2
        end
        ValType .PTR CheckValue .value pos context popValue =:: base?
        base? optional.isEmpty if return end
        base? .data =:: address
        address .location .register ?? if
          address .location .register ValType .PTR setRegType
        else
          ValType .PTR opIndex context nextRegister
        end =:: addressRegister
        Op .OFFSET
          addressRegister asm.Operand .register
          address .location switch
            register case address .location .register asm.Operand .register break
            memory case context [] .stack .length i32 cast.u asm.Operand .stackData break
            registers registerHi registerLow case ..unreachable ## wrong data-format
          end
          offsetRegister asm.Operand .register
          eltType typeContext types.strideOf .fixed asm.Operand .constInt
        context appendOp4
        addressRegister ValType .PTR context pushRegister
      return
    default break
  end
  ops
    Atomic .Unknown list.append
  return
end

proc(
  Atomic list : ops
  Operation ptr : op
  i32 : opIndex
  CompilerContext ptr.mut : context
-> Atomic list ) =>: compileOp
  context [] .program =:: program
  program .errors =:: errors
  program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  ops
    op .val .implementProcedure ?? if
      true context .reachable=
      op .val [] .implementProcedure =:: implInfo
      op [] .dataType =:: procType
      program [] .procedures
        implInfo .procId i64 cast list.at .data
      =:: procInfo
      context resetRegisters
      op [] Atomic .DebugStartOp list.append
      asm.OpType .LABEL
        procInfo [] .labelId implInfo .implementationId asm.GlobalLabel new asm.Operand .globalLabel
      context appendOp1
      implInfo Atomic .StartProc list.append
      ## TODO setup procedure memory
      ##   -> stackMemory int,float,v128
      ##   -> localVariables
      ##   -> memory for named arguments passed in registers
      procType typeContext types.getProcIn .data =:: args
      0 =:: mut: intArgs
      0 =:: mut: floatArgs
      ## TODO? is there a way to avoid having two loops (registers are counted right to left, arguments are pushed left ot right)
      ## count argument types
      args .length i32 cast 1 - while $ 0 >= do =:: i
        args i [] =:: argType
        argType typeContext types.isEmpty or
            procType i typeContext types.getProcArgLabel labelContext id.labelFlags id.FLAG_STATIC & ? if
          continue ## skip empty arguments
        end
        argType typeContext toValType =:: valType
        valType isMultiRegValType if
          valType getHiValType isFloatValType if
            floatArgs 1 + floatArgs=
          else
            intArgs 1 + intArgs=
          end
          valType getLowValType isFloatValType if
            floatArgs 1 + floatArgs=
          else
            intArgs 1 + intArgs=
          end
        else valType isFloatValType _if
          floatArgs 1 + floatArgs=
        else
          intArgs 1 + intArgs=
        end
      finally i 1 - end ..drop
      ## go through arguments from left to right (to have push statements in correct order)
      0 while $ args .length i32 cast < do =:: i
        procType i typeContext types.getProcArgLabel =:: label
        args i [] =:: argType
        argType typeContext types.isEmpty or label labelContext id.labelFlags id.FLAG_STATIC & ? if
          continue ## skip empty arguments
        end
        argType typeContext toValType =:: valType
        ## registers are counted from left to right (-> decrement max-count when parsing left to right)
        valType isMultiRegValType if
          valType getLowValType =:: lowVal
          valType getHiValType =:: hiVal
          hiVal isFloatValType if
            floatArgs 1 - floatArgs=
            floatArgs AMD64.getFloatArgumentRegister
          else
            intArgs 1 - intArgs=
            intArgs AMD64.getIntArgumentRegister
          end hiVal setRegType =:: hiReg
          lowVal isFloatValType if
            floatArgs 1 - floatArgs=
            floatArgs AMD64.getFloatArgumentRegister
          else
            intArgs 1 - intArgs=
            intArgs AMD64.getIntArgumentRegister
          end lowVal setRegType =:: lowReg
          hiReg NO_REG == or lowReg NO_REG == if
            "memory multi-values are not implemented":s Atomic .DebugError list.append
            intArgs ValueLocation .compositeArgument ## TODO count composite arguments
          else
            lowReg hiReg RegisterPair new ValueLocation .registers
          end
        else
          valType isFloatValType if
            floatArgs 1 - floatArgs=
            floatArgs AMD64.getFloatArgumentRegister
          else
            intArgs 1 - intArgs=
            intArgs AMD64.getIntArgumentRegister
          end valType setRegType =:: argRegister
          argRegister NO_REG != if
            argRegister ValueLocation .register
          else valType isFloatValType _if
            floatArgs ValueLocation .floatArgument
          else
            intArgs ValueLocation .intArgument
          end
        end =:: argLocation
        label id.LABEL_ID_NONE == if ## push argument
          valType argLocation opIndex context pushValue
        else
          argLocation .register ?? if ## TODO! handle values passed by reference
            asm.OpType .STORE
              label asm.Operand .localMemory
              argLocation .register asm.Operand .register
            context appendOp2
            label argLocation .register valType .REFERENCE ?? opIndex context cacheVariable
          else argLocation .registers ?? _if
            argLocation .registers .low =:: lowReg
            asm.OpType .STORE
              label asm.Operand .localMemory
              lowReg asm.Operand .register
            context appendOp2
            asm.OpType .STORE
              label lowReg getRegSize asm.LabelAndOffset new asm.Operand .localMemoryAndOffset
              argLocation .registers .hi asm.Operand .register
            context appendOp2
            label argLocation .registers opIndex context cacheVariable2
          else
            "non-register variable arguments are not supported":s Atomic .DebugError list.append
          end
        end
      finally i 1 + end ..drop
      procInfo [] .implementation .code ?? ! if
        "unexpected procedure implementation" sb.copyPtr
        op [] .pos errors appendError
        return
      end
      return
    end
    context [] .reachable ! and op [] .val .block ?? ! and op [] .val .blockEnd ?? ! if
      return ## skip unreachable statements
    end
    op [] Atomic .DebugStartOp list.append
    op [] .val switch
      Constant case
        op [] .dataType typeContext types.isPointer if
          op [] .dataType typeContext types.ptrTarget op [] .val .Constant context newPtrConstant =:: ptrId
          ValType .PTR ptrId ValueLocation .ptrConstant opIndex context pushValue
          return
        end
        op [] .dataType typeContext toValType =:: valType
        ## FIXME use value-type to determine target type, truncate intergers to correct size
        ## TODO make operation dependent on value type
        ## TODO extract conversion constant -> location to procedure
        op [] .val .Constant switch
          Int case
            valType op [] .val .Constant .Int ValueLocation .intConstant opIndex context pushValue
            return
          Char case
            valType op [] .val .Constant .Char i64 cast.u ValueLocation .intConstant opIndex context pushValue
            return
          Bool case
            valType op [] .val .Constant .Bool ?1 i64 cast.u ValueLocation .intConstant opIndex context pushValue
            return
          EnumLabel case
            valType op [] .val .Constant .EnumLabel i64 cast.u ValueLocation .intConstant opIndex context pushValue
            return
          Float case
            valType op [] .val .Constant .Float ValueLocation .floatConstant opIndex context pushValue
            return
          Array Array8 Array16 Array32 Array64 case
            op [] .dataType op [] .val .Constant context newPtrConstant =:: ptrId
            ValType .REFERENCE ptrId ValueLocation .ptrConstant opIndex context pushValue
            #+valType isMultiRegValType if ## TODO? load value default
              valType getLowValType opIndex context nextRegister =:: lowReg
              valType getHiValType opIndex context nextRegister =:: hiReg
              asm.OpType .LOAD
                lowReg asm.Operand .register
                ptrId asm.Operand .constPtr
              context appendOp2
              asm.OpType .LOAD
                hiReg asm.Operand .register
                ptrId lowReg getRegSize asm.ConstAndOffset new asm.Operand .constPtrAndOffset
              context appendOp2
              valType lowReg hiReg RegisterPair new ValueLocation .registers opIndex context pushValue
            else
              valType opIndex context nextRegister =:: valReg
              asm.OpType .LOAD
                valReg asm.Operand .register
                ptrId asm.Operand .constPtr
              context appendOp2
              valType valReg ValueLocation .register opIndex context pushValue
            end+#
            return
          default break ## TODO support other constant types
        end
        break
      ConstantReference case
        op [] .dataType
          program [] .constantReferences ## TODO? store const-value in const-reference once asm is main back-end
            op [] .val .ConstantReference i64 cast.u
          [] .value
        context newPtrConstant =:: ptrId
        ValType .REFERENCE ptrId ValueLocation .ptrConstant opIndex context pushValue
        return
      NewEnum case
        op [] .dataType typeContext toValType =:: valType
        op [] .dataType typeContext types.isEnum if
          valType op [] .val .NewEnum i64 cast.s ValueLocation .intConstant opIndex context pushValue
          return
        end
        break
      New case
        op [] .dataType typeContext toValType =:: valType
        NO_REG =:: mut: hiReg
        NO_REG =:: mut: lowReg
        valType isMultiRegValType if
          valType getLowValType =:: low
          valType getHiValType =:: hi
          low opIndex context nextRegister lowReg=
          hi opIndex context nextRegister hiReg=
        else
          valType opIndex context nextRegister lowReg=
        end
        op [] .dataType typeContext types.isArray if
          asm.OpType .CLEAR
            lowReg asm.Operand .register
          context appendOp1
          hiReg NO_REG == if
            valType lowReg ValueLocation .register opIndex context pushValue
          else
            asm.OpType .CLEAR
              hiReg asm.Operand .register
            context appendOp1
            valType lowReg hiReg RegisterPair new ValueLocation .registers opIndex context pushValue
          end
          return ## nothing to do for array (clearing is enough)
        end
        op [] .dataType typeContext types.isTuple ! if
          "CodeGen: unsupported type for new" ..panic
        end
        lowReg getRegSize i64 cast.u =:: lowRegSize
        false =:: mut: usedLow
        false =:: mut: usedHi
        op [] .dataType typeContext types.compositeElts =:: eltTypes
        eltTypes .length i32 cast 1 - while $ 0 >= do =:: i
          eltTypes i [] =:: eltType
          eltType typeContext toValType =:: eltVal
          op [] .dataType i i32 cast typeContext types.tupleElementOffset .data =:: eltOffset
          eltType typeContext types.sizeOf .fixed =:: eltSize
          eltVal .REFERENCE ?? ! "no reference type in value tuple" assert
          eltVal CheckValue .valueOrReference op [] .pos context popValue =:: elt?
          elt? optional.isEmpty if
            "CodeGen: invalid type for tuple-element":s Atomic .DebugError list.append
            continue
          end
