            end
            StackValueLocation .memory stackData .location=
            register context resetRegisterById ## clear previous location
          else
            asm.OpType .MOVE
              targetRegister asm.Operand .register
              stackSlot isHi if asm.Operand .stackData128Hi else asm.Operand .stackData128Low end
            context appendOp2
            StackValueLocation .memory stackData .location=
          end
        end
        regPair
          targetRegister >$ isHi if .hi= else .low= end
        regPair=
        regPair .hi NO_REG == if
          regPair .low stackData .location .registerLow=
        else regPair .low NO_REG == _if
          regPair .hi stackData .location .registerHi=
        else
          regPair stackData .location .registers=
        end
        break
    end
    expectedValue regs i @[] .currentValue=
    targetRegister regs i @[] .register=
  end
  usedEmptyReg if ## cleanup tmp-vars that were moved to previously cleared slots
    regs .length for =:: i
      buffer i [] .currentValue .forceClear ?? or mode .MERGE ?? and buffer i [] .currentValue .empty ?? if
        regs i [] context clearRegister regs i =[]
      end
    end
  end
end

proc( CompilerContext ptr.mut : context -> i32 ) =>: nextLabelId
  context [] .labelCount
    $ 1 + context .labelCount=
  return
end
proc(
  BlockId : blockId
  i32 : startLabelId
  CompilerContext ptr.mut : context
-> WhileBlockInfo ptr.mut ) =>: openWhileBlock
  context .dataRegisters [] .length i32 cast =:: regCount
  context [] .openBlocks
    ## WhileBlockInfo
      blockId
      startLabelId
      NO_LABEL NO_LABEL NO_LABEL
      regCount 4 * iSize cast.u RegisterState mem.alloc regCount 4 * slice.createMutable
      regCount
      regCount 2 *
      regCount 3 *
      -1:iSize -1:iSize -1:iSize -1:iSize
    WhileBlockInfo new BlockInfo .While list.append
  context .openBlocks=
  context [] .openBlocks list.peek .data .While
end
