struct(
  i32 : startLabelId
  i32 : doLabelId
  i32 : finallyLabelId
  i32 : endLabelId
  ## TODO remember which registers are read within loop (without beeing overwritten first, do not need to be restored)
  RegisterState slice.mut : regData ## storage for register data (heap allocated)
  ## regData: [WHILE][DO][CONTINUE][BREAK]
  i32 : doRegsOffset ## offset for reg-data in do-branch
  i32 : continueRegsOffset ## offset for reg-data in continue-branches
  i32 : breakRegsOffset ## offset for reg-data in break-branches
) =:: WhileBlockInfo
struct(
  i32 : ifLabelId
  i32 : elseLabelId
  i32 : endLabelId
  RegisterState slice.mut : regData ## storage for register data (heap allocated)
  ## regData: [ELSE-start][IF-start][Branch-end]
  i32 : ifStartRegsOffset
  i32 : elseRegsOffset ## offset for reg-data in else-branch
  bool : hasIf
) =:: IfBlockInfo
union(
  WhileBlockInfo : While
  IfBlockInfo : If
) =:: BlockInfo

## TODO? keep track of registers holding constant values
struct(
  ProgramContext ptr.mut : program
  RegisterState slice.mut : intDataRegisters ## ? store float register states in same array, remember offset
  StackValue list : stack ## TODO? seperate stacks for ints, floats, and double-register values
  LabelId ValueLocation hashMap : variableLocations
  BlockInfo list : openBlocks
  i32 : labelCount
) =:: CompilerContext

proc( LabelId : valId RegisterId : register i32 : opIndex CompilerContext ptr.mut : context -> ) =>: cacheVariable
  context .variableLocations
    valId
    register ValueLocation .register
  map.put =:: prevLocation?
  ## remove previous location from register data
  prevLocation? optional.hasData and
      prevLocation? .data =:: prevLocation
      prevLocation .registers ?? ! "CodeGen: single register value not stored inregister pair" assert
      prevLocation .register ?? and
      prevLocation .register context findRegister =:: prevRegisterData?
      prevRegisterData? optional.hasData if
    prevRegisterData? .data =:: prevRegisterData
    RegisterContent .empty prevRegisterData .currentValue=
  end
  ## update register storage
  register context findRegister
    $ optional.isEmpty if ..drop return end
  .data =:: registerData
  opIndex registerData .lastUsed=
  registerData .currentValue .empty ?? "caching variable does not overwrite register" assert
  valId RegisterContent .variable registerData .currentValue=
end
proc( LabelId : valId RegisterPair : register i32 : opIndex CompilerContext ptr : context -> ) =>: cacheVariable2
  ## TODO cache double-register value
  "CodeGen: unimplemented" ..panic
end
proc( RegisterState : state -> RegisterState ) =>: resetRegister
  state
    RegisterContent .empty >$ .currentValue=
    -1 >$ .lastUsed=
  return
end
proc( LabelId : valId CompilerContext ptr.mut : context -> ValueLocation ptr.mut optional ) =>: atCachedVarLocation
  context .variableLocations valId map.at
end
proc( LabelId : valId bool : isGlobal CompilerContext ptr.mut : context -> ValueLocation ) =>: getVarLocation
  context .variableLocations
    valId
  map.get =:: location?
  location? optional.hasData if
    ## TODO update dependent cache if multi-value cache is accessed after back-jump
    ##    * variable mutable -> removes all other cached values
    ##    * variable immutable -> removes all mutable cached values
    location? .data return
  end
  valId
    isGlobal if
      ValueLocation .globalMemory
    else
      ValueLocation .localMemory
    end
  return
end

## TODO! easy way to get from register to register-state
proc(
  RegisterId : reg
  CompilerContext ptr.mut : context
-> RegisterState ptr.mut optional ) =>: findRegister ## TODO? better name
  reg NO_REG == if
    RegisterState ptr.mut optional.empty return
  end
  context .intDataRegisters [] .length for =:: i
    context [] .intDataRegisters i @[] =:: intReg
    intReg [] .register reg == if
      intReg optional.wrap return
    end
  end
  RegisterState ptr.mut optional.empty return
end

proc(
  CompilerContext ptr.mut : context
-> ) =>: resetRegisters
  context [] .stack list.clear context .stack=
  context .variableLocations map.clear
  context .intDataRegisters [] .length for =:: i
    context [] .intDataRegisters i []
      resetRegister
    context [] .intDataRegisters i =[]
  end
  ## TODO reset float registers
end

proc( i32 : stackSlot CompilerContext ptr.mut : context -> StackValue ptr.mut ) =>: stackSlotData
  stackSlot 0 < or stackSlot context [] .stack .length >= if
    "CodeGen: stack-data and register-states are out of sync" ..panic
  end
  context [] .stack stackSlot list.at .data
end
proc(
  Atomic list
  RegisterState : regState
  ## TODO option to allow moving value to empty register (if available) instead of memory
  CompilerContext ptr.mut : context
-> Atomic list RegisterState ) =>: clearRegister
  ## save previous value
  regState .currentValue switch
    empty case break
    stackSlot case
      regState .currentValue .stackSlot =:: stackSlot
      stackSlot context stackSlotData =:: stackData
      stackData [] .location switch
        register case
          stackData .location [] .register =:: register
          register regState .register == "CodeGen: stack-data and register state match" assert
          asm.OpType .MOVE
            stackData [] .valType
            stackSlot asm.Operand .stackData
            register asm.Operand .register
          asmOp2 list.append
          StackValueLocation .memory stackData .location=
          break
        memory registers registerHi registerLow case
          "CodeGen: stack-data and register-states are out of sync" ..panic
      end
      StackValueLocation .memory stackData .location=
      break
    stackSlotHi case
      regState .currentValue .stackSlotHi =:: stackSlot
      stackSlot context stackSlotData =:: stackData
      stackData [] .location switch
        registerHi case
          stackData .location [] .registerHi =:: register
          register regState .register == "CodeGen: stack-data and register state match" assert
          asm.OpType .MOVE
            stackData [] .valType getHiValType
            stackSlot asm.Operand .stackData128Hi
            register asm.Operand .register
          asmOp2 list.append
          StackValueLocation .memory stackData .location=
          break
        registers case
          stackData .location [] .registers .hi regState .register == "CodeGen: stack-data and register state match" assert
          asm.OpType .MOVE
            stackData [] .valType getHiValType
            stackSlot asm.Operand .stackData128Hi
            stackData .location [] .registers .hi asm.Operand .register
          asmOp2 list.append
          stackData .location [] .registers .low StackValueLocation .registerLow stackData .location=
          break
        memory register registerLow case
          "CodeGen: stack-data and register-states are out of sync" ..panic
      end
      StackValueLocation .memory stackData .location=
      break
    stackSlotLow case
      regState .currentValue .stackSlotLow =:: stackSlot
      stackSlot context stackSlotData =:: stackData
      stackData [] .location switch
        registerLow case
          stackData .location [] .registerLow =:: register
          register regState .register == "CodeGen: stack-data and register state match" assert
          asm.OpType .MOVE
            stackData [] .valType getLowValType
            stackSlot asm.Operand .stackData128Low
            register asm.Operand .register
          asmOp2 list.append
          StackValueLocation .memory stackData .location=
          break
        registers case
          stackData .location [] .registers .low regState .register == "CodeGen: stack-data and register state match" assert
          asm.OpType .MOVE
            stackData [] .valType getLowValType
            stackSlot asm.Operand .stackData128Low
            stackData .location [] .registers .low asm.Operand .register
          asmOp2 list.append
          stackData .location [] .registers .hi StackValueLocation .registerHi stackData .location=
          break
        memory register registerHi case
          "CodeGen: stack-data and register-states are out of sync" ..panic
      end
      break
    variable case
      context .variableLocations regState .currentValue .variable map.remove ..drop ## TODO check if correct value was removed
      break
  end
  regState resetRegister
end

proc(
  Atomic list : ops
  i32 : opIndex
  CompilerContext ptr.mut : context
-> Atomic list RegisterId ) =>: nextIntRegister
  context [] .intDataRegisters 0 @[] =::  mut: bestCandidate
  0:i64 =:: mut: candiateIndex
  1:i64 while $ context .intDataRegisters [] .length < and bestCandidate [] .lastUsed 0 >= do =:: i
    context [] .intDataRegisters i [] .lastUsed bestCandidate [] .lastUsed < if
      context [] .intDataRegisters i @[] bestCandidate=
      i candiateIndex=
    end
  finally i 1 + end ..drop
  ops
    ## clear values cache register
    bestCandidate [] context clearRegister bestCandidate =[]
    opIndex bestCandidate .lastUsed=
  bestCandidate [] .register return
end

proc( RegisterState slice.mut : buffer CompilerContext ptr.mut : context -> ) =>: rememberRegisters
  context [] .intDataRegisters =:: intRegs
  buffer .length intRegs .length >= "CodeGen: buffer large enough to store registers" assert
  buffer .data intRegs .data intRegs .length mem.copy ..drop ## copy register data
end
enum( MERGE MERGE_FALLTHROUGH RESET ) =:: RegisterRestoreMode
proc(
  Atomic list
  RegisterState slice.mut : buffer
  RegisterRestoreMode : mode
  CompilerContext ptr.mut : context
-> Atomic list ) =>: restoreRegisters
  context [] .program =:: program
  program .idContext =:: idContext
  context [] .intDataRegisters =:: intRegs
  false =:: mut: tmpMovedToLower
  buffer .length intRegs .length >= "CodeGen: buffer large enough to store registers" assert
  ## TODO? smarter algorithm (reduce number of moves)
  ## 1. clear all registers holding value not appearing in new state
  ## 2. move all values where source is register and target is currently free
  intRegs .length for =:: i
    intRegs i [] .currentValue =:: currentValue
    buffer i [] .currentValue =:: expectedValue
    expectedValue currentValue RegisterContent.eq if ## already correct value in register
      buffer i [] .lastUsed intRegs i @[] .lastUsed= ## mark resister as used
      continue
    end
    ## current value is wrong -> clear out register
    mode .RESET ?? if
      RegisterContent .empty intRegs i @[] .currentValue=
    else
      currentValue .empty ?? ! if
        -1:i64 =:: mut: freeSlot
        intRegs .length for =:: j
          j i == if continue end
          intRegs j [] .currentValue .empty ?? if
            j freeSlot=
            break
          end
        end
        freeSlot 0 >= if
          intRegs freeSlot [] .register =:: targetRegister
          intRegs i [] .register =:: srcRegister
          ## temporarily move value to free register
          currentValue intRegs freeSlot @[] .currentValue=
          currentValue switch
            variable case
              expectedValue .variable idContext id.getIdentifier
                ! "CodeGen: identifier exists" assert
              =:: idData
              currentValue .variable context atCachedVarLocation .data =:: varLoc
              varLoc [] .register srcRegister == "CodeGen: variable-cache and registers in sync" assert
              targetRegister varLoc .register=
              idData [] .valueType program toValType
              break
            stackSlot case
              currentValue .stackSlot context stackSlotData =:: stackData
              stackData .location [] .register srcRegister == "CodeGen: stack and registers in sync" assert
              targetRegister stackData .location .register=
              stackData [] .valType
              break
            stackSlotHi stackSlotLow case "unimplemented" ..panic
            empty case ..unreachable
          end =:: valType
          asm.OpType .MOVE
            valType
            targetRegister asm.Operand .register
            srcRegister asm.Operand .register
          asmOp2 list.append
          RegisterContent .empty intRegs i @[] .currentValue=
          tmpMovedToLower freeSlot i < | tmpMovedToLower=
        else
          intRegs i [] context clearRegister intRegs i =[]
        end
      end
    end
    ## copy expected value into register
    ## TODO? delay copying of memory values (to keep space of moved values)
    buffer i [] .register =:: targetRegister
    expectedValue switch
      empty case
        intRegs i [] .currentValue .empty ?? "register cleared before assign" assert
        break
      variable case
        expectedValue .variable idContext id.getIdentifier
          ! "CodeGen: identifier exists" assert
        =:: idData
        expectedValue .variable idData .idType [] .GLOBAL_VAR ?? context getVarLocation =:: varLoc
        varLoc switch
          register case
            asm.OpType .MOVE
              idData [] .valueType program toValType
              targetRegister asm.Operand .register
              varLoc .register asm.Operand .register
            asmOp2 list.append
            break
          localMemory case
            asm.OpType .MOVE
              idData [] .valueType program toValType
              targetRegister asm.Operand .register
              varLoc .localMemory asm.Operand .localMemory
            asmOp2 list.append
            break
          globalMemory case
            asm.OpType .MOVE
              idData [] .valueType program toValType
              targetRegister asm.Operand .register
              varLoc .globalMemory asm.Operand .globalMemory
            asmOp2 list.append
            break
          registerHi registerLow registers case "unimplemented" ..panic
          default "CodeGen: unsupported variable location" ..panic
        end
        expectedValue .variable targetRegister buffer i [] .lastUsed context cacheVariable ## update variable location
        break
      stackSlot case
        expectedValue .stackSlot =:: stackSlot
        stackSlot context stackSlotData =:: stackData
        stackData [] .location switch
          register case
            stackData .location [] .register =:: register
            asm.OpType .MOVE
              stackData [] .valType
              targetRegister asm.Operand .register
              register asm.Operand .register
            asmOp2 list.append
            StackValueLocation .memory stackData .location=
            register context findRegister .data =:: regState
            regState [] resetRegister regState =[] ## clear previous location
            break
          memory case
            asm.OpType .MOVE
              stackData [] .valType
              targetRegister asm.Operand .register
              stackSlot asm.Operand .stackData
            asmOp2 list.append
            StackValueLocation .memory stackData .location=
            break
          registers registerHi registerLow case
            "CodeGen: stack-data and register-states are out of sync" ..panic
        end
        targetRegister stackData .location .register=
        break
      stackSlotHi stackSlotLow case "unimplemented" ..panic
    end
    expectedValue intRegs i @[] .currentValue=
  end
  tmpMovedToLower if ## cleanup tmp-vars that were moved to previously cleared slots
    intRegs .length for =:: i
      buffer i [] .currentValue .empty ?? if
        intRegs i [] context clearRegister intRegs i =[]
      end
    end
  end
end

proc( CompilerContext ptr.mut : context -> i32 ) =>: nextLabelId
  context [] .labelCount
    $ 1 + context .labelCount=
  return
end
proc(
  i32 : startLabelId
  CompilerContext ptr.mut : context
-> WhileBlockInfo ptr.mut ) =>: openWhileBlock
  context .intDataRegisters [] .length i32 cast =:: intRegCount
  context [] .openBlocks
    ## WhileBlockInfo
      startLabelId
      NO_LABEL NO_LABEL NO_LABEL
      intRegCount 4 * i64 cast.u RegisterState mem.alloc intRegCount 4 * slice.createMutable
      intRegCount
      intRegCount 2 *
      intRegCount 3 *
    WhileBlockInfo new BlockInfo .While list.append
  context .openBlocks=
  context [] .openBlocks list.peek .data .While
end
proc(
  CompilerContext ptr.mut : context
-> IfBlockInfo ptr.mut ) =>: openIfBlock
  context .intDataRegisters [] .length i32 cast =:: intRegCount
  context [] .openBlocks
    ## WhileBlockInfo
      NO_LABEL
      NO_LABEL
      NO_LABEL
      intRegCount 3 * i64 cast.u RegisterState mem.alloc intRegCount 4 * slice.createMutable
      intRegCount
      intRegCount 2 *
      false
    IfBlockInfo new BlockInfo .If list.append
  context .openBlocks=
  context [] .openBlocks list.peek .data .If
end

proc(
  RegisterId : regId
  ValType : valType
  CompilerContext ptr.mut : context
-> ) =>: pushRegister
  regId context findRegister .data =:: regState
  regState .currentValue .empty ?? "CodeGen: pushed register is currently unassigned" assert
  context .stack [] .length RegisterContent .stackSlot regState .currentValue=
  context [] .stack
    regId StackValueLocation .register valType StackValue new list.push
  context .stack=
end
proc(
  Atomic list : ops
  ValType : valType
  ValueLocation : location
  i32 : opIndex
  CompilerContext ptr.mut : context
-> Atomic list ) =>: pushValue
  ops =:: mut: newOps
  ## TODO make dependent on valType
  location switch
    register case
      location .register context findRegister =:: regState
      regState optional.hasData and regState .data .currentValue [] .empty ?? if
        opIndex regState .data .lastUsed=
        location .register valType context pushRegister
      else ## arg register is not a valid data register
        newOps
          opIndex context nextIntRegister =:: targetRegister
          asm.OpType .MOVE
            valType
            targetRegister asm.Operand .register
            location .register asm.Operand .register
          asmOp2 list.append
        newOps=
        targetRegister valType context pushRegister
      end
      newOps return
    registers registerHi registerLow case
      break
    intConstant case
      newOps
        opIndex context nextIntRegister =:: targetRegister
        asm.OpType .MOVE
          valType
          targetRegister asm.Operand .register
          location .intConstant asm.Operand .constInt
        asmOp2 list.append
      newOps=
      targetRegister valType context pushRegister
      newOps return
    intArgument case
      break
    floatArgument case
      break
    localMemory case
      break
    globalMemory case
      break
  end
  newOps
    Atomic .Unknown list.append
  return
end
proc(
  Atomic list : ops
  ValType : argType
  FilePosition : pos
  CompilerContext ptr.mut : context
-> Atomic list StackValue optional ) =>: popValue
  context [] .program .errors =:: errors
  context [] .stack .length 0 == if
    ops StackValue optional.empty return
  end
  context [] .stack
    list.pop =:: popped
  context .stack=
  popped .valType argType != if
    "unexpected value type expected: " sb.copyPtr
      argType sb.appendValType
      " got: " sb.appendS
      popped .valType sb.appendValType
    pos errors appendError
    ops StackValue optional.empty return
  end
  ## update status of popped registers
  popped .location switch
    register case
      popped .location .register context findRegister =:: regState
      regState .data [] resetRegister regState .data =[]
      break
    registerHi case
      popped .location .registerHi context findRegister =:: regState
      regState .data [] resetRegister regState .data =[]
      break
    registerLow case
      popped .location .registerLow context findRegister =:: regState
      regState .data [] resetRegister regState .data =[]
      break
    registers case
      popped .location .registers .hi context findRegister =:: hiReg
      popped .location .registers .low context findRegister =:: lowReg
      hiReg .data [] resetRegister hiReg .data =[]
      lowReg .data [] resetRegister lowReg .data =[]
      break
    memory case break ## nothing to do
  end
  ops popped optional.wrap return
end

proc(
  Atomic list : ops
  asm.OpType : opType
  ValType : argType
  FilePosition : pos
  i32 : opIndex
  CompilerContext ptr.mut : context
-> Atomic list ) =>: compileUnaryOperator
  ops
    argType pos context popValue =:: argValue?
    argValue? optional.isEmpty if return end
    argValue? .data =:: argValue
  =:: mut: newOps
  ## TODO check if argument caches any variables, if not reuse same register(s)
  argType switch
    EMPTY case break
    I8 I16 I32 I64 PTR case
      newOps
        opIndex context nextIntRegister =:: targetRegister
        opType
          argType
          targetRegister asm.Operand .register
          argValue .location switch ## TODO? extract for procedure
            register case argValue .location .register asm.Operand .register break
            memory case context [] .stack .length asm.Operand .stackData break
            registers registerHi registerLow case ..unreachable ## wrong data-format
          end
        asmOp2 list.append
        ## pushValue
          argType
          targetRegister ValueLocation .register
          opIndex
          context
        pushValue
      return
    F32 F64 case
      break
    REFERENCE case
      break
    BITS128 BITS128IF BITS128FI BITS128F case
      break
  end
  newOps
    Atomic .Unknown list.append
  return
end
proc(
  Atomic list : ops
  asm.OpType : opType
  ValType : argType
  FilePosition : pos
  i32 : opIndex
  CompilerContext ptr.mut : context
-> Atomic list ) =>: compileBinaryOperator
  ops
    argType pos context popValue =:: arg2?
    arg2? optional.isEmpty if return end
    arg2? .data =:: arg2
    argType pos context popValue =:: arg1?
    arg1? optional.isEmpty if return end
    arg1? .data =:: arg1
  =:: mut: newOps
  ## TODO check if first argument caches any variables, if not reuse same register(s)
  argType switch
    EMPTY case break
    I8 I16 I32 I64 PTR case
      newOps
        opIndex context nextIntRegister =:: targetRegister
        opType
          argType
          targetRegister asm.Operand .register
          arg1 .location switch ## TODO? extract for procedure
            register case arg1 .location .register asm.Operand .register break
            memory case context [] .stack .length asm.Operand .stackData break
            registers registerHi registerLow case ..unreachable ## wrong data-format
          end
          arg2 .location switch ## TODO? extract for procedure
            register case arg2 .location .register asm.Operand .register break
            memory case context [] .stack .length asm.Operand .stackData break
            registers registerHi registerLow case ..unreachable ## wrong data-format
          end
        asmOp3 list.append
        ## pushValue
          argType
          targetRegister ValueLocation .register
          opIndex
          context
        pushValue
      return
    F32 F64 case
      break
    REFERENCE case
      break
    BITS128 BITS128IF BITS128FI BITS128F case
      break
  end
  newOps
    Atomic .Unknown list.append
  return
end
proc(
  Atomic list : ops
  asm.CompareType : cmpType
  ValType : argType
  FilePosition : pos
  i32 : opIndex
  CompilerContext ptr.mut : context
-> Atomic list ) =>: compileComparisonOperator
  ops
    argType pos context popValue =:: arg2?
    arg2? optional.isEmpty if return end
    arg2? .data =:: arg2
    argType pos context popValue =:: arg1?
    arg1? optional.isEmpty if return end
    arg1? .data =:: arg1
  =:: mut: newOps
  ## TODO check if first argument caches any variables, if not reuse same register(s)
  argType switch
    EMPTY case break
    I8 I16 I32 I64 PTR case
      newOps
        opIndex context nextIntRegister =:: targetRegister
        asm.OpType .CMP
          argType
          cmpType asm.Operand .cmpType
          targetRegister asm.Operand .register
          arg1 .location switch ## TODO? extract for procedure
            register case arg1 .location .register asm.Operand .register break
            memory case context [] .stack .length asm.Operand .stackData break
            registers registerHi registerLow case ..unreachable ## wrong data-format
          end
          arg2 .location switch ## TODO? extract for procedure
            register case arg2 .location .register asm.Operand .register break
            memory case context [] .stack .length asm.Operand .stackData break
            registers registerHi registerLow case ..unreachable ## wrong data-format
          end
        asmOp4 list.append
        ## pushValue
          ValType .I8
          targetRegister ValueLocation .register
          opIndex
          context
        pushValue
      return
    F32 F64 case
      break
    REFERENCE case
      break
    BITS128 BITS128IF BITS128FI BITS128F case
      break
  end
  newOps
    Atomic .Unknown list.append
  return
end

proc(
  Atomic list : ops
  BuiltIn : builtIn
  Type : opType
  FilePosition : pos
  i32 : opIndex
  CompilerContext ptr.mut : context
-> Atomic list ) =>: compileBuiltIn
  using: Op asm.OpType
  using: Cmp asm.CompareType
  context [] .program =:: program
  program .errors =:: errors
  program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  opType typeContext types.getProcIn ..drop =:: inType
  inType typeContext types.compositeEltCount 0 > if
    inType 0 typeContext types.compositeGetLabel
        labelContext id.labelFlags id.FLAG_STATIC & ? if
      1:i32
    else
      0:i32
    end =:: firstArg
    inType firstArg typeContext types.compositeGetElement
  else
      opType typeContext types.getProcOut ..drop =:: outType
      outType typeContext types.compositeEltCount 0 > _if
    outType 0 typeContext types.compositeGetElement
  else
    Type .undefined
  end =:: baseType
  baseType program toValType =:: baseVal
  builtIn switch
    NEG_I8 NEG_I16 NEG_I32 NEG_I64 NEG_F32 NEG_F64 case
      ops Op .NEG baseVal pos opIndex context compileUnaryOperator
      return
    ADD_I8 ADD_I16 ADD_I32 ADD_I64 ADD_F32 ADD_F64 case
      ops Op .ADD baseVal pos opIndex context compileBinaryOperator
      return
    SUB_I8 SUB_I16 SUB_I32 SUB_I64 SUB_F32 SUB_F64 C8_DIFF C16_DIFF C32_DIFF case
      ops Op .SUB baseVal pos opIndex context compileBinaryOperator
      return ## TODO ensure char-diff arguments are zero extended
    MUL_I32 MUL_I64 MUL_F32 MUL_F64 case
      ops Op .MUL baseVal pos opIndex context compileBinaryOperator
      return
    DIV_I32  DIV_I64 DIV_F32 DIV_F64 case ## TODO implement remaing operators
      break ## ! div,mod requries speical register setup ( input: rax, rdx=0, output rax,rdx
    DIV_I64I32 case
      break
    REM_I32 REM_I64 case
      break
    REM_I64I32 case
      break
    UDIV_I32 UDIV_I64 case
      break
    UDIV_I64I32 case
      break
    UMOD_I32 UMOD_I64 case
      break
    UMOD_I64I32 case
      break
    NOT_BOOL case
      break
    FLIP_I8 FLIP_I16 FLIP_I32 FLIP_I64 case
      break
    AND_BOOL AND_I8 AND_I16 AND_I32 AND_I64 case
      ops Op .AND baseVal pos opIndex context compileBinaryOperator
      return
    OR_BOOL  OR_I8 OR_I16 OR_I32 OR_I64 case
      ops Op .OR baseVal pos opIndex context compileBinaryOperator
      return
    XOR_BOOL XOR_I8 XOR_I16 XOR_I32 XOR_I64 case
      ops Op .XOR baseVal pos opIndex context compileBinaryOperator
      return
    EQ_BOOL EQ_I8 EQ_I16 EQ_I32 EQ_I64 EQ_F32 EQ_F64 EQ_C8 EQ_C16 EQ_C32 case
      ops Cmp .EQ baseVal pos opIndex context compileComparisonOperator
      return
    NE_BOOL NE_I8 NE_I16 NE_I32 NE_I64 NE_F32 NE_F64 NE_C8 NE_C16 NE_C32 case
      ops Cmp .NE baseVal pos opIndex context compileComparisonOperator
      return
    LT_I8 LT_I16 LT_I32 LT_I64 LT_F32 LT_F64 case
      ops Cmp .LT baseVal pos opIndex context compileComparisonOperator
      return
    ULT_I8 ULT_I16 ULT_I32 ULT_I64 LT_C8 LT_C16 LT_C32 case
      ops Cmp .ULT baseVal pos opIndex context compileComparisonOperator
      return
    LE_I8 LE_I16 LE_I32 LE_I64 LE_F32 LE_F64 case
      ops Cmp .LE baseVal pos opIndex context compileComparisonOperator
      return
    ULE_I8 ULE_I16 ULE_I32 ULE_I64 LE_C8 LE_C16 LE_C32 case
      ops Cmp .ULE baseVal pos opIndex context compileComparisonOperator
      return
    GT_I8 GT_I16 GT_I32 GT_I64 GT_F32 GT_F64 case
      ops Cmp .GT baseVal pos opIndex context compileComparisonOperator
      return
    UGT_I8 UGT_I16 UGT_I32 UGT_I64 GT_C8 GT_C16 GT_C32 case
      ops Cmp .UGT baseVal pos opIndex context compileComparisonOperator
      return
    GE_I8 GE_I16 GE_I32 GE_I64 GE_F32 GE_F64 case
      ops Cmp .GE baseVal pos opIndex context compileComparisonOperator
      return
    UGE_I8 UGE_I16 UGE_I32 UGE_I64 GE_C8 GE_C16 GE_C32 case
      ops Cmp .UGE baseVal pos opIndex context compileComparisonOperator
      return
    default break
  end
  ops
    Atomic .Unknown list.append
  return
end

proc(
  Atomic list : ops
  Operation ptr : op
  i32 : opIndex
  CompilerContext ptr.mut : context
-> Atomic list ) =>: compileOp
  context [] .program =:: program
  program .errors =:: errors
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  ops
    op .val .implementProcedure ?? if
      op .val [] .implementProcedure =:: implInfo
      op [] .dataType =:: procType
      program [] .procedures
        implInfo .procId i64 cast list.at .data
      =:: procInfo
      context resetRegisters
      procInfo [] .labelId Atomic .StartProc list.append
      ## TODO setup procedure memory
      ##   -> stackMemory int,float,v128
      ##   -> localVariables
      ##   -> memory for named arguments passed in registers
      procType typeContext types.getProcIn ..drop =:: inType
      inType typeContext types.compositeElts =:: args
      0 =:: mut: intArgs
      ## TODO ensure arument registers are marked as used (to prevent accidental overwrite)
      0:i32 while $ i64 cast.u args .length < do =:: i
        inType i typeContext types.compositeGetLabel =:: label
        args i slice.get =:: argType
        argType program toValType =:: valType
        argType typeContext types.isEmpty if
          i 1 + continue ## skip empty arguments
        end
        ## TODO different handling dependent on argument type
        intArgs AMD64.getIntArgumentRegister =:: argRegister
        label id.LABEL_ID_NONE == if ## push argument
          argRegister NO_REG == if
            valType intArgs ValueLocation .intArgument opIndex context pushValue
          else
            valType argRegister ValueLocation .register opIndex context pushValue
          end
        else
          argRegister NO_REG != if
            asm.OpType .MOVE
              valType
              label asm.Operand .localMemory
              argRegister asm.Operand .register
            asmOp2 list.append
          end
          argRegister NO_REG != if
            label argRegister opIndex context cacheVariable
          end
        end
        intArgs 1 + intArgs=
        i 1 +
      end ..drop
      procInfo [] .implementation .code ?? ! if
        "unexpected procedure implementation" sb.copyPtr
        op [] .pos errors appendError
        return
      end
      ## allocate space for variables
      implInfo .implementationId 0 >= if
        procInfo [] .implementation .code .implementations
          implInfo .implementationId list.at .data [] .variables
      else
        procInfo [] .implementation .code .variables
      end =:: variables
      variables for =:: varInfo
        VariableType ..length 3 == "no new variable types" assert
        varInfo .variableType .ARGUMENT ?? if
          continue
        end
      end
      return
    end
    op [] Atomic .DebugStartOp list.append
    op [] .val switch
      Constant case
        op [] .dataType program toValType =:: valType
        ## TODO make operation dependent on value type
        ## TODO extract conversion constant -> location to procedure
        op [] .val .Constant .Int ?? if
          valType op [] .val .Constant .Int ValueLocation .intConstant opIndex context pushValue
          return
        end
        break
      declareId case return ## nothing to do (all declarations handled at start of procedure)
      getId case
        op .val .getId =:: idData
        idData [] .labelId =:: labelId
        idData [] .idType switch
          ARGUMENT LOCAL_VAR ITR_VAR TMP_VAR GLOBAL_VAR case
            labelId idData [] .idType .GLOBAL_VAR ?? context getVarLocation =:: variableLocation
            op [] .dataType program toValType
              variableLocation
            opIndex context pushValue
            return
          PROCEDURE case break
          TYPE LABEL PROCEDURE_BUNDLE case
            "unexpected id-type" sb.copyPtr
              ## TODO print id-type
            op [] .pos errors appendError
            break
        end
        break
      atId case break ## TODO atId
      setId initializeId case
        op .val .setId ?? if
          op .val .setId
        else
          op .val .initializeId
        end =:: idData
        idData [] .labelId =:: labelId
        ## TODO invaidate previous cached values
        idData [] .idType switch
          ARGUMENT LOCAL_VAR ITR_VAR TMP_VAR case
            op [] .dataType program toValType =:: valType
            valType op [] .pos context popValue =:: stackValue?
            stackValue? optional.isEmpty if return end
            stackValue? .data =:: stackValue
            stackValue .location switch
              register case
                asm.OpType .MOVE
                  valType
                  labelId asm.Operand .localMemory
                  stackValue .location .register asm.Operand .register
                asmOp2 list.append
                labelId stackValue .location .register opIndex context cacheVariable
                return
              registers case
                ## TODO store to memory
                labelId stackValue .location .registers opIndex context cacheVariable2
                break
              registerHi registerLow case
                "unimplemented" ..panic
              memory case
                ## TODO! make dependent on value type
                opIndex context nextIntRegister =:: tmpRegister
                asm.OpType .MOVE
                  valType
                  tmpRegister asm.Operand .register
                  ## TODO use correct memory location (? `context [] .stackIntCount`)
                  context [] .stack .length asm.Operand .stackData
                asmOp2 list.append
                asm.OpType .MOVE
                  valType
                  labelId asm.Operand .localMemory
                  tmpRegister asm.Operand .register
                asmOp2 list.append
                labelId tmpRegister opIndex context cacheVariable
                return
            end
            break
          PROCEDURE GLOBAL_VAR case break
          TYPE LABEL PROCEDURE_BUNDLE case
            "unexpected id-type" sb.copyPtr
              ## TODO print id-type
            op [] .pos errors appendError
            break
        end
        break
      builtIn case
        ## compileBuiltIn
          op [] .val .builtIn
          op [] .dataType
          op [] .pos
          opIndex
          context
        compileBuiltIn
        return
      block case
        op [] .val .block .blockType switch
          AND_IF OR_IF case
            op [] .val .block .blockType .OR_IF ?? =:: isOr
            context [] .openBlocks list.peek =:: ifBlock?
            ifBlock? optional.isEmpty or ifBlock? .data [] .If ?? ! or ifBlock? .data .If [] .hasIf if
              context openIfBlock
            else
              ifBlock? .data .If
            end =:: ifBlock
            ValType .I8 op [] .pos context popValue =:: srcValue?
            srcValue? optional.isEmpty if
              "stack underflow in if-condition" sb.copyPtr op [] .pos errors appendError
              return
            end
            srcValue? .data =:: srcValue
            isOr if
              ifBlock [] .ifLabelId NO_LABEL == if
                context nextLabelId ifBlock .ifLabelId=
                ifBlock [] .regData ifBlock [] .ifStartRegsOffset slice.tail context rememberRegisters
              else
                ifBlock [] .regData ifBlock [] .ifStartRegsOffset slice.tail
                  RegisterRestoreMode .MERGE_FALLTHROUGH
                context restoreRegisters
              end
            else ifBlock [] .elseLabelId NO_LABEL == _if
              context nextLabelId ifBlock .elseLabelId=
              ifBlock [] .regData context rememberRegisters
            else
              ifBlock [] .regData
                RegisterRestoreMode .MERGE_FALLTHROUGH
              context restoreRegisters
            end
            asm.OpType .JMPIF
              srcValue .valType
              ## TODO! negate condition for and statement
              srcValue .location switch
                register case
                    srcValue .location .register asm.Operand .register
                  break
                memory case ## TODO is this the right offset
                    context [] .stack .length 1 + asm.Operand .stackData
                  break
                registers registerHi registerLow case "unexpected format for condition parameter" ..panic
              end
              isOr if
                ifBlock [] .ifLabelId asm.Operand .localLabel
              else
                ifBlock [] .elseLabelId asm.Operand .localLabel
              end
            asmOp2 list.append
            return
          IF case
            context [] .openBlocks list.peek =:: ifBlock?
            ifBlock? optional.isEmpty or ifBlock? .data [] .If ?? ! or ifBlock? .data .If [] .hasIf if
              context openIfBlock
            else
              ifBlock? .data .If
            end =:: ifBlock
            true ifBlock .hasIf=
            ValType .I8 op [] .pos context popValue =:: srcValue?
            srcValue? optional.isEmpty if
              "stack underflow in if-condition" sb.copyPtr op [] .pos errors appendError
              return
            end
            srcValue? .data =:: srcValue
            ifBlock [] .elseLabelId NO_LABEL == if
              ifBlock [] .regData context rememberRegisters
              context nextLabelId
              $ ifBlock .elseLabelId=
            else
              ifBlock [] .elseLabelId
            end =:: elseLabelId
            asm.OpType .JMPIF
              srcValue .valType
              srcValue .location switch
                register case
                    srcValue .location .register asm.Operand .register
                  break
                memory case ## TODO is this the right offset
                    context [] .stack .length 1 + asm.Operand .stackData
                  break
                registers registerHi registerLow case "unexpected format for condition parameter" ..panic
              end
              elseLabelId asm.Operand .localLabel
            asmOp2 list.append
            ifBlock [] .ifLabelId NO_LABEL != if
              ifBlock [] .regData ifBlock [] .ifStartRegsOffset slice.tail
                RegisterRestoreMode .RESET
              context restoreRegisters
              asm.OpType .LABEL ValType .EMPTY
                ifBlock [] .ifLabelId asm.Operand .localLabel
              asmOp1 list.append
            end
            return
          ELSE case
            context [] .openBlocks list.peek =:: ifBlock?
            ifBlock? optional.isEmpty or ifBlock? .data [] .If ?? ! if
              "unexpected else-statement" sb.copyPtr op [] .pos errors appendError
              return
            end
            ifBlock? .data .If =:: ifBlock
            context nextLabelId =:: endLabelId
            endLabelId ifBlock .endLabelId=
            ## TODO? merge registers instead of resetting to state at end of if branch
            ifBlock [] .regData ifBlock [] .elseRegsOffset slice.tail context rememberRegisters
            asm.OpType .JMP ValType .EMPTY
              endLabelId asm.Operand .localLabel
            asmOp1 list.append
            asm.OpType .LABEL ValType .EMPTY
              ifBlock [] .elseLabelId asm.Operand .localLabel
            asmOp1 list.append
            ifBlock [] .regData RegisterRestoreMode .RESET context restoreRegisters
            return
          WHILE case
            context nextLabelId =:: startLabelId
            startLabelId context openWhileBlock =:: whileBlock
            whileBlock [] .regData context rememberRegisters
            asm.OpType .LABEL ValType .EMPTY
              startLabelId asm.Operand .localLabel
            asmOp1 list.append
            return
          DO case
            context [] .openBlocks list.peek =:: whileBlock?
            whileBlock? optional.isEmpty or whileBlock? .data [] .While ?? ! if
              "unexpected do-statement" sb.copyPtr op [] .pos errors appendError
              return
            end
            whileBlock? .data .While =:: whileBlock
            whileBlock [] .endLabelId NO_LABEL == if
              context nextLabelId whileBlock .endLabelId=
            end
            ValType .I8 op [] .pos context popValue =:: srcValue?
            srcValue? optional.isEmpty if
              "stack underflow in do-condition" sb.copyPtr op [] .pos errors appendError
              return
            end
            srcValue? .data =:: srcValue
            whileBlock [] .regData whileBlock [] .breakRegsOffset slice.tail context rememberRegisters
            asm.OpType .JMPIF
              srcValue .valType
              srcValue .location switch
                register case
                    srcValue .location .register asm.Operand .register
                  break
                memory case ## TODO is this the right offset
                    context [] .stack .length 1 + asm.Operand .stackData
                  break
                registers registerHi registerLow case "unexpected format for condition parameter" ..panic
              end
              whileBlock [] .endLabelId asm.Operand .localLabel
            asmOp2 list.append
            whileBlock [] .doLabelId NO_LABEL != if ## create finally label only if it is used
              asm.OpType .LABEL ValType .EMPTY
                whileBlock [] .doLabelId asm.Operand .localLabel
              asmOp1 list.append
            end
            return
          FINALLY case
            context [] .openBlocks list.peek =:: whileBlock?
            whileBlock? optional.isEmpty or whileBlock? .data [] .While ?? ! if
              "unexpected finally-statement" sb.copyPtr op [] .pos errors appendError
              return
            end
            whileBlock? .data .While =:: whileBlock
            whileBlock [] .finallyLabelId NO_LABEL != if ## create finally label only if it is used
              asm.OpType .LABEL ValType .EMPTY
                whileBlock [] .finallyLabelId asm.Operand .localLabel
              asmOp1 list.append
            end
            ## TODO merge continue branches
            return
          break
          BREAK CONTINUE case break
          default break
        end
        break
      blockEnd case
        op [] .val .blockEnd .blockType switch
          ELSE case
            context [] .openBlocks list.peek =:: ifBlock?
            ifBlock? optional.isEmpty or ifBlock? .data [] .If ?? ! if
              "unexpected end of if block" sb.copyPtr op [] .pos errors appendError
              return
            end
            context [] .openBlocks
              list.pop .If =:: ifBlock
            context .openBlocks=
            ## restoreRegisters
              ifBlock .regData ifBlock .elseRegsOffset slice.tail
              RegisterRestoreMode .MERGE
            context restoreRegisters
            asm.OpType .LABEL ValType .EMPTY
              ifBlock .endLabelId asm.Operand .localLabel
            asmOp1 list.append
            ifBlock .regData .data mem.free
            return
          WHILE case
            context [] .openBlocks list.peek =:: whileBlock?
            whileBlock? optional.isEmpty or whileBlock? .data [] .While ?? ! if
              "unexpected end of while block" sb.copyPtr op [] .pos errors appendError
              return
            end
            context [] .openBlocks
              list.pop .While =:: whileBlock
            context .openBlocks=
            whileBlock .regData RegisterRestoreMode .MERGE context restoreRegisters
            asm.OpType .JMP ValType .EMPTY
              whileBlock .startLabelId asm.Operand .localLabel
            asmOp1 list.append
            asm.OpType .LABEL ValType .EMPTY
              whileBlock .endLabelId asm.Operand .localLabel
            asmOp1 list.append
            ## restoreRegisters
              whileBlock .regData whileBlock .breakRegsOffset slice.tail
              RegisterRestoreMode .RESET
            context restoreRegisters
            whileBlock .regData .data mem.free
          return
          PROCEDURE case Atomic .EndProc list.append return
          default break
        end
        break
      stackMod case
        op [] .val .stackMod .modType switch
          DROP case
            op [] .val .stackMod .n =:: count
            context [] .stack .length count < if
              "CodeGen: stack underflow in drop, stackSize: " sb.copyPtr
                context [] .stack .length sb.appendI
              op [] .pos errors appendError
              context [] .stack list.clear context .stack=
              return
            end
            context [] .stack
              count for ..drop
                list.pop =:: popped
                popped .location switch
                  memory case break ## nothing to do
                  register case
                    RegisterContent .empty popped .location .register context findRegister .data .currentValue=
                    break
                  registers registerHi registerLow case "unimplemented" ..panic
                end
              end
            context .stack=
            return
          COPY case
            op [] .val .stackMod .n =:: offset
            context [] .stack .length offset <= if
              "CodeGen: stack underflow in copy, stackSize: " sb.copyPtr
                context [] .stack .length sb.appendI
              op [] .pos errors appendError
              return
            end
            ## copy value on stack
            context [] .stack
              offset
            list.at .data [] =:: copied
            opIndex context nextIntRegister =:: targetRegister
            ## TODO handle case where copied value is no register
            asm.OpType .MOVE
              copied .valType
              targetRegister asm.Operand .register
              copied .location .register asm.Operand .register
            asmOp2 list.append
            ## TODO remember that copied register holds value of old register, use old register to get value until:
            ##  a) register changes
            ##  b) start of next loop
            targetRegister copied .valType context pushRegister
            return
          SWAP case
            context [] .stack .length 2 < if
              "CodeGen: stack underflow in swap, stackSize: " sb.copyPtr
                context [] .stack .length sb.appendI
              op [] .pos errors appendError
              return
            end
            context [] .stack
              list.pop =:: a
              $ .length =:: hiSlot
              list.pop =:: b
              $ .length =:: lowSlot
              a list.push
              b list.push
            context .stack=
            ## update locations
            ## TODO? reduce duplicate code
            a .location switch
              register case
                a .location .register context findRegister .data =:: regData
                hiSlot regData .currentValue [] .stackSlot == "CodeGen: stack and registers in sync" assert
                lowSlot regData .currentValue .stackSlot=
                break
              registerHi case
                a .location .registerHi context findRegister .data =:: regData
                hiSlot regData .currentValue [] .stackSlotHi == "CodeGen: stack and registers in sync" assert
                lowSlot regData .currentValue .stackSlotHi=
                break
              registerLow case
                a .location .registerLow context findRegister .data =:: regData
                hiSlot regData .currentValue [] .stackSlotLow == "CodeGen: stack and registers in sync" assert
                lowSlot regData .currentValue .stackSlotLow=
                break
              registers case
                a .location .registers .hi context findRegister .data =:: regDataHi
                hiSlot regDataHi .currentValue [] .stackSlotHi == "CodeGen: stack and registers in sync" assert
                lowSlot regDataHi .currentValue .stackSlotHi=
                a .location .registers .low context findRegister .data =:: regDataLow
                hiSlot regDataLow .currentValue [] .stackSlotLow == "CodeGen: stack and registers in sync" assert
                lowSlot regDataLow .currentValue .stackSlotLow=
                break
              memory case break
            end
            b .location switch
              register case
                b .location .register context findRegister .data =:: regData
                lowSlot regData .currentValue [] .stackSlot == "CodeGen: stack and registers in sync" assert
                hiSlot regData .currentValue .stackSlot=
                break
              registerHi case
                b .location .registerHi context findRegister  .data =:: regData
                lowSlot regData .currentValue [] .stackSlotHi == "CodeGen: stack and registers in sync" assert
                hiSlot regData .currentValue .stackSlotHi=
                break
              registerLow case
                b .location .registerLow context findRegister .data =:: regData
                lowSlot regData .currentValue [] .stackSlotLow == "CodeGen: stack and registers in sync" assert
                hiSlot regData .currentValue .stackSlotLow=
                break
              registers case
                b .location .registers .hi context findRegister .data =:: regDataHi
                lowSlot regDataHi .currentValue [] .stackSlotHi == "CodeGen: stack and registers in sync" assert
                hiSlot regDataHi .currentValue .stackSlotHi=
                b .location .registers .low context findRegister .data =:: regDataLow
                lowSlot regDataLow .currentValue [] .stackSlotLow == "CodeGen: stack and registers in sync" assert
                hiSlot regDataLow .currentValue .stackSlotLow=
                break
              memory case break
            end
            return
        end
      break
      default break
    end
    Atomic .Unknown list.append
  return
end
proc( Atomic list : ops string : fileName ProgramContext ptr : program io.FILE : target -> Atomic list ) =>: printOps
  1024 sb.create
    "## " sb.appendS
    fileName sb.appendStr
    '\n' sb.appendC
    ops for program sb.appendAtomic end
    target $1 io.fputSb ..drop
  sb.free ..drop
  ops list.clear
end
proc( io.FILE : target ProgramContext ptr.mut : program -> ) =>: export: compileToASM
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  RegisterState MAX_DATA_REGISTERS_INT array : intRegBuffer
  ## CompilerContext
    program
    intRegBuffer@ AMD64.initIntDataRegisters
    64 StackValue list.create
    labelHash@ labelEq@ 1024 ValueLocation map.create
    64 BlockInfo list.create
    0
  CompilerContext new =:: mut: contextData
  contextData@ =:: context
  1024 Atomic list.create
    ## code
    program [] .progFiles .length for =:: i
      program [] .progFiles i list.get =:: f
      f .localOps .length for =:: opIndex
        f .localOps opIndex list.at .data opIndex context compileOp
      end
      f .fileName sb.asStr program target printOps
    end
  list.free ..drop
end
import debug
