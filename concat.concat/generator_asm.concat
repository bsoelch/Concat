              StackValue 3 array : buffer
              buffer@ list.wrapBuffer
            else
              eltCount StackValue list.create
            end
              eltCount for ..drop
                context [] .stack list.pop >$ context .stack=
                list.append
              end
              offset 0 > if
                list.pop =:: lowValue
                $ .length for ..drop
                  list.pop context pushStackValue regOutOfSync | regOutOfSync=
                end
                lowValue context pushStackValue regOutOfSync | regOutOfSync=
              else
                $ 0 [] context pushStackValue regOutOfSync | regOutOfSync=
                $ .length 1:iSize - for ..drop
                  list.pop context pushStackValue regOutOfSync | regOutOfSync=
                end
              end
            list.free ..drop
            regOutOfSync if
              "CodeGen: stack and registers out of sync":s Atomic .DebugError list.append
            end
            return
        end
      break
      default break
    end
    Atomic .Unknown list.append
  return
end

proc( Atomic list type.intLike : auto: I
  I slice : data
  ValType : eltVal
  CompilerContext ptr.mut : context
-> Atomic list ) =>: appendPrimitiveArray
  eltVal isIntValType "unimplemented primitive arrays of non-integer type" assert
  data for =:: elt
    asm.OpType .DATA
      eltVal asm.Operand .valType
      elt i64 cast.u asm.Operand .constInt
    context appendOp2
  end
end
proc( Atomic list Type : constType ConstValue : value CompilerContext ptr.mut : context -> Atomic list ) =>: appendConstantData
  context [] .program =:: program
  program .idContext .typeContext =:: typeContext
  value switch
    Int case
      asm.OpType .DATA ## TODO? create helper function for const-int-data
        constType typeContext toValType =:: eltVal
        eltVal asm.Operand .valType
        value .Int eltVal .F32 ?? if
          f32 cast asm.Operand .constF32
        else eltVal .F64 ?? _if
          f64 cast asm.Operand .constF64
        else
          asm.Operand .constInt
        end
      context appendOp2
      return
    Char case
      asm.OpType .DATA
        constType typeContext toValType asm.Operand .valType
        value .Char i64 cast.u asm.Operand .constInt
      context appendOp2
      return
    Bool case
      asm.OpType .DATA
        constType typeContext toValType asm.Operand .valType
        value .Bool ?1 i64 cast.u asm.Operand .constInt
      context appendOp2
      return
    Float case
      constType typeContext toValType =:: eltVal
      asm.OpType .DATA
        eltVal asm.Operand .valType
        value .Float eltVal .F32 ?? if f32 cast asm.Operand .constF32 else asm.Operand .constF64 end
      context appendOp2
      return
    Array8 case
      value .Array8 ValType .I8 context appendPrimitiveArray
      asm.OpType .DATA ## zero-terminate strings for convenient interaction with C
        ValType .I8 asm.Operand .valType
        0 asm.Operand .constInt
      context appendOp2
    return
    Array16 case value .Array16 ValType .I16 context appendPrimitiveArray return
    Array32 case value .Array32 ValType .I32 context appendPrimitiveArray return
    Array64 case value .Array64 ValType .I64 context appendPrimitiveArray return
    Array case
      constType typeContext types.isPointer if
        ## TODO ensure that creating of new pointer-constants does not interferat with iterating over existing constants
        "Codegen: pointer constants are currently not implemented" ..panic
      end
      constType typeContext types.isArray if
        constType typeContext types.getBaseType =:: eltType
        eltType typeContext types.strideOf .fixed eltType typeContext types.sizeOf .fixed - =:: tailPadding
        value .Array for =:: elt
          eltType elt context appendConstantData
          tailPadding 0 > if ## TODO? use align (? align with zeros) instruction instead of inserting bytes directly
            asm.OpType .PADDING_BYTES
              tailPadding asm.Operand .constInt
            context appendOp1
          end
        end
        return
      else constType typeContext types.isTuple _if
        constType typeContext types.compositeElts =:: eltTypes
        value .Array =:: elts
        0:i64 =:: mut: offset
        0:i32 while $ iSize cast.u elts .length u< do =:: i
          eltTypes i [] =:: eltType
          constType i typeContext types.tupleElementOffset .data =:: eltOffset
          offset eltOffset <= "offset <= eltOffset" assert
          offset eltOffset < if
            asm.OpType .PADDING_BYTES
              eltOffset offset - asm.Operand .constInt
            context appendOp1
            eltOffset offset=
          end
          eltType elts i [] context appendConstantData
          offset
            eltType typeContext types.sizeOf .fixed +
          offset=
        finally i 1 + end ..drop
        return
      end
      "Codegen: unsupported array-constant type" ..panic
    break
    EnumLabel Union case
      "Codegen: union constants are currently not implemented" ..panic
    Procedure case
      "Codegen: procedure constants are currently not implemented" ..panic
    None WildCard TypeId ProcedureBundle LocalValue LocalArray
    LocalArray8 LocalArray16 LocalArray32 LocalArray64 GenericArg case
      ## TODO? include type of constant in error message
      "unsupported constant type":s Atomic .DebugError list.append
      return
  end
end
proc( Atomic list : ops ProgramContext ptr : program io.FILE : target -> ) =>: printOps
  1024 sb.create
    ops for program sb.appendAtomic end
    target $1 io.fputSb ..drop
  sb.free ..drop
end
proc( io.FILE : target io.FILE optional : intermediateTarget? ProgramContext ptr.mut : program -> ) =>: export: compileToASM
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  RegisterState MAX_DATA_REGISTERS array : regBuffer
  ## CompilerContext
    program
    regBuffer@ AMD64.initDataRegisters >$ =:: intRegsCount
    64 StackValue list.create
    labelHash@ labelEq@ 1024 ValueLocation map.create
    64 BlockInfo list.create
    16 ArgumentLocation list.create
    256 PointerConstant list.create
    128 Atomic list.create
    intRegsCount
    0
    true
  CompilerContext new =:: mut: contextData
  contextData@ =:: context
  ## TODO? compile procedures seperately
  1024 Atomic list.create
    ## TODO generate global constants
    SectionType .Code Atomic .Section list.append
    ## code
    program [] .progFiles .length for =:: i
      i FileId cast Atomic .DebugUsesFile list.append
    end
    program [] .progFiles .length for =:: i
      program [] .progFiles i [] =:: f
      f .localOps .length 0:iSize == if continue end
      i FileId cast Atomic .DebugStartFile list.append
      f .localOps .length for i32 cast.u =:: opIndex
        f .localOps opIndex list.at .data opIndex context compileOp
      end
    end
    program [] .mainLabelId =:: mainId
    mainId id.LABEL_ID_NONE != if ## code has main procedure
      ## TODO check if user-code defines C-main
      Atomic .Entry list.append
      asm.OpType .CALL
        mainId -1 asm.GlobalLabel new asm.Operand .globalLabel
      context appendOp1
      Atomic .ExitEntry list.append
    end
    SectionType .Data Atomic .Section list.append ## TODO? seperate section for read-only data
    context .pointerConstants [] .length for i32 cast.u =:: i
      context [] .pointerConstants i [] =:: constInfo
      constInfo .constType typeContext types.alignOf =:: alignement
      ## TODO use real type for error strings to remove need for allowing unknown alignment constants
      alignement .unknown ?? ! and alignement .fixed 1 > if
        alignement .fixed i32 cast Atomic .Align list.append
      end
      asm.OpType .LABEL
        i asm.Operand .constPtr
      context appendOp1
      constInfo .constType constInfo .constValue context appendConstantData
    end
    intermediateTarget? optional.hasData if
      $ program intermediateTarget? .data printOps
    end
    4096 sb.create
      $1 program AMD64.buildProgram
      target $1 io.fputSb ..drop
    sb.free ..drop
  list.free ..drop
end
import debug
