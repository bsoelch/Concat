i8 =:: RegisterId

16 =:: MAX_DATA_REGISTERS_INT

proc( char8 _ ptr : str i64 : len -> RegisterId ) : alias: static: :reg ..builtIn.parse.i8

i32 =:: CachedValId
namespace: CachedValId
  -1:CachedValId =:: NONE
end
struct(
  i32 : lastUsed
  CachedValId : cachedVariables
  RegisterId : register
) =:: RegisterState

0xff:reg =:: NO_REG

## TODO? 32-bit mode, ARM64 support
namespace: AMD64
  ## XXX? use same order as internal id
  0x00:reg =:: RSP
  0x01:reg =:: RBP
  0x02:reg =:: RAX ## r2
  0x03:reg =:: RBX ## r3
  0x04:reg =:: RCX ## r4
  0x05:reg =:: RDX ## r5
  0x06:reg =:: RDI ## r6
  0x07:reg =:: RSI ## r7
  RAX =:: INT_REG_MIN
  0x0f:reg =:: INT_REG_MAX
  0x40:reg =:: REG_MASK_FLOAT ## up 64 int/float regs

  { RDI RSI RDX RCX 8:reg 9:reg } =:: INT_ARG_REGISTERS
  { RAX RBX RCX RDX RDI RSI 8:reg 9:reg 10:reg 11:reg 12:reg 13:reg 14:reg 15:reg } =:: INT_DATA_REGISTERS
  proc(
    RegisterState MAX_DATA_REGISTERS_INT ptr.mut : buffer
  -> RegisterState slice.mut ) =>: initIntDataRegisters
    INT_DATA_REGISTERS ..length i32 cast MAX_DATA_REGISTERS_INT i32.min for =:: i
      ## RegisterState
        -1
        CachedValId.NONE
        INT_DATA_REGISTERS i []
      RegisterState new buffer i =[]
    end
    buffer INT_DATA_REGISTERS ..length slice.createMutable
  end
  ## TODO make dependent on calling convention
  proc( i32 : index -> RegisterId ) =>: getIntArgumentRegister
    index 0 < or index INT_ARG_REGISTERS ..length i32 cast >= if
      NO_REG return
    end
    INT_ARG_REGISTERS index [] return
  end
end
namespace: sb
  proc( stringBuilder RegisterId : reg -> stringBuilder ) =>: appendRegister
    'r' sb.appendC
    reg i64 cast.u sb.appendI
  end
end

enum( EMPTY I8 I16 I32 I64 F32 F64 PTR REFERENCE BITS128 BITS128IF BITS128FI BITS128F ) =:: ValType
proc( Type : dataType ProgramContext ptr.mut : program -> ValType ) =>: toValType
  program .idContext .typeContext =:: typeContext
  dataType switch
    namedType case
      dataType typeContext types.unwrapNamed program toValType return
    generatedType case
      dataType typeContext types.getGeneratedType program toValType return
    primitiveType case
      dataType .primitiveType switch
        TYPE case ValType .EMPTY return
        BOOL I8 CHAR8 case ValType .I8 return
        I16 CHAR16 case ValType .I16 return
        I32 CHAR32 case ValType .I32 return
        I64 case ValType .I64 return
        F32 case ValType .F32 return
        F64 case ValType .F64 return
      end
      break
    intLiteral case
      dataType .intLiteral types.intLiteralAsInt program toValType return
    cType case
      dataType .cType
        types.cTypeAsType
      program toValType return
    pointer rawPointer case
      ValType .PTR return ## TODO? distinquish pointer and procedure pointer
    arrayType struct union enum case
      ## TODO! treat small structs/unions/enums as values
      ValType .REFERENCE return
    undefined empty genericType autoType procedure
    procIn procOut align typeSet initializer case
      ValType .EMPTY return
  end
end

namespace: sb
  proc( stringBuilder ValType -> stringBuilder ) =>: appendValType
    switch
      EMPTY case "empty":s break
      I8  case "i8":s  break
      I16 case "i16":s break
      I32 case "i32":s break
      I64 case "i64":s break
      F32 case "f32":s break
      F64 case "f64":s break
      PTR case "ptr":s break
      REFERENCE case "reference":s break
      BITS128   case "bits128":s   break
      BITS128F  case "bits128f":s  break
      BITS128IF case "bits128if":s break
      BITS128FI case "bits128fi":s break
    end sb.appendStr return
  end
end

namespace: asm
  enum(
    ## memory
    MOVE PUSH POP
    ## controll-flow
    LABEL
    JMP JMPIF CALL RET
    ## arithmetic
    NEG NOT ADD SUB MUL DIV MOD UDIV UMOD
    AND OR XOR BITNOT SHL ASHL LSHL
    ## comparision
    CMP ## compare type if given as parameter
    ## special arithmetic
    ADC SBB MULH MUL2 DIVMOD UDIVMOD ## TODO? add float ops
  ) =:: OpType
  ## TODO? version to check for NaN?
  enum( EQ NE LT LE GE GT ULT ULE UGE UGT ) =:: CompareType
  union(
    _ : empty
    _ : unknown
    CompareType : cmpType
    RegisterId : register
    i64 : constInt
    f64 : constFloat
    i32 : intStackData
    i32 : intArgument
    ## XXX ? memory+s*offset1+offset2 , s=1,2,4,8
    LabelId : localMemory
    LabelId : globalMemory
    RegisterId : memory
    ## TODO label
  ) =:: Operand
end
struct(
  asm.OpType : opType
  ValType : valType
  asm.Operand 4 array : operands ## are four operands enough  [jmpif  lt r1 r2 @targetLabel]
  ## TODO? attach info to concat operation
  ## FilePos, concat-type, variables, ...
  ## ? attach (ptr to?) complete base operation
) =:: AsmOp
union(
  _ : Unknown
  AsmOp : Op
  LabelId : StartProc
  Operation : DebugStartOp
) =:: Atomic
proc( asm.OpType : opType ValType : valType -> Atomic ) =>: asmOp0
  ## AsmOp
    opType
    valType
    { asm.Operand .empty asm.Operand .empty asm.Operand .empty asm.Operand .empty }
  AsmOp new Atomic .Op return
end
proc( asm.OpType : opType ValType : valType asm.Operand : arg1 -> Atomic ) =>: asmOp1
  asm.Operand 4 array new =:: mut: args
  arg1 args@ 0 =[]
  ## AsmOp
    opType
    valType
    args
  AsmOp new Atomic .Op return
end
proc( asm.OpType : opType ValType : valType asm.Operand : arg1 asm.Operand : arg2 -> Atomic ) =>: asmOp2
  asm.Operand 4 array new =:: mut: args
  arg1 args@ 0 =[]
  arg2 args@ 1 =[]
  ## AsmOp
    opType
    valType
    args
  AsmOp new Atomic .Op return
end
proc(
  asm.OpType : opType
  ValType : valType
  asm.Operand : arg1 asm.Operand : arg2 asm.Operand : arg3
-> Atomic ) =>: asmOp3
  asm.Operand 4 array new =:: mut: args
  arg1 args@ 0 =[]
  arg2 args@ 1 =[]
  arg3 args@ 2 =[]
  ## AsmOp
    opType
    valType
    args
  AsmOp new Atomic .Op return
end
proc(
  asm.OpType : opType
  ValType : valType
  asm.Operand : arg1 asm.Operand : arg2 asm.Operand : arg3 asm.Operand : arg4
-> Atomic ) =>: asmOp4
  asm.Operand 4 array new =:: mut: args
  arg1 args@ 0 =[]
  arg2 args@ 1 =[]
  arg3 args@ 2 =[]
  arg4 args@ 3 =[]
  ## AsmOp
    opType
    valType
    args
  AsmOp new Atomic .Op return
end

namespace: sb
  proc( stringBuilder : sb asm.OpType : opType -> stringBuilder ) =>: appendOpType
    sb
      opType switch
        MOVE case "move":s break
        PUSH case "push":s break
        POP case "pop":s break
        LABEL case "label":s break
        JMP case "jmp":s break
        JMPIF case "jmpif":s break
        CALL case "call":s break
        RET case "ret":s break
        NEG case "neg":s break
        NOT case "not":s break
        ADD case "add":s break
        SUB case "sub":s break
        MUL case "mul":s break
        DIV case "div":s break
        MOD case "mod":s break
        UDIV case "udiv":s break
        UMOD case "umod":s break
        AND case "and":s break
        OR case "or":s break
        XOR case "xor":s break
        BITNOT case "bitnot":s break
        SHL case "shl":s break
        ASHL case "ashl":s break
        LSHL case "lshl":s break
        CMP case "cmp":s break
        ADC case "adc":s break
        SBB case "sbb":s break
        MULH case "mulh":s break
        MUL2 case "mul2":s break
        DIVMOD case "divmod":s break
        UDIVMOD case "udivmod":s break
      end
    appendStr
  end
  proc( stringBuilder : sb asm.CompareType : cmpType -> stringBuilder ) =>: appendCmpType
    sb
      cmpType switch
        EQ case "eq":s break
        NE case "ne":s break
        LT case "lt":s break
        LE case "le":s break
        GE case "ge":s break
        GT case "gt":s break
        ULT case "ult":s break
        ULE case "ule":s break
        UGE case "uge":s break
        UGT case "ugt":s break
      end
    appendStr
  end
  proc( stringBuilder : sb asm.Operand : val -> stringBuilder ) =>: appendAsmOperand
    sb
      val switch
        empty case break
        unknown case "?" sb.appendS break
        cmpType case
          val .cmpType sb.appendCmpType
          break
        register case
          val .register sb.appendRegister
          break
        constInt case
          val .constInt sb.appendI
          break
        constFloat case
          val .constFloat sb.appendF
          break
        intStackData case
          "@memI" sb.appendS val .intStackData sb.appendI
          break
        intArgument case
          "@argI" sb.appendS val .intArgument sb.appendI
          break
        localMemory case
          "@mem" sb.appendS val .localMemory i64 cast.u sb.appendI
          break
        globalMemory case
          "$global" sb.appendS val .globalMemory i64 cast.u sb.appendI
          break
        memory case
          '[' sb.appendC val .memory sb.appendRegister ']' sb.appendC
          break
      end
    return
  end
  proc( stringBuilder : sb AsmOp : op -> stringBuilder ) =>: appendAsmOp
    sb
      op .opType sb.appendOpType ' ' sb.appendC
      op .valType sb.appendValType
      op .operands ..length for =:: i
        op .operands i [] =:: operand
        operand .empty ?? if continue end
        ' ' sb.appendC operand sb.appendAsmOperand
      end
    return
  end
  proc( stringBuilder : sb Atomic : atom ProgramContext ptr : program -> stringBuilder ) =>: appendAtomic
    atom switch
      Unknown case sb "  ?\n" appendS return
      Op case sb "  " sb.appendS atom .Op appendAsmOp '\n' sb.appendC return
      StartProc case
        sb
          '\n' sb.appendC
          atom .StartProc program .idContext .typeContext .labelContext sb.appendLabelName
          ":\n  push rbp\n  mov rbp, rsp\n" sb.appendS
        return
      DebugStartOp case
        sb
          "## " sb.appendS
          atom .DebugStartOp program sb.appendOp
        return
    end
  end
end

struct( RegisterId : hi RegisterId : low ) =:: RegisterPair
union(
  _ : memory ## procedure internal stack-memory
  RegisterId : register
  RegisterPair : registers
  i32 : intArgument ## procedure argument location on call-stack
  ## TODO? seperate state for register+memory (for 2-register values)
) =:: StackValueLocation
## TODO marker for values that appear multiple times in stack (delay copy until next loop start)
struct(
  StackValueLocation : location
  ValType : valType
) =:: StackValue
union(
  RegisterId : register
  RegisterPair : registers ## TODO? handle partially cached value
  ## TODO pointer, pointer+offset
  i32 : intArgument
  i32 : floatArgument
  LabelId : localMemory
  LabelId : globalMemory
  i64 : intConstant
  ## TODO? float-constant, composite-constant, constant-location
) =:: ValueLocation

#+
registers -> stackValues + "cache" of last variable accesses"
  if variable is read/written value is kept in register until
    a) register is needed
    b) variable changes
    c) merging with branch without value
    d) first read in loop of different value:
      - if first read is mutable variable discard all other values
      - if first read is immutable variable discard all mutable values
      -> ensure remaining values are in cache when reaching end of loop
    e) a value is written to a pointer that might overlap with variable memory
  if variable read again value from register is used
-> write to (small) (sub-)variable adds moving value to register

if register is known to hold a specific constant replace reads from register with that constant

-> register needs list of currently cached variables (+ values need to remember which register holds newest value)
-> register needs flag to remember if currently used by stack value

before final output:
  remove all writes to registers/local memory that are not read before next write
  discard all memory blocks that are never read or converted to pointer
TODO add target specific optimizations as finaly step before output
  -> fuze/split operations
  -> use target specific operations
+#

## TODO? also cache memory locations (value pointed to by var/register) and constants
struct(
  LabelId : label
  CachedValId : next
) =:: CachedValueNode
struct(
  ProgramContext ptr.mut : program
  RegisterState slice.mut : intDataRegisters
  StackValue BranchTree : mut: stack
  LabelId ValueLocation hashMap : mut: variableLocations
  CachedValueNode list : cachedValues
) =:: CompilerContext

## TODO? how similar is cache node structure to branch tree
##  is it possible to use same structure for both
proc( CompilerContext ptr.mut : context -> ) =>: tryShrinkCacheList
  context .cachedValues [] .length 1 - =:: mut: maxIndex
  while maxIndex 0 >= and
    context [] .cachedValues maxIndex list.get .label id.LABEL_ID_NONE ==
  do
    maxIndex 1 - maxIndex=
  end
  context [] .cachedValues
    maxIndex 1 + list.setLength
  context .cachedValues=
end
proc( LabelId : valId RegisterId : register CompilerContext ptr.mut : context -> ) =>: cacheVariable
  context .variableLocations
    valId
    register ValueLocation .register
  map.put =:: prevLocation?
  ## remove previous location from register data
  prevLocation? optional.hasData and
      prevLocation? .data =:: prevLocation
      prevLocation .registers ?? ! "single register value not stored inregister pair" assert
      prevLocation .register ?? and
      prevLocation .register context findRegister =:: prevRegisterData?
      prevRegisterData? optional.hasData if
    prevRegisterData? .data =:: prevRegisterData
    prevRegisterData .cachedVariables =:: mut: cachedValIdLoc
    while cachedValIdLoc [] CachedValId.NONE != do
      context [] .cachedValues cachedValIdLoc [] i32 cast list.at .data =:: valData
      valData [] .label valId == if
        id.LABEL_ID_NONE valData .label=
        ## point previous pointer to next element in linked list
        valData [] .next cachedValIdLoc =[]
        ## cachedValIdLoc did not change
        continue
      end
      valData .next cachedValIdLoc=
    end
    context tryShrinkCacheList
  end
  ## update register storage
  register context findRegister
    $ optional.isEmpty if ..drop return end
  .data =:: registerData
  context .cachedValues []
    $ .length CachedValId cast =:: newNodeId
    ## CachedValueNode
      valId
      registerData [] .cachedVariables
    CachedValueNode new list.append
  context .cachedValues=
  newNodeId registerData .cachedVariables=
end
proc( LabelId : valId RegisterPair : register CompilerContext ptr : context -> ) =>: cacheVariable2
  ## TODO cache double-register value
end
proc( RegisterId : register CompilerContext ptr.mut : context -> ) =>: resetRegister
  register context findRegister
    $ optional.isEmpty if ..drop return end
  .data =:: registerData
  registerData [] .cachedVariables
    while $ CachedValId.NONE != do
      context [] .cachedValues >$ i32 cast list.at .data =:: valData
      ## FIXME remove register from label map
      ## valData [] .label map.remove ## TODO check if correct value was removed
      id.LABEL_ID_NONE valData .label=
      valData [] .next
    end
  registerData .cachedVariables=
  context tryShrinkCacheList
end
proc( LabelId : valId bool : isGlobal CompilerContext ptr.mut : context -> ValueLocation ) =>: getVarLocation
  context .variableLocations
    valId
  map.get =:: location?
  location? optional.hasData if
    ## TODO? check if cached data is still valid,
    ## TODO update dependent cache if mulit-value cache is accessed after back-jump
    ##    * variable mutable -> removes all other cached values
    ##    * variable immutable -> removes all mutable cached values
    location? .data return
  end
  valId
    isGlobal if
      ValueLocation .globalMemory
    else
      ValueLocation .localMemory
    end
  return
end
