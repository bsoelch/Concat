## * Pseudo-Assembly -> Assembly conversion

#################
## Assembly
#################
i8 =:: RegisterId
32 =:: MAX_DATA_REGISTERS ## 16 int + 16 float
proc( char8 _ ptr : str i64 : len -> RegisterId ) : alias: static: :reg ..builtIn.parse.i8
0x7f:reg =:: NO_REG
0x80:i32 =:: REG_FLAG_FLOAT ## mark float registers by setting high bit
proc( RegisterId -> bool ) =>: isFloatReg
  i32 cast.u REG_FLAG_FLOAT & ?
end

union(
  _ : empty
  _ : forceClear ## marker for registers than should be cleared when merging (for caller saved registers)
  _ : preserveValue ## marker for registers that should be reserved when resetting state (for callee saved registers on return)
  LabelId : variable ## TODO variableHi, variableLow
  i32 : stackSlot ## index counted from bottom of stack
  i32 : stackSlotHi   ## hi half of stack-slot
  i32 : stackSlotLow  ## low half of stack-slot
) =:: RegisterContent
namespace: RegisterContent
  proc( RegisterContent : a RegisterContent : b -> bool ) =>: eq
    a ..label b ..label != if
      false return
    end
    a switch
      empty forceClear preserveValue case true return
      variable case a .variable b .variable == return
      stackSlot case a .stackSlot b .stackSlot == return
      stackSlotHi case a .stackSlotHi b .stackSlotHi == return
      stackSlotLow case a .stackSlotLow b .stackSlotLow == return
    end
  end
end
struct(
  RegisterContent : currentValue
  RegisterId : register ## store register in padding after value-union
  i32 : lastUsed
) =:: RegisterState

( i16 : hi i16 : low ) =:: MixedArg
union(
  i32 : argInt
  i32 : argFloat
  i32 : arg128V
  MixedArg : arg128II
  MixedArg : arg128IF
  MixedArg : arg128FI
  MixedArg : arg128FF
) =:: ArgumentLocation

## TODO? 32-bit mode, ARM64 support
namespace: AMD64
  ## XXX? use same order as internal id
  0x00:reg =:: RSP
  0x01:reg =:: RBP
  0x02:reg =:: RAX ## r2
  0x03:reg =:: RBX ## r3
  0x04:reg =:: RCX ## r4
  0x05:reg =:: RDX ## r5
  0x06:reg =:: RDI ## r6
  0x07:reg =:: RSI ## r7
  proc( char8 _ ptr : str i64 : len -> RegisterId ) =>: static: :xmm
    str len ..builtIn.parse.i32 =:: vregId
    vregId 15 u<= "xmm register in range" assert
    vregId REG_FLAG_FLOAT | RegisterId cast
  end

  { RDI RSI RDX RCX 8:reg 9:reg } =:: INT_ARG_REGISTERS
  { RAX RDX } =:: INT_RET_REGISTERS
  { 0:xmm 1:xmm 2:xmm 3:xmm 4:xmm 5:xmm 6:xmm 7:xmm } =:: FLOAT_ARG_REGISTERS
  { 0:xmm 1:xmm } =:: FLOAT_RET_REGISTERS
  { RAX RBX RCX RDX RDI RSI 8:reg 9:reg 10:reg 11:reg 12:reg 13:reg 14:reg 15:reg } =:: INT_DATA_REGISTERS
  RAX =:: INT_REG_MIN
  15:reg =:: INT_REG_MAX
  { 0:xmm  1:xmm  2:xmm  3:xmm  4:xmm  5:xmm  6:xmm  7:xmm
    8:xmm  9:xmm 10:xmm 11:xmm 12:xmm 13:xmm 14:xmm 15:xmm } =:: FLOAT_DATA_REGISTERS
  0:xmm =:: FLOAT_REG_MIN
  15:xmm =:: FLOAT_REG_MAX
  ## TODO use heap allocated buffers for data registers (buffer for main registers, tmp-buffers for args/ret)
  proc(
    RegisterState MAX_DATA_REGISTERS ptr.mut : buffer
  -> i32 RegisterState slice.mut ) =>: initDataRegisters
    INT_DATA_REGISTERS ..length i32 cast =:: intRegCount
    FLOAT_DATA_REGISTERS ..length i32 cast =:: floatRegCount
    intRegCount floatRegCount + MAX_DATA_REGISTERS <= "MAX_DATA_REGISTERS >= intRegCount" assert
    intRegCount for =:: i
      ## RegisterState
        RegisterContent .empty
        INT_DATA_REGISTERS i []
        -1
      RegisterState new buffer i =[]
    end
    floatRegCount for =:: i
      ## RegisterState
        RegisterContent .empty
        FLOAT_DATA_REGISTERS i []
        -1
      RegisterState new buffer i intRegCount + =[]
    end
    intRegCount buffer floatRegCount intRegCount + slice.createMutable
  end
  proc( RegisterId : regId -> i32 ) =>: intDataRegIndex
    regId i32 cast INT_REG_MIN i32 cast - =:: regOffset
    regOffset INT_REG_MAX i32 cast.u u> if
      -1 return
    end
    regOffset return
  end
  proc( RegisterId : regId -> i32 ) =>: floatDataRegIndex
    regId i32 cast FLOAT_REG_MIN i32 cast - =:: regOffset
    regOffset FLOAT_REG_MAX i32 cast.u u> if
      -1 return
    end
    regOffset return
  end
  proc( RegisterId : regId -> i32 ) =>: dataRegIndex
    regId intDataRegIndex =:: intRegIndex
    intRegIndex 0 >= if intRegIndex return end
    INT_DATA_REGISTERS ..length i32 cast =:: intRegCount
    regId floatDataRegIndex =:: floatRegIndex
    floatRegIndex 0 >= if floatRegIndex intRegCount + return end
    -1 return
  end
  ## TODO make dependent on procedure signature & calling convention
  proc( i32 : index -> RegisterId ) =>: getIntArgumentRegister
    index 0 < or index INT_ARG_REGISTERS ..length i32 cast >= if
      NO_REG return
    end
    INT_ARG_REGISTERS index [] return
  end
  proc( i32 : index -> RegisterId ) =>: getFloatArgumentRegister
    index 0 < or index FLOAT_ARG_REGISTERS ..length i32 cast >= if
      NO_REG return
    end
    FLOAT_ARG_REGISTERS index [] return
  end
  proc( i32 : index -> RegisterId ) =>: getFloatReturnRegister
    index 0 < or index FLOAT_RET_REGISTERS ..length i32 cast >= if
      NO_REG return
    end
    FLOAT_RET_REGISTERS index [] return
  end
  proc( i32 : index -> RegisterId ) =>: getIntReturnRegister
    index 0 < or index INT_RET_REGISTERS ..length i32 cast >= if
      NO_REG return
    end
    INT_RET_REGISTERS index [] return
  end
  proc( RegisterId : regId -> bool ) =>: isCalleeSaved
    regId switch ## TODO add :reg post-fix to r12-r15 once custom literals are supported in switch
      RBX RSP RBP 12 13 14 15 case true return
    end
    false return
  end

  proc(
    Type slice : valTypes
    ArgumentLocation slice.mut : mut: argBuffer
    TypeContext ptr.mut : typeContext
  ->
    ArgumentLocation slice.mut
    i32 ## float arg count
    i32 ## int arg count
  ) =>: computeValueLocations
    0 =:: mut: intArgCount ## ? reuse named return value
    0 =:: mut: floatArgCount
    0 =:: mut: b128ArgCount
    valTypes .length 1 - while $ 0 >= do =:: index
      valTypes index [] =:: val
      val typeContext toValType =:: valType
      valType switch
        EMPTY case continue
        I8 I16 I32 I64 PTR REFERENCE case ## int-like
          intArgCount ArgumentLocation .argInt argBuffer index =[]
          intArgCount 1 + intArgCount=
          break
        F32 F64 case ## float
          floatArgCount ArgumentLocation .argFloat argBuffer index =[]
          floatArgCount 1 + floatArgCount=
          break
        BITS128 BITS128IF BITS128FI BITS128F case ## composite
          b128ArgCount 1 + b128ArgCount=
          ## TODO count number of used int/float slots
          "unimplemented: composite return" ..panic
          break
      end
    finally index 1 - end ..drop
    argBuffer floatArgCount intArgCount return
  end
  proc(
    Type : retType
    ArgumentLocation list ptr.mut : argBuffer
    RegisterState MAX_DATA_REGISTERS ptr.mut : regBuffer
    TypeContext ptr.mut : typeContext
  -> ArgumentLocation slice.mut RegisterState slice.mut ) =>: computeReturnLocations
    retType typeContext types.compositeElts =:: retTypes
    ## TODO? ensure buffer is unused
    argBuffer [] retTypes .length list.setLength argBuffer =[]
    retTypes argBuffer [] list.asMutableSlice typeContext computeValueLocations ..drop.2 =:: retLocs
    regBuffer initDataRegisters =:: regData =:: intRegsOffset
    ## TODO is this the correct iteration order?
    retLocs .length 1 - while $ 0 >= do =:: index
      retLocs index [] =:: retLoc
      retLoc .argInt ?? if
        retLoc .argInt getIntReturnRegister
      else
        retLoc .argFloat getFloatReturnRegister
      end =:: retReg
      retReg NO_REG == if continue end ## TODO mark return location as memory
      retReg AMD64.dataRegIndex =:: regIndex
      index i32 cast RegisterContent .stackSlot regData regIndex @[] .currentValue=
    finally index 1 - end ..drop
    retLocs regData
  end
  proc(
    Type : procType
    ArgumentLocation list ptr.mut : argBuffer
    RegisterState MAX_DATA_REGISTERS ptr.mut : argRegBuffer
    RegisterState MAX_DATA_REGISTERS ptr.mut : retRegBuffer
    i32 : opIndex
    i32 : stackSize
    TypeContext ptr.mut : typeContext
  -> ArgumentLocation slice.mut RegisterState slice.mut RegisterState slice.mut ) =>: computeArgumentLocations
    procType typeContext types.getProcIn ! "proc has in" assert =:: inType
    procType typeContext types.getProcOut ! "proc has out" assert =:: outType
    outType typeContext types.compositeElts =:: outTypes
    ## TODO? ensure buffer is unused
    argBuffer [] outTypes .length list.setLength argBuffer =[]
    outTypes argBuffer [] list.asMutableSlice typeContext computeValueLocations
      =:: intCount
      =:: floatCount
    =:: retLocs
    0 =:: mut: intMemCount
    0 =:: mut: floatMemCount
    0 =:: mut: b128MemCount
    INT_RET_REGISTERS ..length i32 cast =:: maxIntRegs
    FLOAT_RET_REGISTERS ..length i32 cast =:: maxFloatRegs
    intCount maxIntRegs > or floatCount maxFloatRegs > if
      ## check which value types need memory region
      0 =:: mut: intRegCount
      0 =:: mut: floatRegCount
      ## TODO is this the correct iteration order?
      retLocs .length 1 - while $ 0 >= do =:: index
        retLocs index [] =:: retLoc
        retLoc switch
          argInt case
            intRegCount 1 + =:: newRegCount
            newRegCount maxIntRegs <= if
              newRegCount intRegCount=
            else
              intMemCount 1 + intMemCount=
            end
            break
          argFloat arg128V case
            floatRegCount 1 + =:: newRegCount
            newRegCount maxFloatRegs <= if
              newRegCount floatRegCount=
            else
              floatMemCount 1 + floatMemCount=
            end
            break
          arg128II case
            intRegCount 2 + =:: newRegCount
            newRegCount maxIntRegs <= if
              newRegCount intRegCount=
            else
              b128MemCount 1 + b128MemCount=
            end
            break
          arg128FF case
            floatRegCount 2 + =:: newRegCount
            newRegCount maxFloatRegs <= if
              newRegCount floatRegCount=
            else
              b128MemCount 1 + b128MemCount=
            end
            break
          arg128IF arg128FI case
            intRegCount 1 + =:: newIntRegCount
            floatRegCount 1 + =:: newFloatRegCount
            newIntRegCount maxIntRegs <= and newFloatRegCount maxFloatRegs <= if
              newIntRegCount intRegCount=
              newFloatRegCount floatRegCount=
            else
              b128MemCount 1 + b128MemCount=
            end
            break
        end
      finally index 1 - end ..drop
    end
    inType typeContext types.compositeElts =:: inTypes
    stackSize inTypes .length i32 cast - =:: stackOffset
    stackOffset 0 >= "enough values for call" assert
    argBuffer [] inTypes .length list.setLength argBuffer =[]
    inTypes argBuffer [] list.asMutableSlice typeContext computeValueLocations ..drop.2 =:: argLocs
    ## TODO handle locations for additional arguments (retMemPointers, retValueLocations)
    ## ? prioritize ret-locs over values when passing to registers, ? pass (first) retValueLocs in special registers
    argRegBuffer initDataRegisters =:: argRegData =:: intRegsOffset
    ## TODO is this the correct iteration order?
    argLocs .length 1 - while $ 0 >= do =:: index
      argLocs index [] =:: argLoc
      argLoc .argInt ?? if
        argLoc .argInt getIntArgumentRegister
      else
        argLoc .argFloat getFloatArgumentRegister
      end =:: argReg
      argReg NO_REG == if continue end ## TODO mark argument location as memory
      argReg AMD64.dataRegIndex =:: regIndex
      stackOffset index i32 cast + RegisterContent .stackSlot argRegData regIndex @[] .currentValue=
    finally index 1 - end ..drop
    retRegBuffer initDataRegisters =:: retRegData intRegsOffset == "int regs offset is consistent" assert
    retLocs .length 1 - while $ 0 >= do =:: index
      retLocs index [] =:: retLoc
      retLoc .argInt ?? if
        retLoc .argInt getIntReturnRegister
      else
        retLoc .argFloat getFloatReturnRegister
      end =:: retReg
      retReg NO_REG == if continue end ## TODO mark return location as memory
      retReg AMD64.dataRegIndex =:: regIndex
      stackOffset index i32 cast + RegisterContent .stackSlot retRegData regIndex @[] .currentValue=
      opIndex retRegData regIndex @[] .lastUsed=
      argRegData regIndex @[] .currentValue .empty ?? if
        ## reserve register slots for return values
        RegisterContent .forceClear argRegData regIndex @[] .currentValue=
      end
    finally index 1 - end ..drop
    argRegData .length for =:: index
      argRegData index [] .register =:: regId
      retRegData index [] .register regId == "arguments and return values use same registers" assert
      regId isCalleeSaved if
        retRegData index @[] .currentValue .empty ?? "callee-saved register is not used for return value" assert
        RegisterContent .preserveValue argRegData index @[] .currentValue=
      else argRegData index @[] .currentValue .empty ?? _if
        RegisterContent .forceClear argRegData index @[] .currentValue=
      end
    end
    argLocs retRegData argRegData
  end
end
namespace: sb
  proc( stringBuilder RegisterId : reg -> stringBuilder ) =>: appendRegister
    reg i32 cast REG_FLAG_FLOAT & ? if
      'v' sb.appendC
      reg i32 cast.u REG_FLAG_FLOAT ^ sb.appendI
    else
      'r' sb.appendC
      reg i32 cast.u sb.appendI
    end
  end
end

## TODO? distinguish bits128f (2x f64) and bits128v (1x v128)
enum( EMPTY I8 I16 I32 I64 F32 F64 PTR REFERENCE BITS128 BITS128IF BITS128FI BITS128F ) =:: ValType
proc( Type : dataType TypeContext ptr.mut : typeContext -> ValType ) =>: toValType
  dataType switch
    namedType case
      dataType typeContext types.unwrapNamed typeContext toValType return
    generatedType case
      dataType typeContext types.getGeneratedType typeContext toValType return
    primitiveType case
      dataType .primitiveType switch
        TYPE case ValType .EMPTY return
        BOOL I8 CHAR8 case ValType .I8 return
        I16 CHAR16 case ValType .I16 return
        I32 CHAR32 case ValType .I32 return
        I64 case ValType .I64 return
        F32 case ValType .F32 return
        F64 case ValType .F64 return
      end
      break
    intLiteral case
      dataType .intLiteral types.intLiteralAsInt typeContext toValType return
    enum case
      dataType typeContext types.compositeFlags types.COMP_FLAG_ONLY_EMPTY & ? "enum only has empty elements" assert
      dataType typeContext types.enumLabelInfo ..drop =:: labelType
      labelType typeContext toValType return
      break
    cType case
      dataType .cType
        types.cTypeAsType
      typeContext toValType return
    pointer rawPointer case
      ValType .PTR return ## TODO? distinquish pointer and procedure pointer
    arrayType struct union case
      ## TODO! treat small arrays/structs/unions as values
      ValType .REFERENCE return
    undefined empty genericType autoType procedure
    procIn procOut align typeSet initializer case
      ValType .EMPTY return
  end
end
## split val-type in hi and low half
proc( ValType : valType -> ValType ) =>: getHiValType
  valType switch
    EMPTY I8 I16 I32 I64 F32 F64 PTR REFERENCE case ValType .EMPTY return
    BITS128 BITS128IF case ValType .I64 return
    BITS128FI BITS128F case ValType .F64 return
  end
end
proc( ValType : valType -> ValType ) =>: getLowValType
  valType switch
    EMPTY I8 I16 I32 I64 F32 F64 PTR REFERENCE case ValType .EMPTY return
    BITS128 BITS128FI case ValType .I64 return
    BITS128IF BITS128F case ValType .F64 return
  end
end
proc( ValType : valType -> bool ) =>: isIntValType
  valType switch
    I8 I16 I32 I64 PTR case true return
    EMPTY BITS128 BITS128FI F32 F64 BITS128IF BITS128F REFERENCE case false return
  end
end
proc( ValType : valType -> bool ) =>: isFloatValType
  valType switch
    F32 F64 BITS128F case true return
    EMPTY I8 I16 I32 I64 PTR BITS128 BITS128FI BITS128IF REFERENCE case false return
  end
end

namespace: sb
  proc( stringBuilder ValType -> stringBuilder ) =>: appendValType
    switch
      EMPTY case "empty":s break
      I8  case "i8":s  break
      I16 case "i16":s break
      I32 case "i32":s break
      I64 case "i64":s break
      F32 case "f32":s break
      F64 case "f64":s break
      PTR case "ptr":s break
      REFERENCE case "reference":s break
      BITS128   case "bits128":s   break
      BITS128F  case "bits128f":s  break
      BITS128IF case "bits128if":s break
      BITS128FI case "bits128fi":s break
    end sb.appendStr return
  end
end

namespace: asm
  enum(
    ## memory
    MOVE COPY PUSH POP
    ## controll-flow
    LABEL
    JMP JMPIF CALL RET
    ## embedded information
    DATA
    ## conversions
    EXT32S EXT32U EXT64S EXT64U ## TODO? ext16?
    TRUNC32 TRUNC16 TRUNC8
    EXT64F TRUCT32F
    ITOF FTOI
    ## arithmetic
    NEG NOT ADD SUB MUL DIV MOD UDIV UMOD
    AND OR XOR BOOLNOT BITNOT SHL ASHR LSHR
    ## comparision
    CMP ## compare type if given as parameter
    ## special arithmetic
    ADC SBB MULH MUL2 DIVMOD UDIVMOD
  ) =:: OpType
  ## TODO? version to check for NaN?
  enum( Z NZ EQ NE LT LE GE GT ULT ULE UGE UGT ) =:: CompareType
  struct( RegisterId : reg i32 : offset ) =:: RegAndOffset
  union(
    _ : empty
    _ : unknown
    CompareType : cmpType
    RegisterId : register
    i64 : constInt
    f64 : constFloat
    i32 : constPtr ## label of k-th pointer constant
    i32 : stackData ## stack memory location for single value (64bit / slot)
    i32 : stackData128 ## stack memory location for 128bit value
    i32 : stackData128Hi  ## stack memory location for high half of 128bit value
    i32 : stackData128Low ## stack memory location for low  half of 128bit value
    ## TODO? shared storage for memory arguments, ? store number of previous arguments
    i32 : intArgument
    i32 : floatArgument
    ## XXX ? memory+s*offset1+offset2 , s=1,2,4,8
    LabelId : localMemory
    LabelId : globalMemory
    RegisterId : memory
    i32 : localLabel
    LabelId : globalLabel
    RegAndOffset : jumpTableElement ## memory at localLabel<offset> + 8*<register> (used for jump-tables)
  ) =:: Operand
end
struct(
  asm.OpType : opType
  ValType : valType
  asm.Operand 4 array : operands ## are four operands enough  [jmpif  lt r1 r2 @targetLabel]
  ## TODO? attach info to concat operation
  ## FilePos, concat-type, variables, ...
  ## ? attach (ptr to?) complete base operation
) =:: AsmOp
enum( Code Data ) =:: SectionType
enum( AssertFail Panic ) =:: RuntimeErrorType
union(
  _ : Unknown
  AsmOp : Op
  FileId : StartFile
  ProcedureImpl : StartProc
  SectionType : Section
  _ : LeaveProc
  _ : EndProc
  Operation : DebugStartOp
  RuntimeErrorType : Error
  i32 : Align
) =:: Atomic
-1 =:: NO_LABEL
proc( asm.OpType : opType ValType : valType -> Atomic ) =>: asmOp0
  ## AsmOp
    opType
    valType
    { asm.Operand .empty asm.Operand .empty asm.Operand .empty asm.Operand .empty }
  AsmOp new Atomic .Op return
end
proc( asm.OpType : opType ValType : valType asm.Operand : arg1 -> Atomic ) =>: asmOp1
  asm.Operand 4 array new =:: mut: args
  arg1 args@ 0 =[]
  ## AsmOp
    opType
    valType
    args
  AsmOp new Atomic .Op return
end
proc( asm.OpType : opType ValType : valType asm.Operand : arg1 asm.Operand : arg2 -> Atomic ) =>: asmOp2
  asm.Operand 4 array new =:: mut: args
  arg1 args@ 0 =[]
  arg2 args@ 1 =[]
  ## AsmOp
    opType
    valType
    args
  AsmOp new Atomic .Op return
end
proc(
  asm.OpType : opType
  ValType : valType
  asm.Operand : arg1 asm.Operand : arg2 asm.Operand : arg3
-> Atomic ) =>: asmOp3
  asm.Operand 4 array new =:: mut: args
  arg1 args@ 0 =[]
  arg2 args@ 1 =[]
  arg3 args@ 2 =[]
  ## AsmOp
    opType
    valType
    args
  AsmOp new Atomic .Op return
end
proc(
  asm.OpType : opType
  ValType : valType
  asm.Operand : arg1 asm.Operand : arg2 asm.Operand : arg3 asm.Operand : arg4
-> Atomic ) =>: asmOp4
  asm.Operand 4 array new =:: mut: args
  arg1 args@ 0 =[]
  arg2 args@ 1 =[]
  arg3 args@ 2 =[]
  arg4 args@ 3 =[]
  ## AsmOp
    opType
    valType
    args
  AsmOp new Atomic .Op return
end
namespace: AMD64
  proc( asm.OpType : opType -> RegisterId optional ) =>: fixedTargetInt
    opType switch
      DIV UDIV case RAX optional.wrap return
      MOD UMOD case RDX optional.wrap return
      DIVMOD UDIVMOD case RAX optional.wrap return
      MULH case RDX optional.wrap return
      MUL2 case RAX optional.wrap return
      default RegisterId optional.empty return
    end
  end
  proc(
    asm.OpType : opType
    i32 : stackSize
    RegisterState MAX_DATA_REGISTERS ptr.mut : buffer
  -> RegisterState slice.mut ) =>: fixedInputInt
    opType switch
      DIV UDIV MOD UMOD DIVMOD UDIVMOD MULH MUL2 case ## rdx empty, rax: left input
        buffer initDataRegisters =:: regs ..drop
          stackSize 2 - RegisterContent .stackSlot regs RAX intDataRegIndex @[] .currentValue=
          RegisterContent .forceClear regs RDX intDataRegIndex @[] .currentValue=
        regs return
      SHL ASHR LSHR case ## rhs in rcx
        buffer initDataRegisters =:: regs ..drop
          stackSize 1 - RegisterContent .stackSlot regs RCX intDataRegIndex @[] .currentValue=
        regs return
      default RegisterState slice.emptyMutable return
    end
  end
end

namespace: sb
  proc( stringBuilder : sb asm.OpType : opType -> stringBuilder ) =>: appendOpType
    sb
      opType switch
        MOVE case "move":s break
        COPY case "copy":s break
        PUSH case "push":s break
        POP case "pop":s break
        LABEL case "label":s break
        DATA case "data":s break
        JMP case "jmp":s break
        JMPIF case "jmpif":s break
        CALL case "call":s break
        RET case "ret":s break
        EXT32S case "ext32s":s break
        EXT32U case "ext32u":s break
        EXT64S case "ext64s":s break
        EXT64U case "ext64u":s break
        TRUNC8 case "trunc8":s break
        TRUNC16 case "trunc16":s break
        TRUNC32 case "trunc32":s break
        EXT64F case "ext64f":s break
        TRUCT32F case "trunc32f":s break
        ITOF case "iToF":s break
        FTOI case "fToI":s break
        NEG case "neg":s break
        NOT case "not":s break
        ADD case "add":s break
        SUB case "sub":s break
        MUL case "mul":s break
        DIV case "div":s break
        MOD case "mod":s break
        UDIV case "udiv":s break
        UMOD case "umod":s break
        AND case "and":s break
        OR case "or":s break
        XOR case "xor":s break
        BOOLNOT case "boolnot":s break
        BITNOT case "bitnot":s break
        SHL case "shl":s break
        ASHR case "ashr":s break
        LSHR case "lshr":s break
        CMP case "cmp":s break
        ADC case "adc":s break
        SBB case "sbb":s break
        MULH case "mulh":s break
        MUL2 case "mul2":s break
        DIVMOD case "divmod":s break
        UDIVMOD case "udivmod":s break
      end
    appendStr
  end
  proc( stringBuilder : sb asm.CompareType : cmpType -> stringBuilder ) =>: appendCmpType
    sb
      cmpType switch
        NZ case "nz":s break
        Z  case "z":s break
        EQ case "eq":s break
        NE case "ne":s break
        LT case "lt":s break
        LE case "le":s break
        GE case "ge":s break
        GT case "gt":s break
        ULT case "ult":s break
        ULE case "ule":s break
        UGE case "uge":s break
        UGT case "ugt":s break
      end
    appendStr
  end
  proc( stringBuilder : sb asm.Operand : val LabelContext ptr : labelContext -> stringBuilder ) =>: appendAsmOperand
    sb
      val switch
        empty case break
        unknown case "?" sb.appendS break
        cmpType case
          val .cmpType sb.appendCmpType
          break
        register case
          val .register sb.appendRegister
          break
        constInt case
          val .constInt sb.appendI
          break
        constFloat case
          val .constFloat sb.appendF
          break
        constPtr case
          "@ptr" sb.appendS val .constPtr sb.appendI
          break
        stackData case
          "@stackMem" sb.appendS val .stackData sb.appendI
          break
        stackData128 case
          "@stack128Mem" sb.appendS val .stackData128 sb.appendI
          break
        stackData128Hi case
          "@stack128Mem" sb.appendS val .stackData128 sb.appendI 'h' sb.appendC
          break
        stackData128Low case
          "@stack128Mem" sb.appendS val .stackData128 sb.appendI 'l' sb.appendC
          break
        intArgument case
          "@argI" sb.appendS val .intArgument sb.appendI
          break
        floatArgument case
          "@argF" sb.appendS val .floatArgument sb.appendI
          break
        localMemory case
          "@mem" sb.appendS val .localMemory i64 cast.u sb.appendI
          break
        globalMemory case
          '$' sb.appendC val .globalMemory labelContext sb.appendLabelName
          break
        memory case
          '[' sb.appendC val .memory sb.appendRegister ']' sb.appendC
          break
        localLabel case
          ".localLabel" sb.appendS val .localLabel i64 cast.u sb.appendI
          break
        globalLabel case
          '$' sb.appendC val .globalLabel labelContext sb.appendLabelName
          break
        jumpTableElement case
          "[.localLabel" sb.appendS
            val .jumpTableElement .offset i64 cast.u sb.appendI
            "+8*" sb.appendS ## TODO? don't hardcode size
            val .jumpTableElement .reg sb.appendRegister
          ']' sb.appendC
          break
      end
    return
  end
  proc( stringBuilder : sb AsmOp : op LabelContext ptr : labelContext -> stringBuilder ) =>: appendAsmOp
    sb
      op .opType sb.appendOpType
      op .valType .EMPTY ?? ! if
        ' ' sb.appendC op .valType sb.appendValType
      end
      op .operands ..length for =:: i
        op .operands i [] =:: operand
        operand .empty ?? if continue end
        ' ' sb.appendC operand labelContext sb.appendAsmOperand
      end
    return
  end
  proc( stringBuilder : sb Atomic : atom ProgramContext ptr : program -> stringBuilder ) =>: appendAtomic
    program .idContext .typeContext .labelContext =:: labelContext
    atom switch
      Unknown case sb "  ?\n" appendS return
      Op case sb "  " sb.appendS atom .Op labelContext appendAsmOp '\n' sb.appendC return
      StartFile case
        sb "## " sb.appendS
          program [] .progFiles atom .StartFile i64 cast [] .fileName sb.appendSb
        '\n' sb.appendC return
      StartProc case sb "  enter\n" sb.appendS return
      LeaveProc case sb "  leave\n" sb.appendS return
      Section case atom .Section switch
          Code case sb "section code\n" sb.appendS return
          Data case sb "section data\n" sb.appendS return
        end break
      EndProc case sb "\n" sb.appendS return
      DebugStartOp case
        sb
          "## " sb.appendS
          atom .DebugStartOp program sb.appendOp
        return
      Error case atom .Error switch
          AssertFail case sb "  assertFail\n" sb.appendS return
          Panic case sb "  panic\n" sb.appendS return
        end break
      Align case sb "align " sb.appendS atom .Align sb.appendI '\n' sb.appendC return
    end
  end
end
################
## Conversion to real assembly
################
namespace: AMD64
  ## TODO? seperate mode for binary output
  struct(
    ProgramContext ptr.mut : program
    LabelId i64 hashMap : variableOffsets
    ## TODO map for used variables
    stringBuilder : procedureTail
    i32 : tmpLabelCount
  ) =:: AsmCompilerContext
  "cct_error_assert":s =:: CCT_ERROR_ASSERT
  "cct_error_panic":s =:: CCT_ERROR_PANIC
  "cct_f32_sign_mask":s =:: CCT_F32_SIGN_MASK
  "cct_f64_sign_mask":s =:: CCT_F64_SIGN_MASK

  proc( stringBuilder asm.CompareType : cmpType -> stringBuilder ) =>: appendCmpFlags
    cmpType switch
      NZ case "nz":s break
      Z  case "z":s break
      EQ case "e":s break
      NE case "ne":s break
      LT case "l":s break
      LE case "le":s break
      GE case "ge":s break
      GT case "g":s break
      ULT case "b":s break
      ULE case "be":s break
      UGE case "ae":s break
      UGT case "a":s break
    end sb.appendStr
  end
  proc( stringBuilder asm.OpType : opType -> stringBuilder ) =>: appendOpNameInt
    opType switch
      MOVE case "mov":s break
      COPY DATA LABEL NOT TRUNC8 TRUNC16 TRUNC32 BOOLNOT case "?":s break ## not a valid x86-64 operation
      PUSH case "push":s break
      POP case "pop":s break
      JMP case "jmp":s break
      JMPIF case "j":s break
      CALL case "call":s break
      RET case "ret":s break
      EXT32S EXT64S case "movsx":s break
      EXT32U EXT64U case "movzx":s break
      ITOF FTOI case "?":s break ## TODO find ops for i<->f conversion
      EXT64F case "cvtss2sd":s break
      TRUCT32F case "cvtsd2ss":s break
      NEG case "neg":s break
      ADD case "add":s break
      SUB case "sub":s break
      MUL MULH MUL2 case "imul":s break ## TODO? opCodes for unsigned mul2/mulh
      DIV case "idiv":s break
      MOD case "idiv":s break
      UDIV case "div":s break
      UMOD case "div":s break
      AND case "and":s break
      OR case "or":s break
      XOR case "xor":s break
      BITNOT case "not":s break
      SHL case "shl":s break
      ASHR case "sar":s break
      LSHR case "shr":s break
      CMP case "cmp":s break
      ADC case "adc":s break
      SBB case "sbb":s break
      DIVMOD case "idiv":s break
      UDIVMOD case "div":s break
    end sb.appendStr
  end
  ## requires avx
  proc( stringBuilder ValType : valType asm.OpType : opType -> stringBuilder ) =>: appendOpNameFloat
    opType switch
      MOVE case "movs":s break
      EXT64F case "cvtss2s":s break
      TRUCT32F case "cvtsd2s":s break
      ## neg is handled using xorps / xorpd
      ADD case "vadds":s break
      SUB case "vsubs":s break
      MUL case "vmuls":s break
      DIV case "vdivs":s break ## TODO? is there a float mod instruction
      CMP case "ucomiss":s break
      default "unsupported operation for float arithmetic" ..panic
    end sb.appendStr
    valType .F32 ?? if 's' sb.appendC else 'd' sb.appendC end
  end
  proc( stringBuilder RegisterId : regId ValType : valType -> stringBuilder ) =>: appendRegister
    regId i32 cast.u REG_FLAG_FLOAT & ? if
      "xmm" sb.appendS regId i32 cast.u REG_FLAG_FLOAT ^ sb.appendI return
    end
    valType switch
      EMPTY BITS128F BITS128 BITS128IF BITS128FI case "invalid register size for integer register" ..panic
      I8 case 8 break
      I16 case 16 break
      I32 F32 case 32 break
      I64 F64 PTR REFERENCE case 64 break
    end =:: regSize
    regId i32 cast.u 8 < if
      regSize 16 > if
        regSize 32 == if 'e' else 'r' end sb.appendC
      end
      regId switch
        RAX case 'a' sb.appendC regSize 8 > if 'x' sb.appendC end break
        RBX case 'b' sb.appendC regSize 8 > if 'x' sb.appendC end break
        RCX case 'c' sb.appendC regSize 8 > if 'x' sb.appendC end break
        RDX case 'd' sb.appendC regSize 8 > if 'x' sb.appendC end break
        RSP case "sp" sb.appendS break
        RBP case "bp" sb.appendS break
        RDI case "di" sb.appendS break
        RSI case "si" sb.appendS break
        default ..unreachable
      end
      regSize 8 == if 'l' sb.appendC end
    else
      "r" sb.appendS regId i32 cast.u sb.appendI
      regSize 64 < if
        regSize 32 == if
          'd' sb.appendC
        else regSize 16 == _if
          'w' sb.appendC
        else
          'b' sb.appendC
        end
      end
    end
  end
  ## TODO take value size as parameter
  proc( stringBuilder asm.Operand : val ValType : valType AsmCompilerContext ptr.mut : context -> stringBuilder ) =>: appendOperand
    context [] .program =:: program
    program .idContext .typeContext =:: typeContext
    typeContext .labelContext =:: labelContext
    val switch
      empty case return
      unknown case break
      cmpType case break
      register case val .register valType appendRegister return
      constInt case val .constInt sb.appendI return
      constPtr case "cct_ptr" sb.appendS val .constPtr sb.appendI return
      constFloat case
        "0x" sb.appendS val .constFloat valType .F32 ?? if f32 cast f32.bits i64 cast.u else f64.bits end sb.appendUX
        " /*" sb.appendS val .constFloat sb.appendF "*/" sb.appendS
        return
      stackData case break
      stackData128 case break
      stackData128Hi case break
      stackData128Low case break
      intArgument case break
      floatArgument case break
      localMemory case
        valType switch
          EMPTY case break
          I8 case "BYTE PTR " sb.appendS break
          I16 case "WORD PTR " sb.appendS break
          I32 F32 case "DWORD PTR " sb.appendS break
          I64 F64 PTR REFERENCE case "QWORD PTR " sb.appendS break
          BITS128F case "XMMWORD PTR " sb.appendS break
          BITS128 BITS128IF BITS128FI case break ## value is not stored in single register
        end
        "[rbp-" sb.appendS context .variableOffsets val .localMemory map.get .data sb.appendI ']' sb.appendC
        return
      globalMemory case break
      memory case break
      localLabel case ".l" sb.appendS val .localLabel i64 cast.u sb.appendI return
      globalLabel case val .globalLabel labelContext sb.appendLabelName return
      jumpTableElement case "[.l" sb.appendS val .jumpTableElement .offset i64 cast.u sb.appendI
            "+8*" sb.appendS val .jumpTableElement .reg ValType .PTR appendRegister ## TODO? don't hardcode size
          ']' sb.appendC return
    end
    "??" sb.appendS
    return
  end

  ## TODO cleanup code: create proc for appending instruction given op-type and operands
  proc( stringBuilder AsmOp : op AsmCompilerContext ptr.mut : context -> stringBuilder ) =>: compileAsmOp
    context [] .program =:: program
    program .idContext .typeContext =:: typeContext
    typeContext .labelContext =:: labelContext
    op .opType switch
      LABEL case op .operands 0 [] op .valType context appendOperand ":\n" sb.appendS return
      MOVE case ## TODO special handling for moves from/to vector register
        ## TODO? automatically extend small values to break dependency chains
        ## TODO? special handling for moving 0 to register
        op .operands 1 [] .constPtr ?? if ## TODO? use lea for any label-like source
          "  lea " sb.appendS
        else op .operands 1 [] .constFloat ?? _if ## movups for handling 128-bit values (float or double)
          op .valType .F32 ?? if "  movss " sb.appendS else "  movsd " sb.appendS end
            context [] .tmpLabelCount $ =:: floatId ## TODO? merge identical constants
              1 +
            context .tmpLabelCount=
            op .operands 0 [] op .valType context appendOperand ", .cct_floatConst" sb.appendS floatId sb.appendI '\n' sb.appendC
            context [] .procedureTail ## TODO? sort constants by alignment
              op .valType .F32 ?? if " .balign 4\n" sb.appendS else "  .balign 8\n" sb.appendS end
              ".cct_floatConst" sb.appendS floatId sb.appendI ":\n" sb.appendS
                op .valType .F32 ?? if "  .4byte " sb.appendS else "  .8byte " sb.appendS end
                op .operands 1 [] op .valType context appendOperand
              '\n' sb.appendC
            context .procedureTail=
          return
        else
          op .valType switch
            EMPTY I8 I16 I32 I64 PTR REFERENCE case "  mov " sb.appendS break
            F32 case "  movss " sb.appendS break
            F64 case "  movsd " sb.appendS break
            BITS128F case "  movups" sb.appendS break ## float-like 128-bit value
            BITS128 BITS128IF BITS128FI case "  movdqu" sb.appendS break ## int-like 128-bit value
          end
        end
          op .operands 0 [] op .valType context appendOperand ", " sb.appendS
          op .operands 1 [] op .valType context appendOperand '\n' sb.appendC
        return
      PUSH case ## TODO? extend pushed values to 64-bits
        ## TODO? handle push/pop for floats
        "  push " sb.appendS op .operands 0 [] ValType .PTR context appendOperand '\n' sb.appendC return
      POP case
        "  pop " sb.appendS op .operands 0 [] ValType .PTR context appendOperand '\n' sb.appendC return
      DATA case
        op .valType switch ## TODO are these the correct (platform idependent) sizes
          I8  case "  .byte " sb.appendS op .operands 0 [] ValType .PTR context appendOperand '\n' sb.appendC return
          I16 case "  .2byte " sb.appendS op .operands 0 [] ValType .PTR context appendOperand '\n' sb.appendC return
          I32 case "  .4byte " sb.appendS op .operands 0 [] ValType .PTR context appendOperand '\n' sb.appendC return
          I64 PTR case "  .8byte " sb.appendS op .operands 0 [] ValType .PTR context appendOperand '\n' sb.appendC return
          default "/*unsupported data type*/" sb.appendS return
        end
        break
      ## TODO? support 2 operand vecsion ext
      EXT32S case
        "  movsx " sb.appendS
          op .operands 0 [] ValType .I32 context appendOperand ", " sb.appendS
          op .operands 0 [] op .valType context appendOperand '\n' sb.appendC
        return
      EXT64S case
        "  movsx " sb.appendS
          op .operands 0 [] ValType .I64 context appendOperand ", " sb.appendS
          op .operands 0 [] op .valType context appendOperand '\n' sb.appendC
        return
      EXT32U case
        "  movzx " sb.appendS
          op .operands 0 [] ValType .I32 context appendOperand ", " sb.appendS
          op .operands 0 [] op .valType context appendOperand '\n' sb.appendC
        return
      EXT64U case
        op .valType .I32 ?? if
          "  mov " sb.appendS
        else
          "  movzx " sb.appendS
        end
          op .operands 0 [] ValType .I32 context appendOperand ", " sb.appendS
          op .operands 0 [] op .valType context appendOperand '\n' sb.appendC
        return
      TRUNC8 TRUNC16 TRUNC32 case break ## noting to do
      EXT64F case
        "  cvtss2sd " sb.appendS
          op .operands 0 [] ValType .F64 context appendOperand ", " sb.appendS
          op .operands 0 [] op .valType context appendOperand '\n' sb.appendC
        return
      TRUCT32F case
        "  cvtsd2ss " sb.appendS
          op .operands 0 [] ValType .F32 context appendOperand ", " sb.appendS
          op .operands 0 [] op .valType context appendOperand '\n' sb.appendC
        return
      NOT case ## special handling for not
        op .operands 0 [] =:: target
        op .operands 1 [] =:: src
        target .register ?? "target is register" assert ## TODO? allow memory location as target
        src .register ?? and target .register src .register == end =:: srcIsTarget
        srcIsTarget ! if ## clear target to break memory dependency
          "  xor " sb.appendS
            target ValType .I32 context appendOperand ", " sb.appendS
            target ValType .I32 context appendOperand '\n' sb.appendC
        end
        "  test " sb.appendS
          src op .valType context appendOperand ", " sb.appendS
          src op .valType context appendOperand '\n' sb.appendC
        "  sete " sb.appendS
          target ValType .I8 context appendOperand '\n' sb.appendC
        srcIsTarget if ## zero-extend to break memory dependency
          "  movzx " sb.appendS
            target ValType .I32 context appendOperand ", " sb.appendS
            target ValType .I8 context appendOperand '\n' sb.appendC
        end
        return
      NEG BITNOT case ## unary-operators
        op .operands 0 [] =:: target
        op .operands 1 [] =:: src
        target .register ?? "target is register" assert ## TODO? allow non-register target when op-code exists
        src .register ?? ! or target .register src .register != if
          op .valType isFloatValType if
            op .valType .F32 ?? if "  movss " sb.appendS else "  movsd " sb.appendS end
          else
            "  mov " sb.appendS
          end
            target op .valType context appendOperand ", " sb.appendS
            src op .valType context appendOperand '\n' sb.appendC
        end
        op .valType isFloatValType if
          op .opType .NEG ?? "bitnot is not supported for floats" assert
          op .valType .F32 ?? if "  xorps " sb.appendS else "  xorpd " sb.appendS end
            target op .valType context appendOperand ", " sb.appendS
            op .valType .F32 ?? if CCT_F32_SIGN_MASK else CCT_F64_SIGN_MASK end sb.appendStr
          '\n' sb.appendC
          return
        end
        "  " sb.appendS op .opType appendOpNameInt ' ' sb.appendC
          target op .valType context appendOperand '\n' sb.appendC
        return
      BOOLNOT case ## boolean not
        op .operands 0 [] =:: target
        op .operands 1 [] =:: src
        target .register ?? "target is register" assert ## TODO? allow non-register target when op-code exists
        op .valType .I8 ?? "bool has val-type i8" assert
        src .register ?? ! or target .register src .register != if
          "  movzx " sb.appendS
            target ValType .I32 context appendOperand ", " sb.appendS
          src ValType .I8 context appendOperand '\n' sb.appendC
        end
        "  xor " sb.appendS target ValType .I32 context appendOperand ", 1\n" sb.appendS
        return
      AND OR XOR ADD MUL SUB case ## binary-operators
        ## TODO? use 3-operand version of operation (if existent for operands)
        op .operands 0 [] =:: target
        op .operands 1 [] =:: left
        op .operands 2 [] =:: right
        target .register ?? "target is register" assert ## TODO? allow non-register target when op-code exists
        op .valType isFloatValType if
          left .register ?? "left operand is register" assert
          "  " sb.appendS op .valType op .opType appendOpNameFloat ' ' sb.appendC
            target op .valType context appendOperand ", " sb.appendS
            left op .valType context appendOperand ", " sb.appendS
            right op .valType context appendOperand '\n' sb.appendC
          return
        end
        left .register ?? and target .register left .register == if
          left right
        else right .register ?? and target .register right .register == _if
          op .opType .SUB ?? if ## operation not symmetric
            "  xchg " sb.appendS
              left op .valType context appendOperand ", " sb.appendS
              right op .valType context appendOperand '\n' sb.appendC
          end
          right left
        else
          "  mov " sb.appendS
            target op .valType context appendOperand ", " sb.appendS
            left op .valType context appendOperand '\n' sb.appendC
          target right
        end =:: arg2 =:: arg1
        "  " sb.appendS op .opType appendOpNameInt ' ' sb.appendC
          arg1 op .valType context appendOperand ", " sb.appendS
          arg2 op .valType context appendOperand '\n' sb.appendC
        return
      SHL ASHR LSHR case ## shifts ( rhs is assumed to be in rcx )
        op .operands 0 [] =:: target
        op .operands 1 [] =:: left
        op .operands 2 [] =:: right
        ## register locations should have been assigned correctly be register allocator
        right .register RCX == "right argument is passed in rcx" assert
        target .register ?? "target is register" assert ## TODO? allow non-register target when op-code exists
        "  " sb.appendS op .opType appendOpNameInt ' ' sb.appendC
          left op .valType context appendOperand ", " sb.appendS
          right ValType .I8 context appendOperand '\n' sb.appendC
        return
      DIV MOD UDIV UMOD MULH case ## division operators ( lhs assumed to be in rax, output in rax/rdx)
        op .operands 0 [] =:: target
        op .operands 1 [] =:: left
        op .operands 2 [] =:: right
        op .valType isFloatValType if
          left .register ?? "left operand is register" assert
          "  " sb.appendS op .valType op .opType appendOpNameFloat ' ' sb.appendC
            target op .valType context appendOperand ", " sb.appendS
            left op .valType context appendOperand ", " sb.appendS
            right op .valType context appendOperand '\n' sb.appendC
          return
        end
        ## register locations should have been assigned correctly be register allocator
        left .register RAX == "left argument is passed in rax" assert
        target .register
          op .opType .DIV ?? or op .opType .UDIV ?? if RAX else RDX end
        == "target is register rax/rdx" assert
        op .opType switch ## TODO? is operand size guaranteed to be i32 or i64
          DIV MOD case op .valType .I64 ?? if "  cqo\n" sb.appendS else "  cdq\n" sb.appendS end break
          UDIV UMOD case "  xor edx, edx\n" sb.appendS break
          MULH case break
          default ..unreachable
        end
        "  " sb.appendS op .opType appendOpNameInt ' ' sb.appendC
          right op .valType context appendOperand '\n' sb.appendC
        return
      ## DIVMOD UDIVMUD MUL2 UMUL2 use same regiter sheme with 2 inputs/outputs
      CMP case
        op .operands 0 [] .cmpType =:: cmpType
        op .operands 1 [] =:: target
        context [] .tmpLabelCount =:: tmpLabelId
        op .valType isFloatValType if
          "  xor "  sb.appendS ## TODO? is it better to clear register after setcc?
            target ValType .I32 context appendOperand ", " sb.appendS
            target ValType .I32 context appendOperand
          '\n' sb.appendC
          op .valType .F32 ?? if
            "  ucomiss " sb.appendS
          else
            "  ucomisd " sb.appendS
          end
          cmpType .LT ?? or cmpType .LE ?? if ## swap arguments
            op .operands 3 [] op .valType context appendOperand ", " sb.appendS
            op .operands 2 [] op .valType context appendOperand '\n' sb.appendC
          else
            op .operands 2 [] op .valType context appendOperand ", " sb.appendS
            op .operands 3 [] op .valType context appendOperand '\n' sb.appendC
          end
          cmpType switch
            GT LT case "  seta " sb.appendS target ValType .I8 context appendOperand '\n' sb.appendC return
            GE LE case "  setae " sb.appendS target ValType .I8 context appendOperand '\n' sb.appendC return
            EQ case ## TODO? use cmov instead of jump (needs extract temporary register)
              tmpLabelId 1 + context .tmpLabelCount=
              "  jp .floatCmp" sb.appendS tmpLabelId sb.appendI '\n' sb.appendC
              "  sete " sb.appendS target ValType .I8 context appendOperand '\n' sb.appendC
              ".floatCmp" sb.appendS tmpLabelId sb.appendI ":\n" sb.appendS
              return
            NE case
              ## TODO? special handling if lhs and rhs are the same (directly check for NaN)
              tmpLabelId 2 + context .tmpLabelCount=
              "  jp .floatCmp" sb.appendS tmpLabelId sb.appendI '\n' sb.appendC
              "  setne " sb.appendS target ValType .I8 context appendOperand '\n' sb.appendC
              ".floatCmp" sb.appendS tmpLabelId 1 + sb.appendI ":\n" sb.appendS
              context [] .procedureTail ## mov nan-path to tail to ensure direct code-flow in standard path
                ".floatCmp" sb.appendS tmpLabelId sb.appendI ":\n" sb.appendS
                "  mov " sb.appendS target ValType .I32 context appendOperand ", 1\n" sb.appendS
                "  jmp .floatCmp" sb.appendS tmpLabelId 1 + sb.appendI '\n' sb.appendC
              context .procedureTail=
              return
            default "unsupported comparison type for floats" ..panic
          end
        end
        "  cmp " sb.appendS
          op .operands 2 [] op .valType context appendOperand ", " sb.appendS
          op .operands 3 [] op .valType context appendOperand '\n' sb.appendC
        "  set" sb.appendS cmpType appendCmpFlags ' ' sb.appendC
          target ValType .I8 context appendOperand '\n' sb.appendC
        "  movzx " sb.appendS target ValType .I32 context appendOperand ", " sb.appendS
          target ValType .I8 context appendOperand '\n' sb.appendC
        return
      JMP case
        "  jmp " sb.appendS op .operands 0 [] ValType .PTR context appendOperand '\n' sb.appendC return
      JMPIF case
        op .operands 0 [] =:: cmpType
        op .operands 3 [] .empty ?? if ## <cmpType> <value> <target>
          "  test " sb.appendS
            op .operands 1 [] op .valType context appendOperand ", " sb.appendS
            op .operands 1 [] op .valType context appendOperand '\n' sb.appendC
          op .operands 2 []
        else ## <cmpType> <src1> <src2> <target>
          ## TODO? handle floats
          "  cmp " sb.appendS
            op .operands 1 [] op .valType context appendOperand ", " sb.appendS
            op .operands 2 [] op .valType context appendOperand '\n' sb.appendC
          op .operands 3 []
        end =:: target
        "  j" sb.appendS cmpType .cmpType appendCmpFlags ' ' sb.appendC
          target ValType .PTR context appendOperand
        '\n' sb.appendC return
      CALL case
        "  call " sb.appendS op .operands 0 [] op .valType context appendOperand '\n' sb.appendC return
      RET case "  ret\n" sb.appendS return
      ITOF FTOI
      COPY
      ADC SBB MUL2 DIVMOD UDIVMOD case "/* unimplemented operation */\n" sb.appendS return
    end
  end
  proc( stringBuilder Atomic : atom AsmCompilerContext ptr.mut : context -> stringBuilder ) =>: compileAtom
    context [] .program =:: program
    program .idContext .typeContext =:: typeContext
    typeContext .labelContext =:: labelContext
    atom switch
      Unknown case "/* unkown operation */\n" sb.appendS return
      Op case atom .Op context compileAsmOp return
      StartFile case
        ".file " sb.appendS atom .StartFile i64 cast sb.appendI " \"" sb.appendS
          program [] .progFiles atom .StartFile i64 cast @[] .fileName [] sb.asStr sb.appendEscapedStrC
        "\"\n" sb.appendS return
      DebugStartOp case
        atom .DebugStartOp .pos =:: pos
        "/* " sb.appendS
          atom .DebugStartOp program sb.appendOp sb.pop ..drop
        " */\n  .loc " sb.appendS
          pos .fileId i64 cast sb.appendI ' ' sb.appendC
          pos .line sb.appendI ' ' sb.appendC pos .posInLine sb.appendI ' ' sb.appendC
        '\n' sb.appendC return
      Section case atom .Section switch
          Code case ".text\n" sb.appendS return
          Data case ".data\n" sb.appendS return
        end break
      Align case "  .balign " sb.appendS atom .Align sb.appendI '\n' sb.appendC return
      StartProc case
        atom .StartProc =:: implInfo
        program [] .procedures
          implInfo .procId i64 cast list.at .data
        =:: procInfo
        procInfo [] .labelId labelContext id.labelFlags id.FLAG_EXPORT & ? if
          "  .globl " sb.appendS
          procInfo [] .labelId labelContext sb.appendLabelName
          '\n' sb.appendC
        end
        0 context .tmpLabelCount= ## count per proc
        ## TODO if proc is exported add .globl <procLabel>
        "  push rbp\n  mov rbp, rsp\n" sb.appendS
        ## TODO create allocations for stack-memory
        context .variableOffsets map.clear ## clear variables from previous procedure
         ## allocate space for variables
        implInfo .implementationId 0 >= if
          procInfo [] .implementation .code .implementations
            implInfo .implementationId list.at .data [] .variables
        else
          procInfo [] .implementation .code .variables
        end =:: variables
        ## TODO sort variables by alignment?
        0:i64 =:: mut: stackOffset
        variables for =:: varInfo
          ## TODO skip arguments passed though memory address
          varInfo .valueType =:: valType
          valType typeContext types.alignOf .fixed =:: alignment
          valType typeContext types.sizeOf .fixed =:: size
          stackOffset alignment 1 - + alignment -_ & stackOffset= ## round offset to alignment
          stackOffset size + stackOffset=
          context .variableOffsets varInfo .label stackOffset map.put ..drop
           "/* " sb.appendS
            varInfo .label labelContext sb.appendLabelName ": " sb.appendS stackOffset sb.appendI
          " */\n" sb.appendS
        end
        stackOffset 0 > if
          stackOffset 15 + -16 & stackOffset= ## align to multiple of 16
          "  sub rsp, " sb.appendS stackOffset sb.appendI '\n' sb.appendC ## allocate stack space
        end
        return
      LeaveProc case "  mov rsp, rbp\n  pop rbp\n" sb.appendS return
      EndProc case
        context [] .procedureTail sb.appendSb
        context [] .procedureTail sb.clear context .procedureTail=
        "\n" sb.appendS
      return
      Error case
        atom .Error switch ## use call to have error location in call-stack
          AssertFail case "  call " sb.appendS CCT_ERROR_ASSERT sb.appendStr '\n' sb.appendC return
          Panic case "  call " sb.appendS CCT_ERROR_PANIC sb.appendStr '\n' sb.appendC return
        end break
    end
  end
  ## TODO compute used variables & stack-memeory slots in pre-compilation phase
  proc( stringBuilder Atomic list : ops ProgramContext ptr.mut : program -> stringBuilder ) =>: buildProgram
    ## AsmCompilerContext
      program
      labelHash@ labelEq@ 1024 i64 map.create
      512 sb.create
      0
    AsmCompilerContext new =:: mut: context
    "  .intel_syntax noprefix\n" sb.appendS
    ops for =:: op
      op context@ compileAtom
    end
    context@ .variableOffsets map.free
    ".data\n  .balign 16\n" sb.appendS
    CCT_F32_SIGN_MASK sb.appendStr ":\n  .4byte 0x80000000\n  .4byte 0\n  .4byte 0\n  .4byte 0\n" sb.appendS
    CCT_F64_SIGN_MASK sb.appendStr ":\n  .8byte 0x8000000000000000\n  .8byte 0\n" sb.appendS
    ## default error handlers (assume arguments first 3 arguments are <msg> <msg-len> <pos-ptr> )
    ".text\ncct_shift_args:" sb.appendS
    3 while $ 0 >= do =:: i
      "\n  mov " sb.appendS
      i 1 + AMD64.getIntArgumentRegister ValType .I64 appendRegister
      ", " sb.appendS
      i AMD64.getIntArgumentRegister ValType .I64 appendRegister
    finally i 1 - end ..drop
    "\n  ret\n" sb.appendS
    ## TODO? support non SysV calling convention
    ## TODO include position in print
    ## TODO? ommit unused handlers
    CCT_ERROR_ASSERT sb.appendStr ":\n" sb.appendS
    "  call cct_shift_args\n" sb.appendS
    "  lea rdi, cct_err_assert_msg\n  xchg rsi, rdx\n  call printf\n" sb.appendS
    "  mov rdi, 1\n  jmp exit\n" sb.appendS
    CCT_ERROR_PANIC sb.appendStr ":\n" sb.appendS
    "  call cct_shift_args\n" sb.appendS
    "  lea rdi, cct_err_panic_msg\n  xchg rsi, rdx\n  call printf\n" sb.appendS
    "  mov rdi, 1\n  jmp exit\n" sb.appendS
    ".data\n" sb.appendS
    "cct_err_assert_msg:\n.string	\"assertion failed \\\"%.*s\\\"\\n\"\n" sb.appendS
    "cct_err_panic_msg:\n.string	\"panic \\\"%.*s\\\"\\n\"\n" sb.appendS
    ".section .note.GNU-stack,\"\",@progbits\n" sb.appendS
    ## TODO! cleanup context
  end
end
#################
## CodeGenerator
#################
struct( RegisterId : hi RegisterId : low ) =:: RegisterPair
union(
  _ : memory ## procedure internal stack-memory
  RegisterId : register
  RegisterId : registerHi ## high part in register, low part in memory
  RegisterId : registerLow ## low part in register, hi part in memory
  RegisterPair : registers
) =:: StackValueLocation
## TODO marker for values that appear multiple times in stack (delay copy until next loop start)
struct(
  StackValueLocation : location
  ValType : valType
) =:: StackValue
union(
  RegisterId : register
  RegisterId : registerHi ## high part in register, low part in memory
  RegisterId : registerLow ## low part in register, hi part in memory
  RegisterPair : registers ## TODO? allow values partially stored in registers
  ## TODO pointer, pointer+offset
  i32 : intArgument
  i32 : floatArgument
  LabelId : localMemory
  LabelId : globalMemory
  i64 : intConstant
  f64 : floatConstant
  i32 : ptrConstant
  ## TODO? float-constant, composite-constant, constant-location
) =:: ValueLocation

##? valuegroup -> bits64
## TODO? keep track of all reads&writes to given variable
##  * allows to better prioritive different values
##  * allows to free variable register if value is no longer used

## simplify register assignment:
## TODO 0. find read/write locations of variables (allows to free registers for variables that are not read until next write)
## 1. store all stack-slots / cached variables in different registers
## 2. run copy elimination in parallel (mark register pairs holding same value, split values at loop start)
## ?? overcommit register ids if there are many registers sharing the same value, if copy elimination does not eliminate all versions move least used normal register to stack when value in overflow register is needed
## TODO! ensure each value has a unique register
#+
before final output:
  remove all writes to registers/local memory that are not read before next write
  discard all memory blocks that are never read or converted to pointer
TODO add target specific optimizations as finaly step before output
  -> fuze/split operations
  -> use target specific operations
+#

## TODO? merge branches instead of resetting to first value
## * in type-check phase: count else/continue/case branches
## * one reg-state for eacha branch
## * merge such that minimum total moves
struct(
  BlockId : blockId
  i32 : startLabelId
  i32 : doLabelId
  i32 : finallyLabelId
  i32 : endLabelId
  ## TODO remember which registers are read within loop (without beeing overwritten first, do not need to be restored)
  RegisterState slice.mut : regData ## storage for register data (heap allocated)
  ## regData: [WHILE][DO][CONTINUE][BREAK]
  i32 : doRegsOffset ## offset for reg-data in do-branch
  i32 : continueRegsOffset ## offset for reg-data in continue-branches
  i32 : breakRegsOffset ## offset for reg-data in break-branches
  i32 : whileStackSize
  i32 : doStackSize
  i32 : endStackSize
  i32 : continueStackSize
) =:: WhileBlockInfo
struct(
  BlockId : blockId
  i32 : ifLabelId
  i32 : elseLabelId
  i32 : endLabelId
  RegisterState slice.mut : regData ## storage for register data (heap allocated)
  ## regData: [ELSE-start][IF-start][Branch-end]
  i32 : ifStartRegsOffset
  i32 : elseRegsOffset ## offset for reg-data in else-branch
  i32 : ifStackSize
  i32 : endStackSize
  bool : hasIf
) =:: IfBlockInfo
struct(
  BlockId : blockId
  i32 : endLabelId
  RegisterState slice.mut : regData ## storage for register data (heap allocated)
  i32 : endStackSize
) =:: AndOrBlockInfo
struct(
  BlockId : blockId
  i32 : endLabelId
  i32 slice.mut : caseLabelIds ## [case-labels] [default-label]
  RegisterState slice.mut : regData ## storage for register data (heap allocated)
  ## regData: [SWITCH-start][BRANCH-end] ## TODO? one state for each branch
  i32 : endRegsOffset
  i32 : switchStackSize
  i32 : endStackSize
  i32 : caseIndex ## current case-id
) =:: SwitchBlockInfo
union(
  WhileBlockInfo : While
  IfBlockInfo : If
  AndOrBlockInfo : AndOr
  SwitchBlockInfo : Switch
) =:: BlockInfo

struct(
  ConstValue : constValue
  Type : constType
  ## TODO? remember location
) =:: PointerConstant

## TODO? keep track of registers holding constant values
struct(
  ProgramContext ptr.mut : program
  RegisterState slice.mut : dataRegisters
  StackValue list : stack ## TODO? seperate stacks for ints, floats, and double-register values
  LabelId ValueLocation hashMap : variableLocations
  BlockInfo list : openBlocks
  ArgumentLocation list : argBuffer
  PointerConstant list : pointerConstants
  Atomic list : procTail
  i32 : intDataRegCount
  i32 : labelCount
  bool : reachable
) =:: CompilerContext

proc( Type : ptrType ConstValue : val CompilerContext ptr.mut : context -> i32 ) =>: newPtrConstant
  context [] .pointerConstants
    $ .length =:: constId
    val ptrType PointerConstant new list.append
  context .pointerConstants=
  constId return
end

proc( LabelId : valId RegisterId : register i32 : opIndex CompilerContext ptr.mut : context -> ) =>: cacheVariable
  context .variableLocations
    valId
    register ValueLocation .register
  map.put =:: prevLocation?
  ## remove previous location from register data
  prevLocation? optional.hasData and
      prevLocation? .data =:: prevLocation
      prevLocation .registers ?? ! "CodeGen: single register value not stored inregister pair" assert
      prevLocation .register ?? and
      prevLocation .register context findRegister =:: prevRegisterData?
      prevRegisterData? optional.hasData if
    prevRegisterData? .data =:: prevRegisterData
    prevRegisterData [] resetRegister prevRegisterData =[]
  end
  ## update register storage
  register context findRegister
    $ optional.isEmpty if ..drop return end
  .data =:: registerData
  opIndex registerData .lastUsed=
  registerData .currentValue .empty ?? "caching variable does not overwrite register" assert
  valId RegisterContent .variable registerData .currentValue=
end
proc( LabelId : valId RegisterPair : register i32 : opIndex CompilerContext ptr : context -> ) =>: cacheVariable2
  ## TODO cache double-register value
  "CodeGen: unimplemented" ..panic
end
proc( RegisterState : state -> RegisterState ) =>: resetRegister
  state
    RegisterContent .empty >$ .currentValue=
    -1 >$ .lastUsed=
  return
end
proc( LabelId : valId CompilerContext ptr.mut : context -> ValueLocation ptr.mut optional ) =>: atCachedVarLocation
  context .variableLocations valId map.at
end
proc( LabelId : valId bool : isGlobal CompilerContext ptr.mut : context -> ValueLocation ) =>: getVarLocation
  context .variableLocations
    valId
  map.get =:: location?
  location? optional.hasData if
    ## TODO update dependent cache if multi-value cache is accessed after back-jump
    ##    * variable mutable -> removes all other cached values
    ##    * variable immutable -> removes all mutable cached values
    location? .data return
  end
  valId
    isGlobal if
      ValueLocation .globalMemory
    else
      ValueLocation .localMemory
    end
  return
end

## TODO! easy way to get from register to register-state
proc(
  RegisterId : reg
  CompilerContext ptr.mut : context
-> RegisterState ptr.mut optional ) =>: findRegister ## TODO? better name
  reg NO_REG == if
    RegisterState ptr.mut optional.empty return
  end
  reg AMD64.dataRegIndex =:: regIndex
  regIndex 0 >= if
    context [] .dataRegisters regIndex @[] optional.wrap return
  end
  RegisterState ptr.mut optional.empty return
end

proc(
  CompilerContext ptr.mut : context
-> ) =>: resetRegisters
  context [] .stack list.clear context .stack=
  context .variableLocations map.clear
  context .dataRegisters [] .length for =:: i
    context [] .dataRegisters i []
      resetRegister
    context [] .dataRegisters i =[]
  end
end

proc( i32 : stackSlot CompilerContext ptr.mut : context -> StackValue ptr.mut ) =>: stackSlotData
  stackSlot 0 < or stackSlot context [] .stack .length >= if
    "CodeGen: stack-data and register-states are out of sync" ..panic
  end
  context [] .stack stackSlot list.at .data
end
proc(
  Atomic list
  RegisterState : regState
  ## TODO option to allow moving value to empty register (if available) instead of memory
  CompilerContext ptr.mut : context
-> Atomic list RegisterState ) =>: clearRegister
  ## save previous value
  regState .currentValue switch
    empty forceClear preserveValue case break
    stackSlot case
      regState .currentValue .stackSlot =:: stackSlot
      stackSlot context stackSlotData =:: stackData
      stackData [] .location switch
        register case
          stackData .location [] .register =:: register
          register regState .register == "CodeGen: stack-data and register state match" assert
          asm.OpType .MOVE
            stackData [] .valType
            stackSlot asm.Operand .stackData
            register asm.Operand .register
          asmOp2 list.append
          StackValueLocation .memory stackData .location=
          break
        memory registers registerHi registerLow case
          "CodeGen: stack-data and register-states are out of sync" ..panic
      end
      StackValueLocation .memory stackData .location=
      break
    stackSlotHi case
      regState .currentValue .stackSlotHi =:: stackSlot
      stackSlot context stackSlotData =:: stackData
      stackData [] .location switch
        registerHi case
          stackData .location [] .registerHi =:: register
          register regState .register == "CodeGen: stack-data and register state match" assert
          asm.OpType .MOVE
            stackData [] .valType getHiValType
            stackSlot asm.Operand .stackData128Hi
            register asm.Operand .register
          asmOp2 list.append
          StackValueLocation .memory stackData .location=
          break
        registers case
          stackData .location [] .registers .hi regState .register == "CodeGen: stack-data and register state match" assert
          asm.OpType .MOVE
            stackData [] .valType getHiValType
            stackSlot asm.Operand .stackData128Hi
            stackData .location [] .registers .hi asm.Operand .register
          asmOp2 list.append
          stackData .location [] .registers .low StackValueLocation .registerLow stackData .location=
          break
        memory register registerLow case
          "CodeGen: stack-data and register-states are out of sync" ..panic
      end
      StackValueLocation .memory stackData .location=
      break
    stackSlotLow case
      regState .currentValue .stackSlotLow =:: stackSlot
      stackSlot context stackSlotData =:: stackData
      stackData [] .location switch
        registerLow case
          stackData .location [] .registerLow =:: register
          register regState .register == "CodeGen: stack-data and register state match" assert
          asm.OpType .MOVE
            stackData [] .valType getLowValType
            stackSlot asm.Operand .stackData128Low
            register asm.Operand .register
          asmOp2 list.append
          StackValueLocation .memory stackData .location=
          break
        registers case
          stackData .location [] .registers .low regState .register == "CodeGen: stack-data and register state match" assert
          asm.OpType .MOVE
            stackData [] .valType getLowValType
            stackSlot asm.Operand .stackData128Low
            stackData .location [] .registers .low asm.Operand .register
          asmOp2 list.append
          stackData .location [] .registers .hi StackValueLocation .registerHi stackData .location=
          break
        memory register registerHi case
          "CodeGen: stack-data and register-states are out of sync" ..panic
      end
      break
    variable case
      context .variableLocations regState .currentValue .variable map.remove ..drop ## TODO check if correct value was removed
      break
  end
  regState resetRegister
end


proc(
  Atomic list : ops
  i32 : opIndex
  RegisterState slice.mut : candidates
  CompilerContext ptr.mut : context
-> Atomic list RegisterId ) =>: nextFreeRegister
  candidates 0 @[] =::  mut: bestCandidate
  0:i64 =:: mut: candiateIndex
  1:i64 while $ candidates .length < and bestCandidate [] .lastUsed 0 >= do =:: i
    candidates i [] .lastUsed bestCandidate [] .lastUsed < if
      candidates i @[] bestCandidate=
      i candiateIndex=
    end
  finally i 1 + end ..drop
  ops
    ## clear values cache register
    bestCandidate [] context clearRegister bestCandidate =[]
    opIndex bestCandidate .lastUsed=
  bestCandidate [] .register return
end
proc(
  Atomic list : ops
  i32 : opIndex
  CompilerContext ptr.mut : context
-> Atomic list RegisterId ) =>: nextIntRegister
  ops opIndex context [] .dataRegisters context [] .intDataRegCount slice.head context nextFreeRegister
end
proc(
  Atomic list : ops
  i32 : opIndex
  CompilerContext ptr.mut : context
-> Atomic list RegisterId ) =>: nextFloatRegister
  ops opIndex context [] .dataRegisters context [] .intDataRegCount slice.tail context nextFreeRegister
end
proc(
  Atomic list
  ValType : valType
  i32 : opIndex
  CompilerContext ptr.mut : context
-> Atomic list RegisterId ) =>: nextRegister
  valType isFloatValType if
    opIndex context nextFloatRegister
  else
    opIndex context nextIntRegister
  end
end


proc( CompilerContext ptr.mut : context -> ) =>: printRegisters
  context [] .program .idContext .typeContext .labelContext =:: labelContext
  context [] .dataRegisters for =:: regData
    regData .currentValue .empty ?? if continue end
    regData .register i32 cast.u =:: regId
    regId REG_FLAG_FLOAT & ? if
      'v' io.print regId REG_FLAG_FLOAT ^ io.print
    else
      'r' io.print regId io.print
    end
    regData .currentValue switch
      variable case " var: ":s io.print regData .currentValue .variable labelContext id.getLabelName io.println break
      stackSlot case " stack: ":s io.print regData .currentValue .stackSlot io.println break
      stackSlotHi case " stack.ho: ":s io.print regData .currentValue .stackSlotHi io.println break
      stackSlotLow case " stack.low: ":s io.print regData .currentValue .stackSlotLow io.println break
      forceClear case " force clear":s io.println break
      preserveValue case " preserve value":s io.println break
      empty case ..unreachable
    end
    regData .lastUsed io.println
  end
end

proc( RegisterState slice.mut : buffer CompilerContext ptr.mut : context -> ) =>: rememberRegisters
  context [] .dataRegisters =:: regs
  buffer .length regs .length >= "CodeGen: buffer large enough to store registers" assert
  ## TODO! remember float registers
  buffer .data regs .data regs .length mem.copy ..drop ## copy register data
end
## TODO? perocedure for updating single register
enum( MERGE MERGE_FALLTHROUGH RESET ) =:: RegisterRestoreMode
proc(
  Atomic list
  RegisterState slice.mut : buffer
  i32 : newStackSize
  RegisterRestoreMode : mode
  FilePosition : pos
  CompilerContext ptr.mut : context
-> Atomic list ) =>: restoreRegisters
  context [] .program =:: program
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  ## TODO! restore float registers
  context [] .dataRegisters =:: regs
  false =:: mut: usedEmptyReg
  mode .RESET ?? if
    ## set stack-size
    ## TODO ensure procedure does not access valus in invalid state
    context [] .stack
      newStackSize list.setLength
    context .stack=
  else
    newStackSize context [] .stack .length != if
      "CodeGen: branches have same stack size" sb.copyPtr
      pos program .errors appendError
      context [] .stack
        newStackSize list.setLength
      context .stack=
    end
  end
  buffer .length regs .length >= "CodeGen: buffer large enough to store registers" assert
  ## TODO? smarter algorithm (reduce number of moves)
  ## 1. clear all registers holding value not appearing in new state
  ##   -> more free registers, less unneccessary moves
  ## 2. move all values where source is register and target is currently free
  regs .length i32 cast for =:: i
    regs i [] .register isFloatReg =:: isFloat
    regs i [] .currentValue =:: currentValue
    buffer i [] .currentValue =:: expectedValue
    expectedValue currentValue RegisterContent.eq if ## already correct value in register
      expectedValue .empty ?? ! if
        buffer i [] .lastUsed
          mode .RESET ?? ! if regs i [] .lastUsed i32.max end
        regs i @[] .lastUsed= ## mark resister as used
      end
      continue
    end
    expectedValue .preserveValue ?? if
      continue
    end
    ## current value is wrong -> clear out register
    mode .RESET ?? if
      regs i [] resetRegister regs i =[]
    else expectedValue .empty ?? _if ## .forceClear is considered non-empty
      ## keep values in empty registers to avoid unnecessary moves
      currentValue .empty ?? ! usedEmptyReg=
    else currentValue .empty ?? ! _if
      -1 =:: mut: freeSlot
      isFloat if
        context [] .intDataRegCount regs .length i32 cast
      else
        0 context [] .intDataRegCount
      end =:: maxIndex =:: minIndex
      minIndex while $ maxIndex < do =:: j
        j i == if continue end
        ## TODO smarter algorithm
        ##  * move to correct buffer slot if currently empty
        ##  * prefer slots that empty in buffer
        regs j [] .currentValue .empty ?? and buffer j [] .currentValue .forceClear ?? ! if
          j freeSlot=
          j break
        end
      finally j 1 + end ..drop
      freeSlot 0 >= if
        regs freeSlot [] .register =:: targetRegister
        regs i [] .register =:: srcRegister
        ## temporarily move value to free register
        currentValue regs freeSlot @[] .currentValue=
        currentValue switch
          variable case
            currentValue .variable idContext id.getIdentifier
              ! "CodeGen: identifier exists" assert
            =:: idData
            currentValue .variable context atCachedVarLocation .data =:: varLoc
            varLoc [] .register srcRegister == "CodeGen: variable-cache and registers in sync" assert
            targetRegister varLoc .register=
            idData [] .valueType typeContext toValType
            break
          stackSlot case
            currentValue .stackSlot context stackSlotData =:: stackData
            stackData .location [] .register srcRegister == "CodeGen: stack and registers in sync" assert
            targetRegister stackData .location .register=
            stackData [] .valType
            break
          stackSlotHi stackSlotLow case "unimplemented" ..panic
          empty forceClear preserveValue case ..unreachable
        end =:: valType
        asm.OpType .MOVE
          valType
          targetRegister asm.Operand .register
          srcRegister asm.Operand .register
        asmOp2 list.append
        regs i [] resetRegister regs i =[]
        usedEmptyReg freeSlot i < | usedEmptyReg=
      else
        regs i [] context clearRegister regs i =[]
      end
    end
    ## copy expected value into register
    ## TODO? delay copying of memory values (to keep space of moved values)
    buffer i [] .register =:: targetRegister
    buffer i [] .lastUsed
      mode .RESET ?? ! if regs i [] .lastUsed i32.max end
    regs i @[] .lastUsed=
    expectedValue switch
      preserveValue case ..unreachable
      empty case continue ## do not change register
      forceClear case
        regs i [] .currentValue .empty ?? "register is cleared" assert
        continue
      variable case
        expectedValue .variable idContext id.getIdentifier
          ! "CodeGen: identifier exists" assert
        =:: idData
        mode .RESET ?? ! if
          expectedValue .variable idData .idType [] .GLOBAL_VAR ?? context getVarLocation =:: varLoc
          varLoc switch
            register case
              asm.OpType .MOVE
                idData [] .valueType typeContext toValType
                targetRegister asm.Operand .register
                varLoc .register asm.Operand .register
              asmOp2 list.append
              break
            localMemory case
              asm.OpType .MOVE
                idData [] .valueType typeContext toValType
                targetRegister asm.Operand .register
                varLoc .localMemory asm.Operand .localMemory
              asmOp2 list.append
              break
            globalMemory case
              asm.OpType .MOVE
                idData [] .valueType typeContext toValType
                targetRegister asm.Operand .register
                varLoc .globalMemory asm.Operand .globalMemory
              asmOp2 list.append
              break
            registerHi registerLow registers case "unimplemented" ..panic
            default "CodeGen: unsupported variable location" ..panic
          end
        end
        expectedValue .variable targetRegister buffer i [] .lastUsed context cacheVariable ## update variable location
        break
      stackSlot case
        expectedValue .stackSlot =:: stackSlot
        stackSlot context stackSlotData =:: stackData
        mode .RESET ?? if
          targetRegister stackData .location .register=
          break
        end
        stackData [] .location switch
          register case
            stackData .location [] .register =:: register
            asm.OpType .MOVE
              stackData [] .valType
              targetRegister asm.Operand .register
              register asm.Operand .register
            asmOp2 list.append
            StackValueLocation .memory stackData .location=
            register context findRegister .data =:: regState
            regState [] resetRegister regState =[] ## clear previous location
            break
          memory case
            asm.OpType .MOVE
              stackData [] .valType
              targetRegister asm.Operand .register
              stackSlot asm.Operand .stackData
            asmOp2 list.append
            StackValueLocation .memory stackData .location=
            break
          registers registerHi registerLow case
            "CodeGen: stack-data and register-states are out of sync" ..panic
        end
        targetRegister stackData .location .register=
        break
      stackSlotHi stackSlotLow case "unimplemented" ..panic
    end
    expectedValue regs i @[] .currentValue=
  end
  mode .MERGE ?? and usedEmptyReg if ## cleanup tmp-vars that were moved to previously cleared slots
    regs .length for =:: i
      buffer i [] .currentValue .empty ?? if
        regs i [] context clearRegister regs i =[]
      end
    end
  end
end

proc( CompilerContext ptr.mut : context -> i32 ) =>: nextLabelId
  context [] .labelCount
    $ 1 + context .labelCount=
  return
end
proc(
  BlockId : blockId
  i32 : startLabelId
  CompilerContext ptr.mut : context
-> WhileBlockInfo ptr.mut ) =>: openWhileBlock
  context .dataRegisters [] .length i32 cast =:: regCount
  context [] .openBlocks
    ## WhileBlockInfo
      blockId
      startLabelId
      NO_LABEL NO_LABEL NO_LABEL
      regCount 4 * i64 cast.u RegisterState mem.alloc regCount 4 * slice.createMutable
      regCount
      regCount 2 *
      regCount 3 *
      -1 -1 -1 -1
    WhileBlockInfo new BlockInfo .While list.append
  context .openBlocks=
  context [] .openBlocks list.peek .data .While
end
proc(
  BlockId : blockId
  CompilerContext ptr.mut : context
-> IfBlockInfo ptr.mut ) =>: openIfBlock
  context .dataRegisters [] .length i32 cast =:: regCount
  context [] .openBlocks
    ## IfBlockInfo
      blockId
      NO_LABEL
      NO_LABEL
      NO_LABEL
      regCount 3 * i64 cast.u RegisterState mem.alloc regCount 3 * slice.createMutable
      regCount
      regCount 2 *
      -1
      -1
      false
    IfBlockInfo new BlockInfo .If list.append
  context .openBlocks=
  context [] .openBlocks list.peek .data .If
end
proc(
  BlockId : blockId
  CompilerContext ptr.mut : context
-> AndOrBlockInfo ptr.mut ) =>: openAndOrBlock
  context .dataRegisters [] .length i32 cast =:: regCount
  context [] .openBlocks
    ## IfBlockInfo
      blockId
      NO_LABEL
      regCount i64 cast.u RegisterState mem.alloc regCount slice.createMutable
      -1
    AndOrBlockInfo new BlockInfo .AndOr list.append
  context .openBlocks=
  context [] .openBlocks list.peek .data .AndOr
end
proc(
  BlockId : blockId
  i32 : caseCount
  CompilerContext ptr.mut : context
-> SwitchBlockInfo ptr.mut ) =>: openSwitchBlock
  context .dataRegisters [] .length i32 cast =:: regCount
  context [] .openBlocks
    ## SwitchBlockInfo
      blockId
      NO_LABEL
      caseCount 1 + i64 cast.u i32 mem.alloc
        $ caseCount 1 + i64 cast.u NO_LABEL mem.fill
      caseCount 1 + slice.createMutable
      regCount 2 *  i64 cast.u RegisterState mem.alloc regCount 2 * slice.createMutable
      regCount
      -1 -1
      0
    SwitchBlockInfo new BlockInfo .Switch list.append
  context .openBlocks=
  context [] .openBlocks list.peek .data .Switch
end

enum( WHILE SWITCH ) =:: BreakType
proc(
  BlockId : blockId
  BreakType : breakType
  CompilerContext ptr.mut : context
-> BlockInfo ptr.mut optional ) =>: findBreakableBlock
  context [] .program =:: program
  program .errors =:: errors
  context [] .openBlocks list.atReversed for =:: block
    breakType .WHILE ?? and block [] .While ?? and
        block [] .While .blockId blockId == if
      block optional.wrap return
    end
    breakType .SWITCH ?? and block [] .Switch ?? and
        block [] .Switch .blockId blockId == if
      block optional.wrap return
    end
  end
  BlockInfo ptr.mut optional.empty return
end

proc(
  Atomic list
  ValType : valType
  asm.Operand : switchValOperand
  LabelData slice : labels
  i32 slice : caseLabelIds
  i64 : lower ## input is >= lower
  i64 : upper ## input is <= upper
  bool : signed ## use signed comparisson
  CompilerContext ptr.mut : context
-> Atomic list ) =>: generateDecisionTree
  labels 0 [] .value switchLabelAsInt =:: minLabel
  labels $ .length 1 - [] .value switchLabelAsInt =:: maxLabel
  caseLabelIds .length 1 - i32 cast =:: defaultLabelId
  ## TODO? compress contiguous ranges jumping to same label
  labels .length 3 <= if
    upper lower - labels .length 1 - == =:: contiguous ## all values between lower and upper are labels
    labels contiguous if $ .length 1 - slice.head end for =:: l
      asm.OpType .JMPIF
        valType
        asm.CompareType .EQ asm.Operand .cmpType
        switchValOperand
        l .value switchLabelAsInt asm.Operand .constInt
        caseLabelIds l .caseId [] asm.Operand .localLabel
      asmOp4 list.append
    end
    asm.OpType .JMP ValType .EMPTY
      contiguous if
        caseLabelIds labels $ .length 1 - [] .caseId []
      else
        defaultLabelId
      end asm.Operand .localLabel
    asmOp1 list.append
    return
  end
  labels .length 2 / =:: centerId
  labels centerId [] .value switchLabelAsInt =:: midValue
  context nextLabelId =:: branchLabel
  asm.OpType .JMPIF
    valType
    signed if asm.CompareType .GE else asm.CompareType .UGE end asm.Operand .cmpType
    switchValOperand
    midValue asm.Operand .constInt
    branchLabel asm.Operand .localLabel
  asmOp4 list.append
  ## less than mid-value
    valType
    switchValOperand
    labels centerId slice.head
    caseLabelIds
    lower
    midValue 1 -
    signed
    context
  generateDecisionTree
  asm.OpType .LABEL ValType .EMPTY
    branchLabel asm.Operand .localLabel
  asmOp1 list.append
  ## greater or equal to mid-value
    valType
    switchValOperand
    labels centerId slice.tail
    caseLabelIds
    midValue
    upper
    signed
    context
  generateDecisionTree
  return
end
proc(
  Atomic list
  StackValue : val
  SwitchBlockInfo ptr : blockInfo
  SwitchData ptr.mut : switchData
  CompilerContext ptr.mut : context
-> Atomic list ) =>: generateSwitchTable
  switchData [] .labels =:: labels
  labels 0 [] .value switchLabelAsInt =:: minLabel
  labels $ .length 1 - [] .value switchLabelAsInt =:: maxLabel
  blockInfo [] .caseLabelIds $ .length 1 - [] =:: defaultLabel
  val .location switch
    register case
        val .location .register asm.Operand .register
      break
    memory case ## TODO is this the right offset
        context [] .stack .length 1 + asm.Operand .stackData
      break
    registers registerHi registerLow case "unexpected format for condition parameter" ..panic
  end =:: switchValOperand
  switchValOperand .register =:: switchOpReg ## TODO ensure target value is register
  ## 0-4 -> linear check
  ## TODO find good way to decide which switch-type to use
  ## TODO? mixed switch: tree for sparse values, table for long continues ranges of values
  labels .length 3 > and maxLabel minLabel - labels .length i64 cast.u $ 4 / + <= if
    context nextLabelId =:: jumpTableId
    ## jump-table
    minLabel 0 != if
      asm.OpType .SUB
        val .valType
        switchValOperand
        switchValOperand
        minLabel asm.Operand .constInt
      asmOp3 list.append
    end
    asm.OpType .JMPIF
      val .valType
      asm.CompareType .UGT asm.Operand .cmpType
      switchValOperand
      maxLabel minLabel - asm.Operand .constInt
      defaultLabel asm.Operand .localLabel
    asmOp4 list.append
    asm.OpType .JMP
      ValType .EMPTY
      switchOpReg jumpTableId asm.RegAndOffset new asm.Operand .jumpTableElement
    asmOp1 list.append
    ## TODO? do not use magic number of table alignment
    8 Atomic .Align list.append ## align jump-table to element size
    asm.OpType .LABEL
      ValType .EMPTY
      jumpTableId asm.Operand .localLabel
    asmOp1 list.append
    0 =:: mut: labelIndex
    minLabel while $ maxLabel <= do =:: tableValue
      labels labelIndex [] .value switchLabelAsInt =:: labelValue
      asm.OpType .DATA
        ValType .PTR
        labelValue tableValue == if
          blockInfo [] .caseLabelIds labels labelIndex [] .caseId []
          labelIndex 1 + labelIndex=
        else
          defaultLabel
        end asm.Operand .localLabel
      asmOp1 list.append
    finally tableValue 1 + end ..drop
  else
    val .valType
      switchValOperand
      labels list.asSlice
      blockInfo [] .caseLabelIds slice.freeze
      i64.MIN ## TODO pass correct bounds for input type & signdness
      i64.MAX
      val .valType .I64 ?? ## smaller values have been zero-extended before sorting
      context
    generateDecisionTree
  end
end

proc(
  RegisterId : regId
  ValType : valType
  CompilerContext ptr.mut : context
-> ) =>: pushRegister
  regId context findRegister .data =:: regState
  regState .currentValue .empty ?? "CodeGen: pushed register is currently unassigned" assert
  context .stack [] .length RegisterContent .stackSlot regState .currentValue=
  context [] .stack
    regId StackValueLocation .register valType StackValue new list.push
  context .stack=
end
proc(
  Atomic list
  ValType : valType
  ValueLocation : location
  i32 : opIndex
  CompilerContext ptr.mut : context
-> Atomic list ) =>: pushValue
  ## TODO make dependent on valType
  location switch
    register case
      location .register context findRegister =:: regState
      regState optional.hasData and regState .data .currentValue [] .empty ?? if
        opIndex regState .data .lastUsed=
        location .register valType context pushRegister
      else ## arg register is not a valid data register
        valType opIndex context nextRegister =:: targetRegister
        asm.OpType .MOVE
          valType
          targetRegister asm.Operand .register
          location .register asm.Operand .register
        asmOp2 list.append
        targetRegister valType context pushRegister
      end
      return
    registers registerHi registerLow case
      break
    intConstant case
      opIndex context nextIntRegister =:: targetRegister
      asm.OpType .MOVE
        valType
        targetRegister asm.Operand .register
        location .intConstant asm.Operand .constInt
      asmOp2 list.append
      targetRegister valType context pushRegister
      return
    floatConstant case
      opIndex context nextFloatRegister =:: targetRegister
      asm.OpType .MOVE
        valType
        targetRegister asm.Operand .register
        location .floatConstant asm.Operand .constFloat
      asmOp2 list.append
      targetRegister valType context pushRegister
      return
    ptrConstant case
      opIndex context nextIntRegister =:: targetRegister
      asm.OpType .MOVE
        valType
        targetRegister asm.Operand .register
        location .ptrConstant asm.Operand .constPtr
      asmOp2 list.append
      targetRegister valType context pushRegister
      return
    intArgument case
      break
    floatArgument case
      break
    localMemory case ## TODO handle composite values
      valType opIndex context nextRegister =:: targetRegister
      asm.OpType .MOVE valType
        targetRegister asm.Operand .register
        location .localMemory asm.Operand .localMemory
      asmOp2 list.append
      targetRegister valType context pushRegister
      return
    globalMemory case
      break
  end
  Atomic .Unknown list.append return
end
proc(
  Atomic list : ops
  ValType optional : argType
  FilePosition : pos
  CompilerContext ptr.mut : context
-> Atomic list StackValue optional ) =>: popValue
  context [] .program .errors =:: errors
  context [] .stack .length 0 == if
    ops StackValue optional.empty return
  end
  context [] .stack
    list.pop =:: popped
  context .stack=
  argType optional.hasData and popped .valType argType .data != if
    "unexpected value type expected: " sb.copyPtr
      argType .data sb.appendValType
      " got: " sb.appendS
      popped .valType sb.appendValType
    pos errors appendError
    ops StackValue optional.empty return
  end
  ## update status of popped registers
  popped .location switch
    register case
      popped .location .register context findRegister =:: regState
      regState .data [] resetRegister regState .data =[]
      break
    registerHi case
      popped .location .registerHi context findRegister =:: regState
      regState .data [] resetRegister regState .data =[]
      break
    registerLow case
      popped .location .registerLow context findRegister =:: regState
      regState .data [] resetRegister regState .data =[]
      break
    registers case
      popped .location .registers .hi context findRegister =:: hiReg
      popped .location .registers .low context findRegister =:: lowReg
      hiReg .data [] resetRegister hiReg .data =[]
      lowReg .data [] resetRegister lowReg .data =[]
      break
    memory case break ## nothing to do
  end
  ops popped optional.wrap return
end


enum( autoCast Cast Cast! bitCast ) =:: CastType

proc(
  Atomic list
  CastType : castType
  SignType : mut: signType
  Type : mut: src
  i32 : offset
  Type : mut: target
  FilePosition : pos
  CompilerContext ptr.mut : context
-> Atomic list ) =>: compileCast
  context [] .program =:: program
  program .errors =:: errors
  program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  src typeContext types.unwrapNamed
    $ .cType ?? if .cType types.cTypeAsType end
    $ .intLiteral ?? if .intLiteral types.intLiteralAsInt end
  src=
  target typeContext types.unwrapNamed
    $ .cType ?? if .cType types.cTypeAsType end
    $ .intLiteral ?? if .intLiteral types.intLiteralAsInt end
  target=
  ## TODO? distinquish code and data pointers / pointers with different alignment
  src target types.typeEquals or src typeContext types.isPointer and target typeContext types.isPointer if
    return ## nothing to do
  end
  signType .NONE ?? if
    src typeContext types.isUnsignedInt or src typeContext types.isChar if
        SignType .UNSIGNED signType=
      else src typeContext types.isSignedInt _if
        SignType .SIGNED signType=
      else target typeContext types.isUnsignedInt or target typeContext types.isChar _if
        SignType .UNSIGNED signType=
      else target typeContext types.isSignedInt _if
        SignType .SIGNED signType=
      end
  end
  offset context .stack [] .length >= if
    "CodeGen: stack underflow in cast" sb.copyPtr
    pos errors appendError
    return
  end
  context [] .stack $ .length 1 - offset - @[] =:: stackEntry
  stackEntry .location .register ?? ! if
    "CodeGen: unimplemented non-register cast-source" ..panic
    ## TODO move source to register
  end
  src typeContext types.isIntOrChar and target typeContext types.isIntOrChar if
    src typeContext types.primitiveValue types.sizeOfPrimitive =:: srcBytes
    target typeContext types.primitiveValue types.sizeOfPrimitive =:: targetBytes
    target typeContext toValType stackEntry .valType=
    srcBytes targetBytes == if return end
    srcBytes targetBytes < if
      targetBytes 4 > if
        signType .UNSIGNED ?? if asm.OpType .EXT64U else asm.OpType .EXT64S end
      else
        signType .UNSIGNED ?? if asm.OpType .EXT32U else asm.OpType .EXT32S end
      end
        src typeContext toValType
        stackEntry .location [] .register asm.Operand .register
      asmOp1 list.append
      return
    end
    targetBytes switch
      1 case asm.OpType .TRUNC8 break
      2 case asm.OpType .TRUNC16 break
      4 case asm.OpType .TRUNC32 break
      default "unexpected size for interger truncate: " sb.copyPtr
        targetBytes sb.appendI
      pos errors appendError return
    end
      src typeContext toValType
      stackEntry .location [] .register asm.Operand .register
    asmOp1 list.append
    return
  end
  src typeContext types.isFloat and target typeContext types.isFloat if
    src typeContext types.primitiveValue types.sizeOfPrimitive =:: srcBytes
    target typeContext types.primitiveValue types.sizeOfPrimitive =:: targetBytes
    target typeContext toValType stackEntry .valType=
    srcBytes targetBytes == if return end
    srcBytes targetBytes < if
      asm.OpType .EXT64F
    else
      asm.OpType .TRUCT32F
    end
      src typeContext toValType
      stackEntry .location [] .register asm.Operand .register
    asmOp1 list.append
    return
  end
  ## TODO support different casts
  Atomic .Unknown list.append
end

proc(
  Atomic list : ops
  asm.OpType : opType
  ValType : argType
  FilePosition : pos
  i32 : opIndex
  CompilerContext ptr.mut : context
-> Atomic list ) =>: compileUnaryOperator
  ops
    argType optional.wrap pos context popValue =:: argValue?
    argValue? optional.isEmpty if return end
    argValue? .data =:: argValue
  =:: mut: newOps
  ## TODO check if argument caches any variables, if not reuse same register(s)
  argType switch
    EMPTY case break
    I8 I16 I32 I64 PTR F32 F64 case
      newOps
        argType opIndex context nextRegister =:: targetRegister
        opType
          argType
          targetRegister asm.Operand .register
          argValue .location switch ## TODO? extract for procedure
            register case argValue .location .register asm.Operand .register break
            memory case context [] .stack .length asm.Operand .stackData break
            registers registerHi registerLow case ..unreachable ## wrong data-format
          end
        asmOp2 list.append
        ## pushValue
          argType
          targetRegister ValueLocation .register
          opIndex
          context
        pushValue
      return
    REFERENCE case
      break
    BITS128 BITS128IF BITS128FI BITS128F case
      break
  end
  newOps
    Atomic .Unknown list.append
  return
end
proc(
  Atomic list : ops
  asm.OpType : opType
  ValType : argType
  FilePosition : pos
  i32 : opIndex
  CompilerContext ptr.mut : context
-> Atomic list ) =>: compileBinaryOperator
  RegisterState MAX_DATA_REGISTERS array : argRegBuffer
  context .stack [] .length =:: stackSize
  ops
    argType isIntValType if
      opType stackSize argRegBuffer@ AMD64.fixedInputInt =:: inputLocs
      inputLocs .length 0 > if
        inputLocs stackSize RegisterRestoreMode .MERGE_FALLTHROUGH pos context restoreRegisters
      end
    end
    argType optional.wrap pos context popValue =:: arg2?
    arg2? optional.isEmpty if return end
    arg2? .data =:: arg2
    argType optional.wrap pos context popValue =:: arg1?
    arg1? optional.isEmpty if return end
    arg1? .data =:: arg1
  =:: mut: newOps
  ## TODO check if first argument caches any variables, if not reuse same register(s)
  argType switch
    EMPTY case break
    I8 I16 I32 I64 PTR F32 F64 case
      newOps
        argType isIntValType and
            opType AMD64.fixedTargetInt =:: target?
            target? optional.hasData if
          target? .data
        else
          argType opIndex context nextRegister
        end =:: targetRegister
        opType
          argType
          targetRegister asm.Operand .register
          arg1 .location switch ## TODO? extract for procedure
            register case arg1 .location .register asm.Operand .register break
            memory case context [] .stack .length asm.Operand .stackData break
            registers registerHi registerLow case ..unreachable ## wrong data-format
          end
          arg2 .location switch ## TODO? extract for procedure
            register case arg2 .location .register asm.Operand .register break
            memory case context [] .stack .length asm.Operand .stackData break
            registers registerHi registerLow case ..unreachable ## wrong data-format
          end
        asmOp3 list.append
        ## pushValue
          argType
          targetRegister ValueLocation .register
          opIndex
          context
        pushValue
      return
    REFERENCE case
      break
    BITS128 BITS128IF BITS128FI BITS128F case
      break
  end
  newOps
    Atomic .Unknown list.append
  return
end
proc(
  Atomic list : ops
  asm.CompareType : cmpType
  ValType : argType
  FilePosition : pos
  i32 : opIndex
  CompilerContext ptr.mut : context
-> Atomic list ) =>: compileComparisonOperator
  ops
    argType optional.wrap pos context popValue =:: arg2?
    arg2? optional.isEmpty if return end
    arg2? .data =:: arg2
    argType optional.wrap pos context popValue =:: arg1?
    arg1? optional.isEmpty if return end
    arg1? .data =:: arg1
  =:: mut: newOps
  ## TODO check if first argument caches any variables, if not reuse same register(s)
  argType switch
    EMPTY case break
    I8 I16 I32 I64 PTR F32 F64 case
      newOps
        opIndex context nextIntRegister =:: targetRegister
        asm.OpType .CMP
          argType
          cmpType asm.Operand .cmpType
          targetRegister asm.Operand .register
          arg1 .location switch ## TODO? extract for procedure
            register case arg1 .location .register asm.Operand .register break
            memory case context [] .stack .length asm.Operand .stackData break
            registers registerHi registerLow case ..unreachable ## wrong data-format
          end
          arg2 .location switch ## TODO? extract for procedure
            register case arg2 .location .register asm.Operand .register break
            memory case context [] .stack .length asm.Operand .stackData break
            registers registerHi registerLow case ..unreachable ## wrong data-format
          end
        asmOp4 list.append
        ## pushValue
          ValType .I8
          targetRegister ValueLocation .register
          opIndex
          context
        pushValue
      return
    REFERENCE case
      break
    BITS128 BITS128IF BITS128FI BITS128F case
      break
  end
  newOps
    Atomic .Unknown list.append
  return
end

proc(
  Atomic list : ops
  BuiltIn : builtIn
  Type : opType
  FilePosition : pos
  i32 : opIndex
  CompilerContext ptr.mut : context
-> Atomic list ) =>: compileBuiltIn
  using: Op asm.OpType
  using: Cmp asm.CompareType
  context [] .program =:: program
  program .errors =:: errors
  program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  opType typeContext types.getProcIn ..drop =:: inType
  inType typeContext types.compositeEltCount 0 > if
    inType 0 typeContext types.compositeGetLabel
        labelContext id.labelFlags id.FLAG_STATIC & ? if
      1:i32
    else
      0:i32
    end =:: firstArg
    inType firstArg typeContext types.compositeGetElement
  else
      opType typeContext types.getProcOut ..drop =:: outType
      outType typeContext types.compositeEltCount 0 > _if
    outType 0 typeContext types.compositeGetElement
  else
    Type .undefined
  end =:: baseType
  baseType typeContext toValType =:: baseVal
  builtIn switch
    NEG_I8 NEG_I16 NEG_I32 NEG_I64 NEG_F32 NEG_F64 case
      ops Op .NEG baseVal pos opIndex context compileUnaryOperator return
    ADD_I8 ADD_I16 ADD_I32 ADD_I64 ADD_F32 ADD_F64 case
      ops Op .ADD baseVal pos opIndex context compileBinaryOperator return
    SUB_I8 SUB_I16 SUB_I32 SUB_I64 SUB_F32 SUB_F64 C8_DIFF C16_DIFF C32_DIFF case
     ## TODO? ensure char-diff arguments are zero extended
      ops Op .SUB baseVal pos opIndex context compileBinaryOperator return
    MUL_I32 MUL_I64 MUL_F32 MUL_F64 case
      ops Op .MUL baseVal pos opIndex context compileBinaryOperator return
    DIV_I32 DIV_I64 DIV_F32 DIV_F64 case
      ops Op .DIV baseVal pos opIndex context compileBinaryOperator return
    REM_I32 REM_I64 case
      ops Op .MOD baseVal pos opIndex context compileBinaryOperator return
    UDIV_I32 UDIV_I64 case
      ops Op .UDIV baseVal pos opIndex context compileBinaryOperator return
    UMOD_I32 UMOD_I64 case
      ops Op .UMOD baseVal pos opIndex context compileBinaryOperator return
    NOT_BOOL case
      ops Op .BOOLNOT baseVal pos opIndex context compileUnaryOperator return
    FLIP_I8 FLIP_I16 FLIP_I32 FLIP_I64 case
      ops Op .BITNOT baseVal pos opIndex context compileUnaryOperator return
    AND_BOOL AND_I8 AND_I16 AND_I32 AND_I64 case
      ops Op .AND baseVal pos opIndex context compileBinaryOperator
      return
    OR_BOOL  OR_I8 OR_I16 OR_I32 OR_I64 case
      ops Op .OR baseVal pos opIndex context compileBinaryOperator
      return
    XOR_BOOL XOR_I8 XOR_I16 XOR_I32 XOR_I64 case
      ops Op .XOR baseVal pos opIndex context compileBinaryOperator
      return
    SHL_I8 SHL_I16 SHL_I32 SHL_I64 case
      ops Op .SHL baseVal pos opIndex context compileBinaryOperator
      return
    LSHR_I8 LSHR_I16 LSHR_I32 LSHR_I64 case
      ops Op .LSHR baseVal pos opIndex context compileBinaryOperator
      return
    ASHR_I8 ASHR_I16 ASHR_I32 ASHR_I64 case
      ops Op .ASHR baseVal pos opIndex context compileBinaryOperator
      return
    EQ_BOOL EQ_I8 EQ_I16 EQ_I32 EQ_I64 EQ_F32 EQ_F64 EQ_C8 EQ_C16 EQ_C32 case
      ops Cmp .EQ baseVal pos opIndex context compileComparisonOperator
      return
    NE_BOOL NE_I8 NE_I16 NE_I32 NE_I64 NE_F32 NE_F64 NE_C8 NE_C16 NE_C32 case
      ops Cmp .NE baseVal pos opIndex context compileComparisonOperator
      return
    LT_I8 LT_I16 LT_I32 LT_I64 LT_F32 LT_F64 case
      ops Cmp .LT baseVal pos opIndex context compileComparisonOperator
      return
    ULT_I8 ULT_I16 ULT_I32 ULT_I64 LT_C8 LT_C16 LT_C32 case
      ops Cmp .ULT baseVal pos opIndex context compileComparisonOperator
      return
    LE_I8 LE_I16 LE_I32 LE_I64 LE_F32 LE_F64 case
      ops Cmp .LE baseVal pos opIndex context compileComparisonOperator
      return
    ULE_I8 ULE_I16 ULE_I32 ULE_I64 LE_C8 LE_C16 LE_C32 case
      ops Cmp .ULE baseVal pos opIndex context compileComparisonOperator
      return
    GT_I8 GT_I16 GT_I32 GT_I64 GT_F32 GT_F64 case
      ops Cmp .GT baseVal pos opIndex context compileComparisonOperator
      return
    UGT_I8 UGT_I16 UGT_I32 UGT_I64 GT_C8 GT_C16 GT_C32 case
      ops Cmp .UGT baseVal pos opIndex context compileComparisonOperator
      return
    GE_I8 GE_I16 GE_I32 GE_I64 GE_F32 GE_F64 case
      ops Cmp .GE baseVal pos opIndex context compileComparisonOperator
      return
    UGE_I8 UGE_I16 UGE_I32 UGE_I64 GE_C8 GE_C16 GE_C32 case
      ops Cmp .UGE baseVal pos opIndex context compileComparisonOperator
      return
    DIV_I64I32 REM_I64I32 UDIV_I64I32 UMOD_I64I32 SHL_I64I32 LSHR_I64I32 ASHR_I64I32 case break ## TODO move to standard libray
    default break
  end
  ops
    Atomic .Unknown list.append
  return
end

proc(
  Atomic list : ops
  Operation ptr : op
  i32 : opIndex
  CompilerContext ptr.mut : context
-> Atomic list ) =>: compileOp
  context [] .program =:: program
  program .errors =:: errors
  program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  ops
    op .val .implementProcedure ?? if
      true context .reachable=
      op .val [] .implementProcedure =:: implInfo
