  context [] .stack $ .length 1 - offset - @[] =:: stackEntry
  stackEntry .location .register ?? ! if
    "CodeGen: unimplemented non-register cast-source" ..panic
    ## TODO move source to register
  end
  src typeContext types.isIntOrChar and target typeContext types.isIntOrChar if
    src typeContext types.primitiveValue types.sizeOfPrimitive =:: srcBytes
    target typeContext types.primitiveValue types.sizeOfPrimitive =:: targetBytes
    target typeContext toValType stackEntry .valType=
    srcBytes targetBytes == if return end
    target typeContext toValType =:: targetType
    targetType stackEntry .valType=
    stackEntry .location [] .register targetType setRegType =:: targetReg
    srcBytes targetBytes < if
      signType .UNSIGNED ?? if asm.OpType .EXTU else asm.OpType .EXTS end
    else
      asm.OpType .TRUNC
    end
      targetReg asm.Operand .register
      stackEntry .location [] .register asm.Operand .register
    context appendOp2
    targetReg stackEntry .location .register=
    targetReg context findRegister ..drop ## update register type
    return
  end
  castType .bitCast ?? and src typeContext types.isNumberOrChar and target typeContext types.isNumberOrChar if
    src typeContext types.primitiveValue types.sizeOfPrimitive =:: srcBytes
    target typeContext types.primitiveValue types.sizeOfPrimitive =:: targetBytes
    stackEntry .location [] .register =:: mut: targetRegister
    ## TODO? is there a need to keep track of system endianness for float <-> int bit-casts
    ## TODO? should bitcast be defined to emulate a little endian system
    ## 1. float -> int
    src typeContext types.isFloat if
      srcBytes switch
        1 case ValType .I8  break
        2 case ValType .I16 break
        4 case ValType .I32 break
        8 case ValType .I64 break
        default "unexpected size for int" ..panic
      end opIndex context nextRegister =:: intReg
      asm.OpType .MOVE
        intReg asm.Operand .register
        targetRegister asm.Operand .register
      context appendOp2
      intReg targetRegister=
    end
    ## 2. zero-extend/truncate
    srcBytes targetBytes != if
      targetBytes switch
        1 case ValType .I8  break
        2 case ValType .I16 break
        4 case ValType .I32 break
        8 case ValType .I64 break
        default "unexpected size for int" ..panic
      end =:: targetIntVal
      targetRegister targetIntVal setRegType =:: newRegSize
      srcBytes targetBytes < if
        asm.OpType .EXTU
          newRegSize asm.Operand .register
          targetRegister asm.Operand .register
        context appendOp2
      else srcBytes targetBytes > _if
        asm.OpType .TRUNC
          newRegSize asm.Operand .register
          targetRegister asm.Operand .register
        context appendOp2
      end
      newRegSize targetRegister=
    end
    ## 3. int -> float
    target typeContext types.isFloat if
      targetBytes switch
        2 case "f16 is not supported" ..panic
        4 case ValType .F32 break
        8 case ValType .F64 break
        default "unexpected size for float" ..panic
      end =:: targetFloatVal
      src typeContext types.isFloat if
        stackEntry .location [] .register targetFloatVal setRegType
      else
        targetFloatVal opIndex context nextRegister
      end =:: floatReg
      asm.OpType .MOVE
        floatReg asm.Operand .register
        targetRegister asm.Operand .register
      context appendOp2
      floatReg targetRegister=
    end
    target typeContext toValType stackEntry .valType=
    stackEntry .location [] .register targetRegister baseRegEq ! if
      stackEntry .location [] .register context findRegister .data =:: srcReg
      srcReg [] .currentValue targetRegister context findRegister .data .currentValue=
      srcReg [] resetRegister srcReg =[]
    else
      targetRegister context findRegister ..drop ## update register type
    end
    targetRegister stackEntry .location .register=
    return
  end
  src typeContext types.isFloat and target typeContext types.isFloat if
    src typeContext types.primitiveValue types.sizeOfPrimitive =:: srcBytes
    target typeContext types.primitiveValue types.sizeOfPrimitive =:: targetBytes
    target typeContext toValType =:: targetType
    targetType stackEntry .valType=
    stackEntry .location [] .register targetType setRegType =:: targetReg
    srcBytes targetBytes == if return end
    srcBytes targetBytes < if asm.OpType .EXTF else asm.OpType .TRUNCF end
      targetReg asm.Operand .register
      stackEntry .location [] .register asm.Operand .register
    context appendOp2
    targetReg stackEntry .location .register=
    targetReg context findRegister ..drop ## update register type
    return
  end
  src typeContext types.isInt and target typeContext types.isFloat if
    src typeContext types.primitiveValue types.sizeOfPrimitive =:: srcBytes
    target typeContext types.primitiveValue types.sizeOfPrimitive =:: targetBytes
    target typeContext toValType =:: targetVal
    targetVal opIndex context nextRegister =:: targetRegister
    signType .UNSIGNED ?? if asm.OpType .U2F else asm.OpType .I2F end
      targetRegister asm.Operand .register
      stackEntry .location [] .register asm.Operand .register
    context appendOp2
    ## TODO avoid manually updating register data (? movStackValue regId, regId operation )
    stackEntry .location [] .register context findRegister .data =:: srcReg
    srcReg [] .currentValue targetRegister context findRegister .data .currentValue=
    srcReg [] resetRegister srcReg =[]
    targetRegister stackEntry .location .register=
    targetVal stackEntry .valType=
    return
  end
  src typeContext types.isFloat and target typeContext types.isInt if
    src typeContext types.primitiveValue types.sizeOfPrimitive =:: srcBytes
    target typeContext types.primitiveValue =:: primitiveTarget
    primitiveTarget types.sizeOfPrimitive =:: targetBytes
    src typeContext toValType =:: srcVal
    srcVal opIndex context nextRegister =:: tmpReg
    stackEntry .location [] .register asm.Operand .register =:: srcLoc
    target typeContext toValType =:: targetVal
    targetVal opIndex context nextRegister =:: targetRegister
    signType .UNSIGNED ?? if asm.OpType .F2U else asm.OpType .F2I end
      targetRegister asm.Operand .register
      srcLoc
    context appendOp2
    ## TODO avoid manually updating register data
    stackEntry .location [] .register context findRegister .data =:: srcReg
    srcReg [] .currentValue targetRegister context findRegister .data .currentValue=
    srcReg [] resetRegister srcReg =[]
    targetRegister stackEntry .location .register=
    targetVal stackEntry .valType=
    return
  end
  ## TODO support different casts
  Atomic .Unknown list.append
end

proc(
  Atomic list : ops
  asm.OpType : opType
  ValType : argType
  FilePosition : pos
  i32 : opIndex
  CompilerContext ptr.mut : context
-> Atomic list ) =>: compileUnaryOperator
  ops
    argType optional.wrap pos context popValue =:: argValue?
    argValue? optional.isEmpty if return end
    argValue? .data =:: argValue
  =:: mut: newOps
  ## TODO check if argument caches any variables, if not reuse same register(s)
  argType switch
    EMPTY case break
    I8 I16 I32 I64 PTR F32 F64 case
      newOps
        argType opIndex context nextRegister =:: targetRegister
        opType
          targetRegister asm.Operand .register
          argValue .location switch ## TODO? extract for procedure
            register case argValue .location .register asm.Operand .register break
            memory case context [] .stack .length asm.Operand .stackData break
            registers registerHi registerLow case ..unreachable ## wrong data-format
          end
        context appendOp2
        ## pushValue
          argType
          targetRegister ValueLocation .register
          opIndex
          context
        pushValue
      return
    REFERENCE case
      break
    BITS128 BITS128IF BITS128FI BITS128F case
      break
  end
  newOps
    Atomic .Unknown list.append
  return
end
proc(
  Atomic list : ops
  asm.OpType : opType
  ValType : argType
  FilePosition : pos
  i32 : opIndex
  CompilerContext ptr.mut : context
-> Atomic list ) =>: compileBinaryOperator
  RegisterState MAX_DATA_REGISTERS array : argRegBuffer
  context .stack [] .length =:: stackSize
  ops
    argType isIntValType if
      opType stackSize argRegBuffer@ AMD64.fixedInputInt =:: inputLocs
      inputLocs .length 0 > if
        inputLocs stackSize RegisterRestoreMode .MERGE_FALLTHROUGH pos context restoreRegisters
      end
    end
    argType optional.wrap pos context popValue =:: arg2?
    arg2? optional.isEmpty if return end
    arg2? .data =:: arg2
    argType optional.wrap pos context popValue =:: arg1?
    arg1? optional.isEmpty if return end
    arg1? .data =:: arg1
  =:: mut: newOps
  ## TODO check if first argument caches any variables, if not reuse same register(s)
  argType switch
    EMPTY case break
    I8 I16 I32 I64 PTR F32 F64 case
      newOps
        argType isIntValType and
            opType AMD64.fixedTargetInt =:: target?
            target? optional.hasData if
          target? .data argType setRegType
        else
          argType opIndex context nextRegister
        end =:: targetRegister
        opType
          targetRegister asm.Operand .register
          arg1 .location switch ## TODO? extract for procedure
            register case arg1 .location .register asm.Operand .register break
            memory case context [] .stack .length asm.Operand .stackData break
            registers registerHi registerLow case ..unreachable ## wrong data-format
          end
          arg2 .location switch ## TODO? extract for procedure
            register case arg2 .location .register asm.Operand .register break
            memory case context [] .stack .length asm.Operand .stackData break
            registers registerHi registerLow case ..unreachable ## wrong data-format
          end
        context appendOp3
        ## pushValue
          argType
          targetRegister ValueLocation .register
          opIndex
          context
        pushValue
      return
    REFERENCE case
      break
    BITS128 BITS128IF BITS128FI BITS128F case
      break
  end
  newOps
    Atomic .Unknown list.append
  return
end
proc(
  Atomic list : ops
  asm.CompareType : cmpType
  ValType : argType
  FilePosition : pos
  i32 : opIndex
  CompilerContext ptr.mut : context
-> Atomic list ) =>: compileComparisonOperator
  ops
    argType optional.wrap pos context popValue =:: arg2?
    arg2? optional.isEmpty if return end
    arg2? .data =:: arg2
    argType optional.wrap pos context popValue =:: arg1?
    arg1? optional.isEmpty if return end
    arg1? .data =:: arg1
  =:: mut: newOps
  ## TODO check if first argument caches any variables, if not reuse same register(s)
  argType switch
    EMPTY case break
    I8 I16 I32 I64 PTR F32 F64 case
      newOps
        argType opIndex context nextRegister =:: targetRegister
        asm.OpType .CMP
          cmpType asm.Operand .cmpType
          targetRegister asm.Operand .register
          arg1 .location switch ## TODO? extract for procedure
            register case arg1 .location .register asm.Operand .register break
            memory case context [] .stack .length asm.Operand .stackData break
            registers registerHi registerLow case ..unreachable ## wrong data-format
          end
          arg2 .location switch ## TODO? extract for procedure
            register case arg2 .location .register asm.Operand .register break
            memory case context [] .stack .length asm.Operand .stackData break
            registers registerHi registerLow case ..unreachable ## wrong data-format
          end
        context appendOp4
        ## pushValue
          ValType .I8
          targetRegister ValueLocation .register
          opIndex
          context
        pushValue
      return
    REFERENCE case
      break
    BITS128 BITS128IF BITS128FI BITS128F case
      break
  end
  newOps
    Atomic .Unknown list.append
  return
end

proc(
  Atomic list : ops
  BuiltIn : builtIn
  Type : opType
  FilePosition : pos
  i32 : opIndex
  CompilerContext ptr.mut : context
-> Atomic list ) =>: compileBuiltIn
  using: Op asm.OpType
  using: Cmp asm.CompareType
  context [] .program =:: program
  program .errors =:: errors
  program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  opType typeContext types.getProcIn ..drop =:: inType
  inType typeContext types.compositeEltCount 0 > if
    inType 0 typeContext types.compositeGetLabel
        labelContext id.labelFlags id.FLAG_STATIC & ? if
      1:i32
    else
      0:i32
    end =:: firstArg
    inType firstArg typeContext types.compositeGetElement
  else
      opType typeContext types.getProcOut ..drop =:: outType
      outType typeContext types.compositeEltCount 0 > _if
    outType 0 typeContext types.compositeGetElement
  else
    Type .undefined
  end =:: baseType
  baseType typeContext toValType =:: baseVal
  builtIn switch
    NEG_I8 NEG_I16 NEG_I32 NEG_I64 NEG_F32 NEG_F64 case
      ops Op .NEG baseVal pos opIndex context compileUnaryOperator return
    ADD_I8 ADD_I16 ADD_I32 ADD_I64 ADD_F32 ADD_F64 case
      ops Op .ADD baseVal pos opIndex context compileBinaryOperator return
    SUB_I8 SUB_I16 SUB_I32 SUB_I64 SUB_F32 SUB_F64 C8_DIFF C16_DIFF C32_DIFF case
     ## TODO? ensure char-diff arguments are zero extended
      ops Op .SUB baseVal pos opIndex context compileBinaryOperator return
    MUL_I32 MUL_I64 MUL_F32 MUL_F64 case
      ops Op .MUL baseVal pos opIndex context compileBinaryOperator return
    DIV_I32 DIV_I64 DIV_F32 DIV_F64 case
      ops Op .DIV baseVal pos opIndex context compileBinaryOperator return
    REM_I32 REM_I64 case
      ops Op .MOD baseVal pos opIndex context compileBinaryOperator return
    UDIV_I32 UDIV_I64 case
      ops Op .UDIV baseVal pos opIndex context compileBinaryOperator return
    UMOD_I32 UMOD_I64 case
      ops Op .UMOD baseVal pos opIndex context compileBinaryOperator return
    NOT_BOOL case
      ops Op .BOOLNOT baseVal pos opIndex context compileUnaryOperator return
    FLIP_I8 FLIP_I16 FLIP_I32 FLIP_I64 case
      ops Op .BITNOT baseVal pos opIndex context compileUnaryOperator return
    AND_BOOL AND_I8 AND_I16 AND_I32 AND_I64 case
      ops Op .AND baseVal pos opIndex context compileBinaryOperator
      return
    OR_BOOL  OR_I8 OR_I16 OR_I32 OR_I64 case
      ops Op .OR baseVal pos opIndex context compileBinaryOperator
      return
    XOR_BOOL XOR_I8 XOR_I16 XOR_I32 XOR_I64 case
      ops Op .XOR baseVal pos opIndex context compileBinaryOperator
      return
    SHL_I8 SHL_I16 SHL_I32 SHL_I64 case
      ops Op .SHL baseVal pos opIndex context compileBinaryOperator
      return
    LSHR_I8 LSHR_I16 LSHR_I32 LSHR_I64 case
      ops Op .LSHR baseVal pos opIndex context compileBinaryOperator
      return
    ASHR_I8 ASHR_I16 ASHR_I32 ASHR_I64 case
      ops Op .ASHR baseVal pos opIndex context compileBinaryOperator
      return
    EQ_BOOL EQ_I8 EQ_I16 EQ_I32 EQ_I64 EQ_F32 EQ_F64 EQ_C8 EQ_C16 EQ_C32 case
      ops Cmp .EQ baseVal pos opIndex context compileComparisonOperator
      return
    NE_BOOL NE_I8 NE_I16 NE_I32 NE_I64 NE_F32 NE_F64 NE_C8 NE_C16 NE_C32 case
      ops Cmp .NE baseVal pos opIndex context compileComparisonOperator
      return
    LT_I8 LT_I16 LT_I32 LT_I64 LT_F32 LT_F64 case
      ops Cmp .LT baseVal pos opIndex context compileComparisonOperator
      return
    ULT_I8 ULT_I16 ULT_I32 ULT_I64 LT_C8 LT_C16 LT_C32 case
      ops Cmp .ULT baseVal pos opIndex context compileComparisonOperator
      return
    LE_I8 LE_I16 LE_I32 LE_I64 LE_F32 LE_F64 case
      ops Cmp .LE baseVal pos opIndex context compileComparisonOperator
      return
    ULE_I8 ULE_I16 ULE_I32 ULE_I64 LE_C8 LE_C16 LE_C32 case
      ops Cmp .ULE baseVal pos opIndex context compileComparisonOperator
      return
    GT_I8 GT_I16 GT_I32 GT_I64 GT_F32 GT_F64 case
      ops Cmp .GT baseVal pos opIndex context compileComparisonOperator
      return
    UGT_I8 UGT_I16 UGT_I32 UGT_I64 GT_C8 GT_C16 GT_C32 case
      ops Cmp .UGT baseVal pos opIndex context compileComparisonOperator
      return
    GE_I8 GE_I16 GE_I32 GE_I64 GE_F32 GE_F64 case
      ops Cmp .GE baseVal pos opIndex context compileComparisonOperator
      return
    UGE_I8 UGE_I16 UGE_I32 UGE_I64 GE_C8 GE_C16 GE_C32 case
      ops Cmp .UGE baseVal pos opIndex context compileComparisonOperator
      return
    DIV_I64I32 REM_I64I32 UDIV_I64I32 UMOD_I64I32 SHL_I64I32 LSHR_I64I32 ASHR_I64I32 case break ## TODO move to standard libray
    GET_PTR GET_PTR_MUT case
      ops
        ValType optional.empty pos context popValue =:: argValue?
        argValue? optional.isEmpty if return end
        argValue? .data =:: argValue
        baseType typeContext types.getBaseType typeContext toValType =:: eltVal
        eltVal opIndex context nextRegister =:: targetRegister
        ## TODO handle non-primitive types
        Op .LOAD
          targetRegister asm.Operand .register
          argValue .location switch ## TODO? extract for procedure
            register case argValue .location .register asm.Operand .register break
            memory case context [] .stack .length asm.Operand .stackData break
            registers registerHi registerLow case ..unreachable ## wrong data-format
          end
        context appendOp2
        targetRegister eltVal context pushRegister
      return
    SET_PTR case
      ops
        ValType .PTR optional.wrap pos context popValue =:: address?
        address? optional.isEmpty if return end
        address? .data =:: address
        baseVal optional.wrap pos context popValue =:: value?
        value? optional.isEmpty if return end
        value? .data =:: value
        Op .STORE
          ## TODO update/clear cache for values associated with pointer
          address .location switch
            register case address .location .register asm.Operand .register break
            memory case context [] .stack .length asm.Operand .stackData break
            registers registerHi registerLow case ..unreachable ## wrong data-format
          end
          value .location switch
            register case value .location .register asm.Operand .register break
            memory case context [] .stack .length asm.Operand .stackData break
            registers registerHi registerLow case ..unreachable ## wrong data-format
          end
        context appendOp2
      return
    OFFSET_PTR_I32 OFFSET_PTR_MUT_I32 OFFSET_PTR_I64 OFFSET_PTR_MUT_I64 case
      builtIn .OFFSET_PTR_I32 ?? or builtIn .OFFSET_PTR_MUT_I32 ?? if
        ValType .I32
      else
        ValType .I64
      end =:: offsetType
      ops
        offsetType optional.wrap pos context popValue =:: offset?
        baseType typeContext types.getBaseType =:: eltType
        offset? optional.isEmpty if return end
        offset? .data =:: offset
        ## TODO? use 32-bit offset if pointer size is 32-bit
        offset .location .register ?? if
          offset .location .register ValType .I64 setRegType
        else
          ValType .I64 opIndex context nextRegister
        end =:: offsetRegister
        ## extend size to 64-bits
        offsetType .I32 ?? if ## TODO? move extending of register to platform dependent code
          Op .EXTS
            offsetRegister asm.Operand .register
            offset .location switch
              register case offset .location .register asm.Operand .register break
              memory case context [] .stack .length asm.Operand .stackData break
              registers registerHi registerLow case ..unreachable ## wrong data-format
            end
          context appendOp2
        end
        ValType .PTR optional.wrap pos context popValue =:: base?
        base? optional.isEmpty if return end
        base? .data =:: address
        address .location .register ?? if
          address .location .register ValType .PTR setRegType
        else
          ValType .PTR opIndex context nextRegister
        end =:: addressRegister
        Op .OFFSET
          addressRegister asm.Operand .register
          address .location switch
            register case address .location .register asm.Operand .register break
            memory case context [] .stack .length asm.Operand .stackData break
            registers registerHi registerLow case ..unreachable ## wrong data-format
          end
          offsetRegister asm.Operand .register
          eltType typeContext types.strideOf .fixed asm.Operand .constInt
        context appendOp4
        addressRegister ValType .PTR context pushRegister
      return
    default break
  end
  ops
    Atomic .Unknown list.append
  return
end

proc(
  Atomic list : ops
  Operation ptr : op
  i32 : opIndex
  CompilerContext ptr.mut : context
-> Atomic list ) =>: compileOp
  context [] .program =:: program
  program .errors =:: errors
  program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  ops
    op .val .implementProcedure ?? if
      true context .reachable=
      op .val [] .implementProcedure =:: implInfo
      op [] .dataType =:: procType
      program [] .procedures
        implInfo .procId i64 cast list.at .data
      =:: procInfo
      context resetRegisters
      op [] Atomic .DebugStartOp list.append
      asm.OpType .LABEL
        procInfo [] .labelId asm.Operand .globalLabel
      context appendOp1
      implInfo Atomic .StartProc list.append
      ## TODO setup procedure memory
      ##   -> stackMemory int,float,v128
      ##   -> localVariables
      ##   -> memory for named arguments passed in registers
      procType typeContext types.getProcIn ..drop =:: inType
      inType typeContext types.compositeElts =:: args
      0 =:: mut: intArgs
      0 =:: mut: floatArgs
      ## TODO? is there a way to avoid having two loops (registers are counted right to left, arguments are pushed left ot right)
      ## count argument types
      args .length 1 - i32 cast while $ 0 >= do =:: i
        args i slice.get =:: argType
        argType typeContext types.isEmpty or
            inType i typeContext types.compositeGetLabel labelContext id.labelFlags id.FLAG_STATIC & ? if
          continue ## skip empty arguments
        end
        argType typeContext toValType =:: valType
        valType isFloatValType if
          floatArgs 1 + floatArgs=
        else
          intArgs 1 + intArgs=
        end
      finally i 1 - end ..drop
      ## go through arguments from left to right (to have push statements in correct order)
      0 while $ args .length i32 cast < do =:: i
        inType i typeContext types.compositeGetLabel =:: label
        args i slice.get =:: argType
        argType typeContext types.isEmpty or label labelContext id.labelFlags id.FLAG_STATIC & ? if
          continue ## skip empty arguments
        end
        argType typeContext toValType =:: valType
        ## registers are counted from left to right (-> decrement max-count when parsing left to right)
        valType isFloatValType if
          floatArgs 1 - floatArgs=
          floatArgs AMD64.getFloatArgumentRegister
        else
          intArgs 1 - intArgs=
          intArgs AMD64.getIntArgumentRegister
        end valType setRegType =:: argRegister
        label id.LABEL_ID_NONE == if ## push argument
          argRegister NO_REG == if
            valType isFloatValType if
              valType floatArgs ValueLocation .floatArgument
            else
              valType intArgs ValueLocation .intArgument
            end opIndex context pushValue
          else
            valType argRegister ValueLocation .register opIndex context pushValue
          end
        else
          argRegister NO_REG != if
            asm.OpType .STORE
              label asm.Operand .localMemory
              argRegister asm.Operand .register
            context appendOp2
            label argRegister opIndex context cacheVariable
          end
          ## TODO? set variable memory location to argument memory
        end
      finally i 1 + end ..drop
      procInfo [] .implementation .code ?? ! if
        "unexpected procedure implementation" sb.copyPtr
        op [] .pos errors appendError
        return
      end
      return
    end
    context [] .reachable ! and op [] .val .block ?? ! and op [] .val .blockEnd ?? ! if
      return ## skip unreachable statements
    end
    op [] Atomic .DebugStartOp list.append
    op [] .val switch
      Constant case
        op [] .dataType typeContext types.isPointer if
          op [] .dataType op [] .val .Constant context newPtrConstant =:: ptrId
          ValType .PTR ptrId ValueLocation .ptrConstant opIndex context pushValue
          return
        end
        op [] .dataType typeContext toValType =:: valType
        ## FIXME use value-type to determine target type, truncate intergers to correct size
        ## TODO make operation dependent on value type
        ## TODO extract conversion constant -> location to procedure
        op [] .val .Constant switch
          Int case
            valType op [] .val .Constant .Int ValueLocation .intConstant opIndex context pushValue
            return
          Char case
            valType op [] .val .Constant .Char i64 cast.u ValueLocation .intConstant opIndex context pushValue
            return
          Bool case
            valType op [] .val .Constant .Bool ?1 i64 cast.u ValueLocation .intConstant opIndex context pushValue
            return
          EnumLabel case
            valType op [] .val .Constant .EnumLabel i64 cast.u ValueLocation .intConstant opIndex context pushValue
            return
          Float case
            valType op [] .val .Constant .Float ValueLocation .floatConstant opIndex context pushValue
            return
          default break ## TODO support other constant types
        end
        break
      NewEnum case
        op [] .dataType typeContext toValType =:: valType
        op [] .dataType typeContext types.isEnum if
          valType op [] .val .NewEnum i64 cast.s ValueLocation .intConstant opIndex context pushValue
          return
        end
        break
      declareId case return ## nothing to do (all declarations handled at start of procedure)
      getId case
        op .val .getId =:: idData
        idData [] .labelId =:: labelId
        idData [] .idType switch
          ARGUMENT LOCAL_VAR ITR_VAR TMP_VAR GLOBAL_VAR case
            labelId idData [] .idType .GLOBAL_VAR ?? context getVarLocation =:: variableLocation
            op [] .dataType typeContext toValType
              variableLocation
            opIndex context pushValue
            return
          PROCEDURE case break
          TYPE LABEL PROCEDURE_BUNDLE case
            "unexpected id-type" sb.copyPtr
              ## TODO print id-type
            op [] .pos errors appendError
            break
        end
        break
      atId case
        op .val .atId =:: idData
        idData [] .labelId =:: labelId
        idData [] .idType switch
          ARGUMENT LOCAL_VAR ITR_VAR TMP_VAR GLOBAL_VAR case
            ## TODO! link pointer to variable location, writes to pointer modify variable
            labelId context removeCachedVar
            ValType .PTR
              labelId idData [] .idType .GLOBAL_VAR ?? if ValueLocation .globalAddr else ValueLocation .localAddr end
            opIndex context pushValue
            return
          PROCEDURE case break
          TYPE LABEL PROCEDURE_BUNDLE case
            "unexpected id-type" sb.copyPtr
              ## TODO print id-type
            op [] .pos errors appendError
            break
        end
        break
      setId initializeId case
        op .val .setId ?? if
          op .val .setId
        else
          op .val .initializeId
        end =:: idData
        idData [] .labelId =:: labelId
        ## TODO invaidate previous cached values
        idData [] .idType switch
          ARGUMENT LOCAL_VAR ITR_VAR TMP_VAR case
            op [] .dataType typeContext toValType =:: valType
            valType optional.wrap op [] .pos context popValue =:: stackValue?
            stackValue? optional.isEmpty if return end
            stackValue? .data =:: stackValue
            stackValue .location switch
              register case
                asm.OpType .STORE
                  labelId asm.Operand .localMemory
                  stackValue .location .register asm.Operand .register
                context appendOp2
                labelId stackValue .location .register opIndex context cacheVariable
                return
              registers case
                ## TODO store to memory
                labelId stackValue .location .registers opIndex context cacheVariable2
                break
              registerHi registerLow case
                "unimplemented" ..panic
              memory case
                valType opIndex context nextRegister =:: tmpRegister
                asm.OpType .LOAD
                  tmpRegister asm.Operand .register
                  ## TODO use correct memory location (? `context [] .stackIntCount`)
                  context [] .stack .length asm.Operand .stackData
                context appendOp2
                asm.OpType .STORE
                  labelId asm.Operand .localMemory
                  tmpRegister asm.Operand .register
                context appendOp2
                labelId tmpRegister opIndex context cacheVariable
                return
            end
            break
          PROCEDURE GLOBAL_VAR case break
          TYPE LABEL PROCEDURE_BUNDLE case
            "unexpected id-type" sb.copyPtr
              ## TODO print id-type
            op [] .pos errors appendError
            break
        end
        break
      autoCast case
        ## compileCast
          CastType .autoCast
          SignType .NONE
          op [] .val .autoCast .src
          op [] .val .autoCast .offset
          op [] .dataType
          opIndex
          op [] .pos
          context
        compileCast return
      Cast Cast! bitCast case
        ## compileCast
          op [] .val .Cast ?? if
            CastType .Cast
            op [] .val .Cast .signType
            op [] .val .Cast .src
          else op [] .val .bitCast ?? _if
            CastType .bitCast
            SignType .UNSIGNED
            op [] .val .bitCast
          else
            CastType .Cast!
            SignType .NONE ## XXX? use sign information for forced cast
            op [] .val .Cast!
          end
          0 ## no offset
          op [] .dataType
          opIndex
          op [] .pos
          context
        compileCast return
        break
      builtIn case
        ## compileBuiltIn
          op [] .val .builtIn
          op [] .dataType
          op [] .pos
          opIndex
          context
        compileBuiltIn
        return
      block case
        op [] .val .block .blockType switch
          AND_IF OR_IF case
            op [] .val .block .blockType .OR_IF ?? =:: isOr
            context [] .openBlocks list.peek =:: ifBlock?
            ifBlock? optional.isEmpty or ifBlock? .data [] .If ?? ! or ifBlock? .data .If [] .hasIf if
              op [] .val .block .blockId context openIfBlock
            else
              ifBlock? .data .If
            end =:: ifBlock
            context [] .reachable ! if return end
            ValType .I8 optional.wrap op [] .pos context popValue =:: srcValue?
            srcValue? optional.isEmpty if
              "stack underflow in if-condition" sb.copyPtr op [] .pos errors appendError
              return
            end
            srcValue? .data =:: srcValue
            isOr if
              ifBlock [] .ifLabelId NO_LABEL == if
                context nextLabelId ifBlock .ifLabelId=
                ifBlock [] .regData ifBlock [] .ifStartRegsOffset slice.tail context rememberRegisters
                ifBlock [] .ifStackSize -1 == if
                  context .stack [] .length ifBlock .ifStackSize=
                else
                  context .stack [] .length ifBlock [] .ifStackSize == "CodeGen: consistent stack size at if" assert
                end
              else
                ifBlock [] .regData ifBlock [] .ifStartRegsOffset slice.tail
                  ifBlock [] .ifStackSize
                  RegisterRestoreMode .MERGE_FALLTHROUGH
                op [] .pos context restoreRegisters
              end
            else ifBlock [] .elseLabelId NO_LABEL == _if
              context nextLabelId ifBlock .elseLabelId=
              ifBlock [] .regData context rememberRegisters
              ifBlock [] .ifStackSize -1 == if
                context .stack [] .length ifBlock .ifStackSize=
              else
                context .stack [] .length ifBlock [] .ifStackSize == "CodeGen: consistent stack size at if" assert
              end
            else
              ifBlock [] .regData
                ifBlock [] .ifStackSize
                RegisterRestoreMode .MERGE_FALLTHROUGH
              op [] .pos context restoreRegisters
            end
            asm.OpType .JMPIF
              isOr if
                asm.CompareType .NZ
              else
                asm.CompareType .Z
              end asm.Operand .cmpType
              srcValue .location switch
                register case
                    srcValue .location .register asm.Operand .register
                  break
                memory case ## TODO is this the right offset
                    context [] .stack .length 1 + asm.Operand .stackData
                  break
                registers registerHi registerLow case "unexpected format for condition parameter" ..panic
              end
              isOr if
                ifBlock [] .ifLabelId asm.Operand .localLabel
              else
                ifBlock [] .elseLabelId asm.Operand .localLabel
              end
            context appendOp3
            return
          IF case
            context [] .openBlocks list.peek =:: ifBlock?
            ifBlock? optional.isEmpty or ifBlock? .data [] .If ?? ! or ifBlock? .data .If [] .hasIf if
              op [] .val .block .blockId context openIfBlock
            else
              ifBlock? .data .If
            end =:: ifBlock
            true ifBlock .hasIf=
            context [] .reachable ! if return end
            ValType .I8 optional.wrap op [] .pos context popValue =:: srcValue?
            srcValue? optional.isEmpty if
              "stack underflow in if-condition" sb.copyPtr op [] .pos errors appendError
              return
            end
            srcValue? .data =:: srcValue
            ifBlock [] .elseLabelId NO_LABEL == if
              ifBlock [] .regData context rememberRegisters
              ifBlock [] .ifStackSize -1 == if
                context .stack [] .length ifBlock .ifStackSize=
              else
                context .stack [] .length ifBlock [] .ifStackSize == "CodeGen: consistent stack size at if" assert
              end
              context nextLabelId
              $ ifBlock .elseLabelId=
            else
              ifBlock [] .regData
                ifBlock [] .ifStackSize
                RegisterRestoreMode .MERGE_FALLTHROUGH
              op [] .pos context restoreRegisters
              ifBlock [] .elseLabelId
            end =:: elseLabelId
            asm.OpType .JMPIF
              asm.CompareType .Z asm.Operand .cmpType
              srcValue .location switch
                register case
                    srcValue .location .register asm.Operand .register
                  break
                memory case ## TODO is this the right offset
                    context [] .stack .length 1 + asm.Operand .stackData
                  break
                registers registerHi registerLow case "unexpected format for condition parameter" ..panic
              end
              elseLabelId asm.Operand .localLabel
            context appendOp3
            ifBlock [] .ifLabelId NO_LABEL != if
              ifBlock [] .regData ifBlock [] .ifStartRegsOffset slice.tail
                ifBlock [] .ifStackSize
                RegisterRestoreMode .RESET
              op [] .pos context restoreRegisters
              asm.OpType .LABEL
                ifBlock [] .ifLabelId asm.Operand .localLabel
              context appendOp1
            end
            return
          ELSE case
            context [] .openBlocks list.peek =:: ifBlock?
            ifBlock? optional.isEmpty or ifBlock? .data [] .If ?? ! if
              "unexpected else-statement" sb.copyPtr op [] .pos errors appendError
              return
            end
            ifBlock? .data .If =:: ifBlock
            context [] .reachable if
              context nextLabelId =:: endLabelId
              endLabelId ifBlock .endLabelId=
              ## TODO? merge registers instead of resetting to state at end of if branch
              ifBlock [] .regData ifBlock [] .elseRegsOffset slice.tail context rememberRegisters
              context .stack [] .length ifBlock .endStackSize=
              asm.OpType .JMP
                endLabelId asm.Operand .localLabel
              context appendOp1
            end
            ifBlock [] .elseLabelId NO_LABEL != if
              asm.OpType .LABEL
                ifBlock [] .elseLabelId asm.Operand .localLabel
              context appendOp1
              ifBlock [] .regData
                ifBlock [] .ifStackSize
                RegisterRestoreMode .RESET
              op [] .pos context restoreRegisters
              true context .reachable=
            else
              false context .reachable=
            end
            return
          WHILE case
            context nextLabelId =:: startLabelId
            op [] .val .block .blockId startLabelId context openWhileBlock =:: whileBlock
            context [] .reachable ! if return end
            whileBlock [] .regData context rememberRegisters
            context .stack [] .length whileBlock .whileStackSize=
            asm.OpType .LABEL
              startLabelId asm.Operand .localLabel
            context appendOp1
            return
          AND_DO OR_DO case
            op [] .val .block .blockType .OR_DO ?? =:: isOr
            context [] .openBlocks list.peek =:: whileBlock?
            whileBlock? optional.isEmpty or whileBlock? .data [] .While ?? ! if
              "unexpected and/or-do-statement" sb.copyPtr op [] .pos errors appendError
              return
            end
            context [] .reachable ! if return end
            whileBlock? .data .While =:: whileBlock
            ValType .I8 optional.wrap op [] .pos context popValue =:: srcValue?
            srcValue? optional.isEmpty if
              "stack underflow in do-condition" sb.copyPtr op [] .pos errors appendError
              return
            end
            srcValue? .data =:: srcValue
            isOr if
              whileBlock [] .doLabelId NO_LABEL == if
                context nextLabelId whileBlock .doLabelId=
                whileBlock [] .regData whileBlock [] .doRegsOffset slice.tail context rememberRegisters
                context .stack [] .length whileBlock .doStackSize=
              else
                whileBlock [] .regData whileBlock [] .doRegsOffset slice.tail
                  whileBlock [] .doStackSize
                  RegisterRestoreMode .MERGE_FALLTHROUGH
                op [] .pos context restoreRegisters
              end
            else
              whileBlock [] .endLabelId NO_LABEL == if
                context nextLabelId whileBlock .endLabelId=
                whileBlock [] .regData whileBlock [] .breakRegsOffset slice.tail context rememberRegisters
                context .stack [] .length whileBlock .endStackSize=
              else
                whileBlock [] .regData whileBlock [] .breakRegsOffset slice.tail
                  whileBlock [] .endStackSize
                  RegisterRestoreMode .MERGE_FALLTHROUGH
                op [] .pos context restoreRegisters
              end
            end
            asm.OpType .JMPIF
              isOr if asm.CompareType .NZ else asm.CompareType .Z end asm.Operand .cmpType
              srcValue .location switch
                register case
                    srcValue .location .register asm.Operand .register
                  break
                memory case ## TODO is this the right offset
                    context [] .stack .length 1 + asm.Operand .stackData
                  break
                registers registerHi registerLow case "unexpected format for condition parameter" ..panic
              end
              isOr if
                whileBlock [] .doLabelId
              else
                whileBlock [] .endLabelId
              end asm.Operand .localLabel
            context appendOp3
            return
          DO case
            context [] .openBlocks list.peek =:: whileBlock?
            whileBlock? optional.isEmpty or whileBlock? .data [] .While ?? ! if
              "unexpected do-statement" sb.copyPtr op [] .pos errors appendError
              return
            end
            context [] .reachable ! if return end
            whileBlock? .data .While =:: whileBlock
            ValType .I8 optional.wrap op [] .pos context popValue =:: srcValue?
            srcValue? optional.isEmpty if
              "stack underflow in do-condition" sb.copyPtr op [] .pos errors appendError
              return
            end
            srcValue? .data =:: srcValue
            whileBlock [] .endLabelId NO_LABEL == if
              context nextLabelId whileBlock .endLabelId=
              whileBlock [] .regData whileBlock [] .breakRegsOffset slice.tail context rememberRegisters
              context .stack [] .length whileBlock .endStackSize=
            else
              whileBlock [] .regData whileBlock [] .breakRegsOffset slice.tail
                whileBlock [] .endStackSize
                RegisterRestoreMode .MERGE_FALLTHROUGH
              op [] .pos context restoreRegisters
            end
            asm.OpType .JMPIF
              asm.CompareType .Z asm.Operand .cmpType
              srcValue .location switch
                register case
                    srcValue .location .register asm.Operand .register
                  break
                memory case ## TODO is this the right offset
                    context [] .stack .length 1 + asm.Operand .stackData
                  break
                registers registerHi registerLow case "unexpected format for condition parameter" ..panic
              end
              whileBlock [] .endLabelId asm.Operand .localLabel
            context appendOp3
            whileBlock [] .doLabelId NO_LABEL != if ## create do label only if it is used
              whileBlock [] .regData whileBlock [] .doRegsOffset slice.tail
                whileBlock [] .doStackSize
                RegisterRestoreMode .MERGE_FALLTHROUGH
              op [] .pos context restoreRegisters
              asm.OpType .LABEL
                whileBlock [] .doLabelId asm.Operand .localLabel
              context appendOp1
            end
            return
          BREAK case
            op [] .val .block .blockId
              BreakType .WHILE
            context findBreakableBlock =:: whileBlock?
            whileBlock? optional.isEmpty or whileBlock? .data [] .While ?? ! if
              "unexpected break-statement" sb.copyPtr op [] .pos errors appendError
              return
            end
            context [] .reachable ! if return end
            whileBlock? .data .While =:: whileBlock
            whileBlock [] .endLabelId NO_LABEL == if
              context nextLabelId whileBlock .endLabelId=
              whileBlock [] .regData whileBlock [] .breakRegsOffset slice.tail context rememberRegisters
              context .stack [] .length whileBlock .endStackSize=
            else
              whileBlock [] .regData whileBlock [] .breakRegsOffset slice.tail
                whileBlock [] .endStackSize
                RegisterRestoreMode .MERGE
              op [] .pos context restoreRegisters
            end
            asm.OpType .JMP
              whileBlock [] .endLabelId asm.Operand .localLabel
            context appendOp1
            false context .reachable=
            return
          CONTINUE case
            op [] .val .block .blockId
              BreakType .WHILE
            context findBreakableBlock =:: whileBlock?
            whileBlock? optional.isEmpty or whileBlock? .data [] .While ?? ! if
              "unexpected continue-statement" sb.copyPtr op [] .pos errors appendError
              return
            end
            context [] .reachable ! if return end
            whileBlock? .data .While =:: whileBlock
            whileBlock [] .finallyLabelId NO_LABEL == if
              context nextLabelId whileBlock .finallyLabelId=
              whileBlock [] .regData whileBlock [] .continueRegsOffset slice.tail context rememberRegisters
              context .stack [] .length whileBlock .continueStackSize=
            else
              whileBlock [] .regData whileBlock [] .continueRegsOffset slice.tail
                whileBlock [] .continueStackSize
                RegisterRestoreMode .MERGE
              op [] .pos context restoreRegisters
            end
            asm.OpType .JMP
              whileBlock [] .finallyLabelId asm.Operand .localLabel
            context appendOp1
            false context .reachable=
            return
          FINALLY case
            context [] .openBlocks list.peek =:: whileBlock?
            whileBlock? optional.isEmpty or whileBlock? .data [] .While ?? ! if
              "unexpected finally-statement" sb.copyPtr op [] .pos errors appendError
              return
            end
            whileBlock? .data .While =:: whileBlock
            whileBlock [] .finallyLabelId NO_LABEL != if ## create finally label only if it is used
              true context .reachable= ## finally is reachable through continue
              ## TODO? merge branches instead of resetting to first branch
              whileBlock [] .regData whileBlock [] .continueRegsOffset slice.tail
                whileBlock [] .continueStackSize
                RegisterRestoreMode .MERGE
              op [] .pos context restoreRegisters
              asm.OpType .LABEL
                whileBlock [] .finallyLabelId asm.Operand .localLabel
              context appendOp1
            end
            return
          break
          AND OR case
            op [] .val .block .blockType .OR ?? =:: isOr
            context [] .openBlocks list.peek =:: andOrBlock?
            andOrBlock? optional.isEmpty or andOrBlock? .data [] .AndOr ?? ! if
              op [] .val .block .blockId context openAndOrBlock
            else
              andOrBlock? .data .AndOr
            end =:: andOrBlock
            context [] .reachable ! if return end
            ## remember state before popping condition to preverse bool on top of stack
            andOrBlock [] .endLabelId NO_LABEL == if
              context nextLabelId andOrBlock .endLabelId=
              andOrBlock [] .regData context rememberRegisters
              andOrBlock [] .endStackSize -1 == if
                context .stack [] .length andOrBlock .endStackSize=
              else
                context .stack [] .length andOrBlock [] .endStackSize == "CodeGen: consistent stack size at and/or" assert
              end
            else
              andOrBlock [] .regData
                andOrBlock [] .endStackSize
                RegisterRestoreMode .MERGE_FALLTHROUGH
              op [] .pos context restoreRegisters
            end
            ValType .I8 optional.wrap op [] .pos context popValue =:: srcValue?
            srcValue? optional.isEmpty if
              "stack underflow in if-condition" sb.copyPtr op [] .pos errors appendError
              return
            end
            srcValue? .data =:: srcValue
            asm.OpType .JMPIF
              isOr if
                asm.CompareType .NZ
              else
                asm.CompareType .Z
              end asm.Operand .cmpType
              srcValue .location switch
                register case
                    srcValue .location .register asm.Operand .register
                  break
                memory case ## TODO is this the right offset
                    context [] .stack .length 1 + asm.Operand .stackData
                  break
                registers registerHi registerLow case "unexpected format for condition parameter" ..panic
              end
              andOrBlock [] .endLabelId asm.Operand .localLabel
            context appendOp3
            return
          SWITCH case
            program [] .switchData op [] .val .block .blockId i32 cast.u list.at .data =:: switchData
            op [] .val .block .blockId switchData [] .caseCount context openSwitchBlock =:: switchBlock
            context [] .reachable ! if return end
            ValType optional.empty op [] .pos context popValue =:: srcValue?
            srcValue? optional.isEmpty if
              "stack underflow in switch" sb.copyPtr op [] .pos errors appendError
              return
            end
            srcValue? .data =:: srcValue
            srcValue .valType switch
              I8 I16 I32 I64 case false break ## switchable
              default true break
            end if
              "cannot switch values of type: " sb.copyPtr
                srcValue .valType sb.appendValType
              op [] .pos errors appendError
              return
            end
            switchData [] .caseCount 1 + for =:: i
              context nextLabelId switchBlock [] .caseLabelIds i =[]
            end
            switchBlock [] .regData context rememberRegisters
            context .stack [] .length switchBlock .switchStackSize=
            srcValue switchBlock switchData context generateSwitchTable
            false context .reachable=
            return
          CASE DEFAULT case
            context [] .reachable if
              "case-label is reachable" sb.copyPtr op [] .pos errors appendError
            end
            context [] .openBlocks list.peek =:: switchBlock?
            switchBlock? optional.isEmpty or switchBlock? .data [] .Switch ?? ! if
              "unexpected case/default-statement" sb.copyPtr op [] .pos errors appendError
              return
            end
            switchBlock? .data .Switch =:: switchBlock
            op [] .val .block .blockType .CASE ?? if
              switchBlock [] .caseIndex
              switchBlock [] .caseIndex 1 + switchBlock .caseIndex=
            else
              switchBlock [] .caseLabelIds .length 1 - i32 cast
            end =:: caseId
            switchBlock [] .caseLabelIds caseId [] =:: caseLabel
            caseLabel NO_LABEL == if return end
            asm.OpType .LABEL
              caseLabel asm.Operand .localLabel
            context appendOp1
            switchBlock [] .regData
              switchBlock [] .switchStackSize
              RegisterRestoreMode .RESET
            op [] .pos context restoreRegisters
            true context .reachable=
            return
          BREAK_SWITCH case
            op [] .val .block .blockId
              BreakType .SWITCH
            context findBreakableBlock =:: switchBlock?
            switchBlock? optional.isEmpty or switchBlock? .data [] .Switch ?? ! if
              "unexpected break-statement" sb.copyPtr op [] .pos errors appendError
              return
            end
            context [] .reachable ! if return end
            switchBlock? .data .Switch =:: switchBlock
            switchBlock [] .endLabelId NO_LABEL == if
              context nextLabelId switchBlock .endLabelId=
              switchBlock [] .regData switchBlock [] .endRegsOffset slice.tail context rememberRegisters
              context .stack [] .length switchBlock .endStackSize=
            else
              switchBlock [] .regData switchBlock [] .endRegsOffset slice.tail
                switchBlock [] .endStackSize
                RegisterRestoreMode .MERGE
              op [] .pos context restoreRegisters
            end
            asm.OpType .JMP
              switchBlock [] .endLabelId asm.Operand .localLabel
            context appendOp1
            false context .reachable=
            return
          default break
        end
        break
      blockEnd case
        op [] .val .blockEnd .blockType switch
          ELSE case
            context [] .openBlocks list.peek =:: ifBlock?
            ifBlock? optional.isEmpty or ifBlock? .data [] .If ?? ! if
              "unexpected end of if block" sb.copyPtr op [] .pos errors appendError
              return
            end
            context [] .openBlocks
              list.pop .If =:: ifBlock
            context .openBlocks=
            ifBlock .endLabelId NO_LABEL != if ## jump to end reachable
              ## restoreRegisters
                ifBlock .regData ifBlock .elseRegsOffset slice.tail
                ifBlock .endStackSize
                RegisterRestoreMode .MERGE
              op [] .pos context restoreRegisters
              asm.OpType .LABEL
                ifBlock .endLabelId asm.Operand .localLabel
              context appendOp1
              true context .reachable=
            end
            ifBlock .regData .data mem.free
            return
          WHILE case
            context [] .openBlocks list.peek =:: whileBlock?
            whileBlock? optional.isEmpty or whileBlock? .data [] .While ?? ! if
              "unexpected end of while block" sb.copyPtr op [] .pos errors appendError
              return
            end
            context [] .openBlocks
              list.pop .While =:: whileBlock
            context .openBlocks=
            context [] .reachable if
              whileBlock .regData
                whileBlock .whileStackSize
                RegisterRestoreMode .MERGE
              op [] .pos context restoreRegisters
              asm.OpType .JMP
                whileBlock .startLabelId asm.Operand .localLabel
              context appendOp1
            end
            whileBlock .endLabelId NO_LABEL != if ## end of loop reachable
              asm.OpType .LABEL
                whileBlock .endLabelId asm.Operand .localLabel
              context appendOp1
              ## restoreRegisters
                whileBlock .regData whileBlock .breakRegsOffset slice.tail
                whileBlock .endStackSize
                RegisterRestoreMode .RESET
              op [] .pos context restoreRegisters
              true context .reachable=
            end
            whileBlock .regData .data mem.free
          return
          AND OR case
            context [] .openBlocks list.peek =:: andOrBlock?
            andOrBlock? optional.isEmpty or andOrBlock? .data [] .AndOr ?? ! if
              "unexpected end of and/or block" sb.copyPtr op [] .pos errors appendError
              return
            end
            context [] .openBlocks
              list.pop .AndOr =:: andOrBlock
            context .openBlocks=
            andOrBlock .endLabelId NO_LABEL != if ## end of loop reachable
              ## restoreRegisters
                andOrBlock .regData
                andOrBlock .endStackSize
                RegisterRestoreMode .MERGE
              op [] .pos context restoreRegisters
              asm.OpType .LABEL
                andOrBlock .endLabelId asm.Operand .localLabel
              context appendOp1
              true context .reachable=
            end
            andOrBlock .regData .data mem.free
            return
          SWITCH case
            context [] .openBlocks list.peek =:: switchBlock?
            switchBlock? optional.isEmpty or switchBlock? .data [] .Switch ?? ! if
              "unexpected end of switch block" sb.copyPtr op [] .pos errors appendError
              return
            end
            context [] .openBlocks
              list.pop .Switch =:: switchBlock
            context .openBlocks=
            switchBlock .endLabelId NO_LABEL != if ## jump to end reachable
              ## restoreRegisters
                switchBlock .regData switchBlock .endRegsOffset slice.tail
                switchBlock .endStackSize
                RegisterRestoreMode .RESET
              op [] .pos context restoreRegisters
              asm.OpType .LABEL
                switchBlock .endLabelId asm.Operand .localLabel
              context appendOp1
              true context .reachable=
            end
            switchBlock .regData .data mem.free
            return
          PROCEDURE case
            context [] .procTail list.appendAll
            context [] .procTail list.clear context .procTail=
            Atomic .EndProc list.append return
          default break
        end
        break
      call callPtr case
        op [] .dataType =:: procType
        op [] .val .callPtr ?? if
          "unimplemented" ..panic ## TODO handle call by pointer
          ## ? move proc-pointer to special register
        end
        RegisterState MAX_DATA_REGISTERS array : argRegBuffer
        RegisterState MAX_DATA_REGISTERS array : retRegBuffer
        ## computeReturnLocations
          procType
          context .argBuffer
          argRegBuffer@
          retRegBuffer@
          opIndex
          context .stack [] .length
        typeContext AMD64.computeArgumentLocations =:: argData =:: retData =:: argLocations
        ## TODO handle arguments passed in memory
        ## TODO! clear cached values for mutable pointer arguments
        argData context .stack [] .length i32 cast RegisterRestoreMode .MERGE_FALLTHROUGH op [] .pos context restoreRegisters
        asm.OpType .CALL
          op [] .val .callPtr ?? if
            "unimplemented" ..panic ## TODO use call pointer
          else
            program [] .procedures op [] .val .call .procId i64 cast @[] .labelId [] asm.Operand .globalLabel
          end
        context appendOp1
        ## TODO? compute new stack size in computeArgumentLocations
        procType typeContext types.getProcIn  ..drop typeContext types.compositeEltCount =:: inCount
        procType typeContext types.getProcOut ..drop =:: outType
        outType typeContext types.compositeEltCount =:: outCount
        retData context .stack [] .length i32 cast inCount - outCount + RegisterRestoreMode .RESET op [] .pos context restoreRegisters
        ## update stack-type of return values
        context .stack [] .length outCount - =:: retOffset
        outCount for =:: i
          outType i typeContext types.compositeGetElement =:: elt
          elt typeContext toValType context [] .stack retOffset i + @[] .valType=
        end
        return
      Return case
        ## TODO? procOut or procRet
        op [] .dataType typeContext types.getProcOut ! "procedure has return type" assert =:: retType
        RegisterState MAX_DATA_REGISTERS array : regBuffer
        ## computeReturnLocations
          retType
          context .argBuffer
          regBuffer@
        typeContext AMD64.computeReturnLocations =:: regData =:: retLocations
        context .variableLocations map.clear ## var-locations do not matter after return
        ## 1. go through registers, move memory return values from registers to memory
        context [] .dataRegisters slice.atItrMut for =:: reg
          reg [] .currentValue switch
            empty forceClear preserveValue case continue
            variable case RegisterContent .empty reg .currentValue= break
            stackSlot case
              reg [] .currentValue .stackSlot =:: stackPosition
              stackPosition i64 cast.u retLocations .length >= if
                "return: stack out of sync" sb.copyPtr
                op [] .pos errors appendError
                continue
              end
              retLocations stackPosition [] =:: targetLocation
              ## TODO handle different location types
              targetLocation switch
                argInt case targetLocation .argInt AMD64.getIntReturnRegister NO_REG == if
                  ## TODO move value to return memory
                  "unimplemented" ..panic
                end break
                argFloat case targetLocation .argFloat AMD64.getFloatReturnRegister NO_REG == if
                  ## TODO move value to return memory
                  "unimplemented" ..panic
                end break
                default "unimplemented" ..panic
              end
              break
            stackSlotHi stackSlotLow case "unimplemented" ..panic
          end
        end
        ## 2. copy remaining memory return values using free register (there should be at least one free register after previous step)
        ## TODO copy memory return values (ensure only valid target resisters are soted in registers)
        ## 3. move remaining registers to correct location
        ## TODO? own return mode
        regData retLocations .length i32 cast RegisterRestoreMode .MERGE op [] .pos context restoreRegisters
        Atomic .LeaveProc list.append
        asm.OpType .RET context appendOp0
        false context .reachable=
        return
      panicWithMessage case
        context nextLabelId =:: targetLabelId
        asm.OpType .JMP
          targetLabelId asm.Operand .localLabel
        context appendOp1
        context [] .procTail
          asm.OpType .LABEL
            targetLabelId asm.Operand .localLabel
          context appendOp1
          op [] Atomic .DebugStartOp list.append
          Type .undefined op .val [] .panicWithMessage constContext newStringConst context newPtrConstant =:: strId
          asm.OpType .MOVE
            0 AMD64.getIntArgumentRegister ValType .PTR setRegType asm.Operand .register
            strId asm.Operand .constPtr
          context appendOp2
          asm.OpType .MOVE
            1 AMD64.getIntArgumentRegister asm.Operand .register
            op .val [] .panicWithMessage .length asm.Operand .constInt
          context appendOp2
          ## TODO? add argument for pointer to file position ( char8 _ ptr : nameData i64 : nameLen i32 : line i32 : linePos )
          RuntimeErrorType .Panic Atomic .Error list.append
        context .procTail=
        false context .reachable=
        return
      RuntimeAssert case
        ValType .I8 optional.wrap op [] .pos context popValue =:: srcValue?
        srcValue? optional.isEmpty if
          "stack underflow in assert-condition" sb.copyPtr op [] .pos errors appendError
          return
        end
        context nextLabelId =:: targetLabelId
        srcValue? .data =:: srcValue
        asm.OpType .JMPIF
          asm.CompareType .Z asm.Operand .cmpType
          srcValue .location switch
            register case
                srcValue .location .register asm.Operand .register
              break
            memory case ## TODO is this the right offset
                context [] .stack .length 1 + asm.Operand .stackData
              break
            registers registerHi registerLow case "unexpected format for condition parameter" ..panic
          end
          targetLabelId asm.Operand .localLabel
        context appendOp3
        context [] .procTail
          asm.OpType .LABEL
            targetLabelId asm.Operand .localLabel
          context appendOp1
          op [] Atomic .DebugStartOp list.append
          Type .undefined op .val [] .RuntimeAssert constContext newStringConst context newPtrConstant =:: strId
          asm.OpType .MOVE
            0 AMD64.getIntArgumentRegister ValType .PTR setRegType asm.Operand .register
            strId asm.Operand .constPtr
          context appendOp2
          asm.OpType .MOVE
            1 AMD64.getIntArgumentRegister asm.Operand .register
            op .val [] .RuntimeAssert .length asm.Operand .constInt
          context appendOp2
          ## TODO? add argument for pointer to file position ( char8 _ ptr : nameData i64 : nameLen i32 : line i32 : linePos )
          RuntimeErrorType .AssertFail Atomic .Error list.append
        context .procTail=
        return
      stackMod case
        op [] .val .stackMod .modType switch
          DROP case
            op [] .val .stackMod .n =:: count
            context [] .stack .length count < if
              "CodeGen: stack underflow in drop, stackSize: " sb.copyPtr
                context [] .stack .length sb.appendI
              op [] .pos errors appendError
              context [] .stack list.clear context .stack=
              return
            end
            context [] .stack
              count for ..drop
                list.pop =:: popped
                popped .location switch
                  memory case break ## nothing to do
                  register case
                    popped .location .register context findRegister .data =:: poppedReg
                    poppedReg [] resetRegister poppedReg =[]
                    break
                  registers registerHi registerLow case "unimplemented" ..panic
                end
              end
            context .stack=
            return
          COPY case
            op [] .val .stackMod .n =:: offset
            context [] .stack .length offset <= if
              "CodeGen: stack underflow in copy, stackSize: " sb.copyPtr
                context [] .stack .length sb.appendI
              op [] .pos errors appendError
              return
            end
            ## copy value on stack
            context [] .stack
              offset
            list.at .data [] =:: copied
            copied .valType opIndex context nextRegister =:: targetRegister
            ## TODO handle case where copied value is no register
            asm.OpType .MOVE
              targetRegister asm.Operand .register
              copied .location .register asm.Operand .register
            context appendOp2
            ## TODO remember that copied register holds value of old register, use old register to get value until:
            ##  a) register changes
            ##  b) start of next loop
            targetRegister copied .valType context pushRegister
            return
          SWAP case
            context [] .stack .length 2 < if
              "CodeGen: stack underflow in swap, stackSize: " sb.copyPtr
                context [] .stack .length sb.appendI
              op [] .pos errors appendError
              return
            end
            context [] .stack
              list.pop =:: a
              $ .length =:: hiSlot
              list.pop =:: b
              $ .length =:: lowSlot
              a list.push
              b list.push
            context .stack=
            ## update locations
            ## TODO? reduce duplicate code
            a .location switch
              register case
                a .location .register context findRegister .data =:: regData
                hiSlot regData .currentValue [] .stackSlot != if
                  "CodeGen: stack and registers in sync":s Atomic .DebugError list.append
                end
                lowSlot regData .currentValue .stackSlot=
                break
              registerHi case
                a .location .registerHi context findRegister .data =:: regData
                hiSlot regData .currentValue [] .stackSlotHi != if
                  "CodeGen: stack and registers in sync":s Atomic .DebugError list.append
                end
                lowSlot regData .currentValue .stackSlotHi=
                break
              registerLow case
                a .location .registerLow context findRegister .data =:: regData
                hiSlot regData .currentValue [] .stackSlotLow != if
                  "CodeGen: stack and registers in sync":s Atomic .DebugError list.append
                end
                lowSlot regData .currentValue .stackSlotLow=
                break
              registers case
                a .location .registers .hi context findRegister .data =:: regDataHi
                hiSlot regDataHi .currentValue [] .stackSlotHi != if
                  "CodeGen: stack and registers in sync":s Atomic .DebugError list.append
                end
                lowSlot regDataHi .currentValue .stackSlotHi=
                a .location .registers .low context findRegister .data =:: regDataLow
                hiSlot regDataLow .currentValue [] .stackSlotLow != if
                  "CodeGen: stack and registers in sync":s Atomic .DebugError list.append
                end
                lowSlot regDataLow .currentValue .stackSlotLow=
                break
              memory case break
            end
            b .location switch
              register case
                b .location .register context findRegister .data =:: regData
                lowSlot regData .currentValue [] .stackSlot != if
                  "CodeGen: stack and registers in sync":s Atomic .DebugError list.append
                end
                hiSlot regData .currentValue .stackSlot=
                break
              registerHi case
                b .location .registerHi context findRegister  .data =:: regData
                lowSlot regData .currentValue [] .stackSlotHi != if
                  "CodeGen: stack and registers in sync":s Atomic .DebugError list.append
                end
                hiSlot regData .currentValue .stackSlotHi=
                break
              registerLow case
                b .location .registerLow context findRegister .data =:: regData
                lowSlot regData .currentValue [] .stackSlotLow != if
                  "CodeGen: stack and registers in sync":s Atomic .DebugError list.append
                end
                hiSlot regData .currentValue .stackSlotLow=
                break
              registers case
                b .location .registers .hi context findRegister .data =:: regDataHi
                lowSlot regDataHi .currentValue [] .stackSlotHi != if
                  "CodeGen: stack and registers in sync":s Atomic .DebugError list.append
                end
                hiSlot regDataHi .currentValue .stackSlotHi=
                b .location .registers .low context findRegister .data =:: regDataLow
                lowSlot regDataLow .currentValue [] .stackSlotLow != if
                  "CodeGen: stack and registers in sync":s Atomic .DebugError list.append
                end
                hiSlot regDataLow .currentValue .stackSlotLow=
                break
              memory case break
            end
            return
        end
      break
      default break
    end
    Atomic .Unknown list.append
  return
end
proc( Atomic list : ops ProgramContext ptr : program io.FILE : target -> ) =>: printOps
  1024 sb.create
    ops for program sb.appendAtomic end
    target $1 io.fputSb ..drop
  sb.free ..drop
end
proc( io.FILE : target io.FILE optional : intermediateTarget? ProgramContext ptr.mut : program -> ) =>: export: compileToASM
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  RegisterState MAX_DATA_REGISTERS array : regBuffer
  ## CompilerContext
    program
    regBuffer@ AMD64.initDataRegisters >$ =:: intRegsCount
    64 StackValue list.create
    labelHash@ labelEq@ 1024 ValueLocation map.create
    64 BlockInfo list.create
    16 ArgumentLocation list.create
    256 PointerConstant list.create
    128 Atomic list.create
    intRegsCount
    0
    true
  CompilerContext new =:: mut: contextData
  contextData@ =:: context
  ## TODO? compile procedures seperately
  1024 Atomic list.create
    ## TODO generate global constants
    SectionType .Code Atomic .Section list.append
    ## code
    program [] .progFiles .length for =:: i
      program [] .progFiles i list.get =:: f
      ## add file-marker even for empty files to ensure file-name is defined for every file-id
      i FileId cast Atomic .StartFile list.append
      f .localOps .length for =:: opIndex
        f .localOps opIndex list.at .data opIndex context compileOp
      end
    end
    SectionType .Data Atomic .Section list.append ## TODO? seperate section for read-only data
    context .pointerConstants [] .length for =:: i
      context [] .pointerConstants i [] =:: constInfo
      asm.OpType .LABEL
        i asm.Operand .constPtr
      context appendOp1
      ## TODO! ensure alignemnt
      constInfo .constValue .Array8 ?? if ## string?
        constInfo .constValue .Array8 for =:: byte
          asm.OpType .DATA
            ValType .I8 asm.Operand .valType
            byte i64 cast.u asm.Operand .constInt
          context appendOp2
        end
        asm.OpType .DATA
          ValType .I8 asm.Operand .valType
          0 asm.Operand .constInt
        context appendOp2
      else
        Atomic .Unknown list.append
      end
    end
    intermediateTarget? optional.hasData if
      $ program intermediateTarget? .data printOps
    end
    4096 sb.create
      $1 program AMD64.buildProgram
      target $1 io.fputSb ..drop
    sb.free ..drop
  list.free ..drop
end
