    ## IfBlockInfo
      blockId
      NO_LABEL
      NO_LABEL
      NO_LABEL
      regCount 3 * iSize cast.u RegisterState mem.alloc regCount 3 * slice.createMutable
      regCount
      regCount 2 *
      -1:iSize
      -1:iSize
      false
    IfBlockInfo new BlockInfo .If list.append
  context .openBlocks=
  context [] .openBlocks list.peek .data .If
end
proc(
  BlockId : blockId
  CompilerContext ptr.mut : context
-> AndOrBlockInfo ptr.mut ) =>: openAndOrBlock
  context .dataRegisters [] .length i32 cast =:: regCount
  context [] .openBlocks
    ## IfBlockInfo
      blockId
      NO_LABEL
      regCount iSize cast.u RegisterState mem.alloc regCount slice.createMutable
      -1:iSize
    AndOrBlockInfo new BlockInfo .AndOr list.append
  context .openBlocks=
  context [] .openBlocks list.peek .data .AndOr
end
proc(
  BlockId : blockId
  CompilerContext ptr.mut : context
-> InlineProcBlockInfo ptr.mut ) =>: openInlineProcBlock
  context .dataRegisters [] .length i32 cast =:: regCount
  context [] .openBlocks
    ## IfBlockInfo
      blockId
      NO_LABEL
    InlineProcBlockInfo new BlockInfo .InlineProc list.append
  context .openBlocks=
