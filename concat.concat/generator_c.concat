#include stringIO

#include "program.concat"
#include "measure.concat"

"concat_" =:: CONCAT_PREFIX ## TODO? shorten to cct_ (current name for compatibility with old library C code)
## XXX? use separate prefix for extern procedures
"internal_argc"            =:: ARGC_NAME
"internal_argv"            =:: ARGV_NAME
"internal_main"            =:: MAIN_NAME
"internal_checkArrayIndex" =:: CHECK_INDEX_NAME
"internal_checkEnumIndex"  =:: CHECK_ENUM_NAME
1 =:: EXIT_CODE_ARRAY_INDEX
2 =:: EXIT_CODE_ENUM_INDEX

proc( io.FILE : target => ) =: printHeader
  target
    #dup "#include <stdlib.h>\n" io.fputs #drop
    #dup "#include <stdio.h>\n" io.fputs #drop
    #dup "#include <inttypes.h>\n" io.fputs #drop
    #dup "#include <string.h>\n" io.fputs #drop
    #dup "#include <stdbool.h>\n" io.fputs #drop
  #drop
end

#namespace sb
proc( stringBuilder string => stringBuilder ) =: appendAsciified
  =:: str
  0 while #dup str .length < do
    #swap
      str #over:2 string.charAt =:: c
      c '0' >= c '9' <= & if
        c sb.appendC
        #swap 1 + continue
      end
      c 'A' >= c 'Z' <= & if
        c sb.appendC
        #swap 1 + continue
      end
      c 'a' >= c 'z' <= & if
        c sb.appendC
        #swap 1 + continue
      end
      c '_' == if
        "__" sb.appendS
        #swap 1 + continue
      end
      c '.' == if
        "_d" sb.appendS
        #swap 1 + continue
      end
      "_X" sb.appendS
      c 0xff & 0x10 < if
        '0' sb.appendC
      end
      c 0xff & sb.appendI
    #swap 1 +
  end #drop
end
#end
proc( LabelId : label i32 : implId io.FILE : target Program ptr mut : prog => ) =: printGlobalName
  prog [] .idContext .labelContext @ =:: labelContext
  128 sb.create
    CONCAT_PREFIX sb.appendS
    label labelContext id.labelFlags id.FLAG_PUBLIC & 0 == if
      label labelContext id.getLabelFile sb.appendI
      "_F" sb.appendS
    end
    label labelContext id.getLabelNamespace =:: mut mNamespace
    while mNamespace id.NAMESPACE_ID_NONE != mNamespace 0 > & do
      mNamespace labelContext id.namespaceName sb.appendAsciified
      "." string.wrap sb.appendAsciified
      mNamespace labelContext id.parentNamespace mNamespace =
    end ## XXX? reverse order
    label labelContext id.labelName #dup optional.hasData if
      .data sb.appendAsciified
    else #drop end
    implId 0 >= if
      "_I" sb.appendS
      implId sb.appendI
    end
    target #over io.fputSb #drop
  sb.free #drop
end
proc( i32 : index LabelId : labelId io.FILE : target Program ptr mut : prog => ) =: printArgName
  prog [] .idContext .labelContext @ =:: labelContext
  labelId labelContext id.labelName =:: labelName
  64 sb.create
    "arg" sb.appendS
    index sb.appendI
    labelName optional.hasData if
      "/*" sb.appendS
      labelName .data sb.appendAsciified
      "*/" sb.appendS
    end
    target #over io.fputSb #drop
  sb.free #drop
end
proc( IdentifierInfo : idInfo io.FILE : target Program ptr mut : prog => ) =: printIdName
  prog [] .idContext .labelContext @ =:: labelContext
  idInfo .idType switch
    PROCEDURE GLOBAL_VAR case
      idInfo .labelId idInfo .id target prog printGlobalName return
    LOCAL_VAR case
      64 sb.create
        "l" sb.appendS
        idInfo .id sb.appendI
        idInfo .labelId labelContext id.labelName #dup optional.hasData if
          #swap
            "_" sb.appendS
          #swap .data sb.appendAsciified
        else #drop end
        target #over io.fputSb #drop
      sb.free #drop
      return
    TMP_VAR case
      64 sb.create
        "tmp" sb.appendS
        idInfo .id sb.appendI
        target #over io.fputSb #drop
      sb.free #drop
      return
    ARGUMENT case
      idInfo .id idInfo .labelId target prog printArgName
      return
    TYPE TEMPLATE_ARG case
      break ## XXX? error message
  end
end
proc( string : name i32 : id io.FILE : target => ) =: printCompositeName
  128 sb.create
    CONCAT_PREFIX sb.appendS
    name  sb.appendStr
    id    sb.appendI
    target #over io.fputSb #drop
  sb.free #drop
end
proc( Type : t io.FILE : target Program ptr mut : prog => ) =: printTypeName
  prog [] .idContext .labelContext @ =:: labelContext
  prog [] .idContext .typeContext @ =:: typeContext
  t switch
    undefined templateType genericType case ## no global type necessary
      target "void" io.fputs #drop
      break
    primitiveType case
      t .primitiveType switch
        TYPE  case target "size_t"  io.fputs #drop break
        BOOL  case target "bool"    io.fputs #drop break
        I8    case target "int8_t"  io.fputs #drop break
        I32   case target "int32_t" io.fputs #drop break
        I64   case target "int64_t" io.fputs #drop break
        FLOAT case target "double"  io.fputs #drop break ## TODO separate double and float
      end
      break
    autoType case
      break ## XXX? resolve auto-types
    pointer case
      t typeContext types.getBaseType target prog printTypeName
      t typeContext types.isCallable if
        break
      end
      t typeContext types.isMutable ! if
        target " const" io.fputs #drop
      end
      target "*" io.fputs #drop
      break
    labeledProcIn procIn case
      ## XXX? print proc-in
      break
    arrayType case
      "array" string.wrap t .arrayType target printCompositeName
      break
    tuple case
      "tuple" string.wrap t .tuple target printCompositeName
      break
    struct case
      "tuple" string.wrap t .struct target printCompositeName
      break
    procOut case
      t typeContext types.compositeEltCount =:: eltCount
      eltCount 0 == if
        target "void" io.fputs #drop
        break
      end
      eltCount 1 == if
        t 0 typeContext types.compositeGetElement target prog printTypeName
        break
      end
      "tuple" string.wrap t .procOut target printCompositeName
      break
    enum case
      "enum" string.wrap t .enum target printCompositeName
      break
    procedure case
      "proc" string.wrap t .procedure target printCompositeName
      break
    namedType case
      t typeContext types.namedTypeName  t typeContext types.getImplId  target prog printGlobalName
      break
  end
end
proc( Type : t io.FILE : target Program ptr mut : prog => ) =: printUnsignedTypeName
  prog [] .idContext .typeContext @ =:: typeContext
  t typeContext types.isInt ! if
    t target prog printTypeName
    return
  end
  t typeContext types.unwrapNamed .primitiveType switch
    TYPE  case target "size_t"  io.fputs #drop break
    BOOL  case target "bool"    io.fputs #drop break
    I8    case target "uint8_t"  io.fputs #drop break
    I32   case target "uint32_t" io.fputs #drop break
    I64   case target "uint64_t" io.fputs #drop break
    FLOAT case target "float"   io.fputs #drop break
  end
end
proc( Type : t bool : argNames io.FILE : target Program ptr mut : prog => ) =: printProcArgs
  prog [] .idContext .labelContext @ =:: labelContext
  prog [] .idContext .typeContext @ =:: typeContext
  t typeContext types.getProcIn #drop =:: inType
  inType typeContext types.compositeElts =:: args
  args .length 0 == if
    target "(void)" io.fputs #drop
    return
  end
  target "(" io.fputs #drop
  0 while #dup args .length < do
    #dup 0 > if
      target "," io.fputs #drop
    end
    args #over array.get target prog printTypeName
    argNames if
      target " " io.fputs #drop
      #dup inType #over typeContext types.compositeGetLabel target prog printArgName
    end
    1 +
  end #drop
  target ")" io.fputs #drop
end
proc( string : name i32 : id io.FILE : target => ) =: printCompositeDeclaration
  128 sb.create
    "typedef struct " sb.appendS
    CONCAT_PREFIX sb.appendS
    name  sb.appendStr
    id    sb.appendI
    ' '   sb.appendC
    CONCAT_PREFIX sb.appendS
    name  sb.appendStr
    id    sb.appendI
    ";\n" sb.appendS
    target #over io.fputSb #drop
  sb.free #drop
end
proc( Type : composite i32 : index io.FILE : target Program ptr mut : prog => ) =: printEltName
  prog [] .idContext .labelContext @ =:: labelContext
  prog [] .idContext .typeContext @ =:: typeContext
  64 sb.create
    "e" sb.appendS
    index sb.appendI
    composite index typeContext types.compositeGetLabel labelContext id.labelName #dup optional.hasData if
      #swap
        "_" sb.appendS
      #swap .data sb.appendAsciified
    else #drop end
    target #over io.fputSb #drop
  sb.free #drop
end
proc( Type : composite io.FILE : target Program ptr mut : prog => ) =: printCompositeElements
  prog [] .idContext .typeContext @ =:: typeContext
  composite typeContext types.compositeElts =:: elts
  0 while #dup elts .length < do
    elts #over array.get #dup typeContext types.isEmpty if ## skip empty types
      #drop 1 + continue
    end target prog printTypeName
    target " " io.fputs #drop
    composite #over target prog printEltName
    target ";\n" io.fputs #drop
    1 +
  end #drop
end
proc( io.FILE : target Program ptr mut : prog => ) =: printTypes
  prog [] .idContext .typeContext @ =:: typeContext
  prog getDeclaredTypes =:: types
  target "//type declarations\n" io.fputs #drop
  ## declare types
  0 while #dup types .length < do
    types #over list.get =:: t
    t switch
      undefined primitiveType autoType templateType genericType procedure labeledProcIn procIn case ## no global type necessary
        break
      pointer case
        t typeContext types.isCallable if ## procedure pointer
          t typeContext types.getBaseType =:: base
          target "typedef " io.fputs #drop
          base typeContext types.getProcOut #drop target prog printTypeName
          32 sb.create
            " (*" sb.appendS
            CONCAT_PREFIX sb.appendS
            "proc" sb.appendS
            base types.getTypeId sb.appendI
            ") " sb.appendS
            target #over io.fputSb #drop
          sb.free #drop
          base false target prog printProcArgs
          target ";\n" io.fputs #drop
        end
        break
      arrayType case
        "array" string.wrap t .arrayType target printCompositeDeclaration
        break
      tuple case
        "tuple" string.wrap t .tuple target printCompositeDeclaration
        break
      struct case
        "tuple" string.wrap t .struct target printCompositeDeclaration
        break
      procOut case
        "tuple" string.wrap t .procOut target printCompositeDeclaration
        break
      enum case
        "enum" string.wrap t .enum target printCompositeDeclaration
        break
      namedType case
        target "typedef " io.fputs #drop
        t typeContext types.unwrapNamed target prog printTypeName
        target " " io.fputs #drop
        t typeContext types.namedTypeName  t typeContext types.getImplId  target prog printGlobalName
        target ";\n" io.fputs #drop
        break
    end
    1 +
  end #drop
  ## initialize composite types
  0 while #dup types .length < do
    types #over list.get =:: t
    t switch
      undefined primitiveType autoType templateType genericType procedure labeledProcIn procIn pointer namedType case ## no initialization necessary
        break
      arrayType case
        t typeContext types.isFixedSize ! if
          ## TODO add to compiler error list
          "arrays cannot be variable sized" io.puts #drop
        end
        target "struct " io.fputs #drop
        "array" string.wrap t .arrayType target printCompositeName
        target "{\n" io.fputs #drop
        t typeContext types.getBaseType target prog printTypeName
        32 sb.create
          " data[" sb.appendS
          t typeContext types.getArraySize =:: sizes
          1 i64 =: mut totalSize
          0 while #dup sizes .length < do
            #swap
              sizes #over:2 array.get
                #dup .sizeType types.ArraySizeType .int != if
                  "non-integer array sizes should not exist at this stage of compilation" io.puts #drop
                end
              .value totalSize * totalSize =
            #swap 1 +
          end #drop
          totalSize sb.appendI
          "];\n};\n" sb.appendS
          target #over io.fputSb #drop
        sb.free #drop
        break
      tuple case
        target "struct " io.fputs #drop
        "tuple" string.wrap t .tuple target printCompositeName
        target "{\n" io.fputs #drop
        t target prog printCompositeElements
        target "};\n" io.fputs #drop
        break
      struct case
        target "struct " io.fputs #drop
        "tuple" string.wrap t .struct target printCompositeName
        target "{\n" io.fputs #drop
        t target prog printCompositeElements
        target "};\n" io.fputs #drop
        break
      procOut case
        target "struct " io.fputs #drop
        "tuple" string.wrap t .procOut target printCompositeName
        target "{\n" io.fputs #drop
        t target prog printCompositeElements
        target "};\n" io.fputs #drop
        break
      enum case
        target "struct " io.fputs #drop
        "enum" string.wrap t .enum target printCompositeName
        target "{\n" io.fputs #drop
        t typeContext types.compositeFlags types.COMP_FLAG_VOID_ONLY & 0 == if
          target "union{\n" io.fputs #drop
          t target prog printCompositeElements
          target "}data;\n" io.fputs #drop
        end
        target "int32_t label;\n};\n" io.fputs #drop ## XXX smaller int-type for smaller label count
        break
    end
    1 +
  end #drop
  types list.free #drop
end
proc( BinaryOperator => bool ) =: isUnsignedOp
  switch
    ADD SUBTRACT MULTIPLY DIVIDE MOD
    AND OR XOR LSHIFT RSHIFT
    EQ NE LE GE LT GT case
      false return
    UDIVIDE UMOD URSHIFT case
      true return
  end
end
## XXX? compiler context
proc( Type : t Operation arrayView : operations i32 ptr mut : index bool : isGlobal io.FILE : target Program ptr mut : prog => ) =:  compileCall
  prog [] .idContext .labelContext @ =:: labelContext
  prog [] .idContext .typeContext @ =:: typeContext
  t typeContext types.getProcIn #drop typeContext types.compositeEltCount =:: argCount
  target "(" io.fputs #drop
  0 while #dup argCount < do
    #dup 0 > if
      target "," io.fputs #drop
    end
    operations index isGlobal target prog compileOp
    1 +
  end #drop
  target ")" io.fputs #drop
  t typeContext types.getProcOut #drop typeContext types.compositeEltCount 0 == if
    target ";\n" io.fputs #drop
  end
end
proc( Type : base i32 : eltIndex bool : isEnum Operation arrayView : operations i32 ptr mut : index bool : isGlobal io.FILE : target Program ptr mut : prog => ) =:  compileGetElt
  target "(" io.fputs #drop
  operations index isGlobal target prog compileOp
  isEnum if
    target ".data." io.fputs #drop
  else
    target "." io.fputs #drop
  end
  base eltIndex target prog printEltName
  target ")" io.fputs #drop
end
proc( Type : base i32 : dims Operation arrayView : operations i32 ptr mut : index bool : isGlobal io.FILE : target Program ptr mut : prog => ) =:  compileGetIndex
  prog [] .idContext .typeContext @ =:: typeContext
  dims 0 == if
    target "(*" io.fputs #drop
    operations index isGlobal target prog compileOp
    target ")" io.fputs #drop
    return
  end
  base typeContext types.getArraySize =:: sizes
  target "(" io.fputs #drop
  operations index isGlobal target prog compileOp
  64 sb.create
    "[" sb.appendS
    target #over io.fputSb #drop
    sb.clear
      0 while #dup dims 1 - < do
        #swap
          "(" sb.appendS
        #swap 1 +
      end #drop
      target #over io.fputSb #drop
      sb.clear
      0 while #dup dims < do
        operations index isGlobal target prog compileOp
        #dup dims 1 - < if
          #dup sizes .length >= if #drop:2
            prog [] .errors @ "number of indices exceeds dimension" sb.wrap operations index [] 1 - array.at .data [] .pos appendError
            return
          end
          #swap
            "*" sb.appendS
            sizes #over:2 array.get .value sb.appendI
            ")+" sb.appendS
            target #over io.fputSb #drop
            sb.clear
          #swap
        end
        1 +
      end #drop
    "])" sb.appendS
    target #over io.fputSb #drop
  sb.free #drop
end
proc( Type : composite Operation arrayView : operations i32 ptr mut : index bool : isGlobal io.FILE : target Program ptr mut : prog => ) =: compileCreateTuple
  prog [] .idContext .typeContext @ =:: typeContext
  composite typeContext types.compositeElts =:: elts
  isGlobal ! if
    target "((" io.fputs #drop
    composite target prog printTypeName
    target ")" io.fputs #drop
  end
  target "{" io.fputs #drop
  0 while #dup elts .length < do
    #dup 0 > if
      target "," io.fputs #drop
    end
    elts #over array.get typeContext types.isEmpty if ## skip empty types
      1 + continue
    end
    target "." io.fputs #drop
    composite #over target prog printEltName
    target " = " io.fputs #drop
    operations index isGlobal target prog compileOp
    1 +
  end #drop
  isGlobal if
    target "}" io.fputs #drop
  else
    target "})" io.fputs #drop
  end
end
proc( Type : constType bool : isGlobal io.FILE : target Program ptr mut : prog => stringBuilder ) =: constStart
  64 sb.create
    isGlobal ! if
      "((" sb.appendS
      target #over io.fputSb #drop
      sb.clear
      constType target prog printTypeName
      ")" sb.appendS
    end
  return
end
proc( stringBuilder : sb bool : isGlobal io.FILE : target Program ptr mut : prog => ) =: constEnd
  sb
    isGlobal ! if
      ")" sb.appendS
    end
    target #over io.fputSb #drop
  sb.free #drop
end

proc( Type : constType ConstValue : const bool : isGlobal io.FILE : target Program ptr mut : prog => ) =: compileConstant
  prog [] .idContext @ =:: idContext
  idContext [] .labelContext @ =:: labelContext
  idContext [] .typeContext @ =:: typeContext
  const switch
    boolean case
      const .boolean if
        target "true" io.fputs #drop
      else
        target "false" io.fputs #drop
      end
      return
    chr case
      constType isGlobal target prog constStart
        const .chr sb.appendI
      isGlobal target prog constEnd
      return
    int case
      constType isGlobal target prog constStart
        const .int i64.MIN == if
          '(' sb.appendC
          const .int 1 + sb.appendI
          "-1)" sb.appendS
        else
          const .int sb.appendI
        end
      isGlobal target prog constEnd
      return
    enumLabel case
      constType isGlobal target prog constStart
        "{.label=" sb.appendS
        const .enumLabel sb.appendI
        "}" sb.appendS
      isGlobal target prog constEnd
      return
    typeId case
      constType isGlobal target prog constStart
        "sizeof(" sb.appendS
        target #over io.fputSb #drop
        sb.clear
        const .typeId target prog printTypeName
        ")" sb.appendS
      isGlobal target prog constEnd
      return
    str case ## TODO string constants
      constType false target prog constStart ## treat all strings as global constants (cast to int8_t*)
      '"' sb.appendC
      const .str labelContext id.scAsStr sb.appendEscapedStr
      '"' sb.appendC
      false target prog constEnd
      break
    arrayConstant case const .arrayConstant idContext [] .constContext @ constArrayAsArray =:: mArray
      constType typeContext types.getBaseType =:: baseType
      constType isGlobal target prog constStart
      "{.data={" sb.appendS
      0 while #dup mArray .length < do
        #swap
        #over 0 > if
          ',' sb.appendC
        end
        target #over io.fputSb #drop
        sb.clear
        baseType mArray #over:3 array.get isGlobal target prog compileConstant
        #swap 1 +
      end #drop
      "}}" sb.appendS
      isGlobal target prog constEnd
      break
    genericArg case ## XXX find correct label
      const .genericArg id.LABEL_ID_NONE target prog printArgName
      return
    none wildCard templateArg case
      break ## XXX error message
  end
end

proc( Operation arrayView : operations i32 ptr mut : index bool : isGlobal io.FILE : target Program ptr mut : prog => ) =: compileOp
  prog [] .idContext @ =:: idContext
  idContext [] .labelContext @ =:: labelContext
  idContext [] .typeContext @ =:: typeContext
  Operation ptr : mut op
  while
    index [] operations .length >= if
      ## TODO error: missing operation
      return
    end
    operations index [] array.at .data op =
    index [] 1 + index [] =
    op [] .val OpValue .NOP ==
  do end
  op [] .val switch
    NOP case
      break
    OpValue .Constant case
      op [] .dataType op [] .val .Constant isGlobal target prog compileConstant
      break
    Print case
      op [] .dataType typeContext types.unwrapNamed =:: printType
      printType types.isPrimitive if
        printType .primitiveType switch
          BOOL case
            target "printf(\"%s\\n\"," io.fputs #drop
            operations index isGlobal target prog compileOp
            target "?\"true\":\"false\");\n" io.fputs #drop
            return
          I8 case
            target "printf(\"%\"PRIi8\"\\n\"," io.fputs #drop ## XXX? also print char value
            operations index isGlobal target prog compileOp
            target ");\n" io.fputs #drop
            return
          I32 case
            target "printf(\"%\"PRIi32\"\\n\"," io.fputs #drop
            operations index isGlobal target prog compileOp
            target ");\n" io.fputs #drop
            return
          I64 case
            target "printf(\"%\"PRIi64\"\\n\"," io.fputs #drop
            operations index isGlobal target prog compileOp
            target ");\n" io.fputs #drop
            return
          FLOAT case
            target "printf(\"%g\\n\"," io.fputs #drop
            operations index isGlobal target prog compileOp
            target ");\n" io.fputs #drop
            return
          TYPE case ## at run-time only size of types is known
            target "printf(\"%zu\\n\"," io.fputs #drop
            operations index isGlobal target prog compileOp
            target ");\n" io.fputs #drop
            return
        end
      end
      printType typeContext types.isPointer if
        target "printf(\"%p\\n\",(void const*)" io.fputs #drop
        operations index isGlobal target prog compileOp
        target ");\n" io.fputs #drop
        return
      end
      ## remove printed element
      target "(void)" io.fputs #drop
      operations index isGlobal target prog compileOp
      target ";\n" io.fputs #drop
      ## XXX print array/tuple types
      break
    New case
      op [] .dataType typeContext types.isTuple if
        op [] .dataType operations index isGlobal target prog compileCreateTuple
        return
      end
      op [] .dataType typeContext types.isArray if
        isGlobal ! if
          target "(" io.fputs #drop
          op [] .dataType target prog printTypeName
          target ")" io.fputs #drop
        end
        target "{0,}" io.fputs #drop
      end
      break
    newEnum case
      isGlobal ! if
        target "((" io.fputs #drop
        op [] .dataType target prog printTypeName
        target ")" io.fputs #drop
      end
      ## TODO empty enum
      64 sb.create
        "{.label="        sb.appendS
        op [] .val .newEnum sb.appendI
        op [] .dataType op [] .val .newEnum typeContext types.compositeGetElement typeContext types.isEmpty ! if
          ",.data={."         sb.appendS
          target #over io.fputSb #drop
          sb.clear
          op [] .dataType op [] .val .newEnum target prog printEltName
          " = "               sb.appendS
          target #over io.fputSb #drop
          sb.clear
          operations index isGlobal target prog compileOp
          "}"                sb.appendS
        end
        isGlobal if
          "}"                sb.appendS
        else
          "})"               sb.appendS
        end
        target #over io.fputSb #drop
      sb.free #drop
      return
    unaryOperator case
      target "(" io.fputs #drop
      op [] .val .unaryOperator switch
        NOT case
          target "!" io.fputs #drop
          operations index isGlobal target prog compileOp
          break
        NEGATE case
          target "-" io.fputs #drop
          operations index isGlobal target prog compileOp
          break
        FLIP case
          target "~" io.fputs #drop
          operations index isGlobal target prog compileOp
          break
      end
      target ")" io.fputs #drop
      break
    binaryOperator case
      target "(" io.fputs #drop
      op [] .val .binaryOperator isUnsignedOp if
        target "(" io.fputs #drop
        op [] .dataType target prog printTypeName
        target ")(((" io.fputs #drop
        op [] .dataType target prog printUnsignedTypeName
        target ")" io.fputs #drop
        operations index isGlobal target prog compileOp
        target ")" io.fputs #drop
      else
        operations index isGlobal target prog compileOp
      end
      op [] .dataType typeContext types.isEnum if
        target ".label" io.fputs #drop
      end
      op [] .val .binaryOperator switch
        ADD case target "+" io.fputs #drop break
        SUBTRACT case target "-" io.fputs #drop break
        MULTIPLY case target "*" io.fputs #drop break
        DIVIDE UDIVIDE case target "/" io.fputs #drop break
        MOD UMOD case target "%" io.fputs #drop break
        AND case target "&" io.fputs #drop break
        OR case target "|" io.fputs #drop break
        XOR case target "^" io.fputs #drop break
        LSHIFT case target "<<" io.fputs #drop break
        RSHIFT URSHIFT case target ">>" io.fputs #drop break
        EQ case target "==" io.fputs #drop break
        NE case target "!=" io.fputs #drop break
        LE case target "<=" io.fputs #drop break
        GE case target ">=" io.fputs #drop break
        LT case target "<" io.fputs #drop break
        GT case target ">" io.fputs #drop break
      end
      op [] .val .binaryOperator isUnsignedOp if
        target "((" io.fputs #drop
        op [] .dataType target prog printUnsignedTypeName
        target ")" io.fputs #drop
        operations index isGlobal target prog compileOp
        target "))" io.fputs #drop
      else
        operations index isGlobal target prog compileOp
      end
      op [] .dataType typeContext types.isEnum if
        target ".label" io.fputs #drop
      end
      target ")" io.fputs #drop
      break
    Cast Cast! case
      op [] .val OpValue .Cast! == if op [] .val .Cast! else op [] .val .Cast end =:: src
      src typeContext types.unwrapNamed op [] .dataType typeContext types.unwrapNamed types.typeEquals if
        operations index isGlobal target prog compileOp ## cast type to itself
        return
      end
      src typeContext types.isArray if
        op [] .dataType typeContext types.isPointer if ## array -> pointer
          target "((" io.fputs #drop
          op [] .dataType target prog printTypeName
          target ")" io.fputs #drop
          operations index isGlobal target prog compileOp
          target ".data)" io.fputs #drop
          return
        end
        break ## unknown cast
      end
      src typeContext types.isEnum if #+TODO emtpy enums, optional pointer+#
        op [] .dataType typeContext types.isInt if ## enum ->int
          target "((" io.fputs #drop
          op [] .dataType target prog printTypeName
          target ")" io.fputs #drop
          operations index isGlobal target prog compileOp
          target ".label)" io.fputs #drop
        end
        break ## unknown cast
      end
      target "((" io.fputs #drop
      op [] .dataType target prog printTypeName
      target ")" io.fputs #drop
      operations index isGlobal target prog compileOp
      target ")" io.fputs #drop
      return
    enumLabelEq case
      target "(" io.fputs #drop
      operations index isGlobal target prog compileOp
      64 sb.create
        ".label=="              sb.appendS
        op [] .val .enumLabelEq sb.appendI
        ")"                     sb.appendS
        target #over io.fputSb #drop
      sb.free #drop
      break
    enumLabelNe case
      target "(" io.fputs #drop
      operations index isGlobal target prog compileOp
      64 sb.create
        ".label!="              sb.appendS
        op [] .val .enumLabelNe sb.appendI
        ")"                     sb.appendS
        target #over io.fputSb #drop
      sb.free #drop
      break
    callPtr case
      operations index isGlobal target prog compileOp
      op [] .dataType operations index isGlobal target prog compileCall
      break
    getId case
      op [] .val .getId =:: idInfo
      idInfo .idType switch
        LOCAL_VAR GLOBAL_VAR TMP_VAR ARGUMENT case
          idInfo target prog printIdName
          return
        PROCEDURE case
          idInfo target prog printIdName
          op [] .dataType operations index isGlobal target prog compileCall
          break
        TYPE TEMPLATE_ARG case
          break ## XXX error message
      end
      break
    @Id case
      op [] .val .@Id =:: idInfo
      idInfo .idType switch
        LOCAL_VAR GLOBAL_VAR TMP_VAR ARGUMENT PROCEDURE case
          target "(&" io.fputs #drop
          op [] .dataType typeContext types.getArrayDims 0 > if
            target "(" io.fputs #drop
          end
          idInfo target prog printIdName
          op [] .dataType typeContext types.getArrayDims 0 > if
            target ".data[0])" io.fputs #drop
          end
          target ")" io.fputs #drop
          return
        TYPE TEMPLATE_ARG case
          break ## XXX error message
      end
      break
    setId case
      op [] .val .setId =:: idInfo
      idInfo .idType switch
        LOCAL_VAR GLOBAL_VAR TMP_VAR case
          idInfo target prog printIdName
          target " = " io.fputs #drop
          operations index isGlobal target prog compileOp
          target ";\n" io.fputs #drop
          return
        TYPE ARGUMENT TEMPLATE_ARG PROCEDURE case
          break ## XXX error message
      end
      break
    declareId case
      op [] .val .declareId =:: idInfo
      idInfo .labelId labelContext id.labelFlags id.FLAG_MUTABLE & 0 == =:: immutable
      idInfo .idType switch
        PROCEDURE case
          op [] .dataType typeContext types.getProcOut #drop target prog printTypeName
          target " " io.fputs #drop
          idInfo .labelId  idInfo .id  target prog printGlobalName
          op [] .dataType true target prog printProcArgs
          target "{\n" io.fputs #drop
          return
        LOCAL_VAR GLOBAL_VAR TMP_VAR case
          op [] .dataType target prog printTypeName
          immutable if
            target " const " io.fputs #drop
          else
            target " " io.fputs #drop
          end
          idInfo target prog printIdName
          target " = " io.fputs #drop
          operations index isGlobal target prog compileOp
          target ";\n" io.fputs #drop
          return
        TYPE ARGUMENT TEMPLATE_ARG case
          break ## XXX error message
      end
      break
    predeclareId case
      op [] .val .predeclareId =:: idInfo
      idInfo .labelId labelContext id.labelFlags id.FLAG_MUTABLE & 0 == =:: immutable
      idInfo .idType switch
        PROCEDURE case
          op [] .dataType typeContext types.getProcOut #drop target prog printTypeName
          target " " io.fputs #drop
          idInfo .labelId  idInfo .id  target prog printGlobalName
          op [] .dataType false target prog printProcArgs
          target ";\n" io.fputs #drop
          return
        LOCAL_VAR GLOBAL_VAR TMP_VAR case
          op [] .dataType target prog printTypeName
          immutable if
            target " const " io.fputs #drop
          else
            target " " io.fputs #drop
          end
          idInfo target prog printIdName
          target ";\n" io.fputs #drop
          return
        TYPE ARGUMENT TEMPLATE_ARG case
          break ## XXX error message
      end
      break
    getArrayElement case
      op [] .dataType op [] .val .getArrayElement operations index isGlobal target prog compileGetIndex
      return
    setArrayElement case
      op [] .dataType op [] .val .setArrayElement operations index isGlobal target prog compileGetIndex
      target " = " io.fputs #drop
      operations index isGlobal target prog compileOp
      target ";\n" io.fputs #drop
      break
    @ArrayElement case
      target "(&" io.fputs #drop
      op [] .dataType typeContext types.getBaseType =:: eltType
      eltType typeContext types.getArrayDims 0 > if
        target "(" io.fputs #drop
      end
      op [] .dataType op [] .val .@ArrayElement operations index isGlobal target prog compileGetIndex
      eltType typeContext types.getArrayDims 0 > if
        target ".data[0])" io.fputs #drop
      end
      target ")" io.fputs #drop
      break
    getTupleElement case
      op [] .dataType op [] .val .getTupleElement false operations index isGlobal target prog compileGetElt
      return
    setTupleElement case
      op [] .dataType op [] .val .setTupleElement false operations index isGlobal target prog compileGetElt
      target " = " io.fputs #drop
      operations index isGlobal target prog compileOp
      target ";\n" io.fputs #drop
      return
    @TupleElement case
      target "(&" io.fputs #drop
      op [] .dataType op [] .val .@TupleElement typeContext types.compositeGetElement =:: eltType
      eltType typeContext types.getArrayDims 0 > if
        target "(" io.fputs #drop
      end
      op [] .dataType op [] .val .@TupleElement false operations index isGlobal target prog compileGetElt
      eltType typeContext types.getArrayDims 0 > if
        target ".data[0])" io.fputs #drop
      end
      target ")" io.fputs #drop
      return
    getEnumElement case
      op [] .dataType op [] .val .getEnumElement true operations index isGlobal target prog compileGetElt
      return
    setEnumElement case
      op [] .dataType op [] .val .setEnumElement true operations index isGlobal target prog compileGetElt
      target " = " io.fputs #drop
      operations index isGlobal target prog compileOp
      target ";\n" io.fputs #drop
      return
    @EnumElement case
      target "(&" io.fputs #drop
      op [] .dataType typeContext types.getArrayDims 0 > if
        target "(" io.fputs #drop
      end
      op [] .dataType op [] .val .@EnumElement true operations index isGlobal target prog compileGetElt
      op [] .dataType typeContext types.getArrayDims 0 > if
        target ".data[0])" io.fputs #drop
      end
      target ")" io.fputs #drop
      return
    block case
      op [] .val .block .blockType switch
        UNKNOWN PROCEDURE case
          ## XXX error message
          break
        IF case
          target "if(" io.fputs #drop
          operations index isGlobal target prog compileOp
          target "){\n" io.fputs #drop
          return
        ELSE case
          target "}else{\n" io.fputs #drop
          return
        WHILE case
          target "do{\n" io.fputs #drop
          return
        DO case
          target "if(!" io.fputs #drop
          operations index isGlobal target prog compileOp
          target ")\n  break;\n" io.fputs #drop
          return
        BREAK case
          target "break;\n" io.fputs #drop
          return
        CONTINUE case
          target "continue;\n" io.fputs #drop
          return
        SWITCH case
          target "switch(" io.fputs #drop
          operations index isGlobal target prog compileOp
          op [] .dataType typeContext types.isEnum if ## TODO empty enums
            target ".label" io.fputs #drop
          end
          target "){\n" io.fputs #drop
          return
        CASE case
          prog [] .switchData op [] .val .block .blockId list.at
            #dup optional.isEmpty if #drop
              ## TODO error message
              return
            end
          .data =:: switchData
          switchData [] .cases op [] .val .block .subId list.at .data =:: caseData
          64 sb.create
            0 while #dup caseData [] .count < do
              #swap
                "case " sb.appendS
                switchData [] .labels #over:2 caseData [] .offset + list.get .value =:: caseVal
                caseVal switch
                  int case caseVal .int sb.appendI break
                  chr case caseVal .chr sb.appendI break
                  enumLabel case caseVal .enumLabel sb.appendI break
                  none wildCard boolean genericArg templateArg str typeId arrayConstant case
                    ## TODO error message
                    break
                end
                ":" sb.appendS
              #swap 1 +
            end #drop
            ";\n" sb.appendS
            target #over io.fputSb #drop
          sb.free #drop
          break
        DEFAULT case
          target "default:;\n" io.fputs #drop
          return
      end
      break
    blockEnd case
      op [] .val .blockEnd .blockType switch
        UNKNOWN BREAK CONTINUE SWITCH case
          ## XXX error message
          break
        PROCEDURE IF ELSE WHILE CASE DEFAULT case
          target "}\n" io.fputs #drop
          return
        DO case
          target "}while(1);\n" io.fputs #drop
          return
      end
      break
    Return case
      op [] .dataType typeContext types.getProcOut #drop =:: retType
      retType typeContext types.compositeEltCount =:: retCount
      retCount 0 == if
        target "return;\n" io.fputs #drop
        return
      end
      retCount 1 == if
        target "return " io.fputs #drop
        operations index isGlobal target prog compileOp
        target ";\n" io.fputs #drop
        return
      end
      target "return " io.fputs #drop
      retType operations index isGlobal target prog compileCreateTuple
      target ";\n" io.fputs #drop
      return
    argc case
      64 sb.create
        CONCAT_PREFIX sb.appendS
        ARGC_NAME     sb.appendS
        target #over io.fputSb #drop
      sb.free #drop
      return
    getArg case
      target "((" io.fputs #drop
      op [] .dataType target prog printTypeName
      64 sb.create
        ")" sb.appendS
        CONCAT_PREFIX      sb.appendS
        ARGV_NAME          sb.appendS
        "["                sb.appendS
        target #over io.fputSb #drop
      sb.clear
        operations index isGlobal target prog compileOp
        "])"               sb.appendS
        target #over io.fputSb #drop
      sb.free #drop
      return
    getArgLen case
      target "((" io.fputs #drop
      op [] .dataType target prog printTypeName
      64 sb.create
        ")strlen("  sb.appendS
        CONCAT_PREFIX        sb.appendS
        ARGV_NAME            sb.appendS
        "["                  sb.appendS
        target #over io.fputSb #drop
      sb.clear
        operations index isGlobal target prog compileOp
        "]))"                sb.appendS
        target #over io.fputSb #drop
      sb.free #drop
      return
    setEnumLabel case
      operations index isGlobal target prog compileOp
      32 sb.create
        ".label = "       sb.appendS
        op [] .val .setEnumLabel sb.appendI
        ";\n"        sb.appendS
        target #over io.fputSb #drop
      sb.free #drop
      return
    checkEnumLabel case
      64 sb.create
        CONCAT_PREFIX   sb.appendS
        CHECK_ENUM_NAME sb.appendS
        "("             sb.appendS
        target #over io.fputSb #drop
      sb.clear
        operations index isGlobal target prog compileOp
        ".label,"       sb.appendS
        op [] .val .checkEnumLabel sb.appendI
        ",\""           sb.appendS
        op [] .pos      sb.appendPos
        "\");\n"        sb.appendS
        target #over io.fputSb #drop
      sb.free #drop
      return
    checkArrayIndex case
      64 sb.create
        CONCAT_PREFIX   sb.appendS
        CHECK_INDEX_NAME sb.appendS
        "("             sb.appendS
        op [] .val .checkArrayIndex
        #dup -1 == if #drop
          target #over io.fputSb #drop
      sb.clear
          operations index isGlobal target prog compileOp
        else
          sb.appendI
        end
        ","         sb.appendS
        target #over io.fputSb #drop
      sb.clear
        operations index isGlobal target prog compileOp
        ",\""       sb.appendS
        op [] .pos  sb.appendPos
        "\");\n"    sb.appendS
        target #over io.fputSb #drop
      sb.free #drop
      return
    entryPoint case
      64 sb.create
        "static void " sb.appendS
        CONCAT_PREFIX  sb.appendS
        MAIN_NAME      sb.appendS
        "(void){\n"    sb.appendS
        target #over io.fputSb #drop
      sb.free #drop
      return
    unreachable case
      ## XXX? printf-statement for error message
      target "exit(EXIT_FAILURE);//unreachable\n" io.fputs #drop
      return
    compilerInfo case
      break
    getName setName @Name getLabel setLabel @Label length size stackMod case
      break ## XXX error message
  end
end

proc( io.FILE : target Program ptr mut : prog => ) =: public compileToC
  prog [] .idContext @ =:: idContext
  idContext [] .labelContext @ =:: labelContext
  idContext [] .typeContext @ =:: typeContext
  target printHeader
  target prog printTypes
  ## TODO initialize string data
  prog [] .hasEntryPoint if
    64 sb.create
      "static void " sb.appendS
      CONCAT_PREFIX  sb.appendS
      MAIN_NAME      sb.appendS
      "(void);\n"    sb.appendS
      target #over io.fputSb #drop
    sb.free #drop
  end
  prog [] .hasGetArgs if
    64 sb.create
      "static int " sb.appendS
      CONCAT_PREFIX sb.appendS
      ARGC_NAME     sb.appendS
      ";\n"         sb.appendS
      target #over io.fputSb #drop
    sb.clear
      "static char** " sb.appendS
      CONCAT_PREFIX    sb.appendS
      ARGV_NAME        sb.appendS
      ";\n"            sb.appendS
      target #over io.fputSb #drop
    sb.free #drop
  end
  prog [] .hasCheckIndex if
    64 sb.create
      "static void " sb.appendS
      CONCAT_PREFIX  sb.appendS
      CHECK_INDEX_NAME sb.appendS
      "(int64_t length,int64_t index,char const* pos){\n" sb.appendS
      "  if(index>=0 && index<length)\n    return;\n" sb.appendS
      "  fprintf(stderr,\"array index out of bounds: %\"PRIi64\" size: %\"PRIi64\" at %s\\n\",index,length,pos);\n" sb.appendS
      "  exit(" sb.appendS
      EXIT_CODE_ARRAY_INDEX sb.appendI
      ");\n}\n" sb.appendS
      target #over io.fputSb #drop
    sb.free #drop
  end
  prog [] .hasCheckEnum if
    64 sb.create
      "static void " sb.appendS
      CONCAT_PREFIX  sb.appendS
      CHECK_ENUM_NAME sb.appendS
      "(int64_t current,int64_t expected,char const* pos){\n" sb.appendS
      "  if(current==expected)\n    return;\n" sb.appendS
      "  fprintf(stderr,\"enum index (%\"PRIi64\") does not match current value (%\"PRIi64\") at %s\\n\",expected,current,pos);\n" sb.appendS
      "  exit(" sb.appendS
      EXIT_CODE_ENUM_INDEX sb.appendI
      ");\n}\n" sb.appendS
      target #over io.fputSb #drop
    sb.free #drop
  end
  target "//declarations\n" io.fputs #drop
  prog [] .idContext .globalScope .identifiers @ map.itr.start while map.itr.hasNext do map.itr.next
    =:: declaration ## TODO find out which declarations are actually used
    declaration .1 [] .valueType =:: mut mType
    declaration .1 [] .labelId labelContext id.labelFlags =:: labelFlags
    mType types.primitive.TYPE types.typeEquals if
      continue
    end
     mType types.isAutoType if
      prog [] .autoTypes
        mType types.getTypeId
      list.at .data []
      mType =
    end
    declaration .1 [] .templateId -1 != if
      labelFlags id.FLAG_EXTERN & 0 != if
        ## TODO error message
        continue
      end
      idContext [] .templateInfos declaration .1 [] .templateId
      list.at .data =:: templateInfo
      0 while #dup templateInfo [] .implementations .length < do
        templateInfo [] .implementations #over list.at .data [] .implType mType =
        mType typeContext types.getProcOut #drop target prog printTypeName
      target " " io.fputs #drop
      declaration .1 [] .labelId #over target prog printGlobalName
      mType false target prog printProcArgs
      target ";\n" io.fputs #drop
        1 +
      end #drop
      continue
    end
    labelFlags id.FLAG_EXTERN & 0 != if
      target "extern " io.fputs #drop
    end
    mType typeContext types.isProcedure if
      mType typeContext types.getProcOut #drop target prog printTypeName
      target " " io.fputs #drop
      declaration .1 [] .labelId -1 target prog printGlobalName
      mType false target prog printProcArgs
      target ";\n" io.fputs #drop
      continue
    end
    mType target prog printTypeName
    target " " io.fputs #drop
    labelFlags id.FLAG_MUTABLE & 0 == if
      target "const " io.fputs #drop
    end
    declaration .1 [] .labelId -1 target prog printGlobalName
    target ";\n" io.fputs #drop
  end #drop
  ## TODO global declarations
  0 while #dup prog [] .progFiles .length < do
    prog [] .progFiles #over list.at .data =:: f
    64 sb.create
      "// " sb.appendS
      f [] .fileName sb.appendSb
      "\n"    sb.appendS
      target #over io.fputSb #drop
    sb.free #drop
    f [] .globalOps .length 0 > if
      target "//global\n" io.fputs #drop
    end
    0 =:: mut index
    while index f [] .globalOps .length < do
      f [] .globalOps list.asArray index @ true target prog compileOp
    end
    f [] .localOps .length 0 > if
      target "//local\n" io.fputs #drop
    end
    0 index =
    while index f [] .localOps .length < do
      f [] .localOps list.asArray index @ false target prog compileOp
    end
    f [] .templateOps .length 0 > if
      target "//templates\n" io.fputs #drop
    end
    0 index =
    while index f [] .templateOps .length < do
      f [] .templateOps list.asArray index @ false target prog compileOp
    end
    1 +
  end #drop
  prog [] .hasEntryPoint ! if
    return
  end
  prog [] .hasGetArgs if
    128 sb.create
      "int main(int argc,char** argv){\n" sb.appendS
      CONCAT_PREFIX sb.appendS
      ARGC_NAME     sb.appendS
      "=argc;\n"    sb.appendS
      CONCAT_PREFIX sb.appendS
      ARGV_NAME     sb.appendS
      "=argv;\n"    sb.appendS
      target #over io.fputSb #drop
    sb.free #drop
  else
    target "int main(void){\n" io.fputs #drop
  end
  64 sb.create
    CONCAT_PREFIX sb.appendS
    MAIN_NAME     sb.appendS
    "();\n"       sb.appendS
    "return EXIT_SUCCESS;\n}\n" sb.appendS
    target #over io.fputSb #drop
  sb.free #drop
end
