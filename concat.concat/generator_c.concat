import stringIO

import "program.concat"
import "measure.concat"

"concat_" =:: CONCAT_PREFIX ## TODO? shorten to cct_ (current name for compatibility with old library C code)
## XXX? use separate prefix for extern procedures
"concatInternal_argc"      =:: ARGC_NAME
"concatInternal_argv"      =:: ARGV_NAME
"concatInternal_checkArrayIndex" =:: CHECK_INDEX_NAME
"concatInternal_checkEnumIndex"  =:: CHECK_ENUM_NAME
"concatInternal_charNames"       =:: CHARNAMES_NAME
1 =:: EXIT_CODE_ARRAY_INDEX
2 =:: EXIT_CODE_ENUM_INDEX

proc( io.FILE : target -> ) =>: printHeader
  target
    ..dup "#include <stdlib.h>\n" io.fputs ..drop
    ..dup "#include <stdio.h>\n" io.fputs ..drop
    ..dup "#include <inttypes.h>\n" io.fputs ..drop
    ..dup "#include <string.h>\n" io.fputs ..drop
    ..dup "#include <stdbool.h>\n" io.fputs ..drop
    ..dup "#include <math.h>\n" io.fputs ..drop ## fmod, NAN, infinity XXX? don't include when not needed
  ..drop
end

proc( LabelId : label i32 : implId io.FILE : target ProgramContext ptr mut : prog -> ) =>: printGlobalName
  prog [] .idContext .typeContext .labelContext @ =:: labelContext
  128 sb.create
    label labelContext id.labelFlags id.FLAG_EXTERN & ? if ## use unmodified name for extern values
      label labelContext sb.appendLabelName
        target ..over io.fputSb ..drop
      sb.free ..drop
      return
    end
    CONCAT_PREFIX sb.appendS
    label labelContext id.labelFlags id.FLAG_EXPORT & 0 == if
      label labelContext id.getLabelFile sb.appendI
      "_F" sb.appendS
    end
    label labelContext id.getLabelNamespace =:: mut mNamespace
    while mNamespace id.NAMESPACE_ID_NONE != mNamespace 0 > & do
      mNamespace labelContext id.namespaceName labelContext sb.appendAsciifiedStringConst
      "." string.wrap sb.appendAsciified
      mNamespace labelContext id.parentNamespace mNamespace =
    end ## XXX? reverse order
    label id.LABEL_ID_NONE != if
      label labelContext sb.appendAsciifiedLabelName
    end
    implId 0 >= if
      "_I" sb.appendS
      implId sb.appendI
    end
    target ..over io.fputSb ..drop
  sb.free ..drop
end
proc( i32 : index LabelId : labelId io.FILE : target ProgramContext ptr mut : prog -> ) =>: printArgName
  prog [] .idContext .typeContext .labelContext @ =:: labelContext
  64 sb.create
    "arg" sb.appendS
    index sb.appendI
    labelId id.LABEL_ID_NONE != if
      "/*" sb.appendS
      labelId labelContext sb.appendAsciifiedLabelName
      "*/" sb.appendS
    end
    target ..over io.fputSb ..drop
  sb.free ..drop
end
proc( i32 : index LabelId : labelId io.FILE : target ProgramContext ptr mut : prog -> ) =>: printOutArgName
  prog [] .idContext .typeContext .labelContext @ =:: labelContext
  64 sb.create
    "out" sb.appendS
    index sb.appendI
    labelId id.LABEL_ID_NONE != if
      "/*" sb.appendS
      labelId labelContext sb.appendAsciifiedLabelName
      "*/" sb.appendS
    end
    target ..over io.fputSb ..drop
  sb.free ..drop
end
proc( IdentifierInfo : idInfo io.FILE : target ProgramContext ptr mut : prog -> ) =>: printIdName
  prog [] .idContext .typeContext .labelContext @ =:: labelContext
  idInfo .idType switch
    PROCEDURE GLOBAL_VAR case
      idInfo .labelId idInfo .id target prog printGlobalName return
    LOCAL_VAR case
      64 sb.create
        "l" sb.appendS
        idInfo .id sb.appendI
        idInfo .labelId id.LABEL_ID_NONE != if
          "_" sb.appendS
          idInfo .labelId labelContext sb.appendAsciifiedLabelName
        end
        target ..over io.fputSb ..drop
      sb.free ..drop
      return
    TMP_VAR case
      64 sb.create
        "tmp" sb.appendS
        idInfo .id sb.appendI
        target ..over io.fputSb ..drop
      sb.free ..drop
      return
    ARGUMENT case
      idInfo .id idInfo .labelId target prog printArgName
      return
    TYPE TEMPLATE_ARG LABEL PROCEDURE_BUNDLE case
      break ## XXX? error message
  end
end
proc( string : name i32 : id io.FILE : target -> ) =>: printCompositeName
  128 sb.create
    CONCAT_PREFIX sb.appendS
    name  sb.appendStr
    id    sb.appendI
    target ..over io.fputSb ..drop
  sb.free ..drop
end
proc( Type : t io.FILE : target ProgramContext ptr mut : prog -> ) =>: printTypeName
  prog [] .idContext .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  t switch
    undefined empty templateType genericType case ## no global type necessary
      target "void" io.fputs ..drop
      break
    primitiveType case
      t .primitiveType switch
        TYPE    case target "size_t"  io.fputs ..drop break
        BOOL    case target "bool"    io.fputs ..drop break
        I8      case target "int8_t"  io.fputs ..drop break
        I16     case target "int16_t" io.fputs ..drop break
        I32     case target "int32_t" io.fputs ..drop break
        I64     case target "int64_t" io.fputs ..drop break
        FLOAT32 case target "float"   io.fputs ..drop break
        FLOAT64 case target "double"  io.fputs ..drop break
      end
      break
    cType case
      t .cType switch
        VOID       case target "void"               io.fputs ..drop break
        BOOL       case target "bool"               io.fputs ..drop break
        CHAR       case target "char"               io.fputs ..drop break
        S_CHAR     case target "signed char"        io.fputs ..drop break
        U_CHAR     case target "unsigned char"      io.fputs ..drop break
        SHORT      case target "short"              io.fputs ..drop break
        U_SHORT    case target "unsigned short"     io.fputs ..drop break
        INT        case target "int"                io.fputs ..drop break
        U_INT      case target "unsigned int"       io.fputs ..drop break
        LONG       case target "long"               io.fputs ..drop break
        U_LONG     case target "unsigned long"      io.fputs ..drop break
        LONGLONG   case target "long long"          io.fputs ..drop break
        U_LONGLONG case target "unsigned long long" io.fputs ..drop break
        SIZE       case target "size_t"             io.fputs ..drop break
        FLOAT      case target "float"              io.fputs ..drop break
        DOUBLE     case target "double"             io.fputs ..drop break
      end
      break
    arrayIndex case
      target "int64_t" io.fputs ..drop break
    autoType case
      break ## XXX? resolve auto-types
    pointer reference mutableReference case
      t typeContext types.getBaseType target prog printTypeName
      t typeContext types.isCallable if
        break
      end
      t typeContext types.isMutable ! if
        target " const" io.fputs ..drop
      end
      target "*" io.fputs ..drop
      break
    procIn case
      ## XXX? print proc-in
      break
    arrayType case
      "array" string.wrap t .arrayType target printCompositeName
      break
    struct case
      "tuple" string.wrap t .struct target printCompositeName
      break
    union case
      "union" string.wrap t .union target printCompositeName
      break
    procOut case
      t typeContext types.compositeEltCount =:: eltCount
      eltCount 0 == if
        target "void" io.fputs ..drop
        break
      end
      eltCount 1 == if
        t 0 typeContext types.compositeGetElement target prog printTypeName
        break
      end
      "tuple" string.wrap t .procOut target printCompositeName
      break
    enum case
      "enum" string.wrap t .enum target printCompositeName
      break
    procedure case
      "proc" string.wrap t .procedure target printCompositeName
      break
    namedType case
      t typeContext types.namedTypeName  t typeContext types.getImplId  target prog printGlobalName
      break
    generatedType case
      t typeContext types.getGeneratedType target prog printTypeName
      break
  end
end
proc( Type : t io.FILE : target ProgramContext ptr mut : prog -> ) =>: printUnsignedTypeName
  prog [] .idContext .typeContext @ =:: typeContext
  t typeContext types.isInt ! if
    t target prog printTypeName
    return
  end
  t typeContext types.unwrapNamed .primitiveType switch
    TYPE    case target "size_t"   io.fputs ..drop break
    BOOL    case target "bool"     io.fputs ..drop break
    I8      case target "uint8_t"  io.fputs ..drop break
    I16     case target "uint16_t" io.fputs ..drop break
    I32     case target "uint32_t" io.fputs ..drop break
    I64     case target "uint64_t" io.fputs ..drop break
    FLOAT32 case target "float"    io.fputs ..drop break
    FLOAT64 case target "double"   io.fputs ..drop break
  end
end
proc( Type : t bool : argNames io.FILE : target ProgramContext ptr mut : prog -> ) =>: printProcArgs
  prog [] .idContext .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  t typeContext types.getCallConvention ..drop =:: callConvention
  t typeContext types.getProcIn ..drop =:: inType
  inType typeContext types.compositeElts =:: args
  t typeContext types.getProcOut ..drop =:: outType
  outType typeContext types.compositeElts =:: outTypes
  false =:: mut hasArgs
  target "(" io.fputs ..drop
  0 while ..dup args .length < do
    args ..over types.compositeElts.get typeContext types.isEmpty if ## skip empty arguments
      1 + continue
    end
    hasArgs if
      target "," io.fputs ..drop
    end
    true hasArgs =
    args ..over types.compositeElts.get target prog printTypeName
    argNames if
      target " " io.fputs ..drop
      ..dup inType ..over typeContext types.compositeGetLabel target prog printArgName
    end
    1 +
  end ..drop
  callConvention .POINTER ?? if
    outTypes .length =:: mut N
    N 0 > if outTypes N 1 - types.compositeElts.get typeContext types.isSmallType if
      N 1 - N =
    end end
    0 while ..dup N < do
      outTypes ..over types.compositeElts.get typeContext types.isEmpty if ## skip empty arguments
        1 + continue
      end
      hasArgs if
        target "," io.fputs ..drop
      end
      true hasArgs =
      outTypes ..over types.compositeElts.get true typeContext types.getAddressType target prog printTypeName
      argNames if
        target " " io.fputs ..drop
        ..dup outType ..over typeContext types.compositeGetLabel target prog printOutArgName
      end
      1 +
    end ..drop
  end
  hasArgs ! if
    target "void" io.fputs ..drop
  end
  target ")" io.fputs ..drop
end
proc( string : name i32 : id string : cName io.FILE : target -> ) =>: printCompositeDeclaration
  128 sb.create
    "typedef " sb.appendS
    cName sb.appendStr
    ' '   sb.appendC
    CONCAT_PREFIX sb.appendS
    name  sb.appendStr
    id    sb.appendI
    ' '   sb.appendC
    CONCAT_PREFIX sb.appendS
    name  sb.appendStr
    id    sb.appendI
    ";\n" sb.appendS
    target ..over io.fputSb ..drop
  sb.free ..drop
end
proc( Type : composite i32 : index io.FILE : target ProgramContext ptr mut : prog -> ) =>: printEltName
  prog [] .idContext .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  64 sb.create
    "e" sb.appendS
    index sb.appendI
    composite index typeContext types.compositeGetLabel =:: labelId
    labelId id.LABEL_ID_NONE != if
      "_" sb.appendS
      labelId labelContext sb.appendAsciifiedLabelName
    end
    target ..over io.fputSb ..drop
  sb.free ..drop
end
proc( Type : composite io.FILE : target ProgramContext ptr mut : prog -> ) =>: printCompositeElements
  prog [] .idContext .typeContext @ =:: typeContext
  composite typeContext types.compositeElts =:: elts
  0 while ..dup elts .length < do
    elts ..over types.compositeElts.get ..dup typeContext types.isEmpty if ## skip empty types
      ..drop 1 + continue
    end target prog printTypeName
    target " " io.fputs ..drop
    composite ..over target prog printEltName
    target ";\n" io.fputs ..drop
    1 +
  end ..drop
end
proc( io.FILE : target ProgramContext ptr mut : prog -> ) =>: printTypes
  prog [] .idContext .typeContext @ =:: typeContext
  prog getDeclaredTypes =:: types
  target "//type declarations\n" io.fputs ..drop
  ## declare types
  0 while ..dup types .length < do
    types ..over list.get =:: t
    t switch
      undefined empty primitiveType autoType templateType genericType generatedType
        procedure procIn reference mutableReference arrayIndex cType case
        ## no global type necessary
        break
      pointer case
        t typeContext types.isCallable if ## procedure pointer
          t typeContext types.getBaseType =:: base
          target "typedef " io.fputs ..drop
          base typeContext types.getProcRet ..drop target prog printTypeName
          32 sb.create
            " (*" sb.appendS
            CONCAT_PREFIX sb.appendS
            "proc" sb.appendS
            base types.getTypeId sb.appendI
            ") " sb.appendS
            target ..over io.fputSb ..drop
          sb.free ..drop
          base false target prog printProcArgs
          target ";\n" io.fputs ..drop
        end
        break
      arrayType case
        "array" string.wrap t .arrayType "struct" string.wrap target printCompositeDeclaration
        break
      struct case
        "tuple" string.wrap t .struct "struct" string.wrap target printCompositeDeclaration
        break
      union case
        "union" string.wrap t .union "union" string.wrap target printCompositeDeclaration
        break
      procOut case
        "tuple" string.wrap t .procOut "struct" string.wrap target printCompositeDeclaration
        break
      enum case
        "enum" string.wrap t .enum "struct" string.wrap target printCompositeDeclaration
        break
      namedType case
        t typeContext types.isProcedure if
          break ## do not generate typedefs for named procedures
        end
        target "typedef " io.fputs ..drop
        t typeContext types.unwrapNamed target prog printTypeName
        target " " io.fputs ..drop
        t typeContext types.namedTypeName  t typeContext types.getImplId  target prog printGlobalName
        target ";\n" io.fputs ..drop
        break
    end
    1 +
  end ..drop
  ## initialize composite types
  0 while ..dup types .length < do
    types ..over list.get =:: t
    t switch
      undefined empty primitiveType autoType templateType genericType generatedType procedure
          procIn pointer namedType reference mutableReference arrayIndex cType case
        ## no initialization necessary
        break
      arrayType case
        t typeContext types.isFixedSize ! if
          ## TODO add to compiler error list
          "arrays cannot be variable sized" io.puts ..drop
        end
        target "struct " io.fputs ..drop
        "array" string.wrap t .arrayType target printCompositeName
        target "{\n" io.fputs ..drop
        t typeContext types.getBaseType target prog printTypeName
        32 sb.create
          " data[" sb.appendS
          t typeContext types.getArraySize =:: sizes
          1 i64 =: mut totalSize
          0 while ..dup sizes .length < do
            ..swap
              sizes ..over.2 array.get
                ..dup .sizeType .int ?? ! if
                  "non-integer array sizes should not exist at this stage of compilation" io.puts ..drop
                end
              .value totalSize * totalSize =
            ..swap 1 +
          end ..drop
          totalSize sb.appendI
          "];\n};\n" sb.appendS
          target ..over io.fputSb ..drop
        sb.free ..drop
        break
      struct case
        target "struct " io.fputs ..drop
        "tuple" string.wrap t .struct target printCompositeName
        target "{\n" io.fputs ..drop
        t target prog printCompositeElements
        target "};\n" io.fputs ..drop
        break
      procOut case
        target "struct " io.fputs ..drop
        "tuple" string.wrap t .procOut target printCompositeName
        target "{\n" io.fputs ..drop
        t target prog printCompositeElements
        target "};\n" io.fputs ..drop
        break
      enum case
        target "struct " io.fputs ..drop
        "enum" string.wrap t .enum target printCompositeName
        target "{\n" io.fputs ..drop
        t typeContext types.compositeFlags types.COMP_FLAG_EMPTY & 0 == if
          target "union{\n" io.fputs ..drop
          t target prog printCompositeElements
          target "}data;\n" io.fputs ..drop
        end
        target "int32_t label;\n};\n" io.fputs ..drop ## XXX smaller int-type for smaller label count
        break
      union case
        target "union " io.fputs ..drop
        "union" string.wrap t .union target printCompositeName
        target "{\n" io.fputs ..drop
        t target prog printCompositeElements
        target "};\n" io.fputs ..drop
        break
    end
    1 +
  end ..drop
  types list.free ..drop
end
proc( BinaryOperator -> bool ) =>: isUnsignedOp
  switch
    ADD SUBTRACT MULTIPLY DIVIDE MOD
    AND OR XOR LSHIFT RSHIFT
    EQ NE LE GE LT GT case
      false return
    UDIVIDE UMOD URSHIFT ULE UGE ULT UGT case
      true return
  end
end
proc( BinaryOperator -> bool ) =>: isArithimeticOp
  switch
    ADD SUBTRACT MULTIPLY DIVIDE UDIVIDE MOD UMOD
    AND OR XOR LSHIFT RSHIFT URSHIFT case
      true return
     EQ NE LE GE LT GT ULE UGE ULT UGT case
      false return
  end
end
## XXX? compiler context
proc( Type : t i64 : argCount Operation arrayView : operations i32 ptr mut : index bool : isGlobal io.FILE : target ProgramContext ptr mut : prog -> ) =>:  compileCall
  prog [] .idContext .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  t typeContext types.getProcRet ..drop =:: retType
  retType typeContext types.isProcOut if
   retType typeContext types.compositeEltCount
  else retType typeContext types.isEmpty _if 0i64 else 1i64 end =:: retCount
  target "(" io.fputs ..drop
  0 while ..dup argCount < do
    ..dup 0 > if
      target "," io.fputs ..drop
    end
    operations index isGlobal target prog compileOp
    1 +
  end ..drop
  target ")" io.fputs ..drop
  retCount 0 == if
    target ";\n" io.fputs ..drop
  end
end
proc( Type : base i32 : eltIndex Operation arrayView : operations i32 ptr mut : index bool : isGlobal io.FILE : target ProgramContext ptr mut : prog -> ) =>:  compileGetElt
  prog [] .idContext .typeContext @ =:: typeContext
  target "(" io.fputs ..drop
  operations index isGlobal target prog compileOp
  base typeContext types.isEnum if
    target ".data." io.fputs ..drop
  else
    target "." io.fputs ..drop
  end
  base eltIndex target prog printEltName
  target ")" io.fputs ..drop
end
proc( Type : base i32 : dims Operation arrayView : operations i32 ptr mut : index bool : isGlobal io.FILE : target ProgramContext ptr mut : prog -> ) =>:  compileGetIndex
  prog [] .idContext .typeContext @ =:: typeContext
  dims 0 == if
    target "(*" io.fputs ..drop
    operations index isGlobal target prog compileOp
    target ")" io.fputs ..drop
    return
  end
  base typeContext types.getArraySize =:: sizes
  target "(" io.fputs ..drop
  operations index isGlobal target prog compileOp
  64 sb.create
    "[" sb.appendS
    target ..over io.fputSb ..drop
    sb.clear
      0 while ..dup dims 1 - < do
        ..swap
          "(" sb.appendS
        ..swap 1 +
      end ..drop
      target ..over io.fputSb ..drop
      sb.clear
      0 while ..dup dims < do
        operations index isGlobal target prog compileOp
        ..dup dims 1 - < if
          ..dup sizes .length >= if ..drop.2
            "number of indices exceeds dimension" sb.wrap operations index [] 1 - array.at .data [] .pos prog [] .errors @ appendError
            return
          end
          ..swap
            "*" sb.appendS
            sizes ..over.2 array.get .value sb.appendI
            ")+" sb.appendS
            target ..over io.fputSb ..drop
            sb.clear
          ..swap
        end
        1 +
      end ..drop
    "])" sb.appendS
    target ..over io.fputSb ..drop
  sb.free ..drop
end
proc( Type : composite Operation arrayView : operations i32 ptr mut : index bool : isGlobal io.FILE : target ProgramContext ptr mut : prog -> ) =>: compileCreateTuple
  prog [] .idContext .typeContext @ =:: typeContext
  composite typeContext types.compositeElts =:: elts
  isGlobal ! if
    target "((" io.fputs ..drop
    composite target prog printTypeName
    target ")" io.fputs ..drop
  end
  target "{" io.fputs ..drop
  0 while ..dup elts .length < do
    ..dup 0 > if
      target "," io.fputs ..drop
    end
    elts ..over types.compositeElts.get typeContext types.isEmpty if ## skip empty types
      1 + continue
    end
    target "." io.fputs ..drop
    composite ..over target prog printEltName
    target " = " io.fputs ..drop
    operations index isGlobal target prog compileOp
    1 +
  end ..drop
  isGlobal if
    target "}" io.fputs ..drop
  else
    target "})" io.fputs ..drop
  end
end
proc( Type : constType bool : isGlobal io.FILE : target ProgramContext ptr mut : prog -> stringBuilder ) =>: constStart
  64 sb.create
    isGlobal ! if
      "((" sb.appendS
      target ..over io.fputSb ..drop
      sb.clear
      constType target prog printTypeName
      ")" sb.appendS
    end
  return
end
proc( stringBuilder : sb bool : isGlobal io.FILE : target ProgramContext ptr mut : prog -> ) =>: constEnd
  sb
    isGlobal ! if
      ")" sb.appendS
    end
    target ..over io.fputSb ..drop
  sb.free ..drop
end

proc( Type : constType ConstValue : const bool : isGlobal io.FILE : target ProgramContext ptr mut : prog -> ) =>: compileConstant
  prog [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  const switch
    boolean case
      const .boolean if
        target "true" io.fputs ..drop
      else
        target "false" io.fputs ..drop
      end
      return
    chr case
      constType isGlobal target prog constStart
        const .chr sb.appendI
      isGlobal target prog constEnd
      return
    int case
      constType typeContext types.numberSize =:: numSize
      const .int =:: mut constVal
      numSize types.primitive.I8
          typeContext types.numberSize == if
        constVal i8 cast constVal =
        i8.MIN i64 cast
      else numSize types.primitive.I16
          typeContext types.numberSize == _if
        constVal i16 cast constVal =
        i16.MIN i64 cast
      else numSize types.primitive.I32
          typeContext types.numberSize == _if
        constVal i32 cast constVal =
        i32.MIN i64 cast
      else
        i64.MIN
      end =:: minVal
      constType isGlobal target prog constStart
        constVal minVal == if
          '(' sb.appendC
          constVal 1 + sb.appendI
          "-1)" sb.appendS
        else
          constVal sb.appendI
        end
      isGlobal target prog constEnd
      return
    Float case
      constType isGlobal target prog constStart
      const .Float sb.appendIeeeDouble
      isGlobal target prog constEnd
      return
    enumLabel case
      constType isGlobal target prog constStart
        "{.label=" sb.appendS
        const .enumLabel sb.appendI
        "}" sb.appendS
      isGlobal target prog constEnd
      return
    typeId case
      constType isGlobal target prog constStart
        "sizeof(" sb.appendS
        target ..over io.fputSb ..drop
        sb.clear
        const .typeId target prog printTypeName
        ")" sb.appendS
      isGlobal target prog constEnd
      return
    str case ## TODO string constants
      constType false target prog constStart ## treat all strings as global constants (cast to int8_t*)
      '"' sb.appendC
      const .str labelContext sb.appendEscapedStrC
      '"' sb.appendC
      false target prog constEnd
      break
    arrayConstant case const .arrayConstant idContext [] .constContext @ constArrayAsArray =:: mArray
      constType typeContext types.getBaseType =:: baseType
      constType isGlobal target prog constStart
      "{.data={" sb.appendS
      0 while ..dup mArray .length < do
        ..swap
        ..over 0 > if
          ',' sb.appendC
        end
        target ..over io.fputSb ..drop
        sb.clear
        baseType mArray ..over.3 array.get isGlobal target prog compileConstant
        ..swap 1 +
      end ..drop
      "}}" sb.appendS
      isGlobal target prog constEnd
      break
    genericArg case ## XXX find correct label
      const .genericArg id.LABEL_ID_NONE target prog printArgName
      return
    none wildCard templateArg procedure procedureBundle union case
      break ## XXX error message
  end
end

proc( Operation arrayView : operations i32 ptr mut : index bool : isGlobal io.FILE : target ProgramContext ptr mut : prog -> ) =>: compileOp
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  Operation ptr : mut op
  while
    index [] operations .length >= if
      ## TODO error: missing operation
      return
    end
    operations index [] array.at .data op =
    index [] 1 + index [] =
    op [] .val .NOP ??
  do end
  op [] .val switch
    NOP case
      break
    Constant case
      op [] .dataType op [] .val .Constant isGlobal target prog compileConstant
      return
    Print case
      op [] .dataType typeContext types.unwrapNamed =:: printType
      target "{//..debug.print\n" io.fputs ..drop
      printType target prog printTypeName
      target " tmpPrint = " io.fputs ..drop
      operations index isGlobal target prog compileOp
      target ";\n" io.fputs ..drop

      printType types.isPrimitive if
        printType .primitiveType switch
          BOOL case
            target "printf(\"%s\\n\",tmpPrint?\"true\":\"false\");\n" io.fputs ..drop
            break
          I8 case ## XXX use stringBuilder instead of multiple writes
            target "printf(\"%\"PRIi8\" ('%.4s')\\n\",tmpPrint,&" io.fputs ..drop
            target CHARNAMES_NAME io.fputs ..drop
            target "[4*(tmpPrint&0xff)]);\n" io.fputs ..drop
            break
          I16 case
            target "printf(\"%\"PRIi16\"\\n\",tmpPrint);\n" io.fputs ..drop
            break
          I32 case
            target "printf(\"%\"PRIi32\"\\n\",tmpPrint);\n" io.fputs ..drop
            break
          I64 case
            target "printf(\"%\"PRIi64\"\\n\",tmpPrint);\n" io.fputs ..drop
            break
          FLOAT32 FLOAT64 case
            target "printf(\"%g\\n\",tmpPrint);\n" io.fputs ..drop
            break
          TYPE case ## at run-time only size of types is known
            target "printf(\"%zu\\n\",tmpPrint);\n" io.fputs ..drop
            break
        end
        target "}\n" io.fputs ..drop
        return
      end
      printType typeContext types.isPointer if
        target "printf(\"%p\\n\",(void const*)tmpPrint);\n" io.fputs ..drop
        ## XXX print values of fixed sized pointer
        target "}\n" io.fputs ..drop
        return
      end
      ## XXX print array/tuple types
      ## remove printed element
      target "}\n" io.fputs ..drop
      break
    New case
      op [] .dataType typeContext types.isTuple if
        op [] .dataType operations index isGlobal target prog compileCreateTuple
        return
      end
      op [] .dataType typeContext types.isArray if
        isGlobal ! if
          target "(" io.fputs ..drop
          op [] .dataType target prog printTypeName
          target ")" io.fputs ..drop
        end
        target "{0,}" io.fputs ..drop
        return
      end
      break
    newEnum case
      isGlobal ! if
        target "((" io.fputs ..drop
        op [] .dataType target prog printTypeName
        target ")" io.fputs ..drop
      end
      ## TODO empty enum
      64 sb.create
        "{.label="        sb.appendS
        op [] .val .newEnum sb.appendI
        op [] .dataType op [] .val .newEnum typeContext types.compositeGetElement typeContext types.isEmpty ! if
          ",.data={."         sb.appendS
          target ..over io.fputSb ..drop
          sb.clear
          op [] .dataType op [] .val .newEnum target prog printEltName
          " = "               sb.appendS
          target ..over io.fputSb ..drop
          sb.clear
          operations index isGlobal target prog compileOp
          "}"                sb.appendS
        end
        isGlobal if
          "}"                sb.appendS
        else
          "})"               sb.appendS
        end
        target ..over io.fputSb ..drop
      sb.free ..drop
      return
    unaryOperator case
      target "(" io.fputs ..drop
      op [] .val .unaryOperator switch
        NOT case
          target "!" io.fputs ..drop
          operations index isGlobal target prog compileOp
          break
        NEGATE case
          target "-" io.fputs ..drop
          operations index isGlobal target prog compileOp
          break
        FLIP case
          target "~" io.fputs ..drop
          operations index isGlobal target prog compileOp
          break
        TO_BOOL case
          target "!!" io.fputs ..drop
          operations index isGlobal target prog compileOp
          break
      end
      target ")" io.fputs ..drop
      return
    binaryOperator case
      op [] .val .binaryOperator .MOD ?? op [] .dataType typeContext types.isFloat & if ## float mod
        op [] .dataType typeContext types.unwrapNamed .primitiveType switch
          FLOAT32 case target "fmodf" io.fputs ..drop break
          FLOAT64 case target "fmod" io.fputs ..drop break
          BOOL I8 I16 I32 I64 TYPE case ..unreachable
        end
        target "(" io.fputs ..drop
        operations index isGlobal target prog compileOp
        target "," io.fputs ..drop
        operations index isGlobal target prog compileOp
        target ")" io.fputs ..drop
        return
      end
      target "(" io.fputs ..drop
      op [] .val .binaryOperator isArithimeticOp if ## ensure number operations have right type
        ## compensates for automatic conversion of shorts to int in C
        target "(" io.fputs ..drop
        op [] .dataType target prog printTypeName
        target ")(" io.fputs ..drop
      end
      op [] .val .binaryOperator isUnsignedOp if
        target "((" io.fputs ..drop
        op [] .dataType target prog printUnsignedTypeName
        target ")" io.fputs ..drop
        operations index isGlobal target prog compileOp
        target ")" io.fputs ..drop
      else
        operations index isGlobal target prog compileOp
      end
      op [] .dataType typeContext types.isEnum if
        target ".label" io.fputs ..drop
      end
      op [] .val .binaryOperator switch
        ADD case target "+" io.fputs ..drop break
        SUBTRACT case target "-" io.fputs ..drop break
        MULTIPLY case target "*" io.fputs ..drop break
        DIVIDE UDIVIDE case target "/" io.fputs ..drop break
        MOD UMOD case target "%" io.fputs ..drop break
        AND case target "&" io.fputs ..drop break
        OR case target "|" io.fputs ..drop break
        XOR case target "^" io.fputs ..drop break
        LSHIFT case target "<<" io.fputs ..drop break
        RSHIFT URSHIFT case target ">>" io.fputs ..drop break
        EQ case target "==" io.fputs ..drop break
        NE case target "!=" io.fputs ..drop break
        LE ULE case target "<=" io.fputs ..drop break
        GE UGE case target ">=" io.fputs ..drop break
        LT ULT case target "<" io.fputs ..drop break
        GT UGT case target ">" io.fputs ..drop break
      end
      op [] .val .binaryOperator isUnsignedOp if
        target "((" io.fputs ..drop
        op [] .dataType target prog printUnsignedTypeName
        target ")" io.fputs ..drop
        operations index isGlobal target prog compileOp
        target ")" io.fputs ..drop
      else
        operations index isGlobal target prog compileOp
      end
      op [] .dataType typeContext types.isEnum if
        target ".label" io.fputs ..drop
      end
      op [] .val .binaryOperator isArithimeticOp if
        target ")" io.fputs ..drop
      end
      target ")" io.fputs ..drop
      return
    Cast Cast! case
      op [] .val .Cast! ?? if op [] .val .Cast! else op [] .val .Cast end =:: src
      src typeContext types.unwrapNamed op [] .dataType typeContext types.unwrapNamed types.typeEquals if
        operations index isGlobal target prog compileOp ## cast type to itself
        return
      end
      op [] .dataType typeContext types.isUnion if
        isGlobal ! if
          target "((" io.fputs ..drop
          op [] .dataType target prog printTypeName
          target ")" io.fputs ..drop
        end
        target "{." io.fputs ..drop
        op [] .dataType src typeContext types.findUnionTypeIndex if
          "cannot store values of type \"" sb.wrap
            src typeContext sb.appendType
            "\" in " sb.appendS
            op [] .dataType typeContext sb.appendType
          op [] .pos prog [] .errors @ appendError
        end
        op [] .dataType ..swap target prog printEltName
        target "=" io.fputs ..drop
        operations index isGlobal target prog compileOp
        target "}" io.fputs ..drop
        isGlobal ! if
          target ")" io.fputs ..drop
        end
        return ## unknown cast
      end
      src typeContext types.isArray if
        op [] .dataType typeContext types.isPointer if ## array -> pointer
          target "((" io.fputs ..drop
          op [] .dataType target prog printTypeName
          target ")" io.fputs ..drop
          operations index isGlobal target prog compileOp
          target ".data)" io.fputs ..drop
          return
        end
        break ## unknown cast
      end
      src typeContext types.isEnum if #+TODO emtpy enums, optional pointer+#
        op [] .dataType typeContext types.isInt if ## enum ->int
          target "((" io.fputs ..drop
          op [] .dataType target prog printTypeName
          target ")" io.fputs ..drop
          operations index isGlobal target prog compileOp
          target ".label)" io.fputs ..drop
        end
        break ## unknown cast
      end
      target "((" io.fputs ..drop
      op [] .dataType target prog printTypeName
      target ")" io.fputs ..drop
      operations index isGlobal target prog compileOp
      target ")" io.fputs ..drop
      return
    getId case
      op [] .val .getId =:: idInfo
      idInfo .idType switch
        LOCAL_VAR GLOBAL_VAR TMP_VAR ARGUMENT case
          op [] .dataType typeContext types.isEmpty ! if
            idInfo target prog printIdName
          end
          return
        PROCEDURE PROCEDURE_BUNDLE case
          "unexpected operation " sb.wrap
            op [] prog sb.appendOp
            " should not exist at this stage of compilation" sb.appendS
          op [] .pos prog [] .errors @ appendError
          return
        TYPE TEMPLATE_ARG LABEL case
          break ## XXX error message
      end
      break
    call_old case
      op [] .val .call_old =:: callData
      callData .idInfo target prog printIdName
      ## compileCall
        op [] .dataType
        callData .argCount
        operations
        index
        isGlobal
        target
      prog compileCall
      return
    callPtr case
      operations index isGlobal target prog compileOp
      op [] .dataType op [] .val .callPtr operations index isGlobal target prog compileCall
      return
    atId case
      op [] .val .atId =:: idInfo
      idInfo .idType switch
        LOCAL_VAR GLOBAL_VAR TMP_VAR ARGUMENT PROCEDURE case
          target "(&" io.fputs ..drop
          op [] .dataType typeContext types.getArrayDims 0 > if
            target "(" io.fputs ..drop
          end
          idInfo target prog printIdName
          op [] .dataType typeContext types.getArrayDims 0 > if
            target ".data[0])" io.fputs ..drop
          end
          target ")" io.fputs ..drop
          return
        TYPE TEMPLATE_ARG LABEL PROCEDURE_BUNDLE case
          break ## XXX error message
      end
      break
    setId case
      op [] .val .setId =:: idInfo
      idInfo .idType switch
        LOCAL_VAR GLOBAL_VAR TMP_VAR case
          idInfo target prog printIdName
          target " = " io.fputs ..drop
          operations index isGlobal target prog compileOp
          target ";\n" io.fputs ..drop
          return
        TYPE ARGUMENT TEMPLATE_ARG PROCEDURE LABEL PROCEDURE_BUNDLE case
          break ## XXX error message
      end
      break
    initializeId autoTypedInitializeId case
      op [] .val .initializeId ?? if
        op [] .val .initializeId
      else
        op [] .val .autoTypedInitializeId
      end =:: idInfo
      idInfo .labelId labelContext id.labelFlags =:: labelFlags
      labelFlags id.FLAG_MUTABLE & 0 == =:: immutable
      idInfo .idType switch
        PROCEDURE case
          labelFlags id.FLAG_EXPORT & 0 == labelFlags id.FLAG_EXTERN & 0 == & if
            target "static " io.fputs ..drop ## mark all non-exported values as static
          end
          op [] .dataType typeContext types.getProcRet ..drop target prog printTypeName
          target " " io.fputs ..drop
          idInfo .labelId  idInfo .id  target prog printGlobalName
          ## printProcArgs
            op [] .dataType
            true
            target
          prog printProcArgs
          target "{\n" io.fputs ..drop
          return
        LOCAL_VAR GLOBAL_VAR TMP_VAR case
          idInfo .idType .GLOBAL_VAR ?? labelFlags id.FLAG_EXPORT & 0 == & labelFlags id.FLAG_EXTERN & 0 == & if
            target "static " io.fputs ..drop ## mark all non-exported values as static
          end
          op [] .dataType target prog printTypeName
          immutable if
            target " const " io.fputs ..drop
          else
            target " " io.fputs ..drop
          end
          idInfo target prog printIdName
          target " = " io.fputs ..drop
          operations index isGlobal target prog compileOp
          target ";\n" io.fputs ..drop
          return
        TYPE ARGUMENT TEMPLATE_ARG LABEL PROCEDURE_BUNDLE case
          break ## XXX error message
      end
      break
    declareId case
      op [] .val .declareId =:: idInfo
      idInfo .labelId labelContext id.labelFlags =:: labelFlags
      labelFlags id.FLAG_MUTABLE & 0 == =:: immutable
      idInfo .idType switch
        PROCEDURE case
          labelFlags id.FLAG_EXPORT & 0 == labelFlags id.FLAG_EXTERN & 0 == & if
            target "static " io.fputs ..drop ## mark all non-exported values as static
          end
          op [] .dataType typeContext types.getProcRet ..drop target prog printTypeName
          target " " io.fputs ..drop
          idInfo .labelId  idInfo .id  target prog printGlobalName
          ## printProcArgs
            op [] .dataType
            false
            target
          prog printProcArgs
          target ";\n" io.fputs ..drop
          return
        LOCAL_VAR GLOBAL_VAR TMP_VAR case
          idInfo .idType .GLOBAL_VAR ?? labelFlags id.FLAG_EXPORT & 0 == & labelFlags id.FLAG_EXTERN & 0 == & if
            target "static " io.fputs ..drop ## mark all non-exported values as static
          end
          op [] .dataType target prog printTypeName
          immutable if
            target " const " io.fputs ..drop
          else
            target " " io.fputs ..drop
          end
          idInfo target prog printIdName
          target ";\n" io.fputs ..drop
          return
        TYPE ARGUMENT TEMPLATE_ARG LABEL PROCEDURE_BUNDLE case
          break ## XXX error message
      end
      break
    getArrayElement case
      op [] .dataType op [] .val .getArrayElement operations index isGlobal target prog compileGetIndex
      return
    setArrayElement case
      op [] .dataType op [] .val .setArrayElement operations index isGlobal target prog compileGetIndex
      target " = " io.fputs ..drop
      operations index isGlobal target prog compileOp
      target ";\n" io.fputs ..drop
      return
    atArrayElement case
      target "(&" io.fputs ..drop
      op [] .dataType typeContext types.getBaseType =:: eltType
      eltType typeContext types.getArrayDims 0 > if
        target "(" io.fputs ..drop
      end
      op [] .dataType op [] .val .atArrayElement operations index isGlobal target prog compileGetIndex
      eltType typeContext types.getArrayDims 0 > if
        target ".data[0])" io.fputs ..drop
      end
      target ")" io.fputs ..drop
      return
    getElement case
      op [] .dataType op [] .val .getElement operations index isGlobal target prog compileGetElt
      return
    setElement case
      op [] .dataType op [] .val .setElement operations index isGlobal target prog compileGetElt
      target " = " io.fputs ..drop
      operations index isGlobal target prog compileOp
      target ";\n" io.fputs ..drop
      return
    atElement case
      target "(&" io.fputs ..drop
      op [] .dataType op [] .val .atElement typeContext types.compositeGetElement =:: eltType
      eltType typeContext types.getArrayDims 0 > if
        target "(" io.fputs ..drop
      end
      op [] .dataType op [] .val .atElement operations index isGlobal target prog compileGetElt
      eltType typeContext types.getArrayDims 0 > if
        target ".data[0])" io.fputs ..drop
      end
      target ")" io.fputs ..drop
      return
    setValue case
      break ## TODO implement set value
    block case
      op [] .val .block .blockType switch
        UNKNOWN PROCEDURE EXPERIMENTAL_PROCEDURE INITIALIZER NAMESPACE
        TYPE_TUPLE TYPE_STRUCT TYPE_ENUM TYPE_UNION TYPE_PROC_IN TYPE_PROC_OUT TYPE_COMPOSITE case
          ## XXX error message
          break
        IF IFIF case
          target "if(" io.fputs ..drop
          operations index isGlobal target prog compileOp
          target "){\n" io.fputs ..drop
          return
        ELSE case
          "}else{\n" sb.wrap
            "else_label" sb.appendS
            op [] .val .block .blockId sb.appendI
            ":;\n" sb.appendS
            target ..over io.fputSb ..drop
          sb.free ..drop
          return
        WHILE case
          target "do{\n" io.fputs ..drop
          return
        DO case
          target "if(!" io.fputs ..drop
          operations index isGlobal target prog compileOp
          target ")\n  break;\n" io.fputs ..drop
          return
        BREAK BREAK_SWITCH case
          target "break;\n" io.fputs ..drop
          return
        CONTINUE case
          target "continue;\n" io.fputs ..drop
          return
        SWITCH case
          target "switch(" io.fputs ..drop
          operations index isGlobal target prog compileOp
          op [] .dataType typeContext types.isEnum if ## TODO empty enums
            target ".label" io.fputs ..drop
          end
          target "){\n" io.fputs ..drop
          return
        CASE case
          prog [] .switchData op [] .val .block .blockId list.at
            ..dup optional.isEmpty if ..drop
              ## TODO error message
              return
            end
          .data =:: switchData
          op [] .val .block .subId =:: caseId
          switchData [] .labels =:: labelData
          64 sb.create
            0 while ..dup labelData .length < do =:: i
              labelData i list.at .data =:: caseLabel
              caseLabel [] .caseId caseId != if
                i 1 + continue
              end
              "case " sb.appendS
              caseLabel [] .value =:: caseVal
              caseVal switch
                int case caseVal .int sb.appendI break
                chr case caseVal .chr sb.appendI break
                enumLabel case caseVal .enumLabel sb.appendI break
                none wildCard boolean genericArg templateArg str typeId arrayConstant Float procedure procedureBundle union case
                  ## TODO error message
                  break
              end
              ":" sb.appendS
              i 1 +
            end ..drop
            ";\n" sb.appendS
            target ..over io.fputSb ..drop
          sb.free ..drop
          return
        DEFAULT case
          target "default:;\n" io.fputs ..drop
          return
      end
      break
    blockEnd case
      op [] .val .blockEnd .blockType switch
        UNKNOWN BREAK BREAK_SWITCH CONTINUE SWITCH INITIALIZER IF NAMESPACE
        TYPE_TUPLE TYPE_STRUCT TYPE_ENUM TYPE_UNION TYPE_PROC_IN TYPE_PROC_OUT TYPE_COMPOSITE case
          ## XXX error message
          break
        PROCEDURE EXPERIMENTAL_PROCEDURE ELSE WHILE CASE DEFAULT case
          target "}\n" io.fputs ..drop
          return
        IFIF case
          "}else{goto else_label" sb.wrap
            op [] .val .blockEnd .blockId sb.appendI
            ";}\n" sb.appendS
            target ..over io.fputSb ..drop
          sb.free ..drop
          return
        DO case
          target "}while(1);\n" io.fputs ..drop
          return
      end
      break
    Return case
      op [] .dataType typeContext types.getProcRet ..drop =:: retType
      op [] .dataType typeContext types.getCallConvention ..drop switch
        STRUCT case break ## no changes needed
        POINTER case
          op [] .dataType typeContext types.getProcOut ..drop =:: outType
          outType typeContext types.compositeEltCount
            retType typeContext types.isEmpty ! if 1 - end
          =:: N
          N 0 == if break end
          outType typeContext types.compositeElts =:: outTypes
          0 while ..dup N < do
            outTypes ..over types.compositeElts.get typeContext types.isEmpty if
              1 + continue
            end
            outTypes ..over types.compositeElts.get typeContext types.isArray if
              target "memcpy(" io.fputs ..drop
              ..dup outType ..over typeContext types.compositeGetLabel target prog printOutArgName
              target ",(" io.fputs ..drop
              operations index isGlobal target prog compileOp
              target ").data," io.fputs ..drop
              target "sizeof(((" io.fputs ..drop
              outTypes ..over types.compositeElts.get target prog printTypeName
              target "*)0)->data));\n" io.fputs ..drop
            else
              target "*(" io.fputs ..drop
              ..dup outType ..over typeContext types.compositeGetLabel target prog printOutArgName
              target ")= " io.fputs ..drop
              operations index isGlobal target prog compileOp
              target ";\n" io.fputs ..drop
            end
            1 +
          end ..drop
          break
      end
      retType typeContext types.isProcOut if
       retType typeContext types.compositeEltCount
      else retType typeContext types.isEmpty _if 0i64 else 1i64 end =:: retCount
      retCount 0 == if
        target "return;\n" io.fputs ..drop
        return
      end
      retCount 1 == if
        target "return " io.fputs ..drop
        operations index isGlobal target prog compileOp
        target ";\n" io.fputs ..drop
        return
      end
      target "return " io.fputs ..drop
      retType operations index isGlobal target prog compileCreateTuple
      target ";\n" io.fputs ..drop
      return
    argc case
      64 sb.create
        ARGC_NAME     sb.appendS
        target ..over io.fputSb ..drop
      sb.free ..drop
      return
    getArg case
      target "((" io.fputs ..drop
      op [] .dataType target prog printTypeName
      64 sb.create
        ")" sb.appendS
        ARGV_NAME          sb.appendS
        "["                sb.appendS
        target ..over io.fputSb ..drop
      sb.clear
        operations index isGlobal target prog compileOp
        "])"               sb.appendS
        target ..over io.fputSb ..drop
      sb.free ..drop
      return
    getArgLen case
      target "((" io.fputs ..drop
      op [] .dataType target prog printTypeName
      64 sb.create
        ")strlen("  sb.appendS
        ARGV_NAME            sb.appendS
        "["                  sb.appendS
        target ..over io.fputSb ..drop
      sb.clear
        operations index isGlobal target prog compileOp
        "]))"                sb.appendS
        target ..over io.fputSb ..drop
      sb.free ..drop
      return
    setEnumLabel case
      operations index isGlobal target prog compileOp
      32 sb.create
        ".label = "       sb.appendS
        op [] .val .setEnumLabel sb.appendI
        ";\n"        sb.appendS
        target ..over io.fputSb ..drop
      sb.free ..drop
      return
    typeInfo case
      op [] .val .typeInfo switch
        ALIGNMENT case
           target "_Alignof(" io.fputs ..drop break
        SIZE STRIDE case
          target "sizeof(" io.fputs ..drop break
      end
      op [] .dataType target prog printTypeName
      target ")" io.fputs ..drop
      return
    checkEnumLabel case
      64 sb.create
        CHECK_ENUM_NAME sb.appendS
        "("             sb.appendS
        target ..over io.fputSb ..drop
      sb.clear
        operations index isGlobal target prog compileOp
        ".label,"       sb.appendS
        op [] .val .checkEnumLabel sb.appendI
        ",\""           sb.appendS
        op [] .pos      sb.appendPos
        "\");\n"        sb.appendS
        target ..over io.fputSb ..drop
      sb.free ..drop
      return
    hasElement case
      64 sb.create
        "("             sb.appendS
        target ..over io.fputSb ..drop
      sb.clear
        operations index isGlobal target prog compileOp
        ".label=="       sb.appendS
        op [] .val .hasElement sb.appendI
        ")"        sb.appendS
        target ..over io.fputSb ..drop
      sb.free ..drop
      return
    checkArrayIndex case
      64 sb.create
        CHECK_INDEX_NAME sb.appendS
        "("             sb.appendS
        op [] .val .checkArrayIndex
        ..dup -1 == if ..drop
          target ..over io.fputSb ..drop
      sb.clear
          operations index isGlobal target prog compileOp
        else
          sb.appendI
        end
        ","         sb.appendS
        target ..over io.fputSb ..drop
      sb.clear
        operations index isGlobal target prog compileOp
        ",\""       sb.appendS
        op [] .pos  sb.appendPos
        "\");\n"    sb.appendS
        target ..over io.fputSb ..drop
      sb.free ..drop
      return
    Assert case
      target "if(!(" io.fputs ..drop
      operations index isGlobal target prog compileOp
      ")){\nprintf(\"assertion failed: \\\"" sb.wrap
        op [] .val .Assert labelContext sb.appendEscapedStrC
        "\\\" at " sb.appendS
        op [] .pos sb.appendPos
        "\\n\");\n" sb.appendS
        target ..over io.fputSb ..drop
      sb.free ..drop
      target "exit(1);\n}\n" io.fputs ..drop
      return
    unreachable case
      "fprintf(stderr,\"reached unreachable statement at " sb.wrap
        op [] .pos sb.appendPos
        "\\n\");//unreachable\n" sb.appendS
        target ..over io.fputSb ..drop
      sb.free ..drop
      target "exit(1);//unreachable\n" io.fputs ..drop
      return
    compilerInfo case
      break
    getName setName atName getLabel setLabel atLabel length size
    stackMod copy builtIn procPtr
    typeModifier autoCast bitCast hasLabel hasName
    call implementProcedure case
      break ## XXX error message
  end
  "unable to compile operation " sb.wrap
    op [] prog sb.appendOp
  op [] .pos prog [] .errors @ appendError
end

proc( stringBuilder -> stringBuilder ) =>: appendCharNames
  "\"" sb.appendS
  0 while ..dup 0x100 < do
    ..swap ## character names padded to with 4 with zero bytes ( using \000 to prevent continuation of hex sequences )
      ..over i8 cast switch
        '\'' '\"' case
            "\\\\\\"      sb.appendS
            ..over i8 cast sb.appendC
            "\\000\\000"  sb.appendS
          break
        '\\' case "\\\\\\\\\\000\\000" sb.appendS break
        '\n' case "\\\\n\\000\\000" sb.appendS break
        '\t' case "\\\\t\\000\\000" sb.appendS break
        '\b' case "\\\\b\\000\\000" sb.appendS break
        '\r' case "\\\\r\\000\\000" sb.appendS break
        '\v' case "\\\\v\\000\\000" sb.appendS break
        '\f' case "\\\\f\\000\\000" sb.appendS break
        default
            ..over 0x7e > ..over.2 0x20 < | if
              "\\\\x" sb.appendS
              ..over 0x10 < if
                '0'   sb.appendC
              end
              ..over   sb.appendX
            else
              ..over i8 cast     sb.appendC
              "\\000\\000\\000" sb.appendS
            end
          break
      end
      ..over 0x7 & 0x7 == if
        "\"\n\"" sb.appendS ## split into lines for readability
      end
    ..swap 1 +
  end ..drop
  "\";\n"          sb.appendS
end

proc( io.FILE : target ProgramContext ptr mut : prog -> ) =>: export compileToC
  prog [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  target printHeader
  target prog printTypes
  ## TODO initialize string data
  id.LABEL_ID_NONE =:: mut mainId
  MAIN_NAME string.wrap 0 idContext id.findIdentifierByName ! if =:: data =:: name
    name .namespace 0 != if
      ..unreachable ## assert that namespace is always top level
    end
    data [] .labelId mainId =
  else ..drop.2 end
  prog [] .hasGetArgs if
    64 sb.create
      "static int " sb.appendS
      ARGC_NAME     sb.appendS
      ";\n"         sb.appendS
      target ..over io.fputSb ..drop
    sb.clear
      "static char** " sb.appendS
      ARGV_NAME        sb.appendS
      ";\n"            sb.appendS
      target ..over io.fputSb ..drop
    sb.free ..drop
  end
  prog [] .hasCheckIndex if
    64 sb.create
      "static void " sb.appendS
      CHECK_INDEX_NAME sb.appendS
      "(int64_t length,int64_t index,char const* pos){\n" sb.appendS
      "  if(index>=0 && index<length)\n    return;\n" sb.appendS
      "  fprintf(stderr,\"array index out of bounds: %\"PRIi64\" size: %\"PRIi64\" at %s\\n\",index,length,pos);\n" sb.appendS
      "  exit(" sb.appendS
      EXIT_CODE_ARRAY_INDEX sb.appendI
      ");\n}\n" sb.appendS
      target ..over io.fputSb ..drop
    sb.free ..drop
  end
  prog [] .hasCheckEnum if
    64 sb.create
      "static void " sb.appendS
      CHECK_ENUM_NAME sb.appendS
      "(int64_t current,int64_t expected,char const* pos){\n" sb.appendS
      "  if(current==expected)\n    return;\n" sb.appendS
      "  fprintf(stderr,\"enum index (%\"PRIi64\") does not match current value (%\"PRIi64\") at %s\\n\",expected,current,pos);\n" sb.appendS
      "  exit(" sb.appendS
      EXIT_CODE_ENUM_INDEX sb.appendI
      ");\n}\n" sb.appendS
      target ..over io.fputSb ..drop
    sb.free ..drop
  end
  64 sb.create ## XXX? only add when needed
    "static char " sb.appendS
    CHARNAMES_NAME sb.appendS
    "[]="          sb.appendS
    appendCharNames
    target ..over io.fputSb ..drop
  sb.free ..drop
  target "//declarations\n" io.fputs ..drop
  prog [] .idContext .globalScope .identifierNames @ map.itr.start while map.itr.hasNext do map.itr.next
    =:: declaration ## TODO find out which declarations are actually used
    declaration .1 [] =:: labelId
    labelId idContext id.getIdentifier
      if ..unreachable end ## XXX replace with assertion
    =:: idData
    idData [] .valueType =:: mut mType
    idData [] .labelId labelContext id.labelFlags =:: labelFlags
    idData [] .idType .PROCEDURE_BUNDLE ?? if
      continue
    end
    mType types.primitive.TYPE types.typeEquals if
      continue
    end
    mType types.isAutoType if
      prog [] .autoTypes
        mType types.getTypeId
      list.at .data []
      mType =
    end
    idData [] .templateId -1 != if
      labelFlags id.FLAG_EXTERN & ? if
        ## TODO error message
        continue
      end
      idContext [] .templateInfos idData [] .templateId
      list.at .data =:: templateInfo
      0 while ..dup templateInfo [] .implementations .length < do
        target "static " io.fputs ..drop ## mark all template implementations as static
        templateInfo [] .implementations ..over list.at .data [] .implType mType =
        mType typeContext types.getProcRet ..drop target prog printTypeName
        target " " io.fputs ..drop
        labelId ..over target prog printGlobalName
        ## printProcArgs
          mType
          false
          target
        prog printProcArgs
        target ";\n" io.fputs ..drop
        1 +
      end ..drop
      continue
    end
    labelFlags id.FLAG_EXPORT & 0 == labelFlags id.FLAG_EXTERN & 0 == & if
      target "static " io.fputs ..drop ## mark all non-exported values as static
    end
    ## GOHERE
    labelFlags id.FLAG_EXTERN & ? if
      target "extern " io.fputs ..drop
    end
    mType typeContext types.isProcedure if
      mType typeContext types.getProcRet ..drop target prog printTypeName
      target " " io.fputs ..drop
      labelId -1 target prog printGlobalName
      ## printProcArgs
        mType
        false
        target
      prog printProcArgs
      target ";\n" io.fputs ..drop
      continue
    end
    mType target prog printTypeName
    target " " io.fputs ..drop
    labelFlags id.FLAG_MUTABLE & 0 == if
      target "const " io.fputs ..drop
    end
    labelId -1 target prog printGlobalName
    target ";\n" io.fputs ..drop
  end ..drop
  ## TODO global declarations
  0 while ..dup prog [] .progFiles .length < do
    prog [] .progFiles ..over list.at .data =:: f
    64 sb.create
      "// " sb.appendS
      f [] .fileName sb.appendSb
      "\n"    sb.appendS
      target ..over io.fputSb ..drop
    sb.free ..drop
    f [] .globalOps .length 0 > if
      target "//global\n" io.fputs ..drop
    end
    0 =:: mut index
    while index f [] .globalOps .length < do
      f [] .globalOps list.asArray index @ true target prog compileOp
    end
    f [] .localOps .length 0 > if
      target "//local\n" io.fputs ..drop
    end
    0 index =
    while index f [] .localOps .length < do
      f [] .localOps list.asArray index @ false target prog compileOp
    end
    f [] .templateOps .length 0 > if
      target "//templates\n" io.fputs ..drop
    end
    0 index =
    while index f [] .templateOps .length < do
      f [] .templateOps list.asArray index @ false target prog compileOp
    end
    1 +
  end ..drop
  mainId id.LABEL_ID_NONE == if ## no main
    return
  end
  prog [] .hasGetArgs if
    128 sb.create
      "int main(int argc,char** argv){\n" sb.appendS
      ARGC_NAME     sb.appendS
      "=argc;\n"    sb.appendS
      ARGV_NAME     sb.appendS
      "=argv;\n"    sb.appendS
      target ..over io.fputSb ..drop
    sb.free ..drop
  else
    target "int main(void){\n" io.fputs ..drop
  end
  mainId -1 target prog printGlobalName
  target "();\nreturn 0;\n}\n" io.fputs ..drop
end
