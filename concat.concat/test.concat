#include string

( i32 i64 ) =:: aTuple
struct( i8 _ ptr : data i64 : len ) type =: string
enum( A B i32 : C i8 ptr mut : D ) =:: enum1
enum( A B string : C i64 3 array : D ) =:: anEnum

proc( i8 i32 => i64 bool ) =: proc0
  #drop:2 0 false return
end
proc( i64 : a i64 : b => i64 i64 ) =: proc1
  a b / a b % return
end

proc( i32 aTuple => string anEnum ) =: aProc
  i64 3 array new =:: anArray
  2 anArray @ 0 [] =
  0 == if
    "Hello" #swap .0 string new #swap .1  anEnum .C new return
  else #dup .0 2 == _if
    "World!" 5 string new anEnum .B return
  end
end

proc( type : static T i64 : k => T _ ptr ) : extern malloc

proc( i32 => ) =: switchTest
  switch
    0 1 2 case
      break
    3 4 case
      break
    default
      return
  end
end

entryPoint:
  0 =:: x
  0 =:: mut y
  i32 2 malloc =:: p
  1 y =
  x print
  0 while #dup "Hello" .length < do
    "Hello" #over [] print
    1 +
  end #drop
end
