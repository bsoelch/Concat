      state [] .openBlocks list.peek ..dup optional.hasData if .data =:: block
        block [] .blockType ..dup .SWITCH ?? ..swap .CASE ?? | if
          state [] .switchData
            block [] .blockId list.at .data
          =:: switchData
          switchData [] .labels @ =:: labels
