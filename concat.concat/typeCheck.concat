  procOut typeContext types.compositeElts "return statement" string.wrap op [] .pos state requireTypes
  state [] .compiledOps
    op list.appendP
  state [] .compiledOps =
  state [] .typeStack .length op [] .pos state CompileType .NON_EMPTY processStackOps
  false state [] .reachable =
