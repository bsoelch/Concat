) =:: export: TypeCheckState

proc( TypeCheckState ptr.mut : state -> ) =>: rememberState
  ## XXX? flag to check if state is currently in use
  ##   (auto-types are reset after type-checking (generic) procedure)
  state [] .stateStack
    ## TypeCheckStateState
      state [] .openBlocks .length
      state [] .compiledOps .length
      state [] .initializationStack .length
      state [] .blockStart
      state .stack branchTree.EMPTY branchTree.reset
      state [] .arrowState
      state [] .currentProcType
      state [] .currentFile
      state [] .mode
      state [] .blockMode
      state [] .reachable
    TypeCheckStateState new list.append
  state .stateStack=
  ## TODO remember Interpreter state
end
proc( TypeCheckState ptr.mut : state -> ) =>: resetState
  state [] .stateStack .length 0:iSize == if
    ## TODO error-message
    return
  end
  state [] .stateStack
    list.removeLast =:: prevState
  state .stateStack=
  ## TODO? error messages for open blocks/unhandled operations
  state [] .openBlocks
    prevState .openBlocksOffset list.setLength
  state .openBlocks=
  state [] .compiledOps
    prevState .compiledOpsOffset list.setLength
  state .compiledOps=
  state [] .initializationStack
    prevState .initializationStackOffset list.setLength
  state .initializationStack=
  prevState .blockStart state .blockStart=
  state .stack prevState .branchRoot branchTree.reset =:: oldRoot
  oldRoot branchTree.EMPTY != if
    ## TODO error message for unfinished branch
    state .stack oldRoot branchTree.endBranch
  end
  prevState .arrowState state .arrowState=
  prevState .currentProcType state .currentProcType=
  prevState .currentFile state .currentFile=
  prevState .mode state .mode=
  prevState .blockMode state .blockMode=
  ## TODO reset Interpreter state
  prevState .reachable state .reachable=
end

proc( TypeCheckState ptr : state -> bool ) =>: isGlobal
  state [] .currentProcType ? ! return
end
proc( TypeCheckState ptr : state -> i32 ) =>: currentBlockStart
  state [] .blockStart return
end

proc(
  bool : printValues
  i32 : maxCount
  i32 : depth
  TypeCheckState ptr.mut : state
-> ) =>: printTypes
  state [] .program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  idContext .constContext =:: constContext
  maxCount =:: mut: remaining
  printValues if
    "stack:\n" sb.copyPtr
  else
    "types:\n" sb.copyPtr
  end
    "-----------------\n" sb.appendS
  =:: mut: sb
  state .stack branchTree.itr.start while
    branchTree.itr.hasNext do branchTree.itr.next =:: val
    remaining 0 > and
        remaining 1 - remaining=
        remaining 0 == if
      break
    end
    sb
      val [] .valueType
        typeContext
        depth
      sb.appendTypeRecursive
      printValues if
        val [] .value .None ? ! if
          " { " sb.appendS
          val [] .value typeContext sb.appendConstant
          " }" sb.appendS
        end
        " pushed at " sb.appendS
        val [] .pushedAt [] sb.appendPos
      end
      '\n' sb.appendC
    sb=
  end ..drop
  sb
    "-----------------\n" sb.appendS
    $ sb.asStr io.print
  sb.free ..drop
end

proc( string : msg Operation : op i64 : errLine TypeCheckState ptr.mut : state -> ) =>: internalError
  "internal compiler error: " sb.copyPtr
    msg sb.appendStr
    " at " sb.appendS
    ..file sb.appendS ':' sb.appendC errLine sb.appendI
    " while type-checking operation " sb.appendS
    op state [] .program sb.appendOp
  sb.asStr io.print
  1 sys.exit
  ..unreachable
end
proc( string : msg FilePosition ptr : codePos i64 : errLine -> ) =>: internalErrorNoOp
  "internal compiler error: " sb.copyPtr
    msg sb.appendStr
    " at " sb.appendS
    ..file sb.appendS ':' sb.appendC errLine sb.appendI
    " while type-checking operation at " sb.appendS
    codePos [] sb.appendPos
    '\n' sb.appendC
  sb.asStr io.print
  1 sys.exit
  ..unreachable
end

proc(
  i32 : count
  FilePosition ptr : pos
  TypeCheckState ptr.mut : state
-> bool ) =>: checkStackSize
  state [] .stack branchTree.depth count < if
    "stack underflow: need " sb.copyPtr
      count sb.appendI
      " values got " sb.appendS
      state [] .stack branchTree.depth sb.appendI
    pos state [] .program .errors appendError
    true return
  end
  false return
end

proc(
  TypeInfo : src
  Type : mut: target
  SignType : signType
  FilePosition ptr : pos
  TypeCheckState ptr.mut : state
-> bool ) =>: tryCastConstant
  state [] .program .errors =:: errors
  state [] .program .idContext .typeContext =:: typeContext
  src .value .None ? if
    true return
  end
  src .opIndex 0 < if
    true return
  end
  src .opIndex state canDeleteOp ! if
    true return
  end
  state [] .compiledOps src .opIndex @[] =:: srcOp
  target typeContext types.unwrapRefinement =:: targetBase
  ## TODO! check refinement-types
  src .valueType signType src .value targetBase typeContext interpreter.castConstant srcOp .val .Constant=
  target srcOp .dataType=
  false return
end
union( _ : Err _ : Match ConstValue slice : Constant ) =:: TypeMatch
proc(
  Type slice : types
  string : name
  ## number of values already popped by instruction
  i32 : mut: stackCastOffset
  bool : popConstants ## TODO? make argument static to reduce runtime const of if-checks
  FilePosition ptr : pos
  TypeCheckState ptr.mut : state
-> TypeMatch ) =>: requireTypes
  state [] .program .errors =:: errors
  state [] .program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  state [] .constBuffer .length =:: constOffset
  i32 list.empty =:: mut: constOffsets
  true =:: mut: isConstant
  1:iSize while $ types .length u<= do =:: i
    types types .length i - [] =:: expectedType
    state .stack branchTree.peek .else
      expectedType typeContext types.isEmpty if
        popConstants and isConstant if
          state [] .constBuffer ConstValue .None list.append state .constBuffer=
          constOffsets OP_EMPTY list.append constOffsets=
        end
        i 1:iSize + continue ## skip empty arguments if no values on stack
      end
      "not enough types for " sb.copyPtr
        name sb.appendStr
      pos errors appendError
      TypeMatch .Err return
    end =:: peekedInfo
    peekedInfo [] .valueType typeContext types.isEmpty and expectedType typeContext types.isEmpty ! if
      state .stack branchTree.pop ..drop ## discard empty value
      i continue ## no not increment index
    end
    expectedType typeContext types.isEmpty and peekedInfo [] .valueType typeContext types.isEmpty ! if
      stackCastOffset 1 - stackCastOffset= ## update cast offset
      popConstants and isConstant if
        state [] .constBuffer ConstValue .None list.append state .constBuffer=
        constOffsets OP_EMPTY list.append constOffsets=
      end
      i 1:iSize + continue ## skip empty if stack value not empty
    end
    state .stack branchTree.pop .else
      "stack underflow":s pos ..line internalErrorNoOp ..unreachable
    end [] =:: typeInfo
    popConstants and isConstant if
      typeInfo .value .None ? if
        false isConstant=
      else
        state [] .constBuffer typeInfo .value list.append state .constBuffer=
        constOffsets typeInfo .opIndex list.append constOffsets=
      end
    end
    typeInfo .valueType expectedType types.typeEquals if
      i 1:iSize + continue
    end
    ## treat all empty types as equal
    typeInfo .valueType typeContext types.isEmpty and expectedType typeContext types.isEmpty if
      i 1:iSize + continue
    end
    typeInfo .valueType expectedType typeContext types.canAutoCast or
        typeInfo .valueType typeInfo .value expectedType pos state typeChecker.canRefineType if
      typeInfo expectedType SignType .NONE pos state tryCastConstant ! if
        ## update constant value
        popConstants and isConstant and state [] .compiledOps typeInfo .opIndex list.at .and
            .val [] .Constant .if
          state [] .constBuffer list.peek .else
            "missing constant":s pos ..line internalErrorNoOp ..unreachable
          end  =[]
        end
        i 1:iSize + continue
      else typeInfo .valueType typeContext types.isType and expectedType typeContext types.isType _if
        ## TODO! check type-sets
        i 1:iSize + continue
      end
      ## opAutoCast
        typeInfo .valueType
        i 1:iSize - i32 cast stackCastOffset +
        expectedType
        pos
      opAutoCast state appendOp ..drop
      typeInfo .opIndex 0 < if
        ## no index update necessary
        i 1:iSize + continue
      end
      i 1:iSize + continue
    end
    "wrong type for " sb.copyPtr
      name sb.appendStr
      " expected " sb.appendS
      expectedType typeContext sb.appendType
      " got " sb.appendS
      typeInfo .valueType typeContext sb.appendType
    pos errors appendError
    i 1:iSize +
  end ..drop
  popConstants if
    isConstant if
      0 =:: mut: dropCount
      constOffsets for $ =:: i
        state tryDeleteOp if ## TODO error handling
          dropCount 1 + dropCount=
        end
      end
      dropCount 0 != if
        dropCount StackModType .DROP pos opStackMod state appendOp ..drop
      end
    end
    constOffsets list.free ..drop
    state [] .constBuffer
      $ constOffset list.tailMut =:: constValues
      constOffset list.setLength
    state .constBuffer=
    isConstant if
      constValues slice.reverse ## TODO? push values in reverse order
      constValues slice.freeze TypeMatch .Constant return
    end
  end
  TypeMatch .Match return
end
proc( i32 : count FilePosition ptr : pos TypeCheckState ptr.mut : state -> ) =>: discardValues
  state [] .program =:: program
  state [] .program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  count pos state checkStackSize if return end
  0 =:: mut: toDrop
  0:i32 while ..dup count < do
    state .stack branchTree.pop optional.unwrap =:: typeInfo
    typeInfo [] .valueType typeContext types.isEmpty if
      1 + continue
    end
    typeInfo [] .opIndex state tryDeleteOp if
      toDrop 1 + toDrop=
    end
    1 +
  end ..drop
  state removeTrailingNOPs
  toDrop 0 > if
    toDrop StackModType .DROP pos opStackMod state appendOp ..drop
  end
end

proc( TypeCheckState ptr.mut : state -> TypedValue optional ) =>: popTypedValue
  state .stack branchTree.pop .else
    TypedValue optional.empty return
  end =:: typeInfo
  typeInfo [] .opIndex state tryDeleteOp if ## remove stored operation
    TypedValue optional.empty return
  end
  typeInfo [] .valueType typeInfo [] .value TypedValue new optional.wrap return
end
proc( TypeCheckState ptr.mut : state -> ConstValue optional ) =>: popValue
  state .stack branchTree.pop .else
    ConstValue optional.empty return
  end =:: typeInfo
    typeInfo [] .opIndex state tryDeleteOp if ## remove stored operation
      state .stack typeInfo [] branchTree.push ## put value back
      ConstValue optional.empty return
    end
  typeInfo [] .value optional.wrap return
end
proc( FilePosition ptr : pos TypeCheckState ptr.mut : state -> Type ) =>: popType
  state [] .program =:: program
  state [] .program .errors =:: errors
  state [] .program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  state .stack branchTree.pop .else
    Type .Undefined return
  end =:: typeInfo
  typeInfo [] .valueType =:: valType
  valType typeContext types.isType ! if
    "expected type got " sb.copyPtr
      valType typeContext sb.appendType
    pos errors appendError
    Type .Undefined return
  end
  typeInfo [] .value .TypeId .else
    "expected type-constant got " sb.copyPtr
      >$ typeContext sb.appendConstant
    pos errors appendError
    Type .Undefined return
  end
    typeInfo [] .opIndex state currentBlockStart < if ..drop
      "type-constant " sb.copyPtr
        typeInfo [] .value typeContext sb.appendConstant
        " at " sb.appendS
        typeInfo [] .pushedAt [] sb.appendPos
        " was declared outside current block" sb.appendS
      pos errors appendError
      Type .Undefined return
    end
    typeInfo [] .opIndex state deleteOp ## remove stored operation
  return
end
proc( FilePosition ptr : pos TypeCheckState ptr.mut : state -> string ) =>: popString
  state [] .program =:: program
  state [] .program .errors =:: errors
  state [] .program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  1 pos state checkStackSize if string.empty return end
  state .stack branchTree.peek optional.unwrap =:: typeInfo
  ## XXX? allow Array: { string, i64 } as string constant
  typeInfo [] .value .Array8 .else
    "expected string-constant got " sb.copyPtr
      >$ typeContext sb.appendConstant
    pos errors appendError
    string.empty return
  end
    typeInfo [] .opIndex state currentBlockStart < if ..drop
      "string-constant " sb.copyPtr
        typeInfo [] .value typeContext sb.appendConstant
        " at " sb.appendS
        typeInfo [] .pushedAt [] sb.appendPos
        " was declared outside current block" sb.appendS
      pos errors appendError
      string.empty return
    end
  string.fromBytes =:: stringValue
    state .stack branchTree.pop ..drop ## drop value
    typeInfo [] .opIndex state deleteOp ## remove stored operation
  stringValue return
end

proc(
  ConstValue : value
  Type : valType
  FilePosition ptr : pos
  TypeCheckState ptr.mut : state
-> ) =>: pushConstant
    state [] .program =:: program
    program .idContext =:: idContext
    idContext .typeContext =:: typeContext
    valType typeContext types.isEmpty if
      OP_EMPTY
    else
      state [] .compiledOps .length i32 cast.u
    end =:: opIndex
    ## branchTree.push
      state .stack
      ## TypeInfo
        value
        valType
        opIndex
        pos
      TypeInfo new
    branchTree.push
    opIndex 0 < if
      return
    end
    state [] .compiledOps
      value valType pos opConst list.append
    state .compiledOps=
end
proc(
  TypeInfo : typeInfo
  TypeCheckState ptr.mut : state
-> ) =>: pushConstTypeInfo
  typeInfo .value typeInfo .valueType typeInfo .pushedAt state pushConstant
end
proc(
  Type : valType
  ConstValue : value
  Operation : op
  TypeCheckState ptr.mut : state
-> ) =>: pushValue
    state [] .program =:: program
    program .idContext =:: idContext
    idContext .typeContext =:: typeContext
    valType typeContext types.isEmpty if
      OP_EMPTY
    else
      state [] .compiledOps .length i32 cast.u
    end =:: opIndex
    ## branchTree.push
      state .stack
      ## TypeInfo
        value
        valType
        opIndex
        op .pos
      TypeInfo new
    branchTree.push
    opIndex 0 < if
      return
    end
    state [] .compiledOps
      op list.append
    state .compiledOps=
end
proc(
  Type slice : types
  FilePosition ptr : pos
  TypeCheckState ptr.mut : state
-> ) =>: pushTypes
  state [] .program .idContext .typeContext =:: typeContext
  types for =:: t
    state .stack
      ## TypeInfo
        ConstValue .None
        t
        ## multiple types from one op -> cannot modify op to modify types
        OP_UNLINKED
        pos
      TypeInfo new
    branchTree.push
  end
end
proc( LabelId : label TypeCheckState ptr.mut : state -> ) =>: replaceLabel
  state .stack branchTree.pop optional.unwrap [] =:: mut: top
  state .stack top branchTree.push
end

proc(
  BlockInfo : blockInfo
  TypeCheckState ptr.mut : state
-> ) =>: openBlock
  state [] .openBlocks
    blockInfo list.append
  state .openBlocks=
end

proc(
  TypeCheckState ptr : state
-> BlockInfo ptr.mut optional ) =>: peekBlock
  state [] .openBlocks list.peek
end
proc(
  FilePosition ptr : pos
  TypeCheckState ptr.mut : state
-> BlockInfo ) =>: closeBlock
  state [] .program .errors =:: errors
  state [] .openBlocks .length 0:iSize == if ## XXX? check for underflow wrt. reset-state
    BlockInfo .Unknown return
  end
  state [] .openBlocks .length 1:iSize - =:: newLength
  state [] .openBlocks newLength [] =:: closed
  state [] .openBlocks
    newLength list.setLength
  state .openBlocks=
  closed return
end
proc( TypeCheckState ptr.mut : state -> bool ) =>: inIfCondition
  state peekBlock .and .If .and [] .flags IfBlockFlags.hasIf & ? ! end
end
proc( TypeCheckState ptr : state -> bool ) =>: inSwitchLabel
  state [] .openBlocks list.peek .and [] .Switch .and .inLabel end
end
proc(
  BlockType : breakType
  LabelId : blockLabel
  FilePosition ptr : pos
  TypeCheckState ptr.mut : state
-> BlockInfo ptr.mut optional ) =>: findBreakableBlock
  state [] .program =:: program
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  program .errors =:: errors
  state [] .openBlocks list.atReversed for =:: block
    block [] .While .and =:: whileBlock blockLabel id.LABEL_ID_NONE == or
        whileBlock .blockLabel blockLabel labelContext id.labelNamesEq if
      block optional.wrap return
    end
    breakType .BREAK and block [] .Switch .and =:: switchBlock
        blockLabel id.LABEL_ID_NONE == or
        switchBlock .blockLabel blockLabel labelContext id.labelNamesEq if
      block optional.wrap return
    end
  end
  60 sb.create
    breakType sb.appendBlockType
    " can only appear in loops " sb.appendS
    breakType .BREAK if
      "and switch-case statements" sb.appendS
    end
  pos errors appendError
  BlockInfo ptr.mut optional.empty return
end

## break from current switch-branch, but don't terminate the branch
proc(
  SwitchBlockInfo ptr.mut : switchBlock
  FilePosition ptr : pos
  TypeCheckState ptr.mut : state
-> ) =>: breakSwitch
  state [] .stack branchTree.depth =:: caseTypes
  state .stack
    switchBlock [] .branchRoot
  branchTree.reset =:: caseBranch
  state [] .reachable if
    ## add space for casts of values on stack
    switchBlock [] .castOffsets
      ## reserveOps
        caseTypes
        pos
      state reserveOps list.append
    switchBlock .castOffsets=
    ## reset stack to start of if statement
    switchBlock [] .caseBranches
      ## BranchPoint
        caseBranch
        pos
      BranchPoint new list.append
    switchBlock .caseBranches=
  end
  switchBlock [] .endLabel CompareType .NONE pos state localJump
  false state .reachable=
  ## breaking innermost switch block -> code is in label
  state [] .openBlocks list.peek .and [] .Switch .and .blockId switchBlock [] .blockId == if
    switchBlock [] .inLabel ! if
      state [] .program .idContext id.closeScope ! "closing case-scope worked" assert
    end
    true switchBlock .inLabel=
  end
end
## terminate current switch branch
proc( FilePosition ptr : pos TypeCheckState ptr.mut : state -> ) =>: endSwitchBranch
  state peekBlock .and .Switch .and =:: switchBlock
      switchBlock [] .inLabel ! if
    switchBlock pos state breakSwitch
  end
end

proc(
  bool : clearConst
  i32 : offset
  FilePosition ptr : pos
  TypeCheckState ptr.mut : state
-> ) =>: clearReferences ## TODO? is clearing references necessary for non-loop blocks
  state [] .program .idContext .typeContext =:: typeContext
  ## list.create
    state [] .stack branchTree.depth
  TypeInfo list.create =:: mut: stackElements
  while
    state .stack branchTree.pop .if =:: next
      stackElements
        next list.appendP
      stackElements=
      continue
    end
    false
  end
  while stackElements .length 0:iSize u> do
    stackElements
      list.removeLast =:: mut: elt
    stackElements=
    clearConst if
      ConstValue .None elt@ .value=
      elt .valueType types.isLiteral if
        elt .valueType
          typeContext types.literalToType
        elt@ .valueType=
      end
    end
    OP_UNLINKED elt@ .opIndex= ## TODO! is this line necessary
    state .stack
      elt
    branchTree.push
  end
  stackElements list.free stackElements=
end

enum( MERGE MERGE_ROOT NO_CAST ) =:: MergeType
struct(
  string : blockName
  FilePosition ptr : mergePoint
  i32 slice : castPointOffsets
  TypeCheckState ptr.mut : state
  i32 : rootBranch
  MergeType : mergeType
) =:: MergePoint
proc(
  TypeInfo ptr slice : toMerge
  i32 : offset
  MergePoint : mergePoint
-> TypeInfo ) =>: mergeBranches
  mergePoint .state [] .program =:: program
  program .errors =:: errors
  program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  toMerge .length 1:iSize == if
    toMerge 0 [] [] return
  end
  toMerge mergePoint .rootBranch [] =:: root
  root [] .valueType =:: mut: mergedType
  mergedType types.isLiteral if
    mergePoint .mergeType switch
      MERGE case break
      MERGE_ROOT NO_CAST case
        mergedType typeContext types.literalToType mergedType=
      break
    end
  end
  true =:: mut: noError
  0:i32 while $ iSize cast.u toMerge .length u< do =:: i
    i mergePoint .rootBranch == if
      i 1 + continue
    end
    toMerge i [] =:: current
    current [] .valueType
      $ types.isLiteral and mergePoint .mergeType .NO_CAST if
        typeContext types.literalToType
      end
    =:: currentType
    mergePoint .mergeType switch
      MERGE case
        currentType mergedType typeContext types.mergeTypes .if
          mergedType=
        else
          "cannot merge the branches of " sb.copyPtr
            mergePoint .blockName sb.appendStr
            "\n cannot merge types " sb.appendS
            mergedType typeContext sb.appendType
            " ( pushed at " sb.appendS
            root [] .pushedAt [] sb.appendPos
            " )\n and " sb.appendS
            currentType typeContext sb.appendType
            " ( pushed at " sb.appendS
            current [] .pushedAt [] sb.appendPos
            " )\n" sb.appendS
          mergePoint .mergePoint errors appendError
          false noError=
        end
        break
      MERGE_ROOT NO_CAST case
        currentType mergedType
          mergePoint .mergeType .NO_CAST if
            types.typeEquals !
          else
            typeContext types.canAutoCast !
          end
        if
          "cannot merge the branches of " sb.copyPtr
            mergePoint .blockName sb.appendStr
            "\n expected: " sb.appendS
            mergedType typeContext sb.appendType
            " ( pushed at " sb.appendS
            root [] .pushedAt [] sb.appendPos
            " )\n got: " sb.appendS
            currentType typeContext sb.appendType
            " ( pushed at " sb.appendS
            current [] .pushedAt [] sb.appendPos
            " )\n" sb.appendS
          mergePoint .mergePoint errors appendError
          false noError=
        end
      break
    end
    i 1 +
  end ..drop
  noError if ## don't try casting values if merging types failed
    0:i32 while $ iSize cast.u toMerge .length u< do =:: i
      toMerge i [] =:: current
        current [] .valueType
          $ types.isLiteral if typeContext types.literalToType end
        =:: currentType
        currentType mergedType types.typeEquals ! and current [] .valueType  mergedType types.typeEquals ! if
          mergePoint .castPointOffsets i [] =:: castRoot
          castRoot 0 >= if
            mergePoint .state [] .compiledOps castRoot offset + @[] =:: castPoint
            castPoint [] .val .NOP .and .RESERVED if
              ## opAutoCast
                currentType
                offset i32 cast
                mergedType
                mergePoint .mergePoint
              opAutoCast castPoint =[]
              i 1 + continue
            end
            "operation is not a NO-OP: " sb.copyPtr
              castPoint [] program sb.appendOp
            mergePoint .mergePoint errors appendError
          end
          "cannot cast " sb.copyPtr
            offset sb.appendI
            "th value in " sb.appendS
            i sb.appendI
            "th branch" sb.appendS
          mergePoint .mergePoint errors appendError
        end
      i 1 +
    end ..drop
  end
  ## TypeInfo
    ConstValue .None ## XXX merge constants
    mergedType
    OP_UNLINKED
    mergePoint .mergePoint
  TypeInfo new return
end

proc(
  Operation : op
  TypeCheckState ptr.mut : state
-> i32 #+opIndex+# ) =>: appendOp
  state [] .program =:: program
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  op .dataType typeContext types.isEmpty if
    OP_EMPTY return
  end
  state [] .compiledOps .length i32 cast.u =:: index
  state [] .compiledOps
    op list.append
  state .compiledOps=
  index return
end

proc(
  iSize : srcPosition
  FilePosition ptr : pos
  TypeCheckState ptr.mut : state
-> ) =>: updateJump
  state [] .compiledOps
    $ .length srcPosition - JumpDistance cast <$
    srcPosition
  list.at .and .val .LocalJump .else
    "expected jump":s pos ..line internalErrorNoOp ..unreachable
  end .jumpDistance=
end
proc(
  LocalLabelId : labelId
  LocalLabelType : labelType
  FilePosition ptr : pos
  TypeCheckState ptr.mut : state
-> ) =>: localLabel
  labelType switch
    HINT_START case break
    HINT_END case
      state .jumpOffsets labelId map.remove .and .Label ! .if
        "unhandled jumps in closed label":s pos ..line internalErrorNoOp ..unreachable
      end
    break
    LABEL_START LABEL_END LABEL_MIDDLE case
      state .jumpOffsets
        labelId state .compiledOps [] .length JumpOffsets .Label
      map.put .if
        switch
          Label case "duplicate label":s pos ..line internalErrorNoOp ..unreachable
          Jump .case pos state updateJump break
          Jump2 .case $ .0 pos state updateJump .1 pos state updateJump break
          Jump3 .case
            $ .0 pos state updateJump
            $ .1 pos state updateJump
            .2 pos state updateJump
          break
          Jumps .case $ for pos state updateJump end list.free ..drop break
        end
      end
    break
  end
  labelId labelType pos opLabel state appendOp ..drop
end
proc(
  LocalLabelId : labelId
  CompareType : cmpType
  FilePosition ptr : pos
  TypeCheckState ptr.mut : state
-> ) =>: localJump
  state .compiledOps [] .length =:: opOffset
  state .jumpOffsets
    labelId
  map.get .if
    switch
      Label .case opOffset - JumpDistance cast.s break
      Jump .case
        state .jumpOffsets
          labelId >>$ opOffset ( iSize iSize ) new JumpOffsets .Jump2
        map.put ..drop
        0:JumpDistance
      break
      Jump2 .case
        state .jumpOffsets
          labelId >>$ ... opOffset ( iSize iSize iSize ) new JumpOffsets .Jump3
        map.put ..drop
        0:JumpDistance
      break
      Jump3 .case
        8 iSize list.create
          $1 .0 list.append
          $1 .1 list.append
          >$ .2 list.append
          opOffset list.append
        state .jumpOffsets
          labelId >>$ JumpOffsets .Jumps
        map.put ..drop
        0:JumpDistance
      break
      Jumps .case
          opOffset list.append
        state .jumpOffsets
          labelId >>$ JumpOffsets .Jumps
        map.put ..drop
        0:JumpDistance
      break
    end
  else
    state .jumpOffsets
      labelId opOffset JumpOffsets .Jump
    map.put ..drop
    0:JumpDistance
  end =:: jumpDistance
  labelId jumpDistance cmpType pos opJump state appendOp ..drop
end
## reserve space for count operations at the current position, returns the position of the first operation
proc(
  i32 : count
  FilePosition ptr : pos
  TypeCheckState ptr.mut : state
-> i32 ) =>: reserveOps
  state [] .compiledOps .length i32 cast.u =:: offset
  state [] .compiledOps
    offset count + list.ensureCap
    offset count + list.setLength
  state .compiledOps=
  ## mem.fill
    state [] .compiledOps .data offset @[]
    count iSize cast.u
    pos reserveOp
  mem.fill
  offset return
end
proc( TypeCheckState ptr.mut : state -> ) =>: wrapCopy
  state [] .program =:: program
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  state .stack branchTree.pop optional.unwrap [] =:: mut: topValue
  topValue .valueType typeContext types.isEmpty if
    state .stack topValue branchTree.push
    return
  end
  state [] .compiledOps .length i32 cast.u =:: index
  state [] .compiledOps
    topValue .valueType topValue .pushedAt opCopy list.append
  state .compiledOps=
  index topValue@ .opIndex=
  state .stack topValue branchTree.push
end

proc(
  i32 : index
  TypeCheckState ptr.mut : state
-> bool ) =>: canDeleteOp
  index OP_ARGUMENT == or index OP_EMPTY == if
    true return
  end
  index state currentBlockStart < if
    false return
  end
  state [] .compiledOps index list.at .else
    false return
  end =:: op
  op [] .val .Constant ? or op [] .val .AtId ? or op [] .val .GetId ? if
    ## deleting op will no remove side-effects
    true return
  end
  false return
end
proc(
  i32 : opIndex
  TypeCheckState ptr.mut : state
-> bool ) =>: canCopyOp
  opIndex OP_ARGUMENT == if false return end
  ## can only copy deletable ops
  opIndex state canDeleteOp ! if false return end
  state [] .compiledOps opIndex list.at .else
    false return
  end .val [] .GetId .if .labelId =:: labelId
    labelId
      state [] .program .idContext .typeContext .labelContext id.labelFlags
    id.FLAG_MUTABLE & ? if
      false return ## cannot copy mutable get (value might change between invocations)
    end
  else ..drop end
  true return
end
proc(
  i32 : index
  TypeCheckState ptr.mut : state
-> bool ) =>: tryDeleteOp
  index state canDeleteOp if
    index state deleteOp
    false return
  else
    true return
  end
end
proc( i32 : index TypeCheckState ptr.mut : state -> ) =>: deleteOp
  index OP_ARGUMENT == or index OP_EMPTY == if return end
  opValNOP state [] .compiledOps index @[] .val=
end
proc( i32 : index TypeCheckState ptr.mut : state -> i32 ) =>: copyOp
  state [] .compiledOps .length i32 cast.u =:: copyIndex
  state [] .compiledOps
    $ index [] list.append
  state .compiledOps=
  copyIndex return
end
proc(
  i32 : opIndex
  TypeCheckState ptr.mut : state
-> i32 bool ) =>: tryCopyOp
  opIndex state canCopyOp if
    opIndex state copyOp false return
  end
  0 true return
end
proc( TypeCheckState ptr.mut : state -> ) =>: removeTrailingNOPs
  state [] .compiledOps .length 1:iSize - while $ 0:iSize iSize.sge do =:: i
    state [] .compiledOps i @[] =:: op
    op [] .val .NOP ! .or .EMPTY ! if
      i break
    end
    i 1:iSize -
  end 1:iSize + =:: offset
  state [] .compiledOps
    offset list.setLength
  state .compiledOps=
end
proc( TypeCheckState ptr.mut : state -> ) =>: clearOps
  0 state .blockStart=
  state [] .stateStack list.peek .if =:: prevState
    state [] .compiledOps
      prevState [] .compiledOpsOffset list.setLength
    state .compiledOps=
    return
  end
  state [] .compiledOps
    list.clear
  state .compiledOps=
end
proc( TypeCheckState ptr.mut : state -> ) =>: freeOps
  state [] .compiledOps
    list.free
  state .compiledOps=
end

proc(
  Operation ptr.mut : op
  bool : autoTyped
  TypeCheckState ptr.mut : state
-> ) =>: resolveDeclarationType
  state [] .program .errors =:: errors
  state [] .program .idContext .typeContext =:: typeContext
  autoTyped if
    state .stack branchTree.peek .else
      "missing type for declaration" sb.copyPtr op [] .pos errors appendError
      return
    end [] .valueType
    $ types.isLiteral if
      typeContext types.literalToType
    end
  else
    op [] .pos state popType
  end =:: valType
  valType op .dataType=
end

union(
  Operation ptr.mut : Op
  StackValue list ptr.mut : Values
) =:: export: CallSource
enum( FAILURE SUCCESS ) =:: EvalResult
proc(
  CallSource : source
  StackValue slice.mut : mut: args
  Type : calledType
  ProcedureCallInfo : calledProc
  FilePosition ptr : pos
  TypeCheckState ptr.mut : state
-> EvalResult ) =>: evaluateCall
  state [] .program =:: program
  state [] .program .errors =:: errors
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  idContext .constContext =:: constContext
  state .interpreter =:: interpreter
  calledType typeContext types.getProcIn .else
    "proc has no in":s pos ..line internalErrorNoOp ..unreachable
  end =:: inTypes
  program [] .procedures calledProc .procId i64 cast @[] =:: procData
  state [] .constBuffer .length =:: constOffset
  procData .implementation .Code ? =:: isCodeImpl
  isCodeImpl and calledType typeContext types.isTypeGeneratorProc end =:: isTypeGenerator
  false =:: mut: isGenericTypeGen
  ## 1. remove static arguments and apply argument conversions
  0:iSize =:: mut: argCount
  0 =:: mut: procArgIndex
  args .length for =:: argIndex
    procArgIndex iSize cast.u inTypes .length u>= if
      "const-args out of sync with proc-signature":s pos ..line internalErrorNoOp ..unreachable
    end
    calledType procArgIndex typeContext types.getProcArgLabel =:: mut: eltLabel
    inTypes procArgIndex [] =:: mut: argType
    ## skip auto-args
    while
      eltLabel labelContext id.labelFlags id.FLAG_AUTO & ? or
      argType typeContext types.isEmpty
    do
      procArgIndex 1 + procArgIndex=
      calledType procArgIndex typeContext types.getProcArgLabel eltLabel=
      inTypes procArgIndex [] argType=
    end
    isTypeGenerator if
      args argIndex [] .value =:: argValue
      state [] .constBuffer
        argValue list.append
      state .constBuffer=
      argValue .GenericArg ? or
          argValue .TypeId .and typeContext types.isGeneric if
        true isGenericTypeGen=
      end
      eltLabel labelContext id.labelFlags id.FLAG_STATIC & ? ! and argType typeContext types.isType ! if
        "Arguments for Type-generators should be static" sb.copyPtr
        eltLabel labelContext id.labelPos .else pos end errors appendError
      end
    end
    argType typeContext types.isEmpty or isCodeImpl and
        eltLabel labelContext id.labelFlags id.FLAG_STATIC & ? or argType typeContext types.isType if
      continue
    end
    argCount argIndex != if
      args argIndex [] args argCount =[]
    end
    args argCount @[] =:: arg
    argCount 1 + argCount=
    arg [] .valType typeContext types.isEmpty or isCodeImpl and arg [] .valType typeContext types.isType if
      continue
    end
    arg [] .valType argType types.typeEquals if
      continue
    end
    ## handle conversions
    arg [] .valType
      SignType .NONE
      arg [] .value
      argType
      typeContext interpreter.castConstant
    arg .value=
  finally
    procArgIndex 1 + procArgIndex=
  end
  procArgIndex iSize cast.u inTypes .length != if
    "const-args out of sync with proc-signature":s pos ..line internalErrorNoOp ..unreachable
  end
  isTypeGenerator if
    ## findGeneratedType
      procData [] .labelId
      state [] .constBuffer constOffset list.tail
      true
      typeContext
      constContext
    types.findGeneratedType .Stored .if
      optional.wrap
    else ..drop isGenericTypeGen _if
      ## initializeGeneratedType
        procData [] .labelId
        state [] .constBuffer constOffset list.tail
        Type .Undefined
        typeContext
        constContext
      types.initializeGeneratedType optional.wrap
    else Type optional.empty end .if =:: genericType
      state [] .constBuffer
        constOffset list.setLength
      state .constBuffer=
      source .Op ? if
        args .length i32 cast.u pos state discardValues
      end
      source switch
        Op case
          ## pushConstant
            genericType ConstValue .TypeId
            types.primitive.TYPE
            pos
          state pushConstant
        break
        Values .case =:: target
          target []
            ## StackValue
              types.primitive.TYPE
              genericType ConstValue .TypeId
            StackValue new list.append
          target =[]
        break
      end
      EvalResult .SUCCESS return
    end
  end
  ## 2. load arguments into interperter
  interpreter interpreter.offsetContext
  interpreter [] .stack
    $ .length argCount + list.ensureCap
  interpreter .stack=
  interpreter [] .stackInfo
    $ .length argCount + list.ensureCap
  interpreter .stackInfo=
  args argCount slice.head slice.reversed for =:: arg
    interpreter [] .stack
      arg .value list.append
    interpreter .stack=
    interpreter [] .stackInfo
      ## ValueInfo
        arg .valType
        pos
      interpreter.ValueInfo new list.append
    interpreter .stackInfo=
  end
  ## 3. ensure procedure has been type-checked (may invalidate args!)
  procData .implementation .Code .if
    calledProc .implementationId -1:i32 != if ## TODO! avoid magic number
      [] .implementations calledProc .implementationId [] .codeState
    else
      [] .codeState
    end  .TYPE_CHECKED ! if
      ## typeCheckChildProcedures
        calledProc .procId
        calledProc .implementationId
        pos
        state
      typeCheckChildProcedures
      ## TODO! do not interpret if type-checking fails
    end
  else ..drop end
  ## 4. evalute-call in interpreter
  ## evaluateCall
    calledProc .procId
    calledProc .implementationId
    calledType
    calledProc .autoArgs
    pos
    interpreter
  interpreter.evaluateCall if
    interpreter interpreter.resetContext
    EvalResult .FAILURE return
  end
  ## 5. load arguments from interpreter, reset interpreter state
  source .Op ? if
    args .length i32 cast.u pos state discardValues
  end
  calledType typeContext types.getProcOut .if .length else 0 end =:: resCount
  resCount "procedure return":s pos interpreter interpreter.checkStack if
    interpreter interpreter.resetContext
    EvalResult .FAILURE return
  end
  interpreter [] .stack .length resCount - =:: offset
  isTypeGenerator if
    ## initializeGeneratedType
      procData [] .labelId
      state [] .constBuffer constOffset list.tail
      interpreter [] .stack list.peek .and [] .TypeId .else Type .Undefined end
      typeContext
      constContext
    types.initializeGeneratedType =:: genericType
    state [] .constBuffer
      constOffset list.setLength
    state .constBuffer=
    source switch
      Op case
        ## pushConstant
          genericType ConstValue .TypeId
          types.primitive.TYPE
          pos
        state pushConstant
      break
      Values .case =:: target
        target []
          ## StackValue
            types.primitive.TYPE
            genericType ConstValue .TypeId
          StackValue new list.append
        target =[]
      break
    end
    interpreter interpreter.resetContext
    EvalResult .SUCCESS return
  end
  ##  -> store computed constants
  offset while $ interpreter [] .stack .length u< do =:: i
    interpreter [] .stack i @[] =:: constant
    interpreter [] .stackInfo i @[] =:: constInfo
    source switch
      Op case
        ## pushConstant
          constant  []
          constInfo [] .valueType
          pos
        state pushConstant
      break
      Values .case =:: target
        target []
          ## StackValue
            constInfo [] .valueType
            constant  []
          StackValue new list.append
        target =[]
      break
    end
  finally i 1:iSize + end ..drop
  interpreter interpreter.resetContext
  EvalResult .SUCCESS return
end
union(
  Type : Generate
  _ : ConstEval
  _ : Error
) =:: TypeCheckCallResult
proc(
  ProcId slice : procedures
  StackValue slice.mut : mut: stackValues
  bool : headConstant
  CallSource : source
  FilePosition ptr : pos
  TypeCheckState ptr.mut : state
-> TypeCheckCallResult ) =>: export: typeCheckCallStackless
  state [] .program =:: program
  state [] .program .errors =:: errors
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  0 sb.create =:: mut: message
  ## resolveCall
    procedures
    stackValues slice.freeze
    message@ optional.wrap
    pos
    state
  resolveCall =:: calledType
    =:: calledProcId
  .if
    message .length 0:iSize u> if
      message pos errors appendInfo
    else
      message sb.free ..drop
    end
  else
    message pos errors appendError
    TypeCheckCallResult .Error return
  end =:: calledProc
  program [] .procedures
    calledProc .procId i64 cast @[]
  =:: baseProcData
  source .Op .if
    calledType >$ .dataType=
  else ..drop end
  calledType typeContext types.getProcIn .else
    "proc has no in":s pos ..line internalErrorNoOp ..unreachable
  end =:: inTypes
  inTypes .length i32 cast.u =:: argCount
  ## restrict stackValues to acually consumed stack arguments
  stackValues .length
    argCount iSize cast.u iSize.min
  stackValues@ .length=
  source .Values ? or state isGlobal
      program [] .procedures
        calledProcId i64 cast @[]
      .isStatic [] | and state [] .mode .STATIC_PROC ! or
      calledType typeContext types.isTypeGeneratorProc or
      baseProcData .implementation .Code .and .codeState .TYPE_CHECKING ! if
    source stackValues calledType calledProc pos state evaluateCall .SUCCESS if
      TypeCheckCallResult .ConstEval return
    end
  end
  baseProcData .implementation switch
    Code .case =:: codeImpl
      state [] .mode .LINEAR ! if
        ## check if implementation exists if not add to list of missing imples
        calledProc .implementationId =:: implId
        implId -1:i32 == if
          codeImpl [] .codeState .TYPE_CHECKED !
        else
          codeImpl [] .implementations
            implId @[]
          .codeState [] .TYPE_CHECKED !
        end if
          state [] .missingProcs
            ## MissingProc
              ## ProcedureImpl
                implId
                calledProc .procId
              ProcedureImpl new
              pos
            MissingProc new list.append
          state .missingProcs=
        end
      end
      source .Op .if
        calledProc program callInfoToCall >$ .val .Call=
      else ..drop end
    break
    Extern case
      source .Op .if
        calledProc program callInfoToCall >$ .val .Call=
      else ..drop end
    break
    BuiltIn .case [] .builtIn =:: builtInId
      builtInId .SYS_ARGC or builtInId .SYS_ARGV or builtInId .SYS_ENVP if
        true program .hasGetArgs=
      else headConstant _if ## only constant arguments
        source stackValues calledType calledProc pos state evaluateCall .SUCCESS if
          TypeCheckCallResult .ConstEval return
        end
      end
      source .Op .if
        builtInId OpValue .BuiltIn >$ .val=
      else ..drop end
    break
    Alias case ..unreachable ## resolveCall unwraps alias
  end
  calledType TypeCheckCallResult .Generate return
end
proc(
  ProcId slice : procedures
  Operation ptr.mut : op
  TypeCheckState ptr.mut : state
-> ) =>: typeCheckCall
  state [] .program =:: program
  state [] .program .errors =:: errors
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  true =:: mut: headConstant
  ## TODO do not recreate list for each call
  state [] .stack branchTree.depth StackValue list.create =:: mut: stackValues
  state .stack branchTree.itr.start while
    branchTree.itr.hasNext do branchTree.itr.next =:: val ## don't consume value
    ## TODO? don't treat genericArg as constant
    val [] .value .None ? or val [] .value .GenericArg ? if
      false headConstant=
    end
    stackValues
      ## StackValue
        val [] .valueType
        val [] .value
      StackValue new list.append
    stackValues=
  end ..drop
  ## typeCheckCallStackless
    procedures
    stackValues list.asMutableSlice
    headConstant
    op CallSource .Op
    op [] .pos
  state typeCheckCallStackless
      stackValues list.free ..drop
  switch
    Error ConstEval case return
    Generate .case break
  end =:: calledType
  calledType typeContext types.getProcIn .else
    "proc has no in":s op [] .pos ..line internalErrorNoOp ..unreachable
  end =:: inTypes
  inTypes .length =:: argCount
  0 =:: mut: offset
  argCount 1 - while $ 0 iSize.sge do =:: i
    calledType i i32 cast.u typeContext types.getProcArgLabel =:: eltLabel
    inTypes i [] =:: elt
    eltLabel labelContext id.labelFlags id.FLAG_STATIC & ? if
      ## remove static arguments from stack
      state .stack branchTree.pop optional.unwrap =:: opData
      opData [] .opIndex state tryDeleteOp and opData [] .opIndex OP_ARGUMENT != if
        "could not remove static argument ( pushed at " sb.copyPtr
          opData [] .pushedAt [] sb.appendPos
          " )" sb.appendS
        op [] .pos errors appendError
      end
    else ## next argument at top of stack
      elt typeContext types.isEmpty and
          state .stack branchTree.peek .and .valueType [] typeContext types.isEmpty ! if
        continue ## skip empty arguments with non-empty value
      end
      elt typeContext types.isType and state .stack branchTree.peek .if =:: opData
        ## remove push operations for type-arguments
        opData [] .opIndex state tryDeleteOp and opData [] .opIndex OP_ARGUMENT != if
          "could not remove type argument ( pushed at " sb.copyPtr
            opData [] .pushedAt [] sb.appendPos
            " )" sb.appendS
          op [] .pos errors appendError
        end
      end
      ## requireTypes
        elt@ slice.wrap
        "procedure argument":s
        offset false
        op [] .pos
        state
      requireTypes .Err ? if
        return
      end
      offset 1 + offset=
    end
  finally i 1 - end ..drop
  op [] state appendOp ..drop
  calledType typeContext types.getProcOut .else
    "proc has no out":s op [] .pos ..line internalErrorNoOp ..unreachable
  end
    op [] .pos
    state
  pushTypes
end
namespace: typeChecker
  proc(
    LabelId : generatorName
    ConstValue slice : args
    FilePosition ptr : pos
    TypeCheckState ptr.mut : typeChecker
  -> Type optional ) =>: export: initializeGeneratedType
    typeChecker [] .program =:: program
    program .errors =:: errors
    program .idContext =:: idContext
    idContext .constContext =:: constContext
    idContext .typeContext =:: typeContext
    typeContext .labelContext =:: labelContext
    generatorName idContext id.getIdentifier if ..drop
      "could not find procedure " sb.copyPtr
        generatorName labelContext sb.appendLabelPath
      pos errors appendError
      Type optional.empty return
    end =:: idData
    idData [] .idType .PROCEDURE ! if
      "expected procedure got: " sb.copyPtr
        idData id.asIdInfo labelContext sb.appendIdInfo
      pos errors appendError
      Type optional.empty return
    end
    idData [] .constValue .Procedure .else
      "expected procedure got: " sb.copyPtr
        >$ typeContext sb.appendConstant
      pos errors appendError
      Type optional.empty return
    end =:: procId
    program [] .procedures
      procId i64 cast @[]
    =:: procData
    procData [] .procType =:: procType
    procType typeContext types.getProcIn .else
      "proc has no in":s pos ..line internalErrorNoOp ..unreachable
    end =:: inTypes
    inTypes .length i32 cast.u =:: argCount
    args .length StackValue list.create =:: mut: stackValues
    0 =:: mut: argIndex
    args for =:: arg
      while procType argIndex typeContext types.getProcArgLabel labelContext id.labelFlags id.FLAG_AUTO & ? do
        argIndex 1 + argIndex=
      end
      stackValues
        ## StackValue
          inTypes argIndex []
          arg
        StackValue new list.append
      stackValues=
    finally argIndex 1 + argIndex= end
    ## typeCheckCallStackless
      procId@ slice.wrap
      stackValues list.asMutableSlice
      true
      stackValues list.clear stackValues= stackValues@ CallSource .Values
      pos
      typeChecker
    typeCheckCallStackless =:: result
    ## generated type has been initiliaized during evaluation
    ## findGeneratedType
      generatorName
      args
      false
      typeContext
      constContext
    types.findGeneratedType switch
      None case
        "initializing generated type failed " sb.copyPtr
          generatorName labelContext sb.appendLabelPath
        pos errors appendError
      Type optional.empty return
      Stored .case optional.wrap break
      Created case ..unreachable
    end return
  end
  proc(
    Type : stackType
    ConstValue : stackValue
    Type : paramType
    FilePosition ptr : pos
    TypeCheckState ptr.mut : state
  -> bool ) =>: export: canRefineType
    state [] .program =:: progContext
    progContext .idContext =:: idContext
    idContext .typeContext =:: typeContext
    stackValue .None ? if false return end ## can only refine constants
    paramType typeContext types.isSetOrRefinementType ! if
      false return ## target is not an refinement type
    end
    paramType typeContext types.unwrapRefinement =:: paramBase
    stackType
      typeContext types.unwrapRefinement
    paramBase typeContext types.canAutoCast ! if false return end ## base types do not match
    paramType typeContext types.isSetType if
      stackValue paramType typeContext types.checkSetType return
    end
    ## StackValue
      stackType
      stackValue
    StackValue new =:: mut: arg
    arg@ list.wrapBuffer =:: mut: stackValues
    paramType typeContext types.getTypeTrait .else
      false return
    end =:: typeTrait
    ## typeCheckCallStackless
      typeTrait@ slice.wrap
      arg@ slice.wrapMutable
      true
      stackValues@ CallSource .Values
      pos
      state
    typeCheckCallStackless .ConstEval ? ! if
      false return
    end
    ## arg modified by typeCheckCallStackless
    arg .value .Bool .else ..drop false end return
  end
end
proc(
  Operation ptr.mut : op
  TypeCheckState ptr.mut : state
-> ) =>: typeCheckReturn
  state [] .program =:: program
  state [] .program .errors =:: errors
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  false state .reachable=
  state [] .currentProcType .else
    "return is only supported within procedures" sb.copyPtr
    op [] .pos errors appendError
    return
  end =:: procType
  procType op .dataType=
  procType typeContext types.isProcedure ! if
    "unexpected type for return: " sb.copyPtr
      procType typeContext sb.appendType
      " expected procedure" sb.appendS
    op [] .pos errors appendError
    return
  end
  procType typeContext types.getProcOut .else
    "could not resolve procedure return value" sb.copyPtr op [] .pos errors appendError
    return
  end =:: outTypes
  outTypes .length i32 cast.u =:: valCount
  valCount state [] .stack branchTree.depth < if
    "wrong number of return values at the end of procedure expected: " sb.copyPtr
      valCount      sb.appendI
      " got: " sb.appendS
      state [] .stack branchTree.depth sb.appendI
    op [] .pos errors appendError
    ## XXX report position of lowest stack value
    return
  end
  ## requireTypes
    outTypes
    "return statement":s
    0 false
    op [] .pos
  state requireTypes .Err ? if
    return
  end
  op [] state appendOp ..drop
  state [] .stack branchTree.depth 0 > if
    state .stack branchTree.pop optional.unwrap =:: val
    "extra value at the end of procedure" sb.copyPtr
       val [] .valueType typeContext sb.appendType
       " ( pushed at " sb.appendS
       val [] .pushedAt [] sb.appendPos
       " )" sb.appendS
    op [] .pos errors appendError
  end
end
proc(
  Type : srcType
  Type : containerType
  i32 : elementIndex
  bool : isWrite ## TODO pass enum( GET TRY_GET SET ) instead if two booleans
  bool : isUnionGet
  bool : isPtr ## TODO? pass enum( VALUE PTR PTR_MUT ) instead if two booleans
  bool : mutable
  FilePosition ptr : pos
  TypeCheckState ptr.mut : state
-> ) =>: typeCheckGetElement
  state [] .program =:: program
  state [] .program .errors =:: errors
  state [] .program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  OP_UNLINKED =:: mut: onRead
  containerType typeContext types.isArray if
    containerType typeContext types.getBaseType
  else isUnionGet and containerType typeContext types.isTaggedUnion _if
    containerType elementIndex typeContext types.newUnionElement .else
      "cannot create union element":s pos ..line internalErrorNoOp ..unreachable
    end
  else containerType typeContext types.isTaggedUnion _if
    containerType typeContext types.asRawUnion .else
      "cannot get raw union-data":s pos ..line internalErrorNoOp ..unreachable
    end elementIndex typeContext types.compositeGetElement
  else
    containerType elementIndex typeContext types.compositeGetElement
  end =:: eltType
  ## can only take address of reference or pointer
  isPtr and isWrite ! if
    eltType mutable typeContext types.getAddressType
  else
    eltType
  end =:: targetType
  isWrite if
    isPtr and mutable ! if ## TODO more detailed message (? print ptr-type & label name if existent)
      "cannot write to element of immutable pointer" sb.copyPtr
      pos errors appendError
    end
    targetType typeContext types.isEmpty and
        containerType typeContext types.isEnumOrTaggedUnion ! if
      ## discard container and argument from stack
      2 pos state discardValues
      return
    end
    containerType typeContext types.isEnum if
      1 pos state discardValues ## discard old value
      ## push new value
      ## pushConstant
        elementIndex i64 cast.u ConstValue .Int
        containerType
        pos
      state pushConstant
      return
    end
    Type 2 array : args
    targetType args@ 0 =[]
    srcType args@ 1 =[]
    ## requireTypes
      args@ slice.wrap
      "element write":s
      0 false
      pos
    state requireTypes .Err ? if
      return
    end
    ## TODO? constant folding
    containerType typeContext types.isTaggedUnion if
      targetType typeContext types.isEmpty ! if
        1 StackModType .ROTATE pos opStackMod state appendOp ..drop
        1 StackModType .COPY pos opStackMod state appendOp ..drop
        ## TODO? do not use magic-numbers for indices of tagged-union elements
        srcType 0 pos opGetElement state appendOp ..drop
        containerType typeContext types.asRawUnion optional.unwrap
          isPtr if
            srcType typeContext types.isMutable typeContext types.getAddressType
          end
        elementIndex pos opSetUnionElement state appendOp ..drop
        isPtr ! if
          1 StackModType .ROTATE pos opStackMod state appendOp ..drop
          srcType 0 pos opSetElement state appendOp ..drop
        end
        containerType typeContext types.enumLabelInfo ..drop =:: labelType
        elementIndex i64 cast.u ConstValue .Int labelType pos opConst state appendOp ..drop
      end
      1 StackModType .ROTATE pos opStackMod state appendOp ..drop
      srcType 1 pos opSetElement
    else
      ## opSetElement
        srcType
        elementIndex
        pos
      opSetElement
    end =:: newOp
    isPtr if
      newOp state appendOp ..drop
    else
      ## pushValue
        srcType
        ConstValue .None ## TODO? update constant
        newOp
      state pushValue
    end
    return
  end
  eltType typeContext types.isEmpty =:: emptyValue
  emptyValue if ## empty or pointer to empty
    ## discard container from stack and operations
    1 pos state discardValues
  else
    ## remove container from stack
    state .stack branchTree.pop ..drop
  end
  ## operation before get element is copy
  state [] .compiledOps list.peek .and .val .Copy ? end =:: directCopy
  directCopy if
    state [] .compiledOps
      $ .length 1:iSize - list.setLength
    state .compiledOps=
  end
  emptyValue and isPtr if
    ## pushConstant
      0 ConstValue .Int
      targetType
      pos
    state pushConstant
    return
  end
  ## pushValue
    targetType
    ConstValue .None ## XXX compute constant value
    srcType
      elementIndex
      pos
    isUnionGet if
      opGetUnionElement
    else
      opGetElement
    end
  state pushValue
  state .stack branchTree.pop optional.unwrap [] =:: mut: topValue
  ## XXX? is pop then push neccessary
  state .stack topValue branchTree.push
  targetType typeContext types.isEmpty if
    return
  end
  directCopy if
    ## removed copy is operation directly before get element
    ## -> have to reinsert copy after getting element
    state wrapCopy
  else
    state .stack branchTree.pop optional.unwrap [] topValue=
    state .stack topValue branchTree.push
  end
end

proc(
  BlockId : switchId
  Type : switchType
  ConstValue : label0
  iSize : caseCount
  FilePosition ptr : pos
  TypeCheckState ptr.mut : state
-> ) =>: newSwitchLabel
  state [] .program =:: program
  state [] .program .errors =:: errors
  state [] .program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  program [] .switchData
    switchId i64 cast.u @[]
  =:: switchData
  label0 .Int ? ! and label0 .Char ? ! if
    "unsupported constant in switch-label: " sb.copyPtr
      label0 typeContext sb.appendConstant
    pos errors appendError
    return
  end
  label0
    ## truncate constant to correct number of bits (switch-lables are treated as unsigned numbers)
    $ .Int .and =:: intVal
        switchType typeContext types.isIntOrChar and
        switchType typeContext types.sizeOf .Fixed .and =:: size
        size 8 < if ..drop
      intVal 1:i64 size 8 * << 1 - & ConstValue .Int
    end
  =:: label
  switchData [] .switchLabels list.atItr for =:: labelData
    ## constantEquals
      labelData [] .value
      label
    constantEquals if
      "duplicate label " sb.copyPtr
        switchType typeContext types.isEnumOrTaggedUnion if
          ## appendLabelName
            switchType
            label .Int .else
              "expected int":s pos ..line internalErrorNoOp ..unreachable
            end i32 cast.u typeContext types.compositeGetLabel
            labelContext
          sb.appendLabelName
        else
          label0 typeContext sb.appendConstant
        end
        " in switch-case ( previous occurence at " sb.appendS
        labelData [] .pos [] sb.appendPos
        " )" sb.appendS
      pos errors appendError
    end
  end
  switchData [] .switchLabels
    ## LabelData
      label
      caseCount i32 cast.u
      pos
    LabelData new list.append
  switchData .switchLabels=
end
proc(
  Operation ptr : op
  TypeCheckState ptr.mut : state
-> bool #+consume op+# ) =>: typeCheckSwitchLabel
  ## TODO? enable const-evalution in switch-labels
  state [] .program =:: program
  state [] .program .errors =:: errors
  state [] .program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  state peekBlock .and .Switch .else
    "typeCheckSwitchLabel outside switch":s op [] .pos ..line internalErrorNoOp ..unreachable
  end =:: switchBlock
  switchBlock [] .switchType =:: switchType
  switchBlock [] .blockId =:: switchId
  op [] .val .Block .if
    .blockType switch
      CASE DOT_CASE DEFAULT DOT_DEFAULT case
        false return
      BREAK case
        switchBlock [] .allowBreak if
          false switchBlock .allowBreak=
          true return
        end
        break
      default
        break
    end
  else .BlockEnd ? _if
    false return
  end
  ## operation after switch -> don't allow break statement
  false switchBlock .allowBreak=
  switchType typeContext types.isEnumOrTaggedUnion ! if
    ## TODO? allow use of Interpreter in switch labels
    op [] .val .Constant .if =:: constVal
      ## newSwitchLabel
        switchId
        switchType
        constVal
        switchBlock .caseLabels [] .length
        op [] .pos
      state newSwitchLabel
    else .GetId ._if =:: idInfo
      idInfo .labelId
        idContext
      id.getIdentifier if ..drop
        "could not find " sb.copyPtr
          idInfo labelContext sb.appendIdInfo
        op [] .pos errors appendError
        true return
      end =:: idData
      idData [] .constValue .None ? if
        "expected constant got " sb.copyPtr
          idData id.asIdInfo labelContext sb.appendIdInfo
        op [] .pos errors appendError
        true return
      end
      ## newSwitchLabel
        switchId
        switchType
        idData [] .constValue
        switchBlock .caseLabels [] .length
        op [] .pos
      state newSwitchLabel
    else .GetName ._if =:: name
      name
        idContext
      id.findIdentifierByLabel if ..drop
        "could not find " sb.copyPtr
          name labelContext sb.appendLabelName
        op [] .pos errors appendError
        true return
      end =:: idData
      idData [] .constValue .None ? if
        "expected constant got " sb.copyPtr
          idData id.asIdInfo labelContext sb.appendIdInfo
        op [] .pos errors appendError
        true return
      end
      ## newSwitchLabel
        switchId
        switchType
        idData [] .constValue
        switchBlock .caseLabels [] .length
        op [] .pos
      state newSwitchLabel
    else ..drop
      "unsupported operation in switch label:\n " sb.copyPtr
        op [] program sb.appendOp
      op [] .pos errors appendError
      true return
    end
    true return
  end
  ## enum-switch -> try read label
  op [] .val .GetId .if
    .labelId
  else .GetName
  ._else .Constant .and .TypeId .and =:: constType
      constType types.isNamedType _if
    constType typeContext types.namedTypeName
  else
    "unsupported operation for switch label of type " sb.copyPtr
      switchType typeContext sb.appendType
      " : " sb.appendS
      op [] program sb.appendOp
      " expected identifier" sb.appendS
    op [] .pos errors appendError
    true return
  end =:: labelId
  ## compositeFindLabel
    switchType $ typeContext types.isTaggedUnion if
      typeContext types.asRawUnion optional.unwrap
    end
    labelId
  typeContext types.compositeFindLabel .else
    "enum " sb.copyPtr
      switchType typeContext sb.appendType
      " does not have a label " sb.appendS
      labelId labelContext sb.appendLabelName
    op [] .pos errors appendError
    true return
  end =:: labelIndex
  ## newSwitchLabel
    switchId
    switchType
    ## ConstValue
      labelIndex i64 cast.u
    ConstValue .Int
    switchBlock .caseLabels [] .length
    op [] .pos
  state newSwitchLabel
  true return
end

proc( ProgramContext ptr.mut : program -> BlockId ) =>: nextIfId
  program [] .ifCount
    $ 1 + program .ifCount=
  BlockId cast
end
proc( ProgramContext ptr.mut : program -> BlockId ) =>: nextAndOrId
  program [] .andOrCount
    $ 1 + program .andOrCount=
  BlockId cast
end

proc(
  LabelId : label
  Operation ptr.mut : op
  TypeCheckState ptr.mut : state
-> IdentifierInfo optional ) =>: resolveIdentifer
  state [] .program =:: program
  state [] .program .idContext =:: idContext
  label idContext id.findIdentifierByLabel if
    ..drop IdentifierInfo optional.empty return
  end =:: idData
  idData [] .valueType op .dataType=
  idData id.asIdInfo optional.wrap return
end
proc( FilePosition ptr : pos JumpDistance -> iSize ) =>: asForwardJump
  iSize cast.u
    $ 0x8000'0000 u>= if
      "negative jump distance":s pos ..line internalErrorNoOp ..unreachable
    end
  return
end

enum( TUPLE UNION RAW_UNION PROC C_PROC ) =:: CompositeType
proc(
  Operation slice : ops
  CompositeType : compType
  FilePosition ptr : pos
  TypeCheckState ptr.mut : state
-> ) =>: typeCheckCompositeType
  state [] .program =:: program
  program .errors =:: errors
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  state [] .blockMode =:: prevMode
  BlockMode .TYPE state .blockMode=
  program .labelBuffer [] .length =:: labelOffset
  state [] .arrowState =:: oldArrowState
  TypeBlockState optional.empty state .arrowState=
  state .stack
    branchTree.EMPTY
  branchTree.reset =:: oldBranch
  state [] .typeBuffer .length =:: typeOffset
  idContext id.openScope
  ops state typeCheckOps
  idContext id.closeScope ! "closing or-if scope worked" assert
  prevMode state .blockMode=
  state [] .stack branchTree.depth iSize cast.u =:: mut: count
  state [] .typeBuffer
    $ .length =:: tailOffset
    tailOffset count + list.setLength
  state .typeBuffer=
  ## TODO less unsafe way to insert list of elements in reverse order
  ##  e.g.  <list> <count> list.appendReverse for elt end
  while count 0 != do
    count 1 - count=
    pos state popType state [] .typeBuffer count tailOffset + =[]
  end
  state [] .arrowState .if =:: arrowState
    state [] .typeBuffer arrowState .typeOffset list.tail
    state [] .typeBuffer typeOffset arrowState .typeOffset $1 - list.getSlice
  else
    state [] .typeBuffer typeOffset list.tail
    Type slice.empty
  end =:: inTypes =:: types
  program [] .labelBuffer labelOffset list.tail =:: labels
  compType switch
    TUPLE case types labels optional.wrap typeContext types.newTuple break
    UNION case types labels types.UnionType .TAGGED typeContext types.newUnion break
    RAW_UNION case types labels types.UnionType .RAW typeContext types.newUnion break
    PROC case inTypes types labels CallingConvention.DEFAULT typeContext types.newProcedure break
    C_PROC case inTypes types labels CallingConvention .CCALL typeContext types.newProcedure break
  end .else
    "failed to create composite-type" sb.copyPtr
    pos errors appendError
    return
  end =:: newType
  state [] .stack branchTree.depth 0 == "stack is empty after popping types" assert
  state .stack
    oldBranch
  branchTree.reset ..drop
  state removeTrailingNOPs
  newType ConstValue .TypeId types.primitive.TYPE pos state pushConstant
  program [] .labelBuffer
    labelOffset list.setLength
  program .labelBuffer=
  state [] .typeBuffer
    typeOffset list.setLength
  state .typeBuffer=
  oldArrowState state .arrowState=
end
proc(
  Operation slice : ops
  FilePosition ptr : pos
  TypeCheckState ptr.mut : state
-> ) =>: typeCheckSetType
  state [] .program =:: program
  state [] .program .errors =:: errors
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  state .stack
    branchTree.EMPTY
  branchTree.reset =:: oldBranch
  idContext id.openScope
  ops state typeCheckOps
  idContext id.closeScope ! "closing or-if scope worked" assert
  Type optional.empty =:: mut: commonType
  state [] .constBuffer .length =:: constOffset
  while state popTypedValue .and =:: nextVal true do ## TODO! add/use `.do` syntax suggar
    commonType .if
      nextVal .valType typeContext types.mergeTypes .else
        "incompatible types in set-type: " sb.copyPtr
          nextVal .valType typeContext sb.appendType
          " cannot be assigned to " sb.appendS
          commonType optional.get typeContext sb.appendType
        pos errors appendError
        break
      end optional.wrap
    else
      nextVal .valType optional.wrap
    end commonType=
    state [] .constBuffer
      nextVal .value list.append
    state .constBuffer=
  end
  state .stack oldBranch branchTree.reset ..drop
  state removeTrailingNOPs
  state [] .constBuffer constOffset list.tail =:: elements
  commonType .if
    elements typeContext types.newSetType
  else
    "the elements of a set-type have to have the same type" sb.copyPtr pos errors appendError
    Type .Undefined
  end ConstValue .TypeId types.primitive.TYPE pos state pushConstant
  state [] .constBuffer
    constOffset list.setLength
  state .constBuffer=
end
proc(
  Operation slice : ops
  FilePosition ptr : pos
  TypeCheckState ptr.mut : state
-> ) =>: typeCheckEnumType
  state [] .program =:: program
  program .errors =:: errors
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  program .labelBuffer [] .length =:: labelOffset
  program [] .labelBuffer
    ops for =:: op
      op .val .GetName .if
        list.append
      else ..drop
        "unexpected operation in Enum block: " sb.copyPtr
          op program sb.appendOp
        op .pos errors appendError
      end
    end
  program .labelBuffer=
  Type optional.empty program [] .labelBuffer labelOffset list.tail typeContext types.newEnum .else
    "failed to create enum-type" sb.copyPtr
    pos errors appendError
    return
  end ConstValue .TypeId types.primitive.TYPE pos state pushConstant
end
proc(
  Operation slice : ops
  FilePosition ptr : pos
  TypeCheckState ptr.mut : state
-> ) =>: typeCheckInitializer
  state [] .program =:: program
  program .errors =:: errors
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  idContext .constContext =:: constContext
  state [] .blockMode =:: prevMode
  BlockMode .INITIALIZER state .blockMode=
  state .stack
    branchTree.EMPTY
  branchTree.reset =:: oldBranch
  program .labelBuffer [] .length =:: labelOffset
  state [] .constBuffer .length =:: valOffset
  state [] .typeBuffer .length =:: typesOffset
  idContext id.openScope
  ops state typeCheckOps
  idContext id.closeScope ! "closing or-if scope worked" assert
  prevMode state .blockMode=
  state [] .stack branchTree.depth iSize cast.u =:: mut: count
  state [] .constBuffer
    $ .length =:: valsTail
    valsTail count + list.setLength
  state .constBuffer=
  state [] .typeBuffer
    $ .length =:: typesTail
    typesTail count + list.setLength
  state .typeBuffer=
  while count 0 != do
    count 1 - count=
    state popTypedValue .else
      "missing value in initializer expected constant" sb.copyPtr pos errors appendError
      break
    end
      $ .valType state [] .typeBuffer count typesTail + =[]
    .value state [] .constBuffer count valsTail + =[]
  end
  state removeTrailingNOPs
  state .stack oldBranch branchTree.reset ..drop
  ## pushConstant
    state [] .constBuffer valOffset list.tail constContext newArrayConst
    state [] .typeBuffer typesOffset list.tail
      program [] .labelBuffer labelOffset list.tail $ .length 0 != if
        optional.wrap
      else ..drop
        LabelId slice optional.empty
      end
    typeContext types.newInitializerType
    pos
  state pushConstant
  program [] .labelBuffer labelOffset list.setLength program .labelBuffer=
  state [] .constBuffer valOffset list.setLength state .constBuffer=
  state [] .typeBuffer typesOffset list.setLength state .typeBuffer=
end

proc(
  Operation slice : ops
  TypeCheckState ptr.mut : state
-> ) =>: typeCheckOps
  state [] .program =:: program
  state [] .program .errors =:: errors
  state [] .program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  ## TODO extract parts of type-checking code into procedures
  0:iSize while: opLoop $ ops .length u< do =:: mut: opIndex
    ops opIndex [] =:: mut: op
    ## TODO? run code in switch-labels through normal type-checker (after processing enum/union labels)
    state inSwitchLabel and op@ state typeCheckSwitchLabel if
      continue.opLoop
    end
    state [] .reachable ! if
      ## ignore unreachable non-block ops
      op .val switch
        Block .case .blockType switch
          AND AND_IF AND_DO OR OR_IF OR_DO case continue.opLoop
          default break
        end break
        BlockEnd .case .blockType switch
          AND OR case ## only close and-or if top-block is and-or
            state peekBlock .and .AndOr ? if break else continue.opLoop end
          break
          default break
        end break
        ## implementProcedure resets reachability at proc-start
        ImplementProcedure case break
        default continue.opLoop
      end
    end
    ## resolve names
    op .val .GetName .and op@ state resolveIdentifer .if
      op@ .val .GetId=
    else op .val .SetName .and op@ state resolveIdentifer ._if
      op@ .val .SetId=
    else op .val .AtName .and op@ state resolveIdentifer ._if
      op@ .val .AtId=
    else op .val .ExistsName ._if
      op@ state resolveIdentifer ? ConstValue .Bool op@ .val .Constant=
      types.primitive.BOOL op@ .dataType=
    else .AliasName ._if =:: nameAlias
      op .pos state popType =:: aliasType
      aliasType typeContext types.isProcedure ! if
        "alias is only supported for procedure types" sb.copyPtr op .pos errors appendError
        continue.opLoop
      end
      nameAlias .baseName idContext id.findIdentifierByLabel if ..drop
        "cannot find identifer: " sb.copyPtr
          nameAlias .baseName labelContext sb.appendLabelPath
        op .pos errors appendError
        continue.opLoop
      end =:: aliasData
      aliasData .idType [] .PROCEDURE ! if
        "expected procedure name got: " sb.copyPtr
          aliasData [] .idType sb.appendIdType
        op .pos errors appendError
      end
      aliasData [] .constValue .Procedure .else
        "unexpected constant for procedure alias: " sb.copyPtr
          >$ typeContext sb.appendConstant
        op .pos errors appendError
        continue.opLoop
      end =:: mut: aliasId
      program [] .procedures aliasId i64 cast @[]
        $ .implementation [] .Alias .if aliasId= ..drop
          program [] .procedures aliasId i64 cast @[]
          $ .implementation [] .Alias ? ! "no double alias" assert
        else ..drop end
      =:: aliasProc
      aliasType aliasProc [] .procType typeContext types.canAlias ! if
        "incompatible signatures for procedure alias: " sb.copyPtr
          aliasType typeContext sb.appendType
          " cannot be renamed to " sb.appendS
          aliasProc [] .procType typeContext sb.appendType
        op .pos errors appendError
        continue.opLoop
      end
      nameAlias .alias
        aliasType
        IdentifierType .PROCEDURE
        -1 ## index
        ConstValue .None
        false
        op .pos
        state [] .currentFile
        idContext
        errors
      id.declareIdentifier if ..drop.2
        ## error message is created by declareIdentifier
        continue.opLoop
      end >$ ..drop .constValue .Procedure ? ! if
        nameAlias .alias aliasType state [] .currentFile aliasId false op .pos program newProcData
          ConstValue .Procedure
        nameAlias .alias idContext id.getIdentifier
          ! "procName is identifier" assert
        .constValue=
      end
      continue.opLoop
    else .DeclareName ? or op .val .InitializeName ? _if
      op .val .InitializeName ? =:: isInit
      op .val .InitializeName .if =:: initName
        op@ initName .initType .AUTO state resolveDeclarationType
        initName .label
      else .DeclareName ._else ..unreachable end
        state [] .blockMode .NONE ! if
          Type .Undefined
          IdentifierType .LABEL
        else
          op .dataType $ .Undefined ? if ..drop
            op .pos state popType
            $ op@ .dataType=
          end
        state isGlobal _if
          $1 labelContext id.currentNamespace labelContext id.setLabelNamespace
          $ typeContext types.isProcedure if
            IdentifierType .PROCEDURE
          else $ typeContext types.isType _if
            IdentifierType .TYPE
          else
            IdentifierType .GLOBAL_VAR
          end
        else
          IdentifierType .LOCAL_VAR
        end
        -1 ## index
        ConstValue .None
        isInit
        op .pos
        state [] .currentFile
        idContext
        errors
      id.declareIdentifier if ..drop.2
        ## error message is created by declareIdentifier
        continue.opLoop
      end =:: idData ..drop
      op .dataType idData@ id.asIdInfo op .pos
      isInit ! if
        opDeclareId
      else op .val .InitializeName .and .initType .AUTO _if
        opAutoTypedInitializeId
      else
        opInitializeId
      end op=
    end
    ## convert static arguments to constants
    op .val .GetId .and .labelId =:: label
        label labelContext id.labelFlags id.FLAG_STATIC & ? and
        state .argData label map.at .if =:: argData
      argData [] .valType op@ .dataType=
      argData [] .value op@ .val .Constant=
    end
    op .val switch
      NOP case continue.opLoop
      Constant .case op .dataType op .pos state pushConstant continue.opLoop
      NestedProc .case =:: procId
        program [] .procedures procId i64 cast @[] =:: procData
        procData [] .procType .Undefined ? ! or
            procData .implementation .Code ! .or [] .codeState .PARSING ! if
          "unexpected state for nested procedure" sb.copyPtr
          op .pos errors appendError
          continue.opLoop
        end
         ## ensure lambda is type-checked
        state [] .missingProcs
          ## MissingProc
            ## ProcedureImpl
              -1
              procId
            ProcedureImpl new
            op .pos
          MissingProc new list.append
        state .missingProcs=
        op .pos state popType =:: procType
        procType procData typeContext setProcType
        idContext id.currentScope procData .scopeId= ## remember host scope
        ProcCodeState .PARSED procData .implementation .Code .else
          "expected code-proc":s op .pos ..line internalErrorNoOp ..unreachable
        end .codeState=
        procId ConstValue .Procedure
          procType ## TODO? special type for procedure literal
        op .pos state pushConstant
        continue.opLoop
      GetName SetName AtName .case =:: labelId
        "could not find identifier: " sb.copyPtr
          labelId labelContext sb.appendLabelPath
        op .pos errors appendError
        continue.opLoop
      InitializeName DeclareName AliasName case ..unreachable
      UsingNamespace .case =:: usingNamespace
        usingNamespace .baseName =:: namespaceLabel
        usingNamespace .alias
          $ id.LABEL_ID_NONE == if ..drop
            string.empty
          else
            labelContext id.getLabelName
          end
        =:: aliasName
        namespaceLabel aliasName idContext id.importNamespace if
          "namespace \"" sb.copyPtr
            namespaceLabel labelContext sb.appendLabelName
          "\" does not exist in the current scope" sb.appendS op .pos errors appendWarning
        end
        continue.opLoop
      UsingIdentifier .case =:: usingIdentifier
        usingIdentifier .baseName =:: srcLabel
        usingIdentifier .alias
          $ id.LABEL_ID_NONE == if ..drop
            string.empty
          else
            labelContext id.getLabelName
          end
        =:: aliasName
        srcLabel labelContext id.getLabelName
          aliasName
          idContext
          op .pos
        errors id.importIdentifier ..drop
        continue.opLoop
      GetId .case =:: idInfo
        idInfo .labelId labelContext id.labelFlags =:: flags
        flags id.FLAG_MUTABLE & ? =:: mutable
        flags id.FLAG_STATIC & ? =:: isStatic
        mutable and isStatic ! and state isGlobal ! if
          ConstValue .None
        else
          idInfo .idType switch
            TYPE PROCEDURE PROCEDURE_BUNDLE GLOBAL_VAR LOCAL_VAR case
              true break ## can hold identifer
            ARGUMENT LABEL TMP_VAR ITR_VAR case
              false break
          end if
            ## getIdentifierByLabel
              idInfo .labelId
              idContext
            id.getIdentifier if ..drop
              "could not find " sb.copyPtr
                idInfo labelContext sb.appendIdInfo
              op .pos errors appendError
              continue.opLoop
            end =:: idData
            idData [] .constValue
          else
            ConstValue .None
          end
        end =:: constValue
        idInfo .idType switch
          GLOBAL_VAR LOCAL_VAR TMP_VAR ITR_VAR case
            idInfo .labelId =:: labelId
            mutable ! and constValue .None ? ! and idInfo .idType .GLOBAL_VAR if
              ## replace access to immutable global variable with constant
              constValue op .dataType op .pos opConst op=
            end
            ## pushValue
              op .dataType
              constValue
              op
            state pushValue
            labelId state replaceLabel
            mutable if ## insert copy for mutable values
              state wrapCopy
            end
            continue.opLoop
          TYPE case
            constValue op .dataType op .pos opConst op=
            op .dataType constValue op state pushValue
            idInfo .labelId state replaceLabel
            continue.opLoop
          ARGUMENT case
            idInfo .labelId =:: label
            state .argData label map.at .if =:: argData
              argData [] .valType op@ .dataType=
              argData [] .value
            else
              ConstValue .None
            end =:: argValue
            op .dataType argValue op state pushValue
            label state replaceLabel
            continue.opLoop
          PROCEDURE PROCEDURE_BUNDLE case
            idInfo .idType .PROCEDURE if
              constValue@ .Procedure .else ..drop
                "missing implementation for " sb.copyPtr
                  idInfo labelContext sb.appendIdInfo
                op .pos errors appendError
                continue.opLoop
              end =:: procId
              program [] .procedures
                procId [] i64 cast @[]
              =:: procData
              procId slice.wrap
            else  ## PROCEDURE_BUNDLE
              constValue .ProcedureBundle .else ..drop
                "missing implementation for " sb.copyPtr
                  idInfo labelContext sb.appendIdInfo
                op .pos errors appendError
                continue.opLoop
              end =:: bundleId
              program [] .procBundles
                bundleId i64 cast @[] .procedures []
              list.asSlice
            end op@ state typeCheckCall
            continue.opLoop
          LABEL case
            ## pushValue
              idInfo .labelId
                op .dataType typeContext types.isType if
                  types.newGenericType ConstValue .TypeId
                else
                  ConstValue .GenericArg
                end
              op .dataType
              op .pos
            state pushConstant
            continue.opLoop
        end
        break
      CallPtr case
        state .stack branchTree.peek .else
          ## TODO? print instruction name instead of 'call'
          "missing argument for call, expected procedure pointer" sb.copyPtr
          op .pos errors appendError
          continue.opLoop
        end [] .valueType =:: calledType
        calledType typeContext types.isCallable ! if
          "cannot call values of type " sb.copyPtr
            calledType typeContext sb.appendType
          op .pos errors appendError
          continue.opLoop
        end
        ## requireTypes
          calledType@ slice.wrap
          "procedure pointer":s
          0 false
          op .pos
          state
        requireTypes .Err ? if continue.opLoop end
        calledType op@ .dataType=
        calledType typeContext types.isPointer if
          calledType typeContext types.getBaseType
        else
          calledType
        end =:: procType
        procType typeContext types.getProcIn .else
          "proc has no in":s op .pos ..line internalErrorNoOp ..unreachable
        end =:: inTypes
        ## requireTypes
          inTypes
          "procedure argument":s
          1 false
          op .pos
          state
        requireTypes .Err ? if continue.opLoop end
        op state appendOp ..drop
        procType typeContext types.getProcOut .else
          "proc has no out":s op .pos ..line internalErrorNoOp ..unreachable
        end
          op .pos
          state
        pushTypes
        continue.opLoop
      AtId .case =:: idInfo
        idInfo .idType switch
          GLOBAL_VAR LOCAL_VAR TMP_VAR PROCEDURE ITR_VAR ARGUMENT case
            idInfo .labelId =:: labelId
            labelId
              labelContext id.labelFlags
            id.FLAG_MUTABLE & ? =:: mutable
            idInfo .idType .PROCEDURE if
              ## getIdentifierByLabel
                idInfo .labelId
                idContext
              id.getIdentifier if ..drop
                "could not find " sb.copyPtr
                  idInfo labelContext sb.appendIdInfo
                op .pos errors appendError
                continue.opLoop
              end =:: idData
              idData [] .constValue .Procedure .else
                "expected procedure-constant":s op ..line state internalError ..unreachable
              end =:: mut: procId
              program [] .procedures
                procId i64 cast @[]
                $ [] .procType op@ .dataType=
                $ .implementation .Alias .if [] procId= ..drop
                  program [] .procedures procId i64 cast list.at .else
                    "could not find procedure alias":s op ..line state internalError ..unreachable
                  end
                  $ .implementation [] .Alias ? ! "no double alias" assert
                else ..drop end
              =:: procData
              -1:i32 =:: mut: implId
              procData [] .hasStaticArg if
                ## TODO resolve implementation id
                ##  -> get static args from stack
                ##  -> replace op with generic-procedure pointer
                ##  -> generic proc ptr : ( procId, implId )
                break
              end
              procData .implementation .BuiltIn .if
                true >$ .hasPtr=
              else .Code ._if =:: codeImpl
                codeImpl .codeState [] .TYPE_CHECKED ! if
                  state [] .missingProcs
                    ## MissingProc
                      ## ProcedureImpl
                        implId
                        procId
                      ProcedureImpl new
                      op .pos
                    MissingProc new list.append
                  state .missingProcs=
                end
              else
                "unexpected proc implementation":s op ..line state internalError ..unreachable
              end
              ## ProcedureImpl
                implId
                procId
              ProcedureImpl new
                OpValue .ProcPtr
              op@ .val=
            end
            op .dataType typeContext types.isEmpty if
              ## pushValue
                0 ConstValue .Int
                op .dataType
                  mutable
                typeContext types.getAddressType
                op .pos
              state pushConstant
            else
              ## pushValue
                op .dataType
                  mutable
                typeContext types.getAddressType
                idInfo .idType .GLOBAL_VAR if
                  labelId ConstValue .GlobalPointer
                else
                  ConstValue .None
                end
                op
              state pushValue
            end
            labelId state replaceLabel
            continue.opLoop
          TYPE LABEL PROCEDURE_BUNDLE case
            "taking the address of identifier " sb.copyPtr
              idInfo labelContext sb.appendIdInfo
              " is not supported" sb.appendS
            op .pos errors appendError
            continue.opLoop
        end
        break
      SetId .case =:: idInfo
        idInfo .labelId =:: labelId
        labelId
          labelContext id.labelFlags
        id.FLAG_MUTABLE & ? ! if
          256 sb.create
            idInfo labelContext sb.appendIdInfo
            " is not mutable" sb.appendS
          op .pos errors appendError
        end
        ## requireTypes
          op@ .dataType slice.wrap
          "set identifier":s
          0 false
          op .pos
          state
        requireTypes .Err ? if continue.opLoop end
        op state appendOp ..drop
        continue.opLoop
      DeclareId .case =:: idInfo
        state .blockMode [] .NONE ! if
          1 op .pos state checkStackSize if
            continue.opLoop ## stack underflow
          end
          idInfo .idType .LABEL "composite-element has type label" assert
          ## assign constant value to label
          state .stack branchTree.peek .if =:: stackVal
            ## getIdentifierByLabel
              idInfo .labelId
              idContext
            id.getIdentifier if ..drop
              "could not find " sb.copyPtr
                idInfo labelContext sb.appendIdInfo
              op .pos errors appendError
              continue.opLoop
            end =:: idData
            state [] .blockMode switch
              TYPE case
                stackVal [] .value .WildCard .if ..drop
                  ## TODO make behaviour of _ dependent on container type
                  ##  Union -> empty element, Proc -> anonymous generic, Struct -> compiler error
                  types.primitive.TYPE stackVal .valueType=
                  Type .Empty ConstValue .TypeId stackVal .value=
                  Type .Empty
                else .TypeId ._else ..drop
                  stackVal [] .valueType
                end idData .valueType=
                idInfo .labelId labelContext id.labelFlags id.FLAG_STATIC & ? if
                  stackVal [] .valueType typeContext types.isType if
                    idInfo .labelId types.newGenericType ConstValue .TypeId
                  else
                    idInfo .labelId ConstValue .GenericArg
                  end
                else
                  ConstValue .None
                end idData .constValue=
              break
              INITIALIZER case
                stackVal [] .valueType idData .valueType=
                stackVal [] .value idData .constValue=
              break
              NONE case ..unreachable
            end
            stackVal [] .value .TypeId .and typeContext types.isType if
              ## type-arguments are always static
              idInfo .labelId id.FLAG_STATIC labelContext id.addLabelFlags
            end
          end
          state [] .arrowState ? if
            continue.opLoop ## ignore element labels after arrow
          end
          state [] .stack branchTree.depth iSize cast.u =:: mut: count
          program [] .labelBuffer
            count 1 - for ..drop ## pad to correct number of labels
              id.LABEL_ID_NONE list.append
            end
            idInfo .labelId list.append
          program .labelBuffer=
          state [] .blockMode switch
            TYPE case
              state [] .typeBuffer
                $ .length =:: typeOffset
                typeOffset count + list.setLength
              state .typeBuffer=
              while count 0 != do
                count 1 - count=
                op .pos state popType state [] .typeBuffer count typeOffset + =[]
              end
            continue.opLoop
            INITIALIZER case
              state [] .typeBuffer
                $ .length =:: typeOffset
                typeOffset count + list.setLength
              state .typeBuffer=
              state [] .constBuffer
                $ .length =:: valOffset
                valOffset count + list.setLength
              state .constBuffer=
              while count 0 != do
                count 1 - count=
                state popTypedValue .else
                  "stack underflow":s op ..line state internalError ..unreachable
                end
                  $ .value state [] .constBuffer count valOffset + =[]
                .valType state [] .typeBuffer count typeOffset + =[]
              end
            continue.opLoop
            NONE case ..unreachable
          end
        end
        op .dataType .Undefined ? if
          op@ false state resolveDeclarationType
        end
        idInfo .idType switch
          PROCEDURE case
            idInfo .labelId idContext id.getIdentifier if ..drop
              "could not find " sb.copyPtr
                idInfo .labelId labelContext sb.appendLabelPath
              op .pos errors appendError
              continue.opLoop
            end .constValue =:: constVal
            constVal [] .None .if ..drop
            else .Procedure ._if =:: procId
              continue.opLoop ## skip if value already exits
            else
              "unexpected constant for procedure: " sb.copyPtr
                >$ typeContext sb.appendConstant
              op .pos errors appendError
              continue.opLoop
            end
            ## newProcData
              idInfo .labelId
              op .dataType
              state [] .currentFile
              NO_PROC
              false
              op .pos
              program
            newProcData ConstValue .Procedure constVal =[]
          continue.opLoop
          GLOBAL_VAR LOCAL_VAR TMP_VAR ITR_VAR case
            state isGlobal ! if ## ignore declarations outside procedure
              op state appendOp ..drop
            end
          continue.opLoop
          TYPE case ## set const-value to named type
            ## getIdentifier
              idInfo .labelId
              idContext
            id.getIdentifier if ..drop
              "could not find " sb.copyPtr
                idInfo labelContext sb.appendIdInfo
              op .pos errors appendError
            else =:: idData
              idInfo .labelId
                typeContext types.declareNamedType
              ConstValue .TypeId idData .constValue=
            end
          continue.opLoop
          LABEL PROCEDURE_BUNDLE case ## XXX? allow type-variables during type-check phase
            "unexpected declaration of identifier " sb.copyPtr
              idInfo labelContext sb.appendIdInfo
            op .pos errors appendError
          continue.opLoop
          ARGUMENT case
            "cannot declare identifier " sb.copyPtr
              idInfo labelContext sb.appendIdInfo
            op .pos errors appendError
          continue.opLoop
        end
        break
      InitializeId AutoTypedInitializeId .case =:: idInfo
        op .val .AutoTypedInitializeId ? =:: autoTyped
        op .dataType .Undefined ? if
          op@ autoTyped state resolveDeclarationType
        end
        idInfo op@ .val .InitializeId= ## auto-typed initializations have been resolved
        idInfo .idType switch
          GLOBAL_VAR LOCAL_VAR ITR_VAR PROCEDURE TYPE case
            state .stack branchTree.peek .if
              [] .value
              idInfo .idType .TYPE if
                .TypeId .else
                  "unexpected constant for type declaration" sb.copyPtr
                    >$ typeContext sb.appendConstant
                  op .pos errors appendError
                  continue.opLoop
                end idInfo .labelId typeContext types.initializeNamedType .else
                  "re-initialization of named type" sb.copyPtr
                    idInfo .labelId labelContext sb.appendLabelPath
                  op .pos errors appendError
                  continue.opLoop
                end ConstValue .TypeId
              end
            else ConstValue .None end =:: constVal
            constVal .TypeId ? or state isGlobal and constVal .None ? ! if
              ## remove type-constant from code
              1 op .pos state discardValues
            else
              ## requireTypes
                op@ .dataType slice.wrap
                "initialization":s
                0 false
                op .pos
              state requireTypes .Err ? if ## TODO? can requireTypes change constVal
                continue.opLoop
              end
            end
            ## update constant value in identifier if stack-value is constant
            ##   don't update mutable local variables
            constVal .TypeId ? or constVal .None ? ! and
                state isGlobal or idInfo .idType .GLOBAL_VAR or idInfo .idType .PROCEDURE or
                idInfo .labelId labelContext id.labelFlags id.FLAG_MUTABLE & ? ! if
              ## TODO special handling for procedure constants
              ## getIdentifier
                idInfo .labelId
                idContext
              id.getIdentifier if ..drop
                "could not find " sb.copyPtr
                  idInfo labelContext sb.appendIdInfo
                op .pos errors appendError
              else =:: idData
                constVal idData .constValue=
              end
              idInfo .idType .PROCEDURE if
                constVal .Procedure .if =:: procId
                  program [] .procedures procId iSize cast.u @[] =:: procInfo
                  procInfo .procType .Undefined ? if
                    op .dataType procInfo .procType=
                  end
                  procInfo .labelId [] labelContext id.labelFlags id.FLAG_LAMBDA & ? if
                    MAIN_NAME idInfo .labelId labelContext id.labelNameEq if
                      ## TODO! check if main has correct signature
                      idInfo .labelId program .mainLabelId=
                      procId program .mainProcId=
                    end
                    idInfo .labelId procInfo .labelId=
                    idInfo .labelId labelContext id.labelFlags id.FLAG_STATIC & ? if
                      true procInfo .isStatic=
                    end
                  end
                else ..drop
                  "expected Procedure got " sb.copyPtr
                    constVal typeContext sb.appendConstant
                  op .pos errors appendError
                end
              end
              ## don't create code for declaration of type-constant
              constVal .TypeId ? or state isGlobal if
                continue.opLoop
              end
            end
            op state appendOp ..drop
            continue.opLoop
          PROCEDURE_BUNDLE LABEL ARGUMENT TMP_VAR case
            "unexpected initialization of identifier " sb.copyPtr
              idInfo labelContext sb.appendIdInfo
            op .pos errors appendError
            continue.opLoop
        end
        break
      ImplementProcedure case break
      GetElement GetUnionElement SetElement .case =:: index
        op .val .SetElement ? =:: isWrite
        op .val .GetUnionElement ? =:: isUnionGet
        isWrite if 2 else 1 end op .pos state checkStackSize if
          continue.opLoop
        end
        false =:: mut: mutable
        false =:: mut: isPtr
        state .stack branchTree.peek optional.unwrap [] =:: container
        container .valueType =:: mut: srcType
        srcType
          $ typeContext types.isPointer if
             $ srcType=
             true isPtr=
             $ typeContext types.isMutable mutable=
             typeContext types.ptrTarget
          else $ types.isLiteral _if
            typeContext types.literalToType
              $ srcType=
            container $1 SignType .NONE op .pos state tryCastConstant if
              "could not convert literal to type: " sb.copyPtr
                srcType typeContext sb.appendType
              op .pos errors appendError
            end
          end
        =:: mut: containerType
        containerType typeContext types.isTuple if
          index containerType typeContext types.compositeEltCount >= if
            "element index out of range: " sb.copyPtr
              index sb.appendI
              " size: " sb.appendS
              containerType typeContext types.compositeEltCount sb.appendI
            op .pos errors appendError
            continue.opLoop
          end
          srcType containerType index isWrite isUnionGet isPtr mutable op .pos state typeCheckGetElement
        else containerType typeContext types.isArray _if
          containerType typeContext types.getArraySize .Int .else ..drop
            "generic arrays are not supported" sb.copyPtr
            op .pos errors appendError
            continue.opLoop
          end =:: eltCount
          index i64 cast.u eltCount >= if
            "element index out of range: " sb.copyPtr
              index sb.appendI
              " size: " sb.appendS
              containerType typeContext types.compositeEltCount sb.appendI
            op .pos errors appendError
            continue.opLoop
          end
          srcType containerType index isWrite isUnionGet isPtr mutable op .pos state typeCheckGetElement
        else
          "indexed element access is only supported on tuples, structs and arrays got: " sb.copyPtr
            srcType typeContext sb.appendType
          op .pos errors appendError
        end
        continue.opLoop
      GetLabel SetLabel ExistsLabel .case =:: labelId
        enum( CHECK CHECK_ENUM GET UNION_GET ) =:: LabelAccessType
        LabelAccessType .GET =:: mut: accessType
        op .val .SetLabel ? =:: isWrite
        op .val .ExistsLabel ? if
          LabelAccessType .CHECK accessType=
        end
        1:i32 isWrite if 1 + end op .pos state checkStackSize if
          continue.opLoop
        end
        state .stack branchTree.peek optional.unwrap [] =:: container
        false =:: mut: mutable
        container .valueType =:: mut: srcType
        false =:: mut: isPtr
        false =:: mut: isType
        srcType
          $ typeContext types.isType and container .value .TypeId .if =:: typeId ..drop
            true isType=
            typeId
          else $ typeContext types.isPointer _if
             true isPtr=
             $ typeContext types.isMutable mutable=
             typeContext types.ptrTarget
          else $ types.isLiteral _if
            typeContext types.literalToType
              $ srcType=
            container $1 SignType .NONE op .pos state tryCastConstant if
              "could not convert literal to type: " sb.copyPtr
                srcType typeContext sb.appendType
              op .pos errors appendError
            end
          end
        =:: containerType
        containerType
          $ typeContext types.isTaggedUnion if
            typeContext types.asRawUnion optional.unwrap
          end
        =:: innerContainerType
        ## compositeFindLabel
          innerContainerType
          labelId
          typeContext
