                labels  .length eltCount iSize cast.u u< if
                  "switch statement does not cover all labels in enum " sb.copyPtr
                    switchBlock .switchType
                      typeContext
                    sb.appendType
                    "\nmissing labels:\n" sb.appendS
                    0:i64 while $ eltCount i64 cast.u < do =:: i
                      false =:: mut:  match
                      ## XXX? use slice.find
                      labels for =:: label
                        label .value .Int .and i == if
                          true match=
                          break
                        end
                      end
                      match ! if
                        rawSwitchType
                          i i32 cast.u
                          typeContext
                        types.compositeGetLabel =:: label
                        " - \"" sb.appendS
                        label labelContext sb.appendLabelPath
                        "\" declaredAt"  sb.appendS
                        label labelContext id.labelPos .if
                          [] sb.appendPos
                        else
                          "?" sb.appendS
                        end
                        '\n' sb.appendC
                      end
                      i 1 +
                    end ..drop
                  op .pos errors appendError
                end
                "enum label outside expected range":s op .pos opPanicWithMessage state appendOp ..drop
              else
                caseBranches
                  ## BranchPoint
                    switchBlock .branchRoot
                    op .pos
                  BranchPoint new list.append
                caseBranches=
              end
              switchBlock .endLabel CompareType .NONE op .pos state localJump
            end
            ## set stack head to one of the accepting branches
            caseBranches .length 1:iSize u>= if
              caseBranches .length branchTree.NodeId list.create
                caseBranches for .node list.append end
              =:: branchPoints
              ## mergeValues
                state .stack
                branchPoints list.asSlice
                mergeBranches@
                ## MergePoint
                  "switch-case block":s
                  op .pos
                  switchBlock .castOffsets list.asSlice
                  state
                  0
                  MergeType .MERGE
                MergePoint new
              branchTree.merge .Error ? if
                "different numbers of types at the end of switch-branches: " sb.copyPtr
                  caseBranches for =:: branchPoint
                    "\n  * " sb.appendS
                    state [] .stack
                      branchPoint .node
                    branchTree.depthFrom sb.appendI
                    " in branch at " sb.appendS
                    branchPoint .pos [] sb.appendPos
                  end
                  '\n' sb.appendC
                op .pos errors appendError
              end
              branchPoints list.free ..drop
            end
            caseBranches .length 0:iSize != state .reachable=
            program [] .programMemory
              switchBlock .caseLabels list.asSlice mixedArena.copySlice =:: caseLabels
              switchBlock .caseLabels .length i32 cast.u JumpDistance mixedArena.allocSlice =:: caseJumps
            program .programMemory=
            caseLabels .length for =:: i
              state .jumpOffsets caseLabels i [] map.remove .and .Label .else
                "expected label":s op ..line state internalError ..unreachable
              end
                switchBlock .switchPos -
              JumpDistance cast.s caseJumps i =[]
            end
            caseLabels slice.freeze switchData .branchLabels=
            caseJumps slice.freeze switchData .caseJumpDistances=
            state .jumpOffsets switchData [] .defaultLabel map.remove .and .Label .else
              "expected label":s op ..line state internalError ..unreachable
            end
              switchBlock .switchPos -
            JumpDistance cast.s switchData .defaultJumpDistance=
            switchBlock .endLabel LocalLabelType .LABEL_END op .pos state localLabel
            switchBlock .caseLabels list.free ..drop
            switchBlock .caseBranches list.free ..drop
            switchBlock .castOffsets list.free ..drop
            idContext id.closeScope ! "closing while-scope worked" assert
            continue.opLoop
          CASE DEFAULT DOT_CASE DOT_DEFAULT case ## end-case should not be created by parser
            break
          FINALLY case
            op .pos state closeBlock .While .else
              "unexpected end of " sb.copyPtr
                >$ sb.appendBlockInfoName
                "-block expected " sb.appendS
                WHILE_BLOCK_INFO_NAME sb.appendS
                "-block" sb.appendS
              op .pos errors appendError
              continue.opLoop
            end =:: whileBlock
            whileBlock .breakBranches =:: breakBranches
            ## XXX? avoid allocation if it si not neccessary
            breakBranches .length branchTree.NodeId list.create
              whileBlock .branchRoot .node list.append
              state .stack branchTree.startBranch list.append
            =:: mut: branchPoints
            i32 2 array new =:: mut: castOffsets
            OP_UNLINKED castOffsets@ 0 =[]
            ## reserveOps
              state [] .stack branchTree.depth
              op .pos
            state reserveOps castOffsets@ 1 =[]
            ## mergeValues
              state .stack
              branchPoints list.asSlice
              mergeBranches@
              ## MergePoint
                "while loop":s
                op .pos
                castOffsets@ 2 slice.create
                state
                0
                MergeType .MERGE_ROOT
              MergePoint new
            branchTree.merge .Success .else ..drop
              "different numbers of types at beginning and end of while-block: " sb.copyPtr
                "\n  * " sb.appendS
                state [] .stack
                   whileBlock .branchRoot .node
                branchTree.depthFrom sb.appendI
                " in branch at " sb.appendS
                whileBlock .branchRoot .pos [] sb.appendPos
                "\n  * " sb.appendS
                state [] .stack
                  branchPoints list.peek optional.unwrap []
                branchTree.depthFrom sb.appendI
                " in branch at " sb.appendS
                op .pos [] sb.appendPos
                '\n' sb.appendC
              op .pos errors appendError
              continue.opLoop
            end =:: depth
            whileBlock .blockId =:: whileId
            ## remember number of changed stack values ( necessary for merging values in compiled code )
            program .backJumpInfo
              whileBlock .whileLabel
              depth BackJumpInfo.new
            map.put ..drop
            breakBranches .length 1:iSize u>= if
              branchPoints
                list.clear
                breakBranches for .node list.append end
              branchPoints=
              ## mergeValues
                state .stack
                branchPoints list.asSlice
                mergeBranches@
                ## MergePoint
                  "while block":s
                  op .pos
                  whileBlock .breakCastOffsets list.asSlice
                  state
                  whileBlock .doBranchIndex
                  MergeType .MERGE_ROOT
                MergePoint new
              branchTree.merge .Error ? if
                "different numbers of types at the end of while branches: " sb.copyPtr
                  breakBranches for =:: branchPoint
                    "\n  * " sb.appendS
                    state [] .stack
                      branchPoint .node
                    branchTree.depthFrom sb.appendI
                    " in branch at " sb.appendS
                    branchPoint .pos [] sb.appendPos
                  end
                  '\n' sb.appendC
                op .pos errors appendError
              end
            end
            branchPoints list.free ..drop
            whileBlock .breakBranches .length 0:iSize != state .reachable=
            whileId op@ .val .BlockEnd .else "expected block" ..panic end .blockId=
            whileBlock .breakBranches list.free ..drop
            whileBlock .breakCastOffsets list.free ..drop
            whileBlock .continueBranches list.free ..drop
            whileBlock .continueCastOffsets list.free ..drop
            whileBlock .doBranches list.free ..drop
            whileBlock .whileLabel CompareType .NONE op .pos state localJump
            whileBlock .whileLabel LocalLabelType .HINT_END op .pos state localLabel
            whileBlock .endLabel LocalLabelType .LABEL_END op .pos state localLabel
            idContext id.closeScope ! "closing switch-scope worked" assert
            continue.opLoop
          WHILE DO case ## end-while/end-do should not be created by parser
            break
          AND OR case
            op .pos state closeBlock .AndOr .else
              "unexpected end of " sb.copyPtr
                >$ sb.appendBlockInfoName
                "-block expected " sb.appendS
                AND_OR_BLOCK_INFO_NAME sb.appendS
                "-block" sb.appendS
              op .pos errors appendError
              continue.opLoop
            end =:: andOrBlock
            state [] .reachable ! if
              "the end of all branches of an and/or block should be reachable, use if-else for conditional exit" sb.copyPtr
              op .pos errors appendError
            end
            andOrBlock .blockId op@ .val .BlockEnd .else "expected block" ..panic end .blockId=
            andOrBlock .endLabel LocalLabelType .LABEL_END op .pos state localLabel
            andOrBlock .branches =:: mut: branches
            branches
                state .stack branchTree.startBranch
                  op .pos
                BranchPoint new list.append
            branches=
            branches .length branchTree.NodeId list.create
              branches for .node list.append end
            =:: branchPoints
            ## mergeValues
              state .stack
              branchPoints list.asSlice
              mergeBranches@
              ## MergePoint
                "and or block":s
                op .pos
                i32 slice.empty
                state
                0
                MergeType .NO_CAST
              MergePoint new
            branchTree.merge .Error ? if
              "different number of types at the end or and-or branch: " sb.copyPtr
                branches for =:: branchPoint
                  "\n  * " sb.appendS
                  state [] .stack
                    branchPoint .node
                  branchTree.depthFrom sb.appendI
                  " in branch at " sb.appendS
                  branchPoint .pos [] sb.appendPos
                end
                '\n' sb.appendC
              op .pos errors appendError
            end
            idContext id.closeScope ! "closing andOr-scope worked" assert
            branchPoints list.free ..drop
            branches list.free ..drop
            continue.opLoop
          NAMESPACE case
            idContext id.endNamespace if
              "unexpected end of namespace" sb.copyPtr op .pos errors appendError
            end
          continue.opLoop
          AND_IF OR_IF AND_DO OR_DO
          BREAK CONTINUE
          UNKNOWN OVERLOAD case
            break
        end
        break
      Return case
        op@ state typeCheckReturn
        continue.opLoop
      Assert RuntimeAssert case
        op .val .Assert ? if
          op .pos state popString =:: message
          message op .pos opRuntimeAssert op=
        end
        state .stack branchTree.peek .and .value [] .Bool .if =:: boolVal
          1 op .pos state discardValues
          boolVal ! if
            "assertion failed: " sb.copyPtr
              op .val .RuntimeAssert .else 
                "expected runtime-assertion":s op ..line state internalError ..unreachable
              end sb.appendStr
            op .pos errors appendError
          end
          continue.opLoop
        end
        ## requireTypes
          types.primitive.BOOL@ slice.wrap
          "assertion":s
          0 false
          op .pos
        state requireTypes .Err ? if
          continue.opLoop
        end
        op state appendOp ..drop
        continue.opLoop
      Panic case
        op .pos state popString =:: message
        message op .pos opPanicWithMessage op=
        false state .reachable=
        op state appendOp ..drop
        continue.opLoop
      PanicWithMessage case
        false state .reachable=
        op state appendOp ..drop
        continue.opLoop
      Error .case =:: errValue
        1 op .pos state checkStackSize if
          continue.opLoop
        end
        state [] .mode .STATIC_PROC if
          ## don't evaluate errors when type-checking static procs
          state .stack branchTree.pop ..drop
          op state appendOp ..drop
          continue.opLoop
        end
        ## appendError
          op .pos state popString sb.fromStr
          ## TODO? append initialization stack for all error messages
          state [] .initializationStack .length 0:iSize != if
            "\n  caused by initializing code at " sb.appendS
            op .pos [] sb.appendPos
            '\n' sb.appendC
            state [] .initializationStack .length i32 cast.u 1 - while
              $ 0 > ## XXX? only go until position in last reset
            do =:: i
              "  caused by initializing code at " sb.appendS
              state [] .initializationStack i [] [] sb.appendPos
              '\n' sb.appendC
            finally i 1 - end ..drop
            state [] .initializationStack 0 []
          else
            op .pos
          end
          errors
        errValue switch
          ERROR case appendError break
          WARNING case appendWarning break
          INFO case appendInfo break
        end
        continue.opLoop
      Length case
        state .stack branchTree.peek .else
          "missing argument for " sb.copyPtr
            op program sb.appendOp
            " expected pointer or array" sb.appendS
          op .pos errors appendError
          continue.opLoop
        end =:: value
          value [] .valueType
          value [] .value
          op .pos
          program
        interpreter.sizeOfValue if ..drop.2
          continue.opLoop
        end =:: constVal =:: constType
        1 op .pos state discardValues ## remove value from stack
        ## pushConstant
          constVal
          constType
          op .pos
        state pushConstant
        continue.opLoop
      RawValue case
        state .stack branchTree.peek .else
          "missing argument for " sb.copyPtr
            op program sb.appendOp
            " expected pointer or union" sb.appendS
          op .pos errors appendError
          continue.opLoop
        end [] .valueType =:: valType
        valType op@ .dataType=
        valType
          valType typeContext types.isPointer =:: isPointer
          isPointer if typeContext types.getBaseType end
        =:: baseType
        baseType typeContext types.isUnionElement if
          state .stack branchTree.pop ..drop
          baseType typeContext types.getUnionElementType
        else baseType typeContext types.isUnion _if
          state .stack branchTree.pop ..drop
          baseType typeContext types.asRawUnion .else
            "union-type .asRawUnion should return value" ..panic
          end
        else
          "unexpected argument for raw-value expected union got: " sb.copyPtr
            valType typeContext sb.appendType
          op .pos errors appendError
          continue.opLoop
        end
          isPointer if
            valType typeContext types.isMutable typeContext types.getAddressType
          end
          ConstValue .None
          op
        state pushValue
        continue.opLoop
      ProcPtr BuiltIn
      NewUnion Call
      ExistsName case
        break
      StackMod .case =:: stackMod
        stackMod .modType switch
          DROP case
            stackMod .n op .pos state discardValues
            continue.opLoop
          COPY case
            stackMod .n =:: offset
            offset 1 + op .pos state checkStackSize if
              continue.opLoop
            end
            ## copy value on stack
            state .stack
              offset
            branchTree.at optional.unwrap [] =:: mut: copied
            op .pos copied@ .pushedAt=
            copied .valueType typeContext types.isEmpty ! if
              ## copy value in code
              copied .opIndex state tryCopyOp if ..drop
                ## copied operation can no longer be deleted
                op state appendOp
              end copied@ .opIndex=
            end
            state .stack copied branchTree.push
            continue.opLoop
          ROTATE case
            stackMod .n =:: offset
            offset i32.abs 1 + =:: eltCount
            eltCount op .pos state checkStackSize if
              continue.opLoop
            end
            ## TODO? avoid duplicate work merge popping and constant check into single iteration, drop old operations on push
            ## check if all rotated values are constant
            true =:: mut: isConst
            0 =:: mut: count
            state .stack branchTree.itr.start
              while isConst and count eltCount < and branchTree.itr.hasNext do
                branchTree.itr.next =:: elt
                elt .value [] .None ? or elt [] .opIndex state canDeleteOp ! if
                  false isConst=
                  break
                end
              finally count 1 + count= end
            ..drop
            isConst if
              ## TODO? use buffer in context
              eltCount 4 <= if
                TypeInfo 4 array : buffer
                buffer@ list.wrapBuffer
              else
                eltCount TypeInfo list.create
              end
                eltCount for ..drop
                  state .stack branchTree.pop optional.unwrap [] =:: elt
                    elt .opIndex state deleteOp
                  elt list.append
                end
                offset 0 > if ## rotate left
                  list.removeLast =:: lowValue
                  $ list.reversed for state pushConstTypeInfo end
                  lowValue state pushConstTypeInfo
                else
                  $ 0 [] state pushConstTypeInfo
                  $ 1 list.tail slice.reversed for
                    state pushConstTypeInfo
                  end
                end
              list.free ..drop
              continue.opLoop
            end
            state .stack eltCount offset 0 > branchTree.rotate
            ## clear stack references after rotation (removing stack values after rotation messes up stack)
            false eltCount op .pos state clearReferences
            op state appendOp ..drop
            continue.opLoop
        end
        break
      TypeInfo .case =:: typeInfo
        op .pos state popType =:: valType
        valType typeContext types.containsGeneric if
          break ## XXX? support var-size arrays
        end
        ## pushConstant
          ## computeTypeInfo
            valType
            typeInfo
          program interpreter.computeTypeInfo if ..drop
            "could no compute size of type " sb.copyPtr
              valType typeContext sb.appendType
            op .pos errors appendError
            continue.opLoop
          end
          types.I_SIZE
          op .pos
        state pushConstant
      continue.opLoop
      TypeWith .case =:: withProcId
        program [] .procedures withProcId i64 cast @[] =:: withProc
        withProc [] .labelId labelContext id.currentNamespace labelContext id.setLabelNamespace
        op .pos state popType =:: baseType
        ## newProcedure
          baseType@ slice.wrap
          types.primitive.BOOL@ slice.wrap
          LabelId slice.empty
          CallingConvention.DEFAULT
        typeContext types.newProcedure .else
          "failed to create procedure":s op ..line state internalError ..unreachable
        end withProc typeContext setProcType
        withProc .implementation .Code .else
          "expected code-procedure":s op ..line state internalError ..unreachable
        end =:: codeImpl
        codeImpl [] .codeState .PARSING ! if
          "unexpected state for `.with( ... )` procedure" sb.copyPtr
          op .pos errors appendError
          continue.opLoop
        end
        ProcCodeState .PARSED codeImpl .codeState=
        baseType withProcId typeContext types.newRefinementType ConstValue .TypeId
          types.primitive.TYPE
          op .pos
        state pushConstant
      continue.opLoop
      TypeModifier .case =:: typeMod
        idContext [] .arraySizeBuffer
          list.clear
        idContext .arraySizeBuffer=
        Type optional.empty =:: mut: baseType0
        while baseType0 ? ! do
          1 op .pos state checkStackSize if
            continue.opLoop
          end
          idContext [] .arraySizeBuffer
            state popValue .else
              "stack underflow":s op ..line state internalError ..unreachable
            end =:: constVal
            constVal switch
              TypeId .case optional.wrap baseType0= break
              Int .case types.ArraySize .Int list.append break
              GenericArg .case types.ArraySize .GenericArg list.append break
              WildCard .case
                "unimplemented: dynamic pointers":s op ..line state internalError ..unreachable
              default ## TODO? .default to access switched value
                "unexpected constant parameter for type-modifier " sb.copyPtr
                  typeMod sb.appendTypeModifier
                  " expected type or size got " sb.appendS
                  constVal typeContext sb.appendConstant
                op .pos errors appendError
              break
            end
          idContext .arraySizeBuffer=
        end
        idContext [] .arraySizeBuffer .length 0:iSize == if
          idContext [] .arraySizeBuffer
            types.ArraySize .None list.append
          idContext .arraySizeBuffer=
        else
          typeMod .RAW_PTR or typeMod .RAW_PTR_MUT if
            "raw pointers cannot be sized" sb.copyPtr op .pos errors appendError
          end
        end
        baseType0 optional.unwrap
          idContext [] .arraySizeBuffer list.asSlice
            1 slice.tail
          slice.reversed for =:: size
            ## newArrayType
              types.ArrayType .ARRAY
              size
              typeContext
            types.newArrayType .else
              "could not create array type" sb.copyPtr op .pos errors appendError
              continue.opLoop
            end
          end
        ## newArrayType
          typeMod switch
            PTR case types.ArrayType .POINTER break
            PTR_MUT case types.ArrayType .MUTABLE_POINTER break
            RAW_PTR case types.ArrayType .RAW_POINTER break
            RAW_PTR_MUT case types.ArrayType .MUTABLE_RAW_POINTER break
            ARRAY case types.ArrayType .ARRAY break
          end
          idContext [] .arraySizeBuffer 0 []
          typeContext
        types.newArrayType .else
          typeMod .ARRAY if
            "could not create array type" sb.copyPtr
          else
            "could not create pointer type" sb.copyPtr
          end op .pos errors appendError
          continue.opLoop
        end
          ConstValue .TypeId
          types.primitive.TYPE
          op .pos
        state pushConstant
        continue.opLoop
      Import LibImport .case
          op .val .LibImport ?
          state [] .currentFile
          op .pos
          program
          state
        parseImportFile
      continue.opLoop
      AutoCast Copy ConstantReference NewReference NewUnionReference case
        "unsupported operation: " sb.copyPtr
          op program sb.appendOp
        op .pos errors appendError
        continue.opLoop
      CompilerInfo .case =:: compilerInfo
        state isGlobal ! if
          ## remeber operation for interpreter
          op state appendOp ..drop
        end
        compilerInfo switch
          TypeInfo .case =:: info
            ## printTypes
              false
              info .count
              info .depth
            state printTypes
            continue.opLoop
          StackInfo .case =:: info
            ## printTypes
              true
              info
              0
            state printTypes
            continue.opLoop
          TypeLayout .case =:: depth
            program [] .tmpString
              sb.clear
              "-----------------\n" sb.appendS
              op .pos state popType depth typeContext sb.appendTypeLayout
              "\n-----------------\n" sb.appendS
              $ sb.asStr io.print
              sb.clear
            program .tmpString=
            continue.opLoop
          CompiledOps case
            continue.opLoop ## TODO print ops
          Find .case =:: idLabel
            16 id.IdentifierMatch list.create =:: mut: matches
            ## TODO? directly search by label
            idLabel labelContext id.getLabelName true idContext matches@ optional.wrap id.searchIdentifier ..drop.3
            program [] .tmpString
              sb.clear
              "-----------------\n" sb.appendS
              "identifier \"" sb.appendS idLabel labelContext sb.appendLabelName "\":\n" sb.appendS
              0:iSize while $ matches .length u< do =:: i
                matches i @[] =:: match
                match [] .nameData .labelId =:: labelId
                match [] .nameData .aliasId =:: aliasId
                labelId idContext id.getIdentifier
                  ! "matched identifier exists" assert
                =:: idData
                " - " sb.appendS
                aliasId id.NO_ALIAS != if
                  "alias (declared at " sb.appendS
                  aliasId idContext id.getAliasPos [] sb.appendPos
                  ")  to " sb.appendS
                end
                idData id.asIdInfo labelContext sb.appendIdInfo
                " ( " sb.appendS
                idData [] .valueType typeContext sb.appendType
                idData [] .constValue .None ? ! if
                  " [ " sb.appendS
                  idData [] .constValue typeContext sb.appendConstant
                  " ]" sb.appendS
                end
                " ) declared at " sb.appendS
                labelId labelContext id.labelPos .if
                  [] sb.appendPos
                else
                  "?" sb.appendS
                end
                '\n' sb.appendC
                i 1:iSize +
              end ..drop
              "-----------------\n" sb.appendS
              $ sb.asStr io.print
              sb.clear
            program .tmpString=
            matches list.free ..drop
            continue.opLoop ## TODO find
        end
        break
        LocalJump LocalLabel case break
    end
    "type-checking for operation: " sb.copyPtr
      op program sb.appendOp
      " has not been implemented" sb.appendS
    op .pos errors appendError
  finally opIndex 1 + end ..drop
end

proc(
  ProcedureInfo ptr : procInfo
  ProgramContext ptr.mut : program
-> i32 ) =>: nextImpl
  ## TODO remember index up to which all operations have been checked
  procInfo .implementation .Code .else
    "expected code-impl" ..panic
  end =:: codeImpl
  codeImpl [] .implementations .length i32 cast.u =:: implLength
  0:i32 while $ implLength < do =:: implId
    codeImpl [] .implementations
      implId @[]
    =:: implData
    implData [] .codeState switch
      TYPE_CHECKED TYPE_CHECKING UNUSED COMPILED case break
      PARSED PARSING case implId return
    end
  finally implId 1 + end ..drop
  implLength return
end

enum( SKIP_UNDEFINED REQUIRE_DEFINED ) =:: ProcCheckType
proc(
  ProcCodeState : codeState
  LabelId : procName
  ProcCheckType : checkType
  bool : isUnused
  FilePosition ptr : expandedAt
  ProgramContext ptr.mut : program
-> bool ) =>: checkProcState
  program .idContext .typeContext .labelContext =:: labelContext
  codeState switch
    PARSED case
      isUnused and procName labelContext id.labelFlags id.FLAG_IGNORE_UNUSED & ? ! if
        "procedure " sb.copyPtr
          procName labelContext sb.appendLabelPath
          " is never used" sb.appendS
        expandedAt program .errors appendInfo
      end
      false return ## expected
    TYPE_CHECKED UNUSED COMPILED case true return ## nothing to do
    PARSING case
      checkType .SKIP_UNDEFINED ! if
        "procedure " sb.copyPtr
          procName labelContext sb.appendLabelPath
          " has not finished parsing" sb.appendS
        expandedAt program .errors appendError
      end
      true return
    TYPE_CHECKING case
      checkType .SKIP_UNDEFINED ! if
        "procedure " sb.copyPtr
          procName labelContext sb.appendLabelPath
          " has not finished type-checking" sb.appendS
        expandedAt program .errors appendError
      end
      true return
  end
end
proc(
  ProcId : procId
  i32 : implId
  ProcCheckType : checkType
  FilePosition ptr optional : expandedAt
  TypeCheckState ptr.mut : state
-> ) =>: typeCheckProcedure
  ## XXX? is there a way to reset local auto-types without copying the whole list
  state [] .program =:: program
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  program [] .procedures procId i64 cast list.at .else
    "missing procedure":s expandedAt .else FILE_POS_UNKNOWN@ end ..line internalErrorNoOp ..unreachable
  end =:: currentProc
  currentProc .implementation .Code .else ..drop
    ## TODO replace alias with underlying proc
    ##  skip built-ins
    return
  end =:: codeImpl
  currentProc [] .labelId labelContext id.getLabelPos .else
    "proc label has no pos":s expandedAt .else FILE_POS_UNKNOWN@ end ..line internalErrorNoOp ..unreachable
  end =:: procPos
  expandedAt .else procPos end =:: initPos
  codeImpl [] .expansionLevel =:: prevExpansionLevel
  implId -1 == if
    codeImpl [] .codeState currentProc [] .labelId checkType state [] .isUnusedProc initPos program checkProcState if
      return
    end
    ProcCodeState .TYPE_CHECKING codeImpl .codeState=
  else
    codeImpl [] .implementations
      implId @[]
    =:: currentImpl
    currentImpl [] .codeState currentProc [] .labelId checkType state [] .isUnusedProc initPos program checkProcState if
      return
    end
    ProcCodeState .TYPE_CHECKING currentImpl .codeState=
    currentImpl [] .expansionLevel
      $ MAX_EXPANSION_DEPTH > if ..drop
        "exceeded maximum expansion depth (" sb.copyPtr
          MAX_EXPANSION_DEPTH i32 cast.u sb.appendI
          ')' sb.appendC
          state [] .initializationStack list.reversed for =:: prevExpand
            "  caused by initializing code at " sb.appendS
            prevExpand [] sb.appendPos
            '\n' sb.appendC
          end
        initPos program .errors appendError
        return
      end
    codeImpl .expansionLevel=
    currentImpl [] .procType typeContext types.getProcIn .else
      "proc has no in":s procPos ..line internalErrorNoOp ..unreachable
    end =:: inTypes
    0:i32 =:: mut: staticArgCount
    ## XXX? clear/reset argument map
    0:i32 while $ iSize cast.u inTypes .length u< do =:: i
      currentImpl [] .procType i typeContext types.getProcArgLabel =:: labelId
      inTypes i [] =:: argType
      labelId labelContext id.labelFlags id.FLAG_STATIC & ? or
          argType typeContext types.isType if
        currentImpl [] .staticArgs
          staticArgCount slice.get .else
            "missing static argument":s initPos ..line internalErrorNoOp ..unreachable
          end
        =:: argValue
        state .argData labelId
          $ id.LABEL_ID_NONE == if ..drop
            -2 i - LabelId cast.s ## dummy labels for static generic arguments
          end
          argType argValue TypedValue new
        map.put ..drop
        staticArgCount 1 + staticArgCount=
      else labelId id.LABEL_ID_NONE != _if
        state .argData labelId
          argType ConstValue .None TypedValue new
        map.put ..drop
      end
      i 1 +
    end ..drop
  end
  currentProc [] .isStatic and state [] .mode .PROC_CHILD if
    TypeCheckMode .STATIC_PROC state .mode=
  end
  ## compile procedures to local code of given file
  currentProc [] .fileId state .currentFile=
  state [] .initializationStack .length =:: offset
  expandedAt .if
    state [] .initializationStack
      >$ list.append
    state .initializationStack=
  end
  currentProc [] .fileId state .interpreter .currentFile=
  program [] .progFiles
    currentProc [] .fileId i64 cast
  @[] =:: procFile
  state clearOps
  ## TODO? compile code to new list (prevents need to copy result after type-checking)
  state [] .compiledOps .length i32 cast.u =:: codeOffset
  currentProc [] .labelId labelContext id.inLabelNamespace
  idContext id.currentScope =:: prevScope
  currentProc [] .scopeId idContext id.setScope
  idContext id.openScope
  implId 0 >= if ## update procedure type
    codeImpl [] .implementations
      implId @[]
    .procType []
  else
    currentProc [] .procType
  end =:: procType
  procType optional.wrap state .currentProcType=
  ## opImplementProc
    procType
    ## ProcedureImpl
      implId
      procId
    ProcedureImpl new
    procPos
  opImplementProc state appendOp ..drop
  ## procedure scope is handled by typeCheckProcedure
  procType BlockInfo .Procedure state openBlock
  true state .reachable=
  procType typeContext types.getProcIn .else
    "wrong type for procedure initialization: " sb.copyPtr
      procType typeContext sb.appendType
      " expected procedure" sb.appendS
    procPos program .errors appendError
    return
  end =:: argTypes
  ## push unnamed arguments
  0:i32 while $ iSize cast.u argTypes .length u< do =:: i
    procType i typeContext types.getProcArgLabel =:: label
    argTypes i [] =:: argType
    label id.LABEL_ID_NONE == if ## push argument
      state .stack
        ## TypeInfo
          argType typeContext types.isType and
              state .argData -2 i - LabelId cast map.get .if
            .value
            argType
            $1 argType procPos opConst state appendOp
          else
            ConstValue .None
            argType
            OP_ARGUMENT
          end
          procPos
        TypeInfo new
      branchTree.push
    else
      label
        argType
        IdentifierType .ARGUMENT
        i i32 cast ## index
        ConstValue .None
        true
        procPos
        state [] .currentFile
        idContext
        program .errors
      id.declareIdentifier if
        "could not declare identifier for argument " sb.copyPtr
          label labelContext sb.appendLabelName
        procPos program .errors appendError
      end ..drop.2
    end
    i 1 +
  end ..drop
  codeImpl [] .code slice.freeze state typeCheckOps
  ## TODO? compile exported procedure normally
  state [] .isUnusedProc ! and currentProc [] .isStatic ! if
    ProcCodeState .TYPE_CHECKED
  else
    ProcCodeState .UNUSED
  end =:: newProcState
  state [] .compiledOps list.asSlice codeOffset slice.tail slice.copy =:: newOps
  state clearOps
  ## remember new code position
  implId -1 == if
    newOps codeImpl .code=
    newProcState codeImpl .codeState=
    idContext id.currentScope currentProc .scopeId=
  else
    codeImpl [] .implementations
      implId @[]
    =:: currentImpl
    newOps currentImpl .code=
    newProcState currentImpl .codeState=
    prevExpansionLevel codeImpl .expansionLevel=
  end
  state [] .initializationStack
    offset list.setLength
  state .initializationStack=
   ## TODO error on unhandled stack values
  state [] .stateStack .length 0:iSize != if
    state .stack branchTree.prune
  else
    state .stack branchTree.clear
  end
  prevScope idContext id.setScope
  state [] .mode .STATIC_PROC if
    TypeCheckMode .PROC_CHILD state .mode=
  end
end
proc(
  ProcId : procId
  i32 : implId
  FilePosition ptr : expandedAt
  TypeCheckState ptr.mut : state
-> ) =>: export: typeCheckChildProcedures
  state rememberState
  BlockMode .NONE state .blockMode=
  state [] .program .idContext .typeContext .labelContext =:: labelContext
  labelContext id.currentNamespace =:: prevNamespace
  TypeCheckMode .PROC_CHILD state .mode=
  state [] .missingProcs .length =:: missingProcsOffset
  procId implId ProcCheckType .REQUIRE_DEFINED expandedAt optional.wrap state typeCheckProcedure
  ##  go through called procedures in breadth first order
  missingProcsOffset while $ state [] .missingProcs .length u< do =:: i
    state [] .missingProcs i [] =:: nextProc
    ## XXX? remember/restore complete expansion stack
    ## typeCheckProcedure
      nextProc .impl .procId
      nextProc .impl .implementationId
      ProcCheckType .SKIP_UNDEFINED
      nextProc .expandedAt optional.wrap
    state typeCheckProcedure
  finally i 1:iSize + end ..drop
  state [] .missingProcs
    missingProcsOffset list.setLength
  state .missingProcs=
  prevNamespace labelContext id.resetNamespace
  state resetState
end
proc(
  Operation slice : ops
  TypeCheckState ptr.mut : state
-> ) =>: export: typeCheckGlobalCode
  state [] .program =:: program
  program .idContext .typeContext .labelContext =:: labelContext
  labelContext id.currentNamespace =:: prevNamespace
  ## TODO ensure code is run in correct scope
  ## TODO? make target namespace an optional parameter
  0:NamespaceId
    id.NAMESPACE_IMPORT_NONE
  NamespaceInfo new labelContext id.resetNamespace
  state [] .compiledOps .length =:: codeOffset
  ops state typeCheckOps
  state removeTrailingNOPs
  state [] .compiledOps .length codeOffset u> if
    "unable to fold constants in global code:\n" sb.copyPtr
      state [] .compiledOps for
        $ .val .NOP .and .EMPTY if ..drop continue end
        program sb.appendOp
      end
    state [] .compiledOps list.peek .else "peek empty" ..panic end
    [] .pos program .errors appendError
  end
  state [] .stack branchTree.depth 0 != if
    "non empty stack at end of file :\n" sb.copyPtr
      state .stack branchTree.peek .else "peek empty" ..panic end =:: stackVal
      stackVal [] .valueType program .idContext .typeContext sb.appendType
    stackVal [] .pushedAt program .errors appendWarning
  end
  state clearOps
  prevNamespace labelContext id.resetNamespace
end

proc(
  ProgramContext ptr.mut : program
  TypeCheckState ptr.mut : state
->  ) =>: export: updateTypeCheckerPointers
  program state .program=
  program state .interpreter .program=
end
proc( ProgramContext ptr.mut : program -> TypeCheckState ) =>: export: newTypeCheckState
  ## TypeCheckState
    program
    program -1:FileId interpreter.wrapProgram
    labelHash@ labelEq@ 64 TypedValue map.create
    LocalLabelId.hash@ LocalLabelId.eq@ 512 JumpOffsets map.create
    Type optional.empty
    BlockMode .NONE
    TypeInfo branchTree.create
    32  BlockInfo list.create
    128 Operation list.create
    64 Type list.create
    64 ConstValue list.create
    0:i32
    TypeBlockState optional.empty
    128 MissingProc list.create
    FILE_ID_NONE
    16 FilePosition ptr list.create
    8 TypeCheckStateState list.create
    TypeCheckMode .LINEAR
    true ## reachable
    false ## isUnusedProc
  TypeCheckState new
end
64 =:: MAX_STATIC_RECURSION
proc( TypeCheckState ptr.mut : state -> ) =>: export: typeCheckProgram
  state [] .program =:: program
  program .errors =:: errors
  program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  program [] .mainProcId NO_PROC != =:: hasMain
  hasMain if
    ## check all procedures reachable from main proc
    program [] .mainLabelId labelContext id.getLabelPos .else
      "main-proc has no position" ..panic
    end =:: mainProcPos
    program [] .mainProcId -1 mainProcPos state typeCheckChildProcedures
  end
  ## TODO? create seperate list of all "root-procedures" to avoid iterating procedures twice
  ## lambdas and exported (non-generic) procedures
  ## TODO detect unused lambda in special cases (e.g. only accessible through unused variable)
  0:i32 while $ iSize cast.u program [] .procedures .length u< do =:: procId
    program [] .procedures procId iSize cast.u @[] =:: currentProc
    currentProc [] .hasStaticArg or currentProc [] .isStatic if
      procId 1 + continue
    end
    currentProc .implementation .Code .else ..drop
      procId 1 + continue ## procedure implementation not in code
    end =:: codeImpl
    codeImpl .code [] .length 0 == if
      procId 1 + continue ## procedure not implemented
    end
    codeImpl .codeState [] .PARSING if
      ## TODO? handle use in currenty unchecked procedure
      ProcCodeState .UNUSED codeImpl .codeState=
      procId 1 + continue ## ignore parsing procedures
    end
    currentProc [] .labelId labelContext id.labelFlags =:: flags
    flags id.FLAG_LAMBDA & ? or EXPORT_GLOBALS hasMain ! | and flags id.FLAG_EXPORT & ? if
      procId ProcId cast
        -1
        currentProc [] .labelId labelContext id.getLabelPos .else
          "proc has no position" ..panic
        end
      state typeCheckChildProcedures
    end
    procId 1 +
  end ..drop
  optimizerFlags.REMOVE_UNUSED_PROCS if
    true state .isUnusedProc=
  end
  ## type-check unreachable procs
  TypeCheckMode .LINEAR state .mode=
  ## TODO reset state
  state .compiledOps =:: originalOps
  ## procedures
  0:i32 while $ iSize cast.u program [] .procedures .length u< do =:: procId
    program [] .procedures procId iSize cast.u @[] =:: currentProc
    currentProc [] .hasStaticArg or currentProc [] .isStatic if
      procId 1 + continue
    end
    currentProc  .implementation .Code .else ..drop
      procId 1 + continue ## procedure implementation not in code
    end =:: codeImpl
    codeImpl .code [] .length 0 == if
      procId 1 + continue ## procedure not implemented
    end
    codeImpl .codeState [] .PARSING if
      ProcCodeState .UNUSED codeImpl .codeState=
      procId 1 + continue ## ignore parsing procedures
    end
    procId ProcId cast -1 ProcCheckType .REQUIRE_DEFINED FilePosition ptr optional.empty state typeCheckProcedure
    procId 1 +
  end ..drop
  ## static procedures
  0 =:: mut: depth
  false =:: mut: compiledImplementation
  while
    false compiledImplementation=
    0:i32 while: procLoop $ iSize cast.u program [] .procedures .length u< do =:: procId
      program [] .procedures procId @[] =:: currentProc
      currentProc [] .hasStaticArg ! if
        procId 1 + continue ## handled by previous loop
      end
      currentProc [] .isStatic if
        procId 1 + continue ## don't type-check static procedures
      end
      currentProc .implementation .Code .else ..drop
        procId 1 + continue ## procedure implementation not in code
      end =:: codeImpl
      codeImpl [] .code .length 0 == if
        procId 1 + continue ## procedure not implemented
      end
      codeImpl [] .codeState .PARSING if
        procId 1 + continue ## ignore parsing procedures
      end
      currentProc program nextImpl =:: nextId
      codeImpl [] .implementations .length i32 cast.u =:: implLength
      nextId implLength >= if
        procId 1 + continue
      end
      true compiledImplementation=
      nextId while ..dup implLength < do =:: implId
        codeImpl [] .implementations
          implId @[]
        =:: implData
        depth MAX_STATIC_RECURSION >= if
          "exceeded maximum static recursion depth (" sb.copyPtr
            MAX_STATIC_RECURSION sb.appendI
            ')' sb.appendC
          implData [] .firstUse errors appendError
        end
        ## ignore procedures with generic signature
        implData [] .staticArgs for
          .GenericArg .if ..drop
            procId 1 + continue.procLoop
          else .TypeId .and typeContext types.isGeneric _if
            procId 1 + continue.procLoop
          end
        end
        procId ProcId cast implId ProcCheckType .REQUIRE_DEFINED implData [] .firstUse optional.wrap state typeCheckProcedure
        implId 1 +
      end ..drop
      procId 1 +
    end ..drop
    compiledImplementation if
      depth 1 + depth=
      depth MAX_STATIC_RECURSION > if
        ## error message appended in implementation
        break
      end
      continue
    end
    false ## break loop while reaching condition
  do end
  ## TODO? put state cleanup into procedure
  state freeOps
  state .stack branchTree.free
  state .interpreter interpreter.cleanupContext
  state .argData map.free
  ( LocalLabelId : _ -> ) => end
    ( JumpOffsets -> ) =>
      .Jumps .if list.free ..drop else ..drop end
    end
    state .jumpOffsets
  map.freeAll
  state [] .initializationStack list.free ..drop
  state [] .stateStack list.free ..drop
  state [] .typeBuffer list.free ..drop
  state [] .constBuffer list.free ..drop
end
