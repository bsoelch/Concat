          1 =:: count
          count offset + state [] .typeStack .length > if
            "type-stack underflow" sb.wrap op [] .pos state appendError2
            return
          end
          state ensureStackHeadIsValue
          offset count + true op [] .pos state extractCompositeOps ## XXX only extract duplicated values
          0 offset state countStackOps =:: opOffset
          offset count state countStackOps =:: copied
          count 0 > if
            state [] .typeStack #dup .length count + list.ensureCap state [] .typeStack =
            state [] .opStack #dup .length copied + list.ensureCap state [] .opStack =
            ## mem.move
              state [] .typeStack .data state [] .typeStack .length +
              state [] .typeStack .data state [] .typeStack .length + offset - count -
              count
            mem.move #drop
            ## mem.move
              state [] .opStack .data state [] .opStack .length +
              state [] .opStack .data state [] .opStack .length + opOffset - copied -
              copied
            mem.move #drop
            state [] .typeStack .length count + state [] .typeStack .length =
            state [] .opStack .length copied + state [] .opStack .length =
          end
          return
        SWAP case
          2 state [] .typeStack .length > if
            "type-stack underflow" sb.wrap op [] .pos state appendError2
            return
          end
          1 =:: offset
          1 =:: count
          state ensureStackHeadIsValue
          0 offset state countStackOps =:: opOffset
          offset count state countStackOps =:: copied
          count 0 > if
            state [] .typeStack #dup .length count + list.ensureCap state [] .typeStack =
            state [] .opStack #dup .length copied + list.ensureCap state [] .opStack =
            ## mem.move
              state [] .typeStack .data state [] .typeStack .length +
              state [] .typeStack .data state [] .typeStack .length + offset - count -
              count
            mem.move #drop
            ## mem.move
              state [] .opStack .data state [] .opStack .length +
              state [] .opStack .data state [] .opStack .length + opOffset - copied -
              copied
            mem.move #drop
            ## mem.move
              state [] .typeStack .data state [] .typeStack .length + offset - count -
              state [] .typeStack .data state [] .typeStack .length + offset -
              offset count +
            mem.move #drop
            ## mem.move
              state [] .opStack .data state [] .opStack .length + opOffset - copied -
              state [] .opStack .data state [] .opStack .length + opOffset -
              opOffset copied +
            mem.move #drop
          end
          return
      end
      break
    compilerInfo case
      op [] .val .compilerInfo switch
        typeInfo case
          false op [] .val .compilerInfo .typeInfo state printTypes
          return
        stackInfo case
          true op [] .val .compilerInfo .stackInfo state printTypes
          return
        compiledOps case
          return ## TODO print ops
        find case
          return ## TODO find
      end
      break
    declareName initializeName typeModifier
    checkEnumLabel checkArrayIndex setEnumLabel getEnumElement setEnumElement @EnumElement getArgLen call case
      "operation " sb.wrap
        op [] idContext [] .constContext @ labelContext typeContext sb.appendOp
        " should not exist at this stage of compilation" sb.appendS
      op [] .pos state appendError2
      return
    getName case
      "unresolved identifier: \"" sb.wrap
        op [] .val .getName labelContext id.labelName .data sb.appendStr
        '"' sb.appendC
      op [] .pos state appendError2
      return
    setName case
      "unresolved identifier: \"" sb.wrap
        op [] .val .setName labelContext id.labelName .data sb.appendStr
        '"' sb.appendC
      op [] .pos state appendError2
      return
    @Name case
      "unresolved identifier: \"" sb.wrap
        op [] .val .@Name labelContext id.labelName .data sb.appendStr
        '"' sb.appendC
      op [] .pos state appendError2
      return
    unreachable case
      state [] .opStack list.clear state [] .opStack =
      state [] .typeStack list.clear state [] .typeStack =
      state [] .compiledOps
        op [] list.append
      state [] .compiledOps =
      false state [] .reachable =
      return
    NOP case
      return ## do nothing
  end
  "type-checking for operation " sb.wrap
    op [] idContext [] .constContext @ labelContext typeContext sb.appendOp
    " is not implemented" sb.appendS
  op [] .pos state appendError2
end

proc(
  Operation ptr mut : op
  IdentifierInfo : idInfo
  TemplateInfo ptr : template
  TemplateImplementation ptr : impl
  i32 : implId
  ConstantArray : argsIndices
  TypeCheckState ptr mut : state =>
) =: resolveTemplateGetIdentifer
  idInfo .idType switch
    TEMPLATE_ARG case
      ## opConst
        impl [] .argValues idInfo .id state [] .idContext [] .constContext @ constArrayGet
        template [] .templateType idInfo .id state [] .idContext [] .typeContext @ types.compositeGetElement
        template [] .declaredAt
      opConst op [] =
      break
    TMP_VAR LOCAL_VAR ARGUMENT LABEL case
      op [] .dataType argsIndices 0 0 ConstantArray new op [] .pos state [] .idContext types.replaceGenericsType op [] .dataType =
      break
    GLOBAL_VAR PROCEDURE TYPE case
      op [] .val OpValue .initializeId == if
        op [] .dataType argsIndices 0 0 ConstantArray new op [] .pos state [] .idContext types.replaceGenericsType op [] .dataType =
        implId op [] .val .initializeId .id =
      end
      op [] .val OpValue .declareId == if
        op [] .dataType argsIndices 0 0 ConstantArray new op [] .pos state [] .idContext types.replaceGenericsType op [] .dataType =
        implId op [] .val .declareId .id =
      end
      break
  end
end
proc(
  Operation ptr mut : op
  TemplateInfo ptr : template
  TemplateImplementation ptr : impl
  i32 : implId
  ConstantArray : argsIndices
  TypeCheckState ptr mut : state =>
) =: resolveTemplateOp
  op [] .val OpValue .getId == if
    op op [] .val .getId template impl implId argsIndices state resolveTemplateGetIdentifer
  else op [] .val OpValue .setId == _if
    op op [] .val .setId template impl implId argsIndices state resolveTemplateGetIdentifer
  else op [] .val OpValue .@Id == _if
    op op [] .val .@Id template impl implId argsIndices state resolveTemplateGetIdentifer
  else op [] .val OpValue .initializeId == _if
    op op [] .val .initializeId template impl implId argsIndices state resolveTemplateGetIdentifer
  else op [] .val OpValue .declareId == _if
    op op [] .val .declareId template impl implId argsIndices state resolveTemplateGetIdentifer
  else
    op [] .dataType argsIndices 0 0 ConstantArray new op [] .pos state [] .idContext types.replaceGenericsType op [] .dataType =
    op [] .val OpValue .Cast == if
      op [] .val .Cast argsIndices 0 0 ConstantArray new op [] .pos state [] .idContext types.replaceGenericsType op [] .val .Cast =
    else op [] .val OpValue .Cast! == _if
      op [] .val .Cast! argsIndices 0 0 ConstantArray new op [] .pos state [] .idContext types.replaceGenericsType op [] .val .Cast! =
    else op [] .val OpValue .Constant == _if
      op [] .val .Constant argsIndices 0 0 ConstantArray new op [] .pos state [] .idContext types.replaceGenerics op [] .val .Constant =
    end
  end
end

128 =:: MAX_TEMPLATE_DEPTH
proc( ProgramContext ptr mut => ) =: public typeCheckProgram
  =:: mut prog
  ## TypeCheckState
    prog [] .idContext @
    128 Operation list.create
    128 Operation list.create
    128 TypeInfo  list.create
    128 BlockInfo list.create
    prog [] .autoTypes
    128 SwitchData list.create
    prog [] .errors
    FILE_ID_NONE
    0
    0
    0
    true
    prog [] .hasCheckIndex
    prog [] .hasCheckEnum
    prog [] .hasGetArgs
  TypeCheckState new =:: mut state
  0 =:: mut globalTmpCount
  0 while #dup prog [] .progFiles .length < do
    #dup state .fileId =
    prog [] .progFiles #over list.at .data
      globalTmpCount state .tmpCount =
      state .compiledOps list.clear state .compiledOps =
      state .typeStack list.clear state .typeStack =
      state .opStack list.clear state .opStack =
      0 while #dup #over:2 [] .globalOps .length < do
        #swap
          #dup [] .globalOps #over:2 list.at .data state @ typeCheckOp
        #swap 1 +
      end #drop
      state .openBlocks .length 0 > if
        "unfinished code block" sb.wrap state .openBlocks list.peek .data [] .startPos state @ appendError2
        state .openBlocks list.clear state .openBlocks =
      end ## XXX check for unfinished operations on stack
      #dup [] .globalOps list.clear
        state .compiledOps list.appendAll
      #over [] .globalOps =
      state .tmpCount globalTmpCount =
      0 state .tmpCount =
      state .compiledOps list.clear state .compiledOps =
      state .typeStack list.clear state .typeStack =
      state .opStack list.clear state .opStack =
      0 while #dup #over:2 [] .localOps .length < do
        #swap
          #dup [] .localOps #over:2 list.at .data state @ typeCheckOp
        #swap 1 +
      end #drop
      state .openBlocks .length 0 > if
        "unfinished code block" sb.wrap state .openBlocks list.peek .data [] .startPos state @ appendError2
        state .openBlocks list.clear state .openBlocks =
      end
      #dup [] .localOps list.clear
        state .compiledOps list.appendAll
      #over [] .localOps =
      ## XXX ensure template ops are empty
    #drop
    1 +
  end #drop
  state .compiledOps list.free state .compiledOps =
  prog [] .templateOps .length 0 > if
    0 =:: mut depth
    false =:: mut compiledImpl
    while
      false compiledImpl =
      depth 1 + depth =
      0 while #dup state .idContext [] .templateInfos .length < do
        state .idContext [] .templateInfos #over list.at .data =:: mut template
        template [] .codeLength 0 > template [] .implementations .length template [] .compiledImpls > & if
          true compiledImpl =
          template [] .implementations .length =:: mut prevImpl
          template [] .srcFile state .fileId =
          prog [] .progFiles template [] .srcFile list.at .data [] .templateOps state .compiledOps =
          template [] .compiledImpls while #dup template [] .implementations .length < do
            0 state .tmpCount =
            state .typeStack list.clear state .typeStack =
            state .opStack list.clear state .opStack =
            template [] .implementations #over list.at .data =:: impl
            state .idContext [] .templateArgBuffer .length =:: argBufferOffset
            state .idContext [] .templateArgBuffer
              impl [] .argValues state .idContext [] .constContext @ constArrayAsArray list.appendArray
            state .idContext [] .templateArgBuffer =
            argBufferOffset state .idContext [] .templateArgBuffer .length argBufferOffset - ConstantArray new =:: argsIndices
            0 while #dup template [] .codeLength < do
              prog [] .templateOps template [] .codeOffset #over:2 + list.get =:: mut op ## copy by value to allow modification
              op @ template impl #over:4 argsIndices state @ resolveTemplateOp
              op @ state @ typeCheckOp
              state .idContext [] .templateInfos #over:3 list.at .data template = ## compiling operation can change template list
              1 +
            end #drop
            argBufferOffset state .idContext [] .templateArgBuffer .length = ## reset template argument buffer
            state .openBlocks .length 0 > if
              "unfinished code block" sb.wrap state .openBlocks list.peek .data [] .startPos state @ appendError2
              state .openBlocks list.clear state .openBlocks =
            end
            template [] .implementations .length prevImpl - depth + MAX_TEMPLATE_DEPTH > if
              "exceeded maximum template depth" sb.wrap impl [] .implPos state @ appendError2
              break
            end
            1 +
          end #drop
          template [] .implementations .length i32 cast template [] .compiledImpls =
          state .compiledOps prog [] .progFiles template [] .srcFile list.at .data [] .templateOps =
        end
        1 +
      end #drop
      depth 1 + depth =
      depth MAX_TEMPLATE_DEPTH > if
        break ## error message in inner loop
      end
    compiledImpl do end
  end
  prog [] .templateOps list.clear prog [] .templateOps =
  state .switchData     prog [] .switchData =
  state .errors         prog [] .errors =
  state .autoTypes      prog [] .autoTypes =
  state .hasCheckIndex  prog [] .hasCheckIndex =
  state .hasCheckEnum   prog [] .hasCheckEnum =
  state .hasGetArgs     prog [] .hasGetArgs =
end
