#include list

#include "program.concat"
#include "types.concat"
#include "labels.concat"

struct( types.Type : mut valType i32 : mut opCount bool : writable ) =:: TypeInfo
struct( Operation list : mut opStack TypeInfo list : mut typeStack ) =:: StackState
struct( StackState : inTypes StackState : mut outTypes i64 : mut elsePos bool : mut elseReachable ) =:: IfBlockData
struct( i64 : offset i64 : mut count ) =:: CaseInfo
struct( ConstValue : value FilePosition : pos ) =:: LabelData
struct( LabelData list : mut labels CaseInfo list : mut cases ) =:: SwitchData
struct( StackState : inTypes StackState : mut outTypes LabelData list : mut labels CaseInfo list : mut cases types.Type : switchType bool : mut endReachable bool : mut explicitBreak ) =:: SwitchBlockData
struct( StackState : inTypes StackState : mut outTypes bool : mut hasOutTypes bool : mut doesLoop ) =:: WhileBlockData
enum( empty IfBlockData : mut ifBlock WhileBlockData : mut whileBlock SwitchBlockData : mut switchBlock types.Type : procBlock ) =:: BlockData
struct( BlockData : mut blockData FilePosition : startPos i64 : blockStart i32 : blockId codeBlocks.BlockType : mut blockType ) =:: BlockInfo
struct(
  id.IdentifierContext ptr mut : mut idContext

  Operation list : mut compiledOps

  Operation list : mut opStack
  TypeInfo list : mut typeStack
  BlockInfo list : mut openBlocks

  types.Type list : mut autoTypes
  SwitchData list : mut switchData
  CompilerError list : mut errors

  i32 : mut tmpCount
  i32 : mut ifCount
  i32 : mut whileCount

  bool : mut reachable
  bool : mut hasCheckBounds
  bool : mut hasCheckEnum
  bool : mut hasGetArgs
) =:: TypeCheckState

#namespace sb
proc( stringBuilder : sb bool : printOps i64 : maxTypes TypeCheckState ptr mut : state => stringBuilder ) =: appendTypeStack
  state [] .idContext =:: idContext
  idContext [] .labelContext @ =:: labelContext
  idContext [] .typeContext @ =:: typeContext
  state [] .opStack .length =:: mut offset
  maxTypes =:: mut remaining
  sb
    state [] .typeStack .length 1 - while #dup 0 > do
      #swap
        remaining -- 0 == if
          #swap #drop return
        end
        state [] .typeStack #over:2 list.at .data =:: elt
        elt [] .writable if
          "writable " sb.appendS
        end
        elt [] .valType labelContext typeContext sb.appendType
        printOps ! if
          '\n' sb.appendC
          #swap 1 - continue
        end
        ' ' sb.appendC
        elt [] .opCount sb.appendI
        ":\n" sb.appendS
        offset elt [] .opCount - offset =
        0 while #dup elt [] .opCount < do
          #swap
          "   " sb.appendS
          state [] .opStack offset #over:3 + list.get labelContext typeContext sb.appendOp
          #swap 1 +
        end #drop
      #swap 1 -
    end #drop
  return
end
#end

proc( stringBuilder FilePosition TypeCheckState ptr mut => ) =: appendError
  =:: state
  CompilerError new
  state [] .errors
    #swap list.append
  state [] .errors =
end
proc( => StackState ) =: emptyStackState
    0 Operation list.create
    0 TypeInfo  list.create
  StackState new return
end
proc( TypeCheckState ptr mut : state => StackState ) =: copyStack
    0 Operation list.create
      state [] .opStack list.appendAll
    0 TypeInfo  list.create
      state [] .typeStack list.appendAll
  StackState new return
end
proc( StackState ptr : src TypeCheckState ptr mut : state => ) =: resetStack
  state [] .opStack list.clear
    src [] .opStack list.appendAll
  state [] .opStack =
  state [] .typeStack list.clear
    src [] .typeStack list.appendAll
  state [] .typeStack =
end
proc( StackState ptr : src => ) =: freeStackState
  src [] .opStack list.free #drop
  src [] .typeStack list.free #drop
end

proc( types.Type : valType TypeCheckState ptr mut : state => ) =: pushType
  state [] .typeStack
    ## TypeInfo
      valType
      1
      false
    TypeInfo new list.append
  state [] .typeStack =
end
proc( Operation ptr : op TypeCheckState ptr mut : state => ) =: pushValue
  ## XXX ensure stack head is value
  state [] .opStack
    op list.appendP
  state [] .opStack =
  op [] .dataType state pushType
  ## XXX stack flags
end
proc( Operation ptr : op i64 : typeCount TypeCheckState ptr mut : state => ) =: insertStackOp
  typeCount state [] .typeStack .length > if
    "type stack underflow" sb.wrap op [] .pos state appendError
    return
  end
  0
    0 while #dup typeCount < do
      #swap
        state [] .typeStack #over:2 list.get .opCount +
      #swap 1 +
    end #drop
  =:: totalOps
  state [] .opStack
    #dup .length 1 + list.ensureCap
  state [] .opStack =
  state [] .opStack .length totalOps - =:: offset
  state [] .opStack .data offset + 1 + state [] .opStack .data offset +  totalOps mem.move #drop ## TODO list.insertArray
  state [] .opStack .data offset + op 1 mem.copy #drop
  state [] .opStack .length 1 + state [] .opStack .length =
  state [] .typeStack .length
    typeCount -
  state [] .typeStack .length =
  op [] .dataType state pushType
  totalOps 1 + state [] .typeStack list.peek .data [] .opCount =
end
proc( i64 : count FilePosition : pos TypeCheckState ptr mut : state => ) =: addCompiledStackOps
  state [] .typeStack .length count -
  #dup 0 < if #drop
    "type stack underflow" sb.wrap pos state appendError
    0 i64 cast
  end =:: typeOffset
  0
    typeOffset while #dup state [] .typeStack .length < do
      #swap
        state [] .typeStack #over:2 list.get .opCount +
      #swap 1 +
    end #drop
  =:: opCount
  state [] .opStack .length opCount - =:: opOffset
  ## add operations to compiled code
  state [] .compiledOps #dup .length opCount + list.ensureCap state [] .compiledOps =
  state [] .compiledOps
    state [] .opStack .data opOffset + opCount array.create list.appendArray
  state [] .compiledOps =
  ## remove operations from stack
  state [] .opStack .length opCount - state [] .opStack .length =
  state [] .typeStack .length count - state [] .typeStack .length =
end

proc( bool : breakSwitch TypeCheckState ptr mut : state => BlockInfo ptr mut optional ) =: findBreakableBlock
  state [] .openBlocks .length 1 - while #dup 0 >= do
    state [] .openBlocks #over list.at
      #dup .data [] .blockType #dup codeBlocks.BlockType .WHILE == #swap codeBlocks.BlockType .DO == | if
        #swap #drop
        return
      end
      breakSwitch #over .data [] .blockType #dup codeBlocks.BlockType .CASE == #swap codeBlocks.BlockType .DEFAULT == | & if
        #swap #drop
        return
      end
    #drop
    1 -
  end #drop
  BlockInfo ptr mut optional.empty return
end

proc( types.Type : a types.Type : b types.Type 2 ptr mut : inTypes types.TypeContext ptr mut : context => types.Type ) =: checkBinOpNumber
  a context types.isNumber ! b context types.isNumber ! | if
    types.Type .undefined return
  end
  a context types.isInt b context types.isInt != if ## XXX? allow assigning i32 -> float
    types.Type .undefined return ## implicit conversion from int to float
  end
  a context types.numberPrecision b context types.numberPrecision < if
    b inTypes 0 [] =
    b return
  else
    a inTypes 1 [] =
    a return
  end
end
proc( types.Type : a types.Type : b types.Type 2 ptr mut : inTypes types.TypeContext ptr mut : context => types.Type ) =: checkBinOpInt
  a context types.isInt ! b context types.isInt ! | if
    types.Type .undefined return
  end
  a context types.numberPrecision b context types.numberPrecision < if
    b inTypes 0 [] =
    b return
  else
    a inTypes 1 [] =
    a return
  end
end

proc( types.Type : src types.Type : to types.TypeContext ptr : context => bool ) =: canAutoCast
  to =:: mut target
  src types.isNamedType ! target types.isNamedType & if
    target context types.unwrapNamed target =
  end
  src target types.typeEquals if
    true return
  end
  src context types.isNumber target context types.isNumber & if
    src context types.numberPrecision target context types.numberPrecision <=
    src context types.numberSize target context types.numberSize <= & return
  end
  ## XXX cast enum-label -> enum
  src context types.isPointer src context types.isArray | target context types.isPointer & if
  src context types.isMutable target context types.isMutable ! | src context types.getBaseType target context types.getBaseType types.typeEquals & if
    #+ TODO check for compare sizes +#
    true return
  end end
  src types.isPrimitive ! target types.isPrimitive ! | if
    false return
  end
  false return
end
proc( types.Type : a types.Type : b bool : forceCast types.TypeContext ptr : context => bool ) =: canCast
  a context types.unwrapNamed =:: mut src
  b context types.unwrapNamed =:: mut target
  src target context canAutoCast if
    true return
  end
  src context types.isNumber target context types.isNumber & if
    true return
  end
  forceCast ! if
    false return
  end
  src context types.isPointer target context types.isPointer & if
    true return ## XXX check for compatible element sizes?, compatible mutability
  end
  src context types.isPointer target context types.isInt & if
    true return
  end
  src context types.isInt target context types.isPointer & if
    true return
  end
  false return
end

proc( types.Type arrayView : types string : opName FilePosition : pos TypeCheckState ptr mut : state => ) =: requireTypes
  state [] .idContext =:: idContext
  idContext [] .labelContext @ =:: labelContext
  idContext [] .typeContext @ =:: typeContext
  state [] .typeStack .length types .length < if
    "not enough types for " sb.wrap
      opName sb.appendStr
      " need " sb.appendS
      types .length sb.appendI
      " have " sb.appendS
      state [] .typeStack .length sb.appendI
    pos state appendError
    return
  end
  0 =:: mut nCasts
  false =:: mut isError
  state [] .opStack .length
    1 while #dup types .length <= do
      #swap
        state [] .typeStack #dup .length #over:3 - list.at .data =:: src
        types #dup .length #over:3 - array.get =:: expected
        src [] .opCount -
        src [] .valType expected types.typeEquals if
          #swap 1 + continue
        end
        src [] .valType expected typeContext canAutoCast if
          src [] .opCount 1 == state [] .opStack #over:2 list.at .data #swap #over [] .val OpValue .Constant == & if
            expected #swap [] .dataType =
            expected src [] .valType =
            #swap 1 + continue
          else #drop end
          nCasts 1 + nCasts =
          #swap 1 + continue
        end
        ## TODO convert enum labels to enum constants
        "wrong type for " sb.wrap
          opName sb.appendStr
          " expected " sb.appendS
          expected labelContext typeContext sb.appendType
          " got " sb.appendS
          src [] .valType labelContext typeContext sb.appendType
        pos state appendError
        true isError =
      #swap 1 +
    end #drop
  #drop
  nCasts 0 == isError | if
    return
  end
  state [] .opStack .length =:: mut offset
  0 =:: mut shiftCount
  state [] .opStack #dup .length nCasts + list.ensureCap state [] .opStack =
  1 while #dup types .length <= do
    state [] .typeStack #dup .length #over:2 - list.at .data =:: op
    types #dup .length #over:2 - array.get =:: expected
    offset op [] .opCount - offset =
    shiftCount op [] .opCount + shiftCount =
    op [] .valType expected types.typeEquals if
      1 + continue
    end
    state [] .opStack .data offset + nCasts + state [] .opStack .data offset + shiftCount mem.move #drop
    0 shiftCount =
    nCasts 1 - nCasts =
    op [] .valType expected state [] .idContext [] .typeContext @ canAutoCast ! if
      "unexpected type conversion" sb.wrap pos state appendError
    end
    ## op
      op [] .valType
      expected
      pos
    opCastFrom state [] .opStack .data offset + nCasts + [] =
    op [] .opCount 1 + op [] .opCount =
    expected op [] .valType =
    1 +
  end #drop
end

proc( bool : keepTop FilePosition : pos TypeCheckState ptr mut : state => i64 ) =: storeStack
  state [] .idContext =:: idContext
  idContext [] .labelContext @ =:: labelContext
  idContext [] .typeContext @ =:: typeContext
  0 =:: mut opOffset
  state [] .typeStack .length
    keepTop if 1 - end
  =:: count
  0 while #dup count < do
    state [] .typeStack #over list.at .data =:: typeInfo
    ## IdInfo
      id.IdentifierType .TMP_VAR
      ## newLabel
        string.empty
        id.FLAG_NONE id.FLAG_MUTABLE |
        pos
        labelContext
      id.newLabel
      -1
      state [] .tmpCount ++
    id.IdentifierInfo new =:: tmpId
    state [] .compiledOps
      ## opDeclare
        typeInfo [] .valType
        tmpId
        pos
      opDeclare list.append
    state [] .compiledOps =
    state [] .compiledOps
      state [] .opStack .data opOffset + typeInfo [] .opCount array.create list.appendArray
    state [] .compiledOps =
    opOffset typeInfo [] .opCount + opOffset =
    ## opGet
      typeInfo [] .valType
      tmpId
      pos
    opGet state [] .opStack .data #over:2 [] =
    1 typeInfo [] .opCount =
    1 +
  end return
end
proc( BlockInfo ptr mut : whileBlock FilePosition : pos TypeCheckState ptr mut : state => ) =: storeLoopInTypes
  state [] .idContext =:: idContext
  idContext [] .labelContext @ =:: labelContext
  idContext [] .typeContext @ =:: typeContext
  state [] .typeStack .length =:: nTypes
  whileBlock [] .blockData .whileBlock .inTypes @ =:: inTypes
  id.IdentifierInfo : mut tmpId
  0 =::  mut opOffset
  whileBlock [] .blockStart =:: mut blockStart
  0 while #dup nTypes < do
    state [] .typeStack #over list.at .data =:: typeInfo
    inTypes [] .opStack #over list.get .val .getId tmpId =
    ## TODO check type
    typeInfo [] .opCount 1 == state [] .opStack opOffset list.get .val #swap #over OpValue .getId == & if
      .getId #dup .idType id.IdentifierType .TMP_VAR == #swap .id tmpId .id == & if ## assignment of tmp-var to itself
        opOffset 1 + opOffset =
        1 + continue
      end
    else #drop end
    state [] .compiledOps
      ## opSet
        typeInfo [] .valType
        tmpId
        pos
      opSet list.append
    state [] .compiledOps =
    state [] .compiledOps
      state [] .opStack .data opOffset + typeInfo [] .opCount array.create list.appendArray
    state [] .compiledOps =
    opOffset typeInfo [] .opCount + opOffset =
    1 typeInfo [] .opCount =
    1 +
  end #drop
end
proc( StackState ptr : inTypes StackState ptr mut : outTypes i64 : stackTypes bool : create i64 : blockStart FilePosition : pos TypeCheckState ptr mut : state => i64 ) =: storeOutTypes
  state [] .idContext =:: idContext
  idContext [] .labelContext @ =:: labelContext
  idContext [] .typeContext @ =:: typeContext
  stackTypes =:: mut nTypes
  create if
    nTypes =:: mut newTypes
    outTypes [] .opStack
      inTypes [] .opStack .length list.ensureCap
    outTypes [] .opStack =
    0 while #dup inTypes [] .typeStack .length < #over nTypes < & do
      inTypes [] .typeStack #over list.get .valType state [] .typeStack #over:2 list.get .valType types.typeEquals ! if
        break
      end
      outTypes [] .opStack
        inTypes [] .opStack #over:2 list.at .data list.appendP
      outTypes [] .opStack =
      newTypes 1 - newTypes =
      1 +
    end #drop
    newTypes 0 > if
      state [] .compiledOps
        #dup .length state [] .opStack .length + newTypes + list.ensureCap
      state [] .compiledOps =
      state [] .compiledOps .data blockStart + =:: codeStart
      ## mem.move
        codeStart newTypes +
        codeStart
        state [] .compiledOps .length blockStart -
      mem.move #drop
      state [] .compiledOps .length newTypes + state [] .compiledOps .length =
    end
  else
    nTypes outTypes [] .typeStack .length != if
      "wrong number of types at the end of " sb.wrap
        #+TODO print code-block name+#
        "-statement expected " sb.appendS
        outTypes [] .typeStack .length sb.appendI
        " got " sb.appendS
        nTypes sb.appendI
      pos state appendError
      nTypes return
    end
    outTypes [] .typeStack .length nTypes < if
      outTypes [] .typeStack .length nTypes =
    end
  end
  id.IdentifierInfo : mut tmpId
  0 =::  mut opOffset
  blockStart =:: mut newBlockStart
  0 while #dup nTypes < do
    state [] .typeStack #over list.at .data =:: typeInfo
    create #over outTypes [] .opStack .length >= & if
      ## IdInfo
        id.IdentifierType .TMP_VAR
        ## newLabel
          string.empty
          id.FLAG_NONE id.FLAG_MUTABLE |
          pos
          labelContext
        id.newLabel
        -1
        state [] .tmpCount ++
      id.IdentifierInfo new tmpId =
      ## opPredeclare
        typeInfo [] .valType
        tmpId
        pos
      opPredeclare state [] .compiledOps .data newBlockStart [] =
      newBlockStart 1 + newBlockStart =
      outTypes [] .opStack
        ## opGet
          typeInfo [] .valType
          tmpId
          pos
        opGet list.append
      outTypes [] .opStack =
    else
      outTypes [] .opStack #over list.get .val .getId tmpId =
      ## TODO check type
    end
    typeInfo [] .opCount 1 == state [] .opStack opOffset list.get .val #swap #over OpValue .getId == & if
      .getId #dup .idType id.IdentifierType .TMP_VAR == #swap .id tmpId .id == & if ## assignment of tmp-var to itself
        opOffset 1 + opOffset =
        1 + continue
      end
    else #drop end
    state [] .compiledOps
      ## opSet
        typeInfo [] .valType
        tmpId
        pos
      opSet list.append
    state [] .compiledOps =
    state [] .compiledOps
      state [] .opStack .data opOffset + typeInfo [] .opCount array.create list.appendArray
    state [] .compiledOps =
    opOffset typeInfo [] .opCount + opOffset =
    ## opGet
        typeInfo [] .valType
        tmpId
        pos
    opGet state [] .opStack #over:2 list.set
    1 typeInfo [] .opCount =
    1 +
  end #drop
  create if
    outTypes [] .typeStack
      state [] .typeStack list.appendAll
    outTypes [] .typeStack =
  end
  nTypes return
end
proc( BlockInfo ptr mut : whileBlock bool : isBreak FilePosition : pos TypeCheckState ptr mut : state => i64 ) =: storeLoopOutTypes
  state [] .typeStack .length
  isBreak ! if
    1 -
  end =:: nTypes
  whileBlock [] .blockData .whileBlock .hasOutTypes ! =:: create
  whileBlock [] .blockData .whileBlock .inTypes @ =:: inTypes
  whileBlock [] .blockData .whileBlock .outTypes @ =:: outTypes
  inTypes outTypes nTypes create whileBlock [] .blockStart pos state storeOutTypes return
end
proc( BlockInfo ptr mut : ifBlock FilePosition : pos TypeCheckState ptr mut : state => i64 ) =: storeIfOutTypes
  state [] .typeStack .length =:: nTypes
  ifBlock [] .blockData .ifBlock .elsePos -1 == =:: create
  ifBlock [] .blockData .ifBlock .inTypes @ =:: inTypes
  ifBlock [] .blockData .ifBlock .outTypes @ =:: outTypes
  inTypes outTypes nTypes create ifBlock [] .blockStart pos state storeOutTypes return
end
proc( BlockInfo ptr mut : switchBlock FilePosition : pos TypeCheckState ptr mut : state => i64 ) =: storeSwitchOutTypes
  state [] .typeStack .length =:: nTypes
  switchBlock [] .blockData .switchBlock .endReachable ! =:: create
  switchBlock [] .blockData .switchBlock .inTypes @ =:: inTypes
  switchBlock [] .blockData .switchBlock .outTypes @ =:: outTypes
  inTypes outTypes nTypes create switchBlock [] .blockStart pos state storeOutTypes return
end

proc( Operation ptr mut : op id.IdentifierInfo : idInfo TypeCheckState ptr mut : state => bool #+XXX remove return value once implementation is complete+# ) =: typeCheckGetId
  state [] .idContext =:: idContext
  idContext [] .labelContext @ =:: labelContext
  idContext [] .typeContext @ =:: typeContext
  idInfo .idType switch
    LOCAL_VAR GLOBAL_VAR TMP_VAR ARGUMENT case
      op [] .dataType types.isAutoType if
        op [] .dataType types.typeId #dup 0 < #over state [] .autoTypes .length >= | if
          "auto-type id out of range " sb.wrap
            #swap sb.appendI
            " max:" sb.appendS
            state [] .autoTypes .length 1 - sb.appendI
          op [] .pos state appendError
        else
          state [] .autoTypes #swap list.get op [] .dataType =
        end
      end
      ## XXX? check for undefined
      op [] .val OpValue .setId == if
        idInfo .labelId labelContext id.labelFlags id.FLAG_MUTABLE & 0 == if
          "variable " sb.wrap
            idInfo .labelId labelContext id.labelName .data sb.appendStr
            " is not mutable" sb.appendS
          op [] .pos state appendError
        end
        op [] .dataType @ array.wrap "variable assignment" string.wrap op [] .pos state requireTypes
        ## XXX? extract composite ops
        state [] .compiledOps
          op list.appendP
        state [] .compiledOps =
        1 op [] .pos state addCompiledStackOps
        false return
      end
      op [] .val OpValue .@Id == if
        ## getAddressType
          op [] .dataType
          idInfo .labelId labelContext id.labelFlags id.FLAG_MUTABLE & 0 ==
          typeContext
        types.getAddressType op [] .dataType =
      end
      op state pushValue
      false return
    PROCEDURE case
      ## TODO call
      true return
      break
    TEMPLATE_ARG TYPE case
      "operation " sb.wrap
        op [] labelContext typeContext sb.appendOp
        " should not exist at this stage of compilation" sb.appendS
      op [] .pos state appendError
      break
  end
  false return
end
proc( Operation ptr mut : op id.IdentifierInfo : idInfo TypeCheckState ptr mut : state => ) =: typeCheckDeclareId
  state [] .idContext =:: idContext
  idContext [] .labelContext @ =:: labelContext
  idContext [] .typeContext @ =:: typeContext
  idInfo .idType switch
    LOCAL_VAR GLOBAL_VAR TMP_VAR case
      op [] .val OpValue .declareId == if
        op [] .dataType types.isAutoType if
          op [] .dataType types.typeId =:: autoTypeId
          autoTypeId 0 < autoTypeId state [] .autoTypes .length >= | if
            "auto-type id out of range " sb.wrap
              autoTypeId sb.appendI
              " max:" sb.appendS
              state [] .autoTypes .length 1 - sb.appendI
            op [] .pos state appendError
          else state [] .typeStack list.peek #dup optional.hasData _if
            ## XXX? convert enum-label to enum
            .data [] .valType
              #dup state [] .autoTypes autoTypeId list.set
            op [] .dataType =
          else #drop end
        end
        op [] .dataType @ array.wrap "variable declaration" string.wrap op [] .pos  state requireTypes
        ## XXX? extract types (if local)
      end
      ## XXX check if type is undefined
      state [] .compiledOps
        op list.appendP
      state [] .compiledOps =
      op [] .val OpValue .declareId == if
        1 op [] .pos state addCompiledStackOps
      end
      return
    PROCEDURE case
      ## XXX check if type is procedure
      op [] .val OpValue .predeclareId == if
        state [] .compiledOps
          op list.appendP
        state [] .compiledOps =
        return
      end
      ## XXX check if stack is non-empty
      ## XXX check if procedure is on global level
      state [] .openBlocks
        ## BlockInfo
            op [] .dataType typeContext types.getProcOut #drop
          BlockData .procBlock new
          op [] .pos
          state [] .compiledOps .length
          -1
          codeBlocks.BlockType .PROCEDURE
        BlockInfo new list.append
      state [] .openBlocks =
      0 state [] .tmpCount =
      state [] .compiledOps
        op list.appendP
      state [] .compiledOps =
      op [] .dataType typeContext types.getProcIn #drop =:: inTypes
      Operation : mut tmp
      0 while #dup inTypes typeContext types.compositeEltCount < do
        inTypes #over typeContext types.compositeGetLabel =:: label
        label labelContext id.isLabelEmpty if
          ## opGet
            inTypes #over typeContext types.compositeGetElement
            ## IdInfo
              id.IdentifierType .ARGUMENT
              label
              -1
              #over:4
            id.IdentifierInfo new
            op [] .pos
          opGet tmp =
          tmp @ state pushValue
        end
        1 +
      end #drop
      break
    ARGUMENT TEMPLATE_ARG TYPE case
      "operation " sb.wrap
        op [] labelContext typeContext sb.appendOp
        " should not exist at this stage of compilation" sb.appendS
      op [] .pos state appendError
      break
  end
end

proc( Operation ptr : op TypeCheckState ptr mut : state => ) =: checkReachable
  state [] .reachable if
    return
  end
  "unreachable operation: " sb.wrap
    op [] state [] .idContext [] .labelContext @ state [] .idContext [] .typeContext @ sb.appendOp
  op [] .pos state appendError
end
proc( Operation ptr : op TypeCheckState ptr mut : state => ) =: checkLocal
  state [] .openBlocks .length 0 > if
    return
  end
  "unexpected operation at global level: " sb.wrap
    op [] state [] .idContext [] .labelContext @ state [] .idContext [] .typeContext @ sb.appendOp
  op [] .pos state appendError
end

proc( Operation ptr mut : op TypeCheckState ptr mut : state => ) =: typeCheckOp
  state [] .idContext =:: idContext
  idContext [] .labelContext @ =:: labelContext
  idContext [] .typeContext @ =:: typeContext
  ## TODO prepare identifiers
  op [] .val switch
    OpValue .Constant case
      state [] .reachable if
        op state pushValue return
      end
      state [] .openBlocks list.peek #dup optional.hasData if .data =:: block
        block [] .blockType #dup codeBlocks.BlockType .SWITCH == #swap codeBlocks.BlockType .CASE == | if
          block [] .blockData .switchBlock .labels @ =:: lables
          block [] .blockData .switchBlock .switchType =:: switchType
          op [] .val .Constant =:: constant
          op [] .dataType switchType typeContext canAutoCast ! if ## XXX ? allow extended constant casts?
            "wrong type for switch-label expected" sb.wrap
               switchType labelContext typeContext sb.appendType
               " got " sb.appendS
               op [] .dataType labelContext typeContext sb.appendType
             op [] .pos state appendError
          end
          0 while #dup lables [] .length < do
            lables [] #over list.at .data [] .value constant labelContext constantEquals if
              "duplicate label " sb.wrap
                 switchType typeContext types.isEnum if ## XXX handle missing name
                  switchType constant .enumLabel typeContext types.compositeGetLabel labelContext id.labelName .data sb.appendStr
                else
                  constant labelContext typeContext sb.appendConstant
                end
                " in switch-case" sb.appendS
              op [] .pos state appendError
            end
            1 +
          end #drop
          lables []
            ## LabelData
              constant
              op [] .pos
            LabelData new list.append
          lables [] =
          block [] .blockData .switchBlock .cases list.peek .data [] .count ++ #drop
          return
        end
      else #drop end
      op state checkReachable
      break
    unaryOperator case
      op state checkReachable
      state [] .typeStack list.peek #dup optional.isEmpty if #drop
        "not enough operands for : " sb.wrap
          op [] labelContext typeContext sb.appendOp
        op [] .pos state appendError
        return
      end .data =:: src
      ## XXX try constant evaluation
      op state checkLocal
      src [] .valType op [] .dataType =
      op [] .val .unaryOperator switch
        INCREMENT DECREMENT case
          src [] .writable ! if
            "the operand for unary operator " sb.wrap
              op [] .val .unaryOperator sb.appendUnaryOperator
              " has to be writable" sb.appendS
            op [] .pos state appendError
          end
          ## XXX ensure operation is kept mutable
          src [] .valType
            #dup typeContext types.isFixedSizePtr if
              #drop break
            end
          #dup typeContext types.isNumber ! if
            "wrong operand for unary operator " sb.wrap
              op [] .val .unaryOperator sb.appendUnaryOperator
              " expected number got " sb.appendS
              #swap labelContext typeContext sb.appendType
            op [] .pos state appendError
          else #drop end
          break
        NEGATE case
          src [] .valType
          #dup typeContext types.isNumber ! if
            "wrong operand for unary operator " sb.wrap
              op [] .val .unaryOperator sb.appendUnaryOperator
              " expected number got " sb.appendS
              #swap labelContext typeContext sb.appendType
            op [] .pos state appendError
          else #drop end
          break
        FLIP case
          src [] .valType
          #dup typeContext types.isInt ! if
            "wrong operand for unary operator " sb.wrap
              op [] .val .unaryOperator sb.appendUnaryOperator
              " expected integer got " sb.appendS
              #swap labelContext typeContext sb.appendType
            op [] .pos state appendError
          else #drop end
          break
        NOT case
          src [] .valType
          #dup typeContext types.isBoolean ! if
            "wrong operand for unary operator " sb.wrap
              op [] .val .unaryOperator sb.appendUnaryOperator
              " expected boolean got " sb.appendS
              #swap labelContext typeContext sb.appendType
            op [] .pos state appendError
          else #drop end
          break
      end
      ## XXX extract composites
      op 1 state insertStackOp
      return
    binaryOperator case
      op state checkReachable
      state [] .typeStack .length 2 < if
        "not enough operands for : " sb.wrap
          op [] labelContext typeContext sb.appendOp
          " need 2 got " sb.appendS
          state [] .typeStack .length sb.appendI
        op [] .pos state appendError
        return
      end
      state [] .typeStack #dup .length 1 - list.at .data =:: right
      state [] .typeStack #dup .length 2 - list.at .data =:: left
      types.Type 2 array new =:: mut inTypes
      left [] .valType  inTypes @ 0 [] =
      right [] .valType inTypes @ 1 [] =
      ## XXX try constant evaluation
      op state checkLocal
      op [] .val .binaryOperator switch
        ADD case
          ## number+number -> number
          left [] .valType right [] .valType inTypes @ typeContext checkBinOpNumber #dup types.Type .undefined != if
            op [] .dataType =
          else #drop end
          ## pointer+integer -> pointer
          left [] .valType typeContext types.isRawPointer right [] .valType typeContext types.isInt & if
            left [] .valType op [] .dataType =
            types.primitive.I64 inTypes @ 1 [] = ## XXX? ptrDiff
          end
          break
        SUBTRACT case
          ## number-number -> number
          left [] .valType right [] .valType inTypes @ typeContext checkBinOpNumber #dup types.Type .undefined != if
            op [] .dataType =
          else #drop end
          ## pointer-integer -> pointer
          left [] .valType typeContext types.isRawPointer right [] .valType typeContext types.isInt & if
            left [] .valType op [] .dataType =
            types.primitive.I64 inTypes @ 1 [] = ## XXX? ptrDiff
          end
          ## pointer-pointer -> integer
          left [] .valType typeContext types.isRawPointer right [] .valType typeContext types.isRawPointer &
          left [] .valType right [] .valType types.typeEquals & if
            types.primitive.I64 op [] .dataType = ## XXX ? pointer-diff integer type
          end
          break
        MULTIPLY DIVIDE MOD case
          ## number*number -> number
          left [] .valType right [] .valType inTypes @ typeContext checkBinOpNumber #dup types.Type .undefined != if
            op [] .dataType =
          else #drop end
          break
        UDIVIDE UMOD LSHIFT RSHIFT URSHIFT case
          ## integer>>integer -> integer
          left [] .valType right [] .valType inTypes @ typeContext checkBinOpInt #dup types.Type .undefined != if
            op [] .dataType =
          else #drop end
          break
        AND OR XOR case
          ## integer&integer -> integer
          left [] .valType right [] .valType inTypes @ typeContext checkBinOpInt types.Type .undefined != if
            types.primitive.BOOL op [] .dataType =
          end
          ## bool&bool -> bool
          left [] .valType typeContext types.isBoolean right [] .valType typeContext types.isBoolean & if
            types.primitive.BOOL op [] .dataType =
          end
          break
        EQ NE case
          ## number==number -> bool
          left [] .valType right [] .valType inTypes @ typeContext checkBinOpNumber types.Type .undefined != if
            types.primitive.BOOL op [] .dataType =
          end
          ## ptr==ptr -> bool
          left [] .valType typeContext types.isRawPointer right [] .valType typeContext types.isRawPointer &
          left [] .valType right [] .valType types.typeEquals & if
            types.primitive.BOOL op [] .dataType =
          end
          ## bool==bool -> bool
          left [] .valType typeContext types.isBoolean right [] .valType typeContext types.isBoolean & if
            types.primitive.BOOL op [] .dataType =
          end
          ## enum==enum -> bool TODO
          break
        LT LE GE GT case
          ## number<number -> bool
          left [] .valType right [] .valType inTypes @ typeContext checkBinOpNumber types.Type .undefined != if
            types.primitive.BOOL op [] .dataType =
          end
          break
      end
      op [] .dataType types.Type .undefined == if
        "no version of binary operator " sb.wrap
          op [] .val .binaryOperator sb.appendBinaryOperator
          " accepts types " sb.appendS
          left [] .valType labelContext typeContext sb.appendType
          " and " sb.appendS
          right [] .valType labelContext typeContext sb.appendType
        op [] .pos state appendError
      end
      ## XXX extract composites
      "binary operator " sb.wrap op [] .val .binaryOperator sb.appendBinaryOperator
        inTypes @ array.wrap #over sb.toStr op [] .pos  state requireTypes
      sb.free #drop
      op 2 state insertStackOp
      break
    block case
      op state checkLocal
      op [] .val .block .blockType switch
        IF case
          op state checkReachable
          state [] .ifCount ++ =:: blockId
          blockId op [] .val .block .blockId =
          types.primitive.BOOL op [] .dataType =
          op [] .dataType @ array.wrap "if condition" string.wrap op [] .pos state requireTypes
          true op [] .pos state storeStack =:: newLength
          state [] .compiledOps .length =:: blockStart
          state [] .compiledOps
            op list.appendP
          state [] .compiledOps =
          ## write if condition
          1 op [] .pos state addCompiledStackOps
          newLength state [] .opStack .length =
          ## BlockInfo
              state copyStack
              emptyStackState
              -1
              false
            IfBlockData new BlockData .ifBlock new
            op [] .pos
            blockStart
            blockId
            codeBlocks.BlockType .IF
          BlockInfo new =:: ifBlock
          state [] .openBlocks
            ifBlock list.append
          state [] .openBlocks =
          break
        ELSE case
          state [] .openBlocks .length 0 == if
            "unexpected else statement" sb.wrap op [] .pos state appendError
            return
          end
          state [] .openBlocks list.peek .data =:: ifBlock
          ifBlock [] .blockType codeBlocks.BlockType .IF != if
            "else can only appear in if blocks" sb.wrap op [] .pos state appendError
            return
          end
          state [] .reachable ifBlock [] .blockData .ifBlock .elseReachable =
          state [] .reachable if
            ifBlock op [] .pos state storeIfOutTypes state [] .opStack .length =
          end
          ifBlock [] .blockData .ifBlock .inTypes @ state resetStack
          state [] .compiledOps .length ifBlock [] .blockData .ifBlock .elsePos =
          codeBlocks.BlockType .ELSE ifBlock [] .blockType =
          ifBlock [] .blockId op [] .val .block .blockId =
          state [] .compiledOps
            op list.appendP
          state [] .compiledOps =
          true state [] .reachable =
          break
        WHILE case
          op state checkReachable
          state [] .whileCount ++ =:: blockId
          blockId op [] .val .block .blockId =
          false op [] .pos state storeStack state [] .opStack .length =
          ## BlockInfo
              state copyStack
              emptyStackState
              false
              false
            WhileBlockData new BlockData .whileBlock new
            op [] .pos
            state [] .compiledOps .length
            blockId
            codeBlocks.BlockType .WHILE
          BlockInfo new =:: whileBlock
          state [] .compiledOps
            op list.appendP
          state [] .compiledOps =
          state [] .openBlocks
            whileBlock list.append
          state [] .openBlocks =
          break
        DO case
          op state checkReachable
          state [] .openBlocks .length 0 == if
            "unexpected do statement" sb.wrap op [] .pos state appendError
            return
          end
          state [] .openBlocks list.peek .data =:: whileBlock
          whileBlock [] .blockType codeBlocks.BlockType .WHILE != if
            "do can only appear in while blocks" sb.wrap op [] .pos state appendError
            return
          end
          whileBlock false op [] .pos state storeLoopOutTypes =:: newOpCount
          ## compile condition
          whileBlock [] .blockId op [] .val .block .blockId =
          types.primitive.BOOL op [] .dataType =
          op [] .dataType @ array.wrap "do condition" string.wrap op [] .pos state requireTypes
          state [] .compiledOps
            op list.appendP
          state [] .compiledOps =
          1 op [] .pos state addCompiledStackOps
          newOpCount state [] .opStack .length =
          ## update block
          codeBlocks.BlockType .DO whileBlock [] .blockType =
          state copyStack whileBlock [] .blockData .whileBlock .outTypes =
          break
        BREAK case
          true state findBreakableBlock #dup optional.isEmpty if #drop
            60 sb.create
              codeBlocks.BlockType .BREAK sb.appendBlockType
              " can only appear in loops and switch-case statements" sb.appendS
            op [] .pos state appendError
            return
          end .data =:: breakBlock
          breakBlock [] .blockId op [] .val .block .blockId =
          false =:: mut match
          breakBlock [] .blockType #dup codeBlocks.BlockType .WHILE == #swap codeBlocks.BlockType .DO == | if
            op state checkReachable
            breakBlock false op [] .pos state storeLoopOutTypes #drop
            true match =
          end
          breakBlock [] .blockType #dup codeBlocks.BlockType .CASE == #swap codeBlocks.BlockType .DEFAULT == | if
            breakBlock [] .blockData .switchBlock .explicitBreak if
              op state checkReachable
            else
              breakBlock op [] .pos state storeSwitchOutTypes #drop
              true breakBlock [] .blockData .switchBlock .explicitBreak =
            end
            true breakBlock [] .blockData .switchBlock .endReachable =
            true match =
          end
          state [] .opStack list.clear state [] .opStack =
          state [] .typeStack list.clear state [] .typeStack =
          state [] .compiledOps
            op list.appendP
          state [] .compiledOps =
          false state [] .reachable =
          match if return end
          break
        CONTINUE case
          op state checkReachable
          false state findBreakableBlock #dup optional.isEmpty if #drop
            35 sb.create
              codeBlocks.BlockType .CONTINUE sb.appendBlockType
              " can only appear in loops" sb.appendS
            op [] .pos state appendError
            return
          end .data =:: breakBlock
          breakBlock [] .blockId op [] .val .block .blockId =
          false state [] .reachable =
          breakBlock [] .blockType #dup codeBlocks.BlockType .WHILE == #swap codeBlocks.BlockType .DO == | if
            breakBlock op [] .pos state storeLoopInTypes
            state [] .compiledOps
              op list.appendP
            state [] .compiledOps =
          end
          break
        SWITCH case
          op state checkReachable
          state [] .switchData .length i32 cast =:: blockId
          blockId op [] .val .block .blockId =
          state [] .typeStack list.peek #dup optional.isEmpty if #drop
            "missing argument for switch-statement" sb.wrap op [] .pos state appendError
            types.Type .undefined
          else .data [] .valType end =:: switchType
          switchType typeContext types.isInt if
            switchType op [] .dataType =
          else switchType typeContext types.isEnum _if
            ## XXX change enum to label
            switchType op [] .dataType =
          else
            "cannot switch values of type " sb.wrap
              switchType labelContext typeContext sb.appendType
            op [] .pos state appendError
          end
          true op [] .pos state storeStack =:: newLength
          state [] .compiledOps .length =:: blockStart
          state [] .compiledOps
            op list.appendP
          state [] .compiledOps =
          ## write switch value
          1 op [] .pos state addCompiledStackOps
          newLength state [] .opStack .length =
          ## BlockInfo
              state copyStack
              emptyStackState
              0 LabelData list.create
              0 CaseInfo list.create
                0 0 CaseInfo new list.append
              switchType
              false
              false
            SwitchBlockData new BlockData .switchBlock new
            op [] .pos
            blockStart
            blockId
            codeBlocks.BlockType .SWITCH
          BlockInfo new =:: switchBlock
          state [] .openBlocks
            switchBlock list.append
          state [] .openBlocks =
          false state [] .reachable =
          break
        CASE case
          state [] .openBlocks .length 0 == if
            "unexpected " sb.wrap
              codeBlocks.BlockType .CASE sb.appendBlockType
            " statement" sb.appendS op [] .pos state appendError
            return
          end
          state [] .openBlocks list.peek .data =:: switchBlock
          switchBlock [] .blockType #dup codeBlocks.BlockType .SWITCH != #swap codeBlocks.BlockType .CASE != & if
            40 sb.create
              codeBlocks.BlockType .CASE sb.appendBlockType
            "-statements are only allowed in switch-case blocks" sb.appendS op [] .pos state appendError
            ## XXX? additional message if current block is default
            return
          end
          state [] .reachable if
            "unfinished " sb.wrap
              codeBlocks.BlockType .CASE sb.appendBlockType
            " statement" sb.appendS op [] .pos state appendError
          end
          switchBlock [] .blockData .switchBlock .cases list.peek .data [] .count 0 == if
            60 sb.create
              codeBlocks.BlockType .CASE sb.appendBlockType
            "-statement has to be preceded by at least one label" sb.appendS op [] .pos state appendError
          end
          switchBlock [] .blockData .switchBlock .cases
            switchBlock [] .blockData .switchBlock .labels .length 0 CaseInfo new list.append
          switchBlock [] .blockData .switchBlock .cases =
          true state [] .reachable =
          switchBlock [] .blockData .switchBlock .inTypes @ state resetStack
          codeBlocks.BlockType .CASE switchBlock [] .blockType =
          false switchBlock [] .blockData .switchBlock .explicitBreak =
          switchBlock [] .blockData .switchBlock .switchType op [] .dataType =
          switchBlock [] .blockId op [] .val .block .blockId =
          ## XXX? sub-id
          state [] .compiledOps
            op list.appendP
          state [] .compiledOps =
          break
        DEFAULT case
          state [] .openBlocks .length 0 == if
            "unexpected " sb.wrap
              codeBlocks.BlockType .DEFAULT sb.appendBlockType
            " statement" sb.appendS op [] .pos state appendError
            return
          end
          state [] .openBlocks list.peek .data =:: switchBlock
          switchBlock [] .blockType codeBlocks.BlockType .CASE != if
            40 sb.create
              codeBlocks.BlockType .DEFAULT sb.appendBlockType
            "-statements are only allowed in switch-case blocks" sb.appendS op [] .pos state appendError
            ## XXX? additional messages if current block is switch or default
            return
          end
          state [] .reachable if
            "unfinished " sb.wrap
              codeBlocks.BlockType .CASE sb.appendBlockType
            " statement" sb.appendS op [] .pos state appendError
          end
          switchBlock [] .blockData .switchBlock .cases list.peek .data [] .count 0 != if
            60 sb.create
              codeBlocks.BlockType .DEFAULT sb.appendBlockType
            "-statement cannot be preceded by at labels" sb.appendS op [] .pos state appendError
          end
          true state [] .reachable =
          switchBlock [] .blockData .switchBlock .inTypes @ state resetStack
          codeBlocks.BlockType .DEFAULT switchBlock [] .blockType =
          false switchBlock [] .blockData .switchBlock .explicitBreak =
          switchBlock [] .blockData .switchBlock .switchType op [] .dataType =
          switchBlock [] .blockId op [] .val .block .blockId =
          state [] .compiledOps
            op list.appendP
          state [] .compiledOps =
          break
        UNKNOWN PROCEDURE case
          "blocks of type " sb.wrap
            op [] .val .block .blockType sb.appendBlockType
          " are not supported" sb.appendS
          op [] .pos state appendError
          break
      end
      break
    blockEnd case
      state [] .openBlocks .length 0 == if
        "unexpected end of " sb.wrap
          op [] .val .blockEnd .blockType sb.appendBlockType
        op [] .pos state appendError
        return
      end
      state [] .openBlocks list.peek .data =:: closed
      op [] .val .blockEnd .blockType closed [] .blockType != if
        "unexpected end of " sb.wrap
          op [] .val .blockEnd .blockType sb.appendBlockType
          " block expected end " sb.appendS
          closed [] .blockType sb.appendBlockType
        op [] .pos state appendError
      end
      closed [] .blockType switch
        IF ELSE case
          state [] .reachable if
            closed op [] .pos state storeIfOutTypes state [] .opStack .length =
          end
          state [] .reachable
            closed [] .blockData .ifBlock .elseReachable |
            closed [] .blockData .ifBlock .elsePos -1 == |
          state [] .reachable =
          closed [] .blockData .ifBlock .inTypes @ freeStackState
          closed [] .blockData .ifBlock .outTypes @ freeStackState
          break
        WHILE case
          "unexpected end of " sb.wrap
            closed [] .blockType sb.appendBlockType
            "-block expected " sb.appendS
            codeBlocks.BlockType .DO sb.appendBlockType
          op [] .pos state appendError
          closed [] .blockData .whileBlock .inTypes @ freeStackState
          closed [] .blockData .whileBlock .outTypes @ freeStackState
          break
        DO case
          state [] .reachable closed [] .blockData .whileBlock .doesLoop | ! if
            "while block cannot complete a loop " sb.wrap op [] .pos state appendError
          end
          state [] .reachable if
            closed op [] .pos state storeLoopInTypes
          end
          closed [] .blockData .whileBlock .outTypes @ state resetStack
          true state [] .reachable =
          closed [] .blockData .whileBlock .inTypes @ freeStackState
          closed [] .blockData .whileBlock .outTypes @ freeStackState
          break
        SWITCH case
          "unexpected end of " sb.wrap
            closed [] .blockType sb.appendBlockType
            "-block expected " sb.appendS
            codeBlocks.BlockType .CASE sb.appendBlockType
          op [] .pos state appendError
          closed [] .blockData .switchBlock .inTypes @ freeStackState
          closed [] .blockData .switchBlock .outTypes @ freeStackState
          break
        CASE case
          state [] .reachable if
            "missing break statement at end of case" sb.wrap op [] .pos state appendError
          end
          closed [] .blockData .switchBlock @ =:: switchBlock
          ## TODO check if all labels are covered
          switchBlock [] .outTypes @ state resetStack
          switchBlock [] .endReachable state [] .reachable =
          state [] .switchData
            switchBlock [] .labels
            switchBlock [] .cases
            SwitchData new list.append
          state [] .switchData =
          closed [] .blockData .switchBlock .inTypes @ freeStackState
          closed [] .blockData .switchBlock .outTypes @ freeStackState
          break
        DEFAULT case
          closed [] .blockData .switchBlock @ =:: switchBlock
          state [] .reachable if
            closed op [] .pos state storeSwitchOutTypes #drop
            state [] .compiledOps
              ## opBlock
                codeBlocks.BlockType .BREAK
                op [] .pos
              opBlock list.append
            state [] .compiledOps =
          end
          switchBlock [] .outTypes @ state resetStack
          switchBlock [] .endReachable state [] .reachable =
          state [] .switchData
            switchBlock [] .labels
            switchBlock [] .cases
            SwitchData new list.append
          state [] .switchData =
          closed [] .blockData .switchBlock .inTypes @ freeStackState
          closed [] .blockData .switchBlock .outTypes @ freeStackState
          break
        PROCEDURE case
          ## XXX add implicit return at end of procedure with return value
          ## XXX check for empty stack at end of void procedure
          true state [] .reachable =
          state [] .opStack
            list.clear
          state [] .opStack =
          state [] .typeStack
            list.clear
          state [] .typeStack =
          break
        BREAK CONTINUE UNKNOWN case
          "closing blocks of type " sb.wrap
            op [] .val .blockEnd .blockType sb.appendBlockType
          " is not supported" sb.appendS
          op [] .pos state appendError
          break
      end
      state [] .compiledOps
        op list.appendP
      state [] .compiledOps =
      ## XXX push op-unreachable if unreachable
      state [] .openBlocks
        list.pop #drop ## remove closed block after writing operations
      state [] .openBlocks =
      break
    getId case
      op state checkReachable
      op op [] .val .getId state typeCheckGetId if break end
      return
    setId case
      op state checkReachable
      op op [] .val .setId state typeCheckGetId if break end
      return
    @Id case
      op state checkReachable
      op op [] .val .@Id state typeCheckGetId if break end
      return
    declareId case
      op state checkReachable
      op op [] .val .declareId state typeCheckDeclareId
      break
    predeclareId case
      op state checkReachable
      op op [] .val .predeclareId state typeCheckDeclareId
      break
    getLabel case
      op state checkReachable
      break ## TODO
    setLabel case
      op state checkReachable
      break ## TODO
    @Label case
      op state checkReachable
      break ## TODO
    getTupleElement case
      op state checkReachable
      break ## TODO
    setTupleElement case
      op state checkReachable
      break ## TODO
    @TupleElement case
      op state checkReachable
      break ## TODO
    getArrayElement case
      op state checkReachable
      break ## TODO
    setArrayElement case
      op state checkReachable
      break ## TODO
    @ArrayElement case
      op state checkReachable
      break ## TODO
    Print case
      op state checkReachable
      state [] .typeStack .length 0 == if
        "not enough operands for : " sb.wrap
          op [] labelContext typeContext sb.appendOp
        op [] .pos state appendError
        return
      end
      state [] .compiledOps
        op list.appendP
      state [] .compiledOps =
      1 op [] .pos state addCompiledStackOps
      return
    Return case
      op state checkReachable
      break ## TODO
    New case
      op state checkReachable
      op [] .dataType typeContext types.isArray if
        op [] .dataType typeContext types.isFixedSize ! if
          "variable size arrays are not supported" sb.wrap op [] .pos state appendError
        end
        op state pushValue return
      end
      op [] .dataType typeContext types.isTuple if
        op [] .dataType typeContext types.compositeEltCount =:: count
        op [] .dataType typeContext types.compositeElts "tuple creation" string.wrap op [] .pos state requireTypes
        ## XXX? extract composite ops
        op count state insertStackOp
      end
      break
    newEnum case
      op state checkReachable
      break ## TODO
    callPtr case
      op state checkReachable
      break ## TODO
    argc case
      op state checkReachable
      break ## TODO
    getArg case
      op state checkReachable
      break ## TODO
    getArgLen case
      op state checkReachable
      break ## TODO
    Cast Cast! case
      op [] .val OpValue .Cast! == =:: forceCast
      state [] .typeStack list.peek #dup optional.isEmpty if #drop
        "not enough operands for : " sb.wrap
          op [] labelContext typeContext sb.appendOp
        op [] .pos state appendError
        return
      end .data =:: src
      src [] .valType forceCast if op [] .val .Cast! = else op [] .val .Cast = end
      src [] .valType op [] .dataType forceCast typeContext canCast ! if
        "cannot cast " sb.wrap
          src [] .valType labelContext typeContext sb.appendType
          " to " sb.appendS
          op [] .dataType labelContext typeContext sb.appendType
        op [] .pos state appendError
      end
      ## XXX constant evaluation
      op state checkReachable
      op state checkLocal
      ## XXX? extract composite ops
      1 op [] .pos state addCompiledStackOps
      break
    entryPoint case
      op state checkReachable
      state [] .openBlocks
        ## BlockInfo
            types.Type array.empty id.LABEL_ID_NONE true typeContext types.newProcArgs #drop
          BlockData .procBlock new
          op [] .pos
          state [] .compiledOps .length
          -1
          codeBlocks.BlockType .PROCEDURE
        BlockInfo new list.append
      state [] .openBlocks =
      0 state [] .tmpCount =
      state [] .compiledOps
        op list.appendP
      state [] .compiledOps =
      return
    stackMod case
      op state checkReachable
      break ## TODO
    Unknown case
      "unknown identifier: \"" sb.wrap
        op [] .val .Unknown labelContext id.labelName .data sb.appendStr
        '\"' sb.appendC
      op [] .pos state appendError
      return
    NOP case
      return ## do nothing
  end
  #+ XXX re-enable once significant portion of operations is implemented
  "type-checking for operation " sb.wrap
    op [] labelContext typeContext sb.appendOp
    " is not implemented" sb.appendS
  op [] .pos state appendError
  +#
end

proc( Program ptr mut => ) =: public typeCheckProgram
  =:: mut prog
  ## TypeCheckState
    prog [] .idContext @
    128 Operation list.create
    128 Operation list.create
    128 TypeInfo  list.create
    128 BlockInfo list.create
    prog [] .autoTypes
    128 SwitchData list.create
    prog [] .errors
    0
    0
    0
    true
    prog [] .hasCheckBounds
    prog [] .hasCheckEnum
    prog [] .hasGetArgs
  TypeCheckState new =:: mut state
  0 =:: mut globalTmpCount
  0 while #dup prog [] .progFiles .length < do
    prog [] .progFiles #over list.at .data
      globalTmpCount state .tmpCount =
      state .compiledOps list.clear state .compiledOps =
      0 while #dup #over:2 [] .globalOps .length < do
        #swap
          #dup [] .globalOps #over:2 list.at .data state @ typeCheckOp
        #swap 1 +
      end #drop
      state .openBlocks .length 0 > if
        "unfinished code block" sb.wrap state .openBlocks list.peek .data [] .startPos state @ appendError
        state .openBlocks list.clear state .openBlocks =
      end
      #dup [] .globalOps list.clear
        state .compiledOps list.appendAll
      #over [] .globalOps =
      state .tmpCount globalTmpCount =
      0 state .tmpCount =
      state .compiledOps list.clear state .compiledOps =
      0 while #dup #over:2 [] .localOps .length < do
        #swap
          #dup [] .localOps #over:2 list.at .data state @ typeCheckOp
        #swap 1 +
      end #drop
      state .openBlocks .length 0 > if
        "unfinished code block" sb.wrap state .openBlocks list.peek .data [] .startPos state @ appendError
        state .openBlocks list.clear state .openBlocks =
      end
      #dup [] .localOps list.clear
        state .compiledOps list.appendAll
      #over [] .localOps =
    #drop
    1 +
  end #drop
  ## TODO type check template implementations
  state .errors         prog [] .errors =
  state .autoTypes      prog [] .autoTypes =
  state .hasCheckBounds prog [] .hasCheckBounds =
  state .hasCheckEnum   prog [] .hasCheckEnum =
  state .hasGetArgs     prog [] .hasGetArgs =
end
