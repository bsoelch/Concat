  ProcedureImpl : impl
  FilePosition : expandedAt
) =:: MissingProc

struct(
  iSize : openBlocksOffset
  iSize : compiledOpsOffset
  iSize : initializationStackOffset
  iSize : skippedBlocksOffset
  i32 : blockStart
  branchTree.NodeId : branchRoot
  Type : currentProcType
  FileId : currentFile
  TypeCheckMode : mode
  bool : inTypeBlock
  bool : reachable
) =:: TypeCheckStateState
struct(
  ProgramContext ptr.mut : program
  InterpreterContext : interpreter
  LabelId TypedValue hashMap : argData
  Type : currentProcType
  bool : inTypeBlock
  TypeInfo BranchTree : stack
  BlockInfo list : openBlocks
  Operation list : compiledOps
  BlockType list : skippedBlocks
  i32 : blockStart
  MissingProc list : missingProcs
  FileId : currentFile
  FilePosition list : initializationStack
  TypeCheckStateState list : stateStack
  TypeCheckMode :  mode
  bool : reachable
  bool : isUnusedProc ## will be set to true once all procs reachable from main are type-checked
) =:: export: TypeCheckState

proc( TypeCheckState ptr.mut : state -> ) =>: rememberState
  ## XXX? flag to check if state is currently in use
  ##   (auto-types are reset after type-checking (generic) procedure)
  state [] .stateStack
    ## TypeCheckStateState
      state [] .openBlocks .length
      state [] .compiledOps .length
      state [] .initializationStack .length
      state [] .skippedBlocks .length
      state [] .blockStart
      state .stack -1:branchTree.NodeId branchTree.reset
      state [] .currentProcType
      state [] .currentFile
      state [] .mode
      state [] .inTypeBlock
      state [] .reachable
    TypeCheckStateState new list.append
  state .stateStack=
  ## TODO remember Interpreter state
end
proc( TypeCheckState ptr.mut : state -> ) =>: resetState
  state [] .stateStack .length 0:iSize == if
    ## TODO error-message
    return
  end
  state [] .stateStack
    list.pop =:: prevState
  state .stateStack=
  ## TODO? error messages for open blocks/unhandled operations
  state [] .openBlocks
    prevState .openBlocksOffset list.setLength
  state .openBlocks=
  state [] .compiledOps
    prevState .compiledOpsOffset list.setLength
  state .compiledOps=
  state [] .initializationStack
    prevState .initializationStackOffset list.setLength
  state .initializationStack=
  state [] .skippedBlocks
    prevState .skippedBlocksOffset list.setLength
  state .skippedBlocks=
  prevState .blockStart state .blockStart=
  state .stack prevState .branchRoot branchTree.reset =:: oldRoot
  oldRoot -1:branchTree.NodeId != if
    ## TODO error message for unfinished branch
    state .stack oldRoot branchTree.endBranch
  end
  prevState .currentProcType state .currentProcType=
  prevState .currentFile state .currentFile=
  prevState .mode state .mode=
  prevState .inTypeBlock state .inTypeBlock=
  ## TODO reset Interpreter state
  prevState .reachable state .reachable=
end

proc( TypeCheckState ptr : state -> i32 ) =>: currentBlockStart
  state [] .blockStart return
end


union(
  i32 : fixedCount ## fixed number of arguments
  _ : typeModifier ## all arguments until first type
  _ : typeBlock ## no arguments
) =:: InterpreterLoadMode
proc( TypeInfo ptr : typeInfo TypeCheckState ptr.mut : state -> bool ) =>: isPopableConstant
  typeInfo [] .value .None ?? or
      typeInfo [] .opIndex 0 < or
      typeInfo [] .opIndex state currentBlockStart < if
    false return
  end
  true return
end
proc( TypeCheckState ptr.mut : state -> i32 bool ) =>: interpreterLoadFindType
  0:i32 =:: mut: count
  ## QBE crashes if itr is kept on stack
  state .stack branchTree.itr.start =:: mut: itr
  while
    itr branchTree.itr.hasNext
  do branchTree.itr.next =:: val itr=
    count 1 + count=
    val state isPopableConstant ! if
      -1:i32 true return
    else val [] .value .TypeId ?? _if
      count false return
    end
  end ..drop
  -1:i32 true return
end
proc( i32 : argCount TypeCheckState ptr.mut : state -> bool ) =>: interpreterLoadCheckArgs
  argCount 0 <= if
    false return
  end
  state [] .stack branchTree.depth argCount < if
    true return
  end
  0:i32 =:: mut: count
  ## QBE crashes if itr is kept on stack
  state .stack branchTree.itr.start  =:: mut: itr
  while
    itr branchTree.itr.hasNext
  do branchTree.itr.next =:: val itr=
    count 1 + count=
    val state isPopableConstant ! if
      true return
    end
    count argCount == if
      false return
    end
  end ..drop
  true return
end
proc(
  InterpreterLoadMode : mode
  TypeCheckState ptr.mut : state
-> bool ) =>: interpreterLoadContants
  mode switch
    fixedCount case
      mode .fixedCount state interpreterLoadCheckArgs if
        true return
      end
      mode .fixedCount break
    typeModifier case
      state interpreterLoadFindType if ..drop
        true return
      end break
    typeBlock case false return
  end iSize cast.u =:: argCount
  state [] .program =:: progContext
  state .interpreter =:: interpreter
  ## XXX? make code less relient on internal behaviour of list
  interpreter [] .stack
    $ .length argCount + list.setLength
    $ .length 1:iSize - =:: stackTail
  interpreter .stack=
  interpreter [] .stackInfo
    $ .length argCount + list.setLength
    $ .length 1:iSize - =:: stackInfoTail
  interpreter .stackInfo=
  argCount for =:: i
    state .stack branchTree.pop .data =:: val
    val [] .value interpreter [] .stack stackTail i - list.set
    ## ValueInfo
      val [] .valueType
      val [] .pushedAt
    interpreter.ValueInfo new
      interpreter [] .stackInfo
      stackInfoTail i -
    list.set
    val [] .opIndex state deleteOp ## clear previous location of operation
  end
  state removeTrailingNOPs
  false return
end
proc( i32 : count FilePosition : pos TypeCheckState ptr.mut : state -> ) =>: interpreterStoreConstants
  state [] .program =:: progContext
  progContext .errors =:: errors
  progContext .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  state .interpreter =:: interpreter
  count iSize cast.u interpreter [] .stack .length u> if
    "stack undeflow: expected " sb.copyPtr
      count sb.appendI
      " got " sb.appendS
      interpreter [] .stack .length sb.appendI
    pos errors appendError
    0:iSize
  else
    interpreter [] .stack .length count iSize cast.u -
  end =:: offset
  ##  -> store computed constants
  offset while $ interpreter [] .stack .length u< do =:: i
    interpreter [] .stack i list.at .data =:: constant
    interpreter [] .stackInfo i list.at .data =:: constInfo
    ## pushConstant
      constant  []
      constInfo [] .valueType
      constInfo [] .pushedAt
    state pushConstant
  finally i 1:iSize + end ..drop
end

proc(
  Type : calledType
  ProcedureCallInfo : calledProc
  bool : staticProc
  FilePosition : pos
  TypeCheckState ptr.mut : state
-> bool ) =>: interpretCall
  state [] .program =:: progContext
  state .interpreter =:: interpreter
  progContext .idContext .typeContext =:: typeContext
  calledType typeContext types.getProcIn .data .length i32 cast.u =:: argCount
  argCount
    InterpreterLoadMode .fixedCount
  state interpreterLoadContants if
    staticProc if
      "could not resolve arguments of static procedure " sb.copyPtr
        progContext [] .procedures
          calledProc .procId i64 cast list.at
        .data [] .labelId typeContext .labelContext sb.appendLabelPath
      pos progContext .errors appendError
    end
    true return
  end
  ## evaluateCall
    calledProc .procId
    calledProc .implementationId
    calledType
    calledProc .autoArgs
    false
    pos
    interpreter
  evaluateCall if
    staticProc if
      "could not evaluate call to static procedure " sb.copyPtr
        progContext [] .procedures
          calledProc .procId i64 cast list.at
        .data [] .labelId typeContext .labelContext sb.appendLabelPath
      pos progContext .errors appendError
    end
    ## reset stack to previous state
    argCount pos state interpreterStoreConstants
    true return
  end
  ## store results
  calledType
    typeContext types.getProcOut .data .length i32 cast.u
  pos state interpreterStoreConstants
  false return
end
proc( Operation ptr : op TypeCheckState ptr.mut : state -> ) =>: interpretTypeModifier
  state [] .program .errors =:: errors
  state .interpreter interpreter.offsetContext
    InterpreterLoadMode .typeModifier state interpreterLoadContants if
      "could not resolve arguments of type Modifier " sb.copyPtr
        op [] .val .typeModifier sb.appendTypeModifier
      op [] .pos errors appendError
      state .interpreter interpreter.resetContext
      return
    end
    interpreter.InterpreterType .INTERPRET state .interpreter .evalType=
    ## TODO? directly evaluate type-modifer without evaluating operation?
    op state .interpreter evaluateOperation .Ok ?? ! if
      "could not evaluate type modifier " sb.copyPtr
        op [] .val .typeModifier sb.appendTypeModifier
      op [] .pos errors appendError
    end
    1 op [] .pos state interpreterStoreConstants
  state .interpreter interpreter.resetContext
end

proc( Operation ptr : op TypeCheckState ptr.mut : state -> ) =>: prepareInterpretTypeBlock
  state .interpreter interpreter.offsetContext
  InterpreterLoadMode .typeBlock state interpreterLoadContants ! "interpreterFindContant" assert
  state [] .compiledOps .length i32 cast.u state .blockStart=
  interpreter.InterpreterType .GLOBAL state .interpreter .evalType=
  op state .interpreter evaluateOperation .Ok ?? ! if
    "could not evaluate " sb.copyPtr
      op [] .val .block .blockType sb.appendBlockType
      " block" sb.appendS
    op [] .pos state [] .program .errors appendError
  end
  true state .inTypeBlock=
end
proc( Operation ptr : op TypeCheckState ptr.mut : state -> bool ) =>: interpretTypeBlock
  state [] .inTypeBlock "in Type-block" assert
  state .interpreter [] .evalType .GLOBAL ?? "global interpreter" assert
  op state .interpreter evaluateOperation .Ok ?? ! if
    "unexpected operation in Type/Initializer block: " sb.copyPtr
      op [] state [] .program sb.appendOp
    op [] .pos state [] .program .errors appendError
    false state .inTypeBlock=
    state .interpreter interpreter.resetContext
    false return
  end
  op .val .blockEnd ?? and state .interpreter interpreter.inTypeOrInitializer ! if
    1 op [] .pos state interpreterStoreConstants
    false state .inTypeBlock=
    state .interpreter interpreter.resetContext
    true return ## consume block end
  end
  true return
end

proc(
  bool : printValues
  i32 : maxCount
  i32 : depth
  TypeCheckState ptr.mut : state
-> ) =>: printTypes
  state [] .program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  idContext .constContext =:: constContext
  maxCount =:: mut: remaining
  printValues if
    "stack:\n" sb.copyPtr
  else
    "types:\n" sb.copyPtr
  end
    "-----------------\n" sb.appendS
  =:: mut: sb
  state .stack branchTree.itr.start while
    branchTree.itr.hasNext do branchTree.itr.next =:: val
    remaining 0 > and
        remaining 1 - remaining=
        remaining 0 == if
      break
    end
    sb
      val [] .valueType
        typeContext
        depth
      sb.appendTypeRecursive
      printValues if
        val [] .value .None ?? ! if
          " { " sb.appendS
          val [] .value typeContext sb.appendConstant
          " }" sb.appendS
        end
        " pushed at " sb.appendS
        val [] .pushedAt sb.appendPos
      end
      '\n' sb.appendC
    sb=
  end ..drop
  sb
    "-----------------\n" sb.appendS
    io.stdOut ..over io.fputSb ..drop
  sb.free ..drop
end

proc(
  i32 : count
  FilePosition : pos
  TypeCheckState ptr.mut : state
-> bool ) =>: checkStackSize
  state [] .stack branchTree.depth count < if
    "stack underflow: need " sb.copyPtr
      count sb.appendI
      " values got " sb.appendS
      state [] .stack branchTree.depth sb.appendI
    pos state [] .program .errors appendError
    true return
  end
  false return
end

proc(
  TypeInfo : src
  Type : target
  SignType : signType
  FilePosition : pos
  TypeCheckState ptr.mut : state
-> bool ) =>: tryCastConstant
  state [] .program .errors =:: errors
  state [] .program .idContext .typeContext =:: typeContext
  src .value .None ?? if
    true return
  end
  src .opIndex 0 < if
    true return
  end
  state [] .compiledOps src .opIndex list.at .data =:: srcOp
  srcOp [] .val .Constant ?? ! if
    true return
  end
  ## TODO? completely merge with interpreter.castConstant
  ## casting between integer constants
  target typeContext types.isNumber and src .value .Int ?? or src .value .Float ??  if
    src .valueType signType src .value target typeContext interpreter.castConstant srcOp .val .Constant=
    target srcOp .dataType=
    false return
  end
  src .valueType types.isLiteral if
    src .valueType signType src .value target typeContext interpreter.castConstant srcOp .val .Constant=
    target srcOp .dataType=
    false return
  end
  true return
end
proc(
  Type slice : types
  string : name
  ## number of values already popped by instruction
  i32 : stackCastOffset0
  FilePosition : pos
  TypeCheckState ptr.mut : state
-> bool ) =>: requireTypes
  state [] .program .errors =:: errors
  state [] .program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  types .length i32 list.create =:: mut: argOffsets
  stackCastOffset0 =:: mut: stackCastOffset
  1:iSize while $ types .length u<= do =:: i
    types types .length i - [] =:: expectedType
    state [] .stack branchTree.depth 0 <= if
      expectedType .empty ?? if
        i 1:iSize + continue ## skip empty arguments if no values on stack
      end
      "not enough types for " sb.copyPtr
        name sb.appendStr
      pos errors appendError
      true return
    end
    state .stack branchTree.peek .data =:: peekedInfo
    peekedInfo [] .valueType .empty ?? and expectedType .empty ?? ! if
      state .stack branchTree.pop ..drop ## discard empty value
      i continue ## no not increment index
    end
    ## append dummy value for argument offset
    argOffsets
      OP_UNLINKED list.append
    argOffsets=
    expectedType .empty ?? and peekedInfo [] .valueType .empty ?? ! if
      stackCastOffset 1 - stackCastOffset= ## update cast offset
      i 1:iSize + continue ## skip empty if stack value not empty
    end
    state .stack branchTree.pop .data [] =:: typeInfo
    ## set argument offset to correct value
    typeInfo .opIndex argOffsets list.peek .data =[]
    typeInfo .valueType expectedType types.typeEquals if
      i 1:iSize + continue
    end
    ## canAutoCast
      typeInfo .valueType
      expectedType
    typeContext types.canAutoCast if
      typeInfo expectedType SignType .NONE pos state tryCastConstant ! if
        i 1:iSize + continue
      end
      ## opAutoCast
        typeInfo .valueType
        i 1:iSize - i32 cast stackCastOffset +
        expectedType
        pos
      opAutoCast state appendOp =:: opId
      typeInfo .opIndex 0 < if
        ## no index update necessary
        i 1:iSize + continue
      end
      opId argOffsets list.peek .data =[]
      i 1:iSize + continue
    end
    "wrong type for " sb.copyPtr
      name sb.appendStr
      " expected " sb.appendS
      expectedType typeContext sb.appendType
      " got " sb.appendS
      typeInfo .valueType typeContext sb.appendType
    pos errors appendError
    i 1:iSize +
  end ..drop
  argOffsets list.free ..drop
  false return
end
proc( i32 : count FilePosition : pos TypeCheckState ptr.mut : state -> ) =>: discardValues
  state [] .program =:: program
  state [] .program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  count pos state checkStackSize if return end
  0 =:: mut: toDrop
  0:i32 while ..dup count < do
    state .stack branchTree.pop .data =:: typeInfo
    typeInfo [] .valueType typeContext types.isEmpty if
      1 + continue
    end
    typeInfo [] .opIndex state tryDeleteOp if
      toDrop 1 + toDrop=
    end
    1 +
  end ..drop
  state removeTrailingNOPs
  toDrop 0 > if
    toDrop StackModType .DROP pos opStackMod state appendOp ..drop
  end
end

proc( FilePosition : pos TypeCheckState ptr.mut : state -> Type ) =>: popType
  state [] .program =:: program
  state [] .program .errors =:: errors
  state [] .program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  1 pos state checkStackSize if Type .undefined return end
  state .stack branchTree.peek .data =:: typeInfo
  typeInfo [] .valueType =:: valType
  valType typeContext types.isType ! if
    "expected type got " sb.copyPtr
      valType typeContext sb.appendType
    pos errors appendError
    Type .undefined return
  end
  typeInfo [] .value .TypeId ?? ! if
    "expected type-constant got " sb.copyPtr
      typeInfo [] .value typeContext sb.appendConstant
    pos errors appendError
    Type .undefined return
  end
  typeInfo [] .opIndex state currentBlockStart < if
    "type-constant " sb.copyPtr
      typeInfo [] .value typeContext sb.appendConstant
      " at " sb.appendS
      typeInfo [] .pushedAt sb.appendPos
      " was declared outside current block" sb.appendS
    pos errors appendError
    Type .undefined return
  end
  typeInfo [] .value .TypeId =:: typeId
    state .stack branchTree.pop ..drop ## drop value
    typeInfo [] .opIndex state deleteOp ## remove stored operation
  typeId return
end
proc( FilePosition : pos TypeCheckState ptr.mut : state -> string ) =>: popString
  state [] .program =:: program
  state [] .program .errors =:: errors
  state [] .program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  1 pos state checkStackSize if string.empty return end
  state .stack branchTree.peek .data =:: typeInfo
  ## XXX? allow Array: { string, i64 } as string constant
  typeInfo [] .value .Array8 ?? ! if
    "expected string-constant got " sb.copyPtr
      typeInfo [] .value typeContext sb.appendConstant
    pos errors appendError
    string.empty return
  end
  typeInfo [] .opIndex state currentBlockStart < if
    "string-constant " sb.copyPtr
      typeInfo [] .value typeContext sb.appendConstant
      " at " sb.appendS
      typeInfo [] .pushedAt sb.appendPos
      " was declared outside current block" sb.appendS
    pos errors appendError
    string.empty return
  end
  typeInfo [] .value .Array8 string.fromBytes =:: stringValue
    state .stack branchTree.pop ..drop ## drop value
    typeInfo [] .opIndex state deleteOp ## remove stored operation
  stringValue return
end

proc(
  ConstValue : value
  Type : valType
  FilePosition : pos
  TypeCheckState ptr.mut : state
-> ) =>: pushConstant
    state [] .program =:: program
    program .idContext =:: idContext
    idContext .typeContext =:: typeContext
    valType typeContext types.isEmpty if
      OP_EMPTY
    else
      state [] .compiledOps .length i32 cast.u
    end =:: opIndex
    ## branchTree.push
      state .stack
      ## TypeInfo
        valType
        value
        pos
        opIndex
      TypeInfo new
    branchTree.push
    opIndex 0 < if
      return
    end
    state [] .compiledOps
      value valType pos opConst list.append
    state .compiledOps=
end
proc(
  Type : valType
  ConstValue : value
  Operation : op
  TypeCheckState ptr.mut : state
-> ) =>: pushValue
    state [] .program =:: program
    program .idContext =:: idContext
    idContext .typeContext =:: typeContext
    valType typeContext types.isEmpty if
      OP_EMPTY
    else
      state [] .compiledOps .length i32 cast.u
    end =:: opIndex
    ## branchTree.push
      state .stack
      ## TypeInfo
        valType
        value
        op .pos
        opIndex
      TypeInfo new
    branchTree.push
    opIndex 0 < if
      return
    end
    state [] .compiledOps
      op list.append
    state .compiledOps=
end
proc(
  Type slice : types
  FilePosition : pos
  TypeCheckState ptr.mut : state
-> ) =>: pushTypes
  state [] .program .idContext .typeContext =:: typeContext
  types for =:: t
    state .stack
      ## TypeInfo
        t
        ConstValue .None
        pos
        ## multiple types from one op -> cannot modify op to modify types
        OP_UNLINKED
      TypeInfo new
    branchTree.push
  end
end
proc( LabelId : label TypeCheckState ptr.mut : state -> ) =>: replaceLabel
  state .stack branchTree.pop .data [] =:: mut: top
  state .stack top branchTree.push
end

proc(
  BlockInfo : blockInfo
  TypeCheckState ptr.mut : state
-> ) =>: openBlock
  state [] .openBlocks
    blockInfo list.append
  state .openBlocks=
end

proc(
  TypeCheckState ptr.mut : state
-> BlockInfo ptr.mut optional ) =>: peekBlock
  state [] .openBlocks list.peek
end
proc(
  FilePosition : pos
  TypeCheckState ptr.mut : state
-> BlockInfo ) =>: closeBlock
  state [] .program .errors =:: errors
  state [] .openBlocks .length 0:iSize == if ## XXX? check for underflow wrt. reset-state
    BlockInfo .Unknown return
  end
  state [] .openBlocks .length 1:iSize - =:: newLength
  state [] .openBlocks newLength list.at .data [] =:: closed
  state [] .openBlocks
    newLength list.setLength
  state .openBlocks=
  closed return
end
proc( TypeCheckState ptr : state -> bool ) =>: inSwitchLabel
  state [] .openBlocks .length 0:iSize == if
    false return
  end
  state [] .openBlocks list.peek .data [] .Switch ?? ! if
    false return
  end
  state [] .openBlocks list.peek .data [] .Switch .inLabel return
end
proc(
  BlockType : breakType
  LabelId : blockLabel
  FilePosition : pos
  TypeCheckState ptr.mut : state
-> BlockInfo ptr.mut optional ) =>: findBreakableBlock
  state [] .program =:: program
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  program .errors =:: errors
  state [] .openBlocks list.atReversed for =:: block
    block [] .While ?? and blockLabel id.LABEL_ID_NONE == or
        block [] .While .blockLabel blockLabel labelContext id.labelNamesEq if
      block optional.wrap return
    end
    breakType .BREAK ?? and block [] .Switch ?? and
        blockLabel id.LABEL_ID_NONE == or
        block [] .Switch .blockLabel blockLabel labelContext id.labelNamesEq if
      block optional.wrap return
    end
  end
  60 sb.create
    breakType sb.appendBlockType
    " can only appear in loops " sb.appendS
    breakType .BREAK ?? if
      "and switch-case statements" sb.appendS
    end
  pos errors appendError
  BlockInfo ptr.mut optional.empty return
end

## break from current switch-branch, but don't terminate the branch
proc(
  SwitchBlockInfo ptr.mut : switchBlock
  FilePosition : pos
  TypeCheckState ptr.mut : state
-> ) =>: breakSwitch
  state [] .stack branchTree.depth =:: caseTypes
  state .stack
    switchBlock [] .branchRoot
  branchTree.reset =:: caseBranch
  state [] .reachable if
    ## add space for casts of values on stack
    switchBlock [] .castOffsets
      ## reserveOps
        caseTypes
        pos
      state reserveOps list.append
    switchBlock .castOffsets=
    ## reset stack to start of if statement
    switchBlock [] .caseBranches
      ## BranchPoint
        caseBranch
        pos
      BranchPoint new list.append
    switchBlock .caseBranches=
  end
  BlockType .BREAK_SWITCH pos opBlock =:: mut: breakOp
  switchBlock [] .blockId breakOp@ .val .block .blockId=
  switchBlock [] .breakPositions
    state [] .compiledOps .length i32 cast.u list.append
  switchBlock .breakPositions=
  breakOp state appendOp ..drop
  false state .reachable=
  state [] .openBlocks list.peek .data [] .Switch ?? if
    switchBlock [] .inLabel ! if
      state [] .program .idContext id.closeScope ! "closing case-scope worked" assert
    end
    true switchBlock .inLabel=
  end
end
## terminate current switch branch
proc( FilePosition : pos TypeCheckState ptr.mut : state -> ) =>: endSwitchBranch
  state peekBlock =:: currentBlock?
  currentBlock? optional.hasData and
      currentBlock? .data =:: currentBlock
      currentBlock [] .Switch ?? and
      currentBlock? .data .Switch =:: switchBlock
      switchBlock [] .inLabel ! if
    switchBlock pos state breakSwitch
  end
end


proc(
  bool : clearConst
  i32 : offset
  FilePosition : pos
  TypeCheckState ptr.mut : state
-> ) =>: clearReferences ## TODO? is clearing references necessary for non-loop blocks
  state [] .program .idContext .typeContext =:: typeContext
  ## list.create
    state [] .stack branchTree.depth
  TypeInfo list.create =:: mut: stackElements
  while state .stack branchTree.pop =:: next?
      next? optional.hasData do
    stackElements
      next? .data list.appendP
    stackElements=
  end
  while stackElements .length 0:iSize u> do
    stackElements
      list.pop =:: mut: elt
    stackElements=
    clearConst if
      ConstValue .None elt@ .value=
      elt .valueType types.isLiteral if
        elt .valueType
          typeContext types.literalToType
        elt@ .valueType=
      end
    end
    OP_UNLINKED elt@ .opIndex= ## TODO! is this line necessary
    state .stack
      elt
    branchTree.push
  end
  stackElements list.free stackElements=
end

enum( MERGE MERGE_ROOT NO_CAST ) =:: MergeType
struct(
  string : blockName
  FilePosition : mergePoint
  i32 slice : castPointOffsets
  TypeCheckState ptr.mut : state
  i32 : rootBranch
  MergeType : mergeType
) =:: MergePoint
proc(
  TypeInfo ptr slice : toMerge
  i32 : offset
  MergePoint : mergePoint
-> TypeInfo ) =>: mergeBranches
  mergePoint .state [] .program =:: program
  program .errors =:: errors
  program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  toMerge .length 1:iSize == if
    toMerge 0 [] [] return
  end
  toMerge mergePoint .rootBranch [] =:: root
  root [] .valueType =:: mut: mergedType
  mergedType types.isLiteral if
    mergePoint .mergeType switch
      MERGE case break
      MERGE_ROOT NO_CAST case
        mergedType typeContext types.literalToType mergedType=
      break
    end
  end
  true =:: mut: noError
  0:i32 while $ iSize cast.u toMerge .length u< do =:: i
    i mergePoint .rootBranch == if
      i 1 + continue
    end
    toMerge i [] =:: current
    current [] .valueType
      $ types.isLiteral and mergePoint .mergeType .NO_CAST ?? if
        typeContext types.literalToType
      end
    =:: currentType
    mergePoint .mergeType switch
      MERGE case
        currentType mergedType typeContext types.mergeTypes $ ? if
          .data mergedType=
        else ..drop
          "cannot merge the branches of " sb.copyPtr
            mergePoint .blockName sb.appendStr
            "\n cannot merge types " sb.appendS
            mergedType typeContext sb.appendType
            " ( pushed at " sb.appendS
            root [] .pushedAt sb.appendPos
            " )\n and " sb.appendS
            currentType typeContext sb.appendType
            " ( pushed at " sb.appendS
            current [] .pushedAt sb.appendPos
            " )\n" sb.appendS
          mergePoint .mergePoint errors appendError
          false noError=
        end
        break
      MERGE_ROOT NO_CAST case
        currentType mergedType
          mergePoint .mergeType .NO_CAST ?? if
            types.typeEquals !
          else
            typeContext types.canAutoCast !
          end
        if
          "cannot merge the branches of " sb.copyPtr
            mergePoint .blockName sb.appendStr
            "\n expected: " sb.appendS
            mergedType typeContext sb.appendType
            " ( pushed at " sb.appendS
            root [] .pushedAt sb.appendPos
            " )\n got: " sb.appendS
            currentType typeContext sb.appendType
            " ( pushed at " sb.appendS
            current [] .pushedAt sb.appendPos
            " )\n" sb.appendS
          mergePoint .mergePoint errors appendError
          false noError=
        end
      break
    end
    i 1 +
  end ..drop
  noError if ## don't try casting values if merging types failed
    0:i32 while $ iSize cast.u toMerge .length u< do =:: i
      toMerge i [] =:: current
        current [] .valueType
          $ types.isLiteral if typeContext types.literalToType end
        =:: currentType
        currentType mergedType types.typeEquals ! and current [] .valueType  mergedType types.typeEquals ! if
          mergePoint .castPointOffsets i [] =:: castRoot
          castRoot 0 >= if
            mergePoint .state [] .compiledOps castRoot offset + list.at .data =:: castPoint
            castPoint [] .val .NOP ?? and castPoint [] .val .NOP .RESERVED ?? if
              ## opAutoCast
                currentType
                offset i32 cast
                mergedType
                mergePoint .mergePoint
              opAutoCast castPoint =[]
              i 1 + continue
            end
            "operation is not a NO-OP: " sb.copyPtr
              castPoint [] program sb.appendOp
            mergePoint .mergePoint errors appendError
          end
          "cannot cast " sb.copyPtr
            offset sb.appendI
            "th value in " sb.appendS
            i sb.appendI
            "th branch" sb.appendS
          mergePoint .mergePoint errors appendError
        end
      i 1 +
    end ..drop
  end
  ## TypeInfo
    mergedType
    ConstValue .None ## XXX merge constants
    mergePoint .mergePoint
    OP_UNLINKED
  TypeInfo new return
end

proc(
  Operation : op
  TypeCheckState ptr.mut : state
-> i32 #+opIndex+# ) =>: appendOp
  state [] .program =:: program
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  op .dataType typeContext types.isEmpty if
    OP_EMPTY return
  end
  state [] .compiledOps .length i32 cast.u =:: index
  state [] .compiledOps
    op list.append
  state .compiledOps=
  index return
end
## reserve space for count operations at the current position, returns the position of the first operation
proc(
  i32 : count
  FilePosition : pos
  TypeCheckState ptr.mut : state
-> i32 ) =>: reserveOps
  state [] .compiledOps .length i32 cast.u =:: offset
  state [] .compiledOps
    offset count + list.ensureCap
    offset count + list.setLength
  state .compiledOps=
  ## mem.fill
    state [] .compiledOps .data offset @[]
    count iSize cast.u
    pos reserveOp
  mem.fill
  offset return
end
proc( TypeCheckState ptr.mut : state -> ) =>: wrapCopy
  state [] .program =:: program
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  state .stack branchTree.pop .data [] =:: mut: topValue
  topValue .valueType typeContext types.isEmpty if
    state .stack topValue branchTree.push
    return
  end
  state [] .compiledOps .length i32 cast.u =:: index
  state [] .compiledOps
    topValue .valueType topValue .pushedAt opCopy list.append
  state .compiledOps=
  index topValue@ .opIndex=
  state .stack topValue branchTree.push
end

proc(
  i32 : index
  TypeCheckState ptr.mut : state
-> bool ) =>: canDeleteOp
  index state currentBlockStart < if
    false return
  end
  state [] .compiledOps index list.at .data =:: op
  op [] .val .Constant ?? if
    true return
  end
  op [] .val .getId ?? if
      state [] .program .idContext =:: idContext
      op [] .val .getId .labelId =:: labelId
      labelId
        idContext .typeContext .labelContext id.labelFlags
      id.FLAG_MUTABLE & ? if
        false return
      end
      ## getIdentifier
        labelId
        idContext
      id.getIdentifier if ..drop
        false return
      end .constValue .None ?? ! return
  end
  false return
end
proc(
  i32 : opIndex
  TypeCheckState ptr.mut : state
-> bool ) =>: canCopyOp
  opIndex state canDeleteOp return
end
proc(
  i32 : index
  TypeCheckState ptr.mut : state
-> bool ) =>: tryDeleteOp
  index state canDeleteOp if
    index state deleteOp
    false return
  else
    true return
  end
end
proc( i32 : index TypeCheckState ptr.mut : state -> ) =>: deleteOp
  opValNOP state [] .compiledOps index list.at .data .val=
end
proc( i32 : index TypeCheckState ptr.mut : state -> i32 ) =>: copyOp
  state [] .compiledOps .length i32 cast.u =:: copyIndex
  state [] .compiledOps
    $ index [] list.append
  state .compiledOps=
  copyIndex return
end
proc(
  i32 : opIndex
  TypeCheckState ptr.mut : state
-> i32 bool ) =>: tryCopyOp
  opIndex state canCopyOp if
    opIndex state copyOp false return
  end
  0 true return
end
proc( TypeCheckState ptr.mut : state -> ) =>: removeTrailingNOPs
  state [] .compiledOps .length 1:iSize - while $ 0:iSize iSize.sge do =:: i
    state [] .compiledOps i list.at .data =:: op
    op [] .val .NOP ?? ! if
      i break
    end
    op [] .val .NOP .EMPTY ?? ! if
      i break
    end
    i 1:iSize -
  end 1:iSize + =:: offset
  state [] .compiledOps
    offset list.setLength
  state .compiledOps=
end
proc( TypeCheckState ptr.mut : state -> ) =>: clearOps
  0 state .blockStart=
  state [] .stateStack list.peek =:: prevState?
  prevState? optional.hasData if
    prevState? .data =:: prevState
    state [] .compiledOps
      prevState [] .compiledOpsOffset list.setLength
    state .compiledOps=
    return
  end
  state [] .compiledOps
    list.clear
  state .compiledOps=
end
proc( TypeCheckState ptr.mut : state -> ) =>: freeOps
  state [] .compiledOps
    list.free
  state .compiledOps=
end

proc(
  Operation ptr.mut : op
  bool : autoTyped
  TypeCheckState ptr.mut : state
-> ) =>: resolveAutoType
  state [] .program .errors =:: errors
  state [] .program .autoTypes =:: autoTypes
  state [] .program .idContext .typeContext =:: typeContext
  op [] .dataType .autoType ?? if
    op [] .dataType types.getAutoTypeId =:: id
    autoTyped if
      state .stack branchTree.peek =:: value?
      value? optional.hasData if
        value? .data [] .valueType
        $ types.isLiteral if
          typeContext types.literalToType
        end
      else
        "missing type for declaration" sb.copyPtr op [] .pos errors appendError
        return
      end
    else
      op [] .pos state popType
    end =:: valType
    valType op .dataType=
    id iSize cast.u autoTypes [] .length u>= if
      "auto-type id outside allowed range:" sb.copyPtr
        id sb.appendI
        " maximum:" sb.appendS
        autoTypes [] .length 1:iSize - sb.appendI
      op [] .pos errors appendError
    end
    ## XXX? check for redefinition of auto-type
    valType autoTypes [] id list.set
  end
end

proc(
  Operation ptr.mut : op
  TypeCheckState ptr.mut : state
-> ) =>: typeCheckReturn
  state [] .program =:: program
  state [] .program .errors =:: errors
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  state [] .currentProcType =:: procType
  procType op .dataType=
  procType typeContext types.isProcedure ! if
    "unexpected type for return: " sb.copyPtr
      procType typeContext sb.appendType
      " expected procedure" sb.appendS
    op [] .pos errors appendError
    return
  end
  procType typeContext types.getProcOut $ optional.hasData if .data else ..drop
    "could not resolve procedure return value" sb.copyPtr op [] .pos errors appendError
    return
  end =:: outTypes
  outTypes .length i32 cast.u =:: valCount
  valCount state [] .stack branchTree.depth < if
    "wrong number of return values at the end of procedure expected: " sb.copyPtr
      valCount      sb.appendI
      " got: " sb.appendS
      state [] .stack branchTree.depth sb.appendI
    op [] .pos errors appendError
    ## XXX report position of lowest stack value
    return
  end
  ## requireTypes
    outTypes
    "return statement":s
    0
    op [] .pos
  state requireTypes if
    return
  end
  op [] state appendOp ..drop
  false state .reachable=
  state [] .stack branchTree.depth 0 > if
    state .stack branchTree.pop .data =:: val
    "extra value at the end of procedure" sb.copyPtr
       val [] .valueType typeContext sb.appendType
       " ( pushed at " sb.appendS
       val [] .pushedAt sb.appendPos
       " )" sb.appendS
    op [] .pos errors appendError
  end
end
proc(
  Type : srcType
  Type : containerType
  i32 : elementIndex
  bool : isWrite
  bool : isPtr
  bool : mutable
  FilePosition : pos
  TypeCheckState ptr.mut : state
-> ) =>: typeCheckGetElement
  state [] .program =:: program
  state [] .program .errors =:: errors
  state [] .program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  OP_UNLINKED =:: mut: onRead
  isWrite ! and containerType typeContext types.isTaggedUnion if
    containerType elementIndex pos opCheckEnum state appendOp onRead=
    true program .hasCheckEnum=
  end
  containerType typeContext types.isArray if
    containerType typeContext types.getBaseType
  else
    containerType elementIndex typeContext types.compositeGetElement
  end =:: eltType
  ## can only take address of reference or pointer
  isPtr and isWrite ! if
    eltType mutable typeContext types.getAddressType
  else
    eltType
  end =:: targetType
  isWrite if
    isPtr and mutable ! if ## TODO more detailed message (? print ptr-type & label name if existent)
      "cannot write to element of immutable pointer" sb.copyPtr
      pos errors appendError
    end
    targetType typeContext types.isEmpty and
        containerType typeContext types.isTaggedUnion ! if
      ## discard container and argument from stack
      2 pos state discardValues
      return
    end
    ## XXX? when writing empty value to union, elementIndex still needs to be changed
    Type 2 array : args
    targetType args@ 0 =[]
    srcType args@ 1 =[]
    ## requireTypes
      args@ slice.wrap
      "element write":s
      0
      pos
    state requireTypes  if
      return
    end
    ## opSetElement
      srcType
      elementIndex
      pos
    containerType typeContext types.isTaggedUnion if
      opSetEnumElement
    else
      opSetElement
    end =:: newOp
    isPtr if
      newOp state appendOp ..drop
    else
      ## pushValue
        srcType
        ConstValue .None ## XXX? update constant
        newOp
      state pushValue
    end
    return
  end
  eltType typeContext types.isEmpty =:: emptyValue
  emptyValue if ## empty or pointer to empty
    ## discard container from stack and operations
    1 pos state discardValues
  else
    ## remove container from stack
    state .stack branchTree.pop ..drop
  end
  state [] .compiledOps list.peek =:: prevOp?
  prevOp? optional.hasData and
      prevOp? .data .val .copy ??
  end =:: directCopy ## operation before get element is copy
  directCopy if
    state [] .compiledOps
      $ .length 1:iSize - list.setLength
    state .compiledOps=
  end
  emptyValue and isPtr if
    ## pushConstant
      0 ConstValue .Int
      targetType
      pos
    state pushConstant
    return
  end
  ## pushValue
    targetType
    ConstValue .None ## XXX compute constant value
    srcType
      elementIndex
      pos
    opGetElement
  state pushValue
  state .stack branchTree.pop .data [] =:: mut: topValue
  ## XXX? is pop then push neccessary
  state .stack topValue branchTree.push
  targetType typeContext types.isEmpty if
    return
  end
  directCopy if
    ## removed copy is operation directly before get element
    ## -> have to reinsert copy after getting element
    state wrapCopy
  else
    state .stack branchTree.pop .data [] topValue=
    state .stack topValue branchTree.push
  end
end

proc(
  BlockId : switchId
  i32 : switchPosition
  ConstValue : label0
  FilePosition : pos
  TypeCheckState ptr.mut : state
-> ) =>: newSwitchLabel
  state [] .program =:: program
  state [] .program .errors =:: errors
  state [] .program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  program [] .switchData
    switchId i64 cast.u list.at .data
  =:: switchData
  label0
    $ .Int ?? and ## truncate constant to correct number of bits (switch-lables are treated as unsigned numbers)
        switchData [] .switchType =:: switchType
        switchType typeContext types.isIntOrChar and
        switchType typeContext types.sizeOf .fixed ?? and
        switchType typeContext types.sizeOf .fixed =:: size
        size 8 < if
      .Int 1:i64 size 8 * << 1 - & ConstValue .Int
    end
  =:: label
  switchData [] .labels list.atItr for =:: labelData
    ## constantEquals
      labelData [] .value
      label
    constantEquals if
      "duplicate label " sb.copyPtr
        switchData [] .switchType typeContext types.isTaggedUnion if
          ## appendLabelName
            switchData [] .switchType
            label .EnumLabel typeContext types.compositeGetLabel
            labelContext
          sb.appendLabelName
        else
          label0 typeContext sb.appendConstant
        end
        " in switch-case ( previous occurence at " sb.appendS
        labelData [] .pos sb.appendPos
        " )" sb.appendS
      pos errors appendError
    end
  end
  switchData [] .labels
    ## LabelData
      label
      pos
      switchData [] .caseCount
    LabelData new list.append
  switchData .labels=
end
proc(
  Operation ptr : op
  TypeCheckState ptr.mut : state
-> bool #+consume op+# ) =>: typeCheckSwitchLabel
  ## TODO? enable const-evalution in switch-labels
  state [] .program =:: program
  state [] .program .errors =:: errors
  state [] .program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  state peekBlock .data .Switch =:: switchBlock
  switchBlock [] .switchType =:: switchType
  switchBlock [] .blockId =:: switchId
  switchBlock [] .switchPosition =:: switchPosition
  op [] .val .block ?? if
    op [] .val .block .blockType switch
      CASE DOT_CASE DEFAULT case
        false return
      BREAK case
        switchBlock [] .allowBreak if
          false switchBlock .allowBreak=
          true return
        end
        break
      default
        break
    end
  else op [] .val .blockEnd ?? _if
    false return
  end
  ## operation after switch -> don't allow break statement
  false switchBlock .allowBreak=
  switchType typeContext types.isTaggedUnion ! if
    ## TODO? allow use of Interpreter in switch labels
    op [] .val .Constant ?? if
      ## newSwitchLabel
        switchId
        switchPosition
        op [] .val .Constant
        op [] .pos
      state newSwitchLabel
    else op [] .val .getId ?? or op [] .val .getName ?? _if
      LabelId : label
      op [] .val .getName ?? if
        ## findIdentifierByLabel
          op [] .val .getName
          idContext
        id.findIdentifierByLabel if ..drop
          "could not find " sb.copyPtr
            op [] .val .getName labelContext sb.appendLabelName
          op [] .pos errors appendError
          true return
        end
      else ## XXX? is this branch reachable
        ## getIdentifier
          op [] .val .getId .labelId
          idContext
        id.getIdentifier if ..drop
          "could not find " sb.copyPtr
            op [] .val .getId labelContext sb.appendIdInfo
          op [] .pos errors appendError
          true return
        end
      end =:: idData
      idData [] .constValue .None ?? if
        "expected constant got " sb.copyPtr
          idData id.asIdInfo labelContext sb.appendIdInfo
        op [] .pos errors appendError
        true return
      end
      ## newSwitchLabel
        switchId
        switchPosition
        idData [] .constValue
        op [] .pos
      state newSwitchLabel
    else
      "unsupported operation in switch label:\n " sb.copyPtr
        op [] program sb.appendOp
      op [] .pos errors appendError
      true return
    end
    true return
  end
  ## enum-switch -> try read label
  op [] .val .getId ?? if
    op [] .val .getId .labelId
  else op [] .val .getName ?? _if
    op [] .val .getName
  else op [] .val .Constant ?? and
      op [] .val .Constant =:: constVal
      constVal .TypeId ?? and
      constVal .TypeId types.isNamedType _if
    constVal .TypeId typeContext types.namedTypeName
  else
    "unsupported operation for switch label of type " sb.copyPtr
      switchType typeContext sb.appendType
      " : " sb.appendS
      op [] program sb.appendOp
      " expected identifier" sb.appendS
    op [] .pos errors appendError
    true return
  end =:: labelId
  ## compositeFindLabel
    switchType
    labelId
  typeContext types.compositeFindLabel $ optional.hasData if .data else ..drop
    "enum " sb.copyPtr
      switchType typeContext sb.appendType
      " does not have a label " sb.appendS
      labelId labelContext sb.appendLabelName
    op [] .pos errors appendError
    true return
  end =:: labelIndex
  ## newSwitchLabel
    switchId
    switchPosition
    ## ConstValue
      labelIndex
    ConstValue .EnumLabel
    op [] .pos
  state newSwitchLabel
  true return
end

proc( i32 : blockStart ProgramContext ptr.mut : program -> BlockId ) =>: createIfData
  program [] .ifData .length =:: oldLength
    program [] .ifData
      ## IfData
        blockStart
        0:i32
        0:i32
        i32 slice.emptyMutable
        i32 slice.emptyMutable
        0:i32
        0:i32
      IfData new list.append
    program .ifData=
  oldLength BlockId cast
end
proc( i32 : blockStart ProgramContext ptr.mut : program -> BlockId ) =>: createAndOrData
  program [] .andOrData .length =:: oldLength
    program [] .andOrData
      ## AndOrData
        blockStart
        i32 slice.emptyMutable
        0:i32
      AndOrData new list.append
    program .andOrData=
  oldLength BlockId cast
end

proc(
  LabelId : label
  Operation ptr.mut : op
  TypeCheckState ptr.mut : state
-> IdentifierInfo optional ) =>: resolveIdentifer
  state [] .program =:: program
  state [] .program .idContext =:: idContext
  idContext .typeContext .labelContext =:: labelContext
  label idContext id.findIdentifierByLabel if
    ..drop IdentifierInfo optional.empty return
  end =:: idData
  idData [] .valueType op .dataType=
  idData id.asIdInfo optional.wrap return
end
proc(
  Operation : op0
  TypeCheckState ptr.mut : state
-> ) =>: typeCheckOp
  op0 =:: mut: op
  state [] .program =:: program
  state [] .program .errors =:: errors
  state [] .program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  op .dataType .autoType ?? if ## try resolving auto-types
    op .dataType types.getAutoTypeId =:: id
    id iSize cast.u program [] .autoTypes .length u< if
      program [] .autoTypes id [] =:: autoType
      autoType .undefined ?? ! if
        autoType op@ .dataType=
      end
    end
  end
  state .skippedBlocks [] .length 0:iSize u> and
      op .val .block ?? ! and op .val .blockEnd ?? ! if
    return ## ignore non-block ops in skipped block
  end
  state inSwitchLabel and op@ state typeCheckSwitchLabel if
    return
  end
  ## resolve names
  op .val .getName ?? if
    op .val .getName
      op@ state resolveIdentifer
    ..dup optional.hasData if
      .data op@ .val .getId=
    else ..drop end
  else op .val .setName ?? _if
    op .val .setName
      op@ state resolveIdentifer
    ..dup optional.hasData if
      .data op@ .val .setId=
    else ..drop end
  else op .val .atName ?? _if
    op .val .atName
      op@ state resolveIdentifer
    ..dup optional.hasData if
      .data op@ .val .atId=
    else ..drop end
  else op .val .existsName ?? _if
    op .val .existsName
      op@ state resolveIdentifer
    optional.hasData if
      true ConstValue .Bool op@ .val .StaticConstant=
    else
      false ConstValue .Bool op@ .val .StaticConstant=
    end
    types.primitive.BOOL op@ .dataType=
  else op .val .declareName ?? or op .val .initializeName ?? _if
    op .val .initializeName ?? =:: isInit
    isInit if
      op@ op .val .initializeName .initType .AUTO ?? state resolveAutoType
      op .val .initializeName .label
    else
      op .val .declareName
    end
      op .dataType $ .undefined ?? if ..drop
        op .pos state popType
        $ op@ .dataType=
      end
      IdentifierType .LOCAL_VAR
      -1 ## index
      ConstValue .None
      isInit
      op .pos
      state [] .currentFile
      idContext
      errors
    id.declareIdentifier if ..drop.2
      ## error message is created by declareIdentifier
      return
    end =:: idData ..drop
    op .dataType idData@ id.asIdInfo op .pos
    isInit ! if
      opDeclareId
    else op .val .initializeName .initType .AUTO ?? _if
      opAutoTypedInitializeId
    else
      opInitializeId
    end op=
  end
  ## convert static arguments to constants
  op .val .getId ?? and state .interpreter interpreter.inEnum ! and
      op .val .getId .labelId =:: label
      label labelContext id.labelFlags id.FLAG_STATIC & ? and
      state .argData label map.at =:: argData?
      argData? optional.hasData if
    argData? .data [] .valType op@ .dataType=
    argData? .data [] .value op@ .val .Constant=
  end
  state [] .inTypeBlock and op@ state interpretTypeBlock if
    return ## evaluate constants
  end
  op .val switch
    NOP case return
    Constant case
      op .val .Constant op .dataType op .pos state pushConstant
      return
    StaticConstant case ## TODO? remove static constants
      op .val .StaticConstant op .dataType op .pos state pushConstant
      return
    NestedProc case
      op .val .NestedProc =:: procId
      program [] .procedures procId i64 cast list.at .data =:: procData
      procData [] .procType .undefined ?? ! or
          procData .implementation [] .code ?? ! or
          procData .implementation .code [] .codeState .PARSING ?? ! if
        "unexpected state for nested procedure" sb.copyPtr
        op .pos errors appendError
        return
      end
       ## ensure lambda is type-checked
      state [] .missingProcs
        ## MissingProc
          ## ProcedureImpl
            -1
            procId
          ProcedureImpl new
          op .pos
        MissingProc new list.append
      state .missingProcs=
      op .pos state popType =:: procType
      procType procData .procType=
      idContext id.currentScope procData .scopeId= ## remember host scope
      ProcCodeState .PARSED procData .implementation .code .codeState=
      procId ConstValue .Procedure
        procType false typeContext types.getAddressType
      op .pos state pushConstant
      return
    getName setName atName case
      "could not find identifier: " sb.copyPtr
        op .val .getName ?? if
          op .val .getName
        else op .val .setName ?? _if
          op .val .setName
        else
          op .val .atName
        end labelContext sb.appendLabelPath
      op .pos errors appendError
      return
    initializeName declareName case ..unreachable
    usingNamespace case
      op .val .usingNamespace .src =:: namespaceLabel
      op .val .usingNamespace .alias
        $ id.LABEL_ID_NONE == if ..drop
          string.empty
        else
          labelContext id.getLabelName
        end
      =:: aliasName
      namespaceLabel aliasName idContext id.importNamespace if
        "namespace \"" sb.copyPtr
          namespaceLabel labelContext sb.appendLabelName
        "\" does not exist in the current scope" sb.appendS op .pos errors appendWarning
      end
      return
    usingIdentifier case
      op .val .usingIdentifier .src =:: srcLabel
      op .val .usingIdentifier .alias
        $ id.LABEL_ID_NONE == if ..drop
          string.empty
        else
          labelContext id.getLabelName
        end
      =:: aliasName
      srcLabel labelContext id.getLabelName
        aliasName
        idContext
        op .pos
      errors id.importIdentifier ..drop
      return
    getId case
      op .val .getId =:: idInfo
      idInfo .labelId labelContext id.labelFlags =:: flags
      flags id.FLAG_MUTABLE & ? =:: mutable
      flags id.FLAG_STATIC & ? =:: isStatic
      mutable and isStatic ! if
        ConstValue .None
      else
        idInfo .idType switch
          TYPE PROCEDURE PROCEDURE_BUNDLE GLOBAL_VAR LOCAL_VAR case
            true break ## can hold identifer
          ARGUMENT LABEL TMP_VAR ITR_VAR case
            false break
        end if
          ## getIdentifierByLabel
            idInfo .labelId
            idContext
          id.getIdentifier if ..drop
            "could not find " sb.copyPtr
              idInfo labelContext sb.appendIdInfo
            op .pos errors appendError
            return
          end =:: idData
          idData [] .constValue
        else
          ConstValue .None
        end
      end =:: constValue
      idInfo .idType switch
        GLOBAL_VAR LOCAL_VAR TMP_VAR ITR_VAR case
          op .val .getId .labelId =:: labelId
          mutable ! and constValue .None ?? ! and idInfo .idType .GLOBAL_VAR ?? if
            ## replace access to immutable global variable with constant
            constValue op .dataType op .pos opConst op=
          end
          ## pushValue
            op .dataType
            constValue
            op
          state pushValue
          labelId state replaceLabel
          mutable if ## insert copy for mutable values
            state wrapCopy
          end
          return
        TYPE case
          op .dataType constValue op state pushValue
          op .val .getId .labelId state replaceLabel
          return
        ARGUMENT case
          op .val .getId .labelId =:: label
          ConstValue .None =:: mut: argValue
          state .argData label map.at =:: argData?
          argData? optional.hasData if
            argData? .data [] .valType op@ .dataType=
            argData? .data [] .value argValue=
          end
          op .dataType argValue op state pushValue
          label state replaceLabel
          return
        PROCEDURE PROCEDURE_BUNDLE case
          idInfo .idType .PROCEDURE ?? if
            constValue@ .Procedure =:: procId
            program [] .procedures
              procId [] i64 cast list.at .data
            =:: procData
            procId slice.wrap
          else  ## PROCEDURE_BUNDLE
            constValue .ProcedureBundle =:: bundleId
            program [] .procBundles
              bundleId i64 cast list.at .data [] .procedures
            list.asSlice
          end =:: procedures
          0:i32 =:: mut: stackConstants
          true =:: mut: headConstant
          ## TODO do not recreate list for each call
          state [] .stack branchTree.depth StackValue list.create =:: mut: stackValues
          state .stack branchTree.itr.start while
            branchTree.itr.hasNext do branchTree.itr.next =:: val ## don't consume value
            ## TODO? don't treat genericArg as constant
            headConstant and val [] .value .None ?? ! and val [] .value .GenericArg ?? !  if
              stackConstants 1 + stackConstants=
            else
              false headConstant=
            end
            stackValues
              ## StackValue
                val [] .valueType
                val [] .value
              StackValue new list.append
            stackValues=
          end ..drop
          0 sb.create =:: mut: message
          ## resolveCall
            procedures
            stackValues list.asSlice
            message@ optional.wrap
            op .pos
            state .interpreter
          resolveCall =:: calledType
            =:: calledProcId
          =:: calledProc?
          calledProc? optional.isEmpty if
            message op .pos errors appendError
            return
          else
            message .length 0:iSize u> if
              message op .pos errors appendInfo
            else
              message sb.free ..drop
            end
          end
          stackValues list.free ..drop
          calledProc? .data =:: calledProc
          program [] .procedures
            calledProc .procId i64 cast list.at .data
          =:: baseProcData
          calledType op@ .dataType=
          calledType typeContext types.getProcIn .data =:: inTypes
          inTypes .length i32 cast.u =:: argCount
          stackConstants argCount calledProc .autoArgs .length i32 cast - >= and
              program [] .procedures
                calledProcId i64 cast list.at .data
              [] .isStatic and state [] .mode .STATIC_PROC ?? ! or
              baseProcData .implementation [] .code ?? and
              baseProcData .implementation .code .codeState .TYPE_CHECKING ?? ! if
            calledType calledProc true op .pos state interpretCall ! if
              return
            end
          end
          baseProcData [] .implementation switch
            code case
              state [] .mode .LINEAR ?? ! if
                ## check if implementation exists if not add to list of missing imples
                baseProcData  .implementation .code =:: codeImpl
                calledProc .implementationId =:: implId
                implId -1:i32 == if
                  codeImpl [] .codeState .TYPE_CHECKED ?? !
                else
                  codeImpl [] .implementations
                    implId list.at .data
                  [] .codeState .TYPE_CHECKED ?? !
                end if
                  state [] .missingProcs
                    ## MissingProc
                      ## ProcedureImpl
                        implId
                        calledProc .procId
                      ProcedureImpl new
                      op .pos
                    MissingProc new list.append
                  state .missingProcs=
                end
              end
              calledProc program callInfoToCall op@ .val .call=
            break
            builtIn case
              baseProcData [] .implementation .builtIn .builtIn =:: builtInId
              builtInId .SYS_ARGC ?? or builtInId .SYS_ARGV ?? or builtInId .SYS_ENVP ?? if
                true program .hasGetArgs=
              else headConstant _if ## only constant arguments
                calledType calledProc false op .pos state interpretCall ! if
                  return
                end
              end
              builtInId OpValue .builtIn op@ .val=
            break
            alias case ..unreachable ## resolveCall unwraps alias
          end
          0 =:: mut: offset
          argCount 1 - while ..dup 0 >= do =:: i
            calledType i typeContext types.getProcArgLabel =:: eltLabel
            inTypes i [] =:: elt
            eltLabel labelContext id.labelFlags id.FLAG_STATIC & ? if
              ## remove static arguments from stack
              state .stack branchTree.pop .data =:: opData
              opData [] .opIndex state tryDeleteOp if
                "could not remove static argument ( pushed at " sb.copyPtr
                  opData [] .pushedAt sb.appendPos
                  " )" sb.appendS
                op .pos errors appendError
              end
            else ## next argument at top of stack
              elt .empty ?? and
                  state .stack branchTree.peek =:: head?
                  head? optional.hasData and head? .data .valueType .empty ?? ! if
                continue ## skip empty arguments with non-empty value
              end
              ## requireTypes
                elt@ slice.wrap
                "procedure argument":s
                offset
                op .pos
                state
              requireTypes if
                return
              end
              offset 1 + offset=
            end
          finally i 1 - end ..drop
          op state appendOp ..drop
          calledType typeContext types.getProcOut .data
            op .pos
            state
          pushTypes
          return
        LABEL case
          break
      end
      break
    callPtr case
      state .stack branchTree.peek =:: value?
      value? optional.isEmpty if
        ## TODO? print instruction name instead of 'call'
        "missing argument for call, expected procedure pointer" sb.copyPtr
        op .pos errors appendError
        return
      end
      value? .data [] .valueType =:: calledType
      calledType typeContext types.isCallable ! if
        "cannot call values of type " sb.copyPtr
          calledType typeContext sb.appendType
        op .pos errors appendError
        return
      end
      ## requireTypes
        calledType@ slice.wrap
        "procedure pointer":s
        0
        op .pos
        state
      requireTypes if return end
      calledType op@ .dataType=
      calledType typeContext types.isPointer if
        calledType typeContext types.getBaseType
      else
        calledType
      end =:: procType
      procType typeContext types.getProcIn .data =:: inTypes
      ## requireTypes
        inTypes
        "procedure argument":s
        1
        op .pos
        state
      requireTypes if return end
      op state appendOp ..drop
      procType typeContext types.getProcOut .data
        op .pos
        state
      pushTypes
      return
    atId case
      op .val .atId =:: idInfo
      idInfo .idType switch
        GLOBAL_VAR LOCAL_VAR TMP_VAR PROCEDURE ITR_VAR ARGUMENT case
          idInfo .labelId =:: labelId
          labelId
            labelContext id.labelFlags
          id.FLAG_MUTABLE & ? =:: mutable
          idInfo .idType .PROCEDURE ?? if
            ## getIdentifierByLabel
              idInfo .labelId
              idContext
            id.getIdentifier if ..drop
