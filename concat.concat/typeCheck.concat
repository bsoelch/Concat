          end
          state [] .reachable if
            state [] .stack @ branchTree.startBranch branches @ nBranches [] =
            elseCastOffset castOffsets @ nBranches [] =
            nBranches 1 + nBranches =
          end
          nBranches 1 >= if
            ## mergeValues
              state [] .stack @
              branches @ nBranches array.create
              mergeBranches @
              ## MergePoint
                "if-else block" string.wrap
                op .pos
                castOffsets @ nBranches array.create
                state
                0
                MergeType .MERGE
              MergePoint new
            branchTree.merge .error ?? if
              "different numbers of types at the end of " sb.wrap
                closed sb.appendBlockInfoName
                " block\n  * ifBranch: " sb.appendS
                state [] .stack
                  closed .If .ifBranch .node
                branchTree.depthFrom sb.appendI
                " at " sb.appendS
                closed .If .ifBranch .pos sb.appendPos
                "\n  * elseBranch: " sb.appendS
                state [] .stack
                  branches @ 1 []
                branchTree.depthFrom sb.appendI
              op .pos errors appendError
            end
          end
          closed .If .blockId op .val .blockEnd .blockId =
          op state appendOp ..drop
          ## cleanup closed block
          closed .If .andBranches list.free ..drop
          closed .If .orBranches list.free ..drop
          nBranches 0 > state [] .reachable =
          return
        IF case break ## end-if should not be created by parser
        CASE DEFAULT case
          ## break current branch
          op .pos state endSwitchBranch
          op .pos state closeBlock =:: closed
          closed .Switch ?? ! if
            "unexpected end of " sb.wrap
              closed sb.appendBlockInfoName
              "-block expected " sb.appendS
              SWITCH_BLOCK_INFO_NAME sb.appendS
              "-block" sb.appendS
            op .pos errors appendError
            return
          end
          ## XXX? check for stray labels
          closed .Switch @ =:: switchBlock
          switchBlock [] .caseBranches =:: mut: caseBranches
          op .val .blockEnd .blockType .CASE ?? if
            BlockType .DEFAULT op .pos opBlock =:: mut: tmp
            switchBlock [] .blockId tmp .val .block .blockId =
            tmp state appendOp ..drop
            switchBlock [] .switchType typeContext types.isTaggedUnion if
              switchBlock [] .switchType
                typeContext
              types.compositeEltCount =:: eltCount
              program [] .switchData
                switchBlock [] .blockId list.at .data
              =:: switchData
              switchData [] .labels =:: labels
              labels  .length eltCount < if
                "switch statement does not cover all labels in enum " sb.wrap
                  switchBlock [] .switchType
                    typeContext
                  sb.appendType
                  "\nmissing labels:\n" sb.appendS
                  0:i64 while ..dup eltCount < do =:: i
                    false =:: mut:  match
                    ## XXX? use array.find
                    0:i64 while ..dup labels .length < do =:: j
                      labels j list.get .value .enumLabel i == if
                        true match =
                        j break
                      end
                      j 1 +
                    end ..drop
                    match ! if
                      switchBlock [] .switchType
                        i
                        typeContext
                      types.compositeGetLabel =:: label
                      " - \"" sb.appendS
                      label labelContext sb.appendLabelName
                      "\" declaredAt" sb.appendS
                      label labelContext id.labelPos .data sb.appendPos
                      '\n' sb.appendC
                    end
                    i 1 +
                  end ..drop
                op .pos errors appendError
              end
              op .pos opUnreachable state appendOp ..drop
            else
              caseBranches
                ## BranchPoint
                  switchBlock [] .branchRoot
                  op .pos
                BranchPoint new list.append
              caseBranches =
            end
            BlockType .BREAK_SWITCH op .pos opBlock tmp =
            switchBlock [] .blockId tmp .val .block .blockId =
            tmp state appendOp ..drop
          end
          ## set stack head to one of the accepting branches
          caseBranches .length 1 >= if
            caseBranches .length =:: nodeCount
            nodeCount branchTree.NodeId list.create
              0:i64 while ..dup nodeCount < do =:: i
                caseBranches
                  i list.at .data
                [] .node list.append
                i 1 +
              end ..drop
            =:: branchPoints
            ## mergeValues
              state [] .stack @
              branchPoints list.asArray
              mergeBranches @
              ## MergePoint
                "switch-case block" string.wrap
                op .pos
                switchBlock [] .castOffsets list.asArray
                state
                0
                MergeType .MERGE
              MergePoint new
            branchTree.merge .error ?? if
              "different numbers of types at the end of switch-branches: " sb.wrap
                0:i64 while ..dup caseBranches .length < do =:: i
                  "\n  * " sb.appendS
                  caseBranches i list.at .data =:: branchPoint
                  state [] .stack
                     branchPoint [] .node
                  branchTree.depthFrom sb.appendI
                  " in branch at " sb.appendS
                    branchPoint [] .pos sb.appendPos
                  i 1 +
                end ..drop
                '\n' sb.appendC
              op .pos errors appendError
            end
            branchPoints list.free ..drop
          end
          caseBranches .length 0 > state [] .reachable =
          BlockType .SWITCH op .pos opEndBlock =:: mut: tmp
          switchBlock [] .blockId tmp .val .blockEnd .blockId =
          tmp state appendOp ..drop
          return
        SWITCH case ## end-switch should not be created by parser
          break
        FINALLY case
          op .pos state closeBlock =:: mut: closed
          closed .While ?? ! if
            "unexpected end of " sb.wrap
              closed sb.appendBlockInfoName
              "-block expected " sb.appendS
              WHILE_BLOCK_INFO_NAME sb.appendS
              "-block" sb.appendS
            op .pos errors appendError
            return
          end
          closed .While @ =:: whileBlock
          whileBlock [] .breakBranches =:: breakBranches
          ## XXX? avoid allocation if it si not neccessary
          breakBranches .length branchTree.NodeId list.create
            whileBlock [] .branchRoot .node list.append
            state [] .stack @ branchTree.startBranch list.append
          =:: mut: branchPoints
          i64 2 array new =:: mut: castOffsets
          OP_UNLINKED castOffsets @ 0 [] =
          ## reserveOps
            state [] .stack branchTree.depth
            op .pos
          state reserveOps castOffsets @ 1 [] =
          ## mergeValues
            state [] .stack @
            branchPoints list.asArray
            mergeBranches @
            ## MergePoint
              "while loop" string.wrap
              op .pos
              castOffsets @ 2 array.create
              state
              0
              MergeType .MERGE_ROOT
            MergePoint new
          branchTree.merge =:: depth
          depth .error ?? if
            "different numbers of types at beginning and end of while-block: " sb.wrap
              "\n  * " sb.appendS
              state [] .stack
                 whileBlock [] .branchRoot .node
              branchTree.depthFrom sb.appendI
              " in branch at " sb.appendS
              whileBlock [] .branchRoot .pos sb.appendPos
              "\n  * " sb.appendS
              state [] .stack
                branchPoints list.peek .data []
              branchTree.depthFrom sb.appendI
              " in branch at " sb.appendS
              op .pos sb.appendPos
              '\n' sb.appendC
            op .pos errors appendError
            return
          end
          whileBlock [] .blockId =:: whileId
          ## remember number of changed stack values ( necessary for merging values in compiled code )
          depth .success i64 cast.u program [] .whileData whileId list.at .data [] .modifiedTypes =
          breakBranches .length 1 >= if
            breakBranches .length =:: nodeCount
            branchPoints
              list.clear
              0:i64 while ..dup nodeCount < do =:: i
                breakBranches
                  i list.at .data
                [] .node list.append
                i 1 +
              end ..drop
            branchPoints =
            ## mergeValues
              state [] .stack @
              branchPoints list.asArray
              mergeBranches @
              ## MergePoint
                "while block" string.wrap
                op .pos
                whileBlock [] .breakCastOffsets list.asArray
                state
                whileBlock [] .doBranchIndex
                MergeType .MERGE_ROOT
              MergePoint new
            branchTree.merge .error ?? if
              "different numbers of types at the end of while branches: " sb.wrap
                0:i64 while ..dup breakBranches .length < do =:: i
                  "\n  * " sb.appendS
                  breakBranches i list.at .data =:: branchPoint
                  state [] .stack
                     branchPoint [] .node
                  branchTree.depthFrom sb.appendI
                  " in branch at " sb.appendS
                    branchPoint [] .pos sb.appendPos
                  i 1 +
                end ..drop
                '\n' sb.appendC
              op .pos errors appendError
            end
          end
          branchPoints list.free ..drop
          whileBlock [] .breakBranches .length 0 > state [] .reachable =
          whileId op .val .blockEnd .blockId =
          whileBlock [] .breakBranches list.free ..drop
          whileBlock [] .breakCastOffsets list.free ..drop
          whileBlock [] .continueBranches list.free ..drop
          whileBlock [] .continueCastOffsets list.free ..drop
          whileBlock [] .doBranches list.free ..drop
          BlockType .WHILE op .pos opEndBlock =:: mut: tmp
          whileBlock [] .blockId tmp .val .blockEnd .blockId =
          tmp state appendOp ..drop
          return
        WHILE DO case ## end-while/end-do should not be created by parser
          break
        AND OR case
          op .pos state closeBlock =:: mut: closed
          closed .AndOr ?? ! if
            "unexpected end of " sb.wrap
              closed sb.appendBlockInfoName
              "-block expected " sb.appendS
              AND_OR_BLOCK_INFO_NAME sb.appendS
              "-block" sb.appendS
            op .pos errors appendError
            return
          end
          state [] .reachable ! if
            "the end of all branches of an and/or block should be reachable, use if-else for conditional exit" sb.wrap
            op .pos errors appendError
          end
          closed .AndOr =:: andOrBlock
          andOrBlock .blockId op .val .blockEnd .blockId =
          op state appendOp ..drop
          andOrBlock .branches =:: mut: branches
          branches
              state [] .stack @ branchTree.startBranch
                op .pos
              BranchPoint new list.append
          branches =
          branches .length =:: nodeCount
          nodeCount branchTree.NodeId list.create
            0:i64 while ..dup nodeCount < do =:: i
              branches i list.at .data [] .node list.append
              i 1 +
            end ..drop
          =:: branchPoints
          ## mergeValues
            state [] .stack @
            branchPoints list.asArray
            mergeBranches @
            ## MergePoint
              "and or block" string.wrap
              op .pos
              i64 array.empty
              state
              0
              MergeType .NO_CAST
            MergePoint new
          branchTree.merge .error ?? if
            "different number of types at the end or and-or branch: " sb.wrap
              0:i64 while ..dup branches .length < do =:: i
                "\n  * " sb.appendS
                branches i list.at .data =:: branchPoint
                state [] .stack
                   branchPoint [] .node
                branchTree.depthFrom sb.appendI
                " in branch at " sb.appendS
                  branchPoint [] .pos sb.appendPos
                i 1 +
              end ..drop
              '\n' sb.appendC
            op .pos errors appendError
          end
          branchPoints list.free ..drop
          branches list.free ..drop
          return
        AND_IF OR_IF AND_DO OR_DO
        BREAK CONTINUE BREAK_SWITCH
        IF_TRUE IF_FALSE AND_TRUE AND_FALSE
        OR_TRUE OR_FALSE ELSE_TRUE ELSE_FALSE
        UNKNOWN NAMESPACE case
          break
      end
      break
    Return case
      op @ state typeCheckReturn
      op .pos state endSwitchBranch
      return
    Assert case
      ## XXX try to evaluate at compile time
      ## requireTypes
        types.primitive.BOOL @ array.wrap
        "assertion" string.wrap
        0
        op .pos
      state requireTypes if ..drop
        return
      end ..drop
      op state appendOp ..drop
      return
    Error case
      ## appendError
        op .val .Error .message .length sb.create
        op .val .Error .message labelContext sb.appendStringConst
        ## TODO? append initialization stack for all error messages
        state [] .initializationStack .length 0 > if
          "\n  caused by initializing code at " sb.appendS
          op .pos sb.appendPos
          '\n' sb.appendC
          state [] .initializationStack .length 1 - while
            $ 0 >
          do =:: i
            "  caused by initializing code at " sb.appendS
            state [] .initializationStack i list.at .data [] sb.appendPos
            '\n' sb.appendC
          finally i 1 - end ..drop
          state [] .initializationStack 0 list.at .data []
        else
          op .pos
        end
        errors
      op .val .Error .errorType switch
        ERROR case appendError break
        WARNING case appendWarning break
        INFO case appendInfo break
      end
      return
    length size case
      state [] .stack @ branchTree.peek =:: value?
      value? optional.isEmpty if
        "missing argument for " sb.wrap
          op program sb.appendOp
          " expected pointer or array" sb.appendS
        op .pos errors appendError
        return
      end
        value? .data [] .valueType
        value? .data [] .value
        op .val .length ??
        op .pos
        program
      interpreter.sizeOfValue if ..drop.2
        return
      end =:: constVal =:: constType
      1 op .pos state discardValues ## remove value from stack
      ## pushConstant
        constVal
        constType
        op .pos
      state pushConstant
      return
    procPtr builtIn
    NewEnum call checkEnumLabel setEnumLabel
    existsName hasElement case
      break
    unreachable case
      false state [] .reachable =
      op state appendOp ..drop
      op .pos state endSwitchBranch
      return
    stackMod case
      op .val .stackMod .modType switch
        DROP case
          op .val .stackMod .n i64 cast.s op .pos state discardValues
          return
        COPY case
          op .val .stackMod .n =:: offset
          offset 1 + i64 cast.s op .pos state checkStackSize if
            return
          end
          ## copy value on stack
          state [] .stack @
            offset
          branchTree.at .data [] =:: mut: copied
          copied .valueType typeContext types.isReference if
            copied .valueType =:: srcType
            ## copying converts reference to value
            copied .valueType
              typeContext types.getBaseType
            copied .valueType =
            ## update value in stack & code
            copied .valueType
              state [] .stack @ offset
            branchTree.replaceAt .data =:: baseValue
            baseValue [] .valueType =
            ## opAutoCast
              srcType
              offset
              copied .valueType
              op .pos
            opAutoCast state appendOp =:: castIndex
            copied .opIndex -1 != if
              state [] .childIds
                ..dup .length =:: argOffset
                copied .opIndex list.append
              state [] .childIds =
              true true 1 argOffset state updateOpInfo_noStack
              castIndex copied .opIndex =
              castIndex baseValue [] .opIndex =
            end
            OP_UNLINKED copied .copyMutableIndex = ## remove possibility to overwrite copy
          end
          op .pos copied .pushedAt =
          copied .valueType typeContext types.isEmpty ! if
            ## TODO? don't copy composite operations
            ## copy value in code
            copied .opIndex state tryCopyOp if ..drop
              ## copied operation can no longer be deleted
              copied .opIndex state freezeOp
              op state appendOp
            end copied .opIndex =
          end
          state [] .stack @ copied branchTree.push
          return
        SWAP case
          2 op .pos state checkStackSize if
            return
          end
          state [] .stack @ branchTree.pop .data [] =:: upper
          state [] .stack @ branchTree.pop .data [] =:: mut: lower
          lower .valueType typeContext types.isEmpty ! and
              upper .valueType typeContext types.isEmpty ! if
            ## swap values in code
            lower .opIndex state canCopyOp and
                lower .opIndex state canDeleteOp if
              ## copy lower value above upper
              ## discard old operations for lower value
              lower .opIndex state tryCopyOp =:: isError =:: newIndex
              lower .opIndex state tryDeleteOp or isError if
                "internal compiler error: could not move operation" sb.wrap
                op .pos errors appendError
              end
              newIndex lower .opIndex =
            else
              op state appendOp ..drop
            end
          end
          ## swap values on stack
          state [] .stack @ upper branchTree.push
          state [] .stack @ lower branchTree.push
          return
      end
      break
    typeInfo case
      op .pos state popType =:: valType
      valType typeContext types.containsGeneric if
        break ## XXX? support var-size arrays
      end
      ## pushConstant
        ## computeTypeInfo
          valType
          op .val .typeInfo
        program interpreter.computeTypeInfo if ..drop
          "could no compute size of type " sb.wrap
            valType typeContext sb.appendType
          op .pos errors appendError
          return
        end
        types.primitive.I_SIZE
        op .pos
      state pushConstant
      return
    typeModifier case
      ## type-modifiers are handled by the interpreter
      constEvalFailed or
          state unfreezeInterpreter
          op @ state [] .interpreter @ evaluateOperation if
        "could not evaluate type modifier " sb.wrap
          op .val .typeModifier sb.appendTypeModifier
        op .pos errors appendError
      end
      return
    autoCast copy ConstantReference NewReference NewEnumReference case
      "unsupported operation: " sb.wrap
        op program sb.appendOp
      op .pos errors appendError
      return
    compilerInfo case
      op .val .compilerInfo switch
        typeInfo case
          op .val .compilerInfo .typeInfo =:: info
          ## printTypes
            false
            info .count
            info .depth
          state printTypes
          return
        stackInfo case
          ## printTypes
            true
            op .val .compilerInfo .stackInfo
            0
          state printTypes
          return
        compiledOps case
          return ## TODO print ops
        find case
          return ## TODO find
      end
      break
  end
  "type-checking for operation: " sb.wrap
    op program sb.appendOp
    " has not been implemented" sb.appendS
  op .pos errors appendError
end

proc(
  ProcedureInfo ptr : procInfo
  ProgramContext ptr.mut : program
-> i64 ) =>: nextImpl
  program [] .tmpOps
    procInfo [] .implementation .code .codeStart list.at .data
  =:: procStart
  procStart [] .val .implementProcedure ?? ! if
    0 return
  end
  ## implementationId contains id of last compiled implementation
  procStart [] .val .implementProcedure .implementationId 1 + return
end

proc(
  ProcId : procId
  i64 : implId
  FilePosition optional : expandedAt
  TypeCheckState ptr.mut : state
-> ) =>: typeCheckProcedure
  state [] .program [] .autoTypes list.copy =:: globalAutoTypes
  state [] .program =:: program
  program [] .procedures procId i64 cast list.at .data =:: currentProc
  ## compile procedures to local code of given file
  currentProc [] .fileId state [] .currentFile =
  state [] .initializationStack .length =:: offset
  expandedAt ? if
    state [] .initializationStack
      expandedAt .data list.append
    state [] .initializationStack =
  end
  currentProc [] .fileId state [] .interpreter .currentFile =
  program [] .progFiles
    currentProc [] .fileId i64 cast
  list.at .data =:: procFile
  state clearOps
  state resetInterpreter
  currentProc [] .implementation .code @ =:: codeImpl
  program [] .tmpOps
     codeImpl [] .codeStart list.at .data
  =:: procStart
  procStart [] .val .implementProcedure ??
      procStart [] .val .initializeId ?? |
      assert "procedure starts with correct operation"
  ## ProcedureImpl
    procId
    implId
  ProcedureImpl new OpValue .implementProcedure procStart [] .val =
  implId 0 >= if ## update procedure type
    codeImpl [] .implementations
      implId list.at .data
    [] .procType =:: procType
    procType procStart [] .dataType =
    procType state [] .currentProcType =
  else
    currentProc [] .procType state [] .currentProcType =
  end
  0:i64 while ..dup codeImpl [] .codeLength < do =:: i
    program [] .tmpOps
      i codeImpl [] .codeStart + list.get
    state typeCheckOp
    i 1 +
  end ..drop
  ## remember new code position
  implId -1 == if
    procFile [] .localOps .length codeImpl [] .codeStart =
    state [] .compiledOps .length codeImpl [] .codeLength =
  else
    codeImpl [] .implementations
      implId list.at .data
    =:: currentImpl
    procFile [] .localOps .length currentImpl [] .codeStart =
    state [] .compiledOps .length currentImpl [] .codeLength =
  end
  procFile [] .localOps
    state [] .compiledOps list.appendAll
  procFile [] .localOps =
  state [] .program [] .autoTypes
    list.free ..drop ## XXX? can free+reassign be replaced by clear+append
    globalAutoTypes ## reset local auto-types
  state [] .program [] .autoTypes =
  state [] .initializationStack
    offset list.setLength
  state [] .initializationStack =
  state [] .stack @ branchTree.clear ## TODO error on unhandled values
end

64 =:: MAX_STATIC_RECURSION

proc( ProgramContext ptr.mut : program -> ) =>: export: typeCheckProgram2
  ## TypeCheckState
    program
    program -1:FileId InterpreterType .FOLD_LOCAL interpreter.wrapProgram
    labelHash @ labelEq @ 64 TypedValue map.create
    Type .undefined
    true
    TypeInfo branchTree.create
    32  BlockInfo list.create
    0
    128 Operation list.create
    0
    128 OpInfo    list.create
    128 i64       list.create
    FILE_ID_NONE
    16 FilePosition list.create
    true
  TypeCheckState new =:: mut: state
  program [] .errors @ =:: errors
  program [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  state .compiledOps =:: originalOps
  ## procedures
  0:i64 while ..dup program [] .procedures .length < do =:: procId
    program [] .procedures procId i64 cast list.at .data =:: currentProc
    currentProc [] .implementation .code ?? ! if
      procId 1 + continue ## procedure implementation not in code
    end
    currentProc [] .procType typeContext types.getProcIn ..drop =:: procIn
    currentProc [] .implementation .code .codeStart 0 < if
      procId 1 + continue ## procedure not implemented
    end
    currentProc [] .hasStaticArg or currentProc [] .isStatic if
      procId 1 + continue
    end
    procId ProcId cast -1 FilePosition optional.empty state@ typeCheckProcedure
    procId 1 +
  end ..drop
  ## static procedures
  0 =:: mut: depth
  false =:: mut: compiledImplementation
  while
    false compiledImplementation =
    0:i64 while ..dup program [] .procedures .length < do =:: procId
      program [] .procedures procId list.at .data =:: currentProc
      currentProc [] .implementation .code ?? ! if
        procId 1 + continue ## procedure implementation not in code
      end
      currentProc [] .implementation .code @ =:: codeImpl
      codeImpl [] .codeStart 0 < if
        procId 1 + continue ## procedure not implemented
      end
      currentProc [] .hasStaticArg ! if
        procId 1 + continue ## handled by previous loop
      end
      currentProc [] .isStatic if
        procId 1 + continue ## don't type-check static procedures
      end
      currentProc program nextImpl =:: nextId
      codeImpl [] .implementations .length =:: implLength
      nextId implLength >= if
        procId 1 + continue
      end
      true compiledImplementation =
      nextId while ..dup implLength < do =:: implId
        codeImpl [] .implementations
          implId list.at .data
        =:: implData
        depth MAX_STATIC_RECURSION >= if
          "exceeded maximum static recursion depth (" sb.wrap
            MAX_STATIC_RECURSION sb.appendI
            ')' sb.appendC
          implData [] .firstUse errors appendError
        end
        implData [] .procType typeContext types.getProcIn ..drop =:: procIn
        procIn typeContext types.compositeElts =:: inTypes
        0:i64 =:: mut: staticArgCount
        ## XXX? clear argument map
        0:i64 while ..dup inTypes .length < do =:: i
          procIn i typeContext types.compositeGetLabel =:: labelId
          inTypes i types.compositeElts.get =:: argType
          labelId labelContext id.labelFlags id.FLAG_STATIC & ? if
            implData [] .staticArgs
              staticArgCount constContext constArrayGet
            =:: argValue
            state .argData @ labelId
              argType argValue TypedValue new
            map.put ..drop
            staticArgCount 1 + staticArgCount =
          else
            state .argData @ labelId
              argType ConstValue .none TypedValue new
            map.put ..drop
          end
          i 1 +
        end ..drop
        procId ProcId cast implId implData [] .firstUse optional.wrap state@ typeCheckProcedure
        implId 1 +
      end ..drop
      procId 1 +
    end ..drop
    compiledImplementation if
      depth 1 + depth =
      depth MAX_STATIC_RECURSION > if
        ## error message appended in implementation
        break
      end
      continue
    end
    false ## break loop while reaching condition
  do end
  program [] .tmpOps
    list.clear ## operations have been compiled
  program [] .tmpOps =
  ## TODO? put state cleanup into procedure
  state@ freeOps
  state .stack@ branchTree.free
  state .interpreter@ interpreter.cleanupContext
  state .argData@ map.free
  state .initializationStack list.free ..drop
end
