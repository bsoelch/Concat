union(
  _ : Unknown
  Type : Procedure
  IfBlockInfo : If
  _ : ConstIf
  SwitchBlockInfo : Switch
  WhileBlockInfo : While
  AndOrBlockInfo : AndOr
) =:: BlockInfo
proc( branchTree.NodeId : branchRoot BlockId : blockId FilePosition ptr : pos TypeCheckState ptr.mut : state -> BlockInfo ) =>: newIfBlock
  ## IfBlockInfo
    branchRoot
    branchTree.EMPTY pos BranchPoint new ## dummy value
    8 BranchPoint list.create
    8 BranchPoint list.create
    state [] .program program.nextLocalLabel
    state [] .program program.nextLocalLabel
    state [] .program program.nextLocalLabel
    -1
    blockId
    IfBlockFlags.none
    id.ScopeId optional.empty
  IfBlockInfo new
    $ .endLabel LocalLabelType .HINT_START pos state localLabel
    $ .elseLabel LocalLabelType .HINT_START pos state localLabel
    $ .ifLabel LocalLabelType .HINT_START pos state localLabel
  BlockInfo .If return
end
proc(
  Type : switchType
  Type : switchBaseType
  branchTree.NodeId : branchRoot
  IdentifierInfo optional : srcVar
  LabelId : blockLabel
  BlockId : blockId
  FilePosition ptr : pos
  TypeCheckState ptr.mut : state
-> SwitchBlockInfo ) =>: newSwitchBlock
  ## SwitchBlockInfo
    switchType
    switchBaseType
    branchRoot
    16 BranchPoint list.create
    16 i32 list.create
    state [] .compiledOps .length
    16 LocalLabelId list.create
    state [] .program program.nextLocalLabel
    blockLabel
    blockId
    srcVar
    true
    false
    false
  SwitchBlockInfo new return
end
proc(
  branchTree.NodeId : branchRoot
  LabelId : blockLabel
  BlockId : blockId
  FilePosition ptr : pos
  TypeCheckState ptr.mut : state
-> WhileBlockInfo ) =>: newWhileBlock
  ## WhileBlockInfo
      branchRoot
      pos
    BranchPoint new
    16 BranchPoint list.create
    16 i32 list.create
    16 BranchPoint list.create
    16 i32 list.create
    16 BranchPoint list.create
    -1
    state [] .program program.nextLocalLabel
    state [] .program program.nextLocalLabel
    state [] .program program.nextLocalLabel
    state [] .program program.nextLocalLabel
    0:i32
    0:i32
    blockLabel
    blockId
    false
  WhileBlockInfo new return
end
proc(
  branchTree.NodeId : branchRoot
  BlockId : blockId
  FilePosition ptr : pos
  TypeCheckState ptr.mut : state
-> AndOrBlockInfo ) =>: newAndOrBlock
  ## AndOrBlockInfo
    16 BranchPoint list.create
      branchRoot
      pos
    BranchPoint new list.append
    state [] .program program.nextLocalLabel
    blockId
  AndOrBlockInfo new return
end
"if-else" =:: IF_BLOCK_INFO_NAME
"switch-case" =:: SWITCH_BLOCK_INFO_NAME
"while" =:: WHILE_BLOCK_INFO_NAME
"and-or" =:: AND_OR_BLOCK_INFO_NAME
namespace: sb
  proc( stringBuilder BlockInfo -> stringBuilder ) =>: appendBlockInfoName
    switch
      Unknown case "unknown" sb.appendS return
      Procedure case "procedure" sb.appendS return
      ConstIf case "constant if" sb.appendS return
      If case IF_BLOCK_INFO_NAME sb.appendS return
      Switch case SWITCH_BLOCK_INFO_NAME sb.appendS return
      While case WHILE_BLOCK_INFO_NAME sb.appendS return
      AndOr case AND_OR_BLOCK_INFO_NAME sb.appendS return
    end
  end
end

