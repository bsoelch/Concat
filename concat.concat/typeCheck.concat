          TYPE_PROC_IN TYPE_CPROC_IN TYPE_PROC_ARROW TYPE_COMPOSITE INITIALIZER case
            ## XXX allow dynamic initializer blocks
            "could not evaluate " sb.copyPtr
              blockInfo .blockType sb.appendBlockType
              " block" sb.appendS
            op .pos errors appendError
            continue.opLoop
          PROCEDURE case
            oldBlockStart state .blockStart= ## keep constants intact
            op .pos state closeBlock .Procedure .else
              "unexpected end of " sb.copyPtr
                >$ sb.appendBlockInfoName
                " block expected Procedure block" sb.appendS
              op .pos errors appendError
              continue.opLoop
            end =:: closedProc
            state [] .reachable if
              ## create explicit  return operation if end of procedure reachable
              op .pos state typeCheckReturn
            end
            op .pos opEndProc state appendOp ..drop
            ## procedure scope is handled by typeCheckProcedure
            continue.opLoop
          ELSE case
            op .pos state closeBlock =:: closed
            closed .ConstIf ? if
              oldBlockStart state .blockStart= ## keep previous block start
              idContext id.closeScope ! "closing if-scope worked" assert
              continue.opLoop
            else closed .If ._else
              "unexpected end of " sb.copyPtr
                >$ sb.appendBlockInfoName
                " block expected " sb.appendS
                IF_BLOCK_INFO_NAME sb.appendS
                " block" sb.appendS
              op .pos errors appendError
              continue.opLoop
            end =:: closedIf
            closedIf .flags IfBlockFlags.hasElse & ? ! if
              "unexpected end of " sb.copyPtr
                closed sb.appendBlockInfoName
                " block, expected `else` before `end`" sb.appendS
              op .pos errors appendError
              continue.opLoop
            end
            state [] .stack branchTree.depth op .pos state reserveOps =:: elseCastOffset
            branchTree.NodeId 2 array new =:: mut: branches
            i32 2 array new =:: mut: castOffsets
            0 =:: mut: nBranches
            closedIf .flags IfBlockFlags.ifBranchTerminates & ? if
              closedIf .ifBranch .node branches@ nBranches =[]
              closedIf .ifCastsOffset castOffsets@ nBranches =[]
              nBranches 1 + nBranches=
            end
            state [] .reachable if
              state .stack branchTree.startBranch branches@ nBranches =[]
              elseCastOffset castOffsets@ nBranches =[]
              nBranches 1 + nBranches=
            end
            nBranches 1 >= if
              ## mergeValues
                state .stack
                branches@ nBranches slice.create
                mergeBranches@
                ## MergePoint
                  "if-else block":s
                  op .pos
                  castOffsets@ nBranches slice.create
                  state
                  0
                  MergeType .MERGE
                MergePoint new
              branchTree.merge .Error ? if
                "different numbers of types at the end of " sb.copyPtr
                  closed sb.appendBlockInfoName
                  " block\n  * ifBranch: " sb.appendS
                  state [] .stack
                    closedIf .ifBranch .node
                  branchTree.depthFrom sb.appendI
                  " at " sb.appendS
                  closedIf .ifBranch .pos [] sb.appendPos
                  "\n  * elseBranch: " sb.appendS
                  state [] .stack
                    branches@ 1 []
                  branchTree.depthFrom sb.appendI
                op .pos errors appendError
              end
            end
            closedIf .endLabel LocalLabelType .LABEL_END op .pos state localLabel
            idContext id.closeScope ! "closing else-scope worked" assert
            ## cleanup closed block
            closedIf .andBranches list.free ..drop
            closedIf .orBranches list.free ..drop
            nBranches 0 > state .reachable=
            continue.opLoop
          IF case break ## end-if should not be created by parser
          SWITCH case
            ## break current branch
            op .pos state endSwitchBranch
            op .pos state closeBlock .Switch .else
              "unexpected end of " sb.copyPtr
                >$ sb.appendBlockInfoName
                "-block expected " sb.appendS
                SWITCH_BLOCK_INFO_NAME sb.appendS
                "-block" sb.appendS
              op .pos errors appendError
              continue.opLoop
            end =:: switchBlock
            ## XXX? check for stray labels
            switchBlock .caseBranches =:: mut: caseBranches
            program [] .switchData
              switchBlock .blockId i64 cast
            @[] =:: switchData
            ## sort switch-labels
            switchData [] .switchLabels switchLabelCmp@ program list.sort
            switchBlock .hasDefault ! if
              switchData [] .defaultLabel LocalLabelType .LABEL_END op .pos state localLabel
              switchBlock .switchType typeContext types.isEnumOrTaggedUnion if
                switchBlock .switchType
                  $ typeContext types.isTaggedUnion if
                    typeContext types.asRawUnion optional.unwrap
                  end
                =:: rawSwitchType
                rawSwitchType
                  typeContext
                types.compositeEltCount =:: eltCount
                switchData [] .switchLabels =:: labels
                labels  .length eltCount iSize cast.u u< if
                  "switch statement does not cover all labels in enum " sb.copyPtr
                    switchBlock .switchType
                      typeContext
                    sb.appendType
                    "\nmissing labels:\n" sb.appendS
                    0:i64 while $ eltCount i64 cast.u < do =:: i
                      false =:: mut:  match
                      ## XXX? use slice.find
                      labels for =:: label
                        label .value .Int .and i == if
                          true match=
                          break
                        end
                      end
                      match ! if
                        " - \"":s sb.appendStr
                        rawSwitchType
                          i i32 cast.u
                          typeContext
                        types.compositeGetEltName .if =:: eltName
                          eltName nameContext sb.appendIdentifierPath
                          "\" declaredAt":s sb.appendStr
                          eltName id.getIdentifierPos [] sb.appendPos
                        else i sb.appendI end
                        '\n' sb.appendC
                      end
                      i 1 +
                    end ..drop
                  op .pos errors appendError
                end
                "enum label outside expected range":s op .pos opPanicWithMessage state appendOp ..drop
              else
                caseBranches
                  ## BranchPoint
                    op .pos
                    switchBlock .branchRoot
                  BranchPoint new list.append
                caseBranches=
              end
              switchBlock .endLabel CompareType .NONE op .pos state localJump
            end
            ## set stack head to one of the accepting branches
            caseBranches .length 1:iSize u>= if
              caseBranches .length branchTree.NodeId list.create
                caseBranches for .node list.append end
              =:: branchPoints
              ## mergeValues
                state .stack
                branchPoints list.asSlice
                mergeBranches@
                ## MergePoint
                  "switch-case block":s
                  op .pos
                  switchBlock .castOffsets list.asSlice
                  state
                  0
                  MergeType .MERGE
                MergePoint new
              branchTree.merge .Error ? if
                "different numbers of types at the end of switch-branches: " sb.copyPtr
                  caseBranches for =:: branchPoint
                    "\n  * " sb.appendS
                    state [] .stack
                      branchPoint .node
                    branchTree.depthFrom sb.appendI
                    " in branch at " sb.appendS
                    branchPoint .pos [] sb.appendPos
                  end
                  '\n' sb.appendC
                op .pos errors appendError
              end
              branchPoints list.free ..drop
            end
            caseBranches .length 0:iSize != state .reachable=
            program [] .programMemory
              switchBlock .caseLabels list.asSlice mixedArena.copySlice =:: caseLabels
              switchBlock .caseLabels .length i32 cast.u JumpDistance mixedArena.allocSlice =:: caseJumps
            program .programMemory=
            caseLabels .length for =:: i
              state .jumpOffsets caseLabels i [] map.remove .and .Label .else
                "expected label":s op ..line state internalError ..unreachable
              end
                switchBlock .switchPos -
              JumpDistance cast.s caseJumps i =[]
            end
            caseLabels slice.freeze switchData .branchLabels=
            caseJumps slice.freeze switchData .caseJumpDistances=
            state .jumpOffsets switchData [] .defaultLabel map.remove .and .Label .else
              "expected label":s op ..line state internalError ..unreachable
            end
              switchBlock .switchPos -
            JumpDistance cast.s switchData .defaultJumpDistance=
            switchBlock .endLabel LocalLabelType .LABEL_END op .pos state localLabel
            switchBlock .caseLabels list.free ..drop
            switchBlock .caseBranches list.free ..drop
            switchBlock .castOffsets list.free ..drop
            idContext id.closeScope ! "closing while-scope worked" assert
            continue.opLoop
          CASE DEFAULT DOT_CASE DOT_DEFAULT case ## end-case should not be created by parser
            break
          FINALLY case
            op .pos state closeBlock .While .else
              "unexpected end of " sb.copyPtr
                >$ sb.appendBlockInfoName
                "-block expected " sb.appendS
                WHILE_BLOCK_INFO_NAME sb.appendS
                "-block" sb.appendS
              op .pos errors appendError
              continue.opLoop
            end =:: whileBlock
            whileBlock .breakBranches =:: breakBranches
            ## XXX? avoid allocation if it si not neccessary
            breakBranches .length branchTree.NodeId list.create
              whileBlock .branchRoot .node list.append
              state .stack branchTree.startBranch list.append
            =:: mut: branchPoints
            i32 2 array new =:: mut: castOffsets
            OP_UNLINKED castOffsets@ 0 =[]
            ## reserveOps
              state [] .stack branchTree.depth
              op .pos
            state reserveOps castOffsets@ 1 =[]
            ## mergeValues
              state .stack
              branchPoints list.asSlice
              mergeBranches@
              ## MergePoint
                "while loop":s
                op .pos
                castOffsets@ 2 slice.create
                state
                0
                MergeType .MERGE_ROOT
              MergePoint new
            branchTree.merge .Success .else ..drop
              "different numbers of types at beginning and end of while-block: " sb.copyPtr
                "\n  * " sb.appendS
                state [] .stack
                   whileBlock .branchRoot .node
                branchTree.depthFrom sb.appendI
                " in branch at " sb.appendS
                whileBlock .branchRoot .pos [] sb.appendPos
                "\n  * " sb.appendS
                state [] .stack
                  branchPoints list.peek optional.unwrap []
                branchTree.depthFrom sb.appendI
                " in branch at " sb.appendS
                op .pos [] sb.appendPos
                '\n' sb.appendC
              op .pos errors appendError
              continue.opLoop
            end =:: depth
            whileBlock .blockId =:: whileId
            ## remember number of changed stack values ( necessary for merging values in compiled code )
            program .backJumpInfo
              whileBlock .whileLabel
              depth BackJumpInfo.new
            map.put ..drop
            breakBranches .length 1:iSize u>= if
              branchPoints
                list.clear
                breakBranches for .node list.append end
              branchPoints=
              ## mergeValues
                state .stack
                branchPoints list.asSlice
                mergeBranches@
                ## MergePoint
                  "while block":s
                  op .pos
                  whileBlock .breakCastOffsets list.asSlice
                  state
                  whileBlock .doBranchIndex
                  MergeType .MERGE_ROOT
                MergePoint new
              branchTree.merge .Error ? if
                "different numbers of types at the end of while branches: " sb.copyPtr
                  breakBranches for =:: branchPoint
                    "\n  * " sb.appendS
                    state [] .stack
                      branchPoint .node
                    branchTree.depthFrom sb.appendI
                    " in branch at " sb.appendS
                    branchPoint .pos [] sb.appendPos
                  end
                  '\n' sb.appendC
                op .pos errors appendError
              end
            end
            whileBlock .whileLabel CompareType .NONE op .pos state localJump
            whileBlock .whileLabel LocalLabelType .HINT_END op .pos state localLabel
            whileBlock .endLabel LocalLabelType .LABEL_END op .pos state localLabel
            whileBlock .breakBranches .length 0:iSize != state .reachable=
            branchPoints list.free ..drop
            whileBlock .breakBranches list.free ..drop
            whileBlock .breakCastOffsets list.free ..drop
            whileBlock .continueBranches list.free ..drop
            whileBlock .continueCastOffsets list.free ..drop
            whileBlock .doBranches list.free ..drop
            idContext id.closeScope ! "closing switch-scope worked" assert
            continue.opLoop
          WHILE DO case ## end-while/end-do should not be created by parser
            break
          AND OR case
            op .pos state closeBlock .AndOr .else
              "unexpected end of " sb.copyPtr
                >$ sb.appendBlockInfoName
                "-block expected " sb.appendS
                AND_OR_BLOCK_INFO_NAME sb.appendS
                "-block" sb.appendS
              op .pos errors appendError
              continue.opLoop
            end =:: andOrBlock
            state [] .reachable ! if
