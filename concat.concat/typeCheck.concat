      op .val .setId =:: idInfo
      idInfo .labelId =:: labelId
      labelId
        labelContext id.labelFlags
      id.FLAG_MUTABLE & ? ! if
        256 sb.create
          idInfo labelContext sb.appendIdInfo
          " is not mutable" sb.appendS
        op .pos errors appendError
      end
      ## requireTypes
        op@ .dataType slice.wrap
        "set identifier":s
        0
        op .pos
        state
