            "wrong type for switch label: expected " sb.wrap
               switchType typeContext sb.appendType
               " got " sb.appendS
               op [] .dataType typeContext sb.appendType
             op [] .pos state appendError2
          end
          0 while ..dup labels [] .length < do
            labels [] ..over list.at .data [] .value constant labelContext constantEquals if
              "duplicate label " sb.wrap
                switchType typeContext types.isEnum if
                  switchType constant .enumLabel typeContext types.compositeGetLabel labelContext sb.appendLabelName
                else
                  constant idContext [] .constContext @ typeContext sb.appendConstant
                end
                " in switch-case" sb.appendS
              op [] .pos state appendError2
            end
            1 +
          end ..drop
          labels []
            ## LabelData
              constant
              op [] .pos
              switchData [] .caseCount
            LabelData new list.append
          labels [] =
          return
        end
      else ..drop end
      op state checkReachable
      break
    unaryOperator case
      op state checkReachable
      state [] .typeStack list.peek ..dup optional.isEmpty if ..drop
        "not enough operands for : " sb.wrap
          op [] progContext sb.appendOp
          " need 1 got " sb.appendS
          state [] .typeStack .length sb.appendI
        op [] .pos state appendError2
        return
      end .data =:: src
      op state checkLocal
      src [] .valType op [] .dataType =
      op [] .val .unaryOperator switch
        NEGATE case
          src [] .valType
          ..dup typeContext types.isNumber ! if
            "wrong operand for unary operator " sb.wrap
              op [] .val .unaryOperator sb.appendUnaryOperator
              " expected number got " sb.appendS
              ..swap typeContext sb.appendType
            op [] .pos state appendError2
          else ..drop end
          break
        FLIP case
          src [] .valType
          ..dup typeContext types.isInt ! if
            "wrong operand for unary operator " sb.wrap
              op [] .val .unaryOperator sb.appendUnaryOperator
              " expected integer got " sb.appendS
              ..swap typeContext sb.appendType
            op [] .pos state appendError2
          else ..drop end
          break
        NOT case
          src [] .valType
          ..dup typeContext types.isBoolean ! if
            "wrong operand for unary operator " sb.wrap
              op [] .val .unaryOperator sb.appendUnaryOperator
              " expected boolean got " sb.appendS
              ..swap typeContext sb.appendType
            op [] .pos state appendError2
          else ..drop end
          break
        TO_BOOL case
