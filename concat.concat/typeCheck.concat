        typeInfo [] .valType typeContext sb.appendType
        " is not mutable" sb.appendS
      op [] .pos state appendError2
    end
    elementType typeContext types.isEmpty if ## skip setting of empty elements
      1 op [] .pos state discardStackOps
    else
      state [] .compiledOps
        op list.appendP
      state [] .compiledOps =
      1 op [] .pos state addCompiledStackOps
    end
    elementType @ array.wrap "tuple assignment" string.wrap op [] .pos state requireTypes
    elementType typeContext types.isEmpty if ## skip setting of empty elements
      1 op [] .pos state discardStackOps
    else
      1 op [] .pos state addCompiledStackOps
    end
    return
  end
  ## GET_TUPLE_ELEMENT(index) <tuple>
  ## ADDR_OF_TUPLE_ELEMENT(index) <tuple>
  op 1 state insertStackOp
  elementType state [] .typeStack list.peek .data [] .valType = ## change type on stack
  op [] .val .getElement ?? if
    mutable state [] .typeStack list.peek .data [] .writable =
  end
end
proc( Operation ptr mut : op LabelId  : label TypeCheckState ptr mut : state -> ) =>: typeCheckGetLabel
  using types
  state [] .progContext =:: progContext
  progContext [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  label labelContext id.isLabelEmpty if
    "missing label name " sb.wrap op [] .pos state appendError2
    return
  end
  state [] .typeStack list.peek ..dup optional.isEmpty if ..drop
    "not enough operands for : " sb.wrap
      op [] progContext sb.appendOp
      " need 1 got " sb.appendS
      state [] .typeStack .length sb.appendI
    op [] .pos state appendError2
    return
  end .data =:: typeInfo
  typeInfo [] .valType =:: mut targetType
  targetType typeContext isPointer if
    targetType typeContext getBaseType targetType =
  end
  targetType typeContext isTuple if
    targetType typeContext unwrapNamed =:: tupleType
    tupleType label typeContext compositeFindLabel =:: index
    index 0 >= if
      op [] .val switch
        getLabel case
          index op [] .val .getElement =
          break
        setLabel case
          index op [] .val .setElement =
          break
        @Label case
          index op [] .val .@Element =
          break
        default
          "unexpected operation for get label: " sb.wrap
            op [] progContext sb.appendOp
          op [] .pos state appendError2
          return
      end
      op index state typeCheckGetElement
      return
    end
  end
  targetType typeContext isEnum if
    targetType typeContext unwrapNamed =:: enumType
    enumType label typeContext compositeFindLabel =:: index
    index 0 >= if
      enumType index typeContext compositeGetElement =:: mut eltType
       op [] .val .hasLabel ?? ! if eltType typeContext isEmpty _if
        "element " sb.wrap
          label labelContext sb.appendLabelName
          " in enum " sb.appendS
          targetType typeContext sb.appendType
          " does not hold a value" sb.appendS
        op [] .pos state appendError2
      end
      enumType index typeContext compositeGetLabel labelContext id.labelFlags id.FLAG_MUTABLE & ? typeInfo [] .writable & =:: mutable
      op [] .val .@Label ?? if
        eltType mutable typeContext getAddressType eltType =
      end
      enumType op [] .dataType =
      op [] .val switch
        getLabel case
          index op [] .val .getElement =
          break
        setLabel case
          index op [] .val .setElement =
          break
        @Label case
          index op [] .val .@Element =
          break
        hasLabel case
          index op [] .val .hasElement =
          break
        default
          "unexpected operation for get label: " sb.wrap
            op [] progContext sb.appendOp
          op [] .pos state appendError2
          return
      end
      1 true op [] .pos state extractCompositeOps
      typeInfo [] .opCount =:: opCount ## extractCompositeOps does not modify type-stack -> typeInfo still valid
      op [] .val .setElement ?? if
        mutable ! if
          "element " sb.wrap
            label labelContext sb.appendLabelName
            " in enum " sb.appendS
            targetType typeContext sb.appendType
            " is not mutable" sb.appendS
          op [] .pos state appendError2
        end
        state [] .compiledOps
          enumType index op [] .pos opSetEnumLabel list.append
          state [] .opStack .data state [] .opStack .length opCount - + opCount array.create list.appendArray
          op list.appendP
        state [] .compiledOps =
        1 op [] .pos state addCompiledStackOps
        eltType @ array.wrap "enum assignment" string.wrap op [] .pos state requireTypes
        1 op [] .pos state addCompiledStackOps
        return
      end
      op [] .val .hasElement ?? if
        op 1 state insertStackOp
        types.primitive.BOOL state [] .typeStack list.peek .data [] .valType = ## change type on stack
        return
      end
      ## check index
      state [] .compiledOps
        enumType index op [] .pos opCheckEnum list.append
        state [] .opStack .data state [] .opStack .length opCount - + opCount array.create list.appendArray
      state [] .compiledOps =
      true state [] .hasCheckEnum =
      ## get value
      op 1 state insertStackOp
      eltType state [] .typeStack list.peek .data [] .valType = ## change type on stack
      op [] .val .getElement ?? if
        mutable state [] .typeStack list.peek .data [] .writable =
      end
      return
    end
  end
  targetType typeContext isUnion if
    targetType typeContext unwrapNamed =:: unionType
    unionType label typeContext compositeFindLabel =:: index
    index 0 >= if
      op [] .val switch
        getLabel case
          index op [] .val .getElement =
          break
        setLabel case
          index op [] .val .setElement =
          break
        @Label case
          index op [] .val .@Element =
          break
        default
          "unexpected operation for get label: " sb.wrap
            op [] progContext sb.appendOp
          op [] .pos state appendError2
          return
      end
      op index state typeCheckGetElement
      return
    end
  end
  0 sb.create
    typeInfo [] .valType typeContext sb.appendType
    " does not have a label " sb.appendS
    label labelContext sb.appendLabelName
  op [] .pos state appendError2
end
proc( Operation ptr : op TypeCheckState ptr mut : state -> ) =>: typeCheckReturn
  state [] .progContext =:: progContext
  progContext [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  op [] .dataType typeContext types.isProcedure ! if
    "unexpected type for return: " sb.wrap
      op [] .dataType typeContext sb.appendType
      " expected procedure" sb.appendS
    op [] .pos state appendError2
    return
  end
  op [] .dataType typeContext types.getProcOut if ..drop
    "could not resolve procedure return value" sb.wrap op [] .pos state appendError2
    return
  end =:: procOut
  procOut typeContext types.compositeEltCount =:: valCount
  valCount state [] .typeStack .length < if ## typeCount < valCount will be handled by requireTypes
    "wrong number of return values at the end of procedure expected: " sb.wrap
      valCount                    sb.appendI
      " got "                     sb.appendS
      state [] .typeStack .length sb.appendI
    op [] .pos state appendError2
    ## XXX report position of lowest stack value
  end
  procOut typeContext types.compositeEltArray "return statement" string.wrap op [] .pos state requireTypes
  state [] .compiledOps
    op list.appendP
  state [] .compiledOps =
  state [] .typeStack .length op [] .pos state CompileType .NON_EMPTY processStackOps
  false state [] .reachable =
end

proc( Operation ptr : op TypeCheckState ptr mut : state -> ) =>: checkReachable
  state [] .reachable if
    return
  end
  "unreachable operation: " sb.wrap
    op [] state [] .progContext sb.appendOp
  op [] .pos state appendError2
end
proc( Operation ptr : op TypeCheckState ptr mut : state -> ) =>: checkLocal
  state [] .openBlocks .length 0 > if
    return
  end
  "unexpected operation at global level: " sb.wrap
    op [] state [] .progContext sb.appendOp
  op [] .pos state appendError2
end

proc( Operation ptr mut : op TypeCheckState ptr mut : state -> bool ) =>: resolveEnumSwitchLabel
  state [] .progContext =:: progContext
  progContext [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  state [] .openBlocks list.peek =:: openBlock?
  openBlock? optional.isEmpty state [] .reachable | if
    false return
  end
  openBlock? .data =:: block
  block [] .blockType .SWITCH ?? ! if block [] .blockType .CASE ?? ! _if
    false return
  end
  block [] .blockData .switchBlock .switchType =:: switchType
  switchType typeContext types.isEnum ! if
    false return
  end
  op [] .val switch
    Constant case
      op [] .val .Constant =:: constVal
      constVal .typeId ?? ! if
        false return
      end
      constVal .typeId types.isNamedType ! if
        false return
      end
      constVal .typeId typeContext types.namedTypeName
      break
    getId case
      op [] .val .getId .labelId
      break
    getName case
      op [] .val .getName
      break
    default
      false return
  end =:: label
  switchType typeContext types.compositeEltCount =:: count
  0 while ..dup count < do
    switchType ..over typeContext types.compositeGetLabel ..dup id.LABEL_ID_NONE == if ..drop
      1 + continue
    end label labelContext id.labelNamesEq if
      switchType op [] .dataType =
      ConstValue .enumLabel op [] .val .Constant =
      true return
    end
    1 +
  end ..drop
  false return
end

proc( Operation ptr mut : op TypeCheckState ptr mut : state -> ) =>: resolveIdentifiers
  state [] .progContext =:: progContext
  progContext [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  op state resolveEnumSwitchLabel if
    return
  end
  op [] .val switch
    getName case
      op [] .val .getName
      break
    setName case
      op [] .val .setName
      break
    @Name case
      op [] .val .@Name
      break
    default
      return
  end =:: label
  label id.LABEL_ID_NONE == if
    return
  end
  label labelContext id.inLabelNamespace
  label state [] .fileId idContext id.findIdentifierByLabel if
    ..drop.2 return
  end
  ..swap ..drop
  ..dup [] .valueType op [] .dataType =
  op [] .val switch
    getName case
      id.asIdInfo op [] .val .getId =
      break
    setName case
      id.asIdInfo op [] .val .setId =
      break
    @Name case
      id.asIdInfo op [] .val .@Id =
      break
    default ..drop
      break
  end
end
## TODO? constant evalutation
proc( Operation ptr mut : op TypeCheckState ptr mut : state -> ) =>: typeCheckOp
  state [] .progContext =:: progContext
  progContext [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  state checkSync if
    "type-stack out of sync " sb.wrap
      " at " sb.appendS
      op [] .pos .fileName sb.appendStr
      ':' sb.appendC
      op [] .pos .line sb.appendI
      ':' sb.appendC
      op [] .pos .posInLine sb.appendI
      '\n' sb.appendC
    io.stdErr ..swap io.fputSb ..drop
    return
  end
  op state resolveIdentifiers
  op [] .val switch
    Constant case
      state [] .reachable if
        op [] .val .Constant .enumLabel ?? if
          op [] .dataType op [] .val .Constant .enumLabel typeContext types.compositeGetElement
            ..dup typeContext types.isEmpty ! if
              "cannot directly use enum label \"" sb.wrap
                  op [] .dataType op [] .val .Constant .enumLabel typeContext types.compositeGetLabel
                labelContext sb.appendLabelName
               "\" in " sb.appendS
               op [] .dataType typeContext sb.appendType
               " use \"new\" to create enum values" sb.appendS
             op [] .pos state appendError2
            end
