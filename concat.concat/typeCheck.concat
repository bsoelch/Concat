proc( Operation ptr : op TypeCheckState ptr mut : state => ) =: checkReachable
  state [] .reachable if
    return
  end
  "unreachable operation: " sb.wrap
    op [] state [] .idContext [] .constContext @ state [] .idContext [] .labelContext @ state [] .idContext [] .typeContext @ sb.appendOp
  op [] .pos state appendError2
end
proc( Operation ptr : op TypeCheckState ptr mut : state => ) =: checkLocal
  state [] .openBlocks .length 0 > if
    return
  end
  "unexpected operation at global level: " sb.wrap
    op [] state [] .idContext [] .constContext @ state [] .idContext [] .labelContext @ state [] .idContext [] .typeContext @ sb.appendOp
  op [] .pos state appendError2
end

proc( Operation ptr mut : op TypeCheckState ptr mut : state => ) =: resolveIdentifiers
  state [] .idContext =:: idContext
  idContext [] .labelContext @ =:: labelContext
  idContext [] .typeContext @ =:: typeContext

  op [] .val switch
    getName case
      op [] .val .getName
      break
    setName case
      op [] .val .setName
      break
    @Name case
      op [] .val .@Name
      break
    default
      return
  end =:: label
  label labelContext id.labelName #dup optional.isEmpty if #drop
    return
  end .data =:: name
  state [] .openBlocks list.peek #dup optional.hasData state [] .reachable ! & if .data =:: block
  block [] .blockType #dup BlockType .SWITCH == #swap BlockType .CASE == | if
  block [] .blockData .switchBlock .switchType =:: switchType
  switchType typeContext types.isEnum if
    switchType typeContext types.compositeEltCount =:: count
    0 while #dup count < do
      switchType #over typeContext types.compositeGetLabel labelContext id.labelName #dup optional.isEmpty if #drop
        1 + continue
      end .data name string.eq if
        switchType op [] .dataType =
        ConstValue .enumLabel new op [] .val .Constant =
        return
      end
      1 +
    end #drop
  end end else #drop end
  label labelContext id.inLabelNamespace
  name state [] .fileId idContext id.getIdentifier if
    #drop:2 return
  end
  #swap #drop
  #dup [] .valueType op [] .dataType =
  op [] .val switch
    getName case
      id.asIdInfo op [] .val .getId =
      break
    setName case
      id.asIdInfo op [] .val .setId =
      break
    @Name case
      id.asIdInfo op [] .val .@Id =
      break
    default #drop
      break
  end
end
