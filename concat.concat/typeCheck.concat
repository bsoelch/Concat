proc(
  i32 : switchId
  Type : switchType
  TypeCheckState ptr.mut : state
-> ) =>: resolveSwitchLabels
  state [] .program =:: program
  state [] .program [] .errors @ =:: errors
  state [] .program [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  state [] .interpreter .stack =:: labels
  state [] .interpreter .stackInfo =:: stackInfo
  0:i64 while ..dup labels .length < do =:: i
    labels i list.get =:: mut: label
    stackInfo i list.at .data =:: labelInfo
    ## XXX? less strict condition for types?
    labelInfo [] .valueType switchType types.typeEquals ! if
      label .int ?? ! if
        "invalid constant for switch label of type " sb.wrap
          switchType typeContext sb.appendType
          " : " sb.appendS
          label constContext typeContext sb.appendConstant
        labelInfo [] .pushedAt errors appendError
      end
      ## XXX ensure correct size of int label
      ## i8 257 -> i8 1
    end
    switchId label labelInfo [] .pushedAt state newSwitchLabel
    i 1 +
  end ..drop
  state resetInterpreter
end
proc(
  Operation ptr : op
  TypeCheckState ptr.mut : state
-> bool #+consume op+# ) =>: typeCheckSwitchLabel
  state [] .program =:: program
  state [] .program [] .errors @ =:: errors
  state [] .program [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  state peekBlock .data [] .Switch @ =:: switchBlock
  switchBlock [] .switchType =:: switchType
  switchBlock [] .blockId =:: switchId
  op [] .val .block ?? if
    op [] .val .block .blockType switch
      CASE DEFAULT case
        ## resolveSwitchLabels
          switchId
          switchType
        state resolveSwitchLabels
        false return
      BREAK case
        switchBlock [] .allowBreak if
          false switchBlock [] .allowBreak =
          true return
        end
        break
      default
        break
    end
  else op [] .val .blockEnd ?? _if
    ## resolveSwitchLabels
      switchId
      switchType
    state resolveSwitchLabels
    false return
  end
  ## operation after switch -> don't allow break statement
  false switchBlock [] .allowBreak =
  switchType typeContext types.isTaggedUnion ! if
    op state [] .interpreter @ evaluateOperation if
      "unsupported operation in switch label:\n " sb.wrap
        op [] program sb.appendOp
      op [] .pos errors appendError
    end
    true return
  end
  ## enum-switch -> try read label
  op [] .val .getId ?? if
    op [] .val .getId .labelId
  else op [] .val .getName ?? _if
    op [] .val .getName
  else op [] .val .Constant ?? and
      op [] .val .Constant =:: constVal
      constVal .typeId ?? and
      constVal .typeId types.isNamedType _if
    constVal .typeId typeContext types.namedTypeName
  else
    "unsupported operation for switch label of type " sb.wrap
      switchType typeContext sb.appendType
      " : " sb.appendS
      op [] program sb.appendOp
      " expected identifier" sb.appendS
    op [] .pos errors appendError
    true return
  end =:: labelId
  ## compositeFindLabel
    switchType
    labelId
  typeContext types.compositeFindLabel =:: labelIndex
  labelIndex 0 < if
    "enum " sb.wrap
      switchType typeContext sb.appendType
      " does not have a label " sb.appendS
      labelId labelContext sb.appendLabelName
    op [] .pos errors appendError
    true return
  end
  ## newSwitchLabel
    switchId
    ## ConstValue
      labelIndex
    ConstValue .enumLabel
    op [] .pos
  state newSwitchLabel
  true return
end

proc(
  LabelId : label
  Operation ptr.mut : op
  TypeCheckState ptr.mut : state
-> IdentifierInfo optional ) =>: resolveIdentifer
  state [] .program =:: program
  state [] .program [] .idContext @ =:: idContext
  idContext [] .typeContext .labelContext @ =:: labelContext
  label labelContext id.inLabelNamespace
  label state [] .currentFile idContext id.findIdentifierByLabel if
    ..drop IdentifierInfo optional.empty return
  end =:: idData
  idData [] .valueType op [] .dataType =
  idData id.asIdInfo optional.wrap return
end
proc(
  Operation : op0
  TypeCheckState ptr.mut : state
-> ) =>: typeCheckOp
  op0 =:: mut: op
  state [] .program =:: program
  state [] .program [] .errors @ =:: errors
  state [] .program [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  op .dataType .autoType ?? if ## try resolving auto-types
    op .dataType types.getTypeId =:: id
    id 0 >= and id i64 cast.s program [] .autoTypes .length < if
      program [] .autoTypes id list.get =:: autoType
      autoType .undefined ?? ! if
        autoType op .dataType =
      end
    end
  end
  state inSwitchLabel and op @ state typeCheckSwitchLabel if
    return
  end
  op .val .getName ?? if
    op .val .getName
      op @ state resolveIdentifer
    ..dup optional.hasData if
      .data op .val .getId =
    else ..drop end
  else op .val .atName ?? _if
    op .val .atName
      op @ state resolveIdentifer
    ..dup optional.hasData if
      .data op .val .atId =
    else ..drop end
  else op .val .existsName ?? _if
    types.primitive.BOOL op .dataType =
    op .val .existsName
      op@ state resolveIdentifer
    optional.hasData if
      true ConstValue .boolean op .val .Constant =
    else
      false ConstValue .boolean op .val .Constant =
    end
  else op .val .getId ?? and ## convert static arguments to constants
      op .val .getId .labelId =:: label
      label labelContext id.labelFlags id.FLAG_STATIC & ? and
      ConstValue .none =:: mut: argValue
      state [] .argData @ label map.at =:: argData?
      argData? optional.hasData _if
    argData? .data [] .valType op .dataType =
    argData? .data [] .value op .val .Constant =
  end
  state [] .interpreterActive =:: constEvalFailed ## true if operation was already evaluated
  state [] .interpreterActive and op @ state [] .interpreter @ evaluateOperation ! if
    return ## evaluate constants
  end
  state freezeInterpreter
  op @ state checkReachable
  op .val switch
    NOP case return
    Constant case
      op .dataType types.primitive.TYPE types.typeEquals if
        constEvalFailed or
            state unfreezeInterpreter
            op @ state [] .interpreter @ evaluateOperation if
          "could not evaluate " sb.wrap
            op program sb.appendOp
          op .pos errors appendError
        end
        return
      end
      op .val .Constant op .dataType op .pos state pushConstant
      return
    getName atName case
      "could not find identifier: " sb.wrap
        op .val .getName ?? if
          op .val .getName
        else
          op .val .atName
        end labelContext sb.appendLabelName
      op .pos errors appendError
      return
    getId case
      op .val .getId =:: idInfo
      idInfo .labelId labelContext id.labelFlags id.FLAG_MUTABLE & ? =:: mutable
      mutable if
        ConstValue .none
      else
        idInfo .idType switch
          TYPE PROCEDURE PROCEDURE_BUNDLE GLOBAL_VAR LOCAL_VAR case
            true break ## can hold identifer
          ARGUMENT LABEL TMP_VAR ITR_VAR case
            false break
        end if
          ## getIdentifierByLabel
            idInfo .labelId
            idContext
          id.getIdentifier if ..drop
            "could not find " sb.wrap
              idInfo labelContext sb.appendIdInfo
            op .pos errors appendError
            return
          end =:: idData
          idData [] .constValue
        else
          ConstValue .none
        end
      end =:: constValue
      idInfo .idType switch
        GLOBAL_VAR LOCAL_VAR TMP_VAR ITR_VAR case
          ## pushValue
            op .dataType
              mutable
            typeContext types.newReferenceType
            constValue
            op
          state pushValue
          op .val .getId .labelId state replaceLabel
          mutable ! true 0 0 state updateOpInfo
          mutable if ## insert copy for mutable values
            state wrapCopy
          end
          return
        TYPE case
          op .dataType constValue op state pushValue
          op .val .getId .labelId state replaceLabel
          true true 0 0 state updateOpInfo
          return
        ARGUMENT case
          op .val .getId .labelId =:: label
          ConstValue .none =:: mut: argValue
          state [] .argData @ label map.at =:: argData?
          argData? optional.hasData if
            argData? .data [] .valType op .dataType =
            argData? .data [] .value argValue =
          end
          op .dataType argValue op state pushValue
          label state replaceLabel
          true true 0 0 state updateOpInfo
          return
        PROCEDURE PROCEDURE_BUNDLE case
          idInfo .idType .PROCEDURE ?? if
            constValue .procedure@ =:: procId
            program [] .procedures
              procId [] i64 cast list.at .data
            =:: procData
            procData [] .isStatic if
              constEvalFailed or
                  state unfreezeInterpreter
                  op @ state [] .interpreter @ evaluateOperation if
                "could not evaluate " sb.wrap
                  op program sb.appendOp
                op .pos errors appendError
              end
              return
            end
            procId array.wrap
          else  ## PROCEDURE_BUNDLE
