        ## getAddressType
          op [] .dataType
          idInfo .labelId labelContext id.labelFlags id.FLAG_MUTABLE & 0 !=
          typeContext
        types.getAddressType op [] .dataType =
      end
      op state pushValue
      op [] .val OpValue .getId == if
        idInfo .labelId labelContext id.labelFlags id.FLAG_MUTABLE & 0 != state [] .typeStack list.peek .data [] .writable =
      end
      return
    PROCEDURE case
      op [] .val OpValue .getId == if
        ## typeCheckCall
          op
          op [] .val .getId .templateId
          op [] .val .getId .id @ optional.wrap
          CallType .PROC
