struct(
  Type         : mut: valueType
  ConstValue   : mut: value
  FilePosition : mut: pushedAt
  i32          : mut: opIndex
) =:: TypeInfo

-1:i32 =:: OP_UNLINKED
-2:i32 =:: OP_EMPTY

16:i16 =:: MAX_EXPANSION_DEPTH

struct(
  branchTree.NodeId : node
  FilePosition : pos
) =:: BranchPoint
i32 =:: IfBlockFlags
namespace: IfBlockFlags
  0:IfBlockFlags =:: none
  0x0001:IfBlockFlags =:: hasIf
  0x0002:IfBlockFlags =:: hasElse
  0x0004:IfBlockFlags =:: ifBranchTerminates
  0x0008:IfBlockFlags =:: hasAndIf
  0x0010:IfBlockFlags =:: hasOrIf
  0x0020:IfBlockFlags =:: skipElse
  0x0040:IfBlockFlags =:: skippedIf
  ( IfBlockFlags IfBlockFlags -> IfBlockFlags ) : alias: or i32.or
  ( IfBlockFlags IfBlockFlags -> IfBlockFlags ) : alias: and i32.and
  ( IfBlockFlags -> IfBlockFlags ) : alias: flip i32.flip
  ( IfBlockFlags -> bool ) : alias: toBool i32.toBool
end
overload: & IfBlockFlags.and end
overload: | IfBlockFlags.or end
overload: ~ IfBlockFlags.flip end
overload: ? IfBlockFlags.toBool end
struct(
  branchTree.NodeId : branchRoot
  BranchPoint : ifBranch
  BranchPoint list : andBranches
  BranchPoint list : orBranches
  i32 list : andOrPositions
  i32 : ifCastsOffset
  BlockId : blockId
  IfBlockFlags : flags
) =:: IfBlockInfo
struct(
  Type : switchType
  branchTree.NodeId : branchRoot
  BranchPoint list : mut: caseBranches
  i32 list : mut: castOffsets
  i32 list : mut: breakPositions
  JumpDistance list : mut: caseJumpDistances
  LabelId : blockLabel
  BlockId : blockId
  i32 : switchPosition
  IdentifierInfo optional : srcVar
  bool : mut: inLabel
  bool : mut: allowBreak
) =:: SwitchBlockInfo
struct(
  BranchPoint : branchRoot
  BranchPoint list : mut: breakBranches
  i32 list : mut: breakCastOffsets
  BranchPoint list : mut: continueBranches
  i32 list : mut: continueCastOffsets
  BranchPoint list : mut: doBranches
  i32 : mut: doBranchIndex ## index of do-branch in break branches
  i32 list : mut: labelPositions
  i32 : mut: orCount
  i32 : mut: continueCount
  LabelId : blockLabel
  BlockId : blockId
  i32 : whilePosition
  bool : mut: hasFinally
) =:: WhileBlockInfo
struct(
  BranchPoint list : mut: branches
  i32 list : mut: andOrPositions
  BlockId : blockId
) =:: AndOrBlockInfo
union(
  _ : Unknown
  Type : Procedure
  IfBlockInfo : mut: If
  SwitchBlockInfo : mut: Switch
  WhileBlockInfo : mut: While
  AndOrBlockInfo : mut: AndOr
) =:: BlockInfo
proc( branchTree.NodeId : branchRoot BlockId : blockId FilePosition : pos -> BlockInfo ) =>: newIfBlock
  ## IfBlockInfo
    branchRoot
    -1:branchTree.NodeId pos BranchPoint new ## dummy value
    8 BranchPoint list.create
    8 BranchPoint list.create
    16 i32 list.create
    -1
    blockId
    IfBlockFlags.none
  IfBlockInfo new BlockInfo .If return
end
proc(
  Type : switchType
  branchTree.NodeId : branchRoot
  IdentifierInfo optional : srcVar
  LabelId : blockLabel
  BlockId : blockId
  i32 : switchPosition
  FilePosition : pos
-> BlockInfo ) =>: newSwitchBlock
  ## SwitchBlockInfo
    switchType
    branchRoot
    16 BranchPoint list.create
    16 i32 list.create
    16 i32 list.create
    16 JumpDistance list.create
    blockLabel
    blockId
    switchPosition
    srcVar
    true
    false
  SwitchBlockInfo new BlockInfo .Switch return
end
proc(
  branchTree.NodeId : branchRoot
  LabelId : blockLabel
  BlockId : blockId
  i32 : whilePosition
  FilePosition : pos
-> BlockInfo ) =>: newWhileBlock
  ## WhileBlockInfo
      branchRoot
      pos
    BranchPoint new
    16 BranchPoint list.create
    16 i32 list.create
    16 BranchPoint list.create
    16 i32 list.create
    16 BranchPoint list.create
    -1
    16 i32 list.create
    0:i32
    0:i32
    blockLabel
    blockId
    whilePosition
    false
  WhileBlockInfo new BlockInfo .While return
end
proc(
  branchTree.NodeId : branchRoot
  BlockId : blockId
  i32 : blockStart
  FilePosition : pos
-> BlockInfo ) =>: newAndOrBlock
  ## AndOrBlockInfo
    16 BranchPoint list.create
      branchRoot
      pos
    BranchPoint new list.append
    16 i32 list.create blockStart list.append
    blockId
  AndOrBlockInfo new BlockInfo .AndOr return
end
"if-else" =:: IF_BLOCK_INFO_NAME
"switch-case" =:: SWITCH_BLOCK_INFO_NAME
"while" =:: WHILE_BLOCK_INFO_NAME
"and-or" =:: AND_OR_BLOCK_INFO_NAME
namespace: sb
  proc( stringBuilder BlockInfo -> stringBuilder ) =>: appendBlockInfoName
    switch
      Unknown case "unknown" sb.appendS return
      Procedure case "procedure" sb.appendS return
      If case IF_BLOCK_INFO_NAME sb.appendS return
      Switch case SWITCH_BLOCK_INFO_NAME sb.appendS return
      While case WHILE_BLOCK_INFO_NAME sb.appendS return
      AndOr case AND_OR_BLOCK_INFO_NAME sb.appendS return
    end
  end
end

