struct( Type : mut valType i32 : mut opCount bool : mut writable ) =:: TypeInfo
struct( Operation list : mut opStack TypeInfo list : mut typeStack ) =:: StackState
struct( StackState : mut inTypes StackState : mut outTypes i64 : mut elsePos bool : mut elseReachable ) =:: IfBlockData
struct( StackState : inTypes StackState : mut outTypes Type : switchType bool : mut endReachable bool : mut explicitBreak ) =:: SwitchBlockData
struct( StackState : mut inTypes StackState : mut outTypes bool : mut hasOutTypes bool : mut doesLoop ) =:: WhileBlockData
enum( empty IfBlockData : mut ifBlock WhileBlockData : mut whileBlock SwitchBlockData : mut switchBlock Type : procBlock ) =:: BlockData
struct( BlockData : mut blockData FilePosition : startPos i64 : blockStart i32 : blockId BlockType : mut blockType ) =:: BlockInfo
struct(
  IdentifierContext ptr mut : mut idContext

  Operation list : mut compiledOps

  Operation list : mut opStack
  TypeInfo list : mut typeStack
  BlockInfo list : mut openBlocks

  Type list : mut autoTypes
  SwitchData list : mut switchData
  CompilerError list : mut errors

  FileId : mut fileId
  i32 : mut tmpCount
  i32 : mut ifCount
  i32 : mut whileCount

  bool : mut reachable
  bool : mut hasCheckIndex
  bool : mut hasCheckEnum
  bool : mut hasGetArgs
) =:: TypeCheckState

#namespace sb
proc( stringBuilder : sb bool : printOps i64 : maxTypes TypeCheckState ptr mut : state => stringBuilder ) =: appendTypeStack
  state [] .idContext =:: idContext
  idContext [] .labelContext @ =:: labelContext
  idContext [] .typeContext @ =:: typeContext
  state [] .opStack .length =:: mut offset
  maxTypes =:: mut remaining
  sb
    state [] .typeStack .length 1 - while #dup 0 >= do
      #swap
        remaining 0 == if
          #swap #drop return
        end
        remaining 1 - remaining =
        state [] .typeStack #over:2 list.at .data =:: elt
        elt [] .writable if
          "writable " sb.appendS
        end
        elt [] .valType labelContext typeContext sb.appendType
        printOps ! if
          '\n' sb.appendC
          #swap 1 - continue
        end
        ' ' sb.appendC
        elt [] .opCount sb.appendI
        ":\n" sb.appendS
        offset elt [] .opCount - offset =
        offset 0 < if
          "out of sync\n" sb.appendS
        end
        0 while #dup elt [] .opCount < do
          #swap
          "   " sb.appendS
          state [] .opStack offset #over:3 + list.get idContext [] .constContext @ labelContext typeContext sb.appendOp
          #swap 1 +
        end #drop
      #swap 1 -
    end #drop
  return
end
#end
proc( bool : printOps i32 : maxTypes TypeCheckState ptr mut : state => ) =: printTypes
  printOps if "stack:\n" sb.wrap else "types:\n" sb.wrap end
    "-----------------\n" sb.appendS
    printOps maxTypes state sb.appendTypeStack
    "-----------------\n" sb.appendS
  io.stdOut #swap io.fputSb #drop
end
proc( TypeCheckState ptr mut : state => ) =: printTypesDebug
  0 sb.create
    "-----------------\n" sb.appendS
    true -1 state sb.appendTypeStack
  io.stdOut #swap io.fputSb #drop
end

proc( stringBuilder : msg FilePosition : pos TypeCheckState ptr mut : state => ) =: appendError2
  msg pos state [] .errors @ appendError
end
proc( => StackState ) =: emptyStackState
    0 Operation list.create
    0 TypeInfo  list.create
  StackState new return
end
proc( TypeCheckState ptr mut : state => StackState ) =: copyStack
    0 Operation list.create
      state [] .opStack list.appendAll
    0 TypeInfo  list.create
      state [] .typeStack list.appendAll
  StackState new return
end
proc( StackState ptr : src TypeCheckState ptr mut : state => ) =: resetStack
  state [] .opStack list.clear
    src [] .opStack list.appendAll
  state [] .opStack =
  state [] .typeStack list.clear
    src [] .typeStack list.appendAll
  state [] .typeStack =
end
proc( StackState ptr : src => ) =: freeStackState
  src [] .opStack list.free #drop
  src [] .typeStack list.free #drop
end

## returns the number of elements in the opStack corresponding to the elements starting at index from in the typeStack
##  ( with 0 being the index of the top stack element )
proc( i64 : from i64 : len TypeCheckState ptr mut : state => i64 ) =: countStackOps
  0 =:: mut count
  state [] .typeStack .length from - =:: offset
  1 while #dup len <= do
    state [] .typeStack offset #over:2 - list.at #dup optional.hasData if .data
      count #swap  [] .opCount + count =
    else #drop end
    1 +
  end #drop
  count return
end
proc( TypeCheckState ptr mut : state => bool ) =: checkSync
  state [] .opStack .length 0 <  state [] .typeStack .length 0 < |
  0 state [] .typeStack .length state countStackOps state [] .opStack .length != | return
end
proc( Type : valType => TypeInfo ) =: newTypeInfo
  ## TypeInfo
    valType
    1
    false
  TypeInfo new return
end
proc( bool : mutable FilePosition : pos TypeCheckState ptr mut : state => IdentifierInfo ) =: newTmpVar
  state [] .idContext =:: idContext
  idContext [] .labelContext @ =:: labelContext
  id.FLAG_NONE mutable if id.FLAG_MUTABLE | LabelFlag cast end =:: flags
  ## IdInfo
    IdentifierType .TMP_VAR
    ## newLabel
      string.empty
      flags
      pos
      state [] .fileId
      labelContext
    id.newLabel
    ConstValue .none
    -1
    state [] .tmpCount
      #dup 1 + state [] .tmpCount =
  IdentifierInfo new return
end

proc( TypeCheckState ptr mut : state => ) =: ensureStackHeadIsValue
  state [] .openBlocks .length 0 == if
    return ## no extracting of values at global level XXX ? allow stack operations at global level
  end
  state [] .typeStack .length 0 == if
    return
  end
  state [] .idContext =:: idContext
  idContext [] .typeContext @ =:: typeContext
  state [] .typeStack list.peek .data =:: head
  head [] .opCount 0 == if
    return
  end
  state [] .opStack #dup .length head [] .opCount - list.at .data =:: opHead
  head [] .valType typeContext types.isMultiValueType ! head [] .writable ! & if
    return
  end
  ## XXX? isStackValue flag for TypeInfo
  head [] .writable head [] .valType typeContext types.isMultiValueType ! | if
    opHead [] .val OpValue .getId != if
      opHead [] .val OpValue .getElement !=
      opHead [] .val OpValue .getArrayElement != &
      opHead [] .val OpValue .getEnumElement != & if
        return
      end
      ## TODO keep access to pointer to stack-values intact
    else opHead [] .val .getId .idType IdentifierType .TMP_VAR == _if
      return
    end
  end
  ## immutable mult-val type or writable multi-value that does not lie on the stack
  true opHead [] .pos state newTmpVar =:: tmpId
  opHead [] .dataType typeContext types.isEmpty ! if
    state [] .compiledOps
      ## opInitializeId
        head [] .valType
        tmpId
        opHead [] .pos
      opInitializeId list.append
    state [] .compiledOps =
    state [] .compiledOps
      state [] .opStack .data state [] .opStack .length + head [] .opCount - head [] .opCount array.create list.appendArray
    state [] .compiledOps =
  end
  state [] .opStack .length head [] .opCount - state [] .opStack .length =
  state [] .opStack
    ## opGet
      head [] .valType
      tmpId
      opHead [] .pos
    opGet list.append
  state [] .opStack =
  1 head [] .opCount =
  true head [] .writable =
end
proc( Type : valType TypeCheckState ptr mut : state => ) =: pushType
  state [] .typeStack
     valType newTypeInfo list.append
  state [] .typeStack =
end
proc( Operation ptr : op TypeCheckState ptr mut : state => ) =: pushValue
  state ensureStackHeadIsValue
  state [] .opStack
    op list.appendP
  state [] .opStack =
  op [] .dataType state pushType
end
proc( Operation ptr : op i64 : typeCount TypeCheckState ptr mut : state => ) =: insertStackOp
  typeCount state [] .typeStack .length > if
    "type stack underflow" sb.wrap op [] .pos state appendError2
    return
  end
  0
    state [] .typeStack .length typeCount - while #dup state [] .typeStack .length  < do
      #swap
        state [] .typeStack #over:2 list.get .opCount +
      #swap 1 +
    end #drop
  =:: totalOps
  state [] .opStack
    #dup .length 1 + list.ensureCap
  state [] .opStack =
  state [] .opStack .length totalOps - =:: offset
  state [] .opStack
    op offset list.insertP
  state [] .opStack  =
  state [] .typeStack .length
    typeCount -
  state [] .typeStack .length =
  op [] .dataType state pushType
  totalOps 1 + state [] .typeStack list.peek .data [] .opCount =
end
enum( ALL NON_EMPTY NONE ) =:: CompileType
proc( i64 : count FilePosition : pos TypeCheckState ptr mut : state CompileType : compileOps => ) =: processStackOps
  state [] .idContext =:: idContext
  idContext [] .typeContext @ =:: typeContext
  state [] .typeStack .length count -
  #dup 0 < if #drop
    "type stack underflow" sb.wrap pos state appendError2
    0 i64 cast
  end =:: typeOffset
  0
    typeOffset while #dup state [] .typeStack .length < do
      #swap
        state [] .typeStack #over:2 list.get .opCount +
      #swap 1 +
    end #drop
  =:: opCount
  state [] .opStack .length opCount - =:: opOffset
  compileOps switch
    NONE case break
    ALL case ## add operations to compiled code
      state [] .compiledOps #dup .length opCount + list.ensureCap state [] .compiledOps =
      state [] .compiledOps
        state [] .opStack .data opOffset + opCount array.create list.appendArray
      state [] .compiledOps =
    break
    NON_EMPTY case ## add operations to compiled code
      state [] .compiledOps #dup .length opCount + list.ensureCap state [] .compiledOps =
      state [] .opStack .data opOffset + opCount array.create =:: ops
      state [] .compiledOps
        0 while #dup ops .length < do
          #swap
            ops #over:2 array.at .data #dup [] .dataType typeContext types.isEmpty ! if
              list.appendP
            else #drop end
          #swap 1 +
        end #drop
      state [] .compiledOps =
    break
  end
  ## remove operations from stack
  opOffset state [] .opStack .length =
  typeOffset state [] .typeStack .length =
end
proc( i64 : count FilePosition : pos TypeCheckState ptr mut : state => ) =: addCompiledStackOps
  count pos state CompileType .ALL processStackOps
end
proc( i64 : count FilePosition : pos TypeCheckState ptr mut : state => ) =: discardStackOps
  count pos state CompileType .NONE processStackOps
end
proc( i64 : count bool : keepWritable FilePosition : pos TypeCheckState ptr mut : state => ) =: extractCompositeOps
  state [] .idContext =:: idContext
  idContext [] .typeContext @ =:: typeContext
  state [] .openBlocks .length 0 == if
    return ## don't extract composites at global level
  end
  state [] .typeStack .length count -
  #dup 0 < if #drop
    "type stack underflow" sb.wrap pos state appendError2
    0 i64 cast
  end =:: typeOffset
  state [] .opStack .length
    typeOffset while #dup state [] .typeStack .length < do
      #swap
        state [] .typeStack #over:2 list.get .opCount -
      #swap 1 +
    end #drop
  =:: mut opOffset
  opOffset =:: mut newOffset
  typeOffset while #dup state [] .typeStack .length < do
    state [] .typeStack #over list.at .data =:: typeInfo
    typeInfo [] .opCount 0 <= if
      1 + continue
    end
    typeInfo [] .opCount 1 == if
      opOffset newOffset != if
        state [] .opStack .data opOffset [] state [] .opStack .data newOffset [] =
      end
      opOffset 1 + opOffset =
      newOffset 1 + newOffset =
      1 + continue
    end
    keepWritable typeInfo [] .writable & if
      state [] .opStack opOffset list.at .data =:: opHead
      state [] .typeStack list.peek .data =:: stackHead
      opHead [] .val switch
        getId case ## writable getId -> access to writable variable
          opHead [] .val .getId opHead [] .val .@Id =
          opHead [] .dataType true typeContext types.getAddressType opHead [] .dataType =
          opHead [] .dataType stackHead [] .valType =
          break
        getElement case
          opHead [] .val .getElement opHead [] .val .@Element =
          stackHead [] .valType true typeContext types.getAddressType stackHead [] .valType =
          break
        getArrayElement case
          opHead [] .val .getArrayElement opHead [] .val .@ArrayElement =
          stackHead [] .valType true typeContext types.getAddressType stackHead [] .valType =
          break
        default
          opOffset newOffset != if
            state [] .opStack .data newOffset + state [] .opStack .data opOffset + typeInfo [] .opCount mem.move #drop
          end
          opOffset typeInfo [] .opCount + opOffset =
          newOffset typeInfo [] .opCount + newOffset =
          1 + continue
      end
      false pos state newTmpVar =:: tmpId
      state [] .compiledOps
        ## opInitializeId
          stackHead [] .valType
          tmpId
          pos
        opInitializeId list.append
        state [] .opStack .data opOffset + typeInfo [] .opCount array.create list.appendArray
      state [] .compiledOps =
      opOffset typeInfo [] .opCount + opOffset =
      ## opArrayGet
        0
        pos
      opArrayGet
        stackHead [] .valType #over .dataType =
        0 #over .val .getArrayElement =
      state [] .opStack .data newOffset [] =
      newOffset 1 + newOffset =
      ## opGet
        stackHead [] .valType
        tmpId
        pos
      opGet state [] .opStack .data newOffset [] =
      newOffset 1 + newOffset =
      2 typeInfo [] .opCount =
      1 + continue
    end
    false pos state newTmpVar =:: tmpId
    state [] .compiledOps
      ## opInitializeId
        typeInfo [] .valType
        tmpId
        pos
      opInitializeId list.append
      state [] .opStack .data opOffset + typeInfo [] .opCount array.create list.appendArray
    state [] .compiledOps =
    opOffset typeInfo [] .opCount + opOffset =
    ## opGet
      typeInfo [] .valType
      tmpId
      pos
    opGet state [] .opStack .data newOffset [] =
    newOffset 1 + newOffset =
    1 typeInfo [] .opCount =
    1 +
  end #drop
  newOffset state [] .opStack .length =
end

proc( bool : breakSwitch TypeCheckState ptr mut : state => BlockInfo ptr mut optional ) =: findBreakableBlock
  state [] .openBlocks .length 1 - while #dup 0 >= do
    state [] .openBlocks #over list.at
      #dup .data [] .blockType #dup BlockType .WHILE == #swap BlockType .DO == | if
        #swap #drop
        return
      end
      breakSwitch #over .data [] .blockType #dup BlockType .CASE == #swap BlockType .DEFAULT == | & if
        #swap #drop
        return
      end
    #drop
    1 -
  end #drop
  BlockInfo ptr mut optional.empty return
end
proc( TypeCheckState ptr mut : state => i32 ) =: findEnclosingIfId
  state [] .openBlocks .length 1 - while #dup 0 >= do
    state [] .openBlocks #over list.at
      #dup .data [] .blockType BlockType .IF == if
        #swap #drop
        .data [] .blockId return
      end
    #drop
    1 -
  end #drop
  -1 return
end

proc( Type : a Type : b Type 2 ptr mut : inTypes TypeContext ptr mut : context => Type ) =: checkBinOpNumber
  a b context types.commonNumberType
    #dup Type .undefined types.typeEquals ! if
      #dup inTypes 0 [] =
      #dup inTypes 1 [] =
    end
  return
end
proc( Type : a Type : b Type 2 ptr mut : inTypes TypeContext ptr mut : context => Type ) =: checkBinOpInt
  a b context types.commonIntType
    #dup Type .undefined types.typeEquals ! if
      #dup inTypes 0 [] =
      #dup inTypes 1 [] =
    end
  return
end

proc( Type arrayView : types string : opName FilePosition : pos TypeCheckState ptr mut : state => ) =: requireTypes
  state [] .idContext =:: idContext
  idContext [] .labelContext @ =:: labelContext
  idContext [] .typeContext @ =:: typeContext
  state [] .typeStack .length types .length < if
    "not enough types for " sb.wrap
      opName sb.appendStr
      " need " sb.appendS
      types .length sb.appendI
      " have " sb.appendS
      state [] .typeStack .length sb.appendI
    pos state appendError2
    return
  end
  0 =:: mut nCasts
  false =:: mut isError
  state [] .opStack .length =:: mut opOffset
  1 while #dup types .length <= do
    state [] .typeStack #dup .length #over:2 - list.at .data =:: src
    types #dup .length #over:2 - array.get =:: expected
    opOffset src [] .opCount - opOffset =
    src [] .valType expected types.typeEquals if
      1 + continue
    end
    src [] .valType expected typeContext types.canAutoCast if
      expected typeContext types.isUnion ! if ## TODO casting of union constants (remember original type)
        src [] .opCount 1 == state [] .opStack opOffset list.at .data #swap #over [] .val OpValue .Constant == & if
          expected #swap [] .dataType =
          expected src [] .valType =
          1 + continue
        else #drop end
      end
      nCasts 1 + nCasts =
      1 + continue
    end
    "wrong type for " sb.wrap
      opName sb.appendStr
      " expected " sb.appendS
      expected labelContext typeContext sb.appendType
      " got " sb.appendS
      src [] .valType labelContext typeContext sb.appendType
    pos state appendError2
    true isError =
    1 +
  end #drop
  nCasts 0 == isError | if
    return
  end
  state [] .opStack .length =:: mut offset
  0 =:: mut shiftCount
  state [] .opStack #dup .length nCasts + list.ensureCap state [] .opStack =
  state [] .opStack .length nCasts + state [] .opStack .length =
  1 while #dup types .length <= do
    state [] .typeStack #dup .length #over:2 - list.at .data =:: op
    types #dup .length #over:2 - array.get =:: expected
    offset op [] .opCount - offset =
    shiftCount op [] .opCount + shiftCount =
    op [] .valType expected types.typeEquals if
      1 + continue
    end
    state [] .opStack .data offset + nCasts + state [] .opStack .data offset + shiftCount mem.move #drop
    0 shiftCount =
    nCasts 1 - nCasts =
    op [] .valType expected typeContext types.canAutoCast ! if
      "unexpected type conversion" sb.wrap pos state appendError2
    end
    ## op
      op [] .valType
      expected
      pos
    opCastFrom state [] .opStack .data offset + nCasts + [] =
    op [] .opCount 1 + op [] .opCount =
    expected op [] .valType =
    1 +
  end #drop
end

proc( bool : keepTop FilePosition : pos TypeCheckState ptr mut : state => i64 ) =: storeStack
  state [] .idContext =:: idContext
  idContext [] .labelContext @ =:: labelContext
  idContext [] .typeContext @ =:: typeContext
  0 =:: mut opOffset
  state [] .typeStack .length
    keepTop if 1 - end
  =:: count
  0 while #dup count < do
    state [] .typeStack #over list.at .data =:: typeInfo
    typeInfo [] .opCount 1 == typeInfo [] .writable & if
      state [] .opStack opOffset list.at .data =:: op
      op [] .val OpValue .getId == if
        op [] .val .getId .idType IdentifierType .TMP_VAR == op [] .val .getId .labelId labelContext id.labelFlags id.FLAG_MUTABLE & 0 != & if
          ## stack element is already mutable temporary variable
          op [] state [] .opStack .data #over:2 [] =
          opOffset typeInfo [] .opCount + opOffset =
          1 +
          continue
        end
      end
    end
    true pos state newTmpVar =:: tmpId
    state [] .compiledOps
      ## opInitializeId
        typeInfo [] .valType
        tmpId
        pos
      opInitializeId list.append
    state [] .compiledOps =
    state [] .compiledOps
      state [] .opStack .data opOffset + typeInfo [] .opCount array.create list.appendArray
    state [] .compiledOps =
    opOffset typeInfo [] .opCount + opOffset =
    ## opGet
      typeInfo [] .valType
      tmpId
      pos
    opGet state [] .opStack .data #over:2 [] =
    1 typeInfo [] .opCount =
    true typeInfo [] .writable =
    1 +
  end return
end
proc( StackState ptr : inTypes StackState ptr mut : outTypes bool : create BlockType : blockName i64 : blockStart bool : ignoreLast FilePosition : pos TypeCheckState ptr mut : state => ) =: storeOutTypes
  state [] .idContext =:: idContext
  idContext [] .labelContext @ =:: labelContext
  idContext [] .typeContext @ =:: typeContext
  state [] .typeStack .length
    ignoreLast if 1 - end
  =:: nTypes
  create if
    nTypes =:: mut newTypes
    outTypes [] .opStack
      inTypes [] .opStack .length list.ensureCap
    outTypes [] .opStack =
    0 while #dup inTypes [] .typeStack .length < #over nTypes < & do
      inTypes [] .typeStack #over list.get .valType state [] .typeStack #over:2 list.get .valType types.typeEquals ! if
        break
      end
      outTypes [] .opStack
        inTypes [] .opStack #over:2 list.at .data list.appendP
      outTypes [] .opStack =
      newTypes 1 - newTypes =
      1 +
    end #drop
    newTypes 0 > if
      state [] .compiledOps
        #dup .length state [] .opStack .length + newTypes + list.ensureCap
      state [] .compiledOps =
      state [] .compiledOps .data blockStart + =:: codeStart
      ## mem.move
        codeStart newTypes +
        codeStart
        state [] .compiledOps .length blockStart -
      mem.move #drop
      state [] .compiledOps .length newTypes + state [] .compiledOps .length =
    end
  else
    nTypes outTypes [] .typeStack .length != if
      "wrong number of types at the " sb.wrap
        blockName BlockType .IFIF == if
          "beginning of " sb.appendS
        else
          "end of " sb.appendS
        end
        blockName sb.appendBlockType
        "-statement expected " sb.appendS
        outTypes [] .typeStack .length sb.appendI
        " got " sb.appendS
        nTypes sb.appendI
      pos state appendError2
      return
    end
  end
  IdentifierInfo : mut tmpId
  0 =::  mut opOffset
  blockStart =:: mut newBlockStart
  0 while #dup nTypes < do
    state [] .typeStack #over list.at .data =:: typeInfo
    state [] .opStack opOffset list.at .data =:: op
    create #over outTypes [] .opStack .length >= & if
      true pos state newTmpVar tmpId =
      ## opDeclareId
        typeInfo [] .valType
        tmpId
        pos
      opDeclareId state [] .compiledOps .data newBlockStart [] =
      newBlockStart 1 + newBlockStart =
      outTypes [] .opStack
        ## opGet
          typeInfo [] .valType
          tmpId
          pos
        opGet list.append
      outTypes [] .opStack =
    else
      outTypes [] .opStack #over list.at .data =:: out
      out [] .val .getId tmpId =
      typeInfo [] .valType out [] .dataType types.typeEquals ! if
          "incompatible types at the " sb.wrap
            blockName BlockType .IFIF == if
              "beginning of " sb.appendS
            else
              "end of " sb.appendS
            end
            blockName sb.appendBlockType
            "-statement expected " sb.appendS
            out [] .dataType labelContext typeContext sb.appendType
            " got " sb.appendS
            typeInfo [] .valType labelContext typeContext sb.appendType
          pos state appendError2
      end
    end
    typeInfo [] .opCount 1 == op [] .val #swap #over OpValue .getId == & if
      .getId #dup .idType IdentifierType .TMP_VAR == #swap .id tmpId .id == & if ## assignment of tmp-var to itself
        op [] state [] .opStack #over:2 list.set
        opOffset 1 + opOffset =
        1 + continue
      end
    else #drop end
    state [] .compiledOps
      ## opSet
        typeInfo [] .valType
        tmpId
        pos
      opSet list.append
      state [] .opStack .data opOffset + typeInfo [] .opCount array.create list.appendArray
    state [] .compiledOps =
    opOffset typeInfo [] .opCount + opOffset =
    ## opGet
        typeInfo [] .valType
        tmpId
        pos
    opGet state [] .opStack #over:2 list.set
    1 typeInfo [] .opCount =
    tmpId .labelId labelContext id.labelFlags id.FLAG_MUTABLE & 0 != typeInfo [] .writable =
    1 +
  end #drop
  ignoreLast if
    state [] .typeStack list.peek .data [] .opCount =:: stackHeadOps
    state [] .opStack .data nTypes + state [] .opStack .data opOffset + stackHeadOps mem.move #drop
    nTypes stackHeadOps + state [] .opStack .length =
  else
    nTypes state [] .opStack .length =
  end
  create if
    outTypes [] .typeStack
      state [] .typeStack list.appendAll
    outTypes [] .typeStack =
    ignoreLast if ## don't store last element
      outTypes [] .typeStack .length 1 - outTypes [] .typeStack .length =
    end
  end
end
proc( BlockInfo ptr mut : whileBlock FilePosition : pos TypeCheckState ptr mut : state => ) =: storeLoopInTypes
  whileBlock [] .blockData .whileBlock .inTypes @ =:: inTypes
  inTypes inTypes false whileBlock [] .blockType whileBlock [] .blockStart false pos state storeOutTypes
end
proc( BlockInfo ptr mut : whileBlock bool : ignoreLast FilePosition : pos TypeCheckState ptr mut : state => ) =: storeLoopOutTypes
  whileBlock [] .blockData .whileBlock .hasOutTypes ! =:: create
  whileBlock [] .blockData .whileBlock .inTypes @ =:: inTypes
  whileBlock [] .blockData .whileBlock .outTypes @ =:: outTypes
  inTypes outTypes create whileBlock [] .blockType  whileBlock [] .blockStart ignoreLast pos state storeOutTypes
  true whileBlock [] .blockData .whileBlock .hasOutTypes =
end
proc( BlockInfo ptr mut : ifBlock bool : noElse FilePosition : pos TypeCheckState ptr mut : state => ) =: storeIfOutTypes
  noElse if false else ifBlock [] .blockData .ifBlock .elseReachable ! end =:: create
  ifBlock [] .blockData .ifBlock .inTypes @ =:: inTypes
  noElse if inTypes else ifBlock [] .blockData .ifBlock .outTypes @ end =:: outTypes
