proc( ProcData arrayView : possibleSignatures TypeCheckState ptr mut : state => ProcData optional ) =: resolveProcedureSignature
  state [] .idContext =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .labelContext @ =:: labelContext
  idContext [] .typeContext @ =:: typeContext
  0i64 =:: mut totalArgCount
  0 while #dup possibleSignatures .length < do
    possibleSignatures #over array.at .data [] .procType
      typeContext types.getProcIn #drop typeContext types.compositeEltCount totalArgCount +
    totalArgCount =
    1 +
  end #drop
  totalArgCount TemplateState list.create =:: mut emptyTemplateBuffer
  totalArgCount ConstValue list.create =:: mut genericArgBuffer
  possibleSignatures .length SignatureInfo list.create =:: mut signatures
  0 while #dup possibleSignatures .length < do
    possibleSignatures #over array.at .data [] =:: procData
    ## initialize buffers for arguments
    procData .procType typeContext types.getProcIn #drop typeContext types.compositeEltCount =:: nArgs
    procData .templateId idContext id.getTemplateInfo =:: templateInfo?
    templateInfo? optional.hasData if templateInfo? .data [] .templateType typeContext types.compositeEltCount else 0i64 end =:: tArgs
    emptyTemplateBuffer .length =:: emptyTemplatesOffset
    emptyTemplateBuffer .length tArgs + emptyTemplateBuffer .length =
    emptyTemplateBuffer .data tArgs mem.clear #drop
    genericArgBuffer .length =:: templatesOffset
    genericArgBuffer .length tArgs + genericArgBuffer .length =
    genericArgBuffer .data tArgs mem.clear #drop
    genericArgBuffer .length =:: autoArgsOffset
    genericArgBuffer .length nArgs + genericArgBuffer .length =
    genericArgBuffer .data nArgs mem.clear #drop
    signatures
      ## SignatureInfo
        procData
        0
        0
        tArgs
        emptyTemplatesOffset
        templatesOffset
        autoArgsOffset
      SignatureInfo new
    list.append signatures =
    1 +
  end #drop
  0 while #dup signatures .length < do
    signatures #over list.at .data [] =:: mut signature
    signature .procData .procType typeContext types.getProcIn #drop typeContext types.compositeElts =:: args
    args .length 1 - =:: mut argIndex
    state [] .typeStack .length 1 - =:: mut stackIndex
    while argIndex 0 >= stackIndex 0 >= & do
      args args .length #over:2 - array.at .data [] =:: argType
      state [] .typeStack #dup .length #over:2 - list.at .data [] .valType =:: stackType
      ## TODO handle autoArgs
      stackType typeContext types.isEmpty ! if
        argType typeContext types.isEmpty if
          argIndex 1 - argIndex =
          signature .matchedArgs 1 + signature .matchedArgs =
          continue ## skip current argument if argType is empty and stack-type is non-empty
        else argType typeContext types.maybeEmpty _if
          ## TODO add alternative signature with templates used in current argument set to empty
          ##   don't add new signature if templates already used as non-empty in previous argument
        end
      end
      ## XXX clear template-buffer
      ## TODO compare argType with stackType
      argIndex 1 - argIndex =
      stackIndex 1 - stackIndex =
    end
    signature signatures #over:2 list.set
    1 +
  end #drop
  ## TODO resolve procedure signature
  ## 1. check arguments right to left
  ##   -  resolve automatic arguments
  ##   -  find potentially empty arguments, add corresponding signatures to list of possible variants
  ##   -  check template types for each argument separately
  ## 2. go through possible signatures from left to right
  ##  - check if template arguments are consistent among signatures
  ## 3. pick best among the matching signatures
  ##  (- number of valid arguments )
  ##  (- number of matching generics )
  ##  - lowest number of necessary casts
  ##  - least template arguments
  ##  - lowest number of empty template arguments
  ##  - highest number of arguments
  ProcData optional.empty return
end

