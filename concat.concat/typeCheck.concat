    ## constantEquals
      switchData [] .labels i list.at .data [] .value
      label
      labelContext
    constantEquals if
      "duplicate label " sb.wrap
        ## TODO? print position of previous occurrence
        switchData [] .switchType typeContext types.isTaggedUnion if
          ## appendLabelName
            switchData [] .switchType
            label .enumLabel i64 cast typeContext types.compositeGetLabel
            labelContext
          sb.appendLabelName
        else
          label
            constContext
            typeContext
          sb.appendConstant
        end
