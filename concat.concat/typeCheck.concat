    state [] .compiledOps .data offset +
    count
    pos reserveOp
  mem.fill
  state [] .opInfo
  0:i64 while ..dup count < do =:: i
    ## OpInfo
      0
      0
      false
      false
    OpInfo new list.append
    i 1 +
  end ..drop
  state [] .opInfo =
  offset return
end
proc( TypeCheckState ptr.mut : state -> ) =>: wrapCopy
  state [] .program =:: program
