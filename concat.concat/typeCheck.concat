          ..dup typeContext types.isInt ! if
            "wrong operand for unary operator " sb.wrap
              op [] .val .unaryOperator sb.appendUnaryOperator
              " expected integer got " sb.appendS
              ..swap typeContext sb.appendType
            op [] .pos state appendError2
          else ..drop end
