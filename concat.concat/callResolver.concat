import arrayView

import "constants.concat"
import "types.concat"
import "program.concat"
import "interpreter.concat"

enum( MATCH GENERIC CAST AUTO EMPTY NONE ) =:: MatchType

struct(
  Type : valType
  ConstValue : value
) =:: export: StackValue

struct(
  i32 : argOffset
  i32 : mut: argCount
  MatchType : matchType
) =:: ParameterInfo

union(
  ConstValue : value
  ConstValue : fixed  ## value of generic cannot be changed
           _ : nonEmpty
) =:: GenericArg

struct(
  ProcId : procId
  ParameterInfo list : mut: paramInfo
  LabelId GenericArg hashMap : mut: genericValues
  i32 : mut: nEmpty
  i32 : mut: nRenames
  i32 : mut: nCasts
  i32 : mut: nGenerics
  i32 : mut: arraySizeArguments
  i32 : mut: signatureWeigth
  bool : mut: argsMatch
  bool : mut: needsParam
) =:: CallSignatureInfo

proc( types.ArraySize : size -> ConstValue ) =>: sizeAsConst
  size switch
    int case size .int ConstValue .Int return
    genericArg case size .genericArg ConstValue .GenericArg return
  end
end
proc( ConstValue : val -> types.ArraySize ) =>: constAsSize
  ConstValue ..length 23 == "no new constants" assert
  val switch
    Int case
      val .Int types.ArraySize .int return
    GenericArg case
      val .GenericArg types.ArraySize .genericArg return
    default ..unreachable
  end
end

proc(
  Type : src
  Type list ptr.mut : typeBuffer
  LabelId list ptr.mut : labelBuffer
  LabelId GenericArg hashMap ptr.mut : genericValues
  bool : replaceAutoArgs
  FilePosition : pos
  ProgramContext ptr.mut : progContext
-> Type ) =>: replaceGenerics
  progContext .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  idContext .constContext =:: constContext
  src typeContext types.containsGeneric ! if
    src return
  end
  src switch
    genericType case
      src types.getTypeId LabelId cast =:: genericId
      genericValues genericId map.at =:: value?
      value? optional.hasData if
        value? .data [] =:: value
        value switch
          fixed case
            value .fixed .TypeId return
          value case
            value .value .TypeId return
          nonEmpty case break
        end
      end
      src return ## generic not found XXX? error
    namedType case
      src typeContext types.namedTypeName =:: name
      src typeContext types.flatUnwrapNamed =:: base
      ## newNamedType
        ## replaceGenerics
          base
          typeBuffer
          labelBuffer
          genericValues
          replaceAutoArgs
          pos
          progContext
        replaceGenerics
        name
        typeContext
      types.newNamedType return
    pointer rawPointer arrayType case
      src typeContext types.getBaseType =:: base
      src typeContext types.getArraySize =:: sizes
      idContext [] .arraySizeBuffer .length =:: sizeOffset
      false =:: mut: genericSize
      0:i64 while ..dup sizes .length < do =:: i
        sizes i array.get =:: size
        idContext [] .arraySizeBuffer
          size switch
            int case
              size list.append break
            genericArg case
              size .genericArg =:: genericId
              genericId labelContext id.labelFlags id.FLAG_STATIC & ? ! if
                replaceAutoArgs ! if
                  size list.append break
                end
                true genericSize@ =
              end
              genericValues genericId map.at =:: newValue
              newValue optional.hasData if
                newValue .data [] .fixed constAsSize list.append
              else
                size list.append
              end
              break
          end
        idContext .arraySizeBuffer =
        i 1 +
      end ..drop
      ## newArrayType
        ## replaceGenerics
          base
          typeBuffer
          labelBuffer
          genericValues
          replaceAutoArgs
          pos
          progContext
        replaceGenerics
        src .pointer ?? or src .arrayType ?? and genericSize if
          types.ArrayType .POINTER
        else src .rawPointer ?? _if
          types.ArrayType .RAW_POINTER
        else
          types.ArrayType .ARRAY
        end
        idContext [] .arraySizeBuffer list.asArray
          sizeOffset
        array.tail
        src typeContext types.isMutable
        typeContext
      types.newArrayType
        idContext [] .arraySizeBuffer
          sizeOffset list.setLength
        idContext .arraySizeBuffer =
        ! "can create array" assert
      return
    struct union procIn procOut enum initializer case
      typeBuffer [] .length =:: typeOffset
      labelBuffer [] .length =:: labelOffset
      src typeContext types.compositeEltCount =:: eltCount
      0:i64 while ..dup eltCount < do =:: i
        ## replaceGenerics
          src i typeContext types.compositeGetElement
          typeBuffer
          labelBuffer
          genericValues
          replaceAutoArgs
          pos
          progContext
        replaceGenerics =:: newElt
        ## ! replaceGenerics changes type-buffer
        typeBuffer []
          newElt list.append
        typeBuffer []=
        labelBuffer []
          src i typeContext types.compositeGetLabel list.append
        labelBuffer []=
        i 1 +
      end ..drop
      ## newComposite
        typeBuffer [] list.asArray typeOffset array.tail
        labelBuffer [] list.asArray labelOffset array.tail optional.wrap
        typeContext
        src switch
          struct case types.newTuple break
          union case true ..swap types.newUnion break
          enum case types.newEnum break
          procIn procOut case src .procOut ?? ..swap types.newProcArgs false break
          ## TODO update initializer type
          initializer case ..drop.3 Type .undefined true break
          default ..unreachable
        end
        ## reset buffer
        typeBuffer [] typeOffset list.setLength typeBuffer []=
        labelBuffer [] labelOffset list.setLength labelBuffer []=
        ! "can create composite" assert
      return
    procedure case
      src typeContext types.getProcIn ..drop =:: inTypes
      src typeContext types.getProcOut ..drop =:: outTypes
      ## newProcedure
        inTypes
          typeBuffer labelBuffer genericValues replaceAutoArgs pos progContext
        replaceGenerics
        outTypes
          typeBuffer labelBuffer genericValues replaceAutoArgs pos progContext
        replaceGenerics
        src typeContext types.getCallConvention ..drop
        typeContext
      types.newProcedure
        ! "can create procedure" assert
      return
    generatedType case
      src typeContext types.getGeneratorArgs =:: args
      idContext .argBuffer =:: argBuffer
      argBuffer [] .length =:: argOffset
      0:i64 while ..dup args .length < do =:: i
        args i array.get =:: arg
        argBuffer []
          ConstValue ..length 23 == "no new constants" assert
          arg switch
            TypeId case
              arg .TypeId
                typeBuffer labelBuffer genericValues replaceAutoArgs pos progContext
              replaceGenerics ConstValue .TypeId
              break
            GenericArg case
              arg .GenericArg =:: argId
              genericValues argId map.at =:: val?
              val? optional.isEmpty if arg break end
              val? .data [] switch
                value case val? .data [] .value break
                fixed case val? .data [] .fixed break
                nonEmpty case arg break
              end
              break
            default arg break ## argument not generic
          end list.append
        argBuffer []=
        i 1 +
      end ..drop
      src typeContext types.getGeneratorLabel =:: generatorName
      argBuffer [] list.asArray argOffset array.tail =:: generatorArgs
      ##findGeneratedType
        generatorName
        generatorArgs
        false
        typeContext
        constContext
      types.findGeneratedType if ..drop ## new generated type
          ## initializeGeneratedType
            generatorName
            generatorArgs
            pos
            progContext
          interpreter.initializeGeneratedType ..drop
        end
        argBuffer []
          argOffset list.setLength
        argBuffer []=
      return
    undefined empty primitiveType cType arrayIndex autoType intLiteral align case
      ..unreachable ## type should not contain generics
  end
end

proc(
  Type : src0
  Type : target
  bool : exactMatch
  bool ptr.mut : needCast
  LabelId GenericArg hashMap ptr.mut : genericValues
  ProgramContext ptr.mut : progContext
-> bool ) =>: resolveGenerics
  progContext .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  idContext .constContext =:: constContext
  target typeContext types.containsGeneric ! if
    src0 target typeContext types.canAutoCast ! return
  end
  src0 =:: mut: src
  src .initializer ?? if
    target typeContext types.isArray and src typeContext types.isArrayLiteral if
      src typeContext types.initializerAsArray src@ =
    else src typeContext types.isArrayLiteral and target typeContext types.isArrayPointer _if
      src typeContext types.initializerAsPointer src@ =
    else
      src typeContext types.initializerAsTuple src@ =
    end
  end
  target switch
    genericType case
      target types.getTypeId LabelId cast =:: genericId
      genericValues genericId map.at =:: oldValue?
      oldValue? optional.hasData if
        oldValue? .data [] =:: oldValue
        oldValue switch
          nonEmpty case
            src .empty ?? if
              true return
            end
            src break
          fixed case
            oldValue .fixed .TypeId ?? ! if
              false return
            end
            exactMatch if ## XXX? allow unwrapping named types for exact match
              src oldValue .fixed .TypeId types.typeEquals ! if
                true return
              end
              src break
            else src oldValue .fixed .TypeId typeContext types.canAutoCast ! _if
              true return
            end
            oldValue .fixed .TypeId break
          value case
            oldValue .value .TypeId ?? ! if
              false return
            end
            exactMatch if
              oldValue .value .TypeId src typeContext types.canAutoCast ! if
                true return
              end
              src break
            end
            src oldValue .value .TypeId typeContext types.mergeTypes if ..drop
              true return
            end
            break
        end
      else
        src
      end =:: genericValue
      genericValues
        genericId
        genericValue ConstValue .TypeId exactMatch if
          GenericArg .fixed
        else
          GenericArg .value
        end
      map.put ..drop
      false return
    namedType case
      src =:: mut: unwrapSrc
      target =:: mut: unwrapTarget
      while
        unwrapSrc types.isNamedType if
          unwrapSrc typeContext types.flatUnwrapNamed unwrapSrc@ =
        end
        unwrapTarget typeContext types.flatUnwrapNamed unwrapTarget@ =
      unwrapTarget .namedType ?? do end
      ## resolveGenerics
        unwrapSrc
        unwrapTarget
        exactMatch
        needCast
        genericValues
        progContext
      resolveGenerics return
    pointer arrayType rawPointer case
      src typeContext types.isPointer ! and
          src typeContext types.isArray ! if
        true return
      end
      target typeContext types.isPointer src typeContext types.isPointer != if
        true return ## no implicit casts array <-> pointer
      end
      src typeContext types.isMutable =:: srcMutable
      target typeContext types.isMutable =:: targetMutable
      targetMutable and srcMutable ! if
        true return ## cannot cast immutable to mutable
      end
      srcMutable and targetMutable ! if
        true needCast []=
      end
      src typeContext types.isFixedSize =:: srcFixed
      target typeContext types.isFixedSize =:: targetFixed
      targetFixed and srcFixed ! if
        true return ## cannot assign unknown-size to fixed-size
      end
      src typeContext types.getArraySize =:: mut: srcSizes
      target typeContext types.getArraySize =:: mut: targetSizes
      ## treat 0D fixed arrays as 1D array of length 1
      1:i64 types.ArraySize .int =:: one
      srcFixed and srcSizes .length 0 == if
        one@ array.wrap srcSizes@ =
      end
      targetFixed and targetSizes .length 0 == if
        one@ array.wrap targetSizes@ =
      end
      targetFixed ! if
        srcSizes $ .length 1 - array.head srcSizes@ =
      end
      srcSizes .length targetSizes .length < if
        true return ## target sizes have to be matched
      end
      srcSizes
        srcSizes .length targetSizes .length -
      array.cutIndex =:: newSrcSizes =:: matchedSizes
      0:i64 while ..dup targetSizes .length < do =:: i
        matchedSizes i array.get =:: srcSize
        targetSizes i array.get =:: targetSize
        targetSize switch
          int case
            srcSize .int ?? ! if
              true return
            else srcSize .int targetSize .int != _if
              true return
            end
          break
          genericArg case
            targetSize .genericArg =:: genericId
            srcSize sizeAsConst =:: newValue
            genericValues genericId map.at =:: oldValue?
            oldValue? optional.hasData if
              oldValue? .data [] switch
                nonEmpty case break
                value case
                    oldValue? .data [] .value
                    newValue
                    labelContext
                  constantEquals ! if true return end
                  break
                fixed case
                    oldValue? .data [] .fixed
                    newValue
                    labelContext
                  constantEquals ! if true return end
                  break
              end
            end
            genericValues
              genericId
              newValue GenericArg .fixed
            map.put ..drop
            break
        end
        i 1 +
      end ..drop
      newSrcSizes .length 0 > if
        ## newArrayType
          src typeContext types.getBaseType
          types.ArrayType .ARRAY
          newSrcSizes
          srcMutable
          typeContext
        types.newArrayType ! "can create array" assert
      else
        src typeContext types.getBaseType
      end =:: srcBase
      ## resolveGenerics
        srcBase
        target typeContext types.getBaseType
        true
        needCast
        genericValues
        progContext
      resolveGenerics return
    struct union procIn procOut enum initializer case
      src typeContext types.unwrapNamed src@ =
      src ..label target ..label != if
        true return ## src and target have to be same type of composite
      end
      target typeContext types.compositeEltCount =:: targetCount
      src typeContext types.compositeEltCount =:: srcCount
      targetCount srcCount < if
        true return ## all types in source have to be matched to type in target
      end
      ## resolve generics for all elements of composite type
      0:i64 while ..dup targetCount < do =:: i
        target i typeContext types.compositeGetElement =:: targetElt
        i srcCount < if
          src i typeContext types.compositeGetElement
        else
          Type .empty ## extend source with empty if necessary
        end =:: srcElt
        ## resolveGenerics
          srcElt
          targetElt
          true
          needCast
          genericValues
          progContext
        resolveGenerics if
          true return
        end
        i 1 +
      end ..drop
      false return
    procedure case
      src typeContext types.unwrapNamed src@ =
      src ..label target ..label != if
        true return
      end
      ## separately run for in and out arguments
      ## resolveGenerics
        src typeContext types.getProcIn ..drop
        target typeContext types.getProcIn ..drop
        true
        needCast
        genericValues
        progContext
      resolveGenerics if
        true return
      end
      ## resolveGenerics
        src typeContext types.getProcOut ..drop
        target typeContext types.getProcOut ..drop
        true
        needCast
        genericValues
        progContext
      resolveGenerics if
        true return
      end
      false return
    generatedType case
      src typeContext types.unwrapNamedKeepGenerated src@ =
      ## src has to be a compatible generated type
      src types.isGeneratedType ! if
        true return
      else src typeContext types.getGeneratorLabel
           target typeContext types.getGeneratorLabel != _if
        true return
      end
      src typeContext types.getGeneratorArgs =:: srcArgs
      target typeContext types.getGeneratorArgs =:: targetArgs
      0:i64 while ..dup targetArgs .length < do =:: i
        srcArgs i array.get =:: srcArg
        targetArgs i array.get =:: targetArg
        targetArg .TypeId ?? if
          ## resolveGenerics
            srcArg .TypeId
            targetArg .TypeId
            true
            needCast
            genericValues
            progContext
          resolveGenerics if
            true return
          end
        else targetArg .GenericArg ?? _if
          targetArg .GenericArg =:: argId
          genericValues
            argId
          map.at =:: prev?
          prev? optional.hasData if
            prev? .data [] switch
              value case
                ## XXX? allow auto-casts type-casts
                srcArg prev? .data [] .value labelContext constantEquals if break end
                true return
              fixed case
                srcArg prev? .data [] .fixed labelContext constantEquals if break end
                true return
              nonEmpty case break
            end
          end
          genericValues
            argId
            srcArg GenericArg .fixed
          map.put ..drop
        end
        i 1 +
      end ..drop
      false return
    undefined empty primitiveType cType arrayIndex autoType intLiteral align case
      ..unreachable ## type should not contain generics
  end
end

proc(
  CallSignatureInfo ptr : src
  CallSignatureInfo list ptr.mut : elts
-> CallSignatureInfo ptr.mut ) =>: appendCopy
  elts []
    src list.appendP
  elts []=
  elts [] list.peek .data =:: newVal
    src [] .paramInfo list.copy newVal .paramInfo =
    src [] .genericValues map.copy newVal .genericValues =
  newVal return
end

#+ computes the types are given weight of the given type,
in case of a draw signatures with lower total weight will be prioritized.
This is mainly to prioritize functions acting on smaller number types over larger number types.
+#
proc( Type : t TypeContext ptr : typeContext -> i32 ) =>: computeTypeWeigth
  t .empty ?? if
    0 return
  end
  t typeContext types.unwrapNamed types.isPrimitive if
    t typeContext types.primitiveValue switch
      BOOL case 0 return
      I8   case 1 return
      I16  case 2 return
      I32  case 3 return
      I64  case 4 return
      F32  case 5 return
      F64  case 6 return
      TYPE case 7 return
      CHAR8  case  8 return
      CHAR16 case  9 return
      CHAR32 case 10 return
    end
  end
  t typeContext types.isPointer if
    t typeContext types.isFixedSize if
      12 return
    end
    16 return
  end
  t typeContext types.isArray if
    20 return
  end
  32 return
end
proc(
  CallSignatureInfo : a
  CallSignatureInfo : b
  ProgramContext ptr.mut : progContext
-> i32 ) =>: cmpSignatures
  a .needsParam b .needsParam != if
    ## fully matched before non-match
    a .needsParam if 1  else -1 end return
  end
  a .argsMatch b .argsMatch != if
    ## missing arguments before wrong arguments
    a .argsMatch if -1  else 1 end return
  end
  a .argsMatch ! if
    ## TODO? check if later arguments match to give better feedback
    ## no-match -> compare number of matched parameters
    a .paramInfo .length b .paramInfo .length == if
      ## sort non-matching signatures by declaration order
      a .procId i64 cast b .procId i64 cast < if -1 else a .procId b .procId == _if 0 else 1 end return
    end
    a .paramInfo .length b .paramInfo .length > if
      -1
    else
      1
    end
    return
  end
  a .nCasts b .nCasts != if
    ## prefer less casts
    a .nCasts b .nCasts < if -1  else 1 end return
  end
  a .nEmpty b .nEmpty != if
    ## prefer less empty parameters
    a .nEmpty b .nEmpty < if -1  else 1 end return
  end
  a .nGenerics b .nGenerics != if
    ## prefer less generics
    a .nGenerics b .nGenerics < if -1  else 1 end return
  end
  a .arraySizeArguments b .arraySizeArguments != if
    ## prefer more array dimensions in parameters
    a .arraySizeArguments b .arraySizeArguments > if -1  else 1 end return
  end
  a .signatureWeigth b .signatureWeigth != if
    ## prefer lower weight
    a .signatureWeigth b .signatureWeigth < if -1  else 1 end return
  end
  a .nRenames b .nRenames != if
    ## prefer less renames
    a .nRenames b .nRenames < if -1  else 1 end return
  end
  a .paramInfo .length b .paramInfo .length != if
    ## prefer more parameters
    a .paramInfo .length b .paramInfo .length > if -1  else 1 end return
  end
  0 return
end

proc(
  CallSignatureInfo list ptr.mut : signatures
-> ) =>: cleanupSignatures
  0:i64 while ..dup signatures [] .length < do =:: i
    signatures [] i list.at .data =:: elt
    elt [] .paramInfo
      list.free
    elt .paramInfo =
    elt .genericValues map.free
    i 1 +
  end ..drop
  signatures []
    list.free
  signatures []=
end

proc(
  LabelId GenericArg hashMap ptr.mut : genericValues
  LabelId : key
-> ConstValue ) =>: getValueOrNone
  genericValues key map.at =:: eltValue?
  eltValue? optional.hasData if
    eltValue? .data [] switch
      nonEmpty case ConstValue .None return
      value case eltValue? .data [] .value return
      fixed case eltValue? .data [] .fixed return
    end
  else
    ConstValue .None return
  end
end

5:i64 =:: MAX_DISPLAY_ARGS_DEFAULT
5:i64 =:: MAX_DISPLAY_SIGNATURES ## XXX? make customizable

proc(
  ProcId arrayView : procedureIds
  StackValue arrayView : stackValues
  stringBuilder ptr.mut optional : errorMessage
  FilePosition : pos
  ProgramContext ptr.mut : progContext
-> ProcedureCallInfo optional Type ) =>: export: resolveCall
  progContext .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  idContext .constContext =:: constContext
  procedureIds .length 0 == if
    errorMessage optional.hasData if
      errorMessage .data []
        "empty procedure bundle" sb.appendS ##XXX? print name of procedure bundle
      errorMessage .data []=
    end
    ProcedureCallInfo optional.empty Type .undefined return
  end
  procedureIds .length CallSignatureInfo list.create =:: mut: currentSignatures
  MAX_DISPLAY_ARGS_DEFAULT =:: mut: maxArgs
  0:i64 while ..dup procedureIds .length < do =:: i
    procedureIds i array.get =:: procId
    progContext [] .procedures procId i64 cast list.at .data =:: procInfo
    procInfo [] .procType
      typeContext types.getProcIn ..drop typeContext types.compositeEltCount
    =:: argCount
    maxArgs argCount i64.max maxArgs@ =
    currentSignatures
      ## CallSignatureInfo
        procId
        argCount ParameterInfo list.create
        labelHash@ labelEq@ argCount GenericArg map.create
        0
        0
        0
        0
        0
        0
        true
        argCount 0 >
      CallSignatureInfo new list.append
    currentSignatures@ =
    i 1 +
  end ..drop
  0:i64 while ..dup stackValues .length <= do =:: stackIndex
    stackIndex stackValues .length < if
      stackValues stackIndex array.at .data [] .valType
    else
      ## add dummy type below stack to ensure auto-arguments get matched
      Type .undefined
    end =:: stackType
    0:i64 while ..dup currentSignatures .length < do =:: i
      currentSignatures i list.at .data =:: mut: current
      current [] .argsMatch ! or current [] .needsParam ! if
        ## don't continue checking if first arguments were no match / all params matched
        i 1 + continue
      end
      progContext [] .procedures
        current [] .procId i64 cast list.at .data
      [] .procType typeContext types.getProcIn ..drop =:: inTypes
      inTypes typeContext types.compositeEltCount 1 -
        current [] .paramInfo .length -
      =:: mut: paramIndex
      inTypes paramIndex typeContext types.compositeGetElement =:: mut: paramType
      inTypes paramIndex typeContext types.compositeGetLabel =:: mut: paramLabel
      ## XXX? allow passing arrays as individual elements
      while ## skip empty parameters if stack-value is non-empty
        paramType typeContext types.isEmpty and
            stackType typeContext types.isEmpty ! if
          ## empty parameter, non-empty argument
          current [] .paramInfo
            ## ParameterInfo
              stackIndex i32 cast 0
              MatchType .EMPTY
            ParameterInfo new list.append
          current .paramInfo =
          paramIndex 1 - paramIndex@ =
        else paramLabel labelContext id.labelFlags id.FLAG_AUTO & ? and
            current .genericValues paramLabel map.at =:: autoValue
            autoValue optional.isEmpty ! and autoValue .data [] .nonEmpty ?? ! _if
          autoValue .data [] switch
            fixed case autoValue .data .fixed break
            value case autoValue .data .value break
            nonEmpty case ..unreachable
          end =:: value
          ## convert literal types to corresponding base types
          value [] .TypeId ?? and value [] .TypeId types.isLiteral if
            current .genericValues
              paramLabel
              value [] .TypeId typeContext types.literalToType ConstValue .TypeId GenericArg .fixed
            map.put ..drop
          end
          current [] .paramInfo
            ## ParameterInfo
              stackIndex i32 cast 0
              MatchType .AUTO
            ParameterInfo new list.append
          current .paramInfo =
          paramIndex 1 - paramIndex@ =
        else
          break
        end
      paramIndex 0 >= do
        inTypes paramIndex typeContext types.compositeGetElement paramType@ =
        inTypes paramIndex typeContext types.compositeGetLabel paramLabel@ =
      end
      paramIndex 0 < if
        false current .needsParam =
        i 1 + continue
      end
      stackIndex stackValues .length >= if
        i 1 + continue ## no value present
      end
      MatchType .NONE =:: mut: matchType
      paramType typeContext types.isGeneric and
          paramType
            typeContext types.unwrapNamed
          types.getTypeId LabelId cast =:: paramId
          current .genericValues
            paramId
          map.at optional.isEmpty if
        ## add copy of signature with generic type set to empty
        current currentSignatures@ appendCopy =:: copySig
        copySig .genericValues
          paramId
          Type .empty ConstValue .TypeId GenericArg .fixed
        map.put ..drop
        copySig [] .nEmpty
          1 +
        copySig .nEmpty =
        ## mark generic as non-empty
        current .genericValues
          paramId
          GenericArg .nonEmpty
        map.put ..drop
        ## update current pointer after changing list
        currentSignatures i list.at .data current@ =
      end
      paramLabel labelContext id.labelFlags id.FLAG_STATIC & ? if
        stackValues stackIndex array.at .data [] .value =:: stackVal
        stackVal .None ?? if
          false current .argsMatch =
        end
        current .genericValues
          paramLabel
        map.at =:: prevVal?
        prevVal? optional.hasData and
            prevVal? .data =:: prevVal
            prevVal [] switch
              nonEmpty case
                stackVal .TypeId ?? if
                  stackVal .TypeId .empty ??
                else
                  false
                end
                break
              value case
                prevVal [] .value stackVal labelContext constantEquals !
                break
              fixed case
                prevVal [] .fixed stackVal labelContext constantEquals !
                break
            end if
          false current .argsMatch =
        else
          current .genericValues
            paramLabel
            stackVal GenericArg .fixed
          map.put ..drop
        end
      end
      paramType typeContext types.isPointer or paramType typeContext types.isArray if
        current [] .arraySizeArguments
          paramType typeContext types.getArrayDims i32 cast +
        current .arraySizeArguments =
      end
      stackType typeContext types.getArrayDims 0 == and paramType typeContext types.getArrayDims 0 > if
        ## count conversion from 0D ptr to 1D ptr as cast
        current [] .nCasts
          1 +
        current .nCasts =
      end
      current [] .signatureWeigth
        paramType typeContext computeTypeWeigth +
      current .signatureWeigth =
      ## try matching type
      paramType typeContext types.containsGeneric and
          false =:: mut: needCast
          ## resolveGenerics
            stackType
            paramType
            false
            needCast@
            current .genericValues
            progContext
          resolveGenerics ! if
        MatchType .GENERIC matchType@ =
        current [] .nGenerics 1 + current .nGenerics =
        needCast if ## ptr.mut -> ptr
          current [] .nCasts 1 + current .nCasts =
        end
      else stackType paramType types.typeEquals _if
        MatchType .MATCH matchType@ =
      else stackType paramType typeContext types.canAutoCast _if
        MatchType .CAST matchType@ =
        stackType =:: mut: fromType
        ## TODO extra casts for move complicated literal conversion
        fromType paramType types.typeEquals ! if
          fromType .intLiteral ?? and
              fromType .intLiteral types.intLiteralAsInt
              paramType typeContext types.unwrapNamed types.typeEquals ! if
            ## resizing int-literal counts as additional cast
            current [] .nCasts 1 + current .nCasts =
          end
          fromType typeContext types.unwrapNamed
              paramType typeContext types.unwrapNamed
              types.typeEquals if
            ## same underlying type but different name
            current [] .nRenames 1 + current .nRenames =
          else
            current [] .nCasts 1 + current .nCasts =
          end
        end
      else
        false current .argsMatch =
      end
      current [] .paramInfo
        ## ParameterInfo
          stackIndex i32 cast
          1
          matchType
        ParameterInfo new list.append
      current .paramInfo =
      paramIndex 0 == and current [] .argsMatch if
        false current .needsParam =
      end
      i 1 +
    end ..drop
    stackIndex 1 +
  end ..drop
  currentSignatures cmpSignatures@ progContext list.sort
  currentSignatures 0 list.at .data =:: candidate
  candidate [] .needsParam if
    ## no match
    errorMessage optional.hasData if
      errorMessage .data []
        "no matching signature for arguments ( " sb.appendS
        stackValues .length maxArgs > if "... " sb.appendS end
        stackValues .length maxArgs i64.min 1 - while ..dup 0 >= do =:: i
          stackValues i array.at .data =:: val
          val [] .valType typeContext sb.appendType
          val [] .value .None ?? ! if
            " { " sb.appendS
            val [] .value typeContext sb.appendConstant
            " }" sb.appendS
          end
          "  " sb.appendS
          i 1 -
        end ..drop
        ")\ncandidates:\n" sb.appendS
        MAX_DISPLAY_SIGNATURES currentSignatures .length i64.min =:: maxSignatures
        0:i64 while ..dup maxSignatures < do =:: i
          currentSignatures i list.at .data =:: mut: current
          progContext [] .procedures
            current [] .procId i64 cast list.at .data
          =:: procInfo
          "  * " sb.appendS
          procInfo [] .procType typeContext sb.appendType
          ' ' sb.appendC
          procInfo [] .labelId labelContext sb.appendLabelName
          '\n' sb.appendC
          i 1 +
        end ..drop
        currentSignatures .length maxSignatures > if "  ...\n" sb.appendS end
      errorMessage .data []=
    end
    currentSignatures@ cleanupSignatures
    ProcedureCallInfo optional.empty Type .undefined return
  end
  currentSignatures .length 1 > and
      ## cmpSignatures
        candidate []
        currentSignatures 1 list.at .data []
        progContext
      cmpSignatures 0 == if
    ## multiple matches
    errorMessage optional.hasData if
      errorMessage .data []
        "multiple matching signature for arguments ( " sb.appendS
        stackValues .length maxArgs > if "... " sb.appendS end
        stackValues .length maxArgs i64.min 1 - while ..dup 0 >= do =:: i
          stackValues i array.at .data =:: val
          val [] .valType typeContext sb.appendType
          val [] .value .None ?? ! if
            " { " sb.appendS
            val [] .value typeContext sb.appendConstant
            " }" sb.appendS
          end
          "  " sb.appendS
          i 1 -
        end ..drop
        ")\npossible matches: \n" sb.appendS
        true =:: mut: isEquivalent
        MAX_DISPLAY_SIGNATURES currentSignatures .length i64.min =:: maxSignatures
        0:i64 while ..dup maxSignatures < do =:: i
          currentSignatures i list.at .data =:: mut: current
          progContext [] .procedures
            current [] .procId i64 cast list.at .data
          =:: procInfo
          isEquivalent and
              candidate [] current [] progContext cmpSignatures 0 != if
            "other signatures: \n" sb.appendS
            false isEquivalent@ =
          end
          "  * " sb.appendS
          procInfo [] .procType typeContext sb.appendType
          ' ' sb.appendC
          procInfo [] .labelId labelContext sb.appendLabelName
          '\n' sb.appendC
          i 1 +
        end ..drop
        currentSignatures .length maxSignatures > if "  ...\n" sb.appendS end
      errorMessage .data []=
    end
    currentSignatures@ cleanupSignatures
    ProcedureCallInfo optional.empty Type .undefined return
  end
  progContext [] .procedures
    candidate [] .procId i64 cast list.at .data
  =:: procInfo
  procInfo [] .implementation .alias ?? ! if
    candidate [] .procId
  else
    ## XXX? nested alias
    procInfo [] .implementation .alias
  end =:: baseProcId
  procInfo [] .procType typeContext types.getProcIn ..drop =:: inType
  procInfo [] .procType typeContext types.getProcOut ..drop =:: outType
  inType typeContext types.compositeEltCount =:: eltCount
  eltCount ConstValue list.create =:: mut: constArgs
  0:i64 while ..dup eltCount < do =:: i
    inType i typeContext types.compositeGetLabel =:: eltLabel
    eltLabel labelContext id.labelFlags id.FLAG_STATIC & ? if
      constArgs
        candidate .genericValues eltLabel getValueOrNone list.append
      constArgs@ =
    end
    i 1 +
  end ..drop
  -1:i64 =:: mut: implId
  eltCount Type list.create =:: mut: typeBuffer
  eltCount LabelId list.create =:: mut: labelBuffer
  constArgs .length 0 > and
      progContext [] .procedures
        baseProcId i64 cast list.at .data
      =:: baseProcInfo
      baseProcInfo [] .isStatic ! and ## don't create implementations for static procedures
      baseProcInfo .implementation =:: implData
      ## TODO support alias for generic procedures
      implData [] .code ?? if
    implData .code .implementations =:: impls
    false =:: mut: isMatch
    0:i64 while ..dup impls [] .length < do =:: i
      impls [] i list.at .data =:: impl
      impl [] .staticArgs .length constArgs .length == "correct number of static arguments" assert
      true isMatch@ =
      0:i64 while ..dup constArgs .length < do =:: j
        ## constEquals
          impl [] .staticArgs j array.get
          constArgs j list.get
          labelContext
        constantEquals ! if
          false isMatch@ =
          j break
        end
        j 1 +
      end ..drop
      isMatch if
        i implId@ =
        i break
      end
      i 1 +
    end ..drop
    isMatch ! if ## no matching implementation -> create new one
      impls []
        ..dup .length implId@ =
        ## ProcImplementation
          ## replaceGenerics
            baseProcInfo [] .procType
            typeBuffer@
            labelBuffer@
            candidate .genericValues
            false
            pos
            progContext
          replaceGenerics
          constArgs list.asArray constContext constArray
          0 VariableInfo list.create
          pos
          -1
          -1
          ProcCodeState .PARSED
        ProcImplementation new list.append
      impls []=
    end
  end
  constArgs
    list.clear
  constArgs@ =
  0:i64 while ..dup eltCount < do =:: i
    inType i typeContext types.compositeGetLabel =:: eltLabel
    eltLabel labelContext id.labelFlags =:: flags
    true =:: mut: needArg
    flags id.FLAG_AUTO & ? if
      candidate .genericValues eltLabel getValueOrNone =:: value
      value .None ?? ! if
        false needArg@ =
      end
      ## convert literal types to corresponding types
      value .TypeId ?? and value .TypeId types.isLiteral if
        candidate .genericValues
          eltLabel
          value .TypeId typeContext types.literalToType ConstValue .TypeId GenericArg .fixed
        map.put ..drop
      end
      constArgs
        value list.append
      constArgs@ =
    end
    needArg if ## need argument from stack
      inType i typeContext types.compositeGetElement =:: eltType
      ## replaceGenerics
        eltType
        typeBuffer@
        labelBuffer@
        candidate .genericValues
        true
        pos
        progContext
      replaceGenerics =:: newElt
      ## ! replaceGenerics changes typeBuffer
      typeBuffer
         newElt list.append
      typeBuffer@ =
      labelBuffer
        eltLabel list.append
      labelBuffer@ =
    end
    i 1 +
  end ..drop
  ## newProcArgs
    typeBuffer list.asArray
    labelBuffer list.asArray optional.wrap
    false
    typeContext
  types.newProcArgs =:: newIn
  typeBuffer list.clear typeBuffer@ =
  labelBuffer list.clear labelBuffer@ =
  ## replaceGenerics
    outType
    typeBuffer@
    labelBuffer@
    candidate .genericValues
    true
    pos
    progContext
  replaceGenerics =:: newOut
  typeBuffer list.free typeBuffer@ =
  labelBuffer list.free labelBuffer@ =
  ## newProcedure
    newIn
    newOut
    procInfo [] .procType typeContext types.getCallConvention ..drop
    typeContext
  types.newProcedure
    ! "can create procedure" assert
  =:: calledType
  ## ProcedureCallInfo
    baseProcId
    implId
    constArgs list.asArray constContext constArray
  ProcedureCallInfo new =:: result
  constArgs list.free constArgs@ =
  currentSignatures@ cleanupSignatures
  result optional.wrap calledType return
end
