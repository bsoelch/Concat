    implData [] .code .implementations @ =:: impls
    false =:: mut isMatch
    0 while ..dup impls [] .length < do =:: i
      impls [] i list.at .data =:: impl
      impl [] .staticArgs .length constArgs .length != if
        ..unreachable ## XXX? replace with assertion
      end
      true isMatch =
      0 while ..dup constArgs .length < do =:: j
        ## constEquals
          impl [] .staticArgs j constContext constArrayGet
          constArgs j list.get
          labelContext
        constantEquals ! if
          false isMatch =
          j break
        end
        j 1 +
      end ..drop
      isMatch if
        i implId =
        i break
      end
      i 1 +
    end ..drop
    isMatch ! if
      impls []
        ..dup .length implId =
        ## ProcImplementation
          ## replaceGenerics
            procInfo [] .procType
            typeBuffer @
            labelBuffer @
            candidate [] .genericValues @
            progContext
          replaceGenerics
          constArgs list.asArray constContext constArray
          -1
          -1
        ProcImplementation new list.append
