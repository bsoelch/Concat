import arrayView

import "constants.concat"
import "types.concat"
import "program.concat"


enum( MATCH GENERIC CAST AUTO EMPTY NONE ) =:: MatchType

struct(
  Type : valType
  ConstValue : value
) =:: export StackValue

struct(
  i32 : argOffset
  i32 : mut argCount
  MatchType : matchType
) =:: ParameterInfo

enum(
  ConstValue : value
  ConstValue : fixed
               nonEmpty
) =:: GenericArg

struct(
  ProcId : procId
  ParameterInfo list : mut paramInfo
  LabelId GenericArg hashMap : mut genericValues
  i32 : mut nEmpty
  i32 : mut nRenames
  i32 : mut nCasts
  i32 : mut nGenerics
  bool : mut argsMatch
  bool : mut needsParam
) =:: CallSignatureInfo


proc( types.ArraySize : size -> ConstValue ) =>: sizeAsConst
  size .sizeType switch
    int case size .value ConstValue .int return
    staticArg case
      size .value LabelId cast ConstValue .genericArg return
    templateArg case
      size .value TemplateId cast ConstValue .templateArg return
  end
end
proc( ConstValue : val -> types.ArraySize ) =>: constAsSize
  val switch
    int case
      ## ArraySize
        val .int
        types.ArraySizeType .int
      types.ArraySize new return
    genericArg case
      ## ArraySize
        val .genericArg
        types.ArraySizeType .staticArg
      types.ArraySize new return
    none boolean enumLabel chr Float str
    arrayConstant typeId wildCard templateArg
    procedure procedureBundle case ..unreachable
  end
end

proc(
  Type : src
  Type list ptr mut : typeBuffer
  LabelId list ptr mut : labelBuffer
  LabelId GenericArg hashMap ptr mut : genericValues
  ProgramContext ptr mut : progContext
-> Type ) =>: replaceGenerics
  progContext [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  idContext [] .labelContext @ =:: labelContext
  idContext [] .constContext @ =:: constContext
  src typeContext types.containsGeneric | ! if
    src return
  end
  src switch
    genericType case
      src types.getTypeId LabelId =: genericId
      genericValues genericId map.at =:: value?
      value? optional.hasData if
        value? .data [] =:: value
        value switch
          fixed case
            value .fixed .typeId return
          value case
            value .value .typeId return
          nonEmpty case break
        end
      end
      src return ## generic not found XXX? error
    namedType case
      src typeContext types.namedTypeName =:: name
      src typeContext types.flatUnwrapNamed =:: base
      ## newNamedType
        ## replaceGenerics
          base
          typeBuffer
          labelBuffer
          genericValues
          progContext
        replaceGenerics
        name
        -1
        typeContext
      types.newNamedType return
    reference mutableReference case
      ## newReferenceType
        ## replaceGenerics
          src typeContext types.getBaseType
          typeBuffer
          labelBuffer
          genericValues
          progContext
        replaceGenerics
        src .mutableReference ??
        typeContext
      types.newReferenceType return
    pointer arrayType case
      src typeContext types.getBaseType =:: base
      src typeContext types.getArraySize =:: sizes
      idContext [] .arraySizeBuffer .length =:: sizeOffset
      0 while ..dup sizes .length < do =:: i
        sizes i array.get =:: size
        idContext [] .arraySizeBuffer
          size .sizeType switch
            int case
              size list.append break
            staticArg case
              size .value LabelId cast =:: genericId
              genericValues genericId map.at .data =:: val
              val [] .fixed constAsSize list.append
              break
            templateArg case ..unreachable
          end
        idContext [] .arraySizeBuffer =
        i 1 +
      end ..drop
      ## newArrayType
        ## replaceGenerics
          base
          typeBuffer
          labelBuffer
          genericValues
          progContext
        replaceGenerics
        src .pointer ??
        idContext [] .arraySizeBuffer list.asArray
          sizeOffset
        array.tail
        src typeContext types.isFixedSize
        src typeContext types.isMutable
        typeContext
      types.newArrayType
        idContext [] .arraySizeBuffer
          sizeOffset list.setLength
        idContext [] .arraySizeBuffer =
        if ..unreachable end ## XXX handle error
      return
    struct union procIn procOut enum case
      typeBuffer [] .length =:: typeOffset
      labelBuffer [] .length =:: labelOffset
      src typeContext types.compositeEltCount =:: eltCount
      0 while ..dup eltCount < do =:: i
        typeBuffer []
          ## replaceGenerics
            src i typeContext types.compositeGetElement
            typeBuffer
            labelBuffer
            genericValues
            progContext
          replaceGenerics list.append
        typeBuffer [] =
        labelBuffer []
          src i typeContext types.compositeGetLabel list.append
        labelBuffer [] =
        i 1 +
      end ..drop
      ## newComposite
        typeBuffer [] list.asArray typeOffset array.tail
        labelBuffer [] list.asArray labelOffset array.tail optional.wrap
        typeContext
        src switch
          struct case types.newTuple break
          union case types.newUnion break
          enum case types.newEnum break
          procIn procOut case src .procOut ?? ..swap types.newProcArgs false break
          default ..unreachable
        end
        ## reset buffer
        typeBuffer [] typeOffset list.setLength typeBuffer [] =
        labelBuffer [] labelOffset list.setLength labelBuffer [] =
        if ..unreachable end ## XXX check error
      return
    procedure case
      src typeContext types.getProcIn ..drop =:: inTypes
      src typeContext types.getProcOut ..drop =:: outTypes
      ## newProcedure
        inTypes
          typeBuffer labelBuffer genericValues progContext
        replaceGenerics
        outTypes
          typeBuffer labelBuffer genericValues progContext
        replaceGenerics
        src typeContext types.getCallConvention ..drop
        typeContext
      types.newProcedure
        if ..unreachable end ## XXX check error
      return
    generatedType case
      src typeContext types.getGeneratorArgs =:: args
      idContext [] .templateArgBuffer @ =:: argBuffer
      argBuffer [] .length =:: argOffset
      0 while ..dup args .length < do =:: i
        args i constContext constArrayGet =:: arg
        argBuffer []
          arg switch
            none boolean enumLabel chr int Float
            str arrayConstant wildCard procedure procedureBundle case
              arg break ## argument not generic
            typeId case
              arg .typeId
                typeBuffer labelBuffer genericValues progContext
              replaceGenerics ConstValue .typeId
              break
            genericArg case
              arg .genericArg =:: argId
              genericValues argId map.at =:: val?
              val? optional.isEmpty if arg break end
              val? .data [] switch
                value case val? .data [] .value break
                fixed case val? .data [] .fixed break
                nonEmpty case arg break
              end
              break
            templateArg case ..unreachable
          end list.append
        argBuffer [] =
        i 1 +
      end ..drop
      ##findGeneratedType
        src typeContext types.getGeneratorLabel
        argBuffer [] list.asArray argOffset array.tail
        typeContext
        labelContext
        constContext
      types.findGeneratedType
        if ## new generated type
          ..unreachable ## XXX? ensure generator is initialized
        end
        argBuffer []
          argOffset list.setLength
        argBuffer [] =
      return
    undefined empty primitiveType cType arrayIndex autoType case
      ..unreachable ## type should not contain generics
    templateType case
      ..unreachable ## new parser should not generate template types
  end
end

proc(
  Type : src0
  Type : target
  bool : exactMatch
  bool ptr mut : needCast
  LabelId GenericArg hashMap ptr mut : genericValues
  ProgramContext ptr mut : progContext
-> bool ) =>: resolveGenerics
  progContext [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  idContext [] .labelContext @ =:: labelContext
  idContext [] .constContext @ =:: constContext
  target typeContext types.containsGeneric | ! if
    false return
  end
  src0 =:: mut src
  ## unwrap reference in src argument if target is not a reference
  src typeContext types.isReference if
    target typeContext types.isReference ! _if
    src typeContext types.getBaseType src =
  end
  target switch
    genericType case
      target types.getTypeId LabelId =: genericId
      genericValues genericId map.at =:: oldValue?
      oldValue? optional.hasData if
        oldValue? .data [] =:: oldValue
        oldValue switch
          nonEmpty case
            src .empty ?? if
              true return
            end
            src break
          fixed case
            exactMatch if ## XXX? allow unwrapping named types for exact match
              src oldValue .fixed .typeId types.typeEquals ! if
                true return
              end
              src break
            else src oldValue .fixed .typeId typeContext types.canAutoCast ! _if
              true return
            end
            oldValue .fixed .typeId break
          value case
            exactMatch if
              oldValue .value .typeId src typeContext types.canAutoCast ! if
                true return
              end
              src break
            end
            src oldValue .value .typeId typeContext types.mergeTypes if ..drop
              true return
            end
            break
        end
      else
        src
      end =:: genericValue
      genericValues
        genericId
        genericValue ConstValue .typeId exactMatch if
          GenericArg .fixed
        else
          GenericArg .value
        end
      map.put ..drop
      false return
    namedType case
      src =:: mut unwrapSrc
      target =:: mut unwrapTarget
      while
        unwrapSrc types.isNamedType if
          unwrapSrc typeContext types.flatUnwrapNamed unwrapSrc =
        end
        unwrapTarget typeContext types.flatUnwrapNamed unwrapTarget =
      unwrapTarget .namedType ?? do end
      ## resolveGenerics
        unwrapSrc
        unwrapTarget
        exactMatch
        needCast
        genericValues
        progContext
      resolveGenerics return
    reference mutableReference case
      src typeContext types.isReference ! if
        true return
      end
      ## resolveGenerics
        src typeContext types.getBaseType
        target typeContext types.getBaseType
        true
        needCast
        genericValues
        progContext
      resolveGenerics return
    pointer arrayType case
      src typeContext types.isPointer ! if
          src typeContext types.isArray ! _if
        true return
      end
      src typeContext types.isMutable =:: srcMutable
      target typeContext types.isMutable =:: targetMutable
      targetMutable if srcMutable ! _if
        true return ## cannot cast immutable to mutable
      end
      srcMutable if targetMutable ! _if
        true needCast [] =
      end
      ## resolveGenerics
        src typeContext types.getBaseType
        target typeContext types.getBaseType
        true
        needCast
        genericValues
        progContext
      resolveGenerics if
        true return
      end
      src typeContext types.isFixedSize =:: srcFixed
      target typeContext types.isFixedSize =:: targetFixed
      targetFixed if srcFixed ! _if
        true return ## cannot assign unknown-size to fixed-size
      end
      src typeContext types.getArraySize =:: srcSizes
      target typeContext types.getArraySize =:: targetSizes
      srcSizes .length targetSizes .length < if
        true return ## target sizes have to be matched
      end
      targetFixed if srcSizes .length targetSizes .length != _if
        true return ## all target sizes have to be matched
      end
      0 while ..dup targetSizes .length < do =:: i
        srcSizes i array.get =:: srcSize
        targetSizes i array.get =:: targetSize
        targetSize .sizeType switch
          int case
            srcSize .sizeType .int ?? ! if
              true return
            else srcSize .value targetSize .value != _if
              true return
            end
          break
          staticArg case
            targetSize .value LabelId cast =:: genericId
            srcSize sizeAsConst =:: newValue
            genericValues genericId map.at =:: oldValue?
            oldValue? optional.hasData if
              oldValue? .data [] switch
                nonEmpty case break
                value case
                    oldValue? .data [] .value
                    newValue
                    labelContext
                  constantEquals ! if true return end
                  break
                fixed case
                    oldValue? .data [] .fixed
                    newValue
                    labelContext
                  constantEquals ! if true return end
                  break
              end
            end
            genericValues
              genericId
              newValue GenericArg .fixed
            map.put ..drop
            break
          templateArg case ..unreachable
        end
        i 1 +
      end ..drop
      false return
    struct union procIn procOut enum case
      ## TODO? allow matching value to union/enum element
      src typeContext types.unwrapNamed src =
      src target != if
        true return ## src and target have to be same type of composite
      end
      target typeContext types.compositeEltCount =:: targetCount
      src typeContext types.compositeEltCount =:: srcCount
      targetCount srcCount < if
        true return ## all types in source have to be matched to type in target
      end
      ## resolve generics for all elements of composite type
      0 while ..dup targetCount < do =:: i
        target i typeContext types.compositeGetElement =:: targetElt
        i srcCount < if
          src i typeContext types.compositeGetElement
        else
          Type .empty ## extend source with empty if necessary
        end =:: srcElt
        ## resolveGenerics
          srcElt
          targetElt
          true
          needCast
          genericValues
          progContext
        resolveGenerics if
          true return
        end
        i 1 +
      end ..drop
      false return
    procedure case
      src typeContext types.unwrapNamed src =
      src target != if
        true return
      end
      ## separately run for in and out arguments
      ## resolveGenerics
        src typeContext types.getProcIn ..drop
        target typeContext types.getProcIn ..drop
        true
        needCast
        genericValues
        progContext
      resolveGenerics if
        true return
      end
      ## resolveGenerics
        src typeContext types.getProcOut ..drop
        target typeContext types.getProcOut ..drop
        true
        needCast
        genericValues
        progContext
      resolveGenerics if
        true return
      end
      false return
    generatedType case
      src typeContext types.unwrapNamedKeepGenerated src =
      ## src has to be a compatible generated type
      src types.isGeneratedType ! if
        true return
      else src typeContext types.getGeneratorLabel
           target typeContext types.getGeneratorLabel != _if
        true return
      end
      src typeContext types.getGeneratorArgs =:: srcArgs
      target typeContext types.getGeneratorArgs =:: targetArgs
      0 while ..dup targetArgs .length < do =:: i
        srcArgs i constContext constArrayGet =:: srcArg
        targetArgs i constContext constArrayGet =:: targetArg
        targetArg .typeId ?? if
          ## resolveGenerics
            srcArg .typeId
            targetArg .typeId
            true
            needCast
            genericValues
            progContext
          resolveGenerics if
            true return
          end
        else targetArg .genericArg ?? _if
          targetArg .genericArg =:: argId
          genericValues
            argId
          map.at =:: prev?
          prev? optional.hasData if
            prev? .data [] switch
              value case ## XXX allow merging values?
                ## TODO allow auto-casts type-casts
                srcArg prev? .data [] .value labelContext constantEquals if break end
                true return
              fixed case
                srcArg prev? .data [] .fixed labelContext constantEquals if break end
                true return
              nonEmpty case break
            end
          end
          genericValues
            argId
            srcArg GenericArg .fixed
          map.put ..drop
        end
        i 1 +
      end ..drop
      false return
    undefined empty primitiveType cType arrayIndex autoType case
      ..unreachable ## type should not contain generics
    templateType case
      ..unreachable ## new parser should not generate template types
  end
end

proc(
  CallSignatureInfo ptr : src
  CallSignatureInfo list ptr mut : elts
-> CallSignatureInfo ptr mut ) =>: appendCopy
  elts []
    src list.appendP
  elts [] =
  elts [] list.peek .data =:: newVal
    src [] .paramInfo list.copy newVal [] .paramInfo =
    src [] .genericValues map.copy newVal [] .genericValues =
  newVal return
end

proc(
  CallSignatureInfo : a
  CallSignatureInfo : b
  ProgramContext ptr mut : progContext
-> i32 ) =>: cmpSignatures
  a .needsParam b .needsParam != if
    ## fully matched before non-match
    a .needsParam if 1  else -1 end return
  end
  a .argsMatch b .argsMatch != if
    ## missing arguments before wrong arguments
    a .argsMatch if -1  else 1 end return
  end
  a .argsMatch ! if
    ## no-match -> only compare number of matched parameters
    a .paramInfo .length b .paramInfo .length == if
      0 return
    end
    a .paramInfo .length b .paramInfo .length < if
      -1
    else
      1
    end
    return
  end
  a .nCasts b .nCasts != if
    ## prefer less casts
    a .nCasts b .nCasts < if -1  else 1 end return
  end
  a .nEmpty b .nEmpty != if
    ## prefer less empty parameters
    a .nEmpty b .nEmpty < if -1  else 1 end return
  end
  a .nGenerics b .nGenerics != if
    ## prefer less generics
    a .nGenerics b .nGenerics < if -1  else 1 end return
  end
  a .nRenames b .nRenames != if
    ## prefer less renames
    a .nRenames b .nRenames < if -1  else 1 end return
  end
  a .paramInfo .length b .paramInfo .length != if
    ## prefer more parameters
    a .paramInfo .length b .paramInfo .length > if -1  else 1 end return
  end
  0 return
end

proc(
  CallSignatureInfo list ptr mut : signatures
-> ) =>: cleanupSignatures
  0 while ..dup signatures [] .length < do =:: i
    signatures [] i list.at .data =:: elt
    elt [] .paramInfo
      list.free
    elt [] .paramInfo =
    elt [] .genericValues @ map.free
    i 1 +
  end ..drop
  signatures []
    list.free
  signatures [] =
end

proc(
  LabelId GenericArg hashMap ptr mut : genericValues
  LabelId : key
-> ConstValue ) =>: getValueOrNone
  genericValues key map.at =:: eltValue?
  eltValue? optional.hasData if
    eltValue? .data [] switch
      nonEmpty case ConstValue .none return
      value case eltValue? .data [] .value return
      fixed case eltValue? .data [] .fixed return
    end
  else
    ConstValue .none return
  end
end


