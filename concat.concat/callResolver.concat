  procedureIds .length CallSignatureInfo list.create =:: mut currentSignatures
  0 while ..dup procedureIds .length < do =:: i
    procedureIds i array.get =:: procId
    progContext [] .procedures procId list.at .data =:: procInfo
    procInfo [] .procType
      typeContext types.getProcIn ..drop typeContext types.compositeEltCount
    =:: argCount
    currentSignatures
      ## CallSignatureInfo
        procId
        argCount ParameterInfo list.create
        labelHash @ labelEq @ argCount GenericArg map.create
        0
        0
        0
        0
