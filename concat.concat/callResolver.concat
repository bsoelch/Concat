import slice

import "constants.concat"
import "types.concat"
import "program.concat"
import "interpreter.concat"

enum( MATCH GENERIC CAST AUTO EMPTY NONE ) =:: MatchType

struct(
  Type : valType
  ConstValue : value
) =:: export: StackValue

struct(
  i32 : argOffset
  i32 : argCount
  MatchType : matchType
) =:: ParameterInfo

union(
  ConstValue : value
  ConstValue : fixed  ## value of generic cannot be changed
           _ : nonEmpty
) =:: GenericArg

struct(
  ProcId : procId
  ParameterInfo list : paramInfo
  LabelId GenericArg hashMap : genericValues
  i32 : nEmpty
  i32 : nRenames
  i32 : nCasts
  i32 : nGenerics
  i32 : signatureWeigth
  bool : argsMatch
  bool : needsParam
) =:: CallSignatureInfo

proc( GenericArg : val TypeContext ptr.mut : typeContext -> bool ) =>: isEmptyConstant
  val switch
    nonEmpty case false return
    value case val .value break
    fixed case val .fixed break
  end =:: constVal
  constVal .?None ? or
    constVal .?TypeId .and typeContext types.isEmpty
  end return
end

proc( types.ArraySize : size -> ConstValue ) =>: sizeAsConst
  size switch
    Dynamic case ConstValue .None return
    None case 1 ConstValue .Int return
    Int case size .Int ConstValue .Int return
    GenericArg case size .GenericArg ConstValue .GenericArg return
  end
end
proc( ConstValue : val -> types.ArraySize ) =>: constAsSize
  ConstValue ..length 23:iSize == "no new constants" assert
  val switch
    Int case
      val .Int types.ArraySize .Int return
    GenericArg case
      val .GenericArg types.ArraySize .GenericArg return
    default ..unreachable
  end
end

i32 =:: ReplaceFlags
( char8 ptr.raw iSize -> ReplaceFlags ) : static: alias: :ReplaceFlags ..builtIn.parse.i32
namespace: ReplaceFlags
  ( ReplaceFlags ReplaceFlags -> ReplaceFlags ) : alias: or i32.or
  ( ReplaceFlags ReplaceFlags -> ReplaceFlags ) : alias: and i32.and
  ( ReplaceFlags -> bool ) : alias: toBool i32.toBool
  0:ReplaceFlags =:: REPLACE_NONE
  1:ReplaceFlags =:: REPLACE_AUTO_ARGS
  2:ReplaceFlags =:: IGNORE_EMPTY
end
overload: merge: & ReplaceFlags.and end
overload: merge: | ReplaceFlags.or end
overload: merge: ? ReplaceFlags.toBool end

proc(
  Type : src
  Type list ptr.mut : typeBuffer
  LabelId list ptr.mut : labelBuffer
  LabelId GenericArg hashMap ptr.mut : genericValues
  ReplaceFlags : flags
  FilePosition : pos
  InterpreterContext ptr.mut : interpreterContext
-> Type ) =>: replaceGenerics
  interpreterContext [] .program =:: progContext
  progContext .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  idContext .constContext =:: constContext
  src typeContext types.containsGeneric ! if
    src return
  end
  src switch
    GenericType case
      src types.getGenericTypeId LabelId cast =:: genericId
      genericValues genericId map.at =:: value?
      value? optional.hasData if
        value? .data [] =:: value
        value switch
          fixed case
            value .fixed .TypeId return
          value case
            value .value .TypeId return
          nonEmpty case break
        end
      end
      src return ## generic not found XXX? error
    NamedType case
      src typeContext types.namedTypeName =:: name
      src typeContext types.flatUnwrapNamed =:: base
      base typeContext types.containsGeneric if
        "generic named types are not supported" ..panic
        ## TODO? support generic named types: create copy with different contents
      end
      src return
    Pointer MutablePointer RawPointer MutableRawPointer ArrayType case
      src typeContext types.getBaseType =:: base
      src typeContext types.getArraySize =:: size
      idContext [] .arraySizeBuffer .length =:: sizeOffset
      false =:: mut: genericSize
      size switch
        None Int Dynamic case
          size break
        GenericArg case
          size .GenericArg =:: genericId
          genericId labelContext id.labelFlags id.FLAG_STATIC & ? ! if
            flags ReplaceFlags.REPLACE_AUTO_ARGS & ? ! if
              size break
            end
            true genericSize=
          end
          genericValues genericId map.at =:: newValue
          newValue optional.hasData if
            newValue .data [] .fixed constAsSize
          else
            size
          end
          break
      end =:: newSize
      ## newArrayType
        ## replaceGenerics
          base
          typeBuffer
          labelBuffer
          genericValues
          flags ReplaceFlags.IGNORE_EMPTY |
          pos
          interpreterContext
        replaceGenerics
        src .?Pointer ? or src .?ArrayType ? and genericSize if
          types.ArrayType .POINTER
        else src .?MutablePointer ? _if
          types.ArrayType .MUTABLE_POINTER
        else src .?RawPointer ? _if
          types.ArrayType .RAW_POINTER
        else src .?MutableRawPointer ? _if
          types.ArrayType .MUTABLE_RAW_POINTER
        else
          types.ArrayType .ARRAY
        end
        newSize
        typeContext
      types.newArrayType .data
        idContext [] .arraySizeBuffer
          sizeOffset list.setLength
        idContext .arraySizeBuffer=
      return
    Struct Union RawUnion Enum Initializer case
      typeBuffer [] .length =:: typeOffset
      labelBuffer [] .length =:: labelOffset
      src typeContext types.compositeEltCount =:: eltCount
      eltCount for =:: i
        ## replaceGenerics
          src i typeContext types.compositeGetElement
          typeBuffer
          labelBuffer
          genericValues
          flags
          pos
          interpreterContext
        replaceGenerics =:: newElt
        ## ! replaceGenerics changes type-buffer
        typeBuffer []
          newElt list.append
        typeBuffer =[]
        ## TODO? pass original labels instead of creating copy
        labelBuffer []
          src i typeContext types.compositeGetLabel list.append
        labelBuffer =[]
      end
      src switch
        Struct case
          ## newTuple
            typeBuffer [] list.asSlice typeOffset slice.tail
            labelBuffer [] list.asSlice labelOffset slice.tail optional.wrap
            typeContext
          types.newTuple break
        Union RawUnion case
          ## newTuple
            typeBuffer [] list.asSlice typeOffset slice.tail
            labelBuffer [] list.asSlice labelOffset slice.tail
            src .?Union ? if types.UnionType .TAGGED else types.UnionType .RAW end
            typeContext
          types.newUnion break
        Enum case
          ## newEnum
            Type optional.empty ## TODO preserve base-type
            labelBuffer [] list.asSlice labelOffset slice.tail
            typeContext
          types.newEnum break
        ## TODO update initializer type
        Initializer case
          "generic initializers are not supported" ..panic
        default ..unreachable
      end .data
        ## reset buffer
        typeBuffer [] typeOffset list.setLength typeBuffer =[]
        labelBuffer [] labelOffset list.setLength labelBuffer =[]
      return
    ## FIXME: implement replace-generic for union-elements
    UnionElement case "unimplemented: generic union-element check" ..panic
    Procedure case
      src typeContext types.getProcIn .data =:: inTypes
      src typeContext types.getProcOut .data =:: outTypes
      src typeContext types.getProcLabels =:: oldLabels
      0:iSize =:: mut: labelIndex
      typeBuffer [] .length =:: typeOffset
      labelBuffer [] .length =:: labelOffset
      inTypes for =:: inType
        inType typeBuffer labelBuffer genericValues flags pos interpreterContext replaceGenerics =:: newArg
        flags ReplaceFlags.IGNORE_EMPTY & ? and newArg typeContext types.isEmpty if
          continue
        end
        ## ! cannot use buffer on stack when pointer to buffer is pssed to child
        labelIndex oldLabels .length u< if
          labelBuffer []
            oldLabels labelIndex [] list.append
          labelBuffer =[]
        end
        typeBuffer []
          newArg list.append
        typeBuffer =[]
      finally labelIndex 1:iSize + labelIndex= end
      typeBuffer [] .length =:: outTypesOffset
      outTypes for =:: outType
        outType typeBuffer labelBuffer genericValues flags pos interpreterContext replaceGenerics =:: newRes
        flags ReplaceFlags.IGNORE_EMPTY & ? and newRes typeContext types.isEmpty if
          continue
        end
        labelIndex oldLabels .length u< if
          labelBuffer []
            oldLabels labelIndex [] list.append
          labelBuffer =[]
        end
        typeBuffer []
          newRes list.append
        typeBuffer =[]
      finally labelIndex 1:iSize + labelIndex= end
      ## newProcedure
        typeBuffer [] typeOffset outTypesOffset $1 - list.getSlice
        typeBuffer [] list.asSlice outTypesOffset slice.tail
        ## TODO? reuse old labels if there was no change
        labelBuffer [] list.asSlice labelOffset slice.tail
        src typeContext types.getCallConvention
        typeContext
      types.newProcedure .data
        ## reset buffers
        typeBuffer [] typeOffset list.setLength typeBuffer =[]
        labelBuffer [] labelOffset list.setLength labelBuffer =[]
      return
    GeneratedType case
      src typeContext types.getGeneratorArgs =:: args
      idContext .argBuffer =:: argBuffer
      argBuffer [] .length =:: argOffset
      args for =:: arg
        argBuffer []
          ConstValue ..length 23:iSize == "no new constants" assert
          arg switch
            TypeId case
              arg .TypeId
                typeBuffer labelBuffer genericValues flags pos interpreterContext
              replaceGenerics ConstValue .TypeId
              break
            GenericArg case
              arg .GenericArg =:: argId
              genericValues argId map.at =:: val?
              val? optional.isEmpty if arg break end
              val? .data [] switch
                value case val? .data [] .value break
                fixed case val? .data [] .fixed break
                nonEmpty case arg break
              end
              break
            default arg break ## argument not generic
          end list.append
        argBuffer =[]
      end
      src typeContext types.getGeneratorLabel =:: generatorName
      argBuffer [] list.asSlice argOffset slice.tail =:: generatorArgs
      ##findGeneratedType
        generatorName
        generatorArgs
        false
        typeContext
        constContext
      types.findGeneratedType $ switch
        None case ..drop ## new generated type
          ## initializeGeneratedType
            generatorName
            generatorArgs
            pos
            interpreterContext
          interpreter.initializeGeneratedType .data
        break
        Stored case .Stored break
        Created case .Created break
      end
        argBuffer []
          argOffset list.setLength
        argBuffer =[]
      return
    Undefined Empty PrimitiveType CType AutoType IntLiteral Align TypeSet case
      ..unreachable ## type should not contain generics
  end
end

proc(
  Type : src0
  Type : target
  bool : exactMatch
  bool ptr.mut : needCast
  LabelId GenericArg hashMap ptr.mut : genericValues
  ProgramContext ptr.mut : progContext
-> bool ) =>: resolveGenerics
  progContext .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  idContext .constContext =:: constContext
  target typeContext types.containsGeneric ! if
    src0 target typeContext types.canAutoCast ! return
  end
  src0 =:: mut: src
  src typeContext types.isInitializer if
    target typeContext types.isArray and src typeContext types.isArrayLiteral if
      src typeContext types.initializerAsArray src=
    else src typeContext types.isArrayLiteral and target typeContext types.isArrayPointer _if
      src typeContext types.initializerAsPointer src=
    else
      src typeContext types.initializerAsTuple src=
    end
  end
  target switch
    GenericType case
      target types.getGenericTypeId LabelId cast =:: genericId
      genericValues genericId map.at =:: oldValue?
      oldValue? optional.hasData if
        oldValue? .data [] =:: oldValue
        oldValue switch
          nonEmpty case
            src typeContext types.isEmpty if
              true return
            end
            src break
          fixed .case .?TypeId .else ..drop
              false return
            end =:: oldTypeId
            src typeContext types.isEmpty and oldTypeId typeContext types.isEmpty if
              src break
            end
            exactMatch if ## XXX? allow unwrapping named types for exact match
              src oldTypeId types.typeEquals ! if
                true return
              end
              src break
            else src oldTypeId typeContext types.canAutoCast ! _if
              true return
            end
            oldTypeId break
          value .case .?TypeId .else ..drop
              false return
            end =:: oldIdType
            src typeContext types.isEmpty and oldIdType typeContext types.isEmpty if
              src break
            end
            exactMatch if
              oldIdType src typeContext types.canAutoCast ! if
                true return
              end
              src break
            end
            src oldIdType typeContext types.mergeTypes $ ? if .data else ..drop
              true return
            end
            break
        end
      else
        src
      end =:: genericValue
      genericValues
        genericId
        genericValue ConstValue .TypeId exactMatch if
          GenericArg .fixed
        else
          GenericArg .value
        end
      map.put ..drop
      false return
    NamedType case
      src =:: mut: unwrapSrc
      target =:: mut: unwrapTarget
      while
        unwrapSrc types.isNamedType if
          unwrapSrc typeContext types.flatUnwrapNamed unwrapSrc=
        end
        unwrapTarget typeContext types.flatUnwrapNamed unwrapTarget=
      unwrapTarget .?NamedType ? do end
      ## resolveGenerics
        unwrapSrc
        unwrapTarget
        exactMatch
        needCast
        genericValues
        progContext
      resolveGenerics return
    Pointer MutablePointer ArrayType RawPointer MutableRawPointer case
      src typeContext types.isPointer ! and
          src typeContext types.isArray ! if
        true return
      end
      target typeContext types.isPointer src typeContext types.isPointer != if
        true return ## no implicit casts array <-> pointer
      end
      src typeContext types.isMutable =:: srcMutable
      target typeContext types.isMutable =:: targetMutable
      targetMutable and srcMutable ! if
        true return ## cannot cast immutable to mutable
      end
      srcMutable and targetMutable ! if
        true needCast =[]
      end
      src typeContext types.isFixedSize =:: srcFixed
      target typeContext types.isFixedSize =:: targetFixed
      targetFixed and srcFixed ! if
        true return ## cannot assign unknown-size to fixed-size
      end
      src typeContext types.getArraySize =:: srcSize
      target typeContext types.getArraySize =:: targetSize
      targetFixed and srcFixed if
        targetSize switch
          Dynamic case break
          None case
            srcSize .?None ? ! if
              true return
            end
            break
          Int .case =:: targetSizeValue
            srcSize .?Int .if targetSizeValue != if
                true return
              end
            else .?None ? ! or targetSizeValue 1 != if
                true return
              end
            end
          break
          GenericArg .case =:: genericId
            srcSize sizeAsConst =:: newValue
            genericValues genericId map.at =:: oldValue?
            oldValue? optional.hasData if
              oldValue? .data [] switch
                nonEmpty case break
                value case
                    oldValue? .data [] .value
                    newValue
                  constantEquals ! if true return end
                  break
                fixed case
                    oldValue? .data [] .fixed
                    newValue
                  constantEquals ! if true return end
                  break
              end
            end
            genericValues
              genericId
              newValue GenericArg .fixed
            map.put ..drop
            break
        end
      end
      ## resolveGenerics
        src typeContext types.getBaseType
        target typeContext types.getBaseType
        true
        needCast
        genericValues
        progContext
      resolveGenerics return
    Struct Union RawUnion Enum Initializer case
      src typeContext types.unwrapNamed src=
      src ..label target ..label != if
        true return ## src and target have to be same type of composite
      end
      target typeContext types.compositeEltCount =:: targetCount
      src typeContext types.compositeEltCount =:: srcCount
      targetCount srcCount < if
        true return ## all types in source have to be matched to type in target
      end
      ## resolve generics for all elements of composite type
      targetCount for =:: i
        target i typeContext types.compositeGetElement =:: targetElt
        i srcCount < if
          src i typeContext types.compositeGetElement
        else
          Type .Empty ## extend source with empty if necessary
        end =:: srcElt
        ## resolveGenerics
          srcElt
          targetElt
          true
          needCast
          genericValues
          progContext
        resolveGenerics if
          true return
        end
      end
      false return
    UnionElement case
      ## FIXME implement call-resolving for union-elements
      "unimplemented: call-resolving union elements" ..panic
    Procedure case
      src typeContext types.unwrapNamed src=
      src ..label target ..label != if
        true return
      end
      ## TODO? create helper funtion for matching type-array
      ## separately run for in and out arguments
      src typeContext types.getProcIn .data =:: srcIn
      target typeContext types.getProcIn .data =:: targetIn
      targetIn .length for =:: i
        i srcIn .length u< if
          srcIn i []
        else
          Type .Empty ## extend source with empty if necessary
        end =:: srcElt
        ## resolveGenerics
          srcElt
          targetIn i []
          true
          needCast
          genericValues
          progContext
        resolveGenerics if
          true return
        end
      end
      src typeContext types.getProcOut .data =:: srcOut
      target typeContext types.getProcOut .data =:: targetOut
      targetOut .length for =:: i
        i srcOut .length u< if
          srcOut i []
        else
          Type .Empty ## extend source with empty if necessary
        end =:: srcElt
        ## resolveGenerics
          srcElt
          targetOut i []
          true
          needCast
          genericValues
          progContext
        resolveGenerics if
          true return
        end
      end
      false return
    GeneratedType case
      src typeContext types.unwrapNamedKeepGenerated src=
      ## src has to be a compatible generated type
      src types.isGeneratedType ! if
        true return
      else src typeContext types.getGeneratorLabel
           target typeContext types.getGeneratorLabel != _if
        true return
      end
      src typeContext types.getGeneratorArgs =:: srcArgs
      target typeContext types.getGeneratorArgs =:: targetArgs
      srcArgs .length targetArgs .length == "all instances of generator have same number of arguments" assert
      targetArgs .length for =:: i
        srcArgs i [] =:: srcArg
        targetArgs i [] =:: targetArg
        targetArg .?TypeId .if =:: targetId
          ## resolveGenerics
            srcArg .?TypeId .else "expected srcArg to be Type" ..panic end
            targetId
            true
            needCast
            genericValues
            progContext
          resolveGenerics if
            true return
          end
        else .?GenericArg ._if =:: argId
          genericValues
            argId
          map.at .if
            [] switch
              value .case
                ## XXX? allow auto-casts type-casts
                srcArg >$ constantEquals if break end
                true return
              fixed .case
                srcArg >$ constantEquals if break end
                true return
              nonEmpty case break
            end
          end
          genericValues
            argId
            srcArg GenericArg .fixed
          map.put ..drop
        else ..drop end
      end
      false return
    Undefined Empty PrimitiveType CType AutoType IntLiteral Align TypeSet case
      ..unreachable ## type should not contain generics
  end
end

proc(
  iSize : index
  CallSignatureInfo list ptr.mut : elts
-> CallSignatureInfo ptr.mut ) =>: copyElement
  elts [] ## TODO? add procedure for element copy to list
    $ .length 1:iSize + list.ensureCap
    $ index list.at .data list.appendP
  elts =[]
  elts [] list.peek .data =:: newVal
    newVal [] .paramInfo list.copy newVal .paramInfo=
    newVal [] .genericValues map.copy newVal .genericValues=
  newVal return
end

#+ computes the types are given weight of the given type,
in case of a draw signatures with lower total weight will be prioritized.
This is mainly to prioritize functions acting on smaller number types over larger number types.
+#
proc( Type : t TypeContext ptr : typeContext -> i32 ) =>: computeTypeWeigth
  t typeContext types.isEmpty if
    0 return
  end
  t typeContext types.unwrapNamed types.isPrimitive if
    t typeContext types.primitiveValue switch
      BOOL case 0 return
      I8   case 1 return
      I16  case 2 return
      I32  case 3 return
      I64  case 4 return
      F32  case 5 return
      F64  case 6 return
      TYPE case 7 return
      CHAR8  case  8 return
      CHAR16 case  9 return
      CHAR32 case 10 return
    end
  end
  t typeContext types.isPointer if
    t typeContext types.isFixedSize if
      12 return
    end
    16 return
  end
  t typeContext types.isArray if
    20 return
  end
  t typeContext types.isTypeSet if
    types.primitive.TYPE typeContext computeTypeWeigth 1 - return
  end
  32 return
end
proc(
  CallSignatureInfo : a
  CallSignatureInfo : b
  ProgramContext ptr.mut : progContext
-> i32 ) =>: cmpSignatures
  a .needsParam b .needsParam != if
    ## fully matched before non-match
    a .needsParam if 1  else -1 end return
  end
  a .argsMatch b .argsMatch != if
    ## missing arguments before wrong arguments
    a .argsMatch if -1  else 1 end return
  end
  a .argsMatch ! if
    ## TODO? check if later arguments match to give better feedback
    ## no-match -> compare number of matched parameters
    a .paramInfo .length b .paramInfo .length == if
      ## sort non-matching signatures by declaration order
      a .procId i64 cast b .procId i64 cast < if -1 else a .procId b .procId == _if 0 else 1 end return
    end
    a .paramInfo .length b .paramInfo .length u> if
      -1
    else
      1
    end
    return
  end
  a .nCasts b .nCasts != if
    ## prefer less casts
    a .nCasts b .nCasts < if -1  else 1 end return
  end
  a .nEmpty b .nEmpty != if
    ## prefer less empty parameters
    a .nEmpty b .nEmpty < if -1  else 1 end return
  end
  a .nGenerics b .nGenerics != if
    ## prefer less generics
    a .nGenerics b .nGenerics < if -1  else 1 end return
  end
  a .nRenames b .nRenames != if
    ## prefer less renames
    a .nRenames b .nRenames < if -1  else 1 end return
  end
  a .paramInfo .length b .paramInfo .length != if
    ## prefer more parameters
    a .paramInfo .length b .paramInfo .length u> if -1  else 1 end return
  end
  a .signatureWeigth b .signatureWeigth != if
    ## prefer lower weight
    a .signatureWeigth b .signatureWeigth < if -1  else 1 end return
  end
  0 return
end

proc(
  CallSignatureInfo list ptr.mut : signatures
-> ) =>: cleanupSignatures
  signatures [] list.atItr for =:: elt
    elt [] .paramInfo
      list.free
    elt .paramInfo=
    elt .genericValues map.free
  end
  signatures []
    list.free
  signatures =[]
end

proc(
  LabelId GenericArg hashMap ptr.mut : genericValues
  LabelId : key
-> ConstValue ) =>: getValueOrNone
  genericValues key map.at =:: eltValue?
  eltValue? optional.hasData if
    eltValue? .data [] switch
      nonEmpty case ConstValue .None return
      value case eltValue? .data [] .value return
      fixed case eltValue? .data [] .fixed return
    end
  else
    ConstValue .None return
  end
end

5:iSize =:: MAX_DISPLAY_ARGS_DEFAULT
5:i32 =:: MAX_DISPLAY_SIGNATURES ## XXX? make customizable

proc(
  ProcId slice : procedureIds
  StackValue slice : stackValues
  stringBuilder ptr.mut optional : errorMessage
  FilePosition : pos
  InterpreterContext ptr.mut : interpreterContext
-> ProcedureCallInfo optional ProcId Type ) =>: export: resolveCall
  interpreterContext [] .program =:: progContext
  progContext .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  idContext .constContext =:: constContext
  procedureIds .length 0:iSize == if
    errorMessage optional.hasData if
      errorMessage .data []
        "empty procedure bundle" sb.appendS ##XXX? print name of procedure bundle
      errorMessage .data =[]
    end
    ProcedureCallInfo optional.empty NO_PROC Type .Undefined return
  end
  procedureIds .length CallSignatureInfo list.create =:: mut: currentSignatures
  MAX_DISPLAY_ARGS_DEFAULT =:: mut: maxArgs
  procedureIds for =:: procId
    progContext [] .procedures procId i64 cast list.at .data =:: procInfo
    procInfo [] .procType
      typeContext types.getProcIn $ ? if .data .length else ..drop 0:iSize end
    =:: argCount
    maxArgs argCount iSize.max maxArgs=
    ## TODO! do not create a map for every single procedure
    currentSignatures
      ## CallSignatureInfo
        procId
        argCount ParameterInfo list.create
        labelHash@ labelEq@ argCount i32 cast.u GenericArg map.create
        0
        0
        0
        0
        0
        true
        argCount 0:iSize !=
      CallSignatureInfo new list.append
    currentSignatures=
  end
  0:iSize while $ stackValues .length u<= do =:: stackIndex
    stackIndex stackValues .length u< if
      stackValues stackIndex slice.at .data [] .valType
    else
      ## add dummy type below stack to ensure auto-arguments get matched
      Type .Undefined
    end =:: stackType
    0:iSize while $ currentSignatures .length u< do =:: i
      currentSignatures i list.at .data =:: mut: current
      current [] .argsMatch ! or current [] .needsParam ! if
        ## don't continue checking if first arguments were no match / all params matched
        i 1:iSize + continue
      end
      progContext [] .procedures
        current [] .procId i64 cast list.at .data
      [] .procType =:: procType
      procType typeContext types.getProcIn .data =:: inTypes
      inTypes .length 1:iSize -
        current [] .paramInfo .length -
      i32 cast.u =:: mut: paramIndex
      inTypes paramIndex [] =:: mut: paramType
      procType paramIndex typeContext types.getProcArgLabel =:: mut: paramLabel
      ## XXX? allow passing arrays as individual elements
      while ## skip empty parameters if stack-value is non-empty
        paramType typeContext types.isEmpty or
              paramType typeContext types.isGeneric and
              paramType
                typeContext types.unwrapNamed
              types.getGenericTypeId LabelId cast =:: paramId
              current .genericValues paramId map.at =:: typeVal?
              typeVal? optional.hasData and typeVal? .data [] typeContext isEmptyConstant
            end and stackType typeContext types.isEmpty ! if
          ## empty parameter, non-empty argument
          current [] .paramInfo
            ## ParameterInfo
              stackIndex i32 cast 0
              MatchType .EMPTY
            ParameterInfo new list.append
          current .paramInfo=
          paramIndex 1 - paramIndex=
        else paramLabel labelContext id.labelFlags id.FLAG_AUTO & ? and
            current .genericValues paramLabel map.at .and =:: autoValue
            autoValue [] .?nonEmpty ? ! _if
          autoValue [] switch
            fixed case autoValue .fixed break
            value case autoValue .value break
            nonEmpty case ..unreachable
          end =:: value
          paramType typeContext types.isTypeSet and
              value [] paramType pos interpreterContext interpreter.checkTypeSet ! if
            false current .argsMatch=
          end
          ## convert literal types to corresponding base types
          value [] .?TypeId .and types.isLiteral if
            current .genericValues
              paramLabel
              value [] .TypeId typeContext types.literalToType ConstValue .TypeId GenericArg .fixed
            map.put ..drop
          end
          current [] .paramInfo
            ## ParameterInfo
              stackIndex i32 cast 0
              MatchType .AUTO
            ParameterInfo new list.append
          current .paramInfo=
          paramIndex 1 - paramIndex=
          ## include auto-args in signature weigth
          current [] .signatureWeigth
            paramType typeContext computeTypeWeigth +
          current .signatureWeigth=
        else
          break
        end
      paramIndex 0 >= do
        inTypes paramIndex [] paramType=
        procType paramIndex typeContext types.getProcArgLabel paramLabel=
      end
      paramIndex 0 < if
        false current .needsParam=
        i 1:iSize + continue
      end
      stackIndex stackValues .length u>= if
        i 1:iSize + continue ## no value present
      end
      MatchType .NONE =:: mut: matchType
      paramType typeContext types.isGeneric and
          paramType
            typeContext types.unwrapNamed
          types.getGenericTypeId LabelId cast =:: paramId
          current .genericValues
            paramId
          map.at optional.isEmpty if
        ## add copy of signature with generic type set to empty
        i currentSignatures@ copyElement =:: copySig
        ## update current pointer after changing list
        currentSignatures i list.at .data current=
        copySig .genericValues
          paramId
          Type .Empty ConstValue .TypeId GenericArg .fixed
        map.put ..drop
        copySig [] .nEmpty
          1 +
        copySig .nEmpty=
        ## mark generic as non-empty
        current .genericValues
          paramId
          GenericArg .nonEmpty
        map.put ..drop
      end
      paramLabel labelContext id.labelFlags id.FLAG_STATIC & ? or
          paramType typeContext types.isType if
        stackValues stackIndex @[] .value [] =:: stackVal
        stackVal .?None ? if
          false current .argsMatch=
        end
        paramType typeContext types.isTypeSet and
            stackVal paramType pos interpreterContext interpreter.checkTypeSet ! if
          false current .argsMatch=
        end
        paramLabel id.LABEL_ID_NONE != and
            current .genericValues paramLabel map.at .and =:: prevVal
          prevVal [] switch
            nonEmpty case
              stackVal .?TypeId .and typeContext types.isEmpty end
              break
            value case
              prevVal [] .value stackVal constantEquals !
              break
            fixed case
              prevVal [] .fixed stackVal constantEquals !
              break
        end if
          false current .argsMatch=
        else
          current .genericValues
            paramLabel $ id.LABEL_ID_NONE == if ..drop
              -2 paramIndex - LabelId cast.s
            end
            stackVal GenericArg .fixed
          map.put ..drop
        end
      end
      stackType typeContext types.getArraySize .?None ? and paramType typeContext types.getArraySize .?None ? ! if
        ## count conversion from 0D ptr to 1D ptr as cast
        current [] .nCasts
          1 +
        current .nCasts=
      end
      current [] .signatureWeigth
        paramType typeContext computeTypeWeigth +
      current .signatureWeigth=
      ## try matching type
      paramType typeContext types.containsGeneric and
          false =:: mut: needCast
          ## resolveGenerics
            stackType
            paramType
            false
            needCast@
            current .genericValues
            progContext
          resolveGenerics ! if
        MatchType .GENERIC matchType=
        current [] .nGenerics 1 + current .nGenerics=
        needCast if ## ptr.mut -> ptr
          current [] .nCasts 1 + current .nCasts=
        end
      else stackType paramType types.typeEquals _if
        MatchType .MATCH matchType=
      else stackType paramType typeContext types.canAutoCast _if
        MatchType .CAST matchType=
        stackType =:: mut: fromType
        ## TODO extra casts for more complicated literal conversion
        fromType paramType types.typeEquals ! if
          fromType types.isLiteral if
            fromType typeContext types.literalToType =:: valType
            valType paramType typeContext types.unwrapNamed types.typeEquals ! if
              ## changing literal counts as rename
              current [] .nRenames 1 + current .nRenames=
            end
            paramType types.isNamedType if
              ## changing literal to named type counts as 2 renames
              current [] .nRenames 1 + current .nRenames=
            end
            ## no cast for conversion literal -> value-type
          else paramType typeContext types.isTypeSet and
              fromType typeContext types.isTypeSet ! _if
            ## converting to type-set is no cast
            ## XXX? remember number of conversions to type-set (more restricted is better)
          else fromType typeContext types.unwrapNamed
              paramType typeContext types.unwrapNamed
              types.typeEquals _if
            ## same underlying type but different name
            current [] .nRenames 1 + current .nRenames=
          else
            current [] .nCasts 1 + current .nCasts=
          end
        end
      else
        false current .argsMatch=
      end
      current [] .paramInfo
        ## ParameterInfo
          stackIndex i32 cast
          1
          matchType
        ParameterInfo new list.append
      current .paramInfo=
      paramIndex 0 == and current [] .argsMatch if
        false current .needsParam=
      end
      i 1:iSize +
    end ..drop
    stackIndex 1:iSize +
  end ..drop
  currentSignatures cmpSignatures@ progContext list.sort
  currentSignatures 0 list.at .data =:: candidate
  candidate [] .needsParam or candidate [] .argsMatch ! if
    ## no match
    errorMessage optional.hasData if
      errorMessage .data []
        "no matching signature for arguments ( " sb.appendS
        stackValues .length maxArgs u> if "... " sb.appendS end
        stackValues .length maxArgs iSize.min 1:iSize - while $ 0:iSize iSize.sge do =:: i
          stackValues i slice.at .data =:: val
          val [] .valType typeContext sb.appendType
          val [] .value .?None ? ! if
            " { " sb.appendS
            val [] .value typeContext sb.appendConstant
            " }" sb.appendS
          end
          "  " sb.appendS
          i 1:iSize -
        end ..drop
        ")\ncandidates:\n" sb.appendS
        MAX_DISPLAY_SIGNATURES currentSignatures .length i32 cast.u i32.min =:: maxSignatures
        maxSignatures for =:: i
          currentSignatures i list.at .data =:: mut: current
          progContext [] .procedures
            current [] .procId i64 cast list.at .data
          =:: procInfo
          "  * " sb.appendS
          procInfo [] .procType typeContext sb.appendType
          ' ' sb.appendC
          procInfo [] .labelId labelContext sb.appendLabelPath
          '\n' sb.appendC
        end
        currentSignatures .length i32 cast.u maxSignatures > if "  ...\n" sb.appendS end
      errorMessage .data =[]
    end
    currentSignatures@ cleanupSignatures
    ProcedureCallInfo optional.empty NO_PROC Type .Undefined return
  end
  currentSignatures .length 1:iSize != and
      ## cmpSignatures
        candidate []
        currentSignatures 1 list.at .data []
        progContext
      cmpSignatures 0 == if
    ## multiple matches
    errorMessage optional.hasData if
      errorMessage .data []
        "multiple matching signatures for arguments ( " sb.appendS
        stackValues .length maxArgs u> if "... " sb.appendS end
        stackValues .length maxArgs iSize.min 1:iSize - while $ 0:iSize iSize.sge do =:: i
          stackValues i slice.at .data =:: val
          val [] .valType typeContext sb.appendType
          val [] .value .?None ? ! if
            " { " sb.appendS
            val [] .value typeContext sb.appendConstant
            " }" sb.appendS
          end
          "  " sb.appendS
          i 1:iSize -
        end ..drop
        ")\npossible matches: \n" sb.appendS
        true =:: mut: isEquivalent
        MAX_DISPLAY_SIGNATURES currentSignatures .length i32 cast.u i32.min =:: maxSignatures
        maxSignatures for =:: i
          currentSignatures i list.at .data =:: mut: current
          progContext [] .procedures
            current [] .procId i64 cast list.at .data
          =:: procInfo
          isEquivalent and
              candidate [] current [] progContext cmpSignatures 0 != if
            "other signatures: \n" sb.appendS
            false isEquivalent=
          end
          "  * " sb.appendS
          procInfo [] .procType typeContext sb.appendType
          ' ' sb.appendC
          procInfo [] .labelId labelContext sb.appendLabelPath
          '\n' sb.appendC
        end
        currentSignatures .length i32 cast.u maxSignatures > if "  ...\n" sb.appendS end
      errorMessage .data =[]
    end
    currentSignatures@ cleanupSignatures
    ProcedureCallInfo optional.empty NO_PROC Type .Undefined return
  end
  progContext [] .procedures
    candidate [] .procId i32 cast list.at .data
  =:: procInfo
  candidate [] .procId =:: calledProcId
  ## TODO? nested alias
  procInfo [] .implementation .?Alias .else ..drop
    calledProcId
  end =:: baseProcId
  procInfo [] .procType =:: procType
  procType typeContext types.getProcIn .data =:: inTypes
  procType typeContext types.getProcOut .data =:: outTypes
  inTypes .length i32 cast.u =:: eltCount
  eltCount ConstValue list.create =:: mut: constArgs
  0:i32 while ..dup eltCount < do =:: i
    procType i typeContext types.getProcArgLabel =:: eltLabel
    eltLabel labelContext id.labelFlags id.FLAG_STATIC & ? if
      constArgs
        candidate .genericValues eltLabel getValueOrNone list.append
      constArgs=
    else inTypes i [] types.primitive.TYPE typeContext types.canAutoCast _if
      constArgs
        candidate .genericValues -2 i - LabelId cast.s getValueOrNone list.append
      constArgs=
    end
    i 1 +
  end ..drop
  -1:i32 =:: mut: implId
  eltCount Type list.create =:: mut: typeBuffer
  eltCount LabelId list.create =:: mut: labelBuffer
  constArgs .length 0:iSize != and
      progContext [] .procedures
        baseProcId i64 cast list.at .data
      =:: baseProcInfo
      baseProcInfo .implementation =:: implData
      ## TODO support alias for generic procedures
      implData .?Code .if .implementations =:: impls
    false =:: mut: isMatch
    impls [] .length for =:: i
      impls [] i list.at .data =:: impl
      impl [] .staticArgs .length constArgs .length == "correct number of static arguments" assert
      true isMatch=
      constArgs .length for =:: j
        ## constEquals
          impl [] .staticArgs j []
          constArgs j []
        constantEquals ! if
          false isMatch=
          break
        end
      end
      isMatch if
        i i32 cast.u implId=
        break
      end
    end
    isMatch ! if ## no matching implementation -> create new one
      impls []
        $ .length i32 cast.u implId=
        ## ProcImplementation
          constArgs list.asSlice constContext constArray
          0 VariableInfo list.create
          Operation slice.emptyMutable
          pos
          implData .Code [] .expansionLevel 1:i16 +
          ## replaceGenerics
            baseProcInfo [] .procType
            typeBuffer@
            labelBuffer@
            candidate .genericValues
            ReplaceFlags.REPLACE_NONE
            pos
            interpreterContext
          replaceGenerics
          ProcCodeState .PARSED
        ProcImplementation new list.append
      impls =[]
    end
  end
  constArgs
    list.clear
  constArgs=
  eltCount for =:: i
    procType i typeContext types.getProcArgLabel =:: eltLabel
    eltLabel labelContext id.labelFlags =:: flags
    true =:: mut: needArg
    flags id.FLAG_AUTO & ? if
      candidate .genericValues eltLabel getValueOrNone =:: value
      value .?None ? ! if
        false needArg=
      end
      ## convert literal types to corresponding types
      value .?TypeId .and types.isLiteral if
        candidate .genericValues
          eltLabel
          value .TypeId typeContext types.literalToType ConstValue .TypeId GenericArg .fixed
        map.put ..drop
      end
      constArgs
        value list.append
      constArgs=
    end
    needArg if ## need argument from stack
      inTypes i [] =:: eltType
      ## replaceGenerics
        eltType
        typeBuffer@
        labelBuffer@
        candidate .genericValues
        ReplaceFlags.REPLACE_AUTO_ARGS
        pos
        interpreterContext
      replaceGenerics =:: newElt
      ## ! replaceGenerics changes typeBuffer
      typeBuffer
         newElt list.append
      typeBuffer=
      labelBuffer
        eltLabel list.append
      labelBuffer=
    end
  end
  typeBuffer .length =:: inTypeCount
  labelBuffer .length 0:iSize != if
    while labelBuffer .length typeBuffer .length u< do
      labelBuffer
        id.LABEL_ID_NONE list.append
      labelBuffer=
    end
  end
  outTypes for =:: outType
    ## replaceGenerics
      outType
      typeBuffer@
      labelBuffer@
      candidate .genericValues
      ReplaceFlags.REPLACE_AUTO_ARGS ReplaceFlags.IGNORE_EMPTY |
      pos
      interpreterContext
    replaceGenerics =:: newOut
    typeBuffer
      newOut list.append
    typeBuffer=
    ## TODO? ensure out-labels are preserved
  end
  ## newProcedure
    typeBuffer list.asSlice inTypeCount slice.head
    typeBuffer list.asSlice inTypeCount slice.tail
    labelBuffer list.asSlice
    procInfo [] .procType typeContext types.getCallConvention
    typeContext
  types.newProcedure .data =:: calledType
  typeBuffer list.free typeBuffer=
  labelBuffer list.free labelBuffer=
  ## ProcedureCallInfo
    baseProcId
    implId
    constArgs list.asSlice constContext constArray
  ProcedureCallInfo new =:: result
  constArgs list.free constArgs=
  currentSignatures@ cleanupSignatures
  result optional.wrap calledProcId calledType return
end
