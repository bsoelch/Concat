#include string

proc( char => bool ) =: public isWhitespace
  switch
    ' ' '\n' '\t' '\v' '\f' '\r' case
      true return
    default
      false return
  end
end
proc( i8 : chr => i32 ) =: public parseDigit
  chr '0' >= chr '9' <= & if
    chr '0' - return
  else chr 'A' >= chr 'Z' <= & _if
    chr 'A' - 10 + return
  else chr 'a' >= chr 'z' <= & _if
    chr 'a' - 10 + return
  end
  -1 return
end
enum( NONE INVALID_BASE EMPTY INVALID_CHAR OVERFLOW ) =:: public ParseIntError
proc( string : str  i32 : base => i64 ParseIntError ) =: public tryParseInt
  false =:: mut sign
  base =:: mut mBase
  base 0 != base 2 < base 62 > | & if
    0 ParseIntError .INVALID_BASE return
  end
  0 i64 =: mut res
  false =:: mut overflow
  str
    #dup 0 string.charAt '-' == if
      true sign =
      1 string.tail
    else #dup 0 string.charAt '+' == _if
      1 string.tail
    end
    #dup .length 0 == if
      #drop 0 ParseIntError .EMPTY return
    end
    mBase 0 == if
      10 mBase =
      #dup 0 string.charAt '0' == if
        #dup 1 string.charAt 'x' == if
          16 mBase =
          2 string.tail
        else #dup 1 string.charAt 'b' == _if
          2 mBase =
          2 string.tail
        end
      end
    end
    sign if -0x8000_0000_0000_0000 else 0x7fff_ffff_ffff_ffff end mBase /u =:: maxSafe
    0 while #dup #over:2 .length < do
      #over #over string.charAt
        #dup '_' == #over '\'' == | if
          #drop ## ignore _ and ' in numbers
          1 + continue
        end
      parseDigit
        #dup 0 < #over mBase > | if
          #drop:3 0 ParseIntError .INVALID_CHAR return ## ERR_INVALID_CHAR
        end
      res
        #dup maxSafe > if
          true overflow =
        end
        mBase * +
      res = ## add digit to number
      1 +
    end #drop
  #drop
  res
    sign if neg end
  overflow if ParseIntError .OVERFLOW return else ParseIntError .NONE return end
end

