import arenaAlloc

import "program.concat"
import "branchTree.concat"
using id.IdentifierFlag


iSize =:: VariableUse ## use low two bits for type (Read,Write,Label) and remaining bits for location
namespace: VariableUse
  2:iSize =:: TAG_BITS
  0:iSize =:: TYPE_READ
  1:iSize =:: TYPE_WRITE
  2:iSize =:: TYPE_LABEL
  3:iSize =:: TYPE_MASK
  proc( iSize -> VariableUse ) =>: read
    TAG_BITS << TYPE_READ | VariableUse cast
  end
  proc( iSize -> VariableUse ) =>: write
    TAG_BITS << TYPE_WRITE | VariableUse cast
  end
  proc( LocalLabelId -> VariableUse ) =>: label
    iSize cast TAG_BITS << TYPE_LABEL | VariableUse cast
  end
  proc( VariableUse -> iSize optional ) =>: asRead
    iSize cast $ TYPE_MASK & TYPE_READ == if
      TAG_BITS >>> optional.wrap
    else ..drop iSize optional.empty end
  end
  proc( VariableUse -> iSize optional ) =>: asWrite
    iSize cast $ TYPE_MASK & TYPE_WRITE == if
      TAG_BITS >>> optional.wrap
    else ..drop iSize optional.empty end
  end
  proc( VariableUse -> LocalLabelId optional ) =>: asLabel
    iSize cast $ TYPE_MASK & TYPE_LABEL == if
      iSize cast TAG_BITS >>> LocalLabelId cast optional.wrap
    else ..drop LocalLabelId optional.empty end
  end
end
union(
  _ : Arg
  _ : Read
  VariableUse : Use
  ( VariableUse VariableUse ) : Use2
  ( VariableUse VariableUse VariableUse ) : Use3
  VariableUse list : Uses
) =:: VariableUses
namespace: VariableUses
  proc( iSize -> VariableUses ) =>: read
    VariableUse.read VariableUses .Use
  end
  proc( iSize -> VariableUses ) =>: write
    VariableUse.write VariableUses .Use
  end
  proc( LocalLabelId -> VariableUses ) =>: label
    VariableUse.label VariableUses .Use
  end
 ( VariableUses -> VariableUses ) =>: copy
   .Uses .if
     list.copy VariableUses .Uses
   end
 end
  proc( type : auto: C VariableUses ( VariableUse C -> ) ptr : f C : context -> ) =>: forEach
    switch
      Arg Read case return
      Use .case context f () return
      Use2 .case
          $ .0 context f ()
        .1 context f ()
      return
      Use3 .case
          $ .0 context f ()
          $ .1 context f ()
        .2 context f ()
      return
      Uses .case for context f () end return
    end
  end
end
struct(
  VariableUses : uses
  NameId : name
) =:: VariableUseInfo
namespace: VariableUseInfo
 ( VariableUseInfo : a VariableUseInfo : b -> i32 ) =>: cmp
   a .name b .name NameId.cmp
 end
 ( VariableUseInfo -> VariableUseInfo ) =>: copy
   $ .uses VariableUses.copy >$ .uses=
 end
end

struct(
  ProgramContext ptr.mut : program
  NameId VariableUses hashMap : variableUses
  LocalLabelId VariableUseInfo list hashMap : labelVariableUses
  FileId : currentFile
  i32 : inlineCount
  bool : reachable
) =:: ConverterContext

proc(
  ProcId : procId
  ProgramContext ptr.mut : program
-> Operation slice ) =>: calledProcOps
  procId ProcId.getProcInfo =:: procInfo
  program [] .progFiles
    procInfo [] .fileId i64 cast.u
  @[] =:: procFile
  procInfo .implementation .Code .else
    "expected code-proc" ..panic
  end =:: impl
  impl [] .code slice.freeze
end


proc(
  Type : varType
  bool : mutable
  FilePosition ptr : pos
  ConverterContext ptr.mut : context
-> IdentifierInfo ) =>: newTmpVar ## TODO? merge with id.newTmpVar
  context [] .program .idContext =:: idContext
  idContext .typeContext .nameContext =:: nameContext
  id.FLAG_NONE mutable if
    id.FLAG_MUTABLE | IdentifierFlag cast
  end =:: flags
  ## newIdentifier
    string.empty
    flags ## XXX? special flag for tmp vars
    pos
    nameContext
  id.newIdentifier =:: nameId
  nameId varType pos idContext id.declareTmpVar
  ## IdInfo
    nameId
    IdentifierType .TMP_VAR false
  IdentifierInfo new return
end
proc(
  ProcId : procId
  ProgramContext ptr.mut : program
-> bool ) =>: shouldInline
  program .idContext .typeContext .nameContext =:: nameContext
  optimizerFlags.ALLOW_INLINE ! and optimizerFlags.ALLOW_INLINE_SMALL ! if false return end
  procId ProcId.getProcInfo =:: procData
  procData .implementation [] .Code ? ! or
      procData [] .nameId nameContext id.identifierFlags id.FLAG_EXTERN & ? or
      procData [] .nameId nameContext id.identifierFlags id.FLAG_NO_INLINE & ? if
    false return
  end
  procId program calledProcOps =:: procOps
  ## TODO? small procedures should only be inlined if they don't contain jumps
  procOps .length 10 u<= if true return end ## init+op{0-7}+ret+end
  optimizerFlags.ALLOW_INLINE ! if false return end
  ## TODO! detect if proc is currently being inlined (smaller inline-limits in nested inline, prevent recursive inline)
  ## TODO compute inline weight depending on operations in procedure, cache weight in procedure(-impl) info
  procOps .length 18:iSize u<=
end

proc(
  Operation list
  ProcId : procId
  FilePosition ptr : pos
  ConverterContext ptr.mut : context
-> Operation list ) =>: inlineCall
  context [] .program =:: program
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .nameContext =:: nameContext
  procId ProcId.getProcInfo .implementation [] .Code ? "only code-procs are inlined" assert
  procId program calledProcOps =:: procOps
  NameId.hash@ NameId.eq@ 64 IdentifierInfo map.create =:: mut: remapIds ## TODO? store in context
  LocalLabelId.hash@ LocalLabelId.eq@ 64 LocalLabelId map.create =:: mut: remapLabels
  program program.nextLocalLabel =:: procEnd
  $ .length =:: startLabelPos
  procEnd LocalLabelType .HINT_START pos opLabel context filterOp
  procOps 0 [] .dataType =:: procType
  procType typeContext types.getProcIn optional.unwrap =:: inTypes
  0 =:: mut: offset
  ## create tmp-variables for named arguments
  inTypes .length i32 cast.u 1 - while $ 0 >= do =:: i
    procType i typeContext types.getProcArgName =:: argName
    inTypes i [] =:: eltType
    eltType typeContext types.isEmpty if continue end ## ignore empty arguments
    argName id.NAME_ID_NONE == if
      offset 1 + offset=
    else argName nameContext id.identifierFlags id.FLAG_STATIC & ? ! _if
      offset 0 != if
        ## rotate named argument to top
        offset StackModType .ROTATE pos opStackMod context filterOp
      end
      eltType argName nameContext id.identifierFlags id.FLAG_MUTABLE & ? pos context newTmpVar =:: tmpId
      eltType tmpId pos opInitializeId context filterOp
      remapIds@ argName tmpId map.put optional.isEmpty "identifier-value only reassigned once" assert
    end
  finally i 1 - end ..drop
  false =:: mut: hasEarlyReturn
  procOps 1:iSize $1 .length 2:iSize - slice.getSlice
    $ .length 1 - =:: last
    $ last [] .val .Return ? if last >$ .length= end ## ignore return at end of proc
  for =:: mut: op
    op .val .Return ? if
      true hasEarlyReturn=
      procEnd 0:JumpDistance CompareType .NONE op .pos opJump context filterOp
      continue
    else op .val .GetId ._if .nameId =:: nameId
      remapIds@ nameId map.get .if op@ .val .GetId= end
    else .SetId ._if .nameId =:: nameId
      remapIds@ nameId map.get .if op@ .val .SetId= end
    else .AtId ._if .nameId =:: nameId
      remapIds@ nameId map.get .if op@ .val .AtId= end
    ## TODO? handle declareId and initializeId
    else .LocalJump ._if .labelId =:: label
      remapLabels@ label map.get .else
        program program.nextLocalLabel
        remapLabels@ label $2 map.put ..drop
      end op@ .val .LocalJump .if .labelId =[] else ..drop.2 end
    else .LocalLabel ._if .labelId =:: label
      remapLabels@ label map.get .else
        program program.nextLocalLabel
        remapLabels@ label $2 map.put ..drop
      end op@ .val .LocalLabel .if .labelId =[] else ..drop.2 end
    else ..drop end
    op context filterOp
  end
  hasEarlyReturn if
    procEnd LocalLabelType .LABEL_END pos opLabel context filterOp
  else
    $ startLabelPos list.at .and =:: op op .val [] .LocalLabel .and .labelType .HINT_START if
      opValNOP op .val=
    end
  end
  remapIds@ map.free
  remapLabels@ map.free
end

struct( ConverterContext ptr.mut : shadow: context Operation slice.mut : shadow: ops NameId : nameId ) =:: VarReadContext
proc( VariableUse : use VarReadContext : curry -> ) =>: markVarAsRead
  use VariableUse.asLabel .if =:: useLabel
    curry .context .labelVariableUses
      useLabel
    map.at .if =:: varInfo
      VariableUses .Read curry .nameId VariableUseInfo new =:: newUse
      varInfo [] list.asSlice
        newUse
        VariableUseInfo.cmp@
      slice.binarySearch switch
        Match .case varInfo [] >$ @[]
            $ [] .uses =:: oldUses
          newUse >$ =[]
          oldUses markVarAsRead@ curry VariableUses.forEach
          oldUses .Uses .if list.free ..drop else ..drop end
        break
        Missing .case
          varInfo [] newUse >>$ list.insert varInfo =[]
        break
      end
    end
  else use VariableUse.asRead ._if =:: readIndex
    curry .ops readIndex @[] .val .GetId .if false >$ .noRead= else "ops out of sync" ..panic end
  else use VariableUse.asWrite ._if =:: writeIndex
    curry .ops writeIndex @[] .val .SetId .if false >$ .noRead= else "ops out of sync" ..panic end
  end
end
proc(
  Operation slice.mut : ops
  LocalLabelId : labelId
  bool : preserveSource
  ConverterContext ptr.mut : context
-> ) =>: mergeVariableUses
  context .labelVariableUses labelId map.at .else
    context .labelVariableUses labelId 4 VariableUseInfo list.create map.put ..drop
    context .labelVariableUses labelId map.at optional.unwrap
  end =:: labelUseInfo
  ## merge current state into label state
  context .variableUses for =:: nameId =:: uses
    uses nameId VariableUseInfo new =:: currentUses
    preserveSource ! =:: mut: needFree
    labelUseInfo [] list.asSlice
       currentUses
       VariableUseInfo.cmp@
    slice.binarySearch switch: labelMatch
      Match .case
        labelUseInfo [] >$ @[] =:: labelUses
        labelUses .uses switch
          Read case
            ( Operation slice.mut : shadow: ops ) =:: Curry
            ## var read after label -> mark all new uses for label as read
            uses ( VariableUse : use Curry : curry -> ) =>
              use VariableUse.asRead .if =:: readIndex
                curry .ops readIndex @[] .val .GetId .if false >$ .noRead= else "ops out of sync" ..panic end
              else use VariableUse.asWrite ._if =:: writeIndex
                curry .ops writeIndex @[] .val .SetId .if false >$ .noRead= else "ops out of sync" ..panic end
              end
            end ops Curry new VariableUses.forEach
          break.labelMatch
          Arg case
            currentUses
              preserveSource if VariableUseInfo.copy end
              false needFree=
            labelUses =[]
          break.labelMatch
          Uses .case break
          Use .case []
            4 VariableUse list.create >$ list.append labelUses .uses .Uses=
            labelUses .uses .Uses .else ..unreachable end
          break
          Use2 .case []
            4 VariableUse list.create $1 .0 list.append >$ .1 list.append labelUses .uses .Uses=
            labelUses .uses .Uses .else ..unreachable end
          break
          Use3 .case []
            4 VariableUse list.create $1 .0 list.append $1 .1 list.append >$ .2 list.append labelUses .uses .Uses=
            labelUses .uses .Uses .else ..unreachable end
          break
        end =:: useList
        ( ConverterContext ptr.mut : shadow: context VariableUse list ptr.mut : shadow: useList ) =:: Curry
        ## mark all preceding labels as read
        uses ( VariableUse : use Curry : curry -> ) =>
          curry .useList [] use list.append curry .useList =[]
        end context useList Curry new VariableUses.forEach
      break
      Missing .case
        labelUseInfo [] currentUses
          preserveSource if VariableUseInfo.copy end
          false needFree=
        >>$ list.insert labelUseInfo =[]
      break
    end
    needFree and uses .Uses .if list.free ..drop end
  end
end

proc(
  Operation slice.mut : ops
  iSize : index
  ConverterContext ptr.mut : context
-> ) =>: analizeOp
  ops index [] =:: op
  context [] .program =:: program
  program .errors =:: errors
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .nameContext =:: nameContext
  op .val switch
    ImplementProcedure case
      ## mark argument variables as initialized
      op .dataType typeContext types.getProcArgNames for =:: nameId
        nameId id.NAME_ID_NONE != if
          context .variableUses
            nameId
            VariableUses .Arg
          map.put ..drop
        end
      end
      true context .reachable=
    break
    GetId .case =:: idInfo
      ops index @[] .val .GetId .if true >$ .noRead= else ..unreachable end
      context .variableUses
        idInfo .nameId
        index VariableUses.read
      map.put .if =:: prevUses
        ## mark all preceding labels/reads/writes as read
        prevUses markVarAsRead@ context ops idInfo .nameId VarReadContext new VariableUses.forEach
        prevUses .Uses .if list.free ..drop else ..drop end
      else
        "read from uninitialized value: " sb.copyPtr
          idInfo nameContext sb.appendIdInfo
        op .pos errors appendWarning
      end
      ## FIXME! ensure variable is marked as read in ALL labels after previous write (that can be targets of back-jumps)
    break
    SetId .case =:: idInfo
      ops index @[] .val .SetId .if true >$ .noRead= else ..unreachable end
      context .variableUses
        idInfo .nameId
        index VariableUses.write
      map.put .if
        .Uses .if list.free ..drop else ..drop end
        ## check is var is writeable
        idInfo .nameId nameContext id.identifierFlags id.FLAG_MUTABLE & ? ! if
          256 sb.create
            idInfo nameContext sb.appendIdInfo
            " is not mutable" sb.appendS
          op .pos errors appendError
        end
      end
    break
    LocalJump .case =:: jumpInfo
      jumpInfo .cmpType .NONE if
        false context .reachable=
      end
      ops jumpInfo .labelId context [] .reachable context mergeVariableUses
      context [] .reachable ! if
        context .variableUses map.clear
      end
    break
    Block .case =:: blockData
      blockData .blockType .SWITCH if
        program [] .switchData blockData .blockId iSize cast.u @[] =:: switchData
        context [] .reachable "switch-start is reachable" assert
        switchData [] .branchLabels for
          ops >$ true context mergeVariableUses
        end
        ops switchData [] .defaultLabel false context mergeVariableUses
        context .variableUses map.clear
        false context .reachable=
      end
    break
    Return case
      context .variableUses
        $ for ..drop .Uses .if list.free ..drop else ..drop end end
      map.clear
      false context .reachable=
    break
    LocalLabel .case =:: labelInfo
      labelInfo .labelType switch
        HINT_START HINT_END case return
        LABEL_START LABEL_MIDDLE LABEL_END case break
      end
      context [] .reachable if
        ops labelInfo .labelId false context mergeVariableUses
        context .variableUses map.atItr for [] =:: nameId =:: useInfo
          labelInfo .labelId VariableUses.label useInfo =[]
        end
      else
        ## reset to state at label
        true context .reachable=
        context .labelVariableUses labelInfo .labelId map.get .else
          "label only readable through backwards jump" ..panic
        end for =:: varUseInfo
          varUseInfo .uses .Read ? if continue end ## is this even reachable
          context .variableUses varUseInfo .name varUseInfo .uses map.put ..drop
        end
      end
    break
    default break
  end
end
proc(
  Operation list : newOps
  Operation : mut: op
  ConverterContext ptr.mut : context
-> Operation list ) =>: filterOp
  context [] .program =:: program
  program .errors =:: errors
  program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .nameContext =:: nameContext
  op .val switch
    NOP case newOps return ## ignore no-ops
    Call .case =:: callVal
      callVal program shouldInline if
        newOps callVal op .pos context inlineCall return
      end
    break
    ProcPtr .case =:: procId
      procId ProcId.getProcInfo .implementation .BuiltIn .if
        true >$ .hasPtr=
      else ..drop end
    break
    ConstantReference NewReference
    TypeInfo NewUnionReference UsingNamespace UsingIdentifier
    GetName AtName SetName GetNamedElt Assert DeclareName AliasName InitializeName
    SetNamedElt Length TypeModifier TypeWith ExistsNamedElt ExistsName NestedProc Import LibImport case
      "unsupported operation " sb.copyPtr
        op program sb.appendOp
      op .pos errors appendError
    newOps return
    default break
  end
  newOps op list.append return ## nothing to change
end

proc(
  Operation slice.mut : mut: oldOps
  Operation list ptr.mut : tmpOps
  ConverterContext ptr.mut : context
-> Operation slice.mut ) =>: analizeProc
  context [] .program =:: program
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .nameContext =:: nameContext
  _EXPERIMENTAL_ if
    oldOps .length for =:: index
      oldOps index context analizeOp
    end
    context .variableUses
      $ for ..drop .Uses .if list.free ..drop else ..drop end end
    map.clear
  end
  ## TODO? free local variable uses
  tmpOps []
    $ .length 0 == "tmp-ops are empty" assert
    oldOps for
      context filterOp
    end
    $ list.asSlice slice.copy =:: newCode
  tmpOps =[]
  oldOps slice.free ..drop
  newCode
end

proc( ProgramContext ptr.mut : program -> ) =>: export: usageAnalysis
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .nameContext =:: nameContext
  ## ConverterContext
    program
    NameId.hash@ NameId.eq@ 1024 VariableUses map.create
    LocalLabelId.hash@ LocalLabelId.eq@ 1024 VariableUseInfo list map.create
    -1:FileId
    0
    false
  ConverterContext new =:: mut: contextData
  ## sort procs to ensure inlinable procs are before non-inlinable procs
  ## TODO: precompute for each proc if it should be inlined
  program [] .procedures ( ProcId : a ProcId : b -> i32 ) =>
    a ProcId.getProcInfo =:: aData
    b ProcId.getProcInfo =:: bData
    aData [] .implementation ..tag bData [] .implementation ..tag != if
      aData [] .implementation ..tag i32 cast.s bData [] .implementation ..tag i32 cast.s - return
    end
    aData .implementation [] .Code .else ..drop 0 return end =:: aCode
    bData .implementation [] .Code .else ..drop 0 return end =:: bCode
    ## TODO sort by inlinability
    aCode .code .length bCode .code .length iSize.cmp return
  end list.sort
  ## TODO 2 passes for each proc
  ## pass 1
  ## [ ] mark writes that are never read
  ## [ ] mark last direct read before write
  ## [ ] detect unconditional jump directly after label(s) -> can replace jump to label with jumpto target
  ## pass 2
  ## [*] inlining
  ## [ ] remove unused writes
  ## [ ] update chain jumps, remove chain labels
  ## afterwards:
  ## * discard procs that are always inlined
  ## TODO -> seperate compilation phase for copy-analysis
  ## * insert 'copy' operations for composites
  ## * second round of constant folding
  ## * merged aliased local variables
  ## ? detect stack values that are never read (? only if optimizations are enabled)
  ## ? remove push (+pops) of values that are poped on every branch (? only if optimizations are enabled)
  ## ? borrow-checking
  contextData@ =:: context
  program [] .globalOps list.clear program .globalOps= ## global ops are no longer needed
  Operation list.empty =:: mut: tmpOps
  program [] .procedures for ProcId.getProcInfo =:: currentProc
    currentProc .implementation .Code .else ..drop
      continue
    end =:: impl
    tmpOps list.clear tmpOps=
    currentProc [] .fileId context .currentFile=
    program [] .progFiles
      currentProc [] .fileId i64 cast
    @[] =:: f
    ## analizeProc
      impl [] .code
      tmpOps@
      context
    analizeProc impl .code=
    ## ProcCodeState .COMPILED impl .codeState= ## TODO? add extrac code-state for proc after current phase
  end
  ## create implementations for built-in procedure-pointers
  program [] .procedures for =:: procId
    procId ProcId.getProcInfo =:: currentProc
    currentProc .implementation .BuiltIn .else ..drop
      break ## built-ins at start of procedure list
    end =:: builtInImpl
    builtInImpl [] .hasPtr ! if
      continue
    end
    currentProc [] .nameId nameContext id.identifierPos .else
      "missing identifier position" ..panic
    end =:: pos
    4 Operation mem.alloc 4 slice.createMutable =:: opBuffer
    opBuffer list.wrapSlice
      ## opImplementProc
        currentProc [] .procType
        procId
        pos
      opImplementProc list.append
      ## opBuiltIn
        currentProc [] .procType
        builtInImpl [] .builtIn
        pos
      opBuiltIn list.append
      currentProc [] .procType pos opReturn list.append
      BlockType .PROCEDURE pos opEndBlock list.append
    ..drop
    ## CodeProcData
      0 VariableInfo list.create
      opBuffer
      GenericProcInfo .None
      ProcCodeState .COMPILED ## skip pre-compiler
      0:i16
    CodeProcData new currentProc .implementation .Code=
  end
  tmpOps list.free ..drop
end
