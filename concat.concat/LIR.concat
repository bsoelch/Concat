'stringBuilder' import

"IR" import
"identifiers" import

namespace: LIROp
  ## TODO? bit-field/vector-types: BITS32 BITS64 V64 V128 V256
  enum(
    BOOL
    I8 I16 I32 I64
    F16 F32 F64
    PTR FPTR
  ) =:: export: ValType
  namespace: ValType
    proc( -> ValType ) =>: export: I_SIZE
      ValType .I64
    end
    proc( ValType -> i32 ) =>: export: size
      switch
        BOOL case 1 return
        I8 case 1 return
        I16 F16 case 2 return
        I32 F32 case 4 return
        I64 F64 case 8 return
        PTR FPTR case 8 return
      end
    end
    proc( ValType -> bool ) =>: export: isInt
      switch
        I8 I16 I32 I64 case true return
        default false return
      end
    end
    proc( ValType -> bool ) =>: export: isFloat
      switch
        F16 F32 F64 case true return
        default false return
      end
    end
    proc( ValType -> bool ) =>: export: isPointer
      switch
        PTR FPTR case true return
        default false return
      end
    end
    proc( ValType ValType -> ValType optional ) =>: export: mergeUnionElt
      $1 $1 == if ..drop optional.wrap return end ## values are the same
      ## TODO? support merge of different sized floats to V<n>F
      >$ ValType.size >$ ValType.size i32.max switch
        1 case ValType .I8 optional.wrap return
        2 case ValType .I16 optional.wrap return
        4 case ValType .I32 optional.wrap return
        8 case ValType .I64 optional.wrap return
        default { } return
      end
    end
    proc( stringBuilder ValType -> stringBuilder ) =>: export: sbAppend
      switch
        BOOL case "bool":s sb.appendStr return
        I8 case "i8":s sb.appendStr return
        I16 case "i16":s sb.appendStr return
        I32 case "i32":s sb.appendStr return
        I64 case "i64":s sb.appendStr return
        F16 case "f16":s sb.appendStr return
        F32 case "f32":s sb.appendStr return
        F64 case "f64":s sb.appendStr return
        PTR case "ptr":s sb.appendStr return
        FPTR case "fptr":s sb.appendStr return
      end
    end
  end
  ( type : T -> type ) =>: export: typed
    ( T : val ValType : valType )
  end
  struct(
    LocalLabelId : labelId
    CompareType : cmpType
    ValType : valType
  ) =:: export: JumpInfo
  struct(
    ValType slice : data ## [outArgTypes argTypes] retTypes
    i32 : argCount
    i32 : outArgCount
  ) =:: export: ProcTypeInfo
  namespace: ProcTypeInfo
    proc( stringBuilder ProcTypeInfo -> stringBuilder ) =>: sbAppend
      $ .data >$ .argCount iSize cast.u slice.cutIndex <<$
        for
          ValType.sbAppend
        end
        " -- ":s sb.appendStr
      >$ for
        ValType.sbAppend
      end
    end
  end
  enum(
    NEG ADD SUB MUL
    DIV UDIV REM UREM DIVREM UDIVREM
    NOT AND OR XOR
    SHL LSHR ASHR
  ) =:: export: Arithmetic
  namespace: Arithmetic
    { "neg":s "add":s "sub":s "mul":s
      "div":s "udiv":s "rem":s "urem":s "divrem":s "udivrem":s
      "not":s "and":s "or":s "xor":s
      "shl":s "lshr":s "ashr":s
    } =:: NAMES
    NAMES ..length Arithmetic ..length == "correct number of names" assert
    proc( stringBuilder Arithmetic -> stringBuilder ) =>: sbAppend
      NAMES >$ ..tag iSize cast.u [] sb.appendStr
    end
  end
  union(
    _ : Nop
    bool : ConstBool
    i64 typed : ConstInt
    f64 typed : ConstFloat
    ProcId : ConstProcPtr
    ## TODO const-ref
    IdentifierInfo typed : GetId
    IdentifierInfo typed : GetId2
    IdentifierInfo typed : GetId3
    IdentifierInfo typed : SetId
    IdentifierInfo typed : SetId2
    IdentifierInfo typed : SetId3
    IdentifierInfo : AtId
    Arithmetic typed : shadow: Arithmetic
    CompareType typed : Compare
    ## TODO: convert
    ## TODO: load
    ## TODO: store
    ## TODO: memcpy, memclear
    ## TODO: sys (argc,argv,envp)
    LocalLabelInfo : LocalLabel
    JumpInfo : LocalJump
    ProcTypeInfo ptr : BeginProc
    ProcTypeInfo ptr : Call
    ProcTypeInfo ptr : Return
    _ : EndProc
    i32 : Copy
    i32 : Drop
    i32 : Rotate
    i32 : Rotate2
    i32 : Rotate3
  ) =:: export: Data
end
struct(
  LIROp.Data : data
  FilePosition ptr : pos
) =:: export: LIROp

"program" import

namespace: LIROp.new
  proc( i32 #+count+# FilePosition ptr #+pos+# -> LIROp ) =>: export: lirDrop
    >$ LIROp.Data .Drop >$ LIROp new
  end
  proc( i32 #+count+# FilePosition ptr #+pos+# -> LIROp ) =>: export: lirCopy
    >$ LIROp.Data .Copy >$ LIROp new
  end
  proc( i32 #+count+# FilePosition ptr #+pos+# -> LIROp ) =>: export: lirRotate
    >$ LIROp.Data .Rotate >$ LIROp new
  end
  proc( i32 #+count+# FilePosition ptr #+pos+# -> LIROp ) =>: export: lirRotate2
    >$ LIROp.Data .Rotate2 >$ LIROp new
  end
  proc( i32 #+count+# FilePosition ptr #+pos+# -> LIROp ) =>: export: lirRotate3
    >$ LIROp.Data .Rotate3 >$ LIROp new
  end
  proc( ConstValue #+constVal+# Type #+dataType+# FilePosition ptr #+pos+# ProgramContext ptr.mut : program -> LIROp ) =>: export: lirConstRef
    "unimplemented: const-references" ..panic
  end
  proc( bool #+constVal+# FilePosition ptr #+pos+# -> LIROp ) =>: export: lirBoolConst
    <$ LIROp.Data .ConstBool >$ LIROp new
  end
  proc( i64 #+constVal+# ValType #+intType+# FilePosition ptr #+pos+# -> LIROp ) =>: export: lirIntConst
    <<$ i64 LIROp.typed new LIROp.Data .ConstInt >$ LIROp new
  end
  proc( f64 #+constVal+# ValType #+floatType+# FilePosition ptr #+pos+# -> LIROp ) =>: export: lirFloatConst
    <<$ f64 LIROp.typed new LIROp.Data .ConstFloat >$ LIROp new
  end
  proc( ProcId #+constVal+# FilePosition ptr #+pos+# -> LIROp ) =>: export: lirProcConst
    <$ LIROp.Data .ConstProcPtr >$ LIROp new
  end
  proc( ConstValue #+constVal+# ValType #+valType+# FilePosition ptr #+pos+# ProgramContext ptr.mut : program -> LIROp ) =>: export: lirConst
    >>$ switch
      Bool .case >>$ ..drop
        <$ lirBoolConst
      return
      Char .case i64 cast.u
        <<$ lirIntConst
      return
      Int .case
        <<$ lirIntConst
      return
      Float .case
        <<$ lirFloatConst
      return
      Procedure .case >>$ ..drop
        <$ lirProcConst
      return
      .default
        "unsupported constant for ValType " sb.copyPtr
          >>>$ ValType.sbAppend
          ": ":s sb.appendStr
          >$ program .idContext .typeContext sb.appendConstant
        $1 program .errors appendError
        LIROp.Data .Nop >$ LIROp new ## return nop
      break
    end
  end
  proc( ProcId #+constVal+# FilePosition ptr #+pos+# -> LIROp ) =>: export: lirProcPtr
    <$ LIROp.Data .ConstProcPtr >$ LIROp new
  end
  proc( LocalLabelInfo #+labelInfo+# FilePosition ptr #+pos+# -> LIROp ) =>: export: lirLabel
    >$ LIROp.Data .LocalLabel >$ LIROp new
  end
  proc( LocalLabelId #+labelInfo+# CompareType #+cmp+# ValType #+valType+# FilePosition ptr #+pos+# -> LIROp ) =>: export: lirJump
    <<<$ LIROp.JumpInfo new LIROp.Data .LocalJump >$ LIROp new
  end
  proc( LIROp.ProcTypeInfo ptr FilePosition ptr #+pos+# -> LIROp ) =>: export: lirBeginProc
    <$ LIROp.Data .BeginProc >$ LIROp new
  end
  proc( LIROp.ProcTypeInfo ptr FilePosition ptr #+pos+# -> LIROp ) =>: export: lirReturn
    <$ LIROp.Data .Return >$ LIROp new
  end
  proc( LIROp.ProcTypeInfo ptr FilePosition ptr #+pos+# -> LIROp ) =>: export: lirCall
    <$ LIROp.Data .Call >$ LIROp new
  end
  proc( FilePosition ptr #+pos+# -> LIROp ) =>: export: lirEndProc
    LIROp.Data .EndProc >$ LIROp new
  end
  proc( string #+msg+# FilePosition ptr #+pos+# -> LIROp ) =>: export: lirPanic
    "unimplemented: lir-panic" ..panic
  end
  proc( LIROp.Arithmetic #+op+# ValType #+opType+# FilePosition ptr #+pos+# -> LIROp ) =>: export: lirArithmetic
    <<$ LIROp.Arithmetic LIROp.typed new LIROp.Data .Arithmetic >$ LIROp new
  end
  proc( CompareType #+op+# ValType #+opType+# FilePosition ptr #+pos+# -> LIROp ) =>: export: lirCompare
    <<$ CompareType LIROp.typed new LIROp.Data .Compare >$ LIROp new
  end
end
namespace: LIROp
  proc( type : auto: T stringBuilder T typed string -> stringBuilder T ) =>: prepareSbAppendTyped
    >>$ >$ sb.appendStr $1 .valType ValType.sbAppend ": ":s sb.appendStr >$ .val
  end
  proc( stringBuilder IdentifierInfo typed string NameContext ptr : nameContext -> stringBuilder ) =>: sbAppendIdInfo
    prepareSbAppendTyped nameContext sb.appendIdInfo
  end
  proc( stringBuilder LIROp ProgramContext ptr : program -> stringBuilder ) =>: export: sbAppend
    program .idContext .typeContext .nameContext =:: nameContext
    <$ $1 .data switch
      Nop case "NOP":s sb.appendStr break
      ConstBool .case if "const true":s sb.appendStr else "const false":s sb.appendStr end break
      ConstInt .case "const ":s prepareSbAppendTyped i64.sbAppend break
      ConstFloat .case "const ":s prepareSbAppendTyped f64.sbAppend break
      ConstProcPtr .case
        <$ "const proc: ":s sb.appendStr >$ ProcId.getProcInfo [] .nameId nameContext sb.appendIdentifierPath
      break
      GetId .case "get ":s nameContext sbAppendIdInfo break
      GetId2 .case "get2 ":s nameContext sbAppendIdInfo break
      GetId3 .case "get3 ":s nameContext sbAppendIdInfo break
      SetId .case "set ":s nameContext sbAppendIdInfo break
      SetId2 .case "set2 ":s nameContext sbAppendIdInfo break
      SetId3 .case "set3 ":s nameContext sbAppendIdInfo break
      AtId .case
        <$ "at: ":s sb.appendStr >$ nameContext sb.appendIdInfo
      break
      Arithmetic .case
        "arithmetic ":s prepareSbAppendTyped Arithmetic.sbAppend
      break
      Compare .case
        "compare ":s prepareSbAppendTyped CompareType.sbAppend
      break
      LocalLabel .case <$
        "label ":s sb.appendStr
        $1 .labelType sb.appendLocalLabelType
        ": ":s sb.appendStr
        >$ .labelId i64 cast sb.appendI
      break
      LocalJump .case <$
        "jump ":s sb.appendStr
           $1 .cmpType CompareType.sbAppend
           $1 .cmpType .NONE ! if
             ' ' sb.appendC
             $1 .valType ValType.sbAppend
           end
           ": ":s sb.appendStr
        >$ .labelId i64 cast.u sb.appendI
      break
      BeginProc .case
        <$ "begin proc: ":s sb.appendStr >$ [] ProcTypeInfo.sbAppend
      break
      Call .case
        <$ "call: ":s sb.appendStr >$ [] ProcTypeInfo.sbAppend
      break
      Return .case
        <$ "return: ":s sb.appendStr >$ [] ProcTypeInfo.sbAppend
      break
      EndProc case
        "end proc: ":s sb.appendStr
      break
      Copy .case <$ "copy: ":s sb.appendStr >$ sb.appendI break
      Drop .case <$ "drop: ":s sb.appendStr >$ sb.appendI break
      Rotate .case <$ "rotate: ":s sb.appendStr >$ sb.appendI break
      Rotate2 .case <$ "rotate2: ":s sb.appendStr >$ sb.appendI break
      Rotate3 .case <$ "rotate3: ":s sb.appendStr >$ sb.appendI break
    end
    " at ":s sb.appendStr
    >$ .pos [] sb.appendPos
  end
end
