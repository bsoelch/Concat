#namespace id
  enum( TYPE PROCEDURE GLOBAL_VAR  TEMPLATE_ARG  LOCAL_VAR ARGUMENT TMP_VAR ) =:: public IdentifierType

  struct( types.Type : implType ConstantArray : argValues FilePosition : implPos ) =:: public TemplateImplementation
  ## XXX? ( offset length file code-Type ) -> code-position
  struct( types.Type : templateType FilePosition : declaredAt i64 : codeOffset i64 : mut codeLength FileId : srcFile TemplateImplementation list : mut implementations i64 : compiledImpls ) =:: public TemplateInfo

  struct( types.Type : valueType ConstValue : constValue FilePosition : declaredAt LabelId : labelId TemplateId : templateId i32 : id IdentifierType : idType ) =:: IdentifierData
  struct( IdentifierType : idType LabelId : labelId TemplateId : templateId i32 : mut id ) =:: public IdentifierInfo

  struct( string : name NamespaceId : mut namespace FileId : fileId ) =:: IdentifierName
  struct( IdentifierName : name IdentifierData ptr : data ) =:: IdentifierMatch

  "" 0 string new NAMESPACE_ID_NONE FILE_ID_NONE IdentifierName new =:: ID_NONE
  types.Type .undefined ConstValue .none "" 0 string new 0 0 FilePosition new LABEL_ID_NONE TEMPLATE_ID_NONE -1 IdentifierType .GLOBAL_VAR  IdentifierData new =:: ID_NONE_DATA
  types.Type .undefined ConstValue .none "" 0 string new 0 0 FilePosition new LABEL_ID_NONE TEMPLATE_ID_NONE -1 IdentifierType .GLOBAL_VAR  IdentifierData new =:: mut ID_TMP_DATA


  proc( IdentifierName : a => i32 ) =: idHash
    a .name string.hash 31 * a .namespace i32 cast + 31 * a .fileId i32 cast + return
  end
  proc( IdentifierName : a IdentifierName : b => bool ) =: idEq
    a .fileId b .fileId != a .namespace b .namespace != | if
      false return
    end
    a .name b .name string.eq return
  end

  struct(
    IdentifierName IdentifierData hashMap : mut identifiers
    i8 _ ptr mut list : mut scopeStrings ## strings allocated for this scope
    codeBlocks.BlockType : mut blockType
    types.Type : currentProc
    NamespaceImportId : prevImports
    bool : mut autoClose
  ) =:: Scope

  proc( codeBlocks.BlockType : blockType types.Type : procType NamespaceImportId : imports => Scope ) =: newScope
    idHash @
    idEq @
    128 IdentifierData map.create
    128 i8 _ ptr mut list.create
    blockType
    procType
    imports
    false
    Scope new return
  end

  struct(
    ConstantContext : mut constContext
    LabelContext : mut labelContext
    types.TypeContext : mut typeContext
    Scope : mut globalScope
    Scope list : mut localScopes
    TemplateInfo list : mut templateInfos
    ConstValue list : mut templateArgBuffer
    types.ArraySize list : mut arraySizeBuffer
    NamespaceImportId list : mut prevImports
    i32 : mut localVarCount
    TemplateId : mut currentTemplate
  ) =:: public IdentifierContext

  proc( => IdentifierContext ) =: public newIdentifierContext
    newConstContext
    newLabelContext
    types.newTypeContext
    codeBlocks.BlockType .UNKNOWN types.Type .undefined NAMESPACE_IMPORT_NONE newScope
    128 Scope list.create
    128 TemplateInfo      list.create
    32  ConstValue        list.create
    128 types.ArraySize   list.create
    32  NamespaceImportId list.create
    0
    TEMPLATE_ID_NONE
    IdentifierContext new =:: mut newContext
    newContext return
  end

  proc( IdentifierData ptr : idData => IdentifierInfo ) =: public asIdInfo
    idData [] .idType
    idData [] .labelId
    idData [] .templateId
    idData [] .id
    IdentifierInfo new return
  end

  proc( IdentifierContext ptr mut : context => bool ) =: public isGlobal
    context [] .localScopes .length 0 == return
  end
  proc( codeBlocks.BlockType : blockType types.Type : procType  IdentifierContext ptr mut : context => ) =: public openProcScope
    context [] .localScopes
       blockType procType context [] .labelContext .namespaceInfo .imports newScope
       list.append
    context [] .localScopes =
  end
  proc( codeBlocks.BlockType : blockType  IdentifierContext ptr mut : context => ) =: public openScope
    context [] .localScopes .length 0 == if
      types.Type .undefined
    else
      context [] .localScopes list.peek .data [] .currentProc
    end =:: currentProc
    context [] .localScopes
       blockType currentProc context [] .labelContext .namespaceInfo .imports newScope
       list.append
    context [] .localScopes =
  end
  proc( codeBlocks.BlockType : blockType  bool : autoClose IdentifierContext ptr mut : context => bool ) =: public updateScopeType
    context [] .localScopes .length 0 == if
      true return
    end
    blockType context [] .localScopes list.peek .data [] .blockType =
    autoClose context [] .localScopes list.peek .data [] .autoClose =
    false return
  end
  proc( IdentifierContext ptr mut : context => codeBlocks.BlockType ) =: public currentScopeType
    #using codeBlocks
    context [] .localScopes .length 0 == if
      BlockType .UNKNOWN return
    end
    context [] .localScopes list.peek .data [] .blockType return
  end
  proc( IdentifierContext ptr mut : context => types.Type ) =: public currentScopeProc
    #using codeBlocks
    context [] .localScopes .length 0 == if
      types.Type .undefined return
    end
    context [] .localScopes list.peek .data [] .currentProc return
  end
  proc( i8 _ ptr mut list => i8 _ ptr mut list ) =: freeScopeStrings
    0 while #dup #over:2 .length < do
      #over #over list.get mem.free
      1 +
    end #drop
    list.free
  end
  proc( IdentifierContext ptr mut : context => bool codeBlocks.BlockType bool ) =: public closeScope
    #using codeBlocks
    context [] .localScopes .length 0 == if
      false BlockType .UNKNOWN true return
    end
    context [] .localScopes list.pop #swap context [] .localScopes =
      #dup .scopeStrings freeScopeStrings #over .scopeStrings =
      #dup .identifiers @ map.free
      #dup .prevImports context [] .labelContext .namespaceInfo .imports =
      #dup .blockType codeBlocks.BlockType .PROCEDURE == if
        0 context [] .localVarCount = ## XXX handle nested procedures
      end
    #dup .autoClose #swap .blockType false return
  end

  proc( string : id FileId : fileId IdentifierContext ptr mut : context IdentifierMatch list ptr mut optional : matches => IdentifierName IdentifierData ptr bool ) =: public searchIdentifier
    context [] .labelContext .namespaceInfo .current =:: mut mNamespace
    NamespaceId : mut relSpace
    mNamespace NAMESPACE_ID_NONE == if
      "invalid current namespace id" string.wrap NAMESPACE_ID_NONE fileId IdentifierName new ID_NONE_DATA @ true return
    end
    id 0 string.charAt '.' == if
      "identifiers cannot start with ." string.wrap NAMESPACE_ID_NONE fileId IdentifierName new ID_NONE_DATA @ true return
    end
    id '.' string.splitLast
    =:: path
    =:: name
    ## 1. search in local scopes
    mNamespace path  context [] .labelContext addrOf findNamespace relSpace =
    name relSpace fileId IdentifierName new =:: mut idName
    relSpace NAMESPACE_ID_NONE != if
      context [] .localScopes .length 1 -
      while #dup 0 >= do
        context [] .localScopes #over list.get .identifiers addrOf idName map.at
        #dup optional.hasData if .data
          matches optional.isEmpty if #swap #drop
            idName #swap false return
          end
          matches .data []
            idName #over:2 IdentifierMatch new list.append
          matches .data [] =
          #drop
        else #drop end
        1 -
      end #drop
    end
    ## 2. search global variable in current&parent namespaces
    name relSpace FILE_ID_NONE IdentifierName new =:: mut globalName
    while mNamespace NAMESPACE_ID_NONE != do
      mNamespace path  context [] .labelContext addrOf findNamespace relSpace =
      relSpace idName .namespace =
      relSpace globalName .namespace =
      relSpace NAMESPACE_ID_NONE != if
        context [] .globalScope .identifiers addrOf idName map.at
        #dup optional.hasData if .data
          matches optional.isEmpty if
            idName #swap false return
          end
          matches .data []
            idName #over:2 IdentifierMatch new list.append
          matches .data [] =
          #drop
        else #drop end
        context [] .globalScope .identifiers addrOf globalName map.at
        #dup optional.hasData if .data
          matches optional.isEmpty if
            globalName #swap false return
          end
          matches .data []
            globalName #over:2 IdentifierMatch new list.append
          matches .data [] =
          #drop
        else #drop end
      end
      context [] .labelContext .namespaces mNamespace list.get .parent mNamespace =
    end
    ## 3. search imports
    false =:: mut multiMatch
    IdentifierData ptr optional.empty =:: mut match
    false =:: mut matchGlobal
    context [] .labelContext .namespaceInfo .imports while #dup NAMESPACE_IMPORT_NONE != do
      context [] .labelContext .namespaceImports #swap list.get
        #dup .imported path  context [] .labelContext addrOf findNamespace relSpace =
        relSpace idName .namespace =
        relSpace globalName .namespace =
        relSpace NAMESPACE_ID_NONE != if
          context [] .globalScope .identifiers addrOf idName map.at
          #dup optional.hasData if .data
            matches optional.hasData if
              matches .data []
                idName #over:2 IdentifierMatch new list.append
              matches .data [] =
            end
            mNamespace NAMESPACE_ID_NONE == if
              IdentifierData ptr cast optional.wrap match =
              false matchGlobal =
              #dup .imported mNamespace =
            else #drop
              true multiMatch =
            end
          else #drop end
          context [] .globalScope .identifiers addrOf globalName map.at
          #dup optional.hasData if .data
            matches optional.hasData if
              matches .data []
                globalName #over:2 IdentifierMatch new list.append
              matches .data [] =
            end
            mNamespace NAMESPACE_ID_NONE == if
              IdentifierData ptr cast optional.wrap match =
              true matchGlobal =
              #dup .imported mNamespace =
            else #drop
              true multiMatch =
            end
          else #drop end
        end
     .parent
    end #drop
    matches optional.isEmpty match optional.hasData & if ## XXX return value indicating multi-match
      matchGlobal if globalName else idName end match .data false return
    end
    ## 4. template arguments
    context hasOpenTemplate if
      context [] .templateInfos context [] .currentTemplate list.get =:: template
      template .templateType
        0 while #dup #over:2 context [] .typeContext @ types.compositeEltCount < do
          #swap
            #dup #over:2 context [] .typeContext @ types.compositeGetLabel context [] .labelContext @ labelName .data id string.eq if
              =:: tType =:: tId
              tType tId context [] .typeContext @ types.compositeGetElement =:: eType
              eType
              eType types.primitive.TYPE types.typeEquals if
                tId types.newTemplateType ConstValue .typeId new
              else
                tId ConstValue .templateArg new
              end
              template .declaredAt
              tType tId context [] .typeContext @ types.compositeGetLabel
              context [] .currentTemplate
              tId
              IdentifierType .TEMPLATE_ARG
              IdentifierData new ID_TMP_DATA =
              name context [] .labelContext .namespaceInfo .current fileId IdentifierName new ID_TMP_DATA @ false return
            end
          #swap
          1 +
        end #drop
      #drop
    end
    "could not find identifier" string.wrap NAMESPACE_ID_NONE fileId IdentifierName new ID_NONE_DATA @ true return
  end
  proc( string : id FileId : fileId IdentifierContext ptr mut : context => IdentifierName IdentifierData ptr bool ) =: public getIdentifier
    id fileId context IdentifierMatch list ptr mut optional.empty searchIdentifier return
  end
  proc( LabelId : label types.Type : valType IdentifierType : idType i32 : id ConstValue : constVal FilePosition : declaredAt FileId : currentFile IdentifierContext ptr mut : context CompilerError list ptr mut : errors =>  IdentifierName IdentifierData ptr bool ) =: public declareIdentifier
    label LABEL_ID_NONE == if
      errors []
        "invalid label id" sb.wrap declaredAt CompilerError new list.append
      errors [] =
      ID_NONE ID_NONE_DATA @ true return
    end
    label  context [] .labelContext addrOf
      #over #over labelFlags =:: flags
    labelName .data =:: name
    context id.isGlobal flags FLAG_PUBLIC & 0 != & if ## public global -> ignore fileId
      FILE_ID_NONE
    else
      currentFile
    end =:: fileId
    flags FLAG_MUTABLE & 0 != if
      idType IdentifierType .TYPE == if
        errors []
          "type definitions cannot be mutable" sb.wrap declaredAt CompilerError new list.append
        errors [] =
        ID_NONE ID_NONE_DATA @ true return
      end
      idType IdentifierType .PROCEDURE == if
        errors []
          "procedures cannot be mutable" sb.wrap declaredAt CompilerError new list.append
        errors [] =
        ID_NONE ID_NONE_DATA @ true return
      end
      idType IdentifierType .ARGUMENT ==  if
        errors []
          "procedure arguments cannot be mutable" sb.wrap declaredAt CompilerError new list.append
        errors [] =
        ID_NONE ID_NONE_DATA @ true return
      end
    end
    name 0 string.charAt '#' == if
      errors []
        "identifier names cannot start with '#'" sb.wrap declaredAt CompilerError new list.append
      errors [] =
      ID_NONE ID_NONE_DATA @ true return
    end
    name '.' string.contains if
      errors []
        "identifier names cannot contain '.'" sb.wrap declaredAt CompilerError new list.append
      errors [] =
      ID_NONE ID_NONE_DATA @ true return
    end
    context [] .localScopes .length 0 > if
      context [] .localScopes #dup .length 1 - list.at .data
    else
      context [] .globalScope @
    end =:: mScope
    name .length sb.create name sb.appendStr ## ensure name allocation stays valid for whole lifetime of scope
      mScope [] .scopeStrings
        #over .data list.append ## remember allocated string
      mScope [] .scopeStrings =
    sb.toStr
    context [] .labelContext .namespaceInfo .current fileId IdentifierName new =:: mut idName
    mScope [] .identifiers addrOf idName map.at #dup optional.hasData if .data =:: prevDec
      errors []
        "re declaration of identifier \"" sb.wrap name sb.appendStr '\"' sb.appendC declaredAt CompilerError new list.append
        "previous declaration " sb.wrap prevDec [] .declaredAt CompilerError new list.append
      errors [] =
      ID_NONE ID_NONE_DATA @ true return
    end #drop
    name fileId context getIdentifier ! if
      errors []
        "declaration of identifier \"" sb.wrap name sb.appendStr '\"' sb.appendC declaredAt CompilerError new list.append
        "shadows previous declaration " sb.wrap #over:2 [] .declaredAt CompilerError new list.append
      errors [] =
    end #drop:2
    mScope [] .identifiers addrOf
      idName
      valType
      flags FLAG_MUTABLE & 0 != if ConstValue .none new else constVal end
      declaredAt
      label
      context [] .currentTemplate
      id -1 == idType IdentifierType .LOCAL_VAR == & if
        context [] .localVarCount ++
      else
        id
      end
      idType
      IdentifierData new
    map.put #drop ## previous entry is always empty
    idName mScope [] .identifiers addrOf idName map.at .data false return
  end
#end
#namespace sb
  proc( stringBuilder : sb id.IdentifierInfo : id id.LabelContext ptr : labelContext => stringBuilder ) =: public appendIdInfo
    sb
      id .labelId labelContext id.labelFlags id.FLAG_MUTABLE & 0 != if
        "mutable " sb.appendS
      end
      id .templateId id.TEMPLATE_ID_NONE != if
        "template " sb.appendS
        id .templateId sb.appendI
        id .id -1 != if
          ':' sb.appendC
          id .id sb.appendI
        end
        ' ' sb.appendC
      end
      id .idType switch
        TYPE case
          "type \"" sb.appendS
          id .labelId labelContext id.labelName .data sb.appendStr
          "\"" sb.appendS
          return
        PROCEDURE case
          "procedure \"" sb.appendS
          id .labelId labelContext id.labelName .data sb.appendStr
          "\"" sb.appendS
          return
        GLOBAL_VAR case
          "global variable \"" sb.appendS
          id .labelId labelContext id.labelName .data sb.appendStr
          "\"" sb.appendS
          return
        LOCAL_VAR case
          "local variable (" sb.appendS
          id .id sb.appendI
          ") \"" sb.appendS
          id .labelId labelContext id.labelName #dup optional.hasData if .data sb.appendStr else #drop end
          "\"" sb.appendS
          return
        ARGUMENT case
          "procedure argument (" sb.appendS
          id .id sb.appendI
          ") \"" sb.appendS
          id .labelId labelContext id.labelName #dup optional.hasData if .data sb.appendStr else #drop end
          "\"" sb.appendS
          return
        TMP_VAR case
          "temporary variable (" sb.appendS
          id .id sb.appendI
          ") \"" sb.appendS
          id .labelId labelContext id.labelName #dup optional.hasData if .data sb.appendStr else #drop end
          "\"" sb.appendS
          return
        TEMPLATE_ARG case
          "template argument (" sb.appendS
          id .id sb.appendI
          ") \"" sb.appendS
          id .labelId labelContext id.labelName #dup optional.hasData if .data sb.appendStr else #drop end
          "\"" sb.appendS
          return
      end
  end
#end
#namespace id
  proc( LabelId : name IdentifierContext ptr mut : context => ) =: public beginNamespace
    context [] .prevImports
      context [] .labelContext .namespaceInfo .imports list.append
    context [] .prevImports =
    context [] .labelContext .namespaceInfo .current
      name context [] .labelContext @ labelName .data true context [] .labelContext @ childId
    context [] .labelContext .namespaceInfo .current =
  end
  proc( LabelId : name IdentifierContext ptr mut : context => bool ) =: public importNamespace
    0 NamespaceId cast name context [] .labelContext @ labelName .data context [] .labelContext @ findNamespace
    #dup NAMESPACE_ID_NONE == if #drop
      true return
    end
    context [] .labelContext .namespaceInfo .imports
      #swap context [] .labelContext @ getNamespaceImportId
    context [] .labelContext .namespaceInfo .imports =
    false return
  end
  proc( IdentifierContext ptr mut : context => bool ) =: public endNamespace
    context [] .labelContext .namespaceInfo .current 0 == if
      true return
    end
    context [] .labelContext .namespaceInfo .current context [] .labelContext @ parentNamespace
    context [] .labelContext .namespaceInfo .current =
    context [] .prevImports
      list.pop #swap
    context [] .prevImports =
    context [] .labelContext .namespaceInfo .imports =
    false
  end

  proc( IdentifierContext ptr mut : context => bool ) =: public hasOpenTemplate
    context [] .currentTemplate TEMPLATE_ID_NONE != return
  end
  proc( TemplateId : id IdentifierContext ptr mut : context => TemplateInfo ptr mut optional ) =: public getTemplateInfo
    id 0 < id context [] .templateInfos .length >= | if
      TemplateInfo ptr mut optional.empty return
    end
    context [] .templateInfos id list.at return
  end
  proc( TemplateId : id IdentifierContext ptr mut : context => types.Type ) =: public templateArgs
    id 0 < id context [] .templateInfos .length >= | if
      types.Type .undefined return
    end
    context [] .templateInfos id list.get .templateType return
  end
  proc( types.Type : templateTypes i64 : templateOpsOffset FileId : srcFile FilePosition : pos IdentifierContext ptr mut : context => bool ) =: public beginTemplate
    context hasOpenTemplate if
      true return
    end
    context [] .templateInfos
      #dup .length TemplateId cast context [] .currentTemplate =
      ## TemplateInfo
        templateTypes
        pos
        templateOpsOffset
        0
        srcFile
        8 TemplateImplementation list.create
        0
      TemplateInfo new list.append
    context [] .templateInfos =
    false return
  end
  proc( i64 : templateOpsOffset IdentifierContext ptr mut : context => ) =: public endOpenTemplate
    context hasOpenTemplate ! if
      return
    end
    context [] .templateInfos context [] .currentTemplate list.at .data
      templateOpsOffset #over [] .codeOffset -
      #swap [] .codeLength =
    TEMPLATE_ID_NONE context [] .currentTemplate =
  end
#end

#namespace types
  proc( ConstantArray : data i64 : index id.IdentifierContext ptr mut : context => ConstValue ) =: argBufferGet
    context [] .templateArgBuffer data .offset index + list.get return
  end
  proc( ConstantArray : data id.IdentifierContext ptr mut : context => ConstValue arrayView ) =: argBufferAsArray
    context [] .templateArgBuffer .data data .offset + data .length array.create return
  end
  proc( CompositeId : src ConstantArray : templateArgs ConstantArray : genericArgs FilePosition : implPos id.IdentifierContext ptr mut : context => CompositeId ) =: replaceGenericsComposite
    context [] .typeContext .compositeTypes src list.get
      #dup .flags COMP_FLAG_VOID_ONLY & 0 != #over .flags COMP_GENERIC_MASK & 0 == | if #drop
        src return ## no generic elements
      end
      #dup .eltCount Type list.create
        0 while #dup #over:3 .eltCount < do
          #swap ## composite index list
            context [] .typeContext .compositeData #over:3 .eltsOffset #over:3 + list.get templateArgs genericArgs implPos context replaceGenericsType list.append
          #swap 1 +
        end #drop
        #over .flags COMP_CLASS_MASK &
        #over list.asArray
        #over:3 .labelOffset
        context [] .typeContext @
        newCompositeType
      #swap list.free #drop
    #swap #drop
    return
  end
  proc( ConstValue => ArraySize bool ) =: constToSize
    #dup ConstValue .int == if
      .int ArraySizeType .int ArraySize new false return
    end
    #dup ConstValue .genericArg == if
      .genericArg ArraySizeType .staticArg ArraySize new false return
    end
    #dup ConstValue .templateArg == if
      .templateArg ArraySizeType .templateArg ArraySize new false return
    end
    #drop
    -1 ArraySizeType .int ArraySize new true return
  end
  proc( ArraySize : src ConstantArray : templateArgs ConstantArray : genericArgs FilePosition : implPos id.IdentifierContext ptr mut : context => ArraySize ) =: replaceGenericsSize
    src .sizeType switch
      int case
        src return
      staticArg case
        src .value
        #dup 0 >= #over genericArgs .length < & if
          genericArgs #swap context argBufferGet
          constToSize if
            #+TODO handle errors+#
            #drop src
          end return
        end #drop
        src return
      templateArg case
        src .value
        #dup 0 >= #over templateArgs .length < & if
          templateArgs #swap context argBufferGet
          constToSize if #drop src end return
        end #drop
        src return
    end
  end
  proc( Type : src ConstantArray : templateArgs ConstantArray : genericArgs FilePosition : implPos id.IdentifierContext ptr mut : context => Type ) =: public replaceGenericsType
    src context [] .typeContext @ containsGeneric genericArgs .length 0 > & #swap templateArgs .length 0 > & | ! if
      src return ## no generics to replace
    end
    src switch
      undefined primitiveType autoType case
        src return ## no generic info
      pointer arrayType case
        src Type .pointer == =:: isPtr
        src isPtr if .pointer else .arrayType end
        context [] .typeContext .arrayTypes #swap list.get =:: arrayType
          arrayType .base templateArgs genericArgs implPos context replaceGenericsType
          isPtr
          context [] .arraySizeBuffer .length =:: offset
          arrayType .fixedSize if
            context [] .typeContext .arraySizes .data arrayType .sizeOffset + arrayType .dims array.create =:: prevSizes
            0 while #dup prevSizes .length < do
              context [] .arraySizeBuffer
                  prevSizes #over:2 array.get
                templateArgs genericArgs implPos context replaceGenericsSize list.append
              context [] .arraySizeBuffer =
              1 +
            end #drop
            context [] .arraySizeBuffer .data offset + context [] .arraySizeBuffer .length offset - array.create
            true
          else
            ArraySize array.empty
            false
          end
          arrayType .mutable
          context [] .typeContext @
        newArrayType #drop return
      tuple case
        src .tuple templateArgs genericArgs implPos context replaceGenericsComposite Type .tuple new return
      struct case
        src .struct templateArgs genericArgs implPos context replaceGenericsComposite Type .struct new return
      labeledProcIn case
        src .labeledProcIn templateArgs genericArgs implPos context replaceGenericsComposite Type .labeledProcIn new return
      procIn case
        src .procIn templateArgs genericArgs implPos context replaceGenericsComposite Type .procIn new return
      procOut case
        src .procOut templateArgs genericArgs implPos context replaceGenericsComposite Type .procOut new return
      enum case
        src .enum templateArgs genericArgs implPos context replaceGenericsComposite Type .enum new return
      enumLabel case
        src .enumLabel templateArgs genericArgs implPos context replaceGenericsComposite Type .enumLabel new return
      procedure case
        context [] .typeContext .procTypes src .procedure list.get
          #dup .in templateArgs genericArgs implPos context replaceGenericsType
          #swap .out templateArgs genericArgs implPos context replaceGenericsType
        context [] .typeContext @ newProcedure #drop return
      namedType namedLabel case
        src Type .namedLabel == =:: isLabel
        context [] .typeContext .namedTypes
          src isLabel if .namedLabel else .namedType end
        list.get =:: typeData
        typeData .templateId id.TEMPLATE_ID_NONE == if
          src return ## no template data in type
        end
        context [] .templateInfos typeData .templateId list.at .data =:: templateInfo
        context [] .templateArgBuffer .length =:: offset
        typeData .implId -1 != if ## already implemented
          templateInfo [] .implementations typeData .implId list.get .argValues =:: argValues
          0 while #dup argValues .length < do
            context [] .templateArgBuffer
              argValues #over:2 context [] .constContext @ constArrayGet
                templateArgs genericArgs implPos context replaceGenerics
              list.append
            context [] .templateArgBuffer =
            1 +
          end #drop
          offset context [] .templateArgBuffer .length offset - ConstantArray new
        else
          ## TODO check if template arguments have correct size
          templateArgs
        end =:: args
        0 while #dup templateInfo [] .implementations .length < do ## check if template arguments have already been implemented
          templateInfo [] .implementations #over list.get
            true 0 while #dup #over:3 .argValues .length < do
              #swap #drop
                #over .argValues #over context [] .constContext @ constArrayGet args #over:2 context argBufferGet context [] .labelContext @ constantEquals #dup ! if
                  #swap break
                end
              #swap 1 +
            end #drop
            if ## already implemented
              offset context [] .templateArgBuffer .length = ## reset template buffer
              .implType
              #swap #drop return
            end
          #drop
          1 +
        end #drop
        ## create implementation
        Type .undefined typeData .name typeData .templateId context [] .typeContext @ newNamedType =:: newType
        templateInfo [] .implementations
            newType
            args context argBufferAsArray context [] .constContext @ constArray
            implPos
          id.TemplateImplementation new list.append
        templateInfo [] .implementations =
        ## compute value
        newType
          typeData .data args genericArgs implPos context replaceGenericsType
          templateInfo [] .implementations .length 1 - i32 cast
          context [] .typeContext @
        setNamedType #drop
        offset context [] .templateArgBuffer .length = ## reset template buffer
        newType return
      genericType case
        src .genericType
          #dup 0 >= #over genericArgs .length < & if
            genericArgs #swap context argBufferGet #dup ConstValue .typeId == if
              .typeId return
            end #drop
            ## TODO error message if argument is not typeId
        else #drop end
        src return
      templateType case
        src .templateType
          #dup 0 >= #over templateArgs .length < & if
            templateArgs #swap context argBufferGet #dup ConstValue .typeId == if
              .typeId return
            end #drop
            ## error message if argument is not typeId
        else #drop end
        src return
    end
  end
  proc( ConstValue : src ConstantArray : templateArgs ConstantArray : genericArgs FilePosition : implPos id.IdentifierContext ptr mut : context => ConstValue ) =: public replaceGenerics
    src switch
      none wildCard boolean int enumLabel chr str case
        src return
      typeId case
        src .typeId templateArgs genericArgs implPos context replaceGenericsType ConstValue .typeId new return
      genericArg case
        src .genericArg
        #dup 0 >= #over genericArgs .length < & if
          genericArgs #swap context argBufferGet return
        end #drop
        src return
      templateArg case
        src .templateArg
        #dup 0 >= #over templateArgs .length < & if
          templateArgs #swap context argBufferGet return
        end #drop
        src return
    end
  end

  proc( Type : src Type : expected i32 : templateCount i32 : genericCount bool _ ptr mut : visitedValues ConstValue _ ptr mut : values i32 list ptr mut : visitedTypes id.IdentifierContext ptr mut : context => ) =: resolveGenericsTypeInternal
    #using types
    context [] .typeContext @ =:: typeContext
    expected Type .templateType == if
      expected .templateType 0 < expected .templateType templateCount >= | if
        return
      end
      visitedValues expected .templateType [] if
        src ConstValue .typeId new values expected .templateType [] =
      end
      true visitedValues expected .templateType [] =
      return
    end
    expected Type .genericType == if
      expected .genericType 0 < expected .genericType genericCount >= | if
        return
      end
      visitedValues expected .genericType templateCount + [] ! if
        src ConstValue .typeId new values expected .genericType templateCount + [] =
      end
      true visitedValues expected .genericType templateCount + [] =
      return
    end
    expected typeContext containsGeneric genericCount 0 > & #swap templateCount 0 > & | ! if
      return ## no generics to replace
    end
    src typeContext isComposite expected typeContext isComposite & if
      src typeContext compositeEltCount =:: srcCount
      expected typeContext compositeEltCount =:: expectedCount
      srcCount expectedCount < if srcCount else expectedCount end =:: count
      0 while #dup count < do
        ## resolveGenericsType
          src #over typeContext compositeGetElement
          expected #over:2 typeContext compositeGetElement
        templateCount genericCount visitedValues values visitedTypes context resolveGenericsTypeInternal
        1 +
      end #drop
      return
    end
    src expected != if
      return
    end
    expected switch
      undefined primitiveType autoType case
        break
      procedure case
        ## resolveGenericsType
          src typeContext getProcIn #drop
          expected typeContext getProcIn #drop
        templateCount genericCount visitedValues values visitedTypes context resolveGenericsTypeInternal
        ## resolveGenericsType
          src typeContext getProcOut #drop
          expected typeContext getProcOut #drop
        templateCount genericCount visitedValues values visitedTypes context resolveGenericsTypeInternal
        break
      pointer arrayType case
        ## resolveGenericsType
          src typeContext getBaseType
          expected typeContext getBaseType
        templateCount genericCount visitedValues values visitedTypes context resolveGenericsTypeInternal
        src typeContext isFixedSize  expected typeContext isFixedSize & if
          src typeContext getArraySize =:: srcSizes
          expected typeContext getArraySize =:: sizes
          0 while #dup sizes .length < do
            #dup srcSizes .length < if
              srcSizes #over array.get
              #dup .sizeType switch
                int case
                  .value ConstValue .int new
                  break
                templateArg case
                  .value ConstValue .templateArg new
                  break
                staticArg case
                  .value ConstValue .genericArg new
                  break
              end
            else
              1 ConstValue .int new
            end =:: srcVal
            sizes #over array.get =:: val
            val .sizeType switch
             int case
               1 + continue
             templateArg case
              val .value 0 < val .value templateCount >= | if
                break
              end
              visitedValues val .value [] if
                srcVal values val .value [] =
              end
              true visitedValues val .value [] =
              break
             staticArg case
              val .value 0 < val .value templateCount >= | if
                break
              end
              visitedValues val .value templateCount + [] if
                srcVal values val .value templateCount + [] =
              end
              true visitedValues val .value templateCount + [] =
              break
            end
            1 +
          end #drop
        end
        break
      namedType namedLabel case
        expected Type .namedType == if expected .namedType else expected .namedLabel end =:: id
        visitedTypes [] list.asArray id array.contains if
          return
        end
        visitedTypes []
          id list.append
        visitedTypes [] =
        ## resolveGenericsType
          src typeContext unwrapNamed
          expected typeContext unwrapNamed
        templateCount genericCount visitedValues values visitedTypes context resolveGenericsTypeInternal
        break
      tuple struct labeledProcIn procIn procOut enum enumLabel genericType templateType case
        io.stdErr "unreachable\n" io.fputs #drop ## TODO mark as unreachable
        break
    end
  end
  ## XXX resolve generics method for general constants

  proc( Type : src Type : expected i32 : templateCount i32 : genericCount ConstValue list ptr mut : values i64 : valOffset id.IdentifierContext ptr mut : context => ) =: public resolveGenericsType
    templateCount genericCount + bool mem.alloc =:: visitedValues
    64 i32 list.create =:: mut visitedTypes
    values []
      templateCount genericCount + valOffset + list.ensureCap
    values [] =
    src expected templateCount genericCount visitedValues  values [] .data valOffset +  visitedTypes @ context resolveGenericsTypeInternal
    visitedValues mem.free
    visitedTypes list.free visitedTypes =
  end
#end

