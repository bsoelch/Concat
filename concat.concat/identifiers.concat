import string
import stringBuilder
import map
import optional
using std.literals.

import "constants.concat"
import "types.concat"
import "names.concat"
import "codeBlocks.concat"
import "common.concat"

enum(
  TYPE
  PROCEDURE
  PROCEDURE_BUNDLE
  GLOBAL_VAR
  LABEL
  LOCAL_VAR
  ARGUMENT
  TMP_VAR
  ITR_VAR
) =:: export: IdentifierType

struct(
  Type : valueType
  ConstValue : constValue
  FilePosition ptr : declaredAt
  NameId : nameId
  i32 : index
  IdentifierType : idType
  bool : declarationOnly
) =:: IdentifierData
struct(
  NameId : nameId
  IdentifierType : idType
  bool : noRead
) =:: export: IdentifierInfo

namespace: id
  i32 =:: export: AliasId
  ( char8 ptr.raw iSize -> AliasId ) : static: export: alias: :AliasId ..builtIn.parse.i32
  -1:AliasId =:: export: NO_ALIAS
  struct( FilePosition ptr : declaredAt ) =:: AliasInfo
  i32 =:: ImportId
  ( char8 ptr.raw iSize -> ImportId ) : static: alias: :ImportId ..builtIn.parse.i32
  -1:ImportId =:: export: NO_IMPORTS
  struct( FileId : fileId ImportId : prev ) =:: ImportInfo
  struct(
    string : name
    NamespaceId : namespace
    ScopeId : scope
  ) =:: IdentifierName
  struct(
    NameId  : nameId
    AliasId : aliasId
  ) =:: export: NameInfo
  struct(
    IdentifierName : name
    NameInfo : nameData
  ) =:: export: IdentifierMatch
  ## IdentifierName
    string.empty
    NAMESPACE_ID_NONE
    GLOBAL_SCOPE
  IdentifierName new =:: ID_NONE
  ## IdentifierData
    Type .Undefined
    ConstValue .None
    FILE_POS_UNKNOWN@
    NAME_ID_NONE
    -1
    IdentifierType .GLOBAL_VAR
    false
  IdentifierData new =:: ID_NONE_DATA
  ## IdentifierData
    Type .Undefined
    ConstValue .None
    FILE_POS_UNKNOWN@
    NAME_ID_NONE
    -1
    IdentifierType .GLOBAL_VAR
    false
  IdentifierData new =:: mut: ID_TMP_DATA

  proc( IdentifierName : a -> i32 ) =>: idHash
    a .name string.hash 31 * a .namespace i32 cast + 31 * a .scope i32 cast + return
  end
  proc( IdentifierName : a IdentifierName : b -> bool ) =>: idEq
    a .scope b .scope != a .namespace b .namespace != | if
      false return
    end
    a .name b .name string.eq return
  end

  struct(
    ScopeId : parentScope
    ProcId optional : currentProc
    NamespaceImportId : prevImports
    ImportId : visibleFiles
  ) =:: Scope

  proc( ScopeId : parent ProcId optional : procId NamespaceImportId : imports ImportId : visibleFiles -> Scope ) =>: newScope
     ## Scope
      parent
      procId
      imports
      visibleFiles
    Scope new return
  end
end
  struct(
    using id.
    TypeContext : typeContext
    ConstantContext : constContext
    Scope list : scopes
    IdentifierName  NameInfo hashMap : identifierNames
    NameId IdentifierData hashMap : identifierData
    ConstValue list : argBuffer
    types.ArraySize list : arraySizeBuffer
    NamespaceInfo list : prevNamespaces
    AliasInfo list : aliasInfo
    ImportInfo list : visibleFiles
    ScopeId : currentScopeId
  ) =:: export: IdentifierContext
namespace: id

  proc( -> IdentifierContext ) =>: export: newIdentifierContext
    types.newTypeContext
      newConstContext
      128 Scope list.create
        id.GLOBAL_SCOPE ProcId optional.empty NAMESPACE_IMPORT_NONE NO_IMPORTS newScope
      list.append
      idHash@    idEq@    4096 NameInfo map.create
      NameId.hash@ NameId.eq@ 4096 IdentifierData map.create
      32  ConstValue      list.create
      128 types.ArraySize list.create
      128 NamespaceInfo   list.create
      128 AliasInfo       list.create
      128 ImportInfo      list.create
      id.GLOBAL_SCOPE
    IdentifierContext new return
  end
  proc( IdentifierContext -> IdentifierContext ) =>: export: freeIdentifierContext
    $ .typeContext types.freeTypeContext >$ .typeContext=
    $ .constContext freeConstContext >$ .constContext=
    $ .scopes list.free >$ .scopes=
    $ .identifierNames =:: mut: idNames
      idNames@ map.free
    idNames >$ .identifierNames=
    $ .identifierData =:: mut: idData
      idData@ map.free
    idData >$ .identifierData=
    $ .argBuffer list.free >$ .argBuffer=
    $ .arraySizeBuffer list.free >$ .arraySizeBuffer=
    $ .prevNamespaces list.free >$ .prevNamespaces=
    $ .aliasInfo list.free >$ .aliasInfo=
    $ .visibleFiles list.free >$ .visibleFiles=
    id.NO_SCOPE >$ .currentScopeId=
  end

  proc( IdentifierData ptr : idData -> IdentifierInfo ) =>: export: asIdInfo
    idData [] .nameId idData [] .idType false IdentifierInfo new return
  end

  proc( Scope list ScopeId -> Scope ptr.mut ) =>: getScopeData
    i64 cast.u @[]
  end
  proc( IdentifierContext ptr : context -> ScopeId ) =>: export: currentScope
    context [] .currentScopeId
  end
  proc( IdentifierContext ptr.mut : context -> ) =>: export: clearScope
    GLOBAL_SCOPE context .currentScopeId=
  end
  proc( ScopeId : scopeId IdentifierContext ptr.mut : context -> ) =>: export: setScope
    scopeId context .currentScopeId=
  end
  proc( ProcId optional : newProc IdentifierContext ptr.mut : context -> ) =>: export: openProcScope
    context [] .scopes context [] .currentScopeId getScopeData =:: parentScope
    context [] .scopes
      $ .length ScopeId cast =:: newScopeId
        context [] .currentScopeId
          newProc ? if newProc else parentScope [] .currentProc end
          context [] .typeContext .nameContext .namespaceInfo .imports
          parentScope [] .visibleFiles
        newScope
      list.append
    context .scopes=
    newScopeId context .currentScopeId=
  end
  proc( IdentifierContext ptr.mut : context -> ) =>: export: openScope
    ProcId optional.empty context openProcScope
  end
  proc(
    IdentifierContext ptr.mut : context
  ->
    bool #+isError+#
  ) =>: export: closeScope
    context [] .currentScopeId GLOBAL_SCOPE == if
      true return
    end
    context [] .scopes context [] .currentScopeId getScopeData =:: currentScopeData
    currentScopeData [] .prevImports context .typeContext .nameContext .namespaceInfo .imports=
    currentScopeData [] .parentScope context .currentScopeId=
    false return
  end
  proc( NameId : nameId IdentifierContext ptr.mut : context -> bool ) =>: isVisible
    context .typeContext .nameContext =:: nameContext
    nameId nameContext identifierFlags id.FLAG_BUILT_IN id.FLAG_MERGEABLE | & ? if
      true return ## built-ins and mergable identifiers are always visible
    end
    nameId nameContext getIdentifierFile =:: srcFile
    context [] .scopes context [] .currentScopeId getScopeData =:: currentScopeData
    currentScopeData [] .visibleFiles while $ NO_IMPORTS != do =:: id
      context [] .visibleFiles id i64 cast [] =:: importInfo
      importInfo .fileId srcFile == if
        true return
      end
      importInfo .prev
    end ..drop
    false return
  end
  proc(
    string : id
    bool : checkVisible
    IdentifierContext ptr.mut : context
    IdentifierMatch list ptr.mut optional : matches
  -> IdentifierName NameInfo optional ) =>: export: searchIdentifier
    context [] .currentScopeId =:: scopeId
    context [] .typeContext .nameContext .namespaceInfo .current =:: mut: mNamespace
    NamespaceId : relSpace
    mNamespace NAMESPACE_ID_NONE == if
      "invalid current namespace id":s NAMESPACE_ID_NONE scopeId IdentifierName new
      NameInfo optional.empty return
    end
    id 0 string.charAt '.' == if
      id .length 2:iSize u>= and id 1 string.charAt '.' == if
        id string.empty
      else
        "identifiers cannot start with .":s NAMESPACE_ID_NONE scopeId IdentifierName new
        NameInfo optional.empty return
      end
    else
      id '.' string.splitLast
    end =:: path =:: name
    NameInfo : idNameInfo
    ## 1. search in current scopes
    context [] .scopes scopeId getScopeData [] .currentProc =:: currentProc?
    mNamespace path  context .typeContext .nameContext findNamespace relSpace=
    name relSpace scopeId IdentifierName new =:: mut: idName
    relSpace NAMESPACE_ID_NONE != if
      while
        context .identifierNames idName map.get .and idNameInfo=
            checkVisible ! or idName .scope GLOBAL_SCOPE != or
            idNameInfo .nameId context isVisible if
          matches .else
            idName idNameInfo optional.wrap return
          end =:: matchData
          matchData []
            idName idNameInfo IdentifierMatch new list.append
          matchData =[]
        end
        idName .scope GLOBAL_SCOPE !=
      do
        context [] .scopes
          idName .scope getScopeData [] .parentScope
        idName@ .scope=
      end
    end
    scopeId =:: mut: firstNonProcScope
    scopeId GLOBAL_SCOPE != =:: mut: searchingNonProc
    ## search first non-proc scope containing current scope
    while
      searchingNonProc
    do
      context [] .scopes firstNonProcScope getScopeData =:: scopeData
      scopeData [] .currentProc ? ! if
        break
      end
      scopeData [] .parentScope firstNonProcScope=
    end
    ## 2. search global variable in parent namespaces
    while
      context [] .typeContext .nameContext .namespaces mNamespace i64 cast [] .parent mNamespace=
      mNamespace NAMESPACE_ID_NONE !=
    do
      mNamespace path  context .typeContext .nameContext findNamespace relSpace=
      relSpace idName@ .namespace=
      relSpace NAMESPACE_ID_NONE == if
        continue
      end
      ## search all scopes outside procedure
      firstNonProcScope idName@ .scope=
      while
        context .identifierNames idName map.get .and idNameInfo=
            checkVisible ! or idName .scope GLOBAL_SCOPE != or
            idNameInfo .nameId context isVisible if
          matches .else
            idName idNameInfo optional.wrap return
          end =:: matchData
          matchData []
            idName idNameInfo IdentifierMatch new list.append
          matchData =[]
        end
        idName .scope GLOBAL_SCOPE !=
      do
        context [] .scopes
          idName .scope getScopeData [] .parentScope
        idName@ .scope=
      end
    end
    ## 3. search imports
    false =:: mut: multiMatch
    NameInfo optional.empty =:: mut: match
    context [] .typeContext .nameContext .namespaceInfo .imports while
      $ NAMESPACE_IMPORT_NONE !=
    do =:: importId
      context [] .typeContext .nameContext .namespaceImports
        importId i64 cast
      @[] =:: importInfo
      importInfo [] .nameAlias .length 0:iSize == if
        importInfo [] .imported path  context .typeContext .nameContext findNamespace relSpace=
      else
        importInfo [] .nameAlias =:: nameAlias
        path nameAlias string.startsWith ! or path .length nameAlias .length u> and
            path nameAlias .length string.charAt '.' != if
          ## top namespace is not <nameAlias>
          continue
        end
        importInfo [] .imported
          path nameAlias .length 1:iSize + string.tail
        context .typeContext .nameContext findNamespace relSpace=
      end
      relSpace idName@ .namespace=
      relSpace NAMESPACE_ID_NONE == if
        continue
      end
      ## search all scopes outside procedure
      firstNonProcScope idName@ .scope=
      while
        context .identifierNames idName map.get .and idNameInfo=
            checkVisible ! or idName .scope GLOBAL_SCOPE != or
            idNameInfo .nameId context isVisible if
          matches .if =:: matchData
            matchData []
              idName idNameInfo IdentifierMatch new list.append
            matchData =[]
          end
          mNamespace NAMESPACE_ID_NONE == if
            idNameInfo optional.wrap match=
            importInfo [] .imported mNamespace=
          else
            true multiMatch=
          end
        end
        idName .scope GLOBAL_SCOPE !=
      do
        context [] .scopes
          idName .scope getScopeData [] .parentScope
        idName@ .scope=
      end
    finally importInfo [] .parent end ..drop
    matches optional.isEmpty and match .if
      ## TODO return value indicating multi-match
      idName >$ optional.wrap return
    end
    "could not find identifier":s NAMESPACE_ID_NONE scopeId IdentifierName new
    NameInfo optional.empty return
  end
  proc( NameId : nameId IdentifierContext ptr.mut : context -> IdentifierData ptr.mut optional ) =>: export: getIdentifier
    context .identifierData
      nameId
    map.at return
  end
  proc(
    string : name
    IdentifierContext ptr.mut : context
  -> NameInfo optional ) =>: findIdByName
    name .length 0:iSize != "name is non-empty" assert
    ## searchIdentifier
      name
      true
      context
      IdentifierMatch list ptr.mut optional.empty
    searchIdentifier >$ ..drop return
  end
  union(
    IdentifierData ptr.mut : Ok
    IdentifierData ptr.mut : Curry
    string : Err
  ) =:: export: IdentifierResult
  ## finds an identifier with the given name
  proc(
    string : name
    IdentifierContext ptr.mut : context
  -> IdentifierResult ) =>: export: findIdentifierByName ## TODO return union( data : Ok data : Curry string : Err )
    name .length 0:iSize != "name is non-empty" assert
    ## searchIdentifier
      name
      true
      context
      IdentifierMatch list ptr.mut optional.empty
    searchIdentifier .else
      .name IdentifierResult .Err return
    end .nameId context getIdentifier .else ..drop "could not find identifier":s IdentifierResult .Err return end
      context [] .scopes >>$ .scope getScopeData [] .currentProc .and =:: scopeProc
        context [] .scopes context [] .currentScopeId getScopeData [] .currentProc .and =:: currentProc
        scopeProc currentProc ProcId.eq !
      if
        IdentifierResult .Curry
      else
        IdentifierResult .Ok
      end
    return
  end
  ## finds an identifier with the same name as the given label
  ## to get the identifier-data for a given nameId use `getIdentifier`
  proc(
    NameId : nameId
    IdentifierContext ptr.mut : context
  -> IdentifierResult ) =>: export: findIdentifier
    nameId context .typeContext  .nameContext id.getIdentifierName context findIdentifierByName return
  end
  ## unlike `findIdentifier` this procedure can also find invisible identifiers
  proc(
    NameId : nameId
    IdentifierContext ptr.mut : context
  -> IdentifierResult ) =>: export: findDeclaredIdentifier ## TODO? merge with findIdentifier
    ## searchIdentifier
      nameId context .typeContext  .nameContext id.getIdentifierName
      false
      context
      IdentifierMatch list ptr.mut optional.empty
    searchIdentifier .else
      .name IdentifierResult .Err return
    end .nameId context getIdentifier .else ..drop "could not find identifier":s IdentifierResult .Err return end
      context [] .scopes >>$ .scope getScopeData [] .currentProc .and =:: scopeProc
        context [] .scopes context [] .currentScopeId getScopeData [] .currentProc .and =:: currentProc
        scopeProc currentProc ProcId.eq !
      if
        IdentifierResult .Curry
      else
        IdentifierResult .Ok
      end
    return
  end
  enum( BUILT_IN NAMESPACE PROCEDURE VARIABLE LABEL ) =:: export: DeclarationContext
  proc( IdentifierType : idType -> DeclarationContext ) =>: idDeclarationContext
    idType .PROCEDURE or idType .PROCEDURE_BUNDLE if
      DeclarationContext .PROCEDURE
    else idType .LABEL _if
      DeclarationContext .LABEL
    else
      DeclarationContext .VARIABLE
    end
  end
  proc(
    string : id
    DeclarationContext : context
    FilePosition ptr : pos
    CompilerError list ptr.mut : errors
  -> bool ) =>: export: checkIdentifier
    id .length 0:iSize == if
      "identifier names have to be non-empty" sb.copyPtr pos errors appendError
      true return
    end
    context .BUILT_IN if
      false return
    end
    id 0 string.charAt '#' == if
      "identifier names cannot start with '#'" sb.copyPtr pos errors appendError
      true return
    end
    id ':' string.contains and context .PROCEDURE ! or id 1 string.tail ':' string.contains if
      "identifier names cannot contain ':'" sb.copyPtr pos errors appendError
      true return
    end
    context .NAMESPACE if
      false return
    end
    id '.' string.contains if
      "identifier names cannot contain '.'" sb.copyPtr pos errors appendError
      true return
    end
    id id .length 1:iSize - string.charAt '@' == if
      "identifier names cannot end with '@'" sb.copyPtr pos errors appendError
      true return
    end
    id 0 string.charAt '$' == or id $ .length 1:iSize - string.charAt '$' == if
      "identifier names cannot start or end with `$`" sb.copyPtr pos errors appendError
      true return
    end
    context .PROCEDURE if
      false return
    end
    id id .length 1:iSize - string.charAt '=' == if
      ## allow procedures named `=`
      ##  and procedures with name ending in `==` `!=` `>=` `<=`
      ## XXX? allow more operator-like names ending in `=`
      context .PROCEDURE ! or id .length 1:iSize u> and
          "=<>!":s id $ .length 2:iSize - string.charAt string.contains ! if
        "identifier names cannot end with '='" sb.copyPtr pos errors appendError
        true return
      end
    end
    false return
  end
  proc( AliasId : aliasId IdentifierContext ptr : context -> FilePosition ptr ) =>: export: getAliasPos
    context [] .aliasInfo aliasId i64 cast @[] .declaredAt []
  end
  union(
    _ : OK
    NameInfo : Redeclare
  ) =:: DeclareNameResult
  proc(
    NameId : nameId
    string : name
    bool : isAlias
    IdentifierType : idType
    FilePosition ptr : declaredAt
    IdentifierContext ptr.mut : context
    CompilerError list ptr.mut : errors
  -> DeclareNameResult ) =>: declareName
    context .typeContext =:: typeContext
    typeContext .nameContext =:: nameContext
    nameId nameContext identifierFlags =:: flags
    isAlias ! and flags FLAG_EXPORT & ? and
        context [] .scopes
          context [] .currentScopeId
        getScopeData [] .currentProc ? ! if
      ## exported identifier outside procedure -> global scope
      GLOBAL_SCOPE
    else
      context [] .currentScopeId
    end =:: scopeId
    name
      nameContext [] .namespaceInfo .current
    scopeId IdentifierName new =:: mut: idName
    context .identifierNames idName map.get .if
      DeclareNameResult .Redeclare return
    end
    name context findIdByName .if =:: shadowedName
      shadowedName .nameId nameContext id.identifierFlags =:: shadowFlags
      flags FLAG_SHADOW & ? ! or shadowFlags id.FLAG_BUILT_IN & ? if
        shadowedName .nameId context getIdentifier optional.unwrap =:: shadowed
        ## allow shadoing for labels
        ## TODO? only allow shadowed labels in initializers
        isAlias or idType .LABEL ! or shadowed [] .idType .LABEL ! if
          isAlias if
            "declaration of alias \"" sb.copyPtr
          else
            "declaration of identifier \"" sb.copyPtr
          end
              name sb.appendStr
          shadowFlags id.FLAG_BUILT_IN & ? if
              "\" shadows built-in identifier" sb.appendS
            declaredAt errors appendError
          else shadowedName .aliasId NO_ALIAS == _if
              "\" shadows previous declaration ( at" sb.appendS
              shadowed [] .declaredAt [] sb.appendPos
              " )" sb.appendS
            declaredAt errors appendWarning
          else
              "\" shadows alias ( at" sb.appendS
              shadowedName .aliasId context getAliasPos [] sb.appendPos
              " )" sb.appendS
            declaredAt errors appendWarning
          end
        end
      end
    end
    isAlias if
      context .aliasInfo [] .length AliasId cast
      context .aliasInfo []
        declaredAt AliasInfo new list.append
      context .aliasInfo=
    else
      id.NO_ALIAS
    end =:: aliasId
    context .identifierNames
      idName
      nameId aliasId NameInfo new
    map.put ..drop ## previous entry is always empty
    DeclareNameResult .OK return
  end
  proc(
    NameId : nameId
    Type : valType
    IdentifierType : idType
    i32 : index
    ConstValue : constVal
    bool : isInit
    FilePosition ptr : declaredAt
    IdentifierContext ptr.mut : context
    CompilerError list ptr.mut : errors
  ->  NameId IdentifierData bool ) =>: export: declareIdentifier
    context .typeContext =:: typeContext
    typeContext .nameContext =:: nameContext
    nameId NAME_ID_NONE == if
      "invalid name id" sb.copyPtr declaredAt errors appendError
      NAME_ID_NONE ID_NONE_DATA true return
    end
    nameId nameContext id.currentNamespace nameContext id.setIdentifierNamespace
    nameId nameContext identifierFlags =:: flags
    flags FLAG_MUTABLE & ? if
      idType .TYPE if
        "type definitions cannot be mutable" sb.copyPtr declaredAt errors appendError
        NAME_ID_NONE ID_NONE_DATA true return
      end
      idType .PROCEDURE if
        "procedures cannot be mutable" sb.copyPtr declaredAt errors appendError
        NAME_ID_NONE ID_NONE_DATA true return
      end
    end
    nameId nameContext id.getIdentifierName =:: name
    ## don't check names of built-in identifiers
    name
      flags FLAG_BUILT_IN & ? or flags FLAG_LAMBDA & ? if
        DeclarationContext .BUILT_IN
      else
        idType idDeclarationContext
      end
    declaredAt errors checkIdentifier if
      NAME_ID_NONE ID_NONE_DATA true return
    end
    nameId
      name
      false
      idType
      declaredAt
      context
      errors
    declareName .Redeclare .if =:: prevId
      context .identifierData prevId .nameId map.at .else
        "could not find previous id of redeclaration" ..panic
      end =:: prevDec
      prevId .aliasId NO_ALIAS == and
          ## initialization for declaration / declaration for initialized identifier
          prevDec [] .declarationOnly isInit ! | and
          idType .GLOBAL_VAR or idType .TYPE or
          idType .PROCEDURE or idType .PROCEDURE_BUNDLE if
        ## remove procedure labels before comparing types
        valType typeContext types.asUnlabeledProc
            prevDec [] .valueType  typeContext types.asUnlabeledProc
            types.typeEquals ! if
          "incompatible types for declaration and initialization of \"" sb.copyPtr
            nameId nameContext sb.appendIdentifierPath
            "\":\n  * " sb.appendS
            prevDec [] .valueType typeContext sb.appendType
            " at " sb.appendS
            prevDec [] .declaredAt [] sb.appendPos
            "\n  * " sb.appendS
            valType typeContext sb.appendType
          declaredAt errors appendError
          NAME_ID_NONE ID_NONE_DATA true return
        end
        prevDec [] .idType idType != if
          "declaration and initialization of \"" sb.copyPtr
            nameId nameContext sb.appendIdentifierPath
            "\" are not compatible expected: " sb.appendS
            prevDec [] .idType sb.appendIdType
            " ( declared at " sb.appendS
            prevDec [] .declaredAt [] sb.appendPos
            " )" sb.appendS
            " got: " sb.appendS
            idType sb.appendIdType
          declaredAt errors appendError
          NAME_ID_NONE ID_NONE_DATA true return
        end
        prevDec [] .nameId nameContext identifierFlags flags != if
          "flags for declaration and initialization of \"" sb.copyPtr
            nameId nameContext sb.appendIdentifierPath
            "\" differ: " sb.appendS
            ## TODO? print flags
            " ( declaration at " sb.appendS
            prevDec [] .declaredAt [] sb.appendPos
            " )" sb.appendS
          declaredAt errors appendWarning
        end
        isInit if
          valType prevDec .valueType=
          constVal prevDec .constValue=
          index prevDec .index=
          declaredAt prevDec .declaredAt=
          false prevDec .declarationOnly=
        end
        prevDec [] .nameId prevDec [] false return
      end
      prevId .aliasId NO_ALIAS == if
        prevDec [] .declaredAt
      else
        prevId .aliasId context getAliasPos
      end =:: prevPos
      "re declaration of identifier \"" sb.copyPtr
        nameId nameContext sb.appendIdentifierPath
        "\" ( previous declaration at " sb.appendS
        prevPos [] sb.appendPos
        " )" sb.appendS
      declaredAt errors appendError
      NAME_ID_NONE ID_NONE_DATA true return
    else ..drop end
    ## IdentifierData
      valType
      constVal
      declaredAt
      nameId
      index
      idType
      isInit !
    IdentifierData new =:: idData
    context .identifierData
      nameId
      idData
    map.put ..drop ## previous entry is always empty
    nameId idData false return
  end
  proc(
    NameId : srcId
    string : newName
    IdentifierType : idType
    FilePosition ptr : declaredAt
    IdentifierContext ptr.mut : context
    CompilerError list ptr.mut : errors
  -> bool ) =>: export: declareNameAlias
    newName idType idDeclarationContext declaredAt errors checkIdentifier if
      true return
    end
    srcId
      newName
      true
      idType
      declaredAt
      context
      errors
    declareName .Redeclare .if =:: prevId
      prevId .aliasId NO_ALIAS == if
        context .identifierData prevId .nameId map.at .else
          "could not find previous id of redeclaration" ..panic
        end [] .declaredAt
      else
        prevId .aliasId context getAliasPos
      end =:: prevPos
      "re declaration of identifier \"" sb.copyPtr
        newName sb.appendStr
        "\" ( previous declaration at " sb.appendS
        prevPos [] sb.appendPos
        " )" sb.appendS
      declaredAt errors appendWarning
      true return
    else ..drop end
    false return
  end
  proc(
    Type : itrType
    IdentifierFlag : flags
    FilePosition ptr : pos
    IdentifierContext ptr.mut : context
  -> IdentifierInfo ) =>: export: newTmpVar
    ## newIdentifier
      string.empty
      flags
      pos
    context .typeContext .nameContext newIdentifier =:: label
    ## IdentifierInfo
      label
      IdentifierType .ITR_VAR false
    IdentifierInfo new =:: idInfo
    context .identifierData
      label
      ## IdentifierData
        itrType
        ConstValue .None
        pos
        label
        -1
        IdentifierType .ITR_VAR
        false
      IdentifierData new
    map.put ? ! "each itr-var has an unique id" assert
    idInfo return
  end
  proc(
    NameId : nameId
    Type : varType
    FilePosition ptr : pos
    IdentifierContext ptr.mut : context
  -> ) =>: export: declareTmpVar
    context .identifierData
      nameId
      ## IdentifierData
        varType
        ConstValue .None
        pos
        nameId
        -1
        IdentifierType .TMP_VAR
        false
      IdentifierData new
    map.put ? ! "each tmp-var has an unique id" assert
  end
end
namespace: sb
  proc( stringBuilder : sb IdentifierType : idType -> stringBuilder ) =>: export: appendIdType
    sb
    idType switch
      TYPE case
        "type":s sb.appendStr
        return
      PROCEDURE case
        "procedure":s sb.appendStr
        return
      PROCEDURE_BUNDLE case
        "procedure bundle":s sb.appendStr
        return
      GLOBAL_VAR case
        "global variable":s sb.appendStr
        return
      LABEL case
        "label ":s sb.appendStr
        return
      LOCAL_VAR case
        "local variable":s sb.appendStr
        return
      ARGUMENT case
        "procedure argument":s sb.appendStr
        return
      TMP_VAR case
        "temporary variable":s sb.appendStr
        return
      ITR_VAR case
        "iterator variable":s sb.appendStr
        return
    end
  end
  proc( stringBuilder : sb IdentifierInfo : id NameContext ptr : nameContext -> stringBuilder ) =>: export: appendIdInfo
    sb
      id .nameId nameContext id.identifierFlags >$
        $1 id.FLAG_EXPORT & ? if
          "export: ":s sb.appendStr
        end
        $1 id.FLAG_EXTERN & ? if
          "extern: ":s sb.appendStr
        end
        $1 id.FLAG_MUTABLE & ? if
          "mutable: ":s sb.appendStr
        end
        $1 id.FLAG_STATIC & ? if
          "static: ":s sb.appendStr
        end
      >$ ..drop
      id .noRead if
        "no-read ":s sb.appendStr
      end
      id .idType switch
        TYPE case
          "type \"":s sb.appendStr
          id .nameId nameContext sb.appendIdentifierPath
          "\"":s sb.appendStr
          return
        PROCEDURE case
          "procedure \"":s sb.appendStr
          id .nameId nameContext sb.appendIdentifierPath
          "\"":s sb.appendStr
          return
        PROCEDURE_BUNDLE case
          "procedure bundle  \"":s sb.appendStr
          id .nameId nameContext sb.appendIdentifierPath
          "\"":s sb.appendStr
          return
        GLOBAL_VAR case
          "global variable \"":s sb.appendStr
          id .nameId nameContext sb.appendIdentifierPath
          "\"":s sb.appendStr
          return
        LABEL case
          "label \"":s sb.appendStr
          id .nameId nameContext sb.appendIdentifierName
          "\"":s sb.appendStr
          return
        LOCAL_VAR case
          "local variable: \"":s sb.appendStr
          id .nameId nameContext sb.appendIdentifierName
          "\"":s sb.appendStr
          return
        ARGUMENT case
          "procedure argument \"":s sb.appendStr
          id .nameId nameContext sb.appendIdentifierName
          "\"":s sb.appendStr
          return
        TMP_VAR case
          "temporary variable \"":s sb.appendStr
          id .nameId nameContext sb.appendIdentifierName
          "\"":s sb.appendStr
          return
        ITR_VAR case
          "iterator variable (":s sb.appendStr
          id .nameId i64 cast sb.appendI
          ")":s sb.appendStr
          return
      end
  end
end
namespace: id
  proc( NameId : name IdentifierContext ptr.mut : context -> ) =>: export: beginNamespace
    context [] .prevNamespaces
      context [] .typeContext  .nameContext .namespaceInfo list.append
    context .prevNamespaces=
    context [] .typeContext  .nameContext .namespaceInfo .current
      name context .typeContext  .nameContext id.getIdentifierName
        true
      context .typeContext  .nameContext childId
    context .typeContext  .nameContext .namespaceInfo .current=
  end
  proc(
    NameId : name
    string : nameAlias
    IdentifierContext ptr.mut : context
  -> bool ) =>: export: importNamespace
    0 NamespaceId cast
      name context .typeContext  .nameContext id.getIdentifierName
    context .typeContext  .nameContext findNamespace
      $ NAMESPACE_ID_NONE == if ..drop
        true return
      end
    =:: importId
    context [] .typeContext  .nameContext .namespaceInfo .imports
      importId nameAlias context .typeContext  .nameContext getNamespaceImportId
    context .typeContext  .nameContext .namespaceInfo .imports=
    false return
  end
  proc(
    string : usedName string : nameAlias
    IdentifierContext ptr.mut : idContext
    FilePosition ptr : pos
    CompilerError list ptr.mut : errors
  -> bool ) =>: export: importIdentifier
    idContext .typeContext .nameContext =:: nameContext
    usedName idContext id.findIdentifierByName .Ok .else .Curry ? =:: isCurry
     "identifier \"" sb.copyPtr
        usedName sb.appendStr
        "\" does not exist in the current scope":s sb.appendStr
        isCurry if " currying is not supported":s sb.appendStr end
      pos errors appendError
     true return
    end =:: target
      target [] .nameId
      nameAlias .length 0:iSize != if
        nameAlias nameContext id.copyString ## create copy to ensure string stays alive
      else
        target [] .nameId nameContext id.getIdentifierName
          $ '.' string.lastIndexOf
        string.tail
      end
      target [] .idType
      pos
      idContext
      errors
    id.declareNameAlias ..drop
    false return
  end
  proc( IdentifierContext ptr.mut : context -> bool ) =>: export: endNamespace
    context [] .prevNamespaces .length 0:iSize == if
      true return
    end
    context [] .prevNamespaces
      list.removeLast context .typeContext  .nameContext .namespaceInfo=
    context .prevNamespaces=
    false
  end
  proc(
    FileId : fileId
    ScopeId : fileScopeId
    IdentifierContext ptr.mut : context
  -> ) =>: export: importFile
    fileId FILE_ID_NONE == or fileId FILE_ID_BUILT_IN == if
      return
    end
    context [] .scopes context [] .currentScopeId getScopeData =:: currentScopeData
    ## check if already imported
    currentScopeData [] .visibleFiles while $ NO_IMPORTS != do =:: id
      context [] .visibleFiles id i64 cast [] =:: importInfo
      importInfo .fileId fileId == if
        return
      end
    finally importInfo .prev end ..drop
    context [] .visibleFiles
      $ .length =:: newId
      ## ImportInfo
        fileId
        currentScopeData [] .visibleFiles
      ImportInfo new list.append
    context .visibleFiles=
    newId ImportId cast currentScopeData .visibleFiles=
    ## imports imports of import
    fileScopeId NO_SCOPE != if
      context [] .scopes fileScopeId getScopeData =:: fileScope
      fileScope [] .visibleFiles while $ NO_IMPORTS != do =:: id
        context [] .visibleFiles id i64 cast [] =:: importInfo
        importInfo .fileId NO_SCOPE context importFile
      finally importInfo .prev end ..drop
    end
  end
end
