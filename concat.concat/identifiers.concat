#include stringBuilder
#include map
#include optional

#include "types.concat"
#include "constants.concat"
#include "labels.concat"
#include "codeBlocks.concat"

#namespace id
  enum( TYPE PROCEDURE GLOBAL_VAR  TEMPLATE_ARG  LOCAL_VAR ARGUMENT TMP_VAR ) =:: public IdentifierType

  i32 =:: public TemplateId
  -1 TemplateId =: public TEMPLATE_ID_NONE
  struct( ConstValue arrayView : argValues types.Type : implType FilePosition : implPos ) =:: public TemplateImplementation
  ## XXX? ( offset length file code-Type ) -> code-position
  struct( types.Type : templateType FilePosition : declaredAt i64 : codeOffset i64 : mut codeLength #+XXX scrFile+# TemplateImplementation list : implementations i64 : compiledImpls ) =:: public TemplateInfo

  struct( types.Type : valueType ConstValue : constValue FilePosition : declaredAt LabelId : labelId TemplateId : templateId i32 : id IdentifierType : idType ) =:: IdentifierData
  struct( IdentifierType : idType LabelId : labelId TemplateId : templateId i32 : id ) =:: public IdentifierInfo

  types.Type .undefined ConstValue .none "" 0 string new 0 0 FilePosition new LABEL_ID_NONE TEMPLATE_ID_NONE -1 IdentifierType .GLOBAL_VAR  IdentifierData new =:: ID_NONE_DATA
  types.Type .undefined ConstValue .none "" 0 string new 0 0 FilePosition new LABEL_ID_NONE TEMPLATE_ID_NONE -1 IdentifierType .GLOBAL_VAR  IdentifierData new =:: mut ID_TMP_DATA

  struct( string : name NamespaceId : mut namespace ) =:: IdentifierName
  struct( IdentifierName : name IdentifierData ptr : data ) =:: IdentifierMatch

  proc( IdentifierName : a => i32 ) =: idHash
    a .name string.hash a .namespace i32 cast ^ return
  end
  proc( IdentifierName : a IdentifierName : b => bool ) =: idEq
    a .namespace b .namespace == a .name b .name string.eq & return
  end

  struct(
    IdentifierName IdentifierData hashMap : mut identifiers
    codeBlocks.BlockType : mut blockType
    types.Type : currentProc
    NamespaceImportId : prevImports
    bool : mut autoClose
  ) =:: Scope

  proc( codeBlocks.BlockType : blockType types.Type : procType NamespaceImportId : imports => Scope ) =: newScope
    idHash @
    idEq @
    128 IdentifierData map.create
    blockType
    procType
    imports
    false
    Scope new return
  end

  struct(
    LabelContext : mut labelContext
    types.TypeContext : mut typeContext
    Scope list : mut localScopes
    Scope list : mut globalScopes
    TemplateInfo list : mut templateInfos
    NamespaceImportId list : mut prevImports
    NamespaceInfo : mut namespaceInfo
    i32 : mut globalScopeId
    i32 : mut localVarCount
    TemplateId : mut currentTemplate
  ) =:: public IdentifierContext

  proc( => IdentifierContext ) =: public newIdentifierContext
    newLabelContext
    types.newTypeContext
    128 Scope list.create
    128 Scope list.create
      codeBlocks.BlockType .UNKNOWN types.Type .undefined NAMESPACE_IMPORT_NONE newScope list.append
    128 TemplateInfo      list.create
    32  NamespaceImportId list.create
      0
      NAMESPACE_IMPORT_NONE
    NamespaceInfo new
    0
    0
    TEMPLATE_ID_NONE
    IdentifierContext new return
  end

  proc( IdentifierData ptr : idData => IdentifierInfo ) =: public asIdInfo
    idData [] .idType
    idData [] .labelId
    idData [] .templateId
    idData [] .id
    IdentifierInfo new return
  end

  proc( IdentifierContext ptr mut : context => bool ) =: public isGlobal
    context [] .localScopes .length 0 == return
  end
  proc( IdentifierContext ptr mut : context => Scope ptr mut optional ) =: getGlobalScope
    context [] .globalScopes context [] .globalScopeId list.at return
  end
  proc( codeBlocks.BlockType : blockType types.Type : procType  IdentifierContext ptr mut : context => ) =: public openProcScope
    context [] .localScopes
       blockType procType context [] .namespaceInfo .imports newScope
       list.append
    context [] .localScopes =
  end
  proc( codeBlocks.BlockType : blockType  IdentifierContext ptr mut : context => ) =: public openScope
    context [] .localScopes .length 0 == if
      types.Type .undefined
    else
      context [] .localScopes list.peek .data [] .currentProc
    end =:: currentProc
    context [] .localScopes
       blockType currentProc context [] .namespaceInfo .imports newScope
       list.append
    context [] .localScopes =
  end
  proc( codeBlocks.BlockType : blockType  bool : autoClose IdentifierContext ptr mut : context => bool ) =: public updateScopeType
    context [] .localScopes .length 0 == if
      true return
    end
    blockType context [] .localScopes list.peek .data [] .blockType =
    autoClose context [] .localScopes list.peek .data [] .autoClose =
    false return
  end
  proc( IdentifierContext ptr mut : context => codeBlocks.BlockType ) =: public currentScopeType
    #using codeBlocks
    context [] .localScopes .length 0 == if
      BlockType .UNKNOWN return
    end
    context [] .localScopes list.peek .data [] .blockType return
  end
  proc( IdentifierContext ptr mut : context => types.Type ) =: public currentScopeProc
    #using codeBlocks
    context [] .localScopes .length 0 == if
      types.Type .undefined return
    end
    context [] .localScopes list.peek .data [] .currentProc return
  end
  proc( IdentifierContext ptr mut : context => bool codeBlocks.BlockType bool ) =: public closeScope
    #using codeBlocks
    context [] .localScopes .length 0 == if
      false BlockType .UNKNOWN true return
    end
    context [] .localScopes list.pop #swap context [] .localScopes =
      #dup .identifiers addrOf map.free
      #dup .prevImports context [] .namespaceInfo .imports =
      #dup .blockType codeBlocks.BlockType .PROCEDURE == if
        0 context [] .localVarCount = ## XXX handle nested procedures
      end
    #dup .autoClose #swap .blockType false return
  end
  ## TODO scopeItr
  ## TODO different return flags for: error, no-match, match, multi-match
  proc( string : id IdentifierContext ptr mut : context IdentifierMatch list ptr mut optional : matches => IdentifierName IdentifierData ptr bool ) =: public searchIdentifier
    context [] .namespaceInfo .current =:: mut mNamespace
    NamespaceId : mut relSpace
    mNamespace NAMESPACE_ID_NONE == if
      "invalid current namespace id" string.wrap NAMESPACE_ID_NONE IdentifierName new ID_NONE_DATA @ true return
    end
    id 0 string.charAt '.' == if
      "identifiers cannot start with ." string.wrap NAMESPACE_ID_NONE IdentifierName new ID_NONE_DATA @ true return
    end
    id '.' string.split
      #over .length 0 == if
        #swap
      end
    =:: path
    =:: name
    ## 1. search in local scopes
    mNamespace path  context [] .labelContext addrOf findNamespace relSpace =
    name relSpace IdentifierName new =:: mut idName
    relSpace NAMESPACE_ID_NONE != if
      context [] .localScopes .length 1 -
      while #dup 0 >= do
        context [] .localScopes #over list.get .identifiers addrOf idName map.at
        #dup optional.hasData if .data
          matches optional.isEmpty if #swap #drop
            idName #swap false return
          end
          matches .data []
            idName #over:2 IdentifierMatch new list.append
          matches .data [] =
          #drop
        else #drop end
        1 -
      end #drop
    end
    ## 2. search global variable in current&parent namespaces
    while mNamespace NAMESPACE_ID_NONE != do
      mNamespace path  context [] .labelContext addrOf findNamespace relSpace =
      relSpace idName .namespace =
      relSpace NAMESPACE_ID_NONE != if
        context getGlobalScope .data [] .identifiers addrOf idName map.at
        #dup optional.hasData if .data
          matches optional.isEmpty if
            idName #swap false return
          end
          matches .data []
            idName #over:2 IdentifierMatch new list.append
          matches .data [] =
          #drop
        else #drop end
      end
      context [] .labelContext .namespaces mNamespace list.get .parent mNamespace =
    end
    ## 3. search imports
    false =:: mut multiMatch
    IdentifierData ptr optional.empty =:: mut match
    context [] .namespaceInfo .imports while #dup NAMESPACE_IMPORT_NONE != do
      context [] .labelContext .namespaceImports #swap list.get
        #dup .imported path  context [] .labelContext addrOf findNamespace relSpace =
        relSpace idName .namespace =
        relSpace NAMESPACE_ID_NONE != if
          context getGlobalScope .data [] .identifiers addrOf idName map.at
          #dup optional.hasData if .data
            matches optional.hasData if
              matches .data []
                idName #over:2 IdentifierMatch new list.append
              matches .data [] =
            end
            mNamespace NAMESPACE_ID_NONE == if
              IdentifierData ptr cast optional.wrap match =
              #dup .imported mNamespace =
            else #drop
              true multiMatch =
            end
          else #drop end
        end
     .parent
    end #drop
    matches optional.isEmpty match optional.hasData & if ## XXX return value indicating multi-match
      idName match .data multiMatch return
    end
    ## 4. template arguments
    context hasOpenTemplate if
      context [] .templateInfos context [] .currentTemplate list.get =:: template
      template .templateType
        0 while #dup #over:2 context [] .typeContext @ types.compositeEltCount < do
          #swap
            #dup #over:2 context [] .typeContext @ types.compositeGetLabel context [] .labelContext @ labelName .data id string.eq if
              =:: tType =:: tId
              tType tId context [] .typeContext @ types.compositeGetElement =:: eType
              eType
              eType types.primitive.TYPE types.typeEquals if
                tId types.newTemplateType ConstValue .typeId new
              else
                tId ConstValue .templateArg new
              end
              template .declaredAt
              tType tId context [] .typeContext @ types.compositeGetLabel
              context [] .currentTemplate
              tId
              IdentifierType .TEMPLATE_ARG
              IdentifierData new ID_TMP_DATA =
              name context [] .namespaceInfo .current IdentifierName new ID_TMP_DATA @ false return
            end
          #swap
          1 +
        end #drop
      #drop
    end
    "could not find identifier" string.wrap NAMESPACE_ID_NONE IdentifierName new ID_NONE_DATA @ true return
  end
  proc( string : id  IdentifierContext ptr mut : context => IdentifierName IdentifierData ptr bool ) =: public getIdentifier
    id context  IdentifierMatch list ptr mut optional.empty searchIdentifier return
  end
  proc( LabelId : label types.Type : valType IdentifierType : idType i32 : id ConstValue : constVal FilePosition : declaredAt IdentifierContext ptr mut : context =>  IdentifierName IdentifierData ptr bool ) =: public declareIdentifier
    label LABEL_ID_NONE == if
      "invalid label id" string.wrap NAMESPACE_ID_NONE IdentifierName new
        ID_NONE_DATA @ true return
    end
    label  context [] .labelContext addrOf
      #over #over labelFlags =:: flags
      #over #over labelName .data =:: name
    labelPos .data =:: labelPos

    flags FLAG_MUTABLE & 0 != if
      idType IdentifierType .TYPE == if
        "type definitions cannot be mutable" string.wrap NAMESPACE_ID_NONE IdentifierName new
          ID_NONE_DATA @ true return
      end
      idType IdentifierType .PROCEDURE == if
        "procedures cannot be mutable" string.wrap NAMESPACE_ID_NONE IdentifierName new
          ID_NONE_DATA @ true return
      end
      idType IdentifierType .ARGUMENT ==  if
        "procedure arguments cannot be mutable" string.wrap NAMESPACE_ID_NONE IdentifierName new
          ID_NONE_DATA @ true return
      end
    end
    name 0 string.charAt '#' == if
      "identifier names cannot start with '#'" string.wrap NAMESPACE_ID_NONE IdentifierName new
        ID_NONE_DATA @ true return
    end
    name '.' string.contains if
      "identifier names cannot contain '.'" string.wrap NAMESPACE_ID_NONE IdentifierName new
        ID_NONE_DATA @ true return
    end
    context [] .localScopes .length 0 > if
      context [] .localScopes #dup .length 1 - list.at .data
    else
      context getGlobalScope .data
    end =:: mScope
    name context [] .namespaceInfo .current IdentifierName new =:: mut idName
    mScope [] .identifiers addrOf idName map.at #dup optional.hasData if .data
      idName #swap true return
    end #drop
    name context getIdentifier ! if
      true return ## shadowed identifier
    end #drop:2
    mScope [] .identifiers addrOf
      idName
      valType
      flags FLAG_MUTABLE & 0 != if ConstValue .none new else constVal end
      declaredAt
      label
      context [] .currentTemplate
      id -1 == idType IdentifierType .LOCAL_VAR == & if
        context [] .localVarCount ++
      else
        id
      end
      idType
      IdentifierData new
    map.put #drop ## previous entry is always empty
    idName mScope [] .identifiers addrOf idName map.at .data false return
  end
#end
#namespace sb
  proc( stringBuilder : sb id.IdentifierInfo : id id.LabelContext ptr : labelContext => stringBuilder ) =: public appendIdInfo
    sb ## TODO print mutability & template data
      id .idType switch
        TYPE case
          "type \"" sb.appendS
          id .labelId labelContext id.labelName .data sb.appendStr
          "\"" sb.appendS
          return
        PROCEDURE case
          "procedure \"" sb.appendS
          id .labelId labelContext id.labelName .data sb.appendStr
          "\"" sb.appendS
          return
        GLOBAL_VAR case
          "global variable \"" sb.appendS
          id .labelId labelContext id.labelName .data sb.appendStr
          "\"" sb.appendS
          return
        LOCAL_VAR case
          "local variable (" sb.appendS
          id .id sb.appendI
          ") \"" sb.appendS
          id .labelId labelContext id.labelName .data sb.appendStr
          "\"" sb.appendS
          return
        ARGUMENT case
          "procedure argument (" sb.appendS
          id .id sb.appendI
          ") \"" sb.appendS
          id .labelId labelContext id.labelName .data sb.appendStr
          "\"" sb.appendS
          return
        TMP_VAR case
          "temporary variable (" sb.appendS
          id .id sb.appendI
          ") \"" sb.appendS
          id .labelId labelContext id.labelName .data sb.appendStr
          "\"" sb.appendS
          return
        TEMPLATE_ARG case
          "template argument (" sb.appendS
          id .id sb.appendI
          ") \"" sb.appendS
          id .labelId labelContext id.labelName .data sb.appendStr
          "\"" sb.appendS
          return
      end
  end
#end
#namespace id
  proc( LabelId : name IdentifierContext ptr mut : context => ) =: public beginNamespace
    context [] .prevImports
      context [] .namespaceInfo .imports list.append
    context [] .prevImports =
    context [] .namespaceInfo .current
      name context [] .labelContext @ labelName .data true context [] .labelContext @ childId
    context [] .namespaceInfo .current =
  end
  proc( LabelId : name IdentifierContext ptr mut : context => bool ) =: public importNamespace
    0 NamespaceId cast name context [] .labelContext @ labelName .data context [] .labelContext @ findNamespace
    #dup NAMESPACE_ID_NONE == if #drop
      true return
    end
    context [] .namespaceInfo .imports
      #swap context [] .labelContext @ getNamespaceImportId
    context [] .namespaceInfo .imports =
    false return
  end
  proc( IdentifierContext ptr mut : context => bool ) =: public endNamespace
    context [] .namespaceInfo .current 0 == if
      true return
    end
    context [] .namespaceInfo .current context [] .labelContext @ parentNamespace
    context [] .namespaceInfo .current =
    context [] .prevImports
      list.pop #swap
    context [] .prevImports =
    context [] .namespaceInfo .imports =
    false
  end

  proc( IdentifierContext ptr mut : context => bool ) =: public hasOpenTemplate
    context [] .currentTemplate TEMPLATE_ID_NONE != return
  end
  proc( TemplateId : id IdentifierContext ptr mut : context => TemplateInfo ptr mut optional ) =: public getTemplateInfo
    id 0 < id context [] .templateInfos .length >= | if
      TemplateInfo ptr mut optional.empty return
    end
    context [] .templateInfos id list.at return
  end
  proc( types.Type : templateTypes i64 : templateOpsOffset #+XXX src-file+# FilePosition : pos IdentifierContext ptr mut : context => bool ) =: public beginTemplate
    context hasOpenTemplate if
      true return
    end
    context [] .templateInfos
      #dup .length TemplateId cast context [] .currentTemplate =
      ## TemplateInfo
        templateTypes
        pos
        templateOpsOffset
        0
        8 TemplateImplementation list.create
        0
      TemplateInfo new list.append
    context [] .templateInfos =
    false return
  end
  proc( i64 : templateOpsOffset IdentifierContext ptr mut : context => ) =: public endOpenTemplate
    context hasOpenTemplate ! if
      return
    end
    context [] .templateInfos context [] .currentTemplate list.at .data
      templateOpsOffset #over [] .codeOffset -
      #swap [] .codeLength =
    TEMPLATE_ID_NONE context [] .currentTemplate =
  end
#end

