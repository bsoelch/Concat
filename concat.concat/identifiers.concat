import string
import stringBuilder
import map
import optional
using std.literals.

import "constants.concat"
import "types.concat"
import "labels.concat"
import "codeBlocks.concat"
import "common.concat"

enum(
  TYPE
  PROCEDURE
  PROCEDURE_BUNDLE
  GLOBAL_VAR
  LABEL
  LOCAL_VAR
  ARGUMENT
  TMP_VAR
  ITR_VAR
) =:: export: IdentifierType

struct(
  Type : valueType
  ConstValue : constValue
  FilePosition : declaredAt
  LabelId : labelId
  i32 : index
  IdentifierType : idType
  bool : declarationOnly
) =:: IdentifierData
struct(
  IdentifierType : idType
  LabelId : labelId
) =:: export: IdentifierInfo

namespace: id
  i32 =:: export: AliasId
  -1:AliasId =:: export: NO_ALIAS
  struct( FilePosition : declaredAt ) =:: AliasInfo
  i32 =:: ImportId
  -1:ImportId =:: export: NO_IMPORTS
  struct( FileId : fileId ImportId : prev ) =:: ImportInfo
  struct(
    string : name
    NamespaceId : namespace
    ScopeId : scope
  ) =:: IdentifierName
  struct(
    LabelId : labelId
    AliasId : aliasId
  ) =:: export: NameId
  struct(
    IdentifierName : name
    NameId : nameData
  ) =:: export: IdentifierMatch
  ## IdentifierName
    "" 0 string new
    NAMESPACE_ID_NONE
    GLOBAL_SCOPE
  IdentifierName new =:: ID_NONE
  ## IdentifierData
    Type .undefined
    ConstValue .None
    FILE_POS_UNKNOWN
    LABEL_ID_NONE
    -1
    IdentifierType .GLOBAL_VAR
    false
  IdentifierData new =:: ID_NONE_DATA
  ## IdentifierData
    Type .undefined
    ConstValue .None
    FILE_POS_UNKNOWN
    LABEL_ID_NONE
    -1
    IdentifierType .GLOBAL_VAR
    false
  IdentifierData new =:: mut: ID_TMP_DATA
  -2:LabelId =:: LABEL_ID_TMP

  proc( IdentifierName : a -> i32 ) =>: idHash
    a .name string.hash 31 * a .namespace i32 cast + 31 * a .scope i32 cast + return
  end
  proc( IdentifierName : a IdentifierName : b -> bool ) =>: idEq
    a .scope b .scope != a .namespace b .namespace != | if
      false return
    end
    a .name b .name string.eq return
  end

  struct(
    ScopeId : parentScope
    ProcId : currentProc
    NamespaceImportId : prevImports
    ImportId : visibleFiles
  ) =:: Scope

  proc( ScopeId : parent ProcId : procId NamespaceImportId : imports ImportId : visibleFiles -> Scope ) =>: newScope
     ## Scope
      parent
      procId
      imports
      visibleFiles
    Scope new return
  end
end
  struct(
    using id.
    TypeContext : typeContext
    ConstantContext : constContext
    Scope list : scopes
    IdentifierName  NameId hashMap : identifierNames
    LabelId IdentifierData hashMap : identifierData
    ConstValue list : argBuffer
    types.ArraySize list : arraySizeBuffer
    NamespaceInfo list : prevNamespaces
    AliasInfo list : aliasInfo
    ImportInfo list : visibleFiles
    ScopeId : currentScopeId
  ) =:: export: IdentifierContext
namespace: id

  proc( -> IdentifierContext ) =>: export: newIdentifierContext
    types.newTypeContext
      newConstContext
      128 Scope list.create
        id.GLOBAL_SCOPE NO_PROC NAMESPACE_IMPORT_NONE NO_IMPORTS newScope
      list.append
      idHash@    idEq@    4096 NameId map.create
      labelHash@ labelEq@ 4096 IdentifierData map.create
      32  ConstValue      list.create
      128 types.ArraySize list.create
      128 NamespaceInfo   list.create
      128 AliasInfo       list.create
      128 ImportInfo      list.create
      id.GLOBAL_SCOPE
    IdentifierContext new return
  end
  proc( IdentifierContext -> IdentifierContext ) =>: export: freeIdentifierContext
    $ .typeContext types.freeTypeContext >$ .typeContext=
    $ .constContext freeConstContext >$ .constContext=
    $ .scopes list.free >$ .scopes=
    $ .identifierNames =:: mut: idNames
      idNames@ map.free
    idNames >$ .identifierNames=
    $ .identifierData =:: mut: idData
      idData@ map.free
    idData >$ .identifierData=
    $ .argBuffer list.free >$ .argBuffer=
    $ .arraySizeBuffer list.free >$ .arraySizeBuffer=
    $ .prevNamespaces list.free >$ .prevNamespaces=
    $ .aliasInfo list.free >$ .aliasInfo=
    $ .visibleFiles list.free >$ .visibleFiles=
    id.NO_SCOPE >$ .currentScopeId=
  end

  proc( IdentifierData ptr : idData -> IdentifierInfo ) =>: export: asIdInfo
    idData [] .idType
    idData [] .labelId
    IdentifierInfo new return
  end

  proc( Scope list ScopeId -> Scope ptr.mut ) =>: getScopeData
    i64 cast.u list.at .data
  end
  proc( IdentifierContext ptr : context -> ScopeId ) =>: export: currentScope
    context [] .currentScopeId
  end
  proc( IdentifierContext ptr.mut : context -> ) =>: export: clearScope
    GLOBAL_SCOPE context .currentScopeId=
  end
  proc( ScopeId : scopeId IdentifierContext ptr.mut : context -> ) =>: export: setScope
    scopeId context .currentScopeId=
  end
  proc( IdentifierContext ptr.mut : context -> ) =>: export: openScope
    context [] .scopes context [] .currentScopeId getScopeData =:: parentScope
    context [] .scopes
      $ .length ScopeId cast =:: newScopeId
        context [] .currentScopeId
          parentScope [] .currentProc
          context [] .typeContext .labelContext .namespaceInfo .imports
          parentScope [] .visibleFiles
        newScope
      list.append
    context .scopes=
    newScopeId context .currentScopeId=
  end
  proc(
    IdentifierContext ptr.mut : context
  ->
    bool #+isError+#
  ) =>: export: closeScope
    context [] .currentScopeId GLOBAL_SCOPE == if
      true return
    end
    context [] .scopes context [] .currentScopeId getScopeData =:: currentScopeData
    currentScopeData [] .prevImports context .typeContext .labelContext .namespaceInfo .imports=
    currentScopeData [] .parentScope context .currentScopeId=
    false return
  end
  proc( LabelId : label IdentifierContext ptr.mut : context -> bool ) =>: isVisible
    context .typeContext .labelContext =:: labelContext
    label labelContext labelFlags id.FLAG_BUILT_IN id.FLAG_MERGEABLE | & ? if
      true return ## built-ins and mergable identifiers are always visible
    end
    label labelContext getLabelFile =:: srcFile
    context [] .scopes context [] .currentScopeId getScopeData =:: currentScopeData
    currentScopeData [] .visibleFiles while $ NO_IMPORTS != do =:: id
      context [] .visibleFiles id i64 cast list.get =:: importInfo
      importInfo .fileId srcFile == if
        true return
      end
      importInfo .prev
    end ..drop
    false return
  end
  proc(
    string : id
    bool : checkVisible
    IdentifierContext ptr.mut : context
    IdentifierMatch list ptr.mut optional : matches
  -> IdentifierName NameId bool ) =>: export: searchIdentifier
    context [] .currentScopeId =:: scopeId
    context [] .typeContext .labelContext .namespaceInfo .current =:: mut: mNamespace
    NamespaceId : relSpace
    mNamespace NAMESPACE_ID_NONE == if
      "invalid current namespace id":s NAMESPACE_ID_NONE scopeId IdentifierName new
      id.LABEL_ID_NONE id.NO_ALIAS NameId new true return
    end
    id 0 string.charAt '.' == if
      id .length 2 >= and id 1 string.charAt '.' == if
        id string.empty
      else
        "identifiers cannot start with .":s NAMESPACE_ID_NONE scopeId IdentifierName new
        id.LABEL_ID_NONE id.NO_ALIAS NameId new true return
      end
    else
      id '.' string.splitLast
    end =:: path =:: name
    NameId optional : idLabel?
    NameId : idLabel
    ## 1. search in current scopes
    mNamespace path  context .typeContext .labelContext findNamespace relSpace@ =
    name relSpace scopeId IdentifierName new =:: mut: idName
    relSpace NAMESPACE_ID_NONE != if
      while
        context .identifierNames idName map.get idLabel?@ =
        idLabel? optional.hasData and
            idLabel? .data idLabel@ =
            checkVisible ! or idName .scope GLOBAL_SCOPE != or
            idLabel .labelId context isVisible if
          matches optional.isEmpty if
            idName idLabel false return
          end
          matches .data []
            idName idLabel IdentifierMatch new list.append
          matches .data []=
        end
        idName .scope GLOBAL_SCOPE !=
      do
        context [] .scopes
          idName .scope getScopeData [] .parentScope
        idName@ .scope=
      end
    end
    scopeId =:: mut: firstNonProcScope
    scopeId GLOBAL_SCOPE != =:: mut: searchingNonProc
    ## search first non-proc scope containing current scope
    while
      searchingNonProc
    do
      context [] .scopes firstNonProcScope getScopeData =:: scopeData
      scopeData [] .currentProc NO_PROC == if
        break
      end
      scopeData [] .parentScope firstNonProcScope@ =
    end
    ## 2. search global variable in parent namespaces
    while
      context [] .typeContext .labelContext .namespaces mNamespace i64 cast list.get .parent mNamespace@ =
      mNamespace NAMESPACE_ID_NONE !=
    do
      mNamespace path  context .typeContext .labelContext findNamespace relSpace@ =
      relSpace idName@ .namespace=
      relSpace NAMESPACE_ID_NONE == if
        continue
      end
      ## search all scopes outside procedure
      firstNonProcScope idName@ .scope=
      while
        context .identifierNames idName map.get idLabel?@ =
        idLabel? optional.hasData and
            idLabel? .data idLabel@ =
            checkVisible ! or idName .scope GLOBAL_SCOPE != or
            idLabel .labelId context isVisible if
          matches optional.isEmpty if
            idName idLabel false return
          end
          matches .data []
            idName idLabel IdentifierMatch new list.append
          matches .data []=
        end
        idName .scope GLOBAL_SCOPE !=
      do
        context [] .scopes
          idName .scope getScopeData [] .parentScope
        idName@ .scope=
      end
    end
    ## 3. search imports
    false =:: mut: multiMatch
    NameId optional.empty =:: mut: match
    context [] .typeContext .labelContext .namespaceInfo .imports while
      $ NAMESPACE_IMPORT_NONE !=
    do =:: importId
      context [] .typeContext .labelContext .namespaceImports
        importId i64 cast
      list.at .data =:: importInfo
      importInfo [] .nameAlias .length 0 == if
        importInfo [] .imported path  context .typeContext .labelContext findNamespace relSpace@ =
      else
        importInfo [] .nameAlias =:: nameAlias
        path nameAlias string.startsWith ! or path .length nameAlias .length > and
            path nameAlias .length string.charAt '.' != if
          ## top namespace is not <nameAlias>
          continue
        end
        importInfo [] .imported
          path nameAlias .length 1 + string.tail
        context .typeContext .labelContext findNamespace relSpace@ =
      end
      relSpace idName@ .namespace=
      relSpace NAMESPACE_ID_NONE == if
        continue
      end
      ## search all scopes outside procedure
      firstNonProcScope idName@ .scope=
      while
        context .identifierNames idName map.get idLabel?@ =
        idLabel? optional.hasData and
            idLabel? .data idLabel@ =
            checkVisible ! or idName .scope GLOBAL_SCOPE != or
            idLabel .labelId context isVisible if
          matches optional.hasData if
            matches .data []
              idName idLabel IdentifierMatch new list.append
            matches .data []=
          end
          mNamespace NAMESPACE_ID_NONE == if
            idLabel optional.wrap match@ =
            importInfo [] .imported mNamespace@ =
          else
            true multiMatch@ =
          end
        end
        idName .scope GLOBAL_SCOPE !=
      do
        context [] .scopes
          idName .scope getScopeData [] .parentScope
        idName@ .scope=
      end
    finally importInfo [] .parent end ..drop
    matches optional.isEmpty and match optional.hasData if
      ## TODO return value indicating multi-match
      idName match .data false return
    end
    "could not find identifier":s NAMESPACE_ID_NONE scopeId IdentifierName new
    id.LABEL_ID_NONE id.NO_ALIAS NameId new true return
  end

  proc( LabelId : nameId IdentifierContext ptr.mut : context -> IdentifierData ptr.mut bool ) =>: export: getIdentifier
    nameId LABEL_ID_TMP == if
      ID_TMP_DATA@ false return
    end
    context .identifierData
      nameId
    map.at =:: data?
    data? optional.isEmpty if
      ID_TMP_DATA@ true return
    end
    data? .data false return
  end
  proc(
    LabelId : nameId
    IdentifierContext ptr.mut : context
  -> IdentifierData ptr.mut bool ) =>: export: findIdentifierByLabel
    ## searchIdentifier
      nameId context .typeContext  .labelContext id.getLabelName
      true
      context
      IdentifierMatch list ptr.mut optional.empty
    searchIdentifier =:: isError .labelId =:: label ..drop
    label context getIdentifier isError | return
  end
  ## unlike `findIdentifierByLabel` this procedure also find invisible identifiers
  proc(
    LabelId : nameId
    IdentifierContext ptr.mut : context
  -> IdentifierData ptr.mut bool ) =>: export: findDeclaredIdentifierByLabel
    ## searchIdentifier
      nameId context .typeContext  .labelContext id.getLabelName
      false
      context
      IdentifierMatch list ptr.mut optional.empty
    searchIdentifier =:: isError .labelId =:: label ..drop
    label context getIdentifier isError | return
  end
  proc(
    string : name
    IdentifierContext ptr.mut : context
  -> NameId bool ) =>: findIdByName
    name .length 0 > "name is non-empty" assert
    ## searchIdentifier
      name
      true
      context
      IdentifierMatch list ptr.mut optional.empty
    searchIdentifier =:: isError =:: nameData =:: idName
    nameData isError return
  end
  proc(
    string : name
    IdentifierContext ptr.mut : context
  -> IdentifierData ptr.mut bool ) =>: export: findIdentifierByName ## TODO? change return value to optional
    name .length 0 > "name is non-empty" assert
    ## searchIdentifier
      name
      true
      context
      IdentifierMatch list ptr.mut optional.empty
    searchIdentifier =:: isError .labelId =:: label =:: idName
    label context getIdentifier isError | return
  end
  enum( BUILT_IN NAMESPACE PROCEDURE VARIABLE LABEL ) =:: export: NameContext
  proc( IdentifierType : idType -> NameContext ) =>: idTypeAsNameContext
    idType .PROCEDURE ?? or idType .PROCEDURE_BUNDLE ?? if
      NameContext .PROCEDURE
    else idType .LABEL ?? _if
      NameContext .LABEL
    else
      NameContext .VARIABLE
    end
  end
  proc(
    string : id
    NameContext : context
    FilePosition : pos
    CompilerError list ptr.mut : errors
  -> bool ) =>: export: checkIdentifier
    id .length 0 == if
      "identifier names have to be non-empty" sb.copyPtr pos errors appendError
      true return
    end
    context .BUILT_IN ?? if
      false return
    end
    id 0 string.charAt '#' == if
      "identifier names cannot start with '#'" sb.copyPtr pos errors appendError
      true return
    end
    id ':' string.contains and context .PROCEDURE ?? ! or id 1 string.tail ':' string.contains if
      "identifier names cannot contain ':'" sb.copyPtr pos errors appendError
      true return
    end
    context .NAMESPACE ?? if
      false return
    end
    id '.' string.contains if
      "identifier names cannot contain '.'" sb.copyPtr pos errors appendError
      true return
    end
    id id .length 1 - string.charAt '@' == if
      "identifier names cannot end with '@'" sb.copyPtr pos errors appendError
      true return
    end
    id 0 string.charAt '$' == or id ">$":s string.startsWith if
      "identifier names cannot start with `$` or `>$`" sb.copyPtr pos errors appendError
      true return
    end
    context .PROCEDURE ?? if
      false return
    end
    id id .length 1 - string.charAt '=' == if
      "variable names cannot end with '='" sb.copyPtr pos errors appendError
      true return
    end
    false return
  end
  proc( AliasId : aliasId IdentifierContext ptr : context -> FilePosition ) =>: export: getAliasPos
    context [] .aliasInfo aliasId i64 cast list.at .data [] .declaredAt
  end
  union(
    _ : OK
    NameId : REDECLARE
  ) =:: DeclareNameResult
  proc(
    LabelId : label
    string : name
    bool : isAlias
    IdentifierType : idType
    FilePosition : declaredAt
    IdentifierContext ptr.mut : context
    CompilerError list ptr.mut : errors
  -> DeclareNameResult ) =>: declareName
    context .typeContext =:: typeContext
    typeContext .labelContext =:: labelContext
    label labelContext labelFlags =:: flags
    isAlias ! and flags FLAG_EXPORT & ? and
        context [] .scopes
          context [] .currentScopeId
        getScopeData [] .currentProc NO_PROC == if
      ## exported identifier outside procedure -> global scope
      GLOBAL_SCOPE
    else
      context [] .currentScopeId
    end =:: scopeId
    name
      labelContext [] .namespaceInfo .current
    scopeId IdentifierName new =:: mut: idName
    context .identifierNames idName map.get =:: prevId?
    prevId? optional.hasData if
      prevId? .data DeclareNameResult .REDECLARE return
    end
    name context findIdByName ! if =:: shadowedName
      shadowedName .labelId labelContext id.labelFlags =:: shadowFlags
      flags FLAG_SHADOW & ? ! or shadowFlags id.FLAG_BUILT_IN & ? if
        shadowedName .labelId context getIdentifier
          ! "shadowedName exists" assert
        =:: shadowed
        ## allow shadoing for labels
        ## TODO? only allow shadowed labels in initializers
        isAlias or idType .LABEL ?? ! or shadowed [] .idType .LABEL ?? ! if
          isAlias if
            "declaration of alias \"" sb.copyPtr
          else
            "declaration of identifier \"" sb.copyPtr
          end
              name sb.appendStr
          shadowFlags id.FLAG_BUILT_IN & ? if
              "\" shadows built-in identifier" sb.appendS
            declaredAt errors appendError
          else shadowedName .aliasId NO_ALIAS == _if
              "\" shadows previous declaration ( at" sb.appendS
              shadowed [] .declaredAt sb.appendPos
              " )" sb.appendS
            declaredAt errors appendWarning
          else
              "\" shadows alias ( at" sb.appendS
              shadowedName .aliasId context getAliasPos sb.appendPos
              " )" sb.appendS
            declaredAt errors appendWarning
          end
        end
      end
    else ..drop end
    isAlias if
      context .aliasInfo [] .length AliasId cast
      context .aliasInfo []
        declaredAt AliasInfo new list.append
      context .aliasInfo=
    else
      id.NO_ALIAS
    end =:: aliasId
    context .identifierNames
      idName
      label aliasId NameId new
    map.put ..drop ## previous entry is always empty
    DeclareNameResult .OK return
  end
  proc(
    LabelId : label
    Type : valType
    IdentifierType : idType
    i32 : index
    ConstValue : constVal
    bool : isInit
    FilePosition : declaredAt
    FileId : currentFile
    IdentifierContext ptr.mut : context
    CompilerError list ptr.mut : errors
  ->  LabelId IdentifierData bool ) =>: export: declareIdentifier
    context .typeContext =:: typeContext
    typeContext .labelContext =:: labelContext
    label LABEL_ID_NONE == if
      "invalid label id" sb.copyPtr declaredAt errors appendError
      LABEL_ID_NONE ID_NONE_DATA true return
    end
    label labelContext labelFlags =:: flags
    flags FLAG_MUTABLE & ? if
      idType .TYPE ?? if
        "type definitions cannot be mutable" sb.copyPtr declaredAt errors appendError
        LABEL_ID_NONE ID_NONE_DATA true return
      end
      idType .PROCEDURE ?? if
        "procedures cannot be mutable" sb.copyPtr declaredAt errors appendError
        LABEL_ID_NONE ID_NONE_DATA true return
      end
      idType .ARGUMENT ??  if
        "procedure arguments cannot be mutable" sb.copyPtr declaredAt errors appendError
        LABEL_ID_NONE ID_NONE_DATA true return
      end
    end
    label labelContext id.getLabelName =:: name
    ## don't check names of built-in identifiers
    name
      flags FLAG_BUILT_IN & ? or flags FLAG_LAMBDA & ? if
        NameContext .BUILT_IN
      else
        idType idTypeAsNameContext
      end
    declaredAt errors checkIdentifier if
      LABEL_ID_NONE ID_NONE_DATA true return
    end
    label
      name
      false
      idType
      declaredAt
      context
      errors
    declareName $ .REDECLARE ?? if .REDECLARE =:: prevId
      context .identifierData prevId .labelId map.at .data =:: prevDec
      prevId .aliasId NO_ALIAS == and
          ## initialization for declaration / declaration for initialized identifier
          prevDec [] .declarationOnly isInit ! | and
          idType .GLOBAL_VAR ?? or idType .TYPE ?? or
          idType .PROCEDURE ?? or idType .PROCEDURE_BUNDLE ?? if
        ## remove procedure labels before comparing types
        valType typeContext types.asUnlabeledProc ..drop
            prevDec [] .valueType  typeContext types.asUnlabeledProc ..drop
            types.typeEquals ! if
          "incompatible types for declaration and initialization of \"" sb.copyPtr
            label labelContext sb.appendLabelPath
            "\":\n  * " sb.appendS
            prevDec [] .valueType typeContext sb.appendType
            " at " sb.appendS
            prevDec [] .declaredAt sb.appendPos
            "\n  * " sb.appendS
            valType typeContext sb.appendType
          declaredAt errors appendError
          LABEL_ID_NONE ID_NONE_DATA true return
        end
        prevDec [] .idType idType != if
          "declaration and initialization of \"" sb.copyPtr
            label labelContext sb.appendLabelPath
            "\" are not compatible expected: " sb.appendS
            prevDec [] .idType sb.appendIdType
            " ( declared at " sb.appendS
            prevDec [] .declaredAt sb.appendPos
            " )" sb.appendS
            " got: " sb.appendS
            idType sb.appendIdType
          declaredAt errors appendError
          LABEL_ID_NONE ID_NONE_DATA true return
        end
        prevDec [] .labelId labelContext labelFlags flags != if
          "flags for declaration and initialization of \"" sb.copyPtr
            label labelContext sb.appendLabelPath
            "\" differ: " sb.appendS
            ## TODO? print flags
            " ( declaration at " sb.appendS
            prevDec [] .declaredAt sb.appendPos
            " )" sb.appendS
          declaredAt errors appendWarning
        end
        isInit if
          valType prevDec .valueType=
          constVal prevDec .constValue=
          index prevDec .index=
          declaredAt prevDec .declaredAt=
          false prevDec .declarationOnly=
        end
        prevDec [] .labelId prevDec [] false return
      end
      prevId .aliasId NO_ALIAS == if
        prevDec [] .declaredAt
      else
        prevId .aliasId context getAliasPos
      end =:: prevPos
      "re declaration of identifier \"" sb.copyPtr
        label labelContext sb.appendLabelPath
        '\"' sb.appendC
      declaredAt errors appendWarning
      "previous declaration " sb.copyPtr prevPos errors appendInfo
      LABEL_ID_NONE ID_NONE_DATA true return
    end ..drop
    ## IdentifierData
      valType
      constVal
      declaredAt
      label
      index
      idType
      isInit !
    IdentifierData new =:: idData
    context .identifierData
      label
      idData
    map.put ..drop ## previous entry is always empty
    label idData false return
  end
  proc(
    LabelId : srcId
    string : newName
    IdentifierType : idType
    FilePosition : declaredAt
    IdentifierContext ptr.mut : context
    CompilerError list ptr.mut : errors
  -> bool ) =>: export: declareNameAlias
    newName idType idTypeAsNameContext declaredAt errors checkIdentifier if
      true return
    end
    srcId
      newName
      true
      idType
      declaredAt
      context
      errors
    declareName $ .REDECLARE ?? if .REDECLARE =:: prevId
      prevId .aliasId NO_ALIAS == if
        context .identifierData prevId .labelId map.at .data [] .declaredAt
      else
        prevId .aliasId context getAliasPos
      end =:: prevPos
      "re declaration of identifier \"" sb.copyPtr
        newName sb.appendStr
        '\"' sb.appendC
      declaredAt errors appendWarning
      "previous declaration " sb.copyPtr prevPos errors appendInfo
      true return
    end ..drop
    false return
  end
  proc(
    FilePosition : pos
    FileId : currentFile
    IdentifierContext ptr.mut : context
  -> IdentifierInfo ) =>: export: newItrVar
    ## IdentifierInfo
      IdentifierType .ITR_VAR
      ## newLabel
        string.empty
        id.FLAG_ITR_VAR id.FLAG_MUTABLE | id.FLAG_BUILT_IN |
        pos
        currentFile
      context .typeContext .labelContext newLabel
    IdentifierInfo new =:: idInfo
    idInfo return
  end
end
namespace: sb
  proc( stringBuilder : sb IdentifierType : idType -> stringBuilder ) =>: export: appendIdType
    sb
    idType switch
      TYPE case
        "type" sb.appendS
        return
      PROCEDURE case
        "procedure" sb.appendS
        return
      PROCEDURE_BUNDLE case
        "procedure bundle" sb.appendS
        return
      GLOBAL_VAR case
        "global variable" sb.appendS
        return
      LABEL case
        "label " sb.appendS
        return
      LOCAL_VAR case
        "local variable" sb.appendS
        return
      ARGUMENT case
        "procedure argument" sb.appendS
        return
      TMP_VAR case
        "temporary variable" sb.appendS
        return
      ITR_VAR case
        "iterator variable" sb.appendS
        return
    end
  end
  proc( stringBuilder : sb IdentifierInfo : id LabelContext ptr : labelContext -> stringBuilder ) =>: export: appendIdInfo
    sb
      id .labelId labelContext id.labelFlags ..swap
        ..over id.FLAG_EXPORT & ? if
          "export: " sb.appendS
        end
        ..over id.FLAG_EXTERN & ? if
          "extern: " sb.appendS
        end
        ..over id.FLAG_MUTABLE & ? if
          "mutable: " sb.appendS
        end
        ..over id.FLAG_STATIC & ? if
          "static: " sb.appendS
        end
      ..swap ..drop
      ## TODO print namespace
      id .idType switch
        TYPE case
          "type \"" sb.appendS
          id .labelId labelContext sb.appendLabelPath
          "\"" sb.appendS
          return
        PROCEDURE case
          "procedure \"" sb.appendS
          id .labelId labelContext sb.appendLabelPath
          "\"" sb.appendS
          return
        PROCEDURE_BUNDLE case
          "procedure bundle  \"" sb.appendS
          id .labelId labelContext sb.appendLabelPath
          "\"" sb.appendS
          return
        GLOBAL_VAR case
          "global variable \"" sb.appendS
          id .labelId labelContext sb.appendLabelPath
          "\"" sb.appendS
          return
        LABEL case
          "label \"" sb.appendS
          id .labelId labelContext sb.appendLabelName
          "\"" sb.appendS
          return
        LOCAL_VAR case
          "local variable: \"" sb.appendS
          id .labelId labelContext sb.appendLabelName
          "\"" sb.appendS
          return
        ARGUMENT case
          "procedure argument \"" sb.appendS
          id .labelId labelContext sb.appendLabelName
          "\"" sb.appendS
          return
        TMP_VAR case
          "temporary variable \"" sb.appendS
          id .labelId labelContext sb.appendLabelName
          "\"" sb.appendS
          return
        ITR_VAR case
          "iterator variable (" sb.appendS
          id .labelId i64 cast sb.appendI
          ")" sb.appendS
          return
      end
  end
end
namespace: id
  proc( LabelId : name IdentifierContext ptr.mut : context -> ) =>: export: beginNamespace
    context [] .prevNamespaces
      context [] .typeContext  .labelContext .namespaceInfo list.append
    context .prevNamespaces=
    context [] .typeContext  .labelContext .namespaceInfo .current
      name context .typeContext  .labelContext id.getLabelName
        true
      context .typeContext  .labelContext childId
    context .typeContext  .labelContext .namespaceInfo .current=
  end
  proc(
    LabelId : name
    string : nameAlias
    IdentifierContext ptr.mut : context
  -> bool ) =>: export: importNamespace
    0 NamespaceId cast
      name context .typeContext  .labelContext id.getLabelName
    context .typeContext  .labelContext findNamespace
      $ NAMESPACE_ID_NONE == if ..drop
        true return
      end
    =:: importId
    context [] .typeContext  .labelContext .namespaceInfo .imports
      importId nameAlias context .typeContext  .labelContext getNamespaceImportId
    context .typeContext  .labelContext .namespaceInfo .imports=
    false return
  end
  proc(
    string : usedName string : nameAlias
    IdentifierContext ptr.mut : idContext
    FilePosition : pos
    CompilerError list ptr.mut : errors
  -> bool ) =>: export: importIdentifier
    idContext .typeContext .labelContext =:: labelContext
    usedName idContext id.findIdentifierByName if ..drop
     "identifier \"" sb.copyPtr
        usedName sb.appendStr
      "\" does not exist in the current scope" sb.appendS pos errors appendError
     true return
    end =:: target
      target [] .labelId
      nameAlias .length 0 > if
        nameAlias
      else
        target [] .labelId labelContext id.getLabelName
          $ '.' string.lastIndexOf
        string.tail
      end
      target [] .idType
      pos
      idContext
      errors
    id.declareNameAlias ..drop
    false return
  end
  proc( IdentifierContext ptr.mut : context -> bool ) =>: export: endNamespace
    context [] .prevNamespaces .length 0 == if
      true return
    end
    context [] .prevNamespaces
      list.pop context .typeContext  .labelContext .namespaceInfo=
    context .prevNamespaces=
    false
  end
  proc(
    FileId : fileId
    ScopeId : fileScopeId
    IdentifierContext ptr.mut : context
  -> ) =>: export: importFile
    fileId FILE_ID_NONE == or fileId FILE_ID_BUILT_IN == if
      return
    end
    context [] .scopes context [] .currentScopeId getScopeData =:: currentScopeData
    ## check if already imported
    currentScopeData [] .visibleFiles while $ NO_IMPORTS != do =:: id
      context [] .visibleFiles id i64 cast list.get =:: importInfo
      importInfo .fileId fileId == if
        return
      end
    finally importInfo .prev end ..drop
    context [] .visibleFiles
      $ .length =:: newId
      ## ImportInfo
        fileId
        currentScopeData [] .visibleFiles
      ImportInfo new list.append
    context .visibleFiles=
    newId ImportId cast currentScopeData .visibleFiles=
    ## imports imports of import
    fileScopeId NO_SCOPE != if
      context [] .scopes fileScopeId getScopeData =:: fileScope
      fileScope [] .visibleFiles while $ NO_IMPORTS != do =:: id
        context [] .visibleFiles id i64 cast list.get =:: importInfo
        importInfo .fileId NO_SCOPE context importFile
      finally importInfo .prev end ..drop
    end
  end
end
