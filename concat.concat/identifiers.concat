import string
import stringBuilder
import map
import optional
using std.literals.

import "constants.concat"
import "types.concat"
import "labels.concat"
import "codeBlocks.concat"
import "common.concat"

enum(
  TYPE
  PROCEDURE
  PROCEDURE_BUNDLE
  GLOBAL_VAR
  LABEL
  LOCAL_VAR
  ARGUMENT
  TMP_VAR
  ITR_VAR
) =:: export: IdentifierType

struct(
  Type : mut: valueType
  ConstValue : mut: constValue
  FilePosition : mut: declaredAt
  LabelId : labelId
  i32 : mut: index
  IdentifierType : idType
  bool : mut: declarationOnly
) =:: IdentifierData
struct(
  IdentifierType : idType
  LabelId : labelId
) =:: export: IdentifierInfo

namespace: id
  i32 =:: export: AliasId
  -1:AliasId =:: export: NO_ALIAS
  struct(
    FilePosition : declaredAt
  ) =:: AliasInfo
  struct(
    string : name
    NamespaceId : mut: namespace
    FileId : fileId
  ) =:: IdentifierName
  struct(
    LabelId : labelId
    AliasId : aliasId
  ) =:: export: NameId
  struct(
    IdentifierName : name
    NameId : nameData
  ) =:: export: IdentifierMatch
  ## IdentifierName
    "" 0 string new
    NAMESPACE_ID_NONE
    FILE_ID_NONE
  IdentifierName new =:: ID_NONE
  ## IdentifierData
    Type .undefined
    ConstValue .None
    "" 0 string new
    0 0 FilePosition new
    LABEL_ID_NONE
    -1
    IdentifierType .GLOBAL_VAR
    false
  IdentifierData new =:: ID_NONE_DATA
  ## IdentifierData
    Type .undefined
    ConstValue .None
    "" 0 string new
    0 0 FilePosition new
    LABEL_ID_NONE
    -1
    IdentifierType .GLOBAL_VAR
    false
  IdentifierData new =:: mut: ID_TMP_DATA
  -2:LabelId =:: LABEL_ID_TMP

  proc( IdentifierName : a -> i32 ) =>: idHash
    a .name string.hash 31 * a .namespace i32 cast + 31 * a .fileId i32 cast + return
  end
  proc( IdentifierName : a IdentifierName : b -> bool ) =>: idEq
    a .fileId b .fileId != a .namespace b .namespace != | if
      false return
    end
    a .name b .name string.eq return
  end

  1 =:: export: SCOPE_FLAG_NO_CONST_FOLD
  struct(
    IdentifierName NameId hashMap : mut: identifierNames
    NamespaceImportId : prevImports
    ProcId : currentProc
    bool : isProcScope
    bool : experimental
  ) =:: Scope

  proc( bool : isProc ProcId : procId bool : experimental NamespaceImportId : imports -> Scope ) =>: newScope
     ## Scope
      idHash@ idEq@ 128 NameId map.create
      imports
      procId
      isProc
      experimental
    Scope new return
  end
end
  struct(
    TypeContext : mut: typeContext
    ConstantContext : mut: constContext
    id.Scope : mut: globalScope
    id.Scope list : mut: openScopes
    LabelId IdentifierData hashMap : mut: identifierData
    ConstValue list : mut: argBuffer
    types.ArraySize list : mut: arraySizeBuffer
    NamespaceInfo list : mut: prevNamespaces
    id.AliasInfo list : mut: aliasInfo
  ) =:: export: IdentifierContext
namespace: id

  proc( -> IdentifierContext ) =>: export: newIdentifierContext
    types.newTypeContext
    newConstContext
    false -1:ProcId false NAMESPACE_IMPORT_NONE newScope
    128 Scope list.create
    labelHash@ labelEq@ 128 IdentifierData map.create
    32  ConstValue      list.create
    128 types.ArraySize list.create
    32  NamespaceInfo   list.create
    32  AliasInfo       list.create
    IdentifierContext new return
  end
  ## XXX? free IdentifierContext

  proc( IdentifierData ptr : idData -> IdentifierInfo ) =>: export: asIdInfo
    idData [] .idType
    idData [] .labelId
    IdentifierInfo new return
  end

  proc( IdentifierContext ptr.mut : context -> bool ) =>: isTopLevel
    context [] .openScopes .length 0 == return
  end
  proc( ProcId : procId bool : experimental IdentifierContext ptr.mut : context -> ) =>: export: openProcScope
    context [] .openScopes
      ## newScope
        true
        procId
        experimental
        context [] .typeContext .labelContext .namespaceInfo .imports
      newScope list.append
    context .openScopes=
  end
  proc( IdentifierContext ptr.mut : context -> ) =>: export: openScope
    context [] .openScopes .length 0 == if
      -1:ProcId false
    else
      context [] .openScopes list.peek .data ..dup [] .currentProc ..swap [] .experimental
    end =:: experimental =:: currentProc
    context [] .openScopes
       false currentProc experimental context [] .typeContext .labelContext .namespaceInfo .imports newScope
       list.append
    context .openScopes=
  end
  proc( IdentifierContext ptr.mut : context -> ProcId bool ) =>: export: currentScopeProc
    context [] .openScopes .length 0 == if
      -1:ProcId false return
    end
    context [] .openScopes list.peek .data ..dup [] .currentProc ..swap [] .experimental return
  end
  proc(
    IdentifierContext ptr.mut : context
  ->
    bool #+isError+#
  ) =>: export: closeScope
    context [] .openScopes .length 0 == if
      true return
    end
    context [] .openScopes
      list.pop =:: mut: closed
    context .openScopes=
    closed@ .identifierNames map.free
    closed .prevImports context .typeContext .labelContext .namespaceInfo .imports=
    false return
  end

  proc( string : id FileId : fileId IdentifierContext ptr.mut : context IdentifierMatch list ptr.mut optional : matches -> IdentifierName NameId bool ) =>: export: searchIdentifier
    context [] .typeContext .labelContext .namespaceInfo .current =:: mut: mNamespace
    NamespaceId : mut: relSpace
    mNamespace NAMESPACE_ID_NONE == if
      "invalid current namespace id":s NAMESPACE_ID_NONE fileId IdentifierName new
      id.LABEL_ID_NONE id.NO_ALIAS NameId new true return
    end
    id 0 string.charAt '.' == if
      id .length 2 >= and id 1 string.charAt '.' == if
        id string.empty
      else
        "identifiers cannot start with .":s NAMESPACE_ID_NONE fileId IdentifierName new
        id.LABEL_ID_NONE id.NO_ALIAS NameId new true return
      end
    else
      id '.' string.splitLast
    end =:: path =:: name
    NameId optional : idLabel?
    NameId : idLabel
    ## 1. search in local scopes
    mNamespace path  context .typeContext .labelContext findNamespace relSpace@ =
    name relSpace fileId IdentifierName new =:: mut: idName
    relSpace NAMESPACE_ID_NONE != if
      context [] .openScopes .length 1 -
      while ..dup 0 >= do =:: i
        context [] .openScopes
          i list.at .data
        .identifierNames idName map.get idLabel?@ =
        idLabel? optional.hasData if
          idLabel? .data idLabel@ =
          matches optional.isEmpty if
            idName idLabel false return
          end
          matches .data []
            idName idLabel IdentifierMatch new list.append
          matches .data []=
        end
        i 1 -
      end ..drop
    end
    ## 2. search global variable in current&parent namespaces
    name relSpace FILE_ID_NONE IdentifierName new =:: mut: globalName
    while mNamespace NAMESPACE_ID_NONE != do
      mNamespace path  context .typeContext .labelContext findNamespace relSpace@ =
      relSpace idName@ .namespace=
      relSpace globalName@ .namespace=
      relSpace NAMESPACE_ID_NONE != if
        context .globalScope .identifierNames
          idName
        map.get idLabel?@ =
        idLabel? optional.hasData if
          idLabel? .data idLabel@ =
          matches optional.isEmpty if
            idName idLabel false return
          end
          matches .data []
            idName idLabel IdentifierMatch new list.append
          matches .data []=
        end
        context .globalScope .identifierNames
           globalName
        map.get idLabel?@ =
        idLabel? optional.hasData if
          idLabel? .data idLabel@ =
          matches optional.isEmpty if
            globalName idLabel false return
          end
          matches .data []
            globalName idLabel IdentifierMatch new list.append
          matches .data []=
        end
      end
      context [] .typeContext .labelContext .namespaces mNamespace i64 cast list.get .parent mNamespace@ =
    end
    ## 3. search imports
    false =:: mut: multiMatch
    NameId optional.empty =:: mut: match
    false =:: mut: matchGlobal
    context [] .typeContext .labelContext .namespaceInfo .imports while ..dup NAMESPACE_IMPORT_NONE != do
      context [] .typeContext .labelContext .namespaceImports ..swap i64 cast list.get
        ..dup .imported path  context .typeContext .labelContext findNamespace relSpace@ =
        relSpace idName@ .namespace=
        relSpace globalName@ .namespace=
        relSpace NAMESPACE_ID_NONE != if
          context .globalScope .identifierNames
            idName
          map.get idLabel?@ =
          idLabel? optional.hasData if
            idLabel? .data idLabel@ =
            matches optional.hasData if
              matches .data []
                idName idLabel IdentifierMatch new list.append
              matches .data []=
            end
            mNamespace NAMESPACE_ID_NONE == if
              idLabel optional.wrap match@ =
              false matchGlobal@ =
              ..dup .imported mNamespace@ =
            else
              true multiMatch@ =
            end
          end
          context .globalScope .identifierNames
            globalName
          map.get idLabel?@ =
          idLabel? optional.hasData if
            idLabel? .data idLabel@ =
            matches optional.hasData if
              matches .data []
                globalName idLabel IdentifierMatch new list.append
              matches .data []=
            end
            mNamespace NAMESPACE_ID_NONE == if
              idLabel optional.wrap match@ =
              true matchGlobal@ =
              ..dup .imported mNamespace@ =
            else
              true multiMatch@ =
            end
          end
        end
     .parent
    end ..drop
    matches optional.isEmpty match optional.hasData & if ## TODO return value indicating multi-match
      matchGlobal if globalName else idName end match .data false return
    end
    "could not find identifier":s NAMESPACE_ID_NONE fileId IdentifierName new
    id.LABEL_ID_NONE id.NO_ALIAS NameId new true return
  end

  proc( LabelId : nameId IdentifierContext ptr.mut : context -> IdentifierData ptr.mut bool ) =>: export: getIdentifier
    nameId LABEL_ID_TMP == if
      ID_TMP_DATA@ false return
    end
    context .identifierData
      nameId
    map.at =:: data?
    data? optional.isEmpty if
      ID_TMP_DATA@ true return
    end
    data? .data false return
  end
  proc(
    LabelId : nameId
    FileId : fileId
    IdentifierContext ptr.mut : context
  -> IdentifierData ptr.mut bool ) =>: export: findIdentifierByLabel
    ## searchIdentifier
      nameId context .typeContext  .labelContext id.getLabelName
      fileId
      context
      IdentifierMatch list ptr.mut optional.empty
    searchIdentifier =:: isError .labelId =:: label ..drop
    label context getIdentifier isError | return
  end
  proc(
    string : name
    FileId : fileId
    IdentifierContext ptr.mut : context
  -> NameId bool ) =>: findIdByName
    name .length 0 > "name is non-empty" assert
    ## searchIdentifier
      name
      fileId
      context
      IdentifierMatch list ptr.mut optional.empty
    searchIdentifier =:: isError =:: nameData =:: idName
    nameData isError return
  end
  proc(
    string : name
    FileId : fileId
    IdentifierContext ptr.mut : context
  -> IdentifierData ptr.mut bool ) =>: export: findIdentifierByName ## TODO? change return value to optional
    name .length 0 > "name is non-empty" assert
    ## searchIdentifier
      name
      fileId
      context
      IdentifierMatch list ptr.mut optional.empty
    searchIdentifier =:: isError .labelId =:: label =:: idName
    label context getIdentifier isError | return
  end
  enum( BUILT_IN NAMESPACE PROCEDURE VARIABLE LABEL ) =:: export: NameContext
  proc(
    string : id
    NameContext : context
    FilePosition : pos
    CompilerError list ptr.mut : errors
  -> bool ) =>: export: checkIdentifier
    id .length 0 == if
      "identifier names have to be non-empty" sb.copyPtr pos errors appendError
      true return
    end
    context .BUILT_IN ?? if
      false return
    end
    id 0 string.charAt '#' == if
      "identifier names cannot start with '#'" sb.copyPtr pos errors appendError
      true return
    end
    id ':' string.contains if
      "identifier names cannot contain ':'" sb.copyPtr pos errors appendError
      true return
    end
    context .NAMESPACE ?? if
      false return
    end
    id '.' string.contains if
      "identifier names cannot contain '.'" sb.copyPtr pos errors appendError
      true return
    end
    id id .length 1 - string.charAt '@' == if
      "identifier names cannot end with '@'" sb.copyPtr pos errors appendError
      true return
    end
    id 0 string.charAt '$' == or id ">$":s string.startsWith if
      "identifier names cannot start with `$` or `>$`" sb.copyPtr pos errors appendError
      true return
    end
    context .PROCEDURE ?? if
      false return
    end
    id id .length 1 - string.charAt '=' == if
      "variable names cannot end with '='" sb.copyPtr pos errors appendError
      true return
    end
    false return
  end
  proc( AliasId : aliasId IdentifierContext ptr : context -> FilePosition ) =>: export: getAliasPos
    context [] .aliasInfo aliasId i64 cast list.at .data [] .declaredAt
  end
  union(
    _ : OK
    NameId : REDECLARE
  ) =:: DeclareNameResult
  proc(
    LabelId : label
    string : name
    bool : isAlias
    IdentifierType : idType
    FilePosition : declaredAt
    FileId : currentFile
    IdentifierContext ptr.mut : context
    CompilerError list ptr.mut : errors
  -> DeclareNameResult ) =>: declareName
    context .typeContext =:: typeContext
    typeContext .labelContext =:: labelContext
    label labelContext labelFlags =:: flags
    isAlias ! and context id.isTopLevel flags FLAG_EXPORT & ? & if
      ## exported global -> ignore fileId
      FILE_ID_NONE
    else
      currentFile
    end =:: fileId
    context [] .openScopes .length 0 > if
      context [] .openScopes ..dup .length 1 - list.at .data
    else
      context .globalScope
    end =:: mScope
    name
      labelContext [] .namespaceInfo .current
    fileId IdentifierName new =:: mut: idName
    mScope .identifierNames idName map.get =:: prevId?
    prevId? optional.hasData if
      prevId? .data DeclareNameResult .REDECLARE return
    end
    flags FLAG_SHADDOW & ? ! if
      name fileId context findIdByName ! if =:: shaddowedName
        shaddowedName .labelId context getIdentifier
          ! "shaddowedName exists" assert
        =:: shaddowed
        ## allow shaddoing for labels
        ## TODO? only allow shaddowed labels in initializers
        isAlias or idType .LABEL ?? ! or shaddowed [] .idType .LABEL ?? ! if
          isAlias if
            "declaration of alias \"" sb.copyPtr
          else
            "declaration of identifier \"" sb.copyPtr
          end
            name sb.appendStr
            '\"' sb.appendC
          declaredAt errors appendWarning
          shaddowedName .aliasId NO_ALIAS == if
            "shadows previous declaration" sb.copyPtr
            shaddowed [] .declaredAt
          else
            "shadows alias" sb.copyPtr
            shaddowedName .aliasId context getAliasPos
          end
          errors appendInfo
        end
      else ..drop end
    end
    isAlias if
      context .aliasInfo [] .length AliasId cast
      context .aliasInfo []
        declaredAt AliasInfo new list.append
      context .aliasInfo=
    else
      id.NO_ALIAS
    end =:: aliasId
    mScope .identifierNames
      idName
      label aliasId NameId new
    map.put ..drop ## previous entry is always empty
    DeclareNameResult .OK return
  end
  proc(
    LabelId : label
    Type : valType
    IdentifierType : idType
    i32 : index
    ConstValue : constVal
    bool : isInit
    FilePosition : declaredAt
    FileId : currentFile
    IdentifierContext ptr.mut : context
    CompilerError list ptr.mut : errors
  ->  LabelId IdentifierData bool ) =>: export: declareIdentifier
    context .typeContext =:: typeContext
    typeContext .labelContext =:: labelContext
    label LABEL_ID_NONE == if
      "invalid label id" sb.copyPtr declaredAt errors appendError
      LABEL_ID_NONE ID_NONE_DATA true return
    end
    label labelContext labelFlags =:: flags
    flags FLAG_MUTABLE & ? if
      idType .TYPE ?? if
        "type definitions cannot be mutable" sb.copyPtr declaredAt errors appendError
        LABEL_ID_NONE ID_NONE_DATA true return
      end
      idType .PROCEDURE ?? if
        "procedures cannot be mutable" sb.copyPtr declaredAt errors appendError
        LABEL_ID_NONE ID_NONE_DATA true return
      end
      idType .ARGUMENT ??  if
        "procedure arguments cannot be mutable" sb.copyPtr declaredAt errors appendError
        LABEL_ID_NONE ID_NONE_DATA true return
      end
    end
    label labelContext id.getLabelName =:: name
    ## don't check names of built-in identifiers
    name
      flags FLAG_BUILT_IN & ? if
        NameContext .BUILT_IN
      else idType .PROCEDURE ?? or idType .PROCEDURE_BUNDLE ?? _if
        NameContext .PROCEDURE
      else idType .LABEL ?? _if
        NameContext .LABEL
      else
        NameContext .VARIABLE
      end
    declaredAt errors checkIdentifier if
      LABEL_ID_NONE ID_NONE_DATA true return
    end
    label
      name
      false
      idType
      declaredAt
      currentFile
      context
      errors
    declareName $ .REDECLARE ?? if .REDECLARE =:: prevId
      context .identifierData prevId .labelId map.at .data =:: prevDec
      prevId .aliasId NO_ALIAS == and
          ## initialization for declaration / declaration for initialized identifier
          prevDec [] .declarationOnly isInit ! | and
          idType .GLOBAL_VAR ?? or idType .TYPE ?? or
          idType .PROCEDURE ?? or idType .PROCEDURE_BUNDLE ?? if
        ## remove procedure labels before comparing types
        valType typeContext types.asUnlabeledProc ..drop
            prevDec [] .valueType  typeContext types.asUnlabeledProc ..drop
            types.typeEquals ! if
          "incompatible types for declaration and initialization of \"" sb.copyPtr
            label labelContext sb.appendLabelPath
            "\":\n  * " sb.appendS
            prevDec [] .valueType typeContext sb.appendType
            " at " sb.appendS
            prevDec [] .declaredAt sb.appendPos
            "\n  * " sb.appendS
            valType typeContext sb.appendType
          declaredAt errors appendError
          LABEL_ID_NONE ID_NONE_DATA true return
        end
        prevDec [] .idType idType != if
          "declaration and initialization of \"" sb.copyPtr
            label labelContext sb.appendLabelPath
            "\" are not compatible expected: " sb.appendS
            prevDec [] .idType sb.appendIdType
            " ( declared at " sb.appendS
            prevDec [] .declaredAt sb.appendPos
            " )" sb.appendS
            " got: " sb.appendS
            idType sb.appendIdType
          declaredAt errors appendError
          LABEL_ID_NONE ID_NONE_DATA true return
        end
        prevDec [] .labelId labelContext labelFlags flags != if
          "flags for declaration and initialization of \"" sb.copyPtr
            label labelContext sb.appendLabelPath
            "\" differ: " sb.appendS
            ## TODO? print flags
            " ( declaration at " sb.appendS
            prevDec [] .declaredAt sb.appendPos
            " )" sb.appendS
          declaredAt errors appendWarning
        end
        isInit if
          valType prevDec .valueType=
          constVal prevDec .constValue=
          index prevDec .index=
          declaredAt prevDec .declaredAt=
          false prevDec .declarationOnly=
        end
        prevDec [] .labelId prevDec [] false return
      end
      prevId .aliasId NO_ALIAS == if
        prevDec [] .declaredAt
      else
        prevId .aliasId context getAliasPos
      end =:: prevPos
      "re declaration of identifier \"" sb.copyPtr
        label labelContext sb.appendLabelPath
        '\"' sb.appendC
      declaredAt errors appendWarning
      "previous declaration " sb.copyPtr prevPos errors appendInfo
      LABEL_ID_NONE ID_NONE_DATA true return
    end ..drop
    ## IdentifierData
      valType
      constVal
      declaredAt
      label
      index
      idType
      isInit !
    IdentifierData new =:: idData
    context .identifierData
      label
      idData
    map.put ..drop ## previous entry is always empty
    label idData false return
  end
  proc(
    LabelId : srcId
    string : newName
    IdentifierType : idType
    FilePosition : declaredAt
    FileId : currentFile
    IdentifierContext ptr.mut : context
    CompilerError list ptr.mut : errors
  -> bool ) =>: export: declareNameAlias
    srcId
      newName
      true
      idType
      declaredAt
      currentFile
      context
      errors
    declareName $ .REDECLARE ?? if .REDECLARE =:: prevId
      prevId .aliasId NO_ALIAS == if
        context .identifierData prevId .labelId map.at .data [] .declaredAt
      else
        prevId .aliasId context getAliasPos
      end =:: prevPos
      "re declaration of identifier \"" sb.copyPtr
        newName sb.appendStr
        '\"' sb.appendC
      declaredAt errors appendWarning
      "previous declaration " sb.copyPtr prevPos errors appendInfo
      true return
    end ..drop
    false return
  end
  proc(
    FilePosition : pos
    FileId : currentFile
    IdentifierContext ptr.mut : context
  -> IdentifierInfo ) =>: export: newItrVar
    ## IdentifierInfo
      IdentifierType .ITR_VAR
      ## newLabel
        string.empty
        id.FLAG_ITR_VAR id.FLAG_MUTABLE | id.FLAG_BUILT_IN |
        pos
        currentFile
      context .typeContext .labelContext newLabel
    IdentifierInfo new =:: idInfo
    idInfo return
  end
end
namespace: sb
  proc( stringBuilder : sb IdentifierType : idType -> stringBuilder ) =>: export: appendIdType
    sb
    idType switch
      TYPE case
        "type" sb.appendS
        return
      PROCEDURE case
        "procedure" sb.appendS
        return
      PROCEDURE_BUNDLE case
        "procedure bundle" sb.appendS
        return
      GLOBAL_VAR case
        "global variable" sb.appendS
        return
      LABEL case
        "label " sb.appendS
        return
      LOCAL_VAR case
        "local variable" sb.appendS
        return
      ARGUMENT case
        "procedure argument" sb.appendS
        return
      TMP_VAR case
        "temporary variable" sb.appendS
        return
      ITR_VAR case
        "iterator variable" sb.appendS
        return
    end
  end
  proc( stringBuilder : sb IdentifierInfo : id LabelContext ptr : labelContext -> stringBuilder ) =>: export: appendIdInfo
    sb
      id .labelId labelContext id.labelFlags ..swap
        ..over id.FLAG_EXPORT & ? if
          "export: " sb.appendS
        end
        ..over id.FLAG_EXTERN & ? if
          "extern: " sb.appendS
        end
        ..over id.FLAG_MUTABLE & ? if
          "mutable: " sb.appendS
        end
        ..over id.FLAG_STATIC & ? if
          "static: " sb.appendS
        end
      ..swap ..drop
      ## TODO print namespace
      id .idType switch
        TYPE case
          "type \"" sb.appendS
          id .labelId labelContext sb.appendLabelPath
          "\"" sb.appendS
          return
        PROCEDURE case
          "procedure \"" sb.appendS
          id .labelId labelContext sb.appendLabelPath
          "\"" sb.appendS
          return
        PROCEDURE_BUNDLE case
          "procedure bundle  \"" sb.appendS
          id .labelId labelContext sb.appendLabelPath
          "\"" sb.appendS
          return
        GLOBAL_VAR case
          "global variable \"" sb.appendS
          id .labelId labelContext sb.appendLabelPath
          "\"" sb.appendS
          return
        LABEL case
          "label \"" sb.appendS
          id .labelId labelContext sb.appendLabelName
          "\"" sb.appendS
          return
        LOCAL_VAR case
          "local variable: \"" sb.appendS
          id .labelId labelContext sb.appendLabelName
          "\"" sb.appendS
          return
        ARGUMENT case
          "procedure argument \"" sb.appendS
          id .labelId labelContext sb.appendLabelName
          "\"" sb.appendS
          return
        TMP_VAR case
          "temporary variable \"" sb.appendS
          id .labelId labelContext sb.appendLabelName
          "\"" sb.appendS
          return
        ITR_VAR case
          "iterator variable (" sb.appendS
          id .labelId i64 cast sb.appendI
          ")" sb.appendS
          return
      end
  end
end
namespace: id
  proc( LabelId : name IdentifierContext ptr.mut : context -> ) =>: export: beginNamespace
    context [] .prevNamespaces
      context [] .typeContext  .labelContext .namespaceInfo list.append
    context .prevNamespaces=
    context [] .typeContext  .labelContext .namespaceInfo .current
      name context .typeContext  .labelContext id.getLabelName
        true
      context .typeContext  .labelContext childId
    context .typeContext  .labelContext .namespaceInfo .current=
  end
  proc( LabelId : name IdentifierContext ptr.mut : context -> bool ) =>: export: importNamespace
    0 NamespaceId cast
      name context .typeContext  .labelContext id.getLabelName
    context .typeContext  .labelContext findNamespace
    ..dup NAMESPACE_ID_NONE == if ..drop
      true return
    end
    context [] .typeContext  .labelContext .namespaceInfo .imports
      ..swap context .typeContext  .labelContext getNamespaceImportId
    context .typeContext  .labelContext .namespaceInfo .imports=
    false return
  end
  proc( IdentifierContext ptr.mut : context -> bool ) =>: export: endNamespace
    context [] .prevNamespaces .length 0 == if
      true return
    end
    context [] .prevNamespaces
      list.pop context .typeContext  .labelContext .namespaceInfo=
    context .prevNamespaces=
    false
  end
end

