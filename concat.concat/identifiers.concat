import stringBuilder
import map
import optional

import "constants.concat"
import "types.concat"
import "labels.concat"
import "codeBlocks.concat"
import "common.concat"

enum(
  TYPE
  PROCEDURE
  PROCEDURE_BUNDLE
  GLOBAL_VAR
  LABEL
  LOCAL_VAR
  ARGUMENT
  TMP_VAR
  ITR_VAR
) =:: export: IdentifierType

struct(
  Type : mut: valueType
  ConstValue : mut: constValue
  FilePosition : mut: declaredAt
  LabelId : labelId
  i32 : mut: id
  IdentifierType : idType
  bool : mut: declarationOnly
) =:: IdentifierData
struct(
  IdentifierType : idType
  LabelId : labelId
  ConstValue : constValue
  i32 : mut: id
) =:: export: IdentifierInfo

struct(
  string : name
  NamespaceId : mut: namespace
  FileId : fileId
) =:: IdentifierName
struct(
  IdentifierName : name
  LabelId : labelId
) =:: export: IdentifierMatch

namespace: id
  ## IdentifierName
    "" 0 string new
    NAMESPACE_ID_NONE
    FILE_ID_NONE
  IdentifierName new =:: ID_NONE
  ## IdentifierData
    Type .undefined
    ConstValue .none
    "" 0 string new
    0 0 FilePosition new
    LABEL_ID_NONE
    -1
    IdentifierType .GLOBAL_VAR
    false
  IdentifierData new =:: ID_NONE_DATA
  ## IdentifierData
    Type .undefined
    ConstValue .none
    "" 0 string new
    0 0 FilePosition new
    LABEL_ID_NONE
    -1
    IdentifierType .GLOBAL_VAR
    false
  IdentifierData new =:: mut: ID_TMP_DATA
  -2:LabelId =:: LABEL_ID_TMP

  proc( IdentifierName : a -> i32 ) =>: idHash
    a .name string.hash 31 * a .namespace i32 cast + 31 * a .fileId i32 cast + return
  end
  proc( IdentifierName : a IdentifierName : b -> bool ) =>: idEq
    a .fileId b .fileId != a .namespace b .namespace != | if
      false return
    end
    a .name b .name string.eq return
  end

  1 =:: export: SCOPE_FLAG_NO_CONST_FOLD
  struct(
    IdentifierName LabelId hashMap : mut: identifierNames
    char8 _ ptr mut list : mut: scopeStrings ## strings allocated for this scope
    bool : isProcScope
    Type : currentProc
    bool : experimental
    NamespaceImportId : prevImports
  ) =:: Scope

  proc( bool : isProc Type : procType bool : experimental NamespaceImportId : imports -> Scope ) =>: newScope
     ## Scope
      idHash @ idEq @ 128 LabelId map.create
      128 char8 _ ptr mut list.create
      isProc
      procType
      experimental
      imports
    Scope new return
  end
end
  struct(
    TypeContext : mut: typeContext
    ConstantContext : mut: constContext
    id.Scope : mut: globalScope
    id.Scope list : mut: openScopes
    LabelId IdentifierData hashMap : mut: identifierData
    ConstValue list : mut: argBuffer
    types.ArraySize list : mut: arraySizeBuffer
    stringBuilder : mut: nameBuffer
    NamespaceImportId list : mut: prevImports
    IdentifierInfo list : mut: itrVariables
    i32 : mut: localVarCount
  ) =:: export: IdentifierContext
namespace: id

  proc( -> IdentifierContext ) =>: export: newIdentifierContext
    types.newTypeContext
    newConstContext
    false Type .undefined false NAMESPACE_IMPORT_NONE newScope
    128 Scope list.create
    labelHash @ labelEq @ 128 IdentifierData map.create
    32  ConstValue        list.create
    128 types.ArraySize   list.create
    128                     sb.create
    32  NamespaceImportId list.create
    32 IdentifierInfo     list.create
    0
    IdentifierContext new =:: mut: newContext
    newContext return
  end
  ## XXX? free IdentifierContext

  proc( IdentifierData ptr : idData -> IdentifierInfo ) =>: export: asIdInfo
    idData [] .idType
    idData [] .labelId
    idData [] .constValue
    idData [] .id
    IdentifierInfo new return
  end

  proc( IdentifierContext ptr mut : context -> bool ) =>: isTopLevel
    context [] .openScopes .length 0 == return
  end
  proc( Type : procType bool : experimental IdentifierContext ptr mut : context -> ) =>: export: openProcScope
    context [] .openScopes
       ## newScope
         true
         procType
         experimental
         context [] .typeContext .labelContext .namespaceInfo .imports
       newScope list.append
    context [] .openScopes =
  end
  proc( IdentifierContext ptr mut : context -> ) =>: export: openScope
    context [] .openScopes .length 0 == if
      Type .undefined false
    else
      context [] .openScopes list.peek .data ..dup [] .currentProc ..swap [] .experimental
    end =:: experimental =:: currentProc
    context [] .openScopes
       false currentProc experimental context [] .typeContext .labelContext .namespaceInfo .imports newScope
       list.append
    context [] .openScopes =
  end
  proc( IdentifierContext ptr mut : context -> Type bool ) =>: export: currentScopeProc
    context [] .openScopes .length 0 == if
      Type .undefined false return
    end
    context [] .openScopes list.peek .data ..dup [] .currentProc ..swap [] .experimental return
  end
  proc( char8 _ ptr mut list -> char8 _ ptr mut list ) =>: freeScopeStrings
    0:i64 while ..dup ..over.2 .length < do
      ..over ..over list.get mem.free
      1 +
    end ..drop
    list.free
  end
  proc(
    IdentifierContext ptr mut : context
  ->
    bool #+isError+#
  ) =>: export: closeScope
    context [] .openScopes .length 0 == if
      true return
    end
    context [] .openScopes
      list.pop =:: mut: closed
    context [] .openScopes =
    closed .scopeStrings freeScopeStrings closed .scopeStrings =
    closed .identifierNames @ map.free
    closed .prevImports context [] .typeContext .labelContext .namespaceInfo .imports =
    closed .isProcScope if
      0 context [] .localVarCount = ## XXX handle nested procedures
    end
    false return
  end

  proc( string : id FileId : fileId IdentifierContext ptr mut : context IdentifierMatch list ptr mut optional : matches -> IdentifierName LabelId bool ) =>: export: searchIdentifier
    context [] .typeContext .labelContext .namespaceInfo .current =:: mut: mNamespace
    NamespaceId : mut: relSpace
    mNamespace NAMESPACE_ID_NONE == if
      "invalid current namespace id" string.wrap NAMESPACE_ID_NONE fileId IdentifierName new id.LABEL_ID_NONE true return
    end
    id 0 string.charAt '.' == if
      id .length 2 >= and id 1 string.charAt '.' == if
        id string.empty
      else
        "identifiers cannot start with ." string.wrap NAMESPACE_ID_NONE fileId IdentifierName new id.LABEL_ID_NONE true return
      end
    else
      id '.' string.splitLast
    end =:: path =:: name
    LabelId optional : idLabel?
    LabelId : idLabel
    ## 1. search in local scopes
    mNamespace path  context [] .typeContext .labelContext @ findNamespace relSpace =
    name relSpace fileId IdentifierName new =:: mut: idName
    relSpace NAMESPACE_ID_NONE != if
      context [] .openScopes .length 1 -
      while ..dup 0 >= do =:: i
        context [] .openScopes
          i list.at .data
        [] .identifierNames @ idName map.get idLabel? =
        idLabel? optional.hasData if
          idLabel? .data idLabel =
          matches optional.isEmpty if
            idName idLabel false return
          end
          matches .data []
            idName idLabel IdentifierMatch new list.append
          matches .data [] =
        end
        i 1 -
      end ..drop
    end
    ## 2. search global variable in current&parent namespaces
    name relSpace FILE_ID_NONE IdentifierName new =:: mut: globalName
    while mNamespace NAMESPACE_ID_NONE != do
      mNamespace path  context [] .typeContext .labelContext @ findNamespace relSpace =
      relSpace idName .namespace =
      relSpace globalName .namespace =
      relSpace NAMESPACE_ID_NONE != if
        context [] .globalScope .identifierNames @
          idName
        map.get idLabel? =
        idLabel? optional.hasData if
          idLabel? .data idLabel =
          matches optional.isEmpty if
            idName idLabel false return
          end
          matches .data []
            idName idLabel IdentifierMatch new list.append
          matches .data [] =
        end
        context [] .globalScope .identifierNames @
           globalName
        map.get idLabel? =
        idLabel? optional.hasData if
          idLabel? .data idLabel =
          matches optional.isEmpty if
            globalName idLabel false return
          end
          matches .data []
            globalName idLabel IdentifierMatch new list.append
          matches .data [] =
        end
      end
      context [] .typeContext .labelContext .namespaces mNamespace i64 cast list.get .parent mNamespace =
    end
    ## 3. search imports
    false =:: mut: multiMatch
    LabelId optional.empty =:: mut: match
    false =:: mut: matchGlobal
    context [] .typeContext .labelContext .namespaceInfo .imports while ..dup NAMESPACE_IMPORT_NONE != do
      context [] .typeContext .labelContext .namespaceImports ..swap i64 cast list.get
        ..dup .imported path  context [] .typeContext .labelContext @ findNamespace relSpace =
        relSpace idName .namespace =
        relSpace globalName .namespace =
        relSpace NAMESPACE_ID_NONE != if
          context [] .globalScope .identifierNames @
            idName
          map.get idLabel? =
          idLabel? optional.hasData if
            idLabel? .data idLabel =
            matches optional.hasData if
              matches .data []
                idName idLabel IdentifierMatch new list.append
              matches .data [] =
            end
            mNamespace NAMESPACE_ID_NONE == if
              idLabel optional.wrap match =
              false matchGlobal =
              ..dup .imported mNamespace =
            else
              true multiMatch =
            end
          end
          context [] .globalScope .identifierNames @
            globalName
          map.get idLabel? =
          idLabel? optional.hasData if
            idLabel? .data idLabel =
            matches optional.hasData if
              matches .data []
                globalName idLabel IdentifierMatch new list.append
              matches .data [] =
            end
            mNamespace NAMESPACE_ID_NONE == if
              idLabel optional.wrap match =
              true matchGlobal =
              ..dup .imported mNamespace =
            else
              true multiMatch =
            end
          end
        end
     .parent
    end ..drop
    matches optional.isEmpty match optional.hasData & if ## TODO return value indicating multi-match
      matchGlobal if globalName else idName end match .data false return
    end
    "could not find identifier" string.wrap NAMESPACE_ID_NONE fileId IdentifierName new id.LABEL_ID_NONE true return
  end

  proc( LabelId : nameId IdentifierContext ptr mut : context -> IdentifierData ptr mut bool ) =>: export: getIdentifier
    nameId LABEL_ID_TMP == if
      ID_TMP_DATA @ false return
    end
    context [] .identifierData @
      nameId
    map.at =:: data?
    data? optional.isEmpty if
      ID_TMP_DATA @ true return
    end
    data? .data false return
  end
  proc(
    LabelId : nameId
    FileId : fileId
    IdentifierContext ptr mut : context
  -> IdentifierData ptr mut bool ) =>: export: findIdentifierByLabel
    context [] .nameBuffer
      ..dup .length 0 == assert "name buffer is empty"
      nameId context [] .typeContext  .labelContext @ sb.appendLabelName
    context [] .nameBuffer =
    context [] .nameBuffer sb.asStr =:: name
    ## searchIdentifier
      name
      fileId
      context
      IdentifierMatch list ptr mut optional.empty
    searchIdentifier =:: isError =:: label ..drop
    context [] .nameBuffer
      sb.clear
    context [] .nameBuffer =
    label context getIdentifier isError | return
  end
  proc(
    string : name
    FileId : fileId
    IdentifierContext ptr mut : context
  -> IdentifierData ptr mut bool ) =>: export: findIdentifierByName
    ## searchIdentifier
      name
      fileId
      context
      IdentifierMatch list ptr mut optional.empty
    searchIdentifier =:: isError =:: label =:: idName
    label context getIdentifier isError | return
  end
  proc( string : id FilePosition : pos CompilerError list ptr mut : errors -> bool ) =>: export: checkIdentifier
    id .length 0 == if
      "identifier names have to be non-empty" sb.wrap pos errors appendError
      true return
    end
    id 0 string.charAt '#' == if
      "identifier names cannot start with '#'" sb.wrap pos errors appendError
      true return
    end
    id id .length 1 - string.charAt '@' == if
      "identifier names cannot end with '@'" sb.wrap pos errors appendError
      true return
    end
    id 0 string.charAt '$' == or id "_$" string.wrap string.startsWith if
      "identifier names cannot start with `$` or `_$`" sb.wrap pos errors appendError
      true return
    end
    id '.' string.contains if
      "identifier names cannot contain '.'" sb.wrap pos errors appendError
      true return
    end
    id ':' string.contains if
      "identifier names cannot contain ':'" sb.wrap pos errors appendError
      true return
    end
    false return
  end
  proc(
    LabelId : label
    Type : valType
    IdentifierType : idType
    i32 : id
    ConstValue : constVal
    bool : isInit
    FilePosition : declaredAt
    FileId : currentFile
    IdentifierContext ptr mut : context
    CompilerError list ptr mut : errors
  ->  LabelId IdentifierData bool ) =>: export: declareIdentifier
    context [] .typeContext @ =:: typeContext
    typeContext [] .labelContext @ =:: labelContext
    label LABEL_ID_NONE == if
      "invalid label id" sb.wrap declaredAt errors appendError
      LABEL_ID_NONE ID_NONE_DATA true return
    end
    label labelContext labelFlags =:: flags
    context [] .nameBuffer
      ..dup .length 0 == assert "name buffer empty"
      label context [] .typeContext  .labelContext @ sb.appendLabelName
    context [] .nameBuffer =
    context [] .nameBuffer sb.asStr =:: name
    context id.isTopLevel flags FLAG_EXPORT & ? & if ## exported global -> ignore fileId
      FILE_ID_NONE
    else
      currentFile
    end =:: fileId
    flags FLAG_MUTABLE & ? if
      idType .TYPE ?? if
        context [] .nameBuffer sb.clear context [] .nameBuffer =
        "type definitions cannot be mutable" sb.wrap declaredAt errors appendError
        LABEL_ID_NONE ID_NONE_DATA true return
      end
      idType .PROCEDURE ?? if
        context [] .nameBuffer sb.clear context [] .nameBuffer =
        "procedures cannot be mutable" sb.wrap declaredAt errors appendError
        LABEL_ID_NONE ID_NONE_DATA true return
      end
      idType .ARGUMENT ??  if
        context [] .nameBuffer sb.clear context [] .nameBuffer =
        "procedure arguments cannot be mutable" sb.wrap declaredAt errors appendError
        LABEL_ID_NONE ID_NONE_DATA true return
      end
    end
    ## don't check names of built-in identifiers
    flags FLAG_BUILT_IN & ? ! and
        name declaredAt errors checkIdentifier if
      context [] .nameBuffer sb.clear context [] .nameBuffer =
      LABEL_ID_NONE ID_NONE_DATA true return
    end
    context [] .openScopes .length 0 > if
      context [] .openScopes ..dup .length 1 - list.at .data
    else
      context [] .globalScope @
    end =:: mScope
    0 sb.create label labelContext sb.appendLabelName ## ensure name allocation stays valid for whole lifetime of scope
      mScope [] .scopeStrings
        ..over .data list.append ## remember allocated string
      mScope [] .scopeStrings =
    sb.asStr
    
    labelContext [] .namespaceInfo .current fileId IdentifierName new =:: mut: idName
    mScope [] .identifierNames @ idName map.get =:: prevId?
    prevId? optional.hasData if
      prevId? .data =:: prevId
      context [] .identifierData @ prevId map.at .data =:: prevDec
      ## initialization for declaration / declaration for initialized identifier
      prevDec [] .declarationOnly isInit ! | and
          idType .GLOBAL_VAR ?? or idType .TYPE ?? or
          idType .PROCEDURE ?? or idType .PROCEDURE_BUNDLE ?? if
        ## remove procedure labels before comparing types
        valType typeContext types.asUnlabeledProc ..drop
            prevDec [] .valueType  typeContext types.asUnlabeledProc ..drop
            types.typeEquals ! if
          "incompatible types for declaration and initialization of \"" sb.wrap
            label labelContext sb.appendLabelName
            "\":\n  * " sb.appendS
            prevDec [] .valueType typeContext sb.appendType
            " at " sb.appendS
            prevDec [] .declaredAt sb.appendPos
            "\n  * " sb.appendS
            valType typeContext sb.appendType
          declaredAt errors appendError
          context [] .nameBuffer sb.clear context [] .nameBuffer =
          LABEL_ID_NONE ID_NONE_DATA true return
        end
        prevDec [] .idType idType != if
          "declaration and initialization of \"" sb.wrap
            label labelContext sb.appendLabelName
            "\" are not compatible expected: " sb.appendS
            prevDec [] .idType sb.appendIdType
            " ( declared at " sb.appendS
            prevDec [] .declaredAt sb.appendPos
            " )" sb.appendS
            " got: " sb.appendS
            idType sb.appendIdType
          declaredAt errors appendError
          context [] .nameBuffer sb.clear context [] .nameBuffer =
          LABEL_ID_NONE ID_NONE_DATA true return
        end
        prevDec [] .labelId labelContext labelFlags flags != if
          "flags for declaration and initialization of \"" sb.wrap
            label labelContext sb.appendLabelName
            "\" differ: " sb.appendS
            ## TODO? print flags
            " ( declaration at " sb.appendS
            prevDec [] .declaredAt sb.appendPos
            " )" sb.appendS
          declaredAt errors appendWarning
        end
        isInit if
          valType prevDec [] .valueType =
          constVal prevDec [] .constValue =
          id prevDec [] .id =
          declaredAt prevDec [] .declaredAt =
          false prevDec [] .declarationOnly =
        end
        context [] .nameBuffer sb.clear context [] .nameBuffer =
        prevDec [] .labelId prevDec [] false return
      end
      "re declaration of identifier \"" sb.wrap
        label labelContext sb.appendLabelName
        '\"' sb.appendC
      declaredAt errors appendWarning
      "previous declaration " sb.wrap prevDec [] .declaredAt errors appendInfo
      context [] .nameBuffer sb.clear context [] .nameBuffer =
      LABEL_ID_NONE ID_NONE_DATA true return
    end
    flags FLAG_SHADDOW & ? ! if
      name fileId context findIdentifierByName ! if
        "declaration of identifier \"" sb.wrap
          label labelContext sb.appendLabelName
          '\"' sb.appendC
        declaredAt errors appendWarning
        "shadows previous declaration " sb.wrap ..over [] .declaredAt errors appendInfo
      end ..drop
    end
    mScope [] .identifierNames @
      idName
      label
    map.put ..drop ## previous entry is always empty
    ## IdentifierData
      valType
      constVal
      declaredAt
      label
      id -1 == idType .LOCAL_VAR ?? & if
        context [] .localVarCount
          ..dup 1 + context [] .localVarCount =
      else
        id
      end
      idType
      isInit !
    IdentifierData new =:: idData
    context [] .identifierData @
      label
      idData
    map.put ..drop ## previous entry is always empty
    context [] .nameBuffer sb.clear context [] .nameBuffer =
    label idData false return
  end
  proc(
    FilePosition : pos
    FileId : currentFile
    IdentifierContext ptr mut : context
  -> IdentifierInfo ) =>: export: newItrVar
    ## IdentifierInfo
      IdentifierType .ITR_VAR
      ## newLabel
        "" string.wrap
        id.FLAG_ITR_VAR id.FLAG_MUTABLE | id.FLAG_BUILT_IN |
        pos
        currentFile
      context .typeContext .labelContext newLabel
      ConstValue .none
      context .itrVariables .length [] i32 cast
    IdentifierInfo new =:: idInfo
    context .itrVariables []
      idInfo list.append
    context .itrVariables [] =
    idInfo return
  end
  proc(
    IdentifierContext ptr mut : context
    i32 : id
  -> IdentifierInfo ) =>: export: getItrVar
    context .itrVariables [] id list.get return
  end
end
namespace: sb
  proc( stringBuilder : sb IdentifierType : idType -> stringBuilder ) =>: export: appendIdType
    sb
    idType switch
      TYPE case
        "type" sb.appendS
        return
      PROCEDURE case
        "procedure" sb.appendS
        return
      PROCEDURE_BUNDLE case
        "procedure bundle" sb.appendS
        return
      GLOBAL_VAR case
        "global variable" sb.appendS
        return
      LABEL case
        "label " sb.appendS
        return
      LOCAL_VAR case
        "local variable" sb.appendS
        return
      ARGUMENT case
        "procedure argument" sb.appendS
        return
      TMP_VAR case
        "temporary variable" sb.appendS
        return
      ITR_VAR case
        "iterator variable" sb.appendS
        return
    end
  end
  proc( stringBuilder : sb IdentifierInfo : id LabelContext ptr : labelContext -> stringBuilder ) =>: export: appendIdInfo
    sb
      id .labelId labelContext id.labelFlags ..swap
        ..over id.FLAG_EXPORT & ? if
          "export: " sb.appendS
        end
        ..over id.FLAG_EXTERN & ? if
          "extern: " sb.appendS
        end
        ..over id.FLAG_MUTABLE & ? if
          "mutable: " sb.appendS
        end
        ..over id.FLAG_STATIC & ? if
          "static: " sb.appendS
        end
      ..swap ..drop
      ## TODO print namespace
      id .idType switch
        TYPE case
          "type \"" sb.appendS
          id .labelId labelContext sb.appendLabelName
          "\"" sb.appendS
          return
        PROCEDURE case
          "procedure \"" sb.appendS
          id .labelId labelContext sb.appendLabelName
          "\"" sb.appendS
          return
        PROCEDURE_BUNDLE case
          "procedure bundle  \"" sb.appendS
          id .labelId labelContext sb.appendLabelName
          "\"" sb.appendS
          return
        GLOBAL_VAR case
          "global variable \"" sb.appendS
          id .labelId labelContext sb.appendLabelName
          "\"" sb.appendS
          return
        LABEL case
          "label \"" sb.appendS
          id .labelId labelContext sb.appendLabelName
          "\"" sb.appendS
          return
        LOCAL_VAR case
          "local variable (" sb.appendS
          id .id sb.appendI
          ") \"" sb.appendS
          id .labelId labelContext sb.appendLabelName
          "\"" sb.appendS
          return
        ARGUMENT case
          "procedure argument (" sb.appendS
          id .id sb.appendI
          ") \"" sb.appendS
          id .labelId labelContext sb.appendLabelName
          "\"" sb.appendS
          return
        TMP_VAR case
          "temporary variable (" sb.appendS
          id .id sb.appendI
          ") \"" sb.appendS
          id .labelId labelContext sb.appendLabelName
          "\"" sb.appendS
          return
        ITR_VAR case
          "iterator variable (" sb.appendS
          id .id sb.appendI
          ")" sb.appendS
          return
      end
  end
end
namespace: id
  proc( LabelId : name IdentifierContext ptr mut : context -> ) =>: export: beginNamespace
    context [] .prevImports
      context [] .typeContext  .labelContext .namespaceInfo .imports list.append
    context [] .prevImports =
    context [] .nameBuffer
       ..dup .length 0 == assert "name buffer empty"
       name context [] .typeContext  .labelContext @ sb.appendLabelName
    context [] .nameBuffer =
    context [] .nameBuffer sb.asStr =:: nameAsStr
    context [] .typeContext  .labelContext .namespaceInfo .current
      nameAsStr true context [] .typeContext  .labelContext @ childId
    context [] .typeContext  .labelContext .namespaceInfo .current =
    context [] .nameBuffer sb.clear context [] .nameBuffer =
  end
  proc( LabelId : name IdentifierContext ptr mut : context -> bool ) =>: export: importNamespace
    context [] .nameBuffer
       ..dup .length 0 == assert "name buffer empty"
       name context [] .typeContext  .labelContext @ sb.appendLabelName
    context [] .nameBuffer =
    context [] .nameBuffer sb.asStr =:: nameAsStr
    0 NamespaceId cast nameAsStr context [] .typeContext  .labelContext @ findNamespace
    context [] .nameBuffer sb.clear context [] .nameBuffer =
    ..dup NAMESPACE_ID_NONE == if ..drop
      true return
    end
    context [] .typeContext  .labelContext .namespaceInfo .imports
      ..swap context [] .typeContext  .labelContext @ getNamespaceImportId
    context [] .typeContext  .labelContext .namespaceInfo .imports =
    false return
  end
  proc( IdentifierContext ptr mut : context -> bool ) =>: export: endNamespace
    context [] .typeContext  .labelContext .namespaceInfo .current 0:NamespaceId == if
      true return
    end
    context [] .typeContext  .labelContext .namespaceInfo .current context [] .typeContext  .labelContext @ parentNamespace
    context [] .typeContext  .labelContext .namespaceInfo .current =
    context [] .prevImports
      list.pop ..swap
    context [] .prevImports =
    context [] .typeContext  .labelContext .namespaceInfo .imports =
    false
  end
end

