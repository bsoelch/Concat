## collection of basic declarations used by all compiler files
import stringBuilder
import list

"main" =:: export: MAIN_NAME ## name of main procedure

i32 =:: export: FileId
-1:FileId =:: export: FILE_ID_NONE
-2:FileId =:: export: FILE_ID_BUILT_IN

enum( ## XXX more precise names
  QBE
  SSA
) =:: export: BackEnd

struct( string : mut: fileName i64 : mut: line i64 : mut: posInLine ) =:: export: FilePosition
enum( ERROR WARNING INFO ) =:: export: ErrorType
struct( stringBuilder : message ErrorType : errType FilePosition : pos ) =:: export: CompilerError
proc( stringBuilder : message FilePosition : pos CompilerError list ptr mut : errors -> ) =>: export: appendError
  errors []
    message ErrorType .ERROR pos CompilerError new list.append
  errors [] =
end
proc( stringBuilder : message FilePosition : pos CompilerError list ptr mut : errors -> ) =>: export: appendWarning
  errors []
    message ErrorType .WARNING pos CompilerError new list.append
  errors [] =
end
proc( stringBuilder : message FilePosition : pos CompilerError list ptr mut : errors -> ) =>: export: appendInfo
  errors []
    message ErrorType .INFO pos CompilerError new list.append
  errors [] =
end

i32 =:: export: LabelId

proc( LabelId -> i32 ) =>: export: labelHash i32 cast end
proc( LabelId LabelId -> bool ) =>: export: labelEq == end

i32 =:: export: NamespaceId
i32 =:: export: NamespaceImportId
namespace: id
  -1:LabelId =:: export: LABEL_ID_NONE
  -1:NamespaceId =:: export: NAMESPACE_ID_NONE
  -1:NamespaceImportId =:: export: NAMESPACE_IMPORT_NONE
end

enum( STRUCT POINTER ) =:: export: CallingConvention
namespace: CallingConvention
  CallingConvention .POINTER =:: export: DEFAULT
end

type : export: BuiltIn

## declare Type and ConstValue to allow mutual inclusion of types.concat and constants.concat
type : export: Type
type : export: ConstValue
type : export: ConstantArray
type : export: ConstantContext


namespace: sb
  proc( stringBuilder string -> stringBuilder ) =>: export: appendAsciified
    =:: str
    0:i64 while ..dup str .length < do
      ..swap
        str ..over.2 string.charAt =:: c
        c '0' >= c '9' <= & if
          c sb.appendC
          ..swap 1 + continue
        end
        c 'A' >= c 'Z' <= & if
          c sb.appendC
          ..swap 1 + continue
        end
        c 'a' >= c 'z' <= & if
          c sb.appendC
          ..swap 1 + continue
        end
        c '_' == if
          "__" sb.appendS
          ..swap 1 + continue
        end
        c '.' == if
          "_d" sb.appendS
          ..swap 1 + continue
        end
        "_X" sb.appendS
        c i32 cast.u 0xff & 0x10 < if
          '0' sb.appendC
        end
        c i32 cast.u 0xff & sb.appendI
      ..swap 1 +
    end ..drop
  end
end
