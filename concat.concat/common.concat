## collection of basic declarations used by all compiler files
import list
import stringBuilder
import numbers
using std.literals.:s

"main":s =:: export: MAIN_NAME ## name of main procedure

## XXX? seperate file for compiler flags
enum( ## XXX more precise names
  QBE
  ASM
) =:: export: BackEnd
## compiler flags
## XXX? wrap in namespace
..compiler.version
  ..compiler.flag.incrementVersionNumber if 1 + end
=:: export: _VERSION_ ## compiler version auto incremenets on each recompile
false =:: mut: export: _W_ERROR_
## options to enable/disable specific warnings
false =:: mut: export: _W_UNUSED_

false =:: mut: export: _EXPERIMENTAL_
true =:: mut: export: _INCLUDE_CORE_
true =:: mut: export: _INCREMENT_VERSION_
BackEnd .QBE =:: mut: export: _BACKEND_
## TODO make changable using compiler argument
false =:: mut: export: EXPORT_GLOBALS ## include all (non-library) exported procedures in binary
namespace: optimizerFlags
  true =:: export: mut: REMOVE_UNUSED_PROCS ## don't include unused procedures in compiled code
  false =:: export: mut: ALLOW_INLINE_SMALL
  false =:: export: mut: ALLOW_INLINE
  ## XXX! determine good constants
  ## XXX? make dependent on structure of code ? #ops - #args
  ## XXX? make dependent on level
  16 =:: export: mut: WEAK_INLINE_MAX_OP_COUNT ## always inlined (unless marked as inline.never)
  32 =:: export: mut: INLINE_MAX_OP_COUNT ## inlined if marked as inline

  ## diable all optimizations
  proc( -> ) =>: export: optLevel0
    false REMOVE_UNUSED_PROCS=
    false ALLOW_INLINE_SMALL=
    false ALLOW_INLINE=
  end
  ## minimal optimizations, for debug builds
  proc( -> ) =>: export: optLevelDefault
    true REMOVE_UNUSED_PROCS=
    false ALLOW_INLINE_SMALL= ## TODO allow inlining small procs once inline is stable
    false ALLOW_INLINE=
  end
  proc( -> ) =>: export: optLevel1
    true REMOVE_UNUSED_PROCS=
    true ALLOW_INLINE_SMALL=
    false ALLOW_INLINE= ## TODO endable inlining once inlining is stable
    ## true ALLOW_INLINE=
  end
  ## enable experimental optimizations
  proc( -> ) =>: export: optLevelExperimental
    optLevel1
    true ALLOW_INLINE=
  end
  ## TODO? more opt-leves
  ## ? optSave -> optimize but keep savety checks
  ## ? -> optimize, remove savety checks
  ## ? optSize -> optimize for size
end

i32 =:: export: FileId
( char8 ptr.raw iSize -> FileId ) : static: export: alias: :FileId ..builtIn.parse.i32
-1:FileId =:: export: FILE_ID_NONE
-2:FileId =:: export: FILE_ID_BUILT_IN
struct( string : fileName FileId : fileId i32 : line i32 : posInLine ) =:: export: FilePosition
string.empty FILE_ID_NONE 0 0 FilePosition new =:: export: FILE_POS_UNKNOWN
string.empty FILE_ID_BUILT_IN 0 0 FilePosition new =:: export: FILE_POS_BUILTIN
proc( FilePosition : a FilePosition : b -> i32 ) =>: export: filePosCmp
  ## high file ids first
  a .fileId b .fileId != if
    b .fileId i32 cast a .fileId i32 cast i32.cmp return
  end
  ## ordered by position in file
  a .line b .line != if
    a .line b .line i32.cmp return
  end
  a .posInLine b .posInLine i32.cmp return
end
enum( ERROR WARNING INFO ) =:: export: ErrorType
struct( stringBuilder : message FilePosition ptr : pos ErrorType : errType ) =:: export: CompilerError
proc( stringBuilder : message FilePosition ptr : pos CompilerError list ptr.mut : errors -> ) =>: export: appendError
  errors []
    message pos ErrorType .ERROR CompilerError new list.append
  errors =[]
end
proc( stringBuilder : message FilePosition ptr : pos CompilerError list ptr.mut : errors -> ) =>: export: appendWarning
  errors []
    message pos ErrorType .WARNING CompilerError new list.append
  errors =[]
end
proc( stringBuilder : message FilePosition ptr : pos CompilerError list ptr.mut : errors -> ) =>: export: appendInfo
  errors []
    message pos ErrorType .INFO CompilerError new list.append
  errors =[]
end
proc( CompilerError : a CompilerError : b -> i32 ) =>: export: errorCmp
  a .errType ..tag i32 cast.u  b .errType ..tag i32 cast.u - =:: errTypeCmp
  errTypeCmp 0 != if errTypeCmp return end ## errors before warnings before info
  a .pos [] b .pos [] filePosCmp return
end

i32 =:: export: NameId
( char8 ptr.raw iSize -> NameId ) : static: export: alias: :NameId ..builtIn.parse.i32
namespace: NameId
  proc( NameId -> i32 ) =>: export: hash i32 cast end
  proc( NameId NameId -> bool ) : export: alias: eq i32.eq
  proc( NameId NameId -> i32 ) : export: alias: cmp i32.cmp
end
type : export: ProcedureInfo
struct( ## TODO? use low 3 bits of pointer to store important info (isStatic/isBuiltIn/isExtern/ isInline?)
  ProcedureInfo ptr.mut : Data
) =:: export: ProcId
namespace: ProcId
  proc( ProcId : a  ProcId : b -> bool ) =>: export: eq
    a .Data b .Data ptr.eq return
  end
  proc( ProcId : a  ProcId : b -> i32 ) =>: export: cmp
    a .Data b .Data ptr.cmp return
  end
  proc( ProcId : a -> i32 ) =>: export: hash
    a .Data iSize cast! $ 32 >>> ^ i32 cast
  end
  proc( ProcId -> NameId ) : export: getName
  proc( ProcedureInfo ptr.mut -> ProcId ) =>: export: create
    ProcId new
  end
  proc( ProcId -> ProcedureInfo ptr.mut ) =>: export: getProcInfo
    .Data
  end
end
i64 =:: export: ProcBundleId
( char8 ptr.raw iSize -> ProcBundleId ) : static: export: alias: :ProcBundleId ..builtIn.parse.i64


i32 =:: export: NamespaceId
( char8 ptr.raw iSize -> NamespaceId ) : static: export: alias: :NamespaceId ..builtIn.parse.i32
i32 =:: export: NamespaceImportId
( char8 ptr.raw iSize -> NamespaceImportId ) : static: export: alias: :NamespaceImportId ..builtIn.parse.i32
namespace: id
  -1:NameId =:: export: NAME_ID_NONE
  -1:NamespaceId =:: export: NAMESPACE_ID_NONE
  -1:NamespaceImportId =:: export: NAMESPACE_IMPORT_NONE
end

enum( CONCAT CCALL PTRCALL ) =:: export: CallingConvention
namespace: CallingConvention
  proc( -> CallingConvention ) =>: export: DEFAULT
    _BACKEND_ .QBE if
      CallingConvention .PTRCALL
    else
      CallingConvention .CONCAT
    end
  end
end

type : export: BuiltIn

## declare Type and ConstValue to allow mutual inclusion of types.concat and constants.concat
type : export: Type
type : export: ConstValue
type : export: ConstantContext
type : export: TypeCheckState

namespace: sb
  proc( stringBuilder string -> stringBuilder ) =>: export: appendAsciified
    string.chars for =:: c
        c '0' >= c '9' <= & if
          c sb.appendC continue
        end
        c 'A' >= c 'Z' <= & if
          c sb.appendC continue
        end
        c 'a' >= c 'z' <= & if
          c sb.appendC continue
        end
        c '_' == if
          "__" sb.appendS continue
        end
        c '.' == if
          "_d" sb.appendS continue
        end
        "_X" sb.appendS
        c i32 cast.u 0xff & 0x10 < if
          '0' sb.appendC
        end
        c i32 cast.u 0xff & sb.appendI
    end
  end
end
