## collection of basic declarations used by all compiler files
#include stringBuilder

i32 =:: public FileId
-1 FileId =: public FILE_ID_NONE

struct( string : mut fileName i64 : mut line i64 : mut posInLine ) =:: public FilePosition
struct( stringBuilder : message FilePosition : pos ) =:: public CompilerError

i32 =:: public LabelId
i32 =:: public NamespaceId
i32 =:: public NamespaceImportId
i32 =:: public TemplateId
#namespace id
  -1 LabelId =: public LABEL_ID_NONE
  -1 NamespaceId =: public NAMESPACE_ID_NONE
  -1 NamespaceImportId =: public NAMESPACE_IMPORT_NONE
  -1 TemplateId =: public TEMPLATE_ID_NONE
#end
