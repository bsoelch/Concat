## collection of basic declarations used by all compiler files
#include stringBuilder
#include list

"main" =:: public MAIN_NAME ## name of main procedure

i32 =:: public FileId
-1 FileId =: public FILE_ID_NONE

struct( string : mut fileName i64 : mut line i64 : mut posInLine ) =:: public FilePosition
enum( ERROR WARNING INFO ) =:: public ErrorType
struct( stringBuilder : message ErrorType : errType FilePosition : pos ) =:: public CompilerError
proc( stringBuilder : message FilePosition : pos CompilerError list ptr mut : errors => ) =: public appendError
  errors []
    message ErrorType .ERROR pos CompilerError new list.append
  errors [] =
end
proc( stringBuilder : message FilePosition : pos CompilerError list ptr mut : errors => ) =: public appendWarning
  errors []
    message ErrorType .WARNING pos CompilerError new list.append
  errors [] =
end
proc( stringBuilder : message FilePosition : pos CompilerError list ptr mut : errors => ) =: public appendInfo
  errors []
    message ErrorType .INFO pos CompilerError new list.append
  errors [] =
end

i32 =:: public LabelId
i32 =:: public NamespaceId
i32 =:: public NamespaceImportId
i32 =:: public TemplateId
#namespace id
  -1 LabelId =: public LABEL_ID_NONE
  -1 NamespaceId =: public NAMESPACE_ID_NONE
  -1 NamespaceImportId =: public NAMESPACE_IMPORT_NONE
  -1 TemplateId =: public TEMPLATE_ID_NONE
#end

enum( STRUCT POINTER ) =:: public CallingConvention
#namespace CallingConvention
  CallingConvention .POINTER =:: public DEFAULT
#end

## declare Type and ConstValue to allow mutual inclusion of types.concat and constants.concat
type : public Type
type : public ConstValue
type : public ConstantArray
type : public ConstantContext


#namespace sb
proc( stringBuilder string => stringBuilder ) =: public appendAsciified
  =:: str
  0 while #dup str .length < do
    #swap
      str #over:2 string.charAt =:: c
      c '0' >= c '9' <= & if
        c sb.appendC
        #swap 1 + continue
      end
      c 'A' >= c 'Z' <= & if
        c sb.appendC
        #swap 1 + continue
      end
      c 'a' >= c 'z' <= & if
        c sb.appendC
        #swap 1 + continue
      end
      c '_' == if
        "__" sb.appendS
        #swap 1 + continue
      end
      c '.' == if
        "_d" sb.appendS
        #swap 1 + continue
      end
      "_X" sb.appendS
      c 0xff & 0x10 < if
        '0' sb.appendC
      end
      c 0xff & sb.appendI
    #swap 1 +
  end #drop
end
#end
