import slice
import stringBuilder
import numbers
using std.literals.

import "common.concat"
namespace: asm
  i32 =:: export: OpCode
  ( char8 ptr.raw iSize -> OpCode ) : alias: export: :OpCode :i32
  i32 =:: export: RegisterId
  ( char8 ptr.raw iSize -> RegisterId ) : alias: export: :RegisterId :i32
  namespace: RegisterId
    0x3:RegisterId =:: export: SIZE_MASK
    0x0:RegisterId =:: export: SIZE_64
    0x1:RegisterId =:: export: SIZE_32
    0x2:RegisterId =:: export: SIZE_16
    0x3:RegisterId =:: export: SIZE_8
    0x4:RegisterId =:: export: FLAG_VEC
    4 =:: export: BASE_SHIFT
    0xffff_fff0:RegisterId =:: export: BASE_MASK
    proc( RegisterId RegisterId : newSize -> RegisterId ) =>: export: setSize
      BASE_MASK & newSize |
    end
    proc( RegisterId -> RegisterId ) =>: export: baseReg
      BASE_MASK &
    end
    ( RegisterId -> bool ) : alias: export: toBool i32.toBool
    ( RegisterId -> RegisterId  ) : alias: export: flip i32.flip
    ( RegisterId RegisterId -> RegisterId  ) : alias: export: and i32.and
    ( RegisterId RegisterId -> RegisterId  ) : alias: export: or i32.or
    ( RegisterId RegisterId -> RegisterId  ) : alias: export: xor i32.xor
    ( RegisterId i32 -> RegisterId  ) : alias: export: shl i32.shl
    ( RegisterId i32 -> RegisterId  ) : alias: export: shr i32.lshr
    overload: merge: ? toBool end
    overload: merge: ~ flip end
    overload: merge: & RegisterId.and end
    overload: merge: | RegisterId.or end
    overload: merge: ^ xor end
    overload: merge: << shl end
    overload: merge: >>> shr end
  end

  string =:: export: GlobalLabel
  i32 =:: export: LocalLabel

  i32 =:: export: LocalVarId
  namespace: LocalVarId
    proc( LocalVarId -> i32 ) =>: export: hash i32 cast end
    proc( LocalVarId LocalVarId -> bool ) : export: alias: eq i32.eq
    proc( LocalVarId LocalVarId -> i32 ) : export: alias: cmp i32.cmp
  end
  struct( LocalVarId : varId i32 : offset ) =:: export: LocalAddress
  namespace: LocalAddress
    proc( LocalAddress : a LocalAddress : b -> bool ) =>: export: eq
      a .varId b .varId == and a .offset b .offset == end
    end
  end
  struct( RegisterId : reg i32 : offset ) =:: export: RegisterAddress
  namespace: RegisterAddress
    proc( RegisterAddress : a RegisterAddress : b -> bool ) =>: export: eq
      a .reg b .reg == and a .offset b .offset == end
    end
  end

  union(
    _ : None
    RegisterId : Register
    i64 : Int
    f64 : Float
    LocalAddress : shadow: LocalAddress
    RegisterAddress : shadow: RegisterAddress
    ## TODO memory values
  ) =:: export: Value
  namespace: Value
    proc( Value : a Value : b -> bool ) =>: export: equal
      a ..tag b ..tag != if false return end
      a switch
        None case true return
        Register .case b .Register unionElement.unwrap == return
        Int .case b .Int unionElement.unwrap == return
        Float .case b .Float unionElement.unwrap == return
        LocalAddress .case b .LocalAddress unionElement.unwrap LocalAddress.eq return
        RegisterAddress .case b .RegisterAddress unionElement.unwrap RegisterAddress.eq return
      end
    end
  end
  proc( LocalVarId i32 -> Value ) =>: export: localAddress
    LocalAddress new Value .LocalAddress
  end
  proc( RegisterId -> Value ) =>: regAddress1
    0 RegisterAddress new Value .RegisterAddress
  end
  proc( RegisterId i32 -> Value ) =>: regAddress2
    RegisterAddress new Value .RegisterAddress
  end
  overload: export: regAddress regAddress1 regAddress2 end
  union(
    RegisterId : Register
    i64 : Int
    GlobalLabel : shadow: GlobalLabel
    LocalLabel : shadow: LocalLabel
    LocalAddress : shadow: LocalAddress
    RegisterAddress : shadow: RegisterAddress
  ) =:: export: Operand
  union(
    _               : None
    Operand         : Val
    ( Operand Operand ) : Val2
    ( Operand Operand Operand ) : Val3
    Operand slice   : Vals
  ) =:: export: Operands
  struct(
    asm.OpCode : opCode
    Operands : args
  ) =:: export: Instruction
  union(
    i64 : Int
    f64 : Float
    GlobalLabel : Label
  ) =:: export: Data
  union(
    GlobalLabel : Enter
    _ : Leave
    _ : EndProc
    GlobalLabel : Export
    LocalLabel : shadow: LocalLabel
    GlobalLabel : shadow: GlobalLabel
  ) =:: export: Directive
  union(
    _ : None
  ) =:: export: Info
  union(
    asm.Instruction : shadow: Instruction
    asm.Data : shadow: Data
    asm.Directive : shadow: Directive
    asm.Info : shadow: Info
  ) =:: export: Atom
  enum( AMD64 ) =:: export: TargetId
  struct(
    proc( stringBuilder OpCode -> stringBuilder ) ptr : appendOpCode
    proc( stringBuilder RegisterId -> stringBuilder ) ptr : appendReg
    proc( RegisterId -> bool ) ptr : isIntRegister
    TargetId : targetId
  ) =:: export: Context
  proc( OpCode : opCode -> Atom ) =>: export: op0
    opCode Operands .None Instruction new Atom .Instruction
  end
  proc( OpCode : opCode RegisterId : r1 -> Atom ) =>: export: opR
    opCode r1 Operand .Register Operands .Val Instruction new Atom .Instruction
  end
  proc( OpCode : opCode LocalLabel : l1 -> Atom ) =>: export: opL
    opCode l1 Operand .LocalLabel Operands .Val Instruction new Atom .Instruction
  end
  proc( OpCode : opCode string : l1 -> Atom ) =>: export: opG
    opCode l1 GlobalLabel cast Operand .GlobalLabel Operands .Val Instruction new Atom .Instruction
  end
  proc( OpCode : opCode LocalAddress : l1 RegisterId : r1 -> Atom ) =>: export: opLR
    opCode
      l1 Operand .LocalAddress
      r1 Operand .Register
    ( Operand Operand ) new Operands .Val2 Instruction new Atom .Instruction
  end
  proc( OpCode : opCode RegisterId : r1 LocalAddress : l1 -> Atom ) =>: export: opRL
    opCode
      r1 Operand .Register
      l1 Operand .LocalAddress
    ( Operand Operand ) new Operands .Val2 Instruction new Atom .Instruction
  end
  proc( OpCode : opCode RegisterId : r1 RegisterId : r2 -> Atom ) =>: export: opRR
    opCode
      r1 Operand .Register
      r2 Operand .Register
    ( Operand Operand ) new Operands .Val2 Instruction new Atom .Instruction
  end
  proc( OpCode : opCode RegisterId : r1 i64 : imm -> Atom ) =>: export: opRI
    opCode
      r1 Operand .Register
      imm Operand .Int
    ( Operand Operand ) new Operands .Val2 Instruction new Atom .Instruction
  end
  overload: export: op1 opR opL opG end
  overload: export: op2 opLR opRL opRR opRI end
  proc( string : name -> Atom ) =>: export: enter
    name GlobalLabel cast Directive .Enter Atom .Directive
  end
  proc( -> Atom ) =>: export: leave
    Directive .Leave Atom .Directive
  end
  proc( -> Atom ) =>: export: endProc
    Directive .EndProc Atom .Directive
  end
  proc( i32 -> Atom ) =>: export: localLabel
    LocalLabel cast Directive .LocalLabel Atom .Directive
  end
  proc( string -> Atom ) =>: export: globalLabel
    GlobalLabel cast Directive .GlobalLabel Atom .Directive
  end
  proc( string -> Atom ) =>: export: exportName
    GlobalLabel cast Directive .Export Atom .Directive
  end
  proc( Atom -> string optional ) =>: export: isEnter
    .Directive .and .Enter .if
      string cast optional.wrap
     else
      string optional.empty return
     end
  end
  proc( Atom -> bool ) =>: export: isLeave
    .Directive .and .Leave ? end
  end
  proc( Atom -> bool ) =>: export: isEndProc
    .Directive .and .EndProc ? end
  end
  proc( type : auto: C Atom ( Operand C -> Operand ) ptr : f C : curry -> Atom ) =>: export: mapOperands
    .Instruction .if
      $ .args switch
        None case Operands .None break
        Val  .case curry f () Operands .Val break
        Val2 .case
           $ .0 curry f () >$ .1 curry f ()
         ( Operand Operand ) new Operands .Val2 break
        Val3 .case
           $ .0 curry f () $1 .1 curry f () >>$ .2 curry f ()
         ( Operand Operand Operand ) new Operands .Val3 break
        Vals .case
          ## slice.map for curry f () end
          "mapOperands not supported for operations with more that 3 arguments" ..panic
        break
      end >$ .args= Atom .Instruction
    end
  end
  
  proc( stringBuilder LocalAddress : local Context : asmContext -> stringBuilder ) =>: export: appendLocalAddress
    "[local":s sb.appendStr
      local .varId i32 cast.u sb.appendU
      local .offset 0 != if
        '+' sb.appendC
        local .offset sb.appendU
      end
    ']' sb.appendC
  end
  proc( stringBuilder RegisterAddress : addr Context : asmContext -> stringBuilder ) =>: export: appendRegisterAddress
    ## TODO! make target specific
    "[":s sb.appendStr
      addr .reg asmContext .appendReg ()
      addr .offset 0 != if
        addr .offset
          $ 0 > if <$ '+' sb.appendC >$ end
        sb.appendI
      end
    ']' sb.appendC
  end
  proc( stringBuilder Value : arg  Context : asmContext -> stringBuilder ) =>: export: appendValue
    arg switch
      None case "None":s sb.appendStr return
      Register .case asmContext .appendReg () return
      Int .case sb.appendI return
      Float .case sb.appendF ":f64":s sb.appendStr return
      LocalAddress .case asmContext appendLocalAddress return
      RegisterAddress .case asmContext appendRegisterAddress return
    end
  end
  proc( stringBuilder Operand : arg  Context : asmContext -> stringBuilder ) =>: export: appendOperand
    arg switch
      Register .case asmContext .appendReg () return
      Int .case sb.appendI return
      GlobalLabel .case asmContext appendGlobalLabel return
      LocalLabel .case asmContext appendLocalLabel return
      LocalAddress .case asmContext appendLocalAddress return
      RegisterAddress .case asmContext appendRegisterAddress return
    end
  end
  proc( stringBuilder Instruction : op  Context : asmContext -> stringBuilder ) =>: export: appendInstruction
    "  ":s sb.appendStr
    op .opCode asmContext .appendOpCode ()
    ' ' sb.appendC
    op .args switch
      None case sb.removeLast ..drop return
      Val .case asmContext appendOperand return
      Val2 .case =:: args
        args .0 asmContext appendOperand
        ", ":s sb.appendStr
        args .1 asmContext appendOperand
      return
      Val3 .case =:: args
        args .0 asmContext appendOperand
        ", ":s sb.appendStr
        args .1 asmContext appendOperand
        ", ":s sb.appendStr
        args .2 asmContext appendOperand
      return
      Vals .case =:: args
        true =:: mut: first
        args for =:: arg
          first if
            false first=
          else
            ", ":s sb.appendStr
          end
          arg asmContext appendOperand
        end
      return
    end
  end
  proc( stringBuilder GlobalLabel : label  Context : asmContext -> stringBuilder ) =>: export: appendGlobalLabel
    label string cast sb.appendAsciified
  end
  proc( stringBuilder LocalLabel : label  Context : asmContext -> stringBuilder ) =>: export: appendLocalLabel
    ".L":s sb.appendStr label i64 cast.u sb.appendI
  end
  proc( stringBuilder Directive : directive  Context : asmContext -> stringBuilder ) =>: export: appendDirective
    directive switch
      Enter .case =:: label "enter ":s sb.appendStr label asmContext appendGlobalLabel ':' sb.appendC return
      Leave case "leave":s sb.appendStr return
      EndProc case "endProc\n":s sb.appendStr return
      LocalLabel .case asmContext appendLocalLabel ':' sb.appendC return
      GlobalLabel .case asmContext appendGlobalLabel ':' sb.appendC return
      Export .case =:: label ".globl ":s sb.appendStr label asmContext appendGlobalLabel return
    end
  end
  proc( stringBuilder Atom : atom  Context : asmContext -> stringBuilder ) =>: export: appendAtom
    atom switch
      Instruction .case asmContext appendInstruction break
      Directive .case asmContext appendDirective break
      Data .case "TODO" ..panic
      Info .case "TODO" ..panic
    end
    '\n' sb.appendC
  end
end
