#+
compile concat to x86 assembly
generates stack based code, prioritizing simplicity over efficiency
+#
import stringIO
import numbers/floats

import "program.concat"
import "measure.concat"
import "branchTree.concat"

#+
The assembly syntax is primarily inspired by x86-64 with a few instructions/ideas taken from AArch64.
The goal is to have a higher level intermediate assembly language that can easily concertized&optimized for output to both ADM64 and AArch64 assembly ( with possible RISC-V as additional target )
+#
enum(
  MOV EXTZ EXTS LEA PUSH POP
  NEG ADD SUB MUL SMUL DIV SDIV REM SREM
  DIV_REM SDIV_REM ## merged instructions
  NOT AND OR XOR
  SHL SHR SAR
  CMP TEST
  SETL SETLE SETGE SETG
  SETB SETBE SETAE SETA
  SETE SETNE ## XXX? merge: SETcc target, conditionFlag
  JNZ JZ JMP ## XXX? merge: JMPcc target, conditionFlag
  RET
  UITOF ITOF FTOI FTOUI ## (u) int <-> float
  EXTF TRUNCF ## resize float
  ## macro instructions
  ALLOC
  COPY
) =:: X64_OP
## TODO remember operand size [I8,I16,I32,I64,I128,F16,F32,F64,F128]

struct(
  i8 : id
) =:: Register

namespace: Register
  0:i8 Register new =:: none
  0x7f:i8 Register new =:: sp
  0x7e:i8 Register new =:: fp
  ## > 0 -> general purpose registers
  ## < 0 -> float/vector registers
  namespace: x64
    1:i8 Register new =:: rax
    2:i8 Register new =:: rbx
    3:i8 Register new =:: rcx
    4:i8 Register new =:: rdx
    5:i8 Register new =:: rsi
    6:i8 Register new =:: rdi
    sp =:: rsp
    fp =:: rbp
     9:i8 Register new =:: r8
    10:i8 Register new =:: r9
    11:i8 Register new =:: r10
    12:i8 Register new =:: r11
    13:i8 Register new =:: r12
    14:i8 Register new =:: r13
    15:i8 Register new =:: r14
    16:i8 Register new =:: r15
    -1:i8 Register new =:: xmm0
    -2:i8 Register new =:: xmm1
    -3:i8 Register new =:: xmm2
    -4:i8 Register new =:: xmm3
    -5:i8 Register new =:: xmm4
    -6:i8 Register new =:: xmm5
    -7:i8 Register new =:: xmm6
    -8:i8 Register new =:: xmm7
    -9:i8 Register new =:: xmm8
   -10:i8 Register new =:: xmm9
   -11:i8 Register new =:: xmm10
   -12:i8 Register new =:: xmm11
   -13:i8 Register new =:: xmm12
   -14:i8 Register new =:: xmm13
   -15:i8 Register new =:: xmm14
   -16:i8 Register new =:: xmm15
  end
end

enum(
  ERROR
  ELSE END_IF
  WHILE CONTINUE_WHILE END_WHILE
  CASE DEFAULT END_SWITCH
) =:: BranchType
struct(
  BranchType : branchType
  i32 : blockId
  i32 : subId
) =:: LocalLabel
struct(
  LabelId : baseLabel
  i64 : implId
) =:: GlobalLabel
enum(
  empty
  Register : register
  Register : registerPtr
  Register : registerPtrOffset
  i64 : value
  i64 : stackMemoryInt
  i64 : stackMemoryFloat
  i64 : stackArgument
  i64 : outputArgument
  LabelId : localVariable
  LocalLabel : localLabel
  GlobalLabel : globalLabel
) =:: AsmOperand
struct(
  AsmOperand 3 array : args
  X64_OP : operation
) =:: AssemblyOperation
enum(
  empty
  AssemblyOperation : op
  LocalLabel : localLabel
  GlobalLabel : globalLabel
  ## XXX debug info
) =:: AssemblyAtom
namespace: asm
  proc( X64_OP : opName -> AssemblyOperation ) =>: createNilary
    AsmOperand 3 array new =:: mut: args
    ## AssemblyOperation
      args
      opName
    AssemblyOperation new
  end
  proc( X64_OP : opName AsmOperand : op1 -> AssemblyOperation ) =>: createUnary
    AsmOperand 3 array new =:: mut: args
    op1 args @ 0 [] =
    ## AssemblyOperation
      args
      opName
    AssemblyOperation new
  end
  proc(
    X64_OP : opName
    AsmOperand : op1
    AsmOperand : op2
  -> AssemblyOperation ) =>: createBinary
    AsmOperand 3 array new =:: mut: args
    op1 args @ 0 [] =
    op2 args @ 1 [] =
    ## AssemblyOperation
      args
      opName
    AssemblyOperation new
  end
  proc(
    X64_OP : opName
    AsmOperand : op1
    AsmOperand : op2
    AsmOperand : op3
  -> AssemblyOperation ) =>: createTrinary
    AsmOperand 3 array new =:: mut: args
    op1 args @ 0 [] =
    op2 args @ 1 [] =
    op3 args @ 2 [] =
    ## AssemblyOperation
      args
      opName
    AssemblyOperation new
  end
  proc( stringBuilder : sb Register : reg -> stringBuilder ) =>: appendRegister
    sb ## XXX? make register (? /all int-like structures) switchable
      reg .id Register.x64.rax .id ==    if "rax"   sb.appendS else
      reg .id Register.x64.rbx .id ==   _if "rbx"   sb.appendS else
      reg .id Register.x64.rcx .id ==   _if "rcx"   sb.appendS else
      reg .id Register.x64.rdx .id ==   _if "rdx"   sb.appendS else
      reg .id Register.x64.rdi .id ==   _if "rdi"   sb.appendS else
      reg .id Register.x64.rsi .id ==   _if "rsi"   sb.appendS else
      reg .id Register.x64.rsp .id ==   _if "rsp"   sb.appendS else
      reg .id Register.x64.rbp .id ==   _if "rbp"   sb.appendS else
      reg .id Register.x64.r8  .id ==   _if "r8"    sb.appendS else
      reg .id Register.x64.r9  .id ==   _if "r9"    sb.appendS else
      reg .id Register.x64.r10 .id ==   _if "r10"   sb.appendS else
      reg .id Register.x64.r11 .id ==   _if "r11"   sb.appendS else
      reg .id Register.x64.r12 .id ==   _if "r12"   sb.appendS else
      reg .id Register.x64.r13 .id ==   _if "r13"   sb.appendS else
      reg .id Register.x64.r14 .id ==   _if "r14"   sb.appendS else
      reg .id Register.x64.r15 .id ==   _if "r15"   sb.appendS else
      reg .id Register.x64.xmm0  .id == _if "xmm0"  sb.appendS else
      reg .id Register.x64.xmm1  .id == _if "xmm1"  sb.appendS else
      reg .id Register.x64.xmm2  .id == _if "xmm2"  sb.appendS else
      reg .id Register.x64.xmm3  .id == _if "xmm3"  sb.appendS else
      reg .id Register.x64.xmm4  .id == _if "xmm4"  sb.appendS else
      reg .id Register.x64.xmm5  .id == _if "xmm5"  sb.appendS else
      reg .id Register.x64.xmm6  .id == _if "xmm6"  sb.appendS else
      reg .id Register.x64.xmm7  .id == _if "xmm7"  sb.appendS else
      reg .id Register.x64.xmm8  .id == _if "xmm8"  sb.appendS else
      reg .id Register.x64.xmm9  .id == _if "xmm9"  sb.appendS else
      reg .id Register.x64.xmm10 .id == _if "xmm10" sb.appendS else
      reg .id Register.x64.xmm11 .id == _if "xmm11" sb.appendS else
      reg .id Register.x64.xmm12 .id == _if "xmm12" sb.appendS else
      reg .id Register.x64.xmm13 .id == _if "xmm13" sb.appendS else
      reg .id Register.x64.xmm14 .id == _if "xmm14" sb.appendS else
      reg .id Register.x64.xmm15 .id == _if "xmm15" sb.appendS else
        "?"  sb.appendS
      end
    return
  end
  proc(
    stringBuilder : sb
    LocalLabel : label
  -> stringBuilder ) =>: appendLocalLabel
    sb
      ## TODO prefix for current proc
      label .branchType switch
        ERROR case "error" sb.appendS break
        ELSE case "else" sb.appendS break
        END_IF case "endIf" sb.appendS break
        WHILE case "while" sb.appendS break
        CONTINUE_WHILE case "continueWhile" sb.appendS break
        END_WHILE case "endWhile" sb.appendS break
        CASE case "case" sb.appendS break
        DEFAULT case "default" sb.appendS break
        END_SWITCH case "endSwitch" sb.appendS break
      end
      label .blockId sb.appendI
      label .subId -1 != if
        '_' sb.appendC
        label .subId sb.appendI
      end
    return
  end
  proc(
    stringBuilder : sb
    GlobalLabel : label
    LabelContext ptr : labelContext
  -> stringBuilder ) =>: appendGlobalLabel
    sb ## TODO escaping, namespace
      label .baseLabel labelContext sb.appendLabelName
      ## XXX TODO implementation id
    return
  end
  proc(
    stringBuilder : sb
    AssemblyOperation : op
    LabelContext ptr : labelContext
  -> stringBuilder ) =>: appendOp
    sb
      op .operation switch
        PUSH case "push " sb.appendS break
        POP case "pop " sb.appendS break
        MOV case "mov " sb.appendS break
        EXTS case "exts " sb.appendS break
        EXTZ case "extz " sb.appendS break
        LEA case "lea " sb.appendS break
        NEG case "neg " sb.appendS break
        ADD case "add " sb.appendS break
        SUB case "sub " sb.appendS break
        MUL case "mul " sb.appendS break
        SMUL case "smul " sb.appendS break
        DIV case "div " sb.appendS break
        SDIV case "sdiv " sb.appendS break
        REM case "rem " sb.appendS break
        SREM case "srem " sb.appendS break
        DIV_REM case "divRem " sb.appendS break
        SDIV_REM case "sdivRem " sb.appendS break
        NOT case "not " sb.appendS break
        AND case "and " sb.appendS break
        OR  case "or " sb.appendS break
        XOR case "xor " sb.appendS break
        SHL case "shl " sb.appendS break
        SHR case "shr " sb.appendS break
        SAR case "sar " sb.appendS break
        CMP case "cmp " sb.appendS break
        TEST case "test " sb.appendS break
        SETE case "sete " sb.appendS break
        SETNE case "setne " sb.appendS break
        SETL case "setl " sb.appendS break
        SETLE case "setle " sb.appendS break
        SETGE case "setge " sb.appendS break
        SETG case "setg " sb.appendS break
        SETB case "setb " sb.appendS break
        SETBE case "setbe " sb.appendS break
        SETAE case "setae " sb.appendS break
        SETA case "seta " sb.appendS break
        JMP case "jmp " sb.appendS break
        JNZ case "jnz " sb.appendS break
        JZ case "jz " sb.appendS break
        RET case "ret " sb.appendS break
        ALLOC case "alloc " sb.appendS break
        COPY case "copy " sb.appendS break
        ITOF case "iTOf " sb.appendS break
        UITOF case "uiTOf " sb.appendS break
        FTOI case "fTOi " sb.appendS break
        FTOUI case "fTOui " sb.appendS break
        EXTF case "extf " sb.appendS break
        TRUNCF case "truncf " sb.appendS break
      end
      false =:: mut: needComma
      false =:: mut: isPtrOffset
      op .args =:: args
      0 while ..dup args ..length < do =:: i
        args @ i [] =:: arg
        arg .empty ?? if
          i 1 + continue
        end
        needComma if
          isPtrOffset if
            '+' sb.appendC
          else
            ", " sb.appendS
          end
          false needComma =
        end
        isPtrOffset =:: wasPtrOffset
        false isPtrOffset =
        arg switch
          register case arg .register appendRegister break
          registerPtr case
            '[' sb.appendC
            arg .registerPtr appendRegister
            ']' sb.appendC
            break
          registerPtrOffset case
            wasPtrOffset ! if
              '[' sb.appendC
            end
            arg .registerPtrOffset appendRegister
            true isPtrOffset =
            break
          value case arg .value sb.appendI break
          stackArgument case
            "%stackArg" sb.appendS arg .stackArgument sb.appendI break
          stackMemoryInt case
            "%stackInt" sb.appendS arg .stackMemoryInt sb.appendI break
          stackMemoryFloat case
            "%stackFloat" sb.appendS arg .stackMemoryFloat sb.appendI break
          localVariable case
            "%localVar" sb.appendS arg .localVariable i64 cast sb.appendI break
          outputArgument case
            "%outArg" sb.appendS arg .outputArgument sb.appendI break
          localLabel case arg .localLabel appendLocalLabel break
          globalLabel case arg .globalLabel labelContext appendGlobalLabel break
          empty case ..unreachable
        end
        wasPtrOffset and isPtrOffset ! if
          ']' sb.appendC
        end
        true needComma =
        i 1 +
      end ..drop
      '\n' sb.appendC
    return
  end
  proc(
    stringBuilder : sb
    AssemblyAtom : atom
    LabelContext ptr : labelContext
  -> stringBuilder ) =>: appendToSb
    atom switch
      empty case sb "  ## empty\n" sb.appendS return
      op case sb "  " sb.appendS atom .op labelContext appendOp return
      localLabel case
          sb atom .localLabel appendLocalLabel
          ":\n" sb.appendS
        return
      globalLabel case
          sb atom .globalLabel labelContext appendGlobalLabel
          ":\n" sb.appendS
        return
    end
  end
end

enum(
  EMPTY I32 I64 F32 F64 PTR REFERENCE
  BITS32 BITS64 BITS128 BITS128L BITS128H
  BITSF32 BITSF64 BITSFF128 BITSIF128 BITSFI128 BITSF128L BITSF128H
) =:: ValueType

namespace: sb
  proc(
    stringBuilder : sb
    ValueType : val
  -> stringBuilder ) =>: appendValueType
    sb
      val switch
        EMPTY case "?" sb.appendS break
        I32 case "i32" sb.appendS break
        I64 case "i64" sb.appendS break
        F32 case "f32" sb.appendS break
        F64 case "f64" sb.appendS break
        PTR case "pointer" sb.appendS break
        REFERENCE case "reference" sb.appendS break
        BITS32 case "bits32" sb.appendS break
        BITSF32 case "bitsF32" sb.appendS break
        BITS64 case "bits64" sb.appendS break
        BITSF64 case "bitsF64" sb.appendS break
        BITS128 case "bits128" sb.appendS break
        BITSFF128 case "bitsFF128" sb.appendS break
        BITSIF128 case "bitsIF128" sb.appendS break
        BITSFI128 case "bitsFI128" sb.appendS break
        BITS128L case "bits128:L" sb.appendS break
        BITS128H case "bits128:H" sb.appendS break
        BITSF128L case "bitsF128:L" sb.appendS break
        BITSF128H case "bitsF128:H" sb.appendS break
      end
    return
  end
end


15 =:: REGISTER_LIST_MAX_LENGTH
struct(
  Register REGISTER_LIST_MAX_LENGTH array : mut: registers
  i8 : mut: count
) =:: RegisterList

struct(
  i32 : intOffset
  i32 : floatOffset
  ValueType : valType
) =:: StackRegisterValue

struct(
  i32 : mut: stackCountInt
  i32 : mut: stackCountFloat
  bool REGISTER_LIST_MAX_LENGTH array : mut: activeStackRegistersInt
  bool REGISTER_LIST_MAX_LENGTH array : mut: activeStackRegistersFloat
) =:: StackRegisterState

struct(
  branchTree.NodeId list : mut: ififBranches
  StackRegisterState : mut: rootStackRegs
  StackRegisterState : mut: ifBranchRegs
  i64 : mut: ifBranchCodeOffset
  branchTree.NodeId : branchRoot
  branchTree.NodeId : mut: ifBranch
  i32 : blockId
  bool : mut: ifBranchTerminates
) =:: IfBlockInfo
struct(
  branchTree.NodeId list : mut: caseBranches
  StackRegisterState list : mut: caseStackRegs
  i64 list : mut: caseCodeOffsets
  StackRegisterState : mut: rootStackRegs
  branchTree.NodeId : branchRoot
  i32 : blockId
) =:: SwitchBlockInfo
struct(
  branchTree.NodeId list : mut: continueBranches
  StackRegisterState list : mut: continueStackRegs
  i64 list : mut: continueCodeOffsets
  branchTree.NodeId list : mut: breakBranches
  StackRegisterState list : mut: breakStackRegs
  i64 list : mut: breakCodeOffsets
  StackRegisterState : rootStackRegs
  branchTree.NodeId : branchRoot
  i32 : blockId
) =:: WhileBlockInfo

enum(
  IfBlockInfo : mut: If
  SwitchBlockInfo : mut: Switch
  WhileBlockInfo : mut: While
) =:: BlockInfo

namespace: sb
  proc( stringBuilder BlockInfo -> stringBuilder ) =>: appendBlockInfo
    switch
      If case "if-else block" sb.appendS return
      Switch case "switch-case block" sb.appendS return
      While case "while block" sb.appendS return
    end
  end
end

struct(
  Type       : valType
  ConstValue : value
  FilePosition : pos
  i64 : id
) =:: LocalConst

struct(
  ProgramContext ptr mut : program
  StackRegisterValue BranchTree : mut: stackValues
  BlockInfo list : mut: openBlocks
  LocalConst list : mut: localConstants
  StringConstant list : mut: stringConstants
  RegisterList : mut: stackRegistersInt
  RegisterList : mut: stackRegistersFloat
  RegisterList : mut: tmpRegistersInt
  RegisterList : mut: tmpRegistersFloat
  StackRegisterState : mut: stackRegState
  Type : mut: currentProc
  i64 : mut: localConstCount
  i64 : mut: stackCount
  i64 : mut: tmpCount
  i32 : mut: jumpLabelCount
  bool : mut: reachable
) =:: CompilerContext

proc( BlockInfo : block CompilerContext ptr mut : context -> ) =>: openBlock
  context [] .openBlocks
    block list.append
  context [] .openBlocks =
end
proc(
  i32 : blockId
  CompilerContext ptr mut : context
-> ) =>: openIfBlock
  ## IfBlockInfo
    8 branchTree.NodeId list.create
      context [] .stackValues @ branchTree.startBranch list.append
    context [] .stackRegState ## root
    context [] .stackRegState ## placeholder for if-branch
    -1
    context [] .stackValues @ branchTree.startBranch
    -1 branchTree.NodeId cast
    blockId
    false
  IfBlockInfo new BlockInfo .If context openBlock
end
proc(
  i32 : blockId
  CompilerContext ptr mut : context
-> ) =>: openSwitchBlock
  ## SwitchBlockInfo
    16 branchTree.NodeId list.create
    16 StackRegisterState list.create
    16 i64 list.create
    context [] .stackRegState
    context [] .stackValues @ branchTree.startBranch
    blockId
  SwitchBlockInfo new BlockInfo .Switch context openBlock
end
proc(
  i32 : blockId
  CompilerContext ptr mut : context
-> ) =>: openWhileBlock
  ## WhileBlockInfo
    8 branchTree.NodeId  list.create
    8 StackRegisterState list.create
    8 i64 list.create
    8 branchTree.NodeId  list.create
    8 StackRegisterState list.create
    8 i64 list.create
    context [] .stackRegState ## root
    context [] .stackValues @ branchTree.startBranch
    blockId
  WhileBlockInfo new BlockInfo .While context openBlock
end

proc(
  BlockType : breakType
  FilePosition : pos
  CompilerContext ptr mut : context
-> BlockInfo ptr mut optional ) =>: findBreakableBlock
  context [] .program =:: program
  program [] .errors @ =:: errors
  context [] .openBlocks .length 1 - while ..dup 0 >= do =:: i
    context [] .openBlocks i list.at .data =:: block
    breakType .BREAK ?? and block [] .While ?? if
      block optional.wrap return
    end
    breakType .CONTINUE ?? and block [] .While ?? if
      block optional.wrap return
    end
    breakType .BREAK_SWITCH ?? and block [] .Switch ?? if
      block optional.wrap return
    end
    i 1 -
  end ..drop
  60 sb.create
    breakType sb.appendBlockType
    " can only appear in loops " sb.appendS
    breakType .BREAK_SWITCH ?? if
      "and switch-case statements" sb.appendS
    end
  pos errors appendError
  BlockInfo ptr mut optional.empty return
end

struct(
  string : blockName
  i32 : blockId
  FilePosition : pos
  CompilerContext ptr mut : context
) =:: MergePoint
proc(
  StackRegisterValue ptr arrayView : toMerge
  i64 : offset
  MergePoint : mergePoint
-> StackRegisterValue ) =>: mergeBranches
  mergePoint .context =:: context
  context [] .program =:: program
  program [] .errors @ =:: errors
  program [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  toMerge 0 array.get [] =:: rootElement
  rootElement .valType =:: rootValue
  true =:: mut: isMerged
  1 while ..dup toMerge .length < do =:: i
    toMerge i array.get [] .valType rootValue != if
      false isMerged =
      i break
    end
    i 1 +
  end ..drop
  isMerged if
    rootElement return
  end
  1 while ..dup toMerge .length < do =:: i
    toMerge i array.get [] .valType rootValue != if
      "branches of " sb.wrap
         mergePoint .blockName sb.appendStr
         "-statement are out of sync expected: " sb.appendS
         rootValue sb.appendValueType
         " got: " sb.appendS
         toMerge i array.get [] .valType sb.appendValueType
      mergePoint .pos errors appendError
      i break
    end
    i 1 +
  end ..drop
  rootElement return
end

proc(
  Type : t
  TypeContext ptr mut : typeContext
-> ValueType ) =>: toValueType
  t switch
    namedType case
      t
        typeContext types.unwrapNamed
      typeContext toValueType return
    generatedType case
      t
        typeContext types.getGeneratedType
      typeContext toValueType return
    primitiveType case
      t .primitiveType switch
        TYPE case ValueType .EMPTY return
        BOOL I8 I16 I32 S8 S16 S32 U8 U16 U32 case
          ValueType .I32 return
        I64 S64 U64 case ValueType .I64 return
        F32 case ValueType .F32 return
        F64 case ValueType .F64 return
      end
      break
    cType case
      t .cType
        types.cTypeAsType
      typeContext toValueType return
      break
    arrayIndex case
      ValueType .I64 return
    pointer case
      ValueType .PTR return
    arrayType struct union enum case
      t typeContext types.sizeOf =:: size
      size .fixed ?? if ## TODO detect floats
        size .fixed 4 <= if
          ValueType .BITS32 return
        else size .fixed 8 <= _if
          ValueType .BITS64 return
        else size .fixed 16 <= _if
          ValueType .BITS128 return
        end
      end
      ValueType .REFERENCE return
    reference mutableReference procedure case
      ValueType .REFERENCE return
    undefined empty genericType autoType
    procIn procOut case
      ValueType .EMPTY return
  end
end

proc(
  AssemblyAtom list : asmOps
  Type : constType
  ConstValue : value
  FilePosition : pos
  CompilerContext ptr mut : context
-> AssemblyAtom list ) =>: pushConstant
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  constType typeContext toValueType =:: valType
  asmOps
    valType pos context preparePushValue =:: valueRegister
    value switch
      boolean case
        valueRegister .registerCount 1 == assert "correct register-count for value"
        ## asm.createBinary
          X64_OP .MOV
          valueRegister .registers @ 0 [] AsmOperand .register
          value .boolean if 1 else 0 end AsmOperand .value
        asm.createBinary AssemblyAtom .op list.append
        return
      chr case
        valueRegister .registerCount 1 == assert "correct register-count for value"
        ## asm.createBinary
          X64_OP .MOV
          valueRegister .registers @ 0 [] AsmOperand .register
          value .chr 0xff & AsmOperand .value
        asm.createBinary AssemblyAtom .op list.append
        return
      int case
        ## XXX ensure value has correct size
        valueRegister .registerCount 1 == assert "correct register-count for value"
        constType typeContext types.isPointer if
          ## treat pointer constants as integers of type iPtr
          types.primitive.I_PTR
        else
          constType typeContext types.unwrapNamed
          ..dup .arrayIndex ?? if ..drop
            types.primitive.I_SIZE
          end
        end =:: numType
        numType types.isPrimitive ! if
          "unexpected type for integer: " sb.wrap
            constType typeContext sb.appendType
            " number-type: " sb.appendS
            numType typeContext sb.appendType
          pos errors appendError
          return
        end
        numType typeContext types.primitiveValue switch
          I8  S8  U8  case value .int u8  cast break
          I16 S16 U16 case value .int u16 cast break
          I32 S32 U32 case value .int u32 cast break
          I64 S64 U64 case value .int break
          F32 case value .int f32 cast f32.bits u32 cast break
          F64 case value .int f64 cast f64.bits break
          BOOL TYPE case
            "unexpected type for integer: " sb.wrap
              constType typeContext sb.appendType
            pos errors appendError
            return
        end =:: intValue
        ## asm.createBinary
          X64_OP .MOV
          valueRegister .registers @ 0 [] AsmOperand .register
          intValue AsmOperand .value
        asm.createBinary AssemblyAtom .op list.append
        return
      Float case
        ## XXX? is int <-> floats platform independent
        constType typeContext types.unwrapNamed =:: numType
        numType types.primitive.F32 types.typeEquals if
          value .Float f32 cast f32.bits u32 cast
        else numType types.primitive.F64 types.typeEquals _if
          value .Float f64.bits
        else
          "unexpected type for float: " sb.wrap
            constType typeContext sb.appendType
            " number-type: " sb.appendS
            numType typeContext sb.appendType
          pos errors appendError
          return
        end =:: floatBits
        ## asm.createBinary
          X64_OP .MOV
          valueRegister .registers @ 0 [] AsmOperand .register
          floatBits AsmOperand .value
        asm.createBinary AssemblyAtom .op list.append
        return
      str case break
      arrayConstant case break
      genericArg case break
      union case break
      none wildCard typeId enumLabel
          procedure procedureBundle case
        break
    end
    "unsupported constant " sb.wrap
      value constContext typeContext sb.appendConstant
    pos errors appendError
  return
end

2 =:: MAX_VALUE_REGISTERS
## XXX? make maximum number of slots a program wide constant
struct(
  Register MAX_VALUE_REGISTERS array : registers
  i8 : registerCount
) =:: RegisterValue

## XXX? store 32-bit values separately to save space
enum( INT FLOAT ) =:: StackRegisterType

enum( PUSH POP DROP ) =:: StackOperation

proc(
  AssemblyAtom list : asmOps
  StackRegisterState : toState
  FilePosition : pos
  CompilerContext ptr mut : context
-> AssemblyAtom list ) =>: resetStackRegisters
  context [] .program [] .errors @ =:: errors
  context [] .stackRegState =:: current
  current .stackCountInt =:: intCount
  current .stackCountFloat =:: floatCount
  intCount toState .stackCountInt != if
    "stack out of sync" sb.wrap
    pos errors appendError
    asmOps return
  end
  floatCount toState .stackCountFloat != if
    "stack out of sync" sb.wrap
    pos errors appendError
    asmOps return
  end
  current .activeStackRegistersInt@ =:: currentIntRegs
  current .activeStackRegistersFloat@ =:: currentFloatRegs
  toState .activeStackRegistersInt =:: toIntRegValues
  toState .activeStackRegistersFloat =:: toFloatRegValues
  toIntRegValues @ =:: toIntRegs
  toFloatRegValues @ =:: toFloatRegs
  context [] .stackRegistersInt =:: intRegisters
  intCount intRegisters .count i64.min =:: intValCount
  context [] .stackRegistersFloat =:: floatRegisters
  floatCount floatRegisters .count i64.min =:: floatValCount
  asmOps
    0 while ..dup intValCount < do =:: i
      intCount intValCount - i + =:: valId
      valId intRegisters .count % =:: regId
      intRegisters .registers @ regId [] =:: regName
      currentIntRegs regId [] toIntRegs regId [] == if
        i 1 + continue
      end
      toIntRegs regId [] if
        ## asm.createBinary
          X64_OP .MOV
          regName AsmOperand .register
          valId AsmOperand .stackMemoryInt
        asm.createBinary AssemblyAtom .op list.append
      else
        ## asm.createBinary
          X64_OP .MOV
          valId AsmOperand .stackMemoryInt
          regName AsmOperand .register
        asm.createBinary AssemblyAtom .op list.append
      end
      i 1 +
    end ..drop
    0 while ..dup floatValCount < do =:: i
      floatCount floatValCount - i + =:: valId
      valId floatRegisters .count % =:: regId
      floatRegisters .registers @ regId [] =:: regName
      currentFloatRegs regId [] toFloatRegs regId [] == if
        i 1 + continue
      end
      toFloatRegs regId [] if
        ## asm.createBinary
          X64_OP .MOV
          regName AsmOperand .register
          valId AsmOperand .stackMemoryFloat
        asm.createBinary AssemblyAtom .op list.append
      else
        ## asm.createBinary
          X64_OP .MOV
          valId AsmOperand .stackMemoryFloat
          regName AsmOperand .register
        asm.createBinary AssemblyAtom .op list.append
      end
      i 1 +
    end ..drop
    toState context [] .stackRegState =
  return
end
proc(
  AssemblyAtom list : asmOps
  CompilerContext ptr mut : context
-> AssemblyAtom list ) =>: reserveStackRegSpace
  context [] .stackRegState .stackCountInt =:: intCount
  context [] .stackRegState .stackCountFloat =:: floatCount
  context [] .stackRegistersInt =:: intRegisters
  context [] .stackRegistersFloat =:: floatRegisters
  floatCount floatRegisters .count i64.min
    intCount intRegisters .count i64.min +
  =:: regCount
  asmOps
    0 while ..dup regCount < do =:: i
      AssemblyAtom .empty list.append
      i 1 +
    end ..drop
  return
end
proc(
  AssemblyAtom list : asmOps
  StackRegisterState arrayView : states
  i64 arrayView : codeOffsets
  FilePosition : pos
  CompilerContext ptr mut : context
-> AssemblyAtom list ) =>: mergeStackRegisters
  context [] .program [] .errors @ =:: errors
  states .length 1 <= if
    asmOps return
  end
  states 0 array.at .data [] .stackCountInt =:: intCount
  states 0 array.at .data [] .stackCountFloat =:: floatCount
  i32 REGISTER_LIST_MAX_LENGTH array new =:: mut: activeInts
  i32 REGISTER_LIST_MAX_LENGTH array new =:: mut: activeFloats
  0 while ..dup states .length < do =:: i
    states i array.at .data =:: state
    state [] .stackCountInt intCount != if
      "stack out of sync" sb.wrap
      pos errors appendError
      asmOps return
    else state [] .stackCountFloat floatCount != _if
      "stack out of sync" sb.wrap
      pos errors appendError
      asmOps return
    end
    0 while ..dup intCount < do =:: j
      state [] .activeStackRegistersInt@ j [] if
        activeInts@ j []
          1 +
        activeInts@ j [] =
      end
      j 1 +
    end ..drop
    0 while ..dup floatCount < do =:: j
      state [] .activeStackRegistersFloat@ j [] if
        activeFloats@ j []
          1 +
        activeFloats@ j [] =
      end
      j 1 +
    end ..drop
    i 1 +
  end ..drop
  intCount context [] .stackRegState .stackCountInt =
  floatCount context [] .stackRegState .stackCountFloat =
  context [] .stackRegState .activeStackRegistersInt@ =:: newIntRegs
  context [] .stackRegState .activeStackRegistersFloat@ =:: newFloatRegs
  context [] .stackRegistersInt =:: intRegisters
  intCount intRegisters .count i64.min =:: intValCount
  context [] .stackRegistersFloat =:: floatRegisters
  floatCount floatRegisters .count i64.min =:: floatValCount
  0 while ..dup states .length < do =:: i
    states i array.at .data =:: state
    codeOffsets i array.get =:: mut: k
    state [] .activeStackRegistersInt@ =:: currentIntRegs
    state [] .activeStackRegistersFloat@ =:: currentFloatRegs
    0 while ..dup intValCount < do =:: j
      intCount intValCount - j + =:: valId
      valId intRegisters .count % =:: regId
      activeInts@ regId [] states .length 2 / >= =:: isActive
      isActive newIntRegs regId [] =
      currentIntRegs regId [] isActive == if
        j 1 + continue
      end
      asmOps k list.at .data [] .empty ?? ! if
        "unable to merge registers, not enough reserved operations" sb.wrap
        pos errors appendError
        asmOps return
      end
      intRegisters .registers @ regId [] =:: regName
      isActive if
        ## asm.createBinary
          X64_OP .MOV
          regName AsmOperand .register
          valId AsmOperand .stackMemoryInt
        asm.createBinary AssemblyAtom .op asmOps k list.set
      else
        ## asm.createBinary
          X64_OP .MOV
          valId AsmOperand .stackMemoryInt
          regName AsmOperand .register
        asm.createBinary AssemblyAtom .op asmOps k list.set
      end
      k 1 + k =
      j 1 +
    end ..drop
    0 while ..dup floatValCount < do =:: j
      floatCount floatValCount - j + =:: valId
      valId floatRegisters .count % =:: regId
      activeFloats@ regId [] states .length 2 / >= =:: isActive
      isActive newFloatRegs regId [] =
      currentFloatRegs regId [] isActive == if
        j 1 + continue
      end
      asmOps k list.at .data [] .empty ?? ! if
        "unable to merge registers, not enough reserved operations" sb.wrap
        pos errors appendError
        asmOps return
      end
      floatRegisters .registers @ regId [] =:: regName
      isActive if
        ## asm.createBinary
          X64_OP .MOV
          regName AsmOperand .register
          valId AsmOperand .stackMemoryFloat
        asm.createBinary AssemblyAtom .op asmOps k list.set
      else
        ## asm.createBinary
          X64_OP .MOV
          valId AsmOperand .stackMemoryFloat
          regName AsmOperand .register
        asm.createBinary AssemblyAtom .op asmOps k list.set
      end
      k 1 + k =
      j 1 +
    end ..drop
    i 1 +
  end ..drop
  asmOps return
end

proc(
  StackRegisterType : registerType
  i64 : stackIndex
  FilePosition : pos
  CompilerContext ptr mut : context
-> AsmOperand ) =>: getStackValue
  context [] .program [] .errors @ =:: errors
  registerType switch
    INT case
      context [] .stackRegState .stackCountInt 1 - =:: maxIndex
      stackIndex 0 < if
        "stack underflow" sb.wrap
        pos errors appendError
        AsmOperand .empty return
      end
      context [] .stackRegistersInt =:: registers
      stackIndex maxIndex registers .count - <= if ## memory only
        stackIndex AsmOperand .stackMemoryInt return
      end
      stackIndex registers .count % =:: regOffset
      context [] .stackRegState .activeStackRegistersInt @ regOffset [] if
        registers .registers @ regOffset [] AsmOperand .register return
      end
      stackIndex AsmOperand .stackMemoryInt return
    FLOAT case
      context [] .stackRegState .stackCountFloat 1 - =:: maxIndex
      stackIndex 0 < if
        "stack underflow" sb.wrap
        pos errors appendError
        AsmOperand .empty return
      end
      context [] .stackRegistersFloat =:: registers
      stackIndex maxIndex registers .count - <= if ## memory only
        stackIndex AsmOperand .stackMemoryFloat return
      end
      stackIndex registers .count % =:: regOffset
      context [] .stackRegState .activeStackRegistersFloat @ regOffset [] if
        registers .registers @ regOffset [] AsmOperand .register return
      end
      stackIndex AsmOperand .stackMemoryFloat return
  end
end
proc(
  AssemblyAtom list : asmOps
  StackRegisterType : registerType
  StackOperation : stackOp
  FilePosition : pos
  CompilerContext ptr mut : context
-> AssemblyAtom list Register ) =>: getStackRegister
  context [] .program [] .errors @ =:: errors
  registerType switch
    INT case
      context [] .stackRegState .stackCountInt
        stackOp switch
          DROP POP case
            1 - ..dup context [] .stackRegState .stackCountInt = break
          PUSH case
            ..dup 1 + context [] .stackRegState .stackCountInt = break
        end
      =:: intCount
      intCount 0 < if
        0 context [] .stackRegState .stackCountInt =
        "stack underflow" sb.wrap
        pos errors appendError
        asmOps Register.none return
      end
      context [] .stackRegistersInt =:: intRegisters
      intCount intRegisters .count % =:: regOffset
      intRegisters .registers @ regOffset [] =:: register
      asmOps
        context [] .stackRegState .activeStackRegistersInt @ regOffset [] if
          stackOp switch
            DROP POP case ## mark register as inactive
              false context [] .stackRegState .activeStackRegistersInt @ regOffset [] =
              break
            PUSH case ## store previous value
              ## asm.createBinary
                X64_OP .MOV
                intCount intRegisters .count - AsmOperand .stackMemoryInt
                register AsmOperand .register
              asm.createBinary AssemblyAtom .op list.append
              break
          end
        else
          stackOp switch
            DROP case break
            POP case ## load current value from memory
              ## asm.createBinary
                X64_OP .MOV
                register AsmOperand .register
                intCount AsmOperand .stackMemoryInt
              asm.createBinary AssemblyAtom .op list.append
              break
            PUSH case
              true context [] .stackRegState .activeStackRegistersInt @ regOffset [] =
              break
          end
        end
      register return
    FLOAT case
      context [] .stackRegState .stackCountFloat
        stackOp switch
          DROP POP case
            1 - ..dup context [] .stackRegState .stackCountFloat = break
          PUSH case
            ..dup 1 + context [] .stackRegState .stackCountFloat = break
        end
      =:: floatCount
      floatCount 0 < if
        0 context [] .stackRegState .stackCountFloat =
        "stack underflow" sb.wrap
        pos errors appendError
        asmOps Register.none return
      end
      context [] .stackRegistersFloat =:: floatRegisters
      floatCount floatRegisters .count % =:: regOffset
      floatRegisters .registers @ regOffset [] =:: register
      asmOps
        context [] .stackRegState .activeStackRegistersFloat @ regOffset [] if
          stackOp switch
            DROP POP case ## mark register as inactive
              false context [] .stackRegState .activeStackRegistersFloat @ regOffset [] =
              break
            PUSH case ## store previous value
              ## asm.createBinary
                X64_OP .MOV
                floatCount floatRegisters .count - AsmOperand .stackMemoryFloat
                register AsmOperand .register
              asm.createBinary AssemblyAtom .op list.append
              break
          end
        else
          stackOp switch
            DROP case break
            POP case ## load current value from memory
              ## asm.createBinary
                X64_OP .MOV
                register AsmOperand .register
                floatCount AsmOperand .stackMemoryFloat
              asm.createBinary AssemblyAtom .op list.append
              break
            PUSH case
              true context [] .stackRegState .activeStackRegistersFloat @ regOffset [] =
              break
          end
        end
      register return
  end
end

proc(
  AssemblyAtom list : asmOps
  StackRegisterType : registerType
  FilePosition : pos
  CompilerContext ptr mut : context
-> AssemblyAtom list Register ) =>: popRegister
  asmOps registerType StackOperation .POP pos context getStackRegister return
end
proc(
  StackRegisterType : registerType
  FilePosition : pos
  CompilerContext ptr mut : context
-> ) =>: dropRegister
  0 AssemblyAtom list.create
    registerType StackOperation .DROP pos context getStackRegister ..drop =:: asmOps
    asmOps .length 0 == assert "drop does not create operations"
  asmOps list.free ..drop
  return
end
## prepares the location for the next stack value selects next slot, stores previous value if necessary
proc(
  AssemblyAtom list : asmOps
  StackRegisterType : registerType
  FilePosition : pos
  CompilerContext ptr mut : context
-> AssemblyAtom list Register ) =>: preparePushRegister
  asmOps registerType StackOperation .PUSH pos context getStackRegister return
end

proc(
  AssemblyAtom list : asmOps
  StackRegisterType : registerType
  Register : src
  FilePosition : pos
  CompilerContext ptr mut : context
-> AssemblyAtom list ) =>: pushRegister
  asmOps
    registerType pos context preparePushRegister =:: target
    ## asm.createBinary
      X64_OP .MOV
      target AsmOperand .register
      src AsmOperand .register
    asm.createBinary AssemblyAtom .op list.append
  return
end

proc(
  ValueType : valType
-> StackRegisterType MAX_VALUE_REGISTERS array i8 ) =>: valTypeToStackRegisters
  StackRegisterType MAX_VALUE_REGISTERS array new =:: mut: registers
  valType switch
    EMPTY case registers 0:i8 return
    BITS128 case
      StackRegisterType .INT registers @ 0 [] =
      StackRegisterType .INT registers @ 1 [] =
      registers 2:i8 return
    BITSFF128 case
      StackRegisterType .FLOAT registers @ 0 [] =
      StackRegisterType .FLOAT registers @ 1 [] =
      registers 2:i8 return
    BITSFI128 case
      StackRegisterType .FLOAT registers @ 0 [] =
      StackRegisterType .INT registers @ 1 [] =
      registers 2:i8 return
    BITSIF128 case
      StackRegisterType .INT registers @ 0 [] =
      StackRegisterType .FLOAT registers @ 1 [] =
      registers 2:i8 return
    I32 BITS32 I64 PTR REFERENCE BITS64 BITS128L BITS128H case
      StackRegisterType .INT registers @ 0 [] =
      registers 1:i8 return
    F32 F64 BITSF32 BITSF64 BITSF128L BITSF128H case
      StackRegisterType .FLOAT registers @ 0 [] =
      registers 1:i8 return
  end
end

proc(
  FilePosition : pos
  CompilerContext ptr mut : context
-> ) =>: dropValue
  context [] .stackValues branchTree.depth 1 < if
    "stack underflow" sb.wrap
    pos context [] .program [] .errors @ appendError
    return
  end
  context [] .stackValues @ branchTree.pop .data [] .valType =:: valType
  valType valTypeToStackRegisters =:: regCount =:: regTypes
  0 while ..dup regCount < do =:: i
    regTypes @ i [] pos context dropRegister
    i 1 +
  end ..drop
end


proc(
  AssemblyAtom list : asmOps
  FilePosition : pos
  CompilerContext ptr mut : context
-> AssemblyAtom list ValueType RegisterValue ) =>: popValue
  Register MAX_VALUE_REGISTERS array new =:: mut: registers
  context [] .stackValues branchTree.depth 1 < if
    "stack underflow" sb.wrap
    pos context [] .program [] .errors @ appendError
    asmOps ValueType .EMPTY registers 0:i8 RegisterValue new return
  end
  context [] .stackValues @ branchTree.pop .data [] .valType =:: valType
  valType valTypeToStackRegisters =:: regCount =:: regTypes
  asmOps
    0 while ..dup regCount < do =:: i
      regTypes @ i [] pos context popRegister registers @ i [] =
      i 1 +
    end ..drop
  valType registers regCount RegisterValue new return
end

## push order chosen to simulate downwards growing stack
proc(
  AssemblyAtom list : asmOps
  ValueType : valType
  FilePosition : pos
  CompilerContext ptr mut : context
-> AssemblyAtom list RegisterValue ) =>: preparePushValue
  context [] .stackValues @
    context [] .stackRegState .stackCountInt
    context [] .stackRegState .stackCountFloat
    valType
  StackRegisterValue new branchTree.push
  Register MAX_VALUE_REGISTERS array new =:: mut: registers
  valType valTypeToStackRegisters =:: regCount =:: regTypes
  asmOps
    regCount 1 - while ..dup 0 >= do =:: i
      regTypes @ i [] pos context preparePushRegister registers @ i [] =
      i 1 -
    end ..drop
  registers regCount RegisterValue new return
end
proc(
  AssemblyAtom list : asmOps
  ValueType : valType
  RegisterValue : data
  FilePosition : pos
  CompilerContext ptr mut : context
-> AssemblyAtom list ) =>: pushValue
  context [] .stackValues @
    context [] .stackRegState .stackCountInt
    context [] .stackRegState .stackCountFloat
    valType
  StackRegisterValue new branchTree.push
  data .registers =:: registers
  valType valTypeToStackRegisters =:: regCount =:: regTypes
  asmOps
    regCount 1 - while ..dup 0 >= do =:: i
      regTypes @ i [] registers @ i [] pos context pushRegister
      i 1 -
    end ..drop
  return
end
## load value stored at location given by src into the target registers
## the source register can overlap with one of the target registers the target registers are assumed to be non-overlapping
proc(
  AssemblyAtom list : asmOps
  Register : src
  ValueType : valType
  RegisterValue : target
  FilePosition : pos
  CompilerContext ptr mut : context
-> AssemblyAtom list ) =>: loadValue
  target .registers =:: registers
  valType switch
    EMPTY case asmOps return
    BITS128 BITSFF128 BITSIF128 BITSFI128 case
      target .registerCount 2 == assert "correct register count"
      asmOps
        registers @ 0 [] .id src .id != if
          ## asm.createBinary
            X64_OP .MOV
            registers @ 0 [] AsmOperand .register
            src AsmOperand .registerPtr
          asm.createBinary AssemblyAtom .op list.append
        end
        ## asm.createTrinary
          X64_OP .MOV
          registers @ 1 [] AsmOperand .register
          src AsmOperand .registerPtrOffset
          8 AsmOperand .value
        asm.createTrinary AssemblyAtom .op list.append
        registers @ 0 [] .id src .id == if
          ## asm.createBinary
            X64_OP .MOV
            registers @ 0 [] AsmOperand .register
            src AsmOperand .registerPtr
          asm.createBinary AssemblyAtom .op list.append
        end
      return
    I32 I64 F32 F64 PTR REFERENCE
        BITS32 BITS64 BITS128L BITS128H
        BITSF32 BITSF64 BITSF128L BITSF128H case
      target .registerCount 1 == assert "correct register count"
      asmOps
        ## asm.createBinary
          X64_OP .MOV
          registers @ 0 [] AsmOperand .register
          src AsmOperand .registerPtr
        asm.createBinary AssemblyAtom .op list.append
      return
  end
end
## store value in src-registers at memory location given by target register
proc(
  AssemblyAtom list : asmOps
  RegisterValue : src
  ValueType : valType
  Register : target
  FilePosition : pos
  CompilerContext ptr mut : context
-> AssemblyAtom list ) =>: storeValue
  src .registers =:: registers
  valType switch
    EMPTY case
      src .registerCount 0 == assert "correct register count" asmOps return
    BITS128 BITSFF128 BITSIF128 BITSFI128 case
      src .registerCount 2 == assert "correct register count"
      asmOps
        registers @ 0 [] .id target .id != if
          ## asm.createBinary
            X64_OP .MOV
            target AsmOperand .registerPtr
            registers @ 0 [] AsmOperand .register
          asm.createBinary AssemblyAtom .op list.append
        end
        ## asm.createTrinary
          X64_OP .MOV
          target AsmOperand .registerPtrOffset
          8 AsmOperand .value
          registers @ 1 [] AsmOperand .register
        asm.createTrinary AssemblyAtom .op list.append
        registers @ 0 [] .id target .id == if
          ## asm.createBinary
            X64_OP .MOV
            target AsmOperand .registerPtr
            registers @ 0 [] AsmOperand .register
          asm.createBinary AssemblyAtom .op list.append
        end
      return
    I32 I64 F32 F64 PTR REFERENCE
        BITS32 BITS64 BITS128L BITS128H
        BITSF32 BITSF64 BITSF128L BITSF128H case
      src .registerCount 1 == assert "correct register count"
      asmOps
        ## asm.createBinary
          X64_OP .MOV
          target AsmOperand .registerPtr
          registers @ 0 [] AsmOperand .register
        asm.createBinary AssemblyAtom .op list.append
      return
  end
end

{
  Register.x64.rdi Register.x64.rsi Register.x64.rdx
  Register.x64.rcx Register.x64.r8  Register.x64.r9
} =:: SYSTEM_V_INT_ARGS
{
  Register.x64.xmm0 Register.x64.xmm1 Register.x64.xmm2
  Register.x64.xmm3 Register.x64.xmm4 Register.x64.xmm5
  Register.x64.xmm6 Register.x64.xmm7
} =:: SYSTEM_V_FLOAT_ARGS
struct(
  AsmOperand MAX_VALUE_REGISTERS array : locations
  i8 : count
) =:: ArgumentLocation
## get storage location of arguments when using System-V calling convention
proc(
  Type arrayView : inTypes
  i64 : outArgsCount
  Type : retType
  TypeContext ptr mut : typeContext
->
  ArgumentLocation list : argLocs AsmOperand : retArgument
) =>: getProcedureArgumentLocations
  0 =:: mut: intArgs
  0 =:: mut: floatArgs
  0 =:: mut: stackOffset
  retType typeContext types.isSmallType if
    AsmOperand .empty
  else
    ## store return pointer for last return value in first argument
    SYSTEM_V_INT_ARGS@ intArgs [] AsmOperand .register
    intArgs 1 + intArgs =
  end =:: retArgument
  ## list.create
    intArgs inTypes .length + outArgsCount +
  ArgumentLocation list.create =:: mut: argLocations
  AsmOperand MAX_VALUE_REGISTERS array new =:: mut: locations
  0 while ..dup inTypes .length < do =:: i
    inTypes i array.get typeContext toValueType
      valTypeToStackRegisters
    =:: count =:: registers
    0 =:: mut: argInts
    0 =:: mut: argFloats
    0 while ..dup count < do =:: j
      registers@ j [] switch
        INT case
          argInts 1 + argInts =
          break
        FLOAT case
          argFloats 1 + argFloats =
          break
      end
      j 1 +
    end ..drop
    ## argument does not fits into registers
    intArgs argInts + SYSTEM_V_INT_ARGS ..length >
        floatArgs argFloats + SYSTEM_V_FLOAT_ARGS ..length > | if
      ## XXX? handle values with higher alignment?
      0 while ..dup count < do =:: j
        stackOffset AsmOperand .stackArgument locations@ j [] =
        stackOffset 8 + stackOffset =
        j 1 +
      end ..drop
    else
      count 1 - while ..dup 0 >= do =:: j
        registers@ j [] switch
          INT case
            SYSTEM_V_INT_ARGS@ intArgs [] AsmOperand .register locations@ j [] =
            intArgs 1 + intArgs =
            j 1 - continue
          FLOAT case
            SYSTEM_V_FLOAT_ARGS@ floatArgs [] AsmOperand .register locations@ j [] =
            floatArgs 1 + floatArgs =
            j 1 - continue
        end
        ..unreachable
      end ..drop
    end
    argLocations
      ## ArgumentLocation
        locations
        count
      ArgumentLocation new list.append
    argLocations =
    i 1 +
  end ..drop
  ## out args
  0 while ..dup outArgsCount < do =:: i
    ## argument does not fits into registers
    intArgs SYSTEM_V_INT_ARGS ..length < if
      SYSTEM_V_INT_ARGS@ intArgs [] AsmOperand .register locations@ 0 [] =
      intArgs 1 + intArgs =
    else
      stackOffset AsmOperand .stackArgument locations@ 0 [] =
      stackOffset 8 + stackOffset =
    end
    argLocations
      ## ArgumentLocation
        locations 1:i8
      ArgumentLocation new list.append
    argLocations =
    i 1 +
  end ..drop
  argLocations retArgument return
end

proc(
  AssemblyAtom list : asmOps
  Type : src
  Type : target
  ## TODO pass source/target registers
  FilePosition : pos
  CompilerContext ptr mut : context
-> AssemblyAtom list ) =>: castNumbers
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  src typeContext types.primitiveValue =:: fromVal
  target typeContext types.primitiveValue =:: toVal
  fromVal toVal == if
    ## TODO move value if source and target register are different
    asmOps return ## identical types -> no change
  end
  src typeContext types.isInt target typeContext types.isInt & if
    src typeContext types.primitiveValue types.sizeOfPrimitive =:: srcPrec
    target typeContext types.primitiveValue types.sizeOfPrimitive =:: targetPrec
    targetPrec srcPrec <= if
      asmOps return ## downcast -> nothing to do
    else
      asmOps
        ## asm.createUnary
          src typeContext types.isUnsignedInt if
            X64_OP .EXTZ ## u -> i,s,u
          else src typeContext types.isSignedInt ! and
              target typeContext types.isUnsignedInt _if
            X64_OP .EXTZ ## i -> u
          else ## s -> i,s,u / i -> i,s
            X64_OP .EXTS
          end
          Register.x64.rax AsmOperand .register
          ## TODO source&target size, remember size
        asm.createUnary AssemblyAtom .op list.append
      return
    end
  ## case 2: float -> float/int
  else fromVal .F32 ?? or fromVal .F64 ?? _if
    toVal switch ## TODO handle overflow in float->int conversion
      F32 case
        ## TODO F64 -> F32
        ## TRUNCF
        break
      F64 case
        ## TODO F32 -> F64
        ## EXTF
        break
      I8 I16 I32 I64 S8 S16 S32 S64 case
        ## TODO float -> int
        ## 1. FTOI
        ## 2. truncate to correct size
        break
      U8 U16 U32 U64 case
        ## TODO float -> uint
        ## 1. FTOUI
        ## 2. truncate to correct size
        break
      BOOL TYPE case ..unreachable
    end
  ## case 3: int -> float
  else ## TODO sign/zero extend 8&16 bit types before conversion
    ## TODO int -> float
    ## 1. sign/zero extend to 64-bits
    ## 2. ITOF / UITOF
  end
  "unsupported cast:" sb.wrap
  src typeContext sb.appendType
  " to " sb.appendS
  target typeContext sb.appendType
  pos errors appendError
  asmOps return
end

proc(
  AssemblyAtom list : asmOps
  Type : src
  Type : target
  ## TODO source/target register
  FilePosition : pos
  CompilerContext ptr mut : context
-> AssemblyAtom list ) =>: bitcastNumbers
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  src typeContext types.primitiveValue =:: fromVal
  target typeContext types.primitiveValue =:: toVal
  ## sizes of arguments scaled to bits
  fromVal types.sizeOfPrimitive 8 * =:: fromSize
  toVal types.sizeOfPrimitive 8 * =:: toSize
  ## TODO move if source and target registers are different
  fromVal toVal == if
    asmOps return
  end
  ## XXX? support for bit-casts between small structures
  ## TODO implement bit-cast
  ## 1. move float->int
  ## 2. zero extend/truncate to right number of bits
  ## 3. move int > float
  ## XXX? is is possible to zero-extend a 32-bit float in place
  "unsupported bit-cast:" sb.wrap
  src typeContext sb.appendType
  " to " sb.appendS
  target typeContext sb.appendType
  pos errors appendError
  asmOps return
end

enum( autoCast Cast Cast! bitCast ) =:: CastType
proc(
  AssemblyAtom list : asmOps
  CastType : castType
  Type : src0
  i32 : offset
  Type : target0
  FilePosition : pos
  CompilerContext ptr mut : context
-> AssemblyAtom list ) =>: compileCast
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  ## XXX? better cType <-> type conversion
  src0 typeContext types.unwrapNamed
    ..dup .cType ?? if .cType types.cTypeAsType end
  =:: src
  target0 typeContext types.unwrapNamed
    ..dup .cType ?? if .cType types.cTypeAsType end
  =:: target
  src target types.typeEquals if
    asmOps return ## nothing to do
  end
  ## TODO correctly update registers
  ## ! handle stack shifts for size changes
  src typeContext types.isNumber target .arrayIndex ?? & if
    ## isNumber returns true for array index
    ##   -> have to check for cast to array index before checking for cast to number
    asmOps
      ## castNumbers
        src
        types.primitive.I_SIZE
      pos context  castType .bitCast ?? if bitcastNumbers else castNumbers end
      target typeContext types.getArraySize 0 array.get =:: size
      ## TODO check index
    return
  end
  src typeContext types.isNumber target typeContext types.isNumber & if
    asmOps
      src
      target
    pos context  castType .bitCast ?? if bitcastNumbers else castNumbers end
    return
  end
  src typeContext types.isPointer target typeContext types.isPointer & if
    asmOps return ## nothing to do
  end
  src typeContext types.isInt target typeContext types.isPointer & if
    ## src -> I_PTR ~ ptr
    asmOps
      ## castNumbers
        src
        types.primitive.I_PTR
      pos context  castType .bitCast ?? if bitcastNumbers else castNumbers end
    return
  end
  src typeContext types.isPointer target typeContext types.isInt & if
    ## ptr ~ I_PTR -> target
    asmOps
      ## castNumbers
        types.primitive.I_PTR
        target
      pos context  castType .bitCast ?? if bitcastNumbers else castNumbers end
    return
  end
  src typeContext types.isReference and target typeContext types.isReference ! if
    src typeContext types.getBaseType typeContext types.unwrapNamed =:: baseType
    asmOps
      ## 1. load reference
      ## 2. cast value
      baseType target types.typeEquals ! if
        ## compileCast
          castType
          baseType
          offset
          target
          pos
          context
        compileCast
      end
    return
  end
  target typeContext types.isUnion if
    ## TODO check if source is subset of union
    asmOps
      ## TODO convert source to union
    return
  end
  "casting from " sb.wrap
    src typeContext sb.appendType
    " to " sb.appendS
    target typeContext sb.appendType
    " is not implemented" sb.appendS
  pos errors appendError
  asmOps return
end

proc(
  AssemblyAtom list : asmOps
  X64_OP : opType
  FilePosition : pos
  CompilerContext ptr mut : context
-> AssemblyAtom list ) =>: appendUnaryOperator
  context [] .stackValues branchTree.depth 1 < if
    "stack underflow" sb.wrap
    pos context [] .program [] .errors @ appendError
    asmOps return
  end
  asmOps
    pos context popValue =:: regData =:: topVal
    regData .registerCount 1 == assert "operators act on single registers"
    ## asm.createUnary
      opType
      regData .registers @ 0 [] AsmOperand .register
    asm.createUnary AssemblyAtom .op list.append
    ## TODO ensure correct output register is used
    topVal regData pos context pushValue
  return
end

proc(
  AssemblyAtom list : asmOps
  X64_OP : opType
  FilePosition : pos
  CompilerContext ptr mut : context
-> AssemblyAtom list ) =>: appendBinaryOperator
  context [] .program [] .errors @ =:: errors
  context [] .stackValues branchTree.depth 2 < if
    "stack underflow" sb.wrap
    pos errors appendError
    asmOps return
  end
  asmOps
    pos context popValue =:: regId2 =:: arg2
    pos context popValue =:: regId1 =:: arg1
    regId1 .registerCount 1 != regId2 .registerCount 1 != | if
      "unexpected operand sizes for binary operation: " sb.wrap
        regId1 .registerCount sb.appendI
        " and " sb.appendS
        regId2 .registerCount sb.appendI
      pos errors appendError
      return
    end
    arg1 arg2 != if
      "incompatible argument types: " sb.wrap
        arg1 sb.appendValueType
        " and " sb.appendS
        arg2 sb.appendValueType
      pos errors appendError
    end
    ## asm.createBinary
      opType
      regId1 .registers @ 0 [] AsmOperand .register
      regId2 .registers @ 0 [] AsmOperand .register
    asm.createBinary AssemblyAtom .op list.append
    ## XXX! determine target register of operation
    arg1 regId1 pos context pushValue
  return
end


proc(
  AssemblyAtom list : asmOps
  X64_OP : setCmpFlag
  FilePosition : pos
  CompilerContext ptr mut : context
-> AssemblyAtom list ) =>: appendComparissonOperator
  context [] .stackValues branchTree.depth 2 < if
    "stack underflow" sb.wrap
    pos context [] .program [] .errors @ appendError
    asmOps return
  end
  asmOps
    pos context popValue =:: regId2 =:: arg2
    pos context popValue =:: regId1 =:: arg1
    ValueType .I32 pos context preparePushValue =:: regOut
    regOut .registerCount 1 == assert "correct register-count for bool"
    regId1 .registerCount 1 == assert "operators act on single registers"
    regId2 .registerCount 1 == assert "operators act on single registers"
    arg1 arg2 != if
      "incompatible argument types: " sb.wrap
        arg1 sb.appendValueType
        " and " sb.appendS
        arg2 sb.appendValueType
      pos context [] .program [] .errors @ appendError
    end
    ## asm.createUnary
      X64_OP .CMP
      regId1 .registers @ 0 [] AsmOperand .register
      regId2 .registers @ 0 []  AsmOperand .register
    asm.createBinary AssemblyAtom .op list.append
    ## asm.createUnary
      setCmpFlag
      regOut .registers @ 0 [] AsmOperand .register
    asm.createUnary AssemblyAtom .op list.append
  return
end
proc(
  AssemblyAtom list : asmOps
  BuiltIn : builtIn
  Type : opType
  FilePosition : pos
  CompilerContext ptr mut : context
-> AssemblyAtom list ) =>: appendBuiltInAsm
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  opType typeContext types.getProcIn ..drop =:: inType
  inType 0 typeContext types.compositeGetLabel
      labelContext id.labelFlags id.FLAG_STATIC & ? if
    1
  else
    0
  end =:: firstArg
  inType firstArg typeContext types.compositeGetElement =:: baseType
  builtIn switch
    NEG_I8 NEG_I16 NEG_I32 NEG_I64 case
      asmOps X64_OP .NEG pos context appendUnaryOperator return
    NEG_F32 NEG_F64 case break
    ADD_I8 ADD_I16 ADD_I32 ADD_I64 case
      asmOps X64_OP .ADD pos context appendBinaryOperator return
    ADD_F32 ADD_F64 case break
    ADD_PTR ADD_PTR_MUT SUB_PTR SUB_PTR_MUT case break
    SUB_I8 SUB_I16 SUB_I32 SUB_I64 case
      asmOps X64_OP .SUB pos context appendBinaryOperator return
    SUB_F32 SUB_F64 case break
    PTR_DIFF case break
    MUL_I32 MUL_I64 case
      asmOps X64_OP .SMUL pos context appendBinaryOperator return
    MUL_F32 MUL_F64 case break
    DIV_I32 DIV_I64 case
      asmOps X64_OP .SDIV pos context appendBinaryOperator return
    DIV_F32 DIV_F64 case break
    REM_I32 REM_I64 case
      asmOps X64_OP .SREM pos context appendBinaryOperator return
    UDIV_I32 UDIV_I64 case
      asmOps X64_OP .DIV pos context appendBinaryOperator return
    UMOD_I32 UMOD_I64 case
      asmOps X64_OP .REM pos context appendBinaryOperator return
    NOT_BOOL case break
    FLIP_I8 FLIP_I16 FLIP_I32 FLIP_I64 case
      asmOps X64_OP .NEG pos context appendUnaryOperator return
    AND_BOOL AND_I8 AND_I16 AND_I32 AND_I64 case
      asmOps X64_OP .AND pos context appendBinaryOperator return
    OR_BOOL OR_I8 OR_I16 OR_I32 OR_I64 case
      asmOps X64_OP .OR pos context appendBinaryOperator return
    XOR_BOOL XOR_I8 XOR_I16 XOR_I32 XOR_I64 case
      asmOps X64_OP .XOR pos context appendBinaryOperator return
    LSHR_I8 LSHR_I16 case
      ## TODO compare small values
      asmOps X64_OP .SHR pos context appendBinaryOperator return
    LSHR_I32 LSHR_I64 case
      asmOps X64_OP .SHR pos context appendBinaryOperator return
    ASHR_I8 ASHR_I16 case
      ## TODO compare small values
      asmOps X64_OP .SAR pos context appendBinaryOperator return
    ASHR_I32 ASHR_I64 case
      asmOps X64_OP .SAR pos context appendBinaryOperator return
    SHL_I8 SHL_I16 SHL_I32 SHL_I64 case
      asmOps X64_OP .SHL pos context appendBinaryOperator return
    BOOL_I8 BOOL_I16 BOOL_I32 BOOL_I64 BOOL_F32 BOOL_F64 case break
    LT_I8 LT_I16 case
      ## TODO compare small values
      asmOps X64_OP .SETL pos context appendComparissonOperator return
    LT_I32 LT_I64 LT_PTR case
      asmOps X64_OP .SETL pos context appendComparissonOperator return
    LE_I8 LE_I16 case
      ## TODO compare small values
      asmOps X64_OP .SETLE pos context appendComparissonOperator return
    LE_I32 LE_I64 LE_PTR case
      asmOps X64_OP .SETLE pos context appendComparissonOperator return
    GE_I8 GE_I16 case
      ## TODO compare small values
      asmOps X64_OP .SETGE pos context appendComparissonOperator return
    GE_I32 GE_I64 GE_PTR case
      asmOps X64_OP .SETGE pos context appendComparissonOperator return
    GT_I8 GT_I16 case
      ## TODO compare small values
      asmOps X64_OP .SETG pos context appendComparissonOperator return
    GT_I32 GT_I64 GT_PTR case
      asmOps X64_OP .SETG pos context appendComparissonOperator return
    LT_F32 LT_F64 case break
    LE_F32 LE_F64 case break
    GE_F32 GE_F64 case break
    GT_F32 GT_F64 case break
    ULT_I8 ULT_I16 case
      ## TODO compare small values
      asmOps X64_OP .SETB pos context appendComparissonOperator return
    ULT_I32 ULT_I64 case
      asmOps X64_OP .SETB pos context appendComparissonOperator return
    ULE_I8 ULE_I16 case
      ## TODO compare small values
      asmOps X64_OP .SETBE pos context appendComparissonOperator return
    ULE_I32 ULE_I64 case
      asmOps X64_OP .SETBE pos context appendComparissonOperator return
    UGE_I8 UGE_I16 case
      ## TODO compare small values
      asmOps X64_OP .SETAE pos context appendComparissonOperator return
    UGE_I32 UGE_I64 case
      asmOps X64_OP .SETAE pos context appendComparissonOperator return
    UGT_I8 UGT_I16 case
      ## TODO compare small values
      asmOps X64_OP .SETA pos context appendComparissonOperator return
    UGT_I32 UGT_I64 case
      asmOps X64_OP .SETA pos context appendComparissonOperator return
  end
  "unable to compile built-in: " sb.wrap
    builtIn sb.appendBuiltIn
  pos errors appendError
  asmOps return
end

proc(
  AssemblyAtom list : asmOps
  Operation ptr : op
  CompilerContext ptr mut : context
-> AssemblyAtom list ) =>: compileOp
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  op [] .val switch
    NOP case
      asmOps return
    Constant case
      asmOps
        op [] .dataType
        op [] .val .Constant
        op [] .pos
        context
      pushConstant
      return
    implementProcedure case
      op [] .val .implementProcedure =:: implId
      prog [] .procedures implId .procId i64 cast list.at .data =:: procData
      implId .implementationId 0 >= if
        procData [] .implementation .code .implementations
          implId .implementationId list.at .data =:: impl
        impl [] .variables
        impl [] .procType
      else
        procData [] .implementation .code .variables
        procData [] .procType
      end =:: procType =:: variables
      procType typeContext types.getProcIn
        ! assert "procedure has arguments"
      =:: inType
      procType typeContext types.getProcOutArgs
        ! assert "procedure has arguments"
      =:: outArgs
      procType typeContext types.getProcRet
        ! assert "procedure has arguments"
      =:: retType
      inType typeContext types.compositeEltArray =:: inTypes
      inTypes .length =:: argCount
      ## getProcedureArgumentLocations
        inTypes
        outArgs .length
        retType
        typeContext
      getProcedureArgumentLocations =:: retArg =:: argLocs
      asmOps
        ## GlobalLabel
          procData [] .labelId
          implId .implementationId
        GlobalLabel new AssemblyAtom .globalLabel list.append
        ## TODO make stack frame dependent on calling convention
        ## asm.createUnary
          X64_OP .PUSH
          Register.fp AsmOperand .register
        asm.createUnary AssemblyAtom .op list.append
        ## asm.createBinary
          X64_OP .MOV
          Register.fp AsmOperand .register
          Register.sp AsmOperand .register
        asm.createBinary AssemblyAtom .op list.append
        ## XXX store callee saved registers
        ## declare local variables
        0 while ..dup variables .length < do =:: i
          variables i list.get =:: varInfo
          varInfo .varType typeContext types.alignOf =:: varAlignment
          varInfo .varType typeContext types.sizeOf =:: varSize
          varSize switch
            fixed case
              ## asm.createTrinary
                X64_OP .ALLOC
                varInfo .label AsmOperand .localVariable
                varAlignment .fixed AsmOperand .value
                varSize .fixed AsmOperand .value
              asm.createTrinary AssemblyAtom .op list.append
              break
            dynamicArray case ## XXX? store dynamic arrays no separate stack
              "dymnamic-size arrays are not supported" sb.wrap
              op [] .pos errors appendError
              break
            unknown case
              "could not determine size of type:" sb.wrap
                varInfo .varType typeContext sb.appendType
              op [] .pos errors appendError
              break
          end
          i 1 +
        end ..drop
        context [] .tmpRegistersInt .registers @ 0 [] =:: tmpRegister
        ## remember output arguments
        retArg .empty ?? ! if
          ## asm.createBinary
            X64_OP .MOV
            tmpRegister AsmOperand .register
            retArg
          asm.createBinary AssemblyAtom .op list.append
          ## asm.createBinary
            X64_OP .MOV
            outArgs .length AsmOperand .outputArgument
            tmpRegister AsmOperand .register
          asm.createBinary AssemblyAtom .op list.append
        end
        0 while ..dup outArgs .length < do =:: i
          argLocs i argCount + list.get =:: eltLoc
          ## asm.createBinary
            X64_OP .MOV
            tmpRegister AsmOperand .register
            eltLoc .locations@ 0 []
          asm.createBinary AssemblyAtom .op list.append
          ## asm.createBinary
            X64_OP .MOV
            i AsmOperand .outputArgument
            tmpRegister AsmOperand .register
          asm.createBinary AssemblyAtom .op list.append
          i 1 +
        end ..drop
        ## load procedure arguments
        0 while ..dup argCount < do =:: i
          inType i typeContext types.compositeGetLabel =:: eltLabel
          inTypes i array.get =:: eltType
          argLocs i list.get =:: eltLoc
          ## preparePushValue
            eltType typeContext toValueType
            op [] .pos
          context preparePushValue =:: registers
          eltLoc .count registers .registerCount == assert "consistent number of registers"
          0 while ..dup eltLoc .count < do =:: j
            ## asm.createBinary
              X64_OP .MOV
              registers .registers@ j [] AsmOperand .register
              eltLoc .locations@ j []
            asm.createBinary AssemblyAtom .op list.append
            j 1 +
          end ..drop
          eltLabel id.LABEL_ID_NONE == if
            i 1 + continue
          end
          ## popValue
            op [] .pos
          context popValue =:: regId =:: valueType
          ## asm.createTrinary
            X64_OP .LEA
            tmpRegister AsmOperand .register
            eltLabel AsmOperand .localVariable
          asm.createBinary AssemblyAtom .op list.append
          op [] .dataType typeContext types.referenceOnly if
            valueType .REFERENCE ?? ! if
              "stack out of sync" sb.wrap
              op [] .pos errors appendError
              return
            end
            regId .registerCount 1 == assert "correct number of registers"
            ## XXX? check if size is fixed
            ## asm.createTrinary
              X64_OP .COPY
              tmpRegister AsmOperand .register
              regId .registers@ 0 [] AsmOperand .register
              op [] .dataType typeContext types.sizeOf .fixed AsmOperand .value
            asm.createTrinary AssemblyAtom .op list.append
            return
          end
          ## storeValue
            regId
            valueType
            tmpRegister
            op [] .pos
            context
          storeValue
          i 1 +
        end ..drop
        argLocs list.free ..drop
      return
    declareId case
      ## all variables declarations are handled at start of procedure
      asmOps return
    initializeId case
      op [] .val .initializeId =:: idInfo
      idInfo .idType switch
        LOCAL_VAR TMP_VAR case
          context [] .tmpRegistersInt .registers @ 0 [] =:: tmpRegister
          asmOps
            ## popValue
              op [] .pos
            context popValue =:: regId =:: valueType
            op [] .dataType typeContext toValueType valueType == assert "stack-val=op-val"
            ## XXX extract to function for getting variable offset
            ## asm.createTrinary
              X64_OP .LEA
              tmpRegister AsmOperand .register
              idInfo .labelId AsmOperand .localVariable
            asm.createBinary AssemblyAtom .op list.append
            op [] .dataType typeContext types.referenceOnly if
              valueType .REFERENCE ?? ! if
                "stack out of sync" sb.wrap
                op [] .pos errors appendError
                return
              end
              regId .registerCount 1 == assert "correct number of registers"
              ## XXX? check if size is fixed
              ## asm.createTrinary
                X64_OP .COPY
                tmpRegister AsmOperand .register
                regId .registers@ 0 [] AsmOperand .register
                op [] .dataType typeContext types.sizeOf .fixed AsmOperand .value
              asm.createTrinary AssemblyAtom .op list.append
              return
            end
            ## storeValue
              regId
              valueType
              tmpRegister
              op [] .pos
              context
            storeValue
          return
        break
        ARGUMENT GLOBAL_VAR TYPE PROCEDURE PROCEDURE_BUNDLE
            LABEL case break
      end
      break
    atId getId case
      op [] .val .atId ?? =:: isPtr
      isPtr if
        op [] .val .atId
      else
        op [] .val .getId
      end =:: idInfo
      idInfo .idType switch
        LOCAL_VAR TMP_VAR ARGUMENT case
          asmOps
            ## preparePushValue
              isPtr if
                ValueType .PTR
              else
                ValueType .REFERENCE
              end
              op [] .pos
            context preparePushValue =:: target
            target .registerCount 1 == assert "correct register count for pointer"
            ## asm.createTrinary
              X64_OP .LEA
              target .registers @ 0 [] AsmOperand .register
              idInfo .labelId AsmOperand .localVariable
            asm.createBinary AssemblyAtom .op list.append
            isPtr ! and idInfo .idType .ARGUMENT ?? if
              op [] .pos context popValue =:: src =:: srcType
              srcType ValueType .REFERENCE == assert "variable is reference"
              src .registerCount 1 == assert "correct register count for reference"
              op [] .dataType typeContext toValueType =:: targetType
              targetType op [] .pos context preparePushValue =:: newValue
              ##loadValue
                src .registers @ 0 []
                targetType
                newValue
                op [] .pos
                context
              loadValue
            end
          return
        break
        GLOBAL_VAR case break
        TYPE PROCEDURE PROCEDURE_BUNDLE LABEL case break
      end
      break
    setValue case
      asmOps
        op [] .pos context popValue =:: targetReg =:: refValue
        refValue ValueType .REFERENCE == assert "copy argument is reference"
        targetReg .registerCount 1 == assert "pointer sorted in one register"
        ## popValue
          op [] .pos
          context
        popValue =:: srcRegs =:: valueType
        ## TODO add assertion back in once compiler is stable
        ## op [] .dataType typeContext toValueType valueType == assert "stack-value=op-value"
        ## storeValue
          srcRegs
          valueType
          targetReg .registers @ 0 []
          op [] .pos
          context
        storeValue
      return
    procPtr
    getArrayElement atArrayElement
    getElement atElement case break
    copy case
      asmOps
        op [] .pos context popValue =:: srcReg =:: refValue
        refValue ValueType .REFERENCE == assert "copy argument is reference"
        srcReg .registerCount 1 == assert "pointer sorted in one register"
        op [] .dataType
          typeContext types.unwrapReference
        typeContext toValueType =:: valueType
        valueType .REFERENCE ?? ! assert "no copy to reference"
        valueType op [] .pos context preparePushValue =:: targetRegisters
        ## loadValue
          srcReg .registers @ 0 []
          valueType
          targetRegisters
          op [] .pos
          context
        loadValue
      return
    New NewEnum
    checkEnumLabel setEnumLabel hasElement
    autoCast Cast Cast! bitCast
    call callPtr case break
    builtIn case
      asmOps
        op [] .val .builtIn
        op [] .dataType
        op [] .pos
        context
      appendBuiltInAsm
      return
    equalityOperator
    argc getArg case break
    block case
      op [] .val .block .blockType switch
        ## TODO implement and/or
        IF case
          asmOps
            ## TODO debug position
            op [] .pos context popValue =:: regData =:: ifCond
            ifCond ValueType .I32 == assert "if-condition is bool"
            regData .registerCount 1 == assert "bool takes one register"
            regData .registers @ 0 [] =:: condRegister
            ## asm.createBinary
              X64_OP .TEST
              condRegister AsmOperand .register
              condRegister AsmOperand .register
            asm.createBinary AssemblyAtom .op list.append
            ## asm.createUnary
              X64_OP .JNZ
              ## LocalLabel
                BranchType .ELSE
                op [] .val .block .blockId
                op [] .val .block .subId
              LocalLabel new AsmOperand .localLabel
            asm.createUnary AssemblyAtom .op list.append
            op [] .val .block .blockId context openIfBlock
          return
        IFIF case
          context [] .openBlocks list.peek .data =:: ifBlock
          asmOps
            ## TODO debug position
            op [] .pos context popValue =:: regData =:: ifCond
            ifCond ValueType .I32 == assert "if-condition is bool"
            regData .registerCount 1 == assert "bool takes one register"
            regData .registers @ 0 [] =:: condRegisterSrc
            context [] .tmpRegistersInt .registers @ 0 [] =:: condRegister
            ## asm.createBinary
              X64_OP .MOV
              condRegister AsmOperand .register
              condRegisterSrc AsmOperand .register
            asm.createBinary AssemblyAtom .op list.append
            ifBlock [] .If .rootStackRegs op [] .pos context resetStackRegisters
            ## asm.createBinary
              X64_OP .TEST
              condRegister AsmOperand .register
              condRegister AsmOperand .register
            asm.createBinary AssemblyAtom .op list.append
            ## asm.createUnary
              X64_OP .JNZ
              ## LocalLabel
                BranchType .ELSE
                op [] .val .block .blockId
                op [] .val .block .subId
              LocalLabel new AsmOperand .localLabel
            asm.createUnary AssemblyAtom .op list.append

            ifBlock [] .If .ififBranches
              context [] .stackValues @ branchTree.startBranch list.append
            ifBlock [] .If .ififBranches =
          return
          break
        AND_IF OR_IF case break
        ELSE case
          context [] .openBlocks list.peek .data =:: ifBlock
          context [] .stackValues @ ifBlock [] .If .branchRoot branchTree.reset =:: ifBranch
          context [] .reachable ifBlock [] .If .ifBranchTerminates =
          ## BranchPoint
          ifBranch ifBlock [] .If .ifBranch =
          asmOps
            context [] .reachable if
              ..dup .length ifBlock [] .If .ifBranchCodeOffset =
              context reserveStackRegSpace
              context [] .stackRegState ifBlock [] .If .ifBranchRegs =
              ## asm.createUnary
                X64_OP .JMP
                ## LocalLabel
                  BranchType .END_IF
                  op [] .val .block .blockId
                  op [] .val .block .subId
                LocalLabel new AsmOperand .localLabel
              asm.createUnary AssemblyAtom .op list.append
            end
            ifBlock [] .If .rootStackRegs context [] .stackRegState =
            ## LocalLabel
              BranchType .ELSE
              op [] .val .block .blockId
              op [] .val .block .subId
            LocalLabel new AssemblyAtom .localLabel list.append
            true context [] .reachable =
          =:: newOps
          ifBlock [] .If .ififBranches .length 1 >= if
            ## mergeValues
              context [] .stackValues @
              ifBlock [] .If .ififBranches list.asArray
              mergeBranches @
              ## MergePoint
                "if _if" string.wrap
                ifBlock [] .If .blockId
                op [] .pos
                context
              MergePoint new
            branchTree.merge .error ?? if
              "could not merge if _if branches" sb.wrap
              op [] .pos errors appendError
            end
          end
          newOps return
        SWITCH case
          op [] .val .block .blockId =:: switchId
          prog [] .switchData
            switchId list.at .data
          =:: switchData
          asmOps
            ## TODO appendPos
            op [] .pos context popValue =:: regData =:: switchVal
            ## TODO switch-table
            switchId context openSwitchBlock
            false context [] .reachable =
          return
        CASE case
          asmOps
            ## LocalLabel
              BranchType .CASE
              op [] .val .block .blockId
              op [] .val .block .subId
            LocalLabel new AssemblyAtom .localLabel list.append
            true context [] .reachable =
          return
        DEFAULT case
          asmOps
            ## LocalLabel
              BranchType .DEFAULT
              op [] .val .block .blockId
              op [] .val .block .subId
            LocalLabel new AssemblyAtom .localLabel list.append
            true context [] .reachable =
          return
        BREAK_SWITCH case
          ## findBreakableBlock
            BlockType .BREAK_SWITCH
            op [] .pos
            context
          findBreakableBlock =:: breakBlock?
          breakBlock? optional.isEmpty if
            ## error message handled by findBreakableBlock
            asmOps return
          end
          breakBlock? .data =:: breakBlock
          breakBlock [] .Switch ?? ! if
            "unexpected block for " sb.wrap
              BlockType .BREAK_SWITCH sb.appendBlockType
              ": " sb.appendS
              breakBlock [] sb.appendBlockInfo
            op [] .pos errors appendError
            asmOps return
          end
          context [] .stackValues @
            breakBlock [] .Switch .branchRoot
          branchTree.reset =:: caseBranchId
          asmOps
            context [] .reachable if
              breakBlock [] .Switch .caseBranches
                caseBranchId list.append
              breakBlock [] .Switch .caseBranches =
              breakBlock [] .Switch .caseCodeOffsets
                ..over .length list.append
              breakBlock [] .Switch .caseCodeOffsets =
              context reserveStackRegSpace
              breakBlock [] .Switch .caseStackRegs
                context [] .stackRegState list.append
              breakBlock [] .Switch .caseStackRegs =
              ## asm.createUnary
                X64_OP .JMP
                ## LocalLabel
                  BranchType .END_SWITCH
                  op [] .val .block .blockId
                  op [] .val .block .subId
                LocalLabel new AsmOperand .localLabel
              asm.createUnary AssemblyAtom .op list.append
            end
            breakBlock [] .Switch .rootStackRegs context [] .stackRegState =
            false context [] .reachable =
          return
        WHILE case
          ## don't add position before label
          op [] .val .block .blockId =:: whileId
          ## XXX ensure most values in stack state are loaded
          ##   end of loop resets to this point
          whileId context openWhileBlock
          context [] .openBlocks list.peek .data [] .While @ =:: whileBlock
          prog [] .whileData whileId list.at .data =:: whileData
          asmOps
            ## LocalLabel
              BranchType .WHILE
              op [] .val .block .blockId
              op [] .val .block .subId
            LocalLabel new AssemblyAtom .localLabel list.append
          return
        DO case
          context [] .openBlocks list.peek .data [] .While @ =:: whileBlock
          asmOps
            ## TODO debug position
            op [] .pos context popValue =:: regData =:: ifCond
            ifCond ValueType .I32 == assert "while-condition is bool"
            regData .registerCount 1 == assert "bool takes one register"
            regData .registers @ 0 [] =:: condRegisterSrc
            context [] .tmpRegistersInt .registers @ 0 [] =:: condRegister
            ## asm.createBinary
              X64_OP .MOV
              condRegister AsmOperand .register
              condRegisterSrc AsmOperand .register
            asm.createBinary AssemblyAtom .op list.append
            whileBlock [] .breakBranches
              context [] .stackValues @ branchTree.startBranch list.append
            whileBlock [] .breakBranches =
            whileBlock [] .breakCodeOffsets
              ..over .length list.append
            whileBlock [] .breakCodeOffsets =
            context reserveStackRegSpace
            whileBlock [] .breakStackRegs
              context [] .stackRegState list.append
            whileBlock [] .breakStackRegs =
            ## asm.createBinary
              X64_OP .TEST
              condRegister AsmOperand .register
              condRegister AsmOperand .register
            asm.createBinary AssemblyAtom .op list.append
            ## asm.createUnary
              X64_OP .JZ
              ## LocalLabel
                BranchType .END_WHILE
                op [] .val .block .blockId
                op [] .val .block .subId
              LocalLabel new AsmOperand .localLabel
            asm.createUnary AssemblyAtom .op list.append
          return
        AND_DO OR_DO case break
        BREAK CONTINUE case
          op [] .val .block .blockType =:: blockType
          ## findBreakableBlock
            blockType
            op [] .pos
            context
          findBreakableBlock =:: breakBlock?
          breakBlock? optional.isEmpty if
            ## error message handled by findBreakableBlock
            asmOps return
          end
          breakBlock? .data =:: breakBlock
          breakBlock [] .While ?? ! if
            "unexpected block for " sb.wrap
              blockType sb.appendBlockType
              ": " sb.appendS
              breakBlock [] sb.appendBlockInfo
            op [] .pos errors appendError
          end
          blockType .CONTINUE ?? if
            breakBlock [] .While .continueStackRegs @
            breakBlock [] .While .continueCodeOffsets @
            breakBlock [] .While .continueBranches @
          else
            breakBlock [] .While .breakStackRegs @
            breakBlock [] .While .breakCodeOffsets @
            breakBlock [] .While .breakBranches @
          end  =:: branches =:: codeOffsets =:: stackRegs
          branches []
            context [] .stackValues @ branchTree.startBranch list.append
          branches []  =
          asmOps
            ## XXX appendPos
            codeOffsets []
              ..over .length list.append
            codeOffsets [] =
            context reserveStackRegSpace
            stackRegs []
              context [] .stackRegState list.append
            stackRegs [] =
            ## asm.createUnary
              X64_OP .JMP
              ## LocalLabel
                blockType .CONTINUE ?? if BranchType .CONTINUE_WHILE else BranchType .END_WHILE end
                op [] .val .block .blockId
                op [] .val .block .subId
              LocalLabel new AsmOperand .localLabel
            asm.createUnary AssemblyAtom .op list.append
            false context [] .reachable =
          return
        AND OR PROCEDURE EXPERIMENTAL_PROCEDURE INITIALIZER NAMESPACE
        TYPE_TUPLE TYPE_STRUCT TYPE_ENUM TYPE_UNION TYPE_PROC_IN
        TYPE_PROC_OUT TYPE_COMPOSITE UNKNOWN case
          ## XXX error message
          break
      end
      break
    blockEnd case
      op [] .val .blockEnd .blockType switch
        PROCEDURE EXPERIMENTAL_PROCEDURE case
          ## TODO? append debug info at end of procedure
          asmOps return
        ELSE case
          context [] .openBlocks
            list.pop .If =:: ifBlock
          context [] .openBlocks =
          branchTree.NodeId 2 array new =:: mut: branches
          0 =:: mut: nBranches
          ifBlock .ifBranchTerminates if
            ifBlock .ifBranch branches @ nBranches [] =
            nBranches 1 + nBranches =
          end
          context [] .reachable if
            context [] .stackValues @ branchTree.startBranch branches @ nBranches [] =
            nBranches 1 + nBranches =
          end
          nBranches 1 >= if
            ## mergeValues
              context [] .stackValues @
              branches @ nBranches array.create
              mergeBranches @
              ## MergeIf
                "if" string.wrap
                ifBlock .blockId
                op [] .pos
                context
              MergePoint new
            branchTree.merge .error ?? if
              "could not merge branches of if-else block" sb.wrap
              op [] .pos errors appendError
            end
          end
          asmOps
            ..dup .length =:: elseCodeOffset
            context [] .reachable and ifBlock .ifBranchTerminates if
              context reserveStackRegSpace
            end
            ## LocalLabel
              BranchType .END_IF
              op [] .val .blockEnd .blockId
              op [] .val .blockEnd .subId
            LocalLabel new AssemblyAtom .localLabel list.append
            context [] .reachable and ifBlock .ifBranchTerminates if
              i64 2 array new =:: mut: offsets
              StackRegisterState 2 array new =:: mut: states
              ifBlock .ifBranchCodeOffset offsets@ 0 [] =
              ifBlock .ifBranchRegs states@ 0 [] =
              elseCodeOffset offsets@ 1 [] =
              context [] .stackRegState states@ 1 [] =
              ## mergeStackRegisters
                states@ array.wrap
                offsets@ array.wrap
                op [] .pos
              context mergeStackRegisters
              ## TODO set register state to merge registers
            end
            nBranches 0 > context [] .reachable =
            ifBlock .ififBranches  list.free ..drop
          return
        IFIF case asmOps return ## no-op
        SWITCH case
          context [] .openBlocks
            list.pop .Switch =:: switchBlock
          context [] .openBlocks =
          switchBlock .caseBranches =:: caseBranches
          caseBranches .length 1 >= if
            caseBranches .length =:: nodeCount
            ## mergeValues
              context [] .stackValues @
              caseBranches list.asArray
              mergeBranches @
              ## MergePoint
                "switch" string.wrap
                switchBlock .blockId
                op [] .pos
                context
              MergePoint new
            branchTree.merge .error ?? if
              "could not merge branches of switch-case block" sb.wrap
              op [] .pos errors appendError
            end
          end
          asmOps
            switchBlock .caseStackRegs .length 1 > if
              ## mergeStackRegisters
                switchBlock .caseStackRegs list.asArray
                switchBlock .caseCodeOffsets list.asArray
                op [] .pos
              context mergeStackRegisters
            else switchBlock .caseStackRegs .length 1 == _if
              switchBlock .caseStackRegs 0 list.at .data [] context [] .stackRegState =
            end
            caseBranches .length 0 > context [] .reachable =
            caseBranches  list.free ..drop
            switchBlock .caseStackRegs list.free ..drop
            switchBlock .caseCodeOffsets list.free ..drop
            ## LocalLabel
              BranchType .END_SWITCH
              op [] .val .blockEnd .blockId
              op [] .val .blockEnd .subId
            LocalLabel new AssemblyAtom .localLabel list.append
          return
        WHILE case
          context [] .openBlocks
            list.pop .While =:: mut: whileBlock
          context [] .openBlocks =
          whileBlock .continueBranches =:: mut: continueBranches
          whileBlock .continueStackRegs =:: mut: continueStackRegs
          whileBlock .continueCodeOffsets =:: mut: continueCodeOffsets
          asmOps
            context [] .reachable if
              continueBranches
                context [] .stackValues @ branchTree.startBranch list.append
              continueBranches =
              continueCodeOffsets
                ..dup .length list.append
              continueCodeOffsets =
              context reserveStackRegSpace
              continueStackRegs
                context [] .stackRegState list.append
              continueStackRegs =
            end
            ## LocalLabel
              BranchType .CONTINUE_WHILE
              op [] .val .blockEnd .blockId
              op [] .val .blockEnd .subId
            LocalLabel new AssemblyAtom .localLabel list.append
            continueStackRegs .length 1 > if
              ## mergeStackRegisters
                continueStackRegs list.asArray
                continueCodeOffsets list.asArray
                op [] .pos
              context mergeStackRegisters
            else continueStackRegs .length 1 == _if
              continueStackRegs 0 list.at .data [] context [] .stackRegState =
            end
          =:: mut: newOps
          continueBranches .length 1 >= if
            continueBranches .length =:: nodeCount
            ## mergeValues
              context [] .stackValues @
              continueBranches list.asArray
              mergeBranches @
              ## MergePoint
                "while" string.wrap
                whileBlock .blockId
                op [] .pos
                context
              MergePoint new
            branchTree.merge .error ?? if
              "could not merge continue branches of while block" sb.wrap
              op [] .pos errors appendError
            end
          end
          continueBranches  list.free ..drop
          continueStackRegs list.free ..drop
          continueCodeOffsets list.free ..drop
          newOps
            ## XXX update value locations?
            ## jump to start of loop
            whileBlock .rootStackRegs op [] .pos context resetStackRegisters
            ## asm.createUnary
              X64_OP .JMP
              ## LocalLabel
                BranchType .WHILE
                op [] .val .blockEnd .blockId
                op [] .val .blockEnd .subId
              LocalLabel new AsmOperand .localLabel
            asm.createUnary AssemblyAtom .op list.append
            ## LocalLabel
              BranchType .END_WHILE
              op [] .val .blockEnd .blockId
              op [] .val .blockEnd .subId
            LocalLabel new AssemblyAtom .localLabel list.append
          newOps =
          whileBlock .breakBranches =:: breakBranches
          whileBlock .breakStackRegs =:: breakStackRegs
          whileBlock .breakCodeOffsets =:: breakCodeOffsets
          breakBranches .length 1 >= if
            breakBranches .length =:: nodeCount
            ## mergeValues
              context [] .stackValues @
              breakBranches list.asArray
              mergeBranches @
              ## MergePoint
                "while" string.wrap
                whileBlock .blockId
                op [] .pos
                context
              MergePoint new
            branchTree.merge .error ?? if
              "could not merge break branches of while block" sb.wrap
              op [] .pos errors appendError
            end
          end
          breakBranches .length 0 > context [] .reachable =
          newOps
            breakStackRegs .length 1 > if
              ## mergeStackRegisters
                breakStackRegs list.asArray
                breakCodeOffsets list.asArray
                op [] .pos
              context mergeStackRegisters
            else breakStackRegs .length 1 == _if
              breakStackRegs 0 list.at .data [] context [] .stackRegState =
            end
            breakStackRegs list.free ..drop
            breakCodeOffsets list.free ..drop
          return
        IF DO BREAK CONTINUE CASE DEFAULT BREAK_SWITCH
        AND OR AND_IF OR_IF AND_DO OR_DO
        UNKNOWN INITIALIZER NAMESPACE
        TYPE_TUPLE TYPE_STRUCT TYPE_ENUM TYPE_UNION
        TYPE_PROC_IN TYPE_PROC_OUT TYPE_COMPOSITE case
          ## XXX error message
          break
      end
      break
    Return case
      op [] .dataType =:: procType
      procType typeContext types.getProcOutArgs
        ! assert "procedure has arguments"
      =:: outArgs
      procType typeContext types.getProcRet
        ! assert "procedure has arguments"
      =:: retType
      context [] .tmpRegistersInt .registers @ 0 [] =:: tmpRegister
      asmOps
        ## TODO make return value handling dependent on calling convention
        retType .empty ?? ! if
          op [] .pos context popValue
            =:: retData
          retType typeContext toValueType != if
            "stack out of sync" sb.wrap
            op [] .pos errors appendError
            return
          end
          retData
        else
          ## RegisterValue
            Register MAX_VALUE_REGISTERS array new
            0:i8
          RegisterValue new
        end =:: retData
        outArgs .length 1 - while ..dup 0 >= do =:: i
          context [] .stackValues @ branchTree.pop .data [] =:: stackValue
          outArgs i array.get =:: argType
          stackValue .valType argType typeContext toValueType != if
            "stack out of sync" sb.wrap
            op [] .pos errors appendError
            return
          end
          stackValue .intOffset =:: mut: intOffset
          stackValue .floatOffset =:: mut: floatOffset
          stackValue .valType valTypeToStackRegisters =:: srcCount =:: srcTypes
          ## asm.createBinary
            X64_OP .MOV
            tmpRegister AsmOperand .register
            i AsmOperand .outputArgument
          asm.createBinary AssemblyAtom .op list.append
          stackValue .REFERENCE ?? if
            srcCount 1 != if
              "stack out of sync" sb.wrap
              op [] .pos errors appendError
              return
            end
            srcTypes@ 0 [] StackRegisterType .INT == assert "correct register type"
            ## XXX? ensure fixed size type
            ## asm.createTrinary
              X64_OP .COPY
              tmpRegister AsmOperand .register
              srcTypes@ 0 [] intOffset op [] .pos context getStackValue
              argType typeContext types.sizeOf .fixed AsmOperand .value
            asm.createTrinary AssemblyAtom .op list.append
          end
          0 while ..dup srcCount < do =:: j
            srcTypes @ j [] =:: srcType
            srcType
              srcType switch
                INT case intOffset ..dup 1 + intOffset = break
                FLOAT case floatOffset ..dup 1 + floatOffset = break
              end
              op [] .pos
            context getStackValue =:: srcRegister
            ## asm.createTrinary
              X64_OP .MOV
              tmpRegister AsmOperand .registerPtrOffset
              j 8 * AsmOperand .value
              srcRegister
            asm.createTrinary AssemblyAtom .op list.append
            j 1 +
          end ..drop
          i 1 -
        end ..drop
        ## TODO make handling of return values dependent on calling convention
        retType .empty ?? ! if
          retType typeContext types.isSmallType if
            ## asm.createBinary
              X64_OP .MOV
              Register.x64.rax AsmOperand .register
              retData .registers @ 0 [] AsmOperand .register
            asm.createBinary AssemblyAtom .op list.append
            retData .registerCount 1 > if
              ## asm.createBinary
                X64_OP .MOV
                Register.x64.rdx AsmOperand .register
                retData .registers @ 1 [] AsmOperand .register
              asm.createBinary AssemblyAtom .op list.append
            end
            ## XXX handle float return values
          else
            ## asm.createBinary
              X64_OP .MOV
              Register.x64.rax AsmOperand .register
              outArgs .length AsmOperand .outputArgument
            asm.createBinary AssemblyAtom .op list.append
            ## XXX? ensure fixed size
            ## asm.createTrinary
              X64_OP .COPY
              Register.x64.rax AsmOperand .register
              retData .registers @ 0 [] AsmOperand .register
              retType typeContext types.sizeOf .fixed AsmOperand .value
            asm.createTrinary AssemblyAtom .op list.append
          end
        end
        ## TODO make stack frame depend on calling convention
        ## asm.createBinary
          X64_OP .MOV
          Register.sp AsmOperand .register
          Register.fp AsmOperand .register
        asm.createBinary AssemblyAtom .op list.append
        ## XXX restore callee saved registers
        ## asm.createUnary
          X64_OP .POP
          Register.fp AsmOperand .register
        asm.createUnary AssemblyAtom .op list.append
        ## asm.createNilary
          X64_OP .RET
        asm.createNilary AssemblyAtom .op list.append
        false context [] .reachable =
      return
    stackMod case
      op [] .val .stackMod .modType switch
        DROP case
          op [] .val .stackMod .n =:: count
          count while ..dup 0 > do 1 -
            op [] .pos context dropValue
          end ..drop
          asmOps return
        COPY case
          op [] .val .stackMod .n =:: offset
          context [] .stackValues branchTree.depth offset <= if
            "stack underflow" sb.wrap
            op [] .pos errors appendError
            asmOps return
          end
          context [] .stackValues @
            offset
          branchTree.at .data [] =:: sourceValue
          sourceValue .intOffset =:: mut: intOffset
          sourceValue .floatOffset =:: mut: floatOffset
          asmOps
            sourceValue .valType op [] .pos context preparePushValue =:: target
            sourceValue .valType valTypeToStackRegisters =:: srcCount =:: srcTypes
            target .registerCount srcCount == assert "matching register count"
            0 while ..dup srcCount < do =:: i
              srcTypes @ i [] =:: srcType
              srcType
                srcType switch
                  INT case intOffset ..dup 1 + intOffset = break
                  FLOAT case floatOffset ..dup 1 + floatOffset = break
                end
                op [] .pos
              context getStackValue =:: srcRegister
              ## asm.createBinary
                X64_OP .MOV
                target .registers @ i [] AsmOperand .register
                srcRegister
              asm.createBinary AssemblyAtom .op list.append
              i 1 +
            end ..drop
          return
        SWAP case
          context [] .stackValues branchTree.depth 2 < if
            "stack underflow" sb.wrap
            op [] .pos errors appendError
            asmOps return
          end
          context [] .stackValues @ 0 branchTree.at .data [] =:: upperVal
          context [] .stackValues @ 1 branchTree.at .data [] =:: lowerVal
          upperVal .valType valTypeToStackRegisters =:: upperCount =:: upperTypes
          lowerVal .valType valTypeToStackRegisters =:: lowerCount =:: lowerTypes
          false =:: mut: hasInt
          false =:: mut: hasFloat
          0 while ..dup upperCount < do =:: i
            upperTypes @ i [] switch
              INT case true hasInt = break
              FLOAT case true hasFloat = break
            end
            i 1 +
          end ..drop
          true =:: mut: hasCommonRegister
          0 while ..dup lowerCount < do =:: i
            lowerTypes @ i [] switch
              INT case hasCommonRegister hasInt | hasCommonRegister = break
              FLOAT case hasCommonRegister hasFloat | hasCommonRegister = break
            end
            i 1 +
          end ..drop
          hasCommonRegister ! if
            context [] .stackValues @ branchTree.swap
            asmOps return
          end
          0 =:: stackRegTypeInt
          1 =:: stackRegTypeFloat
          ## XXX? use initializer and make immutable
          RegisterList ptr 2 array new =:: mut: tmpRegisters
          context [] .tmpRegistersInt @ tmpRegisters @ stackRegTypeInt [] =
          context [] .tmpRegistersFloat @  tmpRegisters @ stackRegTypeFloat [] =
          0 =:: mut: tmpInts
          0 =:: mut: tmpFloats
          asmOps
            op [] .pos context popValue =:: regData1 =:: val1
            op [] .pos context popValue =:: regData2 =:: val2
            val1 op [] .pos context preparePushValue =:: regData3
            val2 op [] .pos context preparePushValue =:: regData4
            regData1 .registerCount =:: count1
            regData2 .registerCount =:: count2
            count1 regData3 .registerCount == assert "regs1.length==regs3.length"
            count2 regData4 .registerCount == assert "regs2.length==regs4.length"
            regData1 .registers @ =:: regs1
            regData2 .registers @ =:: regs2
            regData3 .registers @ =:: regs3
            regData4 .registers @ =:: regs4
            ## copy upper block to tmp registers
            0 while ..dup count1 < do =:: i
              regs1 i [] =:: src
              regs3 i [] =:: target
              src .id target .id == if i 1 + continue end
              upperTypes @ i [] switch
                INT case
                  tmpRegisters @ stackRegTypeInt [] [] .registers @ tmpInts []
                  tmpInts 1 + tmpInts =
                  break
                FLOAT case
                  tmpRegisters @ stackRegTypeFloat [] [] .registers @ tmpFloats []
                  tmpFloats 1 + tmpFloats =
                  break
              end =:: tmpRegister
              ## asm.createBinary
                X64_OP .MOV
                tmpRegister AsmOperand .register
                src AsmOperand .register
              asm.createBinary AssemblyAtom .op list.append
              i 1 +
            end ..drop
            ## copy lower block to upper block
            0 while ..dup count2 < do =:: i
              regs4 i [] =:: target
              regs2 i [] =:: src
              src .id target .id == if i 1 + continue end
              ## asm.createBinary
                X64_OP .MOV
                target AsmOperand .register
                src AsmOperand .register
              asm.createBinary AssemblyAtom .op list.append
              i 1 +
            end ..drop
            0 tmpInts =
            0 tmpFloats =
            ## copy tmp registers to lower block
            0 while ..dup count1 < do =:: i
              regs1 i [] =:: src
              regs3 i [] =:: target
              src .id target .id == if i 1 + continue end
              upperTypes @ i [] switch
                INT case
                  tmpRegisters @ stackRegTypeInt [] [] .registers @ tmpInts []
                  tmpInts 1 + tmpInts =
                  break
                FLOAT case
                  tmpRegisters @ stackRegTypeFloat [] [] .registers @ tmpFloats []
                  tmpFloats 1 + tmpFloats =
                  break
              end =:: tmpRegister
              ## asm.createBinary
                X64_OP .MOV
                target AsmOperand .register
                tmpRegister AsmOperand .register
              asm.createBinary AssemblyAtom .op list.append
              i 1 +
            end ..drop
          return
      end
      break
    Assert unreachable
    autoTypedInitializeId
    ConstantReference NewReference
    typeInfo NewEnumReference getEnumLabel
    compilerInfo getName atName getLabel
    atLabel length size typeModifier hasLabel hasName case
      break ## XXX error message
  end
  "unable to compile operation " sb.wrap
    op [] prog sb.appendOp
  op [] .pos errors appendError
  asmOps return
end

proc(
  Operation arrayView : ops
  AssemblyAtom list ptr mut : asmOps0
  io.FILE : target
  CompilerContext ptr mut : context
-> ) =>: compileProc
  context [] .program =:: prog
  prog [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  ops 0 array.at .data [] .val .implementProcedure ??
      assert "procedure starts with correct operation"
  ## XXX? reset offset map
  asmOps0 [] =:: mut: asmOps
  0 while ..dup ops .length < do =:: j
    asmOps
       ops j array.at .data context compileOp
    asmOps =
    j 1 +
  end ..drop
  ## XXX optimize assembly
  ##  * replace move target with move source until one of them gets modified (forward)
  ##      mov b, a; mov c, b  -> mov b,a; mov c, a
  ##  * replace move source with move target until one of them gets modified (backward)
  ##      mov b, [x]; add b, c; mov b, a; ret a -> mov a, [x]; add a, c; ret a
  ##  * store variables (without pointer access) in registers where possible
  ##  * permute register names ( reduce use of r8-r15 / xmm8-xmm15 )
  64 asmOps .length * sb.create
    0 while ..dup asmOps .length < do =:: j
      asmOps j list.get labelContext asm.appendToSb
      j 1 +
    end ..drop
    '\n' sb.appendC
    target ..over io.fputSb ..drop
  sb.free ..drop ## XXX merge string builders
  asmOps list.clear asmOps0 [] =
  context [] .stackValues @ branchTree.clear
  0 context [] .stackRegState .stackCountInt =
  0 context [] .stackRegState .stackCountFloat =
  bool REGISTER_LIST_MAX_LENGTH array new context [] .stackRegState .activeStackRegistersInt =
  bool REGISTER_LIST_MAX_LENGTH array new context [] .stackRegState .activeStackRegistersFloat =
end

proc( -> RegisterList ) =>: getStackRegistersInt
  Register REGISTER_LIST_MAX_LENGTH array new =:: mut: registers
  Register.x64.rdi registers @ 0 [] =
  Register.x64.rsi registers @ 1 [] =
  Register.x64.rdx registers @ 2 [] =
  Register.x64.rcx registers @ 3 [] =
  Register.x64.r8  registers @ 4 [] =
  Register.x64.r9  registers @ 5 [] =
  registers 6:i8 RegisterList new return
end
proc( -> RegisterList ) =>: getStackRegistersFloat
  Register REGISTER_LIST_MAX_LENGTH array new =:: mut: registers
  Register.x64.xmm0 registers @ 0 [] =
  Register.x64.xmm1 registers @ 1 [] =
  Register.x64.xmm2 registers @ 2 [] =
  Register.x64.xmm3 registers @ 3 [] =
  Register.x64.xmm4 registers @ 4 [] =
  Register.x64.xmm5 registers @ 5 [] =
  registers 6:i8 RegisterList new return
end
proc( -> RegisterList ) =>: getTmpRegistersInt
  Register REGISTER_LIST_MAX_LENGTH array new =:: mut: registers
  Register.x64.rax registers @ 0 [] =
  Register.x64.rbx registers @ 1 [] =
  Register.x64.r10 registers @ 2 [] =
  registers 3:i8 RegisterList new return
end
proc( -> RegisterList ) =>: getTmpRegistersFloat
  Register REGISTER_LIST_MAX_LENGTH array new =:: mut: registers
  Register.x64.xmm8  registers @ 0 [] =
  Register.x64.xmm9  registers @ 1 [] =
  Register.x64.xmm10 registers @ 2 [] =
  registers 3:i8 RegisterList new return
end

proc( io.FILE : target ProgramContext ptr mut : prog -> ) =>: export: compileToAsm
  prog [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  ## CompilerContext
    prog
    StackRegisterValue branchTree.create
    32 BlockInfo list.create
    32 LocalConst list.create
    32 StringConstant list.create
    getStackRegistersInt
    getStackRegistersFloat
    getTmpRegistersInt
    getTmpRegistersFloat
    ## StackRegisterState
      0
      0
      bool REGISTER_LIST_MAX_LENGTH array new
      bool REGISTER_LIST_MAX_LENGTH array new
    StackRegisterState new
    Type .undefined
    0
    0
    0
    0
    true
  CompilerContext new =:: mut: contextData
  contextData @ =:: context
  ## TODO find main
  ## TODO type-declarations
  idContext [] .globalScope .identifierNames @ map.itr.start while map.itr.hasNext do map.itr.next
    =:: declaration ## TODO find out which declarations are actually used
    declaration .1 [] =:: labelId
    labelId idContext id.getIdentifier
      ! assert "labelId is identifier"
    =:: idData
    ## TODO compile global variables
  end ..drop
  1024 AssemblyAtom list.create =:: mut: asmOps
  0 while ..dup prog [] .procedures .length < do =:: i
    prog [] .procedures i list.at .data =:: currentProc
    currentProc [] .implementation .code ?? ! if
      i 1 + continue
    end
    prog [] .progFiles currentProc [] .fileId i64 cast list.at .data =:: f
    currentProc [] .implementation .code @ =:: impl
    currentProc [] .hasStaticArg if
      0 while ..dup impl [] .implementations .length < do =:: implId
        impl [] .implementations implId list.at .data =:: currentImpl
        ## compileProc
          f [] .localOps
            currentImpl [] .codeStart
            currentImpl [] .codeLength
          list.slice
          asmOps @
          target
          context
        compileProc
        implId 1 +
      end ..drop
    else
      ## compileProc
        f [] .localOps impl [] .codeStart impl [] .codeLength list.slice
        asmOps @
        target
        context
      compileProc
    end
    i 1 +
  end ..drop
  ## TODO string-constants
  ## TODO compile main
  ## TODO cleanup context
end
