import stringBuilder
import list
import file

import "program.concat"
import "stackVM/ir.concat"

union(
  i64 : Int
  f64 : Float
  i64 : StackSlot ## count from bottom of stack to get stable id
  i64 : LocalValue
  i64 : RoValue
  i64 : RwValue
  i64 : LocalAddr
  i64 : RoAddr
  i64 : RwAddr
) =:: StackValue
struct(
  ProgramContext ptr.mut : program
  StackValue list : stack
  ## dstStack: val-counts for top 16 slots
  ## dstStack: free-slots
  ## varLocs -> memory/stack locations of variables
) =:: CompilerContext

proc( stackvm.Operation list Operation : op CompilerContext ptr.mut : context -> stackvm.Operation list ) =>: compileOp
  context [] .program =:: program
  program .errors =:: errors
  program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .nameContext =:: nameContext
  op .val switch
    NOP case return
    default break
  end
  "unsupported operation:" sb.copyPtr
    op program sb.appendOp
  op .pos errors appendError
end
proc( stackvm.Operation list ProcedureInfo ptr : proc CompilerContext ptr.mut : context -> stackvm.Operation list ) =>: beginProcedure
  context .stack list.clear context .stack=
  ## TODO reset stack
  ## TODO generate proc-header
end
proc( stackvm.Operation list CompilerContext ptr.mut : context -> stackvm.Operation list ) =>: finishProcedure
  ## TODO? try to eliminate local labels
end

proc( file.File : mut: target ProgramContext ptr.mut : program bool : assemble -> file.File ) =>: export: compileToStackVM
  ## CompilerContext
    program
    StackValue list.create
  CompilerContext new =:: mut: contextData
  contextData@ =:: context
  stackvm.Operation list.empty
    program [] .procedures for ProcId.getProcInfo =:: proc
      proc .implementation .Code .else ..drop continue end =:: impl
      impl .codeState [] .PreCompiled .else ..drop continue end =:: procCode
      proc context beginProcedure
        $ .length procCode .length + list.ensureCap
        procCode for context compileOp end
      context finishProcedure
    end
  =:: ops
  ## 2. generate data-section
  ## 3. resolve labels
  ## 4. generate byte-code
  "stack-vm compiler is not implemented" ..panic
  ops list.free ..drop
  contextData .stack list.free ..drop
end
