  i32 : count
  i32 : depth
  FilePosition ptr : pos
-> Operation ) =>: export: opTypesInfo
  ## Operation
    pos
    count depth StackTypesInfo new
      CompilerInfo .TypeInfo
    OpValue .CompilerInfo
    Type .Undefined
  Operation new return
end
proc( i32 : count FilePosition ptr : pos -> Operation ) =>: export: opStackInfo
  pos count CompilerInfo .StackInfo OpValue .CompilerInfo Type .Undefined Operation new return
end
proc( i32 : count FilePosition ptr : pos -> Operation ) =>: export: opPrintCompiledOps
  pos count CompilerInfo .CompiledOps OpValue .CompilerInfo Type .Undefined Operation new return
end
proc( NameId : name FilePosition ptr : pos -> Operation ) =>: export: opPrintIdentifierMatches
  pos name CompilerInfo .Find OpValue .CompilerInfo Type .Undefined Operation new return
end
proc( i32 : depth FilePosition ptr : pos -> Operation ) =>: export: opTypeLayout
  pos depth CompilerInfo .TypeLayout OpValue .CompilerInfo Type .Undefined Operation new return
end

struct(
      stringBuilder : fileName
             FileId : id
         id.ScopeId : fileScope
) =:: export: ProgramFile

struct( ConstValue : value i32 : caseId FilePosition ptr : pos ) =:: export: LabelData
proc( ConstValue : label -> i64 ) =>: export: switchLabelAsInt
  label .Int .if
    return
  else .Char ._if
    i64 cast.u return
  else ..drop end
  ## TODO? more usefull error message?
  "unexpected constant-type in switch statement" ..panic
end
proc(
  LabelData : a
  LabelData : b
  ProgramContext ptr : program ## forward compatability
-> i32 ) =>: export: switchLabelCmp
  a .value switchLabelAsInt =:: aInt
  b .value switchLabelAsInt =:: bInt
  aInt bInt == if
    0 return
  end
  aInt bInt < if -1 else 1 end return
end
struct(
  LabelData list : switchLabels
  LocalLabelId slice : branchLabels
  LocalLabelId : defaultLabel
  LocalLabelId : endLabel
  JumpDistance slice : caseJumpDistances
  JumpDistance : defaultJumpDistance
  Type : switchType
) =:: export: SwitchData

struct(
  ProcId list : procedures
) =:: export: ProcedureBundle

## check if composite has any static elements, types are static by default
proc( Type slice : elements NameId optional slice : eltNames TypeContext ptr : typeContext -> bool ) =>: hasStaticElement
  typeContext .nameContext =:: nameContext
  elements .length for =:: i
    eltNames i slice.get optional.flat .and id.identifierFlags id.FLAG_STATIC & ? if
      true return
    end
    elements i [] typeContext types.isType if
      true return
    end
  end
  false return
end
proc(
  Type : newProcType
  ProcedureInfo ptr.mut : procInfo
  TypeContext ptr : typeContext
-> ) =>: export: setProcType
  newProcType procInfo .procType=
  newProcType typeContext types.getProcIn .else Type slice.empty end =:: inTypes
  newProcType typeContext types.getProcOut .else Type slice.empty end =:: outTypes
  procInfo [] .flags
    inTypes newProcType typeContext types.getProcArgNames typeContext hasStaticElement if
      ProcFlags.HAS_STATIC_ARG |
    end
    outTypes newProcType typeContext types.getProcRetNames typeContext hasStaticElement or
        procInfo [] .nameId id.identifierFlags id.FLAG_STATIC & ? if
      ProcFlags.IS_STATIC |
    end
  procInfo .flags=
  procInfo .implementation .Code .if =:: codeImpl
    codeImpl .genericInfo .None ? and procInfo [] .flags ProcFlags.HAS_STATIC_ARG & ? or
        newProcType typeContext types.containsGeneric if
      0 ProcId list.create GenericProcInfo .Implementations codeImpl .genericInfo=
    end
  else ..drop end
end
proc(
  NameId : procName
  Type : procType
  FileId : fileId
  ProcId optional : aliasId
  bool : hasImpl
  FilePosition ptr : pos
  ProgramContext ptr.mut : progContext
-> ProcId ) =>: export: newProcData
  progContext .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .nameContext =:: nameContext
  procType typeContext types.getProcIn .else
    Type slice.empty
  end =:: inTypes
  procType typeContext types.getProcOut .else
    Type slice.empty
  end =:: outTypes
  inTypes procType typeContext types.getProcArgNames typeContext hasStaticElement =:: hasStaticArg
  outTypes procType typeContext types.getProcRetNames typeContext hasStaticElement
    procName id.identifierFlags id.FLAG_STATIC & ? |
  =:: isStatic
  progContext [] .programMemory
    ## ProcedureInfo
      aliasId .if
        ProcImplType .Alias
      else hasImpl ! _if
        procName ProcImplType .Extern
      else
        ## CodeProcData
          0 VariableInfo list.create
          Operation slice.emptyMutable
          hasStaticArg or procType typeContext types.containsGeneric if
            0 ProcId list.create GenericProcInfo .Implementations
          else
            GenericProcInfo .None
          end
          ProcCodeState .PARSING
          0:i16
        CodeProcData new ProcImplType .Code
      end
      procName
      fileId
      idContext id.currentScope
      procType
      ProcFlags.NONE
        hasStaticArg if ProcFlags.HAS_STATIC_ARG | end
        isStatic if ProcFlags.IS_STATIC | end
      ## ^flags
    ProcedureInfo new mixedArena.copyValue ProcId.create =:: procId
  progContext .programMemory=
  progContext [] .procedures
    procId list.append
  progContext .procedures=
  procId return
end
proc( -> ProcedureBundle ) =>: export: newProcBundle
  ## ProcedureBundle
    8 ProcId list.create
  ProcedureBundle new
end

struct(
  FilePosition ptr : pos
  ConstValue : value
  Type : constType
) =:: export: TypedConstant

struct(
  IdentifierContext : idContext
  ProgramFile list : progFiles
  ProcId list : procedures
  ProcedureBundle list : procBundles
  Type list : autoTypes
  PreOperation list : globalOps
  MixedArenaAllocator : programMemory ## TODO? merge non-linear buffers into Allocator
  LocalLabelId BackJumpInfo hashMap : backJumpInfo
  LocalLabelId : nextLabelId
  SwitchData list : switchData
  NameId optional : mainId
  i32 : whileCount
  ProcId optional : mainProcId
  i32 : ifCount
  i32 : andOrCount
  TypedConstant list : constantReferences
  NameId optional list : nameBuffer
  stringBuilder : tmpString
  CompilerError list : errors
  string : basePath
  string : libPath
  bool : saveGlobalTokens
  bool : inLibFile
  bool : hasGetArgs
) =:: export: ProgramContext
namespace: program
  proc( ProgramContext ptr.mut -> LocalLabelId ) =>: export: nextLocalLabel
    .nextLabelId $
      [] $ i64 cast.u 1 + LocalLabelId cast.u
    >>$ =[]
  end
end

proc(
  string : basePath
  string : libPath
  bool : saveGlobalTokens
-> ProgramContext ) =>: export: newProgramContext
  ## ProgramContext
    id.newIdentifierContext
    16  ProgramFile     list.create
    64  ProcId          list.create
    64  ProcedureBundle list.create
    32  Type            list.create
    PreOperation list.empty
    4096                mixedArena.create
    LocalLabelId.skewHash@ LocalLabelId.eq@ 1024 BackJumpInfo map.create
    0 LocalLabelId cast
    128 SwitchData      list.create
    NameId optional.empty ## main NameId
    0
    ProcId optional.empty ## main ProcId
    0 0
    32  TypedConstant   list.create
    32  NameId optional list.create
    256 sb.create
    32  CompilerError   list.create
    basePath
    libPath
    saveGlobalTokens
    false ## inLibFile
    false ## has getArgs
  ProgramContext new
end
proc( ProgramContext ptr.mut -> ) =>: export: freeStaticProcs
  $ [] .procedures list.filter for ProcId.getProcInfo =:: procInfo
    procInfo [] .flags ProcFlags.IS_STATIC ProcFlags.HAS_STATIC_ARG | & ? if
      procInfo [] freeProcedure false
    else
      true
    end
  end >$ .procedures=
end
proc( ProgramContext ptr.mut -> ) =>: export: freeUnusedProcs
  $ [] .procedures list.filter for ProcId.getProcInfo =:: procInfo
    procInfo [] .implementation .Code .and .codeState .UNUSED if
      procInfo [] freeProcedure false
    else
      true
    end
  end >$ .procedures=
end
proc( ProgramContext -> ProgramContext ) =>: export: freeProgramContext
  $ .idContext id.freeIdentifierContext >$ .idContext=
  $ .progFiles list.free >$ .progFiles=
  $ .procedures for ProcId.getProcInfo [] freeProcedure end
  $ .procedures list.free >$ .procedures=
  $ .procBundles list.free >$ .procBundles=
  $ .autoTypes list.free >$ .autoTypes=
  $ .globalOps list.free >$ .globalOps=
  $ .programMemory mixedArena.free >$ .programMemory=
  $ .switchData list.free >$ .switchData=
  $ .constantReferences list.free >$ .constantReferences=
  $ .nameBuffer list.free >$ .nameBuffer=
  $ .tmpString sb.free >$ .tmpString=
  $ .errors list.free >$ .errors=
  NameId optional.empty >$ .mainId=
  ProcId optional.empty >$ .mainProcId=
  false >$ .hasGetArgs=
  =:: mut: tmp ## is there a way to avoid switching to variable
    tmp@ .backJumpInfo map.free
  tmp
end

proc(
  stringBuilder : fileName
  FileId : id
-> ProgramFile ) =>: export: newProgFile
  ## ProgramFile
    fileName
    id
    id.NO_SCOPE
  ProgramFile new return
end

proc(
  ConstValue : constValue
  Type : constType
  FilePosition ptr : pos
  ProgramContext ptr.mut : program
-> Operation ) =>: export: opConstReference
  program [] .constantReferences
    ..dup .length ConstReferenceId cast =:: refId
    pos constValue constType TypedConstant new list.append
  program .constantReferences=
  program .idContext .typeContext =:: typeContext
  ## Operation
    pos
    refId OpValue .ConstantReference
    constType
  Operation new return
end

namespace: sb
  proc( stringBuilder : sb StackModification : mod -> stringBuilder ) =>: export: appendStackMod
    sb
      mod .modType switch
        COPY case
          mod .n 0 == if
            "DUP" sb.appendS
          else
            "OVER " sb.appendS
            mod .n sb.appendI
          end
          break
        ROTATE case
          mod .n 1 == if
            "SWAP" sb.appendS
          else
            "ROTATE " sb.appendS
            mod .n sb.appendI
          end
          break
        DROP case
          "DROP " sb.appendS
          mod .n  sb.appendI
          break
      end
    return
  end
  proc( stringBuilder TypeModifier -> stringBuilder ) =>: export: appendTypeModifier
    switch
      ARRAY case
        "array" sb.appendS
        break
      PTR case
        "ptr" sb.appendS
        break
      PTR_MUT case
        "ptr.mut" sb.appendS
        break
      RAW_PTR case
        "ptr.raw" sb.appendS
        break
      RAW_PTR_MUT case
        "ptr.raw.mut" sb.appendS
        break
    end
  end
  proc( stringBuilder LocalLabelType -> stringBuilder ) =>: export: appendLocalLabelType
    switch
      LABEL_START case "start" sb.appendS return
      LABEL_END case "end" sb.appendS return
      LABEL_MIDDLE case "middle" sb.appendS return
      HINT_START case "hint-start" sb.appendS return
      HINT_END case "hint-end" sb.appendS return
    end
  end
  proc( stringBuilder CompareType -> stringBuilder ) =>: export: appendCmpType
    CMP_TYPE_NAMES@ >$ ..tag iSize cast.u [] sb.appendStr
  end
  proc( stringBuilder PreOperation : op ProgramContext ptr : progContext -> stringBuilder ) =>: export: appendPreOp
    progContext .idContext .typeContext =:: typeContext
    progContext .idContext .typeContext .nameContext =:: nameContext
    progContext .idContext .constContext =:: constContext
    op .val switch
      NOP case
        "NOP" sb.appendS
        break
      Constant .case =:: constVal
        "constant ( " sb.appendS
        op .dataType  typeContext sb.appendType
        " ) : " sb.appendS
        constVal typeContext sb.appendConstant
      break
      NestedProc .case =:: procId
        "nested proc ( " sb.appendS
        op .dataType  typeContext sb.appendType
        " ) : " sb.appendS
        procId ProcId.getName nameContext sb.appendIdentifierPath
      break
      Block .case =:: blockData
        "Block: " sb.appendS
        blockData .blockType sb.appendBlockType
        " (" sb.appendS
          blockData .blockId i64 cast sb.appendI
          " ->" sb.appendS
          blockData .jumpDistance i64 cast sb.appendI
        ')' sb.appendC
      break
      BlockEnd .case =:: blockData
        "End: " sb.appendS
        blockData .blockType sb.appendBlockType
        " (" sb.appendS
          blockData .blockId i64 cast sb.appendI
          " ->" sb.appendS
          blockData .jumpDistance i64 cast sb.appendI
        ')' sb.appendC
      break
      GetNamedElt .case =:: name
        "get element ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) : " sb.appendS
        name sb.appendStr
      break
      SetNamedElt .case =:: name
        "set element ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) : " sb.appendS
        name sb.appendStr
      break
      SetNestedNamedElt .case =:: name
        "set nested element ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) : " sb.appendS
        name sb.appendStr
      break
      ExistsNamedElt .case =:: name
        "exists element ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) : " sb.appendS
        name sb.appendStr
      break
      TypeWith .case =:: procId
        "type with( " sb.appendS
          procId ProcId.getName nameContext sb.appendIdentifierPath
        "@ )" sb.appendS
      break
      TypeModifier .case =:: typeModifier
        "typeModifier \"" sb.appendS
          typeModifier sb.appendTypeModifier
        "\"" sb.appendS
      break
      Return case
        "Return( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) " sb.appendS
      break
      Splat case
        "splat: " sb.appendS
        op .dataType typeContext sb.appendType
      break
      New case
        "new: " sb.appendS
        op .dataType typeContext sb.appendType
      break
      Cast .case =:: castInfo
        castInfo .signType switch
          NONE case break
          SIGNED case "signed " sb.appendS break
          UNSIGNED case "unsigned " sb.appendS break
        end
        "cast ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) src: " sb.appendS
        castInfo .src typeContext sb.appendType
      break
      Cast! .case =:: src
        "cast! ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) src: " sb.appendS
        src typeContext sb.appendType
      break
      BitCast .case =:: src
        "bitCast ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) src: " sb.appendS
        src typeContext sb.appendType
      break
      CallPtr case
        "call pointer ( " sb.appendS
        op .dataType typeContext sb.appendType
        " )" sb.appendS
      break
      Length case
        "length ( " sb.appendS
        op .dataType typeContext sb.appendType
        " )" sb.appendS
      break
      RawValue case
        "raw ( " sb.appendS
        op .dataType typeContext sb.appendType
        " )" sb.appendS
      break
      TypeOf case
        "type-of":s sb.appendStr
      break
      TypeInfo .case =:: typeInfo
        "typeInfo ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ): " sb.appendS
        typeInfo switch
          ALIGNMENT case "alignment" sb.appendS break
          SIZE case "size" sb.appendS break
          STRIDE case "stride" sb.appendS break
        end
      break
      GetUnionTag case
        "get union tag ( " sb.appendS
        op .dataType typeContext sb.appendType
        " )" sb.appendS
      break
      StackMod .case =:: stackMod
        "stack modification: " sb.appendS
        stackMod sb.appendStackMod
      break
      GetName .case =:: name
        "get: " sb.appendS
        name sb.appendStr
      break
      AtName .case =:: name
        "address of: " sb.appendS
        name sb.appendStr
      break
      SetName .case =:: name
        "set: " sb.appendS
        name sb.appendStr
      break
      ElementSetName .case =:: name
        "element set: " sb.appendS
        name sb.appendStr
      break
      ExistsName .case =:: name
        "exists name: " sb.appendS
        name sb.appendStr
      break
      DeclareName .case =:: name
        "declare name: " sb.appendS
        name nameContext sb.appendIdentifierPath
      break
      AliasName .case =:: aliasData
        "alias name: " sb.appendS
        aliasData .alias nameContext sb.appendIdentifierPath
        aliasData .baseName nameContext sb.appendIdentifierPath
      break
      InitializeName .case =:: initName
        "initialize name: ":s sb.appendStr
        initName nameContext sb.appendIdentifierPath
      break
      UsingNamespace .case =:: usingNamespace
        "using namespace: ":s sb.appendStr
        usingNamespace .baseName nameContext sb.appendIdentifierPath
        usingNamespace .alias .if =:: aliasName
          " as ":s sb.appendStr
          aliasName sb.appendIdentifierName
        end
      break
      UsingIdentifier .case =:: usingIdentifier
        "using idenfifier: ":s sb.appendStr
        usingIdentifier .baseName nameContext sb.appendIdentifierPath
        usingIdentifier .alias .if =:: aliasName
          " as ":s sb.appendStr
          aliasName sb.appendIdentifierName
        end
      break
      Assert case
        "assert" sb.appendS
      break
      Error .case switch
          ERROR case "..compiler.error" sb.appendS break
          WARNING case "..compiler.warning" sb.appendS break
          INFO case "..compiler.info" sb.appendS break
        end
      break
      Panic case
        "..panic" sb.appendS
      break
      PanicWithMessage .case =:: msg
        '"' sb.appendC
        msg sb.appendEscapedStr
        "\" ..panic" sb.appendS
      break
      Import .case =:: path
        "import \"" sb.appendS
        path sb.appendEscapedStr
        '"' sb.appendC
      break
      LibImport .case =:: path
        "lib-import \"" sb.appendS
        path sb.appendEscapedStr
        '"' sb.appendC
      break
      CompilerInfo .case nameContext sb.appendCompilerInfo break
    end
      " at " sb.appendS
      op .pos [] sb.appendPos
      '\n' sb.appendC
    return
  end
  proc( stringBuilder Operation : op ProgramContext ptr : progContext -> stringBuilder ) =>: export: appendOp
    progContext .idContext .typeContext =:: typeContext
    progContext .idContext .typeContext .nameContext =:: nameContext
    progContext .idContext .constContext =:: constContext
    op .val switch
      NOP case
        "NOP" sb.appendS
        break
      Constant .case =:: constVal
        "constant ( " sb.appendS
        op .dataType  typeContext sb.appendType
        " ) : " sb.appendS
        constVal typeContext sb.appendConstant
      break
      NestedProc .case =:: procId
        "nested proc ( " sb.appendS
        op .dataType  typeContext sb.appendType
        " ) : " sb.appendS
        procId ProcId.getName nameContext sb.appendIdentifierPath
      break
      ConstantReference .case =:: refId
        progContext [] .constantReferences refId i64 cast @[] =:: constData
        "constant reference ( " sb.appendS
        constData [] .constType typeContext sb.appendType
        " )[" sb.appendS
        refId i64 cast sb.appendI
        "] : " sb.appendS
        constData [] .value typeContext sb.appendConstant
      break
      Block .case =:: blockData
        "Block: " sb.appendS
        blockData .blockType sb.appendBlockType
        " (" sb.appendS
          blockData .blockId i64 cast sb.appendI
          " ->" sb.appendS
          blockData .jumpDistance i64 cast sb.appendI
        ')' sb.appendC
      break
      BlockEnd .case =:: blockData
        "End: " sb.appendS
        blockData .blockType sb.appendBlockType
        " (" sb.appendS
          blockData .blockId i64 cast sb.appendI
          " ->" sb.appendS
          blockData .jumpDistance i64 cast sb.appendI
        ')' sb.appendC
      break
      LocalLabel .case =:: labelInfo
        "Label(" sb.appendS
        labelInfo .labelType sb.appendLocalLabelType
        "): " sb.appendS
        labelInfo .labelId i64 cast sb.appendI
      break
      LocalJump .case =:: jumpInfo
        "Jump( " sb.appendS
        jumpInfo .cmpType sb.appendCmpType
        jumpInfo .cmpType .NONE ! and  jumpInfo .cmpType .TRUE ! and
            jumpInfo .cmpType .FALSE ! if
          ' ' sb.appendC
          op .dataType  typeContext sb.appendType
        end
        " ): " sb.appendS
        jumpInfo .labelId i64 cast.u sb.appendI
        " -> " sb.appendS
        jumpInfo .jumpDistance i64 cast.s sb.appendI
      break
      Call .case =:: procId
        "call ( " sb.appendS
        op .dataType  typeContext sb.appendType
        " ) : " sb.appendS
        procId ProcId.getProcInfo =:: procInfo
        procInfo [] .nameId nameContext sb.appendIdentifierPath
        ## XXX? print auto args
      break
      BuiltIn .case =:: builtInId
        "built-in ( " sb.appendS
        op .dataType  typeContext sb.appendType
        " ) : " sb.appendS
        builtInId sb.appendBuiltIn
      break
      GetId .case =:: id
        "get ( " sb.appendS
        op .dataType  typeContext sb.appendType
        " ) : " sb.appendS
        id nameContext sb.appendIdInfo
      break
      SetId .case =:: id
        "set ( " sb.appendS
        op .dataType  typeContext sb.appendType
        " ) : " sb.appendS
        id nameContext sb.appendIdInfo
      break
      AtId .case =:: id
        "address ( " sb.appendS
        op .dataType  typeContext sb.appendType
        " ) : " sb.appendS
        id nameContext sb.appendIdInfo
      break
      ImplementProcedure .case =:: procId
        "implement ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) : " sb.appendS
        procId ProcId.getProcInfo =:: procInfo
        procInfo [] .nameId nameContext sb.appendIdentifierPath
      break
      ProcPtr .case =:: procId
        "procedure pointer ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) : " sb.appendS
        procId ProcId.getProcInfo =:: procInfo
        procInfo [] .nameId nameContext sb.appendIdentifierPath
      break
      DeclareId .case =:: id
        "declare ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) : " sb.appendS
        id nameContext sb.appendIdInfo
      break
      GetNamedElt .case =:: name
        "get element ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) : " sb.appendS
        name sb.appendStr
      break
      SetNamedElt .case =:: name
        "set element ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) : " sb.appendS
        name sb.appendStr
      break
      SetNestedNamedElt .case =:: name
        "set nested element ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) : " sb.appendS
        name sb.appendStr
      break
      ExistsNamedElt .case =:: name
        "exists element ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) : " sb.appendS
        name sb.appendStr
      break
      TypeWith .case =:: procId
        "type with( " sb.appendS
          procId ProcId.getName nameContext sb.appendIdentifierPath
        "@ )" sb.appendS
      break
      TypeModifier .case =:: typeModifier
        "typeModifier \"" sb.appendS
          typeModifier sb.appendTypeModifier
        "\"" sb.appendS
      break
      GetElement .case =:: index
        "get element ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) : " sb.appendS
        index sb.appendI
      break
      SetElement .case =:: index
        "set element ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) : " sb.appendS
        index sb.appendI
      break
      SetNestedElement .case =:: path
        "set nested element ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) :" sb.appendS
        =:: mut: newSb
        path ( i32 : i stringBuilder ptr.mut : sb -> ) =>
          sb []
            ' ' sb.appendC
            i sb.appendI
          sb =[]
        end newSb@ NestedElementPath.forEach newSb
      break
      Return case
        "Return( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) " sb.appendS
      break
      Splat case
        "splat: " sb.appendS
        op .dataType typeContext sb.appendType
      break
      New case
        "new: " sb.appendS
        op .dataType typeContext sb.appendType
      break
      NewReference case
        "new reference: " sb.appendS
        op .dataType typeContext sb.appendType
      break
      NewUnion .case =:: eltIndex
        "new union ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) : " sb.appendS
        eltIndex sb.appendI
      break
      NewUnionReference .case =:: eltIndex
        "new union reference ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) : " sb.appendS
        eltIndex sb.appendI
      break
      AutoCast .case =:: autoCast
        "autoCast ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) src: " sb.appendS
        autoCast .src typeContext sb.appendType
        " at " sb.appendS
        autoCast .offset sb.appendI
      break
      Cast .case =:: castInfo
        castInfo .signType switch
          NONE case break
          SIGNED case "signed " sb.appendS break
          UNSIGNED case "unsigned " sb.appendS break
        end
        "cast ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) src: " sb.appendS
        castInfo .src typeContext sb.appendType
      break
      Cast! .case =:: src
        "cast! ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) src: " sb.appendS
        src typeContext sb.appendType
      break
      BitCast .case =:: src
        "bitCast ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) src: " sb.appendS
        src typeContext sb.appendType
      break
      CallPtr case
        "call pointer ( " sb.appendS
        op .dataType typeContext sb.appendType
        " )" sb.appendS
      break
      Length case
        "length ( " sb.appendS
        op .dataType typeContext sb.appendType
        " )" sb.appendS
      break
      RawValue case
        "raw ( " sb.appendS
        op .dataType typeContext sb.appendType
        " )" sb.appendS
      break
      TypeOf case
        "type-of":s sb.appendStr
      break
      TypeInfo .case =:: typeInfo
        "typeInfo ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ): " sb.appendS
        typeInfo switch
          ALIGNMENT case "alignment" sb.appendS break
          SIZE case "size" sb.appendS break
          STRIDE case "stride" sb.appendS break
        end
      break
      GetUnionTag case
        "get union tag ( " sb.appendS
        op .dataType typeContext sb.appendType
        " )" sb.appendS
      break
      StackMod .case =:: stackMod
        "stack modification: " sb.appendS
        stackMod sb.appendStackMod
      break
      Copy case
        "copy( " sb.appendS
        op .dataType typeContext sb.appendType
        " )" sb.appendS
      break
      GetName .case =:: name
        "get: " sb.appendS
        name sb.appendStr
      break
      AtName .case =:: name
        "address of: " sb.appendS
        name sb.appendStr
      break
      SetName .case =:: name
        "set: " sb.appendS
        name sb.appendStr
      break
      ElementSetName .case =:: name
        "element set: " sb.appendS
        name sb.appendStr
      break
      ExistsName .case =:: name
        "exists name: " sb.appendS
        name sb.appendStr
      break
      DeclareName .case =:: name
        "declare name: " sb.appendS
        name nameContext sb.appendIdentifierPath
      break
      AliasName .case =:: aliasData
        "alias name: " sb.appendS
        aliasData .alias nameContext sb.appendIdentifierPath
        aliasData .baseName nameContext sb.appendIdentifierPath
      break
      InitializeName .case =:: initName
        "initialize name: ":s sb.appendStr
        initName nameContext sb.appendIdentifierPath
      break
      UsingNamespace .case =:: usingNamespace
        "using namespace: ":s sb.appendStr
        usingNamespace .baseName nameContext sb.appendIdentifierPath
        usingNamespace .alias .if =:: aliasName
          " as ":s sb.appendStr
          aliasName sb.appendIdentifierName
        end
      break
      UsingIdentifier .case =:: usingIdentifier
        "using idenfifier: ":s sb.appendStr
        usingIdentifier .baseName nameContext sb.appendIdentifierPath
        usingIdentifier .alias .if =:: aliasName
          " as ":s sb.appendStr
          aliasName sb.appendIdentifierName
        end
      break
      Assert case
      "assert" sb.appendS
      break
      RuntimeAssert .case =:: msg
        '"' sb.appendC
        msg sb.appendStr
        "\" assert" sb.appendS
      break
      Error .case switch
          ERROR case "..compiler.error" sb.appendS break
          WARNING case "..compiler.warning" sb.appendS break
          INFO case "..compiler.info" sb.appendS break
        end
      break
      Panic case
        "..panic" sb.appendS
      break
      PanicWithMessage .case =:: msg
        '"' sb.appendC
        msg sb.appendEscapedStr
        "\" ..panic" sb.appendS
      break
      Import .case =:: path
        "import \"" sb.appendS
        path sb.appendEscapedStr
        '"' sb.appendC
      break
      LibImport .case =:: path
        "lib-import \"" sb.appendS
        path sb.appendEscapedStr
        '"' sb.appendC
      break
      CompilerInfo .case nameContext sb.appendCompilerInfo break
    end
      " at " sb.appendS
      op .pos [] sb.appendPos
      '\n' sb.appendC
    return
  end
  proc( stringBuilder CompilerError : err -> stringBuilder ) =>: export: appendCompilerError
    err .message sb.appendSb
    " at "       sb.appendS
    err .pos []  sb.appendPos
    '\n'         sb.appendC
  end
  proc( stringBuilder CompilerInfo : info NameContext ptr : nameContext -> stringBuilder ) =>: export: appendCompilerInfo
    info switch
      TypeInfo .case =:: typeInfo
        "..?types" sb.appendS
        typeInfo .count 0 > if
          '.' sb.appendC
          typeInfo .count sb.appendI
        end
        typeInfo .depth 0 > if
          '.' sb.appendC
          typeInfo .depth sb.appendI
        end
        break
      StackInfo .case =:: count
        "..?stack" sb.appendS
        count 0 > if
          '.' sb.appendC
          count sb.appendI
        end
        break
      TypeLayout .case =:: depth
        "..?type.layout" sb.appendS
        depth 1 > if
          '.' sb.appendC
          depth sb.appendI
        end
        break
      CompiledOps .case =:: count
        "..?ops" sb.appendS
        count 0 > if
          '.' sb.appendC
          count sb.appendI
        end
        break
      Find .case =:: id
        "..?find." sb.appendS
        id nameContext sb.appendIdentifierPath
        break
    end
  end
  proc( stringBuilder ProgramContext ptr : prog -> stringBuilder ) =>: export: appendProgram
    prog .idContext .typeContext =:: typeContext
    typeContext .nameContext =:: nameContext
    "## errors:\n" sb.appendS
    prog [] .errors errorCmp@ list.sort
    prog [] .errors for sb.appendCompilerError end
    "## global:\n" sb.appendS
    prog [] .globalOps for prog sb.appendPreOp end
    prog [] .procedures for ProcId.getProcInfo =:: proc
      proc .implementation .Code .else
        ..drop continue
      end =:: impl
      "## "          sb.appendS
      proc [] .nameId nameContext sb.appendIdentifierPath
      impl .genericInfo .ImplInfo .if
        [] .staticArgs for >$ ' ' sb.appendC <$ typeContext sb.appendConstant end
      else ..drop end
      '\n'           sb.appendC
      impl [] .codeState .UNUSED if continue end ## ignore unused procs
      impl [] .code for prog sb.appendOp end
      '\n' sb.appendC
    end
  end
end
