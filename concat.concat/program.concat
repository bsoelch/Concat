  i16 8 array : path
  i8 : length
) =:: export: NestedElementPath16
struct(
  i32 4 array : path
  i8 : length
) =:: export: NestedElementPath32
union(
  NestedElementPath8 : Path8
  NestedElementPath16 : Path16
  NestedElementPath32 : Path32
  i32 slice : LongPath
) =:: export: NestedElementPath
namespace: NestedElementPath
  proc( type : auto: C NestedElementPath ( i32 C -> ) ptr : f C : c -> ) =>: export: forEach
    switch
      Path8 .case =:: path
        path .length iSize cast.u for
          path .path >$ [] i32 cast.u c f ()
        end
      break
      Path16 .case =:: path
        path .length iSize cast.u for
          path .path >$ [] i32 cast.u c f ()
        end
      break
      Path32 .case =:: path
        path .length iSize cast.u for
          path .path >$ [] i32 cast.u c f ()
        end
      break
      LongPath .case for c f () end break
    end
  end
end
