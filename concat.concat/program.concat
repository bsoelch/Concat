i16 =:: export: ProcFlags
namespace: ProcFlags
  ( ProcFlags ProcFlags -> ProcFlags ) : export: alias: and i16.and
  ( ProcFlags ProcFlags -> ProcFlags ) : export: alias: or i16.or
  ( ProcFlags ProcFlags -> ProcFlags ) : export: alias: xor i16.xor
  ( ProcFlags -> ProcFlags ) : export: alias: flip i16.flip
  ( ProcFlags -> bool ) : export: alias: toBool i16.toBool
  0x00 ProcFlags =: export: NONE
  0x01 ProcFlags =: export: HAS_STATIC_ARG
  0x02 ProcFlags =: export: IS_STATIC

  0x04 ProcFlags =: export: IS_CALLED
  0x08 ProcFlags =: export: HAS_POINTER
  IS_CALLED HAS_POINTER ProcFlags.or =:: export: IS_USED
end
overload: merge: & ProcFlags.and end
overload: merge: | ProcFlags.or end
overload: merge: ^ ProcFlags.xor end
overload: merge: ~ ProcFlags.flip end
overload: merge: ? ProcFlags.toBool end
struct(
  ProcImplType : implementation
  NameId : nameId
  FileId : fileId
  id.ScopeId : scopeId ## host-scope if parsing, body-scope if type-checked
  Type : procType
  ProcFlags : flags
) =:: export: ProcedureInfo
proc( ProcedureInfo : p -> ) =>: freeProcedure
  p .implementation .Code .if =:: impl
    impl .codeState switch
      Parsing case break
      Parsed PreTypeChecking TypeChecking .case ## parsed impl contains shallow copy of generic-proc code
        impl .genericInfo .ImplInfo ? ! if slice.free end ..drop
      break
      TypeChecked PreCompiled .case slice.free ..drop break
    end
    impl .genericInfo .Implementations .if
      list.free ..drop
    else .QuotationImpls ._if
      list.free ..drop
    else ..drop end
  else ..drop end
end
namespace: ProcId
  proc( ProcId -> NameId ) =>: export: getName
    getProcInfo [] .nameId
  end
end
namespace: program
  proc(
    Type : procType
    ProcId : baseQuotation
    ProgramContext ptr.mut : progContext
  -> ProcId optional ) =>: export: initializeQuotation
    progContext .idContext .typeContext .nameContext =:: nameContext
    baseQuotation ProcId.getProcInfo =:: baseProcInfo
    baseProcInfo .implementation .Code .else ..drop
      ProcId optional.empty return
    end =:: codeImpl
    codeImpl .genericInfo .QuotationImpls .else ..drop
      ProcId optional.empty return
    end =:: impls
    impls [] for =:: implData
      implData .procType procType types.typeEquals if
        implData .procId optional.wrap return
      end
    end
    progContext [] .programMemory
      ## ProcedureInfo
        ## CodeProcData
          0 VariableInfo list.create
          ## GenericImplementationInfo
            ConstValue slice.empty
            baseQuotation
          GenericImplementationInfo new GenericProcInfo .ImplInfo
          codeImpl [] .codeState .PreTypeChecking .else
            "expected parsed procedure" ..panic
          end ProcCodeState .PreTypeChecking ## reuse code from generic base procedure
          codeImpl [] .expansionLevel 1:i16 +
        CodeProcData new ProcImplType .Code
        baseProcInfo [] .nameId impls [] .length i32 cast.u nameContext id.newImplName
        baseProcInfo [] .fileId
        baseProcInfo [] .scopeId
        procType
        baseProcInfo [] .flags ProcFlags.HAS_STATIC_ARG ~ & ## TODO? can quotation have generic arg
      ProcedureInfo new mixedArena.copyValue ProcId.create =:: implProdId
    progContext .programMemory=
    progContext [] .procedures
      implProdId list.append
    progContext .procedures=
    impls []
      procType implProdId TypedProcedure new list.append
    impls =[]
    implProdId optional.wrap return
  end
end

