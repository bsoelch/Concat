struct(
            IdentifierContext : idContext
             ProgramFile list : progFiles
           ProcedureInfo list : procedures
         ProcedureBundle list : procBundles
                    Type list : autoTypes
               Operation list : globalOps
          MixedArenaAllocator : programMemory ## TODO? merge non-linear buffers into Allocator
              SwitchData list : switchData
               WhileData list : whileData
                  IfData list : ifData
               AndOrData list : andOrData
           TypedConstant list : constantReferences
                 LabelId list : labelBuffer
                stringBuilder : tmpString
                CallData list : callData
           CompilerError list : errors
                        string : basePath
                        string : libPath
                      LabelId : mainLabelId
                       ProcId : mainProcId
                         bool : saveGlobalTokens
                         bool : inLibFile
                         bool : hasGetArgs
) =:: export: ProgramContext

proc(
  string : basePath
  string : libPath
  bool : saveGlobalTokens
-> ProgramContext ) =>: export: newProgramContext
  ## ProgramContext
    id.newIdentifierContext
    16  ProgramFile     list.create
    64  ProcedureInfo   list.create
    64  ProcedureBundle list.create
    32  Type            list.create
    1024 Operation      list.create
    4096                mixedArena.create
    128 SwitchData      list.create
    128 WhileData       list.create
    256 IfData          list.create
    128 AndOrData       list.create
    32  TypedConstant   list.create
    32  LabelId         list.create
    256 sb.create
    1024 CallData       list.create
    32  CompilerError   list.create
    basePath
    libPath
    id.LABEL_ID_NONE ## main LabelId
    NO_PROC ## main ProcId
    saveGlobalTokens
    false ## inLibFile
    false ## has getArgs
  ProgramContext new
end
proc( ProgramContext -> ProgramContext ) =>: export: freeProgramContext
  $ .idContext id.freeIdentifierContext >$ .idContext=
  $ .progFiles list.free >$ .progFiles=
  $ .procedures for freeProcedure end
  $ .procedures list.free >$ .procedures=
  $ .procBundles list.free >$ .procBundles=
  $ .autoTypes list.free >$ .autoTypes=
  $ .globalOps list.free >$ .globalOps=
  $ .programMemory mixedArena.free >$ .programMemory=
  $ .switchData list.free >$ .switchData=
  $ .whileData list.free >$ .whileData=
  $ .ifData list.free >$ .ifData=
  $ .andOrData list.free >$ .andOrData=
  $ .constantReferences list.free >$ .constantReferences=
  $ .labelBuffer list.free >$ .labelBuffer=
  $ .tmpString sb.free >$ .tmpString=
  $ .callData list.free >$ .callData=
  $ .errors list.free >$ .errors=
  id.LABEL_ID_NONE >$ .mainLabelId=
  NO_PROC >$ .mainProcId=
  false >$ .hasGetArgs=
end

proc(
  stringBuilder : fileName
  FileId : id
-> ProgramFile ) =>: export: newProgFile
  ## ProgramFile
    fileName
    id
    id.NO_SCOPE
  ProgramFile new return
end

proc(
  ConstValue : constValue
  Type : constType
  FilePosition : pos
  ProgramContext ptr.mut : program
-> Operation ) =>: export: opConstReference
  program [] .constantReferences
    ..dup .length ConstReferenceId cast =:: refId
    constType constValue pos TypedConstant new list.append
  program .constantReferences=
  program .idContext .typeContext =:: typeContext
  ## Operation
    refId OpValue .ConstantReference
    constType
    pos
  Operation new return
end

namespace: sb
  proc( stringBuilder : sb StackModification : mod -> stringBuilder ) =>: export: appendStackMod
    sb
      mod .modType switch
        COPY case
          mod .n 0 == if
            "DUP " sb.appendS
          else
            "OVER " sb.appendS
            mod .n sb.appendI
          end
          break
        ROTATE case
          mod .n 1 == if
            "SWAP " sb.appendS
          else
            "ROTATE " sb.appendS
          end
          break
        DROP case
          "DROP " sb.appendS
          mod .n  sb.appendI
          break
      end
    return
  end
  proc( stringBuilder TypeModifier -> stringBuilder ) =>: export: appendTypeModifier
    switch
      ARRAY case
        "array" sb.appendS
        break
      PTR case
        "ptr" sb.appendS
        break
      PTR_MUT case
        "ptr.mut" sb.appendS
        break
      RAW_PTR case
        "ptr.raw" sb.appendS
        break
      RAW_PTR_MUT case
        "ptr.raw.mut" sb.appendS
        break
    end
  end
  proc( stringBuilder Operation : op ProgramContext ptr : progContext -> stringBuilder ) =>: export: appendOp
    progContext .idContext .typeContext =:: typeContext
    progContext .idContext .typeContext .labelContext =:: labelContext
    progContext .idContext .constContext =:: constContext
    op .val switch
      NOP case
        "NOP" sb.appendS
        break
      Constant .case =:: constVal
        "constant ( " sb.appendS
        op .dataType  typeContext sb.appendType
        " ) : " sb.appendS
        constVal typeContext sb.appendConstant
      break
      NestedProc .case =:: procId
        "nested proc ( " sb.appendS
        op .dataType  typeContext sb.appendType
        " ) : " sb.appendS
        procId i64 cast.u sb.appendI
        ":ProcId" sb.appendS
      break
      ConstantReference .case =:: refId
        progContext [] .constantReferences refId i64 cast @[] =:: constData
        "constant reference ( " sb.appendS
        constData [] .constType typeContext sb.appendType
        " )[" sb.appendS
        refId i64 cast sb.appendI
        "] : " sb.appendS
        constData [] .value typeContext sb.appendConstant
      break
      Block .case =:: blockData
        "Block: " sb.appendS
        blockData .blockType sb.appendBlockType
        " (" sb.appendS
          blockData .blockId i64 cast sb.appendI
          " ->" sb.appendS
          blockData .jumpDistance i64 cast sb.appendI
        ')' sb.appendC
      break
      BlockEnd .case =:: blockData
        "End: " sb.appendS
        blockData .blockType sb.appendBlockType
        " (" sb.appendS
          blockData .blockId i64 cast sb.appendI
          " ->" sb.appendS
          blockData .jumpDistance i64 cast sb.appendI
        ')' sb.appendC
      break
      Call .case =:: callInfo
        "call ( " sb.appendS
        op .dataType  typeContext sb.appendType
        " ) : " sb.appendS
        progContext [] .procedures
          callInfo .procId i64 cast @[]
        =:: procInfo
        procInfo [] .labelId labelContext sb.appendLabelPath
        callInfo .implementationId 0 >= if
          ## XXX append static args instead of impl id
          " (" sb.appendS
          callInfo .implementationId sb.appendI
          ')' sb.appendC
        end
        ## XXX? print auto args
      break
      BuiltIn .case =:: builtInId
        "built-in ( " sb.appendS
        op .dataType  typeContext sb.appendType
        " ) : " sb.appendS
        builtInId sb.appendBuiltIn
      break
      GetId .case =:: id
        "get ( " sb.appendS
        op .dataType  typeContext sb.appendType
        " ) : " sb.appendS
        id labelContext sb.appendIdInfo
      break
      SetId .case =:: id
        "set ( " sb.appendS
        op .dataType  typeContext sb.appendType
        " ) : " sb.appendS
        id labelContext sb.appendIdInfo
      break
      AtId .case =:: id
        "address ( " sb.appendS
        op .dataType  typeContext sb.appendType
        " ) : " sb.appendS
        id labelContext sb.appendIdInfo
      break
      InitializeId .case =:: id
        "initialize ( " sb.appendS
        op .dataType  typeContext sb.appendType
        " ) : " sb.appendS
        id labelContext sb.appendIdInfo
      break
      ImplementProcedure .case =:: implInfo
        "implement ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) : " sb.appendS
        progContext [] .procedures
          implInfo .procId i64 cast @[]
        =:: procInfo
        procInfo [] .labelId labelContext sb.appendLabelPath
        implInfo .implementationId 0 >= if
          ## XXX append static args instead of impl id
          " (" sb.appendS
          implInfo .implementationId sb.appendI
          ')' sb.appendC
        end
      break
      ProcPtr .case =:: implInfo
        "procedure pointer ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) : " sb.appendS
        progContext [] .procedures
          implInfo .procId i64 cast @[]
        =:: procInfo
        procInfo [] .labelId labelContext sb.appendLabelPath
        implInfo .implementationId 0 >= if
          ## XXX append static args instead of impl id
          " (" sb.appendS
          implInfo .implementationId sb.appendI
          ')' sb.appendC
        end
      break
      AutoTypedInitializeId .case =:: id
        "auto-typed initialize ( " sb.appendS
        op .dataType  typeContext sb.appendType
        " ) : " sb.appendS
        id labelContext sb.appendIdInfo
      break
      DeclareId .case =:: id
        "declare ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) : " sb.appendS
        id labelContext sb.appendIdInfo
      break
      GetLabel .case =:: name
        "get label ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) : " sb.appendS
        name labelContext sb.appendLabelName
      break
      GetUnionLabel .case =:: name
        "get union label ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) : " sb.appendS
        name labelContext sb.appendLabelName
      break
      SetLabel .case =:: name
        "set label ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) : " sb.appendS
        name labelContext sb.appendLabelName
      break
      ExistsLabel .case =:: name
        "exists label ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) : " sb.appendS
        name labelContext sb.appendLabelName
      break
      TypeWith .case =:: procId
        "type with( " sb.appendS
          procId i64 cast.u sb.appendI
        ":ProcId )" sb.appendS
      break
      TypeModifier .case =:: typeModifier
        "typeModifier \"" sb.appendS
          typeModifier sb.appendTypeModifier
        "\"" sb.appendS
      break
      GetElement .case =:: index
        "get element ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) : " sb.appendS
        index sb.appendI
      break
      GetUnionElement .case =:: index
        "get union element ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) : " sb.appendS
        index sb.appendI
      break
      SetElement .case =:: index
        "set element ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) : " sb.appendS
        index sb.appendI
      break
      HasElement .case =:: index
        "has element ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) : " sb.appendS
        index sb.appendI
      break
      Return case
        "Return( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) " sb.appendS
      break
      InlineReturn .case =:: blockId
        "InlineReturn " sb.appendS
          blockId i64 cast sb.appendI
        " ( " sb.appendS
        op .dataType typeContext sb.appendType
        " )" sb.appendS
      break
      EqualityOperator .case
        switch
          EQ case "Equal ( " sb.appendS break
          NEQ case "Not Equal ( " sb.appendS break
        end
        op .dataType typeContext sb.appendType
        " )" sb.appendS
      break
      Splat case
        "splat: " sb.appendS
        op .dataType typeContext sb.appendType
      break
      New case
        "new: " sb.appendS
        op .dataType typeContext sb.appendType
      break
      NewReference case
        "new reference: " sb.appendS
        op .dataType typeContext sb.appendType
      break
      NewEnum .case =:: eltIndex
        "new enum ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) : " sb.appendS
        eltIndex sb.appendI
      break
      NewEnumReference .case =:: eltIndex
        "new enum reference ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) : " sb.appendS
        eltIndex sb.appendI
      break
      AutoCast .case =:: autoCast
        "autoCast ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) src: " sb.appendS
        autoCast .src typeContext sb.appendType
        " at " sb.appendS
        autoCast .offset sb.appendI
      break
      Cast .case =:: castInfo
        castInfo .signType switch
          NONE case break
          SIGNED case "signed " sb.appendS break
          UNSIGNED case "unsigned " sb.appendS break
        end
        "cast ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) src: " sb.appendS
        castInfo .src typeContext sb.appendType
      break
      Cast! .case =:: src
        "cast! ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) src: " sb.appendS
        src typeContext sb.appendType
      break
      BitCast .case =:: src
        "bitCast ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) src: " sb.appendS
        src typeContext sb.appendType
      break
      CallPtr case
        "call pointer ( " sb.appendS
        op .dataType typeContext sb.appendType
        " )" sb.appendS
      break
      Length case
        "length ( " sb.appendS
        op .dataType typeContext sb.appendType
        " )" sb.appendS
      break
      RawValue case
        "raw ( " sb.appendS
        op .dataType typeContext sb.appendType
        " )" sb.appendS
      break
      TypeInfo .case =:: typeInfo
        "typeInfo ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ): " sb.appendS
        typeInfo switch
          ALIGNMENT case "alignment" sb.appendS break
          SIZE case "size" sb.appendS break
          STRIDE case "stride" sb.appendS break
        end
      break
      GetEnumLabel case
        "get enum label ( " sb.appendS
        op .dataType typeContext sb.appendType
        " )" sb.appendS
      break
      SetEnumElement .case =:: index
        "set enum element ( " sb.appendS
        op .dataType typeContext sb.appendType
        " ) : " sb.appendS
        index sb.appendI
      break
      StackMod .case =:: stackMod
        "stack modification: " sb.appendS
        stackMod sb.appendStackMod
      break
      Copy case
        "copy( " sb.appendS
        op .dataType typeContext sb.appendType
        " )" sb.appendS
      break
      GetName .case =:: name
        "get: " sb.appendS
        name labelContext sb.appendLabelPath
      break
      AtName .case =:: name
        "address of: " sb.appendS
        name labelContext sb.appendLabelPath
      break
      SetName .case =:: name
        "set: " sb.appendS
        name labelContext sb.appendLabelPath
      break
      ExistsName .case =:: name
        "exists name: " sb.appendS
        name labelContext sb.appendLabelPath
      break
      DeclareName .case =:: name
        "declare name: " sb.appendS
        name labelContext sb.appendLabelPath
      break
      AliasName .case =:: aliasData
        "alias name: " sb.appendS
        aliasData .alias labelContext sb.appendLabelPath
        aliasData .baseName labelContext sb.appendLabelPath
      break
      InitializeName .case =:: initInfo
        initInfo .initType .AUTO if
          "auto-typed " sb.appendS
        end
        "initialize name: " sb.appendS
        initInfo .label labelContext sb.appendLabelPath
      break
      UsingNamespace .case =:: usingNamespace
        "using namespace: " sb.appendS
        usingNamespace .baseName labelContext sb.appendLabelPath
        usingNamespace .alias id.LABEL_ID_NONE != if
          " as " sb.appendS
          usingNamespace .alias labelContext sb.appendLabelName
        end
      break
      UsingIdentifier .case =:: usingIdentifier
        "using idenfifier: " sb.appendS
        usingIdentifier .baseName labelContext sb.appendLabelPath
        usingIdentifier .alias id.LABEL_ID_NONE != if
          " as " sb.appendS
          usingIdentifier .alias labelContext sb.appendLabelName
        end
      break
      Assert case
      "assert" sb.appendS
      break
      RuntimeAssert .case =:: msg
        '"' sb.appendC
        msg sb.appendStr
        "\" assert" sb.appendS
      break
      Error .case switch
          ERROR case "..compiler.error" sb.appendS break
          WARNING case "..compiler.warning" sb.appendS break
          INFO case "..compiler.info" sb.appendS break
        end
      break
      Panic case
        "..panic" sb.appendS
      break
      PanicWithMessage .case =:: msg
        '"' sb.appendC
        msg sb.appendEscapedStr
        "\" ..panic" sb.appendS
      break
      Import .case =:: path
        "import \"" sb.appendS
        path sb.appendEscapedStr
        '"' sb.appendC
      break
      LibImport .case =:: path
        "lib-import \"" sb.appendS
        path sb.appendEscapedStr
        '"' sb.appendC
      break
      CompilerInfo .case labelContext sb.appendCompilerInfo break
    end
      " at " sb.appendS
      op .pos sb.appendPos
      '\n' sb.appendC
    return
  end
  proc( stringBuilder CompilerError : err -> stringBuilder ) =>: export: appendCompilerError
    err .message sb.appendSb
    " at "       sb.appendS
    err .pos     sb.appendPos
    '\n'         sb.appendC
  end
  proc( stringBuilder CompilerInfo : info LabelContext ptr : labelContext -> stringBuilder ) =>: export: appendCompilerInfo
    info switch
      TypeInfo .case =:: typeInfo
        "..?types" sb.appendS
        typeInfo .count 0 > if
          '.' sb.appendC
          typeInfo .count sb.appendI
        end
        typeInfo .depth 0 > if
          '.' sb.appendC
          typeInfo .depth sb.appendI
        end
        break
      StackInfo .case =:: count
        "..?stack" sb.appendS
        count 0 > if
          '.' sb.appendC
          count sb.appendI
        end
        break
      CompiledOps .case =:: count
        "..?ops" sb.appendS
        count 0 > if
          '.' sb.appendC
          count sb.appendI
        end
        break
      Find .case =:: id
        "..?find." sb.appendS
        id labelContext sb.appendLabelPath
        break
    end
  end
  proc( stringBuilder ProgramContext ptr : prog -> stringBuilder ) =>: export: appendProgram
    prog .idContext .typeContext .labelContext =:: labelContext
    "## errors:\n" sb.appendS
    prog [] .errors errorCmp@ list.sort
    prog [] .errors for sb.appendCompilerError end
    "## global:\n" sb.appendS
    prog [] .globalOps for prog sb.appendOp end
    prog [] .procedures for =:: proc
      proc .implementation .?Code .else
        ..drop continue
      end =:: impl
      "## "          sb.appendS
      proc .labelId labelContext sb.appendLabelPath
      '\n'           sb.appendC
      impl .codeState .UNUSED if continue end ## ignore unused procs
      impl .code for prog sb.appendOp end
      '\n' sb.appendC
      impl .implementations for =:: genericImpl
        genericImpl .code for prog sb.appendOp end
        '\n' sb.appendC
      end
    end
  end
end

namespace: program.jumps
  proc(
    BlockId : blockId
    i32 : newIndex
    ProgramContext ptr.mut : program
  -> ) =>: export: updateAndIf
    program [] .ifData
      blockId i32 cast
    @[] =:: ifData
    ifData [] .andCount ifData [] .orCount + 0 == if
      newIndex ifData .blockStart=
    end
    ifData [] .andCount
      newIndex ifData [] .andPositions $2 slice.set
      1 +
    ifData .andCount=
  end
  proc(
    BlockId : blockId
    i32 : newIndex
    ProgramContext ptr.mut : program
  -> ) =>: export: updateOrIf
    program [] .ifData
      blockId i32 cast
    @[] =:: ifData
    ifData [] .andCount ifData [] .orCount + 0 == if
      newIndex ifData .blockStart=
    end
    ifData [] .orCount
      newIndex ifData [] .orPositions $2 slice.set
      1 +
    ifData .orCount=
  end
  proc(
    BlockId : blockId
    Operation slice.mut : newOps
    ProgramContext ptr.mut : program
  -> ) =>: export: updateIf
    program [] .ifData
      blockId i32 cast
    @[] =:: ifData
    ifData [] .andCount ifData [] .orCount + 0 == if
      newOps .length i32 cast ifData .blockStart=
    end
    newOps .length i32 cast ifData .ifPosition=
    ifData [] .orCount for =:: i
      ifData [] .orPositions
        i
      [] =:: orPos
      newOps .length i32 cast
        orPos - JumpDistance cast
      newOps
        orPos @[]
      .val .?Block .else "expected block" ..panic end .jumpDistance=
    end
    0 ifData .orCount=
  end
  proc(
    BlockId : blockId
    Operation slice.mut : newOps
    ProgramContext ptr.mut : program
  -> ) =>: export: updateElse
    program [] .ifData
      blockId i32 cast
    @[] =:: ifData
    newOps .length i32 cast ifData .elsePosition=
    ifData [] .andCount for =:: i
      ifData [] .andPositions
        i
      [] =:: andPos
      newOps .length i32 cast
        andPos - JumpDistance cast
      newOps
        andPos @[]
      .val .?Block .else "expected block" ..panic end .jumpDistance=
    end
    0 ifData .andCount=
    newOps .length i32 cast
      ifData [] .ifPosition - JumpDistance cast
    newOps
      ifData [] .ifPosition @[]
    .val .?Block .else "expected block" ..panic end .jumpDistance=
  end
  proc(
    BlockId : blockId
    Operation slice.mut : newOps
    ProgramContext ptr.mut : program
  -> JumpDistance ) =>: export: updateEndIf
    program [] .ifData
      blockId i32 cast
    @[] =:: ifData
    newOps .length i32 cast
      ifData [] .elsePosition - JumpDistance cast
    newOps
      ifData [] .elsePosition @[]
    .val .?Block .else "expected block" ..panic end .jumpDistance=
    ifData [] .blockStart
      newOps .length i32 cast -
    JumpDistance cast
  end

  proc(
    BlockId : blockId
    i32 : newIndex
    ProgramContext ptr.mut : program
  -> ) =>: export: updateSwitch
    newIndex
      program [] .switchData blockId i32 cast @[]
    .switchPosition=
  end
  proc(
    BlockId : blockId
    i32 : newIndex
    ProgramContext ptr.mut : program
  -> ) =>: export: updateCase
    program [] .switchData
      blockId i32 cast
    @[] =:: switchData
    switchData [] .caseCount
      newIndex
        switchData [] .switchPosition - JumpDistance cast
      switchData [] .caseJumpDistances $2 slice.set
      1 +
    switchData .caseCount=
  end
  proc(
    BlockId : blockId
    i32 : newIndex
    ProgramContext ptr.mut : program
  -> ) =>: export: updateDefault
    program [] .switchData
      blockId i32 cast
    @[] =:: switchData
    newIndex
      switchData [] .switchPosition - JumpDistance cast
    switchData .defaultJumpDistance=
  end
  proc(
    BlockId : blockId
    i32 : newIndex
    ProgramContext ptr.mut : program
  -> ) =>: export: updateBreakSwitch
    program [] .switchData
      blockId i32 cast
    @[] =:: switchData
    switchData [] .breakCount
      newIndex switchData [] .breakPositions $2 slice.set
      1 +
    switchData .breakCount=
  end
  proc(
    BlockId : blockId
    Operation slice.mut : newOps
    ProgramContext ptr.mut : program
  -> JumpDistance ) =>: export: updateEndSwitch
    program [] .switchData
      blockId i32 cast
    @[] =:: switchData
    switchData [] .breakCount for =:: i
      switchData [] .breakPositions
        i
      [] =:: breakPos
      newOps .length i32 cast
        breakPos - JumpDistance cast
      newOps
        breakPos @[]
      .val .?Block .else "expected block" ..panic end .jumpDistance=
    end
    0 switchData .breakCount=
    switchData [] .switchPosition
      newOps .length i32 cast -
    JumpDistance cast
  end

  proc(
    BlockId : blockId
    i32 : newIndex
    ProgramContext ptr.mut : program
  -> ) =>: export: updateWhile
    program [] .whileData
      blockId i32 cast
    @[] =:: whileData
    newIndex whileData .loopStart=
  end
  proc(
    BlockId : blockId
    i32 : newIndex
    ProgramContext ptr.mut : program
  -> ) =>: export: updateOrDo
    program [] .whileData
      blockId i32 cast
    @[] =:: whileData
    whileData [] .orCount
      newIndex whileData [] .orPositions $2 slice.set
      1 +
    whileData .orCount=
  end
  proc(
    BlockId : blockId
    i32 : newIndex
    ProgramContext ptr.mut : program
  -> ) =>: export: updateBreak
    program [] .whileData
      blockId i32 cast
    @[] =:: whileData
    whileData [] .breakCount
      newIndex whileData [] .breakPositions $2 slice.set
      1 +
    whileData .breakCount=
  end
  proc(
    BlockId : blockId
    i32 : newIndex
    ProgramContext ptr.mut : program
  -> ) : export: alias: updateAndDo updateBreak
  proc(
    BlockId : blockId
    i32 : newIndex
    ProgramContext ptr.mut : program
  -> ) =>: export: updateContinue
    program [] .whileData
      blockId i32 cast
    @[] =:: whileData
    whileData [] .continueCount
      newIndex whileData [] .continuePositions $2 slice.set
      1 +
    whileData .continueCount=
  end
  proc(
    BlockId : blockId
    Operation slice.mut : newOps
    ProgramContext ptr.mut : program
  -> ) =>: export: updateDo
    blockId newOps .length i32 cast program updateBreak
    program [] .whileData
      blockId i32 cast
    @[] =:: whileData
    whileData [] .orCount for =:: i
      whileData [] .orPositions i [] =:: orPos
      newOps .length i32 cast
        orPos - JumpDistance cast
      newOps
        orPos @[]
      .val .?Block .else "expected block" ..panic end .jumpDistance=
    end
    0 whileData .orCount=
  end
  proc(
    BlockId : blockId
    Operation slice.mut : newOps
    ProgramContext ptr.mut : program
  -> ) =>: export: updateFinally
    program [] .whileData
      blockId i32 cast
    @[] =:: whileData
    whileData [] .continueCount for =:: i
      whileData [] .continuePositions
        i
      [] =:: continuePos
      newOps .length i32 cast
        continuePos - JumpDistance cast
      newOps
        continuePos @[]
      .val .?Block .else "expected block" ..panic end .jumpDistance=
    end
    0 whileData .continueCount=
  end
  proc(
    BlockId : blockId
    Operation slice.mut : newOps
    ProgramContext ptr.mut : program
  -> JumpDistance ) =>: export: updateEndWhile
    program [] .whileData
      blockId i32 cast
    @[] =:: whileData
    whileData [] .breakCount for =:: i
      whileData [] .breakPositions i [] =:: breakPos
      newOps .length i32 cast
        breakPos - JumpDistance cast
      newOps
        breakPos @[]
      .val .?Block .else "expected block" ..panic end .jumpDistance=
    end
    0 whileData .breakCount=
    newOps .length i32 cast
      whileData [] .loopStart -
    =:: loopLength
    loopLength JumpDistance cast
    newOps whileData [] .loopStart
      @[]
    .val .?Block .else "expected block" ..panic end .jumpDistance=
    loopLength -_ JumpDistance cast
  end

  proc(
    BlockId : blockId
    i32 : newIndex
    ProgramContext ptr.mut : program
  -> ) =>: export: updateAnd
    program [] .andOrData
      blockId i32 cast
    @[] =:: andOrData
    andOrData [] .andOrCount 0 == if
      newIndex andOrData .blockStart=
    end
    andOrData [] .andOrCount
      newIndex andOrData [] .andOrPositions $2 slice.set
      1 +
    andOrData .andOrCount=
  end
  proc(
    BlockId : blockId
    i32 : newIndex
    ProgramContext ptr.mut : program
  -> ) : export: alias: updateOr updateAnd
  proc(
    BlockId : blockId
    Operation slice.mut : newOps
    ProgramContext ptr.mut : program
  -> JumpDistance ) =>: export: updateEndAndOr
    program [] .andOrData
      blockId i32 cast
    @[] =:: andOrData
    andOrData [] .andOrCount for =:: i
      andOrData [] .andOrPositions
        i
      [] =:: andOrPos
      newOps .length i32 cast
        andOrPos - JumpDistance cast
      newOps
        andOrPos @[]
      .val .?Block .else "expected block" ..panic end .jumpDistance=
    end
    0 andOrData .andOrCount=
    andOrData [] .blockStart
      newOps .length i32 cast -
    JumpDistance cast
  end
end
