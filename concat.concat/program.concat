import stringBuilder

import "constants.concat"
import "codeBlocks.concat"
import "identifiers.concat"
import "common.concat"

enum( NEGATE TO_BOOL NOT FLIP ) =:: export UnaryOperator
enum( ADD SUBTRACT MULTIPLY DIVIDE UDIVIDE MOD UMOD AND OR XOR LSHIFT RSHIFT URSHIFT EQ NE LT LE GE GT ULT ULE UGE UGT ) =:: export BinaryOperator
enum( COPY SWAP DROP ) =:: export StackModType
struct( i32 : n StackModType : modType ) =:: export StackModification
enum( i32 : typeInfo i32 : stackInfo i32 : compiledOps LabelId : find ) =:: export CompilerInfo
struct( IdentifierInfo : idInfo i64 : argCount ) =:: export CallInfo
enum( PTR ARRAY PTR_MUT ) =:: export TypeModifier
struct( Type : src i32 : mut offset ) =:: export CastInfo
enum( ALIGNMENT SIZE STRIDE ) =:: export TypeMemoryInfo

enum(
                      NOP
         ConstValue : mut Constant
            BlockId : mut block
            BlockId : mut blockEnd
     IdentifierInfo : mut getId
     IdentifierInfo : mut setId
     IdentifierInfo : mut @Id
     IdentifierInfo : mut initializeId
     IdentifierInfo : mut autoTypedInitializeId
     IdentifierInfo : mut declareId
            LabelId : getLabel
            LabelId : mut setLabel
            LabelId : mut @Label
            LabelId : mut hasLabel
                i32 : mut getElement
                i32 : mut setElement
                i32 : mut @Element
                i32 : mut hasElement
                i32 : mut getArrayElement
                i32 : mut setArrayElement
                i32 : mut @ArrayElement
                      setValue
                      Print
                      Return
                      New
                i32 : newEnum
           CallInfo : call
                i64 : mut callPtr
                      argc
                      getArg
                      getArgLen
                      length
                      size
           CastInfo : mut autoCast
               Type : mut Cast
               Type : mut Cast!
      UnaryOperator : unaryOperator
     BinaryOperator : binaryOperator
                i32 : checkEnumLabel
                i32 : setEnumLabel
                i64 : checkArrayIndex
                      copy
  StackModification : stackMod
            LabelId : getName
            LabelId : mut setName
            LabelId : mut @Name
            LabelId : mut hasName
       TypeModifier : mut typeModifier
     TypeMemoryInfo : typeInfo
                      unreachable
       CompilerInfo : compilerInfo
) =:: export OpValue
struct( OpValue : mut val Type : mut dataType FilePosition : mut pos ) =:: export Operation
proc( FilePosition : pos -> Operation ) =: export opNOP
  OpValue .NOP Type .undefined pos Operation new return
end
proc( ConstValue : constValue Type : constType FilePosition : pos -> Operation ) =: export opConst
  constValue OpValue .Constant new constType pos Operation new return
end
proc( BlockType FilePosition -> Operation ) =: export opBlock
  =:: pos
  -1 -1 BlockId new OpValue .block new Type .undefined pos Operation new return
end
proc( BlockType FilePosition -> Operation ) =: export opEndBlock
  =:: pos
  -1 -1 BlockId new OpValue .blockEnd new Type .undefined pos Operation new return
end
proc( Type IdentifierInfo FilePosition  -> Operation ) =: export opGet
  =:: pos
  OpValue .getId new #swap pos Operation new return
end
proc( Type IdentifierInfo FilePosition  -> Operation ) =: export opSet
  =:: pos
  OpValue .setId new #swap pos Operation new return
end
proc( Type IdentifierInfo FilePosition  -> Operation ) =: export op@Id
  =:: pos
  OpValue .@Id new #swap pos Operation new return
end
proc( Type IdentifierInfo FilePosition  -> Operation ) =: export opInitializeId
  =:: pos
  OpValue .initializeId new #swap pos Operation new return
end
proc( Type IdentifierInfo FilePosition  -> Operation ) =: export opAutoTypedInitializeId
  =:: pos
  OpValue .autoTypedInitializeId new #swap pos Operation new return
end
proc( Type IdentifierInfo FilePosition  -> Operation ) =: export opDeclareId
  =:: pos
  OpValue .declareId new #swap pos Operation new return
end
proc( FilePosition : pos  -> Operation ) =: export opSetValue
  OpValue .setValue Type .undefined pos Operation new return
end
proc( i32 FilePosition  -> Operation ) =: export opArrayGet
  =:: pos
  OpValue .getArrayElement new Type .undefined pos Operation new return
end
proc( i32 FilePosition  -> Operation ) =: export opTupleGet
  =:: pos
  OpValue .getElement new Type .undefined pos Operation new return
end
proc( Type : base i32 : index FilePosition : pos -> Operation ) =: export opGetElement
  index OpValue .getElement new base pos Operation new return
end
proc( Type : base i32 : index FilePosition : pos -> Operation ) =: export op@Element
  index OpValue .@Element new base pos Operation new return
end
proc( Type : base i32 : index FilePosition : pos -> Operation ) =: export opHasElement
  index OpValue .hasElement new base pos Operation new return
end
proc( LabelId FilePosition  -> Operation ) =: export opGetLabel
  =:: pos
  OpValue .getLabel new Type .undefined pos Operation new return
end
proc( Type FilePosition -> Operation ) =: export opReturn
  =:: pos
  OpValue .Return #swap pos Operation new return
end
proc( BinaryOperator FilePosition -> Operation ) =: export opBinOp
  =:: pos
  OpValue .binaryOperator new Type .undefined pos Operation new return
end
proc( UnaryOperator FilePosition -> Operation ) =: export opUnaryOp
  =:: pos
  OpValue .unaryOperator new Type .undefined pos Operation new return
end
proc( FilePosition : pos -> Operation ) =: export opPrint
  OpValue .Print Type .undefined pos Operation new return
end
proc( Type FilePosition -> Operation ) =: export opNew
  =:: pos
  OpValue .New #swap pos Operation new return
end
proc( Type i32 FilePosition -> Operation ) =: export opNewEnum
  =:: pos
  OpValue .newEnum new #swap pos Operation new return
end
proc( Type : target FilePosition : pos -> Operation ) =: export opCast
   Type .undefined OpValue .Cast new target pos Operation new return
end
proc( Type : target FilePosition : pos -> Operation ) =: export opCast!
   Type .undefined OpValue .Cast! new target pos Operation new return
end
proc( Type : src Type : target FilePosition : pos -> Operation ) =: export opCastFrom
   src OpValue .Cast new target pos Operation new return
end
proc( Type : src Type : target FilePosition : pos -> Operation ) =: export opCast!From
   src OpValue .Cast! new target pos Operation new return
end
proc( Type : src i32 : offset Type : target FilePosition : pos -> Operation ) =: export opAutoCast
   src offset CastInfo new OpValue .autoCast new target pos Operation new return
end
proc( i32 StackModType FilePosition -> Operation ) =: export opStackMod
  =:: pos
  StackModification new OpValue .stackMod new Type .undefined pos Operation new return
end
proc( FilePosition : pos -> Operation ) =: export opCallPtr
  -1 OpValue .callPtr new Type .undefined pos Operation new return
end
proc( FilePosition : pos -> Operation ) =: export opArgc
  OpValue .argc types.primitive.I_SIZE pos Operation new return
end
proc( FilePosition : pos -> Operation ) =: export opGetArg
  OpValue .getArg Type .undefined pos Operation new return
end
proc( FilePosition : pos -> Operation ) =: export opGetArgLen
  OpValue .getArgLen types.primitive.I_SIZE pos Operation new return
end
proc( FilePosition : pos -> Operation ) =: export opLength
  OpValue .length types.primitive.I_SIZE pos Operation new return
end
proc( FilePosition : pos -> Operation ) =: export opSize
  OpValue .size Type .undefined pos Operation new return
end
proc( Type : t TypeMemoryInfo : infoType FilePosition : pos -> Operation ) =: export opTypeInfo
  infoType OpValue .typeInfo new t pos Operation new return
end
proc( Type i32 FilePosition -> Operation ) =: export opCheckEnum
  =:: pos
  OpValue .checkEnumLabel new #swap pos Operation new return
end
proc( Type i32 FilePosition -> Operation ) =: export opSetEnumLabel
  =:: pos
  OpValue .setEnumLabel new #swap pos Operation new return
end
proc( Type i64 FilePosition -> Operation ) =: export opCheckIndex
  =:: pos
  OpValue .checkArrayIndex new #swap pos Operation new return
end
proc( Type : t FilePosition : pos -> Operation ) =: export opCopy
  OpValue .copy t pos Operation new return
end
proc( LabelId FilePosition  -> Operation ) =: export opGetName
  =:: pos
  OpValue .getName new Type .undefined pos Operation new return
end
proc( TypeModifier FilePosition  -> Operation ) =: export opTypeModifier
  =:: pos
  OpValue .typeModifier new Type .undefined pos Operation new return
end
proc( FilePosition : pos -> Operation ) =: export opUnreachable
  OpValue .unreachable Type .undefined pos Operation new return
end
proc( i32 : count FilePosition : pos -> Operation ) =: export opTypesInfo
  count CompilerInfo .typeInfo new OpValue .compilerInfo new Type .undefined  pos Operation new return
end
proc( i32 : count FilePosition : pos -> Operation ) =: export opStackInfo
  count CompilerInfo .stackInfo new OpValue .compilerInfo new Type .undefined  pos Operation new return
end
proc( i32 : count FilePosition : pos -> Operation ) =: export opPrintCompiledOps
  count CompilerInfo .compiledOps new OpValue .compilerInfo new Type .undefined  pos Operation new return
end
proc( LabelId : name FilePosition : pos -> Operation ) =: export opPrintIdentifierMatches
  name CompilerInfo .find new OpValue .compilerInfo new Type .undefined  pos Operation new return
end

struct( FileId : id FilePosition : includePos ) =:: export IncludedFile

struct(
     Operation list : mut globalOps
     Operation list : mut localOps
     Operation list : mut templateOps
  IncludedFile list : mut includedFiles

      stringBuilder : mut fileName
             FileId : id
) =:: export ProgramFile

struct( ConstValue : value FilePosition : pos ) =:: export LabelData
struct( i64 : offset i64 : mut count ) =:: export CaseInfo
struct( LabelData list : mut labels CaseInfo list : mut cases ) =:: export SwitchData
struct( FileId : fileId Type : procType i64 : codeStart i64 : mut codeLength ) =:: export ProcedureInfo
struct(
  IdentifierContext : mut idContext
   ProgramFile list : mut progFiles
 ProcedureInfo list : mut procedures
          Type list : mut autoTypes
     Operation list : mut templateOps
    SwitchData list : mut switchData
 CompilerError list : mut errors
               bool : mut hasCheckIndex
               bool : mut hasCheckEnum
               bool : mut hasGetArgs
) =:: export ProgramContext

proc( stringBuilder : fileName FileId : id IdentifierContext ptr mut : idContext -> ProgramFile ) =: export newProgFile
  128 Operation list.create
  128 Operation list.create
  128 Operation list.create
  16 IncludedFile list.create
  fileName
  id
  ProgramFile new return
end

namespace: sb
  proc( stringBuilder UnaryOperator -> stringBuilder ) =: export appendUnaryOperator
    switch
      NEGATE case "NEGATE" sb.appendS return
      NOT case "NOT" sb.appendS return
      TO_BOOL case "TO_BOOL" sb.appendS return
      FLIP case "FLIP" sb.appendS return
    end
  end
  proc( stringBuilder BinaryOperator -> stringBuilder ) =: export appendBinaryOperator
    switch
      ADD case "ADD" sb.appendS return
      SUBTRACT case "SUBTRACT" sb.appendS return
      MULTIPLY case "MULTIPLY" sb.appendS return
      DIVIDE case "DIVIDE" sb.appendS return
      MOD case "MOD" sb.appendS return
      UDIVIDE case "UDIVIDE" sb.appendS return
      UMOD case "UMOD" sb.appendS return
      AND case "AND" sb.appendS return
      OR case "OR" sb.appendS return
      XOR case "XOR" sb.appendS return
      EQ case "EQ" sb.appendS return
      NE case "NE" sb.appendS return
      LT case "LT" sb.appendS return
      LE case "LE" sb.appendS return
      GE case "GE" sb.appendS return
      GT case "GT" sb.appendS return
      ULT case "ULT" sb.appendS return
      ULE case "ULE" sb.appendS return
      UGE case "UGE" sb.appendS return
      UGT case "UGT" sb.appendS return
      LSHIFT case "LSHIFT" sb.appendS return
      RSHIFT case "RSHIFT" sb.appendS return
      URSHIFT case "URSHIFT" sb.appendS return
    end
  end
  proc( stringBuilder : sb StackModification : mod -> stringBuilder ) =: export appendStackMod
    sb
      mod .modType switch
        COPY case
          mod .n 0 == if
            "DUP " sb.appendS
          else
            "OVER " sb.appendS
            mod .n sb.appendI
          end
          break
        SWAP case
          "SWAP " sb.appendS
          break
        DROP case
          "DROP " sb.appendS
          mod .n  sb.appendI
          break
      end
    return
  end
  proc( stringBuilder TypeModifier -> stringBuilder ) =: export appendTypeModifier
    switch
      PTR case
        "ptr" sb.appendS
        break
      ARRAY case
        "array" sb.appendS
        break
      PTR_MUT case
        "ptr mut" sb.appendS
        break
    end
  end
  proc( stringBuilder Operation ConstantContext ptr LabelContext ptr TypeContext ptr -> stringBuilder ) =: export appendOp
    =:: typeContext
    =:: labelContext
    =:: constContext
    #swap
      #over .val switch
        NOP case
          "NOP" sb.appendS
          break
        OpValue .Constant case
          "constant ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .Constant constContext labelContext typeContext sb.appendConstant
          break
        block case
          "Block: " sb.appendS
          #over .val .block .blockType sb.appendBlockType
          " (" sb.appendS
          #over .val .block .blockId sb.appendI
          ')' sb.appendC
          break
        blockEnd case
          "End: " sb.appendS
          #over .val .blockEnd .blockType sb.appendBlockType
          " (" sb.appendS
          #over .val .blockEnd .blockId sb.appendI
          ')' sb.appendC
          break
        getId case
          "get ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .getId labelContext sb.appendIdInfo
          break
        call case
          "call ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .call .idInfo labelContext sb.appendIdInfo
          break
        setId case
          "set ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .setId labelContext sb.appendIdInfo
          break
        @Id case
          "address ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .@Id labelContext sb.appendIdInfo
          break
        initializeId case
          "initialize ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .initializeId labelContext sb.appendIdInfo
          break
        autoTypedInitializeId case
          "auto-typed initialize ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .autoTypedInitializeId labelContext sb.appendIdInfo
          break
        declareId case
          "declare ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .declareId labelContext sb.appendIdInfo
          break
        getLabel case
          "get label ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .getLabel labelContext sb.appendLabelName
          break
        setLabel case
          "set label ( " sb.appendS
          #over .dataType labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .setLabel labelContext sb.appendLabelName
          break
        @Label case
          "label address ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .@Label labelContext sb.appendLabelName
          break
        hasLabel case
          "has label ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .hasLabel labelContext sb.appendLabelName
          break
        typeModifier case
          "typeModifier \"" sb.appendS
          #over .val .typeModifier sb.appendTypeModifier
          "\"" sb.appendS
          break
        getElement case
          "get element ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .getElement sb.appendI
          break
        setElement case
          "set element ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .setElement sb.appendI
          break
        @Element case
          "element address ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .@Element sb.appendI
          break
        hasElement case
          "has element ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .hasElement sb.appendI
          break
        getArrayElement case
          "get array element ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .getArrayElement sb.appendI
          break
        setArrayElement case
          "set array element ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .setArrayElement sb.appendI
          break
        @ArrayElement case
          "array element address ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .@ArrayElement sb.appendI
          break
        setValue case
          "set value ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " )" sb.appendS
          break
        Return case
          "Return( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) " sb.appendS
          break
        binaryOperator case
          "binary Operator ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .binaryOperator sb.appendBinaryOperator
          break
        unaryOperator case
          "unary Operator ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .unaryOperator sb.appendUnaryOperator
          break
        Print case
          "print: " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          break
        New case
          "new: " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          break
        newEnum case
          "new enum ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .newEnum sb.appendI
          break
        autoCast case
          "autoCast ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) src: " sb.appendS
          #over .val .autoCast .src labelContext typeContext sb.appendType
          " at " sb.appendS
          #over .val .autoCast .offset sb.appendI
          break
        Cast case
          "cast ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) src: " sb.appendS
          #over .val .Cast  labelContext typeContext sb.appendType
          break
        Cast! case
          "cast! ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) src: " sb.appendS
          #over .val .Cast!  labelContext typeContext sb.appendType
          break
        callPtr case
          "call pointer ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " )" sb.appendS
          break
        argc case
          "get program argument count ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " )" sb.appendS
          break
        getArg case
          "get program argument ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " )" sb.appendS
          break
        getArgLen case
          "get program argument length ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " )" sb.appendS
          break
        length case
          "length ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " )" sb.appendS
          break
        size case
          "size ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " )" sb.appendS
          break
        typeInfo case
          "typeInfo ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ): " sb.appendS
          #over .val .typeInfo switch
            ALIGNMENT case "alignment" sb.appendS break
            SIZE case "size" sb.appendS break
            STRIDE case "stride" sb.appendS break
          end
          break
        checkEnumLabel case
          "check enum label ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .checkEnumLabel sb.appendI
          break
        setEnumLabel case
          "set enum label ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .setEnumLabel sb.appendI
          break
        checkArrayIndex case
          "check array index ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .checkArrayIndex sb.appendI
          break
        stackMod case
          "stack modification: " sb.appendS
          #over .val .stackMod sb.appendStackMod
          break
        copy case
          "copy( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " )" sb.appendS
          break
        getName case
          "get: " sb.appendS
          #over .val .getName labelContext sb.appendLabelName
          break
        setName case
          "set: " sb.appendS
          #over .val .setName labelContext sb.appendLabelName
          break
        @Name case
          "address of: " sb.appendS
          #over .val .@Name labelContext sb.appendLabelName
          break
        hasName case
          "has name: " sb.appendS
          #over .val .hasName labelContext sb.appendLabelName
          break
        unreachable case
          "unreachable " sb.appendS
          break
        compilerInfo case
          #over .val .compilerInfo labelContext sb.appendCompilerInfo
          break
      end
      " at " sb.appendS
      #swap .pos sb.appendPos
      '\n' sb.appendC
    return
  end
  proc( stringBuilder CompilerError -> stringBuilder ) =: export appendCompilerError
    =:: err
    err .message sb.appendSb
    " at "       sb.appendS
    err .pos     sb.appendPos
    '\n'         sb.appendC
  end
  proc( stringBuilder CompilerInfo LabelContext ptr -> stringBuilder ) =: export appendCompilerInfo
    =:: labelContext
    =:: info
    info switch
      typeInfo case
        "..compiler.types" sb.appendS
        info .typeInfo 0 > if
          '.' sb.appendC
          info .typeInfo sb.appendI
        end
        break
      stackInfo case
        "..compiler.stack" sb.appendS
        info .stackInfo 0 > if
          '.' sb.appendC
          info .stackInfo sb.appendI
        end
        break
      compiledOps case
        "..compiler.ops" sb.appendS
        info .compiledOps 0 > if
          '.' sb.appendC
          info .compiledOps sb.appendI
        end
        break
      find case
        "..compiler.find." sb.appendS
        info .find labelContext sb.appendLabelName
        break
    end
  end
  proc( stringBuilder ProgramContext -> stringBuilder ) =: export appendProgram
    =:: prog
      "## errors:\n" sb.appendS
      0 while #dup prog .errors .length < do
        #swap
          prog .errors #over:2 list.get sb.appendCompilerError
        #swap
        1 +
      end #drop
      0 while #dup prog .progFiles .length < do
        #swap
          prog .progFiles #over:2 list.get =:: f
          "## "          sb.appendS
          f .fileName    sb.appendSb
          '\n'           sb.appendC
          "## global:\n" sb.appendS
          0 while #dup f .globalOps .length < do
            #swap
              f .globalOps #over:2 list.get prog .idContext .constContext @ prog .idContext .labelContext @ prog .idContext .typeContext @  sb.appendOp
            #swap
            1 +
          end #drop
          "## local:\n" sb.appendS
          0 while #dup f .localOps .length < do
            #swap
              f .localOps #over:2 list.get prog .idContext .constContext @ prog .idContext .labelContext @ prog .idContext .typeContext @   sb.appendOp
            #swap
            1 +
          end #drop
          "## templates:\n" sb.appendS
          0 while #dup f .templateOps .length < do
            #swap
              f .templateOps #over:2 list.get prog .idContext .constContext @ prog .idContext .labelContext @ prog .idContext .typeContext @   sb.appendOp
            #swap
            1 +
          end #drop
        #swap
        1 +
      end #drop
      "## unresolved templates:\n" sb.appendS
      0 while #dup prog .templateOps .length < do
        #swap
          prog .templateOps #over:2 list.get prog .idContext .constContext @ prog .idContext .labelContext @ prog .idContext .typeContext @   sb.appendOp
        #swap
        1 +
      end #drop
  end
end

