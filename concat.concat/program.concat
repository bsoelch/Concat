  proc(
    BlockId : blockId
    i64 : newIndex
    ProgramContext ptr.mut : program
  -> ) =>: export: updateBreak
    program [] .whileData
      blockId i64 cast
    list.at .data =:: whileData
    whileData [] .breakCount
