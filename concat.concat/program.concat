#include stringBuilder

#include "constants.concat"
#include "codeBlocks.concat"
#include "identifiers.concat"
#include "common.concat"

enum( NEGATE NOT FLIP ) =:: public UnaryOperator
enum( ADD SUBTRACT MULTIPLY DIVIDE UDIVIDE MOD UMOD AND OR XOR LSHIFT RSHIFT URSHIFT EQ NE LT LE GE GT ) =:: public BinaryOperator
enum( DUP OVER SWAP ROT DROP ) =:: public StackModType
struct( i32 : offset i32 : count StackModType : modType ) =:: public StackModification
enum( i32 : typeInfo i32 : stackInfo i32 : compiledOps LabelId : find ) =:: public CompilerInfo
enum(
                      NOP
                      entryPoint
         ConstValue : mut Constant
            BlockId : mut block
            BlockId : mut blockEnd
     IdentifierInfo : mut getId
     IdentifierInfo : mut setId
     IdentifierInfo : mut @Id
     IdentifierInfo : mut declareId
     IdentifierInfo : mut predeclareId
            LabelId : getLabel
            LabelId : mut setLabel
            LabelId : mut @Label
                i32 : mut getTupleElement
                i32 : mut setTupleElement
                i32 : mut @TupleElement
                i32 : mut getArrayElement
                i32 : mut setArrayElement
                i32 : mut @ArrayElement
                i32 : mut getEnumElement
                i32 : mut setEnumElement
                i32 : mut @EnumElement
                      Print
                      Return
                      New
                i32 : newEnum
                      callPtr
                      argc
                      getArg
                      getArgLen
                      length
                      size
               Type : mut Cast
               Type : mut Cast!
      UnaryOperator : unaryOperator
     BinaryOperator : binaryOperator
                i32 : enumLabelEq
                i32 : enumLabelNe
                i32 : checkEnumLabel
                i32 : setEnumLabel
                i64 : checkArrayIndex
  StackModification : stackMod
            LabelId : getName
            LabelId : mut setName
            LabelId : mut @Name
                      unreachable
       CompilerInfo : compilerInfo
) =:: public OpValue
struct( OpValue : mut val Type : mut dataType FilePosition : mut pos ) =:: public Operation
proc( FilePosition : pos => Operation ) =: public opNOP
  OpValue .NOP Type .undefined pos Operation new return
end
proc( ConstValue : constValue Type : constType FilePosition : pos => Operation ) =: public opConst
  constValue OpValue .Constant new constType pos Operation new return
end
proc( BlockType FilePosition => Operation ) =: public opBlock
  =:: pos
  -1 -1 BlockId new OpValue .block new Type .undefined pos Operation new return
end
proc( BlockType FilePosition => Operation ) =: public opEndBlock
  =:: pos
  -1 -1 BlockId new OpValue .blockEnd new Type .undefined pos Operation new return
end
proc( Type IdentifierInfo FilePosition  => Operation ) =: public opGet
  =:: pos
  OpValue .getId new #swap pos Operation new return
end
proc( Type IdentifierInfo FilePosition  => Operation ) =: public opSet
  =:: pos
  OpValue .setId new #swap pos Operation new return
end
proc( Type IdentifierInfo FilePosition  => Operation ) =: public op@Id
  =:: pos
  OpValue .@Id new #swap pos Operation new return
end
proc( Type IdentifierInfo FilePosition  => Operation ) =: public opDeclare
  =:: pos
  OpValue .declareId new #swap pos Operation new return
end
proc( Type IdentifierInfo FilePosition  => Operation ) =: public opPredeclare
  =:: pos
  OpValue .predeclareId new #swap pos Operation new return
end
proc( i32 FilePosition  => Operation ) =: public opArrayGet
  =:: pos
  OpValue .getArrayElement new Type .undefined pos Operation new return
end
proc( i32 FilePosition  => Operation ) =: public opTupleGet
  =:: pos
  OpValue .getTupleElement new Type .undefined pos Operation new return
end
proc( LabelId FilePosition  => Operation ) =: public opGetLabel
  =:: pos
  OpValue .getLabel new Type .undefined pos Operation new return
end
proc( FilePosition : pos => Operation ) =: public opEntryPoint
  OpValue .entryPoint Type .undefined pos Operation new return
end
proc( Type FilePosition => Operation ) =: public opReturn
  =:: pos
  OpValue .Return #swap pos Operation new return
end
proc( BinaryOperator FilePosition => Operation ) =: public opBinOp
  =:: pos
  OpValue .binaryOperator new Type .undefined pos Operation new return
end
proc( UnaryOperator FilePosition => Operation ) =: public opUnaryOp
  =:: pos
  OpValue .unaryOperator new Type .undefined pos Operation new return
end
proc( FilePosition : pos => Operation ) =: public opPrint
  OpValue .Print Type .undefined pos Operation new return
end
proc( Type FilePosition => Operation ) =: public opNew
  =:: pos
  OpValue .New #swap pos Operation new return
end
proc( Type i32 FilePosition => Operation ) =: public opNewEnum
  =:: pos
  OpValue .newEnum new #swap pos Operation new return
end
proc( Type : target FilePosition : pos => Operation ) =: public opCast
   Type .undefined OpValue .Cast new target pos Operation new return
end
proc( Type : target FilePosition : pos => Operation ) =: public opCast!
   Type .undefined OpValue .Cast! new target pos Operation new return
end
proc( Type : src Type : target FilePosition : pos => Operation ) =: public opCastFrom
   src OpValue .Cast new target pos Operation new return
end
proc( Type : src Type : target FilePosition : pos => Operation ) =: public opCast!From
   src OpValue .Cast! new target pos Operation new return
end
proc( i32 i32 StackModType FilePosition => Operation ) =: public opStackMod
  =:: pos
  StackModification new OpValue .stackMod new Type .undefined pos Operation new return
end
proc( FilePosition : pos => Operation ) =: public opCallPtr
  OpValue .callPtr Type .undefined pos Operation new return
end
proc( FilePosition : pos => Operation ) =: public opArgc
  OpValue .argc types.primitive.I_SIZE pos Operation new return
end
proc( FilePosition : pos => Operation ) =: public opGetArg
  OpValue .getArg Type .undefined pos Operation new return
end
proc( FilePosition : pos => Operation ) =: public opGetArgLen
  OpValue .getArgLen types.primitive.I_SIZE pos Operation new return
end
proc( FilePosition : pos => Operation ) =: public opLength
  OpValue .length types.primitive.I_SIZE pos Operation new return
end
proc( FilePosition : pos => Operation ) =: public opSize
  OpValue .size Type .undefined pos Operation new return
end
proc( Type i32 FilePosition => Operation ) =: public opLabelEQ
  =:: pos
  OpValue .enumLabelEq new #swap pos Operation new return
end
proc( Type i32 FilePosition => Operation ) =: public opLabelNE
  =:: pos
  OpValue .enumLabelNe new #swap pos Operation new return
end
proc( Type i32 FilePosition => Operation ) =: public opCheckEnum
  =:: pos
  OpValue .checkEnumLabel new #swap pos Operation new return
end
proc( Type i32 FilePosition => Operation ) =: public opSetEnumLabel
  =:: pos
  OpValue .setEnumLabel new #swap pos Operation new return
end
proc( Type i64 FilePosition => Operation ) =: public opCheckIndex
  =:: pos
  OpValue .checkArrayIndex new #swap pos Operation new return
end
proc( LabelId FilePosition  => Operation ) =: public opGetName
  =:: pos
  OpValue .getName new Type .undefined pos Operation new return
end
proc( FilePosition : pos => Operation ) =: public opUnreachable
  OpValue .unreachable Type .undefined pos Operation new return
end
proc( i32 : count FilePosition : pos => Operation ) =: public opTypeInfo
  count CompilerInfo .typeInfo new OpValue .compilerInfo new Type .undefined  pos Operation new return
end
proc( i32 : count FilePosition : pos => Operation ) =: public opStackInfo
  count CompilerInfo .stackInfo new OpValue .compilerInfo new Type .undefined  pos Operation new return
end
proc( i32 : count FilePosition : pos => Operation ) =: public opPrintCompiledOps
  count CompilerInfo .compiledOps new OpValue .compilerInfo new Type .undefined  pos Operation new return
end
proc( LabelId : name FilePosition : pos => Operation ) =: public opPrintIdentifierMatches
  name CompilerInfo .find new OpValue .compilerInfo new Type .undefined  pos Operation new return
end

struct( FileId : id FilePosition : includePos ) =:: public IncludedFile

struct(
     Operation list : mut globalOps
     Operation list : mut localOps
     Operation list : mut templateOps
  IncludedFile list : mut includedFiles

      stringBuilder : mut fileName
             FileId : id
) =:: public ProgramFile

struct( ConstValue : value FilePosition : pos ) =:: public LabelData
struct( i64 : offset i64 : mut count ) =:: public CaseInfo
struct( LabelData list : mut labels CaseInfo list : mut cases ) =:: public SwitchData
struct(
  IdentifierContext : mut idContext
   ProgramFile list : mut progFiles
          Type list : mut autoTypes
     Operation list : mut templateOps
    SwitchData list : mut switchData
 CompilerError list : mut errors
               bool : mut hasEntryPoint
               bool : mut hasCheckIndex
               bool : mut hasCheckEnum
               bool : mut hasGetArgs
) =:: public Program

proc( stringBuilder : fileName FileId : id IdentifierContext ptr mut : idContext => ProgramFile ) =: public newProgFile
  128 Operation list.create
  128 Operation list.create
  128 Operation list.create
  16 IncludedFile list.create
  fileName
  id
  ProgramFile new return
end

#namespace sb
  proc( stringBuilder UnaryOperator => stringBuilder ) =: public appendUnaryOperator
    switch
      NEGATE case "NEGATE" sb.appendS return
      NOT case "NOT" sb.appendS return
      FLIP case "FLIP" sb.appendS return
    end
  end
  proc( stringBuilder BinaryOperator => stringBuilder ) =: public appendBinaryOperator
    switch
      ADD case "ADD" sb.appendS return
      SUBTRACT case "SUBTRACT" sb.appendS return
      MULTIPLY case "MULTIPLY" sb.appendS return
      DIVIDE case "DIVIDE" sb.appendS return
      MOD case "MOD" sb.appendS return
      UDIVIDE case "UDIVIDE" sb.appendS return
      UMOD case "UMOD" sb.appendS return
      AND case "AND" sb.appendS return
      OR case "OR" sb.appendS return
      XOR case "XOR" sb.appendS return
      EQ case "EQ" sb.appendS return
      NE case "NE" sb.appendS return
      LT case "LT" sb.appendS return
      LE case "LE" sb.appendS return
      GE case "GE" sb.appendS return
      GT case "GT" sb.appendS return
      LSHIFT case "LSHIFT" sb.appendS return
      RSHIFT case "RSHIFT" sb.appendS return
      URSHIFT case "URSHIFT" sb.appendS return
    end
  end
  proc( stringBuilder StackModification => stringBuilder ) =: public appendStackMod
    #dup .modType switch
      DUP case
        #swap "DUP " sb.appendS
        #swap .count sb.appendI
        break
      OVER case
        #swap "OVER " sb.appendS
        #over .offset sb.appendI
                  ' ' sb.appendC
        #swap .count  sb.appendI
        break
      SWAP case
        #swap "SWAP " sb.appendS
        #swap .offset sb.appendI
        break
      ROT case
        #swap "ROTATE " sb.appendS
        #over .count    sb.appendI
                  ' '   sb.appendC
        #swap .offset   sb.appendI
        break
      DROP case
        #swap "DROP " sb.appendS
        #swap .count  sb.appendI
        break
    end
    end
  proc( stringBuilder Operation ConstantContext ptr LabelContext ptr TypeContext ptr => stringBuilder ) =: public appendOp
    =:: typeContext
    =:: labelContext
    =:: constContext
    #swap
      #over .val switch
        NOP case
          "NOP" sb.appendS
          break
        entryPoint case
          "entryPoint" sb.appendS
          break
        OpValue .Constant case
          "constant ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .Constant constContext labelContext typeContext sb.appendConstant
          break
        block case
          "Block: " sb.appendS
          #over .val .block .blockType sb.appendBlockType
          break
        blockEnd case
          "End: " sb.appendS
          #over .val .blockEnd .blockType sb.appendBlockType
          break
        getId case
          "get ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .getId labelContext sb.appendIdInfo
          break
        setId case
          "set ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .setId labelContext sb.appendIdInfo
          break
        @Id case
          "address ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .@Id labelContext sb.appendIdInfo
          break
        declareId case
          "declare ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .declareId labelContext sb.appendIdInfo
          break
        predeclareId case
          "predeclare ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .predeclareId labelContext sb.appendIdInfo
          break
        getLabel case
          "get label ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .getLabel labelContext id.labelName .data sb.appendStr
          break
        setLabel case
          "set label ( " sb.appendS
          #over .dataType labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .setLabel labelContext id.labelName .data sb.appendStr
          break
        @Label case
          "label address ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .@Label labelContext id.labelName .data sb.appendStr
          break
        getTupleElement case
          "get tuple element ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .getTupleElement sb.appendI
          break
        setTupleElement case
          "set tuple element ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .setTupleElement sb.appendI
          break
        @TupleElement case
          "tuple element address ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .@TupleElement sb.appendI
          break
        getArrayElement case
          "get array element ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .getArrayElement sb.appendI
          break
        setArrayElement case
          "set array element ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .setArrayElement sb.appendI
          break
        @ArrayElement case
          "array element address ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .@ArrayElement sb.appendI
          break
        getEnumElement case
          "get enum element ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .getEnumElement sb.appendI
          break
        setEnumElement case
          "set enum element ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .setEnumElement sb.appendI
          break
        @EnumElement case
          "enum element address ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .@EnumElement sb.appendI
          break
        Return case
          "Return: " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          break
        binaryOperator case
          "binary Operator ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .binaryOperator sb.appendBinaryOperator
          break
        unaryOperator case
          "unary Operator ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .unaryOperator sb.appendUnaryOperator
          break
        Print case
          "print: " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          break
        New case
          "new: " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          break
        newEnum case
          "new enum ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .newEnum sb.appendI
          break
        Cast case
          "cast ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) src: " sb.appendS
          #over .val .Cast  labelContext typeContext sb.appendType
          break
        Cast! case
          "cast ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) src: " sb.appendS
          #over .val .Cast!  labelContext typeContext sb.appendType
          break
        callPtr case
          "call pointer ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " )" sb.appendS
          break
        argc case
          "get program argument count ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " )" sb.appendS
          break
        getArg case
          "get program argument ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " )" sb.appendS
          break
        getArgLen case
          "get program argument length ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " )" sb.appendS
          break
        length case
          "length ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " )" sb.appendS
          break
        size case
          "size ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " )" sb.appendS
          break
        enumLabelEq case
          "enum label equal ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .enumLabelEq sb.appendI
          break
        enumLabelNe case
          "enum label not equal ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .enumLabelNe sb.appendI
          break
        checkEnumLabel case
          "check enum label ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .checkEnumLabel sb.appendI
          break
        setEnumLabel case
          "set enum label ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .setEnumLabel sb.appendI
          break
        checkArrayIndex case
          "check array index ( " sb.appendS
          #over .dataType  labelContext typeContext sb.appendType
          " ) : " sb.appendS
          #over .val .checkArrayIndex sb.appendI
          break
        stackMod case
          "stack modification: " sb.appendS
          #over .val .stackMod sb.appendStackMod
          break
        getName case
          "get: " sb.appendS
          #over .val .getName labelContext id.labelName .data sb.appendStr
          break
        setName case
          "set: " sb.appendS
          #over .val .setName labelContext id.labelName .data sb.appendStr
          break
        @Name case
          "address of: " sb.appendS
          #over .val .@Name labelContext id.labelName .data sb.appendStr
          break
        unreachable case
          "unreachable " sb.appendS
          break
        compilerInfo case
          #over .val .compilerInfo labelContext sb.appendCompilerInfo
          break
      end
      " at " sb.appendS
      #swap .pos sb.appendPos
      '\n' sb.appendC
    return
  end
  proc( stringBuilder CompilerError => stringBuilder ) =: public appendCompilerError
    =:: err
    err .message sb.appendSb
    " at "       sb.appendS
    err .pos     sb.appendPos
    '\n'         sb.appendC
  end
  proc( stringBuilder CompilerInfo LabelContext ptr => stringBuilder ) =: public appendCompilerInfo
    =:: labelContext
    =:: info
    info switch
      typeInfo case
        "#types" sb.appendS
        info .typeInfo 0 > if
          ':' sb.appendC
          info .typeInfo sb.appendI
        end
        break
      stackInfo case
        "#stack" sb.appendS
        info .stackInfo 0 > if
          ':' sb.appendC
          info .stackInfo sb.appendI
        end
        break
      compiledOps case
        "#ops" sb.appendS
        info .compiledOps 0 > if
          ':' sb.appendC
          info .compiledOps sb.appendI
        end
        break
      find case
        "#find " sb.appendS
        info .find labelContext id.labelName .data sb.appendStr
        break
    end
  end
  proc( stringBuilder Program => stringBuilder ) =: public appendProgram
    =:: prog
      "## errors:\n" sb.appendS
      0 while #dup prog .errors .length < do
        #swap
          prog .errors #over:2 list.get sb.appendCompilerError
        #swap
        1 +
      end #drop
      0 while #dup prog .progFiles .length < do
        #swap
          prog .progFiles #over:2 list.get =:: f
          "## "          sb.appendS
          f .fileName    sb.appendSb
          '\n'           sb.appendC
          "## global:\n" sb.appendS
          0 while #dup f .globalOps .length < do
            #swap
              f .globalOps #over:2 list.get prog .idContext .constContext @ prog .idContext .labelContext @ prog .idContext .typeContext @  sb.appendOp
            #swap
            1 +
          end #drop
          "## local:\n" sb.appendS
          0 while #dup f .localOps .length < do
            #swap
              f .localOps #over:2 list.get prog .idContext .constContext @ prog .idContext .labelContext @ prog .idContext .typeContext @   sb.appendOp
            #swap
            1 +
          end #drop
          "## templates:\n" sb.appendS
          0 while #dup f .templateOps .length < do
            #swap
              f .templateOps #over:2 list.get prog .idContext .constContext @ prog .idContext .labelContext @ prog .idContext .typeContext @   sb.appendOp
            #swap
            1 +
          end #drop
        #swap
        1 +
      end #drop
      "## unresolved templates:\n" sb.appendS
      0 while #dup prog .templateOps .length < do
        #swap
          prog .templateOps #over:2 list.get prog .idContext .constContext @ prog .idContext .labelContext @ prog .idContext .typeContext @   sb.appendOp
        #swap
        1 +
      end #drop
  end
#end

