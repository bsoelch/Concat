union(
            NopType : NOP
         ConstValue : Constant
             ProcId : NestedProc
   ConstReferenceId : ConstantReference
          BlockData : Block
          BlockData : BlockEnd
     LocalLabelInfo : LocalLabel
      LocalJumpInfo : LocalJump
     IdentifierInfo : GetId
     IdentifierInfo : SetId
     IdentifierInfo : AtId
     IdentifierInfo : InitializeId
     IdentifierInfo : AutoTypedInitializeId
     IdentifierInfo : DeclareId
      ProcedureImpl : ImplementProcedure
      ProcedureImpl : ProcPtr
            LabelId : GetLabel
            LabelId : SetLabel
            LabelId : ExistsLabel
                i32 : GetElement
                i32 : GetUnionElement
                i32 : SetElement
                i32 : SetUnionElement
                  _ : GetUnionLabel
                  _ : Return
            BlockId : InlineReturn ## TODO? remember jump distance
                  _ : New
                  _ : NewReference
                i32 : NewUnion
                i32 : NewUnionReference
      ProcedureCall : Call
            BuiltIn : shadow: BuiltIn
        PointerCall : CallPtr
                  _ : Length
                  _ : RawValue
       AutoCastInfo : AutoCast
           CastInfo : Cast
               Type : Cast!
               Type : BitCast
                  _ : Splat
                  _ : Copy
  StackModification : StackMod
            LabelId : GetName
            LabelId : SetName
            LabelId : AtName
            LabelId : ExistsName
      NameAliasInfo : AliasName
            LabelId : DeclareName
       NameInitInfo : InitializeName
      NameAliasInfo : UsingNamespace
      NameAliasInfo : UsingIdentifier
             ProcId : TypeWith
       TypeModifier : shadow: TypeModifier
                  _ : Assert
             string : RuntimeAssert
          ErrorType : Error
     TypeMemoryInfo : TypeInfo
                  _ : Panic
             string : PanicWithMessage
             string : Import
             string : LibImport
       CompilerInfo : shadow: CompilerInfo
) =:: export: OpValue
