  bool : isStatic
) =:: export: ProcedureInfo
proc( ProcedureInfo : p -> ) =>: freeProcedure
  p .implementation .Code .if =:: impl
    impl .code slice.free ..drop
    impl .implementations for
      .code slice.free ..drop
    end
  else ..drop end
end
