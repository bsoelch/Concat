i64 =:: export: LocalLabelId
namespace: LocalLabelId
  proc( LocalLabelId LocalLabelId -> bool ) : export: alias: eq i64.eq
  ## fast hash
  proc( LocalLabelId -> i32 ) =>: export: hash i32 cast.u end
  ## hash function that reduces collisions in low bits for non-consequtive values
  proc( LocalLabelId -> i32 ) =>: export: skewHash
    0
      >$ i64 cast.u while $ 0 != do =:: x
        11 * x 0x7 & i32 cast.u +
      finally x 3 >>> end ..drop
    return
  end
end
enum( LABEL_START LABEL_END LABEL_MIDDLE HINT_START HINT_END ) =:: export: LocalLabelType
