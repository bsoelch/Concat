  ## ProcedureBundle
    8 ProcId list.create
  ProcedureBundle new
end

## XXX rename TypeConstant -> Constant, Constant -> ConstantInfo
struct(
  Type : constType
  ConstValue : value
  FilePosition : pos
) =:: export: TypedConstant

struct(
            IdentifierContext : idContext
             ProgramFile list : progFiles
           ProcedureInfo list : procedures
         ProcedureBundle list : procBundles
                    Type list : autoTypes
               Operation list : tmpOps
               Operation list : globalOps
          MixedArenaAllocator : programMemory ## TODO? merge non-linear buffers into Allocator
              SwitchData list : switchData
               WhileData list : whileData
                  IfData list : ifData
               AndOrData list : andOrData
           TypedConstant list : constantReferences
                 LabelId list : labelBuffer
                CallData list : callData
           CompilerError list : errors
                      LabelId : mainLabelId
                       ProcId : mainProcId
                         bool : hasCheckEnum
                         bool : hasGetArgs
) =:: export: ProgramContext

proc( -> ProgramContext ) =>: export: newProgramContext
  ## ProgramContext
    id.newIdentifierContext
    16  ProgramFile     list.create
    64  ProcedureInfo   list.create
    64  ProcedureBundle list.create
    32  Type            list.create
    1024 Operation      list.create
    1024 Operation      list.create
    4096                mixedArena.create
    128 SwitchData      list.create
    128 WhileData       list.create
    256 IfData          list.create
    128 AndOrData       list.create
    32  TypedConstant   list.create
    32  LabelId         list.create
    1024 CallData       list.create
    32  CompilerError   list.create
    id.LABEL_ID_NONE ## main LabelId
    NO_PROC ## main ProcId
    false ## hasCheckEnum
    false ## has getArgs
  ProgramContext new
end
proc( ProgramContext -> ProgramContext ) =>: export: freeProgramContext
  $ .idContext id.freeIdentifierContext >$ .idContext=
  $ .progFiles list.free >$ .progFiles=
  $ .procedures for freeProcedure end
  $ .procedures list.free >$ .procedures=
  $ .procBundles list.free >$ .procBundles=
  $ .autoTypes list.free >$ .autoTypes=
  $ .tmpOps list.free >$ .tmpOps=
  $ .globalOps list.free >$ .globalOps=
  $ .programMemory mixedArena.free >$ .programMemory=
  $ .switchData list.free >$ .switchData=
  $ .whileData list.free >$ .whileData=
  $ .ifData list.free >$ .ifData=
  $ .andOrData list.free >$ .andOrData=
  $ .constantReferences list.free >$ .constantReferences=
  $ .labelBuffer list.free >$ .labelBuffer=
  $ .callData list.free >$ .callData=
  $ .errors list.free >$ .errors=
  id.LABEL_ID_NONE >$ .mainLabelId=
  NO_PROC >$ .mainProcId=
  false >$ .hasCheckEnum=
  false >$ .hasGetArgs=
end

proc(
  stringBuilder : fileName
  FileId : id
-> ProgramFile ) =>: export: newProgFile
  ## ProgramFile
    fileName
    id
    id.NO_SCOPE
  ProgramFile new return
end

proc(
  ConstValue : constValue
  Type : constType
  FilePosition : pos
  ProgramContext ptr.mut : program
-> Operation ) =>: export: opConstReference
  program [] .constantReferences
    ..dup .length ConstReferenceId cast =:: refId
    constType constValue pos TypedConstant new list.append
  program .constantReferences=
  program .idContext .typeContext =:: typeContext
  ## Operation
    refId OpValue .ConstantReference
    constType
    pos
  Operation new return
end

namespace: sb
  proc( stringBuilder : sb StackModification : mod -> stringBuilder ) =>: export: appendStackMod
    sb
      mod .modType switch
        COPY case
          mod .n 0 == if
            "DUP " sb.appendS
          else
            "OVER " sb.appendS
            mod .n sb.appendI
          end
          break
        ROTATE case
          mod .n 1 == if
            "SWAP " sb.appendS
          else
            "ROTATE " sb.appendS
          end
          break
        DROP case
          "DROP " sb.appendS
          mod .n  sb.appendI
          break
      end
    return
  end
  proc( stringBuilder TypeModifier -> stringBuilder ) =>: export: appendTypeModifier
    switch
      ARRAY case
        "array" sb.appendS
        break
      PTR case
        "ptr" sb.appendS
        break
      PTR_MUT case
        "ptr.mut" sb.appendS
        break
      RAW_PTR case
        "ptr.raw" sb.appendS
        break
      RAW_PTR_MUT case
        "ptr.raw.mut" sb.appendS
        break
    end
  end
  proc( stringBuilder Operation ProgramContext ptr -> stringBuilder ) =>: export: appendOp
    =:: progContext
    progContext .idContext .typeContext =:: typeContext
    progContext .idContext .typeContext .labelContext =:: labelContext
    progContext .idContext .constContext =:: constContext
    ..swap
      ..over .val switch
        NOP case
          "NOP" sb.appendS
          break
        Constant case
          "constant ( " sb.appendS
          ..over .dataType  typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .Constant typeContext sb.appendConstant
          break
        StaticConstant case
          "static constant ( " sb.appendS
          ..over .dataType  typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .StaticConstant typeContext sb.appendConstant
          break
        NestedProc case
          "nested proc ( " sb.appendS
          ..over .dataType  typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .NestedProc i64 cast.u sb.appendI
          ":ProcId" sb.appendS
          break
        ConstantReference case
          ..over .val .ConstantReference =:: refId
          progContext [] .constantReferences refId i64 cast list.at .data =:: constData
          "constant reference ( " sb.appendS
          constData [] .constType typeContext sb.appendType
          " )[" sb.appendS
          refId i64 cast sb.appendI
          "] : " sb.appendS
          constData [] .value typeContext sb.appendConstant
          break
        block case
          "Block: " sb.appendS
          $1 .val .block .blockType sb.appendBlockType
          " (" sb.appendS
            $1 .val .block .blockId i64 cast sb.appendI
            " ->" sb.appendS
            $1 .val .block .jumpDistance i64 cast sb.appendI
          ')' sb.appendC
          break
        blockEnd case
          "End: " sb.appendS
          $1 .val .blockEnd .blockType sb.appendBlockType
          " (" sb.appendS
            $1 .val .blockEnd .blockId i64 cast sb.appendI
            " ->" sb.appendS
            $1 .val .blockEnd .jumpDistance i64 cast sb.appendI
          ')' sb.appendC
          break
        call case ..over =:: op
          op@ .val .call =:: callInfo
          "call ( " sb.appendS
          op .dataType  typeContext sb.appendType
          " ) : " sb.appendS
          progContext [] .procedures
            callInfo [] .procId i64 cast list.at .data
          =:: procInfo
          procInfo [] .labelId labelContext sb.appendLabelPath
          callInfo [] .implementationId 0 >= if
            ## XXX append static args instead of impl id
            " (" sb.appendS
            callInfo [] .implementationId sb.appendI
            ')' sb.appendC
          end
          ## XXX? print auto args
          break
        builtIn case ..over =:: op
          "built-in ( " sb.appendS
          op .dataType  typeContext sb.appendType
          " ) : " sb.appendS
          op .val .builtIn sb.appendBuiltIn
          break
        getId case
          "get ( " sb.appendS
          ..over .dataType  typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .getId labelContext sb.appendIdInfo
          break
        setId case
          "set ( " sb.appendS
          ..over .dataType  typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .setId labelContext sb.appendIdInfo
          break
        atId case
          "address ( " sb.appendS
          ..over .dataType  typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .atId labelContext sb.appendIdInfo
          break
        initializeId case
          "initialize ( " sb.appendS
          ..over .dataType  typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .initializeId labelContext sb.appendIdInfo
          break
        implementProcedure case ..over =:: op
          op@ .val .implementProcedure =:: implInfo
          "implement ( " sb.appendS
          op .dataType typeContext sb.appendType
          " ) : " sb.appendS
          progContext [] .procedures
            implInfo [] .procId i64 cast list.at .data
          =:: procInfo
          procInfo [] .labelId labelContext sb.appendLabelPath
          implInfo [] .implementationId 0 >= if
            ## XXX append static args instead of impl id
            " (" sb.appendS
            implInfo [] .implementationId sb.appendI
            ')' sb.appendC
          end
          break
        procPtr case ..over =:: op
          op@ .val .procPtr =:: implInfo
          "procedure pointer ( " sb.appendS
          op .dataType typeContext sb.appendType
          " ) : " sb.appendS
          progContext [] .procedures
            implInfo [] .procId i64 cast list.at .data
          =:: procInfo
          procInfo [] .labelId labelContext sb.appendLabelPath
          implInfo [] .implementationId 0 >= if
            ## XXX append static args instead of impl id
            " (" sb.appendS
            implInfo [] .implementationId sb.appendI
            ')' sb.appendC
          end
          break
        autoTypedInitializeId case
          "auto-typed initialize ( " sb.appendS
          ..over .dataType  typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .autoTypedInitializeId labelContext sb.appendIdInfo
          break
        declareId case
          "declare ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .declareId labelContext sb.appendIdInfo
          break
        getLabel case
          "get label ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .getLabel labelContext sb.appendLabelName
          break
        getUnionLabel case
          "get union label ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .getUnionLabel labelContext sb.appendLabelName
          break
        setLabel case
          "set label ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .setLabel labelContext sb.appendLabelName
          break
        existsLabel case
          "exists label ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .existsLabel labelContext sb.appendLabelName
          break
        typeModifier case
          "typeModifier \"" sb.appendS
          ..over .val .typeModifier sb.appendTypeModifier
          "\"" sb.appendS
          break
        getElement case
          "get element ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .getElement sb.appendI
          break
        getUnionElement case
          "get union element ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .getUnionElement sb.appendI
          break
        setElement case
          "set element ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .setElement sb.appendI
          break
        hasElement case
          "has element ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .hasElement sb.appendI
          break
        Return case
          "Return( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ) " sb.appendS
          break
        InlineReturn case
          "InlineReturn " sb.appendS
            $1 .val .InlineReturn i64 cast sb.appendI
          " ( " sb.appendS
          $1 .dataType typeContext sb.appendType
          " )" sb.appendS
          break
        equalityOperator case
          ..over .val .equalityOperator switch
            EQ case "Equal ( " sb.appendS break
            NEQ case "Not Equal ( " sb.appendS break
          end
          ..over .dataType typeContext sb.appendType
          " )" sb.appendS
          break
        New case
          "new: " sb.appendS
          ..over .dataType typeContext sb.appendType
          break
        NewReference case
          "new reference: " sb.appendS
          ..over .dataType typeContext sb.appendType
          break
        NewEnum case
          "new enum ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .NewEnum sb.appendI
          break
        NewEnumReference case
          "new enum reference ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .NewEnumReference sb.appendI
          break
        autoCast case
          "autoCast ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ) src: " sb.appendS
          ..over .val .autoCast .src typeContext sb.appendType
          " at " sb.appendS
          ..over .val .autoCast .offset sb.appendI
          break
        Cast case
          ..over .val .Cast .signType switch
            NONE case break
            SIGNED case "signed " sb.appendS break
            UNSIGNED case "unsigned " sb.appendS break
          end
          "cast ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ) src: " sb.appendS
          ..over .val .Cast .src typeContext sb.appendType
          break
        Cast! case
          "cast! ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ) src: " sb.appendS
          ..over .val .Cast! typeContext sb.appendType
          break
        bitCast case
          "bitCast ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ) src: " sb.appendS
          ..over .val .bitCast typeContext sb.appendType
          break
        callPtr case
          "call pointer ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " )" sb.appendS
          break
        length case
          "length ( " sb.appendS
          $1 .dataType typeContext sb.appendType
          " )" sb.appendS
          break
        rawValue case
          "raw ( " sb.appendS
          $1 .dataType typeContext sb.appendType
          " )" sb.appendS
          break
        typeInfo case
          "typeInfo ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ): " sb.appendS
          ..over .val .typeInfo switch
            ALIGNMENT case "alignment" sb.appendS break
            SIZE case "size" sb.appendS break
            STRIDE case "stride" sb.appendS break
          end
          break
        getEnumLabel case
          "get enum label ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " )" sb.appendS
          break
        checkEnumLabel case
          "check enum label ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .checkEnumLabel sb.appendI
          break
        setEnumElement case
          "set enum element ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .setEnumElement sb.appendI
          break
        stackMod case
          "stack modification: " sb.appendS
          ..over .val .stackMod sb.appendStackMod
          break
        copy case
          "copy( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " )" sb.appendS
          break
        getName case
          "get: " sb.appendS
          ..over .val .getName labelContext sb.appendLabelPath
          break
        atName case
          "address of: " sb.appendS
          ..over .val .atName labelContext sb.appendLabelPath
          break
        setName case
          "set: " sb.appendS
          ..over .val .setName labelContext sb.appendLabelPath
          break
        existsName case
          "exists name: " sb.appendS
          ..over .val .existsName labelContext sb.appendLabelPath
          break
        declareName case
          "declare name: " sb.appendS
          $1 .val .declareName labelContext sb.appendLabelPath
          break
        initializeName case
          $1 .val .initializeName .initType .AUTO if
            "auto-typed " sb.appendS
          end
          "initialize name: " sb.appendS
          $1 .val .initializeName .label labelContext sb.appendLabelPath
          break
        usingNamespace case
          "using namespace: " sb.appendS
          $1 .val .usingNamespace .src labelContext sb.appendLabelPath
          $1 .val .usingNamespace .alias id.LABEL_ID_NONE != if
            " as " sb.appendS
            $1 .val .usingNamespace .alias labelContext sb.appendLabelName
          end
          break
        usingIdentifier case
          "using idenfifier: " sb.appendS
          $1 .val .usingIdentifier .src labelContext sb.appendLabelPath
          $1 .val .usingIdentifier .alias id.LABEL_ID_NONE != if
            " as " sb.appendS
            $1 .val .usingIdentifier .alias labelContext sb.appendLabelName
          end
          break
        Assert case
          "assert" sb.appendS
          break
        RuntimeAssert case
          '"' sb.appendC
          ..over .val .RuntimeAssert sb.appendStr
          "\" assert" sb.appendS
          break
        Error case
          ..over .val .Error switch
            ERROR case "..compiler.error" sb.appendS break
            WARNING case "..compiler.warning" sb.appendS break
            INFO case "..compiler.info" sb.appendS break
          end
          break
        panic case
          "..panic" sb.appendS
          break
        panicWithMessage case
          '"' sb.appendC
          ..over .val .panicWithMessage sb.appendEscapedStr
          "\" ..panic" sb.appendS
          break
        compilerInfo case
          ..over .val .compilerInfo labelContext sb.appendCompilerInfo
          break
      end
      " at " sb.appendS
      ..swap .pos sb.appendPos
      '\n' sb.appendC
    return
  end
  proc( stringBuilder CompilerError -> stringBuilder ) =>: export: appendCompilerError
    =:: err
    err .message sb.appendSb
    " at "       sb.appendS
    err .pos     sb.appendPos
    '\n'         sb.appendC
  end
  proc( stringBuilder CompilerInfo LabelContext ptr -> stringBuilder ) =>: export: appendCompilerInfo
    =:: labelContext
    =:: info
    info switch
      typeInfo case
        "..?types" sb.appendS
        info .typeInfo .count 0 > if
          '.' sb.appendC
          info .typeInfo .count sb.appendI
        end
        info .typeInfo .depth 0 > if
          '.' sb.appendC
          info .typeInfo .depth sb.appendI
        end
        break
      stackInfo case
        "..?stack" sb.appendS
        info .stackInfo 0 > if
          '.' sb.appendC
          info .stackInfo sb.appendI
        end
        break
      compiledOps case
        "..?ops" sb.appendS
        info .compiledOps 0 > if
          '.' sb.appendC
          info .compiledOps sb.appendI
        end
        break
      find case
        "..?find." sb.appendS
        info .find labelContext sb.appendLabelPath
        break
    end
  end
  proc( stringBuilder ProgramContext ptr : prog -> stringBuilder ) =>: export: appendProgram
    prog .idContext .typeContext .labelContext =:: labelContext
    "## errors:\n" sb.appendS
    prog [] .errors errorCmp@ list.sort
    prog [] .errors for sb.appendCompilerError end
    "## global:\n" sb.appendS
    prog [] .globalOps for prog sb.appendOp end
    prog [] .procedures for =:: proc
      proc .implementation .?code .else
        ..drop continue
      end =:: impl
      "## "          sb.appendS
      proc .labelId labelContext sb.appendLabelPath
      '\n'           sb.appendC
      impl .codeState .UNUSED if continue end ## ignore unused procs
      impl .code for prog sb.appendOp end
      '\n' sb.appendC
      impl .implementations for =:: genericImpl
        genericImpl .code for prog sb.appendOp end
        '\n' sb.appendC
      end
    end
    "## temporary code:\n" sb.appendS
    prog [] .tmpOps for prog sb.appendOp end
  end
end

namespace: program.jumps
  proc(
    BlockId : blockId
    i32 : newIndex
    ProgramContext ptr.mut : program
  -> ) =>: export: updateAndIf
    program [] .ifData
      blockId i32 cast
    list.at .data =:: ifData
    ifData [] .andCount ifData [] .orCount + 0 == if
      newIndex ifData .blockStart=
    end
    ifData [] .andCount
      newIndex ifData [] .andPositions $2 slice.set
      1 +
    ifData .andCount=
  end
  proc(
    BlockId : blockId
    i32 : newIndex
    ProgramContext ptr.mut : program
  -> ) =>: export: updateOrIf
    program [] .ifData
      blockId i32 cast
    list.at .data =:: ifData
    ifData [] .andCount ifData [] .orCount + 0 == if
      newIndex ifData .blockStart=
    end
    ifData [] .orCount
      newIndex ifData [] .orPositions $2 slice.set
      1 +
    ifData .orCount=
  end
  proc(
    BlockId : blockId
    Operation slice.mut : newOps
    ProgramContext ptr.mut : program
  -> ) =>: export: updateIf
    program [] .ifData
      blockId i32 cast
    list.at .data =:: ifData
    ifData [] .andCount ifData [] .orCount + 0 == if
      newOps .length i32 cast ifData .blockStart=
    end
    newOps .length i32 cast ifData .ifPosition=
    ifData [] .orCount for =:: i
      ifData [] .orPositions
        i
      [] =:: orPos
      newOps .length i32 cast
        orPos - JumpDistance cast
      newOps
        orPos slice.at .data
      .val .block .jumpDistance=
    end
    0 ifData .orCount=
  end
  proc(
    BlockId : blockId
    Operation slice.mut : newOps
    ProgramContext ptr.mut : program
  -> ) =>: export: updateElse
    program [] .ifData
      blockId i32 cast
    list.at .data =:: ifData
    newOps .length i32 cast ifData .elsePosition=
    ifData [] .andCount for =:: i
      ifData [] .andPositions
        i
      [] =:: andPos
      newOps .length i32 cast
        andPos - JumpDistance cast
      newOps
        andPos slice.at .data
      .val .block .jumpDistance=
    end
    0 ifData .andCount=
    newOps .length i32 cast
      ifData [] .ifPosition - JumpDistance cast
    newOps
      ifData [] .ifPosition slice.at .data
    .val .block .jumpDistance=
  end
  proc(
    BlockId : blockId
    Operation slice.mut : newOps
    ProgramContext ptr.mut : program
  -> JumpDistance ) =>: export: updateEndIf
    program [] .ifData
      blockId i32 cast
    list.at .data =:: ifData
    newOps .length i32 cast
      ifData [] .elsePosition - JumpDistance cast
    newOps
      ifData [] .elsePosition slice.at .data
    .val .block .jumpDistance=
    ifData [] .blockStart
      newOps .length i32 cast -
    JumpDistance cast
  end

  proc(
    BlockId : blockId
    i32 : newIndex
    ProgramContext ptr.mut : program
  -> ) =>: export: updateSwitch
    newIndex
      program [] .switchData blockId i32 cast list.at .data
    .switchPosition=
  end
  proc(
    BlockId : blockId
    i32 : newIndex
    ProgramContext ptr.mut : program
  -> ) =>: export: updateCase
    program [] .switchData
      blockId i32 cast
    list.at .data =:: switchData
    switchData [] .caseCount
      newIndex
        switchData [] .switchPosition - JumpDistance cast
      switchData [] .caseJumpDistances $2 slice.set
      1 +
    switchData .caseCount=
  end
  proc(
    BlockId : blockId
    i32 : newIndex
    ProgramContext ptr.mut : program
  -> ) =>: export: updateDefault
    program [] .switchData
      blockId i32 cast
    list.at .data =:: switchData
    newIndex
      switchData [] .switchPosition - JumpDistance cast
    switchData .defaultJumpDistance=
  end
  proc(
    BlockId : blockId
    i32 : newIndex
    ProgramContext ptr.mut : program
  -> ) =>: export: updateBreakSwitch
    program [] .switchData
      blockId i32 cast
    list.at .data =:: switchData
    switchData [] .breakCount
      newIndex switchData [] .breakPositions $2 slice.set
      1 +
    switchData .breakCount=
  end
  proc(
    BlockId : blockId
    Operation slice.mut : newOps
    ProgramContext ptr.mut : program
  -> JumpDistance ) =>: export: updateEndSwitch
    program [] .switchData
      blockId i32 cast
    list.at .data =:: switchData
    switchData [] .breakCount for =:: i
      switchData [] .breakPositions
        i
      [] =:: breakPos
      newOps .length i32 cast
        breakPos - JumpDistance cast
      newOps
        breakPos slice.at .data
      .val .block .jumpDistance=
    end
    0 switchData .breakCount=
    switchData [] .switchPosition
      newOps .length i32 cast -
    JumpDistance cast
  end

  proc(
    BlockId : blockId
    i32 : newIndex
    ProgramContext ptr.mut : program
  -> ) =>: export: updateWhile
    program [] .whileData
      blockId i32 cast
    list.at .data =:: whileData
    newIndex whileData .loopStart=
  end
  proc(
    BlockId : blockId
    i32 : newIndex
    ProgramContext ptr.mut : program
  -> ) =>: export: updateOrDo
    program [] .whileData
      blockId i32 cast
    list.at .data =:: whileData
    whileData [] .orCount
      newIndex whileData [] .orPositions $2 slice.set
      1 +
    whileData .orCount=
  end
  proc(
    BlockId : blockId
    i32 : newIndex
    ProgramContext ptr.mut : program
  -> ) =>: export: updateBreak
    program [] .whileData
      blockId i32 cast
    list.at .data =:: whileData
    whileData [] .breakCount
      newIndex whileData [] .breakPositions $2 slice.set
      1 +
    whileData .breakCount=
  end
  proc(
    BlockId : blockId
    i32 : newIndex
    ProgramContext ptr.mut : program
  -> ) : export: alias: updateAndDo updateBreak
  proc(
    BlockId : blockId
    i32 : newIndex
    ProgramContext ptr.mut : program
  -> ) =>: export: updateContinue
    program [] .whileData
      blockId i32 cast
    list.at .data =:: whileData
    whileData [] .continueCount
      newIndex whileData [] .continuePositions $2 slice.set
      1 +
    whileData .continueCount=
  end
  proc(
    BlockId : blockId
    Operation slice.mut : newOps
    ProgramContext ptr.mut : program
  -> ) =>: export: updateDo
    blockId newOps .length i32 cast program updateBreak
    program [] .whileData
      blockId i32 cast
    list.at .data =:: whileData
    whileData [] .orCount for =:: i
      whileData [] .orPositions i [] =:: orPos
      newOps .length i32 cast
        orPos - JumpDistance cast
      newOps
        orPos slice.at .data
      .val .block .jumpDistance=
    end
    0 whileData .orCount=
  end
  proc(
    BlockId : blockId
    Operation slice.mut : newOps
    ProgramContext ptr.mut : program
  -> ) =>: export: updateFinally
    program [] .whileData
      blockId i32 cast
    list.at .data =:: whileData
    whileData [] .continueCount for =:: i
      whileData [] .continuePositions
        i
      [] =:: continuePos
      newOps .length i32 cast
        continuePos - JumpDistance cast
      newOps
        continuePos slice.at .data
      .val .block .jumpDistance=
    end
    0 whileData .continueCount=
  end
  proc(
    BlockId : blockId
    Operation slice.mut : newOps
    ProgramContext ptr.mut : program
  -> JumpDistance ) =>: export: updateEndWhile
    program [] .whileData
      blockId i32 cast
    list.at .data =:: whileData
    whileData [] .breakCount for =:: i
      whileData [] .breakPositions i [] =:: breakPos
      newOps .length i32 cast
        breakPos - JumpDistance cast
      newOps
        breakPos slice.at .data
      .val .block .jumpDistance=
    end
    0 whileData .breakCount=
    newOps .length i32 cast
      whileData [] .loopStart -
    =:: loopLength
    loopLength JumpDistance cast
    newOps whileData [] .loopStart
      slice.at .data
    .val .block .jumpDistance=
    loopLength -_ JumpDistance cast
  end

  proc(
    BlockId : blockId
    i32 : newIndex
    ProgramContext ptr.mut : program
  -> ) =>: export: updateAnd
    program [] .andOrData
      blockId i32 cast
    list.at .data =:: andOrData
    andOrData [] .andOrCount 0 == if
      newIndex andOrData .blockStart=
    end
    andOrData [] .andOrCount
      newIndex andOrData [] .andOrPositions $2 slice.set
      1 +
    andOrData .andOrCount=
  end
  proc(
    BlockId : blockId
    i32 : newIndex
    ProgramContext ptr.mut : program
  -> ) : export: alias: updateOr updateAnd
  proc(
    BlockId : blockId
    Operation slice.mut : newOps
    ProgramContext ptr.mut : program
  -> JumpDistance ) =>: export: updateEndAndOr
    program [] .andOrData
      blockId i32 cast
    list.at .data =:: andOrData
    andOrData [] .andOrCount for =:: i
      andOrData [] .andOrPositions
        i
      [] =:: andOrPos
      newOps .length i32 cast
        andOrPos - JumpDistance cast
      newOps
        andOrPos slice.at .data
      .val .block .jumpDistance=
    end
    0 andOrData .andOrCount=
    andOrData [] .blockStart
      newOps .length i32 cast -
    JumpDistance cast
  end
end
