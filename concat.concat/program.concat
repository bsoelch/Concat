    program [] .switchData
      blockId i64 cast
    list.at .data =:: switchData
    switchData [] .breakCount for =:: i
      switchData [] .breakPositions
        i
      slice.get =:: breakPos
      newOps .length
        breakPos - JumpDistance cast
      newOps
        breakPos slice.at .data
      .val .block .jumpDistance=
    end
    0 switchData .breakCount=
    switchData [] .switchPosition
      newOps .length -
    JumpDistance cast
  end

  proc(
    BlockId : blockId
    i64 : newIndex
    ProgramContext ptr.mut : program
  -> ) =>: export: updateWhile
    program [] .whileData
      blockId i64 cast
    list.at .data =:: whileData
    newIndex whileData .loopStart=
  end
  proc(
    BlockId : blockId
    i64 : newIndex
    ProgramContext ptr.mut : program
  -> ) =>: export: updateOrDo
    program [] .whileData
      blockId i64 cast
    list.at .data =:: whileData
    whileData [] .orCount
      newIndex whileData [] .orPositions $2 slice.set
      1 +
    whileData .orCount=
