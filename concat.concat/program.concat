union(
            NopType : NOP
         ConstValue : mut: Constant
   ConstReferenceId : mut: ConstantReference
          BlockData : mut: block
          BlockData : mut: blockEnd
     IdentifierInfo : mut: getId
     IdentifierInfo : mut: atId
     IdentifierInfo : mut: initializeId
     IdentifierInfo : mut: autoTypedInitializeId
     IdentifierInfo : mut: declareId
      ProcedureImpl : mut: implementProcedure
      ProcedureImpl : mut: procPtr
            LabelId : getLabel
            LabelId : setLabel
            LabelId : mut: hasLabel
            LabelId : mut: existsLabel
                i64 : mut: getElement
                i64 : mut: setElement
                i64 : mut: hasElement
                  _ : setValue
                  _ : Return
                  _ : New
                  _ : NewReference
                i64 : NewEnum
                i64 : NewEnumReference
  ProcedureCallInfo : call
            BuiltIn : builtIn
                i64 : mut: callPtr
                  _ : argc
                  _ : getArg
                  _ : length
                  _ : size
       AutoCastInfo : mut: autoCast
           CastInfo : mut: Cast
               Type : mut: Cast!
               Type : mut: bitCast
   EqualityOperator : equalityOperator
                  _ : getEnumLabel
                i64 : checkEnumLabel
                i64 : mut: setEnumElement
                i64 : mut: setEnumLabel ## backwards compatibility
                  _ : copy
  StackModification : stackMod
            LabelId : getName
            LabelId : mut: atName
            LabelId : mut: existsName
       TypeModifier : mut: typeModifier
                  _ : Assert
             string : RuntimeAssert
          ErrorType : Error
     TypeMemoryInfo : typeInfo
                  _ : panic
             string : panicWithMessage
       CompilerInfo : compilerInfo
) =:: export: OpValue
struct( OpValue : mut: val Type : mut: dataType FilePosition : mut: pos ) =:: export: Operation
proc( -> OpValue ) =>: export: opValNOP
  NopType .EMPTY OpValue .NOP return
end
proc( FilePosition : pos -> Operation ) =>: export: opNOP
  NopType .EMPTY OpValue .NOP Type .undefined pos Operation new return
end
proc( FilePosition : pos -> Operation ) =>: export: reserveOp
  NopType .RESERVED OpValue .NOP Type .undefined pos Operation new return
end
proc( ConstValue : constValue Type : constType FilePosition : pos -> Operation ) =>: export: opConst
  constValue OpValue .Constant constType pos Operation new return
end

proc( BlockType FilePosition : pos -> Operation ) =>: export: opBlock
  id.LABEL_ID_NONE
    -1:BlockId
    0:JumpDistance
  BlockData new OpValue .block Type .undefined pos Operation new return
end
proc( BlockType LabelId : label FilePosition : pos -> Operation ) =>: export: opLabeledBlock
  label
    -1:BlockId
    0:JumpDistance
  BlockData new OpValue .block Type .undefined pos Operation new return
end
proc( BlockType FilePosition : pos -> Operation ) =>: export: opEndBlock
