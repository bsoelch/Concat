## TODO find& eliminate large entries, extract additional data to seperate storage
union(
            NopType : NOP
         ConstValue : Constant
         ConstValue : StaticConstant
             ProcId : NestedProc
   ConstReferenceId : ConstantReference
          BlockData : block
          BlockData : blockEnd
     IdentifierInfo : getId
     IdentifierInfo : setId
     IdentifierInfo : atId
     IdentifierInfo : initializeId
     IdentifierInfo : autoTypedInitializeId
     IdentifierInfo : declareId
      ProcedureImpl : implementProcedure
      ProcedureImpl : procPtr
            LabelId : getLabel
            LabelId : getUnionLabel
            LabelId : setLabel
            LabelId : existsLabel
                i32 : getElement
                i32 : getUnionElement
                i32 : setElement
                i32 : hasElement
                  _ : Return
            BlockId : InlineReturn ## TODO? remember jump distance
                  _ : New
                  _ : NewReference
                i32 : NewEnum
                i32 : NewEnumReference
      ProcedureCall : call
            BuiltIn : builtIn
        PointerCall : callPtr
                  _ : length
                  _ : rawValue
       AutoCastInfo : autoCast
           CastInfo : Cast
               Type : Cast!
               Type : bitCast
   EqualityOperator : equalityOperator
                  _ : getEnumLabel
                i32 : checkEnumLabel
                i32 : setEnumElement
                  _ : copy
  StackModification : stackMod
            LabelId : getName
            LabelId : setName
            LabelId : atName
            LabelId : existsName
            LabelId : declareName
       NameInitInfo : initializeName
      NameAliasInfo : usingNamespace
      NameAliasInfo : usingIdentifier
       TypeModifier : typeModifier
                  _ : Assert
             string : RuntimeAssert
          ErrorType : Error
     TypeMemoryInfo : typeInfo
                  _ : panic
             string : panicWithMessage
       CompilerInfo : compilerInfo
) =:: export: OpValue
