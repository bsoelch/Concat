struct(
      stringBuilder : fileName
             FileId : id
         id.ScopeId : fileScope
) =:: export: ProgramFile

struct( ConstValue : value FilePosition : pos i32 : caseId ) =:: export: LabelData
proc( ConstValue : label -> i64 ) =>: export: switchLabelAsInt
  label .Int .if
    return
  else .Char ._if
    i64 cast.u return
  else ..drop end
  ## TODO? more usefull error message?
  "unexpected constant-type in switch statement" ..panic
end
proc(
  LabelData : a
  LabelData : b
  ProgramContext ptr : program ## forward compatability
-> i32 ) =>: export: switchLabelCmp
  a .value switchLabelAsInt =:: aInt
  b .value switchLabelAsInt =:: bInt
  aInt bInt == if
    0 return
  end
  aInt bInt < if -1 else 1 end return
end
struct(
  LabelData list : switchLabels
  LocalLabelId slice : branchLabels
  LocalLabelId : defaultLabel
  Type : switchType
) =:: export: SwitchData

struct(
  ProcId list : procedures
) =:: export: ProcedureBundle

## check if composite has any static elements, types are static by default
proc( Type slice : elements LabelId slice : labels TypeContext ptr : typeContext -> bool ) =>: hasStaticElement
  typeContext .labelContext =:: labelContext
  elements .length for =:: i
    i labels .length u< and labels i []
        labelContext id.labelFlags id.FLAG_STATIC & ? if
      true return
    end
    elements i [] typeContext types.isType if
      true return
    end
  end
  false return
end
proc(
  Type : newProcType
  ProcedureInfo ptr.mut : procInfo
  TypeContext ptr : typeContext
-> ) =>: export: setProcType
  newProcType procInfo .procType=
  newProcType typeContext types.getProcIn .else Type slice.empty end =:: inTypes
  newProcType typeContext types.getProcOut .else Type slice.empty end =:: outTypes
  inTypes newProcType typeContext types.getProcArgLabels typeContext hasStaticElement procInfo .hasStaticArg=
  outTypes newProcType typeContext types.getProcRetLabels typeContext hasStaticElement
    procInfo [] .labelId typeContext .labelContext id.labelFlags id.FLAG_STATIC & ? |
  procInfo .isStatic=
end
proc(
  LabelId : procName
  Type : procType
  FileId : fileId
  ProcId : aliasId
  bool : hasImpl
  FilePosition : pos
  ProgramContext ptr.mut : progContext
-> ProcId ) =>: export: newProcData
  progContext .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  procType typeContext types.getProcIn .else
    Type slice.empty
  end =:: inTypes
  procType typeContext types.getProcOut .else
    Type slice.empty
  end =:: outTypes
  inTypes procType typeContext types.getProcArgLabels typeContext hasStaticElement =:: hasStaticArg
  outTypes procType typeContext types.getProcRetLabels typeContext hasStaticElement
    procName labelContext id.labelFlags id.FLAG_STATIC & ? |
  =:: isStatic
  progContext [] .procedures
    $ .length ProcId cast =:: procId
    ## ProcedureInfo
      aliasId NO_PROC != if
        aliasId ProcImplType .Alias
      else hasImpl ! _if
        procName ProcImplType .Extern
      else
        ## CodeProcData
          0 ProcImplementation list.create
          0 VariableInfo list.create
          Operation slice.emptyMutable
          0:i16
          ProcCodeState .PARSING
        CodeProcData new ProcImplType .Code
      end
      procType
      procName
      fileId
      idContext id.currentScope
      hasStaticArg
      isStatic
    ProcedureInfo new list.append
  progContext .procedures=
  procId return
end
proc( -> ProcedureBundle ) =>: export: newProcBundle
  ## ProcedureBundle
    8 ProcId list.create
  ProcedureBundle new
end

