struct(
  ProcImplType : implementation
  Type : procType
  LabelId : labelId
  FileId : fileId
  id.ScopeId : scopeId ## host-scope if parsing, body-scope if type-checked
  bool : hasStaticArg
  bool : isStatic
) =:: export: ProcedureInfo
proc( ProcedureInfo : p -> ) =>: freeProcedure
  p .implementation .?code .if =:: impl
    impl .code slice.free ..drop
    impl .implementations for
      .code slice.free ..drop
    end
  else ..drop end
end
struct(
  ConstValue slice : autoArgs
  LabelId slice.mut : retValueLocations
) =:: CallData
i32 =:: CallDataId
-1:CallDataId =:: NO_CALL_DATA
struct(
  ProcId : procId
  i32 : implementationId
  CallDataId : callDataId
) =:: export: ProcedureCall
struct(
  iSize : outArgCount
  CallDataId : callDataId
) =:: export: PointerCall
struct(
  ProcId : procId
  i32 : implementationId
  ConstValue slice : autoArgs
) =:: export: ProcedureCallInfo
proc(
  ProcedureCallInfo : callInfo
  ProgramContext ptr.mut : context
-> ProcedureCall ) =>: export: callInfoToCall
  context [] .callData
    $ .length =:: callDataId
    ## CallData
      callInfo .autoArgs
      ## TODO? create labels for composite ret-values here and make slice immutable
      LabelId slice.emptyMutable
    CallData new list.append
  context .callData=
  ## ProcedureCall
    callInfo .procId
    callInfo .implementationId
    callDataId CallDataId cast
  ProcedureCall new
end
proc(
  ProcedureCall : call
  ProgramContext ptr.mut : context
-> CallData ptr.mut ) =>: export: getCallData
  context [] .callData call .callDataId i64 cast @[]
end
proc(
  PointerCall : call
  ProgramContext ptr.mut : context
-> CallData ptr.mut ) =>: export: getPtrCallData
  context [] .callData call .callDataId i64 cast @[]
end
