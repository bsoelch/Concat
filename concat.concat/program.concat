  proc(
    BlockId : blockId
    i64 : newIndex
    ProgramContext ptr.mut : program
  -> ) : export: alias: updateAndDo updateBreak
  proc(
    BlockId : blockId
    i64 : newIndex
    ProgramContext ptr.mut : program
  -> ) =>: export: updateContinue
    program [] .whileData
      blockId i64 cast
    list.at .data =:: whileData
    whileData [] .continueCount
      newIndex whileData [] .continuePositions $2 slice.set
      1 +
    whileData .continueCount=
  end
  proc(
    BlockId : blockId
    Operation slice.mut : newOps
    ProgramContext ptr.mut : program
  -> ) =>: export: updateDo
    blockId newOps .length program updateBreak
    program [] .whileData
      blockId i64 cast
    list.at .data =:: whileData
    whileData [] .orCount for =:: i
      whileData [] .orPositions i slice.get =:: orPos
      newOps .length
        orPos - JumpDistance cast
      newOps
        orPos slice.at .data
      .val .block .jumpDistance=
    end
    0 whileData .orCount=
  end
  proc(
    BlockId : blockId
    Operation slice.mut : newOps
    ProgramContext ptr.mut : program
  -> ) =>: export: updateFinally
    program [] .whileData
      blockId i64 cast
    list.at .data =:: whileData
    whileData [] .continueCount for =:: i
      whileData [] .continuePositions
        i
      slice.get =:: continuePos
      newOps .length
        continuePos - JumpDistance cast
      newOps
        continuePos slice.at .data
      .val .block .jumpDistance=
    end
    0 whileData .continueCount=
  end
  proc(
    BlockId : blockId
    Operation slice.mut : newOps
    ProgramContext ptr.mut : program
  -> JumpDistance ) =>: export: updateEndWhile
    program [] .whileData
      blockId i64 cast
    list.at .data =:: whileData
    whileData [] .breakCount for =:: i
      whileData [] .breakPositions i slice.get =:: breakPos
      newOps .length
        breakPos - JumpDistance cast
      newOps
        breakPos slice.at .data
      .val .block .jumpDistance=
    end
    0 whileData .breakCount=
    newOps .length
      whileData [] .loopStart -
    =:: loopLength
    loopLength JumpDistance cast
    newOps whileData [] .loopStart
      slice.at .data
    .val .block .jumpDistance=
    loopLength -_ JumpDistance cast
  end

  proc(
    BlockId : blockId
    i64 : newIndex
    ProgramContext ptr.mut : program
  -> ) =>: export: updateAnd
    program [] .andOrData
      blockId i64 cast
    list.at .data =:: andOrData
    andOrData [] .andOrCount 0 == if
      newIndex andOrData .blockStart=
    end
    andOrData [] .andOrCount
      newIndex andOrData [] .andOrPositions $2 slice.set
      1 +
    andOrData .andOrCount=
  end
  proc(
    BlockId : blockId
    i64 : newIndex
    ProgramContext ptr.mut : program
  -> ) : export: alias: updateOr updateAnd
  proc(
    BlockId : blockId
    Operation slice.mut : newOps
    ProgramContext ptr.mut : program
  -> JumpDistance ) =>: export: updateEndAndOr
    program [] .andOrData
      blockId i64 cast
    list.at .data =:: andOrData
    andOrData [] .andOrCount for =:: i
      andOrData [] .andOrPositions
        i
      slice.get =:: andOrPos
      newOps .length
        andOrPos - JumpDistance cast
      newOps
        andOrPos slice.at .data
      .val .block .jumpDistance=
    end
    0 andOrData .andOrCount=
    andOrData [] .blockStart
      newOps .length -
    JumpDistance cast
  end
end
