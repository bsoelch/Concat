  Type : constType
  ConstValue : value
  FilePosition : pos
) =:: export: TypedConstant

struct(
            IdentifierContext : mut: idContext
             ProgramFile list : mut: progFiles
           ProcedureInfo list : mut: procedures
         ProcedureBundle list : mut: procBundles
                    Type list : mut: autoTypes
               Operation list : mut: tmpOps
  JumpDistance ArenaAllocator : mut: switchJumps
           i64 ArenaAllocator : mut: labelPositions
              SwitchData list : mut: switchData
               WhileData list : mut: whileData
                  IfData list : mut: ifData
               AndOrData list : mut: andOrData
           TypedConstant list : mut: constantReferences
           CompilerError list : mut: errors
                         bool : mut: hasCheckIndex
                         bool : mut: hasCheckEnum
                         bool : mut: hasGetArgs
) =:: export: ProgramContext

proc( -> ProgramContext ) =>: export: newProgramContext
  ## ProgramContext
    id.newIdentifierContext
    16  ProgramFile     list.create
    64  ProcedureInfo   list.create
    64  ProcedureBundle list.create
    32  Type            list.create
    128 Operation       list.create
    1024 JumpDistance   arenaAlloc.create
    1024 i64            arenaAlloc.create
    128 SwitchData      list.create
    128 WhileData       list.create
    256 IfData          list.create
    128 AndOrData       list.create
    32  TypedConstant   list.create
    32  CompilerError   list.create
    false ## hasCheckIndex
    false ## hasCheckEnum
    false ## has getArgs
  ProgramContext new
end
## TODO free Program context

proc( stringBuilder : fileName FileId : id IdentifierContext ptr.mut : idContext -> ProgramFile ) =>: export: newProgFile
  128 Operation list.create
  128 Operation list.create
  128 Operation list.create
  16 IncludedFile list.create
  fileName
  id
  ProgramFile new return
end


proc(
  ConstValue : constValue
  Type : constType
  FilePosition : pos
  ProgramContext ptr.mut : program
-> Operation ) =>: export: opConstReference
  program [] .constantReferences
    ..dup .length ConstReferenceId cast =:: refId
    constType constValue pos TypedConstant new list.append
  program .constantReferences=
  program .idContext .typeContext =:: typeContext
  ## Operation
    refId OpValue .ConstantReference
    constType
    pos
  Operation new return
end

namespace: sb
  proc( stringBuilder : sb StackModification : mod -> stringBuilder ) =>: export: appendStackMod
    sb
      mod .modType switch
        COPY case
          mod .n 0 == if
            "DUP " sb.appendS
          else
            "OVER " sb.appendS
            mod .n sb.appendI
          end
          break
        SWAP case
          "SWAP " sb.appendS
          break
        DROP case
          "DROP " sb.appendS
          mod .n  sb.appendI
          break
      end
    return
  end
  proc( stringBuilder TypeModifier -> stringBuilder ) =>: export: appendTypeModifier
    switch
      PTR case
        "ptr" sb.appendS
        break
      ARRAY case
        "array" sb.appendS
        break
      PTR_MUT case
        "ptr.mut" sb.appendS
        break
    end
  end
  proc( stringBuilder Operation ProgramContext ptr -> stringBuilder ) =>: export: appendOp
    =:: progContext
    progContext .idContext .typeContext =:: typeContext
    progContext .idContext .typeContext .labelContext =:: labelContext
    progContext .idContext .constContext =:: constContext
    ..swap
      ..over .val switch
        NOP case
          "NOP" sb.appendS
          break
        Constant case
          "constant ( " sb.appendS
          ..over .dataType  typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .Constant typeContext sb.appendConstant
          break
        ConstantReference case
          ..over .val .ConstantReference =:: refId
          progContext [] .constantReferences refId i64 cast list.at .data =:: constData
          "constant reference ( " sb.appendS
          constData [] .constType typeContext sb.appendType
          " )[" sb.appendS
          refId i64 cast sb.appendI
          "] : " sb.appendS
          constData [] .value typeContext sb.appendConstant
          break
        block case
          "Block: " sb.appendS
          $1 .val .block .blockType sb.appendBlockType
          " (" sb.appendS
            $1 .val .block .blockId i64 cast sb.appendI
            " ->" sb.appendS
            $1 .val .block .jumpDistance i64 cast sb.appendI
          ')' sb.appendC
          break
        blockEnd case
          "End: " sb.appendS
          $1 .val .blockEnd .blockType sb.appendBlockType
          " (" sb.appendS
            $1 .val .blockEnd .blockId i64 cast sb.appendI
            " ->" sb.appendS
            $1 .val .blockEnd .jumpDistance i64 cast sb.appendI
          ')' sb.appendC
          break
        getId case
          "get ( " sb.appendS
          ..over .dataType  typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .getId labelContext sb.appendIdInfo
          break
        call case ..over =:: op
          op@ .val .call =:: callInfo
          "call ( " sb.appendS
          op .dataType  typeContext sb.appendType
          " ) : " sb.appendS
          progContext [] .procedures
            callInfo [] .procId i64 cast list.at .data
          =:: procInfo
          procInfo [] .labelId labelContext sb.appendLabelPath
          callInfo [] .implementationId 0 >= if
            ## XXX append static args instead of impl id
            " (" sb.appendS
            callInfo [] .implementationId sb.appendI
            ')' sb.appendC
          end
          ## XXX? print auto args
          break
        builtIn case ..over =:: op
          "built-in ( " sb.appendS
          op .dataType  typeContext sb.appendType
          " ) : " sb.appendS
          op .val .builtIn sb.appendBuiltIn
          break
        atId case
          "address ( " sb.appendS
          ..over .dataType  typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .atId labelContext sb.appendIdInfo
          break
        initializeId case
          "initialize ( " sb.appendS
          ..over .dataType  typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .initializeId labelContext sb.appendIdInfo
          break
        implementProcedure case ..over =:: op
          op@ .val .implementProcedure =:: implInfo
          "implement ( " sb.appendS
          op .dataType typeContext sb.appendType
          " ) : " sb.appendS
          progContext [] .procedures
            implInfo [] .procId i64 cast list.at .data
          =:: procInfo
          procInfo [] .labelId labelContext sb.appendLabelPath
          implInfo [] .implementationId 0 >= if
            ## XXX append static args instead of impl id
            " (" sb.appendS
            implInfo [] .implementationId sb.appendI
            ')' sb.appendC
          end
          break
        procPtr case ..over =:: op
          op@ .val .procPtr =:: implInfo
          "procedure pointer ( " sb.appendS
          op .dataType typeContext sb.appendType
          " ) : " sb.appendS
          progContext [] .procedures
            implInfo [] .procId i64 cast list.at .data
          =:: procInfo
          procInfo [] .labelId labelContext sb.appendLabelPath
          implInfo [] .implementationId 0 >= if
            ## XXX append static args instead of impl id
            " (" sb.appendS
            implInfo [] .implementationId sb.appendI
            ')' sb.appendC
          end
          break
        autoTypedInitializeId case
          "auto-typed initialize ( " sb.appendS
          ..over .dataType  typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .autoTypedInitializeId labelContext sb.appendIdInfo
          break
        declareId case
          "declare ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .declareId labelContext sb.appendIdInfo
          break
        getLabel case
          "get label ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .getLabel labelContext sb.appendLabelName
          break
        setLabel case
          "set label ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .setLabel labelContext sb.appendLabelName
          break
        hasLabel case
          "has label ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .hasLabel labelContext sb.appendLabelName
          break
        existsLabel case
          "exists label ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .existsLabel labelContext sb.appendLabelName
          break
        typeModifier case
          "typeModifier \"" sb.appendS
          ..over .val .typeModifier sb.appendTypeModifier
          "\"" sb.appendS
          break
        getElement case
          "get element ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .getElement sb.appendI
          break
        setElement case
          "set element ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .setElement sb.appendI
          break
        hasElement case
          "has element ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .hasElement sb.appendI
          break
        setValue case
          "set value ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " )" sb.appendS
          break
        Return case
          "Return( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ) " sb.appendS
          break
        equalityOperator case
          ..over .val .equalityOperator switch
            EQ case "Equal ( " sb.appendS break
            NEQ case "Not Equal ( " sb.appendS break
          end
          ..over .dataType typeContext sb.appendType
          " )" sb.appendS
          break
        New case
          "new: " sb.appendS
          ..over .dataType typeContext sb.appendType
          break
        NewReference case
          "new reference: " sb.appendS
          ..over .dataType typeContext sb.appendType
          break
        NewEnum case
          "new enum ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .NewEnum sb.appendI
          break
        NewEnumReference case
          "new enum reference ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .NewEnumReference sb.appendI
          break
        autoCast case
          "autoCast ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ) src: " sb.appendS
          ..over .val .autoCast .src typeContext sb.appendType
          " at " sb.appendS
          ..over .val .autoCast .offset sb.appendI
          break
        Cast case
          ..over .val .Cast .signType switch
            NONE case break
            SIGNED case "signed" sb.appendS break
            UNSIGNED case "unsigned" sb.appendS break
          end
          "cast ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ) src: " sb.appendS
          ..over .val .Cast .src typeContext sb.appendType
          break
        Cast! case
          "cast! ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ) src: " sb.appendS
          ..over .val .Cast! typeContext sb.appendType
          break
        bitCast case
          "bitCast ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ) src: " sb.appendS
          ..over .val .bitCast typeContext sb.appendType
          break
        callPtr case
          "call pointer ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " )" sb.appendS
          break
        argc case
          "get program argument count ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " )" sb.appendS
          break
        getArg case
          "get program argument ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " )" sb.appendS
          break
        length case
          "length ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " )" sb.appendS
          break
        size case
          "size ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " )" sb.appendS
          break
        typeInfo case
          "typeInfo ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ): " sb.appendS
          ..over .val .typeInfo switch
            ALIGNMENT case "alignment" sb.appendS break
            SIZE case "size" sb.appendS break
            STRIDE case "stride" sb.appendS break
          end
          break
        getEnumLabel case
          "get enum label ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " )" sb.appendS
          break
        checkEnumLabel case
          "check enum label ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .checkEnumLabel sb.appendI
          break
        setEnumLabel case
          "set enum label ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .setEnumLabel sb.appendI
          break
        setEnumElement case
          "set enum element ( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " ) : " sb.appendS
          ..over .val .setEnumElement sb.appendI
          break
        stackMod case
          "stack modification: " sb.appendS
          ..over .val .stackMod sb.appendStackMod
          break
        copy case
          "copy( " sb.appendS
          ..over .dataType typeContext sb.appendType
          " )" sb.appendS
          break
        getName case
          "get: " sb.appendS
          ..over .val .getName labelContext sb.appendLabelPath
          break
        atName case
          "address of: " sb.appendS
          ..over .val .atName labelContext sb.appendLabelPath
          break
        existsName case
          "exists name: " sb.appendS
          ..over .val .existsName labelContext sb.appendLabelPath
          break
        Assert case
          "assert" sb.appendS
          break
        RuntimeAssert case
          '"' sb.appendC
          ..over .val .RuntimeAssert sb.appendStr
          "\" assert" sb.appendS
          break
        Error case
          ..over .val .Error switch
            ERROR case "..compiler.error" sb.appendS break
            WARNING case "..compiler.warning" sb.appendS break
            INFO case "..compiler.info" sb.appendS break
          end
          break
        panic case
          "..panic" sb.appendS
          break
        panicWithMessage case
          '"' sb.appendC
          ..over .val .panicWithMessage sb.appendEscapedStr
          "\" ..panic" sb.appendS
          break
        compilerInfo case
          ..over .val .compilerInfo labelContext sb.appendCompilerInfo
          break
      end
      " at " sb.appendS
      ..swap .pos sb.appendPos
      '\n' sb.appendC
    return
  end
  proc( stringBuilder CompilerError -> stringBuilder ) =>: export: appendCompilerError
    =:: err
    err .message sb.appendSb
    " at "       sb.appendS
    err .pos     sb.appendPos
    '\n'         sb.appendC
  end
  proc( stringBuilder CompilerInfo LabelContext ptr -> stringBuilder ) =>: export: appendCompilerInfo
    =:: labelContext
    =:: info
    info switch
      typeInfo case
        "..?types" sb.appendS
        info .typeInfo .count 0 > if
          '.' sb.appendC
          info .typeInfo .count sb.appendI
        end
        info .typeInfo .depth 0 > if
          '.' sb.appendC
          info .typeInfo .depth sb.appendI
        end
        break
      stackInfo case
        "..?stack" sb.appendS
        info .stackInfo 0 > if
          '.' sb.appendC
          info .stackInfo sb.appendI
        end
        break
      compiledOps case
        "..?ops" sb.appendS
        info .compiledOps 0 > if
          '.' sb.appendC
          info .compiledOps sb.appendI
        end
        break
      find case
        "..?find." sb.appendS
        info .find labelContext sb.appendLabelPath
        break
    end
  end
  proc( stringBuilder ProgramContext ptr -> stringBuilder ) =>: export: appendProgram
    =:: prog
      "## errors:\n" sb.appendS
      0:i64 while ..dup prog [] .errors .length < do
        ..swap
          prog [] .errors ..over.2 list.get sb.appendCompilerError
        ..swap
        1 +
      end ..drop
      0:i64 while ..dup prog [] .progFiles .length < do
        ..swap
          prog [] .progFiles ..over.2 list.get =:: f
          "## "          sb.appendS
          f .fileName    sb.appendSb
          '\n'           sb.appendC
          "## global:\n" sb.appendS
          0:i64 while ..dup f .globalOps .length < do
            ..swap
              f .globalOps ..over.2 list.get prog sb.appendOp
            ..swap
            1 +
          end ..drop
          "## local:\n" sb.appendS
          0:i64 while ..dup f .localOps .length < do
            ..swap
              f .localOps ..over.2 list.get prog sb.appendOp
            ..swap
            1 +
          end ..drop
          "## tmp:\n" sb.appendS
          0:i64 while ..dup f .tmpOps .length < do
            ..swap
              f .tmpOps ..over.2 list.get prog sb.appendOp
            ..swap
            1 +
          end ..drop
        ..swap
        1 +
      end ..drop
      "## temporary code:\n" sb.appendS
      0:i64 while ..dup prog [] .tmpOps .length < do
        ..swap
          prog [] .tmpOps ..over.2 list.get prog sb.appendOp
        ..swap
        1 +
      end ..drop
  end
end

namespace: program.jumps
  proc(
    BlockId : blockId
    i64 : newIndex
    ProgramContext ptr.mut : program
  -> ) =>: export: updateAndIf
    program [] .ifData
      blockId i64 cast
    list.at .data =:: ifData
    ifData [] .andCount ifData [] .orCount + 0 == if
      newIndex ifData .blockStart=
    end
    ifData [] .andCount
      newIndex ifData [] .andPositions $2 slice.set
      1 +
    ifData .andCount=
  end
  proc(
    BlockId : blockId
    i64 : newIndex
    ProgramContext ptr.mut : program
  -> ) =>: export: updateOrIf
    program [] .ifData
      blockId i64 cast
    list.at .data =:: ifData
    ifData [] .andCount ifData [] .orCount + 0 == if
      newIndex ifData .blockStart=
    end
    ifData [] .orCount
      newIndex ifData [] .orPositions $2 slice.set
      1 +
    ifData .orCount=
  end
  proc(
    BlockId : blockId
    Operation slice.mut : newOps
    ProgramContext ptr.mut : program
  -> ) =>: export: updateIf
    program [] .ifData
      blockId i64 cast
    list.at .data =:: ifData
    ifData [] .andCount ifData [] .orCount + 0 == if
      newOps .length ifData .blockStart=
    end
    newOps .length ifData .ifPosition=
    ifData [] .orCount for =:: i
      ifData [] .orPositions
        i
      slice.get =:: orPos
      newOps .length
        orPos - JumpDistance cast
      newOps
        orPos slice.at .data
      .val .block .jumpDistance=
    end
    0 ifData .orCount=
  end
  proc(
    BlockId : blockId
    Operation slice.mut : newOps
    ProgramContext ptr.mut : program
  -> ) =>: export: updateElse
    program [] .ifData
      blockId i64 cast
    list.at .data =:: ifData
    newOps .length ifData .elsePosition=
    ifData [] .andCount for =:: i
      ifData [] .andPositions
        i
      slice.get =:: andPos
      newOps .length
        andPos - JumpDistance cast
      newOps
        andPos slice.at .data
      .val .block .jumpDistance=
    end
    0 ifData .andCount=
    newOps .length
      ifData [] .ifPosition - JumpDistance cast
    newOps
      ifData [] .ifPosition slice.at .data
    .val .block .jumpDistance=
  end
  proc(
    BlockId : blockId
    Operation slice.mut : newOps
    ProgramContext ptr.mut : program
  -> JumpDistance ) =>: export: updateEndIf
    program [] .ifData
      blockId i64 cast
    list.at .data =:: ifData
    newOps .length
      ifData [] .elsePosition - JumpDistance cast
    newOps
      ifData [] .elsePosition slice.at .data
    .val .block .jumpDistance=
    ifData [] .blockStart
      newOps .length -
    JumpDistance cast
  end

  proc(
    BlockId : blockId
    i64 : newIndex
    ProgramContext ptr.mut : program
  -> ) =>: export: updateSwitch
    newIndex
      program [] .switchData blockId i64 cast list.at .data
    .switchPosition=
  end
  proc(
    BlockId : blockId
    i64 : newIndex
    ProgramContext ptr.mut : program
  -> ) =>: export: updateCase
    program [] .switchData
      blockId i64 cast
    list.at .data =:: switchData
    switchData [] .caseCount
      newIndex
        switchData [] .switchPosition - JumpDistance cast
      switchData [] .caseJumpDistances $2 slice.set
      1 +
    switchData .caseCount=
  end
  proc(
    BlockId : blockId
    i64 : newIndex
    ProgramContext ptr.mut : program
  -> ) =>: export: updateDefault
    program [] .switchData
      blockId i64 cast
    list.at .data =:: switchData
    newIndex
      switchData [] .switchPosition - JumpDistance cast
    switchData .defaultJumpDistance=
  end
