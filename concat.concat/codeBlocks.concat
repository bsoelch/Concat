import stringBuilder

import "common.concat"

enum(
  UNKNOWN
  PROCEDURE
  EXPERIMENTAL_PROCEDURE
  IF
  IFIF
  AND_IF
  OR_IF
  ELSE
  WHILE
  DO
  AND_DO
  OR_DO
  BREAK
  CONTINUE
  SWITCH
  BREAK_SWITCH
  CASE
  DEFAULT
  AND
  OR
  INITIALIZER
  TYPE_TUPLE
  TYPE_STRUCT
  TYPE_ENUM
  TYPE_UNION
  TYPE_PROC_IN
  TYPE_PROC_OUT
  TYPE_COMPOSITE
  NAMESPACE
) =:: export: BlockType
struct(
  BlockType : blockType
  LabelId : blockLabel
  i32 : mut: blockId
  i32 : mut: subId
) =:: export: BlockId
namespace: sb
  proc( stringBuilder BlockType -> stringBuilder ) =>: export: appendBlockType
    switch
      UNKNOWN case
        "unknown" sb.appendS
        return
      PROCEDURE case
        "procedure" sb.appendS
        return
      EXPERIMENTAL_PROCEDURE case
        "procedure(experimental)" sb.appendS
        return
      IF case
        "if" sb.appendS
        return
      IFIF case
        "if _if" sb.appendS
        return
      ELSE case
        "else" sb.appendS
        return
      WHILE case
        "while" sb.appendS
        return
      DO case
        "do" sb.appendS
        return
      BREAK case
        "break" sb.appendS
        return
      BREAK_SWITCH case
        "break switch" sb.appendS
        return
      CONTINUE case
        "continue" sb.appendS
        return
      SWITCH case
        "switch" sb.appendS
        return
      CASE case
        "case" sb.appendS
        return
      DEFAULT case
        "default" sb.appendS
        return
      AND case
        "and" sb.appendS
        return
      OR case
        "or" sb.appendS
        return
      AND_IF case
        "and if" sb.appendS
        return
      OR_IF case
        "or if" sb.appendS
        return
      AND_DO case
        "and do" sb.appendS
        return
      OR_DO case
        "or do" sb.appendS
        return
      INITIALIZER case
        "{initializer}" sb.appendS
        return
      TYPE_COMPOSITE case
        "( )" sb.appendS
        return
      TYPE_TUPLE case
        "tuple( )" sb.appendS
        return
      TYPE_STRUCT case
        "struct( )" sb.appendS
        return
      TYPE_ENUM case
        "enum( )" sb.appendS
        return
      TYPE_UNION case
        "union( )" sb.appendS
        return
      TYPE_PROC_IN case
        "proc( )" sb.appendS
        return
      TYPE_PROC_OUT case
        "proc( -> )" sb.appendS
        return
      NAMESPACE case
        "namespace" sb.appendS
        return
    end
  end
end
