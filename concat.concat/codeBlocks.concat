import stringBuilder

import "common.concat"
import "names.concat"

enum(
  UNKNOWN
  PROCEDURE
  IF
  AND_IF
  OR_IF
  ELSE
  WHILE
  DO
  AND_DO
  OR_DO
  BREAK
  CONTINUE
  FINALLY
  SWITCH
  CASE DOT_CASE
  DEFAULT DOT_DEFAULT
  AND
  OR
  INITIALIZER
  TYPE_TUPLE
  TYPE_STRUCT
  TYPE_ENUM
  TYPE_UNION
  TYPE_UNTAGGED_UNION
  TYPE_PROC_IN
  TYPE_CPROC_IN
  TYPE_PROC_ARROW
  TYPE_COMPOSITE
  TYPE_SETTYPE
  NAMESPACE OVERLOAD
  STATIC_FOR
) =:: export: BlockType
i32 =:: export: JumpDistance
( char8 ptr.raw iSize -> JumpDistance ) : static: export: alias: :JumpDistance ..builtIn.parse.i32
namespace: JumpDistance
  ( JumpDistance -> bool ) : alias: toBool i32.toBool
end
overload: ? JumpDistance.toBool end
struct(
  NameId optional : blockName
  JumpDistance : jumpDistance
  BlockType : blockType
) =:: export: BlockData
namespace: sb
  proc( stringBuilder BlockType -> stringBuilder ) =>: export: appendBlockType
    switch
      UNKNOWN case
        "unknown":s sb.appendStr
        return
      PROCEDURE case
        "procedure":s sb.appendStr
        return
      IF case
        "if":s sb.appendStr
        return
      ELSE case
        "else":s sb.appendStr
        return
      WHILE case
        "while":s sb.appendStr
        return
      DO case
        "do":s sb.appendStr
        return
      BREAK case
        "break":s sb.appendStr
        return
      CONTINUE case
        "continue":s sb.appendStr
        return
      FINALLY case
        "finally":s sb.appendStr
        return
      SWITCH case
        "switch":s sb.appendStr
        return
      CASE case
        "case":s sb.appendStr
        return
      DOT_CASE case
        ".case":s sb.appendStr
        return
      DEFAULT case
        "default":s sb.appendStr
        return
      DOT_DEFAULT case
        ".default":s sb.appendStr
        return
      AND case
        "and":s sb.appendStr
        return
      OR case
        "or":s sb.appendStr
        return
      AND_IF case
        "and if":s sb.appendStr
        return
      OR_IF case
        "or if":s sb.appendStr
        return
      AND_DO case
        "and do":s sb.appendStr
        return
      OR_DO case
        "or do":s sb.appendStr
        return
      INITIALIZER case
        "{initializer}":s sb.appendStr
        return
      TYPE_COMPOSITE case
        "( )":s sb.appendStr
        return
      TYPE_TUPLE case
        "tuple( )":s sb.appendStr
        return
      TYPE_STRUCT case
        "struct( )":s sb.appendStr
        return
      TYPE_ENUM case
        "enum( )":s sb.appendStr
        return
      TYPE_UNION case
        "union( )":s sb.appendStr
        return
      TYPE_UNTAGGED_UNION case
        "union( )":s sb.appendStr
        return
      TYPE_PROC_IN case
        "proc( )":s sb.appendStr
        return
      TYPE_CPROC_IN case
        "proc.c( )":s sb.appendStr
        return
      TYPE_PROC_ARROW case
        "->":s sb.appendStr
        return
      TYPE_SETTYPE case
        "oneOf( )":s sb.appendStr
        return
      NAMESPACE case
        "namespace":s sb.appendStr
        return
      OVERLOAD case
        "overload":s sb.appendStr
        return
      STATIC_FOR case
        "static-for":s sb.appendStr
      return
    end
  end
end
