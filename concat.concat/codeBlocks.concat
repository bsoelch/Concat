import stringBuilder

enum(
  UNKNOWN
  PROCEDURE
  EXPERIMENTAL_PROCEDURE
  IF
  IFIF
  ELSE
  WHILE
  DO
  BREAK
  CONTINUE
  SWITCH
  CASE
  DEFAULT
  INITIALIZER
  TYPE_TUPLE
  TYPE_STRUCT
  TYPE_ENUM
  TYPE_UNION
  TYPE_PROC_IN
  TYPE_PROC_OUT
  TYPE_COMPOSITE
) =:: export BlockType
struct( BlockType : blockType i32 : mut blockId i32 : mut subId ) =:: export BlockId
#namespace sb
  proc( stringBuilder BlockType => stringBuilder ) =: export appendBlockType
    switch
      UNKNOWN case
        "unknown" sb.appendS
        return
      PROCEDURE case
        "procedure" sb.appendS
        return
      EXPERIMENTAL_PROCEDURE case
        "procedure(experimental)" sb.appendS
        return
      IF case
        "if" sb.appendS
        return
      IFIF case
        "if _if" sb.appendS
        return
      ELSE case
        "else" sb.appendS
        return
      WHILE case
        "while" sb.appendS
        return
      DO case
        "do" sb.appendS
        return
      BREAK case
        "break" sb.appendS
        return
      CONTINUE case
        "continue" sb.appendS
        return
      SWITCH case
        "switch" sb.appendS
        return
      CASE case
        "case" sb.appendS
        return
      DEFAULT case
        "default" sb.appendS
        return
      INITIALIZER case
        "{initializer}" sb.appendS
        return
      TYPE_COMPOSITE case
        "( )" sb.appendS
        return
      TYPE_TUPLE case
        "tuple( )" sb.appendS
        return
      TYPE_STRUCT case
        "struct( )" sb.appendS
        return
      TYPE_ENUM case
        "enum( )" sb.appendS
        return
      TYPE_UNION case
        "union( )" sb.appendS
        return
      TYPE_PROC_IN case
        "proc( )" sb.appendS
        return
      TYPE_PROC_OUT case
        "proc( => )" sb.appendS
        return
    end
  end
#end
