import stringBuilder

import "common.concat"

enum(
  UNKNOWN
  PROCEDURE
  INLINE_PROCEDURE
  IF
  AND_IF
  OR_IF
  ELSE
  ## if-block with known condition
  IF_TRUE IF_FALSE
  AND_TRUE AND_FALSE
  OR_TRUE OR_FALSE
  ELSE_TRUE ELSE_FALSE
  WHILE
  DO
  AND_DO
  OR_DO
  BREAK
  CONTINUE
  FINALLY
  SWITCH
  BREAK_SWITCH
  CASE DOT_CASE
  DEFAULT
  AND
  OR
  INITIALIZER
  TYPE_TUPLE
  TYPE_STRUCT
  TYPE_ENUM
  TYPE_UNION
  TYPE_UNTAGGED_UNION
  TYPE_PROC_IN
  TYPE_CPROC_IN
  TYPE_PROC_ARROW
  TYPE_COMPOSITE
  TYPE_SETTYPE
  NAMESPACE OVERLOAD
) =:: export: BlockType
i32 =:: export: BlockId
i32 =:: export: JumpDistance
namespace: JumpDistance
  ( JumpDistance -> bool ) : alias: toBool i32.toBool
end
overload: ? JumpDistance.toBool end
struct(
  BlockType : blockType
  LabelId : blockLabel
  BlockId : blockId
  JumpDistance : jumpDistance
) =:: export: BlockData
namespace: sb
  proc( stringBuilder BlockType -> stringBuilder ) =>: export: appendBlockType
    switch
      UNKNOWN case
        "unknown" sb.appendS
        return
      PROCEDURE case
        "procedure" sb.appendS
        return
      INLINE_PROCEDURE case
        "inline-procedure" sb.appendS
        return
      IF case
        "if" sb.appendS
        return
      ELSE case
        "else" sb.appendS
        return
      IF_TRUE case
        "true if" sb.appendS
        return
      IF_FALSE case
        "false if" sb.appendS
        return
      ELSE_TRUE case
        "false if ... else" sb.appendS
        return
      ELSE_FALSE case
        "true if ... else" sb.appendS
        return
      WHILE case
        "while" sb.appendS
        return
      DO case
        "do" sb.appendS
        return
      BREAK case
        "break" sb.appendS
        return
      BREAK_SWITCH case
        "break switch" sb.appendS
        return
      CONTINUE case
        "continue" sb.appendS
        return
      FINALLY case
        "finally" sb.appendS
        return
      SWITCH case
        "switch" sb.appendS
        return
      CASE case
        "case" sb.appendS
        return
      DOT_CASE case
        ".case" sb.appendS
        return
      DEFAULT case
        "default" sb.appendS
        return
      AND case
        "and" sb.appendS
        return
      OR case
        "or" sb.appendS
        return
      AND_IF case
        "and if" sb.appendS
        return
      OR_IF case
        "or if" sb.appendS
        return
      AND_TRUE case
        "true and" sb.appendS
        return
      AND_FALSE case
        "false and" sb.appendS
        return
      OR_TRUE case
        "true or" sb.appendS
        return
      OR_FALSE case
        "false or" sb.appendS
        return
      AND_DO case
        "and do" sb.appendS
        return
      OR_DO case
        "or do" sb.appendS
        return
      INITIALIZER case
        "{initializer}" sb.appendS
        return
      TYPE_COMPOSITE case
        "( )" sb.appendS
        return
      TYPE_TUPLE case
        "tuple( )" sb.appendS
        return
      TYPE_STRUCT case
        "struct( )" sb.appendS
        return
      TYPE_ENUM case
        "enum( )" sb.appendS
        return
      TYPE_UNION case
        "union( )" sb.appendS
        return
      TYPE_UNTAGGED_UNION case
        "union( )" sb.appendS
        return
      TYPE_PROC_IN case
        "proc( )" sb.appendS
        return
      TYPE_CPROC_IN case
        "proc.c( )" sb.appendS
        return
      TYPE_PROC_ARROW case
        "->" sb.appendS
        return
      TYPE_SETTYPE case
        "oneOf( )" sb.appendS
        return
      NAMESPACE case
        "namespace" sb.appendS
        return
      OVERLOAD case
        "overload" sb.appendS
        return
    end
  end
end
