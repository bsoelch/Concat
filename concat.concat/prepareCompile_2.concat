#+
converts code from pure stack code to code targeting a "real" machine as a
common first step for all compiler back-ends:
* limit size of stack-values
* explicitly create temporary variables for copy/output arguments
+#
'arenaAlloc' import

"program" import
"measure" import
"branchTree" import
"LIR" import
using id.IdentifierFlag
using LIROp.ValType
using: ValType LIROp.ValType.
using LIROp.new.

union(
  _ : Empty
  ValType : Value
  ( ValType ValType ) : Val2
  ( ValType ValType ValType ) : Val3
  _ : Reference
  ## TODO: seperate StackValues for compressed composites (needed for C ABI)
  ## ValType : Composite
  ## ( ValType ValType ) : Composite2
  ## ValType : UnionElement
  ## ( ValType ValType ) : UnionElement2
  ## ( ValType ValType ValType ) : UnionElement3
  ## ( ValType ValType ) : TaggedUnionElement
  ## ( ValType ValType ValType ) : TaggedUnionElement2
) =:: StackValue
namespace: StackValue
  proc( StackValue -> i32 ) =>: slots
    switch
      Empty case 0 return
      Reference Value case 1 return
      Val2 case 2 return
      Val3 case 3 return
    end
  end
  proc( StackValue ValType 4 ptr.mut -> ValType slice ) =>: slotTypes
    >$ switch
      Reference Empty case ..drop ValType slice.empty return
      Value .case $1 0 =[] 1 slice.create return
      Val2 .case ... ## <s> <0> <1>
        $2 1 =[]
        $1 0 =[]
        2 slice.create
      return
      Val3 .case ... ## <s> <0> <1> <2>
        $3 2 =[]
        $2 1 =[]
        $1 0 =[]
        3 slice.create
      return
    end
  end
  proc( StackValue StackValue -> StackValue ) =>: unionMerge
    ## if one of values is reference, return that value
    ## if one value is empty return the other value
    $ .Reference ? or $1 .Empty ? if >$ ..drop return end
    $1 .Reference ? or $ .Empty ? if ..drop return end
    ## get slots
    ValType 4 array new =:: mut: slotsA
    ValType 4 array new =:: mut: slotsB
    >$ slotsA@ StackValue.slotTypes .length
    >$ slotsB@ StackValue.slotTypes .length
    iSize.max $ for
      slotsA $1 [] slotsB $2 [] ValType.mergeUnionElt .else
        ..drop.2 StackValue .Reference return
      end slotsA@ >>$ =[]
    end switch
      0 case StackValue .Empty return
      1 case slotsA 0 [] StackValue .Value return
      2 case
        slotsA 0 [] slotsA 1 [] ( ValType ValType ) new
      StackValue .Val2 return
      3 case
        slotsA 0 [] slotsA 1 [] slotsA 2 [] ( ValType ValType ValType ) new
      StackValue .Val3 return
      default StackValue .Reference return
    end
  end
  proc( ValType list StackValue -> ValType list ) =>: listAppend
    switch
      Empty case return
      Reference case ValType .PTR list.append return
      Value .case list.append return
      Val2 .case ... ## <l> <0> <1>
        <<$ list.append >$ list.append
      return
      Val3 .case ... >>>$ ## <0> <1> <2> <l>
        >>>$ list.append
        >>$ list.append
        >$ list.append
      return
    end
  end
  proc( stringBuilder StackValue -> stringBuilder ) =>: sbAppend
    switch
      Empty case "empty":s sb.appendStr return
      Reference case "reference":s sb.appendStr return
      Value .case ValType.sbAppend return
      Val2 .case ... ## <sb> <0> <1>
        <<$ ValType.sbAppend
        >$ ValType.sbAppend
      return
      Val3 .case ... >>>$ ## <0> <1> <2> <sb>
        >>>$ ValType.sbAppend
        >>$ ValType.sbAppend
        >$ ValType.sbAppend
      return
    end
  end
end

struct(
  ProgramContext ptr.mut : program
  VariableInfo list : variables
  StackValue BranchTree : stack
  NameId optional slice.mut : outArgNames
  Type optional : currentProcType
  FileId : currentFile
  bool : reachable
) =:: ConverterContext

proc(
  Type : varType
  bool : mutable
  FilePosition ptr : pos
  ConverterContext ptr.mut : context
-> IdentifierInfo ) =>: newTmpVar ## TODO? merge with id.newTmpVar
  context [] .program .idContext =:: idContext
  idContext .typeContext .nameContext =:: nameContext
  id.FLAG_NONE mutable if
    id.FLAG_MUTABLE | IdentifierFlag cast
  end =:: flags
  ## newIdentifier
    flags ## TODO? special flag for tmp vars
    pos
    nameContext
  id.newTmpIdentifier =:: nameId
  nameId varType pos idContext id.declareTmpVar
  context [] .variables
    nameId varType VariableType .TMP_VAR VariableInfo new list.append
  context .variables=
  ## IdInfo
    nameId
    IdentifierType .TMP_VAR false
  IdentifierInfo new return
end

proc( CompareType bool : isFloat -> CompareType ) =>: flipCmpType
  switch
    NONE case CompareType .NONE break
    TRUE case CompareType .FALSE break
    FALSE case CompareType .TRUE break
    EQ case CompareType .NE break
    NE case CompareType .EQ break
    LT case isFloat if CompareType .UGE else CompareType .GE end break
    LE case isFloat if CompareType .UGT else CompareType .GT end break
    GE case isFloat if CompareType .ULT else CompareType .LT end break
    GT case isFloat if CompareType .ULE else CompareType .LE end break
    ULT case isFloat if CompareType .GE else CompareType .UGE end break
    ULE case isFloat if CompareType .GT else CompareType .UGT end break
    UGE case isFloat if CompareType .LT else CompareType .ULT end break
    UGT case isFloat if CompareType .LE else CompareType .ULE end break
  end
end
proc( CompareType #+prev cmpType+# CompareType LIROp.typed #+cmpOp+# -> CompareType ValType ) =>: mergeJumpIf
  $1 .FALSE or $1 .TRUE end "can only merge cmp.true and cmp.false" assert
  >$ .FALSE =:: flip
  $ .val
    flip if
      $1 .valType ValType.isFloat flipCmpType
    end
  >$ .valType
end
## TODO? merge built-ins: `compare + not` -> `compare`, `and + 0 eq/ne` -?> `bit-test`

proc( LIROp list
  i64 : offset
  FilePosition ptr : pos
-> LIROp list ) =>: offsetPointer
  offset 0 == if return end ## no offset -> no change
  ## merge chained (constant) pointer offset
  $ list.peek .and .data .Arithmetic .and .val [] .ADD and
      $ $ .length 2 - list.at .and .data .ConstInt .if .val [] =:: prev_offset
    $ .length 2 - list.setLength ## discard previous operations
    offset prev_offset +
  else
    offset
  end ValType.I_SIZE pos lirIntConst list.append
  LIROp.Arithmetic .ADD ValType.I_SIZE pos lirArithmetic list.append
end
proc( LIROp list
  Type : refBase
  i32 : index
  FilePosition ptr : pos
  TypeContext ptr.mut : typeContext
-> LIROp list Type ) =>: applyElementOffset
  refBase index typeContext types.tupleElementOffset .if =:: offset
    offset pos offsetPointer
      refBase index typeContext types.compositeGetElement optional.unwrap
    return
  else refBase typeContext types.isRawUnion _if
    ## no pointer change needed
      refBase index typeContext types.compositeGetElement optional.unwrap
    return
  else refBase typeContext types.getArrayBaseType ._if =:: arrayBase
    arrayBase typeContext types.strideOf .Fixed .else
      "array-element not fixed-sized" ..panic
    end =:: eltSize
    index i64 cast.u eltSize * pos offsetPointer
      arrayBase
    return
  else
    "unsupported type for get-element" ..panic
  end
end

## TODO: find good data format for procedure signature
## need:
##   * list of stack values passed to procedure
##   * list of values returned from procedure
##   * storage locations for reference out-types
## ? remember corresponding source slot
struct(
  ValType slice : data ## outArgs inOutArgs inArgs -- retTypes
  i32 : argCount
  i32 : outArgCount
  i32 : inOutCount
) =:: ProcCallInfo
namespace: ProcCallInfo
  proc( ProcCallInfo ProgramContext ptr.mut : program -> LIROp.ProcTypeInfo ptr ) =>: toProcType
    program [] .programMemory ## <callInfo> <typeInfo> <memory>
      LIROp.ProcTypeInfo mixedArena.alloc <$
    program .programMemory=
    $1 .data $1 .data=
    $1 .argCount $1 .argCount=
    >$ .outArgCount $1 .outArgCount=
  end
end
proc( LIROp list Type : calledType FilePosition ptr : pos ConverterContext ptr.mut : context -> LIROp list ProcCallInfo ) =>: determineProcType
  context [] .program =:: program
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .nameContext =:: nameContext
  calledType typeContext types.getProcIn .else "proc without in" ..panic end =:: args
  calledType typeContext types.getProcArgNames =:: argNames
  calledType typeContext types.getProcOut .else "proc without out" ..panic end =:: outTypes
  calledType typeContext types.getCallConvention =:: callConvention
  ## TODO error for non-primitive value in ccall (currently not supported)
  ## TODO? reuse list
  0 =:: mut: outArgCount
  0 =:: mut: inOutCount
  ValType list.empty
    outTypes .length for =:: index
      outTypes index []
      ## ignore empty ret-values
      $ typeContext types.isEmpty if
        ..drop continue
      end
      pos program toValTypes .Reference .if ..drop
        ## TODO? only return reference if it is the last return value
        ## TODO argument merging for first slot (? first slot of given type)
        ## TODO prepare slots for reference return values
        ValType .PTR list.append
        outArgCount 1 + outArgCount=
      else StackValue.listAppend end
    end
    $ .length =:: retCount
    ## pass memory locations for out-args
    outArgCount for ..drop ValType .PTR list.append end
    args .length for =:: index
      args index [] =:: arg
      ## ignore static and empty arguments
      arg typeContext types.isEmpty or
          argNames index slice.get .and .and id.identifierFlags id.FLAG_STATIC & ? if
        continue
      end
      arg pos program toValTypes StackValue.listAppend
    end
    program [] .programMemory
      $1 .length i32 cast.u ValType mixedArena.allocSlice <$
    program .programMemory=
    list.wrapSlice list.clear
      $1 list.asSlice retCount slice.cutIndex >>$ ## tmpList retType argTypes dstList
      >$ list.appendSlice
      >$ list.appendSlice
    list.asSlice <$
  list.free ..drop
  ## ProcCallInfo
    $ .length retCount - i32 cast.u
    outArgCount
    inOutCount
  ProcCallInfo new
end

proc( Type FilePosition ptr : pos ProgramContext ptr.mut : program -> StackValue ) =>: toValTypes
  program .errors =:: errors
  program .idContext .typeContext =:: typeContext
  ValType 4 array : mut: eltBuffer
  typeContext types.unwrapNamed .PrimitiveType .if switch
      BOOL case ValType .BOOL break
      I8  case ValType .I8 break
      I16 case ValType .I16 break
      I32 case ValType .I32 break
      I64 case ValType .I64 break
      F16 case ValType .F16 break
      F32 case ValType .F32 break
      F64 case ValType .F64 break
      TYPE case ValType .PTR break
    end StackValue .Value return
  else $ typeContext types.isCallable _if ..drop
    ValType .FPTR StackValue .Value return
  else $ typeContext types.isPointer _if ..drop
    ValType .PTR StackValue .Value return
  else $ typeContext types.isEnum _if
    typeContext types.enumTagInfo ..drop pos program toValTypes return
  else $ typeContext types.isTupleLike _if
    eltBuffer@ list.wrapBuffer
      >$ typeContext types.compositeElts for
        pos program toValTypes switch
          Empty case break
          Reference case ..drop StackValue .Reference return
          Value .case
            $1 .length eltBuffer ..length 1 - u>= if
              ..drop.2 StackValue .Reference return
            end
            list.append
          break
          Val2 .case
            $1 .length eltBuffer ..length 2 - u>= if
              ..drop.2 StackValue .Reference return
            end ...
            <<$ list.append
            >$ list.append
          break
          Val3 .case
            $1 .length eltBuffer ..length 3 - u>= if
              ..drop.2 StackValue .Reference return
            end ...
            >>>$ >>>$ list.append
            >>$ list.append
            >$ list.append
          break
        end
      end
    $ .length switch
      0 case ..drop StackValue .Empty return
      1 case 0 [] StackValue .Value return
      2 case
        $ 0 [] >$ 1 [] ( ValType ValType ) new StackValue .Val2
      return
      3 case
        $ 0 [] $1 1 [] >>$ 2 [] ( ValType ValType ValType ) new StackValue .Val3
      return
      default ..drop
        StackValue .Reference return
      break
    end
  else $ typeContext types.isUnionLike _if
    StackValue .Empty
      >$ typeContext types.compositeElts for
        pos program toValTypes StackValue.unionMerge
      end
    return
  end
  ## TODO support array values
  "cannot determine ValType of " sb.copyPtr
    >$ typeContext sb.appendType
  pos errors appendError
  StackValue .Reference return
end
proc(
  Type : expectedType ## expected type of value
  FilePosition ptr : pos
  ConverterContext ptr.mut : context
-> ) =>: decayReference
  context [] .program =:: program
  program .errors =:: errors
  program .idContext .typeContext =:: typeContext
  context .stack branchTree.peek .else
    "stack-underflow" sb.copyPtr pos errors appendError return
  end [] .Reference ? if
    expectedType pos program toValTypes switch
      Reference case return ## nothing to do
      Empty case
        "unimplemented: deref val0" ..panic ## -> generate drop operation
      break
      Value .case
        "unimplemented: deref" ..panic
      break
      Val2 .case
        "unimplemented: deref val2" ..panic
      break
      Val3 .case
        "unimplemented: deref val3" ..panic
      break
    end
  end
end
struct( i32 : start i32 : count ) =:: ElementSlotInfo
proc( Type : valType i32 : index FilePosition ptr : pos ProgramContext ptr.mut : program -> ElementSlotInfo  ) =>: findTupleElementSlots
  program .errors =:: errors
  program .idContext .typeContext =:: typeContext
  0
    index 0 != if
      index 1 - for
        valType >$ typeContext types.compositeGetElement <unwrap> pos program toValTypes StackValue.slots +
      end
    end
  valType index typeContext types.compositeGetElement <unwrap> pos program toValTypes StackValue.slots
  ElementSlotInfo new return
end
proc( Type : valType NestedElementPath : path FilePosition ptr : pos ProgramContext ptr.mut : program -> ElementSlotInfo  ) =>: findNestedTupleElementSlots
  ## proc( type : auto: C NestedElementPath ( i32 C -> ) ptr : f C : c -> ) : forEach
  "nested element slots" ..panic
end
proc( LIROp list i32 : count FilePosition ptr : pos ConverterContext ptr.mut : context -> LIROp list ) =>: dropSlots
  count pos lirDrop list.append
  count for ..drop
    context .stack branchTree.pop ? ! if
      "stack underflow" sb.copyPtr pos context [] .program .errors appendError
    end
  end
end
proc( LIROp list i32 : count FilePosition ptr : pos ConverterContext ptr.mut : context -> LIROp list ) =>: rotateSlots
  count pos lirRotate list.append
  ## TODO:! apply stack effect
end
proc( LIROp list ElementSlotInfo StackValue FilePosition ptr : pos ConverterContext ptr.mut : context -> LIROp list ) =>: setTupleSlots
  context [] .program =:: program
  switch
    Reference case ..unreachable
    Empty case
      0 pos program checkSlotCount ..drop
    return
    Value case ## <v> <0>
      $ 1 pos program checkSlotCount if ..drop return end
      .count 0 == if
       1 pos context dropSlots
      end
    return
    Val2 case ## <v> <0> <1>
      $ 2 pos program checkSlotCount if ..drop return end
      $ .count 0 == if ..drop
        2 pos context dropSlots return
      end
      $ .start 0 == if
        .count 2 == if ## <v1> <v2> <0> <1>
          2 pos context dropSlots return
        end ## <v> <0> <1>
        1 pos context rotateSlots ## <v> <1> <0>
        1 pos context dropSlots ## <v> <1>
        return
      else $ .start 1 == _if ## <v> <0> <1>
        .count 1 == "count is 1" assert ## count = 0 already handled, count > 1 excluded
        1 pos context dropSlots ## <v> <0>
        1 pos context rotateSlots ## <0> <v>
      else ..unreachable return end
    break
    Val3 case
      $ 3 pos program checkSlotCount if ..drop return end
      $ .count 0 == if ..drop
        3 pos context dropSlots return
      end
      $ .start 0 == if
        .count switch
          1 case ## <v> <0> <1> <2> -- <v> <1> <2>
            2 pos context rotateSlots ## <v> <1> <2> <0>
            1 pos context dropSlots
          return
          2 case ## <v1> <v2> <0> <1> <2> -- <v1> <v2> <2>
            -2 pos context rotateSlots ## <v1> <v2> <2> <0> <1>
            2 pos context dropSlots
          return
          3 case ## <v1> <v2> <v3> <0> <1> <2> -- <v1> <v2> <v3>
            3 pos context dropSlots return
          return
          default ..unreachable
        end
      else $ .start 1 == _if ## count is 1 or 2
        .count switch
          1 case ## <v> <0> <1> <2> -- <0> <v> <2>
            -2 pos context rotateSlots ## <v> <2> <0> <1>
            1 pos context dropSlots ## <v> <2> <0>
            -2 pos context rotateSlots ## <0> <v> <2>
          return
          2 case ## <v1> <v2> <0> <1> <2> -- <0> <v1> <v2>
            2 pos context dropSlots ## <v1> <v2> <0>
            -2 pos context rotateSlots ## <0> <v1> <v2>
          return
          default ..unreachable
        end
      else $ .start 2 == _if ## <v> <0> <1> <2> -- <0> <1> <v>
        .count 1 == "count is 1" assert ## count = 0 already handled, count > 1 excluded
        1 pos context dropSlots ## <v> <0> <1>
        2 pos context rotateSlots ## <0> <1> <v>
      else ..unreachable end
    break
  end
end
proc( ElementSlotInfo i32 FilePosition ptr : pos ProgramContext ptr.mut : program -> bool ) =>: checkSlotCount
  ## <slotsInfo> <slotCount>
  $1 .start $2 .count + $1 u> if
    "element position outside available slots (" sb.copyPtr
      >$ sb.appendI
      ") expected: ":s sb.appendStr
      $1 .start sb.appendI '(' sb.appendC >$ .count sb.appendI ')' sb.appendC
    pos program .errors appendError
    true return
  else ..drop.2 end
  false return
end

proc(
  i32 : offset
  FilePosition ptr : pos
  ConverterContext ptr.mut : context
-> ValType ) =>: popPrimitive
  context [] .program =:: program
  context .stack branchTree.peek .and .Reference ? if
    ## ! need expected type (can be guessed from data-type of built-in)
    "unimplemented: decay of primitive values" ..panic
  end
  context .stack branchTree.pop .else
    "stack undeflow" sb.copyPtr pos program .errors appendError
    ValType .BOOL return
  end [] .Value .else
    "unsupported argument for builtIn expected primitive got: " sb.copyPtr
      >$ StackValue.sbAppend
    pos program .errors appendError
    ValType .BOOL return
  end
end

proc(
  ValType ValType
  FilePosition ptr : pos
  ProgramContext ptr.mut : program
-> ) =>: checkValTypeEq
  $1 $1 != if
    "incompatible arguments for built-in: " sb.copyPtr
      >>$ ValType.sbAppend " and ":s sb.appendStr
      >$ ValType.sbAppend
    pos program .errors appendError
  else ..drop.2 end
end
proc(
  LIROp list
  LIROp.Arithmetic #+op+#
  FilePosition ptr : pos
  ConverterContext ptr.mut : context
-> LIROp list ) =>: compileUnaryArithmetic
  0 pos context popPrimitive <<$
    $2 pos lirArithmetic list.append
  context .stack >>$ StackValue .Value branchTree.push
end
proc(
  LIROp list
  LIROp.Arithmetic #+op+#
  FilePosition ptr : pos
  ConverterContext ptr.mut : context
-> LIROp list ) =>: compileBinaryArithmetic
  0 pos context popPrimitive =:: rhs
  1 pos context popPrimitive =:: lhs
  lhs rhs pos context [] .program checkValTypeEq
  lhs pos lirArithmetic list.append
  context .stack lhs StackValue .Value branchTree.push
end
proc(
  LIROp list
  CompareType #+op+#
  FilePosition ptr : pos
  ConverterContext ptr.mut : context
-> LIROp list ) =>: compileBinaryCompare
  0 pos context popPrimitive =:: rhs
  1 pos context popPrimitive =:: lhs
  lhs rhs pos context [] .program checkValTypeEq
  lhs pos lirCompare list.append
  context .stack ValType .BOOL StackValue .Value branchTree.push
end
proc(
  LIROp list
  BuiltIn #+op+#
  FilePosition ptr : pos
  ConverterContext ptr.mut : context
-> LIROp list ) =>: compileBuiltIn
  context [] .program =:: program
  switch
    ## arithmetic
    NEG_I8 NEG_I16 NEG_I32 NEG_I64 NEG_F32 NEG_F64 case
      LIROp.Arithmetic .NEG pos context compileUnaryArithmetic
    break
    ADD_I8 ADD_I16 ADD_I32 ADD_I64 ADD_F32 ADD_F64 case
      LIROp.Arithmetic .ADD pos context compileBinaryArithmetic
    break
    SUB_I8 SUB_I16 SUB_I32 SUB_I64 SUB_F32 SUB_F64 case
      LIROp.Arithmetic .SUB pos context compileBinaryArithmetic
    break
    MUL_I32 MUL_I64 MUL_F32 MUL_F64 case
      LIROp.Arithmetic .MUL pos context compileBinaryArithmetic
    break
    DIV_I32 DIV_I64 DIV_F32 DIV_F64 case
      LIROp.Arithmetic .DIV pos context compileBinaryArithmetic
    break
    REM_I32 REM_I64 case
      LIROp.Arithmetic .REM pos context compileBinaryArithmetic
    break
    UDIV_I32 UDIV_I64 case
      LIROp.Arithmetic .UDIV pos context compileBinaryArithmetic
    break
    UMOD_I32 UMOD_I64 case
      LIROp.Arithmetic .UREM pos context compileBinaryArithmetic
    break
    ## TODO: mixed division (? should mixed division be a low-level built-in
    ## DIV_I64I32 REM_I64I32 UDIV_I64I32 UMOD_I64I32
    NOT_BOOL case
      LIROp.Arithmetic .NOT pos context compileUnaryArithmetic
    break
    FLIP_I8 FLIP_I16 FLIP_I32 FLIP_I64 case
      LIROp.Arithmetic .NOT pos context compileUnaryArithmetic
    break
    AND_BOOL AND_I8 AND_I16 AND_I32 AND_I64 case
      LIROp.Arithmetic .AND pos context compileBinaryArithmetic
    break
    OR_BOOL OR_I8 OR_I16 OR_I32 OR_I64 case
      LIROp.Arithmetic .OR pos context compileBinaryArithmetic
    break
    XOR_BOOL XOR_I8 XOR_I16 XOR_I32 XOR_I64 case
      LIROp.Arithmetic .XOR pos context compileBinaryArithmetic
    break
    ## LSHR_I8 LSHR_I16 LSHR_I32 LSHR_I64I32 LSHR_I64
    ## ASHR_I8 ASHR_I16 ASHR_I32 ASHR_I64I32 ASHR_I64
    ## SHL_I8 SHL_I16 SHL_I32 SHL_I64I32 SHL_I64
 ## comparison
    EQ_BOOL EQ_I8 EQ_I16 EQ_I32 EQ_I64 EQ_F32 EQ_F64 case
      CompareType .EQ pos context compileBinaryCompare
    break
    NE_BOOL NE_I8 NE_I16 NE_I32 NE_I64 NE_F32 NE_F64 case
      CompareType .NE pos context compileBinaryCompare
    break
    LT_I8 LT_I16 LT_I32 LT_I64 LT_F32 LT_F64 case
      CompareType .LT pos context compileBinaryCompare
    break
    LE_I8 LE_I16 LE_I32 LE_I64 LE_F32 LE_F64 case
      CompareType .LE pos context compileBinaryCompare
    break
    GE_I8 GE_I16 GE_I32 GE_I64 GE_F32 GE_F64 case
      CompareType .GE pos context compileBinaryCompare
    break
    GT_I8 GT_I16 GT_I32 GT_I64 GT_F32 GT_F64 case
      CompareType .GT pos context compileBinaryCompare
    break
    ULT_I8 ULT_I16 ULT_I32 ULT_I64 case
      CompareType .ULT pos context compileBinaryCompare
    break
    ULE_I8 ULE_I16 ULE_I32 ULE_I64 case
      CompareType .ULE pos context compileBinaryCompare
    break
    UGE_I8 UGE_I16 UGE_I32 UGE_I64 case
      CompareType .UGE pos context compileBinaryCompare
    break
    UGT_I8 UGT_I16 UGT_I32 UGT_I64 case
      CompareType .UGT pos context compileBinaryCompare
    break
    .default
      "unsupported builtIn: " sb.copyPtr
        >$ sb.appendBuiltIn
      pos program .errors appendError
    break
  end
end

proc(
  LIROp list
  SignType : signType
  Type : src
  Type : dst
  FilePosition ptr : pos
  ConverterContext ptr.mut : context
-> LIROp list ) =>: compileCast
  context [] .program =:: program
  program .errors =:: errors
  program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .nameContext =:: nameContext
  src typeContext types.unwrapNamed =:: shadow: src
  dst typeContext types.unwrapNamed =:: shadow: dst
  src dst types.typeEquals if return end
  ## TODO? number-like Ctypes should also match isNumberOrPointer
  ## ? isNumberLike -> Number or Pointer or CType-number or Enum
  src typeContext types.isNumberOrPointer and dst typeContext types.isNumberOrPointer if
    src pos program toValTypes .Value .else
      "expected int or pointer to be Value type" ..panic
    end
      dst pos program toValTypes .Value .else
        "expected int or pointer to be Value type" ..panic
      end
    $1 $1 == if ..drop.2 return end ## same val type -> no change necessary
    $1 ValType.isPointer if ## src is pointer
      $ ValType.isPointer if ## both are pointers
        pos lirTransmute list.append ## transmute src to dst
        return
      else
        >>$ $2 ValType.I_SIZE pos lirTransmute list.append <<$ ## transmute src to iSize
      end
    end
    $ ValType.isPointer if
      $ <<<$ ## <dst> <elts> <src> <dst>
      signType .UNSIGNED pos lirConvert list.append ## cast int-value
      ValType.I_SIZE >>$ pos lirTransmute list.append ## transmute int to ptr
    else
      signType .UNSIGNED pos lirConvert list.append
    end
    return
  end
  "unimplemented: cast" ..panic
end

proc(
  LIROp list
  Operation : mut: op
  ConverterContext ptr.mut : context
-> LIROp list ) =>: compileOp
  context [] .program =:: program
  program .errors =:: errors
  program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .nameContext =:: nameContext
  ## TODO: bring switch-branches in reasonable order
  op .val switch
    NOP case return ## ignore no-ops
    Constant .case =:: constVal
      op .dataType op .pos program toValTypes
        context .stack $1 branchTree.push
      switch
        Reference case
          constVal op .dataType op .pos program lirConstRef list.append
        return
        Empty case return
        Value .case
          constVal >$ op .pos program lirConst list.append
        return
        Val2 .case
          constVal .Array .if
            $ .length 2 != if
              "unsupported constant for Val2 expected Array length 2 got: " sb.copyPtr
                constVal typeContext sb.appendConstant
              op .pos errors appendError
              ..drop.2 return
            end
            >>$
              $1 0 [] $3 .0 op .pos program lirConst list.append
              >$ 1 [] >>$ .1 op .pos program lirConst list.append
            return
          else
            "unsupported constant for Val2 expected Array got: " sb.copyPtr
              constVal typeContext sb.appendConstant
            op .pos errors appendError
            ..drop.2 return
          end
        break
        Val3 .case
          constVal .Array .if
            $ .length 3 != if
              "unsupported constant for Val3 expected Array length 3 got: " sb.copyPtr
                constVal typeContext sb.appendConstant
              op .pos errors appendError
              ..drop.2 return
            end
            >>$
              $1 0 [] $3 .0 op .pos program lirConst list.append
              $1 1 [] $3 .1 op .pos program lirConst list.append
              >$ 2 [] >>$ .2 op .pos program lirConst list.append
            return
          else
            "unsupported constant for Val3 expected Array got: " sb.copyPtr
              constVal typeContext sb.appendConstant
            op .pos errors appendError
            ..drop.2 return
          end
        break
      end
    break
    EndProc case op .pos lirEndProc list.append return
    ## TODO: move panic handler to standard libary
    PanicWithMessage .case op .pos lirPanic list.append return
    ProcPtr .case ## push value
      context .stack ValType .FPTR StackValue .Value branchTree.push
      op .pos lirProcPtr list.append return
    break
    Cast .case
      $ .signType >$ .src op .dataType op .pos context compileCast
    return
    Cast! .case
      SignType .NONE >$ op .dataType op .pos context compileCast
    return
    AutoCast .case
      ## TODO: add rotations to ensure cast value is on top of stack
      ##  1. rotate 2. remember op-count 3. cast 4. if op-count > old-op-count: rotate back else remove rotate
      SignType .NONE >$ .src op .dataType op .pos context compileCast
    return
    BitCast case
      "unimplemented: BitCast" ..panic
      op list.append return
    break
    Switch case
      op .dataType op .pos context decayReference
      ## TODO: update branches
      "unimplemented: switch" ..panic
      op list.append return
    break
    BuiltIn .case
      op .pos context compileBuiltIn
    return
    StackMod .case $ .modType switch
        DROP case
          0
            >$ .n for ..drop
              context .stack branchTree.pop .if
                [] StackValue.slots +
              end
            end
          op .pos lirDrop list.append
        return
        COPY case .n
          0 =:: mut: eltCount
          ## count slots above duplicated eleemnt
          context .stack branchTree.itr.start
            while $1 0 != do
              branchTree.itr.next [] StackValue.slots eltCount + eltCount=
            finally >$ 1 - <$ end >$ ..drop ## copy-count
          branchTree.itr.next [] StackValue.slots >$ ..drop ## itr
            eltCount $1 1 - + eltCount=
          for ..drop
            eltCount op .pos lirCopy list.append ## copy all elements seperately
          end
        return
        ROTATE case .n
            $ 0 < =:: flip
          i32.abs
          0 =:: mut: eltCount
          ## count slots above duplicated element
          context .stack branchTree.itr.start
            while $1 0 != do
              branchTree.itr.next [] StackValue.slots eltCount + eltCount=
            finally >$ 1 - <$ end >$ ..drop ## copy-count
          branchTree.itr.next [] StackValue.slots >$ ..drop ## itr
            eltCount $1 + 1 - flip if -_ end eltCount=
          switch
            0 case return
            1 case eltCount op .pos lirRotate list.append return
            2 case eltCount op .pos lirRotate2 list.append return
            3 case eltCount op .pos lirRotate3 list.append return
            default "unxpected slot-count for value" ..panic
          end
        break
      end
    break
    AtId .case =:: idInfo
      "unimplemented: atId" ..panic
      context .stack ValType .PTR StackValue .Value branchTree.push
        op list.append
      return
    break
    GetId SetId .case .nameId
      op .dataType op .pos program toValTypes
        op .val .GetId ? if
          context .stack $1 branchTree.push
        else
          op .dataType op .pos context decayReference
          context .stack branchTree.pop .if
            ..drop ## TODO? verify that source and target value match
          end
        end
      switch
        Empty case ..drop return
        Value .case
          op .pos op .val .GetId ? if
            lirGetLocal
          else
            lirSetLocal
          end list.append ## element access on value-type
        return
        Val2 .case ... ## <elts> <name> <0> <1>
          op .val .GetId ? if
            $2 >>$ op .pos lirGetLocal ## <elts> <name> <1> <get0>
            >>>$ >$ list.append <<$ ## <elts> <name> <1>
            op .pos lirGetLocal2 list.append
          else ## <elts> <name> <0> <1>
            $2 >$ op .pos lirSetLocal2 ## <elts> <name> <0> <set1>
            >>>$ >$ list.append <<$ ## <elts> <name> <0>
            op .pos lirSetLocal list.append
          end
        return
        Val3 .case ... ## <elts> <name> <0> <1> <2>
          op .val .GetId ? if
            $3 >>>$ op .pos lirGetLocal ## <elts> <name> <1> <2> <get0>
            >>>>$ >$ list.append <<<$ ## <elts> <name> <1> <2>
            $2 >>$ op .pos lirGetLocal2 ## <elts> <name> <2> <get1>
            >>>$ >$ list.append <<$ ## <elts> <name> <2>
            op .pos lirGetLocal3 list.append
          else ## <elts> <name> <0> <1> <2>
            $3 >$ op .pos lirSetLocal3 ## <elts> <name> <0> <1> <set2>
            >>>>$ >$ list.append <<<$ ## <elts> <name> <0> <1>
            $2 >$ op .pos lirSetLocal2 ## <elts> <name> <0> <set1>
            >>>$ >$ list.append <<$ ## <elts> <name> <0>
            op .pos lirSetLocal list.append
          end
        return
        Reference case break
      end op .pos lirAtLocal list.append
        op .val .SetId ? if
          op .dataType typeContext LIROp.MemorySize.fromType .else
            "unimplemented: dynamic sized values" ..panic
          end op .pos lirMemCopy list.append
        end
      return
    break
    GetElement .case =:: index
      op .dataType typeContext types.ptrTarget
        $ ? =:: isPtr
      .else op .dataType op .pos program toValTypes .Reference ._if ..drop
        op .dataType
      else ## get by value
        op .dataType typeContext types.isTupleLike if
          op .dataType index op .pos program findTupleElementSlots
          >$ switch
            Reference case ..unreachable
            Empty case
              0 op .pos program checkSlotCount ..drop
            return
            Value case
              $ 1 op .pos program checkSlotCount if ..drop return end
              .count 0 == if
               1 op .pos context dropSlots
              end
            return
            Val2 case
              $ 2 op .pos program checkSlotCount if ..drop return end
              $ .count 0 == if ..drop
                2 op .pos context dropSlots return
              end
              $ .start 0 == if
                .count 2 == if return end
                1 op .pos context dropSlots return
              else $ .start 1 == _if
                .count 1 == "count is 1" assert ## count = 0 already handled, count > 1 excluded
                1 op .pos context rotateSlots ## <0>
                1 op .pos context dropSlots ## <1>
              else ..unreachable end
            return
            Val3 case
              $ 3 op .pos program checkSlotCount if ..drop return end
              $ .count 0 == if ..drop
                3 op .pos context dropSlots return
              end
              $ .start 0 == if
                .count 3 >$ -
                  $ 0 == if ..drop return end
                op .pos context dropSlots return
              else $ .start 1 == _if ## count is 1 or 2
                >$ 2 op .pos context rotateSlots ## <1> <2> <0>
                >$ .count 3 >$ - op .pos context dropSlots
              else $ .start 2 == _if
                .count 1 == "count is 1" assert ## count = 0 already handled, count > 1 excluded
                -2 op .pos context rotateSlots ## <2> <0> <1>
                2 op .pos context dropSlots ## <2>
              else ..unreachable end
            return
          end
        else op .dataType typeContext types.isUnionLike _if
          "unimplemented: union-element access" ..panic
        else op .dataType typeContext types.isArray _if
          "unimplemented: array-element access" ..panic
        else ..drop
          "unsupported type for element access: " sb.copyPtr
            op .dataType typeContext sb.appendType
          op .pos errors appendError
          return
        end
      end index op .pos typeContext applyElementOffset =:: eltType
        isPtr ! if
          ## TODO delayed dereferencing of value-types
          ## -> keep using pointer ops for element-access, deref on copy/branch/built-in
          eltType op .pos program toValTypes switch
            Empty Reference case break
            Value .case "unimplemented: load" ..panic
            Val2 Val3 case "unimplemented: multi-dererference" ..panic
          end
        end
      return
    break
    SetElement .case =:: index
      op .dataType typeContext types.ptrTarget
        $ ? =:: isPtr
      .else op .dataType op .pos program toValTypes .Reference ._if ..drop
        op .dataType
      else ## set by value
        op .dataType typeContext types.isTupleLike if
          ## TODO: decay source value
          op .dataType index op .pos program findTupleElementSlots
          >$ op .pos context setTupleSlots
          return
        else op .dataType typeContext types.isUnionLike _if
          "unimplemented: union-element access" ..panic
        else op .dataType typeContext types.isArray _if
          "unimplemented: array-element access" ..panic
        else
          "unsupported type for element access: " sb.copyPtr
            op .dataType typeContext sb.appendType
          op .pos errors appendError
          ..drop return
        end
      end
        isPtr ! if ## preserve reference on stack
          >$
            1 op .pos lirRotate list.append
            1 op .pos lirCopy list.append
          <$
        end
      index op .pos typeContext applyElementOffset
        ## TODO: extract to procedure "setElementPtr"
      op .pos program toValTypes switch
        Empty case return
        Reference case
          "unimplemented: copy-ptr" ..panic
          ##BuiltIn .COPY_PTR op .pos lirBuiltIn list.append
        return
        Value .case "unimplemented: store" ..panic
        Val2 Val3 case "unimplemented: multi-value setPtrElement" ..panic
      end
      return
    break
    SetNestedElement .case =:: path
      op .dataType typeContext types.ptrTarget
        $ ? =:: isPtr
      .else op .dataType op .pos program toValTypes .Reference ._if ..drop
        op .dataType
      else ## set by value
        op .dataType typeContext types.isTupleLike if
          ## TODO: decay source value
          op .dataType path op .pos program findNestedTupleElementSlots
          >$ op .pos context setTupleSlots
          return
        else op .dataType typeContext types.isUnionLike _if
          "unimplemented: nested set union-element" ..panic
        else op .dataType typeContext types.isArray _if
          "unimplemented: nested set array-element" ..panic
        else
          "unsupported type for element access: " sb.copyPtr
            op .dataType typeContext sb.appendType
          op .pos errors appendError
          ..drop return
        end
      end
        isPtr ! if ## preserve value on stack
          >$
            1 op .pos lirRotate list.append
            1 op .pos lirCopy list.append
          <$
        end
        ( LIROp list : ops Type : eltType ) new
          ( TypeContext ptr.mut : shadow: typeContext FilePosition ptr : pos ) =:: Curry
          path >$ @{ ## <data> <index> <curry> | <ops> <eltType>
            $2 .ops
              $3 .eltType
                >>>$ ## <data> <curry> <ops> <eltType> <index> | <pos>
                $3 .pos >>>>$ .typeContext applyElementOffset
              >>$ .eltType= ## <data> <ops> <eltType>
            .ops=
          } typeContext op .pos Curry new NestedElementPath.forEach
        $ .ops
        >$ .eltType op .pos program toValTypes switch
          Empty case return
          Reference case
            "unimplemented: copy-ptr" ..panic
            ##BuiltIn .COPY_PTR op .pos lirBuiltIn list.append
          return
          Value .case "unimplemented: store" ..panic
          Val2 Val3 case "unimplemented: multi-value setPtrElement" ..panic
        end
      return
    break
    ImplementProcedure case
      op .dataType op .pos context determineProcType
        $ .outArgCount 0 != if
          "unimplemented: handle out-args" ..panic
        end
        program ProcCallInfo.toProcType op .pos lirBeginProc list.append
        op .dataType typeContext types.getProcIn <unwrap> for
          context .stack >$ op .pos program toValTypes branchTree.push
        end
      return
    Return case
      op .dataType op .pos context determineProcType
        $ .outArgCount 0 != if
          "unimplemented: handle out-args" ..panic
        end
        program ProcCallInfo.toProcType op .pos lirReturn list.append
        ## TODO? verify return types
      return
    break
    Call CallPtr case
      op .val .Call ?? .if
        op .pos lirProcConst list.append
      end
      op .dataType
        $ typeContext types.getPointerBaseType .if >$ ..drop end
      op .pos context determineProcType
        ## TODO! (verify and) pop arguments
        $ .outArgCount 0 != if
          "unimplemented: handle out-args" ..panic
        end
        program ProcCallInfo.toProcType op .pos lirCall list.append
        ## TODO! push return values
      return
    break
    DeclareId .case =:: idInfo
      context [] .variables
        ## VariableInfo
          idInfo .nameId
          op .dataType
          VariableType .LOCAL_VAR
        VariableInfo new list.append
      context .variables=
      idInfo .nameId op .pos lirDeclare list.append
    return
    Copy case
      op .dataType op .pos program toValTypes .Reference ? ! if
        op .dataType op .pos context decayReference
        return ## no copy needed for value types
      end
      "unimplemented: Copy" ..panic
      =:: baseType
      _BACKEND_ .QBE ! if ## currently QBE cannot handle value.types
        ## TODO? move delayed dereferencing to pre-compiler
        ## ? force deref for pure int/float value + keep copy (as deref hit) if type is not simple
        baseType typeContext types.isValueType if
          return ## copy of value type is no-op
        end
      else
        baseType typeContext types.unwrapNamed types.isPrimitive or
            baseType typeContext types.isPointer if
          return ## primitive copy is no-op
        end
      end
      baseType true op .pos context newTmpVar =:: tmpId
        op .dataType baseType types.typeEquals ! if
          ## opAutoCast
            op .dataType
            0
            baseType
            op .pos
          opAutoCast list.append
        end
        baseType tmpId op .pos opDeclareId list.append
        baseType typeContext types.isValueType ! if ## when _QBE_VAL_TYPES_ is false baseType this can be a non-value type
          baseType tmpId op .pos opAtId list.append
          baseType BuiltIn .COPY_PTR op .pos opBuiltIn list.append
          baseType tmpId op .pos opAtId list.append
        else
          baseType tmpId op .pos opSetId list.append
          baseType tmpId op .pos opGetId list.append
        end
      return
    New NewUnion case
      op .dataType op .pos program toValTypes switch
        Empty case return
        Reference case break
        Value Val2 Val3 case
          op .val .New ? if
            ## TODO! decay references
            return ## struct by value only regroups exisiting ValTypes
          else
            "unimplemented: union by value" ..panic
          end
        break
      end
      "unimplemented: New" ..panic
      op .dataType typeContext types.isValueType if
        op list.append return
      end
      op .dataType true op .pos context newTmpVar =:: tmpId
        ## opDeclareId
          op .dataType
          tmpId
          op .pos
        opDeclareId list.append
        ## opAtId
          op .dataType
          tmpId
          op .pos
        opAtId list.append
        op .val .NewUnion .if =:: index
          1 StackModType .ROTATE op .pos opStackMod list.append
          1 StackModType .COPY op .pos opStackMod list.append
          op .dataType index op .pos typeContext applyElementOffset
            $ typeContext types.isValueType if
              BuiltIn .SET_PTR
            else
              BuiltIn .COPY_PTR
            end
          op .pos opBuiltIn list.append
        else ..drop op .dataType typeContext types.isTuple or op .dataType typeContext types.isTaggedUnion _if
          op .dataType typeContext types.compositeEltCount while $ 1 - <$ 0 != do =:: index
            1 StackModType .ROTATE op .pos opStackMod list.append
            1 StackModType .COPY op .pos opStackMod list.append
            op .dataType index op .pos typeContext applyElementOffset
              $ typeContext types.isValueType if
                BuiltIn .SET_PTR
              else
                BuiltIn .COPY_PTR
              end
            op .pos opBuiltIn list.append
          finally index end ..drop
        else op .dataType typeContext types.isArray _if
          0 StackModType .COPY op .pos opStackMod list.append
          op .dataType BuiltIn .CLEAR_PTR op .pos opBuiltIn list.append
        else
          0 sb.create
            op .dataType typeContext sb.appendType
          sb.asStr io.println
          "unexpected type for new" ..panic
        end
      return
    LocalLabel .case =:: labelInfo
      labelInfo .labelType switch
        HINT_START HINT_END case
          ## move mergable operation after start hint
          $ list.peek .and .data .Compare ? if
            list.pop optional.unwrap =:: tmp
            labelInfo op .pos lirLabel list.append
            tmp list.append
            return
          end
        break
        LABEL_START LABEL_MIDDLE LABEL_END case break
      end
      labelInfo op .pos lirLabel list.append
    return
    LocalJump .case =:: jumpInfo
      jumpInfo .cmpType .NONE ! if
        ## pop jump condition
        0 op .pos context popPrimitive $ .BOOL ! if
          "expected bool got: " sb.copyPtr
            >$ ValType.sbAppend
          op .pos errors appendError
        else ..drop end
      end
      ## fuse compare+jumpif
      jumpInfo .labelId jumpInfo .cmpType
        $ .TRUE or $ .FALSE if
          $2 list.peek .and .data .Arithmetic .and $ .val [] .NOT >$ .valType [] .BOOL & if
            >>$ list.pop ..drop <<$
            .TRUE if CompareType .FALSE else CompareType .TRUE end ValType .BOOL
          else _BACKEND_ .ASM and $2 list.peek .and .data .Compare ? _if
            >>$ list.pop .and .data .Compare .else ..unreachable end
            >$ <<<$ ## jmpDst cmpType list cmpOp -- list jmpDst cmpType cmpOp
            mergeJumpIf
          else ValType .BOOL end
        else ValType .BOOL end op .pos lirJump list.append
    return
    CompilerInfo case return ## TODO? preserve compilerInfo ops
    ConstantReference Error case
      break ## unsupported
  end
  "unsupported operation " sb.copyPtr
    op program sb.appendOp
  op .pos errors appendError
  return
end

proc(
  Operation slice.mut : mut: oldOps
  LIROp list ptr.mut : tmpOps
  VariableInfo list ptr.mut : variables
  ConverterContext ptr.mut : context
-> LIROp slice.mut ) =>: convertProc
  context [] .program =:: program
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .nameContext =:: nameContext
  variables [] context .variables=
  tmpOps []
    $ .length =:: codeStart
    oldOps for
      context compileOp
    end
    $ list.asSlice codeStart slice.tail slice.copy =:: newCode
    oldOps slice.free oldOps=
  tmpOps =[]
  context [] .variables variables =[]
  context .outArgNames [] slice.free context .outArgNames=
  newCode
end

## TODO better name for file&procedure, find good description of compilation-step
proc( ProgramContext ptr.mut : program -> ) =>: export: prepareCompile2
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .nameContext =:: nameContext
  ## ConverterContext
    program
    0 VariableInfo list.create
    StackValue branchTree.create
    NameId optional slice.emptyMutable
    Type optional.empty
    -1:FileId
    false
  ConverterContext new =:: mut: contextData
  contextData@ =:: context
  program [] .globalOps list.clear program .globalOps= ## global ops are no longer needed
  LIROp list.empty =:: mut: tmpOps
  program [] .procedures for ProcId.getProcInfo =:: currentProc
    currentProc [] .flags ProcFlags.IS_STATIC ProcFlags.HAS_STATIC_ARG | & ? if continue end
    currentProc .implementation .Code .else ..drop
      continue
    end =:: impl
    impl .codeState [] .TypeChecked .else ..drop
      continue
    end =:: procCode
    tmpOps list.clear tmpOps=
    currentProc [] .fileId context .currentFile=
    program [] .progFiles
      currentProc [] .fileId i64 cast
    @[] =:: f
    ## convertProc
      procCode
      tmpOps@
      impl .variables
      context
    convertProc impl .codeState .PreCompiled2=
  end
  tmpOps list.free ..drop
  context .stack branchTree.free
end
