#+
common code for code generators
+#
import map

import "program.concat"
import "types.concat"

proc(
  Type : declared
  i32 : ptrLevel
  FilePosition ptr : pos
  ProgramContext ptr.mut : prog
  Type i32 hashMap ptr.mut : visited
  Type list ptr.mut : types
-> ) =>: declaredType
  prog .errors =:: errors
  prog .idContext .typeContext =:: typeContext
  visited declared map.at .if []
    ptrLevel == if
      0 sb.create
        declared prog .idContext .typeContext sb.appendType
        "! \n" sb.appendS
      pos errors appendError
    end
    return
  end
  visited declared ptrLevel map.put ..drop
  declared switch
    Undefined Empty PrimitiveType GenericType CType IntLiteral Align case
      break
    Pointer MutablePointer RawPointer MutableRawPointer case
      declared typeContext types.getBaseType ptrLevel 1 + pos prog visited types declaredType
      types []
        declared list.append
      types =[]
      break
    ArrayType case
      declared typeContext types.getBaseType ptrLevel pos prog visited types declaredType
      types []
        declared list.append
      types =[]
      break
    Enum case
      types []
        declared list.append
      types =[]
      break
    Struct TaggedUnion RawUnion Initializer case
      declared typeContext types.compositeElts =:: elts
      elts for
        ptrLevel pos prog visited types declaredType
      end
      types []
        declared list.append
      types =[]
      break
    UnionElement case
      declared typeContext types.getBaseType ptrLevel pos prog visited types declaredType
      types []
        declared list.append
      types =[]
      break
    Procedure case
      declared typeContext types.getProcIn optional.unwrap for
        ptrLevel pos prog visited types declaredType
      end
      declared typeContext types.getProcOut optional.unwrap for
        ptrLevel pos prog visited types declaredType
      end
      ## don't add procedure type to list of declared types
      ## type declaration of proc-pointer will be covered by surrounding pointer type
      break
    NamedType case
      declared typeContext types.unwrapNamed ptrLevel pos prog visited types declaredType
      types []
        declared list.append
      types =[]
    break
    GeneratedType case
      declared typeContext types.getGeneratedType ptrLevel pos prog visited types declaredType
      types []
        declared list.append
      types =[]
    break
    SetType RefinementType case
      declared typeContext types.unwrapRefinement ptrLevel pos prog visited types declaredType
    break
  end
  -1 visited declared map.at optional.unwrap =[] ## finished declaration
end

proc( Operation ptr : op ProgramContext ptr.mut : prog Type i32 hashMap ptr.mut : visited Type list ptr.mut : types -> ) =>: addOpType
  op [] .val switch
    InitializeId DeclareId ImplementProcedure Cast Cast! New TypeInfo Constant
    NewUnion NewReference NewUnionReference ConstantReference case
      op [] .dataType 0 op [] .pos prog visited types declaredType
    break
    default break
  end
end

proc( ProgramContext ptr.mut : prog -> Type list ) =>: export: getDeclaredTypes
  types.typeHash@ types.typeEquals@ 128 i32 map.create =:: mut: visited ## XXX start with power of two closest to total type count as capacity
  128 Type list.create =:: mut: types
  prog .idContext =:: idContext
  ## TODO find better way to iterate through all global variables
  idContext .identifierNames map.itr.start while map.itr.hasNext do map.itr.next
    =:: declaration ## XXX find out which declarations are actually used
    declaration .1 [] .aliasId id.NO_ALIAS != if continue end
    declaration .1 [] .labelId =:: labelId
    labelId idContext id.getIdentifier
      ! "identifier exists" assert
    =:: idData
    idData [] .idType .GLOBAL_VAR ! if
      continue
    end
    idData [] .valueType 0 idData [] .declaredAt prog visited@ types@ declaredType
  end ..drop
  prog [] .globalOps for =:: op
    op@ prog visited@ types@ addOpType
  end
  prog [] .procedures for ProcId.getProcInfo =:: proc
    proc .implementation .Code .else
      ..drop continue
    end =:: impl
    impl .codeState [] .UNUSED if continue end
    impl .codeState [] .COMPILED if
      impl [] .code for =:: op
        op@ prog visited@ types@ addOpType
      end
    end
  end
  visited@ map.free
  types return
end
