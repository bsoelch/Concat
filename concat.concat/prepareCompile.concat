#+
converts code from pure stack code to code targeting a "real" machine as a
common first step for all compiler back-ends:
* limit size of stack-values
* explicitly create temporary variables for copy/output arguments
+#
'arenaAlloc' import

"program" import
"measure" import
"branchTree" import
using id.IdentifierFlag

struct(
  ProgramContext ptr.mut : program
  VariableInfo list : variables
  NameId optional slice.mut : outArgNames
  Type optional : currentProcType
  FileId : currentFile
  bool : reachable
) =:: ConverterContext

proc(
  Type : varType
  bool : mutable
  FilePosition ptr : pos
  ConverterContext ptr.mut : context
-> IdentifierInfo ) =>: newTmpVar ## TODO? merge with id.newTmpVar
  context [] .program .idContext =:: idContext
  idContext .typeContext .nameContext =:: nameContext
  id.FLAG_NONE mutable if
    id.FLAG_MUTABLE | IdentifierFlag cast
  end =:: flags
  ## newIdentifier
    flags ## TODO? special flag for tmp vars
    pos
    nameContext
  id.newTmpIdentifier =:: nameId
  nameId varType pos idContext id.declareTmpVar
  context [] .variables
    nameId varType VariableType .TMP_VAR VariableInfo new list.append
  context .variables=
  ## IdInfo
    nameId
    IdentifierType .TMP_VAR false
  IdentifierInfo new return
end

proc( BuiltIn -> bool ) =>: canMergeJumpIf
  BuiltIn ..length 221 == "no new builtins" assert
  switch
    NOT_BOOL ## !
    EQ_BOOL EQ_I8 EQ_I16 EQ_I32 EQ_I64 EQ_F32 EQ_F64 ## ==
    NE_BOOL NE_I8 NE_I16 NE_I32 NE_I64 NE_F32 NE_F64 ## !=
    LT_I8 LT_I16 LT_I32 LT_I64 LT_F32 LT_F64 ## <
    LE_I8 LE_I16 LE_I32 LE_I64 LE_F32 LE_F64 ## <=
    GE_I8 GE_I16 GE_I32 GE_I64 GE_F32 GE_F64 ## >=
    GT_I8 GT_I16 GT_I32 GT_I64 GT_F32 GT_F64 ## >
    ULT_I8 ULT_I16 ULT_I32 ULT_I64           ## u<
    ULE_I8 ULE_I16 ULE_I32 ULE_I64           ## u<=
    UGE_I8 UGE_I16 UGE_I32 UGE_I64           ## u>=
    UGT_I8 UGT_I16 UGT_I32 UGT_I64           ## u>
    case true return
    default false return
  end
end
proc( CompareType -> CompareType ) =>: adjustFlippedFloatCmpType
  switch
    EQ case CompareType .EQ break
    NE case CompareType .NE break
    LT case CompareType .ULT break
    LE case CompareType .ULE break
    GE case CompareType .UGE break
    GT case CompareType .UGT break
    default "unexpected compare-type for float" ..panic
  end
end
proc( CompareType : cmpType BuiltIn : builtIn -> CompareType Type ) =>: mergeJumpIf
  cmpType .FALSE or cmpType .TRUE end "can only merge cmp.true and cmp.false" assert
  cmpType .FALSE =:: flip
  BuiltIn ..length 221 == "no new builtins" assert
  builtIn switch
    NOT_BOOL case
      flip if CompareType .TRUE else CompareType .FALSE end
    break
    EQ_BOOL EQ_I8 EQ_I16 EQ_I32 EQ_I64 EQ_F32 EQ_F64 case
      flip if CompareType .NE else CompareType .EQ end
    break
    NE_BOOL NE_I8 NE_I16 NE_I32 NE_I64 NE_F32 NE_F64 case
      flip if CompareType .EQ else CompareType .NE end
    break
    LT_I8 LT_I16 LT_I32 LT_I64 LT_F32 LT_F64 case
      flip if CompareType .GE else CompareType .LT end
    break
    LE_I8 LE_I16 LE_I32 LE_I64 LE_F32 LE_F64 case
      flip if CompareType .GT else CompareType .LE end
    break
    GE_I8 GE_I16 GE_I32 GE_I64 GE_F32 GE_F64 case
      flip if CompareType .LT else CompareType .GE end
    break
    GT_I8 GT_I16 GT_I32 GT_I64 GT_F32 GT_F64 case
      flip if CompareType .LE else CompareType .GT end
    break
    ULT_I8 ULT_I16 ULT_I32 ULT_I64 case
      flip if CompareType .UGE else CompareType .ULT end
    break
    ULE_I8 ULE_I16 ULE_I32 ULE_I64 case
      flip if CompareType .UGT else CompareType .ULE end
    break
    UGE_I8 UGE_I16 UGE_I32 UGE_I64 case
      flip if CompareType .ULT else CompareType .UGE end
    break
    UGT_I8 UGT_I16 UGT_I32 UGT_I64 case
      flip if CompareType .ULE else CompareType .UGT end
    break
    default "unsupported built-in for jump-merge" ..panic
  end
  builtIn switch
    EQ_BOOL NE_BOOL case types.primitive.BOOL break
    EQ_I8 NE_I8 LT_I8 LE_I8 GE_I8 GT_I8 ULT_I8 ULE_I8 UGE_I8 UGT_I8 case
      types.primitive.I8 break
    EQ_I16 NE_I16 LT_I16 LE_I16 GE_I16 GT_I16 ULT_I16 ULE_I16 UGE_I16 UGT_I16 case
      types.primitive.I16 break
    EQ_I32 NE_I32 LT_I32 LE_I32 GE_I32 GT_I32 ULT_I32 ULE_I32 UGE_I32 UGT_I32 case
      types.primitive.I32 break
    EQ_I64 NE_I64 LT_I64 LE_I64 GE_I64 GT_I64 ULT_I64 ULE_I64 UGE_I64 UGT_I64 case
      types.primitive.I64 break
    EQ_F32 NE_F32 LT_F32 LE_F32 GE_F32 GT_F32 case
      flip if adjustFlippedFloatCmpType end
      types.primitive.F32 break
    EQ_F64 NE_F64 LT_F64 LE_F64 GE_F64 GT_F64 case
      flip if adjustFlippedFloatCmpType end
      types.primitive.F64 break
    default "unsupported built-in for jump-merge" ..panic
  end
end
## TODO? merge built-ins: `compare + not` -> `compare`, `and + 0 eq/ne` -?> `bit-test`

proc( Operation list
  i64 : offset
  FilePosition ptr : pos
-> Operation list ) =>: offsetPointer
  offset 0 == if return end ## no offset -> no change
  ## merge chained (constant) pointer offset
  $ list.peek .and .val .BuiltIn .and .OFFSET_PTR and
      $ $ .length 2 - list.at .and .val .Constant .and .Int .if [] =:: prev_offset
    $ .length 2 - list.setLength ## discard previous operations
    offset prev_offset + ConstValue .Int types.I_SIZE pos opConst list.append
  else
    offset ConstValue .Int types.I_SIZE pos opConst list.append
  end
  Type .Empty BuiltIn .OFFSET_PTR pos opBuiltIn list.append
end
proc( Operation list
  Type : refBase
  i32 : index
  FilePosition ptr : pos
  TypeContext ptr.mut : typeContext
-> Operation list Type ) =>: applyElementOffset
  refBase index typeContext types.tupleElementOffset .if =:: offset
    offset pos offsetPointer
      refBase index typeContext types.compositeGetElement optional.unwrap
    return
  else refBase typeContext types.isRawUnion _if
    ## no pointer change needed
      refBase index typeContext types.compositeGetElement optional.unwrap
    return
  else refBase typeContext types.getArrayBaseType ._if =:: arrayBase
    arrayBase typeContext types.strideOf .Fixed .else
      "array-element not fixed-sized" ..panic
    end =:: eltSize
    index i64 cast.u eltSize * pos offsetPointer
      arrayBase
    return
  else
    "unsupported type for get-element" ..panic
  end
end

union( Operation list ptr.mut : Call Operation list ptr.mut : CallPtr _ : Impl ) =:: ProcSignatureType
proc( Type : calledType ProcSignatureType : procType FilePosition ptr : pos ConverterContext ptr.mut : context -> Type NameId optional slice ) =>: updateProcType
  context [] .program =:: program
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .nameContext =:: nameContext
  calledType typeContext types.getProcIn .else "proc without in" ..panic end =:: args
  calledType typeContext types.getProcArgNames =:: argNames
  calledType typeContext types.getProcOut .else "proc without out" ..panic end =:: outTypes
  false =:: mut: needNewArgs
  false =:: mut: needNewOutTypes
  ## TODO: reuse lists
  NameId optional list.empty =:: mut: newArgNames
  Type list.empty
    args .length for =:: index
      args index [] =:: arg
      ## ignore static and empty arguments
      arg typeContext types.isEmpty or argNames index slice.get .and .and id.identifierFlags id.FLAG_STATIC & ? if
        needNewArgs ! if
          args index slice.head list.appendSlice
          procType .Impl ? if
            newArgNames argNames index slice.head list.appendSlice newArgNames=
          end
        end
        true needNewArgs=
        continue
      end
      needNewArgs and procType .Impl ? if
        argNames index slice.get .if newArgNames >$ list.append newArgNames= end
      end
      arg typeContext types.isValueType if
        needNewArgs if arg list.append end
        continue
      end
      needNewArgs ! if
        args index slice.head list.appendSlice
        procType .Impl ? if
          newArgNames argNames index 1 + slice.head list.appendSlice newArgNames=
        end
      end
      true needNewArgs=
      arg true typeContext types.getAddressType =:: argType
      argType list.append
      argNames index slice.get .and .if =:: argName
        argName id.FLAG_IS_REFERENCE id.addIdentifierFlags
        argType argName idContext id.getIdData .else "arg has data" ..panic end .valueType=
      end
    end
  =:: mut: newArgs
  program .nameBuffer [] .length =:: nameOffset
  Type list.empty
    outTypes .length for =:: index
      outTypes index [] =:: outType
      outType typeContext types.isEmpty if
        needNewOutTypes ! if outTypes index slice.head list.appendSlice end
        true needNewOutTypes=
        continue
      end
      outType typeContext types.isValueType and index outTypes .length 1 - == or _BACKEND_ .QBE ! if
        needNewOutTypes if outType list.append end
        continue
      end
      needNewOutTypes ! if outTypes index slice.head list.appendSlice end
      true needNewOutTypes=
      outType true typeContext types.getAddressType =:: outArgType
      ## TODO merge try mergining location with first or last argument
      ##  ? merge first n in args with first n out-args if all match (! how to savely handle ( A A -> A A ) [values may be swapped before return needing value data swap] )
      _BACKEND_ .QBE ! if
        outArgType list.append
      end
      ## TODO! should all out-args be passed before the real proc args (! backend used reveresd arg-order for c-procs)
      newArgs
        needNewArgs ! if
          args list.appendSlice 
          procType .Impl ? if
            newArgNames
              argNames list.appendSlice
            newArgNames=
          end
        end
        procType .Impl ? and $ .length newArgNames .length u> if
          newArgNames
            $1 .length $1 .length - for ..drop NameId optional.empty list.append end
          newArgNames=
        end
        true needNewArgs=
        outArgType list.append
      newArgs=
      outType true pos context newTmpVar =:: tmpId
      procType switch
        Call CallPtr .case
          $ []
            ## opDeclareId
              outType
              tmpId
              pos
            opDeclareId list.append
            ## opAtId
              outType
              tmpId
              pos
            opAtId list.append
            procType .CallPtr ? if
              1 StackModType .ROTATE pos opStackMod list.append
            end
          >$ =[]
          tmpId .nameId
        break
        Impl case ## don't use newTmpVar to avoid adding to proc-variables twice
          id.FLAG_NONE pos nameContext id.newTmpIdentifier
          $ outArgType pos idContext id.declareTmpVar
          newArgNames
            $1 optional.wrap list.append
          newArgNames=
        break
      end
      program [] .nameBuffer
        index $1 .length - for ..drop NameId optional.empty list.append end
        >$ optional.wrap list.append
      program .nameBuffer=
    end
  =:: newOutTypes
  needNewArgs or needNewOutTypes if
    ## newProcedure
      needNewArgs if newArgs list.asSlice else args end
      needNewOutTypes if newOutTypes list.asSlice else outTypes end
      newArgNames list.asSlice
      calledType typeContext types.getCallConvention
    typeContext types.newProcedure
  else
    calledType
  end
  newArgs list.free ..drop
  newOutTypes list.free ..drop
  newArgNames list.free ..drop
  program [] .nameBuffer
    $ nameOffset list.tail <$
    nameOffset list.setLength
  program .nameBuffer=
end

proc(
  Operation list : newOps
  Operation : mut: op
  ConverterContext ptr.mut : context
-> Operation list ) =>: compileOp
  context [] .program =:: program
  program .errors =:: errors
  program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .nameContext =:: nameContext
  op .val switch
    NOP case newOps return ## ignore no-ops
    EndProc PanicWithMessage ProcPtr AutoCast Cast Cast! BitCast
        RuntimeAssert Switch BuiltIn StackMod case ## unary operation
      newOps op list.append return
    break
    AtId .case =:: idInfo
      newOps
        idInfo .nameId id.identifierFlags id.FLAG_IS_REFERENCE & ? if
          idInfo .nameId idContext id.getIdData .else "arg has data" ..panic end .valueType []
            idInfo op .pos
          opGetId list.append
        else
          op list.append
        end
      return
    break
    ## TODO vvv------vvvv do stack updates + split composites
    GetId SetId .case =:: idInfo
      op .dataType typeContext types.isValueType if
        newOps
          op list.append ## element access on value-type
        return
      end
      newOps
        idInfo .nameId id.identifierFlags id.FLAG_IS_REFERENCE & ? if
          idInfo .nameId
            idContext id.getIdData .else "arg has data" ..panic end .valueType []
          idInfo op .pos opGetId list.append
        else
          ## TODO? consistent type for atId: always var-type or always address-type?
          op .dataType idInfo op .pos opAtId list.append
        end
        op .val .SetId ? if
          op .dataType BuiltIn .COPY_PTR op .pos opBuiltIn list.append
        end
      return
    break
    GetElement .case =:: index
      op .dataType typeContext types.ptrTarget
        $ ? =:: isPtr
      .else
      op .dataType typeContext types.isValueType _if
        newOps
          op list.append ## element access on value-type
        return
      else op .dataType end =:: refBase
      newOps
        refBase index op .pos typeContext applyElementOffset =:: eltType
        isPtr ! and eltType typeContext types.isValueType if
          ## TODO? delayed dereferencing of value-types
          ## -> keep using pointer ops for element-access, deref on copy/branch/built-in
          eltType BuiltIn .GET_PTR op .pos opBuiltIn list.append
        end
      return
    break
    SetElement .case =:: index
      op .dataType typeContext types.ptrTarget
        $ ? =:: isPtr
      .else
      op .dataType typeContext types.isValueType _if
        newOps
          op list.append ## element access on value-type
        return
      else op .dataType end =:: refBase
      newOps
        isPtr ! if ## preserve value on stack
          1 StackModType .ROTATE op .pos opStackMod list.append
          1 StackModType .COPY op .pos opStackMod list.append
        end
        refBase index op .pos typeContext applyElementOffset
          $ typeContext types.isValueType if
            BuiltIn .SET_PTR
          else
            BuiltIn .COPY_PTR
          end
        op .pos opBuiltIn list.append
      return
    break
    SetNestedElement .case =:: path
      op .dataType typeContext types.ptrTarget
        $ ? =:: isPtr
      .else
      op .dataType typeContext types.isValueType _if
        newOps
          op list.append ## element access on value-type
        return
      else op .dataType end =:: mut: eltType
      newOps
        isPtr ! if ## preserve value on stack
          1 StackModType .ROTATE op .pos opStackMod list.append
          1 StackModType .COPY op .pos opStackMod list.append
        end
        ( Type ptr.mut : shadow: eltType TypeContext ptr.mut : shadow: typeContext FilePosition ptr : pos ) =:: Curry
        path >$ ( Operation list i32 : index Curry : curry -> Operation list ) =>
          curry .eltType []
            index
          curry .pos curry .typeContext applyElementOffset curry .eltType =[]
        end eltType@ typeContext op .pos Curry new NestedElementPath.forEach
        eltType
          $ typeContext types.isValueType if
            BuiltIn .SET_PTR
          else
            BuiltIn .COPY_PTR
          end
        op .pos opBuiltIn list.append
      return
    break
    ImplementProcedure case
      op .dataType ProcSignatureType .Impl op .pos context updateProcType =:: outArgNames
      outArgNames slice.copy context .outArgNames=
        $ optional.wrap context .currentProcType=
      =:: procType
      procType typeContext types.getProcIn optional.unwrap =:: args
      args .length i32 cast.u =:: argCount
      true context .reachable=
      context [] .variables
        0:i32 while ..dup argCount < do =:: i
          procType i typeContext types.getProcArgName .else
            continue
          end =:: argName
          argName id.identifierFlags id.FLAG_STATIC & ? if
            continue ## TODO? are static args even possible in this context
          end
          args i [] =:: argType
          argType typeContext types.isEmpty if continue end
          ## VariableInfo
            argName
            argType
            VariableType .ARGUMENT
          VariableInfo new list.append
        finally i 1 + end ..drop
      context .variables=
      newOps
        op
          procType >$ .dataType=
        list.append
      return
    DeclareId .case =:: idInfo
      context [] .variables
        ## VariableInfo
          idInfo .nameId
          op .dataType
          VariableType .LOCAL_VAR
        VariableInfo new list.append
      context .variables=
      newOps
        op list.append ## nothing to change
      return
    Constant .case =:: constVal
      op .dataType typeContext types.isValueType if
        newOps
          op list.append
        return
      end
      newOps
        constVal op .dataType op .pos program opConstReference list.append
      return
    Copy case
      op .dataType =:: baseType
      _BACKEND_ .QBE ! if ## currently QBE cannot handle value.types
        ## TODO? move delayed dereferencing to pre-compiler
        ## ? force deref for pure int/float value + keep copy (as deref hit) if type is not simple
        baseType typeContext types.isValueType if
          newOps return ## copy of value type is no-op
        end
      else
        baseType typeContext types.unwrapNamed types.isPrimitive or
            baseType typeContext types.isPointer if
          newOps return ## primitive copy is no-op
        end
      end
      baseType true op .pos context newTmpVar =:: tmpId
      newOps
        op .dataType baseType types.typeEquals ! if
          ## opAutoCast
            op .dataType
            0
            baseType
            op .pos
          opAutoCast list.append
        end
        baseType tmpId op .pos opDeclareId list.append
        baseType typeContext types.isValueType ! if
          baseType tmpId op .pos opAtId list.append
          baseType BuiltIn .COPY_PTR op .pos opBuiltIn list.append
          baseType tmpId op .pos opAtId list.append
        else
          baseType tmpId op .pos opSetId list.append
          baseType tmpId op .pos opGetId list.append
        end
      return
    New NewUnion case
      op .dataType typeContext types.isValueType if
        newOps
          op list.append
        return
      end
      op .dataType true op .pos context newTmpVar =:: tmpId
      newOps
        ## opDeclareId
          op .dataType
          tmpId
          op .pos
        opDeclareId list.append
        ## opAtId
          op .dataType
          tmpId
          op .pos
        opAtId list.append
        op .val .NewUnion .if =:: index
          1 StackModType .ROTATE op .pos opStackMod list.append
          1 StackModType .COPY op .pos opStackMod list.append
          op .dataType index op .pos typeContext applyElementOffset
            $ typeContext types.isValueType if
              BuiltIn .SET_PTR
            else
              BuiltIn .COPY_PTR
            end
          op .pos opBuiltIn list.append
        else ..drop op .dataType typeContext types.isTuple or op .dataType typeContext types.isTaggedUnion _if
          op .dataType typeContext types.compositeEltCount while $ 1 - <$ 0 != do =:: index
            1 StackModType .ROTATE op .pos opStackMod list.append
            1 StackModType .COPY op .pos opStackMod list.append
            op .dataType index op .pos typeContext applyElementOffset
              $ typeContext types.isValueType if
                BuiltIn .SET_PTR
              else
                BuiltIn .COPY_PTR
              end
            op .pos opBuiltIn list.append
          finally index end ..drop
        else op .dataType typeContext types.isArray _if
          0 StackModType .COPY op .pos opStackMod list.append
          op .dataType BuiltIn .CLEAR_PTR op .pos opBuiltIn list.append
        else
          0 sb.create
            op .dataType typeContext sb.appendType
          sb.asStr io.println
          "unexpected type for new" ..panic
        end
      return
    Call CallPtr case
      op .dataType
        $ typeContext types.getPointerBaseType .if >$ ..drop end
      =:: calledType
      newOps =:: mut: shadow: newOps
      calledType newOps@
        op .val .CallPtr ? if ProcSignatureType .CallPtr else ProcSignatureType .Call end
      op .pos context updateProcType =:: outArgNames =:: newProcType
      newOps =:: shadow: newOps
      newOps
        op
          newProcType
            op .dataType typeContext types.isPointer if
              false typeContext types.getAddressType
            end
          >$ .dataType=
        list.append
        _BACKEND_ .QBE if
          newProcType typeContext types.getProcOut .if .length 0 != else false end =:: hasValueRet
          outArgNames for .else continue end
            idContext id.getIdData .else "missing id-data for out-arg" ..panic end =:: idData
            idData [] .valueType
              idData id.asIdInfo
              op .pos
              idData [] .valueType typeContext types.isValueType if
                opGetId
              else
                opAtId
              end
            list.append
            hasValueRet if
              1 StackModType .ROTATE op .pos opStackMod list.append
            end
          end
        end
      return
    break
    Return case
      context .currentProcType [] .else "return outside procedure" ..panic end =:: retType
      ## TODO? don't return out-args by value independent of back-end
      ##  ! how to deal with value args mixed with non-value args
      retType typeContext types.getProcOut .if .length i32 cast.u else 0 end
        _BACKEND_ .QBE if context .outArgNames [] .length i32 cast.u + end
      =:: mut: stackValCount
      newOps
        context .outArgNames [] for .else
            continue
          end =:: retName
          stackValCount 1 u> if
            stackValCount 1 - StackModType .ROTATE op .pos opStackMod list.append
          end
          retName idContext id.getIdData .else
            "out-arg has no id-data" ..panic
          end
            $ [] .valueType =:: ptrType
          id.asIdInfo ptrType <$ op .pos opGetId list.append
          _BACKEND_ .QBE ! if
            0 StackModType .COPY op .pos opStackMod list.append
            stackValCount -_ StackModType .ROTATE op .pos opStackMod list.append
          else
            stackValCount 1 - stackValCount=
          end
          ptrType typeContext types.ptrTarget .else "expected out-arg to be pointer" ..panic end
            $ typeContext types.isValueType if
              BuiltIn .SET_PTR
            else
              BuiltIn .COPY_PTR
            end
          op .pos opBuiltIn list.append
        end
        op retType >$ .dataType= list.append
      return
    break
    LocalLabel .case =:: labelInfo
      labelInfo .labelType switch
        HINT_START HINT_END case
          ## move mergable operation after start hint
          newOps list.peek .and .val [] .BuiltIn .and canMergeJumpIf if
            newOps
              list.pop optional.unwrap =:: tmp
              op list.append
              tmp list.append
            return
          end
        break
        LABEL_START LABEL_MIDDLE LABEL_END case break
      end
      newOps
        op list.append
      return
    break
    LocalJump .case =:: jumpInfo
      0:JumpDistance op@ .val .LocalJump .if .jumpDistance= else ..unreachable end
      newOps
      ## fuse compare+jumpif
        jumpInfo .cmpType .TRUE or jumpInfo .cmpType .FALSE if
          jumpInfo .cmpType =:: mut: newCmpType
          $ list.peek .and .val .BuiltIn .and [] .NOT_BOOL if
            list.pop ..drop
            newCmpType
              .TRUE if CompareType .FALSE else CompareType .TRUE end
            newCmpType=
          else _BACKEND_ .ASM and $ list.peek .and .val .BuiltIn .and [] canMergeJumpIf _if
            list.pop .and .val .BuiltIn .else ..unreachable end =:: builtInVal
            newCmpType
              builtInVal mergeJumpIf op@ .dataType=
            newCmpType=
          end
          jumpInfo .cmpType newCmpType != if
            newCmpType op@ .val .LocalJump .if .cmpType= else ..unreachable end
          end
        end
      op list.append
    return
    CompilerInfo case ## TODO? preserve compilerInfo ops
      newOps return
    ConstantReference Error case
      break ## unsupported
  end
  "unsupported operation " sb.copyPtr
    op program sb.appendOp
  op .pos errors appendError
  newOps return
end

proc(
  Operation slice.mut : mut: oldOps
  Operation list ptr.mut : tmpOps
  VariableInfo list ptr.mut : variables
  ConverterContext ptr.mut : context
-> Operation slice.mut ) =>: convertProc
  context [] .program =:: program
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .nameContext =:: nameContext
  variables [] context .variables=
  tmpOps []
    $ .length =:: codeStart
    oldOps for
      context compileOp
    end
    $ list.asSlice codeStart slice.tail slice.copy =:: newCode
    oldOps slice.free oldOps=
  tmpOps =[]
  context [] .variables variables =[]
  context .outArgNames [] slice.free context .outArgNames=
  newCode
end

## TODO better name for file&procedure, find good description of compilation-step
proc( ProgramContext ptr.mut : program -> ) =>: export: prepareCompile
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .nameContext =:: nameContext
  ## ConverterContext
    program
    0 VariableInfo list.create
    NameId optional slice.emptyMutable
    Type optional.empty
    -1:FileId
    false
  ConverterContext new =:: mut: contextData
  contextData@ =:: context
  program [] .globalOps list.clear program .globalOps= ## global ops are no longer needed
  Operation list.empty =:: mut: tmpOps
  program [] .procedures for ProcId.getProcInfo =:: currentProc
    currentProc [] .flags ProcFlags.IS_STATIC ProcFlags.HAS_STATIC_ARG | & ? if continue end
    currentProc .implementation .Code .else ..drop
      continue
    end =:: impl
    impl .codeState [] .TypeChecked .else ..drop
      continue
    end =:: procCode
    tmpOps list.clear tmpOps=
    currentProc [] .fileId context .currentFile=
    program [] .progFiles
      currentProc [] .fileId i64 cast
    @[] =:: f
    ## convertProc
      procCode
      tmpOps@
      impl .variables
      context
    convertProc impl .codeState .PreCompiled=
  end
  tmpOps list.free ..drop
end
