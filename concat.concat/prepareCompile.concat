#+
converts code from pure stack code to code targeting a "real" machine as a
common first step for all compiler back-ends:
* limit size of stack-values
* explicitly create temporary variables for copy/output arguments
+#
import arenaAlloc

import "program.concat"
import "measure.concat"
import "branchTree.concat"
using id.IdentifierFlag

struct(
  ProgramContext ptr.mut : program
  VariableInfo list : variables
  FileId : mut: currentFile
  i32 : mut: inlineCount
) =:: ConverterContext

proc(
  Type : varType
  bool : mutable
  FilePosition ptr : pos
  ConverterContext ptr.mut : context
-> IdentifierInfo ) =>: newTmpVar
  context [] .program .idContext =:: idContext
  idContext .typeContext .nameContext =:: nameContext
  id.FLAG_NONE mutable if
    id.FLAG_MUTABLE | IdentifierFlag cast
  end =:: flags
  ## newIdentifier
    string.empty
    flags ## XXX? special flag for tmp vars
    pos
    nameContext
  id.newIdentifier =:: nameId
  nameId varType pos idContext id.declareTmpVar
  context [] .variables
    varType nameId VariableType .TMP_VAR VariableInfo new list.append
  context .variables=
  ## IdInfo
    IdentifierType .TMP_VAR
    nameId
  IdentifierInfo new return
end

## TODO? move inlining to seperate optimization pass
proc(
  ProcId : procId
  ProgramContext ptr.mut : program
-> Operation slice ) =>: calledProcOps
  procId ProcId.getProcInfo =:: procInfo
  program [] .progFiles
    procInfo [] .fileId i64 cast.u
  @[] =:: procFile
  procInfo .implementation .Code .else
    "expected code-proc" ..panic
  end =:: impl
  impl [] .code slice.freeze
end

proc(
  ProcId : procId
  ProgramContext ptr.mut : program
-> bool ) =>: shouldInlineCall
  program .idContext .typeContext .nameContext =:: nameContext
  optimizerFlags.ALLOW_INLINE ! and optimizerFlags.ALLOW_INLINE_SMALL ! if false return end
  procId ProcId.getProcInfo =:: procData
  procData .implementation [] .Code ? ! or
      procData [] .nameId nameContext id.identifierFlags id.FLAG_EXTERN & ? or
      procData [] .nameId nameContext id.identifierFlags id.FLAG_NO_INLINE & ? if
    false return
  end
  procId program calledProcOps =:: procOps
  ## TODO? small procedures should only be inlined if they don't contain jumps
  procOps .length 10 u<= if true return end ## init+op{0-7}+ret+end
  optimizerFlags.ALLOW_INLINE ! if false return end
  ## TODO! detect if proc is currently being inlined (smaller inline-limits in nested inline, prevent recursive inline)
  ## TODO compute inline weight depending on operations in procedure, cache weight in procedure(-impl) info
  procOps .length 18:iSize u<=
end
## FIXME inline should use original proc-code BEFORE pre-compilation was called
##  ? postpone pre-compile of inlinable-procs until other procs are done
##  * mark inlined procs that are never called directly as unused
proc(
  Operation list
  ProcId : procId
  FilePosition ptr : pos
  ConverterContext ptr.mut : context
-> Operation list ) =>: inlineCall
  context [] .program =:: program
  program .idContext .typeContext =:: typeContext
  typeContext .nameContext =:: nameContext
  procId ProcId.getProcInfo .implementation [] .Code ? "only code-procs are inlined" assert
  procId program calledProcOps =:: procOps
  NameId.hash@ NameId.eq@ 64 IdentifierInfo map.create =:: mut: remapIds ## TODO? store in context
  LocalLabelId.hash@ LocalLabelId.eq@ 64 LocalLabelId map.create =:: mut: remapLabels
  program program.nextLocalLabel =:: procEnd
  procEnd LocalLabelType .HINT_START pos opLabel list.append
  procOps 0 [] .dataType =:: procType
  procType typeContext types.getProcIn optional.unwrap =:: inTypes
  0 =:: mut: offset
  ## create tmp-variables for named arguments
  inTypes .length i32 cast.u 1 - while $ 0 >= do =:: i
    procType i typeContext types.getProcArgName =:: argName
    inTypes i [] =:: eltType
    eltType typeContext types.isEmpty if continue end ## ignore empty arguments
    argName id.NAME_ID_NONE == if
      offset 1 + offset=
    else argName nameContext id.identifierFlags id.FLAG_STATIC & ? ! _if
      offset 0 != if
        ## rotate labeled argument to top
        offset StackModType .ROTATE pos opStackMod list.append
      end
      eltType argName nameContext id.identifierFlags id.FLAG_MUTABLE & ? pos context newTmpVar =:: tmpId
      eltType tmpId pos opInitializeId list.append
      remapIds@ argName tmpId map.put optional.isEmpty "label-value only reassigned once" assert
    end
  finally i 1 - end ..drop
  procOps 1:iSize $1 .length 2:iSize - slice.getSlice
    $ .length 1 - =:: last
    $ last [] .val .Return ? if last >$ .length= end ## ignore return at end of proc
  for =:: mut: op
    op .val .Return ? if
      procEnd 0:JumpDistance CompareType .NONE op .pos opJump list.append
      continue
    else op .val .GetId ._if .nameId =:: nameId
      remapIds@ nameId map.get .if op@ .val .GetId= end
    else .SetId ._if .nameId =:: nameId
      remapIds@ nameId map.get .if op@ .val .SetId= end
    else .AtId ._if .nameId =:: nameId
      remapIds@ nameId map.get .if op@ .val .AtId= end
    else .LocalJump ._if .labelId =:: label
      remapLabels@ label map.get .else
        program program.nextLocalLabel
        remapLabels@ label $2 map.put ..drop
      end op@ .val .LocalJump .if .labelId =[] else ..drop.2 end
    else .LocalLabel ._if .labelId =:: label
      remapLabels@ label map.get .else
        program program.nextLocalLabel
        remapLabels@ label $2 map.put ..drop
      end op@ .val .LocalLabel .if .labelId =[] else ..drop.2 end
    else ..drop end
    op context compileOp
  end
  procEnd LocalLabelType .LABEL_END pos opLabel list.append
  remapIds@ map.free
  remapLabels@ map.free
end

proc( BuiltIn -> bool ) =>: canMergeJumpIf
  BuiltIn ..length 221 == "no new builtins" assert
  switch
    EQ_BOOL EQ_I8 EQ_I16 EQ_I32 EQ_I64 EQ_F32 EQ_F64 ## ==
    NE_BOOL NE_I8 NE_I16 NE_I32 NE_I64 NE_F32 NE_F64 ## !=
    LT_I8 LT_I16 LT_I32 LT_I64 LT_F32 LT_F64 ## <
    LE_I8 LE_I16 LE_I32 LE_I64 LE_F32 LE_F64 ## <=
    GE_I8 GE_I16 GE_I32 GE_I64 GE_F32 GE_F64 ## >=
    GT_I8 GT_I16 GT_I32 GT_I64 GT_F32 GT_F64 ## >
    ULT_I8 ULT_I16 ULT_I32 ULT_I64           ## u<
    ULE_I8 ULE_I16 ULE_I32 ULE_I64           ## u<=
    UGE_I8 UGE_I16 UGE_I32 UGE_I64           ## u>=
    UGT_I8 UGT_I16 UGT_I32 UGT_I64           ## u>
    case true return
    default false return
  end
end
proc( CompareType -> CompareType ) =>: adjustFlippedFloatCmpType
  switch
    EQ case CompareType .EQ break
    NE case CompareType .NE break
    LT case CompareType .ULT break
    LE case CompareType .ULE break
    GE case CompareType .UGE break
    GT case CompareType .UGT break
    default "unexpected compare-type for float" ..panic
  end
end
proc( CompareType : cmpType BuiltIn : builtIn -> CompareType Type ) =>: mergeJumpIf
  cmpType .FALSE or cmpType .TRUE end "can only merge cmp.true and cmp.false" assert
  cmpType .FALSE =:: flip
  BuiltIn ..length 221 == "no new builtins" assert
  builtIn switch
    EQ_BOOL EQ_I8 EQ_I16 EQ_I32 EQ_I64 EQ_F32 EQ_F64 case
      flip if CompareType .NE else CompareType .EQ end
    break
    NE_BOOL NE_I8 NE_I16 NE_I32 NE_I64 NE_F32 NE_F64 case
      flip if CompareType .EQ else CompareType .NE end
    break
    LT_I8 LT_I16 LT_I32 LT_I64 LT_F32 LT_F64 case
      flip if CompareType .GE else CompareType .LT end
    break
    LE_I8 LE_I16 LE_I32 LE_I64 LE_F32 LE_F64 case
      flip if CompareType .GT else CompareType .LE end
    break
    GE_I8 GE_I16 GE_I32 GE_I64 GE_F32 GE_F64 case
      flip if CompareType .LT else CompareType .GE end
    break
    GT_I8 GT_I16 GT_I32 GT_I64 GT_F32 GT_F64 case
      flip if CompareType .LE else CompareType .GT end
    break
    ULT_I8 ULT_I16 ULT_I32 ULT_I64 case
      flip if CompareType .UGE else CompareType .ULT end
    break
    ULE_I8 ULE_I16 ULE_I32 ULE_I64 case
      flip if CompareType .UGT else CompareType .ULE end
    break
    UGE_I8 UGE_I16 UGE_I32 UGE_I64 case
      flip if CompareType .ULT else CompareType .UGE end
    break
    UGT_I8 UGT_I16 UGT_I32 UGT_I64 case
      flip if CompareType .ULE else CompareType .UGT end
    break
    default "unsupported built-in for jump-merge" ..panic
  end
  builtIn switch
    EQ_BOOL NE_BOOL case types.primitive.BOOL break
    EQ_I8 NE_I8 LT_I8 LE_I8 GE_I8 GT_I8 ULT_I8 ULE_I8 UGE_I8 UGT_I8 case
      types.primitive.I8 break
    EQ_I16 NE_I16 LT_I16 LE_I16 GE_I16 GT_I16 ULT_I16 ULE_I16 UGE_I16 UGT_I16 case
      types.primitive.I16 break
    EQ_I32 NE_I32 LT_I32 LE_I32 GE_I32 GT_I32 ULT_I32 ULE_I32 UGE_I32 UGT_I32 case
      types.primitive.I32 break
    EQ_I64 NE_I64 LT_I64 LE_I64 GE_I64 GT_I64 ULT_I64 ULE_I64 UGE_I64 UGT_I64 case
      types.primitive.I64 break
    EQ_F32 NE_F32 LT_F32 LE_F32 GE_F32 GT_F32 case
      flip if adjustFlippedFloatCmpType end
      types.primitive.F32 break
    EQ_F64 NE_F64 LT_F64 LE_F64 GE_F64 GT_F64 case
      flip if adjustFlippedFloatCmpType end
      types.primitive.F64 break
    default "unsupported built-in for jump-merge" ..panic
  end
end

proc(
  Operation list : newOps
  Operation : mut: op
  ConverterContext ptr.mut : context
-> Operation list ) =>: compileOp
  context [] .program =:: program
  program .errors =:: errors
  program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .nameContext =:: nameContext
  op .val switch
    NOP case
      newOps return ## ignore no-ops
    BuiltIn Splat ProcPtr Panic PanicWithMessage
    GetId SetId AtId GetUnionLabel SetUnionElement
    SetElement RuntimeAssert Error StackMod GetElement GetUnionElement
    AutoCast Cast Cast! BitCast Return RawValue case
      newOps
        op list.append ## nothing to change
      return
    ImplementProcedure case
      op .dataType typeContext types.getProcIn optional.unwrap =:: args
      args .length i32 cast.u =:: argCount
      context [] .variables
        0:i32 while ..dup argCount < do =:: i
          op .dataType i typeContext types.getProcArgName =:: argName
          argName id.NAME_ID_NONE == or argName nameContext id.identifierFlags id.FLAG_STATIC & ? if
            continue
          end
          args i [] =:: argType
          argType typeContext types.isEmpty if continue end
          ## VariableInfo
            argType
            argName
            VariableType .ARGUMENT
          VariableInfo new list.append
        finally i 1 + end ..drop
      context .variables=
      newOps
        op list.append ## nothing to change
      return
    DeclareId InitializeId .case =:: idInfo
      context [] .variables
        ## VariableInfo
          op .dataType
          idInfo .nameId
          VariableType .LOCAL_VAR
        VariableInfo new list.append
      context .variables=
      newOps
        op list.append ## nothing to change
      return
    Constant .case =:: constVal
      ## TODO? smarter way to determine when to use const-reference?
      op .dataType typeContext types.referenceOnly ! if
        newOps
          op list.append
        return
      end
      newOps
        constVal op .dataType op .pos program opConstReference list.append
      return
    Copy case
      op .dataType =:: baseType
      ## TODO change to check for reference-only once composite stack values are supported by QBE back-end
      ## baseType typeContext types.referenceOnly ! if
      baseType typeContext types.unwrapNamed types.isPrimitive or
          baseType typeContext types.isPointer if
        newOps return ## primitive copy is no-op
      end
      baseType true op .pos context newTmpVar =:: tmpId
      newOps
        op .dataType baseType types.typeEquals ! if
          ## opAutoCast
            op .dataType
            0
            baseType
            op .pos
          opAutoCast list.append
        end
        ## opInitializeId
          baseType
          tmpId
          op .pos
        opInitializeId list.append
        ## opGetId
          baseType
          tmpId
          op .pos
        opGetId list.append
      return
    New NewUnion case
      op .dataType typeContext types.referenceOnly ! if
        newOps
          op list.append
        return
      end
      op .dataType true op .pos context newTmpVar =:: tmpId
      newOps
        ## opInitializeId
          op .dataType
          tmpId
          op .pos
        opDeclareId list.append
        ## opAtId
          op .dataType
          tmpId
          op .pos
        opAtId list.append
        op .val .NewUnion .if
          op .dataType >$ op .pos opNewUnionReference list.append
        else ..drop
          op .dataType op .pos opNewReference list.append
        end
      return
    Call CallPtr case
      op .val .Call .and =:: callVal
          callVal program shouldInlineCall if
        newOps callVal op .pos context inlineCall return
      end
      op .dataType
        $ typeContext types.isPointer if
          typeContext types.getBaseType
        end
      =:: calledType
      ## special handling for pointer-call procedures
      _BACKEND_ .QBE if ## TODO? is special case for QBE needed, ? should this be a check for PTRCALL
        calledType typeContext types.getProcOutArgs =:: outArgs
        newOps
          outArgs for =:: arg
            arg typeContext types.isEmpty if
              continue
            end
            arg true op .pos context newTmpVar =:: tmpId
            ## opDeclareId
              arg
              tmpId
              op .pos
            opDeclareId list.append
            ## opAtId
              arg
              tmpId
              op .pos
            opAtId list.append
          end
          op list.append
        return
      end
      newOps
        op list.append
      return
    ## TODO? merge identical variables on independent branches
    ## TODO cleanup unused labels
    LocalLabel case newOps op list.append return
    LocalJump .case =:: jumpInfo
      0:JumpDistance op@ .val .LocalJump .if .jumpDistance= else ..unreachable end
      newOps
      ## fuse compare+jumpif
        jumpInfo .cmpType .TRUE or jumpInfo .cmpType .FALSE if
          jumpInfo .cmpType =:: mut: newCmpType
          $ list.peek .and .val .BuiltIn .and [] .NOT_BOOL if
            list.pop ..drop
            newCmpType
              .TRUE if CompareType .FALSE else CompareType .TRUE end
            newCmpType=
          end
          _BACKEND_ .ASM and $ list.peek .and .val .BuiltIn .and [] canMergeJumpIf if
            list.pop .and .val .BuiltIn .else ..unreachable end =:: builtInVal
            newCmpType
              builtInVal mergeJumpIf op@ .dataType=
            newCmpType=
          end
          jumpInfo .cmpType newCmpType != if
            newCmpType op@ .val .LocalJump .if .cmpType= else ..unreachable end
          end
        end
      op list.append
    return
    Block .case .blockType
      BlockType ..length 33:iSize == "no new block types" assert
      switch
        SWITCH case newOps op list.append return
        default break
      end
    break
    BlockEnd .case .blockType
      BlockType ..length 33:iSize == "no new block types" assert
      switch
        PROCEDURE case newOps op list.append return
        default break
      end
    break
    CompilerInfo case ## XXX? preserve compilerInfo ops
      newOps return
    AutoTypedInitializeId ConstantReference NewReference
    TypeInfo NewUnionReference UsingNamespace UsingIdentifier
    GetName AtName SetName GetNamedElt Assert DeclareName AliasName InitializeName
    SetNamedElt Length TypeModifier TypeWith ExistsNamedElt ExistsName NestedProc Import LibImport case
      break ## XXX error message
  end
  "unsupported operation " sb.copyPtr
    op program sb.appendOp
  op .pos errors appendError
  newOps return
end

proc(
  Operation slice.mut : mut: oldOps
  Operation list ptr.mut : tmpOps
  VariableInfo list ptr.mut : variables
  ConverterContext ptr.mut : context
-> Operation slice.mut ) =>: convertProc
  context [] .program =:: program
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .nameContext =:: nameContext
  variables [] context .variables=
  tmpOps []
    $ .length =:: codeStart
    oldOps for
      context compileOp
    end
    $ list.asSlice codeStart slice.tail slice.copy =:: newCode
    oldOps slice.free oldOps=
  tmpOps =[]
  context [] .variables variables =[]
  newCode
end

## TODO better name for file&procedure, find good description of compilation-step
proc( ProgramContext ptr.mut : program -> ) =>: export: prepareCompile
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .nameContext =:: nameContext
  ## ConverterContext
    program
    0 VariableInfo list.create
    -1:FileId
    0
  ConverterContext new =:: mut: contextData
  contextData@ =:: context
  program [] .globalOps list.clear program .globalOps= ## global ops are no longer needed
  Operation list.empty =:: mut: tmpOps
  program [] .procedures for ProcId.getProcInfo =:: currentProc
    currentProc [] .flags ProcFlags.IS_STATIC ProcFlags.HAS_STATIC_ARG | & ? if continue end
    currentProc .implementation .Code .else ..drop
      continue
    end =:: impl
    tmpOps list.clear tmpOps=
    currentProc [] .fileId context .currentFile=
    program [] .progFiles
      currentProc [] .fileId i64 cast
    @[] =:: f
    impl .codeState [] .UNUSED if
      continue
    end
    ## convertProc
      impl [] .code
      tmpOps@
      impl .variables
      context
    convertProc impl .code=
    ProcCodeState .COMPILED impl .codeState=
  end
  ## create implementations for built-in procedure-pointers
  program [] .procedures for =:: procId
    procId ProcId.getProcInfo =:: currentProc
    currentProc .implementation .BuiltIn .else ..drop
      break ## built-ins at start of procedure list
    end =:: builtInImpl
    builtInImpl [] .hasPtr ! if
      continue
    end
    currentProc [] .nameId nameContext id.identifierPos .else
      "missing nameId position" ..panic
    end =:: pos
    4 Operation mem.alloc 4 slice.createMutable =:: opBuffer
    opBuffer list.wrapSlice
      ## opImplementProc
        currentProc [] .procType
        procId
        pos
      opImplementProc list.append
      ## opBuiltIn
        currentProc [] .procType
        builtInImpl [] .builtIn
        pos
      opBuiltIn list.append
      currentProc [] .procType pos opReturn list.append
      BlockType .PROCEDURE pos opEndBlock list.append
    ..drop
    ## CodeProcData
      0 VariableInfo list.create
      opBuffer
      GenericProcInfo .None
      ProcCodeState .COMPILED
      0:i16
    CodeProcData new currentProc .implementation .Code=
  end
  tmpOps list.free ..drop
end
