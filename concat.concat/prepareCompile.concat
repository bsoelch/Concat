#+
converts code from pure stack code to code targeting a "real" machine as a
common first step for all compiler back-ends:
* limit size of stack-values
* explicitly create temporary variables for copy/output arguments
+#
import stringIO
import arenaAlloc

import "program.concat"
import "measure.concat"
import "branchTree.concat"
using id.LabelFlag

i64 =:: BlockUId
enum( IF AND_OR WHILE SWITCH ) =:: LocalBlockType
proc( BlockId LocalBlockType -> BlockUId ) =>: getBlockUId
  ..label i64 cast.u
    $ 0b100 <= "LocalBlockType fits in two bits" assert
  >$ i64 cast.u << 2 | BlockUId cast
end
struct(
  LocalLabelId : endLabel
) =:: AndOrBlockLabelInfo
struct(
  LocalLabelId : ifLabel
  LocalLabelId : elseLabel
  LocalLabelId : endLabel
) =:: IfBlockLabelInfo
struct(
  LocalLabelId : whileLabel
  LocalLabelId : doLabel
  LocalLabelId : finallyLabel
  LocalLabelId : endLabel
) =:: WhileBlockLabelInfo
union(
  AndOrBlockLabelInfo : AndOr
  IfBlockLabelInfo : If
  WhileBlockLabelInfo : While
) =:: BlockLabelInfo
struct(
  ProgramContext ptr.mut : program
  BlockUId BlockLabelInfo hashMap : blockLabels
  VariableInfo list : variables
  FileId : mut: currentFile
  i32 : mut: inlineCount
) =:: ConverterContext
proc( BlockId ConverterContext ptr.mut : context -> AndOrBlockLabelInfo bool ) =>: getAndOrLabelInfo
  LocalBlockType .AND_OR getBlockUId =:: blockId
  context .blockLabels blockId map.get .else
    ## AndOrBlockLabelInfo
      context [] .program program.nextLocalLabel
    AndOrBlockLabelInfo new
      context .blockLabels blockId $2 BlockLabelInfo .AndOr map.put ..drop
    true return
  end .AndOr .else "expected AndOrBlockLabelInfo" ..panic end false
end
proc( BlockId ConverterContext ptr.mut : context -> AndOrBlockLabelInfo ) =>: removeAndOrLabelInfo
  LocalBlockType .AND_OR getBlockUId =:: blockId
  context .blockLabels blockId map.remove .and .AndOr .else
    "missing AndOrBlockLabelInfo" ..panic
  end
end
proc( BlockId ConverterContext ptr.mut : context -> IfBlockLabelInfo bool ) =>: getIfLabelInfo
  LocalBlockType .IF getBlockUId =:: blockId
  context .blockLabels blockId map.get .else
    ## IfBlockLabelInfo
      context [] .program program.nextLocalLabel
      context [] .program program.nextLocalLabel
      context [] .program program.nextLocalLabel
    IfBlockLabelInfo new
      context .blockLabels blockId $2 BlockLabelInfo .If map.put ..drop
    true return
  end .If .else "expected IfBlockLabelInfo" ..panic end false
end
proc( BlockId ConverterContext ptr.mut : context -> IfBlockLabelInfo ) =>: removeIfLabelInfo
  LocalBlockType .IF getBlockUId =:: blockId
  context .blockLabels blockId map.remove .and .If .else
    "missing IfBlockLabelInfo" ..panic
  end
end
proc( BlockId ConverterContext ptr.mut : context -> WhileBlockLabelInfo ) =>: getWhileLabelInfo
  LocalBlockType .WHILE getBlockUId =:: blockId
  context .blockLabels blockId map.get .else
    ## WhileBlockLabelInfo
      context [] .program program.nextLocalLabel
      context [] .program program.nextLocalLabel
      context [] .program program.nextLocalLabel
      context [] .program program.nextLocalLabel
    WhileBlockLabelInfo new
      context .blockLabels blockId $2 BlockLabelInfo .While map.put ..drop
    return
  end .While .else "expected WhileBlockLabelInfo" ..panic end
end
proc( BlockId ConverterContext ptr.mut : context -> WhileBlockLabelInfo ) =>: removeWhileLabelInfo
  LocalBlockType .WHILE getBlockUId =:: blockId
  context .blockLabels blockId map.remove .and .While .else
    "missing WhileBlockLabelInfo" ..panic
  end
end

proc(
  Type : varType
  bool : mutable
  FilePosition : pos
  ConverterContext ptr.mut : context
-> IdentifierInfo ) =>: newTmpVar
  context [] .program .idContext =:: idContext
  idContext .typeContext .labelContext =:: labelContext
  id.FLAG_NONE mutable if
    id.FLAG_MUTABLE | LabelFlag cast
  end =:: flags
  ## newLabel
    string.empty
    flags ## XXX? special flag for tmp vars
    pos
    context [] .currentFile
    labelContext
  id.newLabel =:: label
  label varType pos idContext id.declareTmpVar
  context [] .variables
    varType label VariableType .TMP_VAR VariableInfo new list.append
  context .variables=
  ## IdInfo
    IdentifierType .TMP_VAR
    label
  IdentifierInfo new return
end

import debug
## TODO? move inlining to seperate optimization pass
proc(
  ProcedureCall : callInfo
  ProgramContext ptr.mut : program
-> Operation slice ) =>: calledProcOps
  program [] .procedures callInfo .procId i64 cast.u @[] =:: procInfo
  program [] .progFiles
    procInfo [] .fileId i64 cast.u
  @[] =:: procFile
  procInfo .implementation .Code .else
    "expected code-proc" ..panic
  end =:: impl
  callInfo .implementationId -1 == if
    impl [] .code slice.freeze
  else
    impl [] .implementations callInfo .implementationId @[] =:: callImpl
    callImpl [] .code slice.freeze
  end
end
import debug
proc(
  ProcedureCall : callInfo
  ProgramContext ptr.mut : program
-> bool ) =>: shouldInlineCall
  program .idContext .typeContext .labelContext =:: labelContext
  optimizerFlags.ALLOW_INLINE ! if false return end
  ## TODO allow inlining of small procedures when ALLOW_INLINE_SMALL is set
  program [] .procedures callInfo .procId i64 cast.u @[] =:: procData
  procData [] .isStatic or procData .implementation [] .Code ? ! or
      procData [] .labelId labelContext id.labelFlags id.FLAG_EXTERN & ? if
    false return
  end
  callInfo program calledProcOps =:: procOps
  ## TODO compute inline weight depending on operations in procedure, cache weight in procedure(-impl) info
  procOps .length 16:iSize u<
end
proc(
  Operation list
  ProcedureCall : callInfo
  FilePosition : pos
  ConverterContext ptr.mut : context
-> Operation list ) =>: inlineCall
  context [] .program =:: program
  program .idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  program [] .procedures
    callInfo .procId i64 cast.u @[] .implementation []
  .Code ? "only code-procs are inlined" assert
  callInfo program calledProcOps =:: procOps
  "Inlining procedures is currently experimental" sb.copyPtr pos program .errors appendWarning
  context [] .inlineCount
    $ 1 + context .inlineCount=
  BlockId cast =:: inlineId
  labelHash@ labelEq@ 64 IdentifierInfo map.create =:: mut: remapLabels ## TODO store in context
  BlockType .INLINE_PROCEDURE pos opBlock list.append
  inlineId $1 list.peek .and .val .Block .else
    "expected block" ..panic
  end .blockId=
  procOps 0 [] .dataType =:: procType
  procType typeContext types.getProcIn optional.unwrap =:: inTypes
  0 =:: mut: offset
  ## create tmp-variables for named arguments
  inTypes .length i32 cast.u 1 - while $ 0 >= do =:: i
    procType i typeContext types.getProcArgLabel =:: argLabel
    argLabel id.LABEL_ID_NONE == if
      offset 1 + offset=
    else argLabel labelContext id.labelFlags id.FLAG_STATIC & ? ! _if
      ## TODO 1. rotate labeled argument to top
      inTypes i [] =:: eltType
      eltType argLabel labelContext id.labelFlags id.FLAG_MUTABLE & ? pos context newTmpVar =:: tmpId
      eltType tmpId pos opInitializeId list.append
      remapLabels@ argLabel tmpId map.put optional.isEmpty "label-value only reassigned once" assert
    end
  finally i 1 - end ..drop
  procOps 1:iSize $1 .length 2:iSize - slice.getSlice for =:: mut: op
    ## TODO? move remapping to compileOp ( flag to check if within inlined proc )
    op .val .Return ? if
      inlineId op@ .val .InlineReturn=
      op list.append
      continue
    else op .val .GetId ._if .labelId =:: label
      remapLabels@ label map.get .if op@ .val .GetId= end
    else .SetId ._if .labelId =:: label
      remapLabels@ label map.get .if op@ .val .SetId= end
    else .AtId ._if .labelId =:: label
      remapLabels@ label map.get .if op@ .val .AtId= end
    else ..drop end
    op context compileOp
  end
  BlockType .INLINE_PROCEDURE pos opEndBlock list.append
  inlineId $1 list.peek .and .val .BlockEnd .else
    "expected block-end" ..panic
  end .blockId=
  remapLabels@ map.free
end

proc(
  Operation list : newOps
  Operation : mut: op
  ConverterContext ptr.mut : context
-> Operation list ) =>: compileOp
  context [] .program =:: program
  program .errors =:: errors
  program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  op .val switch
    NOP case
      newOps return ## ignore no-ops
    BuiltIn Splat ProcPtr Panic PanicWithMessage
    GetId SetId AtId GetUnionLabel SetUnionElement
    SetElement RuntimeAssert Error StackMod GetElement GetUnionElement
    AutoCast Cast Cast! BitCast Return RawValue case
      newOps
        op list.append ## nothing to change
      return
    ImplementProcedure case
      op .dataType typeContext types.getProcIn optional.unwrap =:: args
      args .length i32 cast.u =:: argCount
      context [] .variables
        0:i32 while ..dup argCount < do =:: i
          op .dataType i typeContext types.getProcArgLabel =:: label
          label id.LABEL_ID_NONE == or label labelContext id.labelFlags id.FLAG_STATIC & ? if
            continue
          end
          args i [] =:: argType
          argType typeContext types.isEmpty if continue end
          ## VariableInfo
            argType
            label
            VariableType .ARGUMENT
          VariableInfo new list.append
        finally i 1 + end ..drop
      context .variables=
      newOps
        op list.append ## nothing to change
      return
    DeclareId InitializeId .case =:: idInfo
      context [] .variables
        ## VariableInfo
          op .dataType
          idInfo .labelId
          VariableType .LOCAL_VAR
        VariableInfo new list.append
      context .variables=
      newOps
        op list.append ## nothing to change
      return
    Constant .case =:: constVal
      ## TODO? smarter way to determine when to use const-reference?
      op .dataType typeContext types.referenceOnly ! if
        newOps
          op list.append
        return
      end
      newOps
        constVal op .dataType op .pos program opConstReference list.append
      return
    Copy case
      op .dataType =:: baseType
      ## TODO change to check for reference-only once composite stack values are supported by QBE back-end
      ## baseType typeContext types.referenceOnly ! if
      baseType typeContext types.unwrapNamed types.isPrimitive or
          baseType typeContext types.isPointer if
        newOps return ## primitive copy is no-op
      end
      baseType true op .pos context newTmpVar =:: tmpId
      newOps
        ## opAutoCast
          op .dataType
          0
          baseType
          op .pos
        opAutoCast list.append
        ## opInitializeId
          baseType
          tmpId
          op .pos
        opInitializeId list.append
        ## opGetId
          baseType
          tmpId
          op .pos
        opGetId list.append
      return
    New NewUnion case
      op .dataType typeContext types.referenceOnly ! if
        newOps
          op list.append
        return
      end
      op .dataType true op .pos context newTmpVar =:: tmpId
      newOps
        ## opInitializeId
          op .dataType
          tmpId
          op .pos
        opDeclareId list.append
        ## opAtId
          op .dataType
          tmpId
          op .pos
        opAtId list.append
        op .val .NewUnion .if
          op .dataType >$ op .pos opNewUnionReference list.append
        else ..drop
          op .dataType op .pos opNewReference list.append
        end
      return
    Call CallPtr case
      op .val .Call .and =:: callVal
          callVal program shouldInlineCall if
        newOps callVal op .pos context inlineCall return
      end
      op .dataType
        $ typeContext types.isPointer if
          typeContext types.getBaseType
        end
      =:: calledType
      ## special handling for pointer-call procedures
      _BACKEND_ .QBE if ## TODO? is special case for QBE needed, ? should this be a check for PTRCALL
        calledType typeContext types.getProcOutArgs =:: outArgs
        op@ .val .CallPtr .if
          ## remember number of out-args in call operation
          outArgs .length >$ .outArgCount=
        else ..drop end
        newOps
          outArgs for =:: arg
            arg typeContext types.isEmpty if
              continue
            end
            arg true op .pos context newTmpVar =:: tmpId
            ## opDeclareId
              arg
              tmpId
              op .pos
            opDeclareId list.append
            ## opAtId
              arg
              tmpId
              op .pos
            opAtId list.append
          end
          op list.append
        return
      end
      op .val .CallPtr .if
        program getPtrCallData
      else .Call ._if
        program getCallData
      else ..unreachable end =:: callData
      calledType typeContext types.getCallConvention .PTRCALL =:: isPtrCall
      calledType typeContext types.getProcOut optional.unwrap =:: outTypes
      false =:: mut: hasLabel
      program [] .labelBuffer
        $ .length 0:iSize == "label buffer is empty before use" assert
        outTypes .length for =:: i
          outTypes i [] =:: arg
          arg typeContext types.isEmpty if continue end
          arg typeContext types.referenceOnly or isPtrCall and i outTypes .length 1:iSize - u< if
            true hasLabel=
            arg true op .pos context newTmpVar .labelId
          else
            id.LABEL_ID_NONE
          end list.append
        end
        hasLabel if
          program [] .programMemory
            $1 mixedArena.copyList callData .retValueLocations=
          program .programMemory=
        end
        list.clear
      program .labelBuffer=
      newOps
        op list.append
      return
    LocalJump LocalLabel case break
    ## TODO! generate correct label hints
    ## TODO? merge identical variables on independent branches
    Block .case =:: blockInfo
      blockInfo .blockId =:: blockId
      blockInfo .blockType switch
        AND_IF case newOps
          blockId context getIfLabelInfo if
            >$
              $1 .endLabel LocalLabelType .HINT_START op .pos opLabel list.append
              $1 .elseLabel LocalLabelType .HINT_START op .pos opLabel list.append
              $1 .ifLabel LocalLabelType .HINT_START op .pos opLabel list.append
            <$
          end .elseLabel CompareType .FALSE op .pos opJump list.append
        return
        OR_IF case newOps
          blockId context getIfLabelInfo if
            >$
              $1 .endLabel LocalLabelType .HINT_START op .pos opLabel list.append
              $1 .elseLabel LocalLabelType .HINT_START op .pos opLabel list.append
              $1 .ifLabel LocalLabelType .HINT_START op .pos opLabel list.append
            <$
          end .ifLabel CompareType .TRUE op .pos opJump list.append
        return
        IF case newOps
          blockId context getIfLabelInfo =:: isBlockStart =:: ifLabelInfo
          isBlockStart if
            ifLabelInfo .endLabel LocalLabelType .HINT_START op .pos opLabel list.append
            ifLabelInfo .elseLabel LocalLabelType .HINT_START op .pos opLabel list.append
          end
          ifLabelInfo .elseLabel CompareType .FALSE op .pos opJump list.append
          isBlockStart ! if ## do not need if-label when block starts with if
            ifLabelInfo .ifLabel LocalLabelType .LABEL_END op .pos opLabel list.append
          end
        return
        ELSE case newOps
          blockId context getIfLabelInfo ..drop .endLabel CompareType .NONE op .pos opJump list.append
          blockId context getIfLabelInfo ..drop .elseLabel LocalLabelType .LABEL_END op .pos opLabel list.append
        return
        SWITCH case
          blockId
            newOps .length i32 cast.u
          program program.jumps.updateSwitch
          newOps op list.append return
        CASE DOT_CASE case
          blockId
            newOps .length i32 cast.u
          program program.jumps.updateCase
          newOps op list.append return
        DEFAULT DOT_DEFAULT case
          blockId
            newOps .length i32 cast.u
          program program.jumps.updateDefault
          newOps op list.append return
        BREAK_SWITCH case
          blockId
            newOps .length i32 cast.u
          program program.jumps.updateBreakSwitch
          newOps op list.append return
        WHILE case newOps
          blockId context getWhileLabelInfo =:: whileInfo
          whileInfo .endLabel LocalLabelType .HINT_START op .pos opLabel list.append
          whileInfo .whileLabel LocalLabelType .LABEL_START op .pos opLabel list.append
          whileInfo .finallyLabel LocalLabelType .HINT_START op .pos opLabel list.append
          whileInfo .doLabel LocalLabelType .HINT_START op .pos opLabel list.append
        return
        OR_DO case
          newOps
            blockId context getWhileLabelInfo .doLabel CompareType .TRUE op .pos opJump
          list.append
        return
        AND_DO case
          newOps
            blockId context getWhileLabelInfo .endLabel CompareType .FALSE op .pos opJump
          list.append
        return
        DO case newOps
          blockId context getWhileLabelInfo =:: whileBlockInfo
          whileBlockInfo .endLabel CompareType .FALSE op .pos opJump list.append
          whileBlockInfo .doLabel LocalLabelType .LABEL_END op .pos opLabel list.append
        return
        BREAK case
          newOps
            blockId context getWhileLabelInfo .endLabel CompareType .NONE op .pos opJump
          list.append
        return
        CONTINUE case
          newOps
            blockId context getWhileLabelInfo .finallyLabel CompareType .NONE op .pos opJump
          list.append
        return
        FINALLY case
          newOps
            blockId context getWhileLabelInfo .finallyLabel LocalLabelType .LABEL_END op .pos opLabel
          list.append
        return
        AND case newOps
          0 StackModType .COPY op .pos opStackMod list.append
          blockId context getAndOrLabelInfo if
            >$
              $1 .endLabel LocalLabelType .HINT_START op .pos opLabel list.append
            <$
          end .endLabel CompareType .FALSE op .pos opJump list.append
        return
        OR case newOps
          0 StackModType .COPY op .pos opStackMod list.append
          blockId context getAndOrLabelInfo if
            >$
              $1 .endLabel LocalLabelType .HINT_START op .pos opLabel list.append
            <$
          end .endLabel CompareType .TRUE op .pos opJump list.append
        return
        IF_TRUE IF_FALSE AND_TRUE AND_FALSE
        OR_TRUE OR_FALSE ELSE_TRUE ELSE_FALSE
        UNKNOWN INITIALIZER NAMESPACE PROCEDURE INLINE_PROCEDURE OVERLOAD
        TYPE_TUPLE TYPE_STRUCT TYPE_ENUM TYPE_UNION TYPE_UNTAGGED_UNION TYPE_SETTYPE
            TYPE_PROC_IN TYPE_CPROC_IN TYPE_PROC_ARROW TYPE_COMPOSITE case break
      end
    break
    ## TODO remove block-label-info after closing block
    BlockEnd .case =:: blockInfo
      blockInfo .blockId =:: blockId
      blockInfo .blockType switch
        PROCEDURE case
          newOps op list.append return
        ELSE case
          newOps
            blockId context removeIfLabelInfo .endLabel LocalLabelType .LABEL_END op .pos opLabel
          list.append
        return
        SWITCH case
          blockId
            newOps list.asMutableSlice
          program program.jumps.updateEndSwitch
          op@ .val .BlockEnd unionElement.unwrapPtr .jumpDistance=
          newOps op list.append return
        WHILE case newOps
          blockId context removeWhileLabelInfo =:: whileBlockInfo
          whileBlockInfo .whileLabel CompareType .NONE op .pos opJump list.append
          whileBlockInfo .whileLabel LocalLabelType .HINT_END op .pos opLabel list.append
          whileBlockInfo .endLabel LocalLabelType .LABEL_END op .pos opLabel list.append
        return
        AND OR case
          newOps
            blockId context removeAndOrLabelInfo .endLabel LocalLabelType .LABEL_END op .pos opLabel
          list.append
        return
        AND_IF OR_IF AND_DO OR_DO FINALLY INLINE_PROCEDURE
        IF_TRUE IF_FALSE AND_TRUE AND_FALSE
        OR_TRUE OR_FALSE ELSE_TRUE ELSE_FALSE
        UNKNOWN CASE DOT_CASE DEFAULT DOT_DEFAULT BREAK_SWITCH DO BREAK
        CONTINUE INITIALIZER IF NAMESPACE TYPE_SETTYPE OVERLOAD
        TYPE_TUPLE TYPE_STRUCT TYPE_ENUM TYPE_UNION TYPE_UNTAGGED_UNION
        TYPE_PROC_IN TYPE_CPROC_IN TYPE_PROC_ARROW TYPE_COMPOSITE case break
      end
      break
    CompilerInfo case ## XXX? preserve compilerInfo ops
      newOps return
    AutoTypedInitializeId ConstantReference NewReference
    TypeInfo NewUnionReference UsingNamespace UsingIdentifier InlineReturn
    GetName AtName SetName GetLabel Assert DeclareName AliasName InitializeName
    SetLabel Length TypeModifier TypeWith ExistsLabel ExistsName NestedProc Import LibImport case
      break ## XXX error message
  end
  "unsupported operation " sb.copyPtr
    op program sb.appendOp
  op .pos errors appendError
  newOps return
end

proc(
  Operation slice.mut : mut: oldOps
  Operation list ptr.mut : tmpOps
  VariableInfo list ptr.mut : variables
  ConverterContext ptr.mut : context
-> Operation slice.mut ) =>: convertProc
  context [] .program =:: program
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  variables [] context .variables=
  tmpOps []
    $ .length =:: codeStart
    oldOps for
      context compileOp
    end
    $ list.asSlice codeStart slice.tail slice.copy =:: newCode
    oldOps slice.free oldOps=
  tmpOps =[]
  context [] .variables variables =[]
  newCode
end

## TODO better name for file&procedure, find good description of compilation-step
proc( ProgramContext ptr.mut : program -> ) =>: export: prepareCompile
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  ## ConverterContext
    program
    proc( BlockUId -> i32 ) => i32 cast end proc( BlockUId BlockUId -> bool ) => == end 256 BlockLabelInfo map.create
    0 VariableInfo list.create
    -1:FileId
    0
  ConverterContext new =:: mut: contextData
  contextData@ =:: context
  program [] .globalOps list.clear program .globalOps= ## global ops are no longer needed
  Operation list.empty =:: mut: tmpOps
  program [] .procedures list.atItr for =:: currentProc
    currentProc [] .isStatic if continue end
    currentProc .implementation .Code .else ..drop
      continue
    end =:: impl
    tmpOps list.clear tmpOps=
    currentProc [] .fileId context .currentFile=
    program [] .progFiles
      currentProc [] .fileId i64 cast
    @[] =:: f
    currentProc [] .hasStaticArg if
      impl [] .implementations list.atItr for =:: currentImpl
        currentImpl .codeState [] .UNUSED if
          continue
        end
        ## convertProc
          currentImpl [] .code
          tmpOps@
          currentImpl .variables
          context
        convertProc currentImpl .code=
        ProcCodeState .COMPILED currentImpl .codeState=
      end
    else
      impl .codeState [] .UNUSED if
        continue
      end
      ## convertProc
        impl [] .code
        tmpOps@
        impl .variables
        context
      convertProc impl .code=
      ProcCodeState .COMPILED impl .codeState=
    end
  end
  ## create implementations for built-in procedure-pointers
  program [] .procedures .length for =:: procId
    program [] .procedures procId @[] =:: currentProc
    currentProc .implementation .BuiltIn .else ..drop
      break ## built-ins at start of procedure list
    end =:: builtInImpl
    builtInImpl [] .hasPtr ! if
      continue
    end
    currentProc [] .labelId labelContext id.labelPos .else
      "missing label position" ..panic
    end =:: pos
    4 Operation mem.alloc 4 slice.createMutable =:: opBuffer
    opBuffer list.wrapSlice
      ## opImplementProc
        currentProc [] .procType
        ## ProcedureImpl
          -1
          procId ProcId cast
        ProcedureImpl new
        pos
      opImplementProc list.append
      ## opBuiltIn
        currentProc [] .procType
        builtInImpl [] .builtIn
        pos
      opBuiltIn list.append
      currentProc [] .procType pos opReturn list.append
      BlockType .PROCEDURE pos opEndBlock list.append
    ..drop
    ## CodeProcData
      0 ProcImplementation list.create
      0 VariableInfo list.create
      opBuffer
      0:i16
      ProcCodeState .COMPILED
    CodeProcData new currentProc .implementation .Code=
  end
  tmpOps list.free ..drop
end
