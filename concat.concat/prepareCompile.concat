#+
converts code from pure stack code to code targeting a "real" machine as a
common first step for all compiler back-ends:
* limit size of stack-values
* explicitly create temporary variables for copy/output arguments
+#
import stringIO
import arenaAlloc

import "program.concat"
import "measure.concat"
import "branchTree.concat"
using id.LabelFlag

struct(
  i32 : codeStart
  i32 : codeLength
) =:: ProcPosition

struct(
  ProgramContext ptr.mut : program
  VariableInfo list : mut: variables
  ProcPosition list : mut: newProcPositions
  FileId : mut: currentFile
  i32 : mut: inlineCount
) =:: ConverterContext

proc(
  Type : varType
  bool : mutable
  FilePosition : pos
  ConverterContext ptr.mut : context
-> IdentifierInfo ) =>: newTmpVar
  context [] .program .idContext =:: idContext
  idContext .typeContext .labelContext =:: labelContext
  id.FLAG_NONE mutable if
    id.FLAG_MUTABLE | LabelFlag cast
  end =:: flags
  ## newLabel
    string.empty
    flags ## XXX? special flag for tmp vars
    pos
    context [] .currentFile
    labelContext
  id.newLabel =:: label
  label varType pos idContext id.declareTmpVar
  context [] .variables
    varType label VariableType .TMP_VAR VariableInfo new list.append
  context .variables=
  ## IdInfo
    IdentifierType .TMP_VAR
    label
  IdentifierInfo new return
end

import debug
## TODO? move inlining to seperate optimization pass
proc(
  ProcedureCall : callInfo
  ProgramContext ptr.mut : program
-> Operation slice ) =>: calledProcOps
  program [] .procedures callInfo .procId i64 cast.u @[] =:: procInfo
  program [] .progFiles
    procInfo [] .fileId i64 cast.u
  list.at .data =:: procFile
  procInfo .implementation .code =:: impl
  callInfo .implementationId -1 == if
    procFile [] .localOps
      impl [] .codeStart
      impl [] .codeLength
    list.getSlice $ .length i32 cast impl [] .codeLength == "correct length" assert
  else
    impl [] .implementations callInfo .implementationId @[] =:: callImpl
    procFile [] .localOps
      callImpl [] .codeStart
      callImpl [] .codeLength
    list.getSlice $ .length i32 cast callImpl [] .codeLength == "correct length" assert
  end
end
import debug
proc(
  ProcedureCall : callInfo
  ProgramContext ptr.mut : program
-> bool ) =>: shouldInlineCall
  program .idContext .typeContext .labelContext =:: labelContext
  optimizerFlags.ALLOW_INLINE ! if false return end
  ## TODO allow inlining of small procedures when ALLOW_INLINE_SMALL is set
  program [] .procedures callInfo .procId i64 cast.u @[] =:: procData
  procData [] .isStatic or procData .implementation [] .code ?? ! or
      procData [] .labelId labelContext id.labelFlags id.FLAG_EXTERN & ? if
    false return
  end
  callInfo program calledProcOps =:: procOps
  ## TODO compute inline weight depending on operations in procedure, cache weight in procedure(-impl) info
  procOps .length 16:iSize u<
end
proc(
  Operation list
  ProcedureCall : callInfo
  FilePosition : pos
  ConverterContext ptr.mut : context
-> Operation list ) =>: inlineCall
  context [] .program =:: program
  program .idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  program [] .procedures
    callInfo .procId i64 cast.u @[] .implementation []
  .code ?? "only code-procs are inlined" assert
  callInfo program calledProcOps =:: procOps
  "Inlining procedures is currently experimental" sb.copyPtr pos program .errors appendWarning
  context [] .inlineCount
    $ 1 + context .inlineCount=
  BlockId cast =:: inlineId
  labelHash@ labelEq@ 64 IdentifierInfo map.create =:: mut: remapLabels ## TODO store in context
  BlockType .INLINE_PROCEDURE pos opBlock list.append
  inlineId $1 list.peek .data .val .block .blockId=
  procOps 0 [] .dataType =:: procType
  procType typeContext types.getProcIn .data =:: inTypes
  0 =:: mut: offset
  ## create tmp-variables for named arguments
  inTypes .length i32 cast.u 1 - while $ 0 >= do =:: i
    procType i typeContext types.getProcArgLabel =:: argLabel
    argLabel id.LABEL_ID_NONE == if
      offset 1 + offset=
    else argLabel labelContext id.labelFlags id.FLAG_STATIC & ? ! _if
      ## TODO 1. rotate labeled argument to top
      inTypes i [] =:: eltType
      eltType argLabel labelContext id.labelFlags id.FLAG_MUTABLE & ? pos context newTmpVar =:: tmpId
      eltType tmpId pos opInitializeId list.append
      remapLabels@ argLabel tmpId map.put optional.isEmpty "label-value only reassigned once" assert
    end
  finally i 1 - end ..drop
  procOps 1:iSize $1 .length 2:iSize - slice.getSlice for =:: mut: op
    ## TODO? move remapping to compileOp ( flag to check if within inlined proc )
    op .val .Return ?? if
      inlineId op@ .val .InlineReturn=
      op list.append
      continue
    else op .val .getId ?? _if
      remapLabels@ op .val .getId .labelId map.get =:: newName?
      newName? optional.hasData if newName? .data op@ .val .getId= end
    else op .val .setId ?? _if
      remapLabels@ op .val .setId .labelId map.get =:: newName?
      newName? optional.hasData if newName? .data op@ .val .setId= end
    else op .val .atId ?? _if
      remapLabels@ op .val .atId .labelId map.get =:: newName?
      newName? optional.hasData if newName? .data op@ .val .atId= end
    end
    op context compileOp
  end
  BlockType .INLINE_PROCEDURE pos opEndBlock list.append
  inlineId $1 list.peek .data .val .blockEnd .blockId=
  remapLabels@ map.free
end

proc(
  Operation list : newOps
  Operation : mut: op
  ConverterContext ptr.mut : context
-> Operation list ) =>: compileOp
  context [] .program =:: program
  program .errors =:: errors
  program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  op .val switch
    NOP case
      newOps return ## ignore no-ops
    builtIn equalityOperator procPtr panic panicWithMessage
    checkEnumLabel hasElement getId setId atId getEnumLabel setEnumElement
    setElement RuntimeAssert Error stackMod getElement
    autoCast Cast Cast! bitCast Return case
      newOps
        op list.append ## nothing to change
      return
    implementProcedure case
      op .dataType typeContext types.getProcIn .data =:: args
      args .length i32 cast.u =:: argCount
      context [] .variables
        0:i32 while ..dup argCount < do =:: i
          op .dataType i typeContext types.getProcArgLabel =:: label
          label id.LABEL_ID_NONE == or label labelContext id.labelFlags id.FLAG_STATIC & ? if
            continue
          end
          args i [] =:: argType
          argType typeContext types.isEmpty if continue end
          ## VariableInfo
            argType
            label
            VariableType .ARGUMENT
          VariableInfo new list.append
        finally i 1 + end ..drop
      context .variables=
      newOps
        op list.append ## nothing to change
      return
    declareId initializeId case
      op .val .declareId ?? if
        op .val .declareId
      else
        op .val .initializeId
      end =:: idInfo
      context [] .variables
        ## VariableInfo
          op .dataType
          idInfo .labelId
          VariableType .LOCAL_VAR
        VariableInfo new list.append
      context .variables=
      newOps
        op list.append ## nothing to change
      return
    Constant case
      ## TODO? smarter way to determine when to use const-reference?
      op .dataType typeContext types.referenceOnly ! if
        newOps
          op list.append
        return
      end
      newOps
        op .val .Constant op .dataType op .pos program opConstReference list.append
      return
    copy case
      op .dataType =:: baseType
      ## TODO change to check for reference-only once composite stack values are supported by QBE back-end
      ## baseType typeContext types.referenceOnly ! if
      baseType typeContext types.unwrapNamed types.isPrimitive or
          baseType typeContext types.isPointer if
        newOps return ## primitive copy is no-op
      end
      baseType true op .pos context newTmpVar =:: tmpId
      newOps
        ## opAutoCast
          op .dataType
          0
          baseType
          op .pos
        opAutoCast list.append
        ## opInitializeId
          baseType
          tmpId
          op .pos
        opInitializeId list.append
        ## opGetId
          baseType
          tmpId
          op .pos
        opGetId list.append
      return
    New NewEnum case
      op .dataType typeContext types.referenceOnly ! if
        newOps
          op list.append
        return
      end
      op .dataType true op .pos context newTmpVar =:: tmpId
      newOps
        ## opInitializeId
          op .dataType
          tmpId
          op .pos
        opDeclareId list.append
        ## opAtId
          op .dataType
          tmpId
          op .pos
        opAtId list.append
        op .val .NewEnum ?? if
          op .dataType op .val .NewEnum op .pos opNewEnumReference list.append
        else
          op .dataType op .pos opNewReference list.append
        end
      return
    call callPtr case
      op .val .call ?? and op .val .call program shouldInlineCall if
        newOps op .val .call op .pos context inlineCall return
      end
      op .dataType
        ..dup typeContext types.isPointer if
          typeContext types.getBaseType
        end
      =:: calledType
      ## special handling for pointer-call procedures
      _BACKEND_ .QBE ?? if ## TODO? is special case for QBE needed, ? should this be a check for PTRCALL
        calledType typeContext types.getProcOutArgs =:: outArgs
        op .val .callPtr ?? if
          ## remember number of out-args in call operation
          outArgs .length op@ .val .callPtr .outArgCount=
        end
        newOps
          outArgs for =:: arg
            arg typeContext types.isEmpty if
              continue
            end
            arg true op .pos context newTmpVar =:: tmpId
            ## opDeclareId
              arg
              tmpId
              op .pos
            opDeclareId list.append
            ## opAtId
              arg
              tmpId
              op .pos
            opAtId list.append
          end
          op list.append
        return
      end
      op .val .callPtr ?? if
        op .val .callPtr program getPtrCallData
      else
        op .val .call program getCallData
      end =:: callData
      calledType typeContext types.getCallConvention .PTRCALL ?? =:: isPtrCall
      calledType typeContext types.getProcOut .data =:: outTypes
      false =:: mut: hasLabel
      program [] .labelBuffer
        $ .length 0:iSize == "label buffer is empty before use" assert
        outTypes .length for =:: i
          outTypes i slice.get =:: arg
          arg typeContext types.isEmpty if continue end
          arg typeContext types.referenceOnly or isPtrCall and i outTypes .length 1:iSize - u< if
            true hasLabel=
            arg true op .pos context newTmpVar .labelId
          else
            id.LABEL_ID_NONE
          end list.append
        end
        hasLabel if
          program [] .programMemory
            $1 mixedArena.copyList callData .retValueLocations=
          program .programMemory=
        end
        list.clear
      program .labelBuffer=
      newOps
        op list.append
      return
    ## XXX merge identical variables on independent branches
    block case
      op .val .block .blockId =:: blockId
      op .val .block .blockType switch
        AND_IF case
          blockId
            newOps .length i32 cast.u
          program program.jumps.updateAndIf
          newOps op list.append return
        OR_IF case
          blockId
            newOps .length i32 cast.u
          program program.jumps.updateOrIf
          newOps op list.append return
        IF case
          blockId
            newOps list.asMutableSlice
          program program.jumps.updateIf
          newOps op list.append return
        ELSE case
          blockId
            newOps list.asMutableSlice
          program program.jumps.updateElse
          newOps op list.append return
        SWITCH case
          blockId
            newOps .length i32 cast.u
          program program.jumps.updateSwitch
          newOps op list.append return
        CASE case
          blockId
            newOps .length i32 cast.u
          program program.jumps.updateCase
          newOps op list.append return
        DEFAULT case
          blockId
            newOps .length i32 cast.u
          program program.jumps.updateDefault
          newOps op list.append return
        BREAK_SWITCH case
          blockId
            newOps .length i32 cast.u
          program program.jumps.updateBreakSwitch
          newOps op list.append return
        WHILE case
          blockId
            newOps .length i32 cast.u
          program program.jumps.updateWhile
          newOps op list.append return
        OR_DO case
          blockId
            newOps .length i32 cast.u
          program program.jumps.updateOrDo
          newOps op list.append return
        AND_DO case
          blockId
            newOps .length i32 cast.u
          program program.jumps.updateAndDo
          newOps op list.append return
        DO case
          blockId
            newOps list.asMutableSlice
          program program.jumps.updateDo
          newOps op list.append return
        BREAK case
          blockId
            newOps .length i32 cast.u
          program program.jumps.updateBreak
          newOps op list.append return
        CONTINUE case
          blockId
            newOps .length i32 cast.u
          program program.jumps.updateContinue
          newOps op list.append return
        FINALLY case
          blockId
            newOps list.asMutableSlice
          program program.jumps.updateFinally
          newOps op list.append return
        AND case
          blockId
            newOps .length i32 cast.u
          program program.jumps.updateAnd
          newOps op list.append return
        OR case
          blockId
            newOps .length i32 cast.u
          program program.jumps.updateOr
          newOps op list.append return
        IF_TRUE IF_FALSE AND_TRUE AND_FALSE
        OR_TRUE OR_FALSE ELSE_TRUE ELSE_FALSE
        UNKNOWN INITIALIZER NAMESPACE PROCEDURE INLINE_PROCEDURE
        TYPE_TUPLE TYPE_STRUCT TYPE_ENUM TYPE_UNION TYPE_UNTAGGED_UNION TYPE_TYPESET
            TYPE_PROC_IN TYPE_CPROC_IN TYPE_PROC_ARROW TYPE_COMPOSITE case break
      end
      break
    blockEnd case
      op .val .blockEnd .blockId =:: blockId
      op .val .blockEnd .blockType switch
        PROCEDURE case
          newOps op list.append return
        ELSE case
          blockId
            newOps list.asMutableSlice
          program program.jumps.updateEndIf
          op@ .val .blockEnd .jumpDistance=
          newOps op list.append return
        SWITCH case
          blockId
            newOps list.asMutableSlice
          program program.jumps.updateEndSwitch
          op@ .val .blockEnd .jumpDistance=
          newOps op list.append return
        WHILE case
          blockId
            newOps list.asMutableSlice
          program program.jumps.updateEndWhile
          op@ .val .blockEnd .jumpDistance=
          newOps op list.append return
        AND OR case
          blockId
            newOps list.asMutableSlice
          program program.jumps.updateEndAndOr
          op@ .val .blockEnd .jumpDistance=
          newOps op list.append return
        AND_IF OR_IF AND_DO OR_DO FINALLY INLINE_PROCEDURE
        IF_TRUE IF_FALSE AND_TRUE AND_FALSE
        OR_TRUE OR_FALSE ELSE_TRUE ELSE_FALSE
        UNKNOWN CASE DEFAULT BREAK_SWITCH DO BREAK
        CONTINUE INITIALIZER IF NAMESPACE TYPE_TYPESET
        TYPE_TUPLE TYPE_STRUCT TYPE_ENUM TYPE_UNION TYPE_UNTAGGED_UNION
        TYPE_PROC_IN TYPE_CPROC_IN TYPE_PROC_ARROW TYPE_COMPOSITE case break
      end
      break
    compilerInfo case ## XXX? preserve compilerInfo ops
      newOps return
    autoTypedInitializeId ConstantReference NewReference
    typeInfo NewEnumReference usingNamespace usingIdentifier InlineReturn
    getName atName setName getLabel Assert declareName initializeName StaticConstant
    setLabel length typeModifier hasLabel existsLabel existsName case
      break ## XXX error message
  end
  "unsupported operation " sb.copyPtr
    op program sb.appendOp
  op .pos errors appendError
  newOps return
end

proc(
  Operation slice : ops
  Operation list ptr.mut : newOps
  ProcPosition ptr.mut : codePosition
  VariableInfo list ptr.mut : variables
  ConverterContext ptr.mut : context
-> ) =>: convertProc
  context [] .program =:: program
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  variables [] context .variables=
  newOps []
    $ .length i32 cast.u codePosition .codeStart =[]
    ops for
      context compileOp
    end
    $ .length i32 cast.u codePosition .codeStart [] - codePosition .codeLength =[]
  newOps =[]
  context [] .variables variables =[]
end

## TODO better name for file&procedure, find good description of compilation-step
proc( ProgramContext ptr.mut : program -> ) =>: export: prepareCompile
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  ## ConverterContext
    program
    0 VariableInfo list.create
    program .procedures [] .length ProcPosition list.create
    -1:FileId
    0
  ConverterContext new =:: mut: contextData
  contextData@ =:: context
  program [] .progFiles list.atItr for =:: f
    f [] .tmpOps list.clear f .tmpOps=
    f [] .globalOps list.clear f .globalOps= ## global ops are no longer needed
  end
  program [] .procedures list.atItr for =:: currentProc
    currentProc [] .implementation .code ?? ! or
        currentProc [] .isStatic if
      continue
    end
    currentProc [] .fileId context .currentFile=
    program [] .progFiles
      currentProc [] .fileId i64 cast
    list.at .data =:: f
    currentProc .implementation .code =:: impl
    currentProc [] .hasStaticArg if
      impl [] .implementations list.atItr for =:: currentImpl
        currentImpl .codeState [] .UNUSED ?? if
          continue
        end
        context .newProcPositions []
          -1 -1 ProcPosition new list.append
        context .newProcPositions=
        ## convertProc
          f [] .localOps
            currentImpl [] .codeStart
            currentImpl [] .codeLength
          list.getSlice
          f .tmpOps
          context .newProcPositions [] list.peek .data
          currentImpl .variables
          context
        convertProc
      end
    else
      impl .codeState [] .UNUSED ?? if
        continue
      end
      context .newProcPositions []
        -1 -1 ProcPosition new list.append
      context .newProcPositions=
      ## convertProc
        f [] .localOps impl [] .codeStart impl [] .codeLength list.getSlice
        f .tmpOps
        context .newProcPositions [] list.peek .data
        impl .variables
        context
      convertProc
    end
  end
  ## update operation list
  program [] .progFiles list.atItr for =:: f
    f [] .localOps list.clear
      f [] .tmpOps
      f .localOps=
    f .tmpOps=
  end
  ## update procedure positions
  0 =:: mut: subProcIndex ## TODO is there a better way to ensure that the new ranges are matched up with the current procedues
  ## ? remember new range in procedure data
  program [] .procedures list.atItr for =:: currentProc
    currentProc [] .implementation .code ?? ! or
        currentProc [] .isStatic if
      continue
    end
    currentProc .implementation .code =:: impl
    currentProc [] .hasStaticArg if
      impl [] .implementations list.atItr for =:: currentImpl
        currentImpl .codeState [] .UNUSED ?? if
          continue
        end
        context [] .newProcPositions subProcIndex [] =:: procPos
        procPos .codeStart currentImpl .codeStart=
        procPos .codeLength currentImpl .codeLength=
        subProcIndex 1 + subProcIndex=
      end
    else
      impl .codeState [] .UNUSED ?? if
        continue
      end
      context [] .newProcPositions subProcIndex [] =:: procPos
      procPos .codeStart impl .codeStart=
      procPos .codeLength impl .codeLength=
      subProcIndex 1 + subProcIndex=
    end
  end
  ## create implementations for built-in procedure-pointers
  program [] .procedures .length for =:: procId
    program [] .procedures procId list.at .data =:: currentProc
    currentProc [] .implementation .builtIn ?? ! if
      break ## built-ins at start of procedure list
    end
    currentProc [] .implementation .builtIn .hasPtr ! if
      continue
    end
    program [] .progFiles 0 list.at .data =:: procFile ## XXX? use separate "file" for built-ins
    currentProc [] .labelId labelContext id.labelPos .data =:: pos
    procFile [] .localOps
      ## opImplementProc
        currentProc [] .procType
        ## ProcedureImpl
          -1
          procId ProcId cast
        ProcedureImpl new
        pos
      opImplementProc list.append
      ## opBuiltIn
        currentProc [] .procType
        currentProc [] .implementation .builtIn .builtIn
        pos
      opBuiltIn list.append
      currentProc [] .procType pos opReturn list.append
      BlockType .PROCEDURE pos opEndBlock list.append
    procFile .localOps=
  end
end
