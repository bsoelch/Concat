import mem
import arrayView
import list

namespace: branchTree
  i64 =:: export NodeId

  #template type : T #end
  struct(
    T : mut data
    NodeId : parent
    i64 : level
    bool : mut deleted
  ) =:: export Node
end

#template type : T #end
struct(
  branchTree.NodeId : mut branchHead
  branchTree.NodeId list : mut branchPoints
  T branchTree.Node list : mut nodes
) =:: export BranchTree

namespace: branchTree
  #template type : T #end
  proc( -> T BranchTree ) =>: export create
    ## BranchTree
      -1
      32 branchTree.NodeId list.create
      32 T branchTree.Node list.create
    T BranchTree new
  end
  #template type : T #end
  proc( T BranchTree ptr mut : tree -> ) =>: export clear
    -1 tree [] .branchHead =
    tree [] .branchPoints
      list.clear
    tree [] .branchPoints =
    tree [] .nodes
      list.clear
    tree [] .nodes =
  end
  #template type : T #end
  proc( T BranchTree ptr mut : tree -> ) =>: export free
    -1 tree [] .branchHead =
    tree [] .branchPoints
      list.free
    tree [] .branchPoints =
    tree [] .nodes
      list.free
    tree [] .nodes =
  end
  
  #template type : T #end
  struct(
   T BranchTree ptr mut : tree
   NodeId : id
  ) =:: export BranchItr
  
  namespace: itr
    #template type : T #end
    proc( T BranchTree ptr mut : tree -> T BranchItr ) =>: export start
      tree tree [] .branchHead T BranchItr new
    end
    #template type : T #end
    proc( T BranchItr : itr -> T BranchItr bool ) =>: export hasNext
      itr .id 0 < itr .id itr .tree [] .nodes .length >= | if
        itr false return
      end
      itr itr .tree [] .nodes itr .id list.at .data [] .deleted ! return
    end
    #template type : T #end
    proc( T BranchItr : itr -> T BranchItr T ptr ) =>: export next
      itr .tree [] .nodes itr .id list.at .data =:: node
      ## return
        itr .tree node [] .parent T BranchItr new
      node [] .data @ return
    end
    #template type : T #end
    proc( T BranchItr : itr -> T BranchItr T ptr ) =>: export peekNext
      itr .tree [] .nodes itr .id list.at .data =:: node
      itr node [] .data @ return
    end
    #template type : T #end
    proc( T BranchItr : itr -> T BranchItr ) =>: export skipNext
      itr .tree [] .nodes itr .id list.at .data =:: node
      itr .tree node [] .parent T BranchItr new return
    end
  end

  #template type : T #end
  proc( T BranchTree ptr mut : tree NodeId : id -> ) =>: export unlinkNode
    tree [] .branchPoints .length 0 > if
     id tree [] .branchPoints ..dup .length 1 - list.get < _if
      return ## node still on different branch
    end
    id tree [] .nodes .length 1 - != if
      true tree [] .nodes id list.at .data [] .deleted =
      return
    end
    id 1 - while ..dup 0 >= do
      tree [] .nodes ..over list.at .data [] .deleted ! if
        break
      end
      1 -
    end 1 + =:: newLength
    newLength tree [] .nodes .length =
  end
  #template type : T #end
  proc( T BranchTree : tree -> i64 ) =>: export depth
    tree tree .branchHead depthFrom return
  end
  #template type : T #end
  proc( T BranchTree : tree NodeId : root -> i64 ) =>: export depthFrom
    root -1 == if
      0 return
    end
    tree .nodes
      root
    list.at .data [] .level return
  end
  #template type : T #end
  proc( T BranchTree ptr mut : tree -> NodeId ) =>: export startBranch
    tree [] .branchPoints
      tree [] .nodes .length NodeId cast list.append
    tree [] .branchPoints =
    tree [] .branchHead return
  end
  #template type : T #end
  proc( T BranchTree ptr mut : tree -> ) =>: export endBranch
    tree [] .branchPoints .length
      1 -
    tree [] .branchPoints .length =
  end
  #template type : T #end
  proc( T BranchTree ptr mut : tree NodeId : branchPoint -> NodeId ) =>: export reset
    tree [] .branchHead =:: oldHead
      branchPoint tree [] .branchHead =
    oldHead return
  end
  #template type : T #end
  proc( T BranchTree ptr mut : tree T : value -> ) =>: export push
    tree [] .branchHead -1 == if
      1i64
    else
      tree [] .nodes
        tree [] .branchHead
      list.at .data [] .level 1 +
    end =:: level
    value tree [] .branchHead level false T Node new =:: newNode
    tree [] .nodes .length =:: newId
    tree [] .nodes
      newNode list.append
    tree [] .nodes =
    newId tree [] .branchHead =
  end
  #template type : T #end
  proc( T BranchTree ptr mut : tree -> T ptr mut optional ) =>: export peek
    tree [] .branchHead =:: nodeId
    nodeId 0 < nodeId tree [] .nodes .length >= | if
      T ptr mut optional.empty return
    end
    tree [] .nodes nodeId list.at
      .data [] .data @
    optional.wrap return
  end
  #template type : T #end
  proc( T BranchTree ptr mut : tree i32 : index -> T ptr mut optional ) =>: export at
    tree [] .branchHead =:: mut nodeId
    index while
      nodeId 0 < nodeId tree [] .nodes .length >= | if ..drop
        T ptr mut optional.empty return
      end
    ..dup 0 > do
      tree [] .nodes nodeId list.at .data [] .parent nodeId =
      1 -
    end ..drop
    tree [] .nodes nodeId list.at
      .data [] .data @
    optional.wrap return
  end
  #template type : T #end
  proc( T BranchTree ptr mut : tree -> T ptr mut optional ) =>: export pop
    tree [] .branchHead =:: nodeId
    nodeId 0 < nodeId tree [] .nodes .length >= | if
      T ptr mut optional.empty return
    end
    tree [] .nodes nodeId list.at .data =:: popped
    popped [] .parent tree [] .branchHead =
    ## unlink node, node stays available until new node is added
    tree nodeId unlinkNode
    popped [] .data @ optional.wrap return
  end
  #template type : T #end
  proc( T BranchTree ptr mut : tree -> ) =>: export swap
    tree pop .data [] =:: upper
    tree pop .data [] =:: lower
    tree upper push
    tree lower push
  end
  ## remove all nodes from current branch
  #template type : T #end
  proc( T BranchTree ptr mut : tree -> ) =>: export prune
    tree [] .branchHead =:: mut nodeId
    while nodeId 0 >= nodeId tree [] .nodes .length < & do
      tree [] .nodes nodeId list.at .data =:: popped
      popped [] .parent
        tree nodeId unlinkNode
      nodeId =
    end
    nodeId tree [] .branchHead =
  end

  #template type : T type : C #end
  proc(
    T BranchTree ptr mut : tree
    NodeId arrayView : branchHeads
    bool : mergeBranches
    proc( T ptr arrayView : types i64 : offset C : context -> T ) ptr : mergeValues
    C : context
  -> bool ) =>: export merge
    branchHeads .length 1 <= if
      false return ## nothing to merge
    end
    -1i64 =:: mut initDepth
    -1i64 =:: mut parentId
    false =:: mut needMerge
    0 while ..dup branchHeads .length < do
      branchHeads ..over array.get =:: nodeId
      nodeId -1 < nodeId tree [] .nodes .length >= | if ## id=-1 or 0 <= id < length
        ..drop
        true return ## nodeId invalid
      end
      nodeId -1 == if
        0i64
      else
        tree [] .nodes nodeId list.at .data [] .level
      end =:: nodeDepth
      initDepth -1 == if
         nodeDepth initDepth =
      else nodeDepth initDepth != _if
        ..drop
        true return ## nodes on top level have different depths
      end
      parentId -1 == if
        nodeId parentId =
      else nodeId parentId != _if
        ## not already merged
        true needMerge =
      end
      1 +
    end ..drop
    needMerge ! if
      false return ## heads identical -> no merge necessary
    end
    ## create mutable copy of heads
    branchHeads .length =:: headCount
    headCount NodeId mem.alloc =:: heads
    heads branchHeads .data headCount mem.copy ..drop
    headCount T ptr mem.alloc =:: buffer
    0 =:: mut offset
    while
      tree [] .nodes heads 0 [] list.at .data =:: root
      root [] .parent parentId =
      root [] .data @ buffer 0 [] =
      parentId heads 0 [] =
      false needMerge =
      1 =:: mut i while i headCount < do
        tree [] .nodes heads i [] list.at .data =:: next
        next [] .parent parentId != if
          true needMerge =
        end
        next [] .data @ buffer i [] =
        mergeBranches if
          tree heads i [] unlinkNode
        end
        next [] .parent heads i [] =
        i 1 + i =
      end
      ## mergeValues
        buffer headCount array.create
        offset
        context
      mergeValues () root [] .data =
      offset 1 + offset =
    needMerge do end
    branchHeads 0 array.get tree [] .branchHead =
    ## cleanup
    buffer mem.free
    heads mem.free
    false return
  end
end
