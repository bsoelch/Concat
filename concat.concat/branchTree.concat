  proc( T BranchTree ptr mut : tree -> ) =>: export: clear
  #:else
  proc( type : auto: T T BranchTree ptr mut : tree -> ) =>: export: clear
  #:end
    -1 tree [] .branchHead =
    tree [] .nodes
      list.clear
    tree [] .nodes =
  end
  #:ifnot:exp
  #template type : T #end
  proc( T BranchTree ptr mut : tree -> ) =>: export: free
  #:else
  proc( type : auto: T T BranchTree ptr mut : tree -> ) =>: export: free
  #:end
    -1 tree [] .branchHead =
    tree [] .nodes
      list.free
    tree [] .nodes =
  end

