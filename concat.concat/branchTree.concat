  namespace: itr
    #:ifnot:exp
    #template type : T #end
    proc( T BranchTree ptr mut : tree -> T BranchItr ) =>: export: start
    #:else
    proc( type : auto: T T BranchTree ptr mut : tree -> T BranchItr ) =>: export: start
    #:end
      tree tree [] .branchHead T BranchItr new
    end
    #:ifnot:exp
    #template type : T #end
    proc( T BranchItr : itr -> T BranchItr bool ) =>: export: hasNext
    #:else
    proc( type : auto: T T BranchItr : itr -> T BranchItr bool ) =>: export: hasNext
    #:end
      itr .id 0 < itr .id itr .tree [] .nodes .length >= | if
        itr false return
      end
      itr itr .tree [] .nodes itr .id list.at .data [] .childCount 0 > return
    end
    #:ifnot:exp
    #template type : T #end
    proc( T BranchItr : itr -> T BranchItr T ptr ) =>: export: next
    #:else
    proc( type : auto: T T BranchItr : itr -> T BranchItr T ptr ) =>: export: next
    #:end
      itr .tree [] .nodes itr .id list.at .data =:: node
      ## return
        itr .tree node [] .parent T BranchItr new
      node [] .data @ return
    end
    #:ifnot:exp
    #template type : T #end
    proc( T BranchItr : itr -> T BranchItr T ptr ) =>: export: peekNext
    #:else
    proc( type : auto: T T BranchItr : itr -> T BranchItr T ptr ) =>: export: peekNext
    #:end
      itr .tree [] .nodes itr .id list.at .data =:: node
      itr node [] .data @ return
    end
    #:ifnot:exp
    #template type : T #end
    proc( T BranchItr : itr -> T BranchItr ) =>: export: skipNext
    #:else
    proc( type : auto: T T BranchItr : itr -> T BranchItr ) =>: export: skipNext
    #:end
      itr .tree [] .nodes itr .id list.at .data =:: node
      itr .tree node [] .parent T BranchItr new return
    end
  end

  #:ifnot:exp
  #template type : T #end
  proc( T BranchTree ptr mut : tree NodeId : id -> ) =>: export: unlinkNode
  #:else
  proc(
    type : auto: T
    T BranchTree ptr mut : tree
    NodeId : id
  -> ) =>: export: unlinkNode
  #:end
    tree [] .nodes id list.at .data =:: node
    ## TODO find out if nodes with zero-child count existing is a bug
    node [] .childCount 0 > if
      node [] .childCount
        1 -
      node [] .childCount =
    end
    id tree [] .nodes .length 1 - != if
      return
    end
    tree [] .nodes .length 1 - while ..dup 0 >= do =:: i
      tree [] .nodes i list.at .data [] .childCount 0 > if
        i break
      end
      i 1 -
    end 1 + =:: newLength
    tree [] .nodes
      newLength list.setLength
    tree [] .nodes =
  end
  #:ifnot:exp
  #template type : T #end
  proc( T BranchTree : tree -> i64 ) =>: export: depth
  #:else
  proc(
    type : auto: T
    T BranchTree : tree
  -> i64 ) =>: export: depth
  #:end
    tree tree .branchHead depthFrom return
  end
  #:ifnot:exp
  #template type : T #end
  proc( T BranchTree : tree NodeId : root -> i64 ) =>: export: depthFrom
  #:else
  proc(
    type : auto: T
    T BranchTree : tree
    NodeId : root
  -> i64 ) =>: export: depthFrom
  #:end
    root -1 == if
      0 return
    end
    tree .nodes
      root
    list.at .data [] .level return
  end
  #:ifnot:exp
  #template type : T #end
  proc( T BranchTree ptr mut : tree -> NodeId ) =>: export: startBranch
  #:else
  proc(
    type : auto: T
    T BranchTree ptr mut : tree
  -> NodeId ) =>: export: startBranch
  #:end
    tree check
    tree [] .branchHead -1 != if
      tree [] .nodes tree [] .branchHead list.at .data =:: node
      node [] .childCount
        1 +
      node [] .childCount =
    end
    tree [] .branchHead return
  end
  ## remove all nodes from current branch
  #:ifnot:exp
  #template type : T #end
  proc( T BranchTree ptr mut : tree -> ) =>: export: prune
  #:else
  proc(
    type : auto: T
    T BranchTree ptr mut : tree
  -> ) =>: export: prune
  #:end
    tree tree [] .branchHead endBranch
    -1 tree [] .branchHead =
  end
  #:ifnot:exp
  #template type : T #end
  proc( T BranchTree ptr mut : tree NodeId : id -> ) =>: export: endBranch
  #:else
  proc(
    type : auto: T
    T BranchTree ptr mut : tree
    NodeId : id
  -> ) =>: export: endBranch
  #:end
    id =:: mut: nodeId
    while nodeId 0 >= nodeId tree [] .nodes .length < & do
      tree [] .nodes nodeId list.at .data =:: node
      tree nodeId unlinkNode
      node [] .childCount 0 > if
        break
      end
      node [] .parent nodeId =
    end
  end
  #:ifnot:exp
  #template type : T #end
  proc( T BranchTree ptr mut : tree NodeId : branchPoint -> NodeId ) =>: export: reset
  #:else
  proc(
    type : auto: T
    T BranchTree ptr mut : tree
    NodeId : branchPoint
  -> NodeId ) =>: export: reset
  #:end
    tree check
    tree [] .branchHead =:: oldHead
      branchPoint tree [] .branchHead =
      branchPoint -1 != if
        tree [] .nodes branchPoint list.at .data =:: node
        node [] .childCount
          1 +
        node [] .childCount =
      end
      tree check
    oldHead return
  end
  #:ifnot:exp
  #template type : T #end
  proc( T BranchTree ptr mut : tree T : value -> ) =>: export: push
  #:else
  proc(
    type : auto: T
    T BranchTree ptr mut : tree
    T : value
  -> ) =>: export: push
  #:end
    tree [] .branchHead -1 == if
      1i64
    else
      tree [] .nodes
        tree [] .branchHead
      list.at .data [] .level 1 +
    end =:: level
    ## no change of child-count for head as head field counts as child
    value tree [] .branchHead level 1 T Node new =:: newNode
    tree [] .nodes .length =:: newId
    tree [] .nodes
      newNode list.append
    tree [] .nodes =
    newId tree [] .branchHead =
  end

  #:ifnot:exp
  #template type : T #end
  proc( T BranchTree ptr mut : tree -> T ptr optional ) =>: export: peek
  #:else
  proc(
    type : auto: T
    T BranchTree ptr mut : tree
  -> T ptr optional ) =>: export: peek
  #:end
    tree 0 at return
  end
  ## returns a pointer to the stack element at the given index (0-indexed from top)
  #:ifnot:exp
  #template type : T #end
  proc( T BranchTree ptr mut : tree i32 : index -> T ptr optional ) =>: export: at
  #:else
  proc(
    type : auto: T
    T BranchTree ptr mut : tree
    i32 : index
  -> T ptr optional ) =>: export: at
  #:end
    tree [] .branchHead =:: mut: nodeId
    index while
      nodeId 0 < nodeId tree [] .nodes .length >= | if ..drop
        T ptr optional.empty return
      end
    ..dup 0 > do
      tree [] .nodes nodeId list.at .data [] .parent nodeId =
      1 -
    end ..drop
    tree [] .nodes nodeId list.at
      .data [] .data @ T ptr cast
    optional.wrap return
  end
  ## returns a mutable pointer to the stack element at the given index (0-indexed from top), writing to the returned pointer will only modify the current branch
  #:ifnot:exp
  #template type : T #end
  proc( T BranchTree ptr mut : tree i32 : index -> T ptr mut optional ) =>: export: replaceAt
  #:else
  proc(
    type : auto: T
    T BranchTree ptr mut : tree
    i32 : index
  -> T ptr mut optional ) =>: export: replaceAt
  #:end
    tree [] .branchHead =:: mut: nodeId
    false =:: mut: needCopy
    index while
      nodeId 0 < nodeId tree [] .nodes .length >= | if ..drop
        T ptr mut optional.empty return
      end
    ..dup 0 > do
      tree [] .nodes nodeId list.at .data =:: nodeData
      nodeData [] .childCount 1 > if
        true needCopy = ## node on multiple branches
      end
      nodeData [] .parent nodeId =
      1 -
    end ..drop
    needCopy ! if
        tree [] .nodes nodeId list.at .data =:: node
        node [] .childCount 1 <= _if
      node [] .data @ optional.wrap return
    end
    ## copy branch to prevent modification of other branches
    ## TODO keep part of tree only present in current branch
    ##   ( all nodes between head and first node with > 1 child )
    tree [] .branchHead =:: oldHead
    tree [] .nodes
      tree [] .branchHead
    list.at .data =:: mut: currentNode
    currentNode [] =:: mut: newNode
    tree [] .nodes .length tree [] .branchHead =
    1 newNode .childCount =
    tree [] .nodes .length nodeId =
    tree [] .nodes
      newNode list.append
    tree [] .nodes =
    index while ..dup 0 > do 1 -
      tree [] .nodes nodeId list.at .data currentNode =
      tree [] .nodes
        currentNode [] .parent list.at .data []
      newNode =
      tree [] .nodes .length currentNode [] .parent =
      tree [] .nodes .length nodeId =
      1 newNode .childCount =
      tree [] .nodes
        newNode list.append
      tree [] .nodes =
    end ..drop
    tree [] .nodes nodeId list.at .data currentNode =
    currentNode [] .parent 0 >= if
      tree [] .nodes
        currentNode [] .parent
      list.at .data =:: parentNode
      parentNode [] .childCount
        1 +
      parentNode [] .childCount =
    end
    tree oldHead endBranch ## remove old head from branch
    tree [] .nodes nodeId list.at
      .data [] .data @
    optional.wrap return
  end
  #:ifnot:exp
  #template type : T #end
  proc( T BranchTree ptr mut : tree -> T ptr optional ) =>: export: pop
  #:else
  proc(
    type : auto: T
    T BranchTree ptr mut : tree
  -> T ptr optional ) =>: export: pop
  #:end
    tree [] .branchHead =:: nodeId
    tree check
    nodeId 0 < nodeId tree [] .nodes .length >= | if
      T ptr optional.empty return
    end
    tree [] .nodes nodeId list.at .data =:: popped
    popped [] .parent tree [] .branchHead =
    popped [] .childCount 1 > if ## popped node stays child
      tree [] .branchHead 0 >= if
        tree [] .nodes tree [] .branchHead list.at .data =:: newNode
        newNode [] .childCount
          1 +
        newNode [] .childCount =
      end
    end
    tree nodeId unlinkNode
    tree check
    popped [] .data @ T ptr cast optional.wrap return
  end
  #:ifnot:exp
  #template type : T #end
  proc( T BranchTree ptr mut : tree -> ) =>: export: swap
  #:else
  proc(
    type : auto: T
    T BranchTree ptr mut : tree
  -> ) =>: export: swap
  #:end
    tree check
    tree pop .data [] =:: upper
    tree pop .data [] =:: lower
    tree upper push
    tree lower push
    tree check
  end

  enum( error i32 : success ) =:: MergeResult
  #:ifnot:exp
  #template type : T type : C #end
  proc(
    T BranchTree ptr mut : tree
    NodeId arrayView : branchHeads ## should be non-empty
    proc( T ptr arrayView : types i64 : offset C : context -> T ) ptr : mergeValues
    C : context
  -> MergeResult ) =>: export: merge
  #:else
  proc(
    type : auto: T
    type : auto: C
    T BranchTree ptr mut : tree
    NodeId arrayView : branchHeads ## should be non-empty
    proc( T ptr arrayView : types i64 : offset C : context -> T ) ptr : mergeValues
    C : context
  -> MergeResult ) =>: export: merge
  #:end
    tree check
    branchHeads .length 0 <= if
      MergeResult .error return
    end
    tree prune ## discard current branch
    ## no update of child count necessary (loose link to branch, gain link to head)
    branchHeads .length 1 == if
      ## move head to first branch
      branchHeads 0 array.get tree [] .branchHead =
      tree check
      0 MergeResult .success return ## nothing to merge
    end
    -1i64 =:: mut: initDepth
    -1i64 =:: mut: parentId
    false =:: mut: needMerge
    0 while ..dup branchHeads .length < do
      branchHeads ..over array.get =:: nodeId
      nodeId -1 < nodeId tree [] .nodes .length >= | if ## id=-1 or 0 <= id < length
        ..drop
        MergeResult .error return ## nodeId invalid
      end
      nodeId -1 == if
        0i64
      else
        tree [] .nodes nodeId list.at .data =:: nodeData
        nodeData [] .childCount
          1 -
        nodeData [] .childCount =
        nodeData [] .level
      end =:: nodeDepth
      initDepth -1 == if
         nodeDepth initDepth =
      else nodeDepth initDepth != _if
        ..drop
        ## nodes on top level have different depths
        MergeResult .error return
      end
      parentId -1 == if
        nodeId parentId =
      else nodeId parentId != _if
        ## not already merged
        true needMerge =
      end
      1 +
    end ..drop
    needMerge ! if
      ## move head to first branch
      branchHeads 0 array.get tree [] .branchHead =
      ## remember link to head in node
      tree [] .branchHead -1 != if
        tree [] .nodes
          tree [] .branchHead
        list.at .data =:: newHead
        newHead [] .childCount
          1 +
        newHead [] .childCount =
      end
      tree check
      ## heads identical -> no merge necessary
      0 MergeResult .success return
    end
    tree [] .nodes .length tree [] .branchHead =
    tree [] .nodes
       tree [] .nodes
         branchHeads 0 array.get
       list.at .data list.appendP
    tree [] .nodes =
    tree [] .nodes list.peek .data =:: mut: currentNode
    1 currentNode [] .childCount =
    ## create mutable copy of heads
    branchHeads .length =:: headCount
    headCount NodeId mem.alloc =:: heads
    heads branchHeads .data headCount mem.copy ..drop
    headCount T ptr mem.alloc =:: buffer
    0 =:: mut: offset
    while
      tree [] .nodes heads 0 [] list.at .data =:: root
      root [] .parent parentId =
      root [] .data @ buffer 0 [] =
      ## store parent node before unlinking child
      parentId 0 >= if
        tree [] .nodes parentId list.get optional.wrap
      else
        T Node optional.empty
      end =:: parentNode
      root [] .childCount 0 == if
        tree heads 0 [] unlinkNode
      end
      parentId heads 0 [] =
      false needMerge =
      1 =:: mut: i while i headCount < do
        tree [] .nodes heads i [] list.at .data =:: next
        next [] .parent parentId != if
          true needMerge =
        end
        next [] .data @ buffer i [] =
        next [] .childCount 0 == if
          ## TODO? are the child counts updated correctly
          tree heads i [] unlinkNode
        end
        next [] .parent heads i [] =
        i 1 + i =
      end
      ## mergeValues
        buffer headCount array.create
        offset
        context
      mergeValues () currentNode [] .data =
      offset 1 + offset =
    needMerge do
      tree [] .nodes .length currentNode [] .parent =
      tree [] .nodes
         parentNode .data list.append
      tree [] .nodes =
      tree [] .nodes list.peek .data currentNode =
      1 currentNode [] .childCount =
    end
    ## cleanup
    buffer mem.free
    heads mem.free
    tree check
    offset MergeResult .success return
  end
end
