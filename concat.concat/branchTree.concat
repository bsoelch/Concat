import mem
import slice
import list

namespace: branchTree
  i32 =:: export: NodeId
  -1:NodeId =:: export: EMPTY
  ( type : T -> type ) =>: export: Node
    struct(
      T : mut: data
      NodeId : mut: parent
      i32 : level
      i32 : mut: childCount
    )
  end
end

( type : T -> type ) =>: export: BranchTree
  struct(
    branchTree.NodeId : mut: branchHead
    T branchTree.Node list : mut: nodes
  )
end

namespace: branchTree
  ## check if childCount > 0 for all nodes on current branch
  proc( type : auto: T T BranchTree ptr : tree -> ) =>: export: check
    tree tree [] .branchHead checkNode
  end
  proc( type : auto: T T BranchTree ptr : tree NodeId : root -> ) =>: export: checkNode
    root i32 cast =:: mut: nodeId
    while nodeId 0 >= do
      tree [] .nodes nodeId list.at .data =:: node
      node [] .childCount 0 > "positive child count" assert
      node [] .parent i32 cast nodeId=
    end
  end

  proc( type : T -> T BranchTree ) =>: export: create
    ## BranchTree
      EMPTY
      32 T branchTree.Node list.create
    T BranchTree new
  end
  proc( type : auto: T T BranchTree ptr.mut : tree -> ) =>: export: clear
    EMPTY tree .branchHead=
    tree [] .nodes
      list.clear
    tree .nodes=
  end
  proc( type : auto: T T BranchTree ptr.mut : tree -> ) =>: export: free
    EMPTY tree .branchHead=
    tree [] .nodes
      list.free
    tree .nodes=
  end

  ( type : T -> type ) =>: export: BranchItr
    struct(
      T BranchTree ptr.mut : tree
      NodeId : id
    )
  end

  namespace: itr
    proc( type : auto: T T BranchTree ptr.mut : tree -> T BranchItr ) =>: export: start
      tree tree [] .branchHead T BranchItr new
    end
    proc( type : auto: T T BranchItr : itr -> T BranchItr bool ) =>: export: hasNext
      itr .id i32 cast 0 < or itr .id i32 cast itr .tree [] .nodes .length >= if
        itr false return
      end
      itr itr .tree [] .nodes itr .id i32 cast list.at .data [] .childCount 0 > return
    end
    proc( type : auto: T T BranchItr : itr -> T BranchItr T ptr ) =>: export: next
      itr .tree [] .nodes itr .id i32 cast list.at .data =:: node
      ## return
        itr .tree node [] .parent T BranchItr new
      node .data return
    end
    proc( type : auto: T T BranchItr : itr -> T BranchItr T ptr ) =>: export: peekNext
      itr .tree [] .nodes itr .id i32 cast list.at .data =:: node
      itr node .data return
    end
    proc( type : auto: T T BranchItr : itr -> T BranchItr ) =>: export: skipNext
      itr .tree [] .nodes itr .id i32 cast list.at .data =:: node
      itr .tree node [] .parent T BranchItr new return
    end
  end

  proc(
    type : auto: T
    T BranchTree ptr.mut : tree
    NodeId : id
  -> ) =>: export: unlinkNode
    tree [] .nodes id i32 cast list.at .data =:: node
    ## TODO find out if nodes with zero-child count existing is a bug
    node [] .childCount 0 > if
      node [] .childCount
        1 -
      node .childCount=
    end
    id i32 cast tree [] .nodes .length 1 - != if
      return
    end
    tree [] .nodes .length 1 - while ..dup 0 >= do =:: i
      tree [] .nodes i list.at .data [] .childCount 0 > if
        i break
      end
      i 1 -
    end 1 + =:: newLength
    tree [] .nodes
      newLength list.setLength
    tree .nodes=
  end
  proc(
    type : auto: T
    T BranchTree : tree
  -> i32 ) =>: export: depth
    tree tree .branchHead depthFrom return
  end
  proc(
    type : auto: T
    T BranchTree : tree
    NodeId : root
  -> i32 ) =>: export: depthFrom
    root EMPTY == if
      0 return
    end
    tree .nodes
      root i32 cast
    list.at .data [] .level return
  end
  proc(
    type : auto: T
    T BranchTree ptr.mut : tree
  -> NodeId ) =>: export: startBranch
    tree check
    tree [] .branchHead EMPTY != if
      tree [] .nodes tree [] .branchHead i32 cast list.at .data =:: node
      node [] .childCount
        1 +
      node .childCount=
    end
    tree [] .branchHead return
  end
  ## remove all nodes from current branch
  proc(
    type : auto: T
    T BranchTree ptr.mut : tree
  -> ) =>: export: prune
    tree tree [] .branchHead endBranch
    EMPTY tree .branchHead=
  end
  proc(
    type : auto: T
    T BranchTree ptr.mut : tree
    NodeId : id
  -> ) =>: export: endBranch
    id i32 cast =:: mut: nodeId
    while nodeId 0 >= and nodeId tree [] .nodes .length < do
      tree [] .nodes nodeId list.at .data =:: node
      tree nodeId NodeId cast unlinkNode
      node [] .childCount 0 > if
        break
      end
      node [] .parent i32 cast nodeId=
    end
  end
  proc(
    type : auto: T
    T BranchTree ptr.mut : tree
    NodeId : branchPoint
  -> NodeId ) =>: export: reset
    tree check
    tree [] .branchHead =:: oldHead
      branchPoint tree .branchHead=
      branchPoint EMPTY != if
        tree [] .nodes branchPoint i32 cast list.at .data =:: node
        node [] .childCount
          1 +
        node .childCount=
      end
      tree check
    oldHead return
  end
  proc(
    type : auto: T
    T BranchTree ptr.mut : tree
    T : value
  -> ) =>: export: push
    tree [] .branchHead EMPTY == if
      1:i32
    else
      tree [] .nodes
        tree [] .branchHead i32 cast
      list.at .data [] .level 1 +
    end =:: level
    ## no change of child-count for head as head field counts as child
    value tree [] .branchHead level 1 T Node new =:: newNode
    tree [] .nodes .length NodeId cast =:: newId
    tree [] .nodes
      newNode list.append
    tree .nodes=
    newId tree .branchHead=
  end

  proc(
    type : auto: T
    T BranchTree ptr.mut : tree
  -> T ptr.mut optional ) =>: export: peek
    tree 0 at return
  end
  ## returns a pointer to the stack element at the given index (0-indexed from top)
  proc(
    type : auto: T
    T BranchTree ptr.mut : tree
    i32 : index
  -> T ptr.mut optional ) =>: export: at
    tree [] .branchHead i32 cast =:: mut: nodeId
    index while
      nodeId 0 < or nodeId tree [] .nodes .length >= if ..drop
        T ptr.mut optional.empty return
      end
    ..dup 0 > do
      tree [] .nodes nodeId list.at .data [] .parent i32 cast nodeId=
      1 -
    end ..drop
    tree [] .nodes nodeId list.at
      .data .data T ptr.mut cast
    optional.wrap return
  end
  ## returns a mutable pointer to the stack element at the given index (0-indexed from top), writing to the returned pointer will only modify the current branch
  proc(
    type : auto: T
    T BranchTree ptr.mut : tree
    i32 : index
  -> T ptr.mut optional ) =>: export: replaceAt
    tree [] .branchHead i32 cast =:: mut: nodeId
    false =:: mut: needCopy
    index while
      nodeId 0 < or nodeId tree [] .nodes .length >= if ..drop
        T ptr.mut optional.empty return
      end
    ..dup 0 > do
      tree [] .nodes nodeId list.at .data =:: nodeData
      nodeData [] .childCount 1 > if
        true needCopy= ## node on multiple branches
      end
      nodeData [] .parent i32 cast nodeId=
      1 -
    end ..drop
    needCopy ! and
        tree [] .nodes nodeId list.at .data =:: node
        node [] .childCount 1 <= if
      node .data optional.wrap return
    end
    ## copy branch to prevent modification of other branches
    ## TODO keep part of tree only present in current branch
    ##   ( all nodes between head and first node with > 1 child )
    tree [] .branchHead =:: oldHead
    tree [] .nodes
      tree [] .branchHead i32 cast
    list.at .data =:: mut: currentNode
    currentNode [] =:: mut: newNode
    tree [] .nodes .length NodeId cast tree .branchHead=
    1 newNode@ .childCount=
    tree [] .nodes .length nodeId=
    tree [] .nodes
      newNode list.append
    tree .nodes=
    index while ..dup 0 > do 1 -
      tree [] .nodes nodeId list.at .data currentNode=
      tree [] .nodes
        currentNode [] .parent i32 cast list.at .data []
      newNode=
      tree [] .nodes .length NodeId cast currentNode .parent=
      tree [] .nodes .length nodeId=
      1 newNode@ .childCount=
      tree [] .nodes
        newNode list.append
      tree .nodes=
    end ..drop
    tree [] .nodes nodeId list.at .data currentNode=
    currentNode [] .parent EMPTY != if
      tree [] .nodes
        currentNode [] .parent i32 cast
      list.at .data =:: parentNode
      parentNode [] .childCount
        1 +
      parentNode .childCount=
    end
    tree oldHead endBranch ## remove old head from branch
    tree [] .nodes nodeId list.at
      .data .data
    optional.wrap return
  end
  proc(
    type : auto: T
    T BranchTree ptr.mut : tree
  -> T ptr optional ) =>: export: pop
    tree [] .branchHead i32 cast =:: nodeId
    tree check
    nodeId 0 < or nodeId tree [] .nodes .length >= if
      T ptr optional.empty return
    end
    tree [] .nodes nodeId list.at .data =:: popped
    popped [] .parent tree .branchHead=
    popped [] .childCount 1 > if ## popped node stays child
      tree [] .branchHead EMPTY != if
        tree [] .nodes tree [] .branchHead i32 cast list.at .data =:: newNode
        newNode [] .childCount
          1 +
        newNode .childCount=
      end
    end
    tree nodeId NodeId cast unlinkNode
    tree check
    popped .data T ptr cast optional.wrap return
  end
  proc(
    type : auto: T
    T BranchTree ptr.mut : tree
    i32 : eltCount
    bool : rotateLeft
  -> ) =>: export: rotate
    tree check
    eltCount tree [] depth <= "stack is large enough" assert
    eltCount 3 <= if
      T 3 array : buffer
      buffer@ list.wrapBuffer
    else
      eltCount T list.create
    end
      eltCount for ..drop
          tree branchTree.pop .data [] list.append
      end
      rotateLeft if
        list.pop =:: lowValue
        $ .length for ..drop
          list.pop tree >$ branchTree.push
        end
        tree lowValue branchTree.push
      else
        tree $1 0 [] branchTree.push
        $ .length 1 - for ..drop
          list.pop tree >$ branchTree.push
        end
      end
    list.free ..drop
    tree check
  end

  union( _ : error i32 : success ) =:: MergeResult
  proc(
    type : auto: T
    type : auto: C
    T BranchTree ptr.mut : tree
    NodeId slice : branchHeads ## should be non-empty
    proc( T ptr slice : types i32 : offset C : context -> T ) ptr : mergeValues
    C : context
  -> MergeResult ) =>: export: merge
    tree check
    branchHeads .length 0 <= if
      MergeResult .error return
    end
    tree prune ## discard current branch
    ## no update of child count necessary (loose link to branch, gain link to head)
    branchHeads .length 1 == if
      ## move head to first branch
      branchHeads 0 slice.get tree .branchHead=
      tree check
      0 MergeResult .success return ## nothing to merge
    end
    -1:i32 =:: mut: initDepth
    EMPTY =:: mut: parentId
    false =:: mut: needMerge
    0:i32 while $ i64 cast branchHeads .length < do
      branchHeads ..over slice.get i32 cast =:: nodeId
      nodeId -1 < or nodeId tree [] .nodes .length >= if ## id=-1 or 0 <= id < length
        ..drop
        MergeResult .error return ## nodeId invalid
      end
      nodeId -1 == if
        0:i32
      else
        tree [] .nodes nodeId list.at .data =:: nodeData
        nodeData [] .childCount
          1 -
        nodeData .childCount=
        nodeData [] .level
      end =:: nodeDepth
      initDepth -1 == if
         nodeDepth initDepth=
      else nodeDepth initDepth != _if
        ..drop
        ## nodes on top level have different depths
        MergeResult .error return
      end
      parentId EMPTY == if
        nodeId NodeId cast parentId=
      else nodeId parentId i32 cast != _if
        ## not already merged
        true needMerge=
      end
      1 +
    end ..drop
    needMerge ! if
      ## move head to first branch
      branchHeads 0 slice.get tree .branchHead=
      ## remember link to head in node
      tree [] .branchHead EMPTY != if
        tree [] .nodes
          tree [] .branchHead i32 cast
        list.at .data =:: newHead
        newHead [] .childCount
          1 +
        newHead .childCount=
      end
      tree check
      ## heads identical -> no merge necessary
      0 MergeResult .success return
    end
    tree [] .nodes .length NodeId cast tree .branchHead=
    tree [] .nodes
       tree [] .nodes
         branchHeads 0 slice.get i32 cast
       list.get list.append
    tree .nodes=
    tree [] .nodes list.peek .data =:: mut: currentNode
    1 currentNode .childCount=
    ## create mutable copy of heads
    branchHeads .length =:: headCount
    headCount NodeId mem.alloc =:: heads
    heads branchHeads .data headCount mem.copy ..drop
    headCount T ptr mem.alloc =:: buffer
    0 =:: mut: offset
    while
      tree [] .nodes heads 0 [] i32 cast list.at .data =:: root
      root [] .parent parentId=
      root .data buffer 0 =[]
      ## store parent node before unlinking child
      parentId EMPTY != if
        tree [] .nodes parentId i32 cast list.get optional.wrap
      else
        T Node optional.empty
      end =:: parentNode
      root [] .childCount 0 == if
        tree heads 0 [] unlinkNode
      end
      parentId heads 0 =[]
      false needMerge=
      1:i32 =:: mut: i while i i64 cast.u headCount < do
        tree [] .nodes heads i [] i32 cast list.at .data =:: next
        next [] .parent parentId != if
          true needMerge=
        end
        next .data buffer i =[]
        next [] .childCount 0 == if
          ## TODO? are the child counts updated correctly
          tree heads i [] unlinkNode
        end
        next [] .parent heads i =[]
        i 1 + i=
      end
      ## mergeValues
        buffer headCount slice.create
        offset i32 cast.s
        context
      mergeValues () currentNode .data=
      offset 1 + offset=
    needMerge do
      tree [] .nodes .length NodeId cast currentNode .parent=
      tree [] .nodes
         parentNode .data list.append
      tree .nodes=
      tree [] .nodes list.peek .data currentNode=
      1 currentNode .childCount=
    end
    ## cleanup
    buffer mem.free
    heads mem.free
    tree check
    offset MergeResult .success return
  end
end
