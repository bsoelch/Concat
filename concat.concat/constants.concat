import stringBuilder
import arenaAlloc

import "files.concat"
import "labels.concat"
import "types.concat"

import debug

i64 =:: export: ProcId
i64 =:: export: ProcBundleId

type :  export: ConstValue
struct( ConstValue ptr : value i64 : eltIndex ) =:: export: UnionConstant

## XXX? use wrapper types for array constants to prevent accidental assignment of external values
union(
  _ : None
  bool : Bool
  char8 : Char ## XXX? rename chr -> Char , int -> Int for consistency
  i64 : Int
  f64 : Float
  string   : String
  string16 : String16
  string32 : String32
  i8  arrayView : Array8
  i16 arrayView : Array16
  i32 arrayView : Array32
  i64 arrayView : Array64
  ConstValue arrayView : Array
  i64 : EnumLabel
  Type : TypeId
  _ : WildCard
  LabelId : GenericArg
  ProcId : Procedure
  ProcBundleId : ProcedureBundle
  UnionConstant : Union
) =:: export: ConstValue

struct(
  i8 ArenaAllocator  : mut: array8Values
  i16 ArenaAllocator : mut: array16Values
  i32 ArenaAllocator : mut: array32Values
  i64 ArenaAllocator : mut: array64Values
  ConstValue ArenaAllocator : mut: arrayValues
  stringBuilder : mut: stringParseBuffer
) =:: export: ConstantContext
## XXX? free const context
proc( -> ConstantContext ) =>: export: newConstContext
  ## ConstantContext
   4096 i8 arenaAlloc.create
   2048 i16 arenaAlloc.create
   1024 i32 arenaAlloc.create
   512  i64 arenaAlloc.create
   256  ConstValue arenaAlloc.create
   256  sb.create
 ConstantContext new return
end

proc( i8 arrayView : elts ConstantContext ptr.mut : context -> i8 arrayView ) =>: constArray8
  context [] .array8Values
    elts arenaAlloc.pushArray =:: result
  context [] .array8Values =
  result return
end
proc( i16 arrayView : elts ConstantContext ptr.mut : context -> i16 arrayView ) =>: constArray16
  context [] .array16Values
    elts arenaAlloc.pushArray =:: result
  context [] .array16Values =
  result return
end
proc( i32 arrayView : elts ConstantContext ptr.mut : context -> i32 arrayView ) =>: constArray32
  context [] .array32Values
    elts arenaAlloc.pushArray =:: result
  context [] .array32Values =
  result return
end
proc( i64 arrayView : elts ConstantContext ptr.mut : context -> i64 arrayView ) =>: constArray64
  context [] .array64Values
    elts arenaAlloc.pushArray =:: result
  context [] .array64Values =
  result return
end
proc(
  ConstValue arrayView : elts
  ConstantContext ptr.mut : context
-> ConstValue arrayView ) =>: export: constArray
  context [] .arrayValues
    elts arenaAlloc.pushArray =:: result
  context [] .arrayValues =
  result return
end

proc( i8 arrayView : elts ConstantContext ptr.mut : context -> ConstValue ) =>: export: newArray8Const
  elts context constArray8 ConstValue .Array8 return
end
proc( string : elts ConstantContext ptr.mut : context -> ConstValue ) =>: export: newStringConst
  elts string.bytes context constArray8 string.fromBytes ConstValue .String return
end
proc( i16 arrayView : elts ConstantContext ptr.mut : context -> ConstValue ) =>: export: newArray16Const
  elts context constArray16 ConstValue .Array16 return
end
proc( string16 : elts ConstantContext ptr.mut : context -> ConstValue ) =>: export: newString16Const
  elts string16.toArray context constArray16 string16.fromArray ConstValue .String16 return
end
proc( i32 arrayView : elts ConstantContext ptr.mut : context -> ConstValue ) =>: export: newArray32Const
  elts context constArray32 ConstValue .Array32 return
end
proc( string32 : elts ConstantContext ptr.mut : context -> ConstValue ) =>: export: newString32Const
  elts string32.toArray context constArray32 string32.fromArray ConstValue .String32 return
end
proc( i64 arrayView : elts ConstantContext ptr.mut : context -> ConstValue ) =>: export: newStr64Const
  elts context constArray64 ConstValue .Array64 return
end
proc(
  ConstValue arrayView : elts
  ConstantContext ptr.mut : context
-> ConstValue ) =>: export: newArrayConst
  elts context constArray ConstValue .Array return
end

proc(
  ConstValue : value
  i64 : index
  ConstantContext ptr.mut : context
-> ConstValue ) =>: export: newUnionConst
  context [] .arrayValues
    value arenaAlloc.pushValue =:: valuePtr
  context [] .arrayValues =
  valuePtr index UnionConstant new ConstValue .Union return
end
proc(
  ConstValue : union
  i64 : eltIndex
-> ConstValue bool ) =>: export: constUnionElement
  union .Union .value [] union .Union .eltIndex eltIndex != return
end

proc( ConstValue : a ConstValue : b LabelContext ptr : labelContext -> bool ) =>: export: constantEquals
  a ..label b ..label != if ##different constant types
    false return
  end
  a switch
    None WildCard case
      true return
    Bool case
      a .Bool b .Bool == return
    EnumLabel case
      a .EnumLabel b .EnumLabel == return
    Int case
      a .Int b .Int == return
    Float case
      a .Float b .Float == return
    Char case
      a .Char b .Char == return
    String case
      a .String b .String string.eq return
    Array8 case
      a .Array8 b .Array8 array.eq return
    String16 case
      a .String16 b .String16 string16.eq return
    Array16 case
      a .Array16 b .Array16 array.eq return
    String32 case
      a .String32 b .String32 string32.eq return
    Array32 case
      a .Array32 b .Array32 array.eq return
    Array64 case
      a .Array64 b .Array64 array.eq return
    Array case
      a .Array b .Array constantEquals@ labelContext array.eq return
    TypeId case
      a .TypeId b .TypeId types.typeEquals return
    Procedure case
      a .Procedure b .Procedure == return
    ProcedureBundle case
      a .ProcedureBundle b .ProcedureBundle == return
    GenericArg case
      a .GenericArg b .GenericArg == return
    Union case
      a .Union .eltIndex b .Union .eltIndex != if
        false return
      end
      ## TODO check equality of value
      a .Union .value b .Union .value == if
        true return
      end
      a .Union .value []
        b .Union .value []
      labelContext constantEquals return
  end
end

namespace: sb
  proc( stringBuilder char8 : c -> stringBuilder ) =>: export: appendEscapedChr
    c i32 cast.u =:: chr
    chr 0x20 < or chr 0x7f >= if ## non-printable ASCII-characters + hex-codes for multi-char characters
      "\\x" sb.appendS
      chr 0xff &
        ..dup 0x10 < if ..swap '0' sb.appendC ..swap end
      sb.appendX
      return
    end
    c '\\' == c '\'' == | c '\"' == | if
      '\\' sb.appendC
      c sb.appendC
      return
    end
    c sb.appendC
  end
  proc( stringBuilder : sb string : str -> stringBuilder ) =>: export: appendEscapedStr
    sb
      0:i64 while ..dup str .length < do =:: i
          str i string.charAt appendEscapedChr
        i 1 +
      end ..drop
    return
  end
  ## C-style string escaping, use octal sequences as hex-sequences may consume following characters
  proc( stringBuilder char8 : c -> stringBuilder ) =>: export: appendEscapedChrC
    c i32 cast.u =:: chr
    chr 0x20 < or chr 0x7f >= if
      ## non-printable ASCII-characters
      "\\" sb.appendS
      chr 0xff &
        ..dup 0o10 < if
          ..swap "00" sb.appendS ..swap
        else ..dup 0o100 < _if
          ..swap '0' sb.appendC ..swap
        end
      i64 cast.u 8 sb.appendI?
      return
    end
    c '\\' == c '\'' == | c '\"' == | if
      '\\' sb.appendC
      c  sb.appendC
      return
    end
    c  sb.appendC
  end
  proc( stringBuilder : sb string : str -> stringBuilder ) =>: export: appendEscapedStrC
    sb
      0:i64 while ..dup str .length < do =:: i
        str i string.charAt appendEscapedChrC
        i 1 +
      end ..drop
    return
  end
  proc(
    stringBuilder : sb
    ConstValue : val
    TypeContext ptr : typeContext
  -> stringBuilder ) =>: export: appendConstant
    typeContext [] .labelContext @ =:: labelContext
    sb
      val switch
        None case
          "none"  sb.appendS
          break
        WildCard case
          "_"  sb.appendS
          break
        Bool case
          "bool: " sb.appendS
          val .Bool if "true" sb.appendS else "false" sb.appendS end
          break
        Int case
          "integer: " sb.appendS
          val .Int    sb.appendI
          break
        Float case
          "float: "  sb.appendS
          val .Float sb.appendF
          break
        String case
          "string: \"" sb.appendS
          val .String  sb.appendEscapedStr
                 '\"'  sb.appendC
          break
        String16 case
          val .String16 =:: str
          "string16: \"" sb.appendS
            0:i64 while $ str .length < do =:: i
              str i string16.get i64 cast.u =:: c
              c 0x20 < or c 0x7f >= if ## XXX? allow some characters outside ascii
                "\\u" sb.appendS
                c 0x1000   ..u< if '0' sb.appendC end
                c 0x100    ..u< if '0' sb.appendC end
                c 0x10     ..u< if '0' sb.appendC end
                c i32 cast.u sb.appendX
              else
                c char8 cast sb.appendC
              end
              i 1 +
            end ..drop
         '\"'  sb.appendC
          break
        String32 case
          val .String32 =:: str
          "string32: \"" sb.appendS
            0:i64 while $ str .length < do =:: i
              str i string32.get i64 cast.u =:: cp
              cp 0 < if
                "\\x" sb.appendS
                cp -0x10 > if '0' sb.appendC end
                cp -_ sb.appendX
              else cp 0x20 < or cp 0x7f >= _if ## XXX? allow some characters outside ascii
                "\\U00" sb.appendS
                cp 0x100000 ..u< if '0' sb.appendC end
                cp 0x10000  ..u< if '0' sb.appendC end
                cp 0x1000   ..u< if '0' sb.appendC end
                cp 0x100    ..u< if '0' sb.appendC end
                cp 0x10     ..u< if '0' sb.appendC end
                cp sb.appendX
              else
                cp char8 cast sb.appendC
              end
              i 1 +
            end ..drop
         '\"'  sb.appendC
          break
        Char case
          "char: \'" sb.appendS
          val .Char   sb.appendEscapedChr
               '\''  sb.appendC
          break
        TypeId case
          "Type: "     sb.appendS
          val .TypeId typeContext sb.appendType
          break
        EnumLabel case
          "enum label: (" sb.appendS
          val .EnumLabel  sb.appendI
                   ')'    sb.appendC
          break
        Array case
          val .Array =:: mArray
          "{ " sb.appendS
          0:i64 while ..dup mArray .length < do =:: i
            mArray i array.get typeContext appendConstant
            ' ' sb.appendC
            i 1 +
          end ..drop
          "}" sb.appendS
          break
        Array8 case
          val .Array8 =:: mArray
          "{ " sb.appendS
          0:i64 while ..dup mArray .length < do =:: i
            mArray i array.get i64 cast.s appendI
            ' ' sb.appendC
            i 1 +
          end ..drop
          "}" sb.appendS
          break
        Array16 case
          val .Array16 =:: mArray
          "{ " sb.appendS
          0:i64 while ..dup mArray .length < do =:: i
            mArray i array.get i64 cast.s appendI
            ' ' sb.appendC
            i 1 +
          end ..drop
          "}" sb.appendS
          break
        Array32 case
          val .Array32 =:: mArray
          "{ " sb.appendS
          0:i64 while ..dup mArray .length < do =:: i
            mArray i array.get i64 cast.s appendI
            ' ' sb.appendC
            i 1 +
          end ..drop
          "}" sb.appendS
          break
        Array64 case
          val .Array64 =:: mArray
          "{ " sb.appendS
          0:i64 while ..dup mArray .length < do =:: i
            mArray i array.get appendI
            ' ' sb.appendC
            i 1 +
          end ..drop
          "}" sb.appendS
          break
        Procedure case
          "procedure: "  sb.appendS
          val .Procedure i64 cast sb.appendI
          break
        ProcedureBundle case
          "procedure bundle: "  sb.appendS
          val .ProcedureBundle i64 cast sb.appendI
          break
        GenericArg case
          "generic argument: "  sb.appendS
          val .GenericArg i64 cast sb.appendI
          ## XXX? print label
          break
        Union case
          "union element ("  sb.appendS
          val .Union .eltIndex sb.appendI
          "):" sb.appendS
            val .Union .value []
            typeContext
          sb.appendConstant
          break
      end
    return
  end
end

namespace: constants
  proc(
    string : str
    FilePosition : stringStart
    CompilerError list ptr.mut : errors
    ConstantContext ptr.mut : context
  -> string ) =>: export: parseStringConstant
    ## TODO improve readability of stack based code (?extract loop counter to variable)
    stringStart =:: mut: pos
    '"' pos@ updateFilePos ## string content starts after "
    context [] .stringParseBuffer .length =:: offset
    context [] .stringParseBuffer
      $ .length str .length + sb.ensureCap
      0:i64 while ..dup str .length < do =:: mut: i
        str i string.charAt
          $ pos@ updateFilePos
        $ '\\' != if
          sb.appendC
          continue
        end ..drop
        i 1 + i =
        str i string.charAt $ switch
          '\\' '\'' '"' case
            $ pos@ updateFilePos
            sb.appendC
            break
          'n' case
            pos@ updateFilePos
            '\n' sb.appendC
            break
          't' case
            pos@ updateFilePos
            '\t' sb.appendC
            break
          'b' case
            pos@ updateFilePos
            '\b' sb.appendC
            break
          'r' case
            pos@ updateFilePos
            '\r' sb.appendC
            break
          'f' case
            pos@ updateFilePos
            '\f' sb.appendC
            break
          'v' case
            pos@ updateFilePos
            '\v' sb.appendC
            break
          'x' 'u' 'U' case =:: c
            c pos@ updateFilePos
            i 1 + i =
            c 'x' == if 2:i64 else c 'u' == _if 4:i64 else 8:i64 end =:: nChars
            i nChars + str .length > if
              "not enough characters for escape sequence \"\\" sb.wrap
                c               sb.appendC
                "\" need "      sb.appendS
                nChars          sb.appendI
                " got "         sb.appendS
                str .length i - sb.appendI
              pos errors appendError
              continue
            end
            str .data i + nChars string.create 16 number.tryParseInt .NONE ?? if
              $ 0 < if ..drop
                "invalid hex-code for escape sequence: \"\\" sb.wrap
                  c sb.appendC
                  str .data i + nChars string.create sb.appendStr
                  '\"' sb.appendC
                pos errors appendError
              else
                c 'x' == if
                  char8 cast sb.appendC
                else c 'u' == _if
                  utf8.Codepoint cast sb.appendCodepoint
                else c 'U' == _if
                  $ utf8.MAX_CODEPOINT i64 cast.u > if
                    "code-point outside allowed range: \"\\U" sb.wrap
                      str .data i + nChars string.create sb.appendStr
                      "\" (maximum: 0x" sb.appendS
                      utf8.MAX_CODEPOINT sb.appendX
                      ")" sb.appendS
                    pos errors appendWarning
                  end
                  utf8.Codepoint cast sb.appendCodepoint
                else ..drop
                  "unknown hex-escape sequence: \"\\" sb.wrap
                    c sb.appendC '\"'
                    sb.appendC
                  pos errors appendError
                end
              end
            else ..drop
              "invalid hex-code for escape sequence: \"\\" sb.wrap
                c sb.appendC
                str .data i + nChars string.create sb.appendStr
                '\"' sb.appendC
              pos errors appendError
            end
            0:i64 while $ nChars < do =:: j
              str i j + string.charAt pos@ updateFilePos
            finally j 1 + end ..drop
            i nChars 1 - + i =
            continue
          default
            "unknown escape sequence \"\\" sb.wrap
              $1 sb.appendC
              '\"' sb.appendC
            pos errors appendError
            pos@ updateFilePos
        end
      finally i 1 + end ..drop
    context [] .stringParseBuffer =
    context [] .stringParseBuffer
      sb.asStr offset string.tail
    context newStringConst .String
      context [] .stringParseBuffer
        offset sb.setLength
      context [] .stringParseBuffer =
    return
  end
  proc(
    string : str
    FilePosition : stringStart
    CompilerError list ptr.mut : errors
    ConstantContext ptr.mut : context
  -> string ) =>: export: parseRawStringConstant
    stringStart =:: mut: pos
    '`' pos@ updateFilePos ## string content starts after `
    context [] .stringParseBuffer .length =:: offset
    context [] .stringParseBuffer
      $ .length str .length + sb.ensureCap
      0:i64 while $ str .length < do =:: i
        str i string.charAt =:: c
        c pos@ updateFilePos
        c '`' != if
          c sb.appendC
          i 1 + continue
        end
        i 1 + str .length >= if
          "unexpected end of raw string" sb.wrap
          pos errors appendError
        end
        str i 1 + string.charAt
          $ pos@ updateFilePos
        sb.appendC
        i 2 +
      end ..drop
    context [] .stringParseBuffer =
    context [] .stringParseBuffer
      sb.asStr offset string.tail
    context newStringConst .String
      context [] .stringParseBuffer
        offset sb.setLength
      context [] .stringParseBuffer =
    return
  end
end
