#include stringBuilder

#include "files.concat"
#include "labels.concat"
#include "types.concat"

struct( i64 : offset i64 : length ) =:: public ConstantArray
enum(
  none
  bool : boolean
  i32 : enumLabel
  i8 : chr
  i64 : int
  StringConstant : str
  ConstantArray : arrayConstant
  Type : typeId
  wildCard
  i32 : genericArg
  i32 : templateArg
) =:: public ConstValue
struct( Type : valueType ConstValue : val FilePosition : pos ) =:: public Constant

struct( ConstValue list : mut arrayValues ) =:: public ConstantContext

proc( => ConstantContext ) =: public newConstContext
 128 ConstValue list.create
 ConstantContext new return
end
proc( ConstValue arrayView : elts ConstantContext ptr mut : context => ConstantArray ) =: public constArray
  context [] .arrayValues .length
    context [] .arrayValues
      elts list.appendArray
    context [] .arrayValues =
  elts .length ConstantArray new return
end
proc( ConstantArray : elts i64 : index ConstantContext ptr : context => ConstValue ) =: public constArrayGet
  context [] .arrayValues elts .offset index + list.get return
end
proc( ConstantArray : elts ConstantContext ptr : context => ConstValue arrayView ) =: public constArrayAsArray
  elts .offset 0 < if
    ConstValue array.empty return
  end
  context [] .arrayValues .length elts .offset elts .length + < if
    ConstValue array.empty return
  end
  context [] .arrayValues .data elts .offset + elts .length array.create return
end

proc( FilePosition : pos => Constant ) =: public constWildcard
  Type .undefined ConstValue .wildCard new pos Constant new return
end
proc( i64 FilePosition => Constant ) =: public constInt
  =:: pos
  #dup i32.MIN < #over i32.MAX > | if types.primitive.I64 else types.primitive.I32 end #swap ConstValue .int new pos Constant new return
end
proc( StringConstant : str FilePosition : pos TypeContext ptr mut : context => Constant ) =: public constStr
  #using types
  str .length ArraySizeType .int ArraySize new =:: size
  types.primitive.I8 true size @ 1 array.create true false context newArrayType #drop str ConstValue .str new pos Constant new return
end
proc( i8 FilePosition => Constant ) =: public constChar
  =:: pos
  types.primitive.I8 #swap ConstValue .chr new pos Constant new return
end
proc( bool FilePosition => Constant ) =: public constBool
  =:: pos
  types.primitive.BOOL #swap ConstValue .boolean new pos Constant new return
end
proc( Type FilePosition => Constant ) =: public constType
  =:: pos
  types.primitive.TYPE #swap ConstValue .typeId new pos Constant new return
end
proc( Type i32 FilePosition => Constant ) =: public constEnumLabel
  =:: pos
  ConstValue .enumLabel new pos Constant new return
end
proc( ConstValue Type FilePosition => Constant ) =: public newConst
  =:: pos
  #swap pos Constant new return
end

proc( ConstValue : a ConstValue : b LabelContext ptr : labelContext => bool ) =: public constantEquals
  a b != if ##different constant types
    false return
  end
  a switch
    none wildCard case
      true return
    boolean case
      a .boolean b .boolean == return
    enumLabel case
      a .enumLabel b .enumLabel == return
    int case
      a .int b .int == return
    chr case
      a .chr b .chr == return
    str case
      a .str .length b .str .length != if
        false return
      end
      a .str .offset b .str .offset == if
        true return
      end
      a .str labelContext id.scAsStr b .str labelContext id.scAsStr string.eq return
    arrayConstant case
      a .arrayConstant .length b .arrayConstant .length != if
        false return
      end
      a .arrayConstant .offset b .arrayConstant .offset == if
        true return
      end
      ## TODO array equality
      false return
    typeId case
      a .typeId b .typeId types.typeEquals return
    templateArg case
      a .templateArg b .templateArg == return
    genericArg case
      a .genericArg b .genericArg == return
  end
end

#namespace sb
proc( stringBuilder i8 => stringBuilder ) =: public appendEscapedChr
  =:: chr
  chr 0x20 < chr 0x7f == | if ## non-printable ASCII-characters + hex-codes for multi-char characters
    "\\x" sb.appendS
    chr 0xff &
      #dup 0x10 < if #swap '0' sb.appendC #swap end
    sb.appendX
    return
  end
  chr '\\' == chr '\'' == | chr '\"' == | if
    '\\' sb.appendC
    chr  sb.appendC
    return
  end
  chr  sb.appendC
end
proc( stringBuilder string => stringBuilder ) =: public appendEscapedStr
  =:: str
  0 while #dup str .length < do
    #swap
      str #over:2 string.charAt appendEscapedChr
    #swap 1 +
  end #drop
end
proc( stringBuilder ConstValue ConstantContext ptr LabelContext ptr TypeContext ptr => stringBuilder ) =: public appendConstant
  =:: typeContext
  =:: labelContext
  =:: constContext
  #swap
    #over switch
      none case
        "none"  sb.appendS
        break
      wildCard case
        "_"  sb.appendS
        break
      boolean case
        "boolean " sb.appendS
        #over .boolean if "true" sb.appendS else "false" sb.appendS end
        break
      int case
        "integer "  sb.appendS
        #over .int sb.appendI
        break
      str case
        "string \""  sb.appendS
        #over .str labelContext id.scAsStr  sb.appendEscapedStr
               '\"'  sb.appendC
        break
      chr case
        "char \'"  sb.appendS
        #over .chr sb.appendEscapedChr
             '\''  sb.appendC
        break
      typeId case
        "type \""     sb.appendS
        #over .typeId labelContext typeContext sb.appendType
             '\"'     sb.appendC
        break
      enumLabel case
        "enum label ("   sb.appendS
        #over .enumLabel sb.appendI
                 ')'     sb.appendC
        break
      arrayConstant case #over .arrayConstant =:: mArray
        "{ " sb.appendS
        0 while #dup mArray .length < do
          #swap
            mArray #over:2 constContext constArrayGet constContext labelContext typeContext appendConstant
            ' ' sb.appendC
          #swap 1 +
        end #drop
        "}" sb.appendS
        break
      genericArg case
        "generic argument "  sb.appendS
        #over .genericArg sb.appendI
        break
      templateArg case
        "template argument "  sb.appendS
        #over .genericArg sb.appendI
        break
    end
   #swap #drop return
end
#end
