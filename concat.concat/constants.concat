import debug

i64 =:: export: ProcId
i64 =:: export: ProcBundleId

type : export: ConstValue
struct( ConstValue ptr : value i64 : eltIndex ) =:: export: UnionConstant

## pointers to mutable constants in interpreter
ConstValue ptr.mut =:: export: LocalAddress
ConstValue arrayView.mut =:: export: LocalSlice
i8 arrayView.mut =:: export: LocalSlice8
i16 arrayView.mut =:: export: LocalSlice16
i32 arrayView.mut =:: export: LocalSlice32
i64 arrayView.mut =:: export: LocalSlice64

## XXX? use wrapper types for array constants to prevent accidental assignment of external values
union(
  _ : None
  bool : Bool
  char8 : Char
  i64 : Int
  f64 : Float
  ## XXX? float arrays
  i8  arrayView : Array8
  i16 arrayView : Array16
  i32 arrayView : Array32
  i64 arrayView : Array64
  ConstValue arrayView : Array
  i64 : EnumLabel
  Type : TypeId
  _ : WildCard
  LabelId : GenericArg
  ProcId : Procedure
  ProcBundleId : ProcedureBundle
  UnionConstant : Union
  LocalAddress : LocalValue
  LocalSlice : LocalArray
  LocalSlice8 : LocalArray8
  LocalSlice16 : LocalArray16
  LocalSlice32 : LocalArray32
  LocalSlice64 : LocalArray64
) =:: export: ConstValue

struct(
  MixedArenaAllocator : mut: arrayValues
  stringBuilder : mut: stringParseBuffer
) =:: export: ConstantContext
## XXX? free const context
proc( -> ConstantContext ) =>: export: newConstContext
  ## ConstantContext
   4096 mixedArena.create
   256  sb.create
 ConstantContext new return
end

proc(
 type : auto: T
 T arrayView : elts
 ConstantContext ptr.mut : context
-> T arrayView ) =>: constPrimitiveArray
  context [] .arrayValues
    elts mixedArena.copyArray array.freeze =:: result
  context [] .arrayValues =
  result return
end
proc(
  ConstValue arrayView : elts
  ConstantContext ptr.mut : context
-> ConstValue arrayView ) =>: export: constArray
  context [] .arrayValues
    elts mixedArena.copyArray array.freeze =:: result
  context [] .arrayValues =
  result return
end

proc( i8 arrayView : elts ConstantContext ptr.mut : context -> ConstValue ) =>: export: newArray8Const
  elts context constPrimitiveArray ConstValue .Array8 return
end
proc( string : elts ConstantContext ptr.mut : context -> ConstValue ) =>: export: newStringConst
  elts string.bytes context newArray8Const return
end
proc( i16 arrayView : elts ConstantContext ptr.mut : context -> ConstValue ) =>: export: newArray16Const
  elts context constPrimitiveArray ConstValue .Array16 return
end
proc( string16 : elts ConstantContext ptr.mut : context -> ConstValue ) =>: export: newString16Const
  elts string16.toIntArray context newArray16Const return
end
proc( i32 arrayView : elts ConstantContext ptr.mut : context -> ConstValue ) =>: export: newArray32Const
  elts context constPrimitiveArray ConstValue .Array32 return
end
proc( string32 : elts ConstantContext ptr.mut : context -> ConstValue ) =>: export: newString32Const
  elts string32.toIntArray context newArray32Const return
end
proc( i64 arrayView : elts ConstantContext ptr.mut : context -> ConstValue ) =>: export: newArray64Const
  elts context constPrimitiveArray ConstValue .Array64 return
end
proc(
  ConstValue arrayView : elts
  ConstantContext ptr.mut : context
-> ConstValue ) =>: export: newArrayConst
  elts context constArray ConstValue .Array return
end

proc(
  ConstValue : value
  i64 : index
  ConstantContext ptr.mut : context
-> ConstValue ) =>: export: newUnionConst
  context [] .arrayValues
    value mixedArena.copyValue =:: valuePtr
  context [] .arrayValues =
  valuePtr index UnionConstant new ConstValue .Union return
end
proc(
  ConstValue : union
  i64 : eltIndex
-> ConstValue bool ) =>: export: constUnionElement
  union .Union .value [] union .Union .eltIndex eltIndex != return
end
proc(
  ConstValue : union
-> ConstValue ) =>: export: constUnionLabel
  union .Union .eltIndex ConstValue .EnumLabel return
end

proc( ConstValue : a ConstValue : b LabelContext ptr : labelContext -> bool ) =>: export: constantEquals
  a ..label b ..label != if ##different constant types
    false return
  end
  a switch
    None WildCard case
      true return
    Bool case
      a .Bool b .Bool == return
    EnumLabel case
      a .EnumLabel b .EnumLabel == return
    Int case
      a .Int b .Int == return
    Float case
      a .Float b .Float == return
    Char case
      a .Char b .Char == return
    Array8 case
      a .Array8 b .Array8 array.eq return
    Array16 case
      a .Array16 b .Array16 array.eq return
    Array32 case
      a .Array32 b .Array32 array.eq return
    Array64 case
      a .Array64 b .Array64 array.eq return
    Array case
      a .Array b .Array constantEquals@ labelContext array.eq return
    TypeId case
      a .TypeId b .TypeId types.typeEquals return
    Procedure case
      a .Procedure b .Procedure == return
    ProcedureBundle case
      a .ProcedureBundle b .ProcedureBundle == return
    GenericArg case
      a .GenericArg b .GenericArg == return
    Union case
      a .Union .eltIndex b .Union .eltIndex != if
        false return
      end
      ## TODO check equality of value
      a .Union .value b .Union .value == if
        true return
      end
      a .Union .value []
        b .Union .value []
      labelContext constantEquals return
    LocalValue case
      a .LocalValue b .LocalValue == return
    LocalArray case
      ## local arrays are only equal if memory ranges coincide
      a .LocalArray .data b .LocalArray .data == and
        a .LocalArray .length b .LocalArray .length ==
      end return
    LocalArray8 case
      ## local arrays are only equal if memory ranges coincide
      a .LocalArray8 .data b .LocalArray8 .data == and
        a .LocalArray8 .length b .LocalArray8 .length ==
      end return
    LocalArray16 case
      ## local arrays are only equal if memory ranges coincide
      a .LocalArray16 .data b .LocalArray16 .data == and
        a .LocalArray16 .length b .LocalArray16 .length ==
      end return
    LocalArray32 case
      ## local arrays are only equal if memory ranges coincide
      a .LocalArray32 .data b .LocalArray32 .data == and
        a .LocalArray32 .length b .LocalArray32 .length ==
      end return
    LocalArray64 case
      ## local arrays are only equal if memory ranges coincide
      a .LocalArray64 .data b .LocalArray64 .data == and
        a .LocalArray64 .length b .LocalArray64 .length ==
      end return
  end
end
namespace: constant
  ## Detect if a given i8 array is a string constant
  proc( i8 arrayView : bytes -> bool ) =>: isString
    0:i64 =:: mut: nonPrintable
    bytes string.fromBytes
    0:i64 while $1 .length $1 > do
      utf8.nextCodepoint =:: cp
      cp unicode.MIN_CODEPOINT < or cp unicode.MAX_CODEPOINT > if
        ..drop.2 false return ## definitely no string
      end
      cp i32 cast =:: intValue
      intValue #+newLine+# 0x0a != and intValue 0x20 < or intValue 0x7f == if ## non-printable ascii
        nonPrintable 1 + nonPrintable =
      end
    end ..drop.2
    ## at most 1/8 non-printable chars
    nonPrintable bytes .length 4 + 8 / <= return
  end
  ## Detect if a given i8 array is a string constant
  proc( i16 arrayView : ints -> bool ) =>: isString16
    0:i64 =:: mut: nonPrintable
    ints string16.fromIntArray
    0:i64 while $1 .length $1 > do
      utf16.nextCodepoint =:: cp
      cp unicode.MIN_CODEPOINT < or cp unicode.MAX_CODEPOINT > if
        ..drop.2 false return ## definitely no string
      end
      cp i32 cast =:: intValue
      intValue #+newLine+# 0x0a != and intValue 0x20 < or intValue 0x7f == if ## non-printable ascii
        nonPrintable 1 + nonPrintable =
      end
    end ..drop.2
    ## at most 1/8 non-printable chars
    nonPrintable ints .length 4 + 8 / <= return
  end
  ## Detect if a given i8 array is a string constant
  proc( i32 arrayView : ints -> bool ) =>: isString32
    0:i64 =:: mut: nonPrintable
    ints .length for =:: i
      ints i array.get unicode.Codepoint cast =:: cp
      cp unicode.MIN_CODEPOINT < or cp unicode.MAX_CODEPOINT > if
        false return ## definitely no string
      end
      cp i32 cast =:: intValue
      intValue #+newLine+# 0x0a != and intValue 0x20 < or intValue 0x7f == if ## non-printable ascii
        nonPrintable 1 + nonPrintable =
      end
    end
    ## at most 1/8 non-printable chars
    nonPrintable ints .length 4 + 8 / <= return
  end
end
namespace: sb
  proc( stringBuilder char8 : c -> stringBuilder ) =>: export: appendEscapedChr
    c i32 cast.u =:: chr
    chr 0x20 < or chr 0x7f >= if ## non-printable ASCII-characters + hex-codes for multi-char characters
      "\\x" sb.appendS
      chr 0xff &
        ..dup 0x10 < if ..swap '0' sb.appendC ..swap end
      sb.appendX
      return
    end
    c '\\' == c '\'' == | c '\"' == | if
      '\\' sb.appendC
      c sb.appendC
      return
    end
    c sb.appendC
  end
  proc( stringBuilder : sb string : str -> stringBuilder ) =>: export: appendEscapedStr
    sb
      0:i64 while ..dup str .length < do =:: i
          str i string.charAt appendEscapedChr
        i 1 +
      end ..drop
    return
  end
  ## C-style string escaping, use octal sequences as hex-sequences may consume following characters
  proc( stringBuilder char8 : c -> stringBuilder ) =>: export: appendEscapedChrC
    c i32 cast.u =:: chr
    chr 0x20 < or chr 0x7f >= if
      ## non-printable ASCII-characters
      "\\" sb.appendS
      chr 0xff &
        ..dup 0o10 < if
          ..swap "00" sb.appendS ..swap
        else ..dup 0o100 < _if
          ..swap '0' sb.appendC ..swap
        end
      i64 cast.u 8 sb.appendI?
      return
    end
    c '\\' == c '\'' == | c '\"' == | if
      '\\' sb.appendC
      c  sb.appendC
      return
    end
    c  sb.appendC
  end
  proc( stringBuilder : sb string : str -> stringBuilder ) =>: export: appendEscapedStrC
    sb
      0:i64 while ..dup str .length < do =:: i
        str i string.charAt appendEscapedChrC
        i 1 +
      end ..drop
    return
  end
  proc( stringBuilder : sb string16 : str -> stringBuilder ) =>: export: appendEscapedStr16
    sb
      0:i64 while ..dup str .length < do =:: i
        str i string16.get i32 cast.u =:: c
        c 0x80 u< if
          c char8 cast appendEscapedChr
        else
          "\\u" sb.appendS
               c 0x100 u< if  "00" sb.appendS
          else c 0x1000 u< _if "0" sb.appendS
          end
          c sb.appendUX
        end
        i 1 +
      end ..drop
    return
  end
  proc( stringBuilder : sb string32 : str -> stringBuilder ) =>: export: appendEscapedStr32
    sb
      0:i64 while ..dup str .length < do =:: i
        str i string32.get i32 cast.u =:: c
        c 0x80 u< if
          c char8 cast appendEscapedChr
        else
          "\\U" sb.appendS
               c 0x100 u<  if "000000" sb.appendS
          else c 0x1000 u< _if "00000" sb.appendS
          else c 0x10000 u< _if "0000" sb.appendS
          else c 0x100000 u< _if "000" sb.appendS
          else c 0x1000000 u< _if "00" sb.appendS
          else c 0x10000000 u< _if "0" sb.appendS
          end
          c sb.appendUX
        end
        i 1 +
      end ..drop
    return
  end
  8:i64 =:: MAX_ARRAY_ELEMENTS
  12:i64 =:: MAX_PRIMITIVE_ARRAY_ELEMENTS
  36:i64 =:: MAX_STRING_CHARS
  24:i64 =:: MAX_STRING_CHARS_HEAD
  8:i64 =:: MAX_STRING_CHARS_TAIL
  ## XXX? limit call depth (to prevent infinite recursion)
  proc(
    stringBuilder : sb
    ConstValue : val
    TypeContext ptr : typeContext
  -> stringBuilder ) =>: export: appendConstant
    typeContext [] .labelContext@ =:: labelContext
    sb
      val switch
        None case
          "none"  sb.appendS
          break
        WildCard case
          "_"  sb.appendS
          break
        Bool case
          val .Bool if "true" sb.appendS else "false" sb.appendS end
          break
        Int case
          val .Int    sb.appendI
          break
        Float case
          val .Float sb.appendF
          break
        Char case
          '\''  sb.appendC
          val .Char   sb.appendEscapedChr
          '\''  sb.appendC
          break
        TypeId case
          val .TypeId typeContext sb.appendType
          break
        EnumLabel case
          "enum label: (" sb.appendS
            val .EnumLabel  sb.appendI
          ')'    sb.appendC
          break
        Array case ## XXX? labeled array?
          val .Array =:: mArray
          mArray .length
            MAX_ARRAY_ELEMENTS 1 - i64.min
          =:: maxElements
          "{ " sb.appendS
          0:i64 while ..dup maxElements < do =:: i
            mArray i array.get typeContext appendConstant
            ' ' sb.appendC
            i 1 +
          end ..drop
          mArray .length MAX_ARRAY_ELEMENTS >= if
            mArray .length MAX_ARRAY_ELEMENTS > if "... " sb.appendS end
            mArray $ .length 1 - array.get typeContext appendConstant
            ' ' sb.appendC
          end
          "}" sb.appendS
          break
        Array8 case
          val .Array8 =:: mArray
          mArray constant.isString if ## array is string constant
            mArray .length MAX_STRING_CHARS <= if
              '\"'  sb.appendC
              mArray string.fromBytes sb.appendEscapedStr
              '\"'  sb.appendC
            else
              '\"'  sb.appendC
              mArray
                MAX_STRING_CHARS_HEAD array.head
              string.fromBytes sb.appendEscapedStr
              "\"...\""  sb.appendS
              mArray
                $ .length MAX_STRING_CHARS_TAIL - array.tail
              string.fromBytes sb.appendEscapedStr
              '\"'  sb.appendC
            end
            return
          end
          mArray .length
            MAX_PRIMITIVE_ARRAY_ELEMENTS 1 - i64.min
          =:: maxElements
          "{ " sb.appendS
          0:i64 while ..dup maxElements < do =:: i
            mArray i array.get i64 cast.s appendI
            ":i8 " sb.appendS
            i 1 +
          end ..drop
          mArray .length MAX_PRIMITIVE_ARRAY_ELEMENTS >= if
            mArray .length MAX_PRIMITIVE_ARRAY_ELEMENTS > if "... " sb.appendS end
            mArray $ .length 1 - array.get i64 cast.s appendI
            ":i8 " sb.appendS
          end
          "}" sb.appendS
          break
        Array16 case
          val .Array16 =:: mArray
          mArray constant.isString16 if ## array is string constant
            mArray .length MAX_STRING_CHARS <= if
              "utf16\""  sb.appendS
              mArray string16.fromIntArray sb.appendEscapedStr16
              '\"'  sb.appendC
            else
              "utf16\""  sb.appendS
              mArray
                MAX_STRING_CHARS_HEAD array.head
              string16.fromIntArray sb.appendEscapedStr16
              "\"...\""  sb.appendS
              mArray
                $ .length MAX_STRING_CHARS_TAIL - array.tail
              string16.fromIntArray sb.appendEscapedStr16
              '\"'  sb.appendC
            end
            return
          end
          mArray .length
            MAX_PRIMITIVE_ARRAY_ELEMENTS 1 - i64.min
          =:: maxElements
          "{ " sb.appendS
          0:i64 while ..dup maxElements < do =:: i
            mArray i array.get i64 cast.s appendI
            ":i16 " sb.appendS
            i 1 +
          end ..drop
          mArray .length MAX_PRIMITIVE_ARRAY_ELEMENTS >= if
            mArray .length MAX_PRIMITIVE_ARRAY_ELEMENTS > if "... " sb.appendS end
            mArray $ .length 1 - array.get i64 cast.s appendI
            ":i16 " sb.appendS
          end
          "}" sb.appendS
          break
        Array32 case
          val .Array32 =:: mArray
          mArray constant.isString32 if ## array is string constant
            mArray .length MAX_STRING_CHARS <= if
              "utf32\""  sb.appendS
              mArray string32.fromIntArray sb.appendEscapedStr32
              '\"'  sb.appendC
            else
              "utf32\""  sb.appendS
              mArray
                MAX_STRING_CHARS_HEAD array.head
              string32.fromIntArray sb.appendEscapedStr32
              "\"...\""  sb.appendS
              mArray
                $ .length MAX_STRING_CHARS_TAIL - array.tail
              string32.fromIntArray sb.appendEscapedStr32
              '\"'  sb.appendC
            end
            return
          end
          mArray .length
            MAX_PRIMITIVE_ARRAY_ELEMENTS 1 - i64.min
          =:: maxElements
          "{ " sb.appendS
          0:i64 while ..dup maxElements < do =:: i
            mArray i array.get i64 cast.s appendI
            ":i32 " sb.appendS
            i 1 +
          end ..drop
          mArray .length MAX_PRIMITIVE_ARRAY_ELEMENTS >= if
            mArray .length MAX_PRIMITIVE_ARRAY_ELEMENTS > if "... " sb.appendS end
            mArray $ .length 1 - array.get i64 cast.s appendI
            ":i32 " sb.appendS
          end
          "}" sb.appendS
          break
        Array64 case
          val .Array64 =:: mArray
          "{ " sb.appendS
          mArray .length
            MAX_PRIMITIVE_ARRAY_ELEMENTS 1 - i64.min
          =:: maxElements
          0:i64 while ..dup maxElements < do =:: i
            mArray i array.get appendI
            ":i64 " sb.appendS
            i 1 +
          end ..drop
          mArray .length MAX_PRIMITIVE_ARRAY_ELEMENTS >= if
            mArray .length MAX_PRIMITIVE_ARRAY_ELEMENTS > if "... " sb.appendS end
            mArray $ .length 1 - array.get i64 cast.s appendI
            ":i64 " sb.appendS
          end
          "}" sb.appendS
          break
        Procedure case
          val .Procedure i64 cast sb.appendI
          ":ProcId"  sb.appendS
          break
        ProcedureBundle case
          val .ProcedureBundle i64 cast sb.appendI
          ":ProcBundleId"  sb.appendS
          break
        GenericArg case
          val .GenericArg i64 cast sb.appendI
          ":LabelId"  sb.appendS
          ## XXX? print label
          break
        Union case
          "union element ("  sb.appendS
          val .Union .eltIndex sb.appendI
          "):" sb.appendS
            val .Union .value []
            typeContext
          sb.appendConstant
          break
        LocalValue case
            "local value ( "  sb.appendS
            val .LocalValue [] typeContext sb.appendConstant
            " )" sb.appendS
          break
        LocalArray case
            "local array ( "  sb.appendS
              val .LocalArray
                ConstValue arrayView.mut cast array.freeze
              ConstValue .Array typeContext sb.appendConstant
            " )" sb.appendS
          break
        LocalArray8 case
            "local array8 ( "  sb.appendS
              val .LocalArray8
                i8 arrayView.mut cast array.freeze
              ConstValue .Array8 typeContext sb.appendConstant
            " )" sb.appendS
          break
        LocalArray16 case
            "local array16 ( "  sb.appendS
              val .LocalArray16
                i16 arrayView.mut cast array.freeze
              ConstValue .Array16 typeContext sb.appendConstant
            " )" sb.appendS
          break
        LocalArray32 case
            "local array32 ( "  sb.appendS
              val .LocalArray32
                i32 arrayView.mut cast array.freeze
              ConstValue .Array32 typeContext sb.appendConstant
            " )" sb.appendS
          break
        LocalArray64 case
            "local array64 ( "  sb.appendS
              val .LocalArray64
                i64 arrayView.mut cast array.freeze
              ConstValue .Array64 typeContext sb.appendConstant
            " )" sb.appendS
          break
      end
    return
  end
end

namespace: constants
  proc(
    string : str
    FilePosition : stringStart
    CompilerError list ptr.mut : errors
    ConstantContext ptr.mut : context
  -> ConstValue ) =>: export: parseStringConstant
    ## TODO improve readability of stack based code (?extract loop counter to variable)
    stringStart =:: mut: pos
    '"' pos@ updateFilePos ## string content starts after "
    context [] .stringParseBuffer .length =:: offset
    context [] .stringParseBuffer
      $ .length str .length + sb.ensureCap
      0:i64 while ..dup str .length < do =:: mut: i
        str i string.charAt
          $ pos@ updateFilePos
        $ '\\' != if
          sb.appendC
          continue
        end ..drop
        i 1 + i =
        str i string.charAt $ switch
          '\\' '\'' '"' case
            $ pos@ updateFilePos
            sb.appendC
            break
          'n' case
            pos@ updateFilePos
            '\n' sb.appendC
            break
          't' case
            pos@ updateFilePos
            '\t' sb.appendC
            break
          'b' case
            pos@ updateFilePos
            '\b' sb.appendC
            break
          'r' case
            pos@ updateFilePos
            '\r' sb.appendC
            break
          'f' case
            pos@ updateFilePos
            '\f' sb.appendC
            break
          'v' case
            pos@ updateFilePos
            '\v' sb.appendC
            break
          'x' 'u' 'U' case =:: c
            c pos@ updateFilePos
            i 1 + i =
            c 'x' == if 2:i64 else c 'u' == _if 4:i64 else 8:i64 end =:: nChars
            i nChars + str .length > if
              "not enough characters for escape sequence \"\\" sb.wrap
                c               sb.appendC
                "\" need "      sb.appendS
                nChars          sb.appendI
                " got "         sb.appendS
                str .length i - sb.appendI
              pos errors appendError
              continue
            end
            str .data i + nChars string.create 16 number.tryParseInt .NONE ?? if
              $ 0 < if ..drop
                "invalid hex-code for escape sequence: \"\\" sb.wrap
                  c sb.appendC
                  str .data i + nChars string.create sb.appendStr
                  '\"' sb.appendC
                pos errors appendError
              else
                c 'x' == if
                  char8 cast sb.appendC
                else c 'u' == _if
                  unicode.Codepoint cast sb.appendCodepoint
                else c 'U' == _if
                  $ unicode.MAX_CODEPOINT i64 cast.u > if
                    "code-point outside allowed range: \"\\U" sb.wrap
                      str .data i + nChars string.create sb.appendStr
                      "\" (maximum: 0x" sb.appendS
                      unicode.MAX_CODEPOINT i64 cast.u sb.appendX
                      ")" sb.appendS
                    pos errors appendWarning
                  end
                  unicode.Codepoint cast sb.appendCodepoint
                else ..drop
                  "unknown hex-escape sequence: \"\\" sb.wrap
                    c sb.appendC '\"'
                    sb.appendC
                  pos errors appendError
                end
              end
            else ..drop
              "invalid hex-code for escape sequence: \"\\" sb.wrap
                c sb.appendC
                str .data i + nChars string.create sb.appendStr
                '\"' sb.appendC
              pos errors appendError
            end
            0:i64 while $ nChars < do =:: j
              str i j + string.charAt pos@ updateFilePos
            finally j 1 + end ..drop
            i nChars 1 - + i =
            continue
          default
            "unknown escape sequence \"\\" sb.wrap
              $1 sb.appendC
              '\"' sb.appendC
            pos errors appendError
            pos@ updateFilePos
        end
      finally i 1 + end ..drop
    context [] .stringParseBuffer =
    context [] .stringParseBuffer
      sb.asStr offset string.tail
    context newStringConst
      context [] .stringParseBuffer
        offset sb.setLength
      context [] .stringParseBuffer =
    return
  end
  proc(
    string : str
    FilePosition : stringStart
    CompilerError list ptr.mut : errors
    ConstantContext ptr.mut : context
  -> ConstValue ) =>: export: parseRawStringConstant
    stringStart =:: mut: pos
    '`' pos@ updateFilePos ## string content starts after `
    context [] .stringParseBuffer .length =:: offset
    context [] .stringParseBuffer
      $ .length str .length + sb.ensureCap
      0:i64 while $ str .length < do =:: i
        str i string.charAt =:: c
        c pos@ updateFilePos
        c '`' != if
          c sb.appendC
          i 1 + continue
        end
        i 1 + str .length >= if
          "unexpected end of raw string" sb.wrap
          pos errors appendError
        end
        str i 1 + string.charAt
          $ pos@ updateFilePos
        sb.appendC
        i 2 +
      end ..drop
    context [] .stringParseBuffer =
    context [] .stringParseBuffer
      sb.asStr offset string.tail
    context newStringConst
      context [] .stringParseBuffer
        offset sb.setLength
      context [] .stringParseBuffer =
    return
  end
end
