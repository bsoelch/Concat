import stringBuilder

import "files.concat"
import "labels.concat"
import "types.concat"

import debug

i64 =:: export: ProcId
i64 =:: export: ProcBundleId
i64 =:: export: ConstantId
struct( i64 : offset i64 : length ) =:: export: ConstantArray
struct( ConstantId : value i64 : eltIndex ) =:: export: UnionConstant
union(
  _ : none
  bool : boolean
  i64 : enumLabel
  char8 : chr ## XXX? rename chr -> Char , int -> Int for consistency
  i64 : int
  f64 : Float
  StringConstant : str
  ConstantArray : str16
  ConstantArray : str32
  ConstantArray : arrayConstant
  Type : typeId
  _ : wildCard
  LabelId : genericArg
  ProcId : procedure
  ProcBundleId : procedureBundle
  UnionConstant : union
) =:: export: ConstValue

struct(
  i16 list : mut: array16Values
  i32 list : mut: array32Values
  ConstValue list : mut: arrayValues
) =:: export: ConstantContext

proc( -> ConstantContext ) =>: export: newConstContext
  ## ConstantContext
   128 i16 list.create
   128 i32 list.create
   128 ConstValue list.create
 ConstantContext new return
end
proc( -> ConstantArray ) =>: export: emptyConstArray
  0 0 ConstantArray new
end
proc( i16 arrayView : elts ConstantContext ptr.mut : context -> ConstantArray ) =>: constArray16
  context [] .array16Values .length
    context [] .array16Values
      elts list.appendArray
    context [] .array16Values =
  elts .length ConstantArray new return
end
proc( i32 arrayView : elts ConstantContext ptr.mut : context -> ConstantArray ) =>: constArray32
  context [] .array32Values .length
    context [] .array32Values
      elts list.appendArray
    context [] .array32Values =
  elts .length ConstantArray new return
end
proc( ConstValue arrayView : elts ConstantContext ptr.mut : context -> ConstantArray ) =>: export: constArray
  context [] .arrayValues .length
    context [] .arrayValues
      elts list.appendArray
    context [] .arrayValues =
  elts .length ConstantArray new return
end

proc( ConstantArray : elts i64 : index ConstantContext ptr : context -> ConstValue ) =>: export: constArrayGet
  context [] .arrayValues elts .offset index + list.get return
end
proc( ConstantArray : elts i64 : index ConstantContext ptr : context -> i16 ) =>: export: constArray16Get
  context [] .array16Values elts .offset index + list.get return
end
proc( ConstantArray : elts i64 : index ConstantContext ptr : context -> i32 ) =>: export: constArray32Get
  context [] .array32Values elts .offset index + list.get return
end

proc( ConstantArray : elts ConstantContext ptr : context -> i16 arrayView ) =>: export: sc16AsStr
  elts .offset 0 < if
    i16 array.empty return
  end
  context [] .array16Values .length elts .offset elts .length + < if
    i16 array.empty return
  end
  context [] .array16Values .data elts .offset + elts .length array.create return
end
proc( ConstantArray : elts ConstantContext ptr : context -> i32 arrayView ) =>: export: sc32AsStr
  elts .offset 0 < if
    i32 array.empty return
  end
  context [] .array32Values .length elts .offset elts .length + < if
    i32 array.empty return
  end
  context [] .array32Values .data elts .offset + elts .length array.create return
end
proc( ConstantArray : elts ConstantContext ptr : context -> ConstValue arrayView ) =>: export: constArrayAsArray
  elts .offset 0 < if
    ConstValue array.empty return
  end
  context [] .arrayValues .length elts .offset elts .length + < if
    ConstValue array.empty return
  end
  context [] .arrayValues .data elts .offset + elts .length array.create return
end

## XXX? use char16/char32 arrayView (? string16/string32 types) for string types
proc( i16 arrayView : elts ConstantContext ptr.mut : context -> ConstValue ) =>: export: newStr16Const
  elts context constArray16 ConstValue .str16 return
end
proc( i32 arrayView : elts ConstantContext ptr.mut : context -> ConstValue ) =>: export: newStr32Const
  elts context constArray32 ConstValue .str32 return
end
proc( ConstValue arrayView : elts ConstantContext ptr.mut : context -> ConstValue ) =>: export: newArrayConst
  elts context constArray ConstValue .arrayConstant return
end

proc( ConstValue : value i64 : index ConstantContext ptr.mut : context -> ConstValue ) =>: export: newUnionConst
  context [] .arrayValues
    ..dup .length ConstantId cast =:: valueId
    value list.append
  context [] .arrayValues =
  valueId index UnionConstant new ConstValue .union return
end
proc(
  ConstValue : union
  i64 : eltIndex
  ConstantContext ptr : context
-> ConstValue bool ) =>: export: constUnionElement
  context [] .arrayValues
    union .union .value i64 cast
  list.get union .union .eltIndex eltIndex != return
end

proc( ConstValue : a ConstValue : b LabelContext ptr : labelContext -> bool ) =>: export: constantEquals
  a ..label b ..label != if ##different constant types
    false return
  end
  a switch
    none wildCard case
      true return
    boolean case
      a .boolean b .boolean == return
    enumLabel case
      a .enumLabel b .enumLabel == return
    int case
      a .int b .int == return
    Float case
      a .Float b .Float == return
    chr case
      a .chr b .chr == return
    str case
      a .str .length b .str .length != if
        false return
      end
      a .str .offset b .str .offset == if
        true return
      end
      a .str b .str labelContext id.scEqual return
    str16 case
      a .str16 .length b .str16 .length != if
        false return
      end
      a .str16 .offset b .str16 .offset == if
        true return
      end
      ## TODO str16 equality
      false return
    str32 case
      a .str32 .length b .str32 .length != if
        false return
      end
      a .str32 .offset b .str32 .offset == if
        true return
      end
      ## TODO str32 equality
      false return
    arrayConstant case
      a .arrayConstant .length b .arrayConstant .length != if
        false return
      end
      a .arrayConstant .offset b .arrayConstant .offset == if
        true return
      end
      ## TODO array equality
      false return
    typeId case
      a .typeId b .typeId types.typeEquals return
    procedure case
      a .procedure b .procedure == return
    procedureBundle case
      a .procedureBundle b .procedureBundle == return
    genericArg case
      a .genericArg b .genericArg == return
    union case
      a .union .eltIndex b .union .eltIndex != if
        false return
      end
      ## TODO check equality of value
      a .union .value b .union .value == return
  end
end

namespace: sb
  proc( stringBuilder char8 : c -> stringBuilder ) =>: export: appendEscapedChr
    c i32 cast.u =:: chr
    chr 0x20 < or chr 0x7f >= if ## non-printable ASCII-characters + hex-codes for multi-char characters
      "\\x" sb.appendS
      chr 0xff &
        ..dup 0x10 < if ..swap '0' sb.appendC ..swap end
      sb.appendX
      return
    end
    c '\\' == c '\'' == | c '\"' == | if
      '\\' sb.appendC
      c sb.appendC
      return
    end
    c sb.appendC
  end
  proc( stringBuilder : sb StringConstant : str LabelContext ptr : labelContext -> stringBuilder ) =>: export: appendEscapedStr
    sb
      0:i64 while ..dup str .length < do =:: i
          str i labelContext id.scCharAt appendEscapedChr
        i 1 +
      end ..drop
    return
  end
  ## C-style string escaping, use octal sequences as hex-sequences may consume following characters
  proc( stringBuilder char8 : c -> stringBuilder ) =>: export: appendEscapedChrC
    c i32 cast.u =:: chr
    chr 0x20 < or chr 0x7f >= if
      ## non-printable ASCII-characters
      "\\" sb.appendS
      chr 0xff &
        ..dup 0o10 < if
          ..swap "00" sb.appendS ..swap
        else ..dup 0o100 < _if
          ..swap '0' sb.appendC ..swap
        end
      i64 cast.u 8 sb.appendI?
      return
    end
    c '\\' == c '\'' == | c '\"' == | if
      '\\' sb.appendC
      c  sb.appendC
      return
    end
    c  sb.appendC
  end
  proc( stringBuilder : sb StringConstant : str LabelContext ptr : labelContext -> stringBuilder ) =>: export: appendEscapedStrC
    sb
      0:i64 while ..dup str .length < do =:: i
        str i labelContext id.scCharAt appendEscapedChrC
        i 1 +
      end ..drop
    return
  end
  proc(
    stringBuilder : sb
    ConstValue : val
    ConstantContext ptr : constContext
    TypeContext ptr : typeContext
  -> stringBuilder ) =>: export: appendConstant
    typeContext [] .labelContext @ =:: labelContext
    sb
      val switch
        none case
          "none"  sb.appendS
          break
        wildCard case
          "_"  sb.appendS
          break
        boolean case
          "bool: " sb.appendS
          val .boolean if "true" sb.appendS else "false" sb.appendS end
          break
        int case
          "integer: " sb.appendS
          val .int    sb.appendI
          break
        Float case
          "float: "  sb.appendS
          val .Float sb.appendF
          break
        str case
          "string: \"" sb.appendS
          val .str labelContext sb.appendEscapedStr
                 '\"'  sb.appendC
          break
        str16 case
          val .str16 constContext sc16AsStr =:: str
          "string16: \"" sb.appendS
            0:i64 while $ str .length < do =:: i
              str i array.get =:: c
              c 0x20 < or c 0x7f >= if ## XXX? allow some characters outside ascii
                "\\u" sb.appendS
                c 0x1000   ..u< if '0' sb.appendC end
                c 0x100    ..u< if '0' sb.appendC end
                c 0x10     ..u< if '0' sb.appendC end
                c i32 cast.u sb.appendX
              else
                c char8 cast sb.appendC
              end
              i 1 +
            end ..drop
         '\"'  sb.appendC
          break
        str32 case
          val .str32 constContext sc32AsStr =:: str
          "string32: \"" sb.appendS
            0:i64 while $ str .length < do =:: i
              str i array.get =:: cp
              cp 0 < if
                "\\x" sb.appendS
                cp -0x10 > if '0' sb.appendC end
                cp -_ sb.appendX
              else cp 0x20 < or cp 0x7f >= _if ## XXX? allow some characters outside ascii
                "\\U00" sb.appendS
                cp 0x100000 ..u< if '0' sb.appendC end
                cp 0x10000  ..u< if '0' sb.appendC end
                cp 0x1000   ..u< if '0' sb.appendC end
                cp 0x100    ..u< if '0' sb.appendC end
                cp 0x10     ..u< if '0' sb.appendC end
                cp sb.appendX
              else
                cp char8 cast sb.appendC
              end
              i 1 +
            end ..drop
         '\"'  sb.appendC
          break
        chr case
          "char: \'" sb.appendS
          val .chr   sb.appendEscapedChr
               '\''  sb.appendC
          break
        typeId case
          "type: "     sb.appendS
          val .typeId typeContext sb.appendType
          break
        enumLabel case
          "enum label: (" sb.appendS
          val .enumLabel  sb.appendI
                   ')'    sb.appendC
          break
        arrayConstant case
          val .arrayConstant =:: mArray
          "{ " sb.appendS
          0:i64 while ..dup mArray .length < do =:: i
            mArray i constContext constArrayGet constContext typeContext appendConstant
            ' ' sb.appendC
            i 1 +
          end ..drop
          "}" sb.appendS
          break
        procedure case
          "procedure: "  sb.appendS
          val .procedure i64 cast sb.appendI
          break
        procedureBundle case
          "procedure bundle: "  sb.appendS
          val .procedureBundle i64 cast sb.appendI
          break
        genericArg case
          "generic argument: "  sb.appendS
          val .genericArg i64 cast sb.appendI
          ## XXX? print label
          break
        union case
          "union element ("  sb.appendS
          val .union .eltIndex sb.appendI
          "):" sb.appendS
            constContext [] .arrayValues
              val .union .value i64 cast
            list.get
            constContext
            typeContext
          sb.appendConstant
          break
      end
    return
  end
end
