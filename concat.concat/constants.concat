#include future

#include "files.concat"
#include "labels.concat"
#include "types.concat"

enum( none wildCard bool : boolean i64 : int id.StringConstant : str i8 : chr types.Type : typeId ) =:: public ConstValue
struct( types.Type : valueType ConstValue : val FilePosition : pos ) =:: public Constant

proc( FilePosition : pos => Constant ) =: public constWildcard
  types.Type .undefined ConstValue .wildCard new pos Constant new return
end
proc( i64 FilePosition => Constant ) =: public constInt
  =:: pos
  #dup i32.MIN < #over i32.MAX > | if types.primitive.I64 else types.primitive.I32 end #swap ConstValue .int new pos Constant new return
end
proc( id.StringConstant FilePosition => Constant ) =: public constStr
  =:: pos
  types.Type .undefined #swap ConstValue .str new pos Constant new return ## TODO store correct string type
end
proc( i8 FilePosition => Constant ) =: public constChar
  =:: pos
  types.primitive.I8 #swap ConstValue .chr new pos Constant new return
end
proc( bool FilePosition => Constant ) =: public constBool
  =:: pos
  types.primitive.BOOL #swap ConstValue .boolean new pos Constant new return
end
proc( types.Type FilePosition => Constant ) =: public constType
  =:: pos
  types.primitive.TYPE #swap ConstValue .typeId new pos Constant new return
end
proc( ConstValue types.Type FilePosition => Constant ) =: public newConst
  =:: pos
  #swap pos Constant new return
end
