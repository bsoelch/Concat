import stringBuilder
import arenaAlloc
import unicode

import "files.concat"
import "names.concat"
import "types.concat"

type : export: ConstValue
struct( ConstValue ptr : value i32 : eltIndex ) =:: export: UnionConstant

## pointers to mutable constants in interpreter
ConstValue ptr.mut =:: export: LocalAddress
ConstValue slice.mut =:: export: LocalSlice
i8 slice.mut =:: export: LocalSlice8
i16 slice.mut =:: export: LocalSlice16
i32 slice.mut =:: export: LocalSlice32
i64 slice.mut =:: export: LocalSlice64

## XXX? use wrapper types for array constants to prevent accidental assignment of external values
union(
  _ : None
  bool : Bool
  char8 : Char
  i64 : Int
  f64 : Float
  ## XXX? float arrays
  i8  slice : Array8
  i16 slice : Array16
  i32 slice : Array32
  i64 slice : Array64
  ConstValue slice : Array
  Type : TypeId
  _ : WildCard
  NameId : GenericArg
  NameId : GlobalPointer
  ProcId : Procedure
  ProcBundleId : ProcedureBundle
  UnionConstant : Union
  LocalAddress : LocalValue
  LocalSlice : LocalArray
  LocalSlice8 : LocalArray8
  LocalSlice16 : LocalArray16
  LocalSlice32 : LocalArray32
  LocalSlice64 : LocalArray64
) =:: export: ConstValue

struct(
  MixedArenaAllocator : arrayValues
  stringBuilder : stringParseBuffer
) =:: export: ConstantContext
## XXX? free const context
proc( -> ConstantContext ) =>: export: newConstContext
  ## ConstantContext
   4096 mixedArena.create
   256  sb.create
 ConstantContext new return
end
proc( ConstantContext -> ConstantContext ) =>: export: freeConstContext
  $ .arrayValues mixedArena.free >$ .arrayValues=
  $ .stringParseBuffer sb.free >$ .stringParseBuffer=
end

proc(
 type : auto: T
 T slice : elts
 ConstantContext ptr.mut : context
-> T slice ) =>: constPrimitiveArray
  context [] .arrayValues
    elts mixedArena.copySlice slice.freeze =:: result
  context .arrayValues=
  result return
end
proc(
  ConstValue slice : elts
  ConstantContext ptr.mut : context
-> ConstValue slice ) =>: export: constArray
  context [] .arrayValues
    elts mixedArena.copySlice slice.freeze =:: result
  context .arrayValues=
  result return
end

proc( i8 slice : elts ConstantContext ptr.mut : context -> ConstValue ) =>: export: newArray8Const
  elts context constPrimitiveArray ConstValue .Array8 return
end
proc( string : elts ConstantContext ptr.mut : context -> ConstValue ) =>: export: newStringConst
  elts string.bytes context newArray8Const return
end
proc( string : elts ConstantContext ptr.mut : context -> ConstValue ) =>: export: newLenStringConst
  ConstValue 2 array : mut: structData
  structData@ slice.wrapMutable
    elts context newStringConst $1 0 =[]
    elts .length i64 cast.u ConstValue .Int $1 1 =[]
  slice.freeze context newArrayConst
end
proc( string : elts -> ConstValue ) =>: export: wrapStringConst
  elts string.bytes ConstValue .Array8 return
end
proc( i16 slice : elts ConstantContext ptr.mut : context -> ConstValue ) =>: export: newArray16Const
  elts context constPrimitiveArray ConstValue .Array16 return
end
proc( i32 slice : elts ConstantContext ptr.mut : context -> ConstValue ) =>: export: newArray32Const
  elts context constPrimitiveArray ConstValue .Array32 return
end
proc( i64 slice : elts ConstantContext ptr.mut : context -> ConstValue ) =>: export: newArray64Const
  elts context constPrimitiveArray ConstValue .Array64 return
end
proc(
  ConstValue slice : elts
  ConstantContext ptr.mut : context
-> ConstValue ) =>: export: newArrayConst
  elts context constArray ConstValue .Array return
end

proc(
  ConstValue : value
  i32 : index
  ConstantContext ptr.mut : context
-> ConstValue ) =>: export: newUnionConst
  context [] .arrayValues
    value mixedArena.copyValue =:: valuePtr
  context .arrayValues=
  valuePtr index UnionConstant new ConstValue .Union return
end
proc(
  ConstValue : union
  i32 : eltIndex
-> ConstValue bool ) =>: export: constUnionElement
  union .Union .else ..drop
    ConstValue .None false return
  end =:: unionConst
  unionConst .value [] unionConst .eltIndex eltIndex != return
end
proc(
  ConstValue : union
-> ConstValue ) =>: export: constUnionTag
  union .Union .else return end .eltIndex i64 cast.u ConstValue .Int return
end

proc( ConstValue : a ConstValue : b -> bool ) =>: export: constantEquals
  a b constantCmp 0 ==
end
proc( ConstValue : a ConstValue : b -> i32 ) =>: export: constantCmp
  a ..tag b ..tag != if ##different constant types
    a ..tag b ..tag <=> return
  end
  a switch
    None WildCard case 0 return
    Bool .case ?1 b .Bool unionElement.unwrap ?1 >$ - return
    Int .case b .Int unionElement.unwrap i64.cmp return
    Float .case b .Float unionElement.unwrap  f64.cmp return
    Char .case b .Char unionElement.unwrap char8.cmp return
    Array8 .case b .Array8 unionElement.unwrap slice.cmp return
    Array16 .case b .Array16 unionElement.unwrap slice.cmp return
    Array32 .case b .Array32 unionElement.unwrap slice.cmp return
    Array64 .case b .Array64 unionElement.unwrap slice.cmp return
    Array .case b .Array unionElement.unwrap constantCmp@ slice.cmp return
    TypeId .case b .TypeId unionElement.unwrap types.typeCmp return
    Procedure .case b .Procedure unionElement.unwrap ProcId.cmp return
    ProcedureBundle .case i64 cast.u b .ProcedureBundle unionElement.unwrap i64 cast.u i64.cmp return
    GenericArg .case b .GenericArg unionElement.unwrap NameId.cmp return
    GlobalPointer .case b .GlobalPointer unionElement.unwrap NameId.cmp return
    Union .case =:: aUnion
      b .Union unionElement.unwrap =:: bUnion
      aUnion .eltIndex bUnion .eltIndex != if
        aUnion .eltIndex bUnion .eltIndex <=> return
      end
      aUnion .value bUnion .value == if 0 return end
      aUnion .value []
        bUnion .value []
      constantCmp return
    ## local values are compared with pointer identity ! update hash function when this changes
    LocalValue .case ConstValue ptr.raw cast b .LocalValue unionElement.unwrap ConstValue ptr.raw cast ptr.cmp return
    LocalArray .case =:: aLocalArray
      b .LocalArray unionElement.unwrap =:: bLocalArray
      ## local arrays are only equal if memory ranges coincide
      aLocalArray .length bLocalArray .length <=>
        $ ? if return else ..drop end
      aLocalArray .data bLocalArray .data ptr.cmp return
    LocalArray8 .case =:: aLocalArray
      b .LocalArray8 unionElement.unwrap =:: bLocalArray
      ## local arrays are only equal if memory ranges coincide
      aLocalArray .length bLocalArray .length <=>
        $ ? if return else ..drop end
      aLocalArray .data bLocalArray .data ptr.cmp return
    LocalArray16 .case =:: aLocalArray
      b .LocalArray16 unionElement.unwrap =:: bLocalArray
      ## local arrays are only equal if memory ranges coincide
      aLocalArray .length bLocalArray .length <=>
        $ ? if return else ..drop end
      aLocalArray .data bLocalArray .data ptr.cmp return
    LocalArray32 .case =:: aLocalArray
      b .LocalArray32 unionElement.unwrap =:: bLocalArray
      ## local arrays are only equal if memory ranges coincide
      aLocalArray .length bLocalArray .length <=>
        $ ? if return else ..drop end
      aLocalArray .data bLocalArray .data ptr.cmp return
    LocalArray64 .case =:: aLocalArray
      b .LocalArray64 unionElement.unwrap =:: bLocalArray
      ## local arrays are only equal if memory ranges coincide
      aLocalArray .length bLocalArray .length <=>
        $ ? if return else ..drop end
      aLocalArray .data bLocalArray .data ptr.cmp return
  end
end
## TODO tweak scale factors (would larger primes be better?)
proc( ConstValue : a -> i32 ) =>: export: constantHash
  a switch
    None case 0 return
    WildCard case 1 return
    Bool .case if 2 else 3 end return
    Int .case $ 32 >>> 5 * + i32 cast.u 715415 + 7 * return
    Float .case ## most floats will only differ on the higher 32 bits ( sign+exponent+start of magnitude )
      f64.bits 32 >>> i32 cast.u i32.bitrev 61414 + 11 * return
    Char .case i32 cast.u 1 + 13 * return
    Array8 .case ( i8 -> i32 ) => i32 cast.u end slice.hash 17 * return
    Array16 .case ( i16 -> i32 ) => i32 cast.u end slice.hash 19 * return
    Array32 .case ( i32 -> i32 ) => end slice.hash 23 * return
    Array64 .case ( i64 -> i32 ) => $ 32 >> >$ + i32 cast.u end slice.hash 29 * return
    Array .case constantHash@ slice.hash 31 * return
    TypeId .case types.typeHash 37 * return
    Procedure .case ProcId.hash 1 + 41 * return
    ProcedureBundle .case i32 cast.u 1 + 43 * return
    GenericArg .case NameId.hash 1 + 47 * return
    GlobalPointer .case NameId.hash 1 + 53 * return
    Union .case =:: unionVal
      unionVal .eltIndex
        31 * unionVal .value [] constantHash +
      57 * return
    LocalValue .case ## identity hash for identity comparisson
      ConstValue ptr.raw cast iSize cast! i64 cast.u $ 32 >>> >$ + i32 cast.u 59 * return
    ## local arrays are only equal if memory ranges coincide
    LocalArray .case =:: arrayData
      arrayData .data iSize cast! 31:iSize *
        arrayData .length +
      i64 cast.u $ 32 >>> >$ + i32 cast.u 61 * return
    LocalArray8 .case =:: arrayData
      arrayData .data iSize cast! 31:iSize *
        arrayData .length +
      i64 cast.u $ 32 >>> >$ + i32 cast.u 67 * return
    LocalArray16 .case =:: arrayData
      arrayData .data iSize cast! 31:iSize *
        arrayData .length +
      i64 cast.u $ 32 >>> >$ + i32 cast.u 71 * return
    LocalArray32 .case =:: arrayData
      arrayData .data iSize cast! 31:iSize *
        arrayData .length +
      i64 cast.u $ 32 >>> >$ + i32 cast.u 73 * return
    LocalArray64 .case =:: arrayData
      arrayData .data iSize cast! 31:iSize *
        arrayData .length +
      i64 cast.u $ 32 >>> >$ + i32 cast.u 79 * return
  end
end
namespace: constant
  ## Detect if a given i8 array is a string constant
  proc( i8 slice : bytes -> bool ) =>: isString
    0:iSize =:: mut: nonPrintable
    bytes string.fromBytes
    0:iSize while $1 .length $1 u> do
      utf8.nextCodepoint =:: cp
      cp unicode.MIN_CODEPOINT < or cp unicode.MAX_CODEPOINT > if
        ..drop.2 false return ## definitely no string
      end
      cp i32 cast =:: intValue
      intValue #+newLine+# 0x0a != and intValue 0x20 < or intValue 0x7f == if ## non-printable ascii
        nonPrintable 1:iSize + nonPrintable=
      end
    end ..drop.2
    ## at most 1/8 non-printable chars
    nonPrintable bytes .length 4:iSize + 8:iSize / u<= return
  end

  proc(
    Type : mut: valType
    TypeContext ptr.mut : typeContext
    ConstantContext ptr.mut : context
  -> ConstValue ) =>: export: defaultVal
    valType
      typeContext types.unwrapNamed
      .CType .if types.cTypeAsType typeContext types.unwrapNamed end
    valType=
    valType switch
      Undefined Empty Align case ConstValue .None return
      PrimitiveType .case switch
        BOOL case false ConstValue .Bool return
        I8 I16 I32 I64 case 0 ConstValue .Int return
        F16 F32 F64 case 0 ConstValue .Float return
        TYPE case Type .Undefined ConstValue .TypeId return
      end break
      Pointer MutablePointer RawPointer MutableRawPointer Procedure case
        0 ConstValue .Int return
      ArrayType .case types.arrayTypeBase typeContext types.unwrapNamed =:: baseType
        valType typeContext types.getArraySize .Int .else
          "unsupported size for constant array" ..panic
        end i32 cast.u =:: count
        baseType types.isPrimitive and baseType types.primitive.TYPE types.typeEquals ! if
          baseType typeContext types.strideOf .Fixed .else "dynamic size primitive" ..panic end switch
            1 case
              context [] .arrayValues count i8 mixedArena.allocSlice =:: elts context .arrayValues=
              elts .data elts .length mem.clear ..drop
              elts slice.freeze ConstValue .Array8
            return
            2 case
              context [] .arrayValues count i16 mixedArena.allocSlice =:: elts context .arrayValues=
              elts .data elts .length mem.clear ..drop
              elts slice.freeze ConstValue .Array16
            return
            4 case
              context [] .arrayValues count i32 mixedArena.allocSlice =:: elts context .arrayValues=
              elts .data elts .length mem.clear ..drop
              elts slice.freeze ConstValue .Array32
            return
            8 case
              context [] .arrayValues count i64 mixedArena.allocSlice =:: elts context .arrayValues=
              elts .data elts .length mem.clear ..drop
              elts slice.freeze ConstValue .Array64
            return
            default "unexpected size for primitive" ..panic
          end
        else
          count 0 == if
            ConstValue slice.empty context newArrayConst
          else
            context [] .arrayValues count ConstValue mixedArena.allocSlice =:: elts context .arrayValues=
            baseType typeContext context defaultVal =:: eltVal
            count for =:: i
              eltVal elts i =[]
            end
            elts slice.freeze ConstValue .Array return
          end
        end
      break
      Struct case
        valType typeContext types.compositeElts =:: eltTypes
        context [] .arrayValues
          eltTypes .length i32 cast.u ConstValue mixedArena.allocSlice =:: elts
        context .arrayValues=
        eltTypes .length for =:: i
          eltTypes i [] typeContext context defaultVal elts i =[]
        end
        elts slice.freeze ConstValue .Array return
      break
      TaggedUnion RawUnion UnionElement Enum case
        "unimplemented: union default values" ..panic
      CType NamedType case ..unreachable
      SetType case
        "unimplemented: set-type default values" ..panic
      Quotation .case ConstValue .Procedure return
      GenericType GeneratedType RefinementType
          IntLiteral Initializer case
        "unsupported type for zero-initialized constant" ..panic
    end
  end
end
namespace: sb
  proc( stringBuilder char8 : c -> stringBuilder ) =>: export: appendEscapedChr
    c i32 cast.u =:: chr
    chr 0x20 < or chr 0x7f >= if ## non-printable ASCII-characters + hex-codes for multi-char characters
      "\\x" sb.appendS
      chr 0xff &
        ..dup 0x10 < if ..swap '0' sb.appendC ..swap end
      sb.appendX
      return
    end
    c '\\' == c '\'' == | c '\"' == | if
      '\\' sb.appendC
      c sb.appendC
      return
    end
    c sb.appendC
  end
  proc( stringBuilder : sb string : str -> stringBuilder ) =>: export: appendEscapedStr
    sb
      str string.chars for appendEscapedChr end
    return
  end
  ## C-style string escaping, use octal sequences as hex-sequences may consume following characters
  proc( stringBuilder char8 : c -> stringBuilder ) =>: export: appendEscapedChrC
    c i32 cast.u =:: chr
    chr 0x20 < or chr 0x7f >= if
      ## non-printable ASCII-characters
      "\\" sb.appendS
      chr 0xff &
        ..dup 0o10 < if
          ..swap "00" sb.appendS ..swap
        else ..dup 0o100 < _if
          ..swap '0' sb.appendC ..swap
        end
      i64 cast.u 8 sb.appendI?
      return
    end
    c '\\' == c '\'' == | c '\"' == | if
      '\\' sb.appendC
      c  sb.appendC
      return
    end
    c  sb.appendC
  end
  proc( stringBuilder : sb string : str -> stringBuilder ) =>: export: appendEscapedStrC
    sb
      str string.chars for appendEscapedChrC end
    return
  end
  8:iSize =:: MAX_ARRAY_ELEMENTS
  12:iSize =:: MAX_PRIMITIVE_ARRAY_ELEMENTS
  36:iSize =:: MAX_STRING_CHARS
  24:iSize =:: MAX_STRING_CHARS_HEAD
  8:iSize =:: MAX_STRING_CHARS_TAIL
  ## XXX? limit call depth (to prevent infinite recursion)
  proc(
    stringBuilder : sb
    ConstValue : val
    TypeContext ptr : typeContext
  -> stringBuilder ) =>: export: appendConstant
    typeContext .nameContext =:: nameContext
    sb
      val switch
        None case
          "none"  sb.appendS
          break
        WildCard case
          "_"  sb.appendS
          break
        Bool .case if "true":s else "false":s end sb.appendStr break
        Int .case sb.appendI break
        Float .case sb.appendF break
        Char .case =:: charVal
          '\''  sb.appendC
            charVal sb.appendEscapedChr
          '\''  sb.appendC
          break
        TypeId .case typeContext sb.appendType break
        Array .case =:: mArray ## TODO? labeled array?
          mArray .length
            MAX_ARRAY_ELEMENTS 1:iSize - iSize.min
          =:: maxElements
          "{ " sb.appendS
          0:iSize while ..dup maxElements u< do =:: i
            mArray i [] typeContext appendConstant
            ' ' sb.appendC
            i 1:iSize +
          end ..drop
          mArray .length MAX_ARRAY_ELEMENTS u>= if
            mArray .length MAX_ARRAY_ELEMENTS u> if "... " sb.appendS end
            mArray $ .length 1:iSize - [] typeContext appendConstant
            ' ' sb.appendC
          end
          "}" sb.appendS
          break
        Array8 .case =:: mArray
          mArray constant.isString if ## array is string constant
            mArray .length MAX_STRING_CHARS u<= if
              '\"'  sb.appendC
              mArray string.fromBytes sb.appendEscapedStr
              '\"'  sb.appendC
            else
              '\"'  sb.appendC
              mArray
                MAX_STRING_CHARS_HEAD slice.head
              string.fromBytes sb.appendEscapedStr
              "\"...\""  sb.appendS
              mArray
                $ .length MAX_STRING_CHARS_TAIL - slice.tail
              string.fromBytes sb.appendEscapedStr
              '\"'  sb.appendC
            end
            return
          end
          mArray .length
            MAX_PRIMITIVE_ARRAY_ELEMENTS 1:iSize - iSize.min
          =:: maxElements
          "{ " sb.appendS
          0:iSize while ..dup maxElements u< do =:: i
            mArray i [] i64 cast.s appendI
            ":i8 " sb.appendS
            i 1:iSize +
          end ..drop
          mArray .length MAX_PRIMITIVE_ARRAY_ELEMENTS u>= if
            mArray .length MAX_PRIMITIVE_ARRAY_ELEMENTS u> if "... " sb.appendS end
            mArray $ .length 1:iSize - [] i64 cast.s appendI
            ":i8 " sb.appendS
          end
          "}" sb.appendS
          break
        Array16 .case =:: mArray
          mArray .length
            MAX_PRIMITIVE_ARRAY_ELEMENTS 1:iSize - iSize.min
          =:: maxElements
          "{ " sb.appendS
          0:iSize while ..dup maxElements u< do =:: i
            mArray i [] i64 cast.s appendI
            ":i16 " sb.appendS
            i 1:iSize +
          end ..drop
          mArray .length MAX_PRIMITIVE_ARRAY_ELEMENTS u>= if
            mArray .length MAX_PRIMITIVE_ARRAY_ELEMENTS u> if "... " sb.appendS end
            mArray $ .length 1:iSize - [] i64 cast.s appendI
            ":i16 " sb.appendS
          end
          "}" sb.appendS
          break
        Array32 .case =:: mArray
          mArray .length
            MAX_PRIMITIVE_ARRAY_ELEMENTS 1:iSize - iSize.min
          =:: maxElements
          "{ " sb.appendS
          0:iSize while $ maxElements u< do =:: i
            mArray i [] i64 cast.s appendI
            ":i32 " sb.appendS
            i 1:iSize +
          end ..drop
          mArray .length MAX_PRIMITIVE_ARRAY_ELEMENTS u>= if
            mArray .length MAX_PRIMITIVE_ARRAY_ELEMENTS u> if "... " sb.appendS end
            mArray $ .length 1:iSize - [] i64 cast.s appendI
            ":i32 " sb.appendS
          end
          "}" sb.appendS
          break
        Array64 .case =:: mArray
          "{ " sb.appendS
          mArray .length
            MAX_PRIMITIVE_ARRAY_ELEMENTS 1:iSize - iSize.min
          =:: maxElements
          0:iSize while ..dup maxElements u< do =:: i
            mArray i [] appendI
            ":i64 " sb.appendS
            i 1:iSize +
          end ..drop
          mArray .length MAX_PRIMITIVE_ARRAY_ELEMENTS u>= if
            mArray .length MAX_PRIMITIVE_ARRAY_ELEMENTS u> if "... " sb.appendS end
            mArray $ .length 1:iSize - [] i64 cast.s appendI
            ":i64 " sb.appendS
          end
          "}" sb.appendS
          break
        Procedure .case
          ProcId.getName nameContext sb.appendIdentifierPath '@' sb.appendC
          break
        ProcedureBundle .case i64 cast sb.appendI
          ":ProcBundleId"  sb.appendS
        break
        GenericArg .case
          sb.appendIdentifierName
        break
        GlobalPointer .case
          typeContext .nameContext sb.appendIdentifierPath
          '@' sb.appendC
          break
        Union .case =:: unionVal
          "union element ("  sb.appendS
            unionVal .eltIndex sb.appendI
          "): " sb.appendS
            unionVal .value []
            typeContext
          sb.appendConstant
          break
        LocalValue .case =:: localVal
            "local value ( "  sb.appendS
              localVal ConstValue ptr.mut cast [] typeContext sb.appendConstant
            " )" sb.appendS
          break
        LocalArray .case =:: arrVal
            "local array ( "  sb.appendS
              arrVal
                ConstValue slice.mut cast slice.freeze
              ConstValue .Array typeContext sb.appendConstant
            " )" sb.appendS
          break
        LocalArray8 .case =:: arrVal
            "local array8 ( "  sb.appendS
              arrVal
                i8 slice.mut cast slice.freeze
              ConstValue .Array8 typeContext sb.appendConstant
            " )" sb.appendS
          break
        LocalArray16 .case =:: arrVal
            "local array16 ( "  sb.appendS
              arrVal
                i16 slice.mut cast slice.freeze
              ConstValue .Array16 typeContext sb.appendConstant
            " )" sb.appendS
          break
        LocalArray32 .case =:: arrVal
            "local array32 ( "  sb.appendS
              arrVal
                i32 slice.mut cast slice.freeze
              ConstValue .Array32 typeContext sb.appendConstant
            " )" sb.appendS
          break
        LocalArray64 .case =:: arrVal
            "local array64 ( "  sb.appendS
              arrVal
                i64 slice.mut cast slice.freeze
              ConstValue .Array64 typeContext sb.appendConstant
            " )" sb.appendS
          break
      end
    return
  end
end

namespace: constants
  proc(
    FilePosition : pos
    ConstantContext ptr.mut : context
  -> FilePosition ptr ) =>: copyPos ## copy position to persistent memory
    context [] .arrayValues
      pos mixedArena.copyValue <$
    context .arrayValues=
  end
  proc(
    string : str
    FilePosition : stringStart
    CompilerError list ptr.mut : errors
    ConstantContext ptr.mut : context
  -> ConstValue ) =>: export: parseStringConstant
    ## TODO improve readability of stack based code (?extract loop counter to variable)
    stringStart =:: mut: pos
    '"' pos@ updateFilePos ## string content starts after "
    context [] .stringParseBuffer .length =:: offset
    context [] .stringParseBuffer
      $ .length str .length + sb.ensureCap
      0:iSize while ..dup str .length u< do =:: mut: i
        str i string.charAt
          $ pos@ updateFilePos
        $ '\\' != if
          sb.appendC
          continue
        end ..drop
        i 1:iSize + i=
        str i string.charAt $ switch
          '\\' '\'' '"' case
            $ pos@ updateFilePos
            sb.appendC
            break
          'n' case
            pos@ updateFilePos
            '\n' sb.appendC
            break
          't' case
            pos@ updateFilePos
            '\t' sb.appendC
            break
          'b' case
            pos@ updateFilePos
            '\b' sb.appendC
            break
          'r' case
            pos@ updateFilePos
            '\r' sb.appendC
            break
          'f' case
            pos@ updateFilePos
            '\f' sb.appendC
            break
          'v' case
            pos@ updateFilePos
            '\v' sb.appendC
            break
          'x' 'u' 'U' case =:: c
            c pos@ updateFilePos
            i 1:iSize + i=
            c 'x' == if 2:iSize else c 'u' == _if 4:iSize else 8:iSize end =:: nChars
            i nChars + str .length u> if
              "not enough characters for escape sequence \"\\" sb.copyPtr
                c               sb.appendC
                "\" need "      sb.appendS
                nChars          sb.appendI
                " got "         sb.appendS
                str .length i - sb.appendI
              pos context copyPos errors appendError
              continue
            end
            str .data i @[] nChars string.create 16 number.tryParseInt .NONE if
              $ 0 < if ..drop
                "invalid hex-code for escape sequence: \"\\" sb.copyPtr
                  c sb.appendC
                  str .data i @[] nChars string.create sb.appendStr
                  '\"' sb.appendC
                pos context copyPos errors appendError
              else
                c 'x' == if
                  char8 cast sb.appendC
                else c 'u' == _if
                  unicode.Codepoint cast sb.appendCodepoint
                else c 'U' == _if
                  $ unicode.MAX_CODEPOINT i64 cast.u > if
                    "code-point outside allowed range: \"\\U" sb.copyPtr
                      str .data i @[] nChars string.create sb.appendStr
                      "\" (maximum: 0x" sb.appendS
                      unicode.MAX_CODEPOINT i64 cast.u sb.appendX
                      ")" sb.appendS
                    pos@ errors appendWarning
                  end
                  unicode.Codepoint cast sb.appendCodepoint
                else ..drop
                  "unknown hex-escape sequence: \"\\" sb.copyPtr
                    c sb.appendC '\"'
                    sb.appendC
                  pos context copyPos errors appendError
                end
              end
            else ..drop
              "invalid hex-code for escape sequence: \"\\" sb.copyPtr
                c sb.appendC
                str .data i @[] nChars string.create sb.appendStr
                '\"' sb.appendC
              pos context copyPos errors appendError
            end
            0:iSize while $ nChars u< do =:: j
              str i j + string.charAt pos@ updateFilePos
            finally j 1:iSize + end ..drop
            i nChars 1:iSize - + i=
            continue
          default
            "unknown escape sequence \"\\" sb.copyPtr
              $1 sb.appendC
              '\"' sb.appendC
            pos context copyPos errors appendError
            pos@ updateFilePos
        end
      finally i 1:iSize + end ..drop
    context .stringParseBuffer=
    context [] .stringParseBuffer
      sb.asStr offset string.tail
    context newStringConst
      context [] .stringParseBuffer
        offset sb.setLength
      context .stringParseBuffer=
    return
  end
  proc(
    string : str
    FilePosition : stringStart
    CompilerError list ptr.mut : errors
    ConstantContext ptr.mut : context
  -> ConstValue ) =>: export: parseRawStringConstant
    stringStart =:: mut: pos
    '`' pos@ updateFilePos ## string content starts after `
    context [] .stringParseBuffer .length =:: offset
    context [] .stringParseBuffer
      $ .length str .length + sb.ensureCap
      0:iSize while $ str .length u< do =:: i
        str i string.charAt =:: c
        c pos@ updateFilePos
        c '`' != if
          c sb.appendC
          i 1:iSize + continue
        end
        i 1:iSize + str .length u>= if
          "unexpected end of raw string" sb.copyPtr
          pos context copyPos errors appendError
        end
        str i 1:iSize + string.charAt
          $ pos@ updateFilePos
        sb.appendC
        i 2:iSize +
      end ..drop
    context .stringParseBuffer=
    context [] .stringParseBuffer
      sb.asStr offset string.tail
    context newStringConst
      context [] .stringParseBuffer
        offset sb.setLength
      context .stringParseBuffer=
    return
  end
end
