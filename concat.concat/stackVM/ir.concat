namespace: stackvm
  enum( I8 I16 I32 I64 F16 F32 F64 ) =:: export: ValType
  struct(
    i16 : index
  ) =:: export: StackLocation
  i32 =:: LabelId
  struct(
    LabelId : labelId
    i32 : offset
  ) =:: export: Label
  struct(
    LabelId : target
    LabelId : base
  ) =:: export: LabelDifference
  enum( CODE RO_DATA RW_DATA LOCAL ) =:: export: MemorySection
  struct(
    i32 : value
    i8 : shift
  ) =:: export: OpLoadi
  struct(
    i32 : offset
    StackLocation : val
    StackLocation : src
    i8 : size
  ) =:: export: OpLoad
  struct(
    i32 : offset
    StackLocation : val
    MemorySection : base
    i8 : size
  ) =:: export: OpLoadRelative
  struct(
    Label : label
    StackLocation : val
    i8 : size
  ) =:: export: OpLoadLabel
  struct(
    i32 : offset
    StackLocation : val1
    StackLocation : val2
    StackLocation : src
  ) =:: export: OpLoad2
  struct(
    i32 : offset
    StackLocation : val1
    StackLocation : val2
    MemorySection : base
  ) =:: export: OpLoad2Relative
  struct(
    Label : label
    StackLocation : val1
    StackLocation : val2
  ) =:: export: OpLoad2Label
  struct(
    i32 : offset
    StackLocation : dst
    MemorySection : base
  ) =:: export: OpAddr
  struct(
    Label : base
    StackLocation : dst
  ) =:: export: OpAddrLabel
  enum( ADD SUB MUL AND OR XOR SHL LSHR ASHR ) =:: export: BinaryOpType
  struct(
    StackLocation : dst
    StackLocation : src1
    StackLocation : src2
    BinaryOpType : opType
    ValType : valType
  ) =:: export: OpBinary
  enum( EQ NE LT LE ULT ULE ) =:: export: CmpType
  struct(
    StackLocation : dst
    StackLocation : src1
    StackLocation : src2
    CmpType : cmpType
    ValType : valType
  ) =:: export: OpCmp
  enum( DIV REM DIVREM UDIV UREM UDIVREM ) =:: export: DivType
  struct(
    StackLocation optional : dst0
    DivType : divType
    StackLocation : dst
    StackLocation : src1
    StackLocation : src2
    ValType : valType
  ) =:: export: OpDiv
  struct(
    StackLocation : dst
    StackLocation : src1
    i16 : src2
    bool : swapArgs
    CmpType : cmpType
    ValType : valType
  ) =:: export: OpCmpImm
  struct(
    StackLocation : dst
    StackLocation : src1
    i16 : src2
    BinaryOpType : opType
    ValType : valType
  ) =:: export: OpBinaryImm
  enum( SHL LSHR ASHR ) =:: ShiftType
  struct(
    StackLocation : dst
    StackLocation : src1
    i16 : src2
    ShiftType : shiftType
    ValType : valType
  ) =:: export: OpShiftImm
  enum( NEG NOT ) =:: UnaryOpType
  struct(
    StackLocation : dst
    StackLocation : src
    UnaryOpType : opType
    ValType : valType
  ) =:: export: OpUnary
  struct(
    StackLocation : dst
    StackLocation : src
    ValType : srcType
    ValType : dstType
    bool : signed
  ) =:: export: OpCvt
  enum( JMP CALL JMP_ADDR CALL_ADDR JZ_POP JNZ_POP ) =:: JmpType
  struct(
    i32 : target
    JmpType : jmpType
  ) =:: export: OpJmp
  struct(
    i32 : target
    StackLocation : addr
    JmpType : jmpType
  ) =:: export: OpJmpAddr
  struct(
    Label : target
    JmpType : jmpType
  ) =:: export: OpJmpLabel
  struct(
    i32 : target
    StackLocation : cond
    JmpType : jmpType
  ) =:: export: OpJmpIf
  struct(
    Label : target
    StackLocation : cond
    JmpType : jmpType
  ) =:: export: OpJmpIfLabel
  struct(
    i32 : count
  ) =:: export: OpDrop
  struct(
    StackLocation : dst
    StackLocation : src
    i16 : dropCount
  ) =:: export: OpCopy
  struct(
    StackLocation : dst
    StackLocation : dst1
    StackLocation : src
    StackLocation : src2
    i16 : dropCount
  ) =:: export: OpCopy2
  struct(
    StackLocation : dst
    StackLocation : dst1
    StackLocation : dst2
    StackLocation : src
    StackLocation : src1
    StackLocation : src3
  ) =:: export: OpCopy3
  struct(
    StackLocation : loc1
    StackLocation : loc2
  ) =:: export: OpSwap
  struct(
    StackLocation : dst
    StackLocation : src
  ) =:: export: OpInsert
  struct(
    StackLocation : dst
    StackLocation : src
  ) =:: export: OpExtract
  struct(
    i32 : count
  ) =:: export: OpAlloc
  struct(
    i32 : id
  ) =:: export: OpSyscall
  struct(
    LabelId : id
  ) =:: export: OpLabel
  union(
    i64 : Int
    f16 : Float16
    f32 : Float32
    f64 : Float64
    Label : shadow: Label
    LabelDifference : LabelDiff
  ) =:: DataConstant
  struct(
    DataConstant slice : data
    ValType : valType
  ) =:: export: OpData
  struct(
    i32 : count
    ValType : valType
  ) =:: export: OpReserve
  struct(
    i32 : alignment
  ) =:: export: OpAlign

  union(
    OpLoadi : Loadi
    OpLoad : Load
    OpLoad : Store
    OpLoadRelative : LoadRelative
    OpLoadRelative : StoreRelative
    OpLoadLabel : LoadLabel
    OpLoadLabel : StoreLabel
    OpLoad2 : Load2
    OpLoad2 : Store2
    OpLoad2Relative : Load2Relative
    OpLoad2Relative : Store2Relative
    OpLoad2Label : Load2Label
    OpLoad2Label : Store2Label
    OpAddr : Addr
    OpAddrLabel : AddrLabel
    OpBinary : Binary
    OpCmp : Cmp
    OpDiv : Div
    OpCmpImm : CmpImm
    OpBinaryImm : BinaryImm
    OpShiftImm : ShiftImm
    OpUnary : Unary
    OpCvt : Cvt
    OpJmp : Jmp
    OpJmpAddr : JmpAddr
    OpJmpLabel : JmpLabel
    OpJmpIf : JmpIf
    OpJmpIfLabel : JmpIfLabel
    _ : Ret
    OpDrop : Drop
    OpCopy : Copy
    OpCopy2 : Copy2
    OpCopy3 : Copy3
    OpSwap : Swap
    OpInsert : Insert
    OpExtract : Extract
    OpAlloc : Alloc
    OpSyscall : Syscall
    OpLabel : shadow: Label
    OpData : Data
    OpReserve : Reserve
    OpAlign : Align
    _ : Start
  ) =:: export: Operation
end
