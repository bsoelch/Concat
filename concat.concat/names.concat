import numbers
import string
import stringBuilder
import list
import optional
import arenaAlloc
using std.literals.

import "files.concat"
import "common.concat"

struct( NamespaceId : current NamespaceImportId : imports ) =:: export: NamespaceInfo

struct(
  NamespaceId : imported
  NamespaceImportId : parent
  string : nameAlias
  NamespaceImportId : firstChild
  NamespaceImportId : next
) =:: export: NamespaceImport

namespace: id
  i32 =:: export: ScopeId
  ( char8 ptr.raw iSize -> ScopeId ) : static: export: alias: :ScopeId ..builtIn.parse.i32
  -1:ScopeId =:: export: NO_SCOPE
   0:ScopeId =:: export: GLOBAL_SCOPE

  i32 =:: export: IdentifierFlag
  ( char8 ptr.raw iSize -> IdentifierFlag ) : static: export: alias: :IdentifierFlag ..builtIn.parse.i32
  proc( IdentifierFlag IdentifierFlag -> IdentifierFlag ) : alias: flagAnd i32.and
  proc( IdentifierFlag IdentifierFlag -> IdentifierFlag ) : alias: flagOr  i32.or
  proc( IdentifierFlag IdentifierFlag -> IdentifierFlag ) : alias: flagXor i32.xor
  proc( IdentifierFlag -> IdentifierFlag ) : alias: flagFlip i32.flip
  proc( IdentifierFlag -> bool ) : alias: flagToBool i32.toBool
  overload: merge: &  flagAnd    end
  overload: merge: |  flagOr     end
  overload: merge: ^  flagXor    end
  overload: merge: ~  flagFlip   end
  overload: merge: ?  flagToBool end

  0x0000:IdentifierFlag =:: export: FLAG_NONE
  0x0001:IdentifierFlag =:: export: FLAG_MUTABLE
  0x0002:IdentifierFlag =:: export: FLAG_AUTO
  0x0004:IdentifierFlag =:: export: FLAG_EXTERN
  0x0008:IdentifierFlag =:: export: FLAG_EXPORT
  0x0010:IdentifierFlag =:: export: FLAG_STATIC
  0x0020:IdentifierFlag =:: export: FLAG_INLINE
  0x0040:IdentifierFlag =:: export: FLAG_NO_INLINE
  0x0080:IdentifierFlag =:: export: FLAG_EMPTY
  0x0100:IdentifierFlag =:: export: FLAG_BUILT_IN
  0x0200:IdentifierFlag =:: export: FLAG_DUMMY
  0x0400:IdentifierFlag =:: export: FLAG_ITR_VAR
  0x0800:IdentifierFlag =:: export: FLAG_SHADOW
  0x1000:IdentifierFlag =:: export: FLAG_ALIAS
  0x2000:IdentifierFlag =:: export: FLAG_MERGE
  0x4000:IdentifierFlag =:: export: FLAG_LAMBDA
  0x8000:IdentifierFlag =:: export: FLAG_MERGEABLE
  0x10000:IdentifierFlag =:: export: FLAG_IGNORE_UNUSED
  0x20000:IdentifierFlag =:: export: FLAG_NO_WRAP
  0x40000:IdentifierFlag =:: export: FLAG_IS_READ
  0x80000:IdentifierFlag =:: export: FLAG_IS_WRITTEN
  0x100000:IdentifierFlag =:: export: FLAG_HAS_POINTER

 ## 0x20000000:IdentifierFlag FLAG_IGNORE_UNUSED | =:: export: FLAG_LIB_FILE ## in library file
  0x20010000:IdentifierFlag =:: export: FLAG_LIB_FILE ## XXX temporary until renamed built-ins are supported
  0x40000000:IdentifierFlag =:: export: FLAG_EXPERIMENTAL
end

struct( string : name NamespaceId list : children NamespaceId : parent ) =:: Namespace
type : Identifier
Identifier ptr.mut =:: export: NameId
struct(
  string : name
  FilePosition ptr : pos
  NamespaceInfo : namespaceInfo
  NameId optional : baseName
  id.IdentifierFlag : flags
) =:: Identifier
namespace: NameId
  ## TODO? should hash/equality/cmp be by value or by reference
  proc( NameId : a -> i32 ) =>: export: hash
    a iSize cast! $ 32 >>> ^ i32 cast.u return
  end
  proc( NameId : a NameId : b -> bool ) =>: export: eq
    a iSize cast! b iSize cast! iSize.eq return
  end
  proc( NameId : a NameId : b -> i32 ) =>: export: cmp
    a iSize cast! b iSize cast! iSize.cmp return
  end

  proc( NameId : a -> i32 ) =>: export: hashName
    a Identifier ptr cast [] .name string.hash
  end
  proc( NameId optional -> i32 ) =>: export: hashNameO
    .else 0 return end hashName
  end
  proc( NameId : a NameId : b -> i32 ) =>: export: cmpName
    a b ptr.eq if 0 return end
    a Identifier ptr cast [] .name b Identifier ptr cast [] .name string.compare
  end
  proc( NameId optional : a? NameId optional : b? -> i32 ) =>: export: cmpNameO
    a? .else b? ? if 0 else -1 end return end =:: a
    b? .else 1 return end =:: b
    a b cmpName
  end
end
namespace: ProcId ## TODO need to prevent cyclic dependency ? move ProcId from program into seperate file
  proc( ProcId -> NameId ) : export: getName
end

struct(
  MixedArenaAllocator : allocator
  i32 : tmpCount
  Namespace list : namespaces
  NamespaceImport list : namespaceImports
  NamespaceInfo : namespaceInfo
) =:: export: NameContext
namespace: id

  proc( -> NameContext ) =>: export: newNameContext
    4096   mixedArena.create
      0
      32 Namespace list.create
      string.empty
      32 NamespaceId list.create
      NAMESPACE_ID_NONE
      Namespace new list.append ## root namespace
    32 NamespaceImport list.create
      0:NamespaceId
      NAMESPACE_IMPORT_NONE
    NamespaceInfo new
    NameContext new return
  end
  proc( NameContext -> NameContext ) =>: export: freeNameContext
    =:: mut: context
    context .allocator mixedArena.free context@ .allocator=
    0:iSize while $ context .namespaces .length u< do =:: i
      context .namespaces i @[] =:: namespace
      namespace [] .children list.free namespace .children=
      i 1:iSize +
    end ..drop
    context .namespaces       list.free context@ .namespaces=
    context .namespaceImports list.free context@ .namespaceImports=
    context return
  end

  proc( NameId : id -> Identifier ptr.mut ) =>: getIdentifier
    id Identifier ptr.mut cast
  end
  proc( NameId : id -> string ) =>: export: getIdentifierName
    ## the addresses of label names are stable for the lifetime of the context
    id getIdentifier [] .name return
  end
  proc( NameId : id -> NamespaceId ) =>: export: getIdentifierNamespace
    id getIdentifier [] .namespaceInfo .current return
  end
  proc( NameId : id -> FileId ) =>: export: getIdentifierFile
    id getIdentifier [] .pos [] .fileId return
  end
  proc( NameId : id -> FilePosition ptr ) =>: export: getIdentifierPos
    id getIdentifier [] .pos return
  end
  proc( NameId : id -> NameId optional ) =>: export: getBaseName
    id getIdentifier [] .baseName return
  end
  proc( NameId : id NamespaceInfo : newVal -> ) =>: export: setIdentifierNamespace
    id getIdentifier  newVal >$ .namespaceInfo=
  end
  proc( NameContext ptr.mut : context -> NamespaceInfo ) =>: export: currentNamespace
    context [] .namespaceInfo return
  end
  proc( NameId : id NameContext ptr.mut : context -> ) =>: export: inIdentifierNamespace
    id getIdentifier [] .namespaceInfo context .namespaceInfo=
  end
  proc( NamespaceInfo NameContext ptr.mut : context -> ) =>: export: resetNamespace
    context .namespaceInfo=
  end
  proc( NameContext ptr.mut : context -> ) =>: export: clearNamespace
    0:NamespaceId NAMESPACE_IMPORT_NONE NamespaceInfo new context .namespaceInfo=
  end
  proc( string : str NameId : id -> bool ) =>: export: identifierNameEq
    id getIdentifier [] .name str string.eq return
  end
  proc( NameId : a NameId : b -> bool ) =>: export: identifierNamesEq
    a b ptr.eq if
      true return
    end
    a getIdentifier [] .name b getIdentifier [] .name string.eq return
    false return
  end
  proc( NameId optional : a? NameId optional : b? -> bool ) =>: export: identifierNamesEqO
    a? .else b? ? ! return end =:: a
    b? .else false return end =:: b
    a b identifierNamesEq
  end
  proc( NameId : id -> IdentifierFlag ) =>: export: identifierFlags
    id getIdentifier [] .flags return
  end
  proc( NameId : id IdentifierFlag : newFlags -> ) =>: export: addIdentifierFlags
    id getIdentifier .flags =:: flags
    flags []
      newFlags |
    flags =[]
  end

  proc(
    string : str
    NameContext ptr.mut : context
  -> string ) =>: export: copyString
    context [] .allocator
      str string.chars mixedArena.copySlice slice.freeze string.fromChars =:: nameData
    context .allocator=
    nameData return
  end
  proc(
    string : str
    IdentifierFlag : flags
    FilePosition ptr : pos
    NameContext ptr.mut : context
  -> NameId ) =>: export: newIdentifier
    str context copyString =:: nameCopy
    context [] .allocator
      ## Identifier
        nameCopy
        pos
        context [] .namespaceInfo
        NameId optional.empty
        flags
      Identifier new mixedArena.copyValue NameId cast =:: nameId
    context .allocator=
    nameId return
  end
  proc(
    IdentifierFlag : flags
    FilePosition ptr : pos
    NameContext ptr.mut : context
  -> NameId ) =>: export: newTmpIdentifier
    char8 16 array : mut: buffer
    ## newIdentifier
      buffer@ sb.wrapBuffer
        "tmp@":s sb.appendStr
        context [] .tmpCount
          $ 1 + context .tmpCount=
        i64 cast.u 62 sb.appendU?
      sb.asStr
      flags
      pos
    context newIdentifier
  end
  proc(
    NameId : baseNameId
    i32 : implId
    NameContext ptr.mut : context
  -> NameId ) =>: export: newImplName
    baseNameId getIdentifier =:: baseName
    implId i32.highestSetBit 4 / 2 + =:: idLength ## hex-length +1
    context [] .allocator
      baseName [] .name .length i32 cast.u idLength + char8 mixedArena.allocSlice =:: nameMemory
    context .allocator=
    nameMemory sb.wrapSlice sb.clear
      baseName [] .name sb.appendStr
      ':' sb.appendC
      implId sb.appendX
    sb.asStr =:: implName
    context [] .allocator
      ## Identifier
        implName
        baseName [] .pos
        baseName [] .namespaceInfo
        baseNameId optional.wrap
        baseName [] .flags id.FLAG_EXPORT ~ &
      Identifier new mixedArena.copyValue NameId cast =:: nameId
    context .allocator=
    nameId return
  end

  proc( NamespaceId : parent string : name  NameContext ptr.mut : context -> NamespaceId ) =>: newNamespace
    context [] .namespaces .length =:: id
    context [] .namespaces
      name context copyString
      16 NamespaceId list.create
      parent
      Namespace new list.append
    context .namespaces=
    id NamespaceId cast return
  end
  proc( NamespaceId : base string : childName bool : create  NameContext ptr.mut : context  -> NamespaceId ) =>: export: childId
    base NAMESPACE_ID_NONE == or childName .length 0:iSize == if
      NAMESPACE_ID_NONE return
    end
    childName '.' string.indexOf .if =:: dotIndex
      ## name contains dot -> search for nested namespace
      childName dotIndex string.splitIndex =:: head =:: tail
      base head create context childId
        tail create context childId
      return
    end
    base iSize cast.u context [] .namespaces .length u>= if
      NAMESPACE_ID_NONE return ## id out of range
    end
    context [] .namespaces base i32 cast @[] =:: baseSpace
    0:iSize while $ baseSpace [] .children .length u< do =:: i
      baseSpace [] .children i [] i32 cast =:: child
      childName context [] .namespaces child [] .name string.eq if
        child NamespaceId cast return
      end
      i 1:iSize +
    end ..drop
    create ! if
      NAMESPACE_ID_NONE return
    end
    base childName context newNamespace
      context [] .namespaces base i32 cast @[]
        ..dup [] .children
          ..over.2 list.append
      ..swap .children=
    return
  end
  proc(
    NamespaceId : base
    string : path
    NameContext ptr.mut : context
    bool : create
  -> NamespaceId ) =>: export: findNamespace_internal
    base NamespaceId =: mut: id
    path
      while $ .length 0:iSize != do
        '.' string.split
        id >$ create context childId id=
        id NAMESPACE_ID_NONE == if
          break
        end
      end
    ..drop
    id return
  end
  proc(
    NamespaceId : base
    string : path
    NameContext ptr.mut : context
  -> NamespaceId ) =>: export: findNamespace
    base path context false findNamespace_internal
  end
  proc( NamespaceId : id NameContext ptr : context -> string ) =>: export: namespaceName
    id NAMESPACE_ID_NONE == if
      string.empty return
    end
    context [] .namespaces id i64 cast [] .name return
  end
  proc( NamespaceId : id NameContext ptr : context -> NamespaceId ) =>: export: parentNamespace
    id NAMESPACE_ID_NONE == if
      NAMESPACE_ID_NONE return
    end
    context [] .namespaces id i64 cast [] .parent return
  end
  proc(
    NamespaceImportId : parent
    NamespaceId : importId
    string : aliasName
    NameContext ptr.mut : context
  -> NamespaceImportId ) =>: export: getNamespaceImportId
    context [] .namespaceImports .length 0:iSize != if
      parent NAMESPACE_IMPORT_NONE == if
        0:NamespaceImportId
      else
        context [] .namespaceImports parent i64 cast [] .firstChild
      end
      ..dup NAMESPACE_IMPORT_NONE == if
        context [] .namespaceImports .length NamespaceImportId cast
          context [] .namespaceImports parent i64 cast @[] .firstChild=
      end
      NAMESPACE_IMPORT_NONE ..swap
        while ..dup NAMESPACE_IMPORT_NONE != do ..swap ..drop
          context [] .namespaceImports ..over i64 cast [] .imported importId == if
            return
          end
          context [] .namespaceImports ..over i64 cast [] .next
        end ..drop
      ..dup NAMESPACE_IMPORT_NONE != if
        context [] .namespaceImports .length NamespaceImportId cast
          context [] .namespaceImports ..over.2 i64 cast @[] .next=
      end ..drop
    end
    context [] .namespaceImports
      importId
      parent
      aliasName
      NAMESPACE_IMPORT_NONE
      NAMESPACE_IMPORT_NONE
      NamespaceImport new list.append
    context .namespaceImports=
    context [] .namespaceImports .length 1:iSize - NamespaceImportId cast return
  end
end

namespace: sb
  proc( stringBuilder NameId : id -> stringBuilder ) =>: export: appendIdentifierName
    id id.getIdentifier [] .name sb.appendStr return
  end
  proc( stringBuilder NameId : id -> stringBuilder ) =>: export: appendAciifiedIdentifierName
    id id.getIdentifier [] .name sb.appendAsciified return
  end
  proc( stringBuilder : sb NameId : id NameContext ptr : context bool : asciify -> stringBuilder ) =>: appendIdentifierPath_internal
    id id.getIdentifier =:: ident
    string 64 array : mut: pathBuffer
    pathBuffer@ list.wrapBuffer
      ident [] .namespaceInfo .current =:: mut: mNamespace
      while mNamespace id.NAMESPACE_ID_NONE != and mNamespace 0:NamespaceId != do
        mNamespace context id.namespaceName list.append
        mNamespace context id.parentNamespace mNamespace=
      end
    =:: namePath
    asciify if
      sb
        namePath .length 1:iSize - while $ 0:iSize iSize.sge do =:: i
          namePath i [] sb.appendAsciified
          ".":s sb.appendAsciified
        finally i 1:iSize - end ..drop
        ident [] .name sb.appendAsciified
      return
    else
      sb
        namePath .length 1:iSize - while $ 0:iSize iSize.sge do =:: i
          namePath i [] sb.appendStr
          '.' sb.appendC
        finally i 1:iSize - end ..drop
        ident [] .name sb.appendStr
      return
    end
  end
  proc( stringBuilder : sb NameId : id NameContext ptr : context -> stringBuilder ) =>: export: appendIdentifierPath
    sb id context false appendIdentifierPath_internal
  end
  proc( stringBuilder : sb NameId : id NameContext ptr : context -> stringBuilder ) =>: export: appendAsciifiedIdentifierPath
    sb id context true appendIdentifierPath_internal
  end
end
