import string

import "program.concat"

enum(
 ## arithmetic
 NEG_I8 NEG_I16 NEG_I32 NEG_I64 NEG_F32 NEG_F64 ## -_
 ADD_I8 ADD_I16 ADD_I32 ADD_I64 ADD_F32 ADD_F64 ## +
 SUB_I8 SUB_I16 SUB_I32 SUB_I64 SUB_F32 SUB_F64 ## -
 MUL_I32 MUL_I64 MUL_F32 MUL_F64                ## *
 ## XXX? div f64 i32
 DIV_I32 DIV_I64I32 DIV_I64 DIV_F32 DIV_F64     ## /
 REM_I32 REM_I64I32 REM_I64                     ## %
 UDIV_I32 UDIV_I64I32 UDIV_I64                  ## u/
 UMOD_I32 UMOD_I64I32 UMOD_I64                  ## u%
 ## logic
 NOT_BOOL                                       ## !
 FLIP_I8 FLIP_I16 FLIP_I32 FLIP_I64             ## ~
 AND_BOOL OR_BOOL XOR_BOOL             ## boolean ops
 AND_I8 AND_I16 AND_I32 AND_I64        ## &
 OR_I8 OR_I16 OR_I32 OR_I64            ## |
 XOR_I8 XOR_I16 XOR_I32 XOR_I64        ## ^
 LSHR_I8 LSHR_I16 LSHR_I32 LSHR_I64I32 LSHR_I64 ## >>>
 ASHR_I8 ASHR_I16 ASHR_I32 ASHR_I64I32 ASHR_I64 ## >>
 SHL_I8 SHL_I16 SHL_I32 SHL_I64I32 SHL_I64      ## <<
 ## comparison
 EQ_BOOL EQ_I8 EQ_I16 EQ_I32 EQ_I64 EQ_F32 EQ_F64 ## ==
 NE_BOOL NE_I8 NE_I16 NE_I32 NE_I64 NE_F32 NE_F64 ## !=
 LT_I8 LT_I16 LT_I32 LT_I64 LT_F32 LT_F64 ## <
 LE_I8 LE_I16 LE_I32 LE_I64 LE_F32 LE_F64 ## <=
 GE_I8 GE_I16 GE_I32 GE_I64 GE_F32 GE_F64 ## >=
 GT_I8 GT_I16 GT_I32 GT_I64 GT_F32 GT_F64 ## >
 ULT_I8 ULT_I16 ULT_I32 ULT_I64                  ## u<
 ULE_I8 ULE_I16 ULE_I32 ULE_I64                  ## u<=
 UGE_I8 UGE_I16 UGE_I32 UGE_I64                  ## u>=
 UGT_I8 UGT_I16 UGT_I32 UGT_I64                  ## u>
 ## conversions
 CONVERT_S8_I16 CONVERT_S8_I32 CONVERT_S8_I64 CONVERT_S8_F32 CONVERT_S8_F64 ## i8 -> ...
   CONVERT_U8_I16 CONVERT_U8_I32 CONVERT_U8_I64 CONVERT_U8_F32 CONVERT_U8_F64
 CONVERT_I16_I8 CONVERT_S16_I32 CONVERT_S16_I64 CONVERT_S16_F32 CONVERT_S16_F64 ## i16 -> ...
   CONVERT_U16_I32 CONVERT_U16_I64 CONVERT_U16_F32 CONVERT_U16_F64
 CONVERT_I32_I8 CONVERT_I32_I16 CONVERT_S32_I64 CONVERT_U32_I64 ## i32 -> ...
   CONVERT_S32_F32 CONVERT_U32_F32 CONVERT_S32_F64 CONVERT_U32_F64
 CONVERT_I64_I8 CONVERT_I64_I16 CONVERT_I64_I32 ## i64 -> ...
   CONVERT_S64_F32 CONVERT_U64_F32 CONVERT_S64_F64 CONVERT_U64_F64
 CONVERT_F32_S8 CONVERT_F32_S16 CONVERT_F32_S32 CONVERT_F32_S64 CONVERT_F32_F64 ## f32 -> ...
   CONVERT_F32_U8 CONVERT_F32_U16 CONVERT_F32_U32 CONVERT_F32_U64
 CONVERT_F64_S8 CONVERT_F64_S16 CONVERT_F64_S32 CONVERT_F64_S64 CONVERT_F64_F32 ## f64 -> ...
   CONVERT_F64_U8 CONVERT_F64_U16 CONVERT_F64_U32 CONVERT_F64_U64
 SYS_ARGC SYS_ARGV SYS_ENVP
 ## pointer access
 GET_PTR SET_PTR OFFSET_PTR COPY_PTR CLEAR_PTR
 ## TODO? more built-in operations
 PARSE_I8 PARSE_I16 PARSE_I32 PARSE_I64 PARSE_F16 PARSE_F32 PARSE_F64
 TYPE_IS_PRIMITIVE TYPE_IS_POINTER TYPE_IS_VALUE_POINTER TYPE_IS_RAW_POINTER TYPE_IS_ARRAY TYPE_IS_STRUCT
 TYPE_IS_SET_TYPE TYPE_IS_REFINEMENT_TYPE TYPE_IS_TAGGED_UNION TYPE_IS_UNION_ELEMENT TYPE_IS_RAW_UNION TYPE_IS_ENUM TYPE_IS_PROC
 TYPE_IS_NAMED TYPE_IS_CTYPE TYPE_IS_ALIGN TYPE_IS_MUTABLE TYPE_IS_DEFINED
 TYPE_EQUAL TYPE_CAN_ASSIGN TYPE_CAN_CAST
 TYPE_ARRAY_ELEMENT TYPE_UNION_TAG TYPE_GET_UNION_ELEMENT TYPE_GET_UNION_ELEMENT_UNION TYPE_GET_ELEMENT TYPE_UNWRAP_NAMED
) =:: export: BuiltIn
## TODO? rename type_array_element to type_get_base_type

proc(
  Type : base
  bool : mutable
  TypeContext ptr.mut : typeContext
-> Type ) =>: wrapPtr
  base
    mutable if types.ArrayType .MUTABLE_RAW_POINTER else types.ArrayType .RAW_POINTER end
    types.ArraySize .None
    typeContext
  types.newArrayType return
end

proc(
  string : name
  FilePosition ptr : pos
  ProgramContext ptr.mut : context
-> ) =>: newBuiltInBundle
  context .idContext =:: idContext
  idContext .typeContext .nameContext =:: nameContext
  nameContext id.clearNamespace
  context [] .procBundles
    ..dup .length ProcBundleId cast =:: bundleId
    newProcBundle list.append
  context .procBundles=
  ## newIdentifier
    name
    id.FLAG_EXPORT id.FLAG_BUILT_IN |
    pos
  nameContext id.newIdentifier =:: nameId
  ## declareIdentifier
    nameId
    Type .Undefined
    IdentifierType .PROCEDURE_BUNDLE
    -1
    bundleId ConstValue .ProcedureBundle
    true
    pos
    idContext
    context .errors
  id.declareIdentifier ..drop
end
-1:ProcBundleId =:: NO_BUNDLE
proc(
  BuiltIn : buildIn
  NameId : procName
  Type : procType
  FilePosition ptr : pos
  ProgramContext ptr.mut : context
  ProcFlags : flags
-> ProcId ) =>: addBuiltIn_internal
  context .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .nameContext =:: nameContext
  context [] .programMemory
    ## ProcedureInfo
      buildIn BuiltInData new ProcImplType .BuiltIn
      procName
      FILE_ID_BUILT_IN
      id.GLOBAL_SCOPE
      procType
      flags
    ProcedureInfo new mixedArena.copyValue ProcId.create =:: procId
  context .programMemory=
  context [] .procedures
    procId list.append
  context .procedures=
  procName nameContext id.inIdentifierNamespace
  ## declareIdentifier
    procName
    Type .Undefined
    IdentifierType .PROCEDURE
    -1
    procId ConstValue .Procedure
    true
    pos
    idContext
    context .errors
  id.declareIdentifier ..drop
  procId return
end
proc(
  BuiltIn : buildIn
  NameId : procName
  Type : procType
  FilePosition ptr : pos
  ProgramContext ptr.mut : context
-> ) =>: addBuiltIn
  buildIn procName procType pos context ProcFlags.NONE addBuiltIn_internal ..drop
end
proc(
  BuiltIn : buildIn
  NameId : procName
  Type : procType
  FilePosition ptr : pos
  ProgramContext ptr.mut : context
-> ) =>: addStaticBuiltIn
  buildIn procName procType pos context ProcFlags.IS_STATIC addBuiltIn_internal ..drop
end
proc(
  BuiltIn : buildIn
  NameId : procName
  Type : procType
  FilePosition ptr : pos
  ProgramContext ptr.mut : context
-> ProcId ) =>: addStaticBuiltInGetId
  buildIn procName procType pos context ProcFlags.IS_STATIC addBuiltIn_internal
end

proc(
  string : name
  FilePosition ptr : pos
  NameContext ptr.mut : nameContext
-> NameId ) =>: createIdentifier
  ## newIdentifier
    name
    id.FLAG_EXPORT id.FLAG_SHADOW | id.FLAG_BUILT_IN |
    pos
  nameContext id.newIdentifier
end

proc(
  Type : t
  ProgramContext ptr.mut : context
-> Type Type Type Type Type ) =>: operatorProcTypes
  context .idContext =:: idContext
  idContext .typeContext =:: typeContext
  Type 2 array new =:: mut: args
  t args@ 0 =[]
  t args@ 1 =[]
  ## newProcedure
    args@ 1 slice.create
    Type slice.empty
    NameId optional slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure =:: consumeVal
  ## newProcedure
    args@ 1 slice.create
    args@ 1 slice.create
    NameId optional slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure =:: unOpProc
  ## newProcedure
    args@ slice.wrap
    args@ 1 slice.create
    NameId optional slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure =:: binOpProc
  ## newProcedure
    args@ slice.wrap
    types.primitive.BOOL@ 1 slice.create
    NameId optional slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure =:: cmpOpProc
  ## newProcedure
    args@ 1 slice.create
    types.primitive.BOOL@ 1 slice.create
    NameId optional slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure =:: toBoolOpProc
  binOpProc unOpProc cmpOpProc toBoolOpProc consumeVal return
end
proc(
  Type : t1
  Type : t2
  ProgramContext ptr.mut : context
-> Type Type ) =>: mixedProcTypes
  context .idContext =:: idContext
  idContext .typeContext =:: typeContext
  Type 2 array new =:: mut: args
  t1 args@ 0 =[]
  t2 args@ 1 =[]
  ## newProcedure
    args@ 2 slice.create
    args@ 1 slice.create
    NameId optional slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure =:: aba
  ## newProcedure
    args@ 2 slice.create
    args@ 1 @[] 1 slice.create
    NameId optional slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure =:: abb
  aba abb return
end
## i64 i32 -> i32 mod/rem/and
## i64 i32 -> i64 div/udiv/shifts
proc(
  Type : t1
  Type : t2
  ProgramContext ptr.mut : context
-> Type ) =>: convertProcType ## t1 -> t2
  context .idContext .typeContext =:: typeContext
  ## newProcedure
    t1@ 1 slice.create
    t2@ 1 slice.create
    NameId optional slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure return
end

proc(
  ProgramContext ptr.mut : context
-> Type Type ) =>: sysProcTypes
  context .idContext =:: idContext
  idContext .typeContext =:: typeContext
  types.CHAR8 false typeContext wrapPtr false typeContext wrapPtr =:: c8pp
  ## newProcedure
    Type slice.empty
    types.primitive.I64@ 1 slice.create
    NameId optional slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure =:: v_i64
  ## newProcedure
    Type slice.empty
    c8pp@ 1 slice.create
    NameId optional slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure =:: v_c8pp
  v_c8pp v_i64 return
end
proc(
  FilePosition ptr : pos
  ProgramContext ptr.mut : context
-> Type Type Type Type Type Type Type ) =>: parseProcTypes
  context .idContext =:: idContext
  idContext .typeContext =:: typeContext
  Type 2 array : mut: typeData
  typeData@ =:: argTypes
  ## char8 ptr.raw  iSize   -> ...
  types.CHAR8 false typeContext wrapPtr argTypes 0 =[]
  types.I_SIZE argTypes 1 =[]
  ## newProcedure
    argTypes slice.wrap
    types.primitive.I8@ 1 slice.create
    NameId optional slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure =:: s_i8
  ## newProcedure
    argTypes slice.wrap
    types.primitive.I16@ 1 slice.create
    NameId optional slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure =:: s_i16
  ## newProcedure
    argTypes slice.wrap
    types.primitive.I32@ 1 slice.create
    NameId optional slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure =:: s_i32
  ## newProcedure
    argTypes slice.wrap
    types.primitive.I64@ 1 slice.create
    NameId optional slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure =:: s_i64
  ## newProcedure
    argTypes slice.wrap
    types.primitive.F16@ 1 slice.create
    NameId optional slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure =:: s_f16
  ## newProcedure
    argTypes slice.wrap
    types.primitive.F32@ 1 slice.create
    NameId optional slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure =:: s_f32
  ## newProcedure
    argTypes slice.wrap
    types.primitive.F64@ 1 slice.create
    NameId optional slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure =:: s_f64
  s_f64 s_f32 s_f16 s_i64 s_i32 s_i16 s_i8 return
end
proc(
  FilePosition ptr : pos
  ProgramContext ptr.mut : context
-> Type Type Type Type ) =>: ptrProcTypes
  context .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .nameContext =:: nameContext
  ## type : auto: T
  NameId optional 3 array : mut: nameData
  Type 3 array : mut: typeData
  ## newIdentifier
    "T":s
    id.FLAG_STATIC id.FLAG_BUILT_IN | id.FLAG_AUTO |
    pos
    nameContext
  id.newIdentifier =:: genericName
  genericName optional.wrap nameData@ 0 =[]
  NameId optional.empty nameData@ 1 =[]
  NameId optional.empty nameData@ 2 =[]
  types.primitive.TYPE typeData@ 0 =[]
  genericName types.newGenericType =:: baseType
  baseType false typeContext wrapPtr =:: basePtr
  baseType true typeContext wrapPtr =:: basePtrMut
  baseType typeData@ 1 =[]
  basePtrMut typeData@ 2 =[]
  ## newProcedure
    typeData@ slice.wrap
    Type slice.empty
    nameData@ slice.wrap
    CallingConvention.DEFAULT
  typeContext types.newProcedure =:: setProc ## auto: T  T  T ptr.raw.mut ->
  basePtr typeData@ 1 =[]
  ## newProcedure
    typeData@ 2 slice.create
    baseType@ slice.wrap
    nameData@ slice.wrap
    CallingConvention.DEFAULT
  typeContext types.newProcedure =:: getProc ## auto: T  T ptr.raw -> T
  types.I_SIZE typeData@ 2 =[]
  ## newProcedure
    typeData@ slice.wrap
    basePtr@ slice.wrap
    nameData@ slice.wrap
    CallingConvention.DEFAULT
  typeContext types.newProcedure =:: offsetProc ## auto: T  T ptr.raw iSize -> T ptr.raw
  basePtrMut typeData@ 1 =[]
  ## newProcedure
    typeData@ slice.wrap
    basePtrMut@ slice.wrap
    nameData@ slice.wrap
    CallingConvention.DEFAULT
  typeContext types.newProcedure =:: offsetMutProc ## auto: T  T ptr.raw.mut iSize -> T ptr.raw.mut
  offsetMutProc offsetProc setProc getProc
end
proc(
  ProgramContext ptr.mut : context
-> Type Type Type Type ) =>: typeProcTypes ## ti32_t tt_bool t_t t_bool
  context .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .nameContext =:: nameContext
  Type 2 array new =:: mut: args
  types.primitive.TYPE args@ 0 =[]
  types.primitive.TYPE args@ 1 =[]
  ## newProcedure
    types.primitive.TYPE@ 1 slice.create
    types.primitive.BOOL@ 1 slice.create
    NameId optional slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure =:: t_b
  ## newProcedure
    types.primitive.TYPE@ 1 slice.create
    types.primitive.TYPE@ 1 slice.create
    NameId optional slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure =:: t_t
  ## newProcedure
    args@ 2 slice.create
    types.primitive.BOOL@ 1 slice.create
    NameId optional slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure =:: tt_b
  types.primitive.I32 args@ 1 =[]
  ## newProcedure
    args@ 2 slice.create
    types.primitive.TYPE@ 1 slice.create
    NameId optional slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure =:: ti32_t
  ti32_t tt_b t_t t_b return
end

proc(
  Type : t
  NameId : nameId
  FilePosition ptr : pos
  ProgramContext ptr.mut : context
-> ) =>: newBuiltInTypeIdentifier
  context .idContext =:: idContext
  ## declareIdentifier
    nameId
    types.primitive.TYPE
    IdentifierType .TYPE
    -1
    t ConstValue .TypeId
    true
    pos
    idContext
    context .errors
  id.declareIdentifier ..drop
end
proc(
  Type : t
  string : name
  FilePosition ptr : pos
  ProgramContext ptr.mut : context
-> ) =>: newBuiltInType
  context .idContext =:: idContext
  idContext .typeContext .nameContext =:: nameContext
  t
    name pos nameContext createIdentifier
    pos
  context newBuiltInTypeIdentifier
end
proc(
  Type : valType
  ConstValue : value
  string : name
  FilePosition ptr : pos
  ProgramContext ptr.mut : context
-> ) =>: newBuiltInConstant
  context .idContext =:: idContext
  idContext .typeContext .nameContext =:: nameContext
  ## declareIdentifier
    name pos nameContext createIdentifier
    valType
    IdentifierType .GLOBAL_VAR
    -1
    value
    true
    pos
    idContext
    context .errors
  id.declareIdentifier ..drop
end
proc(
  FilePosition ptr : pos
  ProgramContext ptr.mut : context
-> ) =>: export: initBuiltInConstants
  context .idContext .typeContext =:: typeContext
  typeContext .nameContext =:: nameContext
  types.primitive.BOOL   "bool":s   pos context newBuiltInType
  types.primitive.BOOL
    true  ConstValue .Bool "true":s
  pos context newBuiltInConstant
  types.primitive.BOOL
    false ConstValue .Bool "false":s
  pos context newBuiltInConstant
  types.primitive.I8     "i8":s     pos context newBuiltInType
  types.primitive.I16    "i16":s    pos context newBuiltInType
  types.primitive.I32    "i32":s    pos context newBuiltInType
  types.primitive.I64    "i64":s    pos context newBuiltInType
  types.primitive.F16    "f16":s    pos context newBuiltInType
  types.primitive.F32    "f32":s    pos context newBuiltInType
  types.primitive.F64    "f64":s    pos context newBuiltInType
  types.primitive.TYPE   "type":s   pos context newBuiltInType
  "char8":s pos nameContext createIdentifier =:: char8Identifier
  types.primitive.CHAR8 char8Identifier typeContext types.initializeNamedType .else
    "failed to initialize named type" ..panic
  end $ types.CHAR8=
  char8Identifier pos context newBuiltInTypeIdentifier
  "iSize":s pos nameContext createIdentifier =:: iSizeIdentifier
  types.primitive.I_SIZE iSizeIdentifier typeContext types.initializeNamedType .else
    "failed to initialize named type" ..panic
  end $ types.I_SIZE=
  iSizeIdentifier pos context newBuiltInTypeIdentifier
  types.primitive.I_SIZE "..type.iSize":s pos context newBuiltInType
  2  Type .Align "..type.align2":s  pos context newBuiltInType
  4  Type .Align "..type.align4":s  pos context newBuiltInType
  8  Type .Align "..type.align8":s  pos context newBuiltInType
  16 Type .Align "..type.align16":s pos context newBuiltInType
  32 Type .Align "..type.align32":s pos context newBuiltInType
  types.ctype.VOID    "..ctype.void":s   pos context newBuiltInType
  types.ctype.BOOL    "..ctype.bool":s   pos context newBuiltInType
  types.ctype.CHAR    "..ctype.char":s   pos context newBuiltInType
  types.ctype.S_CHAR  "..ctype.schar":s  pos context newBuiltInType
  types.ctype.U_CHAR  "..ctype.uchar":s  pos context newBuiltInType
  types.ctype.SHORT   "..ctype.short":s  pos context newBuiltInType
  types.ctype.U_SHORT "..ctype.ushort":s pos context newBuiltInType
  types.ctype.INT     "..ctype.int":s    pos context newBuiltInType
  types.ctype.U_INT   "..ctype.uint":s   pos context newBuiltInType
  types.ctype.LONG    "..ctype.long":s   pos context newBuiltInType
  types.ctype.U_LONG  "..ctype.ulong":s  pos context newBuiltInType
  types.ctype.LONGLONG   "..ctype.longlong":s  pos context newBuiltInType
  types.ctype.U_LONGLONG "..ctype.ulonglong":s pos context newBuiltInType
  types.ctype.SIZE   "..ctype.size":s   pos context newBuiltInType
  types.ctype.FLOAT  "..ctype.float":s  pos context newBuiltInType
  types.ctype.DOUBLE "..ctype.double":s pos context newBuiltInType
  types.ctype.STRUCT "..ctype.struct":s pos context newBuiltInType
  types.ctype.UNION  "..ctype.union":s  pos context newBuiltInType

  types.primitive.BOOL
    _EXPERIMENTAL_ ConstValue .Bool
    "..compiler.flag.experimental":s
  pos context newBuiltInConstant
  types.primitive.BOOL
    _INCLUDE_CORE_ ! ConstValue .Bool
    "..compiler.flag.noCore":s
  pos context newBuiltInConstant
  types.primitive.BOOL
    _INCREMENT_VERSION_ ConstValue .Bool
    "..compiler.flag.incrementVersionNumber":s
  pos context newBuiltInConstant
  types.primitive.I64
    _VERSION_ ConstValue .Int
    "..compiler.version":s
  pos context newBuiltInConstant
end
proc(
  FilePosition ptr : pos
  ProgramContext ptr.mut : context
-> bool ) =>: export: initBuiltInProcs
  context .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .nameContext =:: nameContext
  types.primitive.BOOL
    context operatorProcTypes
  =:: consume_bool =:: bool_bool =:: boolbool_bool ..drop.2
  types.primitive.I8
    context operatorProcTypes
  =:: consume_i8 =:: i8_bool =:: i8i8_bool =:: i8_i8 =:: i8i8_i8
  types.primitive.I16
    context operatorProcTypes
  =:: consume_i16 =:: i16_bool =:: i16i16_bool
      =:: i16_i16 =:: i16i16_i16
  types.primitive.I32
    context operatorProcTypes
  =:: consume_i32 =:: i32_bool =:: i32i32_bool
      =:: i32_i32 =:: i32i32_i32
  types.primitive.I64
    context operatorProcTypes
  =:: consume_i64 =:: i64_bool =:: i64i64_bool
      =:: i64_i64 =:: i64i64_i64
  types.primitive.F32
    context operatorProcTypes
  =:: consume_f32 =:: f32_bool =:: f32f32_bool
      =:: f32_f32 =:: f32f32_f32
  types.primitive.F64
    context operatorProcTypes
  =:: consume_f64 =:: f64_bool =:: f64f64_bool
      =:: f64_f64 =:: f64f64_f64
  types.primitive.I64 types.primitive.I32
    context mixedProcTypes
  =:: i64i32_i32 =:: i64i32_i64
  BuiltIn .NEG_I8
    "..builtIn.neg.i8":s pos nameContext createIdentifier
    i8_i8
  pos context addBuiltIn
  BuiltIn .NEG_I16
    "..builtIn.neg.i16":s pos nameContext createIdentifier
    i16_i16
  pos context addBuiltIn
  BuiltIn .NEG_I32
    "..builtIn.neg.i32":s pos nameContext createIdentifier
    i32_i32
  pos context addBuiltIn
  BuiltIn .NEG_I64
    "..builtIn.neg.i64":s pos nameContext createIdentifier
    i64_i64
  pos context addBuiltIn
  BuiltIn .NEG_F32
    "..builtIn.neg.f32":s pos nameContext createIdentifier
    f32_f32
  pos context addBuiltIn
  BuiltIn .NEG_F64
    "..builtIn.neg.f64":s pos nameContext createIdentifier
    f64_f64
  pos context addBuiltIn
  BuiltIn .ADD_I8
    "..builtIn.add.i8":s pos nameContext createIdentifier
    i8i8_i8
  pos context addBuiltIn
  BuiltIn .ADD_I16
    "..builtIn.add.i16":s pos nameContext createIdentifier
    i16i16_i16
  pos context addBuiltIn
  BuiltIn .ADD_I32
    "..builtIn.add.i32":s pos nameContext createIdentifier
    i32i32_i32
  pos context addBuiltIn
  BuiltIn .ADD_I64
    "..builtIn.add.i64":s pos nameContext createIdentifier
    i64i64_i64
  pos context addBuiltIn
  BuiltIn .ADD_F32
    "..builtIn.add.f32":s pos nameContext createIdentifier
    f32f32_f32
  pos context addBuiltIn
  BuiltIn .ADD_F64
    "..builtIn.add.f64":s pos nameContext createIdentifier
    f64f64_f64
  pos context addBuiltIn
  BuiltIn .SUB_I8
    "..builtIn.sub.i8":s pos nameContext createIdentifier
    i8i8_i8
  pos context addBuiltIn
  BuiltIn .SUB_I16
    "..builtIn.sub.i16":s pos nameContext createIdentifier
    i16i16_i16
  pos context addBuiltIn
  BuiltIn .SUB_I32
    "..builtIn.sub.i32":s pos nameContext createIdentifier
    i32i32_i32
  pos context addBuiltIn
  BuiltIn .SUB_I64
    "..builtIn.sub.i64":s pos nameContext createIdentifier
    i64i64_i64
  pos context addBuiltIn
  BuiltIn .SUB_F32
    "..builtIn.sub.f32":s pos nameContext createIdentifier
    f32f32_f32
  pos context addBuiltIn
  BuiltIn .SUB_F64
    "..builtIn.sub.f64":s pos nameContext createIdentifier
    f64f64_f64
  pos context addBuiltIn
  BuiltIn .MUL_I32
    "..builtIn.mul.i32":s pos nameContext createIdentifier
    i32i32_i32
