import string
using std.literals.

import "program.concat"

## TODO? char+-int
enum(
 ## arithmetic
 NEG_I8 NEG_I16 NEG_I32 NEG_I64 NEG_F32 NEG_F64 ## -_
 ADD_I8 ADD_I16 ADD_I32 ADD_I64 ADD_F32 ADD_F64 ## +
 SUB_I8 SUB_I16 SUB_I32 SUB_I64 SUB_F32 SUB_F64 ## -
 MUL_I32 MUL_I64 MUL_F32 MUL_F64                ## *
 ## XXX? div f64 i32
 DIV_I32 DIV_I64I32 DIV_I64 DIV_F32 DIV_F64     ## /
 REM_I32 REM_I64I32 REM_I64                     ## %
 UDIV_I32 UDIV_I64I32 UDIV_I64                  ## u/
 UMOD_I32 UMOD_I64I32 UMOD_I64                  ## u%
 ## logic
 NOT_BOOL                                       ## !
 FLIP_I8 FLIP_I16 FLIP_I32 FLIP_I64             ## ~
 AND_BOOL OR_BOOL XOR_BOOL             ## boolean ops
 AND_I8 AND_I16 AND_I32 AND_I64        ## &
 OR_I8 OR_I16 OR_I32 OR_I64            ## |
 XOR_I8 XOR_I16 XOR_I32 XOR_I64        ## ^
 LSHR_I8 LSHR_I16 LSHR_I32 LSHR_I64I32 LSHR_I64 ## >>>
 ASHR_I8 ASHR_I16 ASHR_I32 ASHR_I64I32 ASHR_I64 ## >>
 SHL_I8 SHL_I16 SHL_I32 SHL_I64I32 SHL_I64      ## <<
 ## comparison
 EQ_BOOL EQ_I8 EQ_I16 EQ_I32 EQ_I64 EQ_F32 EQ_F64 ## ==
 NE_BOOL NE_I8 NE_I16 NE_I32 NE_I64 NE_F32 NE_F64 ## !=
 LT_I8 LT_I16 LT_I32 LT_I64 LT_F32 LT_F64 ## <
 LE_I8 LE_I16 LE_I32 LE_I64 LE_F32 LE_F64 ## <=
 GE_I8 GE_I16 GE_I32 GE_I64 GE_F32 GE_F64 ## >=
 GT_I8 GT_I16 GT_I32 GT_I64 GT_F32 GT_F64 ## >
 ULT_I8 ULT_I16 ULT_I32 ULT_I64                  ## u<
 ULE_I8 ULE_I16 ULE_I32 ULE_I64                  ## u<=
 UGE_I8 UGE_I16 UGE_I32 UGE_I64                  ## u>=
 UGT_I8 UGT_I16 UGT_I32 UGT_I64                  ## u>
 SYS_ARGC SYS_ARGV SYS_ENVP
 ## pointer access
 GET_PTR GET_PTR_MUT SET_PTR OFFSET_PTR_I32 OFFSET_PTR_I64 OFFSET_PTR OFFSET_PTR_MUT_I32 OFFSET_PTR_MUT_I64 OFFSET_PTR_MUT
 ## XXX? more built-in operations
 PARSE_I8 PARSE_I16 PARSE_I32 PARSE_I64 PARSE_F16 PARSE_F32 PARSE_F64
 TYPE_IS_PRIMITIVE TYPE_IS_POINTER TYPE_IS_RAW_POINTER TYPE_IS_ARRAY TYPE_IS_STRUCT
 TYPE_IS_SET_TYPE TYPE_IS_REFINEMENT_TYPE TYPE_IS_TAGGED_UNION TYPE_IS_UNION_ELEMENT TYPE_IS_RAW_UNION TYPE_IS_ENUM TYPE_IS_PROC
 TYPE_IS_NAMED TYPE_IS_CTYPE TYPE_IS_ALIGN TYPE_IS_MUTABLE TYPE_IS_DEFINED
 TYPE_EQUAL TYPE_CAN_ASSIGN TYPE_CAN_CAST
 TYPE_ARRAY_ELEMENT TYPE_GET_UNION_ELEMENT TYPE_GET_UNION_ELEMENT_UNION TYPE_GET_ELEMENT TYPE_UNWRAP_NAMED
) =:: export: BuiltIn
## TODO? rename type_array_element to type_get_base_type

proc(
  Type : base
  bool : mutable
  TypeContext ptr.mut : typeContext
-> Type ) =>: wrapPtr
  base
    mutable if types.ArrayType .MUTABLE_RAW_POINTER else types.ArrayType .RAW_POINTER end
    types.ArraySize .None
    typeContext
  types.newArrayType .else
    "failed to create array-type" ..panic
  end return
end

proc(
  string : name
  FilePosition ptr : pos
  ProgramContext ptr.mut : context
-> ) =>: newBuiltInBundle
  context .idContext =:: idContext
  idContext .typeContext .labelContext =:: labelContext
  labelContext id.clearNamespace
  context [] .procBundles
    ..dup .length ProcBundleId cast =:: bundleId
    newProcBundle list.append
  context .procBundles=
  ## newLabel
    name
    id.FLAG_EXPORT id.FLAG_BUILT_IN |
    pos
    FILE_ID_BUILT_IN
  labelContext id.newLabel =:: label
  ## declareIdentifier
    label
    Type .Undefined
    IdentifierType .PROCEDURE_BUNDLE
    -1
    bundleId ConstValue .ProcedureBundle
    true
    pos
    FILE_ID_BUILT_IN
    idContext
    context .errors
  id.declareIdentifier =:: isError ..drop.2
end
-1:ProcBundleId =:: NO_BUNDLE
proc(
  BuiltIn : buildIn
  LabelId : procLabel
  Type : procType
  FilePosition ptr : pos
  ProgramContext ptr.mut : context
  bool : hasStaticArgs
  bool : isStatic
-> ProcId ) =>: addBuiltIn_internal
  context .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  context [] .procedures
    ..dup .length ProcId cast =:: procId
    ## ProcedureInfo
      buildIn false BuiltInData new ProcImplType .BuiltIn
      procType
      procLabel
      FILE_ID_BUILT_IN
      id.GLOBAL_SCOPE
      hasStaticArgs
      isStatic
    ProcedureInfo new list.append
  context .procedures=
  procLabel labelContext id.inLabelNamespace
  ## declareIdentifier
    procLabel
    Type .Undefined
    IdentifierType .PROCEDURE
    -1
    procId ConstValue .Procedure
    true
    pos
    FILE_ID_BUILT_IN
    idContext
    context .errors
  id.declareIdentifier =:: isError ..drop.2
  procId return
end
proc(
  BuiltIn : buildIn
  LabelId : procLabel
  Type : procType
  FilePosition ptr : pos
  ProgramContext ptr.mut : context
-> ) =>: addBuiltIn
  buildIn procLabel procType pos context false false addBuiltIn_internal ..drop
end
proc(
  BuiltIn : buildIn
  LabelId : procLabel
  Type : procType
  FilePosition ptr : pos
  ProgramContext ptr.mut : context
-> ) =>: addStaticBuiltIn
  buildIn procLabel procType pos context false true addBuiltIn_internal ..drop
end
proc(
  BuiltIn : buildIn
  LabelId : procLabel
  Type : procType
  FilePosition ptr : pos
  ProgramContext ptr.mut : context
-> ProcId ) =>: addStaticBuiltInGetId
  buildIn procLabel procType pos context false true addBuiltIn_internal
end

proc(
  string : name
  FilePosition ptr : pos
  LabelContext ptr.mut : labelContext
-> LabelId ) =>: createLabel
  ## newLabel
    name
    id.FLAG_EXPORT id.FLAG_SHADOW | id.FLAG_BUILT_IN |
    pos
    FILE_ID_BUILT_IN
  labelContext id.newLabel
end

proc(
  Type : t
  ProgramContext ptr.mut : context
-> Type Type Type Type Type ) =>: operatorProcTypes
  context .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  ## TODO? own calling convention for built-ins
  LabelId slice optional.empty =:: argLabels
  Type 2 array new =:: mut: args
  t args@ 0 =[]
  t args@ 1 =[]
  ## newProcedure
    args@ 1 slice.create
    Type slice.empty
    LabelId slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure .else
    "failed to create procedure-type" ..panic
  end =:: consumeVal
  ## newProcedure
    args@ 1 slice.create
    args@ 1 slice.create
    LabelId slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure .else
    "failed to create procedure-type" ..panic
  end =:: unOpProc
  ## newProcedure
    args@ slice.wrap
    args@ 1 slice.create
    LabelId slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure .else
    "failed to create procedure-type" ..panic
  end =:: binOpProc
  ## newProcedure
    args@ slice.wrap
    types.primitive.BOOL@ 1 slice.create
    LabelId slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure .else
    "failed to create procedure-type" ..panic
  end =:: cmpOpProc
  ## newProcedure
    args@ 1 slice.create
    types.primitive.BOOL@ 1 slice.create
    LabelId slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure .else
    "failed to create procedure-type" ..panic
  end =:: toBoolOpProc
  binOpProc unOpProc cmpOpProc toBoolOpProc consumeVal return
end
proc(
  Type : t1
  Type : t2
  ProgramContext ptr.mut : context
-> Type Type ) =>: mixedProcTypes
  context .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  Type 2 array new =:: mut: args
  t1 args@ 0 =[]
  t2 args@ 1 =[]
  ## newProcedure
    args@ 2 slice.create
    args@ 1 slice.create
    LabelId slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure .else
    "failed to create procedure-type" ..panic
  end =:: aba
  ## newProcedure
    args@ 2 slice.create
    args@ 1 @[] 1 slice.create
    LabelId slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure .else
    "failed to create procedure-type" ..panic
  end =:: abb
  aba abb return
end
## i64 i32 -> i32 mod/rem/and
## i64 i32 -> i64 div/udiv/shifts

proc(
  ProgramContext ptr.mut : context
-> Type Type ) =>: sysProcTypes
  context .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  LabelId slice optional.empty =:: argLabels
  types.CHAR8 false typeContext wrapPtr false typeContext wrapPtr =:: c8pp
  ## newProcedure
    Type slice.empty
    types.primitive.I64@ 1 slice.create
    LabelId slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure .else
    "failed to create procedure-type" ..panic
  end =:: v_i64
  ## newProcedure
    Type slice.empty
    c8pp@ 1 slice.create
    LabelId slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure .else
    "failed to create procedure-type" ..panic
  end =:: v_c8pp
  v_c8pp v_i64 return
end
proc(
  FilePosition ptr : pos
  ProgramContext ptr.mut : context
-> Type Type Type Type Type Type Type ) =>: parseProcTypes
  context .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  Type 2 array : typeData
  typeData@ =:: argTypes
  ## char8 ptr.raw  iSize   -> ...
  types.CHAR8 false typeContext wrapPtr argTypes 0 =[]
  types.I_SIZE argTypes 1 =[]
  ## newProcedure
    argTypes slice.wrap
    types.primitive.I8@ 1 slice.create
    LabelId slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure .else
    "failed to create procedure-type" ..panic
  end =:: s_i8
  ## newProcedure
    argTypes slice.wrap
    types.primitive.I16@ 1 slice.create
    LabelId slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure .else
    "failed to create procedure-type" ..panic
  end =:: s_i16
  ## newProcedure
    argTypes slice.wrap
    types.primitive.I32@ 1 slice.create
    LabelId slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure .else
    "failed to create procedure-type" ..panic
  end =:: s_i32
  ## newProcedure
    argTypes slice.wrap
    types.primitive.I64@ 1 slice.create
    LabelId slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure .else
    "failed to create procedure-type" ..panic
  end =:: s_i64
  ## newProcedure
    argTypes slice.wrap
    types.primitive.F16@ 1 slice.create
    LabelId slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure .else
    "failed to create procedure-type" ..panic
  end =:: s_f16
  ## newProcedure
    argTypes slice.wrap
    types.primitive.F32@ 1 slice.create
    LabelId slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure .else
    "failed to create procedure-type" ..panic
  end =:: s_f32
  ## newProcedure
    argTypes slice.wrap
    types.primitive.F64@ 1 slice.create
    LabelId slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure .else
    "failed to create procedure-type" ..panic
  end =:: s_f64
  s_f64 s_f32 s_f16 s_i64 s_i32 s_i16 s_i8 return
end
proc(
  FilePosition ptr : pos
  ProgramContext ptr.mut : context
-> Type Type Type Type Type Type Type ) =>: ptrProcTypes
  context .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  ## type : auto: T
  LabelId 3 array : labelData
  Type 3 array : typeData
  ## newLabel
    "T":s
    id.FLAG_STATIC id.FLAG_BUILT_IN | id.FLAG_AUTO |
    pos
    FILE_ID_BUILT_IN
    labelContext
  id.newLabel labelData@ 0 =[]
  id.LABEL_ID_NONE labelData@ 1 =[]
  id.LABEL_ID_NONE labelData@ 2 =[]
  types.primitive.TYPE typeData@ 0 =[]
  labelData 0 [] types.newGenericType =:: baseType
  baseType false typeContext wrapPtr =:: basePtr
  baseType true typeContext wrapPtr =:: basePtrMut
  baseType typeData@ 1 =[]
  basePtrMut typeData@ 2 =[]
  ## newProcedure
    typeData@ slice.wrap
    Type slice.empty
    labelData@ slice.wrap
    CallingConvention.DEFAULT
  typeContext types.newProcedure .else
    "failed to create procedure-type" ..panic
  end =:: setProc
  basePtr typeData@ 1 =[]
  ## newProcedure
    typeData@ 2 slice.create
    baseType@ slice.wrap
    labelData@ slice.wrap
    CallingConvention.DEFAULT
  typeContext types.newProcedure .else
    "failed to create procedure-type" ..panic
  end =:: getProc
  types.primitive.I32 typeData@ 2 =[]
  ## newProcedure
    typeData@ slice.wrap
    typeData@ 1 @[] 1 slice.create
    labelData@ slice.wrap
    CallingConvention.DEFAULT
  typeContext types.newProcedure .else
    "failed to create procedure-type" ..panic
  end =:: offset32Proc
  types.primitive.I64 typeData@ 2 =[]
  ## newProcedure
    typeData@ slice.wrap
    typeData@ 1 @[] 1 slice.create
    labelData@ slice.wrap
    CallingConvention.DEFAULT
  typeContext types.newProcedure .else
    "failed to create procedure-type" ..panic
  end =:: offset64Proc
  basePtrMut typeData@ 1 =[] ## auto: T T ptr.raw.mut i64
  ## newProcedure
    typeData@ 2 slice.create
    baseType@ slice.wrap
    labelData@ slice.wrap
    CallingConvention.DEFAULT
  typeContext types.newProcedure .else
    "failed to create procedure-type" ..panic
  end =:: getMutProc
  ## newProcedure
    typeData@ slice.wrap
    typeData@ 1 @[] 1 slice.create
    labelData@ slice.wrap
    CallingConvention.DEFAULT
  typeContext types.newProcedure .else
    "failed to create procedure-type" ..panic
  end =:: offsetMut64Proc
  types.primitive.I32 typeData@ 2 =[]
  ## newProcedure
    typeData@ slice.wrap
    typeData@ 1 @[] 1 slice.create
    labelData@ slice.wrap
    CallingConvention.DEFAULT
  typeContext types.newProcedure .else
    "failed to create procedure-type" ..panic
  end =:: offsetMut32Proc
  offsetMut64Proc offsetMut32Proc offset64Proc offset32Proc setProc getMutProc getProc
end
proc(
  ProgramContext ptr.mut : context
-> Type Type Type Type ) =>: typeProcTypes ## ti32_t tt_bool t_t t_bool
  context .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  Type 2 array new =:: mut: args
  types.primitive.TYPE args@ 0 =[]
  types.primitive.TYPE args@ 1 =[]
  ## newProcedure
    types.primitive.TYPE@ 1 slice.create
    types.primitive.BOOL@ 1 slice.create
    LabelId slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure .else
    "failed to create procedure-type" ..panic
  end =:: t_b
  ## newProcedure
    types.primitive.TYPE@ 1 slice.create
    types.primitive.TYPE@ 1 slice.create
    LabelId slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure .else
    "failed to create procedure-type" ..panic
  end =:: t_t
  ## newProcedure
    args@ 2 slice.create
    types.primitive.BOOL@ 1 slice.create
    LabelId slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure .else
    "failed to create procedure-type" ..panic
  end =:: tt_b
  types.primitive.I32 args@ 1 =[]
  ## newProcedure
    args@ 2 slice.create
    types.primitive.BOOL@ 1 slice.create
    LabelId slice.empty
    CallingConvention.DEFAULT
  typeContext types.newProcedure .else
    "failed to create procedure-type" ..panic
  end =:: ti32_b
  ti32_b tt_b t_t t_b return
end

proc(
  Type : t
  LabelId : label
  FilePosition ptr : pos
  ProgramContext ptr.mut : context
-> ) =>: newBuiltInTypeLabel
  context .idContext =:: idContext
  ## declareIdentifier
    label
    types.primitive.TYPE
    IdentifierType .TYPE
    -1
    t ConstValue .TypeId
    true
    pos
    FILE_ID_BUILT_IN
    idContext
    context .errors
  id.declareIdentifier =:: isError ..drop.2
end
