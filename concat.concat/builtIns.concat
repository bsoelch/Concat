import "program.concat"

## TODO? char+-int
enum(
 ## arithmetic
 NEG_I8 NEG_I16 NEG_I32 NEG_I64 NEG_F32 NEG_F64 ## -_
 ADD_I8 ADD_I16 ADD_I32 ADD_I64 ADD_F32 ADD_F64 ADD_PTR ADD_PTR_MUT ## +
 SUB_I8 SUB_I16 SUB_I32 SUB_I64 SUB_F32 SUB_F64
     SUB_PTR SUB_PTR_MUT PTR_DIFF C8_DIFF C16_DIFF C32_DIFF ## -
 MUL_I32 MUL_I64 MUL_F32 MUL_F64                ## *
 ## XXX? div f64 i32
 DIV_I32 DIV_I64I32 DIV_I64 DIV_F32 DIV_F64     ## /
 REM_I32 REM_I64I32 REM_I64                     ## %
 UDIV_I32 UDIV_I64I32 UDIV_I64                  ## ..udiv
 UMOD_I32 UMOD_I64I32 UMOD_I64                  ## ..umod
 ## logic
 NOT_BOOL                                       ## !
 FLIP_I8 FLIP_I16 FLIP_I32 FLIP_I64             ## ~
 AND_BOOL AND_I8 AND_I16 AND_I32 AND_I64        ## &
 OR_BOOL  OR_I8 OR_I16 OR_I32 OR_I64            ## |
 XOR_BOOL XOR_I8 XOR_I16 XOR_I32 XOR_I64        ## ^
 LSHR_I8 LSHR_I16 LSHR_I32 LSHR_I64I32 LSHR_I64 ## >>>
 ASHR_I8 ASHR_I16 ASHR_I32 ASHR_I64I32 ASHR_I64 ## >>
 SHL_I8 SHL_I16 SHL_I32 SHL_I64I32 SHL_I64      ## <<
 ## comparison
 BOOL_I8 BOOL_I16 BOOL_I32 BOOL_I64 BOOL_F32 BOOL_F64 ## ?
 ## TODO? mixed inequalities ( i32 i64 <  is frequent loop condition )
 EQ_I8 EQ_I16 EQ_I32 EQ_I64 EQ_F32 EQ_F64 EQ_PTR EQ_C8 EQ_C16 EQ_C32 ## ==
 NE_I8 NE_I16 NE_I32 NE_I64 NE_F32 NE_F64 NE_PTR NE_C8 NE_C16 NE_C32 ## !=
 LT_I8 LT_I16 LT_I32 LT_I64 LT_F32 LT_F64 LT_PTR LT_C8 LT_C16 LT_C32 ## <
 LE_I8 LE_I16 LE_I32 LE_I64 LE_F32 LE_F64 LE_PTR LE_C8 LE_C16 LE_C32 ## <=
 GE_I8 GE_I16 GE_I32 GE_I64 GE_F32 GE_F64 GE_PTR GE_C8 GE_C16 GE_C32 ## >=
 GT_I8 GT_I16 GT_I32 GT_I64 GT_F32 GT_F64 GT_PTR GT_C8 GT_C16 GT_C32 ## >
 ULT_I8 ULT_I16 ULT_I32 ULT_I64                  ## ..u<
 ULE_I8 ULE_I16 ULE_I32 ULE_I64                  ## ..u<=
 UGE_I8 UGE_I16 UGE_I32 UGE_I64                  ## ..u>=
 UGT_I8 UGT_I16 UGT_I32 UGT_I64                  ## ..u>
 SYS_ARGC SYS_ARGV SYS_ENVP
 ## XXX? more built-in operations
) =:: export: BuiltIn

namespace: sb
  proc( stringBuilder BuiltIn -> stringBuilder ) =>: export: appendBuiltIn
    switch
      NEG_I8 NEG_I16 NEG_I32 NEG_I64 NEG_F32 NEG_F64 case
        "-_" sb.appendS break
      ADD_I8 ADD_I16 ADD_I32 ADD_I64 ADD_F32 ADD_F64
          ADD_PTR ADD_PTR_MUT case
        "+" sb.appendS break
      SUB_I8 SUB_I16 SUB_I32 SUB_I64 SUB_F32 SUB_F64
          SUB_PTR SUB_PTR_MUT PTR_DIFF C8_DIFF C16_DIFF C32_DIFF case
        "-" sb.appendS break
      MUL_I32 MUL_I64 MUL_F32 MUL_F64 case
        "*" sb.appendS break
      DIV_I32 DIV_I64I32 DIV_I64 DIV_F32 DIV_F64 case
        "/" sb.appendS break
      REM_I32 REM_I64I32 REM_I64 case
        "%" sb.appendS break
      UDIV_I32 UDIV_I64I32 UDIV_I64 case "..udiv" sb.appendS break
      UMOD_I32 UMOD_I64I32 UMOD_I64 case "..umod" sb.appendS break
      NOT_BOOL case "!" sb.appendS break
      FLIP_I8 FLIP_I16 FLIP_I32 FLIP_I64 case
        "~" sb.appendS break
      AND_BOOL AND_I8 AND_I16 AND_I32 AND_I64 case
        "&" sb.appendS break
      OR_BOOL OR_I8 OR_I16 OR_I32 OR_I64 case
        "|" sb.appendS break
      XOR_BOOL XOR_I8 XOR_I16 XOR_I32 XOR_I64 case
        "^" sb.appendS break
      LSHR_I8 LSHR_I16 LSHR_I32 LSHR_I64I32 LSHR_I64 case
        ">>>" sb.appendS break
      ASHR_I8 ASHR_I16 ASHR_I32 ASHR_I64I32 ASHR_I64 case
        ">>" sb.appendS break
      SHL_I8 SHL_I16 SHL_I32 SHL_I64I32 SHL_I64 case
        "<<" sb.appendS break
      BOOL_I8 BOOL_I16 BOOL_I32 BOOL_I64 BOOL_F32 BOOL_F64 case
        "?" sb.appendS break
      EQ_I8 EQ_I16 EQ_I32 EQ_I64 EQ_F32 EQ_F64 EQ_PTR EQ_C8 EQ_C16 EQ_C32 case
        "==" sb.appendS break
      NE_I8 NE_I16 NE_I32 NE_I64 NE_F32 NE_F64 NE_PTR NE_C8 NE_C16 NE_C32 case
        "!=" sb.appendS break
      LT_I8 LT_I16 LT_I32 LT_I64 LT_F32 LT_F64 LT_PTR LT_C8 LT_C16 LT_C32 case
        "<" sb.appendS break
      LE_I8 LE_I16 LE_I32 LE_I64 LE_F32 LE_F64 LE_PTR LE_C8 LE_C16 LE_C32 case
        "<=" sb.appendS break
      GE_I8 GE_I16 GE_I32 GE_I64 GE_F32 GE_F64 GE_PTR GE_C8 GE_C16 GE_C32 case
        ">=" sb.appendS break
      GT_I8 GT_I16 GT_I32 GT_I64 GT_F32 GT_F64 GT_PTR GT_C8 GT_C16 GT_C32 case
        ">" sb.appendS break
      ULT_I8 ULT_I16 ULT_I32 ULT_I64 case "..u<" sb.appendS break
      ULE_I8 ULE_I16 ULE_I32 ULE_I64 case "..u<=" sb.appendS break
      UGE_I8 UGE_I16 UGE_I32 UGE_I64 case "..u>=" sb.appendS break
      UGT_I8 UGT_I16 UGT_I32 UGT_I64 case "..u>" sb.appendS break
      SYS_ARGC case "sys.argc" sb.appendS break
      SYS_ARGV case "sys.argv" sb.appendS break
      SYS_ENVP case "sys.envp" sb.appendS break
    end
  end
end

proc(
  Type : base
  bool : mutable
  TypeContext ptr mut : typeContext
-> Type ) =>: wrapPtr
  base
    true
    types.ArraySize array.empty
    false
    mutable
    typeContext
  types.newArrayType
    ! assert "can wrap pointer"
  return
end
proc(
  FilePosition : pos
  ProgramContext ptr mut : context
-> Type Type Type Type Type ) =>: ptrSignatures
  context [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  ## newLabel
    "T" string.wrap
    id.FLAG_AUTO id.FLAG_STATIC | id.FLAG_BUILT_IN |
    pos
    FILE_ID_BUILT_IN
  labelContext id.newLabel =:: genericLabel
  genericLabel types.newGenericType =:: genericType
  genericType false typeContext wrapPtr =:: genericPtr
  genericType true  typeContext wrapPtr =:: genericPtrMut
  Type 3 array new =:: mut: typeArray
  typeArray @ =:: types
  LabelId 3 array new =:: mut: labelArray
  labelArray @ =:: labels
  genericLabel labels 0 [] =
  id.LABEL_ID_NONE labels 1 [] =
  id.LABEL_ID_NONE labels 2 [] =
  labels array.wrap optional.wrap =:: labelData
  types.primitive.TYPE types 0 [] =
  types.primitive.I_PTR types 2 [] =
  genericPtrMut types 1 [] =
  ## newProcArgs
    types array.wrap ## type : T , T ptr mut , iPtr
    labelData
    false
  typeContext types.newProcArgs =:: ptrMutAddIn
  ## newProcArgs
    types 1 [] @ array.wrap ## T ptr mut
    LabelId arrayView optional.empty
    true
  typeContext types.newProcArgs =:: ptrMutAddOut
  genericPtr types 1 [] =
  ## newProcArgs
    types array.wrap ## type : T , T ptr , iPtr
    labelData
    false
  typeContext types.newProcArgs =:: ptrAddIn
  ## newProcArgs
    types 1 [] @ array.wrap ## T ptr
    LabelId arrayView optional.empty
    true
  typeContext types.newProcArgs =:: ptrAddOut
  ## newProcArgs
    types 2 [] @ array.wrap ## iPtr
    LabelId arrayView optional.empty
    true
  typeContext types.newProcArgs =:: ptrDiffOut
  genericPtr types 2 [] =
  ## newProcArgs
    types array.wrap  ## type : T  T ptr  T ptr
    labelData
    false
  typeContext types.newProcArgs =:: ptrCmpIn
  types.primitive.BOOL types 2 [] =
  ## newProcArgs
    types 2 [] @ array.wrap
    LabelId arrayView optional.empty
    true
  typeContext types.newProcArgs =:: ptrCmpOut
  ## newProcArgs
    types array.wrap 2 array.head  ## type : T  T ptr
    labelData
    false
  typeContext types.newProcArgs =:: ptrConsumeIn
  ## newProcArgs
    Type array.empty
    LabelId arrayView optional.empty
    false
  typeContext types.newProcArgs =:: ptrConsumeOut
  ## newProcedure
    ptrMutAddIn
    ptrMutAddOut
    CallingConvention.DEFAULT
  typeContext types.newProcedure
    ! assert "can create procedure"
  =:: ptrMutAdd
  ## newProcedure
    ptrAddIn
    ptrAddOut
    CallingConvention.DEFAULT
  typeContext types.newProcedure
    ! assert "can create procedure"
  =:: ptrAdd
  ## newProcedure
    ptrCmpIn
    ptrDiffOut
    CallingConvention.DEFAULT
  typeContext types.newProcedure
    ! assert "can create procedure"
  =:: ptrDiff
  ## newProcedure
    ptrCmpIn
    ptrCmpOut
    CallingConvention.DEFAULT
  typeContext types.newProcedure
    ! assert "can create procedure"
  =:: ptrCmp
  ## newProcedure
    ptrConsumeIn
    ptrConsumeOut
    CallingConvention.DEFAULT
  typeContext types.newProcedure
    ! assert "can create procedure"
  =:: ptrConsume
  ptrMutAdd ptrAdd ptrDiff ptrCmp ptrConsume
end

proc(
  string : name
  FilePosition : pos
  ProgramContext ptr mut : context
-> ProcBundleId bool ) =>: newBuiltInBundle
  context [] .idContext @ =:: idContext
  idContext [] .typeContext .labelContext @ =:: labelContext
  labelContext id.resetNamespace
  context [] .procBundles
    ..dup .length ProcBundleId cast =:: bundleId
    newProcBundle list.append
  context [] .procBundles =
  ## newLabel
    name
    id.FLAG_EXPORT id.FLAG_BUILT_IN |
    pos
    FILE_ID_BUILT_IN
  labelContext id.newLabel =:: label
  ## declareIdentifier
    label
    Type .undefined
    IdentifierType .PROCEDURE_BUNDLE
    -1
    bundleId ConstValue .procedureBundle
    true
    pos
    FILE_ID_BUILT_IN
    idContext
    context [] .errors @
  id.declareIdentifier =:: isError ..drop.2
  bundleId isError return
end
-1:ProcBundleId =:: NO_BUNDLE
proc(
  BuiltIn : buildIn
  LabelId : procLabel
  Type : procType
  ProcBundleId : bundleId
  FilePosition : pos
  ProgramContext ptr mut : context
  bool : hasStaticArgs
  bool : isStatic
-> ) =>: addBuiltIn_internal
  context [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  context [] .procedures
    ..dup .length ProcId cast =:: procId
    ## ProcedureInfo
      FILE_ID_BUILT_IN
      procType
      procLabel
      buildIn false BuiltInData new ProcImplType .builtIn
      hasStaticArgs
      isStatic
    ProcedureInfo new list.append
  context [] .procedures =
  procLabel labelContext id.inLabelNamespace
  ## declareIdentifier
    procLabel
    Type .undefined
    IdentifierType .PROCEDURE
    -1
    procId ConstValue .procedure
    true
    pos
    FILE_ID_BUILT_IN
    idContext
    context [] .errors @
  id.declareIdentifier =:: isError ..drop.2
  bundleId NO_BUNDLE != if
    context [] .procBundles bundleId i64 cast list.at .data =:: bundle
    bundle [] .procedures
      procId list.append
    bundle [] .procedures =
  end
end
proc(
  BuiltIn : buildIn
  LabelId : procLabel
  Type : procType
  ProcBundleId : bundleId
  FilePosition : pos
  ProgramContext ptr mut : context
-> ) =>: addBuiltIn
  buildIn procLabel procType bundleId pos context false false addBuiltIn_internal
end
proc(
  BuiltIn : buildIn
  LabelId : procLabel
  Type : procType
  ProcBundleId : bundleId
  FilePosition : pos
  ProgramContext ptr mut : context
-> ) =>: addGenericBuiltIn
  buildIn procLabel procType bundleId pos context true false addBuiltIn_internal
end

proc(
  i64 : auto: l1 char8 l1 ptr : namespace
  i64 : auto: l2 char8 l2 ptr : element
  FilePosition : pos
  LabelContext ptr mut : labelContext
-> LabelId ) =>: createLabel
  ## newLabel
    namespace string.wrap
    element string.wrap
    id.FLAG_EXPORT id.FLAG_BUILT_IN |
    pos
    FILE_ID_BUILT_IN
  labelContext id.newLabelInNamespace
end

proc(
  Type : t
  ProgramContext ptr mut : context
-> Type Type Type Type Type ) =>: operatorProcTypes
  context [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  ## TODO? own calling convention for built-ins
  LabelId arrayView optional.empty =:: argLabels
  Type 2 array new =:: mut: args
  t args @ 0 [] =
  t args @ 1 [] =
  ## newProcArgs
    args @ 1 array.create
    argLabels
    false
    typeContext
  types.newProcArgs =:: mut: procIn
  ## newProcArgs
    Type array.empty
    argLabels
    true
  typeContext types.newProcArgs =:: mut: procOut
  ## newProcedure
    procIn
    procOut
    CallingConvention.DEFAULT
  typeContext types.newProcedure
    ! assert "can create procedure"
  =:: consumeVal
  ## newProcArgs
    args @ 1 array.create
    argLabels
    true
  typeContext types.newProcArgs procOut =
  ## newProcedure
    procIn
    procOut
    CallingConvention.DEFAULT
  typeContext types.newProcedure
    ! assert "can create procedure"
  =:: unOpProc
  ## newProcArgs
    args @ array.wrap
    argLabels
    false
  typeContext types.newProcArgs procIn =
  ## newProcedure
    procIn
    procOut
    CallingConvention.DEFAULT
  typeContext types.newProcedure
    ! assert "can create procedure"
  =:: binOpProc
  types.primitive.BOOL args @ 0 [] =
  ## newProcArgs
    args @ 1 array.create
    argLabels
    true
  typeContext types.newProcArgs procOut =
  ## newProcedure
    procIn
    procOut
    CallingConvention.DEFAULT
  typeContext types.newProcedure
    ! assert "can create procedure"
  =:: cmpOpProc
  ## newProcArgs
    args @ 1 [] @ 1 array.create
    argLabels
    false
  typeContext types.newProcArgs procIn =
  ## newProcedure
    procIn
    procOut
    CallingConvention.DEFAULT
  typeContext types.newProcedure
    ! assert "can create procedure"
  =:: toBoolOpProc
  binOpProc unOpProc cmpOpProc toBoolOpProc consumeVal return
end
proc(
  Type : t1
  Type : t2
  ProgramContext ptr mut : context
-> Type Type ) =>: mixedProcTypes
  context [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  LabelId arrayView optional.empty =:: argLabels
  Type 2 array new =:: mut: args
  t1 args @ 0 [] =
  t2 args @ 1 [] =
  ## newProcArgs
    args @ 2 array.create
    argLabels
    false
    typeContext
  types.newProcArgs =:: mut: procIn
  ## newProcArgs
    args @ 1 array.create
    argLabels
    true
  typeContext types.newProcArgs =:: mut: procOut
  ## newProcedure
    procIn
    procOut
    CallingConvention.DEFAULT
  typeContext types.newProcedure
    ! assert "can create procedure"
  =:: aba
  ## newProcArgs
    args @ 1 [] @ 1 array.create
    argLabels
    true
  typeContext types.newProcArgs procOut =
  ## newProcedure
    procIn
    procOut
    CallingConvention.DEFAULT
  typeContext types.newProcedure
    ! assert "can create procedure"
  =:: abb
  aba abb return
end
## i64 i32 -> i32 mod/rem/and
## i64 i32 -> i64 div/udiv/shifts

proc(
  Type : t1
  ProgramContext ptr mut : context
-> Type Type ) =>: charProcTypes ## c?c?_bool c?c?_i32
  context [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  LabelId arrayView optional.empty =:: argLabels
  Type 2 array new =:: mut: args
  t1 args @ 0 [] =
  t1 args @ 1 [] =
  ## newProcArgs
    args @ 2 array.create
    argLabels
    false
    typeContext
  types.newProcArgs =:: mut: procIn
  types.primitive.BOOL args@ 0 [] =
  ## newProcArgs
    args @ 1 array.create
    argLabels
    true
  typeContext types.newProcArgs =:: mut: procOut
  ## newProcedure
    procIn
    procOut
    CallingConvention.DEFAULT
  typeContext types.newProcedure
    ! assert "can create procedure"
  =:: cc_b
  types.primitive.I32 args@ 0 [] =
  ## newProcArgs
    args@ 1 array.create
    argLabels
    true
  typeContext types.newProcArgs procOut =
  ## newProcedure
    procIn
    procOut
    CallingConvention.DEFAULT
  typeContext types.newProcedure
    ! assert "can create procedure"
  =:: cc_i
  cc_b cc_i return
end
proc(
  ProgramContext ptr mut : context
-> Type Type ) =>: sysProcTypes
  context [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  LabelId arrayView optional.empty =:: argLabels
  ## newProcArgs
    Type array.empty
    argLabels
    false
    typeContext
  types.newProcArgs =:: mut: procIn
  ## newProcArgs
    types.primitive.I64@ 1 array.create
    argLabels
    true
  typeContext types.newProcArgs =:: mut: toI64
  types.primitive.CHAR8 false typeContext wrapPtr false typeContext wrapPtr =:: c8pp
  ## newProcArgs
    c8pp@ 1 array.create
    argLabels
    true
  typeContext types.newProcArgs =:: mut: toC8PP
  ## newProcedure
    procIn
    toI64
    CallingConvention.DEFAULT
  typeContext types.newProcedure
    ! assert "can create procedure"
  =:: v_i64
  ## newProcedure
    procIn
    toC8PP
    CallingConvention.DEFAULT
  typeContext types.newProcedure
    ! assert "can create procedure"
  =:: v_c8pp
  v_c8pp v_i64 return
end

proc(
  FilePosition : pos
  ProgramContext ptr mut : context
-> bool ) =>: export: initBuiltInProcs
  context [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  types.primitive.BOOL
    context operatorProcTypes
  =:: consume_bool =:: bool_bool =:: boolbool_bool ..drop.2
  types.primitive.I8
    context operatorProcTypes
  =:: consume_i8 =:: i8_bool =:: i8i8_bool =:: i8_i8 =:: i8i8_i8
  types.primitive.I16
    context operatorProcTypes
  =:: consume_i16 =:: i16_bool =:: i16i16_bool
      =:: i16_i16 =:: i16i16_i16
  types.primitive.I32
    context operatorProcTypes
  =:: consume_i32 =:: i32_bool =:: i32i32_bool
      =:: i32_i32 =:: i32i32_i32
  types.primitive.I64
    context operatorProcTypes
  =:: consume_i64 =:: i64_bool =:: i64i64_bool
      =:: i64_i64 =:: i64i64_i64
  types.primitive.F32
    context operatorProcTypes
  =:: consume_f32 =:: f32_bool =:: f32f32_bool
      =:: f32_f32 =:: f32f32_f32
  types.primitive.F64
    context operatorProcTypes
  =:: consume_f64 =:: f64_bool =:: f64f64_bool
      =:: f64_f64 =:: f64f64_f64
  types.primitive.I64 types.primitive.I32
    context mixedProcTypes
  =:: i64i32_i32 =:: i64i32_i64
  pos context ptrSignatures
  =:: consume_ptr =:: ptrCmp =:: ptrDiff =:: ptrAdd =:: ptrMutAdd
  types.primitive.CHAR8  context charProcTypes =:: c8c8_i32 =:: c8c8_bool
  types.primitive.CHAR16 context charProcTypes =:: c16c16_i32 =:: c16c16_bool
  types.primitive.CHAR32 context charProcTypes =:: c32c32_i32 =:: c32c32_bool
  "-_" string.wrap pos context newBuiltInBundle
    if ..drop true return end
  =:: mut: bundle
  BuiltIn .NEG_I8
    "i8"  "neg" pos labelContext createLabel
    i8_i8
    bundle
  pos context addBuiltIn
  BuiltIn .NEG_I16
    "i16" "neg" pos labelContext createLabel
    i16_i16
    bundle
  pos context addBuiltIn
  BuiltIn .NEG_I32
    "i32" "neg" pos labelContext createLabel
    i32_i32
    bundle
  pos context addBuiltIn
  BuiltIn .NEG_I64
    "i64" "neg" pos labelContext createLabel
    i64_i64
    bundle
  pos context addBuiltIn
  BuiltIn .NEG_F32
    "f32" "neg" pos labelContext createLabel
    f32_f32
    bundle
  pos context addBuiltIn
  BuiltIn .NEG_F64
    "f64" "neg" pos labelContext createLabel
    f64_f64
    bundle
  pos context addBuiltIn
  "+" string.wrap pos context newBuiltInBundle
    if ..drop true return end
  bundle =
  BuiltIn .ADD_I8
    "i8"  "add" pos labelContext createLabel
    i8i8_i8
    bundle
  pos context addBuiltIn
  BuiltIn .ADD_I16
    "i16" "add" pos labelContext createLabel
    i16i16_i16
    bundle
  pos context addBuiltIn
  BuiltIn .ADD_I32
    "i32" "add" pos labelContext createLabel
    i32i32_i32
    bundle
  pos context addBuiltIn
  BuiltIn .ADD_I64
    "i64" "add" pos labelContext createLabel
    i64i64_i64
    bundle
  pos context addBuiltIn
  BuiltIn .ADD_F32
    "f32" "add" pos labelContext createLabel
    f32f32_f32
    bundle
  pos context addBuiltIn
  BuiltIn .ADD_F64
    "f64" "add" pos labelContext createLabel
    f64f64_f64
    bundle
  pos context addBuiltIn
  BuiltIn .ADD_PTR
    "ptr" "add" pos labelContext createLabel
    ptrAdd
    bundle
  pos context addGenericBuiltIn
  BuiltIn .ADD_PTR_MUT
    "ptrMut" "add" pos labelContext createLabel
    ptrMutAdd
    bundle
  pos context addGenericBuiltIn
  "-" string.wrap pos context newBuiltInBundle
    if ..drop true return end
  bundle =
  BuiltIn .SUB_I8
    "i8"  "sub" pos labelContext createLabel
    i8i8_i8
    bundle
  pos context addBuiltIn
  BuiltIn .SUB_I16
    "i16" "sub" pos labelContext createLabel
    i16i16_i16
    bundle
  pos context addBuiltIn
  BuiltIn .SUB_I32
    "i32" "sub" pos labelContext createLabel
    i32i32_i32
    bundle
  pos context addBuiltIn
  BuiltIn .SUB_I64
    "i64" "sub" pos labelContext createLabel
    i64i64_i64
    bundle
  pos context addBuiltIn
  BuiltIn .SUB_F32
    "f32" "sub" pos labelContext createLabel
    f32f32_f32
    bundle
  pos context addBuiltIn
  BuiltIn .SUB_F64
    "f64" "sub" pos labelContext createLabel
    f64f64_f64
    bundle
  pos context addBuiltIn
  BuiltIn .SUB_PTR
  "ptr" "sub" pos labelContext createLabel
    ptrAdd
    bundle
  pos context addGenericBuiltIn
  BuiltIn .SUB_PTR_MUT
    "ptrMut" "difference" pos labelContext createLabel
    ptrMutAdd
    bundle
  pos context addGenericBuiltIn
    BuiltIn .PTR_DIFF
    "ptr" "difference" pos labelContext createLabel
    ptrDiff
    bundle
  pos context addGenericBuiltIn
  BuiltIn .C8_DIFF
    "char8" "difference" pos labelContext createLabel
    c8c8_i32
    bundle
  pos context addBuiltIn
  BuiltIn .C16_DIFF
    "char16" "difference" pos labelContext createLabel
    c16c16_i32
    bundle
  pos context addBuiltIn
  BuiltIn .C32_DIFF
    "char32" "difference" pos labelContext createLabel
    c32c32_i32
    bundle
  pos context addBuiltIn
  "*" string.wrap pos context newBuiltInBundle
    if ..drop true return end
  bundle =
  BuiltIn .MUL_I32
    "i32" "mul" pos labelContext createLabel
    i32i32_i32
