  Type : t
  string : name
  FilePosition ptr : pos
  ProgramContext ptr.mut : context
-> ) =>: newBuiltInType
  context .idContext =:: idContext
  idContext .typeContext .labelContext =:: labelContext
  t
    name pos labelContext createLabel
    pos
  context newBuiltInTypeLabel
end
