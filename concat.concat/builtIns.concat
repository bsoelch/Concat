  Type : valType
  ConstValue : value
  string : name
  FilePosition ptr : pos
  ProgramContext ptr.mut : context
-> ) =>: newBuiltInConstant
  context .idContext =:: idContext
  idContext .typeContext .labelContext =:: labelContext
  ## declareIdentifier
    name pos labelContext createLabel
    valType
    IdentifierType .GLOBAL_VAR
    -1
    value
    true
    pos
    FILE_ID_BUILT_IN
    idContext
    context .errors
