import "program.concat"

## TODO distinguish mod and remainder
enum(
 ## arithmetic
 NEG_I8 NEG_I16 NEG_I32 NEG_I64 NEG_F32 NEG_F64 ## -_
 ADD_I8 ADD_I16 ADD_I32 ADD_I64 ADD_F32 ADD_F64 ADD_PTR ADD_PTR_MUT ## +
 SUB_I8 SUB_I16 SUB_I32 SUB_I64 SUB_F32 SUB_F64
     SUB_PTR SUB_PTR_MUT PTR_DIFF  ## -
 MUL_I32 MUL_I64 MUL_F32 MUL_F64                ## *
 DIV_I32 DIV_I64 DIV_F32 DIV_F64                ## /
 MOD_I32 MOD_I64 MOD_F32 MOD_F64                ## %
 UDIV_I32 UDIV_I64                              ## ..udiv
 UMOD_I32 UMOD_I64                              ## ..umod
 ## logic
 NOT_BOOL                                       ## !
 FLIP_I8 FLIP_I16 FLIP_I32 FLIP_I64             ## ~
 AND_BOOL AND_I8 AND_I16 AND_I32 AND_I64        ## &
 OR_BOOL  OR_I8 OR_I16 OR_I32 OR_I64            ## |
 XOR_BOOL XOR_I8 XOR_I16 XOR_I32 XOR_I64        ## ^
 LSHR_I8 LSHR_I16 LSHR_I32 LSHR_I64             ## ..lshr
 ASHR_I8 ASHR_I16 ASHR_I32 ASHR_I64             ## >>
 SHL_I8 SHL_I16 SHL_I32 SHL_I64                 ## <<
 ## comparison
 BOOL_I8 BOOL_I16 BOOL_I32 BOOL_I64 BOOL_F32 BOOL_F64 ## ?
 #+ XXX ? special handling for ==, !=  to support enum equality
 EQ_I8 EQ_I16 EQ_I32 EQ_I64 EQ_F32 EQ_F64       ## ==
 NE_I8 NE_I16 NE_I32 NE_I64 NE_F32 NE_F64       ## !=
 +#
 ## XXX? are the 16bit operations necessary
 LT_I8 LT_I16 LT_I32 LT_I64 LT_F32 LT_F64 LT_PTR ## <
 LE_I8 LE_I16 LE_I32 LE_I64 LE_F32 LE_F64 LE_PTR ## <=
 GE_I8 GE_I16 GE_I32 GE_I64 GE_F32 GE_F64 GE_PTR ## >=
 GT_I8 GT_I16 GT_I32 GT_I64 GT_F32 GT_F64 GT_PTR ## >
 ULT_I8 ULT_I16 ULT_I32 ULT_I64                  ## ..u<
 ULE_I8 ULE_I16 ULE_I32 ULE_I64                  ## ..u<=
 UGE_I8 UGE_I16 UGE_I32 UGE_I64                  ## ..u>=
 UGT_I8 UGT_I16 UGT_I32 UGT_I64                  ## ..u>
 ## XXX? more built-in operations
 PRINT_BOOL PRINT_I8 PRINT_I16 PRINT_I32 PRINT_I64
   PRINT_F32 PRINT_F64 PRINT_PTR                 ## ..debug.print
) =:: export BuiltIn

namespace: sb
  proc( stringBuilder BuiltIn -> stringBuilder ) =>: export appendBuiltIn
    switch
      NEG_I8 NEG_I16 NEG_I32 NEG_I64 NEG_F32 NEG_F64 case
        "-_" sb.appendS break
      ADD_I8 ADD_I16 ADD_I32 ADD_I64 ADD_F32 ADD_F64
          ADD_PTR ADD_PTR_MUT case
        "+" sb.appendS break
      SUB_I8 SUB_I16 SUB_I32 SUB_I64 SUB_F32 SUB_F64
          SUB_PTR SUB_PTR_MUT PTR_DIFF case
        "-" sb.appendS break
      MUL_I32 MUL_I64 MUL_F32 MUL_F64 case
        "*" sb.appendS break
      DIV_I32 DIV_I64 DIV_F32 DIV_F64 case
        "/" sb.appendS break
      MOD_I32 MOD_I64 MOD_F32 MOD_F64 case
        "%" sb.appendS break
      UDIV_I32 UDIV_I64 case "..udiv" sb.appendS break
      UMOD_I32 UMOD_I64 case "..umod" sb.appendS break
      NOT_BOOL case "!" sb.appendS break
      FLIP_I8 FLIP_I16 FLIP_I32 FLIP_I64 case
        "~" sb.appendS break
      AND_BOOL AND_I8 AND_I16 AND_I32 AND_I64 case
        "&" sb.appendS break
      OR_BOOL OR_I8 OR_I16 OR_I32 OR_I64 case
        "|" sb.appendS break
      XOR_BOOL XOR_I8 XOR_I16 XOR_I32 XOR_I64 case
        "^" sb.appendS break
      LSHR_I8 LSHR_I16 LSHR_I32 LSHR_I64 case
        "..lshr" sb.appendS break
      ASHR_I8 ASHR_I16 ASHR_I32 ASHR_I64 case
        ">>" sb.appendS break
      SHL_I8 SHL_I16 SHL_I32 SHL_I64 case
        "<<" sb.appendS break
      BOOL_I8 BOOL_I16 BOOL_I32 BOOL_I64 BOOL_F32 BOOL_F64 case
        "?" sb.appendS break
      LT_I8 LT_I16 LT_I32 LT_I64 LT_F32 LT_F64 LT_PTR  case
        "<" sb.appendS break
      LE_I8 LE_I16 LE_I32 LE_I64 LE_F32 LE_F64 LE_PTR  case
        "<=" sb.appendS break
      GE_I8 GE_I16 GE_I32 GE_I64 GE_F32 GE_F64 GE_PTR  case
        ">=" sb.appendS break
      GT_I8 GT_I16 GT_I32 GT_I64 GT_F32 GT_F64 GT_PTR  case
        ">" sb.appendS break
      ULT_I8 ULT_I16 ULT_I32 ULT_I64 case "..u<" sb.appendS break
      ULE_I8 ULE_I16 ULE_I32 ULE_I64 case "..u<=" sb.appendS break
      UGE_I8 UGE_I16 UGE_I32 UGE_I64 case "..u>=" sb.appendS break
      UGT_I8 UGT_I16 UGT_I32 UGT_I64 case "..u>" sb.appendS break
      PRINT_BOOL PRINT_I8 PRINT_I16 PRINT_I32 PRINT_I64
          PRINT_F32 PRINT_F64 PRINT_PTR case
        "..debug.print" sb.appendS break
    end
  end
end

proc(
  Type : base
  bool : mutable
  TypeContext ptr mut : typeContext
-> Type ) =>: wrapPtr
  base
    true
    types.ArraySize array.empty
    false
    mutable
    typeContext
  types.newArrayType
    if ..unreachable end ## XXX use assertion ?
  return
end
proc(
  FilePosition : pos
  ProgramContext ptr mut : context
-> Type Type Type Type Type ) =>: ptrSignatures
  context [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  ## newLabel
    "T" string.wrap
    id.FLAG_AUTO id.FLAG_STATIC | id.FLAG_BUILT_IN |
    pos
    FILE_ID_BUILT_IN
  labelContext id.newLabel =:: genericLabel
  genericLabel types.newGenericType =:: genericType
  genericType false typeContext wrapPtr =:: genericPtr
  genericType true  typeContext wrapPtr =:: genericPtrMut
  Type 3 array new =:: mut typeArray
  typeArray @ =:: types
  LabelId 3 array new =:: mut labelArray
  labelArray @ =:: labels
  genericLabel labels 0 [] =
  id.LABEL_ID_NONE labels 1 [] =
  id.LABEL_ID_NONE labels 2 [] =
  labels array.wrap optional.wrap =:: labelData
  types.primitive.TYPE types 0 [] =
  types.primitive.I_PTR types 2 [] =
  genericPtrMut types 1 [] =
  ## newProcArgs
    types array.wrap ## type : T , T ptr mut , iPtr
    labelData
    false
  typeContext types.newProcArgs =:: ptrMutAddIn
  ## newProcArgs
    types 1 [] @ array.wrap ## T ptr mut
    LabelId arrayView optional.empty
    true
  typeContext types.newProcArgs =:: ptrMutAddOut
  genericPtr types 1 [] =
  ## newProcArgs
    types array.wrap ## type : T , T ptr , iPtr
    labelData
    false
  typeContext types.newProcArgs =:: ptrAddIn
  ## newProcArgs
    types 1 [] @ array.wrap ## T ptr
    LabelId arrayView optional.empty
    true
  typeContext types.newProcArgs =:: ptrAddOut
  ## newProcArgs
    types 2 [] @ array.wrap ## iPtr
    LabelId arrayView optional.empty
    true
  typeContext types.newProcArgs =:: ptrDiffOut
  genericPtr types 2 [] =
  ## newProcArgs
    types array.wrap  ## type : T  T ptr  T ptr
    labelData
    false
  typeContext types.newProcArgs =:: ptrCmpIn
  types.primitive.BOOL types 2 [] =
  ## newProcArgs
    types 2 [] @ array.wrap
    LabelId arrayView optional.empty
    true
  typeContext types.newProcArgs =:: ptrCmpOut
  ## newProcArgs
    types array.wrap 2 array.head  ## type : T  T ptr
    labelData
    false
  typeContext types.newProcArgs =:: ptrConsumeIn
  ## newProcArgs
    Type array.empty
    LabelId arrayView optional.empty
    false
  typeContext types.newProcArgs =:: ptrConsumeOut
  ## newProcedure
    ptrMutAddIn
    ptrMutAddOut
    CallingConvention.DEFAULT
  typeContext types.newProcedure
    if ..unreachable end ## XXX use assertion ?
  =:: ptrMutAdd
  ## newProcedure
    ptrAddIn
    ptrAddOut
    CallingConvention.DEFAULT
  typeContext types.newProcedure
    if ..unreachable end ## XXX use assertion ?
  =:: ptrAdd
  ## newProcedure
    ptrCmpIn
    ptrDiffOut
    CallingConvention.DEFAULT
  typeContext types.newProcedure
    if ..unreachable end ## XXX use assertion ?
  =:: ptrDiff
  ## newProcedure
    ptrCmpIn
    ptrCmpOut
    CallingConvention.DEFAULT
  typeContext types.newProcedure
    if ..unreachable end ## XXX use assertion ?
  =:: ptrCmp
  ## newProcedure
    ptrConsumeIn
    ptrConsumeOut
    CallingConvention.DEFAULT
  typeContext types.newProcedure
    if ..unreachable end ## XXX use assertion ?
  =:: ptrConsume
  ptrMutAdd ptrAdd ptrDiff ptrCmp ptrConsume
end

proc(
  string : name
  FilePosition : pos
  ProgramContext ptr mut : context
-> LabelId ProcBundleId bool ) =>: newBuiltInBundle
  context [] .idContext @ =:: idContext
  idContext [] .typeContext .labelContext @ =:: labelContext
  context [] .procBundles
    ..dup .length =:: bundleId
    newProcBundle list.append
  context [] .procBundles =
  ## newLabel
    name
    id.FLAG_EXPORT id.FLAG_BUILT_IN |
    pos
    FILE_ID_BUILT_IN
  labelContext id.newLabel =:: label
  ## declareIdentifier
    label
    Type .undefined
    IdentifierType .PROCEDURE_BUNDLE
    -1
    bundleId ConstValue .procedureBundle
    true
    pos
    FILE_ID_BUILT_IN
    idContext
    context [] .errors @
  id.declareIdentifier =:: isError ..drop.2
  label bundleId isError return
end
proc(
  BuiltIn : buildIn
  LabelId : procLabel
  Type : procType
  ProcBundleId : bundleId
  ProgramContext ptr mut : context
-> ) =>: addBuiltIn
  context [] .procedures
    ..dup .length =:: procId
    ## ProcedureInfo
      FILE_ID_BUILT_IN
      procType
      procLabel
      buildIn ProcImplType .builtIn
      false
      false
    ProcedureInfo new list.append
  context [] .procedures =
  context [] .procBundles bundleId list.at .data =:: bundle
  bundle [] .procedures
    procId list.append
  bundle [] .procedures =
end
proc(
  BuiltIn : buildIn
  LabelId : procLabel
  Type : procType
  ProcBundleId : bundleId
  ProgramContext ptr mut : context
-> ) =>: addGenericBuiltIn
  context [] .procedures
    ..dup .length =:: procId
    ## ProcedureInfo
      FILE_ID_BUILT_IN
      procType
      procLabel
      buildIn ProcImplType .builtIn
      true
      false
    ProcedureInfo new list.append
  context [] .procedures =
  context [] .procBundles bundleId list.at .data =:: bundle
  bundle [] .procedures
    procId list.append
  bundle [] .procedures =
end
proc(
  Type : t
  ProgramContext ptr mut : context
-> Type Type Type Type Type ) =>: operatorProcTypes
  context [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  ## TODO? own calling convention for built-ins
  LabelId arrayView optional.empty =:: argLabels
  Type 2 array new =:: mut args
  t args @ 0 [] =
  t args @ 1 [] =
  ## newProcArgs
    args @ 1 array.create
    argLabels
    false
    typeContext
  types.newProcArgs =:: mut procIn
  ## newProcArgs
    Type array.empty
    argLabels
    true
  typeContext types.newProcArgs =:: mut procOut
  ## newProcedure
    procIn
    procOut
    CallingConvention.DEFAULT
  typeContext types.newProcedure
    if ..unreachable end ## XXX replace with assertion
  =:: consumeVal
  ## newProcArgs
    args @ 1 array.create
    argLabels
    true
  typeContext types.newProcArgs procOut =
  ## newProcedure
    procIn
    procOut
    CallingConvention.DEFAULT
  typeContext types.newProcedure
    if ..unreachable end ## XXX replace with assertion
  =:: unOpProc
  ## newProcArgs
    args @ array.wrap
    argLabels
    false
  typeContext types.newProcArgs procIn =
  ## newProcedure
    procIn
    procOut
    CallingConvention.DEFAULT
  typeContext types.newProcedure
    if ..unreachable end ## XXX replace with assertion
  =:: binOpProc
  types.primitive.BOOL args @ 0 [] =
  ## newProcArgs
    args @ 1 array.create
    argLabels
    true
  typeContext types.newProcArgs procOut =
  ## newProcedure
    procIn
    procOut
    CallingConvention.DEFAULT
  typeContext types.newProcedure
    if ..unreachable end ## XXX replace with assertion
  =:: cmpOpProc
  ## newProcArgs
    args @ 1 [] @ 1 array.create
    argLabels
    false
  typeContext types.newProcArgs procIn =
  ## newProcedure
    procIn
    procOut
    CallingConvention.DEFAULT
  typeContext types.newProcedure
    if ..unreachable end ## XXX replace with assertion
  =:: toBoolOpProc
  binOpProc unOpProc cmpOpProc toBoolOpProc consumeVal return
end

proc(
  FilePosition : pos
  ProgramContext ptr mut : context
-> bool ) =>: export initBuiltInProcs
  types.primitive.BOOL
    context operatorProcTypes
  =:: consume_bool =:: bool_bool =:: boolbool_bool ..drop.2
  types.primitive.I8
    context operatorProcTypes
  =:: consume_i8 =:: i8_bool =:: i8i8_bool =:: i8_i8 =:: i8i8_i8
  types.primitive.I16
    context operatorProcTypes
  =:: consume_i16 =:: i16_bool =:: i16i16_bool
      =:: i16_i16 =:: i16i16_i16
  types.primitive.I32
    context operatorProcTypes
  =:: consume_i32 =:: i32_bool =:: i32i32_bool
      =:: i32_i32 =:: i32i32_i32
  types.primitive.I64
    context operatorProcTypes
  =:: consume_i64 =:: i64_bool =:: i64i64_bool
      =:: i64_i64 =:: i64i64_i64
  types.primitive.FLOAT32
    context operatorProcTypes
  =:: consume_f32 =:: f32_bool =:: f32f32_bool
      =:: f32_f32 =:: f32f32_f32
  types.primitive.FLOAT64
    context operatorProcTypes
  =:: consume_f64 =:: f64_bool =:: f64f64_bool
      =:: f64_f64 =:: f64f64_f64
  pos context ptrSignatures
  =:: consume_ptr =:: ptrCmp =:: ptrDiff =:: ptrAdd =:: ptrMutAdd
  "-_" string.wrap pos context newBuiltInBundle
    if ..drop.2 true return end
  =:: mut bundle =:: mut label
  BuiltIn .NEG_I8  label i8_i8   bundle context addBuiltIn
  BuiltIn .NEG_I16 label i16_i16 bundle context addBuiltIn
  BuiltIn .NEG_I32 label i32_i32 bundle context addBuiltIn
  BuiltIn .NEG_I64 label i64_i64 bundle context addBuiltIn
  BuiltIn .NEG_F32 label f32_f32 bundle context addBuiltIn
  BuiltIn .NEG_F64 label f64_f64 bundle context addBuiltIn
  "+" string.wrap pos context newBuiltInBundle
    if ..drop.2 true return end
  bundle = label =
  BuiltIn .ADD_I8  label i8i8_i8    bundle context addBuiltIn
  BuiltIn .ADD_I16 label i16i16_i16 bundle context addBuiltIn
  BuiltIn .ADD_I32 label i32i32_i32 bundle context addBuiltIn
  BuiltIn .ADD_I64 label i64i64_i64 bundle context addBuiltIn
  BuiltIn .ADD_F32 label f32f32_f32 bundle context addBuiltIn
  BuiltIn .ADD_F64 label f64f64_f64 bundle context addBuiltIn
  BuiltIn .ADD_PTR label ptrAdd        bundle context addGenericBuiltIn
  BuiltIn .ADD_PTR_MUT label ptrMutAdd bundle context addGenericBuiltIn
  "-" string.wrap pos context newBuiltInBundle
    if ..drop.2 true return end
  bundle = label =
  BuiltIn .SUB_I8  label i8i8_i8    bundle context addBuiltIn
  BuiltIn .SUB_I16 label i16i16_i16 bundle context addBuiltIn
  BuiltIn .SUB_I32 label i32i32_i32 bundle context addBuiltIn
  BuiltIn .SUB_I64 label i64i64_i64 bundle context addBuiltIn
  BuiltIn .SUB_F32 label f32f32_f32 bundle context addBuiltIn
  BuiltIn .SUB_F64 label f64f64_f64 bundle context addBuiltIn
  BuiltIn .SUB_PTR label ptrAdd        bundle context addGenericBuiltIn
  BuiltIn .SUB_PTR_MUT label ptrMutAdd bundle context addGenericBuiltIn
  BuiltIn .PTR_DIFF label ptrDiff   bundle context addGenericBuiltIn
  "*" string.wrap pos context newBuiltInBundle
    if ..drop.2 true return end
  bundle = label =
  BuiltIn .MUL_I32 label i32i32_i32 bundle context addBuiltIn
  BuiltIn .MUL_I64 label i64i64_i64 bundle context addBuiltIn
  BuiltIn .MUL_F32 label f32f32_f32 bundle context addBuiltIn
  BuiltIn .MUL_F64 label f64f64_f64 bundle context addBuiltIn
  "/" string.wrap pos context newBuiltInBundle
    if ..drop.2 true return end
  bundle = label =
  BuiltIn .DIV_I32 label i32i32_i32 bundle context addBuiltIn
  BuiltIn .DIV_I64 label i64i64_i64 bundle context addBuiltIn
  BuiltIn .DIV_F32 label f32f32_f32 bundle context addBuiltIn
  BuiltIn .DIV_F64 label f64f64_f64 bundle context addBuiltIn
  "%" string.wrap pos context newBuiltInBundle
    if ..drop.2 true return end
  bundle = label =
  BuiltIn .MOD_I32 label i32i32_i32 bundle context addBuiltIn
  BuiltIn .MOD_I64 label i64i64_i64 bundle context addBuiltIn
  BuiltIn .MOD_F32 label f32f32_f32 bundle context addBuiltIn
  BuiltIn .MOD_F64 label f64f64_f64 bundle context addBuiltIn
  "..udiv" string.wrap pos context newBuiltInBundle
    if ..drop.2 true return end
  bundle = label =
  BuiltIn .UDIV_I32 label i32i32_i32 bundle context addBuiltIn
  BuiltIn .UDIV_I64 label i64i64_i64 bundle context addBuiltIn
  "..umod" string.wrap pos context newBuiltInBundle
    if ..drop.2 true return end
  bundle = label =
  BuiltIn .UMOD_I32 label i32i32_i32 bundle context addBuiltIn
  BuiltIn .UMOD_I64 label i64i64_i64 bundle context addBuiltIn
  "!" string.wrap pos context newBuiltInBundle
    if ..drop.2 true return end
  bundle = label =
  BuiltIn .NOT_BOOL label bool_bool bundle context addBuiltIn
  "~" string.wrap pos context newBuiltInBundle
    if ..drop.2 true return end
  bundle = label =
  BuiltIn .FLIP_I8  label i8_i8    bundle context addBuiltIn
  BuiltIn .FLIP_I16 label i16_i16 bundle context addBuiltIn
  BuiltIn .FLIP_I32 label i32_i32 bundle context addBuiltIn
  BuiltIn .FLIP_I64 label i64_i64 bundle context addBuiltIn
  "&" string.wrap pos context newBuiltInBundle
    if ..drop.2 true return end
  bundle = label =
  BuiltIn .AND_BOOL label boolbool_bool bundle context addBuiltIn
  BuiltIn .AND_I8  label i8i8_i8    bundle context addBuiltIn
  BuiltIn .AND_I16 label i16i16_i16 bundle context addBuiltIn
  BuiltIn .AND_I32 label i32i32_i32 bundle context addBuiltIn
  BuiltIn .AND_I64 label i64i64_i64 bundle context addBuiltIn
  "|" string.wrap pos context newBuiltInBundle
    if ..drop.2 true return end
  bundle = label =
  BuiltIn .OR_BOOL label boolbool_bool bundle context addBuiltIn
  BuiltIn .OR_I8  label i8i8_i8    bundle context addBuiltIn
  BuiltIn .OR_I16 label i16i16_i16 bundle context addBuiltIn
  BuiltIn .OR_I32 label i32i32_i32 bundle context addBuiltIn
  BuiltIn .OR_I64 label i64i64_i64 bundle context addBuiltIn
  "^" string.wrap pos context newBuiltInBundle
    if ..drop.2 true return end
  bundle = label =
  BuiltIn .XOR_BOOL label boolbool_bool bundle context addBuiltIn
  BuiltIn .XOR_I8  label i8i8_i8    bundle context addBuiltIn
  BuiltIn .XOR_I16 label i16i16_i16 bundle context addBuiltIn
  BuiltIn .XOR_I32 label i32i32_i32 bundle context addBuiltIn
  BuiltIn .XOR_I64 label i64i64_i64 bundle context addBuiltIn
  "..lshr" string.wrap pos context newBuiltInBundle
    if ..drop.2 true return end
  bundle = label =
  BuiltIn .LSHR_I8  label i8i8_i8    bundle context addBuiltIn
  BuiltIn .LSHR_I16 label i16i16_i16 bundle context addBuiltIn
  BuiltIn .LSHR_I32 label i32i32_i32 bundle context addBuiltIn
  BuiltIn .LSHR_I64 label i64i64_i64 bundle context addBuiltIn
  ">>" string.wrap pos context newBuiltInBundle
    if ..drop.2 true return end
  bundle = label =
  BuiltIn .ASHR_I8  label i8i8_i8    bundle context addBuiltIn
  BuiltIn .ASHR_I16 label i16i16_i16 bundle context addBuiltIn
  BuiltIn .ASHR_I32 label i32i32_i32 bundle context addBuiltIn
  BuiltIn .ASHR_I64 label i64i64_i64 bundle context addBuiltIn
  "<<" string.wrap pos context newBuiltInBundle
    if ..drop.2 true return end
  bundle = label =
  BuiltIn .SHL_I8  label i8i8_i8    bundle context addBuiltIn
  BuiltIn .SHL_I16 label i16i16_i16 bundle context addBuiltIn
  BuiltIn .SHL_I32 label i32i32_i32 bundle context addBuiltIn
  BuiltIn .SHL_I64 label i64i64_i64 bundle context addBuiltIn
  "?" string.wrap pos context newBuiltInBundle
    if ..drop.2 true return end
  bundle = label =
  BuiltIn .BOOL_I8 label i8_bool   bundle context addBuiltIn
  BuiltIn .BOOL_I16 label i16_bool bundle context addBuiltIn
  BuiltIn .BOOL_I32 label i32_bool bundle context addBuiltIn
  BuiltIn .BOOL_I64 label i64_bool bundle context addBuiltIn
  BuiltIn .BOOL_F32 label f32_bool bundle context addBuiltIn
  BuiltIn .BOOL_F64 label f64_bool bundle context addBuiltIn
  "<" string.wrap pos context newBuiltInBundle
    if ..drop.2 true return end
  bundle = label =
  BuiltIn .LT_I8  label i8i8_bool   bundle context addBuiltIn
  BuiltIn .LT_I16 label i16i16_bool bundle context addBuiltIn
  BuiltIn .LT_I32 label i32i32_bool bundle context addBuiltIn
  BuiltIn .LT_I64 label i64i64_bool bundle context addBuiltIn
  BuiltIn .LT_F32 label f32f32_bool bundle context addBuiltIn
  BuiltIn .LT_F64 label f64f64_bool bundle context addBuiltIn
  BuiltIn .LT_PTR label ptrCmp bundle context addGenericBuiltIn
  "<=" string.wrap pos context newBuiltInBundle
    if ..drop.2 true return end
  bundle = label =
  BuiltIn .LE_I8  label i8i8_bool   bundle context addBuiltIn
  BuiltIn .LE_I16 label i16i16_bool bundle context addBuiltIn
  BuiltIn .LE_I32 label i32i32_bool bundle context addBuiltIn
  BuiltIn .LE_I64 label i64i64_bool bundle context addBuiltIn
  BuiltIn .LE_F32 label f32f32_bool bundle context addBuiltIn
  BuiltIn .LE_F64 label f64f64_bool bundle context addBuiltIn
  BuiltIn .LE_PTR label ptrCmp bundle context addGenericBuiltIn
  ">=" string.wrap pos context newBuiltInBundle
    if ..drop.2 true return end
  bundle = label =
  BuiltIn .GE_I8  label i8i8_bool   bundle context addBuiltIn
  BuiltIn .GE_I16 label i16i16_bool bundle context addBuiltIn
  BuiltIn .GE_I32 label i32i32_bool bundle context addBuiltIn
  BuiltIn .GE_I64 label i64i64_bool bundle context addBuiltIn
  BuiltIn .GE_F32 label f32f32_bool bundle context addBuiltIn
  BuiltIn .GE_F64 label f64f64_bool bundle context addBuiltIn
  BuiltIn .GE_PTR label ptrCmp bundle context addGenericBuiltIn
  ">" string.wrap pos context newBuiltInBundle
    if ..drop.2 true return end
  bundle = label =
  BuiltIn .GT_I8  label i8i8_bool   bundle context addBuiltIn
  BuiltIn .GT_I16 label i16i16_bool bundle context addBuiltIn
  BuiltIn .GT_I32 label i32i32_bool bundle context addBuiltIn
  BuiltIn .GT_I64 label i64i64_bool bundle context addBuiltIn
  BuiltIn .GT_F32 label f32f32_bool bundle context addBuiltIn
  BuiltIn .GT_F64 label f64f64_bool bundle context addBuiltIn
  BuiltIn .GT_PTR label ptrCmp bundle context addGenericBuiltIn
  "..u<" string.wrap pos context newBuiltInBundle
    if ..drop.2 true return end
  bundle = label =
  BuiltIn .ULT_I8  label i8i8_bool   bundle context addBuiltIn
  BuiltIn .ULT_I16 label i16i16_bool bundle context addBuiltIn
  BuiltIn .ULT_I32 label i32i32_bool bundle context addBuiltIn
  BuiltIn .ULT_I64 label i64i64_bool bundle context addBuiltIn
  "..u<=" string.wrap pos context newBuiltInBundle
    if ..drop.2 true return end
  bundle = label =
  BuiltIn .ULE_I8  label i8i8_bool   bundle context addBuiltIn
  BuiltIn .ULE_I16 label i16i16_bool bundle context addBuiltIn
  BuiltIn .ULE_I32 label i32i32_bool bundle context addBuiltIn
