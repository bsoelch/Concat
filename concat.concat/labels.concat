#namespace labels
  i32 =:: public LabelId
  -1 LabelId =: public LABEL_ID_NONE
  ## TODO labels

  struct( i64 : bufferOffset FilePosition : pos ) =:: Label
  struct( i8 list : mut nameBuffer Label list : mut labels ) =:: public LabelContext
  proc( => LabelContext ) =: public newLabelContext
    1024    i8 list.create
    128  Label list.create
    LabelContext new return
  end

  proc( LabelContext ptr => LabelId ) =: public labelOffset
    [] .labels .length LabelId cast return
  end
  proc( string : str FilePosition : pos LabelContext ptr mut : context => LabelId ) =: public newLabel
    context [] .nameBuffer .length =:: offset
    context [] .nameBuffer  str .data str .length array.create list.appendArray context [] .nameBuffer =
    context [] .labels
      offset pos Label new list.append
    context [] .labels =
    context [] .labels .length 1 - LabelId cast return
  end
#end
