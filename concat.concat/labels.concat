#include numbers
#include string
#include stringBuilder
#include list
#include optional
#include utf8

#include "files.concat"
#include "common.concat"

struct( NamespaceId : mut current NamespaceImportId : mut imports ) =:: public NamespaceInfo

struct( NamespaceId : imported NamespaceImportId : parent NamespaceImportId : mut firstChild NamespaceImportId : mut next ) =:: public NamespaceImport

struct( i64 : offset i64 : length ) =:: public StringConstant

i32 =:: public LabelFlag
#namespace id
  0   LabelFlag =: public FLAG_NONE
  1   LabelFlag =: public FLAG_MUTABLE
  2   LabelFlag =: public FLAG_AUTO
  4   LabelFlag =: public FLAG_EXTERN
  8   LabelFlag =: public FLAG_PUBLIC
  16  LabelFlag =: public FLAG_PRIVATE
  32  LabelFlag =: public FLAG_STATIC
  64  LabelFlag =: public FLAG_EMPTY
  128 LabelFlag =: public FLAG_DUMMY

  0x40000000u32 LabelFlag =: public FLAG_EXPERIMENTAL
#end

struct( StringConstant : name NamespaceId list : mut children NamespaceId : parent ) =:: Namespace
struct( StringConstant : name FilePosition : pos NamespaceInfo : namespaceInfo FileId : srcFile LabelFlag : flags ) =:: Label

struct(
  i8 list : mut nameBuffer
  Label list : mut labels
  Namespace list : mut namespaces
  NamespaceImport list : mut namespaceImports
  NamespaceInfo : mut namespaceInfo
) =:: public LabelContext
#namespace id

  proc( => LabelContext ) =: public newLabelContext
    1024            i8 list.create
    128          Label list.create
    32       Namespace list.create
      0 0 StringConstant new
      32 NamespaceId list.create
      NAMESPACE_ID_NONE
      Namespace new list.append ## root namespace
    32 NamespaceImport list.create
      0
      NAMESPACE_IMPORT_NONE
    NamespaceInfo new
    LabelContext new return
  end

  proc( LabelContext ptr => LabelId ) =: public labelOffset
    [] .labels .length LabelId cast return
  end
  proc( StringConstant : const i64 : index LabelContext ptr : context => i8 ) =: public scCharAt
    context [] .nameBuffer .data const .offset + const .length string.create index string.charAt return
  end
  proc( string : a StringConstant : b LabelContext ptr : context => bool ) =: public scEqualTo
    ## string.eq
      a
      context [] .nameBuffer .data b .offset + b .length string.create
    string.eq return
  end
  proc( StringConstant : a StringConstant : b LabelContext ptr : context => bool ) =: public scEqual
    a .length b .length != if
      false return
    end
    a .offset b .offset == if
      true return
    end
    ## string.eq
      context [] .nameBuffer .data a .offset + a .length string.create
      context [] .nameBuffer .data b .offset + b .length string.create
    string.eq return
  end
  proc( LabelId : id LabelContext ptr mut : context => NamespaceId ) =: public getLabelNamespace
    id 0 < id context [] .labels .length >= | if
      NAMESPACE_ID_NONE return
    end
    context [] .labels id list.at .data [] .namespaceInfo .current return
  end
  proc( LabelId : id LabelContext ptr mut : context => FileId ) =: public getLabelFile
    id 0 < id context [] .labels .length >= | if
      FILE_ID_NONE return
    end
    context [] .labels id list.at .data [] .srcFile return
  end
  proc( LabelId : id LabelContext ptr mut : context => ) =: public inLabelNamespace
    id 0 < id context [] .labels .length >= | if
      return
    end
    context [] .labels id list.at .data [] .namespaceInfo context [] .namespaceInfo =
  end
  proc( string : str LabelId : id LabelContext ptr : context => bool ) =: public labelNameEq
    id 0 < id context [] .labels .length >= | if
      false return
    end
    context [] .labels id list.at .data [] .name =:: name
    context [] .nameBuffer .data name .offset +
      name .length
    string.create str string.eq return
  end
  proc( LabelId : a LabelId : b LabelContext ptr : context => bool ) =: public labelNamesEq
    a b == if
      true return
    end
    a 0 < a context [] .labels .length >= |
    b 0 < b context [] .labels .length >= | | if
      false return
    end
    context [] .labels a list.at .data [] .name =:: aData
    context [] .labels b list.at .data [] .name =:: bData
    ## string.eq
      context [] .nameBuffer .data aData .offset +
        aData .length
      string.create
      context [] .nameBuffer .data bData .offset +
        bData .length
      string.create
    string.eq return
  end
  proc( LabelId : id LabelContext ptr : context => LabelFlag ) =: public labelFlags
    id 0 < id context [] .labels .length >= | if
      0 LabelFlag cast return
    end
    context [] .labels id list.get .flags return
  end
  proc( LabelId : id LabelContext ptr : context => bool ) =: public isLabelEmpty
    id 0 < id context [] .labels .length >= | if
      true return
    end
    context [] .labels id list.get .flags FLAG_EMPTY & 0 != return
  end
  proc( LabelId : id LabelContext ptr : context => FilePosition optional ) =: public labelPos
    id 0 < id context [] .labels .length >= | if
      FilePosition optional.empty return
    end
    context [] .labels id list.get .pos optional.wrap return
  end
  proc( string : str LabelFlag : flags FilePosition : pos FileId : srcFile LabelContext ptr mut : context => LabelId ) =: public newLabel
    context [] .nameBuffer .length =:: offset
    context [] .nameBuffer  str .data str .length array.create list.appendArray context [] .nameBuffer =
    context [] .labels
      ## Label
        offset str .length StringConstant new
        pos
        context [] .namespaceInfo
        srcFile
        flags
      Label new list.append
    context [] .labels =
    context [] .labels .length 1 - LabelId cast return
  end
  proc( i64 : id LabelFlag : flags FilePosition : pos FileId : srcFile LabelContext ptr mut : context => LabelId ) =: public newDummyLabel
    context [] .nameBuffer .length =:: offset
    context [] .nameBuffer
      id sb.appendI
    context [] .nameBuffer =
    context [] .nameBuffer .length offset - =:: length
    context [] .labels
      ## Label
        offset length StringConstant new
        pos
        context [] .namespaceInfo
        srcFile
        flags
      Label new list.append
    context [] .labels =
    context [] .labels .length 1 - LabelId cast return
  end
  proc( string : str FilePosition : stringStart CompilerError list ptr mut : errors LabelContext ptr mut : context => StringConstant ) =: public parseStringConstant
    stringStart =:: mut pos
    '"' pos @ updateFilePos ## string content starts after "
    context [] .nameBuffer .length =:: offset
    6 sb.create =:: mut uft8Buff
    context [] .nameBuffer
      #dup .length str .length + list.ensureCap
      0 while #dup str .length < do
        #swap
          str #over:2 string.charAt #dup '\\' != if
            #dup pos @ updateFilePos
            list.append
            #swap
              1 +
            continue
          end #drop
        #swap
        1 +
        #swap
          str #over:2 string.charAt #dup switch
            '\\' '\'' '"' case
              '\\' pos @ updateFilePos
              #dup pos @ updateFilePos
              list.append
              break
            'n' case
              '\\' pos @ updateFilePos
              pos @ updateFilePos
              '\n' list.append
              break
            't' case
              '\\' pos @ updateFilePos
              pos @ updateFilePos
              '\t' list.append
              break
            'b' case
              '\\' pos @ updateFilePos
              pos @ updateFilePos
              '\b' list.append
              break
            'r' case
              '\\' pos @ updateFilePos
              pos @ updateFilePos
              '\r' list.append
              break
            'f' case
              '\\' pos @ updateFilePos
              pos @ updateFilePos
              '\f' list.append
              break
            'v' case
              '\\' pos @ updateFilePos
              pos @ updateFilePos
              '\v' list.append
              break
            'x' 'u' 'U' case =:: c
              c 'x' == if 2 else c 'u' == _if 4 else 8 end =:: nChars
              #over nChars + str .length >= if
                "not enough characters for escape sequence \"\\" sb.wrap
                  c                     sb.appendC
                  "\" need "            sb.appendS
                  nChars                sb.appendI
                  " got "               sb.appendS
                  str .length #over:3 - sb.appendI
                pos errors appendError
                '\\' pos @ updateFilePos
                c pos @ updateFilePos
                #swap 1 +
                continue
              end
              '\\' pos @ updateFilePos
              c pos @ updateFilePos
              #swap
              1 +
              #swap
                str .data #over:2 + nChars string.create 16 number.tryParseInt .NONE ?? if
                  #dup 0 < if #drop
                    "invalid hex-code for escape sequence: \"\\" sb.wrap c sb.appendC str .data #over:3 + nChars string.create sb.appendStr '\"' sb.appendC pos errors appendError
                  else
                    c 'x' == if
                      i8 cast list.append
                    else c 'u' == _if
                      uft8Buff sb.clear
                        #swap i32 cast sb.appendCodepoint
                      uft8Buff =
                      uft8Buff sb.asArray list.appendArray
                    else c 'U' == _if
                      #dup i32.MAX > if
                        "hex-code for escape sequence: \"\\U" sb.wrap
                          str .data #over:4 + nChars string.create sb.appendStr
                          "\" does not fit in a signed integer" sb.appendS
                        pos errors appendError
                      else #dup utf8.MAX_CODEPOINT > _if
                        "code-point outside allowed range: \"\\U" sb.wrap
                          str .data #over:4 + nChars string.create sb.appendStr
                          "\" (maximum: " sb.appendS
                          utf8.MAX_CODEPOINT sb.appendX
                          ")" sb.appendS
                        pos errors appendWarning
                      end
                      uft8Buff sb.clear
                        #swap i32 cast sb.appendCodepoint
                      uft8Buff =
                      uft8Buff sb.asArray list.appendArray
                    else #drop
                      "unknown hex-escape sequence: \"\\" sb.wrap c sb.appendC '\"' sb.appendC pos errors appendError
                    end
                  end
                else #drop
                  "invalid hex-code for escape sequence: \"\\" sb.wrap c sb.appendC str .data #over:3 + nChars string.create sb.appendStr '\"' sb.appendC pos errors appendError
                end
              #swap ## update file position
                0 while #dup nChars < do
                  str #over #over:2 + string.charAt pos @ updateFilePos
                  #swap 1 +
                  #swap 1 +
                end #drop
              continue
            default
              "unknown escape sequence \"\\" sb.wrap #over sb.appendC '\"' sb.appendC pos errors appendError
              '\\' pos @ updateFilePos
              pos @ updateFilePos
          end
        #swap
        1 +
      end #drop
    context [] .nameBuffer =
    uft8Buff sb.free #drop
    offset context [] .nameBuffer .length offset - StringConstant new return
  end
  proc( NamespaceId : parent string : name  LabelContext ptr mut : context => NamespaceId ) =: newNamespace
    context [] .nameBuffer .length =:: offset
    context [] .nameBuffer
      name .data name .length array.create list.appendArray
    context [] .nameBuffer =
    context [] .namespaces .length =:: id
    context [] .namespaces
      offset name .length StringConstant new
      16 NamespaceId list.create
      parent
      Namespace new list.append
    context [] .namespaces =
    id NamespaceId cast return
  end
  proc( NamespaceId : base string : childName bool : create  LabelContext ptr mut : context  => NamespaceId ) =: public childId
    base NAMESPACE_ID_NONE == childName .length 0 == | if
      NAMESPACE_ID_NONE return
    end
    base 0 < base  context [] .namespaces .length >= | if
      NAMESPACE_ID_NONE return ## id out of range
    end
    context [] .namespaces base list.at .data =:: baseSpace
    0 while #dup baseSpace [] .children .length < do
      baseSpace [] .children #over list.get =:: child
      childName context [] .namespaces child list.get .name context scEqualTo if #drop
        child return
      end
      1 +
    end #drop
    create ! if
      NAMESPACE_ID_NONE return
    end
    base childName context newNamespace
      context [] .namespaces base list.at .data
        #dup [] .children
          #over:2 list.append
      #swap [] .children =
    return
  end
  proc( NamespaceId : base string : path  LabelContext ptr mut : context => NamespaceId ) =: public findNamespace
    base NamespaceId =: mut id
    path
      while #dup .length 0 > do
        '.' string.split
        id #swap false context childId id =
        id NAMESPACE_ID_NONE == if
          break
        end
      end
    #drop
    id return
  end
  proc( NamespaceId : id LabelContext ptr mut : context => StringConstant ) =: public namespaceName
    id NAMESPACE_ID_NONE == if
      0 0 StringConstant new return
    end
    context [] .namespaces id list.get .name return
  end
  proc( NamespaceId : id LabelContext ptr mut : context => NamespaceId ) =: public parentNamespace
    id NAMESPACE_ID_NONE == if
      NAMESPACE_ID_NONE return
    end
    context [] .namespaces id list.get .parent return
  end
  proc( NamespaceImportId : parent NamespaceId : import LabelContext ptr mut : context => NamespaceImportId ) =: public getNamespaceImportId
    context [] .namespaceImports .length 0 > if
      parent NAMESPACE_IMPORT_NONE == if
        0 NamespaceImportId cast
      else
        context [] .namespaceImports parent list.get .firstChild
      end
      #dup NAMESPACE_IMPORT_NONE == if
        context [] .namespaceImports .length NamespaceImportId cast
          context [] .namespaceImports parent list.at .data [] .firstChild =
      end
      NAMESPACE_IMPORT_NONE #swap
        while #dup NAMESPACE_IMPORT_NONE != do #swap #drop
          context [] .namespaceImports #over list.get .imported import == if
            return
          end
          context [] .namespaceImports #over list.get .next
        end #drop
      #dup NAMESPACE_IMPORT_NONE != if
        context [] .namespaceImports .length NamespaceImportId cast
          context [] .namespaceImports #over:2 list.at .data [] .next =
      end #drop
    end
    context [] .namespaceImports
      import
      parent
      NAMESPACE_IMPORT_NONE
      NAMESPACE_IMPORT_NONE
      NamespaceImport new list.append
    context [] .namespaceImports =
    context [] .namespaceImports .length 1 - NamespaceImportId cast return
  end
#end

#namespace sb
  proc( stringBuilder : sb LabelId : id LabelContext ptr : context => stringBuilder ) =: public appendLabelName
    id 0 < id context [] .labels .length >= | if
      sb return
    end
    context [] .labels id list.at .data [] .name =:: name
    sb
      context [] .nameBuffer .data name .offset +
        name .length
      string.create
    sb.appendStr return
  end
  proc( stringBuilder : sb LabelId : id LabelContext ptr : context => stringBuilder ) =: public appendAsciifiedLabelName
    id 0 < id context [] .labels .length >= | if
      sb return
    end
    context [] .labels id list.at .data [] .name =:: name
    sb
      context [] .nameBuffer .data name .offset +
        name .length
      string.create
    sb.appendAsciified return
  end
  proc( stringBuilder : sb StringConstant : const LabelContext ptr : context => stringBuilder ) =: public appendStringConst
    sb
      context [] .nameBuffer .data const .offset +
        const .length
      string.create
    sb.appendStr return
  end
  proc( stringBuilder : sb StringConstant : const LabelContext ptr : context => stringBuilder ) =: public appendAsciifiedStringConst
    sb
      context [] .nameBuffer .data const .offset +
        const .length
      string.create
    sb.appendAsciified return
  end
#end
