import numbers
import string
import stringBuilder
import list
import optional
import arenaAlloc
using std.literals.

import "files.concat"
import "common.concat"

struct( NamespaceId : current NamespaceImportId : imports ) =:: export: NamespaceInfo

struct(
  NamespaceId : imported
  NamespaceImportId : parent
  string : nameAlias
  NamespaceImportId : firstChild
  NamespaceImportId : next
) =:: export: NamespaceImport

namespace: id
  i32 =:: export: ScopeId
  -1:ScopeId =:: export: NO_SCOPE
   0:ScopeId =:: export: GLOBAL_SCOPE

  i32 =:: export: LabelFlag
  proc( LabelFlag LabelFlag -> LabelFlag ) : alias: flagAnd i32.and
  proc( LabelFlag LabelFlag -> LabelFlag ) : alias: flagOr  i32.or
  proc( LabelFlag LabelFlag -> LabelFlag ) : alias: flagXor i32.xor
  proc( LabelFlag -> LabelFlag ) : alias: flagFlip i32.flip
  proc( LabelFlag -> bool ) : alias: flagToBool i32.toBool
  overload: merge: &  flagAnd    end
  overload: merge: |  flagOr     end
  overload: merge: ^  flagXor    end
  overload: merge: ~  flagFlip   end
  overload: merge: ?  flagToBool end

  0x0000:LabelFlag =:: export: FLAG_NONE
  0x0001:LabelFlag =:: export: FLAG_MUTABLE
  0x0002:LabelFlag =:: export: FLAG_AUTO
  0x0004:LabelFlag =:: export: FLAG_EXTERN
  0x0008:LabelFlag =:: export: FLAG_EXPORT
  0x0010:LabelFlag =:: export: FLAG_STATIC
  0x0020:LabelFlag =:: export: FLAG_INLINE
  0x0040:LabelFlag =:: export: FLAG_NO_INLINE
  0x0080:LabelFlag =:: export: FLAG_EMPTY
  0x0100:LabelFlag =:: export: FLAG_BUILT_IN
  0x0200:LabelFlag =:: export: FLAG_DUMMY
  0x0400:LabelFlag =:: export: FLAG_ITR_VAR
  0x0800:LabelFlag =:: export: FLAG_SHADOW
  0x1000:LabelFlag =:: export: FLAG_ALIAS
  0x2000:LabelFlag =:: export: FLAG_MERGE
  0x4000:LabelFlag =:: export: FLAG_LAMBDA
  0x8000:LabelFlag =:: export: FLAG_MERGEABLE
  0x10000:LabelFlag =:: export: FLAG_IGNORE_UNUSED

 ## 0x20000000:LabelFlag FLAG_IGNORE_UNUSED | =:: export: FLAG_LIB_FILE ## in library file
  0x20010000:LabelFlag =:: export: FLAG_LIB_FILE ## XXX temporary until renamed built-ins are supported
  0x40000000:LabelFlag =:: export: FLAG_EXPERIMENTAL
end

struct( string : name NamespaceId list : children NamespaceId : parent ) =:: Namespace
struct(
  string : name
  FilePosition : pos
  NamespaceInfo : namespaceInfo
  FileId : srcFile
  id.LabelFlag : flags
) =:: Label

struct(
  char8 ArenaAllocator : nameBuffer
  Label list : labels ## XXX change to arenaAllocator ( i32 addresses )
  Namespace list : namespaces
  NamespaceImport list : namespaceImports
  NamespaceInfo : namespaceInfo
) =:: export: LabelContext
namespace: id

  proc( -> LabelContext ) =>: export: newLabelContext
    4096 char8 arenaAlloc.create
    128          Label list.create
    32       Namespace list.create
      string.empty
      32 NamespaceId list.create
      NAMESPACE_ID_NONE
      Namespace new list.append ## root namespace
    32 NamespaceImport list.create
      0:NamespaceId
      NAMESPACE_IMPORT_NONE
    NamespaceInfo new
    LabelContext new return
  end
  proc( LabelContext -> LabelContext ) =>: export: freeLabelContext
    =:: mut: context
    context .nameBuffer arenaAlloc.free context@ .nameBuffer=
    context .labels           list.free context@ .labels=
    0:i32 while ..dup context .namespaces .length < do =:: i
      context .namespaces i list.at .data =:: namespace
      namespace [] .children list.free namespace .children=
      i 1 +
    end ..drop
    context .namespaces       list.free context@ .namespaces=
    context .namespaceImports list.free context@ .namespaceImports=
    context return
  end

  proc( LabelContext ptr -> LabelId ) =>: export: labelOffset
    [] .labels .length LabelId cast return
  end

  proc( LabelId : id LabelContext ptr : context -> Label ptr.mut optional ) =>: getLabel
    id LABEL_ID_NONE == if
      Label ptr.mut optional.empty return
    end
    ## index check done by list.at
    context [] .labels id i64 cast list.at return
  end
  proc( LabelId : id LabelContext ptr.mut : context -> string ) =>: export: getLabelName
    id context getLabel =:: label?
    label? optional.isEmpty if
      string.empty return
    end
    ## the addresses of label names are stable for the lifetime of the context
    label? .data [] .name return
  end
  proc( LabelId : id LabelContext ptr.mut : context -> NamespaceId ) =>: export: getLabelNamespace
    id context getLabel =:: label?
    label? optional.isEmpty if
      NAMESPACE_ID_NONE return
    end
    label? .data [] .namespaceInfo .current return
  end
  proc( LabelId : id LabelContext ptr.mut : context -> FileId ) =>: export: getLabelFile
    id context getLabel =:: label?
    label? optional.isEmpty if
      FILE_ID_NONE return
    end
    label? .data [] .srcFile return
  end
  proc( LabelId : id LabelContext ptr.mut : context -> FilePosition optional ) =>: export: getLabelPos
    id context getLabel =:: label?
    label? optional.isEmpty if
      FilePosition optional.empty return
    end
    label? .data [] .pos optional.wrap return
  end
  proc( LabelContext ptr.mut : context -> NamespaceInfo ) =>: export: currentNamespace
    context [] .namespaceInfo return
  end
  proc( LabelId : id LabelContext ptr.mut : context -> ) =>: export: inLabelNamespace
    id context getLabel =:: label?
    label? optional.isEmpty if
       return
    end
    label? .data [] .namespaceInfo context .namespaceInfo=
  end
  proc( NamespaceInfo LabelContext ptr.mut : context -> ) =>: export: resetNamespace
    context .namespaceInfo=
  end
  proc( LabelContext ptr.mut : context -> ) =>: export: clearNamespace
    0:NamespaceId NAMESPACE_IMPORT_NONE NamespaceInfo new context .namespaceInfo=
  end
  proc( string : str LabelId : id LabelContext ptr : context -> bool ) =>: export: labelNameEq
    id context getLabel =:: label?
    label? optional.isEmpty if
      false return
    end
    label? .data [] .name =:: name
    name str string.eq return
  end
  proc( LabelId : a LabelId : b LabelContext ptr : context -> bool ) =>: export: labelNamesEq
    a b == if
      true return
    end
    a context getLabel =:: aLabel?
    b context getLabel =:: bLabel?
    aLabel? optional.isEmpty or bLabel? optional.isEmpty if
      false return
    end
    aLabel? .data [] .name bLabel? .data [] .name string.eq return
  end
  proc( LabelId : id LabelContext ptr : context -> LabelFlag ) =>: export: labelFlags
    id context getLabel =:: label?
    label? optional.isEmpty if
      0:LabelFlag return
    end
    label? .data [] .flags return
  end
  proc( LabelId : id LabelFlag : newFlags LabelContext ptr : context -> ) =>: export: addLabelFlags
    id context getLabel =:: label?
    label? optional.isEmpty if
      return
    end
    label? .data .flags =:: flags
    flags []
      newFlags |
    flags []=
  end
  proc( LabelId : id LabelContext ptr : context -> bool ) =>: export: isLabelEmpty
    id context getLabel =:: label?
    label? optional.isEmpty if
      true return
    end
    label? .data [] .flags FLAG_EMPTY & ? return
  end
  proc( LabelId : id LabelContext ptr : context -> FilePosition optional ) =>: export: labelPos
    id context getLabel =:: label?
    label? optional.isEmpty if
      FilePosition optional.empty return
    end
    label? .data [] .pos optional.wrap return
  end
  proc(
    string : str
    LabelContext ptr.mut : context
  -> string ) =>: export: copyString
    context [] .nameBuffer
      str string.chars arenaAlloc.copySlice slice.freeze string.fromChars =:: nameData
    context .nameBuffer=
    nameData return
  end
  proc(
    string : str
    LabelFlag : flags
    FilePosition : pos
    FileId : srcFile
    LabelContext ptr.mut : context
  -> LabelId ) =>: export: newLabel
    context [] .labels
      ## Label
        str context copyString
        pos
        context [] .namespaceInfo
        srcFile
        flags
      Label new list.append
    context .labels=
    context [] .labels .length 1 - LabelId cast return
  end
  proc( i32 : id FilePosition : pos FileId : srcFile LabelContext ptr.mut : context -> LabelId ) =>: export: newDummyLabel
    ## create temporary string Builder backed by buffer
    char8 20 array new =:: mut: intToStrBuffer
    intToStrBuffer@ $ ..length i32 cast.u sb.fromBuffer
      id sb.appendU
    sb.asStr =:: str
    context [] .labels
      ## Label
        str context copyString
        pos
        context [] .namespaceInfo
        srcFile
        id.FLAG_DUMMY id.FLAG_MUTABLE |
      Label new list.append
    context .labels=
    context [] .labels .length 1 - LabelId cast return
  end

  proc( NamespaceId : parent string : name  LabelContext ptr.mut : context -> NamespaceId ) =>: newNamespace
    context [] .namespaces .length =:: id
    context [] .namespaces
      name context copyString
      16 NamespaceId list.create
      parent
      Namespace new list.append
    context .namespaces=
    id NamespaceId cast return
  end
  proc( NamespaceId : base string : childName bool : create  LabelContext ptr.mut : context  -> NamespaceId ) =>: export: childId
    base NAMESPACE_ID_NONE == childName .length 0 == | if
      NAMESPACE_ID_NONE return
    end
    childName '.' string.indexOf =:: dotIndex
    dotIndex 0 >= if ## name contains dot -> search for nested namespace
      childName dotIndex string.splitIndex =:: head =:: tail
      base head create context childId
        tail create context childId
      return
    end
    base i32 cast 0 < or base i32 cast context [] .namespaces .length >= if
      NAMESPACE_ID_NONE return ## id out of range
    end
    context [] .namespaces base i32 cast list.at .data =:: baseSpace
    0:i32 while ..dup baseSpace [] .children .length < do =:: i
      baseSpace [] .children i list.get i32 cast =:: child
      childName context [] .namespaces child list.get .name string.eq if
        child NamespaceId cast return
      end
      i 1 +
    end ..drop
    create ! if
      NAMESPACE_ID_NONE return
    end
    base childName context newNamespace
      context [] .namespaces base i32 cast list.at .data
        ..dup [] .children
          ..over.2 list.append
      ..swap .children=
    return
  end
  proc(
    NamespaceId : base
    string : path
    LabelContext ptr.mut : context
    bool : create
  -> NamespaceId ) =>: export: findNamespace_internal
    base NamespaceId =: mut: id
    path
      while ..dup .length 0 > do
        '.' string.split
        id ..swap create context childId id@ =
        id NAMESPACE_ID_NONE == if
          break
        end
      end
    ..drop
    id return
  end
  proc(
    NamespaceId : base
    string : path
    LabelContext ptr.mut : context
  -> NamespaceId ) =>: export: findNamespace
    base path context false findNamespace_internal
  end
  proc(
    NamespaceId : base
    string : path
    LabelContext ptr.mut : context
  -> NamespaceId ) =>: export: createNamespace
    base path context true findNamespace_internal
  end
  proc( NamespaceId : id LabelContext ptr : context -> string ) =>: export: namespaceName
    id NAMESPACE_ID_NONE == if
      string.empty return
    end
    context [] .namespaces id i64 cast list.get .name return
  end
  proc( NamespaceId : id LabelContext ptr : context -> NamespaceId ) =>: export: parentNamespace
    id NAMESPACE_ID_NONE == if
      NAMESPACE_ID_NONE return
    end
    context [] .namespaces id i64 cast list.get .parent return
  end
  proc(
    NamespaceImportId : parent
    NamespaceId : importId
    string : aliasName
    LabelContext ptr.mut : context
  -> NamespaceImportId ) =>: export: getNamespaceImportId
    context [] .namespaceImports .length 0 > if
      parent NAMESPACE_IMPORT_NONE == if
        0:NamespaceImportId
      else
        context [] .namespaceImports parent i64 cast list.get .firstChild
      end
      ..dup NAMESPACE_IMPORT_NONE == if
        context [] .namespaceImports .length NamespaceImportId cast
          context [] .namespaceImports parent i64 cast list.at .data .firstChild=
      end
      NAMESPACE_IMPORT_NONE ..swap
        while ..dup NAMESPACE_IMPORT_NONE != do ..swap ..drop
          context [] .namespaceImports ..over i64 cast list.get .imported importId == if
            return
          end
          context [] .namespaceImports ..over i64 cast list.get .next
        end ..drop
      ..dup NAMESPACE_IMPORT_NONE != if
        context [] .namespaceImports .length NamespaceImportId cast
          context [] .namespaceImports ..over.2 i64 cast list.at .data .next=
      end ..drop
    end
    context [] .namespaceImports
      importId
      parent
      aliasName
      NAMESPACE_IMPORT_NONE
      NAMESPACE_IMPORT_NONE
      NamespaceImport new list.append
    context .namespaceImports=
    context [] .namespaceImports .length 1 - NamespaceImportId cast return
  end
end

namespace: sb
  proc( stringBuilder : sb LabelId : id LabelContext ptr : context -> stringBuilder ) =>: export: appendLabelName
    id context id.getLabel =:: label?
    label? optional.isEmpty if
      sb return
    end
    sb label? .data [] .name sb.appendStr return
  end
  proc( stringBuilder : sb LabelId : id LabelContext ptr : context bool : asciify -> stringBuilder ) =>: appendLabelPath_internal
    id context id.getLabel =:: label?
    label? optional.isEmpty if
      sb return
    end
    string 64 array : pathBuffer
    pathBuffer@ 64 list.fromBuffer
      label? .data [] .namespaceInfo .current =:: mut: mNamespace
      while mNamespace id.NAMESPACE_ID_NONE != and mNamespace 0:NamespaceId != do
        mNamespace context id.namespaceName list.append
        mNamespace context id.parentNamespace mNamespace@ =
      end
    =:: namePath
    asciify if
      sb
        namePath .length 1 - while $ 0 >= do =:: i
          namePath i list.get sb.appendAsciified
          ".":s sb.appendAsciified
        finally i 1 - end ..drop
        label? .data [] .name sb.appendAsciified
      return
    else
      sb
        namePath .length 1 - while $ 0 >= do =:: i
          namePath i list.get sb.appendStr
          '.' sb.appendC
        finally i 1 - end ..drop
        label? .data [] .name sb.appendStr
      return
    end
  end
  proc( stringBuilder : sb LabelId : id LabelContext ptr : context -> stringBuilder ) =>: export: appendLabelPath
    sb id context false appendLabelPath_internal
  end
  proc( stringBuilder : sb LabelId : id LabelContext ptr : context -> stringBuilder ) =>: export: appendAsciifiedLabelPath
    sb id context true appendLabelPath_internal
  end
end
