    extendArguments return
  end
  src typeContext types.isInt ! if
    sb return
  end
  src typeContext types.numberPrecision
     types.primitive.I32 typeContext types.numberPrecision >= if
    sb return
  end
  context popValue args @ 1 [] =
  context popValue args @ 0 [] =
  sb
    0 while ..dup 2 < do =:: i
      "%s" sb.appendS
