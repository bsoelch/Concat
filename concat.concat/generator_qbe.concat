import stringIO

import "program.concat"
import "measure.concat"
import "branchTree.concat"

## XXX make prefix customizable
"cct_" =:: CONCAT_PREFIX
"cctI_argc" =:: CONCAT_ARGC_NAME
"cctI_argv" =:: CONCAT_ARGV_NAME
"cctI_envp" =:: CONCAT_ENVP_NAME
"localConstant" =:: LOCAL_CONST_NAME
"checkIndexFormat" =:: CHECK_INDEX_FORMAT
"checkEnumFormat" =:: CHECK_ENUM_FORMAT
"fileName" =:: FILE_NAME_NAME

enum(
  START
  NEXT
  ERROR
  IF
  ELSE
  END_IF
  CASE
  DEFAULT
  END_SWITCH
) =:: BranchType
struct( BranchType : branchType i32 : id i32 : subId ) =:: BranchId
enum( EMPTY I32 I64 FLOAT DOUBLE PTR REFERENCE ) =:: ValType

struct(
  i64 : mut varId
  ValType : mut valType
) =:: StackElement

struct(
  Type       : valType
  ConstValue : value
  FilePosition : pos
  i64 : id
) =:: LocalConst

struct(
  branchTree.NodeId list : mut ififBranches
  BranchId list : mut ififBranchIds
  branchTree.NodeId : branchRoot
  branchTree.NodeId : mut ifBranch
  BranchId : mut ifBranchId
  i32 : blockId
  bool : mut ifBranchTerminates
) =:: IfBlockInfo
struct(
  branchTree.NodeId list : mut caseBranches
  BranchId list : mut caseBranchIds
  branchTree.NodeId : branchRoot
  i32 : blockId
) =:: SwitchBlockInfo

enum(
  IfBlockInfo : mut If
  SwitchBlockInfo : mut Switch
  While
) =:: BlockInfo

struct(
  ProgramContext ptr mut : program
  StackElement BranchTree : mut stackInfo
  BranchId : mut currentBranch
  BlockInfo list : mut openBlocks
  LocalConst list : mut localConstants
  i64 : mut localConstCount
  i64 : mut stackCount
  i64 : mut tmpCount
  i32 : mut jumpLabelCount
  bool : mut reachable
) =:: CompilerContext

namespace: sb
  proc( stringBuilder ValType -> stringBuilder ) =>: appendValType
    switch
      EMPTY case "empty" sb.appendS return
      I32 case "i32" sb.appendS return
      I64 case "i64" sb.appendS return
      FLOAT case "float" sb.appendS return
      DOUBLE case "double" sb.appendS return
      PTR case "pointer" sb.appendS return
      REFERENCE case "reference" sb.appendS return
    end
  end
  proc( stringBuilder ValType -> stringBuilder ) =>: appendValTypeQBE
    switch
      EMPTY case break
      I32 case 'w' sb.appendC break
      I64 PTR REFERENCE case 'l' sb.appendC break
      FLOAT case 's' sb.appendC break
      DOUBLE case 'd' sb.appendC break
    end
  end
end
proc( Type : t CompilerContext ptr : context -> ValType ) =>: toValType
  context [] .program =:: program
  program [] .errors @ =:: errors
  program [] .idContext .typeContext @ =:: typeContext
  t switch
    namedType case
      t typeContext types.unwrapNamed context toValType return
    generatedType case
      t typeContext types.getGeneratedType context toValType return
    primitiveType case
      t .primitiveType switch
        TYPE case ValType .EMPTY return
        BOOL I8 I16 I32 case ValType .I32 return
        I64     case ValType .I64 return
        FLOAT32 case ValType .FLOAT return
        FLOAT64 case ValType .DOUBLE return
      end
      break
    cType case
      t .cType switch ## TODO consider sizes of c-types
        VOID case ValType .EMPTY return
        BOOL CHAR S_CHAR U_CHAR SHORT U_SHORT INT U_INT case ValType .I32 return
        LONG U_LONG case ValType .I64 return
        LONGLONG U_LONGLONG SIZE case ValType .I64 return
        FLOAT case ValType .FLOAT return
        DOUBLE case ValType .DOUBLE return
      end
      break
    arrayIndex case
      ValType .I64 return
    pointer case
      ValType .PTR return
    reference mutableReference procedure arrayType struct union enum case
      ValType .REFERENCE return
    undefined empty templateType genericType autoType
    procIn procOut case
      ValType .EMPTY return
  end
end

namespace: sb
  proc( stringBuilder : sb BranchId : branch -> stringBuilder ) =>: appendBranchId
    sb
      branch .branchType switch
        START case "@start" sb.appendS break
        NEXT case "@next" sb.appendS branch .id sb.appendI break
        ERROR case "@error" sb.appendS branch .id sb.appendI break
        IF case "@if_" sb.appendS branch .id sb.appendI break
        ELSE case "@else_" sb.appendS branch .id sb.appendI break
        END_IF case "@endIf_" sb.appendS branch .id sb.appendI break
        CASE case
          "@case_" sb.appendS
          branch .id sb.appendI
          '_' sb.appendC
          branch .subId sb.appendI
         break
        DEFAULT case "@default" sb.appendS branch .id sb.appendI break
        END_SWITCH case "@endSwitch_" sb.appendS branch .id sb.appendI break
      end
    return
  end
end
proc(
  stringBuilder : sb
  BranchId : branch
  CompilerContext ptr mut : context
-> stringBuilder ) =>: startBranch
  branch context [] .currentBranch =
  sb
    branch sb.appendBranchId
    '\n' sb.appendC
  return
end
proc( ValType : valType CompilerContext ptr mut : context -> i64 ) =>: pushValue
  context [] .stackCount =:: oldCount
    context [] .stackInfo @
      oldCount
      valType
    StackElement new branchTree.push
    oldCount
      1 +
    context [] .stackCount =
  oldCount return
end
proc( CompilerContext ptr mut : context -> i64 ) =>: nextValueId
  context [] .stackCount =:: oldCount
    oldCount 1 +
  context [] .stackCount =
  oldCount return
end
proc( ValType : valType i32 : offset CompilerContext ptr mut : context -> i64 ) =>: replaceValue
  context nextValueId =:: newId
  newId context [] .stackInfo @ offset branchTree.at .data [] .varId =
  valType
    context [] .stackInfo @ offset branchTree.at .data
  [] .valType =
  newId return
end
proc( CompilerContext ptr mut : context -> i64 ) =>: popValue
  context [] .stackInfo @ branchTree.pop =:: tmp
  tmp .data ?? if
    tmp .data [] .varId return
  end
  -1 return
end
proc( CompilerContext ptr mut : context -> i64 ) =>: nextTmpId
  context [] .tmpCount =:: oldCount
    oldCount
      1 +
    context [] .tmpCount =
  oldCount return
end
proc( CompilerContext ptr mut : context -> i32 ) =>: nextJumpLabelId
  context [] .jumpLabelCount =:: oldCount
    oldCount
      1 +
    context [] .jumpLabelCount =
  oldCount return
end

proc( Type : t CompilerContext ptr mut : context -> bool ) =>: referenceOnly
  context [] .program =:: program
  program [] .idContext .typeContext @ =:: typeContext
  t typeContext types.unwrapNamed types.isPrimitive if
    false return
  end
  t typeContext types.isPointer if
    false return
  end
  ## XXX allow empty enums as value-type
  true return
end

struct(
  string : blockName
  i32 : blockId
  BranchId arrayView : branchIds
  FilePosition : pos
  CompilerContext ptr mut : context
  stringBuilder ptr mut : out
) =:: MergePoint
proc(
  StackElement ptr arrayView : toMerge
  i64 : offset
  MergePoint : mergePoint
-> StackElement ) =>: mergeBranches
  mergePoint .context =:: context
  context [] .program =:: program
  program [] .errors @ =:: errors
  program [] .idContext @ =:: idContext
  program [] .idContext .constContext @ =:: constContext
  program [] .idContext .typeContext @ =:: typeContext
  program [] .idContext .labelContext @ =:: labelContext
  toMerge 0 array.get =:: rootValue
  rootValue [] .varId =:: rootId
  true =:: mut isMerged
  1 while ..dup toMerge .length < do =:: i
    toMerge i array.get [] .varId rootId != if
      false isMerged =
      i break
    end
    i 1 +
  end ..drop
  isMerged if
    rootValue [] return
  end
  1 while ..dup toMerge .length < do =:: i
    toMerge i array.get [] .valType rootValue [] .valType != if
      "branches of " sb.wrap
         mergePoint .blockName sb.appendStr
         "-statement are out of sync expected: " sb.appendS
         rootValue [] .valType sb.appendValType
         " got: " sb.appendS
         toMerge i array.get [] .valType sb.appendValType
      mergePoint .pos errors appendError
      i break
    end
    i 1 +
  end ..drop
  context nextValueId =:: newId
  mergePoint .out []
    "%s" sb.appendS
    newId sb.appendI
    " =" sb.appendS
    rootValue [] .valType sb.appendValTypeQBE
    " phi " sb.appendS
    0 while ..dup toMerge .length < do =:: i
      i 0 > if
        ", " sb.appendS
      end
      mergePoint .branchIds i array.get sb.appendBranchId
      " %s" sb.appendS
      toMerge i array.get [] .varId sb.appendI
      i 1 +
    end ..drop
    '\n' sb.appendC
  mergePoint .out [] =
  ## StackElement
    newId
    rootValue [] .valType
  StackElement new return
end

proc( BlockInfo : block CompilerContext ptr mut : context -> ) =>: openBlock
  context [] .openBlocks
    block list.append
  context [] .openBlocks =
end
proc(
  i32 : blockId
  branchTree.NodeId : branchRoot
  CompilerContext ptr mut : context
-> ) =>: openIfBlock
  ## IfBlockInfo
    8 branchTree.NodeId list.create
      branchRoot list.append
    8 BranchId list.create
      context [] .currentBranch list.append
    branchRoot
    -1
    context [] .currentBranch
    blockId
    false
  IfBlockInfo new BlockInfo .If new context openBlock
end
proc(
  i32 : blockId
  branchTree.NodeId : branchRoot
  CompilerContext ptr mut : context
-> ) =>: openSwitchBlock
  ## SwitchBlockInfo
    16 branchTree.NodeId list.create
    16 BranchId list.create
    branchRoot
    blockId
  SwitchBlockInfo new BlockInfo .Switch new context openBlock
end

proc(
  BlockType : breakType
  FilePosition : pos
  CompilerContext ptr mut : context
-> BlockInfo ptr mut optional ) =>: findBreakableBlock
  context [] .program =:: program
  program [] .errors @ =:: errors
  context [] .openBlocks .length 1 - while ..dup 0 >= do =:: i
    context [] .openBlocks i list.at .data =:: block
    breakType .BREAK ?? if block [] .While ?? _if
      block optional.wrap return
    end
    breakType .CONTINUE ?? if block [] .While ?? _if
      block optional.wrap return
    end
    breakType .BREAK_SWITCH ?? if block [] .Switch ?? _if
      block optional.wrap return
    end
    i 1 -
  end ..drop
  60 sb.create
    breakType sb.appendBlockType
    " can only appear in loops " sb.appendS
    breakType .BREAK_SWITCH ?? if
      "and switch-case statements" sb.appendS
    end
  pos errors appendError
  BlockInfo ptr mut optional.empty return
end

namespace: sb
  proc( stringBuilder : sb LabelId : label CompilerContext ptr mut : context -> stringBuilder ) =>: appendGlobalName
    context [] .program =:: prog
    prog [] .idContext .labelContext @ =:: labelContext
    sb
      '$' sb.appendC
      CONCAT_PREFIX sb.appendS
      label labelContext id.labelFlags id.FLAG_EXPORT & 0 == if
        label labelContext id.getLabelFile sb.appendI
        "_F" sb.appendS
      end
      label labelContext id.getLabelNamespace =:: mut mNamespace
      while mNamespace id.NAMESPACE_ID_NONE != mNamespace 0 > & do
        mNamespace labelContext id.namespaceName labelContext sb.appendAsciifiedStringConst
        "." string.wrap sb.appendAsciified
        mNamespace labelContext id.parentNamespace mNamespace =
      end ## XXX? reverse order
      label labelContext sb.appendAsciifiedLabelName
    return
  end

  proc(
    stringBuilder : sb
    Type : t
    string : name
    bool : isStored
  -> stringBuilder ) =>: appendCompositeTypeQBE
    isStored if
      sb
        ":" sb.appendS
        name sb.appendStr
        t types.getTypeId sb.appendI
      return
    else
      sb "l" sb.appendS return
    end
  end
end
  enum( STACK LOAD ULOAD STORE ) =:: StorageType
namespace: sb
  proc(
    stringBuilder : sb
    Type : t
    StorageType : storeType
    FilePosition : pos
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: appendTypeNameQBE
    context [] .program =:: prog
    prog [] .errors @ =:: errors
    prog [] .idContext .labelContext @ =:: labelContext
    prog [] .idContext .typeContext @ =:: typeContext
    t switch
      namedType case
        sb
          t typeContext types.unwrapNamed storeType pos context
        appendTypeNameQBE
        return
      generatedType case
        sb
          t typeContext types.getGeneratedType storeType pos context
        appendTypeNameQBE
        return
      primitiveType case
        t .primitiveType switch
          TYPE case sb ":type" sb.appendS return break
          BOOL case
            storeType switch
              STACK case sb "w" sb.appendS return
              LOAD ULOAD case sb "ub" sb.appendS return
              STORE case sb "b" sb.appendS return
            end
            break
          I8 case
            storeType switch
              STACK case sb "w" sb.appendS return
              LOAD case sb "sb" sb.appendS return
              ULOAD case sb "ub" sb.appendS return
              STORE case sb "b" sb.appendS return
            end
            break
          I16 case
            storeType switch
              STACK case sb "w" sb.appendS return
              LOAD case sb "sh" sb.appendS return
              ULOAD case sb "uh" sb.appendS return
              STORE case sb "h" sb.appendS return
            end
            break
          I32     case sb "w" sb.appendS return
          I64     case sb "l" sb.appendS return
          FLOAT32 case sb "s" sb.appendS return
          FLOAT64 case sb "d" sb.appendS return
        end
        break
      cType case
        t .cType switch ## TODO consider sizes of c-types
          BOOL U_CHAR case
            storeType switch
              STACK case sb "w" sb.appendS return
              LOAD ULOAD case sb "ub" sb.appendS return
              STORE case sb "b" sb.appendS return
            end
            break
          CHAR S_CHAR case
            storeType switch
              STACK case sb "w" sb.appendS return
              LOAD ULOAD case sb "sb" sb.appendS return
              STORE case sb "b" sb.appendS return
            end
            break
          SHORT case
            storeType switch
              STACK case sb "w" sb.appendS return
              LOAD ULOAD case sb "sh" sb.appendS return
              STORE case sb "h" sb.appendS return
            end
            break
          U_SHORT case
            storeType switch
              STACK case sb "w" sb.appendS return
              LOAD ULOAD case sb "uh" sb.appendS return
              STORE case sb "h" sb.appendS return
            end
            break
          INT U_INT case sb "w" sb.appendS return
          LONG LONGLONG U_LONG U_LONGLONG SIZE case
            sb "l" sb.appendS return
          FLOAT case sb "s" sb.appendS return
          DOUBLE case sb "d" sb.appendS return
          VOID case break
        end
        break
      arrayIndex pointer reference mutableReference procedure case
        sb "l" sb.appendS return ## size or pointer
      arrayType case
        sb t "array" string.wrap storeType .STACK ?? ! appendCompositeTypeQBE return
        break
      struct case
        sb t "struct" string.wrap storeType .STACK ?? ! appendCompositeTypeQBE return
        break
      union case
        sb t "union" string.wrap storeType .STACK ?? ! appendCompositeTypeQBE return
        break
      enum case
        sb t "enum" string.wrap storeType .STACK ?? ! appendCompositeTypeQBE return
        break
      undefined empty templateType genericType autoType
      procIn procOut case
        break
    end
    "unsupported type" sb.wrap
    pos errors appendError
    sb return
  end
  proc(
    stringBuilder : sb
    i32 : index
    LabelId : labelId
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: appendArgName
    context [] .program =:: prog
    prog [] .idContext .labelContext @ =:: labelContext
    sb
      "%a" sb.appendS
      index sb.appendI
    return
  end
  proc(
    stringBuilder : sb
    i32 : index
    LabelId : labelId
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: appendOutArgName
    context [] .program =:: prog
    prog [] .idContext .labelContext @ =:: labelContext
    sb
      "%o" sb.appendS
      index sb.appendI
    return
  end
  proc(
    stringBuilder : sb
    Type : procType
    FilePosition : pos
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: appendProcArgs
    context [] .program =:: prog
    prog [] .idContext .labelContext @ =:: labelContext
    prog [] .idContext .typeContext @ =:: typeContext
    procType typeContext types.getCallConvention ..drop =:: callConvention
    procType typeContext types.getProcIn ..drop =:: inType
    inType typeContext types.compositeElts =:: args
    procType typeContext types.getProcOut ..drop =:: outType
    outType typeContext types.compositeElts =:: outTypes
    false =:: mut hasArgs
    sb
      "(" sb.appendS
      0 while ..dup args .length < do
        ..swap
          args ..over.2 types.compositeElts.get =:: arg
          arg typeContext types.isEmpty if ## skip empty arguments
            ..swap 1 + continue
          end
          hasArgs if
            ',' sb.appendC
          end
          true hasArgs =
          arg StorageType .LOAD pos context appendTypeNameQBE
          ' ' sb.appendC
          ..over inType ..over typeContext types.compositeGetLabel context appendArgName
        ..swap 1 +
      end ..drop
      callConvention .POINTER ?? if
        outTypes .length =:: mut N
        N 0 > if outTypes N 1 - types.compositeElts.get typeContext types.isSmallType if
          N 1 - N =
        end end
        0 while ..dup N < do
          ..swap
            outTypes ..over.2 types.compositeElts.get =:: arg
            arg typeContext types.isEmpty if ## skip empty arguments
              ..swap 1 + continue
            end
            hasArgs if
              ',' sb.appendC
            end
            true hasArgs =
            "l " sb.appendS ## all out arguments are pointers
            ..over outType ..over typeContext types.compositeGetLabel context appendOutArgName
          ..swap 1 +
        end ..drop
      end
      ")" sb.appendS
    return
  end
  proc(
    stringBuilder : sb
    StringConstant : value
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: appendStringConstQBE
    context [] .program =:: prog
    prog [] .idContext .labelContext @ =:: labelContext
    sb
      0 while ..dup value .length < do =:: i
        "b " sb.appendS
        value i labelContext id.scCharAt 0xff & sb.appendI
        ',' sb.appendC
        i 1 +
      end ..drop
      "b 0" sb.appendS
    return
  end
  proc(
    stringBuilder : sb
    Type : t
    ConstValue : value
    bool : isGlobal
    FilePosition : pos
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: appendConstQBE
    context [] .program =:: prog
    prog [] .errors @ =:: errors
    prog [] .idContext .labelContext @ =:: labelContext
    prog [] .idContext .typeContext @ =:: typeContext
    prog [] .idContext .constContext @ =:: constContext
    sb
      isGlobal if t types.isPrimitive _if
        t StorageType .LOAD pos context sb.appendTypeNameQBE
        ' ' sb.appendC
      end
      value switch
        boolean case value .boolean if 1 else 0 end sb.appendI return
        int case value .int sb.appendI return
        break
        chr case value .chr sb.appendI return
        break
        enumLabel case break
        Float case break
        str case break
        arrayConstant case
          isGlobal ! if
            break ## TODO handle local composite constants
          end
          t typeContext types.isArray if
            t typeContext types.getBaseType =:: base
            value .arrayConstant constContext constArrayAsArray =:: elts
            0 while ..dup elts .length < do
              ..swap
                base elts ..over.3  array.get true pos context appendConstQBE
                ',' sb.appendC
              ..swap 1 +
            end ..drop
            return
          else t typeContext types.isTuple _if
            ## TODO padding/alignment
            t typeContext types.compositeElts =:: types
            value .arrayConstant constContext constArrayAsArray =:: elts
            0 while ..dup elts .length < do
              ..swap
                types ..over.2 types.compositeElts.get elts ..over.3  array.get true pos context appendConstQBE
                ',' sb.appendC
              ..swap 1 +
            end ..drop
            return
          end
        break
        none wildCard genericArg templateArg typeId procedure case
        break
      end
      isGlobal if
        "unsupported constant" sb.wrap
          value constContext labelContext typeContext sb.appendConstant
        pos errors appendError
        return
      end
      context [] .localConstants
        ..dup .length =:: constId
        ## LocalConst
          t
          value
          pos
          constId
        LocalConst new list.append
      context [] .localConstants =
      "$" sb.appendS
      LOCAL_CONST_NAME sb.appendS
      constId sb.appendI
    return
  end
  proc(
    stringBuilder : sb
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: appendLocalConstants
    context [] .program [] .idContext .typeContext @ =:: typeContext
    sb
      0 while ..dup context [] .localConstants .length < do =:: i
        context [] .localConstants i list.at .data =:: constant
        "data $" sb.appendS
        LOCAL_CONST_NAME sb.appendS
        constant [] .id sb.appendI
        " = align " sb.appendS
        constant [] .valType typeContext types.alignOf sb.appendI
        " {" sb.appendS
        constant [] .valType constant [] .value true constant [] .pos context appendConstQBE
        "}\n" sb.appendS
        i 1 +
      end ..drop
      context [] .localConstants
        list.clear
      context [] .localConstants =
    return
  end
  proc( stringBuilder : sb string : str -> stringBuilder ) =>: appendEscapedString
    sb
      0 while ..dup str .length < do =:: i
          str i string.charAt appendEscapedChr
        i 1 +
      end ..drop
    return
  end
  proc(
    stringBuilder : sb
    FilePosition : pos
  -> stringBuilder ) =>: appendPosQBE
    sb
      "dbgloc \"" sb.appendS
      pos .fileName sb.appendEscapedString
      "\"," sb.appendS
      pos .line sb.appendI
      ',' sb.appendC
      pos .posInLine sb.appendI
      '\n' sb.appendC
    return
  end
end

proc( string : fileName ProgramContext ptr : prog -> FileId ) =>: findFileId
  0 while ..dup prog [] .progFiles .length < do =:: i
    prog [] .progFiles i list.at .data [] .fileName list.asArray =:: currentName
    fileName currentName string.eq if
      i return
    end
    i 1 +
  end ..drop
  FILE_ID_NONE return
end


proc(
  stringBuilder : sb
  ValType : valType
  i8 : valStackType
  i64 : valId
  string : cmpType
  i64 : value
  BranchId : ifBranch
  BranchId : elseBranch
  CompilerContext ptr mut : context
-> stringBuilder ) =>: appendCmpInt
  context nextTmpId =:: tmpId
  sb
    "%t" sb.appendS
    tmpId sb.appendI
    " =w c" sb.appendS
    cmpType sb.appendStr
    valType sb.appendValTypeQBE
    " %" sb.appendS
    valStackType sb.appendC
    valId sb.appendI
    ", " sb.appendS
    value sb.appendI
    "\njnz %t" sb.appendS
    tmpId sb.appendI
    ", " sb.appendS
    ifBranch sb.appendBranchId
    ", " sb.appendS
    elseBranch sb.appendBranchId
    "\n" sb.appendS
  return
end
proc(
  stringBuilder : sb
  types.ArraySize : size
  i64 : valId
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: appendIndexCheck
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .labelContext @ =:: labelContext
  idContext [] .typeContext @ =:: typeContext
  size .sizeType .int ?? ! if
    "unsupported size type for array element" sb.wrap
      size sb.appendArraySize
    pos errors appendError
  end
  ## BranchId
    BranchType .NEXT
    context nextJumpLabelId
    0
  BranchId new =:: check1Branch
  ## BranchId
    BranchType .ERROR
    context nextJumpLabelId
    0
  BranchId new =:: errorBranch
  ## BranchId
    BranchType .NEXT
    context nextJumpLabelId
    0
  BranchId new =:: okBranch
  context nextTmpId =:: c1
  context nextTmpId =:: c2
  sb
    "## check index\n" sb.appendS
    ## cmp int
      ValType .I64
      's' valId
      "slt" string.wrap
      0
      errorBranch
      check1Branch
    context appendCmpInt
    check1Branch sb.appendBranchId
    "\n" sb.appendS
    ## cmp int
      ValType .I64
      's' valId
      "sge" string.wrap
      size .value
      errorBranch
      okBranch
    context appendCmpInt
    errorBranch sb.appendBranchId
    "\ncall $printf (l $" sb.appendS
    CHECK_INDEX_FORMAT sb.appendS
    ", ...,l %s" sb.appendS
    valId sb.appendI
    ",l " sb.appendS
    size .value sb.appendI
    ",l " sb.appendS
    pos .fileName .length sb.appendI
    ",l $" sb.appendS
    FILE_NAME_NAME sb.appendS
    pos .fileName prog findFileId sb.appendI
    ",w " sb.appendS
    pos .line sb.appendI
    ",w " sb.appendS
    pos .posInLine sb.appendI
    ")\n" sb.appendS
    "call $exit (w 1)\n" sb.appendS ## use exit for flushing stdout
    okBranch context startBranch
  return
end

proc(
  stringBuilder : sb
  Type : enumType
  i64 : valId
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder i64 ValType ) =>: loadEnumLabel
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  enumType typeContext types.enumLabelInfo =:: labelOffset =:: labelType
  labelType typeContext types.numberSize =:: numSize
  context nextTmpId =:: labelPtr
  context nextTmpId =:: mut label
  sb
    "%t" sb.appendS
    labelPtr sb.appendI
    " =l add %s" sb.appendS
    valId sb.appendI
    ", " sb.appendS
    labelOffset sb.appendI
    "\n%t" sb.appendS
    label sb.appendI
    " =w load" sb.appendS
    labelType StorageType .ULOAD pos context sb.appendTypeNameQBE
    " %t" sb.appendS
    labelPtr sb.appendI
    numSize types.primitive.I32 typeContext types.numberSize < if
      label =:: oldLabel
      context nextTmpId label =
      "\n%t" sb.appendS
      label sb.appendI
      " =w ext" sb.appendS
      labelType StorageType .ULOAD pos context sb.appendTypeNameQBE
      " %t" sb.appendS
      oldLabel sb.appendI
    end
    '\n' sb.appendC
  label ValType .I32 return
end
proc(
  stringBuilder : sb
  Type : enumType
  i64 : valId
  i64 : expectedIndex
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder i64 i64 ) =>: checkEnumIndex
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .labelContext @ =:: labelContext
  idContext [] .typeContext @ =:: typeContext
  sb
    ## loadEnumLabel
      enumType
      valId
      pos
    context loadEnumLabel =:: labelType =:: labelId
    context nextTmpId =:: c
    "%t" sb.appendS
    c sb.appendI
    " =w ceq" sb.appendS
    labelType sb.appendValTypeQBE
    " %t" sb.appendS
    labelId sb.appendI
    ", " sb.appendS
    expectedIndex sb.appendI
    '\n' sb.appendC
  c labelId return
end

proc(
  stringBuilder : sb
  Type : enumType
  i64 : valId
  i64 : expectedIndex
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: appendEnumCheck
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .labelContext @ =:: labelContext
  idContext [] .typeContext @ =:: typeContext
  ## BranchId
    BranchType .ERROR
    context nextJumpLabelId
    0
  BranchId new =:: errorBranch
  ## BranchId
    BranchType .NEXT
    context nextJumpLabelId
    0
  BranchId new =:: okBranch
  ## XXX? support enums with i64 labels? ( currently only i8,i16,i32 supported)
  sb
    "## check enum \n" sb.appendS
    enumType valId expectedIndex pos context checkEnumIndex =:: c =:: label
    "jnz %t" sb.appendS
    c sb.appendI
    ", " sb.appendS
    okBranch sb.appendBranchId
    ", " sb.appendS
    errorBranch sb.appendBranchId
    '\n' sb.appendC
    errorBranch sb.appendBranchId
    "\ncall $printf (l $" sb.appendS
    CHECK_ENUM_FORMAT sb.appendS
    ", ...,w %t" sb.appendS
    label sb.appendI
    ",w " sb.appendS
    expectedIndex sb.appendI
    ",l " sb.appendS
    pos .fileName .length sb.appendI
    ",l $" sb.appendS
    FILE_NAME_NAME sb.appendS
    pos .fileName prog findFileId sb.appendI
    ",w " sb.appendS
    pos .line sb.appendI
    ",w " sb.appendS
    pos .posInLine sb.appendI
    ")\n" sb.appendS
    "call $exit (w 1)\n" sb.appendS ## use exit for flushing stdout
    okBranch context startBranch
  return
end

proc(
  stringBuilder : sb
  Type : tupleType
  i64 : dataPtrId
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: initializeTupleQBE
  context [] .program =:: prog
  prog [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  tupleType typeContext types.compositeElts =:: elts
  sb
    elts .length 1 - while ..dup 0 >= do =:: i
      elts i types.compositeElts.get =:: eltType
      tupleType i typeContext types.tupleElementOffset =:: eltOffset
      eltType typeContext types.isEmpty if
        i 1 - continue
      end
      "%t" sb.appendS
        context nextTmpId =:: eltPtrId
      eltPtrId sb.appendI
      " =l add %t" sb.appendS
      dataPtrId sb.appendI
      ", " sb.appendS
      eltOffset sb.appendI
      '\n' sb.appendC
      eltType context referenceOnly if
        "blit %s" sb.appendS
      else
        "store" sb.appendS
        eltType StorageType .STORE pos context sb.appendTypeNameQBE
        " %s" sb.appendS
      end
      context popValue sb.appendI
      ", %t" sb.appendS
      eltPtrId sb.appendI
      eltType context referenceOnly if
        ',' sb.appendC
        eltType typeContext types.sizeOf sb.appendI
      end
      '\n' sb.appendC
      i 1 -
    end ..drop
  return
end
proc(
  stringBuilder : sb
  Type : valType
  CompilerContext ptr mut : context
  bool : createId
-> stringBuilder i64 ) =>: appendAlloc
  context [] .program =:: prog
  prog [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  -1i64 =:: mut tmpId
  sb
    createId if
      context nextTmpId tmpId =
      "%t" sb.appendS
      tmpId sb.appendI
    end
    " =l alloc" sb.appendS
    valType typeContext types.alignOf
      ..dup 4 < if ..drop 4i64 end
    sb.appendI
    ' ' sb.appendC
    valType typeContext types.sizeOf sb.appendI
    '\n' sb.appendC
  tmpId return
end

proc( ConstValue : label -> i64 ) =>: labelAsInt
  label .int ?? if
    label .int return
  end
  label .enumLabel ?? if
    label .enumLabel return
  end
  ..unreachable
end
proc(
  stringBuilder : sb
  ValType : valType
  i64 : valId
  i32 : switchId
  LabelData arrayView : labels
  i64 optional : lower
  i64 optional : upper
  CompilerContext ptr mut : context
-> stringBuilder ) =>: appendSwitchJumpTree
  labels .length 3 <= if
    false =:: mut contiguous
    labels .length =:: mut loopCount
    lower optional.hasData if upper optional.hasData _if
      upper .data lower .data - labels .length == contiguous =
      loopCount 1 - loopCount =
    end
    sb
      0 while ..dup loopCount < do =:: i
        ## BranchId
          BranchType .CASE
          switchId
          labels i array.at .data [] .caseId
        BranchId new =:: caseBranch
        ## BranchId
          BranchType .NEXT
          context nextJumpLabelId
          0
        BranchId new =:: nextBranch
        labels i array.get .value labelAsInt =:: cmpVal
        ## cmp int
          valType
          't' valId
          "eq" string.wrap
          cmpVal
          caseBranch
          nextBranch
        context appendCmpInt
        nextBranch sb.appendBranchId
        '\n' sb.appendC
        i 1 +
      end ..drop
      "jmp " sb.appendS
      contiguous if
        ## BranchId
          BranchType .CASE
          switchId
          labels loopCount array.at .data [] .caseId
        BranchId new sb.appendBranchId
        '\n' sb.appendC
      else
        ## BranchId
          BranchType .DEFAULT
          switchId
          0
        BranchId new sb.appendBranchId
        '\n' sb.appendC
      end
    return
  end
  labels .length 2 / =:: p
  ## BranchId
    BranchType .NEXT
    context nextJumpLabelId
    0
  BranchId new =:: ltBranch
  ## BranchId
    BranchType .NEXT
    context nextJumpLabelId
    0
  BranchId new =:: geBranch
  labels p array.get .value labelAsInt =:: cmpVal
  labels p array.cutIndex =:: lElts =:: rElts
  sb
    ## cmp int
      valType
      't' valId
      "slt" string.wrap
      cmpVal
      ltBranch
      geBranch
    context appendCmpInt
    ltBranch sb.appendBranchId
    '\n' sb.appendC
    ## appendSwitchJumpTree
      valType
      valId
      switchId
      lElts
      lower
      upper optional.isEmpty if
        cmpVal optional.wrap
      else
        upper .data cmpVal ## XXX min/max procedure
          ..over ..over > if ..swap end ..drop
        optional.wrap
      end
      context
    appendSwitchJumpTree
    geBranch sb.appendBranchId
    '\n' sb.appendC
    ## appendSwitchJumpTree
      valType
      valId
      switchId
      rElts
      lower optional.isEmpty if
        cmpVal optional.wrap
      else
        lower .data cmpVal
          ..over ..over < if ..swap end ..drop
        optional.wrap
      end
      upper
      context
    appendSwitchJumpTree
  return
end
proc(
  LabelData : a
  LabelData : b
  CompilerContext ptr mut : context
-> i32 ) =>: labelCmp
  a .value labelAsInt =:: aInt
  b .value labelAsInt =:: bInt
  aInt bInt == if
    0 return
  end
  aInt bInt < if -1 else 1 end return
end
proc(
  stringBuilder : sb
  Type : switchType
  i64 : valId
  i32 : switchId
  LabelData list : labels
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: appendSwitchTable
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .labelContext @ =:: labelContext
  idContext [] .typeContext @ =:: typeContext
  ValType : valType
  i64 : tmpId
  labels labelCmp @ context list.sort
  sb
    "## switch\n" sb.appendS
    switchType typeContext types.isEnum if
      ## loadEnumLabel
        switchType
        valId
        pos
      context loadEnumLabel valType = tmpId =
    else switchType typeContext types.isInt _if
      switchType typeContext types.numberSize =:: numSize
      context nextTmpId tmpId =
      switchType context toValType valType =
      "%t" sb.appendS
      tmpId sb.appendI
      " =" sb.appendS
      valType sb.appendValTypeQBE
      numSize types.primitive.I32 typeContext types.numberSize < if
        " ext" sb.appendS
        switchType
          StorageType .ULOAD
        pos context sb.appendTypeNameQBE
        " %s" sb.appendS
      else
        " copy %s" sb.appendS
      end
      valId sb.appendI
      '\n' sb.appendC
    else
      "unsupported type in switch: " sb.wrap
        switchType labelContext typeContext sb.appendType
      pos errors appendError
      return
    end
    ## appendJumpTable
      valType
      tmpId
      switchId
      labels list.asArray
      i64 optional.empty
      i64 optional.empty
      context
    appendSwitchJumpTree
  return
end

proc(
  stringBuilder : sb
  Type : src
  i64 : srcIndex
  Type : target
  i64 : targetIndex
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: castNumbers
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .labelContext @ =:: labelContext
  idContext [] .typeContext @ =:: typeContext
  src typeContext types.primitiveValue =:: fromVal
  target typeContext types.primitiveValue =:: toVal
  fromVal toVal == if
    sb return ## no cast necessary
  end
  sb
    ## common prefix
    pos sb.appendPosQBE
    "%s" sb.appendS
    targetIndex sb.appendI
    ## case 1: integer extension/narrowing
    src typeContext types.isInt target typeContext types.isInt & if
      src typeContext types.numberPrecision =:: srcPrec
      target typeContext types.numberPrecision =:: targetPrec
      targetPrec srcPrec <= if
        " =" sb.appendS
        target StorageType .STACK pos context sb.appendTypeNameQBE
        " copy" sb.appendS
      else
        " =" sb.appendS
        target StorageType .STACK pos context sb.appendTypeNameQBE
        " exts" sb.appendS
        fromVal switch
          BOOL TYPE FLOAT32 FLOAT64 case break
          I8  case "b" sb.appendS break
          I16 case "h" sb.appendS break
          I32 case "w" sb.appendS break
          I64 case "l" sb.appendS break
        end
      end
    ## case 2: float -> float/int
    else fromVal .FLOAT32 ?? fromVal .FLOAT64 ?? | _if
      toVal switch
        BOOL TYPE case break
        FLOAT32 case
          " =d exts" sb.appendS break
        FLOAT64 case
          " =s truncd" sb.appendS break
        I8 I16 I32 I64 case
          " =" sb.appendS
          target StorageType .STACK pos context sb.appendTypeNameQBE
          fromVal .FLOAT32 ?? if
            " stosi" sb.appendS
          else
            " dtosi" sb.appendS
          end
          break
      end
    ## case 3: int -> float
    else fromVal .I64 ?? _if
      " =l sltof" sb.appendS
    else
      " =w swtof" sb.appendS
    end
    " %s" sb.appendS
    srcIndex sb.appendI
    '\n' sb.appendC
  return
end

proc(
  stringBuilder : sb
  bool : autoCast
  Type : src
  i32 : offset
  Type : target
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: compileCast
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .labelContext @ =:: labelContext
  idContext [] .typeContext @ =:: typeContext
  autoCast if
    offset context [] .stackInfo branchTree.depth >= if
      "stack underflow" sb.wrap
      pos errors appendError
      sb return
    end
    context [] .stackInfo @ offset branchTree.at .data [] .valType
    context [] .stackInfo @ offset branchTree.at .data [] .varId
  else
    context [] .stackInfo @ offset branchTree.at .data [] .valType
    context popValue
  end =:: srcId =:: valType
  autoCast if
    target context toValType offset context replaceValue
  else
    target context toValType context pushValue
  end =:: targetId
  src typeContext types.isNumber target typeContext types.unwrapNamed .arrayIndex ?? & if
    ## isNumber returns true for array index
    ##   -> have to check for cast to array index before checking for cast to number
    sb
      ## castNumbers
        src
        srcId
        types.primitive.I_SIZE
        targetId
      pos context castNumbers
      target typeContext types.getArraySize 0 array.get targetId pos context appendIndexCheck
    return
  end
  src typeContext types.isNumber target typeContext types.isNumber & if
    sb src srcId target targetId pos context castNumbers return
  end
  src typeContext types.isPointer target typeContext types.isPointer & if
    sb
      "%s" sb.appendS
      targetId sb.appendI
      " =l copy %s" sb.appendS
      srcId sb.appendI
      '\n' sb.appendC
    return ## both are pointer types
  end
  src typeContext types.isInt target typeContext types.isPointer & if
    ## src -> I_PTR ~ ptr
    sb
      ## castNumbers
        src
        srcId
        types.primitive.I_PTR
        targetId
      pos context castNumbers
    return
  end
  src typeContext types.isPointer target typeContext types.isInt & if
    ## ptr ~ I_PTR -> target
    sb
      ## castNumbers
        types.primitive.I_PTR
        srcId
        target
        targetId
      pos context castNumbers
    return
  end
  src typeContext types.isReference if target typeContext types.isReference ! _if
    src typeContext types.getBaseType typeContext types.unwrapNamed =:: baseType
    baseType context referenceOnly ! if
      sb
        ## unwrap reference
        valType .REFERENCE ?? if
          pos sb.appendPosQBE
          "%s" sb.appendS
          targetId sb.appendI
          " =" sb.appendS
          baseType StorageType .STACK pos context sb.appendTypeNameQBE
          " load" sb.appendS
          baseType StorageType .LOAD pos context sb.appendTypeNameQBE
          " %s" sb.appendS
          srcId sb.appendI
          '\n' sb.appendC
        end
        ## cast value
        baseType target typeContext types.unwrapNamed types.typeEquals ! if
          ## compileCast
            autoCast
            baseType
            offset
            target
            pos
            context
          compileCast
        end
      return
    end
  end
  "casting from " sb.wrap
    src labelContext typeContext sb.appendType
    " to " sb.appendS
    target labelContext typeContext sb.appendType
    " is not implemented" sb.appendS
  pos errors appendError
  sb return
end

proc(
  stringBuilder : sb
  Operation ptr : op
  CompilerContext ptr mut : context
-> stringBuilder ) =>: compileOp
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .labelContext @ =:: labelContext
  idContext [] .typeContext @ =:: typeContext
  op [] .val switch
    NOP case
      sb return
    Constant case
      sb
        op [] .pos sb.appendPosQBE
        "%s" sb.appendS
        op [] .dataType context referenceOnly ! if
          op [] .dataType context toValType context pushValue sb.appendI
          " =" sb.appendS
          op [] .dataType StorageType .STACK op [] .pos context sb.appendTypeNameQBE
          " copy " sb.appendS
        else
          ValType .REFERENCE context pushValue sb.appendI
          " =l copy " sb.appendS
        end
        op [] .dataType op [] .val .Constant false op [] .pos context sb.appendConstQBE
        '\n' sb.appendC
      return
    declareId initializeId case
      op [] .val .declareId ?? if
        op [] .val .declareId
      else
        op [] .val .initializeId
      end =:: idInfo
      op [] .val .initializeId ?? =:: assignValue
      idInfo .labelId labelContext id.labelFlags =:: labelFlags
      labelFlags id.FLAG_MUTABLE & ? =:: mutable
      idInfo .idType switch
        PROCEDURE case
          assignValue ! if
            sb return
          end
          ## reset stack-info in context
          0 context [] .stackCount =
          0 context [] .tmpCount =
          0 context [] .jumpLabelCount =
          context [] .stackInfo @ branchTree.clear
          sb
            labelFlags id.FLAG_EXPORT & ? labelFlags id.FLAG_EXTERN & ? | if
              "export " sb.appendS
            end
            "function " sb.appendS
            op [] .dataType typeContext types.getProcRet if ..drop
              "wrong type for procedure initialization: " sb.wrap
                op [] .dataType labelContext typeContext sb.appendType
                " expected procedure" sb.appendS
              op [] .pos errors appendError
              return
            end =:: retType
            retType typeContext types.isEmpty ! if
              retType StorageType .LOAD op [] .pos context sb.appendTypeNameQBE
              ' ' sb.appendC
            end
            idInfo .labelId context sb.appendGlobalName
            op [] .dataType op [] .pos context sb.appendProcArgs
            "{\n" sb.appendS
            ## BranchId
              BranchType .START
              0 0
            BranchId new context startBranch
            ## push unnamed arguments
            op [] .dataType typeContext types.getProcIn ..drop =:: inType
            inType typeContext types.compositeElts =:: args
            0 while ..dup args .length < do =:: i
              inType i typeContext types.compositeGetLabel =:: label
              args i types.compositeElts.get =:: argType
              label id.LABEL_ID_NONE == if ## push argument
                argType context referenceOnly if
                  ValType .REFERENCE
                else
                  argType context toValType
                end =:: valType
                "%s" sb.appendS
                valType context pushValue sb.appendI
                " =" sb.appendS
                valType sb.appendValTypeQBE
                " copy " sb.appendS
                i id.LABEL_ID_NONE context sb.appendArgName
                '\n' sb.appendC
              end
              i 1 +
            end ..drop
            true context [] .reachable =
          return
        LOCAL_VAR TMP_VAR case
          op [] .dataType =:: valType
          ## use pointers as stack representation of arrays and composites
          valType context referenceOnly ! =:: isValue
          sb
            op [] .pos sb.appendPosQBE
            idInfo .idType .LOCAL_VAR ?? if
              "%l" sb.appendS
              idInfo .labelId sb.appendI
            else
              "%tmp" sb.appendS
              idInfo .id sb.appendI
            end
            valType context false appendAlloc ..drop
            assignValue if
              isValue if
                "store" sb.appendS
                valType StorageType .STORE op [] .pos context sb.appendTypeNameQBE
              else
                "blit" sb.appendS ## XXX call memcopy for large structs
              end
              " %s" sb.appendS
              context popValue sb.appendI
              ',' sb.appendC
              idInfo .idType .LOCAL_VAR ?? if
                "%l" sb.appendS
                idInfo .labelId sb.appendI
              else
                "%tmp" sb.appendS
                idInfo .id sb.appendI
              end
              isValue ! if
                ',' sb.appendC
                op [] .dataType typeContext types.sizeOf sb.appendI
              end
              '\n' sb.appendC
            end
          return
        GLOBAL_VAR TYPE ARGUMENT TEMPLATE_ARG LABEL case
          break ## XXX error message
      end
      break
    getId @Id case
      op [] .val .getId ?? if
        op [] .val .getId
      else
        op [] .val .@Id
      end =:: idInfo
      op [] .val .@Id ?? =:: isAddr
      idInfo .idType switch
        PROCEDURE GLOBAL_VAR case
          isAddr ! if idInfo .idType .PROCEDURE ?? _if
            break ## TODO call
          end
          sb
            op [] .pos sb.appendPosQBE
            "%s" sb.appendS
            isAddr if ValType .PTR else ValType .REFERENCE end context pushValue sb.appendI
            " =l copy " sb.appendS
            idInfo .labelId context sb.appendGlobalName
            "\n" sb.appendS
          return
        LOCAL_VAR case
          sb
            op [] .pos sb.appendPosQBE
            "%s" sb.appendS
            isAddr if ValType .PTR else ValType .REFERENCE end context pushValue sb.appendI
            " =l copy %l" sb.appendS
            idInfo .labelId sb.appendI
            '\n' sb.appendC
          return
        TMP_VAR case
          sb
            op [] .pos sb.appendPosQBE
            "%s" sb.appendS
            isAddr if ValType .PTR else ValType .REFERENCE end context pushValue sb.appendI
            " =l copy %tmp" sb.appendS
            idInfo .id sb.appendI
            '\n' sb.appendC
          return
       ARGUMENT case
          isAddr if op [] .dataType context referenceOnly ! _if
            "cannot take the address of procedure argument" sb.wrap
            op [] .pos errors appendError
            sb return
          end
          op [] .dataType context referenceOnly if
            ValType .REFERENCE
          else
            op [] .dataType context toValType
          end =:: valType
          sb
            op [] .pos sb.appendPosQBE
            "%s" sb.appendS
            valType context pushValue sb.appendI
            " =" sb.appendS
            valType sb.appendValTypeQBE
            " copy " sb.appendS
            idInfo .id idInfo .labelId context sb.appendArgName
            '\n' sb.appendC
          return
       TYPE TEMPLATE_ARG LABEL case
          break ## XXX error message
      end
      break
    setValue case
      context popValue =:: targetId
      context popValue =:: valId
      op [] .dataType =:: valType
      sb
        op [] .pos sb.appendPosQBE
        valType context referenceOnly if
          "blit %s" sb.appendS
        else
          "store" sb.appendS
          valType StorageType .STORE op [] .pos context sb.appendTypeNameQBE
          " %s" sb.appendS
        end
        valId sb.appendI
        ", %s" sb.appendS
        targetId sb.appendI
        valType context referenceOnly if
          ',' sb.appendC
          valType typeContext types.sizeOf sb.appendI
        end
        '\n' sb.appendC
      return
    getArrayElement @ArrayElement case
      op [] .val .getArrayElement ?? if
        op [] .val .getArrayElement
      else
        op [] .val .@ArrayElement
      end =:: mut argCount
      op [] .val .@ArrayElement ?? =:: isAddr
      op [] .dataType =:: mut arrayType
      arrayType typeContext types.isPointer =:: mut isPtr
      arrayType typeContext types.isReference if
        arrayType typeContext types.getBaseType arrayType =
        true isPtr =
      end
      arrayType typeContext types.getArraySize =:: sizes
      sizes .length
        arrayType typeContext types.isFixedSize if 2 - else 1 - end
      =:: mut sizeOffset
      context nextTmpId =:: mut offsetId
      offsetId =:: mut prevId
      sb
        op [] .pos sb.appendPosQBE
        "%t" sb.appendS
        offsetId sb.appendI
        argCount 0 == if
          " =l copy 0" sb.appendS
        else
          argCount 1 - argCount =
          " =l copy %s" sb.appendS
          context popValue sb.appendI
        end
        '\n' sb.appendC
        while sizeOffset 0 >= do
          sizes sizeOffset array.get =:: size
          sizeOffset 1 - sizeOffset =
          size .sizeType .int ?? ! if
            "unsupported size type for array element" sb.wrap
              size sb.appendArraySize
            op [] .pos errors appendError
          end
          offsetId prevId =
          context nextTmpId offsetId =
          "%t" sb.appendS
          offsetId sb.appendI
          " =l mul %t" sb.appendS
          prevId sb.appendI
          ", " sb.appendS
          size .value sb.appendI
          '\n' sb.appendC
          argCount 0 > if
            offsetId prevId =
            context nextTmpId offsetId =
            argCount 1 - argCount =
            "%t" sb.appendS
            offsetId sb.appendI
            " =l add %t" sb.appendS
            prevId sb.appendI
            ", %s" sb.appendS
            context popValue sb.appendI
            '\n' sb.appendC
          end
        end
        context popValue =:: srcId
        "%s" sb.appendS
        isAddr if ValType .PTR else ValType .REFERENCE end context pushValue sb.appendI
        " =l add %s" sb.appendS
        srcId sb.appendI
        ", %t" sb.appendS
        offsetId sb.appendI
        '\n' sb.appendC
      return
    getElement @Element case
      op [] .val .getElement ?? if
        op [] .val .getElement
      else
        op [] .val .@Element
      end =:: index
      op [] .val .@Element ?? =:: isAddr
      op [] .dataType =:: mut containerType
      false =:: mut isPtr
      containerType typeContext types.isPointer
      containerType typeContext types.isReference | if
        containerType typeContext types.getBaseType containerType =
        true isPtr =
      end
      isAddr if ValType .PTR else ValType .REFERENCE end =:: valType
      context popValue =:: srcId
      isPtr if
        containerType typeContext types.isUnion
        containerType typeContext types.isEnum | if
          sb
            op [] .pos sb.appendPosQBE
            "%s" sb.appendS
            valType context pushValue sb.appendI
            " =l copy %s" sb.appendS ## union/enum element access does not change pointer
            srcId sb.appendI
            '\n' sb.appendC
          return
        else containerType typeContext types.isTuple _if
          sb
            op [] .pos sb.appendPosQBE
            "%s" sb.appendS
            valType context pushValue sb.appendI
            " =l add %s" sb.appendS ## union/enum element access does not change pointer
            srcId sb.appendI
            "," sb.appendS
            containerType index typeContext types.tupleElementOffset sb.appendI
            '\n' sb.appendC
          return
        end
      end
      break
    copy case
      op [] .dataType =:: srcType
      srcType typeContext types.isReference ! if
        break ## copy only implemented for references
      end
      srcType typeContext types.getBaseType =:: baseType
      baseType context referenceOnly ! if
        context [] .stackInfo @ branchTree.peek =:: srcVal?
        srcVal? optional.isEmpty if
          "stack underflow" sb.wrap
          op [] .pos errors appendError
          sb return
        end
        srcVal? .data =:: srcVal
        srcVal [] .valType .REFERENCE ?? ! if
          sb return ## value is not a reference -> no copy necessary
        end
        context popValue =:: srcId
        sb
          op [] .pos sb.appendPosQBE
          "%s" sb.appendS
          baseType context toValType context pushValue sb.appendI
          " =" sb.appendS
          baseType StorageType .STACK op [] .pos context sb.appendTypeNameQBE
          " load" sb.appendS
          baseType StorageType .LOAD op [] .pos context sb.appendTypeNameQBE
          " %s" sb.appendS
          srcId sb.appendI
          '\n' sb.appendC
        return
      end
      sb
        op [] .pos sb.appendPosQBE
        ## prepare memory
        baseType context true appendAlloc =:: dataPtrId
        "blit %s" sb.appendS
        context popValue sb.appendI
        ", %t" sb.appendS
        dataPtrId sb.appendI
        ", " sb.appendS
        baseType typeContext types.sizeOf sb.appendI
        "\n%s" sb.appendS
        ValType .REFERENCE context pushValue sb.appendI
        " =l copy %t" sb.appendS
        dataPtrId sb.appendI
        '\n' sb.appendC
      return
    New newEnum case
      sb
        op [] .pos sb.appendPosQBE
        ## prepare memory
        op [] .dataType context true appendAlloc =:: dataPtrId
        op [] .val .newEnum ?? if ## TODO store enums without values as integer
          op [] .dataType typeContext types.enumLabelInfo =:: labelOffset =:: labelType
          op [] .val .newEnum =:: index
          op [] .dataType index typeContext types.compositeGetElement =:: eltType
          "%t" sb.appendS
            context nextTmpId =:: labelPtrId
          labelPtrId sb.appendI
          " =l add %t" sb.appendS
          dataPtrId sb.appendI
          ", " sb.appendS
          labelOffset sb.appendI
          "\nstore" sb.appendS
          labelType StorageType .STORE op [] .pos context sb.appendTypeNameQBE
          ' ' sb.appendC
          index sb.appendI
          ", %t" sb.appendS
          labelPtrId sb.appendI
          '\n' sb.appendC
          eltType typeContext types.isEmpty ! if
            eltType context referenceOnly if
              "blit %s" sb.appendS
            else
              "store" sb.appendS
              eltType StorageType .STORE op [] .pos context sb.appendTypeNameQBE
              " %s" sb.appendS
            end
            context popValue sb.appendI
            ", %t" sb.appendS
            dataPtrId sb.appendI
            eltType context referenceOnly if
              ',' sb.appendC
              eltType typeContext types.sizeOf sb.appendI
            end
            '\n' sb.appendC
          end
        else op [] .dataType typeContext types.isTuple _if
          op [] .dataType dataPtrId op [] .pos context initializeTupleQBE
        else op [] .dataType typeContext types.isArray ! _if
          "unsupported type for new:" sb.wrap
            op [] .dataType
              labelContext
              typeContext
            sb.appendType
          op [] .pos errors appendError
          return
        end
        "%s" sb.appendS
        ValType .REFERENCE context pushValue sb.appendI
        " =l copy %t" sb.appendS
        dataPtrId sb.appendI
        '\n' sb.appendC
      return
    checkEnumLabel case
      context [] .stackInfo @ branchTree.peek =:: srcVal?
      srcVal? optional.isEmpty if
        "stack underflow" sb.wrap
        op [] .pos errors appendError
        sb return
      end
      sb
        op [] .pos sb.appendPosQBE
        ## appendEnumCheck
          op [] .dataType
          srcVal? .data [] .varId
          op [] .val .checkEnumLabel
          op [] .pos
          context
        appendEnumCheck
      return
    hasElement case
      op [] .dataType
        ..dup typeContext types.isReference if
           typeContext types.getBaseType
        end
      =:: containerType
      containerType typeContext types.isEnum ! if
        break
      end
      context popValue =:: srcId
      sb
        op [] .pos sb.appendPosQBE
        containerType srcId op [] .val .hasElement op [] .pos context checkEnumIndex ..drop =:: c
        "%s" sb.appendS
        ValType .I32 context pushValue sb.appendI
        " =w copy %t" sb.appendS
        c sb.appendI
        '\n' sb.appendC
      return
    autoCast case
      sb
        op [] .pos sb.appendPosQBE
        true
        op [] .val .autoCast .src
        op [] .val .autoCast .offset
        op [] .dataType
        op [] .pos
        context
      compileCast return
      break
    Cast Cast! case ## XXX? make cast! bit-cast
      sb
        op [] .pos sb.appendPosQBE
        false
        op [] .val .Cast! ?? if
          op [] .val .Cast!
        else
          op [] .val .Cast
        end
        0 ## no offset
        op [] .dataType
        op [] .pos
        context
      compileCast return
      break
    block case
      op [] .val .block .blockType switch
        IF case
          ## BranchId
            BranchType .IF
            op [] .val .block .blockId
            0
          BranchId new =:: ifBranch
          sb
            op [] .pos sb.appendPosQBE
            "jnz $s" sb.appendS
            context popValue sb.appendI
            ", " sb.appendS
            ifBranch sb.appendBranchId
            ", " sb.appendS
            ## appendBranchId
              BranchType .ELSE
              op [] .val .block .blockId
              0
            BranchId new sb.appendBranchId
            '\n' sb.appendC
            context [] .stackInfo @ branchTree.startBranch =:: branchRoot
            op [] .val .block .blockId branchRoot context openIfBlock
            ifBranch context startBranch
          return
        IFIF case
          context [] .openBlocks list.peek .data =:: ifBlock
          ## appendBranchId
            BranchType .NEXT
            context nextJumpLabelId
            0
          BranchId new =:: ifBranch
          sb
            op [] .pos sb.appendPosQBE
            "jnz $s" sb.appendS
            context popValue sb.appendI
            ", " sb.appendS
            ifBranch sb.appendBranchId
            ", " sb.appendS
            ## appendBranchId
              BranchType .ELSE
              op [] .val .block .blockId
              0
            BranchId new sb.appendBranchId
            '\n' sb.appendC
            ifBlock [] .If .ififBranches
              context [] .stackInfo .branchHead list.append
            ifBlock [] .If .ififBranches =
            ifBlock [] .If .ififBranchIds
              context [] .currentBranch list.append
            ifBlock [] .If .ififBranchIds =
            ifBranch context startBranch
          return
        ELSE case
          context [] .openBlocks list.peek .data =:: ifBlock
          context [] .stackInfo @ ifBlock [] .If .branchRoot branchTree.reset =:: ifBranch
          context [] .reachable ifBlock [] .If .ifBranchTerminates =
          ## BranchPoint
          ifBranch ifBlock [] .If .ifBranch =
          context [] .currentBranch ifBlock [] .If .ifBranchId =
          sb
            ## don't add position for labels
            context [] .reachable if
              "jmp " sb.appendS
              ## appendBranchId
                BranchType .END_IF
                op [] .val .block .blockId
                0
              BranchId new sb.appendBranchId
              '\n' sb.appendC
            end
            ## startBranch
              ## BranchId
                BranchType .ELSE
                op [] .val .block .blockId
                0
              BranchId new
              context
            startBranch
            true context [] .reachable =
          =:: mut newSb
          ifBlock [] .If .ififBranches .length 1 > if
            ## mergeValues
              context [] .stackInfo @
              ifBlock [] .If .ififBranches list.asArray
              false ## keep branches active
              mergeBranches @
              ## MergePoint
                "if _if" string.wrap
                ifBlock [] .If .blockId
                ifBlock [] .If .ififBranchIds list.asArray
                op [] .pos
                context
                newSb @
              MergePoint new
            branchTree.merge if
              "could not merge if _if branches" sb.wrap
              op [] .pos errors appendError
            end
          end
          newSb return
        SWITCH case
          op [] .val .block .blockId =:: switchId
          prog [] .switchData
            switchId list.at .data
          =:: switchData
          sb
            op [] .pos sb.appendPosQBE
            ## appendSwitchTable
              switchData [] .switchType
              context popValue
              switchId
              switchData [] .labels
              op [] .pos
              context
            appendSwitchTable
            context [] .stackInfo @ branchTree.startBranch =:: branchRoot
            switchId branchRoot context openSwitchBlock
            false context [] .reachable =
          return
        CASE case
            sb
              ## don't add position before label
              op [] .val .block .blockId =:: switchId
              ## BranchId
                BranchType .CASE
                switchId
                op [] .val .block .subId
              BranchId new context startBranch
              true context [] .reachable =
            return
        DEFAULT case
            sb
              ## don't add position before label
              op [] .val .block .blockId =:: switchId
              ## BranchId
                BranchType .DEFAULT
                switchId
                0
              BranchId new context startBranch
              true context [] .reachable =
            return
        BREAK_SWITCH case
            ## findBreakableBlock
              BlockType .BREAK_SWITCH
              op [] .pos
              context
            findBreakableBlock =:: breakBlock?
            breakBlock? optional.isEmpty if
              ## error message handled by findBreakableBlock
              sb return
            end
            breakBlock? .data =:: breakBlock
            breakBlock [] .Switch ?? ! if
              "unexpected block for " sb.wrap
                BlockType .BREAK_SWITCH sb.appendBlockType
                ## XXX append type of broken block
              op [] .pos errors appendError
            end
            ## remember break (if reachable)
            context [] .reachable if
              breakBlock [] .Switch .caseBranches
                context [] .stackInfo @
                  breakBlock [] .Switch .branchRoot
                branchTree.reset list.append
              breakBlock [] .Switch .caseBranches =
              breakBlock [] .Switch .caseBranchIds
                context [] .currentBranch list.append
              breakBlock [] .Switch .caseBranchIds =
            end
            sb
              context [] .reachable if
                ## don't add jump in unreachable branches
                op [] .pos sb.appendPosQBE
                "jmp " sb.appendS
                ## BlockId
                  BranchType .END_SWITCH
                  breakBlock [] .Switch .blockId
                  0
                BranchId new sb.appendBranchId
                '\n' sb.appendC
              end
              false context [] .reachable =
            return
          break
        WHILE DO case
          break
        UNKNOWN BREAK CONTINUE INITIALIZER NAMESPACE PROCEDURE EXPERIMENTAL_PROCEDURE
        TYPE_TUPLE TYPE_STRUCT TYPE_ENUM TYPE_UNION TYPE_PROC_IN TYPE_PROC_OUT TYPE_COMPOSITE case
          ## XXX error message
          break
      end
      break
    blockEnd case
      op [] .val .blockEnd .blockType switch
        PROCEDURE EXPERIMENTAL_PROCEDURE case
          sb
            "}\n" sb.appendS
            context sb.appendLocalConstants
          return
        ELSE case
          context [] .openBlocks
            list.pop .If =:: ifBlock
          context [] .openBlocks =
          branchTree.NodeId 2 array new =:: mut branches
          BranchId 2 array new =:: mut branchIds
          0 =:: mut nBranches
          ifBlock .ifBranchTerminates if
            ifBlock .ifBranch branches @ nBranches [] =
            ifBlock .ifBranchId branchIds @ nBranches [] =
            nBranches 1 + nBranches =
          end
          context [] .reachable if
            context [] .stackInfo .branchHead branches @ nBranches [] =
            context [] .currentBranch branchIds @ nBranches [] =
            nBranches 1 + nBranches =
          else ifBlock .ifBranchTerminates _if
            context [] .stackInfo @
              ifBlock .ifBranch
            branchTree.reset ..drop
          end
          sb
            ## don't add position for labels
            ## startBranch
              ## BranchId
                BranchType .END_IF
                op [] .val .blockEnd .blockId
                0
              BranchId new
              context
            startBranch
          =:: mut newSb
          nBranches 1 > if
            ## mergeValues
              context [] .stackInfo @
              branches @ nBranches array.create
              true
              mergeBranches @
              ## MergeIf
                "if" string.wrap
                ifBlock .blockId
                branchIds @ nBranches array.create
                op [] .pos
                context
                newSb @
              MergePoint new
            branchTree.merge if
              "could not merge branches of if-else block" sb.wrap
              op [] .pos errors appendError
            end
          end
          nBranches 0 > context [] .reachable =
          ifBlock .ififBranches list.free ..drop
          newSb return
        IFIF case sb return ## no-op
        SWITCH case
          context [] .openBlocks
            list.pop .Switch =:: switchBlock
          context [] .openBlocks =
          switchBlock .caseBranches =:: caseBranches
          caseBranches .length 0 > context [] .reachable =
          sb
            ## don't add position for labels
            ## startBranch
              ## BranchId
                BranchType .END_SWITCH
                op [] .val .blockEnd .blockId
                0
              BranchId new
              context
            startBranch
          =:: mut newSb
          caseBranches .length 1 >= if
            context [] .stackInfo @
              caseBranches 0 list.at .data []
            branchTree.reset ..drop
          end
          caseBranches .length 1 > if
            caseBranches .length =:: nodeCount
            ## mergeValues
              context [] .stackInfo @
              caseBranches list.asArray
              true
              mergeBranches @
              ## MergePoint
                "switch" string.wrap
                switchBlock .blockId
                switchBlock .caseBranchIds list.asArray
                op [] .pos
                context
                newSb @
              MergePoint new
            branchTree.merge if
              "could not merge branches of switch-case block" sb.wrap
              op [] .pos errors appendError
            end
          end
          caseBranches .length 0 > context [] .reachable =
          caseBranches list.free ..drop
          newSb return
        WHILE DO case
          break
        UNKNOWN CASE DEFAULT BREAK BREAK_SWITCH CONTINUE INITIALIZER IF NAMESPACE
        TYPE_TUPLE TYPE_STRUCT TYPE_ENUM TYPE_UNION TYPE_PROC_IN TYPE_PROC_OUT TYPE_COMPOSITE case
          ## XXX error message
          break
      end
      break
    Return case
      op [] .dataType typeContext types.isProcedure ! if
        "unexpected type for return: " sb.wrap
          op [] .dataType labelContext typeContext sb.appendType
          " expected procedure" sb.appendS
        op [] .pos errors appendError
        sb return
      end
      op [] .dataType typeContext types.getProcRet ..drop =:: retType
      sb
        op [] .pos sb.appendPosQBE
        op [] .dataType typeContext types.getCallConvention ..drop switch
          STRUCT case break ## no changes needed
          POINTER case
            op [] .dataType typeContext types.getProcOut ..drop =:: outType
            outType typeContext types.compositeEltCount
              i32 cast
              retType typeContext types.isEmpty ! if 1 - end
            =:: N
            N 0 == if break end
            outType typeContext types.compositeElts =:: outTypes
            N 1 - while ..dup 0 >= do =:: i
              outTypes i types.compositeElts.get =:: elt
              elt typeContext types.isEmpty if
                i 1 - continue
              end
              elt context referenceOnly if
                "blit" sb.appendS
              else
                "store" sb.appendS
                elt StorageType .STORE op [] .pos context sb.appendTypeNameQBE
              end
              " %s" sb.appendS
              context popValue sb.appendI
              ", " sb.appendS
              i outType i typeContext types.compositeGetLabel context sb.appendOutArgName
              '\n' sb.appendC
            i 1 -
            end ..drop
            break
        end
        retType typeContext types.isProcOut if
          retType typeContext types.compositeEltCount
        else retType typeContext types.isEmpty _if 0i64 else 1i64 end =:: retCount
      false context [] .reachable =
      retCount 0 == if
        "ret\n" sb.appendS
        return
      end
      retCount 1 == if
        "ret %s" sb.appendS
        context popValue sb.appendI
        '\n' sb.appendC
        return
      end
      retType context true appendAlloc =:: retId
      retType retId op [] .pos context initializeTupleQBE
        "ret %t" sb.appendS
        retId sb.appendI
        '\n' sb.appendC
      return
    unreachable case
      false context [] .reachable =
      sb
        op [] .pos sb.appendPosQBE
        "## unreachable\n" sb.appendS
        "hlt\n" sb.appendS
      return
    stackMod case
      op [] .val .stackMod .modType switch
        DROP case
          op [] .val .stackMod .n =:: count
          count while ..dup 0 > do 1 -
             context [] .stackInfo @ branchTree.pop ..drop
          end ..drop
          sb return
        COPY case
          op [] .val .stackMod .n =:: offset
          ## copy value on stack
          context [] .stackInfo @
            offset
          branchTree.at .data =:: copied
          context [] .stackInfo @
            copied []
          branchTree.push
          sb return
        SWAP case
          context [] .stackInfo @ branchTree.swap
          sb return
      end
      break
    setId autoTypedInitializeId
    setElement setArrayElement Print call callPtr
    argc getArg getArgLen unaryOperator binaryOperator
    setEnumLabel checkArrayIndex typeInfo
    compilerInfo getName setName @Name getLabel setLabel @Label length size typeModifier hasLabel hasName case
      break ## XXX error message
  end
  "unable to compile operation " sb.wrap
    op [] constContext labelContext typeContext sb.appendOp
  op [] .pos errors appendError
  sb return
end

proc( io.FILE : target ProgramContext ptr mut : prog -> ) =>: export compileToQBE
  prog [] .idContext @ =:: idContext
  idContext [] .labelContext @ =:: labelContext
  idContext [] .typeContext @ =:: typeContext
  ## CompilerContext
    prog
    StackElement branchTree.create
    BranchType .START 0 0 BranchId new
    32 BlockInfo list.create
    32 LocalConst list.create
    0
    0
    0
    0
    true
  CompilerContext new =:: mut contextData ## TODO cleanup context
  contextData @ =:: context
  id.LABEL_ID_NONE =:: mut mainId
  MAIN_NAME string.wrap 0 idContext id.getIdentifierByName ! if =:: data =:: name
    name .namespace 0 != if
      ..unreachable ## assert that namespace is always top level
    end
    data [] .labelId mainId =
  else ..drop.2 end
  ## TODO declare composite types
  prog [] .hasCheckIndex if
    128 sb.create
      "data $" sb.appendS
      CHECK_INDEX_FORMAT sb.appendS
      " = { b \"index out of range: %lli size: %llu at %.*s:%i:%i\\n\", b 0 }\n" sb.appendS
      target ..over io.fputSb ..drop
    sb.free ..drop
  end
  prog [] .hasCheckEnum if
    128 sb.create
      "data $" sb.appendS
      CHECK_ENUM_FORMAT sb.appendS
      " = { b \"enum index (%i) does not match current value (%u) at %.*s:%i:%i\\n\", b 0 }\n" sb.appendS
      target ..over io.fputSb ..drop
    sb.free ..drop
  end
  prog [] .idContext .globalScope .identifiers @ map.itr.start while map.itr.hasNext do map.itr.next
    =:: declaration ## TODO find out which declarations are actually used
    declaration .1 =:: idData
    idData [] .valueType =:: mut valType
    idData [] .labelId =:: labelId
    labelId labelContext id.labelFlags =:: labelFlags
    valType types.isAutoType if
      prog [] .autoTypes
        valType types.getTypeId
      list.at .data []
      valType =
    end
    valType types.primitive.TYPE types.typeEquals
    valType typeContext types.isEmpty |
    valType typeContext types.isProcedure | if
      continue
    end
    128 sb.create
      labelFlags id.FLAG_EXPORT & ? if
        "export " sb.appendS
      end
      "data " sb.appendS
      labelId context sb.appendGlobalName
      " = align " sb.appendS
      valType typeContext types.alignOf sb.appendI
      " {" sb.appendS
      idData [] .constValue ConstValue .none != if
        valType idData [] .constValue true idData [] .declaredAt context sb.appendConstQBE
      else
        "z " sb.appendS
        valType typeContext types.sizeOf sb.appendI
      end
      "}\n" sb.appendS
      target ..over io.fputSb ..drop
    sb.free ..drop
  end ..drop
  0 while ..dup prog [] .progFiles .length < do =:: i
    prog [] .progFiles i list.at .data =:: f
    1024 sb.create
      "dbgfile \"" sb.appendS
      f [] .fileName sb.appendSb
      "\"\n"    sb.appendS
      "data $" sb.appendS
      FILE_NAME_NAME sb.appendS
      i sb.appendI
      " = {" sb.appendS
        f [] .fileName
          list.asArray labelContext id.wrapStringConstant
          context
        sb.appendStringConstQBE
      "} \n" sb.appendS
      0 while ..dup f [] .localOps .length < do
        ..swap
        f [] .localOps ..over.2 list.at .data context compileOp
        ..swap 1 +
      end ..drop
      target ..over io.fputSb ..drop
    sb.free ..drop
    i 1 +
  end ..drop
  context [] .stackInfo @ branchTree.free
  context [] .localConstants list.free ..drop
  mainId id.LABEL_ID_NONE == if ## no main
    return
  end
  128 sb.create
    prog [] .hasGetArgs if
        "data $" sb.appendS
        CONCAT_ARGC_NAME sb.appendS
        " = { l 0 }" sb.appendS
        "data $" sb.appendS
        CONCAT_ARGV_NAME sb.appendS
        " = { l 0 }" sb.appendS
        "data $" sb.appendS
        CONCAT_ENVP_NAME sb.appendS
        " = { l 0 }" sb.appendS
        "export function w $main(l %argc,l %argv,l %envp){\n@start\n" sb.appendS
        "storel %argc,$" sb.appendS
        CONCAT_ARGC_NAME sb.appendS
        '\n' sb.appendC
        "storel %argv,$" sb.appendS
        CONCAT_ARGV_NAME sb.appendS
        '\n' sb.appendC
        "storel %envp,$" sb.appendS
        CONCAT_ENVP_NAME sb.appendS
        '\n' sb.appendC
        "call " sb.appendS
    else
      "export function w $main(){\n@start\ncall " sb.appendS
    end
    mainId context sb.appendGlobalName
    "()\nret 0\n}\n" sb.appendS
    target ..over io.fputSb ..drop
  sb.free ..drop
end
