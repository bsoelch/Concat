import stringIO
import numbers/float

import "program.concat"
import "measure.concat"
import "branchTree.concat"

## XXX make prefix customizable
"cct_" =:: CONCAT_PREFIX
"cctI_argc" =:: CONCAT_ARGC_NAME
"cctI_argv" =:: CONCAT_ARGV_NAME
"cctI_envp" =:: CONCAT_ENVP_NAME
"localConstant" =:: LOCAL_CONST_NAME
"stringConstant" =:: STRING_CONST_NAME
"checkIndexFormat" =:: CHECK_INDEX_FORMAT
"checkEnumFormat" =:: CHECK_ENUM_FORMAT
"fileName" =:: FILE_NAME_NAME

enum(
  START
  NEXT
  ERROR
  IF
  ELSE
  END_IF
  CASE
  DEFAULT
  END_SWITCH
  WHILE
  CONTINUE_WHILE
  END_WHILE
) =:: BranchType
struct( BranchType : branchType i32 : id i32 : subId ) =:: BranchId
enum( EMPTY I32 I64 FLOAT DOUBLE PTR REFERENCE ) =:: ValType

struct(
  i64 : mut varId
  ValType : mut valType
) =:: StackElement

struct(
  Type : mut valType
  i64 : mut valId
) =:: TypedValId

struct(
  Type       : valType
  ConstValue : value
  FilePosition : pos
  i64 : id
) =:: LocalConst

struct(
  branchTree.NodeId list : mut ififBranches
  BranchId list : mut ififBranchIds
  branchTree.NodeId : branchRoot
  branchTree.NodeId : mut ifBranch
  BranchId : mut ifBranchId
  i32 : blockId
  bool : mut ifBranchTerminates
) =:: IfBlockInfo
struct(
  branchTree.NodeId list : mut caseBranches
  BranchId list : mut caseBranchIds
  branchTree.NodeId : branchRoot
  i32 : blockId
) =:: SwitchBlockInfo
struct(
  branchTree.NodeId list : mut continueBranches
  BranchId list : mut continueBranchIds
  branchTree.NodeId list : mut breakBranches
  BranchId list : mut breakBranchIds
  i64 : loopValOffset
  branchTree.NodeId : branchRoot
  i32 : blockId
) =:: WhileBlockInfo

enum(
  IfBlockInfo : mut If
  SwitchBlockInfo : mut Switch
  WhileBlockInfo : mut While
) =:: BlockInfo

namespace: sb
  proc( stringBuilder BlockInfo -> stringBuilder ) =>: appendBlockInfo
    switch
      If case "if-else block" sb.appendS return
      Switch case "switch-case block" sb.appendS return
      While case "while block" sb.appendS return
    end
  end
end

struct(
  ProgramContext ptr mut : program
  StackElement BranchTree : mut stackInfo
  BranchId : mut currentBranch
  BlockInfo list : mut openBlocks
  LocalConst list : mut localConstants
  StringConstant list : mut stringConstants
  Type : mut currentProc
  i64 : mut localConstCount
  i64 : mut stackCount
  i64 : mut tmpCount
  i32 : mut jumpLabelCount
  bool : mut reachable
) =:: CompilerContext

namespace: sb
  proc( stringBuilder ValType -> stringBuilder ) =>: appendValType
    switch
      EMPTY case "empty" sb.appendS return
      I32 case "i32" sb.appendS return
      I64 case "i64" sb.appendS return
      FLOAT case "float" sb.appendS return
      DOUBLE case "double" sb.appendS return
      PTR case "pointer" sb.appendS return
      REFERENCE case "reference" sb.appendS return
    end
  end
  proc( stringBuilder ValType -> stringBuilder ) =>: appendValTypeQBE
    switch
      EMPTY case break
      I32 case 'w' sb.appendC break
      I64 PTR REFERENCE case 'l' sb.appendC break
      FLOAT case 's' sb.appendC break
      DOUBLE case 'd' sb.appendC break
    end
  end
end
proc( Type : t CompilerContext ptr : context -> ValType ) =>: toValType
  context [] .program =:: program
  program [] .errors @ =:: errors
  program [] .idContext .typeContext @ =:: typeContext
  t switch
    namedType case
      t typeContext types.unwrapNamed context toValType return
    generatedType case
      t typeContext types.getGeneratedType context toValType return
    primitiveType case
      t .primitiveType switch
        TYPE case ValType .EMPTY return
        BOOL I8 I16 I32 case ValType .I32 return
        I64     case ValType .I64 return
        FLOAT32 case ValType .FLOAT return
        FLOAT64 case ValType .DOUBLE return
      end
      break
    cType case
      t .cType switch ## TODO consider sizes of c-types
        VOID case ValType .EMPTY return
        BOOL CHAR S_CHAR U_CHAR SHORT U_SHORT INT U_INT case ValType .I32 return
        LONG U_LONG case ValType .I64 return
        LONGLONG U_LONGLONG SIZE case ValType .I64 return
        FLOAT case ValType .FLOAT return
        DOUBLE case ValType .DOUBLE return
      end
      break
    arrayIndex case
      ValType .I64 return
    pointer case
      ValType .PTR return
    reference mutableReference procedure arrayType struct union enum case
      ValType .REFERENCE return
    undefined empty templateType genericType autoType
    procIn procOut case
      ValType .EMPTY return
  end
end

namespace: sb
  proc( stringBuilder : sb BranchId : branch -> stringBuilder ) =>: appendBranchId
    sb
      branch .branchType switch
        START case "@start" sb.appendS break
        NEXT case "@next" sb.appendS branch .id sb.appendI break
        ERROR case "@error" sb.appendS branch .id sb.appendI break
        IF case "@if_" sb.appendS branch .id sb.appendI break
        ELSE case "@else_" sb.appendS branch .id sb.appendI break
        END_IF case "@endIf_" sb.appendS branch .id sb.appendI break
        CASE case
          "@case_" sb.appendS
          branch .id sb.appendI
          '_' sb.appendC
          branch .subId sb.appendI
         break
        DEFAULT case "@default" sb.appendS branch .id sb.appendI break
        END_SWITCH case "@endSwitch_" sb.appendS branch .id sb.appendI break
        WHILE case "@while_" sb.appendS branch .id sb.appendI break
        CONTINUE_WHILE case "@continueWhile_" sb.appendS branch .id sb.appendI break
        END_WHILE case "@endWhile_" sb.appendS branch .id sb.appendI break
      end
    return
  end
end
proc(
  stringBuilder : sb
  BranchId : branch
  CompilerContext ptr mut : context
-> stringBuilder ) =>: startBranch
  branch context [] .currentBranch =
  sb
    branch sb.appendBranchId
    '\n' sb.appendC
  return
end
proc( ValType : valType CompilerContext ptr mut : context -> i64 ) =>: pushValue
  context [] .stackCount =:: oldCount
    context [] .stackInfo @
      oldCount
      valType
    StackElement new branchTree.push
    oldCount
      1 +
    context [] .stackCount =
  oldCount return
end
proc( CompilerContext ptr mut : context -> i64 ) =>: nextValueId
  context [] .stackCount =:: oldCount
    oldCount 1 +
  context [] .stackCount =
  oldCount return
end
proc( ValType : valType i32 : offset CompilerContext ptr mut : context -> i64 ) =>: replaceValue
  context nextValueId =:: newId
  context [] .stackInfo @
    offset
  branchTree.replaceAt .data =:: stackElt
  newId stackElt [] .varId =
  valType stackElt [] .valType =
  newId return
end
proc( CompilerContext ptr mut : context -> i64 ) =>: popValue
  context [] .stackInfo @ branchTree.pop =:: tmp
  tmp .data ?? if
    tmp .data [] .varId return
  end
  -1 return
end
proc( CompilerContext ptr mut : context -> i64 ) =>: nextTmpId
  context [] .tmpCount =:: oldCount
    oldCount
      1 +
    context [] .tmpCount =
  oldCount return
end
proc( CompilerContext ptr mut : context -> i32 ) =>: nextJumpLabelId
  context [] .jumpLabelCount =:: oldCount
    oldCount
      1 +
    context [] .jumpLabelCount =
  oldCount return
end
proc( CompilerContext ptr mut : context -> i64 ) =>: nextLocalConstId
  context [] .localConstCount =:: oldCount
    oldCount
      1 +
    context [] .localConstCount =
  oldCount return
end

proc( Type : t CompilerContext ptr mut : context -> bool ) =>: referenceOnly
  context [] .program =:: program
  program [] .idContext .typeContext @ =:: typeContext
  t typeContext types.unwrapNamed types.isPrimitive if
    false return
  end
  t typeContext types.isPointer if
    false return
  end
  t typeContext types.unwrapNamed .cType ?? if
    false return
  end
  ## XXX allow empty enums as value-type
  true return
end

struct(
  string : blockName
  i32 : blockId
  BranchId arrayView : branchIds
  FilePosition : pos
  CompilerContext ptr mut : context
  stringBuilder ptr mut : out
) =:: MergePoint
proc(
  StackElement ptr arrayView : toMerge
  i64 : offset
  MergePoint : mergePoint
-> StackElement ) =>: mergeBranches
  mergePoint .context =:: context
  context [] .program =:: program
  program [] .errors @ =:: errors
  program [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  toMerge 0 array.get =:: rootValue
  rootValue [] .varId =:: rootId
  true =:: mut isMerged
  1 while ..dup toMerge .length < do =:: i
    toMerge i array.get [] .varId rootId != if
      false isMerged =
      i break
    end
    i 1 +
  end ..drop
  isMerged if
    rootValue [] return
  end
  1 while ..dup toMerge .length < do =:: i
    toMerge i array.get [] .valType rootValue [] .valType != if
      "branches of " sb.wrap
         mergePoint .blockName sb.appendStr
         "-statement are out of sync expected: " sb.appendS
         rootValue [] .valType sb.appendValType
         " got: " sb.appendS
         toMerge i array.get [] .valType sb.appendValType
      mergePoint .pos errors appendError
      i break
    end
    i 1 +
  end ..drop
  context nextValueId =:: newId
  mergePoint .out []
    "%s" sb.appendS
    newId sb.appendI
    " =" sb.appendS
    rootValue [] .valType sb.appendValTypeQBE
    " phi " sb.appendS
    0 while ..dup toMerge .length < do =:: i
      i 0 > if
        ", " sb.appendS
      end
      mergePoint .branchIds i array.get sb.appendBranchId
      " %s" sb.appendS
      toMerge i array.get [] .varId sb.appendI
      i 1 +
    end ..drop
    '\n' sb.appendC
  mergePoint .out [] =
  ## StackElement
    newId
    rootValue [] .valType
  StackElement new return
end

proc( BlockInfo : block CompilerContext ptr mut : context -> ) =>: openBlock
  context [] .openBlocks
    block list.append
  context [] .openBlocks =
end
proc(
  i32 : blockId
  branchTree.NodeId : branchRoot
  CompilerContext ptr mut : context
-> ) =>: openIfBlock
  ## IfBlockInfo
    8 branchTree.NodeId list.create
      branchRoot list.append
    8 BranchId list.create
      context [] .currentBranch list.append
    branchRoot
    -1
    context [] .currentBranch
    blockId
    false
  IfBlockInfo new BlockInfo .If context openBlock
end
proc(
  i32 : blockId
  branchTree.NodeId : branchRoot
  CompilerContext ptr mut : context
-> ) =>: openSwitchBlock
  ## SwitchBlockInfo
    16 branchTree.NodeId list.create
    16 BranchId list.create
    branchRoot
    blockId
  SwitchBlockInfo new BlockInfo .Switch context openBlock
end
proc(
  i32 : blockId
  branchTree.NodeId : branchRoot
  CompilerContext ptr mut : context
-> ) =>: openWhileBlock
  ## WhileBlockInfo
    16 branchTree.NodeId list.create
    16 BranchId list.create
    16 branchTree.NodeId list.create
    16 BranchId list.create
    context [] .tmpCount
    branchRoot
    blockId
  WhileBlockInfo new BlockInfo .While context openBlock
  context [] .tmpCount
    context [] .program [] .whileData blockId list.at .data [] .modifiedTypes +
  context [] .tmpCount =
end

proc(
  BlockType : breakType
  FilePosition : pos
  CompilerContext ptr mut : context
-> BlockInfo ptr mut optional ) =>: findBreakableBlock
  context [] .program =:: program
  program [] .errors @ =:: errors
  context [] .openBlocks .length 1 - while ..dup 0 >= do =:: i
    context [] .openBlocks i list.at .data =:: block
    breakType .BREAK ?? if block [] .While ?? _if
      block optional.wrap return
    end
    breakType .CONTINUE ?? if block [] .While ?? _if
      block optional.wrap return
    end
    breakType .BREAK_SWITCH ?? if block [] .Switch ?? _if
      block optional.wrap return
    end
    i 1 -
  end ..drop
  60 sb.create
    breakType sb.appendBlockType
    " can only appear in loops " sb.appendS
    breakType .BREAK_SWITCH ?? if
      "and switch-case statements" sb.appendS
    end
  pos errors appendError
  BlockInfo ptr mut optional.empty return
end

namespace: sb
  proc(
    stringBuilder : sb
    LabelId : label
    i64 : implId
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: appendGlobalName
    context [] .program =:: prog
    prog [] .idContext .typeContext .labelContext @ =:: labelContext
    sb
      '$' sb.appendC
      label labelContext id.labelFlags id.FLAG_EXTERN & ? if
        ## use unmodified name for extern values
        label labelContext sb.appendLabelName
        return
      end
      CONCAT_PREFIX sb.appendS
      label labelContext id.labelFlags id.FLAG_EXPORT & 0 == if
        label labelContext id.getLabelFile sb.appendI
        "_F" sb.appendS
      end
      label labelContext id.getLabelNamespace =:: mut mNamespace
      while mNamespace id.NAMESPACE_ID_NONE != mNamespace 0 > & do
        mNamespace labelContext id.namespaceName labelContext sb.appendAsciifiedStringConst
        "." string.wrap sb.appendAsciified
        mNamespace labelContext id.parentNamespace mNamespace =
      end ## XXX? reverse order
      label labelContext sb.appendAsciifiedLabelName
      implId 0 >= if
        "_I" sb.appendS
        implId sb.appendI
      end
    return
  end

  proc(
    stringBuilder : sb
    Type : t
    string : name
    bool : isStored
  -> stringBuilder ) =>: appendCompositeTypeQBE
    isStored if
      sb
        ":" sb.appendS
        name sb.appendStr
        t types.getTypeId sb.appendI
      return
    else
      sb "l" sb.appendS return
    end
  end
end
  enum( STACK LOAD ULOAD STORE ) =:: StorageType
namespace: sb
  proc(
    stringBuilder : sb
    Type : t
    StorageType : storeType
    FilePosition : pos
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: appendTypeNameQBE
    context [] .program =:: prog
    prog [] .errors @ =:: errors
    prog [] .idContext .typeContext @ =:: typeContext
    typeContext [] .labelContext @ =:: labelContext
    t switch
      namedType case
        sb
          t typeContext types.unwrapNamed storeType pos context
        appendTypeNameQBE
        return
      generatedType case
        sb
          t typeContext types.getGeneratedType storeType pos context
        appendTypeNameQBE
        return
      primitiveType case
        t .primitiveType switch
          TYPE case sb ":type" sb.appendS return break
          BOOL case
            storeType switch
              STACK case sb "w" sb.appendS return
              LOAD ULOAD case sb "ub" sb.appendS return
              STORE case sb "b" sb.appendS return
            end
            break
          I8 case
            storeType switch
              STACK case sb "w" sb.appendS return
              LOAD case sb "sb" sb.appendS return
              ULOAD case sb "ub" sb.appendS return
              STORE case sb "b" sb.appendS return
            end
            break
          I16 case
            storeType switch
              STACK case sb "w" sb.appendS return
              LOAD case sb "sh" sb.appendS return
              ULOAD case sb "uh" sb.appendS return
              STORE case sb "h" sb.appendS return
            end
            break
          I32     case sb "w" sb.appendS return
          I64     case sb "l" sb.appendS return
          FLOAT32 case sb "s" sb.appendS return
          FLOAT64 case sb "d" sb.appendS return
        end
        break
      cType case
        t .cType switch ## TODO consider sizes of c-types
          BOOL U_CHAR case
            storeType switch
              STACK case sb "w" sb.appendS return
              LOAD ULOAD case sb "ub" sb.appendS return
              STORE case sb "b" sb.appendS return
            end
            break
          CHAR S_CHAR case
            storeType switch
              STACK case sb "w" sb.appendS return
              LOAD ULOAD case sb "sb" sb.appendS return
              STORE case sb "b" sb.appendS return
            end
            break
          SHORT case
            storeType switch
              STACK case sb "w" sb.appendS return
              LOAD ULOAD case sb "sh" sb.appendS return
              STORE case sb "h" sb.appendS return
            end
            break
          U_SHORT case
            storeType switch
              STACK case sb "w" sb.appendS return
              LOAD ULOAD case sb "uh" sb.appendS return
              STORE case sb "h" sb.appendS return
            end
            break
          INT U_INT case sb "w" sb.appendS return
          LONG LONGLONG U_LONG U_LONGLONG SIZE case
            sb "l" sb.appendS return
          FLOAT case sb "s" sb.appendS return
          DOUBLE case sb "d" sb.appendS return
          VOID case break
        end
        break
      arrayIndex pointer reference mutableReference procedure case
        sb "l" sb.appendS return ## size or pointer
      arrayType case
        sb t "array" string.wrap storeType .STACK ?? ! appendCompositeTypeQBE return
        break
      struct case
        sb t "struct" string.wrap storeType .STACK ?? ! appendCompositeTypeQBE return
        break
      union case
        sb t "union" string.wrap storeType .STACK ?? ! appendCompositeTypeQBE return
        break
      enum case
        sb t "enum" string.wrap storeType .STACK ?? ! appendCompositeTypeQBE return
        break
      undefined empty templateType genericType autoType
      procIn procOut case
        break
    end
    "unsupported type" sb.wrap
    pos errors appendError
    sb return
  end
  proc(
    stringBuilder : sb
    i32 : index
    LabelId : labelId
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: appendArgName
    sb
      "%a" sb.appendS
      index sb.appendI
    return
  end
  proc(
    stringBuilder : sb
    i64 : index
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: appendOutArgName
    sb
      "%o" sb.appendS
      index sb.appendI
    return
  end
  proc(
    stringBuilder : sb
    Type : procType
    FilePosition : pos
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: appendProcSignature
    context [] .program =:: prog
    prog [] .idContext .typeContext @ =:: typeContext
    typeContext [] .labelContext @ =:: labelContext
    procType typeContext types.getCallConvention ..drop =:: callConvention
    procType typeContext types.getProcIn ..drop =:: inType
    inType typeContext types.compositeElts =:: args
    procType typeContext types.getProcOutArgs ..drop =:: outArgs
    false =:: mut hasArgs
    sb
      "(" sb.appendS
      0 while ..dup args .length < do =:: i
        args i types.compositeElts.get =:: arg
        inType i typeContext types.compositeGetLabel =:: label
        arg typeContext types.isEmpty if ## skip empty arguments
          i 1 + continue
        end
        label labelContext id.labelFlags id.FLAG_STATIC & ? if
          i 1 + continue
        end
        hasArgs if
          ',' sb.appendC
        end
        true hasArgs =
        arg StorageType .LOAD pos context appendTypeNameQBE
        ' ' sb.appendC
        i inType i typeContext types.compositeGetLabel context appendArgName
        i 1 +
      end ..drop
      0 while ..dup outArgs .length < do =:: i
          outArgs i array.get =:: arg
          arg typeContext types.isEmpty if ## skip empty arguments
            i 1 + continue
          end
          hasArgs if
            ',' sb.appendC
          end
          true hasArgs =
          "l " sb.appendS ## all out arguments are pointers
          i context appendOutArgName
        i 1 +
      end ..drop
      ")" sb.appendS
    return
  end
  proc(
    stringBuilder : sb
    StringConstant : value
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: appendStringConstQBE
    context [] .program =:: prog
    prog [] .idContext .typeContext .labelContext @ =:: labelContext
    sb
      0 while ..dup value .length < do =:: i
        "b " sb.appendS
        value i labelContext id.scCharAt 0xff & sb.appendI
        ',' sb.appendC
        i 1 +
      end ..drop
      "b 0" sb.appendS
    return
  end
  proc(
    stringBuilder : sb
    Type : t
    ConstValue : value
    bool : isGlobal
    FilePosition : pos
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: appendConstQBE
    context [] .program =:: prog
    prog [] .errors @ =:: errors
    prog [] .idContext .typeContext @ =:: typeContext
    typeContext [] .labelContext @ =:: labelContext
    prog [] .idContext .constContext @ =:: constContext
    sb
      isGlobal if
          t typeContext types.unwrapNamed types.isPrimitive
          t typeContext types.isPointer | _if
        t StorageType .STORE pos context sb.appendTypeNameQBE
        ' ' sb.appendC
      end
      value switch
        boolean case
          value .boolean if '1' else '0' end sb.appendC return
        int case
          t typeContext types.numberSize =:: numSize
          numSize types.primitive.I8
              typeContext types.numberSize == if
            value .int i8 cast sb.appendI
          else numSize types.primitive.I16
              typeContext types.numberSize == _if
            value .int i16 cast sb.appendI
          else numSize types.primitive.I32
              typeContext types.numberSize == _if
            value .int i32 cast sb.appendI
          else numSize types.primitive.I64
              typeContext types.numberSize == _if
            value .int sb.appendI
          else numSize types.primitive.FLOAT32
              typeContext types.numberSize == _if
            value .int f32 cast f32.bits sb.appendI
          else numSize types.primitive.FLOAT64
              typeContext types.numberSize == _if
            value .int f64 cast f64.bits sb.appendI
          else
            ..unreachable ## unknown number type
          end
          return
        break
        chr case value .chr sb.appendI return
        break
        Float case
          t typeContext types.numberPrecision =:: numPrec
          numPrec types.primitive.FLOAT32
              typeContext types.numberPrecision == if
            value .Float f32 cast f32.bits sb.appendI
          else numPrec types.primitive.FLOAT64
              typeContext types.numberPrecision == _if
            value .Float f64.bits sb.appendI
          else
            ..unreachable ## unknown number type
          end
          return
        enumLabel case break
        genericArg case
          context [] .currentProc
            typeContext types.getProcIn ..drop
          =:: progIn
          progIn
            value .genericArg
            typeContext
          types.compositeFindLabel =:: index
          index id.LABEL_ID_NONE != if
            ## appendArgName
              index
              value .genericArg
              context
            appendArgName return
          end
          break
        str case
          '$' sb.appendC
          STRING_CONST_NAME sb.appendS
          context [] .stringConstants
            ..dup .length =:: strId
            value .str list.append
          context [] .stringConstants =
          strId sb.appendI
          return
        arrayConstant case
          isGlobal ! if
            break
          end
          t typeContext types.isArray if
            t typeContext types.getBaseType =:: base
            base typeContext types.sizeOf =:: baseSize
            base typeContext types.strideOf =:: baseStride
            value .arrayConstant constContext constArrayAsArray =:: elts
            0 while ..dup elts .length < do =:: i
              i 0 > if
                ',' sb.appendC
              end
              base elts i array.get true pos context appendConstQBE
              baseSize baseStride < if
                ",z " sb.appendS
                baseStride baseSize - sb.appendI
              end
              i 1 +
            end ..drop
            return
          else t typeContext types.isTuple _if
            ## TODO ensure elements are ordered by memory location
            t typeContext types.compositeElts =:: types
            value .arrayConstant constContext constArrayAsArray =:: elts
            0i64 =:: mut offset
            0 while ..dup elts .length < do =:: i
              types i types.compositeElts.get =:: elt
              t i typeContext types.tupleElementOffset =:: eltOffset
              i 0 > if
                ',' sb.appendC
              end
              offset eltOffset < if
                "z " sb.appendS
                eltOffset offset - sb.appendI
                ',' sb.appendC
                eltOffset offset =
              end
              ## appendConstQBE
                elt
                elts i array.get
                true
                pos
              context appendConstQBE
              offset
                elt typeContext types.sizeOf +
              offset =
              i 1 +
            end ..drop
            t typeContext types.sizeOf =:: size
            offset size < if
              ",z " sb.appendS
              size offset - sb.appendI
            end
            return
          end
        break
        none wildCard templateArg typeId
            procedure procedureBundle case
        break
      end
      isGlobal if
        "unsupported constant: " sb.wrap
          value constContext typeContext sb.appendConstant
        pos errors appendError
        return
      end
      context nextLocalConstId =:: constId
      context [] .localConstants
        ## LocalConst
          t
          value
          pos
          constId
        LocalConst new list.append
      context [] .localConstants =
      "$" sb.appendS
      LOCAL_CONST_NAME sb.appendS
      constId sb.appendI
    return
  end
  proc(
    stringBuilder : sb
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: appendLocalConstants
    context [] .program [] .idContext .typeContext @ =:: typeContext
    sb
      0 while ..dup context [] .localConstants .length < do =:: i
        context [] .localConstants i list.at .data =:: constant
        "data $" sb.appendS
        LOCAL_CONST_NAME sb.appendS
        constant [] .id sb.appendI
        " = align " sb.appendS
        constant [] .valType typeContext types.alignOf sb.appendI
        " {" sb.appendS
        constant [] .valType constant [] .value true constant [] .pos context appendConstQBE
        "}\n" sb.appendS
        i 1 +
      end ..drop
      context [] .localConstants
        list.clear
      context [] .localConstants =
    return
  end

  proc(
    stringBuilder : sb
    Type : t
    FilePosition : pos
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: startTypeDeclaration
    sb
      "type " sb.appendS
      t StorageType .LOAD pos context appendTypeNameQBE
      " = {" sb.appendS
    return
  end
  proc(
    stringBuilder : sb
    Type : t
    FilePosition : pos
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: startEltTypeDeclaration
    sb
      "type " sb.appendS
      t StorageType .LOAD pos context appendTypeNameQBE
      "_elt" sb.appendS
      " = {" sb.appendS
    return
  end
  proc(
    stringBuilder : sb
    Type : t
    FilePosition : pos
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: eltTypeName
    sb
      t StorageType .LOAD pos context appendTypeNameQBE
      "_elt" sb.appendS
    return
  end
  proc(
    stringBuilder
  -> stringBuilder ) =>: endTypeDeclaration
    "}\n" sb.appendS return
  end
  proc(
    stringBuilder : sb
    Type : t
    FilePosition : pos
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: appendTypeDeclarationQBE
    context [] .program =:: prog
    prog [] .errors @ =:: errors
    prog [] .idContext .typeContext @ =:: typeContext
    typeContext [] .labelContext @ =:: labelContext
    prog [] .idContext .constContext @ =:: constContext
    t types.isNamedType t types.isGeneratedType | if
      sb return ## ignore named types
    end
    t typeContext types.isEmpty if
      sb return ## ignore empy types
    end
    t typeContext types.containsGeneric | if
      sb return ## ignore generic types
    end
    t typeContext types.isArray if
      t typeContext types.isFixedSize _if
      t typeContext types.getArraySize =:: sizes
      1i64 =:: mut S
      0 while ..dup sizes .length < do =:: i
        sizes i array.get =:: size
        size .sizeType .int ?? ! if
          sb return ## no declaration for var-size array
        end
        S size .value * S =
        i 1 +
      end ..drop
      t typeContext types.getBaseType =:: baseType
      baseType typeContext types.sizeOf =:: baseSize
      baseType typeContext types.strideOf =:: baseStride
      sb
        baseSize baseStride < if
          t pos context startEltTypeDeclaration
            ## appendTypeNameQBE
              baseType
              StorageType .STORE
              pos
            context sb.appendTypeNameQBE
            ",b " sb.appendS
            baseStride baseSize - sb.appendI
          endTypeDeclaration
        end
        t pos context startTypeDeclaration
        baseSize baseStride < if
           t pos context eltTypeName
        else
          ## appendTypeNameQBE
            baseType
            StorageType .STORE
            pos
          context sb.appendTypeNameQBE
        end
        ' ' sb.appendC
        S sb.appendI
      endTypeDeclaration return
    end
    t typeContext types.isTuple if
      t typeContext types.compositeElts =:: elts
      0i64 =:: mut offset
      sb t pos context startTypeDeclaration
        0 while ..dup elts .length < do =:: i
          elts i types.compositeElts.get =:: elt
          t i typeContext types.tupleElementOffset =:: eltOffset
          i 0 > if
            ',' sb.appendC
          end
          offset eltOffset < if
            "b " sb.appendS
            eltOffset offset - sb.appendI
            ',' sb.appendC
            eltOffset offset =
          end
          ## appendTypeNameQBE
            elt
            StorageType .STORE
            pos
          context sb.appendTypeNameQBE
          offset
            elt typeContext types.sizeOf +
          offset =
          i 1 +
        end ..drop
        t typeContext types.sizeOf =:: size
        offset size < if
          ",z " sb.appendS
          size offset - sb.appendI
        end
      endTypeDeclaration return
    end
    t typeContext types.isUnion
    t typeContext types.isEnum | if
      t typeContext types.isEnum =:: isTagged
      t typeContext types.compositeElts =:: elts
      false =:: mut hasElt
      0i64 =:: mut bodySize
      sb
        t typeContext types.compositeFlags types.COMP_FLAG_EMPTY & ? ! if
          isTagged if
            t pos context startEltTypeDeclaration
          else
            t pos context startTypeDeclaration
          end
          0 while ..dup elts .length < do =:: i
            elts i types.compositeElts.get =:: elt
            elt typeContext types.isEmpty if
              i 1 + continue
            end
            elt typeContext types.sizeOf =:: eltSize
            eltSize bodySize > if
              eltSize bodySize =
            end
            "{" sb.appendS
              ## appendTypeNameQBE
                elt
                StorageType .STORE
                pos
              context sb.appendTypeNameQBE
            "}" sb.appendS
            true hasElt =
            i 1 +
          end ..drop
          endTypeDeclaration
        end
      isTagged ! if return end
      t typeContext types.enumLabelInfo =:: labelOffset =:: labelType
      t pos context startTypeDeclaration
        t typeContext types.compositeFlags types.COMP_FLAG_EMPTY & ? ! if
          t pos context eltTypeName
          ',' sb.appendC
        end
        bodySize labelOffset < if
          "b " sb.appendS
          labelOffset bodySize - sb.appendI
          ',' sb.appendC
        end
        ## appendTypeNameQBE
          labelType
          StorageType .STORE
          pos
        context sb.appendTypeNameQBE
      endTypeDeclaration return
    end
    sb return
  end
  proc( stringBuilder : sb string : str -> stringBuilder ) =>: appendEscapedString
    sb
      0 while ..dup str .length < do =:: i
          str i string.charAt appendEscapedChr
        i 1 +
      end ..drop
    return
  end
  proc(
    stringBuilder : sb
    FilePosition : pos
  -> stringBuilder ) =>: appendPosQBE
    sb
      "dbgloc " sb.appendS
      pos .line sb.appendI
      ',' sb.appendC
      pos .posInLine sb.appendI
      " ## " sb.appendS
      pos .fileName sb.appendEscapedString
      '\n' sb.appendC
    return
  end
end

proc( string : fileName ProgramContext ptr : prog -> FileId ) =>: findFileId
  0 while ..dup prog [] .progFiles .length < do =:: i
    prog [] .progFiles i list.at .data [] .fileName list.asArray =:: currentName
    fileName currentName string.eq if
      i return
    end
    i 1 +
  end ..drop
  FILE_ID_NONE return
end


proc(
  stringBuilder : sb
  ValType : valType
  i8 : valStackType
  i64 : valId
  string : cmpType
  i64 : value
  BranchId : ifBranch
  BranchId : elseBranch
  CompilerContext ptr mut : context
-> stringBuilder ) =>: appendCmpInt
  context nextTmpId =:: tmpId
  sb
    "%t" sb.appendS
    tmpId sb.appendI
    " =w c" sb.appendS
    cmpType sb.appendStr
    valType sb.appendValTypeQBE
    " %" sb.appendS
    valStackType sb.appendC
    valId sb.appendI
    ", " sb.appendS
    value sb.appendI
    "\njnz %t" sb.appendS
    tmpId sb.appendI
    ", " sb.appendS
    ifBranch sb.appendBranchId
    ", " sb.appendS
    elseBranch sb.appendBranchId
    "\n" sb.appendS
  return
end
proc(
  stringBuilder : sb
  types.ArraySize : size
  i64 : valId
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: appendIndexCheck
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  size .sizeType .int ?? ! if
    "unsupported size type for array element" sb.wrap
      size sb.appendArraySize
    pos errors appendError
  end
  ## BranchId
    BranchType .NEXT
    context nextJumpLabelId
    0
  BranchId new =:: check1Branch
  ## BranchId
    BranchType .ERROR
    context nextJumpLabelId
    0
  BranchId new =:: errorBranch
  ## BranchId
    BranchType .NEXT
    context nextJumpLabelId
    0
  BranchId new =:: okBranch
  context nextTmpId =:: c1
  context nextTmpId =:: c2
  sb
    "## check index\n" sb.appendS
    ## cmp int
      ValType .I64
      's' valId
      "slt" string.wrap
      0
      errorBranch
      check1Branch
    context appendCmpInt
    check1Branch sb.appendBranchId
    "\n" sb.appendS
    ## cmp int
      ValType .I64
      's' valId
      "sge" string.wrap
      size .value
      errorBranch
      okBranch
    context appendCmpInt
    errorBranch sb.appendBranchId
    "\ncall $printf (l $" sb.appendS
    CHECK_INDEX_FORMAT sb.appendS
    ", ...,l %s" sb.appendS
    valId sb.appendI
    ",l " sb.appendS
    size .value sb.appendI
    ",l " sb.appendS
    pos .fileName .length sb.appendI
    ",l $" sb.appendS
    FILE_NAME_NAME sb.appendS
    pos .fileName prog findFileId sb.appendI
    ",w " sb.appendS
    pos .line sb.appendI
    ",w " sb.appendS
    pos .posInLine sb.appendI
    ")\n" sb.appendS
    "call $exit (w 1)\n" sb.appendS ## use exit for flushing stdout
    okBranch context startBranch
  return
end

proc(
  stringBuilder : sb
  Type : enumType
  i64 : valId
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder i64 ValType ) =>: loadEnumLabel
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  enumType typeContext types.enumLabelInfo =:: labelOffset =:: labelType
  labelType typeContext types.numberSize =:: numSize
  context nextTmpId =:: labelPtr
  context nextTmpId =:: mut label
  sb
    "%t" sb.appendS
    labelPtr sb.appendI
    " =l add %s" sb.appendS
    valId sb.appendI
    ", " sb.appendS
    labelOffset sb.appendI
    "\n%t" sb.appendS
    label sb.appendI
    " =w load" sb.appendS
    labelType StorageType .ULOAD pos context sb.appendTypeNameQBE
    " %t" sb.appendS
    labelPtr sb.appendI
    numSize types.primitive.I32 typeContext types.numberSize < if
      label =:: oldLabel
      context nextTmpId label =
      "\n%t" sb.appendS
      label sb.appendI
      " =w ext" sb.appendS
      labelType StorageType .ULOAD pos context sb.appendTypeNameQBE
      " %t" sb.appendS
      oldLabel sb.appendI
    end
    '\n' sb.appendC
  label ValType .I32 return
end
proc(
  stringBuilder : sb
  Type : enumType
  i64 : valId
  i64 : expectedIndex
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder i64 i64 ValType ) =>: checkEnumIndex
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  sb
    ## loadEnumLabel
      enumType
      valId
      pos
    context loadEnumLabel =:: labelType =:: labelId
    context nextTmpId =:: c
    "%t" sb.appendS
    c sb.appendI
    " =w ceq" sb.appendS
    labelType sb.appendValTypeQBE
    " %t" sb.appendS
    labelId sb.appendI
    ", " sb.appendS
    expectedIndex sb.appendI
    '\n' sb.appendC
  c labelId labelType return
end

proc(
  stringBuilder : sb
  Type : enumType
  i64 : valId
  i64 : expectedIndex
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: appendEnumCheck
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  ## BranchId
    BranchType .ERROR
    context nextJumpLabelId
    0
  BranchId new =:: errorBranch
  ## BranchId
    BranchType .NEXT
    context nextJumpLabelId
    0
  BranchId new =:: okBranch
  sb
    "## check enum \n" sb.appendS
    enumType valId expectedIndex pos context checkEnumIndex =:: labelType =:: label =:: c
    "jnz %t" sb.appendS
    c sb.appendI
    ", " sb.appendS
    okBranch sb.appendBranchId
    ", " sb.appendS
    errorBranch sb.appendBranchId
    '\n' sb.appendC
    errorBranch sb.appendBranchId
    "\ncall $printf (l $" sb.appendS
    CHECK_ENUM_FORMAT sb.appendS
    ", ...," sb.appendS
    labelType sb.appendValTypeQBE
    " %t" sb.appendS
    label sb.appendI
    ",w " sb.appendS
    expectedIndex sb.appendI
    ",l " sb.appendS
    pos .fileName .length sb.appendI
    ",l $" sb.appendS
    FILE_NAME_NAME sb.appendS
    pos .fileName prog findFileId sb.appendI
    ",w " sb.appendS
    pos .line sb.appendI
    ",w " sb.appendS
    pos .posInLine sb.appendI
    ")\n" sb.appendS
    "call $exit (w 1)\n" sb.appendS ## use exit for flushing stdout
    okBranch context startBranch
  return
end

proc(
  stringBuilder : sb
  Type : tupleType
  i64 : tupleId
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: flattenTupleQBE
  context [] .program =:: prog
  prog [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  tupleType typeContext types.compositeElts =:: elts
  sb
    0 while ..dup elts .length < do =:: i
      elts i types.compositeElts.get =:: eltType
      eltType context toValType =:: eltValType
      tupleType i typeContext types.tupleElementOffset =:: eltOffset
      eltType typeContext types.isEmpty if
        i 1 - continue
      end
      "%t" sb.appendS
        context nextTmpId =:: eltPtrId
      eltPtrId sb.appendI
      " =l add %s" sb.appendS
      tupleId sb.appendI
      ", " sb.appendS
      eltOffset sb.appendI
      '\n' sb.appendC
      eltValType context pushValue =:: eltId
      "%s" sb.appendS
      eltId sb.appendI
      eltType context referenceOnly if
        eltType context false appendAlloc ..drop
        "blit %t" sb.appendS
      else
        " =" sb.appendS
        eltValType sb.appendValTypeQBE
        " load" sb.appendS
        eltType StorageType .LOAD pos context sb.appendTypeNameQBE
        " %t" sb.appendS
      end
      eltPtrId sb.appendI
      eltType context referenceOnly if
        ", %s" sb.appendS
        eltId
        sb.appendI
        ',' sb.appendC
        eltType typeContext types.sizeOf sb.appendI
      end
      '\n' sb.appendC
      i 1 +
    end ..drop
  return
end
proc(
  stringBuilder : sb
  Type : tupleType
  i64 : dataPtrId
  FilePosition : pos
