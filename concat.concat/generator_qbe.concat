    getArrayElement atArrayElement case
      op [] .val .getArrayElement ?? if
        op [] .val .getArrayElement
      else
        op [] .val .atArrayElement
      end =:: mut: argCount
      op [] .val .atArrayElement ?? =:: isAddr
      op [] .dataType =:: mut: arrayType
      arrayType typeContext types.isPointer =:: mut: isPtr
      arrayType typeContext types.isReference if
