    block case
      op [] .val .block .blockType switch
        IF case
          ## BranchId
            BranchType .IF
            op [] .val .block .blockId
            0
          BranchId new =:: ifBranch
          sb
            op [] .pos sb.appendPosQBE
            "jnz %s" sb.appendS
            op [] .pos context popValue sb.appendI
            ", " sb.appendS
