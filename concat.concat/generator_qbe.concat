        op [] .pos context popValue =:: srcId
        sb
          op [] .pos sb.appendPosQBE
          "%s" sb.appendS
          valType context pushValue sb.appendI
          " =l add %s" sb.appendS
          srcId sb.appendI
          "," sb.appendS
          containerType index op [] .pos context tupleEltOffsetInt sb.appendI
