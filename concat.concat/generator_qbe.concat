        op [] .pos sb.appendPosQBE
        ## appendEnumCheck
          op [] .dataType
          srcVal? .data [] .varId
          op [] .val .checkEnumLabel
          op [] .pos
          context
        appendEnumCheck
      return
    setEnumLabel case
      context [] .stackInfo @ branchTree.peek =:: srcVal?
      srcVal? optional.isEmpty if
        "stack underflow" sb.wrap
        op [] .pos errors appendError
        sb return
      end
      sb
        op [] .pos sb.appendPosQBE
        ## storeEnumLabel
          op [] .dataType
          's'
          srcVal? .data [] .varId
          op [] .val .setEnumLabel
          op [] .pos
          context
        storeEnumLabel
