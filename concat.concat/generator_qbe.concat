        IFIF AND_IF OR_IF case
          context [] .openBlocks list.peek =:: ifBlock?
          op [] .val .block .blockType .IFIF ?? if
            ifBlock? .data [] .If@
          else ifBlock? optional.hasData and
              ifBlock? .data =:: ifBlock
              ifBlock [] .If ?? and
              ifBlock [] .If .hasIf ! _if
            ifBlock [] .If@
          else ## start if block if not already open
            op [] .val .block .blockId context openIfBlock
            context [] .openBlocks list.peek .data [] .If@
          end =:: ifBlock
          op [] .val .block .blockType .OR_IF ?? =:: isOr
