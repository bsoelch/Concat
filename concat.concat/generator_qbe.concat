end

proc( ConstValue : label -> i64 ) =>: labelAsInt
  label .int ?? if
    label .int return
  end
  label .chr ?? if
    label .chr return
  end
  label .enumLabel ?? if
    label .enumLabel return
  end
  ..unreachable
end
proc(
  stringBuilder : sb
  ValType : valType
  i64 : valId
  i32 : switchId
  LabelData arrayView : labels
  i64 optional : lower
  i64 optional : upper
  CompilerContext ptr mut : context
-> stringBuilder ) =>: appendSwitchJumpTree
  labels .length 3 <= if
    false =:: mut contiguous
    labels .length =:: mut loopCount
    lower optional.hasData if upper optional.hasData _if
      upper .data lower .data - labels .length == contiguous =
      loopCount 1 - loopCount =
    end
    sb
      0 while ..dup loopCount < do =:: i
        ## BranchId
          BranchType .CASE
          switchId
          labels i array.at .data [] .caseId
        BranchId new =:: caseBranch
        ## BranchId
          BranchType .NEXT
          context nextJumpLabelId
          0
        BranchId new =:: nextBranch
        labels i array.get .value labelAsInt =:: cmpVal
        ## cmp int
          valType
          't' valId
          "eq" string.wrap
          cmpVal
          caseBranch
          nextBranch
        context appendCmpInt
        nextBranch sb.appendBranchId
        '\n' sb.appendC
        i 1 +
      end ..drop
      "jmp " sb.appendS
      contiguous if
        ## BranchId
          BranchType .CASE
          switchId
          labels loopCount array.at .data [] .caseId
        BranchId new sb.appendBranchId
        '\n' sb.appendC
      else
        ## BranchId
          BranchType .DEFAULT
          switchId
          0
        BranchId new sb.appendBranchId
        '\n' sb.appendC
      end
    return
  end
  labels .length 2 / =:: p
  ## BranchId
    BranchType .NEXT
    context nextJumpLabelId
    0
  BranchId new =:: ltBranch
  ## BranchId
    BranchType .NEXT
    context nextJumpLabelId
    0
  BranchId new =:: geBranch
  labels p array.get .value labelAsInt =:: cmpVal
  labels p array.cutIndex =:: lElts =:: rElts
  sb
    ## cmp int
      valType
      't' valId
      "slt" string.wrap
      cmpVal
      ltBranch
      geBranch
    context appendCmpInt
    ltBranch sb.appendBranchId
    '\n' sb.appendC
    ## appendSwitchJumpTree
      valType
      valId
      switchId
      lElts
      lower
      upper optional.isEmpty if
        cmpVal optional.wrap
      else
        upper .data cmpVal i64.min optional.wrap
      end
      context
    appendSwitchJumpTree
    geBranch sb.appendBranchId
    '\n' sb.appendC
    ## appendSwitchJumpTree
      valType
      valId
      switchId
      rElts
      lower optional.isEmpty if
        cmpVal optional.wrap
      else
        lower .data cmpVal i64.max optional.wrap
      end
      upper
      context
    appendSwitchJumpTree
  return
end
proc(
  LabelData : a
  LabelData : b
  CompilerContext ptr mut : context
-> i32 ) =>: labelCmp
  a .value labelAsInt =:: aInt
  b .value labelAsInt =:: bInt
  aInt bInt == if
    0 return
  end
  aInt bInt < if -1 else 1 end return
end
proc(
  stringBuilder : sb
  Type : switchType
  i64 : valId
  i32 : switchId
  LabelData list : labels
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: appendSwitchTable
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  ValType : valType
  i64 : tmpId
  labels labelCmp @ context list.sort
  sb
    "## switch\n" sb.appendS
    switchType typeContext types.isEnum if
      ## loadEnumLabel
        switchType
        valId
        pos
      context loadEnumLabel valType = tmpId =
    else switchType typeContext types.isInt _if
      switchType typeContext types.numberSize =:: numSize
      context nextTmpId tmpId =
      switchType context toValType valType =
      "%t" sb.appendS
      tmpId sb.appendI
      " =" sb.appendS
      valType sb.appendValTypeQBE
      numSize types.primitive.I32 typeContext types.numberSize < if
        " ext" sb.appendS
        switchType
          StorageType .ULOAD
        pos context sb.appendTypeNameQBE
        " %s" sb.appendS
      else
        " copy %s" sb.appendS
      end
      valId sb.appendI
      '\n' sb.appendC
    else
      "unsupported type in switch: " sb.wrap
        switchType typeContext sb.appendType
      pos errors appendError
      return
    end
    ## appendJumpTable
      valType
      tmpId
      switchId
      labels list.asArray
      i64 optional.empty
      i64 optional.empty
      context
    appendSwitchJumpTree
  return
end

