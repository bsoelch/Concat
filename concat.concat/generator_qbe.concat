import stringIO
import numbers/floats

import "program.concat"
import "measure.concat"
import "branchTree.concat"

## XXX make prefix customizable
"cct_" =:: CONCAT_PREFIX
"cctI_argc" =:: CONCAT_ARGC_NAME
"cctI_argv" =:: CONCAT_ARGV_NAME
"cctI_envp" =:: CONCAT_ENVP_NAME
"cctI_local" =:: LOCAL_CONST_NAME
"cctI_string" =:: STRING_CONST_NAME
"cctI_ptr" =:: PTR_CONST_NAME
"cctI_constRef" =:: CONST_REFERENCE_NAME
"cctI_checkIndexFormat" =:: CHECK_INDEX_FORMAT
"cctI_checkEnumFormat" =:: CHECK_ENUM_FORMAT
"cctI_assertFormat" =:: ASSERT_FORMAT
"fileName" =:: FILE_NAME_NAME

enum(
  START
  NEXT
  ERROR
  IF
  ELSE
  END_IF
  CASE
  DEFAULT
  END_SWITCH
  WHILE
  DO
  CONTINUE_WHILE
  END_WHILE
  END_AND_OR
) =:: BranchType
struct( BranchType : branchType i32 : id i32 : subId ) =:: BranchId
enum( EMPTY I32 I64 FLOAT DOUBLE PTR REFERENCE ) =:: ValType

struct(
  i64 : mut: varId
  ValType : mut: valType
) =:: StackElement

struct(
  Type : mut: valType
  i64 : mut: valId
) =:: TypedValId

struct(
  Type       : valType
  ConstValue : value
  FilePosition : pos
  i64 : id
) =:: LocalConst

struct(
  branchTree.NodeId list : mut: andBranches
  BranchId list : mut: andBranchIds
  branchTree.NodeId list : mut: orBranches
  BranchId list : mut: orBranchIds
  BranchId : mut: ifBranchId
  branchTree.NodeId : branchRoot
  branchTree.NodeId : mut: ifBranch
  i32 : blockId
  bool : mut: hasIf
  bool : mut: ifBranchTerminates
) =:: IfBlockInfo
struct(
  branchTree.NodeId list : mut: caseBranches
  BranchId list : mut: caseBranchIds
  branchTree.NodeId : branchRoot
  i32 : blockId
) =:: SwitchBlockInfo
struct(
  branchTree.NodeId list : mut: continueBranches
  BranchId list : mut: continueBranchIds
  branchTree.NodeId list : mut: breakBranches
  BranchId list : mut: breakBranchIds
  branchTree.NodeId list : mut: doBranches
  BranchId list : mut: doBranchIds
  i64 : loopValOffset
  branchTree.NodeId : branchRoot
  i32 : blockId
) =:: WhileBlockInfo
struct(
  branchTree.NodeId list : mut: branches
  BranchId list : mut: branchIds
  i32 : blockId
) =:: AndOrBlockInfo

union(
  IfBlockInfo : mut: If
  SwitchBlockInfo : mut: Switch
  WhileBlockInfo : mut: While
  AndOrBlockInfo : mut: AndOr
) =:: BlockInfo

namespace: sb
  proc( stringBuilder BlockInfo -> stringBuilder ) =>: appendBlockInfo
    switch
      If case "if-else block" sb.appendS return
      Switch case "switch-case block" sb.appendS return
      While case "while block" sb.appendS return
      AndOr case "and/or block" sb.appendS return
    end
  end
end

struct(
  ProgramContext ptr mut : program
  StackElement BranchTree : mut: stackInfo
  BranchId : mut: currentBranch
  BlockInfo list : mut: openBlocks
  LocalConst list : mut: localConstants
  StringConstant list : mut: stringConstants
  ConstValue list : mut: ptrConstants
  Type : mut: currentProc
  i64 : mut: localConstCount
  i64 : mut: stackCount
  i64 : mut: tmpCount
  i32 : mut: jumpLabelCount
  bool : mut: reachable
) =:: CompilerContext

namespace: sb
  proc( stringBuilder ValType -> stringBuilder ) =>: appendValType
    switch
      EMPTY case "empty" sb.appendS return
      I32 case "i32" sb.appendS return
      I64 case "i64" sb.appendS return
      FLOAT case "float" sb.appendS return
      DOUBLE case "double" sb.appendS return
      PTR case "pointer" sb.appendS return
      REFERENCE case "reference" sb.appendS return
    end
  end
  proc( stringBuilder ValType -> stringBuilder ) =>: appendValTypeQBE
    switch
      EMPTY case break
      I32 case 'w' sb.appendC break
      I64 PTR REFERENCE case 'l' sb.appendC break
      FLOAT case 's' sb.appendC break
      DOUBLE case 'd' sb.appendC break
    end
  end
end
proc( Type : t CompilerContext ptr : context -> ValType ) =>: toValType
  context [] .program =:: program
  program [] .errors @ =:: errors
  program [] .idContext .typeContext @ =:: typeContext
  t switch
    namedType case
      t typeContext types.unwrapNamed context toValType return
    generatedType case
      t typeContext types.getGeneratedType context toValType return
    primitiveType case
      t .primitiveType switch
        TYPE case ValType .EMPTY return
        BOOL I8 I16 I32 CHAR8 CHAR16 CHAR32 case ValType .I32 return
        I64 case ValType .I64 return
        F32 case ValType .FLOAT return
        F64 case ValType .DOUBLE return
      end
      break
    intLiteral case
      t .intLiteral types.intLiteralAsInt context toValType return
    cType case
      t .cType
        types.cTypeAsType
      context toValType return
    arrayIndex case
      ValType .I64 return
    pointer case
      ValType .PTR return
    reference mutableReference procedure arrayType struct union enum case
      ValType .REFERENCE return
    undefined empty genericType autoType
    procIn procOut case
      ValType .EMPTY return
  end
end


namespace: sb
  proc( stringBuilder : sb BranchId : branch -> stringBuilder ) =>: appendBranchId
    sb
      branch .branchType switch
        START case "@start" sb.appendS break
        NEXT case "@next" sb.appendS branch .id sb.appendI break
        ERROR case "@error" sb.appendS branch .id sb.appendI break
        IF case "@if_" sb.appendS branch .id sb.appendI break
        ELSE case "@else_" sb.appendS branch .id sb.appendI break
        END_IF case "@endIf_" sb.appendS branch .id sb.appendI break
        CASE case
          "@case_" sb.appendS
          branch .id sb.appendI
          '_' sb.appendC
          branch .subId sb.appendI
         break
        DEFAULT case "@default" sb.appendS branch .id sb.appendI break
        END_SWITCH case "@endSwitch_" sb.appendS branch .id sb.appendI break
        WHILE case "@while_" sb.appendS branch .id sb.appendI break
        DO case "@do_" sb.appendS branch .id sb.appendI break
        CONTINUE_WHILE case "@continueWhile_" sb.appendS branch .id sb.appendI break
        END_WHILE case "@endWhile_" sb.appendS branch .id sb.appendI break
        END_AND_OR case "@endAndOr_" sb.appendS branch .id sb.appendI break
      end
    return
  end
end
proc(
  stringBuilder : sb
  BranchId : branch
  CompilerContext ptr mut : context
-> stringBuilder ) =>: startBranch
  branch context [] .currentBranch =
  sb
    branch sb.appendBranchId
    '\n' sb.appendC
  return
end
proc( ValType : valType CompilerContext ptr mut : context -> i64 ) =>: pushValue
  context [] .stackCount =:: oldCount
    context [] .stackInfo @
      oldCount
      valType
    StackElement new branchTree.push
    oldCount
      1 +
    context [] .stackCount =
  oldCount return
end
proc( CompilerContext ptr mut : context -> i64 ) =>: nextValueId
  context [] .stackCount =:: oldCount
    oldCount 1 +
  context [] .stackCount =
  oldCount return
end
proc( ValType : valType i32 : offset CompilerContext ptr mut : context -> i64 ) =>: replaceValue
  context nextValueId =:: newId
  context [] .stackInfo @
    offset
  branchTree.replaceAt .data =:: stackElt
  newId stackElt [] .varId =
  valType stackElt [] .valType =
  newId return
end
proc(
  FilePosition : pos
  CompilerContext ptr mut : context
-> i64 ) =>: popValue
  context [] .stackInfo @ branchTree.pop =:: tmp
  tmp .data ?? if
    tmp .data [] .varId return
  end
  "stack underflow" sb.wrap
  pos context [] .program [] .errors @ appendError
  -1 return
end
proc( CompilerContext ptr mut : context -> i64 ) =>: nextTmpId
  context [] .tmpCount =:: oldCount
    oldCount
      1 +
    context [] .tmpCount =
  oldCount return
end
proc( CompilerContext ptr mut : context -> i32 ) =>: nextJumpLabelId
  context [] .jumpLabelCount =:: oldCount
    oldCount
      1 +
    context [] .jumpLabelCount =
  oldCount return
end
proc( CompilerContext ptr mut : context -> i64 ) =>: nextLocalConstId
  context [] .localConstCount =:: oldCount
    oldCount
      1 +
    context [] .localConstCount =
  oldCount return
end

proc( Type : t CompilerContext ptr mut : context -> bool ) =>: referenceOnly
  context [] .program =:: program
  program [] .idContext .typeContext@ =:: typeContext
  t typeContext types.unwrapNamed
    ..dup .cType ?? if .cType types.cTypeAsType end
    ..dup .intLiteral ?? if .intLiteral types.intLiteralAsInt end
  =:: baseType
  baseType types.isPrimitive if
    false return
  end
  baseType typeContext types.isPointer if
    false return
  end
  ## TODO allow small composites as value-type
  true return
end
proc(
  types.TypeSize : size
  Type : t
  FilePosition : pos
  CompilerContext ptr mut : context
-> i64 ) =>: typeSizeAsInt
  context [] .program =:: program
  program [] .errors @ =:: errors
  program [] .idContext .typeContext @ =:: typeContext
  size switch
    fixed case size .fixed return
    dynamicArray case
      "dynamic arrays are not supported in this context: " sb.wrap
         t typeContext sb.appendType
      pos errors appendError
      0 return
    unknown case
      "could not determine size of type: " sb.wrap
         t typeContext sb.appendType
      pos errors appendError
      0 return
  end
end
proc(
  Type : t
  FilePosition : pos
  CompilerContext ptr mut : context
-> i64 ) =>: typeAlignmentInt
  context [] .program =:: program
  program [] .idContext .typeContext @ =:: typeContext
  t typeContext types.alignOf t pos context typeSizeAsInt return
end
proc(
  Type : t
  FilePosition : pos
  CompilerContext ptr mut : context
-> i64 ) =>: typeSizeInt
  context [] .program =:: program
  program [] .idContext .typeContext @ =:: typeContext
  t typeContext types.sizeOf t pos context typeSizeAsInt return
end
proc(
  Type : t
  FilePosition : pos
  CompilerContext ptr mut : context
-> i64 ) =>: typeStrideInt
  context [] .program =:: program
  program [] .idContext .typeContext @ =:: typeContext
  t typeContext types.strideOf t pos context typeSizeAsInt return
end
proc(
  Type : t
  i64 : i
  FilePosition : pos
  CompilerContext ptr mut : context
-> i64 ) =>: tupleEltOffsetInt
  context [] .program =:: program
  program [] .errors @ =:: errors
  program [] .idContext .typeContext @ =:: typeContext
  t i typeContext types.tupleElementOffset =:: eltOffset?
  eltOffset? optional.hasData if
    eltOffset? .data return
  end
  "could not compute offset of element " sb.wrap
    i sb.appendI
    " in tuple " sb.appendS
    t typeContext sb.appendType
  pos errors appendError
  0 return
end
proc(
  Type : t
  FilePosition : pos
  CompilerContext ptr mut : context
-> Type i64 ) =>: enumLabelInfoInt
  context [] .program =:: program
  program [] .errors @ =:: errors
  program [] .idContext .typeContext @ =:: typeContext
  t typeContext types.enumLabelInfo =:: labelOffset? =:: labelType
  labelOffset? optional.hasData if
    labelType labelOffset? .data return
  end
  "could not compute offset of label in enum " sb.wrap
    t typeContext sb.appendType
  pos errors appendError
  labelType 0 return
end

struct(
  string : blockName
  i32 : blockId
  BranchId arrayView : branchIds
  FilePosition : pos
  CompilerContext ptr mut : context
  stringBuilder ptr mut : out
) =:: MergePoint
proc(
  StackElement ptr arrayView : toMerge
  i64 : offset
  MergePoint : mergePoint
-> StackElement ) =>: mergeBranches
  mergePoint .context =:: context
  context [] .program =:: program
  program [] .errors @ =:: errors
  program [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  toMerge 0 array.get =:: rootValue
  rootValue [] .varId =:: rootId
  true =:: mut: isMerged
  1:i64 while ..dup toMerge .length < do =:: i
    toMerge i array.get [] .varId rootId != if
      false isMerged =
      i break
    end
    i 1 +
  end ..drop
  isMerged if
    rootValue [] return
  end
  1:i64 while ..dup toMerge .length < do =:: i
    toMerge i array.get [] .valType rootValue [] .valType != if
      "branches of " sb.wrap
         mergePoint .blockName sb.appendStr
         "-statement are out of sync expected: " sb.appendS
         rootValue [] .valType sb.appendValType
         " got: " sb.appendS
         toMerge i array.get [] .valType sb.appendValType
      mergePoint .pos errors appendError
      i break
    end
    i 1 +
  end ..drop
  context nextValueId =:: newId
  mergePoint .out []
    "%s" sb.appendS
    newId sb.appendI
    " =" sb.appendS
    rootValue [] .valType sb.appendValTypeQBE
    " phi " sb.appendS
    0:i64 while ..dup toMerge .length < do =:: i
      i 0 > if
        ", " sb.appendS
      end
      mergePoint .branchIds i array.get sb.appendBranchId
      " %s" sb.appendS
      toMerge i array.get [] .varId sb.appendI
      i 1 +
    end ..drop
    '\n' sb.appendC
  mergePoint .out [] =
  ## StackElement
    newId
    rootValue [] .valType
  StackElement new return
end

proc( BlockInfo : block CompilerContext ptr mut : context -> ) =>: openBlock
  context [] .openBlocks
    block list.append
  context [] .openBlocks =
end
proc(
  i32 : blockId
  CompilerContext ptr mut : context
-> ) =>: openIfBlock
  ## IfBlockInfo
    8 branchTree.NodeId list.create
    8 BranchId list.create
    8 branchTree.NodeId list.create
    8 BranchId list.create
    context [] .currentBranch
    context [] .stackInfo @ branchTree.startBranch
    -1:branchTree.NodeId
    blockId
    false
    false
  IfBlockInfo new BlockInfo .If context openBlock
end
proc(
  i32 : blockId
  CompilerContext ptr mut : context
-> ) =>: openSwitchBlock
  ## SwitchBlockInfo
    16 branchTree.NodeId list.create
    16 BranchId list.create
    context [] .stackInfo @ branchTree.startBranch
    blockId
  SwitchBlockInfo new BlockInfo .Switch context openBlock
end
proc(
  i32 : blockId
  CompilerContext ptr mut : context
-> ) =>: openWhileBlock
  ## WhileBlockInfo
    16 branchTree.NodeId list.create
    16 BranchId list.create
    16 branchTree.NodeId list.create
    16 BranchId list.create
    16 branchTree.NodeId list.create
    16 BranchId list.create
    context [] .tmpCount
    context [] .stackInfo @ branchTree.startBranch
    blockId
  WhileBlockInfo new BlockInfo .While context openBlock
  context [] .tmpCount
    context [] .program [] .whileData blockId list.at .data [] .modifiedTypes +
  context [] .tmpCount =
end
proc(
  i32 : blockId
  CompilerContext ptr mut : context
-> ) =>: openAndOrBlock
  ## SwitchBlockInfo
    16 branchTree.NodeId list.create
    16 BranchId list.create
    blockId
  AndOrBlockInfo new BlockInfo .AndOr context openBlock
end

proc(
  i32 : blockId
  FilePosition : pos
  CompilerContext ptr mut : context
-> BlockInfo ptr mut optional ) =>: findBreakableBlock
  context [] .program =:: program
  program [] .errors @ =:: errors
  context [] .openBlocks .length 1 - while ..dup 0 >= do =:: i
    context [] .openBlocks i list.at .data =:: block
    block [] .While ?? and block [] .While .blockId blockId == if
      block optional.wrap return
    end
    block [] .Switch ?? and block [] .Switch .blockId blockId == if
      block optional.wrap return
    end
    i 1 -
  end ..drop
  "could not find target of break/continue " sb.wrap
  pos errors appendError
  BlockInfo ptr mut optional.empty return
end

namespace: sb
  proc(
    stringBuilder : sb
    LabelId : label
    i64 : implId
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: appendGlobalName
    context [] .program =:: prog
    prog [] .idContext .typeContext .labelContext @ =:: labelContext
    sb
      '$' sb.appendC
      label labelContext id.labelFlags id.FLAG_EXTERN & ? if
        ## use unmodified name for extern values
        label labelContext sb.appendLabelName
        return
      end
      CONCAT_PREFIX sb.appendS
      label labelContext id.labelFlags id.FLAG_EXPORT & ? ! if
        label labelContext id.getLabelFile i64 cast sb.appendI
        "_F" sb.appendS
      end
      label labelContext id.getLabelNamespace =:: mut: mNamespace
      while mNamespace id.NAMESPACE_ID_NONE != and mNamespace 0:NamespaceId != do
        mNamespace labelContext id.namespaceName labelContext sb.appendAsciifiedStringConst
        "." string.wrap sb.appendAsciified
        mNamespace labelContext id.parentNamespace mNamespace =
      end ## XXX? reverse order
      label labelContext sb.appendAsciifiedLabelName
      implId 0 >= if
        "_I" sb.appendS
        implId sb.appendI
      end
    return
  end

  proc(
    stringBuilder : sb
    Type : t
    string : name
    bool : isStored
  -> stringBuilder ) =>: appendCompositeTypeQBE
    isStored if
      sb
        ":" sb.appendS
        name sb.appendStr
        t types.getTypeId sb.appendI
      return
    else
      sb "l" sb.appendS return
    end
  end
end
  enum( STACK LOAD ULOAD STORE ) =:: StorageType
namespace: sb
  proc(
    stringBuilder : sb
    Type : t
    StorageType : storeType
    FilePosition : pos
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: appendTypeNameQBE
    context [] .program =:: prog
    prog [] .errors @ =:: errors
    prog [] .idContext .typeContext @ =:: typeContext
    typeContext [] .labelContext @ =:: labelContext
    t switch
      namedType case
        sb
          t typeContext types.unwrapNamed storeType pos context
        appendTypeNameQBE
        return
      generatedType case
        sb
          t typeContext types.getGeneratedType storeType pos context
        appendTypeNameQBE
        return
      primitiveType case
        t .primitiveType switch
          TYPE case sb ":type" sb.appendS return break
          BOOL case
            storeType switch
              STACK case sb "w" sb.appendS return
              LOAD ULOAD case sb "ub" sb.appendS return
              STORE case sb "b" sb.appendS return
            end
            break
          I8 CHAR8 case
            storeType switch
              STACK case sb "w" sb.appendS return
              LOAD case sb t .primitiveType .I8 ?? if "sb" else "ub" end sb.appendS return
              ULOAD case sb "ub" sb.appendS return
              STORE case sb "b" sb.appendS return
            end
            break
          I16 CHAR16 case
            storeType switch
              STACK case sb "w" sb.appendS return
              LOAD case sb t .primitiveType .I16 ?? if "sh" else "uh" end sb.appendS return
              ULOAD case sb "uh" sb.appendS return
              STORE case sb "h" sb.appendS return
            end
            break
          I32 CHAR32 case sb "w" sb.appendS return
          I64 case sb "l" sb.appendS return
          F32 case sb "s" sb.appendS return
          F64 case sb "d" sb.appendS return
        end
        break
      intLiteral case
        sb
          t .intLiteral types.intLiteralAsInt storeType pos context
        appendTypeNameQBE return
      cType case
        sb
          t .cType types.cTypeAsType
          ..dup .undefined ?? if
            ..drop.2 break
          end
        storeType pos context appendTypeNameQBE
        return
      arrayIndex pointer reference mutableReference procedure case
        sb "l" sb.appendS return ## size or pointer
      arrayType case
        sb t "array" string.wrap storeType .STACK ?? ! appendCompositeTypeQBE return
        break
      struct case
        sb t "struct" string.wrap storeType .STACK ?? ! appendCompositeTypeQBE return
        break
      union case
        sb t "union" string.wrap storeType .STACK ?? ! appendCompositeTypeQBE return
        break
      enum case
        sb t "enum" string.wrap storeType .STACK ?? ! appendCompositeTypeQBE return
        break
      undefined empty genericType autoType
      procIn procOut case
        break
    end
    "unsupported type " sb.wrap
      t typeContext sb.appendType
    pos errors appendError
    sb return
  end
  proc(
    stringBuilder : sb
    i64 : index
    LabelId : labelId
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: appendArgName
    sb
      "%a" sb.appendS
      index sb.appendI
    return
  end
  proc(
    stringBuilder : sb
    i64 : index
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: appendOutArgName
    sb
      "%o" sb.appendS
      index sb.appendI
    return
  end
  proc(
    stringBuilder : sb
    Type : procType
    FilePosition : pos
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: appendProcSignature
    context [] .program =:: prog
    prog [] .errors @ =:: errors
    prog [] .idContext .typeContext @ =:: typeContext
    typeContext [] .labelContext @ =:: labelContext
    procType typeContext types.getCallConvention ..drop =:: callConvention
    procType typeContext types.getProcIn ..drop =:: inType
    inType typeContext types.compositeElts =:: args
    procType typeContext types.getProcOutArgs ..drop =:: outArgs
    false =:: mut: hasArgs
    sb
      "(" sb.appendS
      0:i64 while ..dup args .length < do =:: i
        args i types.compositeElts.get =:: mut: arg
        arg typeContext types.containsGeneric if
          arg typeContext types.unwrapReference typeContext types.isArray if
            arg
              false typeContext types.newReferenceType
            arg =
          else arg typeContext types.isPointer ! _if
            "unexpected generic argument: " sb.wrap
              arg typeContext sb.appendType
            pos errors appendError
          end
        end
        inType i typeContext types.compositeGetLabel =:: label
        arg typeContext types.isEmpty if
          ## skip empty arguments
          i 1 + continue
        end
        label labelContext id.labelFlags id.FLAG_STATIC & ? if
          i 1 + continue
        end
        hasArgs if
          ',' sb.appendC
        end
        true hasArgs =
        arg StorageType .LOAD pos context appendTypeNameQBE
        ' ' sb.appendC
        i inType i typeContext types.compositeGetLabel context appendArgName
        i 1 +
      end ..drop
      0:i64 while ..dup outArgs .length < do =:: i
          outArgs i array.get =:: arg
          arg typeContext types.isEmpty if
            ## skip empty arguments
            i 1 + continue
          end
          hasArgs if
            ',' sb.appendC
          end
          true hasArgs =
          "l " sb.appendS ## all out arguments are pointers
          i context appendOutArgName
        i 1 +
      end ..drop
      ")" sb.appendS
    return
  end
  proc(
    stringBuilder : sb
    StringConstant : value
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: appendStringConstQBE
    context [] .program =:: prog
    prog [] .idContext .typeContext .labelContext @ =:: labelContext
    sb
      0:i64 while ..dup value .length < do =:: i
        "b " sb.appendS
        value i labelContext id.scCharAt i32 cast.u 0xff & sb.appendI
        ',' sb.appendC
        i 1 +
      end ..drop
      "b 0" sb.appendS
    return
  end
  proc(
    stringBuilder : sb
    StringConstant : value
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: appendStringPtrConstQBE
    sb
      '$' sb.appendC
      STRING_CONST_NAME sb.appendS
      context [] .stringConstants
        ..dup .length =:: strId
        value list.append
      context [] .stringConstants =
      strId sb.appendI
    return
  end
  proc(
    stringBuilder : sb
    ConstValue : value
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: appendPtrConstQBE
    sb
      '$' sb.appendC
      PTR_CONST_NAME sb.appendS
      context [] .ptrConstants
        $ .length =:: ptrId
        value list.append
      context [] .ptrConstants =
      ptrId sb.appendI
    return
  end
  proc(
    stringBuilder : sb
    ConstValue : value
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: appendPtrConstDataQBE
    context [] .program =:: prog
    prog [] .idContext@ =:: idContext
    idContext .constContext@ =:: constContext
    idContext .typeContext@ =:: typeContext
    typeContext .labelContext@ =:: labelContext
    value .str16 ?? if
      value .str16 constContext sc16AsStr =:: str16
      sb
        0:i64 while ..dup str16 .length < do =:: i
          "h " sb.appendS
          str16 i array.get i32 cast.u sb.appendI
          ',' sb.appendC
          i 1 +
        end ..drop
      return
    else value .str32 ?? _if
      value .str32 constContext sc32AsStr =:: str32
      sb
        0:i64 while ..dup str32 .length < do =:: i
          "h " sb.appendS
          str32 i array.get sb.appendI
          ',' sb.appendC
          i 1 +
        end ..drop
      return
    end
    ..unreachable ## unknown pointer constant type
  end
  proc(
    stringBuilder : sb
    Type : t
    ConstValue : value
    bool : isGlobal
    FilePosition : pos
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: appendConstQBE
    context [] .program =:: prog
    prog [] .errors @ =:: errors
    prog [] .idContext .typeContext @ =:: typeContext
    typeContext [] .labelContext @ =:: labelContext
    prog [] .idContext .constContext @ =:: constContext
    sb
      isGlobal and
          t typeContext types.unwrapNamed types.isPrimitive or
          t typeContext types.isPointer if
        t StorageType .STORE pos context sb.appendTypeNameQBE
        ' ' sb.appendC
      end
      value switch
        boolean case
          value .boolean if '1' else '0' end sb.appendC return
        int case
          t typeContext types.isPointer if
            ## treat pointer constants as integers of type iPtr
            types.primitive.I_PTR
          else
            t typeContext types.unwrapNamed
            ..dup .arrayIndex ?? if ..drop
              types.primitive.I_SIZE
            end
            ..dup .cType ?? if .cType types.cTypeAsType end
            ..dup .intLiteral ?? if .intLiteral types.intLiteralAsInt end
          end =:: numType
          numType types.isPrimitive if
            numType typeContext types.primitiveValue switch
              I8  CHAR8  case value .int 0xff &   sb.appendI return
              I16 CHAR16 case value .int 0xffff & sb.appendI return
              I32 CHAR32 case value .int i32 cast sb.appendI return
              I64 case value .int sb.appendI return
              F32 case value .int f32 cast f32.bits sb.appendI return
              F64 case value .int f64 cast f64.bits sb.appendI return
              BOOL TYPE case break
            end
          end
          "unexpected type for integer: " sb.wrap
            t typeContext sb.appendType
            " number-type: " sb.appendS
            numType typeContext sb.appendType
          pos errors appendError
          return
        break
        chr case value .chr i32 cast.u sb.appendI return
        break
        Float case
          t typeContext types.unwrapNamed
            ..dup .cType ?? if .cType types.cTypeAsType end
            ..dup .intLiteral ?? if .intLiteral types.intLiteralAsInt end
          =:: numType
          numType types.primitive.F32 types.typeEquals if
            value .Float f32 cast f32.bits sb.appendI
          else numType types.primitive.F64 types.typeEquals _if
            value .Float f64.bits sb.appendI
          else
            "unexpected type for float: " sb.wrap
              t typeContext sb.appendType
              " number-type: " sb.appendS
              numType typeContext sb.appendType
            pos errors appendError
          end
          return
        enumLabel case break
        genericArg case
          value .genericArg pos context appendGenericArg return
        str case
          ## appendStringPtrConstQBE
            value .str
            context
          appendStringPtrConstQBE
          return
        str16 str32 case
          ## appendPtrConstQBE
            value
            context
          appendPtrConstQBE
          return
        arrayConstant case
          isGlobal ! if
            break
          end
          t typeContext types.isArray if
            t typeContext types.getBaseType =:: base
            base pos context typeSizeInt =:: baseSize
            base pos context typeStrideInt =:: baseStride
            value .arrayConstant constContext constArrayAsArray =:: elts
            0:i64 while ..dup elts .length < do =:: i
              i 0 > if
                ',' sb.appendC
              end
              base elts i array.get true pos context appendConstQBE
              baseSize baseStride < if
                ",z " sb.appendS
                baseStride baseSize - sb.appendI
              end
              i 1 +
            end ..drop
            return
          else t typeContext types.isTuple _if
            ## TODO ensure elements are ordered by memory location
            t typeContext types.compositeElts =:: types
            value .arrayConstant constContext constArrayAsArray =:: elts
            0:i64 =:: mut: offset
            0:i64 while ..dup elts .length < do =:: i
              types i types.compositeElts.get =:: elt
              t i pos context tupleEltOffsetInt =:: eltOffset
              i 0 > if
                ',' sb.appendC
              end
              offset eltOffset < if
                "z " sb.appendS
                eltOffset offset - sb.appendI
                ',' sb.appendC
                eltOffset offset =
              end
              ## appendConstQBE
                elt
                elts i array.get
                true
                pos
              context appendConstQBE
              offset
                elt pos context typeSizeInt +
              offset =
              i 1 +
            end ..drop
            t pos context typeSizeInt =:: size
            offset size < if
              ",z " sb.appendS
              size offset - sb.appendI
            end
            return
          end
        break
        union case
          isGlobal ! if
            break ## XXX? support small unions as local constants
          end
          t typeContext types.isEnum ! and t typeContext types.isUnion ! if
            "unsupported type for union constant: " sb.wrap
              t typeContext sb.appendType
              " expected enum or union" sb.appendS
            pos errors appendError
            return
          end
          t pos context enumLabelInfoInt =:: labelOffset =:: labelType
          value .union .eltIndex =:: eltIndex
          eltIndex 0 < if break end
          eltIndex t typeContext types.compositeEltCount >= if
            break
          end
          t eltIndex typeContext types.compositeGetElement =:: eltType
          0:i64 =:: mut: offset
          false =:: mut: needComma
          eltType typeContext types.isEmpty ! if
            ## appendConstQBE
              eltType
              value constContext constUnionElement
              isGlobal
              pos
              context
            appendConstQBE
            offset
              eltType pos context typeSizeInt +
            offset =
            true needComma =
          end
          t pos context typeSizeInt =:: size
          offset labelOffset < if
            needComma if ',' sb.appendC end
            "z " sb.appendS
            labelOffset offset - sb.appendI
            true needComma =
          end
          labelType typeContext types.isEmpty ! if
            needComma if ',' sb.appendC end
            ## appendConstQBE
              labelType
              eltIndex ConstValue .int
              isGlobal
              pos
              context
            appendConstQBE
          end
          return
        none wildCard typeId
            procedure procedureBundle case
        break
      end
      isGlobal if
        "unsupported constant: " sb.wrap
          value constContext typeContext sb.appendConstant
        pos errors appendError
        return
      end
      context nextLocalConstId =:: constId
      context [] .localConstants
        ## LocalConst
          t
          value
          pos
          constId
        LocalConst new list.append
      context [] .localConstants =
      "$" sb.appendS
      LOCAL_CONST_NAME sb.appendS
      constId sb.appendI
    return
  end
  proc(
    stringBuilder : sb
    FilePosition : pos
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: appendLocalConstants
    context [] .program [] .idContext .typeContext @ =:: typeContext
    sb
      0:i64 while ..dup context [] .localConstants .length < do =:: i
        context [] .localConstants i list.at .data =:: constant
        "data $" sb.appendS
        LOCAL_CONST_NAME sb.appendS
        constant [] .id sb.appendI
        " = align " sb.appendS
        constant [] .valType pos context typeAlignmentInt sb.appendI
        " {" sb.appendS
        constant [] .valType constant [] .value true constant [] .pos context appendConstQBE
        "}\n" sb.appendS
        i 1 +
      end ..drop
      context [] .localConstants
        list.clear
      context [] .localConstants =
    return
  end

  proc(
    stringBuilder : sb
    Type : t
    FilePosition : pos
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: startTypeDeclaration
    sb
      "type " sb.appendS
      t StorageType .LOAD pos context appendTypeNameQBE
      " = {" sb.appendS
    return
  end
  proc(
    stringBuilder : sb
    Type : t
    FilePosition : pos
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: startEltTypeDeclaration
    sb
      "type " sb.appendS
      t StorageType .LOAD pos context appendTypeNameQBE
      "_elt" sb.appendS
      " = {" sb.appendS
    return
  end
  proc(
    stringBuilder : sb
    Type : t
    FilePosition : pos
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: eltTypeName
    sb
      t StorageType .LOAD pos context appendTypeNameQBE
      "_elt" sb.appendS
    return
  end
  proc(
    stringBuilder
  -> stringBuilder ) =>: endTypeDeclaration
    "}\n" sb.appendS return
  end
  proc(
    stringBuilder : sb
    Type : t
    FilePosition : pos
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: appendTypeDeclarationQBE
    context [] .program =:: prog
    prog [] .errors @ =:: errors
    prog [] .idContext .typeContext @ =:: typeContext
    typeContext [] .labelContext @ =:: labelContext
    prog [] .idContext .constContext @ =:: constContext
    t types.isNamedType t types.isGeneratedType | if
      sb return ## ignore named types
    end
    t typeContext types.isEmpty if
      sb return ## ignore empty types
    end
    t typeContext types.containsGeneric if
      sb return ## ignore generic types
    end
    t typeContext types.isArray and
        t typeContext types.isFixedSize if
      t typeContext types.getArraySize =:: sizes
      1:i64 =:: mut: S
      0:i64 while ..dup sizes .length < do =:: i
        sizes i array.get =:: size
        size .sizeType .int ?? ! if
          sb return ## no declaration for var-size array
        end
        S size .value * S =
        i 1 +
      end ..drop
      t typeContext types.getBaseType =:: baseType
      baseType pos context typeSizeInt =:: baseSize
      baseType pos context typeStrideInt =:: baseStride
      sb
        baseSize baseStride < if
          t pos context startEltTypeDeclaration
            ## appendTypeNameQBE
              baseType
              StorageType .STORE
              pos
            context sb.appendTypeNameQBE
            ",b " sb.appendS
            baseStride baseSize - sb.appendI
          endTypeDeclaration
        end
        t pos context startTypeDeclaration
        baseSize baseStride < if
           t pos context eltTypeName
        else
          ## appendTypeNameQBE
            baseType
            StorageType .STORE
            pos
          context sb.appendTypeNameQBE
        end
        ' ' sb.appendC
        S sb.appendI
      endTypeDeclaration return
    end
    t typeContext types.isTuple if
      t typeContext types.compositeElts =:: elts
      0:i64 =:: mut: offset
      false =:: mut: hasElt
      sb t pos context startTypeDeclaration
        0:i64 while ..dup elts .length < do =:: i
          elts i types.compositeElts.get =:: elt
          elt typeContext types.isEmpty if
            i 1 + continue
          end
          t i pos context tupleEltOffsetInt =:: eltOffset
          hasElt if
            ',' sb.appendC
          end
          true hasElt =
          offset eltOffset <= assert "offset <= eltOffset"
          offset eltOffset < if
            "b " sb.appendS
            eltOffset offset - sb.appendI
            ',' sb.appendC
            eltOffset offset =
          end
          ## appendTypeNameQBE
            elt
            StorageType .STORE
            pos
          context sb.appendTypeNameQBE
          offset
            elt pos context typeSizeInt +
          offset =
          i 1 +
        end ..drop
        t pos context typeSizeInt =:: size
        offset size < if
          ",b " sb.appendS
          size offset - sb.appendI
        end
      endTypeDeclaration return
    end
    t typeContext types.isUnion or t typeContext types.isEnum if
      t typeContext types.isTaggedUnion =:: isTagged
      t typeContext types.compositeElts =:: elts
      false =:: mut: hasElt
      0:i64 =:: mut: bodySize
      sb
        t typeContext types.compositeFlags types.COMP_FLAG_EMPTY & ? ! if
          isTagged if
            t pos context startEltTypeDeclaration
          else
            t pos context startTypeDeclaration
          end
          0:i64 while ..dup elts .length < do =:: i
            elts i types.compositeElts.get =:: elt
            elt typeContext types.isEmpty if
              i 1 + continue
            end
            elt pos context typeSizeInt =:: eltSize
            eltSize bodySize > if
              eltSize bodySize =
            end
            "{" sb.appendS
              ## appendTypeNameQBE
                elt
                StorageType .STORE
                pos
              context sb.appendTypeNameQBE
            "}" sb.appendS
            true hasElt =
            i 1 +
          end ..drop
          endTypeDeclaration
        end
      isTagged ! if return end
      t pos context enumLabelInfoInt =:: labelOffset =:: labelType
      t pos context startTypeDeclaration
        t typeContext types.compositeFlags types.COMP_FLAG_EMPTY & ? ! if
          t pos context eltTypeName
          ',' sb.appendC
        end
        bodySize labelOffset < if
          "b " sb.appendS
          labelOffset bodySize - sb.appendI
          ',' sb.appendC
        end
        ## appendTypeNameQBE
          labelType
          StorageType .STORE
          pos
        context sb.appendTypeNameQBE
      endTypeDeclaration return
    end
    sb return
  end
  proc( stringBuilder : sb string : str -> stringBuilder ) =>: appendEscapedString
    sb
      0:i64 while ..dup str .length < do =:: i
          str i string.charAt appendEscapedChrC
        i 1 +
      end ..drop
    return
  end
  proc(
    stringBuilder : sb
    FilePosition : pos
  -> stringBuilder ) =>: appendPosQBE
    sb
      "dbgloc " sb.appendS
      pos .line sb.appendI
      ',' sb.appendC
      pos .posInLine sb.appendI
      " ## " sb.appendS
      pos .fileName sb.appendEscapedString
      '\n' sb.appendC
    return
  end
end

proc( string : fileName ProgramContext ptr : prog -> FileId ) =>: findFileId
  0:i64 while ..dup prog [] .progFiles .length < do =:: i
    prog [] .progFiles i list.at .data [] .fileName sb.asStr =:: currentName
    fileName currentName string.eq if
      i FileId cast return
    end
    i 1 +
  end ..drop
  FILE_ID_NONE return
end

proc(
  stringBuilder : sb
  FilePosition : pos
  ProgramContext ptr : prog
-> stringBuilder ) =>: appendPosPrintfArgs
  sb
    ",l " sb.appendS
    pos .fileName .length sb.appendI
    ",l $" sb.appendS
    FILE_NAME_NAME sb.appendS
    pos .fileName prog findFileId i64 cast sb.appendI
    ",w " sb.appendS
    pos .line sb.appendI
    ",w " sb.appendS
    pos .posInLine sb.appendI
  return
end

proc(
  stringBuilder
  LabelId  : labelId
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: appendGenericArg
  context .program =:: prog
  prog [] .errors@ =:: errors
  prog [] .idContext@ =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  context [] .currentProc
    typeContext types.getProcIn ..drop
  =:: progIn
  progIn
    labelId
    typeContext
  types.compositeFindLabel =:: index
  index -1 != if
    ## appendArgName
      index
      labelId
      context
    sb.appendArgName return
  end
  "cannot find generic argument: " sb.wrap
    labelId labelContext sb.appendLabelName
  pos errors appendError
end

union( i64 : constant i64 : stackId LabelId : autoArg i64 : localId i64 : tmpId ) =:: IntValue
proc(
  stringBuilder : sb
  ValType : valType
  char8 : valStackType
  i64 : valId
  string : cmpType
  IntValue : value
  BranchId : ifBranch
  BranchId : elseBranch
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: appendCmpInt
  context nextTmpId =:: tmpId
  sb
    "%t" sb.appendS
    tmpId sb.appendI
    " =w c" sb.appendS
    cmpType sb.appendStr
    valType sb.appendValTypeQBE
    " %" sb.appendS
    valStackType sb.appendC
    valId sb.appendI
    ", " sb.appendS
    value switch
      constant case value .constant sb.appendI break
      stackId case "%s" sb.appendS value .stackId sb.appendI break
      localId case "%l" sb.appendS value .localId sb.appendI break
      tmpId case "%t" sb.appendS value .tmpId sb.appendI break
      autoArg case value .autoArg pos context appendGenericArg break
    end
    "\njnz %t" sb.appendS
    tmpId sb.appendI
    ", " sb.appendS
    ifBranch sb.appendBranchId
    ", " sb.appendS
    elseBranch sb.appendBranchId
    "\n" sb.appendS
  return
end
proc(
  stringBuilder : sb
  IntValue : size
  i64 : valId
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: appendIndexCheck
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  ## BranchId
    BranchType .NEXT
    context nextJumpLabelId
    0
  BranchId new =:: check1Branch
  ## BranchId
    BranchType .ERROR
    context nextJumpLabelId
    0
  BranchId new =:: errorBranch
  ## BranchId
    BranchType .NEXT
    context nextJumpLabelId
    0
  BranchId new =:: okBranch
  context nextTmpId =:: c1
  context nextTmpId =:: c2
  sb
    "## check index\n" sb.appendS
    ## cmp int
      ValType .I64
      's' valId
      "slt" string.wrap
      0 IntValue .constant
      errorBranch
      check1Branch
    pos context appendCmpInt
    check1Branch sb.appendBranchId
    "\n" sb.appendS
    ## cmp int
      ValType .I64
      's' valId
      "sge" string.wrap
      size
      errorBranch
      okBranch
    pos context appendCmpInt
    errorBranch sb.appendBranchId
    "\ncall $printf (l $" sb.appendS
    CHECK_INDEX_FORMAT sb.appendS
    ", ...,l %s" sb.appendS
    valId sb.appendI
    ",l " sb.appendS
    size switch
      constant case size .constant sb.appendI break
      stackId case "%s" sb.appendS size .stackId sb.appendI break
      localId case "%l" sb.appendS size .localId sb.appendI break
      tmpId case "%t" sb.appendS size .tmpId sb.appendI break
      autoArg case size .autoArg pos context appendGenericArg break
    end
    pos prog appendPosPrintfArgs
    ")\n" sb.appendS
    "call $exit (w 1)\n" sb.appendS ## use exit for flushing stdout
    okBranch context startBranch
  return
end

proc(
  stringBuilder : sb
  Type : enumType
  i64 : valId
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder i64 ValType ) =>: loadEnumLabel
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  enumType pos context enumLabelInfoInt =:: labelOffset =:: labelType
  labelType typeContext types.primitiveValue types.sizeOfPrimitive =:: numBytes
  context nextTmpId =:: labelPtr
  context nextTmpId =:: mut: label
  sb
    "%t" sb.appendS
    labelPtr sb.appendI
    " =l add %s" sb.appendS
    valId sb.appendI
    ", " sb.appendS
    labelOffset sb.appendI
    "\n%t" sb.appendS
    label sb.appendI
    " =w load" sb.appendS
    labelType StorageType .ULOAD pos context sb.appendTypeNameQBE
    " %t" sb.appendS
    labelPtr sb.appendI
    numBytes 4 < if
      label =:: oldLabel
      context nextTmpId label =
      "\n%t" sb.appendS
      label sb.appendI
      " =w ext" sb.appendS
      labelType StorageType .ULOAD pos context sb.appendTypeNameQBE
      " %t" sb.appendS
      oldLabel sb.appendI
    end
    '\n' sb.appendC
  label ValType .I32 return
end
proc(
  stringBuilder : sb
  Type : enumType
  char8  : stackType
  i64 : valId
  i64 : newLabel
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: storeEnumLabel
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  enumType pos context enumLabelInfoInt =:: labelOffset =:: labelType
  labelType .empty ?? if sb return end
  context nextTmpId =:: labelPtr
  sb
    "%t" sb.appendS
    labelPtr sb.appendI
    " =l add %" sb.appendS
    stackType sb.appendC
    valId sb.appendI
    ", " sb.appendS
    labelOffset sb.appendI
    "\nstore" sb.appendS
    labelType StorageType .STORE pos context sb.appendTypeNameQBE
    ' ' sb.appendC
    newLabel sb.appendI
    ", %t" sb.appendS
    labelPtr sb.appendI
    '\n' sb.appendC
  return
end
proc(
  stringBuilder : sb
  Type : enumType
  i64 : valId
  i64 : expectedIndex
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder i64 i64 ValType ) =>: checkEnumIndex
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  sb
    ## loadEnumLabel
      enumType
      valId
      pos
    context loadEnumLabel =:: labelType =:: labelId
    context nextTmpId =:: c
    "%t" sb.appendS
    c sb.appendI
    " =w ceq" sb.appendS
    labelType sb.appendValTypeQBE
    " %t" sb.appendS
    labelId sb.appendI
    ", " sb.appendS
    expectedIndex sb.appendI
    '\n' sb.appendC
  c labelId labelType return
end

proc(
  stringBuilder : sb
  Type : enumType
  i64 : valId
  i64 : expectedIndex
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: appendEnumCheck
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  ## BranchId
    BranchType .ERROR
    context nextJumpLabelId
    0
  BranchId new =:: errorBranch
  ## BranchId
    BranchType .NEXT
    context nextJumpLabelId
    0
  BranchId new =:: okBranch
  sb
    "## check enum \n" sb.appendS
    enumType valId expectedIndex pos context checkEnumIndex =:: labelType =:: label =:: c
    "jnz %t" sb.appendS
    c sb.appendI
    ", " sb.appendS
    okBranch sb.appendBranchId
    ", " sb.appendS
    errorBranch sb.appendBranchId
    '\n' sb.appendC
    errorBranch sb.appendBranchId
    "\ncall $printf (l $" sb.appendS
    CHECK_ENUM_FORMAT sb.appendS
    ", ...," sb.appendS
    labelType sb.appendValTypeQBE
    " %t" sb.appendS
    label sb.appendI
    ",w " sb.appendS
    expectedIndex sb.appendI
    pos prog appendPosPrintfArgs
    ")\n" sb.appendS
    "call $exit (w 1)\n" sb.appendS ## use exit for flushing stdout
    okBranch context startBranch
  return
end

proc(
  stringBuilder : sb
  Type : tupleType
  i64 : tupleId
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: flattenTupleQBE
  context [] .program =:: prog
  prog [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  tupleType typeContext types.compositeElts =:: elts
  sb
    0:i64 while ..dup elts .length < do =:: i
      elts i types.compositeElts.get =:: eltType
      eltType context toValType =:: eltValType
      tupleType i pos context tupleEltOffsetInt =:: eltOffset
      eltType typeContext types.isEmpty if
        i 1 - continue
      end
      "%t" sb.appendS
        context nextTmpId =:: eltPtrId
      eltPtrId sb.appendI
      " =l add %s" sb.appendS
      tupleId sb.appendI
      ", " sb.appendS
      eltOffset sb.appendI
      '\n' sb.appendC
      eltValType context pushValue =:: eltId
      "%s" sb.appendS
      eltId sb.appendI
      eltType context referenceOnly if
        eltType pos context false appendAlloc ..drop
        "blit %t" sb.appendS
      else
        " =" sb.appendS
        eltValType sb.appendValTypeQBE
        " load" sb.appendS
        eltType StorageType .LOAD pos context sb.appendTypeNameQBE
        " %t" sb.appendS
      end
      eltPtrId sb.appendI
      eltType context referenceOnly if
        ", %s" sb.appendS
        eltId
        sb.appendI
        ',' sb.appendC
        eltType pos context typeSizeInt sb.appendI
      end
      '\n' sb.appendC
      i 1 +
    end ..drop
  return
end
proc(
  stringBuilder : sb
  Type : tupleType
  char8 : dataPtrType
  i64 : dataPtrId
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: initializeTupleQBE
  context [] .program =:: prog
  prog [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  tupleType typeContext types.compositeElts =:: elts
  sb
    elts .length 1 - while ..dup 0 >= do =:: i
      elts i types.compositeElts.get =:: eltType
      tupleType i pos context tupleEltOffsetInt =:: eltOffset
      eltType typeContext types.isEmpty if
        i 1 - continue
      end
      "%t" sb.appendS
        context nextTmpId =:: eltPtrId
      eltPtrId sb.appendI
      " =l add %" sb.appendS
      dataPtrType sb.appendC
      dataPtrId sb.appendI
      ", " sb.appendS
      eltOffset sb.appendI
      '\n' sb.appendC
      eltType context referenceOnly if
        "blit %s" sb.appendS
      else
        "store" sb.appendS
        eltType StorageType .STORE pos context sb.appendTypeNameQBE
        " %s" sb.appendS
      end
      pos context popValue sb.appendI
      ", %t" sb.appendS
      eltPtrId sb.appendI
      eltType context referenceOnly if
        ',' sb.appendC
        eltType pos context typeSizeInt sb.appendI
      end
      '\n' sb.appendC
      i 1 -
    end ..drop
  return
end
proc(
  stringBuilder : sb
  Type : valType
  FilePosition : pos
  CompilerContext ptr mut : context
  bool : createId
-> stringBuilder i64 ) =>: appendAlloc
  context [] .program =:: prog
  prog [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  -1:i64 =:: mut: tmpId
  sb
    createId if
      context nextTmpId tmpId =
      "%t" sb.appendS
      tmpId sb.appendI
    end
    " =l alloc" sb.appendS
    valType pos context typeAlignmentInt 4 i64.max sb.appendI
    ' ' sb.appendC
    valType pos context typeSizeInt  4 i64.max sb.appendI
    '\n' sb.appendC
  tmpId return
end

proc( ConstValue : label -> i64 ) =>: labelAsInt
  label .int ?? if
    label .int return
  end
  label .chr ?? if
    label .chr i64 cast.u return
  end
  label .enumLabel ?? if
    label .enumLabel return
  end
  ..unreachable
end
proc(
  stringBuilder : sb
  ValType : valType
  i64 : valId
  i32 : switchId
  LabelData arrayView : labels
  i64 optional : lower
  i64 optional : upper
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: appendSwitchJumpTree
  labels .length 3 <= if
    false =:: mut: contiguous
    labels .length =:: mut: loopCount
    lower optional.hasData and upper optional.hasData and
        upper .data lower .data - labels .length == contiguous =
        contiguous if
      loopCount 1 - loopCount =
    end
    sb
      0:i64 while ..dup loopCount < do =:: i
        ## BranchId
          BranchType .CASE
          switchId
          labels i array.at .data [] .caseId
        BranchId new =:: caseBranch
        ## BranchId
          BranchType .NEXT
          context nextJumpLabelId
          0
        BranchId new =:: nextBranch
        labels i array.get .value labelAsInt =:: cmpVal
        ## cmp int
          valType
          't' valId
          "eq" string.wrap
          cmpVal IntValue .constant
          caseBranch
          nextBranch
        pos context appendCmpInt
        nextBranch sb.appendBranchId
        '\n' sb.appendC
        i 1 +
      end ..drop
      "jmp " sb.appendS
      contiguous if
        ## BranchId
          BranchType .CASE
          switchId
          labels loopCount array.at .data [] .caseId
        BranchId new sb.appendBranchId
        '\n' sb.appendC
      else
        ## BranchId
          BranchType .DEFAULT
          switchId
          0
        BranchId new sb.appendBranchId
        '\n' sb.appendC
      end
    return
  end
  labels .length 2 / =:: p
  ## BranchId
    BranchType .NEXT
    context nextJumpLabelId
    0
  BranchId new =:: ltBranch
  ## BranchId
    BranchType .NEXT
    context nextJumpLabelId
    0
  BranchId new =:: geBranch
  labels p array.get .value labelAsInt =:: cmpVal
  labels p array.cutIndex =:: lElts =:: rElts
  sb
    ## cmp int
      valType
      't' valId
      "slt" string.wrap
      cmpVal IntValue .constant
      ltBranch
      geBranch
    pos context appendCmpInt
    ltBranch sb.appendBranchId
    '\n' sb.appendC
    ## appendSwitchJumpTree
      valType
      valId
      switchId
      lElts
      lower
      upper optional.isEmpty if
        cmpVal optional.wrap
      else
        upper .data cmpVal i64.min optional.wrap
      end
      pos context
    appendSwitchJumpTree
    geBranch sb.appendBranchId
    '\n' sb.appendC
    ## appendSwitchJumpTree
      valType
      valId
      switchId
      rElts
      lower optional.isEmpty if
        cmpVal optional.wrap
      else
        lower .data cmpVal i64.max optional.wrap
      end
      upper
      pos context
    appendSwitchJumpTree
  return
end
proc(
  LabelData : a
  LabelData : b
  CompilerContext ptr mut : context
-> i32 ) =>: labelCmp
  a .value labelAsInt =:: aInt
  b .value labelAsInt =:: bInt
  aInt bInt == if
    0 return
  end
  aInt bInt < if -1 else 1 end return
end
proc(
  stringBuilder : sb
  Type : switchType
  i64 : valId
  i32 : switchId
  LabelData list : labels
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: appendSwitchTable
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  ValType : valType
  i64 : tmpId
  labels labelCmp @ context list.sort
  sb
    "## switch\n" sb.appendS
    switchType typeContext types.isTaggedUnion if
      ## loadEnumLabel
        switchType
        valId
        pos
      context loadEnumLabel valType = tmpId =
    else switchType typeContext types.isInt or switchType typeContext types.isChar _if
      switchType
        typeContext types.primitiveValue
      types.sizeOfPrimitive =:: numBytes
      context nextTmpId tmpId =
      switchType context toValType valType =
      "%t" sb.appendS
      tmpId sb.appendI
      " =" sb.appendS
      valType sb.appendValTypeQBE
      numBytes 4 < if
        " ext" sb.appendS
        switchType
          StorageType .ULOAD
        pos context sb.appendTypeNameQBE
        " %s" sb.appendS
      else
        " copy %s" sb.appendS
      end
      valId sb.appendI
      '\n' sb.appendC
    else
      "unsupported type in switch: " sb.wrap
        switchType typeContext sb.appendType
      pos errors appendError
      return
    end
    ## appendJumpTable
      valType
      tmpId
      switchId
      labels list.asArray
      i64 optional.empty
      i64 optional.empty
      pos context
    appendSwitchJumpTree
  return
end

proc(
  stringBuilder : sb
  string : name
  ValType : valType
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: appendUnaryOperator
  pos context popValue =:: arg
  sb
    "%s" sb.appendS
    valType context pushValue sb.appendI
    " =" sb.appendS
    valType sb.appendValTypeQBE
    ' ' sb.appendC
    name sb.appendStr
    " %s" sb.appendS
    arg sb.appendI
    '\n' sb.appendC
  return
end
proc(
  stringBuilder : sb
  string : name
  ValType : valType
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: appendBinaryOperator
  pos context popValue =:: arg2
  pos context popValue =:: arg1
  sb
    "%s" sb.appendS
    valType context pushValue sb.appendI
    " =" sb.appendS
    valType sb.appendValTypeQBE
    ' ' sb.appendC
    name sb.appendStr
    " %s" sb.appendS
    arg1 sb.appendI
    ", %s" sb.appendS
    arg2 sb.appendI
    '\n' sb.appendC
  return
end
proc(
  stringBuilder : sb
  string : name
  ValType : resValue
  ValType : arg2Value
  bool : signed
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: appendMixedDivisionOperator
  pos context popValue =:: arg2
  pos context popValue =:: arg1
  context nextTmpId =:: tmpId
  sb
    "%t" sb.appendS
    tmpId sb.appendI
    " =" sb.appendS
    resValue sb.appendValTypeQBE
    " ext" sb.appendS
    signed if 's' else 'u' end sb.appendC
    arg2Value sb.appendValTypeQBE
    " %s" sb.appendS
    arg2 sb.appendI
    '\n' sb.appendC
    "%s" sb.appendS
    resValue context pushValue sb.appendI
    " =" sb.appendS
    resValue sb.appendValTypeQBE
    ' ' sb.appendC
    name sb.appendStr
    " %s" sb.appendS
    arg1 sb.appendI
    ", %t" sb.appendS
    tmpId sb.appendI
    '\n' sb.appendC
  return
end
proc(
  stringBuilder : sb
  string : cmpType
  ValType : valType
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: appendComparisonOperator
  pos context popValue =:: arg2
  pos context popValue =:: arg1
  sb
    "%s" sb.appendS
    ValType .I32 context pushValue sb.appendI
    " =w c" sb.appendS
    cmpType sb.appendStr
    valType sb.appendValTypeQBE
    " %s" sb.appendS
    arg1 sb.appendI
    ", %s" sb.appendS
    arg2 sb.appendI
    '\n' sb.appendC
  return
end
proc(
  stringBuilder : sb
  Type : src
  bool : signed
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: extendArguments
  i64 2 array new =:: mut: args
  context [] .program =:: prog
  prog [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  src typeContext types.unwrapNamed .cType ?? if
    sb
      src typeContext types.unwrapNamed .cType types.cTypeAsType
      signed
      pos
      context
    extendArguments return
  end
  src typeContext types.unwrapNamed .intLiteral ?? if
    sb
      src typeContext types.unwrapNamed .intLiteral types.intLiteralAsInt
      signed
      pos
      context
    extendArguments return
  end
  src typeContext types.isInt ! if
    sb return
  end
  src typeContext types.primitiveValue types.sizeOfPrimitive 4 >= if
    sb return
  end
  pos context popValue args @ 1 [] =
  pos context popValue args @ 0 [] =
  sb
    0 while ..dup 2 < do =:: i
      "%s" sb.appendS
      ValType .I32 context pushValue sb.appendI
      " =w ext" sb.appendS
      signed if 's' else 'u' end sb.appendC
      src StorageType .STORE pos context sb.appendTypeNameQBE
      " %s" sb.appendS
      args @ i [] sb.appendI
      '\n' sb.appendC
      i 1 +
    end ..drop
  return
end

proc(
  stringBuilder : sb
  BuiltIn : builtIn
  Type : opType
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: appendBuiltInQBE
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  opType typeContext types.getProcIn ..drop =:: inType
  inType typeContext types.compositeEltCount 0 > if
    inType 0 typeContext types.compositeGetLabel
        labelContext id.labelFlags id.FLAG_STATIC & ? if
      1:i64
    else
      0:i64
    end =:: firstArg
    inType firstArg typeContext types.compositeGetElement
  else
      opType typeContext types.getProcOut ..drop =:: outType
      outType typeContext types.compositeEltCount 0 > _if
    outType 0 typeContext types.compositeGetElement
  else
    Type .undefined
  end =:: baseType
  baseType context toValType =:: baseVal
  builtIn switch
    NEG_I8 NEG_I16 NEG_I32 NEG_I64 NEG_F32 NEG_F64 case
      sb "neg" string.wrap baseVal pos context appendUnaryOperator
      return
    ADD_I8 ADD_I16 ADD_I32 ADD_I64 ADD_F32 ADD_F64 case
      sb "add" string.wrap baseVal pos context appendBinaryOperator
      return
    ADD_PTR ADD_PTR_MUT SUB_PTR SUB_PTR_MUT case
      baseType typeContext types.getBaseType =:: valueType
      pos context popValue =:: offsetId
      sb
        ## correctly scale offset
        "%s" sb.appendS
        ValType .I64 context pushValue sb.appendI
        " =l mul %s" sb.appendS
        offsetId sb.appendI
        ", " sb.appendS
        valueType pos context typeSizeInt sb.appendI
        '\n' sb.appendC
        builtIn .SUB_PTR ?? builtIn .SUB_PTR_MUT ?? | if
         "sub" string.wrap
        else
         "add" string.wrap
        end ValType .PTR pos context appendBinaryOperator
      return
    SUB_I8 SUB_I16 SUB_I32 SUB_I64 SUB_F32 SUB_F64 C8_DIFF C16_DIFF C32_DIFF case
      sb "sub" string.wrap baseVal pos context appendBinaryOperator
      return ## TODO ensure char-diff arguments are zero extended
    PTR_DIFF case
      baseType typeContext types.getBaseType =:: valueType
      sb
        "sub" string.wrap baseVal pos context appendBinaryOperator
        pos context popValue =:: resId
        ## correctly scale offset
        "%s" sb.appendS
        ValType .I64 context pushValue sb.appendI
        " =l udiv %s" sb.appendS
        resId sb.appendI
        ", " sb.appendS
        valueType pos context typeSizeInt sb.appendI
        '\n' sb.appendC
      return
    MUL_I32 MUL_I64 MUL_F32 MUL_F64 case
      sb "mul" string.wrap baseVal pos context appendBinaryOperator
      return
    DIV_I32  DIV_I64 DIV_F32 DIV_F64 case
      sb "div" string.wrap baseVal pos context appendBinaryOperator
      return
    DIV_I64I32 case
      sb "div" string.wrap baseVal ValType .I32 true pos context appendMixedDivisionOperator
      return
    REM_I32 REM_I64 case
      sb "rem" string.wrap baseVal pos context appendBinaryOperator
      return
    REM_I64I32 case
      sb "rem" string.wrap baseVal ValType .I32 true pos context appendMixedDivisionOperator
      return
    UDIV_I32 UDIV_I64 case
      sb "udiv" string.wrap baseVal pos context appendBinaryOperator
      return
    UDIV_I64I32 case
      sb "udiv" string.wrap baseVal ValType .I32 false pos context appendMixedDivisionOperator
      return
    UMOD_I32 UMOD_I64 case
      sb "urem" string.wrap baseVal pos context appendBinaryOperator
      return
    UMOD_I64I32 case
      sb "urem" string.wrap baseVal ValType .I32 false pos context appendMixedDivisionOperator
      return
    NOT_BOOL case
      pos context popValue =:: arg
      sb
        "%s" sb.appendS
        baseVal context pushValue sb.appendI
        " =w extub %s" sb.appendS
        arg sb.appendI
        '\n' sb.appendC
        "ceqw 0," string.wrap baseVal pos context appendUnaryOperator
      return
    FLIP_I8 FLIP_I16 FLIP_I32 FLIP_I64 case
      sb
        "xor -1," string.wrap baseVal pos context appendUnaryOperator
      return
    AND_BOOL AND_I8 AND_I16 AND_I32 AND_I64 case
      sb "and" string.wrap baseVal pos context appendBinaryOperator
      return
    OR_BOOL  OR_I8 OR_I16 OR_I32 OR_I64 case
      sb "or" string.wrap baseVal pos context appendBinaryOperator
      return
    XOR_BOOL XOR_I8 XOR_I16 XOR_I32 XOR_I64 case
      sb "xor" string.wrap baseVal pos context appendBinaryOperator
      return
    ## shift truncates second operand, no special handling for mixed size needed
    LSHR_I8 LSHR_I16 LSHR_I32 LSHR_I64I32 LSHR_I64 case
      sb
        baseType false pos context extendArguments
        "shr" string.wrap baseVal pos context appendBinaryOperator
      return
    ASHR_I8 ASHR_I16 ASHR_I32 ASHR_I64I32 ASHR_I64 case
      sb
        baseType true pos context extendArguments
        "sar" string.wrap baseVal pos context appendBinaryOperator
      return
    SHL_I8 SHL_I16 SHL_I32 SHL_I64I32 SHL_I64 case
      sb "shl" string.wrap baseVal pos context appendBinaryOperator
      return
    BOOL_I8 BOOL_I16 BOOL_I32 BOOL_I64 BOOL_F32 BOOL_F64 case
      sb
        "%s" sb.appendS
        baseVal context pushValue sb.appendI
        " =" sb.appendS
        baseVal sb.appendValTypeQBE
        " copy 0\n" sb.appendS
        baseType false pos context extendArguments
        "ne" string.wrap baseVal pos context appendComparisonOperator
      return
    EQ_I8 EQ_I16 EQ_I32 EQ_I64 EQ_F32 EQ_F64 EQ_PTR EQ_C8 EQ_C16 EQ_C32 case
      sb
        baseType true pos context extendArguments
        "eq" string.wrap baseVal pos context appendComparisonOperator
      return
    NE_I8 NE_I16 NE_I32 NE_I64 NE_F32 NE_F64 NE_PTR NE_C8 NE_C16 NE_C32 case
      sb
        baseType true pos context extendArguments
        "ne" string.wrap baseVal pos context appendComparisonOperator
      return
    LT_I8 LT_I16 LT_I32 LT_I64 LT_PTR case
      sb
        baseType true pos context extendArguments
        "slt" string.wrap baseVal pos context appendComparisonOperator
      return
    LE_I8 LE_I16 LE_I32 LE_I64 LE_PTR case
      sb
        baseType true pos context extendArguments
        "sle" string.wrap baseVal pos context appendComparisonOperator
      return
    GE_I8 GE_I16 GE_I32 GE_I64 GE_PTR case
      sb
        baseType true pos context extendArguments
        "sge" string.wrap baseVal pos context appendComparisonOperator
      return
    GT_I8 GT_I16 GT_I32 GT_I64 GT_PTR case
      sb
        baseType true pos context extendArguments
        "sgt" string.wrap baseVal pos context appendComparisonOperator
      return
    LT_F32 LT_F64 case
      sb
        baseType true pos context extendArguments
        "lt" string.wrap baseVal pos context appendComparisonOperator
      return
    LE_F32 LE_F64 case
      sb
        baseType true pos context extendArguments
        "le" string.wrap baseVal pos context appendComparisonOperator
      return
    GE_F32 GE_F64 case
      sb
        baseType true pos context extendArguments
        "ge" string.wrap baseVal pos context appendComparisonOperator
      return
    GT_F32 GT_F64  case
      sb
        baseType true pos context extendArguments
        "gt" string.wrap baseVal pos context appendComparisonOperator
      return
    ULT_I8 ULT_I16 ULT_I32 ULT_I64 LT_C8 LT_C16 LT_C32 case
      sb
        baseType false pos context extendArguments
        "ult" string.wrap baseVal pos context appendComparisonOperator
      return
    ULE_I8 ULE_I16 ULE_I32 ULE_I64 LE_C8 LE_C16 LE_C32 case
      sb
        baseType false pos context extendArguments
        "ule" string.wrap baseVal pos context appendComparisonOperator
      return
    UGE_I8 UGE_I16 UGE_I32 UGE_I64 GE_C8 GE_C16 GE_C32 case
      sb
        baseType false pos context extendArguments
        "uge" string.wrap baseVal pos context appendComparisonOperator
      return
    UGT_I8 UGT_I16 UGT_I32 UGT_I64 GT_C8 GT_C16 GT_C32 case
      sb
        baseType false pos context extendArguments
        "ugt" string.wrap baseVal pos context appendComparisonOperator
      return
    SYS_ARGC case
      sb
        "%s" sb.appendS
        baseVal context pushValue sb.appendI
        " =" sb.appendS
        baseVal sb.appendValTypeQBE
        " load $" sb.appendS
        CONCAT_ARGC_NAME sb.appendS
        '\n' sb.appendC
      return
    SYS_ARGV case
      sb
        "%s" sb.appendS
        baseVal context pushValue sb.appendI
        " =" sb.appendS
        baseVal sb.appendValTypeQBE
        " load $" sb.appendS
        CONCAT_ARGV_NAME sb.appendS
        '\n' sb.appendC
      return
    SYS_ENVP case
      sb
        "%s" sb.appendS
        baseVal context pushValue sb.appendI
        " =" sb.appendS
        baseVal sb.appendValTypeQBE
        " load $" sb.appendS
        CONCAT_ENVP_NAME sb.appendS
        '\n' sb.appendC
      return
  end
end

enum( MIN MAX ) =:: BoundType
proc(
  stringBuilder : sb
  types.PrimitiveType : srcType
  bool : unsigned
  BoundType : boundType
  types.PrimitiveType : asType
-> stringBuilder ) =>: appendNumberBound
  sb
    srcType switch
      I8  CHAR8  case
        unsigned if boundType .MIN ?? if 0 else i8.UMAX i64 cast.u end
          else boundType .MIN ?? _if i8.MIN i64 cast.s else i8.MAX i64 cast.s end
        break
      I16 CHAR16 case
        unsigned if boundType .MIN ?? if 0 else i16.UMAX i64 cast.u end
          else boundType .MIN ?? _if i16.MIN i64 cast.s else i16.MAX i64 cast.s end
        break
      I32 CHAR32 case
        unsigned if boundType .MIN ?? if 0 else i32.UMAX i64 cast.u end
          else boundType .MIN ?? _if i32.MIN i64 cast.s else i32.MAX i64 cast.s end
        break
      I64 case
        unsigned if boundType .MIN ?? if 0 else i64.UMAX end
          else boundType .MIN ?? _if i64.MIN else i64.MAX end
        break
      BOOL case boundType .MIN ?? if 0 else 1 end break
      F32 case
        asType switch
          I8 I16 I32 I64 CHAR8 CHAR16 CHAR32 case
            asType unsigned boundType asType appendNumberBound return
          F32 case
            boundType .MIN ?? if f32.MIN else f32.MAX end f32.bits sb.appendI return
          F64 case
            boundType .MIN ?? if f64.MIN else f64.MAX end f64.bits sb.appendI return
          BOOL TYPE case ..unreachable
        end
        break
      F64 case
        asType switch
          I8 I16 I32 I64 CHAR8 CHAR16 CHAR32 case
            asType unsigned boundType asType appendNumberBound return
          F32 case
            boundType .MIN ?? if f32.Infinity else f32.-Infinity end f32.bits sb.appendI return
          F64 case
            boundType .MIN ?? if f64.MIN else f64.MAX end f64.bits sb.appendI return
          BOOL TYPE case ..unreachable
        end
        break
      TYPE case ..unreachable
    end =:: intVal
  asType switch
    I8 I16 I32 I64 CHAR8 CHAR16 CHAR32 case
      intVal sb.appendI return
    F32 case intVal unsigned if f32 cast.u else f32 cast end f32.bits sb.appendI return
    F64 case intVal unsigned if f64 cast.u else f64 cast end f64.bits sb.appendI return
    BOOL TYPE case ..unreachable
  end
end

proc(
  stringBuilder : sb
  types.PrimitiveType : srcVal
  i64 : srcIndex
  Type : targetType
  types.PrimitiveType : targetVal
  i64 : targetIndex
  bool : unsigned
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: castFloatToInt
  BranchId 7 array new =:: mut: branches
  0 while ..dup 7 < do =:: i
    ## BranchId
      BranchType .NEXT
      context nextJumpLabelId 0
    BranchId new branches@ i [] =
    i 1 +
  end ..drop
  context nextTmpId =:: cNaN
  context nextTmpId =:: cMin
  context nextTmpId =:: cMax
  context nextTmpId =:: tCast
  context nextTmpId =:: tNaN
  context nextTmpId =:: tMin
  context nextTmpId =:: tMax
  srcVal .F32 ?? if 's'
  else srcVal .F64 ?? _if 'd'
  else ..unreachable end =:: srcTypeName
  sb
    ## isNaN?
    "%t" sb.appendS cNaN sb.appendI
    " =w co" sb.appendS srcTypeName sb.appendC
    " %s" sb.appendS
    srcIndex sb.appendI
    ", %s" sb.appendS
    srcIndex sb.appendI
    '\n' sb.appendC
    "jnz %t" sb.appendS cNaN sb.appendI
    ", " sb.appendS branches@ 0 [] sb.appendBranchId
    ", " sb.appendS branches@ 1 [] sb.appendBranchId
    '\n' sb.appendC
    branches@ 0 [] context startBranch
    ## > min ?
    "%t" sb.appendS cMin sb.appendI
    " =w cgt" sb.appendS srcTypeName sb.appendC
    " %s" sb.appendS
    srcIndex sb.appendI
    ", " sb.appendS
    targetVal unsigned BoundType .MIN srcVal appendNumberBound
    '\n' sb.appendC
    "jnz %t" sb.appendS cMin sb.appendI
    ", " sb.appendS branches@ 2 [] sb.appendBranchId
    ", " sb.appendS branches@ 3 [] sb.appendBranchId
    '\n' sb.appendC
    branches@ 2 [] context startBranch
    ## < max ?
    "%t" sb.appendS cMin sb.appendI
    " =w clt" sb.appendS srcTypeName sb.appendC
    " %s" sb.appendS
    srcIndex sb.appendI
    ", " sb.appendS
    targetVal unsigned BoundType .MAX srcVal appendNumberBound
    '\n' sb.appendC
    "jnz %t" sb.appendS cMin sb.appendI
    ", " sb.appendS branches@ 4 [] sb.appendBranchId
    ", " sb.appendS branches@ 5 [] sb.appendBranchId
    '\n' sb.appendC
    branches@ 4 [] context startBranch
    ## cast value
    "%t" sb.appendS
    tCast sb.appendI
    " =" sb.appendS
    targetType StorageType .STACK pos context sb.appendTypeNameQBE
    ' ' sb.appendC
    srcTypeName sb.appendC
    unsigned if "toui %s" else "tosi %s" end sb.appendS
    srcIndex sb.appendI
    "\njmp " sb.appendS branches@ 6 [] sb.appendBranchId
    '\n' sb.appendC
    ## NaN
    branches@ 1 [] context startBranch
    "%t" sb.appendS
    tNaN sb.appendI
    " =" sb.appendS
    targetType StorageType .STACK pos context sb.appendTypeNameQBE
    " copy 0" sb.appendS
    "\njmp " sb.appendS branches@ 6 [] sb.appendBranchId
    '\n' sb.appendC
    ## <Min
    branches@ 3 [] context startBranch
    "%t" sb.appendS
    tMin sb.appendI
    " =" sb.appendS
    targetType StorageType .STACK pos context sb.appendTypeNameQBE
    " copy " sb.appendS
    targetVal unsigned BoundType .MIN targetVal appendNumberBound
    "\njmp " sb.appendS branches@ 6 [] sb.appendBranchId
    '\n' sb.appendC
    ## >Max
    branches@ 5 [] context startBranch
    "%t" sb.appendS
    tMax sb.appendI
    " =" sb.appendS
    targetType StorageType .STACK pos context sb.appendTypeNameQBE
    " copy " sb.appendS
    targetVal unsigned BoundType .MAX targetVal appendNumberBound
    '\n' sb.appendC
    branches@ 6 [] context startBranch
    "%s" sb.appendS
    targetIndex sb.appendI
    " =" sb.appendS
    targetType StorageType .STACK pos context sb.appendTypeNameQBE
    " phi " sb.appendS
    branches@ 4 [] sb.appendBranchId
    " %t" sb.appendS tCast sb.appendI
    ", " sb.appendS branches@ 1 [] sb.appendBranchId
    " %t" sb.appendS tNaN sb.appendI
    ", " sb.appendS branches@ 3 [] sb.appendBranchId
    " %t" sb.appendS tMin sb.appendI
    ", " sb.appendS branches@ 5 [] sb.appendBranchId
    " %t" sb.appendS tMax sb.appendI
    '\n' sb.appendC
  return
end

proc(
  stringBuilder : sb
  Type : src
  i64 : srcIndex
  Type : target
  i64 : targetIndex
  FilePosition : pos
  CompilerContext ptr mut : context
  SignType : signType
-> stringBuilder ) =>: castNumbers
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  src typeContext types.primitiveValue =:: fromVal
  target typeContext types.primitiveValue =:: toVal
  ## case 0: identical types
  fromVal toVal == if
    sb
      ## copy necessary to update value id
      "%s" sb.appendS
      targetIndex sb.appendI
      " =" sb.appendS
      target StorageType .STACK pos context sb.appendTypeNameQBE
      " copy" sb.appendS
      " %s" sb.appendS
      srcIndex sb.appendI
      '\n' sb.appendC
    return
  ## case 1: integer extension/narrowing
  else src typeContext types.isIntOrChar and target typeContext types.isIntOrChar _if
    src typeContext types.primitiveValue types.sizeOfPrimitive =:: srcPrec
    target typeContext types.primitiveValue types.sizeOfPrimitive =:: targetPrec
    sb
      "%s" sb.appendS
      targetIndex sb.appendI
      targetPrec srcPrec <= if
        " =" sb.appendS
        target StorageType .STACK pos context sb.appendTypeNameQBE
        " copy" sb.appendS
      else
        " =" sb.appendS
        target StorageType .STACK pos context sb.appendTypeNameQBE
        " ext" sb.appendS
        signType .UNSIGNED ?? if
          'u' sb.appendC
        else
          's' sb.appendC
        end
        fromVal switch
          I8  CHAR8  case "b" sb.appendS break
          I16 CHAR16 case "h" sb.appendS break
          I32 CHAR32 case "w" sb.appendS break
          I64 case "l" sb.appendS break
          BOOL TYPE F32 F64 case ..unreachable
        end
      end
      " %s" sb.appendS
      srcIndex sb.appendI
      '\n' sb.appendC
    return
  ## case 2: float -> float/int
  else fromVal .F32 ?? or fromVal .F64 ?? _if
      toVal switch
        F32 case
          sb
            "%s" sb.appendS
            targetIndex sb.appendI
            " =s truncd %s" sb.appendS
            srcIndex sb.appendI
            '\n' sb.appendC
          return
        F64 case
          sb
            "%s" sb.appendS
            targetIndex sb.appendI
            " =d exts %s" sb.appendS
            srcIndex sb.appendI
            '\n' sb.appendC
          return
        I8 I16 I32 I64 CHAR8 CHAR16 CHAR32 case
          sb
            fromVal srcIndex target toVal targetIndex
            signType .UNSIGNED ??
          pos context castFloatToInt return
        BOOL TYPE case ..unreachable
      end
  ## case 3: int -> float
  else ## TODO sign/zero extend 8&16 bit types before conversion
    sb
      "%s" sb.appendS
      targetIndex sb.appendI
      " =" sb.appendS
      target StorageType .STACK pos context sb.appendTypeNameQBE
      signType .UNSIGNED ?? if " u" sb.appendS else " s" sb.appendS end
      fromVal switch
        I64 case "ltof" sb.appendS break
        I8 I16 I32 CHAR8 CHAR16 CHAR32 case "wtof" sb.appendS break
        BOOL TYPE F32 F64 case ..unreachable
      end
      " %s" sb.appendS
      srcIndex sb.appendI
      '\n' sb.appendC
    return
  end
end


struct( char8 : varType i64 : varId ) =:: StackVal
namespace: sb
  proc(
    stringBuilder : sb
    StackVal : val
  -> stringBuilder ) =>: appendStackVal
    sb
      '%' sb.appendC
      val .varType sb.appendC
      val .varId sb.appendI
    return
  end
end
proc(
  stringBuilder : sb
  Type : src
  i64 : srcIndex
  Type : target
  i64 : targetIndex
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: bitcastNumbers
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  src typeContext types.primitiveValue =:: fromVal
  target typeContext types.primitiveValue =:: toVal
  ## sizes of arguments scaled to bits
  fromVal types.sizeOfPrimitive 8 * =:: fromSize
  toVal types.sizeOfPrimitive 8 * =:: toSize
  fromVal toVal == if
    sb
      "%s" sb.appendS
      targetIndex sb.appendI
      ## copy necessary to update value id
      " =" sb.appendS
      target StorageType .STACK pos context sb.appendTypeNameQBE
      " copy %s" sb.appendS
      srcIndex sb.appendI
      '\n' sb.appendC
    return
  end
  's' srcIndex StackVal new =:: mut: current
  's' targetIndex StackVal new =:: mut: last
  last =:: mut: next
  0 =:: mut: nSteps
  src typeContext types.isFloat if nSteps 1 + nSteps = end
  fromSize toSize != if
    nSteps 1 + nSteps =
  end
  target typeContext types.isFloat if nSteps 1 + nSteps = end
  nSteps 0 > assert "bit-cast casts non-equal types"
  nSteps 1 > if
    't' context nextTmpId StackVal new next =
  end
  sb
    ## 1. convert floats to int
    src typeContext types.isFloat if
      next sb.appendStackVal
      " =" sb.appendS
      fromSize 32 <= if 'w' else 'l' end sb.appendC
      " cast " sb.appendS
      current sb.appendStackVal
      '\n' sb.appendC
      nSteps 1 - nSteps =
      next current =
      nSteps 1 > if 't' context nextTmpId StackVal new else last end next =
    end
    ## 2. zero-extend small values to correct size
    fromSize toSize != if
      next sb.appendStackVal
      " =" sb.appendS
      toSize 32 <= if 'w' else 'l' end sb.appendC
      fromSize toSize < if
        fromVal switch
          BOOL TYPE F32 F64 case break
          I8  CHAR8  case " extub" sb.appendS break
          I16 CHAR16 case " extuh" sb.appendS break
          I32 CHAR32 case " extuw" sb.appendS break
          I64 case " extul" sb.appendS break
        end
      else
        ## copy to smaller type truncates
        " copy " sb.appendS
      end
      current sb.appendStackVal
      '\n' sb.appendC
      nSteps 1 - nSteps =
      next current =
      nSteps 1 > if 't' context nextTmpId StackVal new else last end next =
    end
    ## 3. convert int to float
    target typeContext types.isFloat if
      next sb.appendStackVal
      " =" sb.appendS
      toSize 32 == if 's' else 'd' end sb.appendC
      " cast " sb.appendS
      current sb.appendStackVal
      '\n' sb.appendC
      nSteps 1 - nSteps =
    end
    nSteps 0 == assert "correct step estimate in bit-cast"
  return
end

enum( autoCast Cast Cast! bitCast ) =:: CastType

proc(
  stringBuilder : sb
  CastType : castType
  SignType : signType0
  Type : src0
  i32 : offset
  Type : target0
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: compileCast
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  signType0
    $ .NONE ?? if ..drop
      src0 typeContext types.isUnsignedInt or src0 typeContext types.isChar if
        SignType .UNSIGNED
      else src0 typeContext types.isSignedInt _if
        SignType .SIGNED
      else target0 typeContext types.isUnsignedInt or target0 typeContext types.isChar _if
        SignType .UNSIGNED
      else target0 typeContext types.isSignedInt _if
        SignType .SIGNED
      else
        SignType .NONE
      end
    end
  =:: signType
  ## XXX? better cType <-> type conversion
  ## TODO update sign type when casting from/to  cType/intLiteral
  src0 typeContext types.unwrapNamed
    ..dup .cType ?? if .cType types.cTypeAsType end
    ..dup .intLiteral ?? if .intLiteral types.intLiteralAsInt end
  =:: src
  target0 typeContext types.unwrapNamed
    ..dup .cType ?? if .cType types.cTypeAsType end
    ..dup .intLiteral ?? if .intLiteral types.intLiteralAsInt end
  =:: target
  src target types.typeEquals if
    sb return ## nothing to do
  end
  castType .autoCast ?? if
    offset i64 cast.s context [] .stackInfo branchTree.depth >= if
      "stack underflow" sb.wrap
      pos errors appendError
      sb return
    end
    context [] .stackInfo @ offset branchTree.at .data [] .valType
    context [] .stackInfo @ offset branchTree.at .data [] .varId
  else
    context [] .stackInfo @ offset branchTree.at .data [] .valType
    pos context popValue
  end =:: srcId =:: valType
  castType .autoCast ?? if
    target context toValType offset context replaceValue
  else
    target context toValType context pushValue
  end =:: targetId
  ## TODO? different behavior for bit-casts
  src typeContext types.isNumber and target .arrayIndex ?? if
    ## isNumber returns true for array index
    ##   -> have to check for cast to array index before checking for cast to number
    sb
      ## castNumbers
        src srcId
        types.primitive.I_SIZE targetId
      pos context  castType .bitCast ?? if bitcastNumbers else signType castNumbers end
      target typeContext types.getArraySize 0 array.get =:: size
      ## appendIndexCheck
        size .sizeType switch
          int case size .value IntValue .constant break
          staticArg case size .value LabelId cast IntValue .autoArg break
        end
        targetId
        pos
      context appendIndexCheck
    return
  end
  src typeContext types.isNumber and target typeContext types.isNumber if
    sb
      src srcId
      target targetId
    pos context  castType .bitCast ?? if bitcastNumbers else signType castNumbers end
    return
  end
  src typeContext types.isChar and target typeContext types.isInt if
    sb
      src srcId
      target targetId
    pos context  castType .bitCast ?? if bitcastNumbers else signType castNumbers end
    return
  end
  src typeContext types.isInt and target typeContext types.isChar if
    sb
      src srcId
      target targetId
    pos context  castType .bitCast ?? if bitcastNumbers else signType castNumbers end
    return
  end
  src typeContext types.isPointer target typeContext types.isPointer & if
    sb
      "%s" sb.appendS
      targetId sb.appendI
      " =l copy %s" sb.appendS
      srcId sb.appendI
      '\n' sb.appendC
    return ## both are pointer types
  end
  ## XXX? sign type for cast int <-> ptr
  src typeContext types.isInt target typeContext types.isPointer & if
    ## src -> I_PTR ~ ptr
    sb
      ## castNumbers
        src srcId
        types.primitive.I_PTR targetId
      pos context  castType .bitCast ?? if bitcastNumbers else signType castNumbers end
    return
  end
  src typeContext types.isPointer target typeContext types.isInt & if
    ## ptr ~ I_PTR -> target
    sb
      ## castNumbers
        types.primitive.I_PTR srcId
        target targetId
      pos context  castType .bitCast ?? if bitcastNumbers else signType castNumbers end
    return
  end
  src typeContext types.isReference and target typeContext types.isReference ! if
    src typeContext types.getBaseType typeContext types.unwrapNamed =:: baseType
    sb
      "%s" sb.appendS
      targetId sb.appendI
      " =" sb.appendS
      baseType StorageType .STACK pos context sb.appendTypeNameQBE
      baseType context referenceOnly ! and valType .REFERENCE ?? if ## unwrap reference
        " load" sb.appendS
        baseType StorageType .LOAD pos context sb.appendTypeNameQBE
      else
        " copy" sb.appendS
      end
      " %s" sb.appendS
      srcId sb.appendI
      '\n' sb.appendC
      ## cast value
      baseType target types.typeEquals ! if
        ## compileCast
          castType
          signType
          baseType
          offset
          target
          pos
          context
        compileCast
      end
    return
  end
  target typeContext types.isReference and src typeContext types.isReference ! if
    target typeContext types.getBaseType typeContext types.unwrapNamed =:: baseType
    sb
      ## cast value
      src baseType types.typeEquals ! if
        ## compileCast
          castType
          signType
          src
          offset
          baseType
          pos
          context
        compileCast
      end
      "%s" sb.appendS
      targetId sb.appendI
      " =" sb.appendS
      baseType context referenceOnly or valType .REFERENCE ?? ! if ## value is already reference
        baseType StorageType .STACK pos context sb.appendTypeNameQBE
        " copy" sb.appendS
      else ## TODO convert value type to pointe
        "casting from " sb.wrap
          src typeContext sb.appendType
          " to " sb.appendS
          target typeContext sb.appendType
          " is not implemented" sb.appendS
        pos errors appendError
      end
      " %s" sb.appendS
      srcId sb.appendI
      '\n' sb.appendC
    return
  end
  "casting from " sb.wrap
    src typeContext sb.appendType
    " to " sb.appendS
    target typeContext sb.appendType
    " is not implemented" sb.appendS
  pos errors appendError
  sb return
end

proc(
  stringBuilder : sb
  Type : constType
  ConstValue : value
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: pushConstant
  context [] .program =:: prog
  prog [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  false =:: mut: needCast
  constType =:: mut: srcType
  value .genericArg ?? if
    context [] .currentProc
      typeContext types.getProcIn ! assert "procedure has arguments"
    =:: progIn
    progIn
      value .genericArg
      typeContext
    types.compositeFindLabel =:: index
    index -1 != if
      progIn index typeContext types.compositeGetElement srcType =
      srcType typeContext types.unwrapNamed
        constType typeContext types.unwrapNamed
      types.typeEquals ! needCast =
    end
  end
  i64 : valId
  sb
    pos sb.appendPosQBE
    "%s" sb.appendS
    srcType context referenceOnly ! if
      srcType context toValType context pushValue sb.appendI
      " =" sb.appendS
      srcType StorageType .STACK pos context sb.appendTypeNameQBE
      " copy " sb.appendS
    else
      ValType .REFERENCE context pushValue sb.appendI
      " =l copy " sb.appendS
    end
    srcType value false pos context sb.appendConstQBE
    '\n' sb.appendC
    needCast if
      ## compileCast
        CastType .autoCast
        SignType .NONE
        srcType
        0
        constType
        pos
        context
      compileCast
    end
  return
end

proc(
  stringBuilder : sb
  Type : calledType
  TypedValId list ptr mut : argIndices
  i64 : outArgsOffset
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: prepareCall
  context [] .program =:: prog
  prog [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  calledType typeContext types.getProcOutArgs
    ! assert "calledType has arguments"
  =:: outArgs
  calledType typeContext types.getProcRet
    ! assert "calledType has return value"
  =:: retType
  sb =:: mut: newSb
  ## push out arguments on stack
  outArgsOffset while ..dup argIndices [] .length < do =:: i
    argIndices [] i list.get =:: outArg
    ValType .REFERENCE context pushValue =:: argId
    newSb
      "%s" sb.appendS
      argId sb.appendI
      " =l copy %s" sb.appendS
      outArg .valId sb.appendI
      '\n' sb.appendC
    newSb =
    i 1 +
  end ..drop
  newSb
    retType typeContext types.isEmpty ! if
      retType context toValType context pushValue =:: retId
      "%s" sb.appendS
      retId sb.appendI
      " =" sb.appendS
      retType StorageType .LOAD pos context sb.appendTypeNameQBE
      ' ' sb.appendC
    end
    "call " sb.appendS
  return
end
proc(
  stringBuilder : sb
  Type : calledType
  TypedValId list ptr mut : argIndices
  i64 : outArgsOffset
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: finishCall
  context [] .program =:: prog
  prog [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  calledType typeContext types.getProcOutArgs
    ! assert "calledType has out-arguments"
  =:: outArgs
  calledType typeContext types.getProcRet
    ! assert "calledType has return value"
  =:: retType
  sb
    " (" sb.appendS
    0:i64 while ..dup argIndices [] .length < do =:: i
      argIndices [] i list.at .data =:: arg
      i 0 > if
        ',' sb.appendC
      end
      i outArgsOffset < if
        arg [] .valType
          StorageType .LOAD
          pos
          context
        sb.appendTypeNameQBE
      else
        'l' sb.appendC
      end
      " %s" sb.appendS
      arg [] .valId sb.appendI
      i 1 +
    end ..drop
    ")\n" sb.appendS
    retType typeContext types.isProcOut if
      ## flattenTupleQBE
        retType
        pos context popValue
        pos
      context flattenTupleQBE
    end
    ## convert out-arg references to values
    outArgsOffset while ..dup argIndices [] .length < do =:: i
      argIndices [] i list.at .data [] .valType =:: outArg
      outArg context referenceOnly if
        i 1 + continue
      end
      ## compileCast
        CastType .autoCast
        SignType .NONE
        outArg
          false
          typeContext
        types.newReferenceType
        ## (len-1-i) +1 for return value
        argIndices [] .length i - i32 cast
        outArg
        pos
        context
      compileCast
      i 1 +
    end ..drop
    argIndices [] list.free argIndices [] =
  return
end

proc(
  stringBuilder : sb
  Operation ptr : op
  CompilerContext ptr mut : context
-> stringBuilder ) =>: compileOp
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  op [] .val switch
    NOP case
      sb return
    Constant case
      sb
        op [] .dataType
        op [] .val .Constant
        op [] .pos
        context
      pushConstant
      return
    ConstantReference case
      sb
        "%s" sb.appendS
        ValType .REFERENCE context pushValue sb.appendI
        " =l " sb.appendS
        " copy $" sb.appendS
        CONST_REFERENCE_NAME sb.appendS
        op [] .val .ConstantReference i64 cast sb.appendI
        '\n' sb.appendC
      return
    declareId initializeId case
      op [] .val .declareId ?? if
        op [] .val .declareId
      else
        op [] .val .initializeId
      end =:: idInfo
      op [] .val .initializeId ?? =:: assignValue
      idInfo .labelId labelContext id.labelFlags =:: labelFlags
      labelFlags id.FLAG_MUTABLE & ? =:: mutable
      idInfo .idType switch
        PROCEDURE case
          assignValue ! if
            sb return ## ignore procedure declarations
          end
          break
        LOCAL_VAR TMP_VAR ITR_VAR case
          op [] .dataType =:: valType
          ## use pointers as stack representation of arrays and composites
          valType context referenceOnly ! =:: isValue
          sb
            op [] .pos sb.appendPosQBE
            idInfo .idType .LOCAL_VAR ?? if
              "%l" sb.appendS
              idInfo .labelId i64 cast sb.appendI
            else idInfo .idType .ITR_VAR ?? _if
              "%itr" sb.appendS
              idInfo .id i64 cast sb.appendI
            else
              "%tmp" sb.appendS
              idInfo .labelId i64 cast sb.appendI
            end
            valType op [] .pos context false appendAlloc ..drop
            assignValue if
              isValue if
                "store" sb.appendS
                valType StorageType .STORE op [] .pos context sb.appendTypeNameQBE
              else
                "blit" sb.appendS ## XXX call memcopy for large structs
              end
              " %s" sb.appendS
              op [] .pos context popValue sb.appendI
              ',' sb.appendC
              idInfo .idType .LOCAL_VAR ?? if
                "%l" sb.appendS
                idInfo .labelId i64 cast sb.appendI
              else idInfo .idType .ITR_VAR ?? _if
                "%itr" sb.appendS
                idInfo .id i64 cast sb.appendI
              else
                "%tmp" sb.appendS
                idInfo .labelId i64 cast sb.appendI
              end
              isValue ! if
                ',' sb.appendC
                op [] .dataType op [] .pos context typeSizeInt sb.appendI
              end
              '\n' sb.appendC
            end
          return
        GLOBAL_VAR TYPE ARGUMENT LABEL PROCEDURE_BUNDLE case
          break ## XXX error message
      end
      break
    implementProcedure case
      op [] .val .implementProcedure =:: implInfo
      prog [] .procedures
        implInfo .procId i64 cast list.at .data
      =:: procInfo
      op [] .dataType context [] .currentProc =
      procInfo [] .labelId labelContext id.labelFlags =:: labelFlags
      ## reset stack-info in context
      0 context [] .stackCount =
      0 context [] .tmpCount =
      0 context [] .jumpLabelCount =
      context [] .stackInfo @ branchTree.clear
      sb
        implInfo .implementationId  0 < and
            labelFlags id.FLAG_EXPORT & ? or labelFlags id.FLAG_EXTERN & ? if
          "export " sb.appendS
        end
        "function " sb.appendS
        op [] .dataType typeContext types.getProcRet if ..drop
          "wrong type for procedure initialization: " sb.wrap
            op [] .dataType typeContext sb.appendType
            " expected procedure" sb.appendS
          op [] .pos errors appendError
          return
        end =:: retType
        retType typeContext types.isEmpty ! if
          retType StorageType .LOAD op [] .pos context sb.appendTypeNameQBE
          ' ' sb.appendC
        end
        procInfo [] .labelId implInfo .implementationId context sb.appendGlobalName
        op [] .dataType op [] .pos context sb.appendProcSignature
        "{\n" sb.appendS
        ## BranchId
          BranchType .START
          0 0
        BranchId new context startBranch
        ## push unnamed arguments
        op [] .dataType typeContext types.getProcIn ..drop =:: inType
        inType typeContext types.compositeElts =:: args
        0:i64 while ..dup args .length < do =:: i
          inType i typeContext types.compositeGetLabel =:: label
          args i types.compositeElts.get =:: argType
          argType typeContext types.isEmpty if
            i 1 + continue ## skip empty arguments
          end
          label id.LABEL_ID_NONE == if ## push argument
            argType context referenceOnly if
              ValType .REFERENCE
            else
              argType context toValType
            end =:: valType
            "%s" sb.appendS
            valType context pushValue sb.appendI
            " =" sb.appendS
            valType sb.appendValTypeQBE
            " copy " sb.appendS
            i id.LABEL_ID_NONE context sb.appendArgName
            '\n' sb.appendC
          end
          i 1 +
        end ..drop
        true context [] .reachable =
      return
    getId atId case
      op [] .val .getId ?? if
        op [] .val .getId
      else
        op [] .val .atId
      end =:: idInfo
      op [] .val .atId ?? =:: isAddr
      idInfo .idType switch
        PROCEDURE  case
          ## procedures are handled by call & procPtr instructions
          break
        GLOBAL_VAR LOCAL_VAR TMP_VAR ITR_VAR case
          sb
            op [] .pos sb.appendPosQBE
            "%s" sb.appendS
            isAddr if ValType .PTR else ValType .REFERENCE end context pushValue sb.appendI
            idInfo .idType switch
              GLOBAL_VAR case
                " =l copy " sb.appendS
                idInfo .labelId -1 context sb.appendGlobalName
                break
              LOCAL_VAR case
                " =l copy %l" sb.appendS
                idInfo .labelId i64 cast sb.appendI
                break
             ITR_VAR case
                " =l copy %itr" sb.appendS
                idInfo .id i64 cast sb.appendI
                break
              TMP_VAR case
                " =l copy %tmp" sb.appendS
                idInfo .labelId i64 cast sb.appendI
                break
              PROCEDURE ARGUMENT TYPE LABEL PROCEDURE_BUNDLE case ..unreachable
            end
            '\n' sb.appendC
          return
       ARGUMENT case
          isAddr and op [] .dataType context referenceOnly ! if
            "cannot take the address of procedure argument" sb.wrap
            op [] .pos errors appendError
            sb return
          end
          op [] .dataType context referenceOnly if
            ValType .REFERENCE
          else
            op [] .dataType context toValType
          end =:: valType
          sb
            op [] .pos sb.appendPosQBE
            "%s" sb.appendS
            valType context pushValue sb.appendI
            " =" sb.appendS
            valType sb.appendValTypeQBE
