        LOCAL_CONST_NAME sb.appendS
        constant [] .id sb.appendI
        " = align " sb.appendS
        constant [] .valType pos context typeAlignmentInt sb.appendI
        " {" sb.appendS
        constant [] .valType constant [] .value true constant [] .pos context appendConstQBE
        "}\n" sb.appendS
        i 1 +
      end ..drop
      context [] .localConstants
        list.clear
      context [] .localConstants =
    return
  end

  proc(
    stringBuilder : sb
    Type : t
    FilePosition : pos
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: startTypeDeclaration
    sb
      "type " sb.appendS
