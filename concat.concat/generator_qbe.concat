        op [] .pos sb.appendPosQBE
      =:: mut: newSb
      ## index of current auto-argument
      0:i64 =:: mut: argIndex
      0:i64 while ..dup argCount < do =:: i
        inTypes i typeContext types.compositeGetElement =:: mut: arg
        inTypes i typeContext types.compositeGetLabel =:: argLabel
        arg typeContext types.isEmpty if
          i 1 + continue ## skip empty arguments
