import string
import file

import "program.concat"
import "measure.concat"
import "branchTree.concat"

## TODO? make prefix customizable
"cct_" =:: CONCAT_PREFIX
"cctI_argc" =:: CONCAT_ARGC_NAME
"cctI_argv" =:: CONCAT_ARGV_NAME
"cctI_envp" =:: CONCAT_ENVP_NAME
"cctI_local" =:: LOCAL_CONST_NAME
"cctI_string" =:: STRING_CONST_NAME
"cctI_ptr" =:: PTR_CONST_NAME
"cctI_constRef" =:: CONST_REFERENCE_NAME
"cctI_assertFormat" =:: ASSERT_FORMAT
"cctI_panicFormat" =:: PANIC_FORMAT
"fileName" =:: FILE_NAME_NAME

enum(
  START
  NEXT
  ERROR
  LABEL
  END_INLINE
) =:: BranchType
struct( BranchType : branchType i32 : id ) =:: BranchId
enum( EMPTY I32 I64 FLOAT DOUBLE PTR REFERENCE ) =:: ValType

union(
  _ : None
  iSize : Stack
  i32 : Tmp
  i32 : Arg
  NameId : LocalVar
  ## TODO? const-int
  ## TODO? arg/out-arg
) =:: ValueId
proc( stringBuilder NameId : nameId -> stringBuilder ) =>: appendLocalVar
  "%l":s sb.appendStr
  nameId id.getIdentifierPos =:: pos
  pos [] .line sb.appendI
  '_' sb.appendC
  pos [] .posInLine sb.appendI
  '_' sb.appendC
  nameId sb.appendAciifiedIdentifierName
end
namespace: ValueId
  proc( stringBuilder ValueId : valId -> stringBuilder ) =>: sbAppend
    valId switch
      None case "%_":s sb.appendStr return
      Stack .case =:: id "%s":s sb.appendStr id sb.appendI return
      Arg .case =:: id "%a":s sb.appendStr id sb.appendI return
      Tmp .case =:: id "%t":s sb.appendStr id sb.appendI return
      LocalVar .case appendLocalVar return
    end
  end
  proc( ValueId : a ValueId : b -> bool ) =>: eq
    a ..tag b ..tag != if false return end
    a switch
      None case true return
      Stack  .case b .Stack unionElement.unwrap == return
      Tmp  .case b .Tmp unionElement.unwrap == return
      Arg  .case b .Arg unionElement.unwrap == return
      LocalVar  .case b .LocalVar unionElement.unwrap NameId.eq return
    end
  end
end
struct(
  ValueId : valueId
  ValType : valType
) =:: StackValue
namespace: StackValue
  proc( StackValue : a StackValue : b -> bool ) =>: eq
    a .valueId b .valueId ValueId.eq
  end
  proc( ValueId : valId ValType : valType -> StackValue ) =>: create
    valId valType StackValue new
  end
  proc( StackValue : a StackValue : b -> bool ) =>: valTypesEq
    a .valType b .valType ==
  end
  proc( stringBuilder StackValue -> stringBuilder ) =>: sbAppendValType
    .valType sb.appendValType
  end
end

struct(
  Type : valType
  ValueId : valId
) =:: TypedValId

struct(
  ConstValue   : value
  Type         : valType
  FilePosition ptr : pos
) =:: PtrConstant

struct(
  Type       : valType
  ConstValue : value
  FilePosition ptr : pos
  i32 : id
) =:: LocalConst

struct(
  branchTree.NodeId list : branches
  BranchId list : branchIds
) =:: LabelState
namespace: LabelState
  proc( -> LabelState ) =>: new
    ## LabelState
      8 branchTree.NodeId list.create
      8 BranchId list.create
    LabelState new
  end
  proc( LabelState -> ) =>: free
    $ .branches list.free ..drop
    .branchIds list.free ..drop
  end
end

struct(
  ProgramContext ptr.mut : program
  StackValue BranchTree : stackInfo
  BranchId : currentBranch
  LocalLabelId LabelState hashMap : labelStates
  LocalConst list : localConstants
  string list : stringConstants
  PtrConstant list : ptrConstants
  Type i64 hashMap : typeIds
  i64 : typeIdCount
  iSize : stackCount
  Type : currentProc
  i32 : localConstCount
  i32 : tmpCount
  i32 : jumpLabelCount
  bool : reachable
) =:: CompilerContext

namespace: sb
  proc( stringBuilder ValType -> stringBuilder ) =>: appendValType
    switch
      EMPTY case "empty" sb.appendS return
      I32 case "i32" sb.appendS return
      I64 case "i64" sb.appendS return
      FLOAT case "float" sb.appendS return
      DOUBLE case "double" sb.appendS return
      PTR case "pointer" sb.appendS return
      REFERENCE case "reference" sb.appendS return
    end
  end
  proc( stringBuilder ValType -> stringBuilder ) =>: appendValTypeQBE
    switch
      EMPTY case break
      I32 case 'w' sb.appendC break
      I64 PTR REFERENCE case 'l' sb.appendC break
      FLOAT case 's' sb.appendC break
      DOUBLE case 'd' sb.appendC break
    end
  end
end
proc( Type : t CompilerContext ptr : context -> ValType ) =>: toValType
  context [] .program =:: program
  program .errors =:: errors
  program .idContext .typeContext =:: typeContext
  t switch
    NamedType case
      t typeContext types.unwrapNamed context toValType return
    GeneratedType case
      t typeContext types.getGeneratedType context toValType return
    PrimitiveType .case
      switch
        TYPE case ValType .EMPTY return
        BOOL I8 I16 I32 F16 case ValType .I32 return
        I64 case ValType .I64 return
        F32 case ValType .FLOAT return
        F64 case ValType .DOUBLE return
      end
      break
    IntLiteral .case types.intLiteralAsInt context toValType return
    Enum case t typeContext types.enumTagInfo ..drop context toValType return
    CType .case types.cTypeAsType context toValType return
    Pointer MutablePointer RawPointer MutableRawPointer case
      ValType .PTR return
    Procedure Quotation ArrayType Struct TaggedUnion RawUnion UnionElement Initializer case
      ValType .REFERENCE return
    SetType RefinementType case
      t typeContext types.unwrapRefinement context toValType return
    Undefined Empty GenericType Align case
      ValType .EMPTY return
  end
end


namespace: sb
  proc( stringBuilder : sb BranchId : branch -> stringBuilder ) =>: appendBranchId
    sb
      branch .branchType switch
        START case "@start" sb.appendS break
        NEXT case "@next" sb.appendS branch .id sb.appendI break
        ERROR case "@error" sb.appendS branch .id sb.appendI break
        LABEL case "@label_" sb.appendS branch .id sb.appendI break
        END_INLINE case "@endInline" sb.appendS branch .id sb.appendI break
      end
    return
  end
end
proc(
  stringBuilder : sb
  BranchId : branch
  string : branchComment
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: startBranch
  branch context .currentBranch=
  sb
    branch sb.appendBranchId
    branchComment .length 0:iSize iSize.sgt if
      " ## " sb.appendS
      branchComment sb.appendStr
    end
    '\n' sb.appendC
  return
end
proc( ValType : valType ValueId : valId CompilerContext ptr.mut : context -> ) =>: pushValue
  context .stackInfo
    valId
    valType
  StackValue.create branchTree.push
end
proc( ValType : valType CompilerContext ptr.mut : context -> ValueId ) =>: pushNewValue
  context nextStackValueId
    valType $1 context pushValue
  return
end
proc( CompilerContext ptr.mut : context -> ValueId ) =>: nextStackValueId
  context [] .stackCount =:: oldCount
    oldCount 1 +
  context .stackCount=
  oldCount ValueId .Stack return
end
proc( ValType : valType i32 : offset ValueId : newVal CompilerContext ptr.mut : context -> ) =>: replaceValue
  context .stackInfo
    offset
  branchTree.replaceAt optional.unwrap =:: stackElt
  newVal valType StackValue.create stackElt =[]
end
proc(
  FilePosition ptr : pos
  CompilerContext ptr.mut : context
-> ValueId ) =>: popValue
  context .stackInfo branchTree.pop .if
    [] .valueId return
  end
  "stack underflow" sb.copyPtr
  pos context [] .program .errors appendError
  ValueId .None return
end
proc( CompilerContext ptr.mut : context -> ValueId ) =>: nextTmpId
  context [] .tmpCount =:: oldCount
    oldCount
      1 +
    context .tmpCount=
  oldCount ValueId .Tmp return
end
proc( CompilerContext ptr.mut : context -> i32 ) =>: nextJumpLabelId
  context [] .jumpLabelCount =:: oldCount
    oldCount
      1 +
    context .jumpLabelCount=
  oldCount return
end
proc( CompilerContext ptr.mut : context -> i32 ) =>: nextLocalConstId
  context [] .localConstCount =:: oldCount
    oldCount
      1 +
    context .localConstCount=
  oldCount return
end

proc( Type : t CompilerContext ptr.mut : context -> bool ) =>: referenceOnly
  context [] .program =:: program
  program .idContext .typeContext =:: typeContext
  t typeContext types.unwrapNamed
    typeContext types.unwrapRefinement
    .CType .if types.cTypeAsType else
    .IntLiteral ._if types.intLiteralAsInt end
  =:: baseType
  baseType types.isPrimitive if
    false return
  end
  baseType typeContext types.isEnum if
    false return
  end
  baseType typeContext types.isPointer if
    false return
  end
  ## TODO allow small composites as value-type
  true return
end
proc(
  types.TypeSize : size
  Type : t
  FilePosition ptr : pos
  CompilerContext ptr.mut : context
-> i64 ) =>: typeSizeAsInt
  context [] .program =:: program
  program .errors =:: errors
  program .idContext .typeContext =:: typeContext
  size switch
    Fixed .case return
    DynamicArray case
      "dynamic arrays are not supported in this context: " sb.copyPtr
         t typeContext sb.appendType
      pos errors appendError
      0 return
    Unknown case
      "could not determine size of type: " sb.copyPtr
         t typeContext sb.appendType
      pos errors appendError
      0 return
  end
end
proc(
  Type : t
  FilePosition ptr : pos
  CompilerContext ptr.mut : context
-> i64 ) =>: typeAlignmentInt
  context [] .program =:: program
  program .idContext .typeContext =:: typeContext
  t typeContext types.alignOf t pos context typeSizeAsInt return
end
proc(
  Type : t
  FilePosition ptr : pos
  CompilerContext ptr.mut : context
-> i64 ) =>: typeSizeInt
  context [] .program =:: program
  program .idContext .typeContext =:: typeContext
  t typeContext types.sizeOf t pos context typeSizeAsInt return
end
proc(
  Type : t
  FilePosition ptr : pos
  CompilerContext ptr.mut : context
-> i64 ) =>: typeStrideInt
  context [] .program =:: program
  program .idContext .typeContext =:: typeContext
  t typeContext types.strideOf t pos context typeSizeAsInt return
end
proc(
  Type : t
  i32 : i
  FilePosition ptr : pos
  CompilerContext ptr.mut : context
-> i64 ) =>: tupleEltOffsetInt
  context [] .program =:: program
  program .errors =:: errors
  program .idContext .typeContext =:: typeContext
  t i typeContext types.tupleElementOffset .if return end
  "could not compute offset of element " sb.copyPtr
    i sb.appendI
    " in tuple " sb.appendS
    t typeContext sb.appendType
  pos errors appendError
  0 return
end

struct(
  string : blockName
  BranchId slice : branchIds
  FilePosition ptr : pos
  CompilerContext ptr.mut : context
  stringBuilder ptr.mut : out
) =:: MergePoint
proc(
  StackValue ptr slice : toMerge
  i32 : offset
  MergePoint : mergePoint
-> StackValue ) =>: mergeBranches
  mergePoint .context =:: context
  context [] .program =:: program
  program .errors =:: errors
  program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .nameContext =:: nameContext
  toMerge 0 [] =:: rootValue
  true =:: mut: isMerged
  1:iSize while $ toMerge .length u< do =:: i
    toMerge i [] [] rootValue [] StackValue.eq ! if
      false isMerged=
      i break
    end
    i 1:iSize +
  end ..drop
  isMerged if
    rootValue [] return
  end
  1:iSize while $ toMerge .length u< do =:: i
    toMerge i [] [] rootValue [] StackValue.valTypesEq ! if
      "branches of " sb.copyPtr
         mergePoint .blockName sb.appendStr
         "-statement are out of sync expected: " sb.appendS
         rootValue [] StackValue.sbAppendValType
         " got: " sb.appendS
         toMerge i [] [] StackValue.sbAppendValType
      mergePoint .pos errors appendError
      i break
    end
    i 1:iSize +
  end ..drop
  mergePoint .out []
    rootValue [] =:: srcVal
    context nextStackValueId =:: newId
    newId ValueId.sbAppend
    " =" sb.appendS
    srcVal .valType sb.appendValTypeQBE
    " phi " sb.appendS
    0:iSize while $ toMerge .length u< do =:: i
      i 0:iSize iSize.sgt if
        ", " sb.appendS
      end
      mergePoint .branchIds i [] sb.appendBranchId
      ' ' sb.appendC
      toMerge i [] [] .valueId ValueId.sbAppend
      i 1:iSize +
    end ..drop
    '\n' sb.appendC
    ## StackValue
      newId
      srcVal .valType
    StackValue.create <$
  mergePoint .out =[]
end


proc( LabelState CompilerContext ptr.mut : context -> LabelState ) =>: rememberStackStateAtLabel
  $ .branches context .stackInfo branchTree.startBranch list.append >$ .branches=
  $ .branchIds context [] .currentBranch list.append >$ .branchIds=
end
proc( stringBuilder
  LocalLabelId : labelId
  FilePosition ptr : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: rememberStackState
  context [] .program .backJumpInfo labelId map.get .if
    context .stackInfo branchTree.startBranch =:: oldBranch
    .modifiedTypes for =:: i
      context .stackInfo branchTree.pop .else
        "stack underflow" sb.copyPtr pos context [] .program .errors appendError
        return
      end =:: srcVal
      "%label" sb.appendS labelId i64 cast.u sb.appendI
        '_' sb.appendC i sb.appendI
      " =" sb.appendS srcVal [] .valType sb.appendValTypeQBE
      " copy " sb.appendS srcVal [] .valueId ValueId.sbAppend '\n' sb.appendC
    end
    context .stackInfo oldBranch branchTree.reset =:: tmpBranch
    context .stackInfo tmpBranch branchTree.endBranch
  else
    context .labelStates labelId map.at .else
      "missing label state" ..panic
    end =:: labelState
    labelState [] context rememberStackStateAtLabel labelState =[]
  end
end

namespace: sb
  proc(
    stringBuilder : sb
    NameId : nameId
    CompilerContext ptr.mut : context
  -> stringBuilder ) =>: appendGlobalName
    context [] .program =:: prog
    prog .idContext .typeContext .nameContext =:: nameContext
    sb
      '$' sb.appendC
      nameId id.identifierFlags id.FLAG_EXTERN & ? if
        ## use unmodified name for extern values
        nameId sb.appendIdentifierName
        return
      end
      CONCAT_PREFIX sb.appendS
      nameId id.identifierFlags id.FLAG_EXPORT & ? ! if
        nameId id.getIdentifierFile i64 cast sb.appendI
        "_F" sb.appendS
      end
      nameId nameContext sb.appendAsciifiedIdentifierPath
    return
  end

  proc(
    Type : t
    CompilerContext ptr.mut : context
  -> i64 ) =>: getTypeId
    context .typeIds t map.get .else
      context [] .typeIdCount
        context .typeIds t $2 map.put ..drop
      $ 1 + context .typeIdCount=
    end
  end
  proc(
    stringBuilder : sb
    Type : t
    string : name
    bool : isStored
    CompilerContext ptr.mut : context
  -> stringBuilder ) =>: appendCompositeTypeQBE
    isStored if
      sb
        ":" sb.appendS
        name sb.appendStr
        t context getTypeId sb.appendI
      ## return
    else
      sb "l" sb.appendS return
    end
  end
end
  enum( STACK LOAD ULOAD STORE ) =:: StorageType
namespace: sb
  proc(
    stringBuilder : sb
    Type : t
    StorageType : storeType
    FilePosition ptr : pos
    CompilerContext ptr.mut : context
  -> stringBuilder ) =>: appendTypeNameQBE
    context [] .program =:: prog
    prog .errors =:: errors
    prog .idContext .typeContext =:: typeContext
    typeContext .nameContext =:: nameContext
    t switch
      NamedType case
        sb
          t typeContext types.unwrapNamed storeType pos context
        appendTypeNameQBE
      return
      GeneratedType case
        sb
          t typeContext types.getGeneratedType storeType pos context
        appendTypeNameQBE
      return
      PrimitiveType .case =:: primtive
        primtive switch
          TYPE case sb ":type" sb.appendS return break
          BOOL case
            storeType switch
              STACK case sb "w" sb.appendS return
              LOAD ULOAD case sb "ub" sb.appendS return
              STORE case sb "b" sb.appendS return
            end
            break
          I8 case
            storeType switch
              STACK case sb "w" sb.appendS return
              LOAD case sb primtive .I8 if "sb" else "ub" end sb.appendS return
              ULOAD case sb "ub" sb.appendS return
              STORE case sb "b" sb.appendS return
            end
            break
          I16 case
            storeType switch
              STACK case sb "w" sb.appendS return
              LOAD case sb "sh" sb.appendS return
              ULOAD case sb "uh" sb.appendS return
              STORE case sb "h" sb.appendS return
            end
          break
          I32 case sb "w" sb.appendS return
          I64 case sb "l" sb.appendS return
          F16 case
            storeType switch
              STACK case sb "w" sb.appendS return
              LOAD ULOAD case sb "uh" sb.appendS return
              STORE case sb "h" sb.appendS return
            end
          break
          F32 case sb "s" sb.appendS return
          F64 case sb "d" sb.appendS return
        end
        break
      IntLiteral .case
        sb
          >$ types.intLiteralAsInt storeType pos context
        appendTypeNameQBE return
      CType .case
        sb
          >$ types.cTypeAsType
          $ .Undefined ? if ..drop.2 break end
        storeType pos context appendTypeNameQBE
        return
      Pointer MutablePointer RawPointer MutableRawPointer Procedure Quotation case
        sb "l" sb.appendS return
      ArrayType case
        sb t "array":s storeType .STACK ! context appendCompositeTypeQBE return
        break
      Struct TaggedUnion case
        sb t "struct":s storeType .STACK ! context appendCompositeTypeQBE return
        break
      RawUnion case
        sb t "union":s storeType .STACK ! context appendCompositeTypeQBE return
        break
      UnionElement case
        sb t typeContext types.getUnionElementUnion optional.unwrap
          typeContext types.unwrapNamed
        "struct":s storeType .STACK ! context appendCompositeTypeQBE return
        break
      Enum case
        sb
          t typeContext types.enumTagInfo ..drop
          storeType pos context
        appendTypeNameQBE return
      SetType RefinementType case
        sb
          t typeContext types.unwrapRefinement storeType pos context
        appendTypeNameQBE
      return
      Undefined Empty GenericType Initializer Align case
        break
    end
    "unsupported type " sb.copyPtr
      t typeContext sb.appendType
    pos errors appendError
    sb return
  end
  proc(
    stringBuilder : sb
    i32 : index
    CompilerContext ptr.mut : context
  -> stringBuilder ) =>: appendArgName
    sb
      "%a" sb.appendS
      index sb.appendI
    return
  end
  proc(
    stringBuilder : sb
    Type : procType
    FilePosition ptr : pos
    CompilerContext ptr.mut : context
  -> stringBuilder ) =>: appendProcSignature
    context [] .program =:: prog
    prog .errors =:: errors
    prog .idContext .typeContext =:: typeContext
    typeContext .nameContext =:: nameContext
    procType typeContext types.getCallConvention =:: callConvention
    procType typeContext types.getProcIn optional.unwrap =:: args
    false =:: mut: hasArgs
    sb
      "(" sb.appendS
      args .length 1:iSize - i32 cast.u while $ 0 >= do =:: i
        args i [] =:: mut: arg
        arg typeContext types.containsGeneric if
          arg typeContext types.isArray if
            arg
              false typeContext types.getAddressType
            arg=
          else arg typeContext types.isPointer ! _if
            "unexpected generic argument: " sb.copyPtr
              arg typeContext sb.appendType
            pos errors appendError
          end
        end
        procType i typeContext types.getProcArgName =:: argName?
        arg typeContext types.isEmpty if
          ## skip empty arguments
          continue
        end
        arg typeContext types.isType or argName? .and id.identifierFlags id.FLAG_STATIC & ? if
          continue
        end
        hasArgs if
          ',' sb.appendC
        end
        true hasArgs=
        arg StorageType .LOAD pos context appendTypeNameQBE
        ' ' sb.appendC
        i context appendArgName
      finally i 1 - end ..drop
      ")" sb.appendS
    return
  end
  ## TODO? merge code for string and array constants
  proc(
    type : auto: T
    stringBuilder : sb
    T slice : value
    char8 : valueChar
    bool : nullTerminate
  -> stringBuilder ) =>: appendPrimitiveArrayConstQBE
    sb
      0:iSize while $ value .length u< do =:: i
        i 0 != if ',' sb.appendC end
        valueChar sb.appendC
        ' ' sb.appendC
        value i [] i64 cast.u 0xff & sb.appendI
        i 1:iSize +
      end ..drop
      nullTerminate if
        value .length 0 != if
          ",b 0" sb.appendS
        else
          "b 0" sb.appendS
        end
      end
    return
  end
  proc(
    stringBuilder : sb
    string : value
    CompilerContext ptr.mut : context
  -> stringBuilder ) =>: appendStringPtrConstQBE
    sb
      '$' sb.appendC
      STRING_CONST_NAME sb.appendS
      context [] .stringConstants
        $ .length =:: strId
        value list.append
      context .stringConstants=
      strId sb.appendI
    return
  end
  proc(
    stringBuilder : sb
    ConstValue : value
    Type : ptrType
    FilePosition ptr : pos
    CompilerContext ptr.mut : context
  -> stringBuilder ) =>: appendPtrConstQBE
    context [] .program .idContext .typeContext =:: typeContext
    value .Array .and .length 0:iSize == if
      sb 0 sb.appendI return ## pointer to zero length array -> NULL-pointer
    end
    ptrType typeContext types.ptrTarget .else
      "expected pointer type" ..panic
    end
      ptrType typeContext types.isRawPointer if
        types.ArrayType .ARRAY
          0 types.ArraySize .Int
        typeContext types.newArrayType
      end
    =:: valueType
    sb
      '$' sb.appendC
      PTR_CONST_NAME sb.appendS
      context [] .ptrConstants
        $ .length =:: ptrId
        ## GlobalConst
          value
          valueType
          pos
        PtrConstant new list.append
      context .ptrConstants=
      ptrId sb.appendI
    return
  end
  proc(
    stringBuilder : sb
    PtrConstant ptr : constant
    CompilerContext ptr.mut : context
  -> stringBuilder ) =>: appendPtrConstDataQBE
    context [] .program =:: prog
    prog .idContext =:: idContext
    prog .errors =:: errors
    idContext .constContext =:: constContext
    idContext .typeContext =:: typeContext
    typeContext .nameContext =:: nameContext
    constant [] .value =:: value
    constant [] .valType types.isPrimitive or constant [] .valType .IntLiteral ? and
        ConstValue ..length 23:iSize == "no new constants" assert
        value switch
          Array8  .case .length 0:iSize == break
          Array16 .case .length 0:iSize == break
          Array32 .case .length 0:iSize == break
          Array64 .case .length 0:iSize == break
          Array   .case .length 0:iSize == break
          default false break
        end if ## zero length array as primitive type
      0 types.ArraySize .Int =:: size
      ## newArrayType
        constant [] .valType
        types.ArrayType .ARRAY
        size
      typeContext types.newArrayType
    else
      constant [] .valType
    end =:: valType
    sb
      valType
      value
      true
      constant [] .pos
    context appendConstQBE return
  end
  proc(
    stringBuilder : sb
    Type : t0
    ConstValue : value
    bool : isGlobal
    FilePosition ptr : pos
    CompilerContext ptr.mut : context
  -> stringBuilder ) =>: appendConstQBE
    context [] .program =:: prog
    prog .errors =:: errors
    prog .idContext .typeContext =:: typeContext
    typeContext .nameContext =:: nameContext
    prog .idContext .constContext =:: constContext
    t0 typeContext types.unwrapNamed typeContext types.unwrapRefinement =:: t
    sb
      isGlobal and t typeContext types.isPointer or
          t types.isPrimitive or t typeContext types.isEnum or
          t .CType ? or t .IntLiteral ? or t typeContext types.isProcedure if
        ## add name prefix for global constants, skip prefix for zero-length array constants
        t StorageType .STORE pos context sb.appendTypeNameQBE
        ' ' sb.appendC
      end
      value switch
        Bool .case if '1' else '0' end sb.appendC return
        Int .case =:: intValue
          t typeContext types.isPointer if
            ## treat pointer constants as integers of type iSize
            types.primitive.I_SIZE
          else
            t
              $ typeContext types.isEnum if
                typeContext types.enumTagInfo ..drop
              end
            .CType .if types.cTypeAsType else
            .IntLiteral ._if types.intLiteralAsInt end
          end =:: numType
          numType types.isPrimitive if
            numType typeContext types.primitiveValue switch
              I8  case intValue 0xff &   sb.appendI return
              I16 case intValue 0xffff & sb.appendI return
              I32 case intValue i32 cast sb.appendI return
              I64 case intValue sb.appendI return
              F16 case intValue f32 cast f16.fromF32 f16.bits i32 cast.s sb.appendI return
              F32 case intValue f32 cast f32.bits sb.appendI return
              F64 case intValue f64 cast f64.bits sb.appendI return
              BOOL TYPE case break
            end
          end
          "unexpected type for integer: " sb.copyPtr
            t typeContext sb.appendType
            " number-type: " sb.appendS
            numType typeContext sb.appendType
          pos errors appendError
          return
        break
        Char .case i32 cast.u sb.appendI return
        break
        Float .case =:: floatValue
          t
            .CType .if types.cTypeAsType else
            .IntLiteral ._if types.intLiteralAsInt end
          =:: numType
          numType types.primitive.F32 types.typeEquals if
            floatValue f32 cast f32.bits sb.appendI
          else numType types.primitive.F64 types.typeEquals _if
            floatValue f64.bits sb.appendI
          else numType types.primitive.F16 types.typeEquals _if
            floatValue f16.fromF64 f16.bits i32 cast.s sb.appendI
          else
            "unexpected type for float: " sb.copyPtr
              t typeContext sb.appendType
              " number-type: " sb.appendS
              numType typeContext sb.appendType
            pos errors appendError
          end
          return
        GenericArg .case pos context appendGenericArg return
        Array8 .case =:: arrayValue
          t typeContext types.isPointer if
            ## appendPtrConstQBE
              value
              t
              pos
              context
            appendPtrConstQBE
            return
          end
          isGlobal ! if break end
          arrayValue 'b' false appendPrimitiveArrayConstQBE return
        Array16 .case =:: arrayValue
          t typeContext types.isPointer if
            ## appendPtrConstQBE
              value
              t
              pos
              context
            appendPtrConstQBE
            return
          end
          isGlobal ! if break end
          arrayValue 'h' false appendPrimitiveArrayConstQBE return
        Array32 .case =:: arrayValue
          t typeContext types.isPointer if
            ## appendPtrConstQBE
              value
              t
              pos
              context
            appendPtrConstQBE
            return
          end
          isGlobal ! if break end
          arrayValue 'w' false appendPrimitiveArrayConstQBE return
        Array64 .case =:: arrayValue
          t typeContext types.isPointer if
            ## appendPtrConstQBE
              value
              t
              pos
              context
            appendPtrConstQBE
            return
          end
          isGlobal ! if break end
          arrayValue 'l' false appendPrimitiveArrayConstQBE return
        Array .case =:: arrayValue
          t typeContext types.isPointer if
            ## appendPtrConstQBE
              value
              t
              pos
              context
            appendPtrConstQBE
            return
          end
          isGlobal ! if break end
          t =:: containerType
          containerType typeContext types.getArrayBaseType .if =:: eltType
            eltType pos context typeSizeInt =:: eltSize
            eltType pos context typeStrideInt =:: eltStride
            0:iSize while $ arrayValue .length u< do =:: i
              i 0:iSize != if
                ',' sb.appendC
              end
              eltType arrayValue i [] true pos context appendConstQBE
              eltSize eltStride < if
                ",z " sb.appendS
                eltStride eltSize - sb.appendI
              end
              i 1:iSize +
            end ..drop
            return
          else containerType typeContext types.isTuple or containerType typeContext types.isTaggedUnion _if
            ## TODO ensure elements are ordered by memory location
            containerType typeContext types.compositeElts =:: types
            0:i64 =:: mut: offset
            false =:: mut: needsComma
            0:i32 while $ iSize cast.u arrayValue .length u< do =:: i
              types i [] =:: elt
              elt typeContext types.isEmpty if continue end
              containerType i pos context tupleEltOffsetInt =:: eltOffset
              needsComma if
                ',' sb.appendC
              else
                true needsComma=
              end
              offset eltOffset < if
                "z " sb.appendS
                eltOffset offset - sb.appendI
                ',' sb.appendC
                eltOffset offset=
              end
              ## appendConstQBE
                elt
                arrayValue i []
                true
                pos
              context appendConstQBE
              offset
                elt pos context typeSizeInt +
              offset=
            finally i 1 + end ..drop
            containerType pos context typeSizeInt =:: size
            offset size < if
              ",z " sb.appendS
              size offset - sb.appendI
            end
            return
          else
            "unsupported type for array constant: " sb.copyPtr
              t typeContext sb.appendType
              " expected array or tuple" sb.appendS
            pos errors appendError
            return
          end
          break
        Union .case =:: unionValue
          isGlobal ! if
            break ## TODO? support small unions as local constants
          end
          t typeContext types.isUnion ! if
            "unsupported type for union constant: " sb.copyPtr
              t typeContext sb.appendType
            pos errors appendError
            return
          end
          unionValue .eltIndex =:: eltIndex
          t eltIndex typeContext types.compositeGetElement .else
            break
          end =:: eltType
          0:i64 =:: mut: offset
          false =:: mut: needComma
          eltType typeContext types.isEmpty ! if
            ## appendConstQBE
              eltType
              value eltIndex constUnionElement if
                "union element index out of sync: expected " sb.copyPtr
                  eltIndex sb.appendI
                  " got " sb.appendS
                  unionValue .eltIndex sb.appendI
                pos errors appendError
              end
              isGlobal
              pos
              context
            appendConstQBE
            offset
              eltType pos context typeSizeInt +
            offset=
            true needComma=
          end
          t pos context typeSizeInt =:: size
          offset size < if
            needComma if ',' sb.appendC end
            "z " sb.appendS
            size offset - sb.appendI
            true needComma=
          end
          return
        Procedure .case =:: procValue
          ## appendGlobalName
            procValue ProcId.getName
          context appendGlobalName
          return
        GlobalPointer .case context appendGlobalName return
        None WildCard TypeId LocalValue LocalArray
            LocalArray8 LocalArray16 LocalArray32 LocalArray64
            ProcedureBundle case
        break
      end
      isGlobal if
        "unsupported constant: " sb.copyPtr
          value typeContext sb.appendConstant
        pos errors appendError
        return
      end
      context nextLocalConstId =:: constId
      context [] .localConstants
        ## LocalConst
          t
          value
          pos
          constId
        LocalConst new list.append
      context .localConstants=
      "$" sb.appendS
      LOCAL_CONST_NAME sb.appendS
      constId sb.appendI
    return
  end
  proc(
    stringBuilder : sb
    FilePosition ptr : pos
    CompilerContext ptr.mut : context
  -> stringBuilder ) =>: appendLocalConstants
    context [] .program .idContext .typeContext =:: typeContext
    sb
      context [] .localConstants for =:: constant
        "data $" sb.appendS
        LOCAL_CONST_NAME sb.appendS
        constant .id sb.appendI
        " = align " sb.appendS
        constant .valType pos context typeAlignmentInt sb.appendI
        " {" sb.appendS
        constant .valType constant .value true constant .pos context appendConstQBE
        "}\n" sb.appendS
      end
      context [] .localConstants
        list.clear
      context .localConstants=
    return
  end

  proc(
    stringBuilder : sb
    Type : t
    FilePosition ptr : pos
    CompilerContext ptr.mut : context
  -> stringBuilder ) =>: startTypeDeclaration
    sb
      "type " sb.appendS
      t StorageType .LOAD pos context appendTypeNameQBE
      " = align " sb.appendS
      t pos context typeAlignmentInt sb.appendI
      " {" sb.appendS
    return
  end
  proc(
    stringBuilder : sb
    Type : t
    FilePosition ptr : pos
    CompilerContext ptr.mut : context
  -> stringBuilder ) =>: startEltTypeDeclaration
    sb
      "type " sb.appendS
      t StorageType .LOAD pos context appendTypeNameQBE
      "_elt = align " sb.appendS
      t pos context typeAlignmentInt sb.appendI
      " {" sb.appendS
    return
  end
  proc(
    stringBuilder : sb
    Type : t
    FilePosition ptr : pos
    CompilerContext ptr.mut : context
  -> stringBuilder ) =>: eltTypeName
    sb
      t StorageType .LOAD pos context appendTypeNameQBE
      "_elt" sb.appendS
    return
  end
  proc(
    stringBuilder
  -> stringBuilder ) =>: endTypeDeclaration
    "}\n" sb.appendS return
  end
  proc(
    stringBuilder : sb
    Type : t0
    FilePosition ptr : pos
    CompilerContext ptr.mut : context
  -> stringBuilder ) =>: appendNestedTypeDeclarationQBE
    context [] .program =:: prog
    prog .errors =:: errors
    prog .idContext .typeContext =:: typeContext
    typeContext .nameContext =:: nameContext
    prog .idContext .constContext =:: constContext
    t0 typeContext types.unwrapNamed =:: t
    t typeContext types.getArrayBaseType .if =:: baseType
      t typeContext types.getArraySize .Int .else ..drop
        sb return ## no declaration for var-size array
      end =:: size
      baseType pos context typeSizeInt =:: baseSize
      baseType pos context typeStrideInt =:: baseStride
      sb
        baseType types.isPrimitive or baseType typeContext types.isPointer if
          ## appendTypeNameQBE
            baseType
            StorageType .STORE
            pos
          context sb.appendTypeNameQBE
        else
          t pos context eltTypeName
        end
        ' ' sb.appendC
        size sb.appendI
      return
    end
    t typeContext types.isTuple or t typeContext types.isTaggedUnion if
      t typeContext types.compositeElts =:: elts
      0:i64 =:: mut: offset
      false =:: mut: hasElt
      sb
        0:i32 while $ iSize cast.u elts .length u< do =:: i
          elts i [] =:: elt
          elt typeContext types.isEmpty if
            i 1 + continue
          end
          t i pos context tupleEltOffsetInt =:: eltOffset
          hasElt if
            ',' sb.appendC
          end
          true hasElt=
          offset eltOffset <= "offset <= eltOffset" assert
          offset eltOffset < if
            "b " sb.appendS
            eltOffset offset - sb.appendI
            ',' sb.appendC
            eltOffset offset=
          end
          ## appendNestedTypeDeclarationQBE
            elt
            pos
          context sb.appendNestedTypeDeclarationQBE
          offset
            elt pos context typeSizeInt +
          offset=
          i 1 +
        end ..drop
        t pos context typeSizeInt =:: size
        offset size < if
          ",b " sb.appendS
          size offset - sb.appendI
        end
      return
    end
    t typeContext types.isEnum if
      sb
        ## appendTypeNameQBE
          t typeContext types.enumTagInfo ..drop
          StorageType .STORE
          pos
        context sb.appendTypeNameQBE
      return
    end
    t typeContext types.isRawUnion if
      t typeContext types.compositeElts =:: elts
      false =:: mut: hasElt
      0:i64 =:: mut: bodySize
      t pos context typeSizeInt =:: totalSize
      sb
        -1:iSize =:: mut: nonEmptyIndex
        0:iSize =:: mut: nonEmptyCount
        elts .length for =:: i
          elts i [] =:: elt
          elt typeContext types.isEmpty if continue end
          nonEmptyCount 1:iSize + nonEmptyCount=
          nonEmptyIndex -1 != and
              elts nonEmptyIndex [] pos context typeAlignmentInt
              elt pos context typeAlignmentInt >= if
            continue ## already found element with higher alignemnt
          end
          i nonEmptyIndex=
        end
        nonEmptyCount 0:iSize != "non-empty union has non-empty element" assert
        nonEmptyCount 1:iSize == if
          elts nonEmptyIndex [] =:: elt
          ## appendNestedTypeDeclarationQBE
            elt
            pos
          context sb.appendNestedTypeDeclarationQBE
          elt pos context typeSizeInt =:: eltSize
          eltSize totalSize < if
            ",b " sb.appendS
            totalSize eltSize - sb.appendI
          end
        else
          "b " sb.appendS
          totalSize sb.appendI
        end
      return
    end
    sb
      ## appendTypeNameQBE
        t
        StorageType .STORE
        pos
      context sb.appendTypeNameQBE
    return
  end
  proc(
    stringBuilder : sb
    Type : t
    FilePosition ptr : pos
    CompilerContext ptr.mut : context
  -> stringBuilder ) =>: appendTypeDeclarationQBE
    context [] .program =:: prog
    prog .errors =:: errors
    prog .idContext .typeContext =:: typeContext
    typeContext .nameContext =:: nameContext
    prog .idContext .constContext =:: constContext
    t types.isNamedType or t types.isGeneratedType if
      sb return ## ignore named types
    end
    t typeContext types.isEmpty if
      sb return ## ignore empty types
    end
    t typeContext types.containsGeneric if
      sb return ## ignore generic types
    end
    t typeContext types.getArrayBaseType .if =:: baseType
      baseType pos context typeSizeInt =:: baseSize
      baseType pos context typeStrideInt =:: baseStride
      sb
        baseType types.isPrimitive ! and baseType typeContext types.isPointer ! if
          t pos context startEltTypeDeclaration
            ## appendNestedTypeDeclarationQBE
              baseType
              pos
            context sb.appendNestedTypeDeclarationQBE
            ",b " sb.appendS
            baseStride baseSize - sb.appendI
          endTypeDeclaration
        end
        t pos context startTypeDeclaration
        t pos context sb.appendNestedTypeDeclarationQBE
      endTypeDeclaration return
    end
    t typeContext types.isTuple or t typeContext types.isUnion if
      sb
        t pos context startTypeDeclaration
        t pos context sb.appendNestedTypeDeclarationQBE
      endTypeDeclaration return
    end
    sb return
  end
  proc(
    stringBuilder : sb
    FilePosition ptr : pos
  -> stringBuilder ) =>: appendPosQBE
    sb
      "dbgloc " sb.appendS
      pos [] .line sb.appendI
      ',' sb.appendC
      pos [] .posInLine sb.appendI
      " ## " sb.appendS
      pos [] .fileName sb.appendEscapedStrC
      '\n' sb.appendC
    return
  end
end

proc( string : fileName ProgramContext ptr : prog -> FileId ) =>: findFileId
  prog [] .progFiles .length for =:: i
    prog [] .progFiles i @[] .fileName [] sb.asStr =:: currentName
    fileName currentName string.eq if
      i FileId cast return
    end
  end
  FILE_ID_NONE return
end

proc(
  stringBuilder : sb
  FilePosition ptr : pos
  ProgramContext ptr : prog
-> stringBuilder ) =>: appendPosPrintfArgs
  sb
    ",l " sb.appendS
    pos [] .fileName .length sb.appendI
    ",l $" sb.appendS
    FILE_NAME_NAME sb.appendS
    pos [] .fileName prog findFileId i64 cast sb.appendI
    ",w " sb.appendS
    pos [] .line sb.appendI
    ",w " sb.appendS
    pos [] .posInLine sb.appendI
  return
end

proc(
  stringBuilder
  NameId  : nameId
  FilePosition ptr : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: appendGenericArg
  context [] .program =:: prog
  prog .errors =:: errors
  prog .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .nameContext =:: nameContext
  context [] .currentProc
    nameId
    typeContext
  types.findProcArgName .if =:: index
    ## appendArgName
      index
      context
    sb.appendArgName return
  end
  "cannot find generic argument: " sb.copyPtr
    nameId sb.appendIdentifierName
  pos errors appendError
end

proc(
  stringBuilder : sb
  ValType : valType
  ValueId : valId
  string : cmpType
  i64 : value
  BranchId : ifBranch
  BranchId : elseBranch
  FilePosition ptr : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: appendCmpAndJumpInt
  context nextTmpId =:: tmpId
  sb
    tmpId ValueId.sbAppend
    " =w c":s sb.appendStr
    cmpType sb.appendStr
    valType sb.appendValTypeQBE
    ' ' sb.appendC
    valId ValueId.sbAppend
    ", ":s sb.appendStr
    value sb.appendI
    "\njnz ":s sb.appendStr
    tmpId ValueId.sbAppend
    ", ":s sb.appendStr
    ifBranch sb.appendBranchId
    ", ":s sb.appendStr
    elseBranch sb.appendBranchId
    '\n' sb.appendC
  return
end

proc(
  stringBuilder : sb
  Type : tupleType
  ValueId : tupleId
  FilePosition ptr : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: flattenTupleQBE
  context [] .program =:: prog
  prog .idContext =:: idContext
  idContext .typeContext =:: typeContext
  tupleType typeContext types.compositeElts =:: elts
  sb
    0:i32 while $ iSize cast.u elts .length u< do =:: i
      elts i [] =:: eltType
      eltType context toValType =:: eltValType
      tupleType i pos context tupleEltOffsetInt =:: eltOffset
      eltType typeContext types.isEmpty if
        i 1 - continue
      end
      context nextTmpId =:: eltPtrId
      eltPtrId ValueId.sbAppend
      " =l add " sb.appendS
      tupleId ValueId.sbAppend
      ", " sb.appendS
      eltOffset sb.appendI
      '\n' sb.appendC
      eltValType context pushNewValue
        $ =:: eltId
      ValueId.sbAppend
      eltType context referenceOnly if
        eltType pos context false appendAlloc ..drop
        "blit ":s sb.appendStr
      else
        " =":s sb.appendStr
        eltValType sb.appendValTypeQBE
        " load":s sb.appendStr
        eltType StorageType .LOAD pos context sb.appendTypeNameQBE
        ' ' sb.appendC
      end
      eltPtrId ValueId.sbAppend
      eltType context referenceOnly if
        ", " sb.appendS
        eltId ValueId.sbAppend
        ',' sb.appendC
        eltType pos context typeSizeInt sb.appendI
      end
      '\n' sb.appendC
      i 1 +
    end ..drop
  return
end
proc(
  stringBuilder : sb
  Type : tupleType
  ValueId : dataPtrId
  FilePosition ptr : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: initializeTupleQBE
  context [] .program =:: prog
  prog .idContext =:: idContext
  idContext .typeContext =:: typeContext
  tupleType typeContext types.compositeElts =:: elts
  sb
    elts .length 1:iSize - i32 cast while $ 0 >= do =:: i
      elts i [] =:: eltType
      tupleType i pos context tupleEltOffsetInt =:: eltOffset
      eltType typeContext types.isEmpty if
        i 1 - continue
      end
      context nextTmpId =:: eltPtrId
      eltPtrId ValueId.sbAppend
      " =l add ":s sb.appendStr
      dataPtrId ValueId.sbAppend
      ", ":s sb.appendStr
      eltOffset sb.appendI
      '\n' sb.appendC
      eltType context referenceOnly if
        "blit ":s sb.appendStr
      else
        "store":s sb.appendStr
        eltType StorageType .STORE pos context sb.appendTypeNameQBE
        ' ' sb.appendC
      end
      pos context popValue ValueId.sbAppend
      ", ":s sb.appendStr
      eltPtrId ValueId.sbAppend
      eltType context referenceOnly if
        ',' sb.appendC
        eltType pos context typeSizeInt sb.appendI
      end
      '\n' sb.appendC
      i 1 -
    end ..drop
  return
end
## TODO move all (?most) allocations to start of procedure
proc(
  stringBuilder : sb
  Type : valType
  FilePosition ptr : pos
  CompilerContext ptr.mut : context
  bool : createId
-> stringBuilder ValueId ) =>: appendAlloc
  context [] .program =:: prog
  prog .idContext =:: idContext
  idContext .typeContext =:: typeContext
  ValueId .None =:: mut: tmpId
  sb
    createId if
      context nextTmpId tmpId=
      tmpId ValueId.sbAppend
    end
    " =l alloc" sb.appendS
    valType pos context typeAlignmentInt 4 i64.max sb.appendI
    ' ' sb.appendC
    valType pos context typeSizeInt  4 i64.max sb.appendI
    '\n' sb.appendC
  tmpId return
end

proc(
  stringBuilder : sb
  ValType : valType
  ValueId : valId
  LabelData slice : labels
  LocalLabelId slice : branchLabels
  LocalLabelId : defaultLabel
  i32 : opIndex
  i64 optional : lower
  i64 optional : upper
  FilePosition ptr : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: appendSwitchJumpTree
  labels .length 3:iSize u<= if
    false =:: mut: contiguous
    labels .length =:: mut: loopCount
    lower .and =:: lowVal upper .and =:: upVal
        upVal lowVal - labels .length i64 cast.u == contiguous=
        contiguous if
      loopCount 1:iSize - loopCount=
    end
    sb
      0:iSize while $ loopCount u< do =:: i
        labels i @[] .caseId [] =:: caseId
        ## BranchId
          BranchType .LABEL
          branchLabels caseId [] i32 cast.u
        BranchId new =:: caseBranch
        ## BranchId
          BranchType .NEXT
          context nextJumpLabelId
        BranchId new =:: nextBranch
        labels i [] .value switchLabelAsInt =:: cmpVal
        ## cmp int
          valType
          valId
          "eq":s
          cmpVal
          caseBranch
          nextBranch
        pos context appendCmpAndJumpInt
        nextBranch sb.appendBranchId
        '\n' sb.appendC
        i 1:iSize +
      end ..drop
      "jmp " sb.appendS
      contiguous if
        labels loopCount @[] .caseId [] =:: caseId
        ## BranchId
          BranchType .LABEL
          branchLabels caseId [] i32 cast.u
        BranchId new sb.appendBranchId
        '\n' sb.appendC
      else
        ## BranchId
          BranchType .LABEL
          defaultLabel i32 cast.u
        BranchId new sb.appendBranchId
        '\n' sb.appendC
      end
    return
  end
  labels .length 2:iSize / =:: p
  ## BranchId
    BranchType .NEXT
    context nextJumpLabelId
  BranchId new =:: ltBranch
  ## BranchId
    BranchType .NEXT
    context nextJumpLabelId
  BranchId new =:: geBranch
  labels p [] .value switchLabelAsInt =:: cmpVal
  labels p slice.cutIndex =:: lElts =:: rElts
  sb
    ## cmp int
      valType
      valId
      "slt":s
      cmpVal
      ltBranch
      geBranch
    pos context appendCmpAndJumpInt
    ltBranch sb.appendBranchId
    '\n' sb.appendC
    ## appendSwitchJumpTree
      valType
      valId
      lElts
      branchLabels
      defaultLabel
      opIndex
      lower
      cmpVal
        upper .if i64.min end
      optional.wrap
      pos context
    appendSwitchJumpTree
    geBranch sb.appendBranchId
    '\n' sb.appendC
    ## appendSwitchJumpTree
      valType
      valId
      rElts
      branchLabels
      defaultLabel
      opIndex
      cmpVal
        lower .if i64.max end
      optional.wrap
      upper
      pos context
    appendSwitchJumpTree
  return
end
proc(
  stringBuilder : sb
  Type : switchType
  ValueId : valId
  LabelData list : labels ## switch labels (sorted by type-checker)
  LocalLabelId slice : branchLabels
  LocalLabelId : defaultLabel
  i32 : opIndex
  FilePosition ptr : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: appendSwitchTable
  context [] .program =:: prog
  prog .errors =:: errors
  prog .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .nameContext =:: nameContext
  branchLabels for =:: labelId
    context .labelStates
      labelId
      LabelState.new context rememberStackStateAtLabel
    map.put ..drop
  end
  context .labelStates
    defaultLabel
    LabelState.new context rememberStackStateAtLabel
  map.put ..drop
  sb
    "## switch\n" sb.appendS
    switchType typeContext types.isInt ! and switchType typeContext types.isChar ! if
      "unsupported type in switch: " sb.copyPtr
        switchType typeContext sb.appendType
      pos errors appendError
      return
    end
    switchType
      typeContext types.primitiveValue
    types.sizeOfPrimitive =:: numBytes
    switchType context toValType =:: valType
    numBytes 4 < if
      context nextTmpId =:: tmpId
      tmpId ValueId.sbAppend
      " =":s sb.appendStr
      valType sb.appendValTypeQBE
      " ext":s sb.appendStr
      switchType
        StorageType .ULOAD
      pos context sb.appendTypeNameQBE
      ' ' sb.appendC
      valId ValueId.sbAppend
      '\n' sb.appendC
      tmpId
    else
      valId
    end =:: srcId
    ## appendJumpTable
      valType
      srcId
      labels list.asSlice
      branchLabels
      defaultLabel
      opIndex
      i64 optional.empty
      i64 optional.empty
      pos context
    appendSwitchJumpTree
  return
end

proc(
  stringBuilder : sb
  string : name
  ValType : valType
  FilePosition ptr : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: appendUnaryOperator
  pos context popValue =:: arg
  sb
    valType context pushNewValue ValueId.sbAppend
    " =" sb.appendS
    valType sb.appendValTypeQBE
    ' ' sb.appendC
    name sb.appendStr
    ' ' sb.appendC
    arg ValueId.sbAppend
    '\n' sb.appendC
  return
end
proc(
  stringBuilder : sb
  string : name
  ValType : valType
  FilePosition ptr : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: appendBinaryOperator
  pos context popValue =:: arg2
  pos context popValue =:: arg1
  sb
    valType context pushNewValue ValueId.sbAppend
    " =" sb.appendS
    valType sb.appendValTypeQBE
    ' ' sb.appendC
    name sb.appendStr
    ' ' sb.appendC
    arg1 ValueId.sbAppend
    ", " sb.appendS
    arg2 ValueId.sbAppend
    '\n' sb.appendC
  return
end
proc(
  stringBuilder : sb
  string : name
  ValType : resValue
  ValType : arg2Value
  bool : signed
  FilePosition ptr : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: appendMixedDivisionOperator
  pos context popValue =:: arg2
  pos context popValue =:: arg1
  context nextTmpId =:: tmpId
  sb
    tmpId ValueId.sbAppend
    " =":s sb.appendStr
    resValue sb.appendValTypeQBE
    " ext":s sb.appendStr
    signed if 's' else 'u' end sb.appendC
    arg2Value sb.appendValTypeQBE
    ' ' sb.appendC
    arg2 ValueId.sbAppend
    '\n' sb.appendC
    resValue context pushNewValue ValueId.sbAppend
    " =":s sb.appendStr
    resValue sb.appendValTypeQBE
    ' ' sb.appendC
    name sb.appendStr
    ' ' sb.appendC
    arg1 ValueId.sbAppend
    ", ":s sb.appendStr
    tmpId ValueId.sbAppend
    '\n' sb.appendC
  return
end
proc(
  stringBuilder : sb
  string : cmpType
  ValType : valType
  FilePosition ptr : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: appendComparisonOperator
  pos context popValue =:: arg2
  pos context popValue =:: arg1
  sb
    ValType .I32 context pushNewValue ValueId.sbAppend
    " =w c" sb.appendS
    cmpType sb.appendStr
    valType sb.appendValTypeQBE
    ' ' sb.appendC
    arg1 ValueId.sbAppend
    ", " sb.appendS
    arg2 ValueId.sbAppend
    '\n' sb.appendC
  return
end
proc(
  stringBuilder : sb
  Type : src
  bool : signed
  FilePosition ptr : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: extendArguments
  ValueId 2 array new =:: mut: args
  context [] .program =:: prog
  prog .idContext =:: idContext
  idContext .typeContext =:: typeContext
  src typeContext types.unwrapNamed .CType .if =:: cType
    sb
      cType types.cTypeAsType
      signed
      pos
      context
    extendArguments return
  else .IntLiteral ._if =:: intLiteral
    sb
      intLiteral types.intLiteralAsInt
      signed
      pos
      context
    extendArguments return
  else ..drop end
  src typeContext types.isInt ! if
    sb return
  end
  src typeContext types.primitiveValue types.sizeOfPrimitive 4 >= if
    sb return
  end
  pos context popValue args@ 1 =[]
  pos context popValue args@ 0 =[]
  sb
    0 while $ 2 < do =:: i
      ValType .I32 context pushNewValue ValueId.sbAppend
      " =w ext" sb.appendS
      signed if 's' else 'u' end sb.appendC
      src StorageType .STORE pos context sb.appendTypeNameQBE
      ' ' sb.appendC
      args@ i [] ValueId.sbAppend
      '\n' sb.appendC
      i 1 +
    end ..drop
  return
end

proc(
  stringBuilder : sb
  BuiltIn : builtIn
  Type : opType
  FilePosition ptr : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: appendBuiltInQBE
  context [] .program =:: prog
  prog .errors =:: errors
  prog .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .nameContext =:: nameContext
  opType typeContext types.getProcIn
    $ ? =:: typeIsProc
  .if =:: inTypes
    inTypes .length 0:iSize != if
      opType 0 typeContext types.getProcArgName .and id.identifierFlags id.FLAG_STATIC & ? if
        1:i32
      else
        0:i32
      end =:: firstArg
      inTypes firstArg []
    else
        opType typeContext types.getProcOut optional.unwrap =:: outTypes
        outTypes .length 0:iSize != _if
      outTypes 0 []
    else
      Type .Undefined
    end
  else opType end =:: baseType
  baseType context toValType =:: baseVal
  BuiltIn ..length 221 == "no new built-ins" assert
  builtIn switch
    NEG_I8 NEG_I16 NEG_I32 NEG_I64 NEG_F32 NEG_F64 case
      sb "neg":s baseVal pos context appendUnaryOperator
      return
    ADD_I8 ADD_I16 ADD_I32 ADD_I64 ADD_F32 ADD_F64 case
      sb "add":s baseVal pos context appendBinaryOperator
      return
    SUB_I8 SUB_I16 SUB_I32 SUB_I64 SUB_F32 SUB_F64 case
      sb "sub":s baseVal pos context appendBinaryOperator
      return ## TODO ensure char-diff arguments are zero extended
    MUL_I32 MUL_I64 MUL_F32 MUL_F64 case
      sb "mul":s baseVal pos context appendBinaryOperator
      return
    DIV_I32  DIV_I64 DIV_F32 DIV_F64 case
      sb "div":s baseVal pos context appendBinaryOperator
      return
    DIV_I64I32 case
      sb "div":s baseVal ValType .I32 true pos context appendMixedDivisionOperator
      return
    REM_I32 REM_I64 case
      sb "rem":s baseVal pos context appendBinaryOperator
      return
    REM_I64I32 case
      sb "rem":s baseVal ValType .I32 true pos context appendMixedDivisionOperator
      return
    UDIV_I32 UDIV_I64 case
      sb "udiv":s baseVal pos context appendBinaryOperator
      return
    UDIV_I64I32 case
      sb "udiv":s baseVal ValType .I32 false pos context appendMixedDivisionOperator
      return
    UMOD_I32 UMOD_I64 case
      sb "urem":s baseVal pos context appendBinaryOperator
      return
    UMOD_I64I32 case
      sb "urem":s baseVal ValType .I32 false pos context appendMixedDivisionOperator
      return
    NOT_BOOL case
      pos context popValue =:: arg
      sb
        baseVal context pushNewValue ValueId.sbAppend
        " =w extub " sb.appendS
        arg ValueId.sbAppend
        '\n' sb.appendC
        "ceqw 0,":s baseVal pos context appendUnaryOperator
      return
    FLIP_I8 FLIP_I16 FLIP_I32 FLIP_I64 case
      sb
        "xor -1,":s baseVal pos context appendUnaryOperator
      return
    AND_BOOL AND_I8 AND_I16 AND_I32 AND_I64 case
      sb "and":s baseVal pos context appendBinaryOperator
      return
    OR_BOOL  OR_I8 OR_I16 OR_I32 OR_I64 case
      sb "or":s baseVal pos context appendBinaryOperator
      return
    XOR_BOOL XOR_I8 XOR_I16 XOR_I32 XOR_I64 case
      sb "xor":s baseVal pos context appendBinaryOperator
      return
    ## shift truncates second operand, no special handling for mixed size needed
    LSHR_I8 LSHR_I16 LSHR_I32 LSHR_I64I32 LSHR_I64 case
      sb
        baseType false pos context extendArguments
        "shr":s baseVal pos context appendBinaryOperator
      return
    ASHR_I8 ASHR_I16 ASHR_I32 ASHR_I64I32 ASHR_I64 case
      sb
        baseType true pos context extendArguments
        "sar":s baseVal pos context appendBinaryOperator
      return
    SHL_I8 SHL_I16 SHL_I32 SHL_I64I32 SHL_I64 case
      sb "shl":s baseVal pos context appendBinaryOperator
      return
    EQ_BOOL EQ_I8 EQ_I16 EQ_I32 EQ_I64 EQ_F32 EQ_F64 case
      sb
        baseType true pos context extendArguments
        "eq":s baseVal pos context appendComparisonOperator
      return
    NE_BOOL NE_I8 NE_I16 NE_I32 NE_I64 NE_F32 NE_F64 case
      sb
        baseType true pos context extendArguments
        "ne":s baseVal pos context appendComparisonOperator
      return
    LT_I8 LT_I16 LT_I32 LT_I64 case
      sb
        baseType true pos context extendArguments
        "slt":s baseVal pos context appendComparisonOperator
      return
    LE_I8 LE_I16 LE_I32 LE_I64 case
      sb
        baseType true pos context extendArguments
        "sle":s baseVal pos context appendComparisonOperator
      return
    GE_I8 GE_I16 GE_I32 GE_I64 case
      sb
        baseType true pos context extendArguments
        "sge":s baseVal pos context appendComparisonOperator
      return
    GT_I8 GT_I16 GT_I32 GT_I64 case
      sb
        baseType true pos context extendArguments
        "sgt":s baseVal pos context appendComparisonOperator
      return
    LT_F32 LT_F64 case
      sb
        baseType true pos context extendArguments
        "lt":s baseVal pos context appendComparisonOperator
      return
    LE_F32 LE_F64 case
      sb
        baseType true pos context extendArguments
        "le":s baseVal pos context appendComparisonOperator
      return
    GE_F32 GE_F64 case
      sb
        baseType true pos context extendArguments
        "ge":s baseVal pos context appendComparisonOperator
      return
    GT_F32 GT_F64  case
      sb
        baseType true pos context extendArguments
        "gt":s baseVal pos context appendComparisonOperator
      return
    ULT_I8 ULT_I16 ULT_I32 ULT_I64 case
      sb
        baseType false pos context extendArguments
        "ult":s baseVal pos context appendComparisonOperator
      return
    ULE_I8 ULE_I16 ULE_I32 ULE_I64 case
      sb
        baseType false pos context extendArguments
        "ule":s baseVal pos context appendComparisonOperator
      return
    UGE_I8 UGE_I16 UGE_I32 UGE_I64 case
      sb
        baseType false pos context extendArguments
        "uge":s baseVal pos context appendComparisonOperator
      return
    UGT_I8 UGT_I16 UGT_I32 UGT_I64 case
      sb
        baseType false pos context extendArguments
        "ugt":s baseVal pos context appendComparisonOperator
      return
    GET_PTR case
      ## base-type is pointer to value
      typeIsProc ! if baseType else ## if type is directly given use type
          baseType typeContext types.getBaseType ._else
        "expected pointer got: " sb.copyPtr
          baseType typeContext sb.appendType
        pos errors appendError
        baseType
      end =:: valueType
      valueType context toValType =:: valType
      valueType context referenceOnly if
        ## get-ptr on reference type yields reference
        context .stackInfo branchTree.peek .if
          ValType .REFERENCE >$ .valType=
        end
        sb return
      end
      pos context popValue =:: valPtr
      valueType typeContext types.isEmpty if
        sb return
      end
      sb
        valType context pushNewValue ValueId.sbAppend
        " =" sb.appendS
        valType sb.appendValTypeQBE
        " load" sb.appendS
        valueType StorageType .LOAD pos context sb.appendTypeNameQBE
        ' ' sb.appendC
        valPtr ValueId.sbAppend
        '\n' sb.appendC
      return
    SET_PTR case
      pos context popValue =:: targetPtr
      baseType typeContext types.isEmpty if
        sb return
      end
      pos context popValue =:: srcVal
      sb
        baseType context referenceOnly if
          "blit " sb.appendS
        else
          "store" sb.appendS
          baseType StorageType .STORE pos context sb.appendTypeNameQBE
          ' ' sb.appendC
        end
        srcVal ValueId.sbAppend
        ", " sb.appendS
        targetPtr ValueId.sbAppend
        baseType context referenceOnly if
          ", " sb.appendS
          baseType pos context typeSizeInt sb.appendI
        end
        '\n' sb.appendC
      return
    COPY_PTR case
      pos context popValue =:: targetPtr
      baseType typeContext types.isEmpty if
        sb return
      end
      pos context popValue =:: srcPtr
      sb
        "blit " sb.appendS
        srcPtr ValueId.sbAppend
        ", " sb.appendS
        targetPtr ValueId.sbAppend
        ", " sb.appendS
        baseType pos context typeSizeInt sb.appendI
        '\n' sb.appendC
      return
    CLEAR_PTR case
      pos context popValue =:: targetPtr
      baseType typeContext types.isEmpty if
        sb return
      end
      sb ## zero-out memory
        "call $memset(l " sb.appendS
        targetPtr ValueId.sbAppend
        ",w 0,l " sb.appendS
        baseType pos context typeSizeInt sb.appendI
        ")\n" sb.appendS
      return
    OFFSET_PTR case
      ## baseType is pointer type
      typeIsProc ! if baseType else
          baseType typeContext types.getBaseType ._else
        "expected pointer got: " sb.copyPtr
          baseType typeContext sb.appendType
        pos errors appendError
        Type .Empty
      end =:: eltType
      sb
        pos context popValue =:: baseOffset
        eltType .Empty ? or
            eltType pos context typeStrideInt =:: eltStride eltStride 1 == if
          pos context popValue
          baseOffset
        else
          ValType .I64 context pushNewValue ValueId.sbAppend
          " =l mul ":s sb.appendStr
          baseOffset ValueId.sbAppend
          ", ":s sb.appendStr
          eltType pos context typeStrideInt sb.appendI
          '\n' sb.appendC
          pos context popValue
          pos context popValue
        end =:: srcPtr =:: offset
        ValType .PTR context pushNewValue ValueId.sbAppend
        " =l add ":s sb.appendStr
        srcPtr ValueId.sbAppend
        ", ":s sb.appendStr
        offset ValueId.sbAppend
        '\n' sb.appendC
      return
    CONVERT_S8_I16 CONVERT_S8_I32 case sb "extsb":s ValType .I32 pos context appendUnaryOperator return
    CONVERT_S8_I64 case sb "extsb":s ValType .I64 pos context appendUnaryOperator return
    CONVERT_U8_I16 CONVERT_U8_I32 CONVERT_I16_I8 CONVERT_I32_I8 CONVERT_I64_I8 case
      sb "extub":s ValType .I32 pos context appendUnaryOperator return
    CONVERT_U8_I64 case sb "extub":s ValType .I64 pos context appendUnaryOperator return
    CONVERT_S16_I32 case sb "extsh":s ValType .I32 pos context appendUnaryOperator return
    CONVERT_S16_I64 case sb "extsh":s ValType .I64 pos context appendUnaryOperator return
    CONVERT_U16_I32 CONVERT_I32_I16 CONVERT_I64_I16 case
      sb "extuh":s ValType .I32 pos context appendUnaryOperator return
    CONVERT_U16_I64 case sb "extuh":s ValType .I64 pos context appendUnaryOperator return
    CONVERT_S32_I64 case sb "extsw":s ValType .I64 pos context appendUnaryOperator return
    CONVERT_U32_I64 case sb "extuw":s ValType .I64 pos context appendUnaryOperator return
    CONVERT_I64_I32 case sb "copy":s ValType .I32 pos context appendUnaryOperator return
    CONVERT_S8_F32 CONVERT_S16_F32 CONVERT_S32_F32 CONVERT_S64_F32 case
      sb "swtof":s ValType .FLOAT pos context appendUnaryOperator return
    CONVERT_S8_F64 CONVERT_S16_F64 CONVERT_S32_F64 CONVERT_S64_F64 case
      sb "swtof":s ValType .DOUBLE pos context appendUnaryOperator return
    CONVERT_U8_F32 CONVERT_U16_F32 CONVERT_U32_F32 CONVERT_U64_F32 case
      sb "uwtof":s ValType .FLOAT pos context appendUnaryOperator return
    CONVERT_U8_F64 CONVERT_U16_F64 CONVERT_U32_F64 CONVERT_U64_F64 case
      sb "uwtof":s ValType .DOUBLE pos context appendUnaryOperator return
    CONVERT_F32_S8 case ## TODO simplify float->int conversion
      sb types.PrimitiveType .F32 types.PrimitiveType .I8 false pos context castFloatToIntHelper return
    CONVERT_F32_U8 case
      sb types.PrimitiveType .F32 types.PrimitiveType .I8 true pos context castFloatToIntHelper return
    CONVERT_F64_S8 case
      sb types.PrimitiveType .F64 types.PrimitiveType .I8 false pos context castFloatToIntHelper return
    CONVERT_F64_U8 case
      sb types.PrimitiveType .F64 types.PrimitiveType .I8 true pos context castFloatToIntHelper return
    CONVERT_F32_S16 case
      sb types.PrimitiveType .F32 types.PrimitiveType .I16 false pos context castFloatToIntHelper return
    CONVERT_F32_U16 case
      sb types.PrimitiveType .F32 types.PrimitiveType .I16 true pos context castFloatToIntHelper return
    CONVERT_F64_S16 case
      sb types.PrimitiveType .F64 types.PrimitiveType .I16 false pos context castFloatToIntHelper return
    CONVERT_F64_U16 case
      sb types.PrimitiveType .F64 types.PrimitiveType .I16 true pos context castFloatToIntHelper return
    CONVERT_F32_S32 case
      sb types.PrimitiveType .F32 types.PrimitiveType .I32 false pos context castFloatToIntHelper return
    CONVERT_F32_U32 case
      sb types.PrimitiveType .F32 types.PrimitiveType .I32 true pos context castFloatToIntHelper return
    CONVERT_F64_S32 case
      sb types.PrimitiveType .F64 types.PrimitiveType .I32 false pos context castFloatToIntHelper return
    CONVERT_F64_U32 case
      sb types.PrimitiveType .F64 types.PrimitiveType .I32 true pos context castFloatToIntHelper return
    CONVERT_F32_S64 case
      sb types.PrimitiveType .F32 types.PrimitiveType .I64 false pos context castFloatToIntHelper return
    CONVERT_F32_U64 case
      sb types.PrimitiveType .F32 types.PrimitiveType .I64 true pos context castFloatToIntHelper return
    CONVERT_F64_S64 case
      sb types.PrimitiveType .F64 types.PrimitiveType .I64 false pos context castFloatToIntHelper return
    CONVERT_F64_U64 case
      sb types.PrimitiveType .F64 types.PrimitiveType .I64 true pos context castFloatToIntHelper return
    CONVERT_F32_F64 case sb "exts":s ValType .DOUBLE pos context appendUnaryOperator return
    CONVERT_F64_F32 case sb "truncd":s ValType .FLOAT pos context appendUnaryOperator return
    SYS_ARGC case
      sb
        baseVal context pushNewValue ValueId.sbAppend
        " =" sb.appendS
        baseVal sb.appendValTypeQBE
        " load $" sb.appendS
        CONCAT_ARGC_NAME sb.appendS
        '\n' sb.appendC
      return
    SYS_ARGV case
      sb
        baseVal context pushNewValue ValueId.sbAppend
        " =" sb.appendS
        baseVal sb.appendValTypeQBE
        " load $" sb.appendS
        CONCAT_ARGV_NAME sb.appendS
        '\n' sb.appendC
      return
    SYS_ENVP case
      sb
        baseVal context pushNewValue ValueId.sbAppend
        " =" sb.appendS
        baseVal sb.appendValTypeQBE
        " load $" sb.appendS
        CONCAT_ENVP_NAME sb.appendS
        '\n' sb.appendC
      return
    default
      "unsupported built-in: " sb.copyPtr
        builtIn sb.appendBuiltIn
      pos errors appendError
      sb return
  end
end

enum( MIN MAX ) =:: BoundType
proc(
  stringBuilder : sb
  types.PrimitiveType : srcType
  bool : unsigned
  BoundType : boundType
  types.PrimitiveType : asType
-> stringBuilder ) =>: appendNumberBound
  sb
    srcType switch
      I8 case
        unsigned if boundType .MIN if 0 else i8.UMAX i64 cast.u end
          else boundType .MIN _if i8.MIN i64 cast.s else i8.MAX i64 cast.s end
        break
      I16 case
        unsigned if boundType .MIN if 0 else i16.UMAX i64 cast.u end
          else boundType .MIN _if i16.MIN i64 cast.s else i16.MAX i64 cast.s end
        break
      I32 case
        unsigned if boundType .MIN if 0 else i32.UMAX i64 cast.u end
          else boundType .MIN _if i32.MIN i64 cast.s else i32.MAX i64 cast.s end
        break
      I64 case
        unsigned if boundType .MIN if 0 else i64.UMAX end
          else boundType .MIN _if i64.MIN else i64.MAX end
        break
      BOOL case boundType .MIN if 0 else 1 end break
      F16 case
        asType switch
          I8 I16 I32 I64 case
            asType unsigned boundType asType appendNumberBound return
          F16 case
            boundType .MIN if f16.MIN else f16.MAX end f16.bits i32 cast.s sb.appendI return
          F32 case
            boundType .MIN if f32.MIN else f32.MAX end f32.bits sb.appendI return
          F64 case
            boundType .MIN if f64.MIN else f64.MAX end f64.bits sb.appendI return
          BOOL TYPE case ..unreachable
        end
        break
      F32 case
        asType switch
          I8 I16 I32 I64 case
            asType unsigned boundType asType appendNumberBound return
          F16 case
            boundType .MIN if f16.Infinity else f16.-Infinity end f16.bits i32 cast.s sb.appendI return
          F32 case
            boundType .MIN if f32.MIN else f32.MAX end f32.bits sb.appendI return
          F64 case
            boundType .MIN if f64.MIN else f64.MAX end f64.bits sb.appendI return
          BOOL TYPE case ..unreachable
        end
        break
      F64 case
        asType switch
          I8 I16 I32 I64 case
            asType unsigned boundType asType appendNumberBound return
          F16 case
            boundType .MIN if f16.Infinity else f16.-Infinity end f16.bits i32 cast.s sb.appendI return
          F32 case
            boundType .MIN if f32.Infinity else f32.-Infinity end f32.bits sb.appendI return
          F64 case
            boundType .MIN if f64.MIN else f64.MAX end f64.bits sb.appendI return
          BOOL TYPE case ..unreachable
        end
        break
      TYPE case ..unreachable
    end =:: intVal
  asType switch
    I8 I16 I32 I64 case
      intVal sb.appendI return
    F16 case intVal unsigned if f32 cast.u else f32 cast end f16.fromF32 f16.bits i32 cast.s sb.appendI return
    F32 case intVal unsigned if f32 cast.u else f32 cast end f32.bits sb.appendI return
    F64 case intVal unsigned if f64 cast.u else f64 cast end f64.bits sb.appendI return
    BOOL TYPE case ..unreachable
  end
end

proc(
  stringBuilder
  types.PrimitiveType : srcVal
  types.PrimitiveType : targetVal
  bool : unsigned
  FilePosition ptr : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: castFloatToIntHelper
  pos context popValue =:: srcLoc
  ## castFloatToInt
    srcVal
    srcLoc
    targetVal Type .PrimitiveType
    targetVal
    unsigned
  pos context castFloatToInt
    targetVal Type .PrimitiveType context toValType
  >$ context pushValue
end
proc(
  stringBuilder : sb
  types.PrimitiveType : srcVal
  ValueId : srcLoc
  Type : targetType
  types.PrimitiveType : targetVal
  bool : unsigned
  FilePosition ptr : pos
  CompilerContext ptr.mut : context
-> stringBuilder ValueId ) =>: castFloatToInt
  BranchId 7 array new =:: mut: branches
  0 while $ 7 < do =:: i
    ## BranchId
      BranchType .NEXT
      context nextJumpLabelId
    BranchId new branches@ i =[]
    i 1 +
  end ..drop
  context nextTmpId =:: cNaN
  context nextTmpId =:: cMin
  context nextTmpId =:: cMax
  context nextTmpId =:: tCast
  context nextTmpId =:: tNaN
  context nextTmpId =:: tMin
  context nextTmpId =:: tMax
  srcVal .F32 if 's'
  else srcVal .F64 _if 'd'
  else ..unreachable end =:: srcTypeName
  sb
    ## isNaN?
    cNaN ValueId.sbAppend
    " =w co":s sb.appendStr srcTypeName sb.appendC
    ' ' sb.appendC
    srcLoc ValueId.sbAppend
    ", ":s sb.appendStr
    srcLoc ValueId.sbAppend
    '\n' sb.appendC
    "jnz ":s sb.appendStr cNaN ValueId.sbAppend
    ", ":s sb.appendStr branches@ 0 [] sb.appendBranchId
    ", ":s sb.appendStr branches@ 1 [] sb.appendBranchId
    '\n' sb.appendC
    branches@ 0 [] "float->int":s context startBranch
    ## > min ?
    cMin ValueId.sbAppend
    " =w cgt":s sb.appendStr srcTypeName sb.appendC
    ' ' sb.appendC
    srcLoc ValueId.sbAppend
    ", ":s sb.appendStr
    targetVal unsigned BoundType .MIN srcVal appendNumberBound
    '\n' sb.appendC
    "jnz ":s sb.appendStr cMin ValueId.sbAppend
    ", ":s sb.appendStr branches@ 2 [] sb.appendBranchId
    ", ":s sb.appendStr branches@ 3 [] sb.appendBranchId
    '\n' sb.appendC
    branches@ 2 [] "float->int: check undeflow":s context startBranch
    ## < max ?
    cMin ValueId.sbAppend
    " =w clt":s sb.appendStr srcTypeName sb.appendC
    ' ' sb.appendC
    srcLoc ValueId.sbAppend
    ", " sb.appendS
    targetVal unsigned BoundType .MAX srcVal appendNumberBound
    '\n' sb.appendC
    "jnz ":s sb.appendStr cMin ValueId.sbAppend
    ", ":s sb.appendStr branches@ 4 [] sb.appendBranchId
    ", ":s sb.appendStr branches@ 5 [] sb.appendBranchId
    '\n' sb.appendC
    branches@ 4 [] "float->int: normal":s context startBranch
    ## cast value
    tCast ValueId.sbAppend
    " =":s sb.appendStr
    targetType StorageType .STACK pos context sb.appendTypeNameQBE
    ' ' sb.appendC
    srcTypeName sb.appendC
    unsigned if "toui ":s else "tosi ":s end sb.appendStr
    srcLoc ValueId.sbAppend
    "\njmp ":s sb.appendStr branches@ 6 [] sb.appendBranchId
    '\n' sb.appendC
    ## NaN
    branches@ 1 [] "float->int: NaN":s context startBranch
    tNaN ValueId.sbAppend
    " =":s sb.appendStr
    targetType StorageType .STACK pos context sb.appendTypeNameQBE
    " copy 0":s sb.appendStr
    "\njmp ":s sb.appendStr branches@ 6 [] sb.appendBranchId
    '\n' sb.appendC
    ## <Min
    branches@ 3 [] "float->int: underflow":s context startBranch
    tMin ValueId.sbAppend
    " =":s sb.appendStr
    targetType StorageType .STACK pos context sb.appendTypeNameQBE
    " copy ":s sb.appendStr
    targetVal unsigned BoundType .MIN targetVal appendNumberBound
    "\njmp ":s sb.appendStr branches@ 6 [] sb.appendBranchId
    '\n' sb.appendC
    ## >Max
    branches@ 5 [] "float->int: overflow":s context startBranch
    tMax ValueId.sbAppend
    " =":s sb.appendStr
    targetType StorageType .STACK pos context sb.appendTypeNameQBE
    " copy ":s sb.appendStr
    targetVal unsigned BoundType .MAX targetVal appendNumberBound
    '\n' sb.appendC
    branches@ 6 [] "float->int: end":s context startBranch
    context nextStackValueId
      $ =:: targetLoc
    ValueId.sbAppend
    " =":s sb.appendStr
    targetType StorageType .STACK pos context sb.appendTypeNameQBE
    " phi ":s sb.appendStr
    branches@ 4 [] sb.appendBranchId
    tCast ValueId.sbAppend
    ", ":s sb.appendStr branches@ 1 [] sb.appendBranchId
    tNaN ValueId.sbAppend
    ", ":s sb.appendStr branches@ 3 [] sb.appendBranchId
    tMin ValueId.sbAppend
    ", ":s sb.appendStr branches@ 5 [] sb.appendBranchId
    tMax ValueId.sbAppend
    '\n' sb.appendC
  targetLoc return
end

proc(
  stringBuilder : sb
  Type : src
  ValueId : srcLoc
  Type : target
  FilePosition ptr : pos
  CompilerContext ptr.mut : context
  SignType : signType
-> stringBuilder ValueId ) =>: castNumbers
  context [] .program =:: prog
  prog .errors =:: errors
  prog .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .nameContext =:: nameContext
  src typeContext types.primitiveValue =:: fromVal
  target typeContext types.primitiveValue =:: toVal
  ## case 0: identical types
  fromVal toVal == if
    sb srcLoc return
  ## case 1: integer extension/narrowing
  else src typeContext types.isIntOrChar and target typeContext types.isIntOrChar _if
    src typeContext types.primitiveValue types.sizeOfPrimitive =:: srcPrec
    target typeContext types.primitiveValue types.sizeOfPrimitive =:: targetPrec
    context nextStackValueId =:: targetLoc
    targetPrec srcPrec <= if
      sb srcLoc return ## integer narrowing is no-op
    else
      sb
        targetLoc ValueId.sbAppend
        " =":s sb.appendStr
        target StorageType .STACK pos context sb.appendTypeNameQBE
        " ext":s sb.appendStr
        signType .UNSIGNED if
          'u' sb.appendC
        else
          's' sb.appendC
        end
        fromVal switch
          I8  case "b ":s sb.appendStr break
          I16 case "h ":s sb.appendStr break
          I32 case "w ":s sb.appendStr break
          I64 case "l ":s sb.appendStr break
          BOOL TYPE F16 F32 F64 case ..unreachable
        end
        srcLoc ValueId.sbAppend
        '\n' sb.appendC
      targetLoc return
    end
  ## case 2: float -> float/int
  else fromVal .F32 or fromVal .F64 _if
    toVal switch
      F16 case "unimplemented" ..panic
      F32 case
        context nextStackValueId =:: targetLoc
        sb
          targetLoc ValueId.sbAppend
          " =s truncd ":s sb.appendStr
          srcLoc ValueId.sbAppend
          '\n' sb.appendC
        targetLoc return
      F64 case
        context nextStackValueId =:: targetLoc
        sb
          targetLoc ValueId.sbAppend
          " =d exts ":s sb.appendStr
          srcLoc ValueId.sbAppend
          '\n' sb.appendC
        targetLoc return
      I8 I16 I32 I64 case
        sb
          fromVal srcLoc target toVal
          signType .UNSIGNED
        pos context castFloatToInt return
      BOOL TYPE case ..unreachable
    end
  ## case 3: int -> float
  else ## TODO sign/zero extend 8&16 bit types before conversion
    context nextStackValueId =:: targetLoc
    sb
      targetLoc ValueId.sbAppend
      " =" sb.appendS
      target StorageType .STACK pos context sb.appendTypeNameQBE
      signType .UNSIGNED if " u":s else " s":s end sb.appendStr
      fromVal switch
        I64 case "ltof":s sb.appendStr break
        I8 I16 I32 case "wtof":s sb.appendStr break
        BOOL TYPE F16 F32 F64 case ..unreachable
      end
      ' ' sb.appendC
      srcLoc ValueId.sbAppend
      '\n' sb.appendC
    targetLoc return
  end
end

proc( types.PrimitiveType : a types.PrimitiveType : b -> bool ) =>: f16bitcast
  a .F16 if
    b .I16 return
  else a .I16 _if
    b .F16 return
  end
  false return
end
proc(
  stringBuilder : sb
  Type : src
  ValueId : srcLoc
  Type : target
  FilePosition ptr : pos
  CompilerContext ptr.mut : context
-> stringBuilder ValueId ) =>: bitcastNumbers
  context [] .program =:: prog
  prog .errors =:: errors
  prog .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .nameContext =:: nameContext
  src typeContext types.primitiveValue =:: fromVal
  target typeContext types.primitiveValue =:: toVal
  ## sizes of arguments scaled to bits
  fromVal types.sizeOfPrimitive 8 * =:: fromSize
  toVal types.sizeOfPrimitive 8 * =:: toSize
  fromVal toVal == or fromVal toVal f16bitcast if
    sb srcLoc return
  end
  srcLoc =:: mut: current
  sb
    ## 1. convert floats to int
    src typeContext types.isTrueFloat if
      context nextStackValueId =:: next
      next ValueId.sbAppend
      " =":s sb.appendStr
      fromSize 32 <= if 'w' else 'l' end sb.appendC
      " cast ":s sb.appendStr
      current ValueId.sbAppend
      '\n' sb.appendC
      next current=
    end
    ## 2. zero-extend small values to correct size
    fromSize toSize < if
      context nextStackValueId =:: next
      next ValueId.sbAppend
      " =":s sb.appendStr
      toSize 32 <= if 'w' else 'l' end sb.appendC
      fromVal switch
        BOOL TYPE F16 F32 F64 case break
        I8  case " extub":s sb.appendStr break
        I16 case " extuh":s sb.appendStr break
        I32 case " extuw":s sb.appendStr break
        I64 case " extul":s sb.appendStr break
      end
      current ValueId.sbAppend
      '\n' sb.appendC
      next current=
    end
    ## 3. convert int to float
    target typeContext types.isTrueFloat if
      context nextStackValueId =:: next
      next ValueId.sbAppend
      " =":s sb.appendStr
      toSize 32 == if 's' else 'd' end sb.appendC
      " cast ":s sb.appendStr
      current ValueId.sbAppend
      '\n' sb.appendC
      next current=
    end
  current return
end

enum( AUTO_CAST CAST CAST! BIT_CAST ) =:: CastType

proc(
  stringBuilder : sb
  CastType : castType
  SignType : signType0
  Type : src0
  i32 : offset
  Type : target0
  FilePosition ptr : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: compileCast
  context [] .program =:: prog
  prog .errors =:: errors
  prog .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .nameContext =:: nameContext
  signType0
    $ .NONE if ..drop
      src0 typeContext types.isUnsignedInt or src0 typeContext types.isChar if
        SignType .UNSIGNED
      else src0 typeContext types.isSignedInt _if
        SignType .SIGNED
      else target0 typeContext types.isUnsignedInt or target0 typeContext types.isChar _if
        SignType .UNSIGNED
      else target0 typeContext types.isSignedInt _if
        SignType .SIGNED
      else
        SignType .NONE
      end
    end
  =:: signType
  ## TODO? better cType <-> type conversion
  ## TODO update sign type when casting from/to  cType/intLiteral
  src0 typeContext types.unwrapNamed
    typeContext types.unwrapRefinement
    .CType .if types.cTypeAsType else
    .IntLiteral ._if types.intLiteralAsInt end
  =:: src
  target0 typeContext types.unwrapNamed
    typeContext types.unwrapRefinement
    .CType .if types.cTypeAsType else
    .IntLiteral ._if types.intLiteralAsInt end
  =:: target
  src target types.typeEquals if
    sb return ## nothing to do
  end
  offset context [] .stackInfo branchTree.depth >= if
    "stack underflow" sb.copyPtr
    pos errors appendError
    sb return
  end
  context .stackInfo offset branchTree.at optional.unwrap [] =:: srcVal
  srcVal .valueId =:: srcLoc
  target context toValType =:: targetValType
  ## TODO? different behavior for bit-casts
  src typeContext types.isNumber and target typeContext types.isNumber if
    sb
      src srcLoc
      target
    pos context  castType .BIT_CAST if bitcastNumbers else signType castNumbers end
    targetValType offset >>$ context replaceValue
    return
  end
  src typeContext types.isChar and target typeContext types.isInt if
    sb
      src srcLoc
      target
    pos context  castType .BIT_CAST if bitcastNumbers else signType castNumbers end
    targetValType offset >>$ context replaceValue
    return
  end
  src typeContext types.isInt and target typeContext types.isChar if
    sb
      src srcLoc
      target
    pos context  castType .BIT_CAST if bitcastNumbers else signType castNumbers end
    targetValType offset >>$ context replaceValue
    return
  end
  src typeContext types.isPointer and target typeContext types.isPointer end or
      src types.isUnionElement and target typeContext types.isUnion end or
      src typeContext types.isUnion and target types.isUnionElement end or
      src typeContext types.isCallable and target typeContext types.isCallable if
    srcVal .valType targetValType != if ## update val-type
      ## TODO? check if dereference is needed
      targetValType offset srcLoc context replaceValue
    end
    sb return ## same internal representation -> cast is no-op
  end
  ## TODO? sign type for cast int <-> ptr
  src typeContext types.isInt target typeContext types.isPointer & if
    ## src -> I_SIZE ~ ptr
    sb
      ## castNumbers
        src srcLoc
        types.primitive.I_SIZE
      pos context  castType .BIT_CAST if bitcastNumbers else signType castNumbers end
    targetValType offset >>$ context replaceValue
    return
  end
  src typeContext types.isPointer target typeContext types.isInt & if
    ## ptr ~ I_SIZE -> target
    sb
      ## castNumbers
        types.primitive.I_SIZE srcLoc
        target
      pos context  castType .BIT_CAST if bitcastNumbers else signType castNumbers end
    targetValType offset >>$ context replaceValue
    return
  end
  "casting from " sb.copyPtr
    src typeContext sb.appendType
    " to " sb.appendS
    target typeContext sb.appendType
    " is not implemented" sb.appendS
  pos errors appendError
  sb return
end

proc(
  stringBuilder : sb
  Type : constType
  ConstValue : value
  FilePosition ptr : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: pushConstant
  context [] .program =:: prog
  prog .idContext =:: idContext
  idContext .typeContext =:: typeContext
  false =:: mut: needCast
  constType =:: mut: srcType
  value .GenericArg .if =:: genArg
    context [] .currentProc
      genArg
      typeContext
    types.findProcArgName .if =:: index
      context [] .currentProc typeContext types.getProcIn optional.unwrap index [] srcType=
      srcType typeContext types.unwrapNamed
        constType typeContext types.unwrapNamed
      types.typeEquals ! needCast=
    end
  else ..drop end
  sb
    pos sb.appendPosQBE
    srcType context referenceOnly ! if
      srcType context toValType context pushNewValue ValueId.sbAppend
      " =" sb.appendS
      srcType StorageType .STACK pos context sb.appendTypeNameQBE
      " copy " sb.appendS
    else
      ValType .REFERENCE context pushNewValue ValueId.sbAppend
      " =l copy " sb.appendS
    end
    srcType value false pos context sb.appendConstQBE
    '\n' sb.appendC
    needCast if
      ## compileCast
        CastType .AUTO_CAST
        SignType .NONE
        srcType
        0
        constType
        pos
        context
      compileCast
    end
  return
end

proc(
  stringBuilder : sb
  Type : calledType
  TypedValId list ptr.mut : argIndices
  FilePosition ptr : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: prepareCall
  context [] .program =:: prog
  prog .idContext =:: idContext
  idContext .typeContext =:: typeContext
  calledType typeContext types.getProcRet =:: retType
  sb =:: mut: newSb
  newSb
    retType switch
      Empty case break
      Value Tuple .case =:: retVal
        retVal context toValType context pushNewValue ValueId.sbAppend
        " =" sb.appendS
        retVal StorageType .LOAD pos context sb.appendTypeNameQBE
        ' ' sb.appendC
      break
    end
    "call " sb.appendS
  return
end
proc(
  stringBuilder : sb
  Type : calledType
  TypedValId list ptr.mut : argIndices
  FilePosition ptr : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: finishCall
  context [] .program =:: prog
  prog .idContext =:: idContext
  idContext .typeContext =:: typeContext
  calledType typeContext types.getProcRet =:: retType
  sb
    " (" sb.appendS
    false =:: mut: hasArgs
    argIndices [] .length 1:iSize - while $ 0:iSize iSize.sge do =:: i
      argIndices [] i @[] =:: arg
      hasArgs if
        ',' sb.appendC
      end
      true hasArgs=
      arg [] .valType
        StorageType .LOAD
        pos
        context
      sb.appendTypeNameQBE
      ' ' sb.appendC
      arg [] .valId ValueId.sbAppend
    finally i 1:iSize - end ..drop
    ")\n" sb.appendS
    retType .Tuple .if
      ## flattenTupleQBE
        pos context popValue
        pos
      context flattenTupleQBE
    else ..drop end
    argIndices [] list.free argIndices =[]
  return
end

proc(
  stringBuilder : sb
  Operation ptr : op
  i32 : opIndex
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: compileOp
  context [] .program =:: prog
  prog .errors =:: errors
  prog .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .nameContext =:: nameContext
  op [] .val switch
    NOP case
      sb return
    Constant .case =:: constVal
      sb
        op [] .dataType
        constVal
        op [] .pos
        context
      pushConstant
      return
    ConstantReference .case =:: constId
      sb
        ValType .PTR context pushNewValue ValueId.sbAppend
        " =l " sb.appendS
        " copy $" sb.appendS
        CONST_REFERENCE_NAME sb.appendS
        constId i64 cast sb.appendI
        '\n' sb.appendC
      return
    DeclareId case sb return ## ignore declarations
    ImplementProcedure .case =:: procId
      procId ProcId.getProcInfo =:: procInfo
      op [] .dataType =:: procType
      procType context .currentProc=
      procInfo [] .nameId id.identifierFlags =:: identifierFlags
      ## reset stack-info in context
      0 context .stackCount=
      0 context .tmpCount=
      0 context .jumpLabelCount=
      context .stackInfo branchTree.clear
      sb
        identifierFlags id.FLAG_EXPORT & ? or identifierFlags id.FLAG_EXTERN & ? if
          "export " sb.appendS
        end
        "function " sb.appendS
        procType typeContext types.getProcRet =:: retType
        retType switch
          Empty case break
          Value Tuple .case
            StorageType .LOAD op [] .pos context sb.appendTypeNameQBE
            ' ' sb.appendC
          break
        end
        procInfo [] .nameId context sb.appendGlobalName
        procType op [] .pos context sb.appendProcSignature
        "{\n" sb.appendS
        ## BranchId
          BranchType .START
          0
        BranchId new string.empty context startBranch
        ## push unnamed arguments
        procType typeContext types.getProcIn optional.unwrap =:: args
        0:i32 while $ iSize cast.u args .length u< do =:: i
          procType i typeContext types.getProcArgName =:: argName?
          args i [] =:: argType
          argType typeContext types.isEmpty if
            i 1 + continue ## skip empty arguments
          end
          argType typeContext types.isType or argName? .and id.identifierFlags id.FLAG_STATIC & ? if
            i 1 + continue ## skip static arguments
          end
          argType context referenceOnly if
            ValType .REFERENCE
          else
            argType context toValType
          end =:: valType
          argName? ! .if ## push argument
            valType i ValueId .Arg context pushValue
          else =:: argName valType .REFERENCE _if
            argName appendLocalVar
            " =" sb.appendS
            valType sb.appendValTypeQBE
            " copy " sb.appendS
            i context sb.appendArgName
            '\n' sb.appendC
          else
            argName appendLocalVar
            " =l alloc" sb.appendS
            argType op [] .pos context typeAlignmentInt 4 i64.max sb.appendI
            ' ' sb.appendC
            argType op [] .pos context typeSizeInt  4 i64.max sb.appendI
            "\nstore" sb.appendS
            argType StorageType .STORE op [] .pos context sb.appendTypeNameQBE
            ' ' sb.appendC
            i context sb.appendArgName
            ", " sb.appendS
            argName appendLocalVar
            '\n' sb.appendC
          end
          i 1 +
        end ..drop
        procInfo [] .implementation .Code .if =:: codeImpl
          ## allocate space for variables
          codeImpl .variables =:: variables
          variables for =:: varInfo
            VariableType ..length 3:iSize == "no new variable types" assert
            varInfo .variableType .ARGUMENT if
              continue
            end
            varInfo .nameId appendLocalVar
            varInfo .valueType op [] .pos context false appendAlloc ..drop
          end
        else ..drop end
        true context .reachable=
      return
    GetId AtId .case =:: idInfo
      op [] .val .AtId ? =:: isAddr
      idInfo .idType switch
        PROCEDURE  case
          ## procedures are handled by call & procPtr instructions
          break
        GLOBAL_VAR case
          sb
            op [] .pos sb.appendPosQBE
            isAddr or op [] .dataType context referenceOnly if
              isAddr if ValType .PTR else ValType .REFERENCE end context pushNewValue ValueId.sbAppend
              " =l copy " sb.appendS
            else
              op [] .dataType context toValType =:: valType
              valType context pushNewValue ValueId.sbAppend
              " =" sb.appendS
              valType sb.appendValTypeQBE
              " load" sb.appendS
              op [] .dataType StorageType .LOAD
                op [] .pos
                context
              sb.appendTypeNameQBE
              " " sb.appendS
            end
            idInfo .nameId context sb.appendGlobalName
            '\n' sb.appendC
          return
        LOCAL_VAR TMP_VAR ARGUMENT case
          sb
            op [] .pos sb.appendPosQBE
            isAddr or op [] .dataType context referenceOnly if
              isAddr if ValType .PTR else ValType .REFERENCE end idInfo .nameId ValueId .LocalVar context pushValue
            else
              op [] .dataType context toValType =:: valType
              valType context pushNewValue ValueId.sbAppend
              " =" sb.appendS
              valType sb.appendValTypeQBE
              " load" sb.appendS
              op [] .dataType StorageType .LOAD
                op [] .pos
                context
              sb.appendTypeNameQBE
              ' ' sb.appendC
              idInfo .nameId appendLocalVar
              '\n' sb.appendC
            end
          return
       TYPE LABEL PROCEDURE_BUNDLE case
          break ## TODO error message
      end
      break
    ProcPtr .case =:: procId
      procId ProcId.getProcInfo =:: procData
      sb
        op [] .pos sb.appendPosQBE
        ValType .PTR context pushNewValue ValueId.sbAppend
        " =l copy " sb.appendS
        ## appendGlobalName
          procData [] .nameId
        context sb.appendGlobalName
        "\n" sb.appendS
      return
    SetId .case =:: idInfo
      op [] .dataType =:: valType
      op [] .pos context popValue =:: valueId
      sb
        op [] .pos sb.appendPosQBE
        valType context referenceOnly if
          "blit " sb.appendS
        else
          "store" sb.appendS
          valType StorageType .STORE op [] .pos context sb.appendTypeNameQBE
          " " sb.appendS
        end
        valueId ValueId.sbAppend
        ", " sb.appendS
        idInfo .idType switch
          GLOBAL_VAR case
            idInfo .nameId context sb.appendGlobalName
            break
          LOCAL_VAR TMP_VAR ARGUMENT case
            idInfo .nameId appendLocalVar
            break
         PROCEDURE TYPE LABEL PROCEDURE_BUNDLE case
            "unsupported identifier for setId " sb.copyPtr
            idInfo nameContext sb.appendIdInfo
            op [] .pos errors appendError
            return
        end
        valType context referenceOnly if
          ',' sb.appendC
          valType op [] .pos context typeSizeInt sb.appendI
        end
        '\n' sb.appendC
      return
    GetElement .case =:: index
      op [] .dataType =:: mut: containerType
      false =:: mut: ptrSrc
      containerType typeContext types.ptrTarget .if
        containerType=
        true ptrSrc=
      end
      containerType typeContext types.getArrayBaseType
        $ ? =:: isArray
      .else
        containerType
          index
          typeContext
        types.compositeGetElement .else
          "missing composite element " sb.copyPtr
          containerType typeContext sb.appendType
          " .":s sb.appendStr index sb.appendI
          op [] .pos errors appendError
          sb return
        end
      end =:: eltType
      ptrSrc if
        ValType .PTR
      else
        eltType context toValType
      end =:: valType
      isArray if
        op [] .pos context popValue =:: srcId
        sb
          valType context pushNewValue ValueId.sbAppend
          " =l add ":s sb.appendStr
          srcId ValueId.sbAppend
          ", ":s sb.appendStr
          index i64 cast.u eltType op [] .pos context typeStrideInt * sb.appendI
          '\n' sb.appendC
      else containerType typeContext types.isTuple or containerType typeContext types.isTaggedUnion  _if
        op [] .pos context popValue =:: srcId
        sb
          op [] .pos sb.appendPosQBE
          valType context pushNewValue ValueId.sbAppend
          " =l add ":s sb.appendStr
          srcId ValueId.sbAppend
          ", ":s sb.appendStr
          containerType index op [] .pos context tupleEltOffsetInt sb.appendI
          '\n' sb.appendC
      else containerType typeContext types.isUnion _if
        sb ## no change to pointer necessary
      else
        break ## unsupported type
      end
        ptrSrc or eltType context referenceOnly if
          return
        end
        op [] .pos context popValue =:: srcId
        op [] .pos sb.appendPosQBE
        valType context pushNewValue ValueId.sbAppend
        " =":s sb.appendStr
        valType sb.appendValTypeQBE
        " load":s sb.appendStr
        eltType
          StorageType .LOAD
          op [] .pos
          context
        sb.appendTypeNameQBE
        ' ' sb.appendC
        srcId ValueId.sbAppend
        '\n' sb.appendC
      return
    SetNestedElement .case =:: path
      ( Type : eltType i64 : offset ) =:: ElementInfo
      op [] .dataType
        $ typeContext types.ptrTarget
          $ ? =:: isPtr
        .if >$ ..drop end
      0 ElementInfo new =:: mut: eltInfo
      ( ElementInfo ptr.mut : shadow: eltInfo CompilerContext ptr.mut : shadow: context FilePosition ptr : pos ) =:: Curry
      path ( i32 : index Curry : curry -> ) =>
        curry .context [] .program .errors =:: shadow: errors
        curry .context [] .program .idContext .typeContext =:: shadow: typeContext
        curry .eltInfo [] .eltType
          $ typeContext types.getArrayBaseType .if
            >$ curry .pos curry .context typeStrideInt index i64 cast.u *
              curry .eltInfo [] .offset +
            curry .eltInfo .offset=
          else $ typeContext types.isRawUnion _if
            index typeContext types.compositeGetElement .else
              "missing composite element" ..panic
            end
          else
            $ index curry .pos curry .context tupleEltOffsetInt
              curry .eltInfo [] .offset +
            curry .eltInfo .offset=
            index typeContext types.compositeGetElement .else
              "missing composite element" ..panic
            end
          end
        curry .eltInfo .eltType=
      end eltInfo@ context op [] .pos Curry new NestedElementPath.forEach
      eltInfo .eltType =:: eltType
      eltInfo .offset =:: offset
      ## TODO! extract element-set to procedure (merge occurences in setElement,setNestedElement and setUnionElement)
      sb
        op [] .pos context popValue =:: structId
        op [] .pos sb.appendPosQBE
        isPtr if ValType .PTR else ValType .REFERENCE end context pushNewValue ValueId.sbAppend
        " =l add " sb.appendS
        structId ValueId.sbAppend
        ", " sb.appendS
        offset sb.appendI
        '\n' sb.appendC
        op [] .pos context popValue =:: targetId
        op [] .pos context popValue =:: valueId
        eltType context referenceOnly if
          "blit ":s sb.appendStr
        else
          "store":s sb.appendStr
          eltType StorageType .STORE op [] .pos context sb.appendTypeNameQBE
          ' ' sb.appendC
        end
        valueId ValueId.sbAppend
        ", ":s sb.appendStr
        targetId ValueId.sbAppend
        eltType context referenceOnly if
          ',' sb.appendC
          eltType op [] .pos context typeSizeInt sb.appendI
        end
        '\n' sb.appendC
        isPtr ! if
          ## keep non-pointer value on stack
          ValType .REFERENCE structId context pushValue
        end
      return
    break
    SetElement .case =:: index
      ## TODO? special handling for access through pointer?
      op [] .dataType
        $ typeContext types.ptrTarget
          $ ? =:: isPtr
        .if >$ ..drop end
      =:: containerType
      containerType typeContext types.getArrayBaseType
        $ ? =:: isArray
      .else
        containerType
          index
          typeContext
        types.compositeGetElement .else
          "missing composite element " sb.copyPtr
          containerType typeContext sb.appendType
          " .":s sb.appendStr index sb.appendI
          op [] .pos errors appendError
          sb return
        end
      end =:: eltType
      sb
        op [] .pos context popValue =:: structId
        op [] .pos sb.appendPosQBE
        containerType typeContext types.isRawUnion if
          structId
        else
          isPtr if ValType .PTR else ValType .REFERENCE end context pushNewValue ValueId.sbAppend
          " =l add " sb.appendS
          structId ValueId.sbAppend
          ", " sb.appendS
          isArray if
            index i64 cast.u eltType op [] .pos context typeStrideInt * sb.appendI
          else
            containerType index op [] .pos context tupleEltOffsetInt sb.appendI
          end
          '\n' sb.appendC
          op [] .pos context popValue
        end =:: targetId
        op [] .pos context popValue =:: valueId
        eltType context referenceOnly if
          "blit ":s sb.appendStr
        else
          "store":s sb.appendStr
          eltType StorageType .STORE op [] .pos context sb.appendTypeNameQBE
          ' ' sb.appendC
        end
        valueId ValueId.sbAppend
        ", ":s sb.appendStr
        targetId ValueId.sbAppend
        eltType context referenceOnly if
          ',' sb.appendC
          eltType op [] .pos context typeSizeInt sb.appendI
        end
        '\n' sb.appendC
        isPtr ! if
          ## keep non-pointer value on stack
          ValType .REFERENCE structId context pushValue
        end
      return
    New NewUnion case
      sb
        op [] .pos sb.appendPosQBE
        ## prepare memory
        op [] .dataType op [] .pos context true appendAlloc =:: dataPtrId
        op [] .val .NewUnion .if =:: index
          op [] .dataType index typeContext types.compositeGetElement .else
            "missing union element " sb.copyPtr
            op [] .dataType typeContext sb.appendType
            " .":s sb.appendStr index sb.appendI
            op [] .pos errors appendError
            return
          end =:: eltType
          eltType typeContext types.isEmpty ! if
            eltType context referenceOnly if
              "blit " sb.appendS
            else
              "store" sb.appendS
              eltType StorageType .STORE op [] .pos context sb.appendTypeNameQBE
              " " sb.appendS
            end
            op [] .pos context popValue ValueId.sbAppend
            ", ":s sb.appendStr
            dataPtrId ValueId.sbAppend
            eltType context referenceOnly if
              ',' sb.appendC
              eltType op [] .pos context typeSizeInt sb.appendI
            end
            '\n' sb.appendC
          end
        else ..drop op [] .dataType typeContext types.isTuple or op [] .dataType typeContext types.isTaggedUnion _if
          op [] .dataType dataPtrId op [] .pos context initializeTupleQBE
        else op [] .dataType typeContext types.isArray _if
          ## zero-initialize array
          "call $memset(l " sb.appendS
          dataPtrId ValueId.sbAppend
          ",w 0,l " sb.appendS
          op [] .dataType op [] .pos context typeSizeInt sb.appendI
          ")\n" sb.appendS
        else
          "unsupported type for new:" sb.copyPtr
            op [] .dataType
              typeContext
            sb.appendType
          op [] .pos errors appendError
          return
        end
        ValType .REFERENCE dataPtrId context pushValue
      return
    AutoCast .case =:: castInfo
      sb
        op [] .pos sb.appendPosQBE
        CastType .AUTO_CAST
        SignType .NONE
        castInfo .src
        castInfo .offset
        op [] .dataType
        op [] .pos
        context
      compileCast return
      break
    Cast Cast! BitCast case
      sb
        op [] .pos sb.appendPosQBE
        op [] .val .Cast .if =:: castVal
          CastType .CAST
          castVal .signType
          castVal .src
        else .BitCast ._if =:: castVal
          CastType .BIT_CAST
          SignType .UNSIGNED
          castVal
        else .Cast! ._if =:: castVal
          CastType .CAST!
          SignType .NONE ## TODO? use sign information for forced cast
          castVal
        else ..unreachable end
        0 ## no offset
        op [] .dataType
        op [] .pos
        context
      compileCast return
      break
    Call .case =:: procId
      procId ProcId.getProcInfo =:: procData
      op [] .dataType =:: calledType
      calledType typeContext types.getProcIn optional.unwrap =:: inTypes
      inTypes .length =:: argCount
      argCount TypedValId list.create =:: mut: argIndices
      sb
        op [] .pos sb.appendPosQBE
      =:: mut: newSb
      ## index of current auto-argument
      0:i32 while $ argCount i32 cast.u < do =:: i
        inTypes i [] =:: mut: arg
        calledType i typeContext types.getProcArgName .if id.identifierFlags
        else id.FLAG_NONE end =:: argFlags
        arg typeContext types.isEmpty if
          i 1 + continue ## skip empty arguments
        end
        argFlags id.FLAG_STATIC & ? or arg typeContext types.isType if
          i 1 + continue ## skip static arguments
        end
        arg typeContext types.isArray and arg typeContext types.containsGeneric if
          arg false typeContext types.getAddressType arg=
        end
        argIndices
          arg ValueId .None TypedValId new list.append
        argIndices=
        i 1 +
      end ..drop
      argIndices .length =:: mut: argIndex
      while argIndex 0:iSize iSize.sgt do
        argIndex 1:iSize - argIndex=
        argIndices argIndex @[] .valId [] .None ? ! if
          continue ## argument already set
        end
        ## get argument from stack
        argIndices argIndex @[] =:: arg
        op [] .pos context popValue arg .valId=
      end
      newSb
        calledType
          argIndices@
          op [] .pos
        context prepareCall
        procData [] .nameId context sb.appendGlobalName
        calledType
          argIndices@
          op [] .pos
        context finishCall
      return
    CallPtr .case =:: callInfo
      op [] .dataType =:: mut: calledType
      calledType typeContext types.getPointerBaseType .if
        calledType=
      end
      calledType typeContext types.getProcIn optional.unwrap =:: inTypes
      op [] .pos context popValue =:: calledId
      inTypes .length =:: argCount
      argCount TypedValId list.create =:: mut: argIndices
      argCount 1:iSize - i32 cast.u while $ 0 >= do =:: i
        inTypes i []
          $ typeContext types.isArray and $ typeContext types.containsGeneric if
            false typeContext types.getAddressType
          end
        =:: arg
        arg typeContext types.isEmpty if
          continue ## skip empty arguments
        end
        argIndices
          ## TypedValId
            arg
            op [] .pos context popValue
          TypedValId new list.append
        argIndices=
      finally i 1 - end ..drop
      ## arguments are popped in reverse order
      argIndices list.reverse argIndices=
      sb
        calledType
          argIndices@
          op [] .pos
        context prepareCall
        calledId ValueId.sbAppend
        calledType
          argIndices@
          op [] .pos
        context finishCall
      return
    BuiltIn .case =:: builtIn
      sb
        op [] .pos sb.appendPosQBE
        ## appendBuiltInQBE
          builtIn
          op [] .dataType
          op [] .pos
          context
        appendBuiltInQBE
      return
    LocalLabel .case =:: labelInfo
      labelInfo .labelType switch
        HINT_START case
          context .labelStates
            labelInfo .labelId
            LabelState.new
          map.put ..drop
        sb return
        HINT_END case
          context .labelStates labelInfo .labelId map.remove .if LabelState.free end
        sb return
        LABEL_START case
          context .labelStates
            labelInfo .labelId
            LabelState.new
          map.put ..drop
          context [] .program .backJumpInfo labelInfo .labelId map.get .else
            "start label without back-jump info" ..panic
          end =:: backJumpInfo
        sb
          context [] .reachable ! if
            "unreachable back-jump labels are not supported in QBE-backend" ..panic
          end
          ## copy the top-n stack-elements to tmp-vars
          ## TODO? common buffer in context
          backJumpInfo .modifiedTypes ValType list.create =:: mut: valTypeBuffer
          ## TODO? merge with version in rememberStackState
          backJumpInfo .modifiedTypes for =:: i
            context .stackInfo branchTree.pop .else
              "stack underflow" sb.copyPtr op [] .pos context [] .program .errors appendError
              break
            end =:: srcVal
            "%label" sb.appendS labelInfo .labelId i64 cast.u sb.appendI
              '_' sb.appendC i sb.appendI
            " =" sb.appendS srcVal [] .valType sb.appendValTypeQBE
            " copy ":s sb.appendStr srcVal [] .valueId ValueId.sbAppend '\n' sb.appendC
            valTypeBuffer srcVal [] .valType list.append valTypeBuffer=
          end
          ## BranchId
            BranchType .LABEL
            labelInfo .labelId i32 cast.u
          BranchId new "label":s context startBranch
          ## copy the tmp-vars stack-elements to the top-n stack-elements
          backJumpInfo .modifiedTypes 1 - while $ 0 >= do =:: i
            valTypeBuffer i list.get .else ValType .EMPTY end =:: eltVal
            eltVal context pushNewValue ValueId.sbAppend
            " =":s sb.appendStr eltVal sb.appendValTypeQBE
            " copy %label":s sb.appendStr
              labelInfo .labelId i64 cast.u sb.appendI
            '_' sb.appendC i sb.appendI '\n' sb.appendC
          finally i 1 - end ..drop
          valTypeBuffer list.free ..drop
          true context .reachable=
        return
        LABEL_END case break
        LABEL_MIDDLE case "bi-directional labels are not supported by the QBE-backend" ..panic
      end
      context .labelStates labelInfo .labelId map.at .else
        "missing label state" ..panic
      end =:: labelState
      context [] .reachable if
        labelState [] context rememberStackStateAtLabel labelState =[]
      end
      sb
        labelState [] .branches .length 0 != if
          ## BranchId
            BranchType .LABEL
            labelInfo .labelId i32 cast.u
          BranchId new "label":s context startBranch
          =:: mut: newSb
          ## mergeValues
            context .stackInfo
            labelState [] .branches list.asSlice
            mergeBranches@
            ## MergePoint
              "label":s
              labelState [] .branchIds list.asSlice
              op [] .pos
              context
              newSb@
            MergePoint new
          branchTree.merge .Error ? if
            "could not merge label branches" sb.copyPtr
            op [] .pos errors appendError
          end
          true context .reachable=
          newSb
        end
      context .labelStates labelInfo .labelId map.remove .if LabelState.free end
    return
    LocalJump .case =:: labelInfo
      context [] .reachable ! if sb return end ## ignore unreachable jump
      ## appendBranchId
        BranchType .LABEL
          labelInfo .labelId i32 cast.u
      BranchId new =:: targetBranchId
      ## appendBranchId
        BranchType .NEXT
        context nextJumpLabelId
      BranchId new =:: nextBranch
      labelInfo .cmpType switch
        NONE case
          sb
            labelInfo .labelId op [] .pos context rememberStackState
            "jmp " sb.appendS
            targetBranchId sb.appendBranchId
            '\n' sb.appendC
            false context .reachable=
          return
        TRUE FALSE case
          sb
            op [] .pos sb.appendPosQBE
            op [] .pos context popValue =:: condId
            labelInfo .labelId op [] .pos context rememberStackState
            "jnz ":s sb.appendStr condId ValueId.sbAppend ", ":s sb.appendStr
            labelInfo .cmpType .TRUE if
              targetBranchId sb.appendBranchId
              ", ":s sb.appendStr
              nextBranch sb.appendBranchId
            else
              nextBranch sb.appendBranchId
              ", ":s sb.appendStr
              targetBranchId sb.appendBranchId
            end
            '\n' sb.appendC
            nextBranch "jump-if":s context startBranch
          return
        break
        EQ NE LT LE GE GT ULT ULE UGE UGT case
          "fused compare&jump is not supported by QBE-backend" ..panic
        break
      end
    break
    Switch .case =:: switchId
      switchId SwitchId.getSwitchData =:: switchData
      sb
        op [] .pos sb.appendPosQBE
        ## appendSwitchTable
          switchData [] .switchType
          op [] .pos context popValue
          switchData [] .switchLabels
          switchData [] .branchLabels
          switchData [] .defaultLabel
          opIndex
          op [] .pos
          context
        appendSwitchTable
        context .labelStates
          switchData [] .endLabel
          LabelState.new
        map.put ..drop
        false context .reachable=
      return
    break
    EndProc case
      Type .Undefined context .currentProc=
      sb
        ## end of procedure block always unreachable
        ## ( type-checker ensures there is a return before end )
        "@end\nhlt\n}\n" sb.appendS
        op [] .pos context sb.appendLocalConstants
      return
    break
    Return case
      op [] .dataType typeContext types.isProcedure ! if
        "unexpected type for return: " sb.copyPtr
          op [] .dataType typeContext sb.appendType
          " expected procedure" sb.appendS
        op [] .pos errors appendError
        sb return
      end
      op [] .dataType typeContext types.getProcRet =:: retType
      retType switch
        Empty case 0:i32 break
        Value case 1:i32 break
        Tuple .case typeContext types.compositeEltCount break
      end =:: retCount
      false context .reachable=
      sb
        op [] .pos sb.appendPosQBE
        retCount 1 == if
          context .stackInfo branchTree.pop .else
            "stack underflow" sb.copyPtr op [] .pos context [] .program .errors appendError
            return
          end [] .valueId .None .if ..drop
            ## QBE can only return structs through pointer
            retType switch
              Value Tuple .case break
              Empty case "expected non-empty return value" ..panic
            end =:: retVal
            retVal op [] .pos context true appendAlloc =:: tmpId
            ## TODO! support non-struct composite return
            retVal tmpId op [] .pos context initializeTupleQBE
            tmpId
          end
        else retCount 0 > _if
          retType switch
            Value Tuple .case break
            Empty case "expected non-empty return value" ..panic
          end =:: retVal
          retVal op [] .pos context true appendAlloc =:: tmpId
          retVal tmpId op [] .pos context initializeTupleQBE
          tmpId
        else
          ValueId .None ## values will be ignored
        end =:: retId
        retCount 0 == if
          "ret\n" sb.appendS
          return
        end
        "ret ":s sb.appendStr
        retId ValueId.sbAppend
        '\n' sb.appendC
      return
    RuntimeAssert .case =:: msg
      ## BranchId
        BranchType .NEXT
        context nextJumpLabelId
      BranchId new =:: successBranch
      ## BranchId
        BranchType .ERROR
        context nextJumpLabelId
      BranchId new =:: errorBranch
      sb
        op [] .pos sb.appendPosQBE
        "## assert\n":s sb.appendStr
        "jnz ":s sb.appendStr
        op [] .pos context popValue ValueId.sbAppend
        ", ":s sb.appendStr
        successBranch sb.appendBranchId
        ", ":s sb.appendStr
        errorBranch sb.appendBranchId
        '\n' sb.appendC
        errorBranch sb.appendBranchId
        '\n' sb.appendC
        "call $printf(l $":s sb.appendStr
        ASSERT_FORMAT sb.appendS
        ",...,l ":s sb.appendStr
        msg .length sb.appendI
        ",l ":s sb.appendStr
        msg context sb.appendStringPtrConstQBE
        op [] .pos prog appendPosPrintfArgs
        ")\ncall $exit(w 1)\nhlt\n":s sb.appendStr
        successBranch "end assert":s context startBranch
      return
    PanicWithMessage .case =:: message
      false context .reachable=
      sb
        op [] .pos sb.appendPosQBE
        "call $printf(l $":s sb.appendStr ## TODO? print to stderr
        PANIC_FORMAT sb.appendS
        ",...,l ":s sb.appendStr
        message .length sb.appendI
        ",l ":s sb.appendStr
        message context sb.appendStringPtrConstQBE
        op [] .pos prog appendPosPrintfArgs
        ")\ncall $exit(w 1)\nhlt\n":s sb.appendStr
      return
    StackMod .case =:: stackMod
      stackMod .modType switch
        DROP case
          stackMod .n =:: count
          count while $ 0 > do 1 -
             context .stackInfo branchTree.pop ..drop
          end ..drop
          sb return
        COPY case
          stackMod .n =:: offset
          context [] .stackInfo branchTree.depth offset <= if
            "stack underflow" sb.copyPtr
            op [] .pos errors appendError
            sb return
          end
          ## copy value on stack
          context .stackInfo
            offset
          branchTree.at optional.unwrap =:: copied
          context .stackInfo
            copied []
          branchTree.push
          sb return
        ROTATE case
          stackMod .n =:: offset
          offset i32.abs 1 + =:: eltCount
          context [] .stackInfo branchTree.depth eltCount < if
            "stack underflow" sb.copyPtr
            op [] .pos errors appendError
            sb return
          end
          context .stackInfo eltCount offset 0 > branchTree.rotate
          sb return
      end
      break
    CompilerInfo case
      sb return ## TODO? print compiler info
    Copy Error case
      break ## TODO error message
  end
  "unable to compile operation " sb.copyPtr
    op [] prog sb.appendOp
  op [] .pos errors appendError
  sb return
end

proc( CompilerContext ptr.mut : context -> ) =>: cleanupCompilerContext
  context .stackInfo branchTree.free
  context [] .localConstants
    list.free
  context .localConstants=
  context [] .stringConstants
    list.free
  context .stringConstants=
  context [] .ptrConstants
    list.free
  context .ptrConstants=
  ( LocalLabelId : ignore -> ) => end LabelState.free@ context .labelStates map.freeAll
end
proc( file.File : mut: target ProgramContext ptr.mut : program -> file.File ) =>: export: compileToQBE
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .nameContext =:: nameContext
  ## CompilerContext
    program
    StackValue branchTree.create
    BranchType .START 0 BranchId new
    LocalLabelId.hash@ LocalLabelId.eq@ 512 LabelState map.create
    32 LocalConst list.create
    32 string list.create
    32 PtrConstant list.create
    types.typeHash@ types.typeEquals@ 1024 i64 map.create
    0
    0
    Type .Undefined
    0
    0
    0
    true
  CompilerContext new =:: mut: contextData
  contextData@ =:: context
  program [] .progFiles 0 @[] .fileScope [] idContext id.setScope
  nameContext id.clearNamespace
  1024 sb.create
    program getDeclaredTypes =:: types
    types for =:: t
      t
        ## TODO? use declaration position of type
        FILE_POS_UNKNOWN@
      context sb.appendTypeDeclarationQBE
    end
    "data $" sb.appendS
    ASSERT_FORMAT sb.appendS
    " = { b \"assertion failed: \\\"%.*s\\\" at %.*s:%i:%i\\n\", b 0 }\n" sb.appendS
    "data $" sb.appendS
    PANIC_FORMAT sb.appendS
    " = { b \"PANIC!: \\\"%.*s\\\" at %.*s:%i:%i\\n\", b 0 }\n" sb.appendS
  =:: mut: sb
  ## TODO find better way to iterate through all global variables
  idContext .identifierNames map.itr.start while map.itr.hasNext do map.itr.next
    =:: declaration ## TODO find out which declarations are actually used
    declaration .1 [] .aliasId id.NO_ALIAS != if continue end
    declaration .1 [] .nameId =:: nameId
    nameId idContext id.getIdData optional.unwrap =:: idData
    idData [] .idType .GLOBAL_VAR ! if
      continue
    end
    idData [] .valueType =:: mut: valType
    nameId id.identifierFlags =:: identifierFlags
    valType types.primitive.TYPE types.typeEquals or
        valType typeContext types.isEmpty or
        valType typeContext types.isProcedure or
        identifierFlags id.FLAG_STATIC id.FLAG_EXTERN | & ? if
      continue
    end
    sb
      identifierFlags id.FLAG_EXPORT & ? if
        "export " sb.appendS
      end
      "data " sb.appendS
      nameId context sb.appendGlobalName
      " = align " sb.appendS
      valType idData [] .declaredAt context typeAlignmentInt sb.appendI
      " {" sb.appendS
      idData [] .constValue .None ? ! if
        valType idData [] .constValue true idData [] .declaredAt context sb.appendConstQBE
      else
        "z " sb.appendS
        valType idData [] .declaredAt context typeSizeInt sb.appendI
      end
      "}\n" sb.appendS
      target $1 sb.asStr file.write target=
      sb.clear
    sb=
  end ..drop
  sb
    ## constant references
    program [] .constantReferences .length for =:: i
      program [] .constantReferences i [] =:: constRef
      "data $" sb.appendS
      CONST_REFERENCE_NAME sb.appendS
      i sb.appendI
      " = {" sb.appendS
        constRef .constType constRef .value true constRef .pos context sb.appendConstQBE
      "} \n" sb.appendS
    end
    program [] .progFiles .length for =:: fileId
      "data $" sb.appendS
      FILE_NAME_NAME sb.appendS
      fileId sb.appendI
      " = {" sb.appendS
        program [] .progFiles fileId [] .fileName sb.asStr string.bytes 'b' true sb.appendPrimitiveArrayConstQBE
      "} \n" sb.appendS
    end
    ## code
    program [] .procedures for ProcId.getProcInfo =:: proc
      proc .implementation .Code .else
        ..drop continue
      end =:: impl
      impl .codeState [] .PreCompiled .else ..drop continue end =:: procCode
      program [] .progFiles proc [] .fileId iSize cast.u list.get .if =:: f
        "dbgfile \"" sb.appendS
        f .fileName sb.appendSb
        "\"\n"    sb.appendS
      else
        "dbgfile \"..internal\"\n"    sb.appendS
      end
      procCode .length for i32 cast.u =:: opIndex
        procCode opIndex @[] opIndex context compileOp
      end
      target $1 sb.asStr file.write target=
      sb.clear
    end
    target $1 sb.asStr file.write target=
    sb.clear
    context [] .stringConstants .length for =:: i
      context [] .stringConstants i [] =:: str
      "data $" sb.appendS
      STRING_CONST_NAME sb.appendS
      i sb.appendI
      " = {" sb.appendS
        str string.bytes 'b' true sb.appendPrimitiveArrayConstQBE
      "} ## \"" sb.appendS
      str sb.appendEscapedStr
      "\"\n" sb.appendS
    end
    ## cannot replace with for as loop-counter is changed during loop
    0:iSize while $ context [] .ptrConstants .length u< do =:: i
      context [] .ptrConstants i @[] =:: val
      "data $" sb.appendS
      PTR_CONST_NAME sb.appendS
      i sb.appendI
      " = {" sb.appendS
        val context sb.appendPtrConstDataQBE
      "}\n" sb.appendS
    finally i 1:iSize + end ..drop
    target $1 sb.asStr file.write target=
    sb.clear
    program [] .mainId .else ## no main
      sb.free ..drop
      context cleanupCompilerContext
      target return
    end =:: mainId
    program [] .hasGetArgs if
      "data $" sb.appendS
      CONCAT_ARGC_NAME sb.appendS
      " = { l 0 }\n" sb.appendS
      "data $" sb.appendS
      CONCAT_ARGV_NAME sb.appendS
      " = { l 0 }\n" sb.appendS
      "data $" sb.appendS
      CONCAT_ENVP_NAME sb.appendS
      " = { l 0 }\n" sb.appendS
      "export function w $main(l %argc,l %argv,l %envp){\n@start\n" sb.appendS
      "storel %argc,$" sb.appendS
      CONCAT_ARGC_NAME sb.appendS
      '\n' sb.appendC
      "storel %argv,$" sb.appendS
      CONCAT_ARGV_NAME sb.appendS
      '\n' sb.appendC
      "storel %envp,$" sb.appendS
      CONCAT_ENVP_NAME sb.appendS
      '\n' sb.appendC
      "call " sb.appendS
    else
      "export function w $main(){\n@start\ncall " sb.appendS
    end
    mainId context sb.appendGlobalName
    "()\nret 0\n}\n" sb.appendS
    target $1 sb.asStr file.write target=
  sb.free ..drop
  context cleanupCompilerContext
  target
end
