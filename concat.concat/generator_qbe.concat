            offsetId prevId =
            context nextTmpId offsetId =
            argCount 1 - argCount =
            "%t" sb.appendS
            offsetId sb.appendI
            " =l add %t" sb.appendS
            prevId sb.appendI
            ", %s" sb.appendS
            op [] .pos context popValue sb.appendI
            '\n' sb.appendC
          end
        end
        offsetId prevId =
        context nextTmpId offsetId =
        "%t" sb.appendS
        offsetId sb.appendI
        " =l mul %t" sb.appendS
        prevId sb.appendI
        ", " sb.appendS
        baseType op [] .pos context typeSizeInt sb.appendI
        " ## " sb.appendS
        baseType typeContext sb.appendType
        '\n' sb.appendC
        op [] .pos context popValue =:: srcId
        "%s" sb.appendS
        isAddr if ValType .PTR else ValType .REFERENCE end context pushValue sb.appendI
        " =l add %s" sb.appendS
        srcId sb.appendI
        ", %t" sb.appendS
        offsetId sb.appendI
        '\n' sb.appendC
      return
    getElement atElement case
      op [] .val .getElement ?? if
        op [] .val .getElement
      else
        op [] .val .atElement
      end =:: index
      op [] .val .atElement ?? =:: isAddr
      op [] .dataType =:: mut: containerType
      false =:: mut: ptrSrc
      containerType typeContext types.isReference or
          containerType typeContext types.isPointer if
        containerType typeContext types.getBaseType containerType =
        true ptrSrc =
      end
      containerType
        index
        typeContext
      types.compositeGetElement =:: eltType
      isAddr if
        ValType .PTR
      else ptrSrc _if
        ValType .REFERENCE
      else
        eltType context toValType
