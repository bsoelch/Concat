      else
        procData [] .procType
      end =:: calledType
      calledType typeContext types.getProcIn ..drop =:: inTypes
      calledType typeContext types.getProcOutArgs ..drop =:: outArgs
      calledType typeContext types.getProcRet ..drop =:: retType
      inTypes typeContext types.compositeEltCount =:: argCount
      argCount TypedValId list.create =:: mut: argIndices
