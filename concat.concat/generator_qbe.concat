      op [] .dataType
        ..dup typeContext types.isReference if
           typeContext types.getBaseType
        end
      =:: containerType
      containerType typeContext types.isTaggedUnion ! if
        break
      end
      op [] .pos context popValue =:: srcId
      sb
        op [] .pos sb.appendPosQBE
        containerType srcId op [] .val .hasElement op [] .pos context checkEnumIndex ..drop.2 =:: c
        "%s" sb.appendS
        ValType .I32 context pushValue sb.appendI
        " =w copy %t" sb.appendS
        c sb.appendI
        '\n' sb.appendC
