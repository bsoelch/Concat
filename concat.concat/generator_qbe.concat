            ifBlock [] .orBranchIds
              context [] .currentBranch list.append
            ifBlock [] .orBranchIds =
            ## mergeValues
              context [] .stackInfo @
              ifBlock [] .orBranches list.asArray
              mergeBranches @
              ## MergePoint
                "or-if" string.wrap
                ifBlock [] .blockId
                ifBlock [] .orBranchIds list.asArray
                op [] .pos
