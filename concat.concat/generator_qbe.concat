          newSb return
        SWITCH case
          op [] .val .block .blockId =:: switchId
          prog [] .switchData
            switchId list.at .data
          =:: switchData
          sb
            op [] .pos sb.appendPosQBE
            ## appendSwitchTable
              switchData [] .switchType
              op [] .pos context popValue
              switchId
              switchData [] .labels
              op [] .pos
              context
            appendSwitchTable
            switchId context openSwitchBlock
            false context [] .reachable =
          return
        CASE case
            sb
              ## don't add position before label
              op [] .val .block .blockId =:: switchId
              ## BranchId
                BranchType .CASE
                switchId
                op [] .val .block .subId
              BranchId new context startBranch
              true context [] .reachable =
            return
        DEFAULT case
            sb
              ## don't add position before label
              op [] .val .block .blockId =:: switchId
              ## BranchId
                BranchType .DEFAULT
                switchId
                0
              BranchId new context startBranch
              true context [] .reachable =
            return
        BREAK_SWITCH case
            ## findBreakableBlock
              op [] .val .block .blockId
              op [] .pos
              context
            findBreakableBlock =:: breakBlock?
            breakBlock? optional.isEmpty if
              ## error message handled by findBreakableBlock
              sb return
            end
            breakBlock? .data =:: breakBlock
            breakBlock [] .Switch ?? ! if
              "unexpected block for " sb.wrap
                BlockType .BREAK_SWITCH sb.appendBlockType
                ": " sb.appendS
                breakBlock [] sb.appendBlockInfo
              op [] .pos errors appendError
              sb return
            end
            context [] .stackInfo @
              breakBlock [] .Switch .branchRoot
            branchTree.reset =:: caseBranchId
            ## remember break (if reachable)
            context [] .reachable if
              breakBlock [] .Switch .caseBranches
                caseBranchId list.append
              breakBlock [] .Switch .caseBranches =
              breakBlock [] .Switch .caseBranchIds
                context [] .currentBranch list.append
              breakBlock [] .Switch .caseBranchIds =
            end
            sb
              context [] .reachable if
                ## don't add jump in unreachable branches
                op [] .pos sb.appendPosQBE
                "jmp " sb.appendS
                ## BlockId
                  BranchType .END_SWITCH
                  breakBlock [] .Switch .blockId
                  0
                BranchId new sb.appendBranchId
                '\n' sb.appendC
              end
              false context [] .reachable =
            return
          break
        WHILE case
            ## don't add position before label
            op [] .val .block .blockId =:: whileId
            ## BranchId
              BranchType .WHILE
              whileId
              0
            BranchId new =:: branchId
            whileId context openWhileBlock
            context [] .openBlocks list.peek .data [] .While @ =:: whileBlock
            prog [] .whileData whileId list.at .data =:: whileData
            context [] .currentBranch =:: prevBranch
            whileData [] .modifiedTypes =:: loopEltCount
            loopEltCount StackElement list.create =:: mut: loopElts
            context [] .stackInfo branchTree.depth loopEltCount < if
              "stack underflow" sb.wrap
              op [] .pos errors appendError
              sb return
            end
            0:i64 while ..dup loopEltCount < do 1 +
              loopElts
                context [] .stackInfo @ branchTree.pop .data list.appendP
              loopElts =
            end ..drop
            sb
              "jmp " sb.appendS
              branchId sb.appendBranchId
              '\n' sb.appendC
              branchId context startBranch
              loopEltCount 1 - while ..dup 0 >= do =:: i
                loopElts i list.at .data =:: elt
                "%s" sb.appendS
                elt [] .valType context pushValue sb.appendI
                " =" sb.appendS
                elt [] .valType sb.appendValTypeQBE
                " phi " sb.appendS
                prevBranch sb.appendBranchId
                " %s" sb.appendS
                elt [] .varId sb.appendI
                ',' sb.appendC
                ## BranchId
                  BranchType .CONTINUE_WHILE
                  whileId
                  0
                BranchId new sb.appendBranchId
                " %t" sb.appendS
                whileBlock [] .loopValOffset i + sb.appendI
                '\n' sb.appendC
                i 1 -
              end ..drop
              loopElts list.free loopElts =
            return
        AND_DO OR_DO case
          context [] .openBlocks list.peek .data [] .While @ =:: whileBlock
          op [] .val .block .blockType .OR_DO ?? =:: isOr
          ## BranchId
            BranchType .NEXT
            context nextJumpLabelId
            0
          BranchId new =:: nextBranch
          sb
            op [] .pos sb.appendPosQBE
            "jnz %s" sb.appendS
            op [] .pos context popValue sb.appendI
            ", " sb.appendS
            isOr if
              ## appendBranchId
                BranchType .DO
                op [] .val .block .blockId
                0
              BranchId new sb.appendBranchId
              ", " sb.appendS
            end
            nextBranch sb.appendBranchId
            isOr ! if
              ", " sb.appendS
              ## appendBranchId
                BranchType .END_WHILE
                op [] .val .block .blockId
                0
              BranchId new sb.appendBranchId
            end
            '\n' sb.appendC
            isOr if
              whileBlock [] .doBranches
                context [] .stackInfo @ branchTree.startBranch list.append
              whileBlock [] .doBranches =
              whileBlock [] .doBranchIds
                context [] .currentBranch list.append
              whileBlock [] .doBranchIds =
            else
              whileBlock [] .breakBranches
                context [] .stackInfo @ branchTree.startBranch list.append
              whileBlock [] .breakBranches =
              whileBlock [] .breakBranchIds
                context [] .currentBranch list.append
              whileBlock [] .breakBranchIds =
            end
            nextBranch context startBranch
          return
        DO case
          context [] .openBlocks list.peek .data [] .While @ =:: whileBlock
          ## BranchId
            BranchType .DO
            op [] .val .block .blockId
            0
          BranchId new =:: doBranch
          sb
            op [] .pos sb.appendPosQBE
            "jnz %s" sb.appendS
            op [] .pos context popValue sb.appendI
            ", " sb.appendS
            doBranch sb.appendBranchId
            ", " sb.appendS
            ## appendBranchId
              BranchType .END_WHILE
              op [] .val .block .blockId
              0
            BranchId new sb.appendBranchId
            '\n' sb.appendC
          =:: mut: newSb
          whileBlock [] .breakBranches
            context [] .stackInfo @ branchTree.startBranch list.append
          whileBlock [] .breakBranches =
          whileBlock [] .breakBranchIds
            context [] .currentBranch list.append
          whileBlock [] .breakBranchIds =
          whileBlock [] .doBranches .length 0 > if
            whileBlock [] .doBranches
              context [] .stackInfo @ branchTree.startBranch list.append
            whileBlock [] .doBranches =
            whileBlock [] .doBranchIds
              context [] .currentBranch list.append
            whileBlock [] .doBranchIds =
            ## mergeValues
            context [] .stackInfo @
            whileBlock [] .doBranches list.asArray
            mergeBranches @
            ## MergePoint
                "or-do" string.wrap
                whileBlock [] .blockId
                whileBlock [] .doBranchIds list.asArray
                op [] .pos
                context
                newSb @
              MergePoint new
            branchTree.merge .error ?? if
              "could not merge or-do branches" sb.wrap
              op [] .pos errors appendError
            end
          end
          newSb
            doBranch context startBranch
          return
        BREAK CONTINUE case
          op [] .val .block .blockType =:: blockType
          ## findBreakableBlock
            op [] .val .block .blockId
            op [] .pos
            context
          findBreakableBlock =:: breakBlock?
          breakBlock? optional.isEmpty if
            ## error message handled by findBreakableBlock
            sb return
          end
          breakBlock? .data =:: breakBlock
          breakBlock [] .While ?? ! if
            "unexpected block for " sb.wrap
              blockType sb.appendBlockType
              ": " sb.appendS
              breakBlock [] sb.appendBlockInfo
            op [] .pos errors appendError
            sb return
          end
          blockType .CONTINUE ?? if
            breakBlock [] .While .continueBranches @
            breakBlock [] .While .continueBranchIds @
          else
            breakBlock [] .While .breakBranches @
            breakBlock [] .While .breakBranchIds @
          end =:: branchIds =:: branches
          branches []
            context [] .stackInfo @ branchTree.startBranch list.append
          branches []  =
          branchIds []
            context [] .currentBranch list.append
          branchIds [] =
          sb
            op [] .pos sb.appendPosQBE
            "jmp " sb.appendS
            ## BlockId
              blockType .CONTINUE ?? if BranchType .CONTINUE_WHILE else BranchType .END_WHILE end
              breakBlock [] .While .blockId
              0
            BranchId new sb.appendBranchId
            '\n' sb.appendC
            false context [] .reachable =
          return
        FINALLY case
          context [] .openBlocks list.peek
            .data .While
          =:: mut: whileBlock
          whileBlock .continueBranches =:: mut: continueBranches
          context [] .reachable if
            whileBlock .continueBranchIds []
              context [] .currentBranch list.append
            whileBlock .continueBranchIds [] =
            continueBranches []
              context [] .stackInfo @ branchTree.startBranch list.append
            continueBranches [] =
          end
          sb
            ## don't add position for labels
            ## startBranch
              ## BranchId
                BranchType .CONTINUE_WHILE
                op [] .val .block .blockId
                0
              BranchId new
              context
            startBranch
          =:: mut: newSb
          continueBranches .length [] 1 >= if
            continueBranches .length [] =:: nodeCount
            ## mergeValues
              context [] .stackInfo @
              continueBranches [] list.asArray
              mergeBranches @
              ## MergePoint
                "while" string.wrap
                whileBlock .blockId []
                whileBlock .continueBranchIds [] list.asArray
                op [] .pos
                context
                newSb @
              MergePoint new
            branchTree.merge .error ?? if
              "could not merge continue branches of while block" sb.wrap
              op [] .pos errors appendError
            end
          end
          newSb return
        AND OR case
          op [] .val .block .blockType .OR ?? =:: isOr
          context [] .openBlocks list.peek =:: currentBlock?
          currentBlock? optional.hasData and
              currentBlock? .data =:: andOrBlock
              andOrBlock [] .AndOr ?? if
            andOrBlock [] .AndOr@
          else ## start if block if not already open
            op [] .val .block .blockId context openAndOrBlock
            context [] .openBlocks list.peek .data [] .AndOr@
          end =:: andOrBlock
          andOrBlock [] .branches
            context [] .stackInfo @ branchTree.startBranch list.append
          andOrBlock [] .branches =
          andOrBlock [] .branchIds
            context [] .currentBranch list.append
          andOrBlock [] .branchIds =
          ## BranchId
            BranchType .NEXT
            context nextJumpLabelId
            0
          BranchId new =:: nextBranch
          sb
            op [] .pos sb.appendPosQBE
            "jnz %s" sb.appendS
            op [] .pos context popValue sb.appendI
            ", " sb.appendS
            isOr ! if
              nextBranch sb.appendBranchId
              ", " sb.appendS
            end
            ## appendBranchId
              BranchType .END_AND_OR
              op [] .val .block .blockId
              0
            BranchId new sb.appendBranchId
            isOr if
              ", " sb.appendS
              nextBranch sb.appendBranchId
            end
            '\n' sb.appendC
            nextBranch context startBranch
          return
        PROCEDURE EXPERIMENTAL_PROCEDURE INITIALIZER NAMESPACE
        TYPE_TUPLE TYPE_STRUCT TYPE_ENUM TYPE_UNION TYPE_UNTAGGED_UNION TYPE_PROC_IN
        TYPE_PROC_OUT TYPE_COMPOSITE UNKNOWN case
          ## XXX error message
          break
      end
      break
    blockEnd case
      op [] .val .blockEnd .blockType switch
        PROCEDURE EXPERIMENTAL_PROCEDURE case
          Type .undefined context [] .currentProc =
          sb
            ## end of procedure block always unreachable
            ## ( type-checker ensures there is a return before end )
            "@end\nhlt\n}\n" sb.appendS
            op [] .pos context sb.appendLocalConstants
          return
        ELSE case
          context [] .openBlocks
            list.pop .If =:: ifBlock
          context [] .openBlocks =
          branchTree.NodeId 2 array new =:: mut: branches
          BranchId 2 array new =:: mut: branchIds
          0 =:: mut: nBranches
          ifBlock .ifBranchTerminates if
            ifBlock .ifBranch branches @ nBranches [] =
            ifBlock .ifBranchId branchIds @ nBranches [] =
            nBranches 1 + nBranches =
          end
          context [] .reachable if
            context [] .stackInfo @ branchTree.startBranch branches @ nBranches [] =
            context [] .currentBranch branchIds @ nBranches [] =
            nBranches 1 + nBranches =
          end
          sb
            ## don't add position for labels
            ## startBranch
              ## BranchId
                BranchType .END_IF
                op [] .val .blockEnd .blockId
                0
              BranchId new
              context
            startBranch
          =:: mut: newSb
          nBranches 1 >= if
            ## mergeValues
              context [] .stackInfo @
              branches @ nBranches array.create
              mergeBranches @
              ## MergeIf
                "if" string.wrap
                ifBlock .blockId
                branchIds @ nBranches array.create
                op [] .pos
                context
                newSb @
              MergePoint new
            branchTree.merge .error ?? if
              "could not merge branches of if-else block" sb.wrap
              op [] .pos errors appendError
            end
          end
          nBranches 0 > context [] .reachable =
          ifBlock .andBranches list.free ..drop
          ifBlock .andBranchIds list.free ..drop
          ifBlock .orBranches list.free ..drop
          ifBlock .orBranchIds list.free ..drop
          newSb return
        IFIF case sb return ## no-op
        SWITCH case
          context [] .openBlocks
            list.pop .Switch =:: switchBlock
          context [] .openBlocks =
          switchBlock .caseBranches =:: caseBranches
          caseBranches .length 0 > context [] .reachable =
          sb
            ## don't add position for labels
            ## startBranch
              ## BranchId
                BranchType .END_SWITCH
                op [] .val .blockEnd .blockId
                0
              BranchId new
              context
            startBranch
          =:: mut: newSb
          caseBranches .length 1 >= if
            caseBranches .length =:: nodeCount
            ## mergeValues
              context [] .stackInfo @
              caseBranches list.asArray
              mergeBranches @
              ## MergePoint
                "switch" string.wrap
                switchBlock .blockId
                switchBlock .caseBranchIds list.asArray
                op [] .pos
                context
                newSb @
              MergePoint new
            branchTree.merge .error ?? if
              "could not merge branches of switch-case block" sb.wrap
              op [] .pos errors appendError
            end
          end
          caseBranches .length 0 > context [] .reachable =
          caseBranches list.free ..drop
          switchBlock .caseBranchIds list.free ..drop
          newSb return
        WHILE case
          context [] .openBlocks
            list.pop .While =:: mut: whileBlock
          context [] .openBlocks =
          prog [] .whileData whileBlock .blockId list.at .data =:: whileData
          context [] .stackInfo branchTree.depth whileData [] .modifiedTypes < if
            "stack underflow" sb.wrap
            op [] .pos errors appendError
            sb return
          end
          sb
            ## copy values to loop vars
            0:i64 while ..dup whileData [] .modifiedTypes < do =:: i
              context [] .stackInfo @ branchTree.pop .data =:: elt
              "%t" sb.appendS
              whileBlock .loopValOffset i i64 cast.u + sb.appendI
              " =" sb.appendS
              elt [] .valType sb.appendValTypeQBE
              " copy %s" sb.appendS
              elt [] .varId sb.appendI
              '\n' sb.appendC
              i 1 +
            end ..drop
            ## jump to start of loop
            "jmp " sb.appendS
            ## BranchId
              BranchType .WHILE
              op [] .val .blockEnd .blockId
              0
            BranchId new sb.appendBranchId
            '\n' sb.appendC
          =:: mut: newSb
          newSb
            ## don't add position for labels
            ## startBranch
              ## BranchId
                BranchType .END_WHILE
                op [] .val .blockEnd .blockId
                0
              BranchId new
              context
            startBranch
          newSb =
          whileBlock .breakBranches =:: breakBranches
          breakBranches .length 1 >= if
            breakBranches .length =:: nodeCount
            ## mergeValues
              context [] .stackInfo @
              breakBranches list.asArray
              mergeBranches @
              ## MergePoint
                "while" string.wrap
                whileBlock .blockId
                whileBlock .breakBranchIds list.asArray
                op [] .pos
                context
                newSb @
              MergePoint new
            branchTree.merge .error ?? if
              "could not merge break branches of while block" sb.wrap
              op [] .pos errors appendError
            end
          end
          breakBranches .length 0 > context [] .reachable =
          breakBranches list.free ..drop
          whileBlock .breakBranchIds list.free ..drop
          whileBlock .continueBranches list.free ..drop
          whileBlock .continueBranchIds list.free ..drop
          whileBlock .doBranches list.free ..drop
          whileBlock .doBranchIds list.free ..drop
          newSb return
        AND OR case
          context [] .openBlocks
            list.pop .AndOr =:: mut: andOrBlock
          context [] .openBlocks =
          andOrBlock .branches
            context [] .stackInfo @ branchTree.startBranch list.append
          andOrBlock .branches =
          andOrBlock .branchIds
            context [] .currentBranch list.append
          andOrBlock .branchIds =
          sb
            ## startBranch
              ## BranchId
                BranchType .END_AND_OR
                op [] .val .blockEnd .blockId
                0
              BranchId new
              context
            startBranch
          =:: mut: newSb
          ## mergeValues
            context [] .stackInfo @
            andOrBlock .branches list.asArray
            mergeBranches @
            ## MergePoint
              "and/or" string.wrap
              andOrBlock .blockId
              andOrBlock .branchIds list.asArray
              op [] .pos
              context
              newSb @
            MergePoint new
          branchTree.merge .error ?? if
            "could not merge break branches of and/or block" sb.wrap
            op [] .pos errors appendError
          end
          andOrBlock .branches list.free ..drop
          andOrBlock .branchIds list.free ..drop
          newSb return
        IF DO BREAK CONTINUE CASE DEFAULT BREAK_SWITCH
        AND_IF OR_IF AND_DO OR_DO INITIALIZER NAMESPACE FINALLY
        TYPE_TUPLE TYPE_STRUCT TYPE_ENUM TYPE_UNION TYPE_UNTAGGED_UNION TYPE_PROC_IN
        TYPE_PROC_OUT TYPE_COMPOSITE UNKNOWN case
          ## XXX error message
          break
      end
      break
    Return case
      op [] .dataType typeContext types.isProcedure ! if
        "unexpected type for return: " sb.wrap
          op [] .dataType typeContext sb.appendType
          " expected procedure" sb.appendS
        op [] .pos errors appendError
        sb return
      end
      op [] .dataType typeContext types.getProcRet ..drop =:: retType
      op [] .dataType typeContext types.getProcOutArgs ..drop =:: outTypes
      retType typeContext types.isProcOut if
          retType typeContext types.compositeEltCount
        else retType typeContext types.isEmpty _if 0:i64 else 1:i64 end =:: retCount
      false context [] .reachable =
      sb
        op [] .pos sb.appendPosQBE
        retCount 1 == if
          op [] .pos context popValue
          "ret %s" string.wrap
        else retCount 0 > _if
          retType op [] .pos context true appendAlloc =:: tmpId
          retType 't' tmpId op [] .pos context initializeTupleQBE
          tmpId
          "ret %t" string.wrap
        else
          -1:i64  string.empty ## values will be ignored
        end =:: retStr =:: retId
        outTypes .length 1 - while ..dup 0 >= do =:: i
          outTypes i array.get =:: elt
          elt typeContext types.isEmpty if
            i 1 - continue
          end
          elt context referenceOnly if
            "blit" sb.appendS
          else
            "store" sb.appendS
            elt StorageType .STORE op [] .pos context sb.appendTypeNameQBE
          end
          " %s" sb.appendS
          op [] .pos context popValue sb.appendI
          ", " sb.appendS
          i context sb.appendOutArgName
          elt context referenceOnly if
            ", " sb.appendS
            elt op [] .pos context typeSizeInt sb.appendI
          end
          '\n' sb.appendC
        i 1 -
        end ..drop
        retCount 0 == if
          "ret\n" sb.appendS
          return
        end
        retStr sb.appendStr
        retId sb.appendI
        '\n' sb.appendC
      return
    Assert case
      ## BranchId
        BranchType .NEXT
        context nextJumpLabelId
        0
      BranchId new =:: successBranch
      ## BranchId
        BranchType .ERROR
        context nextJumpLabelId
        0
      BranchId new =:: errorBranch
      sb
        op [] .pos sb.appendPosQBE
        "## assert\n" sb.appendS
        "jnz %s" sb.appendS
        op [] .pos context popValue sb.appendI
        " ," sb.appendS
        successBranch sb.appendBranchId
        " ," sb.appendS
        errorBranch sb.appendBranchId
        '\n' sb.appendC
        errorBranch sb.appendBranchId
        '\n' sb.appendC
        "call $printf(l $" sb.appendS
        ASSERT_FORMAT sb.appendS
        ",l " sb.appendS
        op [] .val .Assert .length sb.appendI
        ",l " sb.appendS
        op [] .val .Assert context sb.appendStringPtrConstQBE
        op [] .pos prog appendPosPrintfArgs
        ")\ncall $exit(w 1)\n" sb.appendS
        successBranch context startBranch
        '\n' sb.appendC
      return
    unreachable case
      false context [] .reachable =
      sb
        op [] .pos sb.appendPosQBE
        "## unreachable\n" sb.appendS
        "hlt\n" sb.appendS
      return
    stackMod case
      op [] .val .stackMod .modType switch
        DROP case
          op [] .val .stackMod .n =:: count
          count while ..dup 0 > do 1 -
             context [] .stackInfo @ branchTree.pop ..drop
          end ..drop
          sb return
        COPY case
          op [] .val .stackMod .n =:: offset
          context [] .stackInfo branchTree.depth offset i64 cast.u <= if
            "stack underflow" sb.wrap
            op [] .pos errors appendError
            sb return
          end
          ## copy value on stack
          context [] .stackInfo @
            offset
          branchTree.at .data =:: copied
          context [] .stackInfo @
            copied []
          branchTree.push
          sb return
        SWAP case
          context [] .stackInfo branchTree.depth 2 < if
            "stack underflow" sb.wrap
            op [] .pos errors appendError
            sb return
          end
          context [] .stackInfo @ branchTree.swap
          sb return
      end
      break
    autoTypedInitializeId typeInfo
    compilerInfo getName atName getLabel
    atLabel length size typeModifier hasLabel hasName case
      break ## XXX error message
  end
  "unable to compile operation " sb.wrap
    op [] prog sb.appendOp
  op [] .pos errors appendError
  sb return
end

proc( CompilerContext ptr mut : context -> ) =>: cleanupCompilerContext
  context [] .stackInfo @ branchTree.free
  context [] .openBlocks
    list.free
  context [] .openBlocks =
  context [] .localConstants
    list.free
  context [] .localConstants =
  context [] .stringConstants
    list.free
  context [] .stringConstants =
  context [] .ptrConstants
    list.free
  context [] .ptrConstants =
end
proc( io.FILE : target ProgramContext ptr mut : program -> ) =>: export: compileToQBE
  program [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  ## CompilerContext
    program
    StackElement branchTree.create
    BranchType .START 0 0 BranchId new
    32 BlockInfo list.create
    32 LocalConst list.create
    32 StringConstant list.create
    32 ConstValue list.create
    Type .undefined
    0
    0
    0
    0
    true
  CompilerContext new =:: mut: contextData
  contextData @ =:: context
  id.LABEL_ID_NONE =:: mut: mainId
  MAIN_NAME string.wrap 0:FileId idContext id.findIdentifierByName ! if =:: data
    data [] .labelId labelContext id.getLabelNamespace 0:NamespaceId ==
        assert "main is in global namespace"
    data [] .labelId mainId =
  else ..drop end
  1024 sb.create
    program getDeclaredTypes =:: types
    0:i64 while ..dup types .length < do =:: i
      types i list.get
        ## TODO? use declaration position of type
        string.empty 0 0 FilePosition new
      context sb.appendTypeDeclarationQBE
      i 1 +
    end ..drop
    program [] .hasCheckIndex if
      "data $" sb.appendS
      CHECK_INDEX_FORMAT sb.appendS
      " = { b \"index out of range: %lli size: %llu at %.*s:%i:%i\\n\", b 0 }\n" sb.appendS
    end
    program [] .hasCheckEnum if
      "data $" sb.appendS
      CHECK_ENUM_FORMAT sb.appendS
      " = { b \"enum index (%i) does not match current value (%u) at %.*s:%i:%i\\n\", b 0 }\n" sb.appendS
    end
    "data $" sb.appendS
    ASSERT_FORMAT sb.appendS
    " = { b \"assertion failed: \\\"%.*s\\\" at %.*s:%i:%i\\n\", b 0 }\n" sb.appendS
  =:: mut: sb
  idContext [] .globalScope .identifierNames @ map.itr.start while map.itr.hasNext do map.itr.next
    =:: declaration ## TODO find out which declarations are actually used
    declaration .1 [] =:: labelId
    labelId idContext id.getIdentifier
      ! assert "labelId is identifier"
    =:: idData
    idData [] .idType .TYPE ??
    idData [] .idType .PROCEDURE ?? |
    idData [] .idType .PROCEDURE_BUNDLE ?? | if
      continue
    end
    idData [] .valueType =:: mut: valType
    labelId labelContext id.labelFlags =:: labelFlags
    valType types.isAutoType if
      program [] .autoTypes
        valType types.getTypeId
      list.at .data []
      valType =
    end
    valType types.primitive.TYPE types.typeEquals or
        valType typeContext types.isEmpty or
        valType typeContext types.isProcedure or
        labelFlags id.FLAG_EXTERN & ? if
      continue
    end
    sb
      labelFlags id.FLAG_EXPORT & ? if
        "export " sb.appendS
      end
      "data " sb.appendS
      labelId -1 context sb.appendGlobalName
      " = align " sb.appendS
      valType idData [] .declaredAt context typeAlignmentInt sb.appendI
      " {" sb.appendS
      idData [] .constValue .none ?? ! if
        valType idData [] .constValue true idData [] .declaredAt context sb.appendConstQBE
      else
        "z " sb.appendS
        valType idData [] .declaredAt context typeSizeInt sb.appendI
      end
      "}\n" sb.appendS
      target ..over io.fputSb ..drop
      sb.clear
    sb =
  end ..drop
  sb
    ## constant references
    0:i64 while ..dup program [] .constantReferences .length < do =:: i
      program [] .constantReferences i list.at .data =:: constRef
      "data $" sb.appendS
      CONST_REFERENCE_NAME sb.appendS
      i sb.appendI
      " = {" sb.appendS
        constRef [] .constType constRef [] .value true constRef [] .pos context sb.appendConstQBE
      "} \n" sb.appendS
      i 1 +
    end ..drop
    ## code
    0:i64 while ..dup program [] .progFiles .length < do =:: i
      program [] .progFiles i list.at .data =:: f
        "dbgfile \"" sb.appendS
        f [] .fileName sb.appendSb
        "\"\n"    sb.appendS
        "data $" sb.appendS
        FILE_NAME_NAME sb.appendS
        i sb.appendI
        " = {" sb.appendS
          f [] .fileName
            sb.asStr labelContext id.wrapStringConstant
            context
          sb.appendStringConstQBE
        "} \n" sb.appendS
        0:i64 while ..dup f [] .localOps .length < do
          ..swap
          f [] .localOps ..over.2 list.at .data context compileOp
          ..swap 1 +
        end ..drop
        target ..over io.fputSb ..drop
        sb.clear
      i 1 +
    end ..drop
    target ..over io.fputSb ..drop
    sb.clear
    0:i64 while ..dup context [] .stringConstants .length < do =:: i
      context [] .stringConstants i list.get =:: str
      "data $" sb.appendS
      STRING_CONST_NAME sb.appendS
      i sb.appendI
      " = {" sb.appendS
        str context sb.appendStringConstQBE
      "} ## \"" sb.appendS
      str labelContext sb.appendEscapedStr
      "\"\n" sb.appendS
      i 1 +
    end ..drop
    0:i64 while ..dup context [] .ptrConstants .length < do =:: i
      context [] .ptrConstants i list.get =:: val
      "data $" sb.appendS
      PTR_CONST_NAME sb.appendS
      i sb.appendI
      " = {" sb.appendS
        val context sb.appendPtrConstDataQBE
      "}\n" sb.appendS ## XXX? append string value of string16/string32 constants
      i 1 +
    end ..drop
    target ..over io.fputSb ..drop
    sb.clear
    mainId id.LABEL_ID_NONE == if ## no main
      sb.free ..drop
      context cleanupCompilerContext
      return
    end
    program [] .hasGetArgs if
      "data $" sb.appendS
      CONCAT_ARGC_NAME sb.appendS
      " = { l 0 }\n" sb.appendS
      "data $" sb.appendS
      CONCAT_ARGV_NAME sb.appendS
      " = { l 0 }\n" sb.appendS
      "data $" sb.appendS
      CONCAT_ENVP_NAME sb.appendS
      " = { l 0 }\n" sb.appendS
      "export function w $main(l %argc,l %argv,l %envp){\n@start\n" sb.appendS
      "storel %argc,$" sb.appendS
      CONCAT_ARGC_NAME sb.appendS
      '\n' sb.appendC
      "storel %argv,$" sb.appendS
      CONCAT_ARGV_NAME sb.appendS
      '\n' sb.appendC
      "storel %envp,$" sb.appendS
      CONCAT_ENVP_NAME sb.appendS
      '\n' sb.appendC
      "call " sb.appendS
    else
      "export function w $main(){\n@start\ncall " sb.appendS
    end
    mainId -1 context sb.appendGlobalName
    "()\nret 0\n}\n" sb.appendS
    target ..over io.fputSb ..drop
  sb.free ..drop
  context cleanupCompilerContext
end
