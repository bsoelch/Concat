        argIndices argIndex list.at .data =:: arg
        op [] .pos context popValue arg [] .valId =
      end
      newSb
        calledType
          argIndices @
          outArgOffset
          op [] .pos
        context prepareCall
        procData [] .labelId
          callInfo [] .implementationId
        context sb.appendGlobalName
        calledType
          argIndices @
          outArgOffset
          op [] .pos
        context finishCall
      return
    callPtr case
      op [] .val .callPtr TypedValId list.create =:: mut: argIndices
      0:i64 while ..dup op [] .val .callPtr < do =:: i
        argIndices
