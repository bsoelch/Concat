import stringIO

import "program.concat"
import "measure.concat"
import "branchTree.concat"

## XXX make prefix customizable
"cct_" =:: CONCAT_PREFIX
"cctI_argc" =:: CONCAT_ARGC_NAME
"cctI_argv" =:: CONCAT_ARGV_NAME
"cctI_envp" =:: CONCAT_ENVP_NAME

enum( START IF ELSE END_IF ) =:: BranchType
struct( BranchType : branchType i32 : id ) =:: BranchId
enum( EMPTY I32 I64 FLOAT DOUBLE PTR ) =:: ValType
struct(
  i64 : varId
  BranchId : branch
  ValType : valType
) =:: StackElement

struct(
  Type       : valType
  ConstValue : value
  FilePosition : pos
  i64 : id
) =:: LocalConst

struct(
  i32 : blockId
  branchTree.NodeId : branchRoot
  branchTree.NodeId : mut ifBranch
) =:: IfBlockInfo

enum(
  IfBlockInfo : mut If
) =:: BlockInfo

struct(
  ProgramContext ptr mut : program
  StackElement BranchTree : mut stackInfo
  BranchId : mut currentBranch
  BlockInfo list : mut openBlocks
  LocalConst list : mut localConstants
  i64 : mut localConstCount
  i64 : mut stackCount
  i64 : mut tmpCount
) =:: CompilerContext

namespace: sb
  proc( stringBuilder ValType -> stringBuilder ) =>: appendValType
    switch
      EMPTY case "empty" sb.appendS return
      I32 case "i32" sb.appendS return
      I64 case "i64" sb.appendS return
      FLOAT case "float" sb.appendS return
      DOUBLE case "double" sb.appendS return
      PTR case "pointer" sb.appendS return
    end
  end
end
proc( Type : t CompilerContext ptr : context -> ValType ) =>: toValType
  context [] .program =:: program
  program [] .errors @ =:: errors
  program [] .idContext .typeContext @ =:: typeContext
  t switch
    namedType case
      t typeContext types.unwrapNamed context toValType return
    generatedType case
      t typeContext types.getGeneratedType context toValType return
    primitiveType case
      t .primitiveType switch
        TYPE case ValType .EMPTY return
        BOOL I8 I16 I32 case ValType .I32 return
        I64     case ValType .I64 return
        FLOAT32 case ValType .FLOAT return
        FLOAT64 case ValType .DOUBLE return
      end
      break
    cType case
      t .cType switch ## TODO consider sizes of c-types
        VOID case ValType .EMPTY return
        BOOL CHAR S_CHAR U_CHAR SHORT U_SHORT INT U_INT case ValType .I32 return
        LONG U_LONG case ValType .I64 return
        LONGLONG U_LONGLONG SIZE case ValType .I64 return
        FLOAT case ValType .FLOAT return
        DOUBLE case ValType .DOUBLE return
      end
      break
    arrayIndex case
      ValType .I64 return
    pointer reference mutableReference procedure
    arrayType struct union enum case
      ValType .PTR return
    undefined empty templateType genericType autoType
    procIn procOut case
      ValType .EMPTY return
  end
end

namespace: sb
  proc( stringBuilder : sb BranchId : branch -> stringBuilder ) =>: appendBranchId
    sb
      branch .branchType switch
        START case "@start" sb.appendS break
        IF case "@if_" sb.appendS branch .id sb.appendI break
        ELSE case "@else_" sb.appendS branch .id sb.appendI break
        END_IF case "@endIf_" sb.appendS branch .id sb.appendI break
      end
    return
  end
end
proc(
  stringBuilder : sb
  BranchType : branchType
  i32 : branchId
  CompilerContext ptr mut : context
-> stringBuilder ) =>: startBranch
  branchType branchId BranchId new =:: branch
  branch context [] .currentBranch =
  sb
    branch sb.appendBranchId
    '\n' sb.appendC
  return
end
proc( ValType : valType CompilerContext ptr mut : context -> i64 ) =>: pushValue
  context [] .stackCount =:: oldCount
    context [] .stackInfo @
      oldCount
      context [] .currentBranch
      valType
    StackElement new branchTree.push
    oldCount
      1 +
    context [] .stackCount =
  oldCount return
end
proc( CompilerContext ptr mut : context -> i64 ) =>: popValue
  context [] .stackInfo @ branchTree.pop =:: tmp
  tmp .data ?? if
    tmp .data [] .varId return
  end
  -1 return
end
proc( CompilerContext ptr mut : context -> i64 ) =>: nextTmpId
  context [] .tmpCount =:: oldCount
    oldCount
      1 +
    context [] .tmpCount =
  oldCount return
end


struct(
  i32 : blockId
  FilePosition : pos
  CompilerContext ptr mut : context
  stringBuilder ptr mut : out
) =:: MergePoint
proc(
  StackElement ptr arrayView : toMerge
  MergePoint : mergePoint
-> StackElement ) =>: mergeIfBranches
  mergePoint .context =:: context
  context [] .program =:: program
  program [] .errors @ =:: errors
  program [] .idContext @ =:: idContext
  program [] .idContext .constContext @ =:: constContext
  program [] .idContext .typeContext @ =:: typeContext
  program [] .idContext .labelContext @ =:: labelContext
  toMerge 0 array.get =:: ifValue
  toMerge .length 2 != if
    "wrong number of branches in if-statement expected: 2 got:" sb.wrap
       toMerge .length sb.appendI
    mergePoint .pos errors appendError
    ifValue [] return
  end
  toMerge 1 array.get =:: elseValue
  ifValue [] .varId elseValue [] .varId == if
    ifValue [] return
  end
  ifValue [] .valType elseValue [] .valType != if
    "branches of if-statement are out of sync expected: " sb.wrap
       ifValue [] .valType sb.appendValType
       " got: " sb.appendS
       elseValue [] .valType sb.appendValType
    mergePoint .pos errors appendError
  end
  context [] .stackCount =:: oldCount
    oldCount 1 +
  context [] .stackCount =
  mergePoint .out []
    "%s" sb.appendS
    oldCount sb.appendI
    " =" sb.appendS
    ifValue [] .valType switch
      EMPTY case break
      I32 case 'w' sb.appendC break
      I64 PTR case 'l' sb.appendC break
      FLOAT case 's' sb.appendC break
      DOUBLE case 'd' sb.appendC break
    end
    " phi " sb.appendS
    ifValue [] .branch sb.appendBranchId
    " %s" sb.appendS
    ifValue [] .varId sb.appendI
    ", " sb.appendS
    elseValue [] .branch sb.appendBranchId
    " %s" sb.appendS
    elseValue [] .varId sb.appendI
    '\n' sb.appendC
  mergePoint .out [] =
  ## StackElement
    oldCount
    context [] .currentBranch
    ifValue [] .valType
  StackElement new return
end

proc( i32 : blockId branchTree.NodeId : branchRoot -> BlockInfo ) =>: newIfBlock
  blockId branchRoot -1 IfBlockInfo new BlockInfo .If new return
end
proc( BlockInfo : block CompilerContext ptr mut : context -> ) =>: openBlock
  context [] .openBlocks
    block list.append
  context [] .openBlocks =
end


namespace: sb
  proc( stringBuilder : sb LabelId : label CompilerContext ptr mut : context -> stringBuilder ) =>: appendGlobalName
    context [] .program =:: prog
    prog [] .idContext .labelContext @ =:: labelContext
    sb
      '$' sb.appendC
      CONCAT_PREFIX sb.appendS
      label labelContext id.labelFlags id.FLAG_EXPORT & 0 == if
        label labelContext id.getLabelFile sb.appendI
        "_F" sb.appendS
      end
      label labelContext id.getLabelNamespace =:: mut mNamespace
      while mNamespace id.NAMESPACE_ID_NONE != mNamespace 0 > & do
        mNamespace labelContext id.namespaceName labelContext sb.appendAsciifiedStringConst
        "." string.wrap sb.appendAsciified
        mNamespace labelContext id.parentNamespace mNamespace =
      end ## XXX? reverse order
      label labelContext sb.appendAsciifiedLabelName
    return
  end

  proc(
    stringBuilder : sb
    Type : t
    string : name
    bool : isStored
  -> stringBuilder ) =>: appendCompositeTypeQBE
    isStored if
      sb
        ":" sb.appendS
        name sb.appendStr
        t types.getTypeId sb.appendI
      return
    else
      sb "l" sb.appendS return
    end
  end

  proc(
    stringBuilder : sb
    Type : t
    bool : isStored
    FilePosition : pos
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: appendTypeNameQBE
    context [] .program =:: prog
    prog [] .errors @ =:: errors
    prog [] .idContext .labelContext @ =:: labelContext
    prog [] .idContext .typeContext @ =:: typeContext
    t switch
      namedType case
        sb
          t typeContext types.unwrapNamed isStored pos context
        appendTypeNameQBE
        return
      generatedType case
        sb
          t typeContext types.getGeneratedType isStored pos context
        appendTypeNameQBE
        return
      primitiveType case
        t .primitiveType switch
          TYPE case sb ":type" sb.appendS return break
          BOOL case
            isStored if
              sb "ub" sb.appendS return
            else
              sb "w" sb.appendS return
            end
            break
          I8 case
            isStored if
              sb "sb" sb.appendS return
            else
              sb "w" sb.appendS return
            end
            break
          I16 case
            isStored if
              sb "sh" sb.appendS return
            else
              sb "w" sb.appendS return
            end
            break
          I32     case sb "w" sb.appendS return
          I64     case sb "l" sb.appendS return
          FLOAT32 case sb "s" sb.appendS return
          FLOAT64 case sb "d" sb.appendS return
        end
        break
      cType case
        t .cType switch ## TODO consider sizes of c-types
          BOOL case
            isStored if
              sb "sb" sb.appendS return
            else
              sb "w" sb.appendS return
            end
            break
          CHAR S_CHAR case
            isStored if
              sb "sb" sb.appendS return
            else
              sb "w" sb.appendS return
            end
            break
          U_CHAR case
            isStored if
              sb "ub" sb.appendS return
            else
              sb "w" sb.appendS return
            end
          break
          SHORT case
            isStored if
              sb "sh" sb.appendS return
            else
              sb "w" sb.appendS return
            end
          break
          U_SHORT case
            isStored if
              sb "uh" sb.appendS return
            else
              sb "w" sb.appendS return
            end
          break
          INT U_INT case sb "w" sb.appendS return
          LONG LONGLONG U_LONG U_LONGLONG SIZE case
            sb "l" sb.appendS return
          FLOAT case sb "s" sb.appendS return
          DOUBLE case sb "d" sb.appendS return
          VOID case break
        end
        break
      arrayIndex pointer reference mutableReference procedure case
        sb "l" sb.appendS return ## size or pointer
      arrayType case
        sb t "array" string.wrap isStored appendCompositeTypeQBE return
        break
      struct case
        sb t "struct" string.wrap isStored appendCompositeTypeQBE return
        break
      union case
        sb t "union" string.wrap isStored appendCompositeTypeQBE return
        break
      enum case
        sb t "enum" string.wrap isStored appendCompositeTypeQBE return
        break
      undefined empty templateType genericType autoType
      procIn procOut case
        break
    end
    "unsupported type" sb.wrap
    pos errors appendError
    sb return
  end
  proc(
    stringBuilder : sb
    i32 : index
    LabelId : labelId
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: appendArgName
    context [] .program =:: prog
    prog [] .idContext .labelContext @ =:: labelContext
    sb
      "%a" sb.appendS
      index sb.appendI
      labelId id.LABEL_ID_NONE != if
        "/*" sb.appendS
        labelId labelContext sb.appendAsciifiedLabelName
        "*/" sb.appendS
      end
    return
  end
  proc(
    stringBuilder : sb
    i32 : index
    LabelId : labelId
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: appendOutArgName
    context [] .program =:: prog
    prog [] .idContext .labelContext @ =:: labelContext
    sb
      "%o" sb.appendS
      index sb.appendI
      labelId id.LABEL_ID_NONE != if
        "/*" sb.appendS
        labelId labelContext sb.appendAsciifiedLabelName
        "*/" sb.appendS
      end
    return
  end
  proc(
    stringBuilder : sb
    Type : procType
    FilePosition : pos
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: appendProcArgs
    context [] .program =:: prog
    prog [] .idContext .labelContext @ =:: labelContext
    prog [] .idContext .typeContext @ =:: typeContext
    procType typeContext types.getCallConvention #drop =:: callConvention
    procType typeContext types.getProcIn #drop =:: inType
    inType typeContext types.compositeElts =:: args
    procType typeContext types.getProcOut #drop =:: outType
    outType typeContext types.compositeElts =:: outTypes
    false =:: mut hasArgs
    sb
      "(" sb.appendS
      0 while #dup args .length < do
        #swap
          args #over:2 types.compositeElts.get =:: arg
          arg typeContext types.isEmpty if ## skip empty arguments
            #swap 1 + continue
          end
          hasArgs if
            ',' sb.appendC
          end
          true hasArgs =
          arg true pos context appendTypeNameQBE
          ' ' sb.appendC
          #over inType #over typeContext types.compositeGetLabel context appendArgName
        #swap 1 +
      end #drop
      callConvention .POINTER ?? if
        outTypes .length =:: mut N
        N 0 > if outTypes N 1 - types.compositeElts.get typeContext types.isSmallType if
          N 1 - N =
        end end
        0 while #dup N < do
          #swap
            outTypes #over:2 types.compositeElts.get =:: arg
            arg typeContext types.isEmpty if ## skip empty arguments
              #swap 1 + continue
            end
            hasArgs if
              ',' sb.appendC
            end
            true hasArgs =
            "l " sb.appendS ## all out arguments are pointers
            #over outType #over typeContext types.compositeGetLabel context appendOutArgName
          #swap 1 +
        end #drop
      end
      ")" sb.appendS
    return
  end
  proc(
    stringBuilder : sb
    Type : t
    ConstValue : value
    bool : isGlobal
    FilePosition : pos
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: appendConstQBE
    context [] .program =:: prog
    prog [] .errors @ =:: errors
    prog [] .idContext .labelContext @ =:: labelContext
    prog [] .idContext .typeContext @ =:: typeContext
    prog [] .idContext .constContext @ =:: constContext
    sb
      isGlobal if t types.isPrimitive _if
        t true pos context sb.appendTypeNameQBE
        ' ' sb.appendC
      end
      value switch
        boolean case value .boolean if 1 else 0 end sb.appendI return
        int case value .int sb.appendI return
        break
        chr case value .chr sb.appendI return
        break
        enumLabel case break
        Float case break
        str case break
        arrayConstant case
          isGlobal ! if
            break ## TODO handle local composite constants
          end
          t typeContext types.isArray if
            t typeContext types.getBaseType =:: base
            value .arrayConstant constContext constArrayAsArray =:: elts
            0 while #dup elts .length < do
              #swap
                base elts #over:3  array.get true pos context appendConstQBE
                ',' sb.appendC
              #swap 1 +
            end #drop
            return
          else t typeContext types.isTuple _if
            ## TODO padding/alignment
            t typeContext types.compositeElts =:: types
            value .arrayConstant constContext constArrayAsArray =:: elts
            0 while #dup elts .length < do
              #swap
                types #over:2 types.compositeElts.get elts #over:3  array.get true pos context appendConstQBE
                ',' sb.appendC
              #swap 1 +
            end #drop
            return
          end
        break
        none wildCard genericArg templateArg typeId procedure case
        break
      end
      isGlobal if
        "unsupported constant" sb.wrap
          value constContext labelContext typeContext sb.appendConstant
        pos errors appendError
        return
      end
      context [] .localConstants
        #dup .length =:: constId
        ## LocalConst
          t
          value
          pos
          constId
        LocalConst new list.append
      context [] .localConstants =
      "$localConstant" sb.appendS
      constId sb.appendI
    return
  end
  proc(
    stringBuilder : sb
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: appendLocalConstants
    context [] .program [] .idContext .typeContext @ =:: typeContext
    sb
      0 while #dup context [] .localConstants .length < do =:: i
        context [] .localConstants i list.at .data =:: constant
        "data $localConstant" sb.appendS
        constant [] .id sb.appendI
        " = align " sb.appendS
        constant [] .valType typeContext types.alignOf sb.appendI
        " {" sb.appendS
        constant [] .valType constant [] .value true constant [] .pos context appendConstQBE
        "}\n" sb.appendS
        i 1 +
      end #drop
      context [] .localConstants
        list.clear
      context [] .localConstants =
    return
  end
  proc( stringBuilder : sb string : str -> stringBuilder ) =>: appendEscapedString
    sb
      0 while #dup str .length < do =:: i
          str i string.charAt appendEscapedChr
        i 1 +
      end #drop
    return
  end
  proc(
    stringBuilder : sb
    FilePosition : pos
  -> stringBuilder ) =>: appendPosQBE
    sb
      "dbgloc \"" sb.appendS
      pos .fileName sb.appendEscapedString
      "\"," sb.appendS
      pos .line sb.appendI
      ',' sb.appendC
      pos .posInLine sb.appendI
      '\n' sb.appendC
    return
  end
end

proc(
  stringBuilder : sb
  Operation ptr : op
  CompilerContext ptr mut : context
-> stringBuilder ) =>: compileOp
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .labelContext @ =:: labelContext
  idContext [] .typeContext @ =:: typeContext
  op [] .val switch
    NOP case
      sb return
    Constant case
      sb
        op [] .pos sb.appendPosQBE
        "%s" sb.appendS
        op [] .dataType types.isPrimitive if
          op [] .dataType context toValType context pushValue sb.appendI
          " =" sb.appendS
          op [] .dataType false op [] .pos context sb.appendTypeNameQBE
          " copy " sb.appendS
        else
          ValType .PTR context pushValue sb.appendI
          " =l copy " sb.appendS
        end
        op [] .dataType op [] .val .Constant false op [] .pos context sb.appendConstQBE
        '\n' sb.appendC
      return
    declareId initializeId case
      op [] .val .declareId ?? if
        op [] .val .declareId
      else
        op [] .val .initializeId
      end =:: idInfo
      op [] .val .initializeId ?? =:: assignValue
      idInfo .labelId labelContext id.labelFlags =:: labelFlags
      labelFlags id.FLAG_MUTABLE & ? =:: mutable
      idInfo .idType switch
        PROCEDURE case
          assignValue ! if
            sb return
          end
          ## reset stack-info in context
          0 context [] .stackCount =
          0 context [] .tmpCount =
          context [] .stackInfo @ branchTree.clear
          sb
            labelFlags id.FLAG_EXPORT & ? labelFlags id.FLAG_EXTERN & ? | if
              "export " sb.appendS
            end
            "function " sb.appendS
            op [] .dataType typeContext types.getProcRet #drop =:: retType
            retType typeContext types.isEmpty ! if
              retType true op [] .pos context sb.appendTypeNameQBE
              ' ' sb.appendC
            end
            idInfo .labelId context sb.appendGlobalName
            op [] .dataType op [] .pos context sb.appendProcArgs
            "{\n@start\n" sb.appendS
          return
        LOCAL_VAR TMP_VAR case
          op [] .dataType =:: valType
          ## use pointers as stack representation of arrays and composites
          valType types.isPrimitive =:: isValue
          sb
            op [] .pos sb.appendPosQBE
            idInfo .idType .LOCAL_VAR ?? if
              "%l" sb.appendS
              idInfo .labelId sb.appendI
            else
              "%tmp" sb.appendS
              idInfo .id sb.appendI
            end
            " =l alloc" sb.appendS
            valType typeContext types.alignOf
              #dup 4 < if #drop 4i64 end
            sb.appendI
            ' ' sb.appendC
            valType typeContext types.sizeOf sb.appendI
            '\n' sb.appendC
            assignValue if
              isValue if
                "store" sb.appendS
                valType true op [] .pos context sb.appendTypeNameQBE
              else
                "blit " sb.appendS ## XXX call memcopy for large structs
              end
              " %s" sb.appendS
              context popValue sb.appendI
              ',' sb.appendC
              idInfo .idType .LOCAL_VAR ?? if
                "%l" sb.appendS
                idInfo .labelId sb.appendI
              else
                "%tmp" sb.appendS
                idInfo .id sb.appendI
              end
              isValue ! if
                ',' sb.appendC
                op [] .dataType typeContext types.sizeOf sb.appendI
              end
              '\n' sb.appendC
            end
          return
        GLOBAL_VAR TYPE ARGUMENT TEMPLATE_ARG LABEL case
          break ## XXX error message
      end
      break
    getId @Id case
      op [] .val .getId ?? if
        op [] .val .getId
      else
        op [] .val .@Id
      end =:: idInfo
      op [] .val .@Id ?? =:: isAddr
      idInfo .idType switch
        PROCEDURE GLOBAL_VAR case
          isAddr ! if idInfo .idType .PROCEDURE ?? _if
            break ## TODO call
          end
          sb
            op [] .pos sb.appendPosQBE
            "%s" sb.appendS
            ValType .PTR context pushValue sb.appendI
            " =l copy " sb.appendS
            idInfo .labelId context sb.appendGlobalName
            "\n" sb.appendS
          return
        LOCAL_VAR case
          sb
            op [] .pos sb.appendPosQBE
            "%s" sb.appendS
            ValType .PTR context pushValue sb.appendI
            " =l copy %l" sb.appendS
            idInfo .labelId sb.appendI
            '\n' sb.appendC
          return
        TMP_VAR case
          sb
            op [] .pos sb.appendPosQBE
            "%s" sb.appendS
            ValType .PTR context pushValue sb.appendI
            " =l copy %tmp" sb.appendS
            idInfo .id sb.appendI
            '\n' sb.appendC
          return
         TYPE ARGUMENT TEMPLATE_ARG LABEL case
          break ## XXX error message
      end
      break
    New case
      context nextTmpId =:: tmpId
      sb
        op [] .pos sb.appendPosQBE
        ## prepare memory
        "%t" sb.appendS
          context nextTmpId =:: dataPtrId
        dataPtrId sb.appendI
        " =l alloc" sb.appendS
        op [] .dataType typeContext types.alignOf
          #dup 4 < if #drop 4i64 end
        sb.appendI
        ' ' sb.appendC
        op [] .dataType typeContext types.sizeOf sb.appendI
        '\n' sb.appendC
        op [] .dataType typeContext types.isArray if
          "%s" sb.appendS
          ValType .PTR context pushValue sb.appendI
          " =l copy %t" sb.appendS
          dataPtrId sb.appendI
          '\n' sb.appendC
          return
        else op [] .dataType typeContext types.isTuple ! _if
          "unsupported type for new:" sb.wrap
            op [] .dataType
              labelContext
              typeContext
            sb.appendType
          op [] .pos errors appendError
          return
        end
        op [] .dataType typeContext types.compositeElts =:: elts
        elts .length 1 - while #dup 0 >= do =:: i
          elts i types.compositeElts.get =:: eltType
          op [] .dataType i typeContext types.tupleElementOffset =:: eltOffset
          eltType typeContext types.isEmpty if
            i 1 - continue
          end
          "%t" sb.appendS
            context nextTmpId =:: eltPtrId
          eltPtrId sb.appendI
          " =l add %t" sb.appendS
          dataPtrId sb.appendI
          ", " sb.appendS
          eltOffset sb.appendI
          '\n' sb.appendC
          eltType types.isPrimitive =:: isValue
          isValue if
            "store" sb.appendS
            eltType true op [] .pos context sb.appendTypeNameQBE
            " %s" sb.appendS
          else
            "blit %s" sb.appendS
          end
          context popValue sb.appendI
          ", %t" sb.appendS
          eltPtrId sb.appendI
          isValue ! if
            ',' sb.appendC
            eltType typeContext types.sizeOf sb.appendI
          end
          '\n' sb.appendC
          i 1 -
        end #drop
        "%s" sb.appendS
        ValType .PTR context pushValue sb.appendI
        " =l copy %t" sb.appendS
        dataPtrId sb.appendI
        '\n' sb.appendC
      return
    block case
      op [] .val .block .blockType switch
        IF case
          sb
            "jnz $s" sb.appendS
            context popValue sb.appendI
            " ," sb.appendS
            ## appendBranchId
              BranchType .IF
              op [] .val .block .blockId
            BranchId new sb.appendBranchId
            " ," sb.appendS
            ## appendBranchId
              BranchType .ELSE
              op [] .val .block .blockId
            BranchId new sb.appendBranchId
            '\n' sb.appendC
            ## startBranch
              BranchType .IF
              op [] .val .block .blockId
              context
            startBranch
            context [] .stackInfo @ branchTree.startBranch =:: branchRoot
            op [] .val .block .blockId branchRoot newIfBlock context openBlock
          return
        ELSE case
          context [] .openBlocks list.peek .data =:: ifBlock
          context [] .stackInfo @ ifBlock [] .If .branchRoot branchTree.reset =:: ifBranch
          ifBranch ifBlock [] .If .ifBranch =
          sb
            "jmp " sb.appendS
            ## appendBranchId
              BranchType .END_IF
              op [] .val .block .blockId
            BranchId new sb.appendBranchId
            '\n' sb.appendC
            ## startBranch
              BranchType .ELSE
              op [] .val .block .blockId
              context
            startBranch
          return
        IFIF WHILE CASE DEFAULT DO case
          break
        UNKNOWN BREAK CONTINUE SWITCH INITIALIZER NAMESPACE PROCEDURE EXPERIMENTAL_PROCEDURE
        TYPE_TUPLE TYPE_STRUCT TYPE_ENUM TYPE_UNION TYPE_PROC_IN TYPE_PROC_OUT TYPE_COMPOSITE case
          ## XXX error message
          break
      end
      break
    blockEnd case
      op [] .val .blockEnd .blockType switch
        PROCEDURE EXPERIMENTAL_PROCEDURE case
          sb
            "}\n" sb.appendS
            context sb.appendLocalConstants
          return
        ELSE case
          context [] .openBlocks
            list.pop .If =:: ifBlock
          context [] .openBlocks =
          sb
            ## startBranch
              BranchType .END_IF
              op [] .val .blockEnd .blockId
              context
            startBranch
            branchTree.NodeId 2 array new =:: mut branches
            ifBlock .ifBranch branches @ 0 [] =
            context [] .stackInfo .branchHead branches @ 1 [] =
          =:: mut newSb
            ## mergeValues
              context [] .stackInfo @
              branches @ array.wrap
              mergeIfBranches @
              ## MergeIf
                ifBlock .blockId
                op [] .pos
                context
                newSb @
              MergePoint new
            branchTree.merge if
              "could not merge branches of if-else block" sb.wrap
              op [] .pos errors appendError
            end
          newSb return
        IFIF WHILE CASE DEFAULT DO case
          break
        UNKNOWN BREAK CONTINUE SWITCH INITIALIZER IF NAMESPACE
        TYPE_TUPLE TYPE_STRUCT TYPE_ENUM TYPE_UNION TYPE_PROC_IN TYPE_PROC_OUT TYPE_COMPOSITE case
          ## XXX error message
          break
      end
      break
    setId autoTypedInitializeId
    getElement setElement @Element hasElement getArrayElement
    setArrayElement @ArrayElement setValue Print Return newEnum call callPtr
    argc getArg getArgLen Cast Cast! unaryOperator binaryOperator checkEnumLabel
    setEnumLabel checkArrayIndex unreachable typeInfo
    compilerInfo getName setName @Name getLabel setLabel @Label length size stackMod copy
    typeModifier autoCast hasLabel hasName case
      break ## XXX error message
  end
  "unable to compile operation " sb.wrap
    op [] constContext labelContext typeContext sb.appendOp
  op [] .pos errors appendError
  sb return
end

proc( io.FILE : target ProgramContext ptr mut : prog -> ) =>: export compileToQBE
  prog [] .idContext @ =:: idContext
  idContext [] .labelContext @ =:: labelContext
  idContext [] .typeContext @ =:: typeContext
  ## CompilerContext
    prog
    StackElement branchTree.create
    BranchType .START 0 BranchId new
    32 BlockInfo list.create
    32 LocalConst list.create
    0
    0
    0
  CompilerContext new =:: mut contextData ## TODO cleanup context
  contextData @ =:: context
  id.LABEL_ID_NONE =:: mut mainId
  MAIN_NAME string.wrap 0 idContext id.getIdentifierByName ! if =:: data =:: name
    name .namespace 0 != if
      ..unreachable ## assert that namespace is always top level
    end
    data [] .labelId mainId =
  else #drop:2 end
  ## TODO declare composite types
  ## TODO internal functions
  prog [] .idContext .globalScope .identifiers @ map.itr.start while map.itr.hasNext do map.itr.next
    =:: declaration ## TODO find out which declarations are actually used
    declaration .1 =:: idData
    idData [] .valueType =:: mut valType
    idData [] .labelId =:: labelId
    labelId labelContext id.labelFlags =:: labelFlags
    valType types.isAutoType if
      prog [] .autoTypes
        valType types.getTypeId
      list.at .data []
      valType =
    end
    valType types.primitive.TYPE types.typeEquals
    valType typeContext types.isEmpty |
    valType typeContext types.isProcedure | if
      continue
    end
    128 sb.create
      labelFlags id.FLAG_EXPORT & ? if
        "export " sb.appendS
      end
      "data " sb.appendS
      labelId context sb.appendGlobalName
      " = align " sb.appendS
      valType typeContext types.alignOf sb.appendI
      " {" sb.appendS
      idData [] .constValue ConstValue .none != if
        valType idData [] .constValue true idData [] .declaredAt context sb.appendConstQBE
      else
        "z " sb.appendS
        valType typeContext types.sizeOf sb.appendI
      end
      "}\n" sb.appendS
      target #over io.fputSb #drop
    sb.free #drop
  end #drop
  0 while #dup prog [] .progFiles .length < do
    prog [] .progFiles #over list.at .data =:: f
    1024 sb.create
      "dbgfile \"" sb.appendS
      f [] .fileName sb.appendSb
      "\"\n"    sb.appendS
      0 while #dup f [] .localOps .length < do
        #swap
        f [] .localOps #over:2 list.at .data context compileOp
        #swap 1 +
      end #drop
      target #over io.fputSb #drop
    sb.free #drop
    1 +
  end #drop
  context [] .stackInfo @ branchTree.free
  context [] .localConstants list.free #drop
  mainId id.LABEL_ID_NONE == if ## no main
    return
  end
  128 sb.create
    prog [] .hasGetArgs if
        "data $" sb.appendS
        CONCAT_ARGC_NAME sb.appendS
        " = { l 0 }" sb.appendS
        "data $" sb.appendS
        CONCAT_ARGV_NAME sb.appendS
        " = { l 0 }" sb.appendS
        "data $" sb.appendS
        CONCAT_ENVP_NAME sb.appendS
        " = { l 0 }" sb.appendS
        "export function w $main(l %argc,l %argv,l %envp){\n@start\n" sb.appendS
        "storel %argc,$" sb.appendS
        CONCAT_ARGC_NAME sb.appendS
        '\n' sb.appendC
        "storel %argv,$" sb.appendS
        CONCAT_ARGV_NAME sb.appendS
        '\n' sb.appendC
        "storel %envp,$" sb.appendS
        CONCAT_ENVP_NAME sb.appendS
        '\n' sb.appendC
        "call " sb.appendS
    else
      "export function w $main(){\n@start\ncall " sb.appendS
    end
    mainId context sb.appendGlobalName
    "()\nret 0\n}\n" sb.appendS
    target #over io.fputSb #drop
  sb.free #drop
end
