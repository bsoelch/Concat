  proc(
    stringBuilder
  -> stringBuilder ) =>: endTypeDeclaration
    "}\n" sb.appendS return
  end
  proc(
    stringBuilder : sb
    Type : t
    FilePosition : pos
    CompilerContext ptr mut : context
  -> stringBuilder ) =>: appendTypeDeclarationQBE
    context [] .program =:: prog
    prog [] .errors @ =:: errors
    prog [] .idContext .typeContext @ =:: typeContext
    typeContext [] .labelContext @ =:: labelContext
    prog [] .idContext .constContext @ =:: constContext
    t types.isNamedType t types.isGeneratedType | if
      sb return ## ignore named types
    end
    t typeContext types.isEmpty if
      sb return ## ignore empty types
    end
    t typeContext types.containsGeneric | if
      sb return ## ignore generic types
    end
    t typeContext types.isArray if
      t typeContext types.isFixedSize _if
      t typeContext types.getArraySize =:: sizes
      1:i64 =:: mut: S
      0 while ..dup sizes .length < do =:: i
        sizes i array.get =:: size
        size .sizeType .int ?? ! if
          sb return ## no declaration for var-size array
        end
        S size .value * S =
        i 1 +
      end ..drop
      t typeContext types.getBaseType =:: baseType
      baseType pos context typeSizeInt =:: baseSize
      baseType pos context typeStrideInt =:: baseStride
      sb
        baseSize baseStride < if
          t pos context startEltTypeDeclaration
            ## appendTypeNameQBE
              baseType
              StorageType .STORE
              pos
            context sb.appendTypeNameQBE
            ",b " sb.appendS
            baseStride baseSize - sb.appendI
          endTypeDeclaration
        end
        t pos context startTypeDeclaration
        baseSize baseStride < if
           t pos context eltTypeName
        else
          ## appendTypeNameQBE
            baseType
            StorageType .STORE
            pos
          context sb.appendTypeNameQBE
        end
        ' ' sb.appendC
        S sb.appendI
      endTypeDeclaration return
    end
    t typeContext types.isTuple if
      t typeContext types.compositeElts =:: elts
      0:i64 =:: mut: offset
      false =:: mut: hasElt
      sb t pos context startTypeDeclaration
        0 while ..dup elts .length < do =:: i
          elts i types.compositeElts.get =:: elt
          elt typeContext types.isEmpty if
            i 1 + continue
          end
          t i pos context tupleEltOffsetInt =:: eltOffset
          hasElt if
            ',' sb.appendC
          end
          true hasElt =
          offset eltOffset <= assert "offset <= eltOffset"
          offset eltOffset < if
            "b " sb.appendS
            eltOffset offset - sb.appendI
            ',' sb.appendC
            eltOffset offset =
          end
          ## appendTypeNameQBE
            elt
            StorageType .STORE
            pos
          context sb.appendTypeNameQBE
          offset
            elt pos context typeSizeInt +
          offset =
          i 1 +
        end ..drop
        t pos context typeSizeInt =:: size
        offset size < if
          ",b " sb.appendS
          size offset - sb.appendI
        end
      endTypeDeclaration return
    end
    t typeContext types.isUnion
    t typeContext types.isEnum | if
      t typeContext types.isEnum =:: isTagged
      t typeContext types.compositeElts =:: elts
      false =:: mut: hasElt
      0:i64 =:: mut: bodySize
      sb
        t typeContext types.compositeFlags types.COMP_FLAG_EMPTY & ? ! if
          isTagged if
            t pos context startEltTypeDeclaration
          else
            t pos context startTypeDeclaration
          end
          0 while ..dup elts .length < do =:: i
            elts i types.compositeElts.get =:: elt
            elt typeContext types.isEmpty if
              i 1 + continue
            end
            elt pos context typeSizeInt =:: eltSize
            eltSize bodySize > if
              eltSize bodySize =
            end
            "{" sb.appendS
              ## appendTypeNameQBE
                elt
                StorageType .STORE
                pos
              context sb.appendTypeNameQBE
            "}" sb.appendS
            true hasElt =
            i 1 +
          end ..drop
          endTypeDeclaration
        end
      isTagged ! if return end
      t pos context enumLabelInfoInt =:: labelOffset =:: labelType
      t pos context startTypeDeclaration
        t typeContext types.compositeFlags types.COMP_FLAG_EMPTY & ? ! if
          t pos context eltTypeName
          ',' sb.appendC
        end
        bodySize labelOffset < if
          "b " sb.appendS
          labelOffset bodySize - sb.appendI
          ',' sb.appendC
        end
        ## appendTypeNameQBE
          labelType
          StorageType .STORE
          pos
        context sb.appendTypeNameQBE
      endTypeDeclaration return
    end
    sb return
  end
  proc( stringBuilder : sb string : str -> stringBuilder ) =>: appendEscapedString
    sb
      0 while ..dup str .length < do =:: i
          str i string.charAt appendEscapedChrC
        i 1 +
      end ..drop
    return
  end
  proc(
    stringBuilder : sb
    FilePosition : pos
  -> stringBuilder ) =>: appendPosQBE
    sb
      "dbgloc " sb.appendS
      pos .line sb.appendI
      ',' sb.appendC
      pos .posInLine sb.appendI
      " ## " sb.appendS
      pos .fileName sb.appendEscapedString
      '\n' sb.appendC
    return
  end
end

proc( string : fileName ProgramContext ptr : prog -> FileId ) =>: findFileId
  0 while ..dup prog [] .progFiles .length < do =:: i
    prog [] .progFiles i list.at .data [] .fileName list.asArray =:: currentName
    fileName currentName string.eq if
      i return
    end
    i 1 +
  end ..drop
  FILE_ID_NONE return
end

proc(
  stringBuilder : sb
  FilePosition : pos
  ProgramContext ptr : prog
-> stringBuilder ) =>: appendPosPrintfArgs
  sb
    ",l " sb.appendS
    pos .fileName .length sb.appendI
    ",l $" sb.appendS
    FILE_NAME_NAME sb.appendS
    pos .fileName prog findFileId sb.appendI
    ",w " sb.appendS
    pos .line sb.appendI
    ",w " sb.appendS
    pos .posInLine sb.appendI
  return
end

enum( i64 : constant i64 : stackId i64 : localId i64 : tmpId ) =:: IntValue
proc(
  stringBuilder : sb
  ValType : valType
  i8 : valStackType
  i64 : valId
  string : cmpType
  IntValue : value
  BranchId : ifBranch
  BranchId : elseBranch
  CompilerContext ptr mut : context
-> stringBuilder ) =>: appendCmpInt
  context nextTmpId =:: tmpId
  sb
    "%t" sb.appendS
    tmpId sb.appendI
    " =w c" sb.appendS
    cmpType sb.appendStr
    valType sb.appendValTypeQBE
    " %" sb.appendS
    valStackType sb.appendC
    valId sb.appendI
    ", " sb.appendS
    value switch
      constant case value .constant sb.appendI break
      stackId case "%s" sb.appendS value .stackId sb.appendI break
      localId case "%l" sb.appendS value .localId sb.appendI break
      tmpId case "%t" sb.appendS value .tmpId sb.appendI break
    end
    "\njnz %t" sb.appendS
    tmpId sb.appendI
    ", " sb.appendS
    ifBranch sb.appendBranchId
    ", " sb.appendS
    elseBranch sb.appendBranchId
    "\n" sb.appendS
  return
end
proc(
  stringBuilder : sb
  IntValue : size
  i64 : valId
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: appendIndexCheck
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  ## BranchId
    BranchType .NEXT
    context nextJumpLabelId
    0
  BranchId new =:: check1Branch
  ## BranchId
    BranchType .ERROR
    context nextJumpLabelId
    0
  BranchId new =:: errorBranch
  ## BranchId
    BranchType .NEXT
    context nextJumpLabelId
    0
  BranchId new =:: okBranch
  context nextTmpId =:: c1
  context nextTmpId =:: c2
  sb
    "## check index\n" sb.appendS
    ## cmp int
      ValType .I64
      's' valId
      "slt" string.wrap
      0 IntValue .constant
      errorBranch
      check1Branch
    context appendCmpInt
    check1Branch sb.appendBranchId
    "\n" sb.appendS
    ## cmp int
      ValType .I64
      's' valId
      "sge" string.wrap
      size
      errorBranch
      okBranch
    context appendCmpInt
    errorBranch sb.appendBranchId
    "\ncall $printf (l $" sb.appendS
    CHECK_INDEX_FORMAT sb.appendS
    ", ...,l %s" sb.appendS
    valId sb.appendI
    ",l " sb.appendS
    size switch
      constant case size .constant sb.appendI break
      stackId case "%s" sb.appendS size .stackId sb.appendI break
      localId case "%l" sb.appendS size .localId sb.appendI break
      tmpId case "%t" sb.appendS size .tmpId sb.appendI break
    end
    pos prog appendPosPrintfArgs
    ")\n" sb.appendS
    "call $exit (w 1)\n" sb.appendS ## use exit for flushing stdout
    okBranch context startBranch
  return
end

proc(
  stringBuilder : sb
  Type : enumType
  i64 : valId
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder i64 ValType ) =>: loadEnumLabel
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  enumType pos context enumLabelInfoInt =:: labelOffset =:: labelType
  labelType typeContext types.primitiveValue types.sizeOfPrimitive =:: numBytes
  context nextTmpId =:: labelPtr
  context nextTmpId =:: mut: label
  sb
    "%t" sb.appendS
    labelPtr sb.appendI
    " =l add %s" sb.appendS
    valId sb.appendI
    ", " sb.appendS
    labelOffset sb.appendI
    "\n%t" sb.appendS
    label sb.appendI
    " =w load" sb.appendS
    labelType StorageType .ULOAD pos context sb.appendTypeNameQBE
    " %t" sb.appendS
    labelPtr sb.appendI
    numBytes 4 < if
      label =:: oldLabel
      context nextTmpId label =
      "\n%t" sb.appendS
      label sb.appendI
      " =w ext" sb.appendS
      labelType StorageType .ULOAD pos context sb.appendTypeNameQBE
      " %t" sb.appendS
      oldLabel sb.appendI
    end
    '\n' sb.appendC
  label ValType .I32 return
end
proc(
  stringBuilder : sb
  Type : enumType
  i8  : stackType
  i64 : valId
  i64 : newLabel
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: storeEnumLabel
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  enumType pos context enumLabelInfoInt =:: labelOffset =:: labelType
  context nextTmpId =:: labelPtr
  sb
    "%t" sb.appendS
    labelPtr sb.appendI
    " =l add %" sb.appendS
    stackType sb.appendC
    valId sb.appendI
    ", " sb.appendS
    labelOffset sb.appendI
    "\nstore" sb.appendS
    labelType StorageType .STORE pos context sb.appendTypeNameQBE
    ' ' sb.appendC
    newLabel sb.appendI
    ", %t" sb.appendS
    labelPtr sb.appendI
    '\n' sb.appendC
  return
end
proc(
  stringBuilder : sb
  Type : enumType
  i64 : valId
  i64 : expectedIndex
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder i64 i64 ValType ) =>: checkEnumIndex
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  sb
    ## loadEnumLabel
      enumType
      valId
      pos
    context loadEnumLabel =:: labelType =:: labelId
    context nextTmpId =:: c
    "%t" sb.appendS
    c sb.appendI
    " =w ceq" sb.appendS
    labelType sb.appendValTypeQBE
    " %t" sb.appendS
    labelId sb.appendI
    ", " sb.appendS
    expectedIndex sb.appendI
    '\n' sb.appendC
  c labelId labelType return
end

proc(
  stringBuilder : sb
  Type : enumType
  i64 : valId
  i64 : expectedIndex
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: appendEnumCheck
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  ## BranchId
    BranchType .ERROR
    context nextJumpLabelId
    0
  BranchId new =:: errorBranch
  ## BranchId
    BranchType .NEXT
    context nextJumpLabelId
    0
  BranchId new =:: okBranch
  sb
    "## check enum \n" sb.appendS
    enumType valId expectedIndex pos context checkEnumIndex =:: labelType =:: label =:: c
    "jnz %t" sb.appendS
    c sb.appendI
    ", " sb.appendS
    okBranch sb.appendBranchId
    ", " sb.appendS
    errorBranch sb.appendBranchId
    '\n' sb.appendC
    errorBranch sb.appendBranchId
    "\ncall $printf (l $" sb.appendS
    CHECK_ENUM_FORMAT sb.appendS
    ", ...," sb.appendS
    labelType sb.appendValTypeQBE
    " %t" sb.appendS
    label sb.appendI
    ",w " sb.appendS
    expectedIndex sb.appendI
    pos prog appendPosPrintfArgs
    ")\n" sb.appendS
    "call $exit (w 1)\n" sb.appendS ## use exit for flushing stdout
    okBranch context startBranch
  return
end

proc(
  stringBuilder : sb
  Type : tupleType
  i64 : tupleId
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: flattenTupleQBE
  context [] .program =:: prog
  prog [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  tupleType typeContext types.compositeElts =:: elts
  sb
    0 while ..dup elts .length < do =:: i
      elts i types.compositeElts.get =:: eltType
      eltType context toValType =:: eltValType
      tupleType i pos context tupleEltOffsetInt =:: eltOffset
      eltType typeContext types.isEmpty if
        i 1 - continue
      end
      "%t" sb.appendS
        context nextTmpId =:: eltPtrId
      eltPtrId sb.appendI
      " =l add %s" sb.appendS
      tupleId sb.appendI
      ", " sb.appendS
      eltOffset sb.appendI
      '\n' sb.appendC
      eltValType context pushValue =:: eltId
      "%s" sb.appendS
      eltId sb.appendI
      eltType context referenceOnly if
        eltType pos context false appendAlloc ..drop
        "blit %t" sb.appendS
      else
        " =" sb.appendS
        eltValType sb.appendValTypeQBE
        " load" sb.appendS
        eltType StorageType .LOAD pos context sb.appendTypeNameQBE
        " %t" sb.appendS
      end
      eltPtrId sb.appendI
      eltType context referenceOnly if
        ", %s" sb.appendS
        eltId
        sb.appendI
        ',' sb.appendC
        eltType pos context typeSizeInt sb.appendI
      end
      '\n' sb.appendC
      i 1 +
    end ..drop
  return
end
proc(
  stringBuilder : sb
  Type : tupleType
  i64 : dataPtrId
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: initializeTupleQBE
  context [] .program =:: prog
  prog [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  tupleType typeContext types.compositeElts =:: elts
  sb
    elts .length 1 - while ..dup 0 >= do =:: i
      elts i types.compositeElts.get =:: eltType
      tupleType i pos context tupleEltOffsetInt =:: eltOffset
      eltType typeContext types.isEmpty if
        i 1 - continue
      end
      "%t" sb.appendS
        context nextTmpId =:: eltPtrId
      eltPtrId sb.appendI
      " =l add %t" sb.appendS
      dataPtrId sb.appendI
      ", " sb.appendS
      eltOffset sb.appendI
      '\n' sb.appendC
      eltType context referenceOnly if
        "blit %s" sb.appendS
      else
        "store" sb.appendS
        eltType StorageType .STORE pos context sb.appendTypeNameQBE
        " %s" sb.appendS
      end
      pos context popValue sb.appendI
      ", %t" sb.appendS
      eltPtrId sb.appendI
      eltType context referenceOnly if
        ',' sb.appendC
        eltType pos context typeSizeInt sb.appendI
      end
      '\n' sb.appendC
      i 1 -
    end ..drop
  return
end
proc(
  stringBuilder : sb
  Type : valType
  FilePosition : pos
  CompilerContext ptr mut : context
  bool : createId
-> stringBuilder i64 ) =>: appendAlloc
  context [] .program =:: prog
  prog [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  -1:i64 =:: mut: tmpId
  sb
    createId if
      context nextTmpId tmpId =
      "%t" sb.appendS
      tmpId sb.appendI
    end
    " =l alloc" sb.appendS
    valType pos context typeAlignmentInt 4 i64.max sb.appendI
    ' ' sb.appendC
    valType pos context typeSizeInt  4 i64.max sb.appendI
    '\n' sb.appendC
  tmpId return
end

proc( ConstValue : label -> i64 ) =>: labelAsInt
  label .int ?? if
    label .int return
  end
  label .chr ?? if
    label .chr return
  end
  label .enumLabel ?? if
    label .enumLabel return
  end
  ..unreachable
end
proc(
  stringBuilder : sb
  ValType : valType
  i64 : valId
  i32 : switchId
  LabelData arrayView : labels
  i64 optional : lower
  i64 optional : upper
  CompilerContext ptr mut : context
-> stringBuilder ) =>: appendSwitchJumpTree
  labels .length 3 <= if
    false =:: mut: contiguous
    labels .length =:: mut: loopCount
    lower optional.hasData if upper optional.hasData _if
        upper .data lower .data - labels .length == contiguous =
        contiguous _if
      loopCount 1 - loopCount =
    end
    sb
      0 while ..dup loopCount < do =:: i
        ## BranchId
          BranchType .CASE
          switchId
          labels i array.at .data [] .caseId
        BranchId new =:: caseBranch
        ## BranchId
          BranchType .NEXT
          context nextJumpLabelId
          0
        BranchId new =:: nextBranch
        labels i array.get .value labelAsInt =:: cmpVal
        ## cmp int
          valType
          't' valId
          "eq" string.wrap
          cmpVal IntValue .constant
          caseBranch
          nextBranch
        context appendCmpInt
        nextBranch sb.appendBranchId
        '\n' sb.appendC
        i 1 +
      end ..drop
      "jmp " sb.appendS
      contiguous if
        ## BranchId
          BranchType .CASE
          switchId
          labels loopCount array.at .data [] .caseId
        BranchId new sb.appendBranchId
        '\n' sb.appendC
      else
        ## BranchId
          BranchType .DEFAULT
          switchId
          0
        BranchId new sb.appendBranchId
        '\n' sb.appendC
      end
    return
  end
  labels .length 2 / =:: p
  ## BranchId
    BranchType .NEXT
    context nextJumpLabelId
    0
  BranchId new =:: ltBranch
  ## BranchId
    BranchType .NEXT
    context nextJumpLabelId
    0
  BranchId new =:: geBranch
  labels p array.get .value labelAsInt =:: cmpVal
  labels p array.cutIndex =:: lElts =:: rElts
  sb
    ## cmp int
      valType
      't' valId
      "slt" string.wrap
      cmpVal IntValue .constant
      ltBranch
      geBranch
    context appendCmpInt
    ltBranch sb.appendBranchId
    '\n' sb.appendC
    ## appendSwitchJumpTree
      valType
      valId
      switchId
      lElts
      lower
      upper optional.isEmpty if
        cmpVal optional.wrap
      else
        upper .data cmpVal i64.min optional.wrap
      end
      context
    appendSwitchJumpTree
    geBranch sb.appendBranchId
    '\n' sb.appendC
    ## appendSwitchJumpTree
      valType
      valId
      switchId
      rElts
      lower optional.isEmpty if
        cmpVal optional.wrap
      else
        lower .data cmpVal i64.max optional.wrap
      end
      upper
      context
    appendSwitchJumpTree
  return
end
proc(
  LabelData : a
  LabelData : b
  CompilerContext ptr mut : context
-> i32 ) =>: labelCmp
  a .value labelAsInt =:: aInt
  b .value labelAsInt =:: bInt
  aInt bInt == if
    0 return
  end
  aInt bInt < if -1 else 1 end return
end
proc(
  stringBuilder : sb
  Type : switchType
  i64 : valId
  i32 : switchId
  LabelData list : labels
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: appendSwitchTable
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  ValType : valType
  i64 : tmpId
  labels labelCmp @ context list.sort
  sb
    "## switch\n" sb.appendS
    switchType typeContext types.isEnum if
      ## loadEnumLabel
        switchType
        valId
        pos
      context loadEnumLabel valType = tmpId =
    else switchType typeContext types.isInt _if
      switchType
        typeContext types.primitiveValue
      types.sizeOfPrimitive =:: numBytes
      context nextTmpId tmpId =
      switchType context toValType valType =
      "%t" sb.appendS
      tmpId sb.appendI
      " =" sb.appendS
      valType sb.appendValTypeQBE
      numBytes 4 < if
        " ext" sb.appendS
        switchType
          StorageType .ULOAD
        pos context sb.appendTypeNameQBE
        " %s" sb.appendS
      else
        " copy %s" sb.appendS
      end
      valId sb.appendI
      '\n' sb.appendC
    else
      "unsupported type in switch: " sb.wrap
        switchType typeContext sb.appendType
      pos errors appendError
      return
    end
    ## appendJumpTable
      valType
      tmpId
      switchId
      labels list.asArray
      i64 optional.empty
      i64 optional.empty
      context
    appendSwitchJumpTree
  return
end

proc(
  stringBuilder : sb
  string : name
  ValType : valType
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: appendUnaryOperator
  pos context popValue =:: arg
  sb
    "%s" sb.appendS
    valType context pushValue sb.appendI
    " =" sb.appendS
    valType sb.appendValTypeQBE
    ' ' sb.appendC
    name sb.appendStr
    " %s" sb.appendS
    arg sb.appendI
    '\n' sb.appendC
  return
end
proc(
  stringBuilder : sb
  string : name
  ValType : valType
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: appendBinaryOperator
  pos context popValue =:: arg2
  pos context popValue =:: arg1
  sb
    "%s" sb.appendS
    valType context pushValue sb.appendI
    " =" sb.appendS
    valType sb.appendValTypeQBE
    ' ' sb.appendC
    name sb.appendStr
    " %s" sb.appendS
    arg1 sb.appendI
    ", %s" sb.appendS
    arg2 sb.appendI
    '\n' sb.appendC
  return
end
proc(
  stringBuilder : sb
  string : cmpType
  ValType : valType
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: appendComparisonOperator
  pos context popValue =:: arg2
  pos context popValue =:: arg1
  sb
    "%s" sb.appendS
    ValType .I32 context pushValue sb.appendI
    " =w c" sb.appendS
    cmpType sb.appendStr
    valType sb.appendValTypeQBE
    " %s" sb.appendS
    arg1 sb.appendI
    ", %s" sb.appendS
    arg2 sb.appendI
    '\n' sb.appendC
  return
end
proc(
  stringBuilder : sb
  Type : src
  bool : signed
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: extendArguments
  i64 2 array new =:: mut: args
  context [] .program =:: prog
  prog [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  src typeContext types.unwrapNamed .cType ?? if
    sb
      src typeContext types.unwrapNamed .cType types.cTypeAsType
      signed
      pos
      context
    extendArguments return
  end
  src typeContext types.isInt ! if
    sb return
  end
  src typeContext types.primitiveValue types.sizeOfPrimitive 4 >= if
    sb return
  end
  pos context popValue args @ 1 [] =
  pos context popValue args @ 0 [] =
  sb
    0 while ..dup 2 < do =:: i
      "%s" sb.appendS
      ValType .I32 context pushValue sb.appendI
      " =w ext" sb.appendS
      signed if 's' else 'u' end sb.appendC
      src StorageType .STORE pos context sb.appendTypeNameQBE
      " %s" sb.appendS
      args @ i [] sb.appendI
      '\n' sb.appendC
      i 1 +
    end ..drop
  return
end

proc(
  stringBuilder : sb
  BuiltIn : builtIn
  Type : opType
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: appendBuiltInQBE
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  opType typeContext types.getProcIn ..drop =:: inType
  inType 0 typeContext types.compositeGetLabel
      labelContext id.labelFlags id.FLAG_STATIC & ? if
    1
  else
    0
  end =:: firstArg
  inType firstArg typeContext types.compositeGetElement =:: baseType
  baseType context toValType =:: baseVal
  builtIn switch
    NEG_I8 NEG_I16 NEG_I32 NEG_I64 NEG_F32 NEG_F64 case
      sb "neg" string.wrap baseVal pos context appendUnaryOperator
      return
    ADD_I8 ADD_I16 ADD_I32 ADD_I64 ADD_F32 ADD_F64 case
      sb "add" string.wrap baseVal pos context appendBinaryOperator
      return
    ADD_PTR ADD_PTR_MUT SUB_PTR SUB_PTR_MUT case
      baseType typeContext types.getBaseType =:: valueType
      pos context popValue =:: offsetId
      sb
        ## correctly scale offset
        "%s" sb.appendS
        ValType .I64 context pushValue sb.appendI
        " =l mul %s" sb.appendS
        offsetId sb.appendI
        ", " sb.appendS
        valueType pos context typeSizeInt sb.appendI
        '\n' sb.appendC
        builtIn .SUB_PTR ?? builtIn .SUB_PTR_MUT ?? | if
         "sub" string.wrap
        else
         "add" string.wrap
        end ValType .PTR pos context appendBinaryOperator
      return
    SUB_I8 SUB_I16 SUB_I32 SUB_I64 SUB_F32 SUB_F64 case
      sb "sub" string.wrap baseVal pos context appendBinaryOperator
      return
    PTR_DIFF case
      baseType typeContext types.getBaseType =:: valueType
      sb
        "sub" string.wrap baseVal pos context appendBinaryOperator
        pos context popValue =:: resId
        ## correctly scale offset
        "%s" sb.appendS
        ValType .I64 context pushValue sb.appendI
        " =l udiv %s" sb.appendS
        resId sb.appendI
        ", " sb.appendS
        valueType pos context typeSizeInt sb.appendI
        '\n' sb.appendC
      return
    MUL_I32 MUL_I64 MUL_F32 MUL_F64 case
      sb "mul" string.wrap baseVal pos context appendBinaryOperator
      return
    DIV_I32 DIV_I64 DIV_F32 DIV_F64 case
      sb "div" string.wrap baseVal pos context appendBinaryOperator
      return
    REM_I32 REM_I64 case
      sb "rem" string.wrap baseVal pos context appendBinaryOperator
      return
    UDIV_I32 UDIV_I64 case
      sb "udiv" string.wrap baseVal pos context appendBinaryOperator
      return
    UMOD_I32 UMOD_I64 case
      sb "urem" string.wrap baseVal pos context appendBinaryOperator
      return
    NOT_BOOL case
      pos context popValue =:: arg
      sb
        "%s" sb.appendS
        baseVal context pushValue sb.appendI
        " =w extub %s" sb.appendS
        arg sb.appendI
        '\n' sb.appendC
        "ceqw 0," string.wrap baseVal pos context appendUnaryOperator
      return
    FLIP_I8 FLIP_I16 FLIP_I32 FLIP_I64 case
      sb
        "xor -1," string.wrap baseVal pos context appendUnaryOperator
      return
    AND_BOOL AND_I8 AND_I16 AND_I32 AND_I64 case
      sb "and" string.wrap baseVal pos context appendBinaryOperator
      return
    OR_BOOL  OR_I8 OR_I16 OR_I32 OR_I64 case
      sb "or" string.wrap baseVal pos context appendBinaryOperator
      return
    XOR_BOOL XOR_I8 XOR_I16 XOR_I32 XOR_I64 case
      sb "xor" string.wrap baseVal pos context appendBinaryOperator
      return
    LSHR_I8 LSHR_I16 LSHR_I32 LSHR_I64 case
      sb
        baseType false pos context extendArguments
        "shr" string.wrap baseVal pos context appendBinaryOperator
      return
    ASHR_I8 ASHR_I16 ASHR_I32 ASHR_I64 case
      sb
        baseType true pos context extendArguments
        "sar" string.wrap baseVal pos context appendBinaryOperator
      return
    SHL_I8 SHL_I16 SHL_I32 SHL_I64 case
      sb "shl" string.wrap baseVal pos context appendBinaryOperator
      return
    BOOL_I8 BOOL_I16 BOOL_I32 BOOL_I64 BOOL_F32 BOOL_F64 case
      sb
        "%s" sb.appendS
        baseVal context pushValue sb.appendI
        " =" sb.appendS
        baseVal sb.appendValTypeQBE
        " copy 0\n" sb.appendS
        baseType false pos context extendArguments
        "ne" string.wrap baseVal pos context appendComparisonOperator
      return
    LT_I8 LT_I16 LT_I32 LT_I64 LT_PTR case
      sb
        baseType true pos context extendArguments
        "slt" string.wrap baseVal pos context appendComparisonOperator
      return
    LE_I8 LE_I16 LE_I32 LE_I64 LE_PTR case
      sb
        baseType true pos context extendArguments
        "sle" string.wrap baseVal pos context appendComparisonOperator
      return
    GE_I8 GE_I16 GE_I32 GE_I64 GE_PTR case
      sb
        baseType true pos context extendArguments
        "sge" string.wrap baseVal pos context appendComparisonOperator
      return
    GT_I8 GT_I16 GT_I32 GT_I64 GT_PTR  case
      sb
        baseType true pos context extendArguments
        "sgt" string.wrap baseVal pos context appendComparisonOperator
      return
    LT_F32 LT_F64 case
      sb
        baseType true pos context extendArguments
        "lt" string.wrap baseVal pos context appendComparisonOperator
      return
    LE_F32 LE_F64 case
      sb
        baseType true pos context extendArguments
        "le" string.wrap baseVal pos context appendComparisonOperator
      return
    GE_F32 GE_F64 case
      sb
        baseType true pos context extendArguments
        "ge" string.wrap baseVal pos context appendComparisonOperator
      return
    GT_F32 GT_F64  case
      sb
        baseType true pos context extendArguments
        "gt" string.wrap baseVal pos context appendComparisonOperator
      return
    ULT_I8 ULT_I16 ULT_I32 ULT_I64 case
      sb
        baseType false pos context extendArguments
        "ult" string.wrap baseVal pos context appendComparisonOperator
      return
    ULE_I8 ULE_I16 ULE_I32 ULE_I64 case
      sb
        baseType false pos context extendArguments
        "ule" string.wrap baseVal pos context appendComparisonOperator
      return
    UGE_I8 UGE_I16 UGE_I32 UGE_I64 case
      sb
        baseType false pos context extendArguments
        "uge" string.wrap baseVal pos context appendComparisonOperator
      return
    UGT_I8 UGT_I16 UGT_I32 UGT_I64 case
      sb
        baseType false pos context extendArguments
        "ugt" string.wrap baseVal pos context appendComparisonOperator
      return
  end
end

proc(
  stringBuilder : sb
  Type : src
  i64 : srcIndex
  Type : target
  i64 : targetIndex
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: castNumbers
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  src typeContext types.primitiveValue =:: fromVal
  target typeContext types.primitiveValue =:: toVal
  sb
    ## common prefix
    "%s" sb.appendS
    targetIndex sb.appendI
    ## case 0: identical types
    fromVal toVal == if
      ## copy necessary to update value id
      " =" sb.appendS
      target StorageType .STACK pos context sb.appendTypeNameQBE
      " copy" sb.appendS
    ## case 1: integer extension/narrowing
    else src typeContext types.isInt target typeContext types.isInt & _if
      src typeContext types.primitiveValue types.sizeOfPrimitive =:: srcPrec
      target typeContext types.primitiveValue types.sizeOfPrimitive =:: targetPrec
      targetPrec srcPrec <= if
        " =" sb.appendS
        target StorageType .STACK pos context sb.appendTypeNameQBE
        " copy" sb.appendS
      else
        " =" sb.appendS
        target StorageType .STACK pos context sb.appendTypeNameQBE
        " ext" sb.appendS
        src typeContext types.isUnsignedInt if ## u -> i,s,u
          'u' sb.appendC
        else src typeContext types.isSignedInt ! _if ## i -> u
            target typeContext types.isUnsignedInt _if
          'u' sb.appendC
        else ## s -> i,s,u / i -> i,s
          's' sb.appendC
        end
        fromVal switch
          I8  S8  U8 case "b" sb.appendS break
          I16 S16 U16 case "h" sb.appendS break
          I32 S32 U32 case "w" sb.appendS break
          I64 S64 U64 case "l" sb.appendS break
          BOOL TYPE F32 F64 case ..unreachable
        end
      end
    ## case 2: float -> float/int
    else fromVal .F32 ?? fromVal .F64 ?? | _if
      toVal switch ## TODO handle overflow in float->int conversion
        F32 case
          " =s truncd" sb.appendS break
        F64 case
          " =d exts" sb.appendS break
        I8 I16 I32 I64 S8 S16 S32 S64 case
          " =" sb.appendS
          target StorageType .STACK pos context sb.appendTypeNameQBE
          fromVal .F32 ?? if
            " stosi" sb.appendS
          else
            " dtosi" sb.appendS
          end
          break
        U8 U16 U32 U64 case
          " =" sb.appendS
          target StorageType .STACK pos context sb.appendTypeNameQBE
          fromVal .F32 ?? if
            " stoui" sb.appendS
          else
            " dtoui" sb.appendS
          end
          break
        BOOL TYPE case ..unreachable
      end
    ## case 3: int -> float
    else ## TODO sign/zero extend 8&16 bit types before conversion
      " =" sb.appendS
      target StorageType .STACK pos context sb.appendTypeNameQBE
      fromVal switch
        I64 S16 case " sltof" sb.appendS break
        U64 case " ultof" sb.appendS break
        I8 I16 I32 S8 S32 S64 case " swtof" sb.appendS break
        U8 U16 U32 case " uwtof" sb.appendS break
        BOOL TYPE F32 F64 case ..unreachable
      end
    end
    " %s" sb.appendS
    srcIndex sb.appendI
    '\n' sb.appendC
  return
end


struct( i8 : varType i64 : varId ) =:: StackVal
namespace: sb
  proc(
    stringBuilder : sb
    StackVal : val
  -> stringBuilder ) =>: appendStackVal
    sb
      '%' sb.appendC
      val .varType sb.appendC
      val .varId sb.appendI
    return
  end
end
proc(
  stringBuilder : sb
  Type : src
  i64 : srcIndex
  Type : target
  i64 : targetIndex
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: bitcastNumbers
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  src typeContext types.primitiveValue =:: fromVal
  target typeContext types.primitiveValue =:: toVal
  ## sizes of arguments scaled to bits
  fromVal types.sizeOfPrimitive 8 * =:: fromSize
  toVal types.sizeOfPrimitive 8 * =:: toSize
  fromVal toVal == if
    sb
      "%s" sb.appendS
      targetIndex sb.appendI
      ## copy necessary to update value id
      " =" sb.appendS
      target StorageType .STACK pos context sb.appendTypeNameQBE
      " copy %s" sb.appendS
      srcIndex sb.appendI
      '\n' sb.appendC
    return
  end
  's' srcIndex StackVal new =:: mut: current
  's' targetIndex StackVal new =:: mut: last
  last =:: mut: next
  0 =:: mut: nSteps
  src typeContext types.isFloat if nSteps 1 + nSteps = end
  fromSize toSize != if
    nSteps 1 + nSteps =
  end
  target typeContext types.isFloat if nSteps 1 + nSteps = end
  nSteps 0 > assert "bit-cast casts non-equal types"
  nSteps 1 > if
    't' context nextTmpId StackVal new next =
  end
  sb
    ## 1. convert floats to int
    src typeContext types.isFloat if
      next sb.appendStackVal
      " =" sb.appendS
      fromSize 32 <= if 'w' else 'l' end sb.appendC
      " cast " sb.appendS
      current sb.appendStackVal
      '\n' sb.appendC
      nSteps 1 - nSteps =
      next current =
      nSteps 1 > if 't' context nextTmpId StackVal new else last end next =
    end
    ## 2. zero-extend small values to correct size
    fromSize toSize != if
      next sb.appendStackVal
      " =" sb.appendS
      toSize 32 <= if 'w' else 'l' end sb.appendC
      fromSize toSize < if
        ## TODO? use same sign rules as cast, now that zero extend is supported for normal cast
        fromVal switch
          BOOL TYPE F32 F64 case break
          I8  S8  U8  case " extub" sb.appendS break
          I16 S16 U16 case " extuh" sb.appendS break
          I32 S32 U32 case " extuw" sb.appendS break
          I64 S64 U64 case " extul" sb.appendS break
        end
      else
        ## copy to smaller type truncates
        " copy " sb.appendS
      end
      current sb.appendStackVal
      '\n' sb.appendC
      nSteps 1 - nSteps =
      next current =
      nSteps 1 > if 't' context nextTmpId StackVal new else last end next =
    end
    ## 3. convert int to float
    target typeContext types.isFloat if
      next sb.appendStackVal
      " =" sb.appendS
      toSize 32 == if 's' else 'd' end sb.appendC
      " cast " sb.appendS
      current sb.appendStackVal
      '\n' sb.appendC
      nSteps 1 - nSteps =
    end
    nSteps 0 == assert "correct step estimate in bit-cast"
  return
end

enum( autoCast Cast Cast! bitCast ) =:: CastType

proc(
  stringBuilder : sb
  CastType : castType
  Type : src0
  i32 : offset
  Type : target0
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: compileCast
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  ## XXX? better cType <-> type conversion
  src0 typeContext types.unwrapNamed
    ..dup .cType ?? if .cType types.cTypeAsType end
  =:: src
  target0 typeContext types.unwrapNamed
    ..dup .cType ?? if .cType types.cTypeAsType end
  =:: target
  src target types.typeEquals if
    sb return ## nothing to do
  end
  castType .autoCast ?? if
    offset context [] .stackInfo branchTree.depth >= if
      "stack underflow" sb.wrap
      pos errors appendError
      sb return
    end
    context [] .stackInfo @ offset branchTree.at .data [] .valType
    context [] .stackInfo @ offset branchTree.at .data [] .varId
  else
    context [] .stackInfo @ offset branchTree.at .data [] .valType
    pos context popValue
  end =:: srcId =:: valType
  castType .autoCast ?? if
    target context toValType offset context replaceValue
  else
    target context toValType context pushValue
  end =:: targetId
  ## TODO? different behavior for bit-casts
  src typeContext types.isNumber target .arrayIndex ?? & if
    ## isNumber returns true for array index
    ##   -> have to check for cast to array index before checking for cast to number
    sb
      ## castNumbers
        src srcId
        types.primitive.I_SIZE targetId
      pos context  castType .bitCast ?? if bitcastNumbers else castNumbers end
      target typeContext types.getArraySize 0 array.get =:: size
      ## appendIndexCheck
        size .sizeType switch
          int case size .value IntValue .constant break
          staticArg case size .value IntValue .localId break
          templateArg case ..unreachable
        end
        targetId
        pos
      context appendIndexCheck
    return
  end
  src typeContext types.isNumber target typeContext types.isNumber & if
    sb
      src srcId
      target targetId
    pos context  castType .bitCast ?? if bitcastNumbers else castNumbers end
    return
  end
  src typeContext types.isPointer target typeContext types.isPointer & if
    sb
      "%s" sb.appendS
      targetId sb.appendI
      " =l copy %s" sb.appendS
      srcId sb.appendI
      '\n' sb.appendC
    return ## both are pointer types
  end
  src typeContext types.isInt target typeContext types.isPointer & if
    ## src -> I_PTR ~ ptr
    sb
      ## castNumbers
        src srcId
        types.primitive.I_PTR targetId
      pos context  castType .bitCast ?? if bitcastNumbers else castNumbers end
    return
  end
  src typeContext types.isPointer target typeContext types.isInt & if
    ## ptr ~ I_PTR -> target
    sb
      ## castNumbers
        types.primitive.I_PTR srcId
        target targetId
      pos context  castType .bitCast ?? if bitcastNumbers else castNumbers end
    return
  end
  src typeContext types.isReference if target typeContext types.isReference ! _if
    src typeContext types.getBaseType typeContext types.unwrapNamed =:: baseType
    sb
      "%s" sb.appendS
      targetId sb.appendI
      " =" sb.appendS
      baseType StorageType .STACK pos context sb.appendTypeNameQBE
      baseType context referenceOnly ! if valType .REFERENCE ?? _if ## unwrap reference
        " load" sb.appendS
        baseType StorageType .LOAD pos context sb.appendTypeNameQBE
      else
        " copy" sb.appendS
      end
      " %s" sb.appendS
      srcId sb.appendI
      '\n' sb.appendC
      ## cast value
      baseType target types.typeEquals ! if
        ## compileCast
          castType
          baseType
          offset
          target
          pos
          context
        compileCast
      end
    return
  end
  target typeContext types.isUnion if
    ## TODO check if source is subset of union
    sb
      "%s" sb.appendS
      targetId sb.appendI
      target pos context false appendAlloc ..drop
      src context referenceOnly if
        "blit %s" sb.appendS
      else
        "store" sb.appendS
        src StorageType .STORE pos context sb.appendTypeNameQBE
        " %s" sb.appendS
      end
      srcId sb.appendI
      ", %s" sb.appendS
      targetId sb.appendI
      src context referenceOnly if
        ", " sb.appendS
        src pos context typeSizeInt sb.appendI
      end
      '\n' sb.appendC
    return
  end
  "casting from " sb.wrap
    src typeContext sb.appendType
    " to " sb.appendS
    target typeContext sb.appendType
    " is not implemented" sb.appendS
  pos errors appendError
  sb return
end

proc(
  stringBuilder : sb
  Type : constType
  ConstValue : value
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: pushConstant
  context [] .program =:: prog
  prog [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  false =:: mut: needCast
  constType =:: mut: srcType
  value .genericArg ?? if
    context [] .currentProc
      typeContext types.getProcIn ! assert "procedure has arguments"
    =:: progIn
    progIn
      value .genericArg
      typeContext
    types.compositeFindLabel =:: index
    index id.LABEL_ID_NONE != if
      progIn index typeContext types.compositeGetElement srcType =
      srcType typeContext types.unwrapNamed
        constType typeContext types.unwrapNamed
      types.typeEquals ! needCast =
    end
  end
  i64 : valId
  sb
    pos sb.appendPosQBE
    "%s" sb.appendS
    srcType context referenceOnly ! if
      srcType context toValType context pushValue sb.appendI
      " =" sb.appendS
      srcType StorageType .STACK pos context sb.appendTypeNameQBE
      " copy " sb.appendS
    else
      ValType .REFERENCE context pushValue sb.appendI
      " =l copy " sb.appendS
    end
    srcType value false pos context sb.appendConstQBE
    '\n' sb.appendC
    needCast if
      ## compileCast
        CastType .autoCast
        srcType
        0
        constType
        pos
        context
      compileCast
    end
  return
end

proc(
  stringBuilder : sb
  Type : calledType
  TypedValId list ptr mut : argIndices
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: prepareCall
  context [] .program =:: prog
  prog [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  calledType typeContext types.getProcOutArgs
    ! assert "calledType has arguments"
  =:: outArgs
  calledType typeContext types.getProcRet
    ! assert "calledType has return value"
  =:: retType
  sb =:: mut: newSb
  ## allocate output arguments
  0 while ..dup outArgs .length < do =:: i
    outArgs i array.get =:: outArg
    ValType .REFERENCE context pushValue =:: argId
    newSb
      "%s" sb.appendS
      argId sb.appendI
      outArg pos context false appendAlloc ..drop
    newSb =
    argIndices []
      outArg argId TypedValId new list.append
    argIndices [] =
    i 1 +
  end ..drop
  newSb
    retType typeContext types.isEmpty ! if
      retType context toValType context pushValue =:: retId
      "%s" sb.appendS
      retId sb.appendI
      " =" sb.appendS
      retType StorageType .LOAD pos context sb.appendTypeNameQBE
      ' ' sb.appendC
    end
    "call " sb.appendS
  return
end
proc(
  stringBuilder : sb
  Type : calledType
  TypedValId list ptr mut : argIndices
  i64 : outArgsOffset
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: finishCall
  context [] .program =:: prog
  prog [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  calledType typeContext types.getProcOutArgs
    ! assert "calledType has out-arguments"
  =:: outArgs
  calledType typeContext types.getProcRet
    ! assert "calledType has return value"
  =:: retType
  sb
    " (" sb.appendS
    0 while ..dup argIndices [] .length < do =:: i
      argIndices [] i list.at .data =:: arg
      i 0 > if
        ',' sb.appendC
      end
      i outArgsOffset < if
        arg [] .valType
          StorageType .LOAD
          pos
          context
        sb.appendTypeNameQBE
      else
        'l' sb.appendC
      end
      " %s" sb.appendS
      arg [] .valId sb.appendI
      i 1 +
    end ..drop
    ")\n" sb.appendS
    retType typeContext types.isProcOut if
      ## flattenTupleQBE
        retType
        pos context popValue
        pos
      context flattenTupleQBE
    end
    0 while ..dup outArgs .length < do =:: i
      argIndices []
        i outArgsOffset +
      list.at .data [] .valType =:: outArg
      outArg context referenceOnly if
        i 1 + continue
      end
      ## compileCast
        CastType .autoCast
        outArg
          false
          typeContext
        types.newReferenceType
        ## (len-1-i) +1 for return value
        outArgs .length i - i32 cast
        outArg
        pos
        context
      compileCast
      i 1 +
    end ..drop
    argIndices [] list.free argIndices [] =
  return
end

proc(
  stringBuilder : sb
  Operation ptr : op
  CompilerContext ptr mut : context
-> stringBuilder ) =>: compileOp
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  op [] .val switch
    NOP case
      sb return
    Constant case
      sb
        op [] .dataType
        op [] .val .Constant
        op [] .pos
        context
      pushConstant
      return
    declareId initializeId case
      op [] .val .declareId ?? if
        op [] .val .declareId
      else
        op [] .val .initializeId
      end =:: idInfo
      op [] .val .initializeId ?? =:: assignValue
      idInfo .labelId labelContext id.labelFlags =:: labelFlags
      labelFlags id.FLAG_MUTABLE & ? =:: mutable
      idInfo .idType switch
        PROCEDURE case
          assignValue ! if
            sb return ## ignore procedure declarations
          end
          break
        LOCAL_VAR TMP_VAR case
          op [] .dataType =:: valType
          ## use pointers as stack representation of arrays and composites
          valType context referenceOnly ! =:: isValue
          sb
            op [] .pos sb.appendPosQBE
            idInfo .idType .LOCAL_VAR ?? if
              "%l" sb.appendS
              idInfo .labelId sb.appendI
            else
              "%tmp" sb.appendS
              idInfo .id sb.appendI
            end
            valType op [] .pos context false appendAlloc ..drop
            assignValue if
              isValue if
                "store" sb.appendS
                valType StorageType .STORE op [] .pos context sb.appendTypeNameQBE
              else
                "blit" sb.appendS ## XXX call memcopy for large structs
              end
              " %s" sb.appendS
              op [] .pos context popValue sb.appendI
              ',' sb.appendC
              idInfo .idType .LOCAL_VAR ?? if
                "%l" sb.appendS
                idInfo .labelId sb.appendI
              else
                "%tmp" sb.appendS
                idInfo .id sb.appendI
              end
              isValue ! if
                ',' sb.appendC
                op [] .dataType op [] .pos context typeSizeInt sb.appendI
              end
              '\n' sb.appendC
            end
          return
        GLOBAL_VAR TYPE ARGUMENT TEMPLATE_ARG LABEL PROCEDURE_BUNDLE case
          break ## XXX error message
      end
      break
    implementProcedure case
      op [] .val .implementProcedure =:: implInfo
      prog [] .procedures
        implInfo .procId list.at .data
      =:: procInfo
      op [] .dataType context [] .currentProc =
      procInfo [] .labelId labelContext id.labelFlags =:: labelFlags
      ## reset stack-info in context
      0 context [] .stackCount =
      0 context [] .tmpCount =
      0 context [] .jumpLabelCount =
      context [] .stackInfo @ branchTree.clear
      sb
        implInfo .implementationId  0 < if
          labelFlags id.FLAG_EXPORT & ? labelFlags id.FLAG_EXTERN & ? | _if
          "export " sb.appendS
        end
        "function " sb.appendS
        op [] .dataType typeContext types.getProcRet if ..drop
          "wrong type for procedure initialization: " sb.wrap
            op [] .dataType typeContext sb.appendType
            " expected procedure" sb.appendS
          op [] .pos errors appendError
          return
        end =:: retType
        retType typeContext types.isEmpty ! if
          retType StorageType .LOAD op [] .pos context sb.appendTypeNameQBE
          ' ' sb.appendC
        end
        procInfo [] .labelId implInfo .implementationId context sb.appendGlobalName
        op [] .dataType op [] .pos context sb.appendProcSignature
        "{\n" sb.appendS
        ## BranchId
          BranchType .START
          0 0
        BranchId new context startBranch
        ## push unnamed arguments
        op [] .dataType typeContext types.getProcIn ..drop =:: inType
        inType typeContext types.compositeElts =:: args
        0 while ..dup args .length < do =:: i
          inType i typeContext types.compositeGetLabel =:: label
          args i types.compositeElts.get =:: argType
          argType typeContext types.isEmpty if
            i 1 + continue ## skip empty arguments
          end
          label id.LABEL_ID_NONE == if ## push argument
            argType context referenceOnly if
              ValType .REFERENCE
            else
              argType context toValType
            end =:: valType
            "%s" sb.appendS
            valType context pushValue sb.appendI
            " =" sb.appendS
            valType sb.appendValTypeQBE
            " copy " sb.appendS
            i id.LABEL_ID_NONE context sb.appendArgName
            '\n' sb.appendC
          end
          i 1 +
        end ..drop
        true context [] .reachable =
      return
    getId atId case
      op [] .val .getId ?? if
        op [] .val .getId
      else
        op [] .val .atId
      end =:: idInfo
      op [] .val .atId ?? =:: isAddr
      idInfo .idType switch
        PROCEDURE GLOBAL_VAR case
          idInfo .idType .PROCEDURE ?? if
            ## procedures are handled by call & procPtr instructions
            break
          end
          sb
            op [] .pos sb.appendPosQBE
            "%s" sb.appendS
            isAddr if ValType .PTR else ValType .REFERENCE end context pushValue sb.appendI
            " =l copy " sb.appendS
            idInfo .labelId -1 context sb.appendGlobalName
            "\n" sb.appendS
          return
        LOCAL_VAR case
          sb
            op [] .pos sb.appendPosQBE
            "%s" sb.appendS
            isAddr if ValType .PTR else ValType .REFERENCE end context pushValue sb.appendI
            " =l copy %l" sb.appendS
            idInfo .labelId sb.appendI
            '\n' sb.appendC
          return
        TMP_VAR case
          sb
            op [] .pos sb.appendPosQBE
            "%s" sb.appendS
            isAddr if ValType .PTR else ValType .REFERENCE end context pushValue sb.appendI
            " =l copy %tmp" sb.appendS
            idInfo .id sb.appendI
            '\n' sb.appendC
          return
       ARGUMENT case
          isAddr if op [] .dataType context referenceOnly ! _if
            "cannot take the address of procedure argument" sb.wrap
            op [] .pos errors appendError
            sb return
          end
          op [] .dataType context referenceOnly if
            ValType .REFERENCE
          else
            op [] .dataType context toValType
          end =:: valType
          sb
            op [] .pos sb.appendPosQBE
            "%s" sb.appendS
            valType context pushValue sb.appendI
            " =" sb.appendS
            valType sb.appendValTypeQBE
            " copy " sb.appendS
            idInfo .id idInfo .labelId context sb.appendArgName
            '\n' sb.appendC
          return
       TYPE TEMPLATE_ARG LABEL PROCEDURE_BUNDLE case
          break ## XXX error message
      end
      break
    procPtr case
      op [] .val .procPtr =:: procImpl
      prog [] .procedures
        procImpl .procId
      list.at .data =:: procData
      sb
        op [] .pos sb.appendPosQBE
        "%s" sb.appendS
        ValType .PTR context pushValue sb.appendI
        " =l copy " sb.appendS
        ## appendGlobalName
          procData [] .labelId
          procImpl .implementationId
        context sb.appendGlobalName
        "\n" sb.appendS
      return
    setValue case
      op [] .pos context popValue =:: targetId
      op [] .pos context popValue =:: valId
      op [] .dataType =:: valType
      sb
        op [] .pos sb.appendPosQBE
        valType context referenceOnly if
          "blit %s" sb.appendS
        else
          "store" sb.appendS
          valType StorageType .STORE op [] .pos context sb.appendTypeNameQBE
          " %s" sb.appendS
        end
        valId sb.appendI
        ", %s" sb.appendS
        targetId sb.appendI
        valType context referenceOnly if
          ',' sb.appendC
          valType op [] .pos context typeSizeInt sb.appendI
        end
        '\n' sb.appendC
      return
    getArrayElement atArrayElement case
      op [] .val .getArrayElement ?? if
        op [] .val .getArrayElement
      else
        op [] .val .atArrayElement
      end =:: mut: argCount
      op [] .val .atArrayElement ?? =:: isAddr
      op [] .dataType =:: mut: arrayType
      arrayType typeContext types.isPointer =:: mut: isPtr
      arrayType typeContext types.isReference if
        arrayType typeContext types.getBaseType arrayType =
        true isPtr =
      end
      arrayType typeContext types.getArraySize =:: sizes
      arrayType typeContext types.getBaseType =:: baseType
      sizes .length
        arrayType typeContext types.isFixedSize if 2 - else 1 - end
      =:: mut: sizeOffset
      context nextTmpId =:: mut: offsetId
      offsetId =:: mut: prevId
      sb
        op [] .pos sb.appendPosQBE
        "%t" sb.appendS
        offsetId sb.appendI
        argCount 0 == if
          " =l copy 0" sb.appendS
        else
          argCount 1 - argCount =
          " =l copy %s" sb.appendS
          op [] .pos context popValue sb.appendI
        end
        '\n' sb.appendC
        while sizeOffset 0 >= do
          sizes sizeOffset array.get =:: size
          sizeOffset 1 - sizeOffset =
          size .sizeType .int ?? ! if
            "unsupported size type for array element" sb.wrap
              size labelContext sb.appendArraySize
            op [] .pos errors appendError
          end
          offsetId prevId =
          context nextTmpId offsetId =
          "%t" sb.appendS
          offsetId sb.appendI
          " =l mul %t" sb.appendS
          prevId sb.appendI
          ", " sb.appendS
          size .value sb.appendI
          '\n' sb.appendC
          argCount 0 > if
            offsetId prevId =
            context nextTmpId offsetId =
            argCount 1 - argCount =
            "%t" sb.appendS
            offsetId sb.appendI
            " =l add %t" sb.appendS
            prevId sb.appendI
            ", %s" sb.appendS
            op [] .pos context popValue sb.appendI
            '\n' sb.appendC
          end
        end
        offsetId prevId =
        context nextTmpId offsetId =
        "%t" sb.appendS
        offsetId sb.appendI
        " =l mul %t" sb.appendS
        prevId sb.appendI
        ", " sb.appendS
        baseType op [] .pos context typeSizeInt sb.appendI
        " ## " sb.appendS
        baseType typeContext sb.appendType
        '\n' sb.appendC
        op [] .pos context popValue =:: srcId
        "%s" sb.appendS
        isAddr if ValType .PTR else ValType .REFERENCE end context pushValue sb.appendI
        " =l add %s" sb.appendS
        srcId sb.appendI
        ", %t" sb.appendS
        offsetId sb.appendI
        '\n' sb.appendC
      return
    getElement atElement case
      op [] .val .getElement ?? if
        op [] .val .getElement
      else
        op [] .val .atElement
      end =:: index
      op [] .val .atElement ?? =:: isAddr
      op [] .dataType =:: mut: containerType
      false =:: mut: isPtr
      containerType typeContext types.isPointer
          containerType typeContext types.isReference | if
        containerType typeContext types.getBaseType containerType =
        true isPtr =
      end
      containerType
        index
        typeContext
      types.compositeGetElement =:: eltType
      isAddr if
        ValType .PTR
      else isPtr _if
        ValType .REFERENCE
      else
        eltType context toValType
      end =:: valType
      containerType typeContext types.isTuple if
        op [] .pos context popValue =:: srcId
        sb
          op [] .pos sb.appendPosQBE
          "%s" sb.appendS
          valType context pushValue sb.appendI
          " =l add %s" sb.appendS
          srcId sb.appendI
          "," sb.appendS
          containerType index op [] .pos context tupleEltOffsetInt sb.appendI
          '\n' sb.appendC
      else containerType typeContext types.isUnion
          containerType typeContext types.isEnum | _if
        sb ## not change to pointer necessary
      else
        break ## unsupported type
      end
        isPtr ! if eltType context referenceOnly ! _if
          op [] .pos context popValue =:: srcId
          op [] .pos sb.appendPosQBE
          "%s" sb.appendS
          valType context pushValue sb.appendI
          " =" sb.appendS
          valType sb.appendValTypeQBE
          " load" sb.appendS
          eltType
            StorageType .LOAD
            op [] .pos
            context
          sb.appendTypeNameQBE
          " %s" sb.appendS
          srcId sb.appendI
          '\n' sb.appendC
        end
      return
    copy case
      op [] .dataType =:: srcType
      srcType typeContext types.isReference ! if
        break ## copy only implemented for references
      end
      srcType typeContext types.getBaseType =:: baseType
      baseType context referenceOnly ! if
        context [] .stackInfo @ branchTree.peek =:: srcVal?
        srcVal? optional.isEmpty if
          "stack underflow" sb.wrap
          op [] .pos errors appendError
          sb return
        end
        srcVal? .data =:: srcVal
        srcVal [] .valType .REFERENCE ?? ! if
          sb return ## value is not a reference -> no copy necessary
        end
        op [] .pos context popValue =:: srcId
        sb
          op [] .pos sb.appendPosQBE
          "%s" sb.appendS
          baseType context toValType context pushValue sb.appendI
          " =" sb.appendS
          baseType StorageType .STACK op [] .pos context sb.appendTypeNameQBE
          " load" sb.appendS
          baseType StorageType .LOAD op [] .pos context sb.appendTypeNameQBE
          " %s" sb.appendS
          srcId sb.appendI
          '\n' sb.appendC
        return
      end
      sb
        op [] .pos sb.appendPosQBE
        ## prepare memory
        baseType op [] .pos context true appendAlloc =:: dataPtrId
        "blit %s" sb.appendS
        op [] .pos context popValue sb.appendI
        ", %t" sb.appendS
        dataPtrId sb.appendI
        ", " sb.appendS
        baseType op [] .pos context typeSizeInt sb.appendI
        "\n%s" sb.appendS
        ValType .REFERENCE context pushValue sb.appendI
        " =l copy %t" sb.appendS
        dataPtrId sb.appendI
        '\n' sb.appendC
      return
    New newEnum case
      sb
        op [] .pos sb.appendPosQBE
        ## prepare memory
        op [] .dataType op [] .pos context true appendAlloc =:: dataPtrId
        op [] .val .newEnum ?? if ## TODO store enums without values as integer
          op [] .val .newEnum =:: index
          op [] .dataType index typeContext types.compositeGetElement =:: eltType
          ## storeEnumLabel
            op [] .dataType
            't'
            dataPtrId
            index
            op [] .pos
            context
          storeEnumLabel
          eltType typeContext types.isEmpty ! if
            eltType context referenceOnly if
              "blit %s" sb.appendS
            else
              "store" sb.appendS
              eltType StorageType .STORE op [] .pos context sb.appendTypeNameQBE
              " %s" sb.appendS
            end
            op [] .pos context popValue sb.appendI
            ", %t" sb.appendS
            dataPtrId sb.appendI
            eltType context referenceOnly if
              ',' sb.appendC
              eltType op [] .pos context typeSizeInt sb.appendI
            end
            '\n' sb.appendC
          end
        else op [] .dataType typeContext types.isTuple _if
          op [] .dataType dataPtrId op [] .pos context initializeTupleQBE
        else op [] .dataType typeContext types.isArray _if
          ## zero-initialize array
          "call $memset(l %t" sb.appendS
          dataPtrId sb.appendI
          ",w 0,l " sb.appendS
          op [] .dataType op [] .pos context typeSizeInt sb.appendI
          ")\n" sb.appendS
        else
          "unsupported type for new:" sb.wrap
            op [] .dataType
              typeContext
            sb.appendType
          op [] .pos errors appendError
          return
        end
        "%s" sb.appendS
        ValType .REFERENCE context pushValue sb.appendI
        " =l copy %t" sb.appendS
        dataPtrId sb.appendI
        '\n' sb.appendC
      return
    checkEnumLabel case
      context [] .stackInfo @ branchTree.peek =:: srcVal?
      srcVal? optional.isEmpty if
        "stack underflow" sb.wrap
        op [] .pos errors appendError
        sb return
      end
      sb
        op [] .pos sb.appendPosQBE
        ## appendEnumCheck
          op [] .dataType
          srcVal? .data [] .varId
          op [] .val .checkEnumLabel
          op [] .pos
          context
        appendEnumCheck
      return
    setEnumLabel case
      context [] .stackInfo @ branchTree.peek =:: srcVal?
      srcVal? optional.isEmpty if
        "stack underflow" sb.wrap
        op [] .pos errors appendError
        sb return
      end
      sb
        op [] .pos sb.appendPosQBE
        ## storeEnumLabel
          op [] .dataType
          's'
          srcVal? .data [] .varId
          op [] .val .setEnumLabel
          op [] .pos
          context
        storeEnumLabel
      return
    hasElement case
      op [] .dataType
        ..dup typeContext types.isReference if
           typeContext types.getBaseType
        end
      =:: containerType
      containerType typeContext types.isEnum ! if
        break
      end
      op [] .pos context popValue =:: srcId
      sb
        op [] .pos sb.appendPosQBE
        containerType srcId op [] .val .hasElement op [] .pos context checkEnumIndex ..drop.2 =:: c
        "%s" sb.appendS
        ValType .I32 context pushValue sb.appendI
        " =w copy %t" sb.appendS
        c sb.appendI
        '\n' sb.appendC
      return
    autoCast case
      sb
        op [] .pos sb.appendPosQBE
        CastType .autoCast
        op [] .val .autoCast .src
        op [] .val .autoCast .offset
        op [] .dataType
        op [] .pos
        context
      compileCast return
      break
    Cast Cast! bitCast case
      sb
        op [] .pos sb.appendPosQBE
        op [] .val .Cast ?? if
          CastType .Cast
          op [] .val .Cast
        else op [] .val .bitCast ?? _if
          CastType .bitCast
          op [] .val .bitCast
        else
          CastType .Cast!
          op [] .val .Cast!
        end
        0 ## no offset
        op [] .dataType
        op [] .pos
        context
      compileCast return
      break
    call case
      op [] .val .call @ =:: callInfo
      prog [] .procedures
        callInfo [] .procId list.at .data
      =:: procData
      callInfo [] .implementationId 0 >= if
        procData [] .implementation .code .implementations
          callInfo [] .implementationId list.at .data
        [] .procType
      else
        procData [] .procType
      end =:: calledType
      calledType typeContext types.getProcIn ..drop =:: inTypes
      calledType typeContext types.getProcOutArgs ..drop =:: outArgs
      calledType typeContext types.getProcRet ..drop =:: retType
      inTypes typeContext types.compositeEltCount =:: argCount
      argCount TypedValId list.create =:: mut: argIndices
      sb
        op [] .pos sb.appendPosQBE
      =:: mut: newSb
      ## index of current auto-argument
      0:i64 =:: mut: argIndex
      0 while ..dup argCount < do =:: i
        inTypes i typeContext types.compositeGetElement =:: arg
        inTypes i typeContext types.compositeGetLabel =:: argLabel
        arg typeContext types.isEmpty if
          i 1 + continue ## skip empty arguments
        end
        argLabel labelContext id.labelFlags id.FLAG_STATIC & ? if
          i 1 + continue ## skip static arguments
        end
        argLabel labelContext id.labelFlags id.FLAG_AUTO & ? if
          callInfo [] .autoArgs argIndex constContext constArrayGet =:: argVal
          argIndex 1 + argIndex =
          argVal .none ?? ! if
            newSb
              arg argVal op [] .pos context pushConstant
            newSb =
            argIndices
              arg op [] .pos context popValue TypedValId new list.append
            argIndices =
            i 1 + continue
          end
        end
        argIndices
          arg -1 TypedValId new list.append
        argIndices =
        i 1 +
      end ..drop
      argIndices .length argIndex =
      while argIndex 0 > do argIndex 1 - argIndex =
        argIndices argIndex list.at .data [] .valId 0 >= if
          continue ## argument already set
        end
        ## get argument from stack
        argIndices argIndex list.at .data =:: arg
        op [] .pos context popValue arg [] .valId =
      end
      argIndices .length =:: outArgOffset
      newSb
        calledType
          argIndices @
          op [] .pos
        context prepareCall
        procData [] .labelId
          callInfo [] .implementationId
        context sb.appendGlobalName
        calledType
          argIndices @
          outArgOffset
          op [] .pos
        context finishCall
      return
    callPtr case
      op [] .pos context popValue =:: calledId
      op [] .dataType =:: mut: calledType
      calledType typeContext types.isPointer if
        calledType
          typeContext types.getBaseType
        calledType =
      end
      calledType typeContext types.getProcIn
        ! assert "calledType has arguments"
      =:: inTypes
      inTypes typeContext types.compositeEltCount =:: argCount
      argCount TypedValId list.create =:: mut: argIndices
      argCount 1 - while ..dup 0 >= do =:: i
        inTypes
          i typeContext types.compositeGetElement
        =:: arg
        arg typeContext types.isEmpty if
          i 1 - continue ## skip empty arguments
        end
        argIndices
          ## TypedValId
            arg
            op [] .pos context popValue
          TypedValId new list.append
        argIndices =
        i 1 -
      end ..drop
      ## arguments are popped in reverse order
      argIndices list.reverse
      argIndices .length =:: outArgOffset
      sb
        calledType
          argIndices @
          op [] .pos
        context prepareCall
        "%s" sb.appendS
        calledId sb.appendI
        calledType
          argIndices @
          outArgOffset
          op [] .pos
        context finishCall
      return
    builtIn case
      sb
        op [] .pos sb.appendPosQBE
        ## appendBuiltInQBE
          op [] .val .builtIn
          op [] .dataType
          op [] .pos
          context
        appendBuiltInQBE
      return
    binaryOperator case
      op [] .val .binaryOperator .EQ ?? !
      op [] .val .binaryOperator .NE ?? ! & if
        break ## only equality operators are directly supported
      end
      op [] .val .binaryOperator .EQ ?? if
        "eq" string.wrap
      else
        "ne" string.wrap
      end =:: cmpName
      op [] .dataType context referenceOnly ! if
        op [] .dataType context toValType =:: valType
        sb
          op [] .dataType true op [] .pos context extendArguments
          ## appendComparisonOperator
            cmpName
            valType
            op [] .pos
            context
          appendComparisonOperator
        return
      end
      op [] .dataType typeContext types.isEnum if
        op [] .pos context popValue =:: arg1
        op [] .pos context popValue =:: arg2
        sb
          op [] .dataType
            arg1
            op [] .pos
          context loadEnumLabel =:: valType =:: label1
          op [] .dataType
            arg2
            op [] .pos
          context loadEnumLabel ..drop =:: label2
          "%s" sb.appendS
          ValType .I32 context pushValue sb.appendI
          " =w c" sb.appendS
          cmpName sb.appendStr
          valType sb.appendValTypeQBE
          " %t" sb.appendS
          label1 sb.appendI
          ", %t" sb.appendS
          label2 sb.appendI
          '\n' sb.appendC
        return
      end
      break
    argc case
      sb
        op [] .pos sb.appendPosQBE
        "%s" sb.appendS
        ValType .I64 context pushValue sb.appendI
        " =l loadl $" sb.appendS
        CONCAT_ARGC_NAME sb.appendS
        '\n' sb.appendC
      return
    getArg case
      op [] .pos context popValue =:: argIndexId
      context nextTmpId =:: argcId
      context nextTmpId =:: argvId
      context nextTmpId =:: eltOffsetId
      context nextTmpId =:: argvEltId
      ValType .I64 context pushValue =:: argPtr
      sb
        op [] .pos sb.appendPosQBE
        "%t" sb.appendS
        argcId sb.appendI
        " =l loadl $" sb.appendS
        CONCAT_ARGC_NAME sb.appendS
        '\n' sb.appendC
        ## appendIndexCheck
          argcId IntValue .tmpId
          argIndexId
          op [] .pos
          context
        appendIndexCheck
        "%t" sb.appendS
        argvId sb.appendI
        " =l loadl $" sb.appendS
        CONCAT_ARGV_NAME sb.appendS
        '\n' sb.appendC
        ## scale offset by size of pointer
        "%t" sb.appendS
        eltOffsetId sb.appendI
        " =l mul %s" sb.appendS
        argIndexId sb.appendI
        ", 8\n%t" sb.appendS
        argvEltId sb.appendI
        " =l add %t" sb.appendS
        argvId sb.appendI
        ", %t" sb.appendS
        eltOffsetId sb.appendI
        '\n' sb.appendC
        "%s" sb.appendS
        argPtr sb.appendI
        " =l loadl %t" sb.appendS
        argvEltId sb.appendI
        '\n' sb.appendC
        ## push length of string
        "%s" sb.appendS
        ValType .I64 context pushValue sb.appendI
        " =l call $strlen(l %s" sb.appendS
        argPtr sb.appendI
        ")\n" sb.appendS
      return
    block case
      op [] .val .block .blockType switch
        IF case
          ## BranchId
            BranchType .IF
            op [] .val .block .blockId
            0
          BranchId new =:: ifBranch
          sb
            op [] .pos sb.appendPosQBE
            "jnz %s" sb.appendS
            op [] .pos context popValue sb.appendI
            ", " sb.appendS
            ifBranch sb.appendBranchId
            ", " sb.appendS
            ## appendBranchId
              BranchType .ELSE
              op [] .val .block .blockId
              0
            BranchId new sb.appendBranchId
            '\n' sb.appendC
            op [] .val .block .blockId context openIfBlock
            ifBranch context startBranch
          return
        IFIF case
          context [] .openBlocks list.peek .data =:: ifBlock
          ## appendBranchId
            BranchType .NEXT
            context nextJumpLabelId
            0
          BranchId new =:: ifBranch
          sb
            op [] .pos sb.appendPosQBE
            "jnz %s" sb.appendS
            op [] .pos context popValue sb.appendI
            ", " sb.appendS
            ifBranch sb.appendBranchId
            ", " sb.appendS
            ## appendBranchId
              BranchType .ELSE
              op [] .val .block .blockId
              0
            BranchId new sb.appendBranchId
            '\n' sb.appendC
            ifBlock [] .If .ififBranches
              context [] .stackInfo @ branchTree.startBranch list.append
            ifBlock [] .If .ififBranches =
            ifBlock [] .If .ififBranchIds
              context [] .currentBranch list.append
            ifBlock [] .If .ififBranchIds =
            ifBranch context startBranch
          return
        ELSE case
          context [] .openBlocks list.peek .data =:: ifBlock
          context [] .stackInfo @ ifBlock [] .If .branchRoot branchTree.reset =:: ifBranch
          context [] .reachable ifBlock [] .If .ifBranchTerminates =
          ## BranchPoint
          ifBranch ifBlock [] .If .ifBranch =
          context [] .currentBranch ifBlock [] .If .ifBranchId =
          sb
            ## don't add position for labels
            context [] .reachable if
              "jmp " sb.appendS
              ## appendBranchId
                BranchType .END_IF
                op [] .val .block .blockId
                0
              BranchId new sb.appendBranchId
              '\n' sb.appendC
            end
            ## startBranch
              ## BranchId
                BranchType .ELSE
                op [] .val .block .blockId
                0
              BranchId new
              context
            startBranch
            true context [] .reachable =
          =:: mut: newSb
          ifBlock [] .If .ififBranches .length 1 >= if
            ## mergeValues
              context [] .stackInfo @
              ifBlock [] .If .ififBranches list.asArray
              mergeBranches @
              ## MergePoint
                "if _if" string.wrap
                ifBlock [] .If .blockId
                ifBlock [] .If .ififBranchIds list.asArray
                op [] .pos
                context
                newSb @
              MergePoint new
            branchTree.merge .error ?? if
              "could not merge if _if branches" sb.wrap
              op [] .pos errors appendError
            end
          end
          newSb return
        SWITCH case
          op [] .val .block .blockId =:: switchId
          prog [] .switchData
            switchId list.at .data
          =:: switchData
          sb
            op [] .pos sb.appendPosQBE
            ## appendSwitchTable
              switchData [] .switchType
              op [] .pos context popValue
              switchId
              switchData [] .labels
              op [] .pos
              context
            appendSwitchTable
            switchId context openSwitchBlock
            false context [] .reachable =
          return
        CASE case
            sb
              ## don't add position before label
              op [] .val .block .blockId =:: switchId
              ## BranchId
                BranchType .CASE
                switchId
                op [] .val .block .subId
              BranchId new context startBranch
              true context [] .reachable =
            return
        DEFAULT case
            sb
              ## don't add position before label
              op [] .val .block .blockId =:: switchId
              ## BranchId
                BranchType .DEFAULT
                switchId
                0
              BranchId new context startBranch
              true context [] .reachable =
            return
        BREAK_SWITCH case
            ## findBreakableBlock
              BlockType .BREAK_SWITCH
              op [] .pos
              context
            findBreakableBlock =:: breakBlock?
            breakBlock? optional.isEmpty if
              ## error message handled by findBreakableBlock
              sb return
            end
            breakBlock? .data =:: breakBlock
            breakBlock [] .Switch ?? ! if
              "unexpected block for " sb.wrap
                BlockType .BREAK_SWITCH sb.appendBlockType
                ": " sb.appendS
                breakBlock [] sb.appendBlockInfo
              op [] .pos errors appendError
            end
            context [] .stackInfo @
              breakBlock [] .Switch .branchRoot
            branchTree.reset =:: caseBranchId
            ## remember break (if reachable)
            context [] .reachable if
              breakBlock [] .Switch .caseBranches
                caseBranchId list.append
              breakBlock [] .Switch .caseBranches =
              breakBlock [] .Switch .caseBranchIds
                context [] .currentBranch list.append
              breakBlock [] .Switch .caseBranchIds =
            end
            sb
              context [] .reachable if
                ## don't add jump in unreachable branches
                op [] .pos sb.appendPosQBE
                "jmp " sb.appendS
                ## BlockId
                  BranchType .END_SWITCH
                  breakBlock [] .Switch .blockId
                  0
                BranchId new sb.appendBranchId
                '\n' sb.appendC
              end
              false context [] .reachable =
            return
          break
        WHILE case
            ## don't add position before label
            op [] .val .block .blockId =:: whileId
            ## BranchId
              BranchType .WHILE
              whileId
              0
            BranchId new =:: branchId
            whileId context openWhileBlock
            context [] .openBlocks list.peek .data [] .While @ =:: whileBlock
            prog [] .whileData whileId list.at .data =:: whileData
            context [] .currentBranch =:: prevBranch
            whileData [] .modifiedTypes =:: loopEltCount
            loopEltCount StackElement list.create =:: mut: loopElts
            0 while ..dup loopEltCount < do 1 +
              loopElts
                context [] .stackInfo @ branchTree.pop .data list.appendP
              loopElts =
            end ..drop
            sb
              "jmp " sb.appendS
              branchId sb.appendBranchId
              '\n' sb.appendC
              branchId context startBranch
              loopEltCount 1 - while ..dup 0 >= do =:: i
                loopElts i list.at .data =:: elt
                "%s" sb.appendS
                elt [] .valType context pushValue sb.appendI
                " =" sb.appendS
                elt [] .valType sb.appendValTypeQBE
                " phi " sb.appendS
                prevBranch sb.appendBranchId
                " %s" sb.appendS
                elt [] .varId sb.appendI
                ',' sb.appendC
                ## BranchId
                  BranchType .CONTINUE_WHILE
                  whileId
                  0
                BranchId new sb.appendBranchId
                " %t" sb.appendS
                whileBlock [] .loopValOffset i + sb.appendI
                '\n' sb.appendC
                i 1 -
              end ..drop
              loopElts list.free loopElts =
            return
        DO case
          context [] .openBlocks list.peek .data [] .While @ =:: whileBlock
          ## BranchId
            BranchType .NEXT
            context nextJumpLabelId
            0
          BranchId new =:: doBranch
          sb
            op [] .pos sb.appendPosQBE
            "jnz %s" sb.appendS
            op [] .pos context popValue sb.appendI
            ", " sb.appendS
            doBranch sb.appendBranchId
            ", " sb.appendS
            ## appendBranchId
              BranchType .END_WHILE
              op [] .val .block .blockId
              0
            BranchId new sb.appendBranchId
            '\n' sb.appendC
            whileBlock [] .breakBranches
              context [] .stackInfo @ branchTree.startBranch list.append
            whileBlock [] .breakBranches =
            whileBlock [] .breakBranchIds
              context [] .currentBranch list.append
            whileBlock [] .breakBranchIds =
            doBranch context startBranch
          return
        BREAK CONTINUE case
          op [] .val .block .blockType =:: blockType
          ## findBreakableBlock
            blockType
            op [] .pos
            context
          findBreakableBlock =:: breakBlock?
          breakBlock? optional.isEmpty if
            ## error message handled by findBreakableBlock
            sb return
          end
          breakBlock? .data =:: breakBlock
          breakBlock [] .While ?? ! if
            "unexpected block for " sb.wrap
              blockType sb.appendBlockType
              ": " sb.appendS
              breakBlock [] sb.appendBlockInfo
            op [] .pos errors appendError
          end
          blockType .CONTINUE ?? if
            breakBlock [] .While .continueBranches @
            breakBlock [] .While .continueBranchIds @
          else
            breakBlock [] .While .breakBranches @
            breakBlock [] .While .breakBranchIds @
          end =:: branchIds =:: branches
          branches []
            context [] .stackInfo @ branchTree.startBranch list.append
          branches []  =
          branchIds []
            context [] .currentBranch list.append
          branchIds [] =
          sb
            ## don't add jump in unreachable branches
            op [] .pos sb.appendPosQBE
            "jmp " sb.appendS
            ## BlockId
              blockType .CONTINUE ?? if BranchType .CONTINUE_WHILE else BranchType .END_WHILE end
              breakBlock [] .While .blockId
              0
            BranchId new sb.appendBranchId
            '\n' sb.appendC
            false context [] .reachable =
          return
        UNKNOWN INITIALIZER NAMESPACE PROCEDURE EXPERIMENTAL_PROCEDURE
        TYPE_TUPLE TYPE_STRUCT TYPE_ENUM TYPE_UNION TYPE_PROC_IN TYPE_PROC_OUT TYPE_COMPOSITE case
          ## XXX error message
          break
      end
      break
    blockEnd case
      op [] .val .blockEnd .blockType switch
        PROCEDURE EXPERIMENTAL_PROCEDURE case
          Type .undefined context [] .currentProc =
          sb
            ## end of procedure block always unreachable
            ## ( type-checker ensures there is a return before end )
            "@end\nhlt\n}\n" sb.appendS
            op [] .pos context sb.appendLocalConstants
          return
        ELSE case
          context [] .openBlocks
            list.pop .If =:: ifBlock
          context [] .openBlocks =
          branchTree.NodeId 2 array new =:: mut: branches
          BranchId 2 array new =:: mut: branchIds
          0 =:: mut: nBranches
          ifBlock .ifBranchTerminates if
            ifBlock .ifBranch branches @ nBranches [] =
            ifBlock .ifBranchId branchIds @ nBranches [] =
            nBranches 1 + nBranches =
          end
          context [] .reachable if
            context [] .stackInfo @ branchTree.startBranch branches @ nBranches [] =
            context [] .currentBranch branchIds @ nBranches [] =
            nBranches 1 + nBranches =
          end
          sb
            ## don't add position for labels
            ## startBranch
              ## BranchId
                BranchType .END_IF
                op [] .val .blockEnd .blockId
                0
              BranchId new
              context
            startBranch
          =:: mut: newSb
          nBranches 1 >= if
            ## mergeValues
              context [] .stackInfo @
              branches @ nBranches array.create
              mergeBranches @
              ## MergeIf
                "if" string.wrap
                ifBlock .blockId
                branchIds @ nBranches array.create
                op [] .pos
                context
                newSb @
              MergePoint new
            branchTree.merge .error ?? if
              "could not merge branches of if-else block" sb.wrap
              op [] .pos errors appendError
            end
          end
          nBranches 0 > context [] .reachable =
          ifBlock .ififBranches list.free ..drop
          newSb return
        IFIF case sb return ## no-op
        SWITCH case
          context [] .openBlocks
            list.pop .Switch =:: switchBlock
          context [] .openBlocks =
          switchBlock .caseBranches =:: caseBranches
          caseBranches .length 0 > context [] .reachable =
          sb
            ## don't add position for labels
            ## startBranch
              ## BranchId
                BranchType .END_SWITCH
                op [] .val .blockEnd .blockId
                0
              BranchId new
              context
            startBranch
          =:: mut: newSb
          caseBranches .length 1 >= if
            caseBranches .length =:: nodeCount
            ## mergeValues
              context [] .stackInfo @
              caseBranches list.asArray
              mergeBranches @
              ## MergePoint
                "switch" string.wrap
                switchBlock .blockId
                switchBlock .caseBranchIds list.asArray
                op [] .pos
                context
                newSb @
              MergePoint new
            branchTree.merge .error ?? if
              "could not merge branches of switch-case block" sb.wrap
              op [] .pos errors appendError
            end
          end
          caseBranches .length 0 > context [] .reachable =
          caseBranches list.free ..drop
          switchBlock .caseBranchIds list.free ..drop
          newSb return
        WHILE case
          context [] .openBlocks
            list.pop .While =:: mut: whileBlock
          context [] .openBlocks =
          whileBlock .continueBranches =:: mut: continueBranches
          context [] .reachable if
            whileBlock .continueBranchIds
              context [] .currentBranch list.append
            whileBlock .continueBranchIds =
            continueBranches
              context [] .stackInfo @ branchTree.startBranch list.append
            continueBranches =
          end
          sb
            ## don't add position for labels
            ## startBranch
              ## BranchId
                BranchType .CONTINUE_WHILE
                op [] .val .blockEnd .blockId
                0
              BranchId new
              context
            startBranch
          =:: mut: newSb
          continueBranches .length 1 >= if
            continueBranches .length =:: nodeCount
            ## mergeValues
              context [] .stackInfo @
              continueBranches list.asArray
              mergeBranches @
              ## MergePoint
                "while" string.wrap
                whileBlock .blockId
                whileBlock .continueBranchIds list.asArray
                op [] .pos
                context
                newSb @
              MergePoint new
            branchTree.merge .error ?? if
              "could not merge continue branches of while block" sb.wrap
              op [] .pos errors appendError
            end
          end
          prog [] .whileData whileBlock .blockId list.at .data =:: whileData
          newSb
            ## copy values to loop vars
            0 while ..dup whileData [] .modifiedTypes < do =:: i
              context [] .stackInfo @ branchTree.pop .data =:: elt
              "%t" sb.appendS
              whileBlock .loopValOffset i + sb.appendI
              " =" sb.appendS
              elt [] .valType sb.appendValTypeQBE
              " copy %s" sb.appendS
              elt [] .varId sb.appendI
              '\n' sb.appendC
              i 1 +
            end ..drop
            ## jump to start of loop
            "jmp " sb.appendS
            ## BranchId
              BranchType .WHILE
              op [] .val .blockEnd .blockId
              0
            BranchId new sb.appendBranchId
            '\n' sb.appendC
          newSb =
          continueBranches list.free ..drop
          whileBlock .continueBranchIds list.free ..drop
          newSb
            ## don't add position for labels
            ## startBranch
              ## BranchId
                BranchType .END_WHILE
                op [] .val .blockEnd .blockId
                0
              BranchId new
              context
            startBranch
          newSb =
          whileBlock .breakBranches =:: breakBranches
          breakBranches .length 1 >= if
            breakBranches .length =:: nodeCount
            ## mergeValues
              context [] .stackInfo @
              breakBranches list.asArray
              mergeBranches @
              ## MergePoint
                "while" string.wrap
                whileBlock .blockId
                whileBlock .breakBranchIds list.asArray
                op [] .pos
                context
                newSb @
              MergePoint new
            branchTree.merge .error ?? if
              "could not merge break branches of while block" sb.wrap
              op [] .pos errors appendError
            end
          end
          breakBranches .length 0 > context [] .reachable =
          breakBranches list.free ..drop
          whileBlock .breakBranchIds list.free ..drop
          newSb return
        UNKNOWN CASE DEFAULT BREAK_SWITCH DO BREAK CONTINUE INITIALIZER IF NAMESPACE
        TYPE_TUPLE TYPE_STRUCT TYPE_ENUM TYPE_UNION TYPE_PROC_IN TYPE_PROC_OUT TYPE_COMPOSITE case
          ## XXX error message
          break
      end
      break
    Return case
      op [] .dataType typeContext types.isProcedure ! if
        "unexpected type for return: " sb.wrap
          op [] .dataType typeContext sb.appendType
          " expected procedure" sb.appendS
        op [] .pos errors appendError
        sb return
      end
      op [] .dataType typeContext types.getProcRet ..drop =:: retType
      op [] .dataType typeContext types.getProcOutArgs ..drop =:: outTypes
      retType typeContext types.isProcOut if
          retType typeContext types.compositeEltCount
        else retType typeContext types.isEmpty _if 0:i64 else 1:i64 end =:: retCount
      false context [] .reachable =
      sb
        op [] .pos sb.appendPosQBE
        retCount 1 == if
          op [] .pos context popValue
          "ret %s" string.wrap
        else retCount 0 > _if
          retType op [] .pos context true appendAlloc =:: tmpId
          retType tmpId op [] .pos context initializeTupleQBE
          tmpId
          "ret %t" string.wrap
        else
          -1:i64  string.empty ## values will be ignored
        end =:: retStr =:: retId
        outTypes .length 1 - while ..dup 0 >= do =:: i
          outTypes i array.get =:: elt
          elt typeContext types.isEmpty if
            i 1 - continue
          end
          elt context referenceOnly if
            "blit" sb.appendS
          else
            "store" sb.appendS
            elt StorageType .STORE op [] .pos context sb.appendTypeNameQBE
          end
          " %s" sb.appendS
          op [] .pos context popValue sb.appendI
          ", " sb.appendS
          i context sb.appendOutArgName
          elt context referenceOnly if
            ", " sb.appendS
            elt op [] .pos context typeSizeInt sb.appendI
          end
          '\n' sb.appendC
        i 1 -
        end ..drop
        retCount 0 == if
          "ret\n" sb.appendS
          return
        end
        retStr sb.appendStr
        retId sb.appendI
        '\n' sb.appendC
      return
    Assert case
      ## BranchId
        BranchType .NEXT
        context nextJumpLabelId
        0
      BranchId new =:: successBranch
      ## BranchId
        BranchType .ERROR
        context nextJumpLabelId
        0
      BranchId new =:: errorBranch
      sb
        op [] .pos sb.appendPosQBE
        "## assert\n" sb.appendS
        "jnz %s" sb.appendS
        op [] .pos context popValue sb.appendI
        " ," sb.appendS
        successBranch sb.appendBranchId
        " ," sb.appendS
        errorBranch sb.appendBranchId
        '\n' sb.appendC
        errorBranch sb.appendBranchId
        '\n' sb.appendC
        "call $printf(l $" sb.appendS
        ASSERT_FORMAT sb.appendS
        ",l " sb.appendS
        op [] .val .Assert .length sb.appendI
        ",l " sb.appendS
        op [] .val .Assert context sb.appendStringPtrConstQBE
        op [] .pos prog appendPosPrintfArgs
        ")\ncall $exit(w 1)\n" sb.appendS
        successBranch context startBranch
        '\n' sb.appendC
      return
    unreachable case
      false context [] .reachable =
      sb
        op [] .pos sb.appendPosQBE
        "## unreachable\n" sb.appendS
        "hlt\n" sb.appendS
      return
    stackMod case
      op [] .val .stackMod .modType switch
        DROP case
          op [] .val .stackMod .n =:: count
          count while ..dup 0 > do 1 -
             context [] .stackInfo @ branchTree.pop ..drop
          end ..drop
          sb return
        COPY case
          op [] .val .stackMod .n =:: offset
          ## copy value on stack
          context [] .stackInfo @
            offset
          branchTree.at .data =:: copied
          context [] .stackInfo @
            copied []
          branchTree.push
          sb return
        SWAP case
          context [] .stackInfo branchTree.depth 2 < if
            "stack underflow" sb.wrap
            op [] .pos errors appendError
            sb return
          end
          context [] .stackInfo @ branchTree.swap
          sb return
      end
      break
    Print case
      context [] .stackInfo @ branchTree.pop ..drop ## keep stack synced
      break
    setId autoTypedInitializeId
    setElement setArrayElement call_old
    getArgLen unaryOperator
    checkArrayIndex typeInfo
    compilerInfo getName setName atName getLabel setLabel
    atLabel length size typeModifier hasLabel hasName case
      break ## XXX error message
  end
  "unable to compile operation " sb.wrap
    op [] prog sb.appendOp
  op [] .pos errors appendError
  sb return
end

proc( CompilerContext ptr mut : context -> ) =>: cleanupCompilerContext
  context [] .stackInfo @ branchTree.free
  context [] .openBlocks
    list.free
  context [] .openBlocks =
  context [] .localConstants
    list.free
  context [] .localConstants =
  context [] .stringConstants
    list.free
  context [] .stringConstants =
end
proc( io.FILE : target ProgramContext ptr mut : prog -> ) =>: export: compileToQBE
  prog [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  ## CompilerContext
    prog
    StackElement branchTree.create
    BranchType .START 0 0 BranchId new
    32 BlockInfo list.create
    32 LocalConst list.create
    32 StringConstant list.create
    Type .undefined
    0
    0
    0
    0
    true
  CompilerContext new =:: mut: contextData
  contextData @ =:: context
  id.LABEL_ID_NONE =:: mut: mainId
  MAIN_NAME string.wrap 0 idContext id.findIdentifierByName ! if =:: data
    data [] .labelId labelContext id.getLabelNamespace 0 ==
        assert "main is in global namespace"
    data [] .labelId mainId =
  else ..drop end
  1024 sb.create
    prog getDeclaredTypes =:: types
    0 while ..dup types .length < do =:: i
      types i list.get
        ## TODO? use declaration position of type
        string.empty 0 0 FilePosition new
      context sb.appendTypeDeclarationQBE
      i 1 +
    end ..drop
    prog [] .hasCheckIndex if
      "data $" sb.appendS
      CHECK_INDEX_FORMAT sb.appendS
      " = { b \"index out of range: %lli size: %llu at %.*s:%i:%i\\n\", b 0 }\n" sb.appendS
    end
    prog [] .hasCheckEnum if
      "data $" sb.appendS
      CHECK_ENUM_FORMAT sb.appendS
      " = { b \"enum index (%i) does not match current value (%u) at %.*s:%i:%i\\n\", b 0 }\n" sb.appendS
    end
    "data $" sb.appendS
    ASSERT_FORMAT sb.appendS
    " = { b \"assertion failed: \\\"%.*s\\\" at %.*s:%i:%i\\n\", b 0 }\n" sb.appendS
  =:: mut: sb
  idContext [] .globalScope .identifierNames @ map.itr.start while map.itr.hasNext do map.itr.next
    =:: declaration ## TODO find out which declarations are actually used
    declaration .1 [] =:: labelId
    labelId idContext id.getIdentifier
      ! assert "labelId is identifier"
    =:: idData
    idData [] .idType .TYPE ??
    idData [] .idType .PROCEDURE ?? |
    idData [] .idType .PROCEDURE_BUNDLE ?? | if
      continue
    end
    idData [] .valueType =:: mut: valType
    labelId labelContext id.labelFlags =:: labelFlags
    valType types.isAutoType if
      prog [] .autoTypes
        valType types.getTypeId
      list.at .data []
      valType =
    end
    valType types.primitive.TYPE types.typeEquals
    valType typeContext types.isEmpty |
    valType typeContext types.isProcedure | if
      continue
    end
    sb
      labelFlags id.FLAG_EXPORT & ? if
        "export " sb.appendS
      end
      "data " sb.appendS
      labelId -1 context sb.appendGlobalName
      " = align " sb.appendS
      valType idData [] .declaredAt context typeAlignmentInt sb.appendI
      " {" sb.appendS
      idData [] .constValue ConstValue .none != if
        valType idData [] .constValue true idData [] .declaredAt context sb.appendConstQBE
      else
        "z " sb.appendS
        valType idData [] .declaredAt context typeSizeInt sb.appendI
      end
      "}\n" sb.appendS
      target ..over io.fputSb ..drop
      sb.clear
    sb =
  end ..drop
  sb
    0 while ..dup prog [] .progFiles .length < do =:: i
      prog [] .progFiles i list.at .data =:: f
        "dbgfile \"" sb.appendS
        f [] .fileName sb.appendSb
        "\"\n"    sb.appendS
        "data $" sb.appendS
        FILE_NAME_NAME sb.appendS
        i sb.appendI
        " = {" sb.appendS
          f [] .fileName
            list.asArray labelContext id.wrapStringConstant
            context
          sb.appendStringConstQBE
        "} \n" sb.appendS
        0 while ..dup f [] .localOps .length < do
          ..swap
          f [] .localOps ..over.2 list.at .data context compileOp
          ..swap 1 +
        end ..drop
        target ..over io.fputSb ..drop
        sb.clear
      i 1 +
    end ..drop
    target ..over io.fputSb ..drop
    sb.clear
    0 while ..dup context [] .stringConstants .length < do =:: i
      context [] .stringConstants i list.get =:: str
      "data $" sb.appendS
      STRING_CONST_NAME sb.appendS
      i sb.appendI
      " = {" sb.appendS
        str context sb.appendStringConstQBE
      "} ## \"" sb.appendS
      str labelContext sb.appendEscapedStr
      "\"\n" sb.appendS
      i 1 +
    end ..drop
    target ..over io.fputSb ..drop
    sb.clear
    mainId id.LABEL_ID_NONE == if ## no main
      sb.free ..drop
      context cleanupCompilerContext
      return
    end
    prog [] .hasGetArgs if
      "data $" sb.appendS
      CONCAT_ARGC_NAME sb.appendS
      " = { l 0 }\n" sb.appendS
      "data $" sb.appendS
      CONCAT_ARGV_NAME sb.appendS
      " = { l 0 }\n" sb.appendS
      "data $" sb.appendS
      CONCAT_ENVP_NAME sb.appendS
      " = { l 0 }\n" sb.appendS
      "export function w $main(l %argc,l %argv,l %envp){\n@start\n" sb.appendS
      "storel %argc,$" sb.appendS
      CONCAT_ARGC_NAME sb.appendS
      '\n' sb.appendC
      "storel %argv,$" sb.appendS
      CONCAT_ARGV_NAME sb.appendS
      '\n' sb.appendC
      "storel %envp,$" sb.appendS
      CONCAT_ENVP_NAME sb.appendS
      '\n' sb.appendC
      "call " sb.appendS
    else
      "export function w $main(){\n@start\ncall " sb.appendS
    end
    mainId -1 context sb.appendGlobalName
    "()\nret 0\n}\n" sb.appendS
    target ..over io.fputSb ..drop
  sb.free ..drop
  context cleanupCompilerContext
end
