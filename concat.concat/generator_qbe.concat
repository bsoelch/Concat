end

proc(
  stringBuilder : sb
  BuiltIn : builtIn
  Type : opType
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: appendBuiltInQBE
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  opType typeContext types.getProcIn ..drop =:: inType
  inType 0 typeContext types.compositeGetLabel
      labelContext id.labelFlags id.FLAG_STATIC & ? if
    1
  else
    0
  end =:: firstArg
  inType firstArg typeContext types.compositeGetElement =:: baseType
  baseType context toValType =:: baseVal
  builtIn switch
    NEG_I8 NEG_I16 NEG_I32 NEG_I64 NEG_F32 NEG_F64 case
      sb "neg" string.wrap baseVal context appendUnaryOperator
      return
    ADD_I8 ADD_I16 ADD_I32 ADD_I64 ADD_F32 ADD_F64 case
      sb "add" string.wrap baseVal context appendBinaryOperator
      return
    ADD_PTR ADD_PTR_MUT case
      baseType typeContext types.getBaseType =:: valueType
      context popValue =:: offsetId
      sb
        ## correctly scale offset
        "%s" sb.appendS
        ValType .I64 context pushValue sb.appendI
        " =l mul %s" sb.appendS
        offsetId sb.appendI
        ", " sb.appendS
        valueType typeContext types.sizeOf sb.appendI
        '\n' sb.appendC
       "add" string.wrap ValType .PTR context appendBinaryOperator
      return
    SUB_I8 SUB_I16 SUB_I32 SUB_I64 SUB_F32 SUB_F64 case
      sb "sub" string.wrap baseVal context appendBinaryOperator
      return
    PTR_DIFF case
      baseType typeContext types.getBaseType =:: valueType
      sb
        "sub" string.wrap baseVal context appendBinaryOperator
        context popValue =:: resId
        ## correctly scale offset
        "%s" sb.appendS
        ValType .I64 context pushValue sb.appendI
        " =l udiv %s" sb.appendS
        resId sb.appendI
        ", " sb.appendS
        valueType typeContext types.sizeOf sb.appendI
        '\n' sb.appendC
      return
    MUL_I32 MUL_I64 MUL_F32 MUL_F64 case
      sb "mul" string.wrap baseVal context appendBinaryOperator
      return
    DIV_I32 DIV_I64 DIV_F32 DIV_F64 case
      sb "div" string.wrap baseVal context appendBinaryOperator
      return
    MOD_I32 MOD_I64 MOD_F32 MOD_F64 case
      sb "rem" string.wrap baseVal context appendBinaryOperator
      return
    UDIV_I32 UDIV_I64 case
      sb "udiv" string.wrap baseVal context appendBinaryOperator
      return
    UMOD_I32 UMOD_I64 case
      sb "urem" string.wrap baseVal context appendBinaryOperator
      return
    NOT_BOOL case
      context popValue =:: arg
      sb
        "%s" sb.appendS
        baseVal context pushValue sb.appendI
        " =w extub %s" sb.appendS
        arg sb.appendI
        '\n' sb.appendC
        "ceqw 0," string.wrap baseVal context appendUnaryOperator
      return
    FLIP_I8 FLIP_I16 FLIP_I32 FLIP_I64 case
      sb
        "xor -1," string.wrap baseVal context appendUnaryOperator
      return
    AND_BOOL AND_I8 AND_I16 AND_I32 AND_I64 case
      sb "and" string.wrap baseVal context appendBinaryOperator
      return
    OR_BOOL  OR_I8 OR_I16 OR_I32 OR_I64 case
      sb "or" string.wrap baseVal context appendBinaryOperator
      return
    XOR_BOOL XOR_I8 XOR_I16 XOR_I32 XOR_I64 case
      sb "xor" string.wrap baseVal context appendBinaryOperator
      return
    LSHR_I8 LSHR_I16 LSHR_I32 LSHR_I64 case
      sb
        baseType false pos context extendArguments
        "shr" string.wrap baseVal context appendBinaryOperator
      return
    ASHR_I8 ASHR_I16 ASHR_I32 ASHR_I64 case
      sb
        baseType true pos context extendArguments
        "sar" string.wrap baseVal context appendBinaryOperator
      return
    SHL_I8 SHL_I16 SHL_I32 SHL_I64 case
      sb "shl" string.wrap baseVal context appendBinaryOperator
      return
    BOOL_I8 BOOL_I16 BOOL_I32 BOOL_I64 BOOL_F32 BOOL_F64 case
      sb
        "%s" sb.appendS
        baseVal context pushValue sb.appendI
        " =" sb.appendS
        baseVal sb.appendValTypeQBE
        " copy 0\n" sb.appendS
        baseType false pos context extendArguments
        "ne" string.wrap baseVal context appendComparisonOperator
      return
    LT_I8 LT_I16 LT_I32 LT_I64 LT_PTR case
      sb
        baseType true pos context extendArguments
        "slt" string.wrap baseVal context appendComparisonOperator
      return
    LE_I8 LE_I16 LE_I32 LE_I64 LE_PTR case
      sb
        baseType true pos context extendArguments
        "sle" string.wrap baseVal context appendComparisonOperator
      return
    GE_I8 GE_I16 GE_I32 GE_I64 GE_PTR case
      sb
        baseType true pos context extendArguments
        "sge" string.wrap baseVal context appendComparisonOperator
      return
    GT_I8 GT_I16 GT_I32 GT_I64 GT_PTR  case
      sb
        baseType true pos context extendArguments
        "sgt" string.wrap baseVal context appendComparisonOperator
      return
    LT_F32 LT_F64 case
      sb
        baseType true pos context extendArguments
        "lt" string.wrap baseVal context appendComparisonOperator
      return
    LE_F32 LE_F64 case
      sb
        baseType true pos context extendArguments
        "le" string.wrap baseVal context appendComparisonOperator
      return
    GE_F32 GE_F64 case
      sb
        baseType true pos context extendArguments
        "ge" string.wrap baseVal context appendComparisonOperator
      return
    GT_F32 GT_F64  case
      sb
        baseType true pos context extendArguments
        "gt" string.wrap baseVal context appendComparisonOperator
      return
    ULT_I8 ULT_I16 ULT_I32 ULT_I64 case
      sb
        baseType false pos context extendArguments
        "ult" string.wrap baseVal context appendComparisonOperator
      return
    ULE_I8 ULE_I16 ULE_I32 ULE_I64 case
      sb
        baseType false pos context extendArguments
        "ule" string.wrap baseVal context appendComparisonOperator
      return
    UGE_I8 UGE_I16 UGE_I32 UGE_I64 case
      sb
        baseType false pos context extendArguments
        "uge" string.wrap baseVal context appendComparisonOperator
      return
    UGT_I8 UGT_I16 UGT_I32 UGT_I64 case
      sb
        baseType false pos context extendArguments
        "ugt" string.wrap baseVal context appendComparisonOperator
      return
    PRINT_BOOL case
      sb
        "%t" sb.appendS
        context nextTmpId =:: tmp1
        tmp1 sb.appendI
        " =l extub %s" sb.appendS
        context popValue sb.appendI
        "\n%t" sb.appendS
        context nextTmpId =:: tmp2
        tmp2 sb.appendI
        " =l mul 8, %t" sb.appendS
        tmp1 sb.appendI
        "\n%t" sb.appendS
        context nextTmpId =:: tmp3
        tmp3 sb.appendI
        " =l add $PRINT_BOOL_STRS, %t" sb.appendS
        tmp2 sb.appendI
        "\ncall $printf(l %t" sb.appendS
        tmp3 sb.appendI
        ", ... )\n" sb.appendS
      return
    PRINT_I8 case
      sb
        context popValue =:: charId
        "%t" sb.appendS
        context nextTmpId =:: tmp1
        tmp1 sb.appendI
        " =l extub %s" sb.appendS
        charId sb.appendI
        "\n%t" sb.appendS
        context nextTmpId =:: tmp2
        tmp2 sb.appendI
        " =l mul 4, %t" sb.appendS
        tmp1 sb.appendI
        "\n%t" sb.appendS
        context nextTmpId =:: tmp3
        tmp3 sb.appendI
        " =l add $PRINT_CHAR_STRS, %t" sb.appendS
        tmp2 sb.appendI
        "\ncall $printf(l $PRINT_CHAR_STR,...,sb %s" sb.appendS
        charId sb.appendI
        ",l %t" sb.appendS
        tmp3 sb.appendI
        ")\n" sb.appendS
      return
    PRINT_I16 case
      sb
        "%t" sb.appendS
        context nextTmpId =:: tmp1
        tmp1 sb.appendI
        " =w extsh %s" sb.appendS
        context popValue sb.appendI
        "\ncall $printf(l $PRINT_I32_STR,...,w %t" sb.appendS
        tmp1 sb.appendI
        ")\n" sb.appendS
      return
    PRINT_I32 case
      sb
        "call $printf(l $PRINT_I32_STR,...,w %s" sb.appendS
        context popValue sb.appendI
        ")\n" sb.appendS
      return
    PRINT_I64 case
      sb
        "call $printf(l $PRINT_I64_STR,...,l %s" sb.appendS
        context popValue sb.appendI
        ")\n" sb.appendS
      return
    PRINT_F32 case
      sb
        "%t" sb.appendS
        context nextTmpId =:: tmp1
        tmp1 sb.appendI
        " =d exts %s" sb.appendS
        context popValue sb.appendI
        "\ncall $printf(l $PRINT_FLOAT_STR,...,d %t" sb.appendS
        tmp1 sb.appendI
        ")\n" sb.appendS
      return
    PRINT_F64 case
      sb
        "call $printf(l $PRINT_FLOAT_STR,...,d %s" sb.appendS
        context popValue sb.appendI
        ")\n" sb.appendS
      return
    PRINT_PTR case
      sb
        "call $printf(l $PRINT_PTR_STR,...,l %s" sb.appendS
        context popValue sb.appendI
        ")\n" sb.appendS
      return
  end
end
proc( stringBuilder : sb -> stringBuilder ) =>: appendPrintConstants
  sb
    "data $PRINT_BOOL_STRS = {b \"false\\n\",z 2,b \"true\\n\",b 0}\n" sb.appendS
    "data $PRINT_CHAR_STRS = {\n" sb.appendS
    0 while ..dup 0x100 < do =:: c
      ## table of character names zero-padded to 4 bytes
      c i8 cast switch
        '\'' '\"' '\\' case
            "b 92,b " sb.appendS
            c sb.appendI
            ",z 2,"  sb.appendS
          break
        '\n' case "b \"\\\\n\",z 2," sb.appendS break
        '\t' case "b \"\\\\t\",z 2," sb.appendS break
        '\b' case "b \"\\\\b\",z 2,"  sb.appendS break
        '\r' case "b \"\\\\r\",z 2," sb.appendS break
        '\v' case "b \"\\\\v\",z 2," sb.appendS break
        '\f' case "b \"\\\\f\",z 2," sb.appendS break
        default
            c 0x7e > c 0x20 < | if
              "b \"\\\\x" sb.appendS
              c 0x10 < if '0' sb.appendC end
              c sb.appendX
              "\"," sb.appendS
            else
              "b " sb.appendS
              c sb.appendI
              ",z 3," sb.appendS
            end
          break
      end
      c 0x7 & 0x7 == if
        '\n' sb.appendC ## split into lines for readability
      end
      c 1 +
    end ..drop
    "b 0}\n"   sb.appendS
    "data $PRINT_CHAR_STR = {b \"%i ('%.4s')\\n\",b 0}\n" sb.appendS
    "data $PRINT_I32_STR  = {b \"%i\\n\",b 0}\n" sb.appendS
    "data $PRINT_I64_STR  = {b \"%lli\\n\",b 0}\n" sb.appendS
    "data $PRINT_FLOAT_STR  = {b \"%g\\n\",b 0}\n" sb.appendS
    "data $PRINT_PTR_STR  = {b \"%p\\n\",b 0}\n" sb.appendS
  return
end

proc(
  stringBuilder : sb
  Type : src
  i64 : srcIndex
  Type : target
  i64 : targetIndex
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: castNumbers
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  src typeContext types.primitiveValue =:: fromVal
  target typeContext types.primitiveValue =:: toVal
  sb
    ## common prefix
    "%s" sb.appendS
    targetIndex sb.appendI
    ## case 0: identical types
    fromVal toVal == if
      ## copy necessary to update value id
      " =" sb.appendS
      target StorageType .STACK pos context sb.appendTypeNameQBE
      " copy" sb.appendS
    ## case 1: integer extension/narrowing
    else src typeContext types.isInt target typeContext types.isInt & _if
      src typeContext types.numberPrecision =:: srcPrec
      target typeContext types.numberPrecision =:: targetPrec
      targetPrec srcPrec <= if
        " =" sb.appendS
        target StorageType .STACK pos context sb.appendTypeNameQBE
        " copy" sb.appendS
      else
        " =" sb.appendS
        target StorageType .STACK pos context sb.appendTypeNameQBE
        " exts" sb.appendS
        fromVal switch
          BOOL TYPE FLOAT32 FLOAT64 case break
          I8  case "b" sb.appendS break
          I16 case "h" sb.appendS break
          I32 case "w" sb.appendS break
          I64 case "l" sb.appendS break
        end
      end
    ## case 2: float -> float/int
    else fromVal .FLOAT32 ?? fromVal .FLOAT64 ?? | _if
      toVal switch
        BOOL TYPE case break
        FLOAT32 case
          " =s truncd" sb.appendS break
        FLOAT64 case
          " =d exts" sb.appendS break
        I8 I16 I32 I64 case
          " =" sb.appendS
          target StorageType .STACK pos context sb.appendTypeNameQBE
          fromVal .FLOAT32 ?? if
            " stosi" sb.appendS
          else
            " dtosi" sb.appendS
          end
          break
      end
    ## case 3: int -> float
    else fromVal .I64 ?? _if
      " =" sb.appendS
      target StorageType .STACK pos context sb.appendTypeNameQBE
      " sltof" sb.appendS
    else
      " =" sb.appendS
      target StorageType .STACK pos context sb.appendTypeNameQBE
      " swtof" sb.appendS
    end
    " %s" sb.appendS
    srcIndex sb.appendI
    '\n' sb.appendC
  return
end

proc(
  stringBuilder : sb
  bool : autoCast
  Type : src0
  i32 : offset
  Type : target0
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: compileCast
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  ## XXX? better cType <-> type conversion
  src0 typeContext types.unwrapNamed
    ..dup .cType ?? if .cType types.cTypeAsType end
  =:: src
  target0 typeContext types.unwrapNamed
    ..dup .cType ?? if .cType types.cTypeAsType end
  =:: target
  src target types.typeEquals if
    sb return ## nothing to do
  end
  autoCast if
    offset context [] .stackInfo branchTree.depth >= if
      "stack underflow" sb.wrap
      pos errors appendError
      sb return
    end
    context [] .stackInfo @ offset branchTree.at .data [] .valType
    context [] .stackInfo @ offset branchTree.at .data [] .varId
  else
    context [] .stackInfo @ offset branchTree.at .data [] .valType
    context popValue
  end =:: srcId =:: valType
  autoCast if
    target context toValType offset context replaceValue
  else
    target context toValType context pushValue
  end =:: targetId
  src typeContext types.isNumber target .arrayIndex ?? & if
    ## isNumber returns true for array index
    ##   -> have to check for cast to array index before checking for cast to number
    sb
      ## castNumbers
        src
        srcId
        types.primitive.I_SIZE
        targetId
      pos context castNumbers
      target typeContext types.getArraySize 0 array.get targetId pos context appendIndexCheck
    return
  end
  src typeContext types.isNumber target typeContext types.isNumber & if
    sb src srcId target targetId pos context castNumbers return
  end
  src typeContext types.isPointer target typeContext types.isPointer & if
    sb
      "%s" sb.appendS
      targetId sb.appendI
      " =l copy %s" sb.appendS
      srcId sb.appendI
      '\n' sb.appendC
    return ## both are pointer types
  end
  src typeContext types.isInt target typeContext types.isPointer & if
    ## src -> I_PTR ~ ptr
    sb
      ## castNumbers
        src
        srcId
        types.primitive.I_PTR
        targetId
      pos context castNumbers
    return
  end
  src typeContext types.isPointer target typeContext types.isInt & if
    ## ptr ~ I_PTR -> target
    sb
      ## castNumbers
        types.primitive.I_PTR
        srcId
        target
        targetId
      pos context castNumbers
    return
  end
  src typeContext types.isReference if target typeContext types.isReference ! _if
    src typeContext types.getBaseType typeContext types.unwrapNamed =:: baseType
    sb
      "%s" sb.appendS
      targetId sb.appendI
      " =" sb.appendS
      baseType StorageType .STACK pos context sb.appendTypeNameQBE
      baseType context referenceOnly ! if valType .REFERENCE ?? _if ## unwrap reference
        " load" sb.appendS
        baseType StorageType .LOAD pos context sb.appendTypeNameQBE
      else
        " copy" sb.appendS
      end
      " %s" sb.appendS
      srcId sb.appendI
      '\n' sb.appendC
      ## cast value
      baseType target types.typeEquals ! if
        ## compileCast
          autoCast
          baseType
          offset
          target
          pos
          context
        compileCast
      end
    return
  end
  target typeContext types.isUnion if
    ## TODO check if source is subset of union
    sb
      "%s" sb.appendS
      targetId sb.appendI
      target context false appendAlloc ..drop
      src context referenceOnly if
        "blit %s" sb.appendS
      else
        "store" sb.appendS
        src StorageType .STORE pos context sb.appendTypeNameQBE
        " %s" sb.appendS
      end
      srcId sb.appendI
      ", %s" sb.appendS
      targetId sb.appendI
      src context referenceOnly if
        ", " sb.appendS
        src typeContext types.sizeOf sb.appendI
      end
      '\n' sb.appendC
    return
  end
  "casting from " sb.wrap
    src typeContext sb.appendType
    " to " sb.appendS
    target typeContext sb.appendType
    " is not implemented" sb.appendS
  pos errors appendError
  sb return
end

proc(
  stringBuilder : sb
  Type : constType
  ConstValue : value
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: pushConstant
  sb
    pos sb.appendPosQBE
    "%s" sb.appendS
    constType context referenceOnly ! if
      constType context toValType context pushValue sb.appendI
      " =" sb.appendS
      constType StorageType .STACK pos context sb.appendTypeNameQBE
      " copy " sb.appendS
    else
      ValType .REFERENCE context pushValue sb.appendI
      " =l copy " sb.appendS
    end
    constType value false pos context sb.appendConstQBE
    '\n' sb.appendC
  return
end

proc(
  stringBuilder : sb
  Type : calledType
  TypedValId list ptr mut : argIndices
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: prepareCall
  context [] .program =:: prog
  prog [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  calledType typeContext types.getProcOutArgs ..drop =:: outArgs
  calledType typeContext types.getProcRet ..drop =:: retType
  sb =:: mut newSb
  ## allocate output arguments
  0 while ..dup outArgs .length < do =:: i
    outArgs i array.get =:: outArg
    ValType .REFERENCE context pushValue =:: argId
    newSb
      "%s" sb.appendS
      argId sb.appendI
      outArg context false appendAlloc ..drop
    newSb =
    argIndices []
      outArg argId TypedValId new list.append
    argIndices [] =
    i 1 +
  end ..drop
  newSb
    retType typeContext types.isEmpty ! if
      retType context toValType context pushValue =:: retId
      "%s" sb.appendS
      retId sb.appendI
      " =" sb.appendS
      retType StorageType .LOAD pos context sb.appendTypeNameQBE
      ' ' sb.appendC
    end
    "call " sb.appendS
  return
end
proc(
  stringBuilder : sb
  Type : calledType
  TypedValId list ptr mut : argIndices
  i64 : outArgsOffset
  FilePosition : pos
  CompilerContext ptr mut : context
-> stringBuilder ) =>: finishCall
  context [] .program =:: prog
  prog [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  calledType typeContext types.getProcOutArgs ..drop =:: outArgs
  calledType typeContext types.getProcRet ..drop =:: retType
  sb
    " (" sb.appendS
    0 while ..dup argIndices [] .length < do =:: i
      argIndices [] i list.at .data =:: arg
      i 0 > if
        ',' sb.appendC
      end
      i outArgsOffset < if
        arg [] .valType
          StorageType .LOAD
          pos
          context
        sb.appendTypeNameQBE
      else
        'l' sb.appendC
      end
      " %s" sb.appendS
      arg [] .valId sb.appendI
      i 1 +
    end ..drop
    ")\n" sb.appendS
    retType typeContext types.isProcOut if
      ## flattenTupleQBE
        retType context popValue
        pos
      context flattenTupleQBE
    end
    0 while ..dup outArgs .length < do =:: i
      argIndices []
        i outArgsOffset +
      list.at .data [] .valType =:: outArg
      outArg context referenceOnly if
        i 1 + continue
      end
      ## compileCast
        true
        outArg
          false
          typeContext
        types.newReferenceType
        ## (len-1-i) +1 for return value
        outArgs .length i - i32 cast
        outArg
        pos
        context
      compileCast
      i 1 +
    end ..drop
    argIndices [] list.free argIndices [] =
  return
end

proc(
  stringBuilder : sb
  Operation ptr : op
  CompilerContext ptr mut : context
-> stringBuilder ) =>: compileOp
  context [] .program =:: prog
  prog [] .errors @ =:: errors
  prog [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  op [] .val switch
    NOP case
      sb return
    Constant case
      sb
        op [] .dataType
        op [] .val .Constant
        op [] .pos
        context
      pushConstant
      return
    declareId initializeId case
      op [] .val .declareId ?? if
        op [] .val .declareId
      else
        op [] .val .initializeId
      end =:: idInfo
      op [] .val .initializeId ?? =:: assignValue
      idInfo .labelId labelContext id.labelFlags =:: labelFlags
      labelFlags id.FLAG_MUTABLE & ? =:: mutable
      idInfo .idType switch
        PROCEDURE case
          assignValue ! if
            sb return ## ignore procedure declarations
          end
          break
        LOCAL_VAR TMP_VAR case
          op [] .dataType =:: valType
          ## use pointers as stack representation of arrays and composites
          valType context referenceOnly ! =:: isValue
          sb
            op [] .pos sb.appendPosQBE
            idInfo .idType .LOCAL_VAR ?? if
              "%l" sb.appendS
              idInfo .labelId sb.appendI
            else
              "%tmp" sb.appendS
              idInfo .id sb.appendI
            end
            valType context false appendAlloc ..drop
            assignValue if
              isValue if
                "store" sb.appendS
                valType StorageType .STORE op [] .pos context sb.appendTypeNameQBE
              else
                "blit" sb.appendS ## XXX call memcopy for large structs
              end
              " %s" sb.appendS
              context popValue sb.appendI
              ',' sb.appendC
              idInfo .idType .LOCAL_VAR ?? if
                "%l" sb.appendS
                idInfo .labelId sb.appendI
              else
                "%tmp" sb.appendS
                idInfo .id sb.appendI
              end
              isValue ! if
                ',' sb.appendC
                op [] .dataType typeContext types.sizeOf sb.appendI
              end
              '\n' sb.appendC
            end
          return
        GLOBAL_VAR TYPE ARGUMENT TEMPLATE_ARG LABEL PROCEDURE_BUNDLE case
          break ## XXX error message
      end
      break
    implementProcedure case
      op [] .val .implementProcedure =:: implInfo
      prog [] .procedures
        implInfo .procId list.at .data
      =:: procInfo
      op [] .dataType context [] .currentProc =
      procInfo [] .labelId labelContext id.labelFlags =:: labelFlags
      ## reset stack-info in context
      0 context [] .stackCount =
      0 context [] .tmpCount =
      0 context [] .jumpLabelCount =
      context [] .stackInfo @ branchTree.clear
      sb
        implInfo .implementationId  0 < if
          labelFlags id.FLAG_EXPORT & ? labelFlags id.FLAG_EXTERN & ? | _if
          "export " sb.appendS
        end
        "function " sb.appendS
        op [] .dataType typeContext types.getProcRet if ..drop
          "wrong type for procedure initialization: " sb.wrap
            op [] .dataType typeContext sb.appendType
            " expected procedure" sb.appendS
          op [] .pos errors appendError
          return
        end =:: retType
        retType typeContext types.isEmpty ! if
          retType StorageType .LOAD op [] .pos context sb.appendTypeNameQBE
          ' ' sb.appendC
        end
        procInfo [] .labelId implInfo .implementationId context sb.appendGlobalName
        op [] .dataType op [] .pos context sb.appendProcSignature
        "{\n" sb.appendS
        ## BranchId
          BranchType .START
          0 0
        BranchId new context startBranch
        ## push unnamed arguments
        op [] .dataType typeContext types.getProcIn ..drop =:: inType
        inType typeContext types.compositeElts =:: args
        0 while ..dup args .length < do =:: i
          inType i typeContext types.compositeGetLabel =:: label
          args i types.compositeElts.get =:: argType
          label id.LABEL_ID_NONE == if ## push argument
