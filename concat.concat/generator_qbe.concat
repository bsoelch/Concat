import string
import stringIO
using std.literals.

import "program.concat"
import "measure.concat"
import "branchTree.concat"

## XXX make prefix customizable
"cct_" =:: CONCAT_PREFIX
"cctI_argc" =:: CONCAT_ARGC_NAME
"cctI_argv" =:: CONCAT_ARGV_NAME
"cctI_envp" =:: CONCAT_ENVP_NAME
"cctI_local" =:: LOCAL_CONST_NAME
"cctI_string" =:: STRING_CONST_NAME
"cctI_ptr" =:: PTR_CONST_NAME
"cctI_constRef" =:: CONST_REFERENCE_NAME
"cctI_checkIndexFormat" =:: CHECK_INDEX_FORMAT
"cctI_checkEnumFormat" =:: CHECK_ENUM_FORMAT
"cctI_assertFormat" =:: ASSERT_FORMAT
"cctI_panicFormat" =:: PANIC_FORMAT
"fileName" =:: FILE_NAME_NAME

enum(
  START
  NEXT
  ERROR
  LABEL
  LABEL_PRE
  END_INLINE
) =:: BranchType
struct( BranchType : branchType i32 : id ) =:: BranchId
enum( EMPTY I32 I64 FLOAT DOUBLE PTR REFERENCE ) =:: ValType

struct(
  i32 : varId
  ValType : valType
) =:: StackElement

struct(
  Type : valType
  i32 : valId
) =:: TypedValId

struct(
  ConstValue   : value
  Type         : valType
  FilePosition : pos
) =:: PtrConstant

struct(
  Type       : valType
  ConstValue : value
  FilePosition : pos
  i32 : id
) =:: LocalConst

struct(
  branchTree.NodeId list : andBranches
  BranchId list : andBranchIds
  branchTree.NodeId list : orBranches
  BranchId list : orBranchIds
  BranchId : ifBranchId
  branchTree.NodeId : branchRoot
  branchTree.NodeId : ifBranch
  BlockId : blockId
  bool : hasIf
  bool : ifBranchTerminates
) =:: IfBlockInfo
struct(
  branchTree.NodeId list : caseBranches
  BranchId list : caseBranchIds
  branchTree.NodeId : branchRoot
  BlockId : blockId
  i32 : blockEnd
) =:: SwitchBlockInfo
struct(
  branchTree.NodeId list : continueBranches
  BranchId list : continueBranchIds
  branchTree.NodeId list : breakBranches
  BranchId list : breakBranchIds
  branchTree.NodeId list : doBranches
  BranchId list : doBranchIds
  i32 : loopValOffset
  branchTree.NodeId : branchRoot
  BlockId : blockId
  i32 : blockStart
) =:: WhileBlockInfo
struct(
  branchTree.NodeId list : branches
  BranchId list : branchIds
  BlockId : blockId
) =:: AndOrBlockInfo

union(
  IfBlockInfo : If
  SwitchBlockInfo : Switch
  WhileBlockInfo : While
  AndOrBlockInfo : AndOr
) =:: BlockInfo

namespace: sb
  proc( stringBuilder BlockInfo -> stringBuilder ) =>: appendBlockInfo
    switch
      If case "if-else block" sb.appendS return
      Switch case "switch-case block" sb.appendS return
      While case "while block" sb.appendS return
      AndOr case "and/or block" sb.appendS return
    end
  end
end

struct(
  ProgramContext ptr.mut : program
  StackElement BranchTree : stackInfo
  BranchId : currentBranch
  BlockInfo list : openBlocks
  LocalConst list : localConstants
  string list : stringConstants
  PtrConstant list : ptrConstants
  Type i64 hashMap : typeIds
  i64 : typeIdCount
  Type : currentProc
  i32 : localConstCount
  i32 : stackCount
  i32 : tmpCount
  i32 : jumpLabelCount
  bool : reachable
) =:: CompilerContext

namespace: sb
  proc( stringBuilder ValType -> stringBuilder ) =>: appendValType
    switch
      EMPTY case "empty" sb.appendS return
      I32 case "i32" sb.appendS return
      I64 case "i64" sb.appendS return
      FLOAT case "float" sb.appendS return
      DOUBLE case "double" sb.appendS return
      PTR case "pointer" sb.appendS return
      REFERENCE case "reference" sb.appendS return
    end
  end
  proc( stringBuilder ValType -> stringBuilder ) =>: appendValTypeQBE
    switch
      EMPTY case break
      I32 case 'w' sb.appendC break
      I64 PTR REFERENCE case 'l' sb.appendC break
      FLOAT case 's' sb.appendC break
      DOUBLE case 'd' sb.appendC break
    end
  end
end
proc( Type : t CompilerContext ptr : context -> ValType ) =>: toValType
  context [] .program =:: program
  program .errors =:: errors
  program .idContext .typeContext =:: typeContext
  t switch
    namedType case
      t typeContext types.unwrapNamed context toValType return
    generatedType case
      t typeContext types.getGeneratedType context toValType return
    primitiveType case
      t .primitiveType switch
        TYPE case ValType .EMPTY return
        BOOL I8 I16 I32 CHAR8 CHAR16 CHAR32 case ValType .I32 return
        I64 case ValType .I64 return
        F32 case ValType .FLOAT return
        F64 case ValType .DOUBLE return
      end
      break
    intLiteral case
      t .intLiteral types.intLiteralAsInt context toValType return
    cType case
      t .cType
        types.cTypeAsType
      context toValType return
    pointer mutablePointer rawPointer mutableRawPointer case
      ValType .PTR return
    procedure arrayType struct union unionElement enum initializer case
      ValType .REFERENCE return
    undefined empty genericType autoType
    align typeSet case
      ValType .EMPTY return
  end
end


namespace: sb
  proc( stringBuilder : sb BranchId : branch -> stringBuilder ) =>: appendBranchId
    sb
      branch .branchType switch
        START case "@start" sb.appendS break
        NEXT case "@next" sb.appendS branch .id sb.appendI break
        ERROR case "@error" sb.appendS branch .id sb.appendI break
        LABEL case "@label_" sb.appendS branch .id sb.appendI break
        LABEL_PRE case "@label_pre" sb.appendS branch .id sb.appendI break
        END_INLINE case "@endInline" sb.appendS branch .id sb.appendI break
      end
    return
  end
end
proc(
  stringBuilder : sb
  BranchId : branch
  string : branchComment
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: startBranch
  branch context .currentBranch=
  sb
    branch sb.appendBranchId
    branchComment .length 0:iSize iSize.sgt if
      " ## " sb.appendS
      branchComment sb.appendStr
    end
    '\n' sb.appendC
  return
end
proc( ValType : valType CompilerContext ptr.mut : context -> i32 ) =>: pushValue
  context [] .stackCount =:: oldCount
    context .stackInfo
      oldCount
      valType
    StackElement new branchTree.push
    oldCount
      1 +
    context .stackCount=
  oldCount return
end
proc( CompilerContext ptr.mut : context -> i32 ) =>: nextValueId
  context [] .stackCount =:: oldCount
    oldCount 1 +
  context .stackCount=
  oldCount return
end
proc( ValType : valType i32 : offset CompilerContext ptr.mut : context -> i32 ) =>: replaceValue
  context nextValueId =:: newId
  context .stackInfo
    offset
  branchTree.replaceAt .data =:: stackElt
  newId stackElt .varId=
  valType stackElt .valType=
  newId return
end
proc(
  FilePosition : pos
  CompilerContext ptr.mut : context
-> i32 ) =>: popValue
  context .stackInfo branchTree.pop =:: tmp
  tmp .data ?? if
    tmp .data [] .varId return
  end
  "stack underflow" sb.copyPtr
  pos context [] .program .errors appendError
  -1 return
end
proc( CompilerContext ptr.mut : context -> i32 ) =>: nextTmpId
  context [] .tmpCount =:: oldCount
    oldCount
      1 +
    context .tmpCount=
  oldCount return
end
proc( CompilerContext ptr.mut : context -> i32 ) =>: nextJumpLabelId
  context [] .jumpLabelCount =:: oldCount
    oldCount
      1 +
    context .jumpLabelCount=
  oldCount return
end
proc( CompilerContext ptr.mut : context -> i32 ) =>: nextLocalConstId
  context [] .localConstCount =:: oldCount
    oldCount
      1 +
    context .localConstCount=
  oldCount return
end

proc( Type : t CompilerContext ptr.mut : context -> bool ) =>: referenceOnly
  context [] .program =:: program
  program .idContext .typeContext =:: typeContext
  t typeContext types.unwrapNamed
    ..dup .cType ?? if .cType types.cTypeAsType end
    ..dup .intLiteral ?? if .intLiteral types.intLiteralAsInt end
  =:: baseType
  baseType types.isPrimitive if
    false return
  end
  baseType typeContext types.isPointer if
    false return
  end
  ## TODO allow small composites as value-type
  true return
end
proc(
  types.TypeSize : size
  Type : t
  FilePosition : pos
  CompilerContext ptr.mut : context
-> i64 ) =>: typeSizeAsInt
  context [] .program =:: program
  program .errors =:: errors
  program .idContext .typeContext =:: typeContext
  size switch
    fixed case size .fixed return
    dynamicArray case
      "dynamic arrays are not supported in this context: " sb.copyPtr
         t typeContext sb.appendType
      pos errors appendError
      0 return
    unknown case
      "could not determine size of type: " sb.copyPtr
         t typeContext sb.appendType
      pos errors appendError
      0 return
  end
end
proc(
  Type : t
  FilePosition : pos
  CompilerContext ptr.mut : context
-> i64 ) =>: typeAlignmentInt
  context [] .program =:: program
  program .idContext .typeContext =:: typeContext
  t typeContext types.alignOf t pos context typeSizeAsInt return
end
proc(
  Type : t
  FilePosition : pos
  CompilerContext ptr.mut : context
-> i64 ) =>: typeSizeInt
  context [] .program =:: program
  program .idContext .typeContext =:: typeContext
  t typeContext types.sizeOf t pos context typeSizeAsInt return
end
proc(
  Type : t
  FilePosition : pos
  CompilerContext ptr.mut : context
-> i64 ) =>: typeStrideInt
  context [] .program =:: program
  program .idContext .typeContext =:: typeContext
  t typeContext types.strideOf t pos context typeSizeAsInt return
end
proc(
  Type : t
  i32 : i
  FilePosition : pos
  CompilerContext ptr.mut : context
-> i64 ) =>: tupleEltOffsetInt
  context [] .program =:: program
  program .errors =:: errors
  program .idContext .typeContext =:: typeContext
  t i typeContext types.tupleElementOffset =:: eltOffset?
  eltOffset? optional.hasData if
    eltOffset? .data return
  end
  "could not compute offset of element " sb.copyPtr
    i sb.appendI
    " in tuple " sb.appendS
    t typeContext sb.appendType
  pos errors appendError
  0 return
end
proc(
  Type : t
  FilePosition : pos
  CompilerContext ptr.mut : context
-> Type i64 ) =>: enumLabelInfoInt
  context [] .program =:: program
  program .errors =:: errors
  program .idContext .typeContext =:: typeContext
  t typeContext types.enumLabelInfo =:: labelOffset? =:: labelType
  labelOffset? optional.hasData if
    labelType labelOffset? .data return
  end
  "could not compute offset of label in enum " sb.copyPtr
    t typeContext sb.appendType
  pos errors appendError
  labelType 0 return
end

struct(
  string : blockName
  BlockId : blockId
  BranchId slice : branchIds
  FilePosition : pos
  CompilerContext ptr.mut : context
  stringBuilder ptr.mut : out
) =:: MergePoint
proc(
  StackElement ptr slice : toMerge
  i32 : offset
  MergePoint : mergePoint
-> StackElement ) =>: mergeBranches
  mergePoint .context =:: context
  context [] .program =:: program
  program .errors =:: errors
  program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  toMerge 0 [] =:: rootValue
  rootValue [] .varId =:: rootId
  true =:: mut: isMerged
  1:iSize while $ toMerge .length u< do =:: i
    toMerge i [] [] .varId rootId != if
      false isMerged=
      i break
    end
    i 1:iSize +
  end ..drop
  isMerged if
    rootValue [] return
  end
  1:iSize while ..dup toMerge .length u< do =:: i
    toMerge i [] [] .valType rootValue [] .valType != if
      "branches of " sb.copyPtr
         mergePoint .blockName sb.appendStr
         "-statement are out of sync expected: " sb.appendS
         rootValue [] .valType sb.appendValType
         " got: " sb.appendS
         toMerge i [] [] .valType sb.appendValType
      mergePoint .pos errors appendError
      i break
    end
    i 1:iSize +
  end ..drop
  context nextValueId =:: newId
  mergePoint .out []
    "%s" sb.appendS
    newId sb.appendI
    " =" sb.appendS
    rootValue [] .valType sb.appendValTypeQBE
    " phi " sb.appendS
    0:iSize while ..dup toMerge .length u< do =:: i
      i 0:iSize iSize.sgt if
        ", " sb.appendS
      end
      mergePoint .branchIds i [] sb.appendBranchId
      " %s" sb.appendS
      toMerge i [] [] .varId sb.appendI
      i 1:iSize +
    end ..drop
    '\n' sb.appendC
  mergePoint .out =[]
  ## StackElement
    newId
    rootValue [] .valType
  StackElement new return
end

proc( BlockInfo : block CompilerContext ptr.mut : context -> ) =>: openBlock
  context [] .openBlocks
    block list.append
  context .openBlocks=
end
proc(
  BlockId : blockId
  CompilerContext ptr.mut : context
-> ) =>: openIfBlock
  ## IfBlockInfo
    8 branchTree.NodeId list.create
    8 BranchId list.create
    8 branchTree.NodeId list.create
    8 BranchId list.create
    context [] .currentBranch
    context .stackInfo branchTree.startBranch
    -1:branchTree.NodeId
    blockId
    false
    false
  IfBlockInfo new BlockInfo .If context openBlock
end
proc(
  BlockId : blockId
  i32 : blockEnd
  CompilerContext ptr.mut : context
-> ) =>: openSwitchBlock
  ## SwitchBlockInfo
    16 branchTree.NodeId list.create
    16 BranchId list.create
    context .stackInfo branchTree.startBranch
    blockId
    blockEnd
  SwitchBlockInfo new BlockInfo .Switch context openBlock
end
proc(
  BlockId : blockId
  i32 : blockStart
  CompilerContext ptr.mut : context
-> ) =>: openWhileBlock
  ## WhileBlockInfo
    16 branchTree.NodeId list.create
    16 BranchId list.create
    16 branchTree.NodeId list.create
    16 BranchId list.create
    16 branchTree.NodeId list.create
    16 BranchId list.create
    context [] .tmpCount
    context .stackInfo branchTree.startBranch
    blockId
    blockStart
  WhileBlockInfo new BlockInfo .While context openBlock
  context [] .tmpCount
    context [] .program [] .whileData blockId i64 cast list.at .data [] .modifiedTypes +
  context .tmpCount=
end
proc(
  BlockId : blockId
  CompilerContext ptr.mut : context
-> ) =>: openAndOrBlock
  ## SwitchBlockInfo
    16 branchTree.NodeId list.create
    16 BranchId list.create
    blockId
  AndOrBlockInfo new BlockInfo .AndOr context openBlock
end

enum( WHILE SWITCH ) =:: BreakType
proc(
  BlockId : blockId
  BreakType : breakType
  FilePosition : pos
  CompilerContext ptr.mut : context
-> BlockInfo ptr.mut optional ) =>: findBreakableBlock
  context [] .program =:: program
  program .errors =:: errors
  context [] .openBlocks list.atReversed for =:: block
    breakType .WHILE and block [] .While ?? and
        block [] .While .blockId blockId == if
      block optional.wrap return
    end
    breakType .SWITCH and block [] .Switch ?? and
        block [] .Switch .blockId blockId == if
      block optional.wrap return
    end
  end
  "could not find target of break/continue " sb.copyPtr
  pos errors appendError
  BlockInfo ptr.mut optional.empty return
end

namespace: sb
  proc(
    stringBuilder : sb
    LabelId : label
    i32 : implId
    CompilerContext ptr.mut : context
  -> stringBuilder ) =>: appendGlobalName
    context [] .program =:: prog
    prog .idContext .typeContext .labelContext =:: labelContext
    sb
      '$' sb.appendC
      label labelContext id.labelFlags id.FLAG_EXTERN & ? if
        ## use unmodified name for extern values
        label labelContext sb.appendLabelName
        return
      end
      CONCAT_PREFIX sb.appendS
      label labelContext id.labelFlags id.FLAG_EXPORT & ? ! if
        label labelContext id.getLabelFile i64 cast sb.appendI
        "_F" sb.appendS
      end
      label labelContext sb.appendAsciifiedLabelPath
      implId 0 >= if
        "_I" sb.appendS
        implId sb.appendI
      end
    return
  end

  proc(
    Type : t
    CompilerContext ptr.mut : context
  -> i64 ) =>: getTypeId
    context .typeIds t map.get $ ? if
      .data return
    else ..drop
      context [] .typeIdCount
        context .typeIds t $2 map.put ..drop
        $ 1 + context .typeIdCount=
      return
    end
  end
  proc(
    stringBuilder : sb
    Type : t
    string : name
    bool : isStored
    CompilerContext ptr.mut : context
  -> stringBuilder ) =>: appendCompositeTypeQBE
    isStored if
      sb
        ":" sb.appendS
        name sb.appendStr
        t context getTypeId sb.appendI
      ## return
    else
      sb "l" sb.appendS return
    end
  end
end
  enum( STACK LOAD ULOAD STORE ) =:: StorageType
namespace: sb
  proc(
    stringBuilder : sb
    Type : t
    StorageType : storeType
    FilePosition : pos
    CompilerContext ptr.mut : context
  -> stringBuilder ) =>: appendTypeNameQBE
    context [] .program =:: prog
    prog .errors =:: errors
    prog .idContext .typeContext =:: typeContext
    typeContext .labelContext =:: labelContext
    t switch
      namedType case
        sb
          t typeContext types.unwrapNamed storeType pos context
        appendTypeNameQBE
        return
      generatedType case
        sb
          t typeContext types.getGeneratedType storeType pos context
        appendTypeNameQBE
        return
      primitiveType case
        t .primitiveType switch
          TYPE case sb ":type" sb.appendS return break
          BOOL case
            storeType switch
              STACK case sb "w" sb.appendS return
              LOAD ULOAD case sb "ub" sb.appendS return
              STORE case sb "b" sb.appendS return
            end
            break
          I8 CHAR8 case
            storeType switch
              STACK case sb "w" sb.appendS return
              LOAD case sb t .primitiveType .I8 if "sb" else "ub" end sb.appendS return
              ULOAD case sb "ub" sb.appendS return
              STORE case sb "b" sb.appendS return
            end
            break
          I16 CHAR16 case
            storeType switch
              STACK case sb "w" sb.appendS return
              LOAD case sb t .primitiveType .I16 if "sh" else "uh" end sb.appendS return
              ULOAD case sb "uh" sb.appendS return
              STORE case sb "h" sb.appendS return
            end
            break
          I32 CHAR32 case sb "w" sb.appendS return
          I64 case sb "l" sb.appendS return
          F32 case sb "s" sb.appendS return
          F64 case sb "d" sb.appendS return
        end
        break
      intLiteral case
        sb
          t .intLiteral types.intLiteralAsInt storeType pos context
        appendTypeNameQBE return
      cType case
        sb
          t .cType types.cTypeAsType
          ..dup .undefined ?? if
            ..drop.2 break
          end
        storeType pos context appendTypeNameQBE
        return
      pointer mutablePointer rawPointer mutableRawPointer procedure case
        sb "l" sb.appendS return
      arrayType case
        sb t "array":s storeType .STACK ! context appendCompositeTypeQBE return
        break
      struct case
        sb t "struct":s storeType .STACK ! context appendCompositeTypeQBE return
        break
      union case
        sb t "union":s storeType .STACK ! context appendCompositeTypeQBE return
        break
      unionElement case
        sb t typeContext types.getBaseType "union":s storeType .STACK ! context appendCompositeTypeQBE return
        break
      enum case
        sb t "enum":s storeType .STACK ! context appendCompositeTypeQBE return
        break
      undefined empty genericType autoType
      initializer align typeSet case
        break
    end
    "unsupported type " sb.copyPtr
      t typeContext sb.appendType
    pos errors appendError
    sb return
  end
  proc(
    stringBuilder : sb
    i32 : index
    LabelId : labelId
    CompilerContext ptr.mut : context
  -> stringBuilder ) =>: appendArgName
    sb
      "%a" sb.appendS
      index sb.appendI
    return
  end
  proc(
    stringBuilder : sb
    i32 : index
    CompilerContext ptr.mut : context
  -> stringBuilder ) =>: appendOutArgName
    sb
      "%o" sb.appendS
      index sb.appendI
    return
  end
  proc(
    stringBuilder : sb
    Type : procType
    FilePosition : pos
    CompilerContext ptr.mut : context
  -> stringBuilder ) =>: appendProcSignature
    context [] .program =:: prog
    prog .errors =:: errors
    prog .idContext .typeContext =:: typeContext
    typeContext .labelContext =:: labelContext
    procType typeContext types.getCallConvention =:: callConvention
    procType typeContext types.getProcIn .data =:: args
    procType typeContext types.getProcOutArgs =:: outArgs
    false =:: mut: hasArgs
    sb
      "(" sb.appendS
      outArgs .length 1:iSize - i32 cast.u while $ 0 >= do =:: i
          outArgs i [] =:: arg
          arg typeContext types.isEmpty if
            ## skip empty arguments
            continue
          end
          hasArgs if
            ',' sb.appendC
          end
          true hasArgs=
          "l " sb.appendS ## all out arguments are pointers
          i context appendOutArgName
      finally i 1 - end ..drop
      args .length 1:iSize - i32 cast.u while $ 0 >= do =:: i
        args i [] =:: mut: arg
        arg typeContext types.containsGeneric if
          arg typeContext types.isArray if
            arg
              false typeContext types.getAddressType
            arg=
          else arg typeContext types.isPointer ! _if
            "unexpected generic argument: " sb.copyPtr
              arg typeContext sb.appendType
            pos errors appendError
          end
        end
        procType i typeContext types.getProcArgLabel =:: label
        arg typeContext types.isEmpty if
          ## skip empty arguments
          continue
        end
        label labelContext id.labelFlags id.FLAG_STATIC & ? if
          continue
        end
        hasArgs if
          ',' sb.appendC
        end
        true hasArgs=
        arg StorageType .LOAD pos context appendTypeNameQBE
        ' ' sb.appendC
        i procType i typeContext types.getProcArgLabel context appendArgName
      finally i 1 - end ..drop
      ")" sb.appendS
    return
  end
  ## XXX? merge code for string and array constants
  proc(
    type : auto: T
    stringBuilder : sb
    T slice : value
    char8 : valueChar
    bool : nullTerminate
  -> stringBuilder ) =>: appendPrimitiveArrayConstQBE
    sb
      0:iSize while $ value .length u< do =:: i
        valueChar sb.appendC
        ' ' sb.appendC
        value i [] i64 cast.u 0xff & sb.appendI
        ',' sb.appendC
        i 1:iSize +
      end ..drop
      nullTerminate if
        "b 0" sb.appendS
      end
    return
  end
  proc(
    stringBuilder : sb
    string : value
    CompilerContext ptr.mut : context
  -> stringBuilder ) =>: appendStringPtrConstQBE
    sb
      '$' sb.appendC
      STRING_CONST_NAME sb.appendS
      context [] .stringConstants
        ..dup .length =:: strId
        value list.append
      context .stringConstants=
      strId sb.appendI
    return
  end
  proc(
    stringBuilder : sb
    ConstValue : value
    Type : valueType
    FilePosition : pos
    CompilerContext ptr.mut : context
  -> stringBuilder ) =>: appendPtrConstQBE
    value .Array ?? and value .Array .length 0:iSize == if
      sb 0 sb.appendI return ## pointer to zero length array -> NULL-pointer
    end
    sb
      '$' sb.appendC
      PTR_CONST_NAME sb.appendS
      context [] .ptrConstants
        $ .length =:: ptrId
        ## GlobalConst
          value
          valueType
          pos
        PtrConstant new list.append
      context .ptrConstants=
      ptrId sb.appendI
    return
  end
  proc(
    stringBuilder : sb
    PtrConstant ptr : constant
    CompilerContext ptr.mut : context
  -> stringBuilder ) =>: appendPtrConstDataQBE
    context [] .program =:: prog
    prog .idContext =:: idContext
    prog .errors =:: errors
    idContext .constContext =:: constContext
    idContext .typeContext =:: typeContext
    typeContext .labelContext =:: labelContext
    constant [] .value =:: value
    constant [] .valType types.isPrimitive or constant [] .valType .intLiteral ?? and
        ConstValue ..length 23:iSize == "no new constants" assert
        value switch
          Array8  case value .Array8  .length 0:iSize == break
          Array16 case value .Array16 .length 0:iSize == break
          Array32 case value .Array32 .length 0:iSize == break
          Array64 case value .Array64 .length 0:iSize == break
          Array   case value .Array   .length 0:iSize == break
          default false break
        end if ## zero length array as primitive type
      0 types.ArraySize .Int =:: size
      ## newArrayType
        constant [] .valType
        types.ArrayType .ARRAY
        size
      typeContext types.newArrayType .data
    else
      constant [] .valType
    end =:: valType
    sb
      valType
      value
      true
      constant [] .pos
    context appendConstQBE return
  end
  proc(
    stringBuilder : sb
    Type : t
    ConstValue : value
    bool : isGlobal
    FilePosition : pos
    CompilerContext ptr.mut : context
  -> stringBuilder ) =>: appendConstQBE
    context [] .program =:: prog
    prog .errors =:: errors
    prog .idContext .typeContext =:: typeContext
    typeContext .labelContext =:: labelContext
    prog .idContext .constContext =:: constContext
    sb
      isGlobal and t typeContext types.isPointer or
          t typeContext types.unwrapNamed types.isPrimitive or
          t .intLiteral ?? if
        ## add name prefix for global constants, skip prefix for zero-length array constants
        t StorageType .STORE pos context sb.appendTypeNameQBE
        ' ' sb.appendC
      end
      value switch
        Bool case
          value .Bool if '1' else '0' end sb.appendC return
        Int case
          t typeContext types.isPointer if
            ## treat pointer constants as integers of type iSize
            types.primitive.I_SIZE
          else
            t typeContext types.unwrapNamed
            ..dup .cType ?? if .cType types.cTypeAsType end
            ..dup .intLiteral ?? if .intLiteral types.intLiteralAsInt end
          end =:: numType
          numType types.isPrimitive if
            numType typeContext types.primitiveValue switch
              I8  CHAR8  case value .Int 0xff &   sb.appendI return
              I16 CHAR16 case value .Int 0xffff & sb.appendI return
              I32 CHAR32 case value .Int i32 cast sb.appendI return
              I64 case value .Int sb.appendI return
              F32 case value .Int f32 cast f32.bits sb.appendI return
              F64 case value .Int f64 cast f64.bits sb.appendI return
              BOOL TYPE case break
            end
          end
          "unexpected type for integer: " sb.copyPtr
            t typeContext sb.appendType
            " number-type: " sb.appendS
            numType typeContext sb.appendType
          pos errors appendError
          return
        break
        Char case value .Char i32 cast.u sb.appendI return
        break
        Float case
          t typeContext types.unwrapNamed
            ..dup .cType ?? if .cType types.cTypeAsType end
            ..dup .intLiteral ?? if .intLiteral types.intLiteralAsInt end
          =:: numType
          numType types.primitive.F32 types.typeEquals if
            value .Float f32 cast f32.bits sb.appendI
          else numType types.primitive.F64 types.typeEquals _if
            value .Float f64.bits sb.appendI
          else
            "unexpected type for float: " sb.copyPtr
              t typeContext sb.appendType
              " number-type: " sb.appendS
              numType typeContext sb.appendType
            pos errors appendError
          end
          return
        GenericArg case
          value .GenericArg pos context appendGenericArg return
        Array8 case
          t typeContext types.isPointer if
            ## appendPtrConstQBE
              value
              t typeContext types.ptrTarget
              pos
              context
            appendPtrConstQBE
            return
          end
          isGlobal ! if break end
          value .Array8 'b' false appendPrimitiveArrayConstQBE return
        Array16 case
          t typeContext types.isPointer if
            ## appendPtrConstQBE
              value
              t typeContext types.ptrTarget
              pos
              context
            appendPtrConstQBE
            return
          end
          isGlobal ! if break end
          value .Array16 'h' false appendPrimitiveArrayConstQBE return
        Array32 case
          t typeContext types.isPointer if
            ## appendPtrConstQBE
              value
              t typeContext types.ptrTarget
              pos
              context
            appendPtrConstQBE
            return
          end
          isGlobal ! if break end
          value .Array32 'w' false appendPrimitiveArrayConstQBE return
        Array64 case
          t typeContext types.isPointer if
            ## appendPtrConstQBE
              value
              t typeContext types.ptrTarget
              pos
              context
            appendPtrConstQBE
            return
          end
          isGlobal ! if break end
          value .Array64 'l' false appendPrimitiveArrayConstQBE return
        Array case
          t typeContext types.isPointer if
            ## appendPtrConstQBE
              value
              t typeContext types.ptrTarget
              pos
              context
            appendPtrConstQBE
            return
          end
          isGlobal ! if break end
          t =:: containerType
          containerType typeContext types.isArray if
            containerType typeContext types.getBaseType =:: eltType
            eltType pos context typeSizeInt =:: eltSize
            eltType pos context typeStrideInt =:: eltStride
            value .Array =:: elts
            0:iSize while $ elts .length u< do =:: i
              i 0:iSize != if
                ',' sb.appendC
              end
              eltType elts i [] true pos context appendConstQBE
              eltSize eltStride < if
                ",z " sb.appendS
                eltStride eltSize - sb.appendI
              end
              i 1:iSize +
            end ..drop
            return
          else containerType typeContext types.isTuple _if
            ## TODO ensure elements are ordered by memory location
            containerType typeContext types.compositeElts =:: types
            value .Array =:: elts
            0:i64 =:: mut: offset
            0:i32 while $ iSize cast.u elts .length u< do =:: i
              types i [] =:: elt
              containerType i pos context tupleEltOffsetInt =:: eltOffset
              i 0 > if
                ',' sb.appendC
              end
              offset eltOffset < if
                "z " sb.appendS
                eltOffset offset - sb.appendI
                ',' sb.appendC
                eltOffset offset=
              end
              ## appendConstQBE
                elt
                elts i []
                true
                pos
              context appendConstQBE
              offset
                elt pos context typeSizeInt +
              offset=
              i 1 +
            end ..drop
            containerType pos context typeSizeInt =:: size
            offset size < if
              ",z " sb.appendS
              size offset - sb.appendI
            end
            return
          else
            "unsupported type for array constant: " sb.copyPtr
              t typeContext sb.appendType
              " expected array or tuple" sb.appendS
            pos errors appendError
            return
          end
          break
        EnumLabel Union case
          isGlobal ! if
            break ## XXX? support small unions as local constants
          end
          t typeContext types.isEnum ! and t typeContext types.isUnion ! if
            "unsupported type for union constant: " sb.copyPtr
              t typeContext sb.appendType
              " expected enum or union" sb.appendS
            pos errors appendError
            return
          end
          t pos context enumLabelInfoInt =:: labelOffset =:: labelType
          value .EnumLabel ?? if
            value .EnumLabel
          else
            value .Union .eltIndex
          end =:: eltIndex
          eltIndex 0 < if break end
          eltIndex t typeContext types.compositeEltCount >= if
            break
          end
          t eltIndex typeContext types.compositeGetElement =:: eltType
          0:i64 =:: mut: offset
          false =:: mut: needComma
          eltType typeContext types.isEmpty ! if
            value .Union ?? ! if
              "missing element value for union constant" sb.copyPtr
              pos errors appendError
            else
              ## appendConstQBE
                eltType
                value eltIndex constUnionElement if
                  "union element index out of sync: expected " sb.copyPtr
                    eltIndex sb.appendI
                    " got " sb.appendS
                    value .Union .eltIndex sb.appendI
                  pos errors appendError
                end
                isGlobal
                pos
                context
              appendConstQBE
              offset
                eltType pos context typeSizeInt +
              offset=
              true needComma=
            end
          end
          t pos context typeSizeInt =:: size
          offset labelOffset < if
            needComma if ',' sb.appendC end
            "z " sb.appendS
            labelOffset offset - sb.appendI
            true needComma=
          end
          labelType typeContext types.isEmpty ! if
            needComma if ',' sb.appendC end
            ## appendConstQBE
              labelType
              eltIndex i64 cast.u ConstValue .Int
              isGlobal
              pos
              context
            appendConstQBE
          end
          return
        Procedure case
          ## appendGlobalName
            prog [] .procedures
              value .Procedure i64 cast
            list.at .data [] .labelId
            -1
          context appendGlobalName
          return
        None WildCard TypeId LocalValue LocalArray
            LocalArray8 LocalArray16 LocalArray32 LocalArray64
            ProcedureBundle case
        break
      end
      isGlobal if
        "unsupported constant: " sb.copyPtr
          value typeContext sb.appendConstant
        pos errors appendError
        return
      end
      context nextLocalConstId =:: constId
      context [] .localConstants
        ## LocalConst
          t
          value
          pos
          constId
        LocalConst new list.append
      context .localConstants=
      "$" sb.appendS
      LOCAL_CONST_NAME sb.appendS
      constId sb.appendI
    return
  end
  proc(
    stringBuilder : sb
    FilePosition : pos
    CompilerContext ptr.mut : context
  -> stringBuilder ) =>: appendLocalConstants
    context [] .program .idContext .typeContext =:: typeContext
    sb
      context [] .localConstants for =:: constant
        "data $" sb.appendS
        LOCAL_CONST_NAME sb.appendS
        constant .id sb.appendI
        " = align " sb.appendS
        constant .valType pos context typeAlignmentInt sb.appendI
        " {" sb.appendS
        constant .valType constant .value true constant .pos context appendConstQBE
        "}\n" sb.appendS
      end
      context [] .localConstants
        list.clear
      context .localConstants=
    return
  end

  proc(
    stringBuilder : sb
    Type : t
    FilePosition : pos
    CompilerContext ptr.mut : context
  -> stringBuilder ) =>: startTypeDeclaration
    sb
      "type " sb.appendS
      t StorageType .LOAD pos context appendTypeNameQBE
      " = align " sb.appendS
      t pos context typeAlignmentInt sb.appendI
      " {" sb.appendS
    return
  end
  proc(
    stringBuilder : sb
    Type : t
    FilePosition : pos
    CompilerContext ptr.mut : context
  -> stringBuilder ) =>: startEltTypeDeclaration
    sb
      "type " sb.appendS
      t StorageType .LOAD pos context appendTypeNameQBE
      "_elt = align " sb.appendS
      t pos context typeAlignmentInt sb.appendI
      " {" sb.appendS
    return
  end
  proc(
    stringBuilder : sb
    Type : t
    FilePosition : pos
    CompilerContext ptr.mut : context
  -> stringBuilder ) =>: eltTypeName
    sb
      t StorageType .LOAD pos context appendTypeNameQBE
      "_elt" sb.appendS
    return
  end
  proc(
    stringBuilder
  -> stringBuilder ) =>: endTypeDeclaration
    "}\n" sb.appendS return
  end
  proc(
    stringBuilder : sb
    Type : t0
    FilePosition : pos
    CompilerContext ptr.mut : context
  -> stringBuilder ) =>: appendNestedTypeDeclarationQBE
    context [] .program =:: prog
    prog .errors =:: errors
    prog .idContext .typeContext =:: typeContext
    typeContext .labelContext =:: labelContext
    prog .idContext .constContext =:: constContext
    t0 typeContext types.unwrapNamed =:: t
    t typeContext types.isArray if
      t typeContext types.getArraySize =:: size
      size .Int ?? ! if
        sb return ## no declaration for var-size array
      end
      t typeContext types.getBaseType =:: baseType
      baseType pos context typeSizeInt =:: baseSize
      baseType pos context typeStrideInt =:: baseStride
      sb
        baseType types.isPrimitive or baseType typeContext types.isPointer if
          ## appendTypeNameQBE
            baseType
            StorageType .STORE
            pos
          context sb.appendTypeNameQBE
        else
          t pos context eltTypeName
        end
        ' ' sb.appendC
        size .Int sb.appendI
      return
    end
    t typeContext types.isTuple if
      t typeContext types.compositeElts =:: elts
      0:i64 =:: mut: offset
      false =:: mut: hasElt
      sb
        0:i32 while $ iSize cast.u elts .length u< do =:: i
          elts i [] =:: elt
          elt typeContext types.isEmpty if
            i 1 + continue
          end
          t i pos context tupleEltOffsetInt =:: eltOffset
          hasElt if
            ',' sb.appendC
          end
          true hasElt=
          offset eltOffset <= "offset <= eltOffset" assert
          offset eltOffset < if
            "b " sb.appendS
            eltOffset offset - sb.appendI
            ',' sb.appendC
            eltOffset offset=
          end
          ## appendNestedTypeDeclarationQBE
            elt
            pos
          context sb.appendNestedTypeDeclarationQBE
          offset
            elt pos context typeSizeInt +
          offset=
          i 1 +
        end ..drop
        t pos context typeSizeInt =:: size
        offset size < if
          ",b " sb.appendS
          size offset - sb.appendI
        end
      return
    end
    t typeContext types.isEnum if
      sb
        ## appendTypeNameQBE
          t typeContext types.enumLabelInfo ..drop
          StorageType .STORE
          pos
        context sb.appendTypeNameQBE
      return
    end
    t typeContext types.isUnion if
      t typeContext types.isTaggedUnion =:: isTagged
      t typeContext types.compositeElts =:: elts
      false =:: mut: hasElt
      0:i64 =:: mut: bodySize
      t pos context enumLabelInfoInt =:: labelOffset =:: labelType
      sb
        -1:iSize =:: mut: nonEmptyIndex
        0:iSize =:: mut: nonEmptyCount
        elts .length for =:: i
          elts i [] =:: elt
          elt typeContext types.isEmpty if continue end
          nonEmptyCount 1:iSize + nonEmptyCount=
          i nonEmptyIndex=
        end
        nonEmptyCount 0:iSize != "non-empty union has non-empty element" assert
        nonEmptyCount 1:iSize == if
          elts nonEmptyIndex [] =:: elt
          ## appendNestedTypeDeclarationQBE
            elt
            pos
          context sb.appendNestedTypeDeclarationQBE
          ',' sb.appendC
          elt pos context typeSizeInt =:: eltSize
          eltSize labelOffset < if
            "b " sb.appendS
            labelOffset eltSize - sb.appendI
            ',' sb.appendC
          end
        else
          "b " sb.appendS
          labelOffset sb.appendI
          ',' sb.appendC
        end
        ## appendTypeNameQBE
          labelType
          StorageType .STORE
          pos
        context sb.appendTypeNameQBE
      return
    end
    sb
      ## appendTypeNameQBE
        t
        StorageType .STORE
        pos
      context sb.appendTypeNameQBE
    return
  end
  proc(
    stringBuilder : sb
    Type : t
    FilePosition : pos
    CompilerContext ptr.mut : context
  -> stringBuilder ) =>: appendTypeDeclarationQBE
    context [] .program =:: prog
    prog .errors =:: errors
    prog .idContext .typeContext =:: typeContext
    typeContext .labelContext =:: labelContext
    prog .idContext .constContext =:: constContext
    t types.isNamedType or t types.isGeneratedType if
      sb return ## ignore named types
    end
    t typeContext types.isEmpty if
      sb return ## ignore empty types
    end
    t typeContext types.containsGeneric if
      sb return ## ignore generic types
    end
    t typeContext types.isArray if
      t typeContext types.getBaseType =:: baseType
      baseType pos context typeSizeInt =:: baseSize
      baseType pos context typeStrideInt =:: baseStride
      sb
        baseType types.isPrimitive ! and baseType typeContext types.isPointer ! if
          t pos context startEltTypeDeclaration
            ## appendNestedTypeDeclarationQBE
              baseType
              pos
            context sb.appendNestedTypeDeclarationQBE
            ",b " sb.appendS
            baseStride baseSize - sb.appendI
          endTypeDeclaration
        end
        t pos context startTypeDeclaration
        t pos context sb.appendNestedTypeDeclarationQBE
      endTypeDeclaration return
    end
    t typeContext types.isTuple or t typeContext types.isUnion or t typeContext types.isEnum if
      sb
        t pos context startTypeDeclaration
        t pos context sb.appendNestedTypeDeclarationQBE
      endTypeDeclaration return
    end
    sb return
  end
  proc(
    stringBuilder : sb
    FilePosition : pos
  -> stringBuilder ) =>: appendPosQBE
    sb
      "dbgloc " sb.appendS
      pos .line sb.appendI
      ',' sb.appendC
      pos .posInLine sb.appendI
      " ## " sb.appendS
      pos .fileName sb.appendEscapedStrC
      '\n' sb.appendC
    return
  end
end

proc( string : fileName ProgramContext ptr : prog -> FileId ) =>: findFileId
  prog [] .progFiles .length for =:: i
    prog [] .progFiles i list.at .data [] .fileName sb.asStr =:: currentName
    fileName currentName string.eq if
      i FileId cast return
    end
  end
  FILE_ID_NONE return
end

proc(
  stringBuilder : sb
  FilePosition : pos
  ProgramContext ptr : prog
-> stringBuilder ) =>: appendPosPrintfArgs
  sb
    ",l " sb.appendS
    pos .fileName .length sb.appendI
    ",l $" sb.appendS
    FILE_NAME_NAME sb.appendS
    pos .fileName prog findFileId i64 cast sb.appendI
    ",w " sb.appendS
    pos .line sb.appendI
    ",w " sb.appendS
    pos .posInLine sb.appendI
  return
end

proc(
  stringBuilder
  LabelId  : labelId
  FilePosition : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: appendGenericArg
  context [] .program =:: prog
  prog .errors =:: errors
  prog .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  context [] .currentProc
    labelId
    typeContext
  types.findProcArgLabel $ optional.hasData if .data =:: index
    ## appendArgName
      index
      labelId
      context
    sb.appendArgName return
  end ..drop
  "cannot find generic argument: " sb.copyPtr
    labelId labelContext sb.appendLabelName
  pos errors appendError
end

union( i64 : constant i32 : stackId LabelId : autoArg i32 : localId i32 : tmpId ) =:: IntValue
proc(
  stringBuilder : sb
  ValType : valType
  char8 : valStackType
  i32 : valId
  string : cmpType
  IntValue : value
  BranchId : ifBranch
  BranchId : elseBranch
  FilePosition : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: appendCmpInt
  context nextTmpId =:: tmpId
  sb
    "%t" sb.appendS
    tmpId sb.appendI
    " =w c" sb.appendS
    cmpType sb.appendStr
    valType sb.appendValTypeQBE
    " %" sb.appendS
    valStackType sb.appendC
    valId sb.appendI
    ", " sb.appendS
    value switch
      constant case value .constant sb.appendI break
      stackId case "%s" sb.appendS value .stackId sb.appendI break
      localId case "%l" sb.appendS value .localId sb.appendI break
      tmpId case "%t" sb.appendS value .tmpId sb.appendI break
      autoArg case value .autoArg pos context appendGenericArg break
    end
    "\njnz %t" sb.appendS
    tmpId sb.appendI
    ", " sb.appendS
    ifBranch sb.appendBranchId
    ", " sb.appendS
    elseBranch sb.appendBranchId
    "\n" sb.appendS
  return
end

proc(
  stringBuilder : sb
  Type : enumType
  i32 : valId
  FilePosition : pos
  CompilerContext ptr.mut : context
-> stringBuilder i32 ValType ) =>: loadEnumLabel
  context [] .program =:: prog
  prog .errors =:: errors
  prog .idContext =:: idContext
  idContext .typeContext =:: typeContext
  enumType pos context enumLabelInfoInt =:: labelOffset =:: labelType
  labelType typeContext types.primitiveValue types.sizeOfPrimitive =:: numBytes
  context nextTmpId =:: labelPtr
  context nextTmpId =:: mut: label
  sb
    "%t" sb.appendS
    labelPtr sb.appendI
    " =l add %s" sb.appendS
    valId sb.appendI
    ", " sb.appendS
    labelOffset sb.appendI
    "\n%t" sb.appendS
    label sb.appendI
    " =w load" sb.appendS
    labelType StorageType .ULOAD pos context sb.appendTypeNameQBE
    " %t" sb.appendS
    labelPtr sb.appendI
    numBytes 4 < if
      label =:: oldLabel
      context nextTmpId label=
      "\n%t" sb.appendS
      label sb.appendI
      " =w ext" sb.appendS
      labelType StorageType .ULOAD pos context sb.appendTypeNameQBE
      " %t" sb.appendS
      oldLabel sb.appendI
    end
    '\n' sb.appendC
  label ValType .I32 return
end
proc(
  stringBuilder : sb
  Type : enumType
  char8  : stackType
  i32 : valId
  i32 : newLabel
  FilePosition : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: storeEnumLabel
  context [] .program =:: prog
  prog .errors =:: errors
  prog .idContext =:: idContext
  idContext .typeContext =:: typeContext
  enumType pos context enumLabelInfoInt =:: labelOffset =:: labelType
  labelType .empty ?? if sb return end
  context nextTmpId =:: labelPtr
  sb
    "%t" sb.appendS
    labelPtr sb.appendI
    " =l add %" sb.appendS
    stackType sb.appendC
    valId sb.appendI
    ", " sb.appendS
    labelOffset sb.appendI
    "\nstore" sb.appendS
    labelType StorageType .STORE pos context sb.appendTypeNameQBE
    ' ' sb.appendC
    newLabel sb.appendI
    ", %t" sb.appendS
    labelPtr sb.appendI
    '\n' sb.appendC
  return
end
proc(
  stringBuilder : sb
  Type : enumType
  i32 : valId
  i32 : expectedIndex
  FilePosition : pos
  CompilerContext ptr.mut : context
-> stringBuilder i32 i32 ValType ) =>: checkEnumIndex
  context [] .program =:: prog
  prog .errors =:: errors
  prog .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  sb
    ## loadEnumLabel
      enumType
      valId
      pos
    context loadEnumLabel =:: labelType =:: labelId
    context nextTmpId =:: c
    "%t" sb.appendS
    c sb.appendI
    " =w ceq" sb.appendS
    labelType sb.appendValTypeQBE
    " %t" sb.appendS
    labelId sb.appendI
    ", " sb.appendS
    expectedIndex sb.appendI
    '\n' sb.appendC
  c labelId labelType return
end

proc(
  stringBuilder : sb
  Type : enumType
  i32 : valId
  i32 : expectedIndex
  FilePosition : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: appendEnumCheck
  context [] .program =:: prog
  prog .errors =:: errors
  prog .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  ## BranchId
    BranchType .ERROR
    context nextJumpLabelId
  BranchId new =:: errorBranch
  ## BranchId
    BranchType .NEXT
    context nextJumpLabelId
  BranchId new =:: okBranch
  sb
    "## check enum \n" sb.appendS
    enumType valId expectedIndex pos context checkEnumIndex =:: labelType =:: label =:: c
    "jnz %t" sb.appendS
    c sb.appendI
    ", " sb.appendS
    okBranch sb.appendBranchId
    ", " sb.appendS
    errorBranch sb.appendBranchId
    '\n' sb.appendC
    errorBranch sb.appendBranchId
    "\ncall $printf (l $" sb.appendS
    CHECK_ENUM_FORMAT sb.appendS
    ", ...," sb.appendS
    labelType sb.appendValTypeQBE
    " %t" sb.appendS
    label sb.appendI
    ",w " sb.appendS
    expectedIndex sb.appendI
    pos prog appendPosPrintfArgs
    ")\n" sb.appendS
    "call $exit (w 1)\nhlt\n" sb.appendS ## use exit for flushing stdout
    okBranch "checkEnum":s context startBranch
  return
end

proc(
  stringBuilder : sb
  Type : tupleType
  i32 : tupleId
  FilePosition : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: flattenTupleQBE
  context [] .program =:: prog
  prog .idContext =:: idContext
  idContext .typeContext =:: typeContext
  tupleType typeContext types.compositeElts =:: elts
  sb
    0:i32 while $ iSize cast.u elts .length u< do =:: i
      elts i [] =:: eltType
      eltType context toValType =:: eltValType
      tupleType i pos context tupleEltOffsetInt =:: eltOffset
      eltType typeContext types.isEmpty if
        i 1 - continue
      end
      "%t" sb.appendS
        context nextTmpId =:: eltPtrId
      eltPtrId sb.appendI
      " =l add %s" sb.appendS
      tupleId sb.appendI
      ", " sb.appendS
      eltOffset sb.appendI
      '\n' sb.appendC
      eltValType context pushValue =:: eltId
      "%s" sb.appendS
      eltId sb.appendI
      eltType context referenceOnly if
        eltType pos context false appendAlloc ..drop
        "blit %t" sb.appendS
      else
        " =" sb.appendS
        eltValType sb.appendValTypeQBE
        " load" sb.appendS
        eltType StorageType .LOAD pos context sb.appendTypeNameQBE
        " %t" sb.appendS
      end
      eltPtrId sb.appendI
      eltType context referenceOnly if
        ", %s" sb.appendS
        eltId
        sb.appendI
        ',' sb.appendC
        eltType pos context typeSizeInt sb.appendI
      end
      '\n' sb.appendC
      i 1 +
    end ..drop
  return
end
proc(
  stringBuilder : sb
  Type : tupleType
  char8 : dataPtrType
  i32 : dataPtrId
  FilePosition : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: initializeTupleQBE
  context [] .program =:: prog
  prog .idContext =:: idContext
  idContext .typeContext =:: typeContext
  tupleType typeContext types.compositeElts =:: elts
  sb
    elts .length 1:iSize - i32 cast while ..dup 0 >= do =:: i
      elts i [] =:: eltType
      tupleType i pos context tupleEltOffsetInt =:: eltOffset
      eltType typeContext types.isEmpty if
        i 1 - continue
      end
      "%t" sb.appendS
        context nextTmpId =:: eltPtrId
      eltPtrId sb.appendI
      " =l add %" sb.appendS
      dataPtrType sb.appendC
      dataPtrId sb.appendI
      ", " sb.appendS
      eltOffset sb.appendI
      '\n' sb.appendC
      eltType context referenceOnly if
        "blit %s" sb.appendS
      else
        "store" sb.appendS
        eltType StorageType .STORE pos context sb.appendTypeNameQBE
        " %s" sb.appendS
      end
      pos context popValue sb.appendI
      ", %t" sb.appendS
      eltPtrId sb.appendI
      eltType context referenceOnly if
        ',' sb.appendC
        eltType pos context typeSizeInt sb.appendI
      end
      '\n' sb.appendC
      i 1 -
    end ..drop
  return
end
## TODO move all (?most) allocations to start of procedure
proc(
  stringBuilder : sb
  Type : valType
  FilePosition : pos
  CompilerContext ptr.mut : context
  bool : createId
-> stringBuilder i32 ) =>: appendAlloc
  context [] .program =:: prog
  prog .idContext =:: idContext
  idContext .typeContext =:: typeContext
  -1:i32 =:: mut: tmpId
  sb
    createId if
      context nextTmpId tmpId=
      "%t" sb.appendS
      tmpId sb.appendI
    end
    " =l alloc" sb.appendS
    valType pos context typeAlignmentInt 4 i64.max sb.appendI
    ' ' sb.appendC
    valType pos context typeSizeInt  4 i64.max sb.appendI
    '\n' sb.appendC
  tmpId return
end

proc(
  stringBuilder : sb
  ValType : valType
  i32 : valId
  JumpDistance : defaultJumpDistance
  LabelData slice : labels
  JumpDistance slice.mut : caseJumpDistances
  i32 : opIndex
  i64 optional : lower
  i64 optional : upper
  FilePosition : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: appendSwitchJumpTree
  labels .length 3:iSize u<= if
    false =:: mut: contiguous
    labels .length =:: mut: loopCount
    lower optional.hasData and upper optional.hasData and
        upper .data lower .data - labels .length i64 cast.u == contiguous=
        contiguous if
      loopCount 1:iSize - loopCount=
    end
    sb
      0:iSize while ..dup loopCount u< do =:: i
        labels i slice.at .data [] .caseId =:: caseId
        ## BranchId
          BranchType .LABEL
          opIndex caseJumpDistances caseId [] i32 cast +
        BranchId new =:: caseBranch
        ## BranchId
          BranchType .NEXT
          context nextJumpLabelId
        BranchId new =:: nextBranch
        labels i [] .value switchLabelAsInt =:: cmpVal
        ## cmp int
          valType
          't' valId
          "eq":s
          cmpVal IntValue .constant
          caseBranch
          nextBranch
        pos context appendCmpInt
        nextBranch sb.appendBranchId
        '\n' sb.appendC
        i 1:iSize +
      end ..drop
      "jmp " sb.appendS
      contiguous if
        labels loopCount slice.at .data [] .caseId =:: caseId
        ## BranchId
          BranchType .LABEL
          opIndex caseJumpDistances caseId [] i32 cast +
        BranchId new sb.appendBranchId
        '\n' sb.appendC
      else
        ## BranchId
          BranchType .LABEL
          opIndex defaultJumpDistance i32 cast +
        BranchId new sb.appendBranchId
        '\n' sb.appendC
      end
    return
  end
  labels .length 2:iSize / =:: p
  ## BranchId
    BranchType .NEXT
    context nextJumpLabelId
  BranchId new =:: ltBranch
  ## BranchId
    BranchType .NEXT
    context nextJumpLabelId
  BranchId new =:: geBranch
  labels p [] .value switchLabelAsInt =:: cmpVal
  labels p slice.cutIndex =:: lElts =:: rElts
  sb
    ## cmp int
      valType
      't' valId
      "slt":s
      cmpVal IntValue .constant
      ltBranch
      geBranch
    pos context appendCmpInt
    ltBranch sb.appendBranchId
    '\n' sb.appendC
    ## appendSwitchJumpTree
      valType
      valId
      defaultJumpDistance
      lElts
      caseJumpDistances
      opIndex
      lower
      upper optional.isEmpty if
        cmpVal optional.wrap
      else
        upper .data cmpVal i64.min optional.wrap
      end
      pos context
    appendSwitchJumpTree
    geBranch sb.appendBranchId
    '\n' sb.appendC
    ## appendSwitchJumpTree
      valType
      valId
      defaultJumpDistance
      rElts
      caseJumpDistances
      opIndex
      lower optional.isEmpty if
        cmpVal optional.wrap
      else
        lower .data cmpVal i64.max optional.wrap
      end
      upper
      pos context
    appendSwitchJumpTree
  return
end
proc(
  stringBuilder : sb
  Type : switchType
  i32 : valId
  JumpDistance : defaultJumpDistance
  LabelData list : labels ## switch labels (sorted by type-checker)
  JumpDistance slice.mut : caseJumpDistances
  i32 : opIndex
  FilePosition : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: appendSwitchTable
  context [] .program =:: prog
  prog .errors =:: errors
  prog .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  ValType : valType
  i32 : tmpId
  sb
    "## switch\n" sb.appendS
    switchType typeContext types.isTaggedUnion if
      ## loadEnumLabel
        switchType
        valId
        pos
      context loadEnumLabel valType= tmpId=
    else switchType typeContext types.isInt or switchType typeContext types.isChar _if
      switchType
        typeContext types.primitiveValue
      types.sizeOfPrimitive =:: numBytes
      context nextTmpId tmpId=
      switchType context toValType valType=
      "%t" sb.appendS
      tmpId sb.appendI
      " =" sb.appendS
      valType sb.appendValTypeQBE
      numBytes 4 < if
        " ext" sb.appendS
        switchType
          StorageType .ULOAD
        pos context sb.appendTypeNameQBE
        " %s" sb.appendS
      else
        " copy %s" sb.appendS
      end
      valId sb.appendI
      '\n' sb.appendC
    else
      "unsupported type in switch: " sb.copyPtr
        switchType typeContext sb.appendType
      pos errors appendError
      return
    end
    ## appendJumpTable
      valType
      tmpId
      defaultJumpDistance
      labels list.asSlice
      caseJumpDistances
      opIndex
      i64 optional.empty
      i64 optional.empty
      pos context
    appendSwitchJumpTree
  return
end

proc(
  stringBuilder : sb
  string : name
  ValType : valType
  FilePosition : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: appendUnaryOperator
  pos context popValue =:: arg
  sb
    "%s" sb.appendS
    valType context pushValue sb.appendI
    " =" sb.appendS
    valType sb.appendValTypeQBE
    ' ' sb.appendC
    name sb.appendStr
    " %s" sb.appendS
    arg sb.appendI
    '\n' sb.appendC
  return
end
proc(
  stringBuilder : sb
  string : name
  ValType : valType
  FilePosition : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: appendBinaryOperator
  pos context popValue =:: arg2
  pos context popValue =:: arg1
  sb
    "%s" sb.appendS
    valType context pushValue sb.appendI
    " =" sb.appendS
    valType sb.appendValTypeQBE
    ' ' sb.appendC
    name sb.appendStr
    " %s" sb.appendS
    arg1 sb.appendI
    ", %s" sb.appendS
    arg2 sb.appendI
    '\n' sb.appendC
  return
end
proc(
  stringBuilder : sb
  string : name
  ValType : resValue
  ValType : arg2Value
  bool : signed
  FilePosition : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: appendMixedDivisionOperator
  pos context popValue =:: arg2
  pos context popValue =:: arg1
  context nextTmpId =:: tmpId
  sb
    "%t" sb.appendS
    tmpId sb.appendI
    " =" sb.appendS
    resValue sb.appendValTypeQBE
    " ext" sb.appendS
    signed if 's' else 'u' end sb.appendC
    arg2Value sb.appendValTypeQBE
    " %s" sb.appendS
    arg2 sb.appendI
    '\n' sb.appendC
    "%s" sb.appendS
    resValue context pushValue sb.appendI
    " =" sb.appendS
    resValue sb.appendValTypeQBE
    ' ' sb.appendC
    name sb.appendStr
    " %s" sb.appendS
    arg1 sb.appendI
    ", %t" sb.appendS
    tmpId sb.appendI
    '\n' sb.appendC
  return
end
proc(
  stringBuilder : sb
  string : cmpType
  ValType : valType
  FilePosition : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: appendComparisonOperator
  pos context popValue =:: arg2
  pos context popValue =:: arg1
  sb
    "%s" sb.appendS
    ValType .I32 context pushValue sb.appendI
    " =w c" sb.appendS
    cmpType sb.appendStr
    valType sb.appendValTypeQBE
    " %s" sb.appendS
    arg1 sb.appendI
    ", %s" sb.appendS
    arg2 sb.appendI
    '\n' sb.appendC
  return
end
proc(
  stringBuilder : sb
  Type : src
  bool : signed
  FilePosition : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: extendArguments
  i32 2 array new =:: mut: args
  context [] .program =:: prog
  prog .idContext =:: idContext
  idContext .typeContext =:: typeContext
  src typeContext types.unwrapNamed .cType ?? if
    sb
      src typeContext types.unwrapNamed .cType types.cTypeAsType
      signed
      pos
      context
    extendArguments return
  end
  src typeContext types.unwrapNamed .intLiteral ?? if
    sb
      src typeContext types.unwrapNamed .intLiteral types.intLiteralAsInt
      signed
      pos
      context
    extendArguments return
  end
  src typeContext types.isInt ! if
    sb return
  end
  src typeContext types.primitiveValue types.sizeOfPrimitive 4 >= if
    sb return
  end
  pos context popValue args@ 1 =[]
  pos context popValue args@ 0 =[]
  sb
    0 while ..dup 2 < do =:: i
      "%s" sb.appendS
      ValType .I32 context pushValue sb.appendI
      " =w ext" sb.appendS
      signed if 's' else 'u' end sb.appendC
      src StorageType .STORE pos context sb.appendTypeNameQBE
      " %s" sb.appendS
      args@ i [] sb.appendI
      '\n' sb.appendC
      i 1 +
    end ..drop
  return
end

proc(
  stringBuilder : sb
  BuiltIn : builtIn
  Type : opType
  FilePosition : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: appendBuiltInQBE
  context [] .program =:: prog
  prog .errors =:: errors
  prog .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  opType typeContext types.getProcIn .data =:: inTypes
  inTypes .length 0:iSize != if
    opType 0 typeContext types.getProcArgLabel
        labelContext id.labelFlags id.FLAG_STATIC & ? if
      1:i32
    else
      0:i32
    end =:: firstArg
    inTypes firstArg []
  else
      opType typeContext types.getProcOut .data =:: outTypes
      outTypes .length 0:iSize != _if
    outTypes 0 []
  else
    Type .undefined
  end =:: baseType
  baseType context toValType =:: baseVal
  builtIn switch
    NEG_I8 NEG_I16 NEG_I32 NEG_I64 NEG_F32 NEG_F64 case
      sb "neg":s baseVal pos context appendUnaryOperator
      return
    ADD_I8 ADD_I16 ADD_I32 ADD_I64 ADD_F32 ADD_F64 case
      sb "add":s baseVal pos context appendBinaryOperator
      return
    SUB_I8 SUB_I16 SUB_I32 SUB_I64 SUB_F32 SUB_F64 C8_DIFF C16_DIFF C32_DIFF case
      sb "sub":s baseVal pos context appendBinaryOperator
      return ## TODO ensure char-diff arguments are zero extended
    MUL_I32 MUL_I64 MUL_F32 MUL_F64 case
      sb "mul":s baseVal pos context appendBinaryOperator
      return
    DIV_I32  DIV_I64 DIV_F32 DIV_F64 case
      sb "div":s baseVal pos context appendBinaryOperator
      return
    DIV_I64I32 case
      sb "div":s baseVal ValType .I32 true pos context appendMixedDivisionOperator
      return
    REM_I32 REM_I64 case
      sb "rem":s baseVal pos context appendBinaryOperator
      return
    REM_I64I32 case
      sb "rem":s baseVal ValType .I32 true pos context appendMixedDivisionOperator
      return
    UDIV_I32 UDIV_I64 case
      sb "udiv":s baseVal pos context appendBinaryOperator
      return
    UDIV_I64I32 case
      sb "udiv":s baseVal ValType .I32 false pos context appendMixedDivisionOperator
      return
    UMOD_I32 UMOD_I64 case
      sb "urem":s baseVal pos context appendBinaryOperator
      return
    UMOD_I64I32 case
      sb "urem":s baseVal ValType .I32 false pos context appendMixedDivisionOperator
      return
    NOT_BOOL case
      pos context popValue =:: arg
      sb
        "%s" sb.appendS
        baseVal context pushValue sb.appendI
        " =w extub %s" sb.appendS
        arg sb.appendI
        '\n' sb.appendC
        "ceqw 0,":s baseVal pos context appendUnaryOperator
      return
    FLIP_I8 FLIP_I16 FLIP_I32 FLIP_I64 case
      sb
        "xor -1,":s baseVal pos context appendUnaryOperator
      return
    AND_BOOL AND_I8 AND_I16 AND_I32 AND_I64 case
      sb "and":s baseVal pos context appendBinaryOperator
      return
    OR_BOOL  OR_I8 OR_I16 OR_I32 OR_I64 case
      sb "or":s baseVal pos context appendBinaryOperator
      return
    XOR_BOOL XOR_I8 XOR_I16 XOR_I32 XOR_I64 case
      sb "xor":s baseVal pos context appendBinaryOperator
      return
    ## shift truncates second operand, no special handling for mixed size needed
    LSHR_I8 LSHR_I16 LSHR_I32 LSHR_I64I32 LSHR_I64 case
      sb
        baseType false pos context extendArguments
        "shr":s baseVal pos context appendBinaryOperator
      return
    ASHR_I8 ASHR_I16 ASHR_I32 ASHR_I64I32 ASHR_I64 case
      sb
        baseType true pos context extendArguments
        "sar":s baseVal pos context appendBinaryOperator
      return
    SHL_I8 SHL_I16 SHL_I32 SHL_I64I32 SHL_I64 case
      sb "shl":s baseVal pos context appendBinaryOperator
      return
    EQ_BOOL EQ_I8 EQ_I16 EQ_I32 EQ_I64 EQ_F32 EQ_F64 EQ_C8 EQ_C16 EQ_C32 case
      sb
        baseType true pos context extendArguments
        "eq":s baseVal pos context appendComparisonOperator
      return
    NE_BOOL NE_I8 NE_I16 NE_I32 NE_I64 NE_F32 NE_F64 NE_C8 NE_C16 NE_C32 case
      sb
        baseType true pos context extendArguments
        "ne":s baseVal pos context appendComparisonOperator
      return
    LT_I8 LT_I16 LT_I32 LT_I64 case
      sb
        baseType true pos context extendArguments
        "slt":s baseVal pos context appendComparisonOperator
      return
    LE_I8 LE_I16 LE_I32 LE_I64 case
      sb
        baseType true pos context extendArguments
        "sle":s baseVal pos context appendComparisonOperator
      return
    GE_I8 GE_I16 GE_I32 GE_I64 case
      sb
        baseType true pos context extendArguments
        "sge":s baseVal pos context appendComparisonOperator
      return
    GT_I8 GT_I16 GT_I32 GT_I64 case
      sb
        baseType true pos context extendArguments
        "sgt":s baseVal pos context appendComparisonOperator
      return
    LT_F32 LT_F64 case
      sb
        baseType true pos context extendArguments
        "lt":s baseVal pos context appendComparisonOperator
      return
    LE_F32 LE_F64 case
      sb
        baseType true pos context extendArguments
        "le":s baseVal pos context appendComparisonOperator
      return
    GE_F32 GE_F64 case
      sb
        baseType true pos context extendArguments
        "ge":s baseVal pos context appendComparisonOperator
      return
    GT_F32 GT_F64  case
      sb
        baseType true pos context extendArguments
        "gt":s baseVal pos context appendComparisonOperator
      return
    ULT_I8 ULT_I16 ULT_I32 ULT_I64 LT_C8 LT_C16 LT_C32 case
      sb
        baseType false pos context extendArguments
        "ult":s baseVal pos context appendComparisonOperator
      return
    ULE_I8 ULE_I16 ULE_I32 ULE_I64 LE_C8 LE_C16 LE_C32 case
      sb
        baseType false pos context extendArguments
        "ule":s baseVal pos context appendComparisonOperator
      return
    UGE_I8 UGE_I16 UGE_I32 UGE_I64 GE_C8 GE_C16 GE_C32 case
      sb
        baseType false pos context extendArguments
        "uge":s baseVal pos context appendComparisonOperator
      return
    UGT_I8 UGT_I16 UGT_I32 UGT_I64 GT_C8 GT_C16 GT_C32 case
      sb
        baseType false pos context extendArguments
        "ugt":s baseVal pos context appendComparisonOperator
      return
    GET_PTR GET_PTR_MUT case
      ## base-type is pointer to value
      baseType typeContext types.getBaseType =:: valueType
      valueType context toValType =:: valType
      valueType context referenceOnly if
        sb return
      end
      pos context popValue =:: valPtr
      valueType typeContext types.isEmpty if
        sb return
      end
      sb
        "%s" sb.appendS
        valType context pushValue sb.appendI
        " =" sb.appendS
        valType sb.appendValTypeQBE
        " load" sb.appendS
        valueType StorageType .LOAD pos context sb.appendTypeNameQBE
        " %s" sb.appendS
        valPtr sb.appendI
        '\n' sb.appendC
      return
    SET_PTR case
      pos context popValue =:: targetPtr
      baseType typeContext types.isEmpty if
        sb return
      end
      pos context popValue =:: srcVal
      sb
        baseType context referenceOnly if
          "blit %s" sb.appendS
        else
          "store" sb.appendS
          baseType StorageType .STORE pos context sb.appendTypeNameQBE
          " %s" sb.appendS
        end
        srcVal sb.appendI
        ", %s" sb.appendS
        targetPtr sb.appendI
        baseType context referenceOnly if
          ", " sb.appendS
          baseType pos context typeStrideInt sb.appendI
        end
        '\n' sb.appendC
      return
    OFFSET_PTR_I32 OFFSET_PTR_I64 OFFSET_PTR OFFSET_PTR_MUT_I32 OFFSET_PTR_MUT_I64 OFFSET_PTR_MUT case
      ## baseType is pointer type
      baseType typeContext types.getBaseType =:: eltType
      sb
        builtIn .OFFSET_PTR_I32 or builtIn .OFFSET_PTR_MUT_I32 if
          pos context popValue =:: offset32
          "%s" sb.appendS
          ValType .I64 context pushValue sb.appendI
          " =l extsw %s" sb.appendS
          offset32 sb.appendI
          '\n' sb.appendC
        end
        pos context popValue =:: baseOffset
        "%s" sb.appendS
        ValType .I64 context pushValue sb.appendI
        " =l mul %s" sb.appendS
        baseOffset sb.appendI
        ", " sb.appendS
        eltType pos context typeStrideInt sb.appendI
        '\n' sb.appendC
        pos context popValue =:: offset
        pos context popValue =:: srcPtr
        "%s" sb.appendS
        ValType .PTR context pushValue sb.appendI
        " =l add %s" sb.appendS
        srcPtr sb.appendI
        ", %s" sb.appendS
        offset sb.appendI
        '\n' sb.appendC
      return
    CHECK_UNION_ELEMENT case
      sb
        baseType typeContext types.getUnionElementUnion .data
          pos context popValue
          baseType typeContext types.getUnionElementIndex
        pos context checkEnumIndex ..drop.2 =:: c
        "%s" sb.appendS
        ValType .I32 context pushValue sb.appendI
        " =w copy %t" sb.appendS
        c sb.appendI
        '\n' sb.appendC
      return
    SYS_ARGC case
      sb
        "%s" sb.appendS
        baseVal context pushValue sb.appendI
        " =" sb.appendS
        baseVal sb.appendValTypeQBE
        " load $" sb.appendS
        CONCAT_ARGC_NAME sb.appendS
        '\n' sb.appendC
      return
    SYS_ARGV case
      sb
        "%s" sb.appendS
        baseVal context pushValue sb.appendI
        " =" sb.appendS
        baseVal sb.appendValTypeQBE
        " load $" sb.appendS
        CONCAT_ARGV_NAME sb.appendS
        '\n' sb.appendC
      return
    SYS_ENVP case
      sb
        "%s" sb.appendS
        baseVal context pushValue sb.appendI
        " =" sb.appendS
        baseVal sb.appendValTypeQBE
        " load $" sb.appendS
        CONCAT_ENVP_NAME sb.appendS
        '\n' sb.appendC
      return
    PARSE_I8 PARSE_I16 PARSE_I32 PARSE_I64 PARSE_F32 PARSE_F64 TYPE_GET_UNION_ELEMENT_UNION
        TYPE_IS_PRIMITIVE TYPE_IS_POINTER TYPE_IS_RAW_POINTER TYPE_IS_ARRAY TYPE_IS_STRUCT
        TYPE_IS_TYPESET TYPE_IS_RAW_UNION TYPE_IS_TAGGED_UNION TYPE_IS_UNION_ELEMENT TYPE_IS_ENUM TYPE_IS_PROC
        TYPE_IS_NAMED TYPE_IS_CTYPE TYPE_IS_ALIGN TYPE_IS_MUTABLE TYPE_IS_DEFINED TYPE_GET_UNION_ELEMENT
        TYPE_CAN_ASSIGN TYPE_CAN_CAST TYPE_ARRAY_ELEMENT TYPE_GET_ELEMENT TYPE_UNWRAP_NAMED case
      "unsupported built-in" sb.copyPtr
        builtIn sb.appendBuiltIn
      pos errors appendError
      sb return
  end
end

enum( MIN MAX ) =:: BoundType
proc(
  stringBuilder : sb
  types.PrimitiveType : srcType
  bool : unsigned
  BoundType : boundType
  types.PrimitiveType : asType
-> stringBuilder ) =>: appendNumberBound
  sb
    srcType switch
      I8  CHAR8  case
        unsigned if boundType .MIN if 0 else i8.UMAX i64 cast.u end
          else boundType .MIN _if i8.MIN i64 cast.s else i8.MAX i64 cast.s end
        break
      I16 CHAR16 case
        unsigned if boundType .MIN if 0 else i16.UMAX i64 cast.u end
          else boundType .MIN _if i16.MIN i64 cast.s else i16.MAX i64 cast.s end
        break
      I32 CHAR32 case
        unsigned if boundType .MIN if 0 else i32.UMAX i64 cast.u end
          else boundType .MIN _if i32.MIN i64 cast.s else i32.MAX i64 cast.s end
        break
      I64 case
        unsigned if boundType .MIN if 0 else i64.UMAX end
          else boundType .MIN _if i64.MIN else i64.MAX end
        break
      BOOL case boundType .MIN if 0 else 1 end break
      F32 case
        asType switch
          I8 I16 I32 I64 CHAR8 CHAR16 CHAR32 case
            asType unsigned boundType asType appendNumberBound return
          F32 case
            boundType .MIN if f32.MIN else f32.MAX end f32.bits sb.appendI return
          F64 case
            boundType .MIN if f64.MIN else f64.MAX end f64.bits sb.appendI return
          BOOL TYPE case ..unreachable
        end
        break
      F64 case
        asType switch
          I8 I16 I32 I64 CHAR8 CHAR16 CHAR32 case
            asType unsigned boundType asType appendNumberBound return
          F32 case
            boundType .MIN if f32.Infinity else f32.-Infinity end f32.bits sb.appendI return
          F64 case
            boundType .MIN if f64.MIN else f64.MAX end f64.bits sb.appendI return
          BOOL TYPE case ..unreachable
        end
        break
      TYPE case ..unreachable
    end =:: intVal
  asType switch
    I8 I16 I32 I64 CHAR8 CHAR16 CHAR32 case
      intVal sb.appendI return
    F32 case intVal unsigned if f32 cast.u else f32 cast end f32.bits sb.appendI return
    F64 case intVal unsigned if f64 cast.u else f64 cast end f64.bits sb.appendI return
    BOOL TYPE case ..unreachable
  end
end

proc(
  stringBuilder : sb
  types.PrimitiveType : srcVal
  i32 : srcIndex
  Type : targetType
  types.PrimitiveType : targetVal
  i32 : targetIndex
  bool : unsigned
  FilePosition : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: castFloatToInt
  BranchId 7 array new =:: mut: branches
  0 while ..dup 7 < do =:: i
    ## BranchId
      BranchType .NEXT
      context nextJumpLabelId
    BranchId new branches@ i =[]
    i 1 +
  end ..drop
  context nextTmpId =:: cNaN
  context nextTmpId =:: cMin
  context nextTmpId =:: cMax
  context nextTmpId =:: tCast
  context nextTmpId =:: tNaN
  context nextTmpId =:: tMin
  context nextTmpId =:: tMax
  srcVal .F32 if 's'
  else srcVal .F64 _if 'd'
  else ..unreachable end =:: srcTypeName
  sb
    ## isNaN?
    "%t" sb.appendS cNaN sb.appendI
    " =w co" sb.appendS srcTypeName sb.appendC
    " %s" sb.appendS
    srcIndex sb.appendI
    ", %s" sb.appendS
    srcIndex sb.appendI
    '\n' sb.appendC
    "jnz %t" sb.appendS cNaN sb.appendI
    ", " sb.appendS branches@ 0 [] sb.appendBranchId
    ", " sb.appendS branches@ 1 [] sb.appendBranchId
    '\n' sb.appendC
    branches@ 0 [] "float->int":s context startBranch
    ## > min ?
    "%t" sb.appendS cMin sb.appendI
    " =w cgt" sb.appendS srcTypeName sb.appendC
    " %s" sb.appendS
    srcIndex sb.appendI
    ", " sb.appendS
    targetVal unsigned BoundType .MIN srcVal appendNumberBound
    '\n' sb.appendC
    "jnz %t" sb.appendS cMin sb.appendI
    ", " sb.appendS branches@ 2 [] sb.appendBranchId
    ", " sb.appendS branches@ 3 [] sb.appendBranchId
    '\n' sb.appendC
    branches@ 2 [] "float->int: check undeflow":s context startBranch
    ## < max ?
    "%t" sb.appendS cMin sb.appendI
    " =w clt" sb.appendS srcTypeName sb.appendC
    " %s" sb.appendS
    srcIndex sb.appendI
    ", " sb.appendS
    targetVal unsigned BoundType .MAX srcVal appendNumberBound
    '\n' sb.appendC
    "jnz %t" sb.appendS cMin sb.appendI
    ", " sb.appendS branches@ 4 [] sb.appendBranchId
    ", " sb.appendS branches@ 5 [] sb.appendBranchId
    '\n' sb.appendC
    branches@ 4 [] "float->int: normal":s context startBranch
    ## cast value
    "%t" sb.appendS
    tCast sb.appendI
    " =" sb.appendS
    targetType StorageType .STACK pos context sb.appendTypeNameQBE
    ' ' sb.appendC
    srcTypeName sb.appendC
    unsigned if "toui %s" else "tosi %s" end sb.appendS
    srcIndex sb.appendI
    "\njmp " sb.appendS branches@ 6 [] sb.appendBranchId
    '\n' sb.appendC
    ## NaN
    branches@ 1 [] "float->int: NaN":s context startBranch
    "%t" sb.appendS
    tNaN sb.appendI
    " =" sb.appendS
    targetType StorageType .STACK pos context sb.appendTypeNameQBE
    " copy 0" sb.appendS
    "\njmp " sb.appendS branches@ 6 [] sb.appendBranchId
    '\n' sb.appendC
    ## <Min
    branches@ 3 [] "float->int: underflow":s context startBranch
    "%t" sb.appendS
    tMin sb.appendI
    " =" sb.appendS
    targetType StorageType .STACK pos context sb.appendTypeNameQBE
    " copy " sb.appendS
    targetVal unsigned BoundType .MIN targetVal appendNumberBound
    "\njmp " sb.appendS branches@ 6 [] sb.appendBranchId
    '\n' sb.appendC
    ## >Max
    branches@ 5 [] "float->int: overflow":s context startBranch
    "%t" sb.appendS
    tMax sb.appendI
    " =" sb.appendS
    targetType StorageType .STACK pos context sb.appendTypeNameQBE
    " copy " sb.appendS
    targetVal unsigned BoundType .MAX targetVal appendNumberBound
    '\n' sb.appendC
    branches@ 6 [] "float->int: end":s context startBranch
    "%s" sb.appendS
    targetIndex sb.appendI
    " =" sb.appendS
    targetType StorageType .STACK pos context sb.appendTypeNameQBE
    " phi " sb.appendS
    branches@ 4 [] sb.appendBranchId
    " %t" sb.appendS tCast sb.appendI
    ", " sb.appendS branches@ 1 [] sb.appendBranchId
    " %t" sb.appendS tNaN sb.appendI
    ", " sb.appendS branches@ 3 [] sb.appendBranchId
    " %t" sb.appendS tMin sb.appendI
    ", " sb.appendS branches@ 5 [] sb.appendBranchId
    " %t" sb.appendS tMax sb.appendI
    '\n' sb.appendC
  return
end

proc(
  stringBuilder : sb
  Type : src
  i32 : srcIndex
  Type : target
  i32 : targetIndex
  FilePosition : pos
  CompilerContext ptr.mut : context
  SignType : signType
-> stringBuilder ) =>: castNumbers
  context [] .program =:: prog
  prog .errors =:: errors
  prog .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  src typeContext types.primitiveValue =:: fromVal
  target typeContext types.primitiveValue =:: toVal
  ## case 0: identical types
  fromVal toVal == if
    sb
      ## copy necessary to update value id
      "%s" sb.appendS
      targetIndex sb.appendI
      " =" sb.appendS
      target StorageType .STACK pos context sb.appendTypeNameQBE
      " copy" sb.appendS
      " %s" sb.appendS
      srcIndex sb.appendI
      '\n' sb.appendC
    return
  ## case 1: integer extension/narrowing
  else src typeContext types.isIntOrChar and target typeContext types.isIntOrChar _if
    src typeContext types.primitiveValue types.sizeOfPrimitive =:: srcPrec
    target typeContext types.primitiveValue types.sizeOfPrimitive =:: targetPrec
    sb
      "%s" sb.appendS
      targetIndex sb.appendI
      targetPrec srcPrec <= if
        " =" sb.appendS
        target StorageType .STACK pos context sb.appendTypeNameQBE
        " copy" sb.appendS
      else
        " =" sb.appendS
        target StorageType .STACK pos context sb.appendTypeNameQBE
        " ext" sb.appendS
        signType .UNSIGNED if
          'u' sb.appendC
        else
          's' sb.appendC
        end
        fromVal switch
          I8  CHAR8  case "b" sb.appendS break
          I16 CHAR16 case "h" sb.appendS break
          I32 CHAR32 case "w" sb.appendS break
          I64 case "l" sb.appendS break
          BOOL TYPE F32 F64 case ..unreachable
        end
      end
      " %s" sb.appendS
      srcIndex sb.appendI
      '\n' sb.appendC
    return
  ## case 2: float -> float/int
  else fromVal .F32 or fromVal .F64 _if
      toVal switch
        F32 case
          sb
            "%s" sb.appendS
            targetIndex sb.appendI
            " =s truncd %s" sb.appendS
            srcIndex sb.appendI
            '\n' sb.appendC
          return
        F64 case
          sb
            "%s" sb.appendS
            targetIndex sb.appendI
            " =d exts %s" sb.appendS
            srcIndex sb.appendI
            '\n' sb.appendC
          return
        I8 I16 I32 I64 CHAR8 CHAR16 CHAR32 case
          sb
            fromVal srcIndex target toVal targetIndex
            signType .UNSIGNED
          pos context castFloatToInt return
        BOOL TYPE case ..unreachable
      end
  ## case 3: int -> float
  else ## TODO sign/zero extend 8&16 bit types before conversion
    sb
      "%s" sb.appendS
      targetIndex sb.appendI
      " =" sb.appendS
      target StorageType .STACK pos context sb.appendTypeNameQBE
      signType .UNSIGNED if " u" sb.appendS else " s" sb.appendS end
      fromVal switch
        I64 case "ltof" sb.appendS break
        I8 I16 I32 CHAR8 CHAR16 CHAR32 case "wtof" sb.appendS break
        BOOL TYPE F32 F64 case ..unreachable
      end
      " %s" sb.appendS
      srcIndex sb.appendI
      '\n' sb.appendC
    return
  end
end


struct( char8 : varType i32 : varId ) =:: StackVal
namespace: sb
  proc(
    stringBuilder : sb
    StackVal : val
  -> stringBuilder ) =>: appendStackVal
    sb
      '%' sb.appendC
      val .varType sb.appendC
      val .varId sb.appendI
    return
  end
end
proc(
  stringBuilder : sb
  Type : src
  i32 : srcIndex
  Type : target
  i32 : targetIndex
  FilePosition : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: bitcastNumbers
  context [] .program =:: prog
  prog .errors =:: errors
  prog .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  src typeContext types.primitiveValue =:: fromVal
  target typeContext types.primitiveValue =:: toVal
  ## sizes of arguments scaled to bits
  fromVal types.sizeOfPrimitive 8 * =:: fromSize
  toVal types.sizeOfPrimitive 8 * =:: toSize
  fromVal toVal == if
    sb
      "%s" sb.appendS
      targetIndex sb.appendI
      ## copy necessary to update value id
      " =" sb.appendS
      target StorageType .STACK pos context sb.appendTypeNameQBE
      " copy %s" sb.appendS
      srcIndex sb.appendI
      '\n' sb.appendC
    return
  end
  's' srcIndex StackVal new =:: mut: current
  's' targetIndex StackVal new =:: mut: last
  last =:: mut: next
  0 =:: mut: nSteps
  src typeContext types.isFloat if nSteps 1 + nSteps= end
  fromSize toSize != if
    nSteps 1 + nSteps=
  end
  target typeContext types.isFloat if nSteps 1 + nSteps= end
  nSteps 0 > "bit-cast casts non-equal types" assert
  nSteps 1 > if
    't' context nextTmpId StackVal new next=
  end
  sb
    ## 1. convert floats to int
    src typeContext types.isFloat if
      next sb.appendStackVal
      " =" sb.appendS
      fromSize 32 <= if 'w' else 'l' end sb.appendC
      " cast " sb.appendS
      current sb.appendStackVal
      '\n' sb.appendC
      nSteps 1 - nSteps=
      next current=
      nSteps 1 > if 't' context nextTmpId StackVal new else last end next=
    end
    ## 2. zero-extend small values to correct size
    fromSize toSize != if
      next sb.appendStackVal
      " =" sb.appendS
      toSize 32 <= if 'w' else 'l' end sb.appendC
      fromSize toSize < if
        fromVal switch
          BOOL TYPE F32 F64 case break
          I8  CHAR8  case " extub" sb.appendS break
          I16 CHAR16 case " extuh" sb.appendS break
          I32 CHAR32 case " extuw" sb.appendS break
          I64 case " extul" sb.appendS break
        end
      else
        ## copy to smaller type truncates
        " copy " sb.appendS
      end
      current sb.appendStackVal
      '\n' sb.appendC
      nSteps 1 - nSteps=
      next current=
      nSteps 1 > if 't' context nextTmpId StackVal new else last end next=
    end
    ## 3. convert int to float
    target typeContext types.isFloat if
      next sb.appendStackVal
      " =" sb.appendS
      toSize 32 == if 's' else 'd' end sb.appendC
      " cast " sb.appendS
      current sb.appendStackVal
      '\n' sb.appendC
      nSteps 1 - nSteps=
    end
    nSteps 0 == "correct step estimate in bit-cast" assert
  return
end

enum( AUTO_CAST CAST CAST! BIT_CAST ) =:: CastType

proc(
  stringBuilder : sb
  CastType : castType
  SignType : signType0
  Type : src0
  i32 : offset
  Type : target0
  FilePosition : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: compileCast
  context [] .program =:: prog
  prog .errors =:: errors
  prog .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  signType0
    $ .NONE if ..drop
      src0 typeContext types.isUnsignedInt or src0 typeContext types.isChar if
        SignType .UNSIGNED
      else src0 typeContext types.isSignedInt _if
        SignType .SIGNED
      else target0 typeContext types.isUnsignedInt or target0 typeContext types.isChar _if
        SignType .UNSIGNED
      else target0 typeContext types.isSignedInt _if
        SignType .SIGNED
      else
        SignType .NONE
      end
    end
  =:: signType
  ## XXX? better cType <-> type conversion
  ## TODO update sign type when casting from/to  cType/intLiteral
  src0 typeContext types.unwrapNamed
    ..dup .cType ?? if .cType types.cTypeAsType end
    ..dup .intLiteral ?? if .intLiteral types.intLiteralAsInt end
  =:: src
  target0 typeContext types.unwrapNamed
    ..dup .cType ?? if .cType types.cTypeAsType end
    ..dup .intLiteral ?? if .intLiteral types.intLiteralAsInt end
  =:: target
  src target types.typeEquals if
    sb return ## nothing to do
  end
  offset context [] .stackInfo branchTree.depth >= if
    "stack underflow" sb.copyPtr
    pos errors appendError
    sb return
  end
  castType .AUTO_CAST if
    context .stackInfo offset branchTree.at .data [] .valType
    context .stackInfo offset branchTree.at .data [] .varId
  else
    context .stackInfo offset branchTree.at .data [] .valType
    pos context popValue
  end =:: srcId =:: valType
  castType .AUTO_CAST if
    target context toValType offset context replaceValue
  else
    target context toValType context pushValue
  end =:: targetId
  ## TODO? different behavior for bit-casts
  src typeContext types.isNumber and target typeContext types.isNumber if
    sb
      src srcId
      target targetId
    pos context  castType .BIT_CAST if bitcastNumbers else signType castNumbers end
    return
  end
  src typeContext types.isChar and target typeContext types.isInt if
    sb
      src srcId
      target targetId
    pos context  castType .BIT_CAST if bitcastNumbers else signType castNumbers end
    return
  end
  src typeContext types.isInt and target typeContext types.isChar if
    sb
      src srcId
      target targetId
    pos context  castType .BIT_CAST if bitcastNumbers else signType castNumbers end
    return
  end
  src typeContext types.isPointer and target typeContext types.isPointer end or
      src typeContext types.isUnionElement and target typeContext types.isUnion if
    sb
      "%s" sb.appendS
      targetId sb.appendI
      " =l copy %s" sb.appendS
      srcId sb.appendI
      '\n' sb.appendC
    return ## same internal representation -> cast is no-op
  end
  ## XXX? sign type for cast int <-> ptr
  src typeContext types.isInt target typeContext types.isPointer & if
    ## src -> I_SIZE ~ ptr
    sb
      ## castNumbers
        src srcId
        types.primitive.I_SIZE targetId
      pos context  castType .BIT_CAST if bitcastNumbers else signType castNumbers end
    return
  end
  src typeContext types.isPointer target typeContext types.isInt & if
    ## ptr ~ I_SIZE -> target
    sb
      ## castNumbers
        types.primitive.I_SIZE srcId
        target targetId
      pos context  castType .BIT_CAST if bitcastNumbers else signType castNumbers end
    return
  end
  "casting from " sb.copyPtr
    src typeContext sb.appendType
    " to " sb.appendS
    target typeContext sb.appendType
    " is not implemented" sb.appendS
  pos errors appendError
  sb return
end

proc(
  stringBuilder : sb
  Type : constType
  ConstValue : value
  FilePosition : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: pushConstant
  context [] .program =:: prog
  prog .idContext =:: idContext
  idContext .typeContext =:: typeContext
  false =:: mut: needCast
  constType =:: mut: srcType
  value .GenericArg ?? if
    context [] .currentProc
      value .GenericArg
      typeContext
    types.findProcArgLabel $ optional.hasData if .data =:: index
      context [] .currentProc typeContext types.getProcIn .data index [] srcType=
      srcType typeContext types.unwrapNamed
        constType typeContext types.unwrapNamed
      types.typeEquals ! needCast=
    else ..drop end
  end
  sb
    pos sb.appendPosQBE
    "%s" sb.appendS
    srcType context referenceOnly ! if
      srcType context toValType context pushValue sb.appendI
      " =" sb.appendS
      srcType StorageType .STACK pos context sb.appendTypeNameQBE
      " copy " sb.appendS
    else
      ValType .REFERENCE context pushValue sb.appendI
      " =l copy " sb.appendS
    end
    srcType value false pos context sb.appendConstQBE
    '\n' sb.appendC
    needCast if
      ## compileCast
        CastType .AUTO_CAST
        SignType .NONE
        srcType
        0
        constType
        pos
        context
      compileCast
    end
  return
end

proc(
  stringBuilder : sb
  Type : calledType
  TypedValId list ptr.mut : argIndices
  iSize : outArgsOffset
  FilePosition : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: prepareCall
  context [] .program =:: prog
  prog .idContext =:: idContext
  idContext .typeContext =:: typeContext
  calledType typeContext types.getProcOutArgs =:: outArgs
  calledType typeContext types.getProcRet =:: retType
  sb =:: mut: newSb
  ## push out arguments on stack
  outArgsOffset while $ argIndices [] .length u< do =:: i
    argIndices [] i [] =:: outArg
    ValType .REFERENCE context pushValue =:: argId
    newSb
      "%s" sb.appendS
      argId sb.appendI
      " =l copy %s" sb.appendS
      outArg .valId sb.appendI
      '\n' sb.appendC
    newSb=
    i 1:iSize +
  end ..drop
  newSb
    retType .Empty ?? ! if
      retType .Value ?? if
        retType .Value
      else
        retType .Tuple
      end =:: retVal
      retVal context toValType context pushValue =:: retId
      "%s" sb.appendS
      retId sb.appendI
      " =" sb.appendS
      retVal StorageType .LOAD pos context sb.appendTypeNameQBE
      ' ' sb.appendC
    end
    "call " sb.appendS
  return
end
proc(
  stringBuilder : sb
  Type : calledType
  TypedValId list ptr.mut : argIndices
  iSize : outArgsOffset
  FilePosition : pos
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: finishCall
  context [] .program =:: prog
  prog .idContext =:: idContext
  idContext .typeContext =:: typeContext
  calledType typeContext types.getProcOutArgs =:: outArgs
  calledType typeContext types.getProcRet =:: retType
  sb
    " (" sb.appendS
    false =:: mut: hasArgs
    argIndices [] .length 1:iSize - while $ 0:iSize iSize.sge do =:: i
      argIndices [] i list.at .data =:: arg
      hasArgs if
        ',' sb.appendC
      end
      true hasArgs=
      i outArgsOffset u< if
        arg [] .valType
          StorageType .LOAD
          pos
          context
        sb.appendTypeNameQBE
      else
        'l' sb.appendC
      end
      " %s" sb.appendS
      arg [] .valId sb.appendI
    finally i 1:iSize - end ..drop
    ")\n" sb.appendS
    retType .Tuple ?? if
      ## flattenTupleQBE
        retType .Tuple
        pos context popValue
        pos
      context flattenTupleQBE
    end
    ## convert out-arg references to values
    outArgsOffset while $ argIndices [] .length u< do =:: i
      argIndices [] i list.at .data [] .valType =:: argType
      argType context referenceOnly if
        continue
      end
      ## TODO? extract load operations to common procedure
      argIndices [] .length i - i32 cast =:: offset
      context .stackInfo offset branchTree.at .data [] .valType =:: valType
      context .stackInfo offset branchTree.at .data [] .varId =:: srcId
      argType context toValType offset context replaceValue =:: targetId
      "%s" sb.appendS
      targetId sb.appendI
      " =" sb.appendS
      argType StorageType .STACK pos context sb.appendTypeNameQBE
      valType .REFERENCE if ## unwrap reference
        " load" sb.appendS
        argType StorageType .LOAD pos context sb.appendTypeNameQBE
      else
        " copy" sb.appendS
      end
      " %s" sb.appendS
      srcId sb.appendI
      '\n' sb.appendC
    finally i 1:iSize + end ..drop
    argIndices [] list.free argIndices =[]
  return
end

proc(
  stringBuilder : sb
  Operation ptr : op
  i32 : opIndex
  CompilerContext ptr.mut : context
-> stringBuilder ) =>: compileOp
  context [] .program =:: prog
  prog .errors =:: errors
  prog .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  op [] .val switch
    NOP case
      sb return
    Constant case
      sb
        op [] .dataType
        op [] .val .Constant
        op [] .pos
        context
      pushConstant
      return
    ConstantReference case
      sb
        "%s" sb.appendS
        ValType .REFERENCE context pushValue sb.appendI
        " =l " sb.appendS
        " copy $" sb.appendS
        CONST_REFERENCE_NAME sb.appendS
        op [] .val .ConstantReference i64 cast sb.appendI
        '\n' sb.appendC
      return
    declareId initializeId case
      op [] .val .declareId ?? if
        op [] .val .declareId
      else
        op [] .val .initializeId
      end =:: idInfo
      op [] .val .initializeId ?? =:: assignValue
      idInfo .labelId labelContext id.labelFlags =:: labelFlags
      labelFlags id.FLAG_MUTABLE & ? =:: mutable
      idInfo .idType switch
        PROCEDURE case
          assignValue ! if
            sb return ## ignore procedure declarations
          end
          break
        LOCAL_VAR TMP_VAR ITR_VAR case
          op [] .dataType =:: valType
          ## use pointers as stack representation of arrays and composites
          valType context referenceOnly ! =:: isValue
          sb
            op [] .pos sb.appendPosQBE
            assignValue if
              isValue if
                "store" sb.appendS
                valType StorageType .STORE op [] .pos context sb.appendTypeNameQBE
              else
                "blit" sb.appendS ## XXX call memcopy for large structs
              end
              " %s" sb.appendS
              op [] .pos context popValue sb.appendI
              ',' sb.appendC
              "%l" sb.appendS
              idInfo .labelId i64 cast sb.appendI
              isValue ! if
                ',' sb.appendC
                op [] .dataType op [] .pos context typeSizeInt sb.appendI
              end
              '\n' sb.appendC
            end
          return
        GLOBAL_VAR TYPE ARGUMENT LABEL PROCEDURE_BUNDLE case
          break ## XXX error message
      end
      break
    implementProcedure case
      op [] .val .implementProcedure =:: implInfo
      prog [] .procedures
        implInfo .procId i64 cast list.at .data
      =:: procInfo
      op [] .dataType context .currentProc=
      procInfo [] .labelId labelContext id.labelFlags =:: labelFlags
      ## reset stack-info in context
      0 context .stackCount=
      0 context .tmpCount=
      0 context .jumpLabelCount=
      context .stackInfo branchTree.clear
      sb
        implInfo .implementationId  0 < and
            labelFlags id.FLAG_EXPORT & ? or labelFlags id.FLAG_EXTERN & ? if
          "export " sb.appendS
        end
        "function " sb.appendS
        op [] .dataType typeContext types.getProcRet =:: retType
        retType .Empty ?? ! if
          retType .Value ?? if retType .Value else retType .Tuple end =:: retVal
          retVal StorageType .LOAD op [] .pos context sb.appendTypeNameQBE
          ' ' sb.appendC
        end
        procInfo [] .labelId implInfo .implementationId context sb.appendGlobalName
        op [] .dataType op [] .pos context sb.appendProcSignature
        "{\n" sb.appendS
        ## BranchId
          BranchType .START
          0
        BranchId new string.empty context startBranch
        ## push unnamed arguments
        op [] .dataType typeContext types.getProcIn .data =:: args
        0:i32 while $ iSize cast.u args .length u< do =:: i
          op [] .dataType i typeContext types.getProcArgLabel =:: label
          args i [] =:: argType
          argType typeContext types.isEmpty if
            i 1 + continue ## skip empty arguments
          end
          label labelContext id.labelFlags id.FLAG_STATIC & ? if
            i 1 + continue ## skip static arguments
          end
          argType context referenceOnly if
            ValType .REFERENCE
          else
            argType context toValType
          end =:: valType
          label id.LABEL_ID_NONE == if ## push argument
            "%s" sb.appendS
            valType context pushValue sb.appendI
            " =" sb.appendS
            valType sb.appendValTypeQBE
            " copy " sb.appendS
            i id.LABEL_ID_NONE context sb.appendArgName
            '\n' sb.appendC
          else valType .REFERENCE _if
            "%l" sb.appendS
            label i64 cast sb.appendI
            " =" sb.appendS
            valType sb.appendValTypeQBE
            " copy " sb.appendS
            i id.LABEL_ID_NONE context sb.appendArgName
            '\n' sb.appendC
          else
            "%l" sb.appendS
            label i64 cast sb.appendI
            " =l alloc" sb.appendS
            argType op [] .pos context typeAlignmentInt 4 i64.max sb.appendI
            ' ' sb.appendC
            argType op [] .pos context typeSizeInt  4 i64.max sb.appendI
            "\nstore" sb.appendS
            argType StorageType .STORE op [] .pos context sb.appendTypeNameQBE
            ' ' sb.appendC
            i id.LABEL_ID_NONE context sb.appendArgName
            ", %l" sb.appendS
            label i64 cast sb.appendI
            '\n' sb.appendC
          end
          i 1 +
        end ..drop
        procInfo [] .implementation .code ?? if
          ## allocate space for variables
          implInfo .implementationId 0 >= if
            procInfo [] .implementation .code .implementations
              implInfo .implementationId list.at .data [] .variables
          else
            procInfo [] .implementation .code .variables
          end =:: variables
          variables for =:: varInfo
            VariableType ..length 3:iSize == "no new variable types" assert
            varInfo .variableType .ARGUMENT if
              continue
            end
            "%l" sb.appendS
            varInfo .label i64 cast.u sb.appendI
            varInfo .valueType op [] .pos context false appendAlloc ..drop
          end
        end
        true context .reachable=
      return
    getId atId case
      op [] .val .getId ?? if
        op [] .val .getId
      else
        op [] .val .atId
      end =:: idInfo
      op [] .val .atId ?? =:: isAddr
      idInfo .idType switch
        PROCEDURE  case
          ## procedures are handled by call & procPtr instructions
          break
        GLOBAL_VAR case
          sb
            op [] .pos sb.appendPosQBE
            "%s" sb.appendS
            isAddr or op [] .dataType context referenceOnly if
              isAddr if ValType .PTR else ValType .REFERENCE end context pushValue sb.appendI
              " =l copy " sb.appendS
            else
              op [] .dataType context toValType =:: valType
              valType context pushValue sb.appendI
              " =" sb.appendS
              valType sb.appendValTypeQBE
              " load" sb.appendS
              op [] .dataType StorageType .LOAD
                op [] .pos
                context
              sb.appendTypeNameQBE
              " " sb.appendS
            end
            idInfo .labelId -1 context sb.appendGlobalName
            '\n' sb.appendC
          return
        LOCAL_VAR TMP_VAR ITR_VAR ARGUMENT case
          sb
            op [] .pos sb.appendPosQBE
            "%s" sb.appendS
            isAddr or op [] .dataType context referenceOnly if
              isAddr if ValType .PTR else ValType .REFERENCE end context pushValue sb.appendI
              " =l copy %l" sb.appendS
            else
              op [] .dataType context toValType =:: valType
              valType context pushValue sb.appendI
              " =" sb.appendS
              valType sb.appendValTypeQBE
              " load" sb.appendS
              op [] .dataType StorageType .LOAD
                op [] .pos
                context
              sb.appendTypeNameQBE
              " %l" sb.appendS
            end
            idInfo .labelId i64 cast sb.appendI
            '\n' sb.appendC
          return
       TYPE LABEL PROCEDURE_BUNDLE case
          break ## XXX error message
      end
      break
    procPtr case
      op [] .val .procPtr =:: procImpl
      prog [] .procedures
        procImpl .procId i64 cast
      list.at .data =:: procData
      sb
        op [] .pos sb.appendPosQBE
        "%s" sb.appendS
        ValType .PTR context pushValue sb.appendI
        " =l copy " sb.appendS
        ## appendGlobalName
          procData [] .labelId
          procImpl .implementationId
        context sb.appendGlobalName
        "\n" sb.appendS
      return
    setId case
      op [] .val .setId =:: idInfo
      op [] .dataType =:: valType
      op [] .pos context popValue =:: valueId
      sb
        op [] .pos sb.appendPosQBE
        valType context referenceOnly if
          "blit %s" sb.appendS
        else
          "store" sb.appendS
          valType StorageType .STORE op [] .pos context sb.appendTypeNameQBE
          " %s" sb.appendS
        end
        valueId sb.appendI
        ", " sb.appendS
        idInfo .idType switch
          GLOBAL_VAR case
            idInfo .labelId -1 context sb.appendGlobalName
            break
          LOCAL_VAR TMP_VAR ITR_VAR ARGUMENT case
            " %l" sb.appendS
            idInfo .labelId i64 cast sb.appendI
            break
         PROCEDURE TYPE LABEL PROCEDURE_BUNDLE case
            "unsupported identifier for setId " sb.copyPtr
            idInfo labelContext sb.appendIdInfo
            op [] .pos errors appendError
            return
        end
        valType context referenceOnly if
          ',' sb.appendC
          valType op [] .pos context typeSizeInt sb.appendI
        end
        '\n' sb.appendC
      return
    getUnionElement case
      ## try-get element only changes type of top stack value
      sb return
    getElement case
      op [] .val .getElement =:: index
      op [] .dataType =:: mut: containerType
      false =:: mut: ptrSrc
      containerType typeContext types.isPointer if
        containerType typeContext types.ptrTarget containerType=
        true ptrSrc=
      end
      containerType typeContext types.isArray =:: isArray
      isArray if
        containerType typeContext types.getBaseType
      else
        containerType
          index
          typeContext
        types.compositeGetElement
      end =:: eltType
      ptrSrc if
        ValType .PTR
      else
        eltType context toValType
      end =:: valType
      isArray if
        op [] .pos context popValue =:: srcId
        sb
          "%s" sb.appendS
          valType context pushValue sb.appendI
          " =l add %s" sb.appendS
          srcId sb.appendI
          ", " sb.appendS
          index i64 cast.u eltType op [] .pos context typeStrideInt * sb.appendI
          '\n' sb.appendC
      else containerType typeContext types.isTuple _if
        op [] .pos context popValue =:: srcId
        sb
          op [] .pos sb.appendPosQBE
          "%s" sb.appendS
          valType context pushValue sb.appendI
          " =l add %s" sb.appendS
          srcId sb.appendI
          ", " sb.appendS
          containerType index op [] .pos context tupleEltOffsetInt sb.appendI
          '\n' sb.appendC
      else containerType typeContext types.isUnion or containerType typeContext types.isEnum _if
        sb ## not change to pointer necessary
      else
        break ## unsupported type
      end
        ptrSrc or eltType context referenceOnly if
          return
        end
        op [] .pos context popValue =:: srcId
        op [] .pos sb.appendPosQBE
        "%s" sb.appendS
        valType context pushValue sb.appendI
        " =" sb.appendS
        valType sb.appendValTypeQBE
        " load" sb.appendS
        eltType
          StorageType .LOAD
          op [] .pos
          context
        sb.appendTypeNameQBE
        " %s" sb.appendS
        srcId sb.appendI
        '\n' sb.appendC
      return
    setElement case
      op [] .val .setElement =:: index
      ## TODO? special handling for access through pointer?
      op [] .dataType
        $ typeContext types.isPointer =:: isPtr
        isPtr if
          typeContext types.ptrTarget
        end
      =:: containerType
      containerType typeContext types.isArray =:: isArray
      isArray if
        containerType typeContext types.getBaseType
      else
        containerType
          index
          typeContext
        types.compositeGetElement
      end =:: eltType
      sb
        op [] .pos context popValue =:: structId
        op [] .pos sb.appendPosQBE
        "%s" sb.appendS
        isPtr if ValType .PTR else ValType .REFERENCE end context pushValue sb.appendI
        " =l add %s" sb.appendS
        structId sb.appendI
        ", " sb.appendS
        isArray if
          index i64 cast.u eltType op [] .pos context typeStrideInt * sb.appendI
        else
          containerType index op [] .pos context tupleEltOffsetInt sb.appendI
        end
        '\n' sb.appendC
        op [] .pos context popValue =:: targetId
        op [] .pos context popValue =:: valueId
        eltType context referenceOnly if
          "blit %s" sb.appendS
        else
          "store" sb.appendS
          eltType StorageType .STORE op [] .pos context sb.appendTypeNameQBE
          " %s" sb.appendS
        end
        valueId sb.appendI
        ", %s" sb.appendS
        targetId sb.appendI
        eltType context referenceOnly if
          ',' sb.appendC
          eltType op [] .pos context typeSizeInt sb.appendI
        end
        '\n' sb.appendC
        isPtr ! if
          ## keep non-pointer value on stack
          "%s" sb.appendS
          ValType .REFERENCE context pushValue sb.appendI
          " =l copy %s" sb.appendS
          structId sb.appendI
          '\n' sb.appendC
        end
      return
    rawValue case
      ## TODO? allow ..raw on pointer to union/union-element
      op [] .dataType typeContext types.isUnion if
        sb return
      else op [] .dataType typeContext types.isUnionElement _if
        op [] .dataType typeContext types.getUnionElementType =:: eltType
        sb
          eltType context referenceOnly if
            return
          end
          ## TODO: extract unwrapping of references to procedure
          eltType context toValType =:: valType
          op [] .pos context popValue =:: srcId
          op [] .pos sb.appendPosQBE
          "%s" sb.appendS
          valType context pushValue sb.appendI
          " =" sb.appendS
          valType sb.appendValTypeQBE
          " load" sb.appendS
          eltType
            StorageType .LOAD
            op [] .pos
            context
          sb.appendTypeNameQBE
          " %s" sb.appendS
          srcId sb.appendI
          '\n' sb.appendC
        return
      end
      ## FIXME implement ..raw
      "unsupported type in ..raw" ..panic
    New NewEnum NewReference NewEnumReference case
      op [] .val .NewReference ?? op [] .val .NewEnumReference ?? | =:: hasReference
      op [] .val .NewEnum ?? op [] .val .NewEnumReference ?? | =:: isEnum
      sb
        op [] .pos sb.appendPosQBE
        ## prepare memory
        hasReference if
          op [] .pos context popValue 's'
        else
          op [] .dataType op [] .pos context true appendAlloc 't'
        end =:: dataPtrType =:: dataPtrId
        isEnum if ## TODO store enums without values as integer
          op [] .val .NewEnum ?? if
            op [] .val .NewEnum
          else
            op [] .val .NewEnumReference
          end =:: index
          op [] .dataType index typeContext types.compositeGetElement =:: eltType
          ## storeEnumLabel
            op [] .dataType
            dataPtrType
            dataPtrId
            index
            op [] .pos
            context
          storeEnumLabel
          eltType typeContext types.isEmpty ! if
            eltType context referenceOnly if
              "blit %s" sb.appendS
            else
              "store" sb.appendS
              eltType StorageType .STORE op [] .pos context sb.appendTypeNameQBE
              " %s" sb.appendS
            end
            op [] .pos context popValue sb.appendI
            ", %" sb.appendS
            dataPtrType sb.appendC
            dataPtrId sb.appendI
            eltType context referenceOnly if
              ',' sb.appendC
              eltType op [] .pos context typeSizeInt sb.appendI
            end
            '\n' sb.appendC
          end
        else op [] .dataType typeContext types.isTuple _if
          op [] .dataType dataPtrType dataPtrId op [] .pos context initializeTupleQBE
        else op [] .dataType typeContext types.isArray _if
          ## zero-initialize array
          "call $memset(l %" sb.appendS
          dataPtrType sb.appendC
          dataPtrId sb.appendI
          ",w 0,l " sb.appendS
          op [] .dataType op [] .pos context typeSizeInt sb.appendI
          ")\n" sb.appendS
        else
          "unsupported type for new:" sb.copyPtr
            op [] .dataType
              typeContext
            sb.appendType
          op [] .pos errors appendError
          return
        end
        "%s" sb.appendS
        ValType .REFERENCE context pushValue sb.appendI
        " =l copy %" sb.appendS
        dataPtrType sb.appendC
        dataPtrId sb.appendI
        '\n' sb.appendC
      return
    getEnumLabel case
      context .stackInfo branchTree.pop =:: srcVal?
      srcVal? optional.isEmpty if
        "stack underflow" sb.copyPtr
        op [] .pos errors appendError
        sb return
      end
      sb
        op [] .pos sb.appendPosQBE
        ## loadEnumLabel
          op [] .dataType
          srcVal? .data [] .varId
          op [] .pos
        context loadEnumLabel =:: labelType =:: labelId
        context nextTmpId =:: c
        "%s" sb.appendS
        labelType context pushValue sb.appendI
        " ="  sb.appendS
        labelType sb.appendValTypeQBE
        " copy " sb.appendS
        " %t" sb.appendS
        labelId sb.appendI
        '\n' sb.appendC
      return
    checkEnumLabel case
      context .stackInfo branchTree.peek =:: srcVal?
      srcVal? optional.isEmpty if
        "stack underflow" sb.copyPtr
        op [] .pos errors appendError
        sb return
      end
      sb
        op [] .pos sb.appendPosQBE
        ## appendEnumCheck
          op [] .dataType
          srcVal? .data [] .varId
          op [] .val .checkEnumLabel
          op [] .pos
          context
        appendEnumCheck
      return
    setEnumElement case
      context .stackInfo branchTree.peek =:: srcVal?
      srcVal? optional.isEmpty if
        "stack underflow" sb.copyPtr
        op [] .pos errors appendError
        sb return
      end
      ## TODO? special handling for access through pointer?
      op [] .dataType
        $ typeContext types.isPointer =:: isPtr
        isPtr if
          typeContext types.getBaseType
        end
      =:: enumType
      op [] .val .setEnumElement =:: elementId
      sb
        op [] .pos sb.appendPosQBE
        ## storeEnumLabel
          enumType
          's'
          srcVal? .data [] .varId
          elementId
          op [] .pos
          context
        storeEnumLabel
        enumType elementId typeContext types.compositeGetElement =:: eltType
        eltType typeContext types.isEmpty if
          return
        end
        op [] .pos context popValue =:: unionId
        op [] .pos context popValue =:: valueId
        eltType context referenceOnly if
          "blit %s" sb.appendS
        else
          "store" sb.appendS
          eltType StorageType .STORE op [] .pos context sb.appendTypeNameQBE
          " %s" sb.appendS
        end
        valueId sb.appendI
        ", %s" sb.appendS
        unionId sb.appendI
        eltType context referenceOnly if
          ',' sb.appendC
          eltType op [] .pos context typeSizeInt sb.appendI
        end
        '\n' sb.appendC
        isPtr ! if
          ## keep non-pointer value on stack
          "%s" sb.appendS
          ValType .REFERENCE context pushValue sb.appendI
          " =l copy %s" sb.appendS
          unionId sb.appendI
          '\n' sb.appendC
        end
      return
    hasElement case
      op [] .dataType =:: containerType
      containerType typeContext types.isTaggedUnion ! if
        break
      end
      op [] .pos context popValue =:: srcId
      sb
        op [] .pos sb.appendPosQBE
        containerType srcId op [] .val .hasElement op [] .pos context checkEnumIndex ..drop.2 =:: c
        "%s" sb.appendS
        ValType .I32 context pushValue sb.appendI
        " =w copy %t" sb.appendS
        c sb.appendI
        '\n' sb.appendC
      return
    autoCast case
      sb
        op [] .pos sb.appendPosQBE
        CastType .AUTO_CAST
        SignType .NONE
        op [] .val .autoCast .src
        op [] .val .autoCast .offset
        op [] .dataType
        op [] .pos
        context
      compileCast return
      break
    Cast Cast! bitCast case
      sb
        op [] .pos sb.appendPosQBE
        op [] .val .Cast ?? if
          CastType .CAST
          op [] .val .Cast .signType
          op [] .val .Cast .src
        else op [] .val .bitCast ?? _if
          CastType .BIT_CAST
          SignType .UNSIGNED
          op [] .val .bitCast
        else
          CastType .CAST!
          SignType .NONE ## XXX? use sign information for forced cast
          op [] .val .Cast!
        end
        0 ## no offset
        op [] .dataType
        op [] .pos
        context
      compileCast return
      break
    call case
      op .val .call =:: callInfo
      prog [] .procedures
        callInfo [] .procId i64 cast list.at .data
      =:: procData
      callInfo [] .implementationId 0 >= if
        procData [] .implementation .code .implementations
          callInfo [] .implementationId list.at .data
        [] .procType
      else
        procData [] .procType
      end =:: calledType
      calledType typeContext types.getProcIn .data =:: inTypes
      calledType typeContext types.getProcOutArgs =:: outArgs
      inTypes .length =:: argCount
      argCount TypedValId list.create =:: mut: argIndices
      sb
        op [] .pos sb.appendPosQBE
      =:: mut: newSb
      ## index of current auto-argument
      0:i32 =:: mut: autoArgIndex
      0:i32 while $ argCount i32 cast.u < do =:: i
        inTypes i [] =:: mut: arg
        calledType i typeContext types.getProcArgLabel =:: argLabel
        arg typeContext types.isEmpty if
          i 1 + continue ## skip empty arguments
        end
        argLabel labelContext id.labelFlags =:: argFlags
        argFlags id.FLAG_STATIC & ? if
          argFlags id.FLAG_AUTO & ? if
            autoArgIndex 1 + autoArgIndex=
          end
          i 1 + continue ## skip static arguments
        end
        argFlags id.FLAG_AUTO & ? if
          callInfo [] prog getCallData [] .autoArgs autoArgIndex [] =:: argVal
          autoArgIndex 1 + autoArgIndex=
          argVal .None ?? ! if
            newSb
              arg argVal op [] .pos context pushConstant
            newSb=
            argIndices
              arg op [] .pos context popValue TypedValId new list.append
            argIndices=
            i 1 + continue
          end
        end
        arg typeContext types.isArray and arg typeContext types.containsGeneric if
          arg false typeContext types.getAddressType arg=
        end
        argIndices
          arg -1 TypedValId new list.append
        argIndices=
        i 1 +
      end ..drop
      argIndices .length =:: outArgOffset
      ## reserve space for out-arguments
      outArgs for =:: arg
        arg typeContext types.isEmpty if
          ## skip empty arguments
          continue
        end
        argIndices
          arg -1 TypedValId new list.append
        argIndices=
      end
      argIndices .length =:: mut: argIndex
      while argIndex 0:iSize iSize.sgt do
        argIndex 1:iSize - argIndex=
        argIndices argIndex list.at .data [] .valId 0 >= if
          continue ## argument already set
        end
        ## get argument from stack
        argIndices argIndex list.at .data =:: arg
        op [] .pos context popValue arg .valId=
      end
      newSb
        calledType
          argIndices@
          outArgOffset
          op [] .pos
        context prepareCall
        procData [] .labelId
          callInfo [] .implementationId
        context sb.appendGlobalName
        calledType
          argIndices@
          outArgOffset
          op [] .pos
        context finishCall
      return
    callPtr case
      op [] .val .callPtr .outArgCount TypedValId list.create =:: mut: argIndices
      0:iSize while $ op [] .val .callPtr .outArgCount u< do =:: i
        argIndices
          ## TypedValId
            Type .undefined
            op [] .pos context popValue
          TypedValId new list.append
        argIndices=
        i 1:iSize +
      end ..drop
      op [] .pos context popValue =:: calledId
      op [] .dataType =:: mut: calledType
      calledType typeContext types.isPointer if
        calledType
          typeContext types.getBaseType
        calledType=
      end
      calledType typeContext types.getProcIn .data =:: inTypes
      calledType typeContext types.getProcOutArgs =:: outArgs
      0:iSize =:: mut: outArgCount
      0:iSize while ..dup outArgs .length u< do =:: i
        outArgs i [] =:: arg
        arg typeContext types.isEmpty if
          ## skip empty arguments
          i 1:iSize + continue
        end
        arg argIndices outArgCount list.at .data .valType=
        outArgCount 1:iSize + outArgCount=
        i 1:iSize +
      end ..drop
      outArgCount op [] .val .callPtr .outArgCount == "correct number of out arguments" assert
      inTypes .length =:: argCount
      argIndices
        $ .length argCount + list.ensureCap
      argIndices=
      argCount 1:iSize - i32 cast.u while $ 0 >= do =:: i
        inTypes i []
          $ typeContext types.isArray and $ typeContext types.containsGeneric if
            false typeContext types.getAddressType
          end
        =:: arg
        arg typeContext types.isEmpty if
          continue ## skip empty arguments
        end
        argIndices
          ## TypedValId
            arg
            op [] .pos context popValue
          TypedValId new list.append
        argIndices=
      finally i 1 - end ..drop
      ## arguments are popped in reverse order
      argIndices list.reverse
      argCount =:: outArgOffset
      sb
        calledType
          argIndices@
          outArgOffset
          op [] .pos
        context prepareCall
        "%s" sb.appendS
        calledId sb.appendI
        calledType
          argIndices@
          outArgOffset
          op [] .pos
        context finishCall
      return
    builtIn case
      sb
        op [] .pos sb.appendPosQBE
        ## appendBuiltInQBE
          op [] .val .builtIn
          op [] .dataType
          op [] .pos
          context
        appendBuiltInQBE
      return
    equalityOperator case
      op [] .val .equalityOperator .EQ if
        "eq":s
      else
        "ne":s
      end =:: cmpName
      op [] .dataType context referenceOnly ! if
        op [] .dataType context toValType =:: valType
        sb
          op [] .dataType true op [] .pos context extendArguments
          ## appendComparisonOperator
            cmpName
            valType
            op [] .pos
            context
          appendComparisonOperator
        return
      end
      op [] .dataType typeContext types.isEnum if
        op [] .pos context popValue =:: arg1
        op [] .pos context popValue =:: arg2
        sb
          op [] .dataType
            arg1
            op [] .pos
          context loadEnumLabel =:: valType =:: label1
          op [] .dataType
            arg2
            op [] .pos
          context loadEnumLabel ..drop =:: label2
          "%s" sb.appendS
          ValType .I32 context pushValue sb.appendI
          " =w c" sb.appendS
          cmpName sb.appendStr
          valType sb.appendValTypeQBE
          " %t" sb.appendS
          label1 sb.appendI
          ", %t" sb.appendS
          label2 sb.appendI
          '\n' sb.appendC
        return
      end
      break
    block case
      op [] .val .block .blockType switch
        IF IF_TRUE IF_FALSE case
          ## BranchId
            BranchType .LABEL
            opIndex
          BranchId new =:: ifBranch
          sb
            op [] .pos sb.appendPosQBE
            "jnz %s" sb.appendS
            op [] .pos context popValue sb.appendI
            ", " sb.appendS
            ifBranch sb.appendBranchId
            ", " sb.appendS
            ## appendBranchId
              BranchType .LABEL
              opIndex  op [] .val .block .jumpDistance i32 cast +
            BranchId new sb.appendBranchId
            '\n' sb.appendC
          =:: mut: newSb
          context [] .openBlocks list.peek =:: ifBlock?
          ifBlock? optional.hasData and
              ifBlock? .data =:: ifBlock
              ifBlock [] .If ?? and
              ifBlock [] .If .hasIf ! if
            ifBlock .If
          else ## start if block if not already open
            op [] .val .block .blockId context openIfBlock
            context [] .openBlocks list.peek .data .If
          end =:: ifBlock
          true ifBlock .hasIf=
          ifBlock [] .andBranches
            context .stackInfo branchTree.startBranch list.append
          ifBlock .andBranches=
          ifBlock [] .andBranchIds
            context [] .currentBranch list.append
          ifBlock .andBranchIds=
          ifBlock [] .orBranches .length 0:iSize != if
            ifBlock [] .orBranches
              context .stackInfo branchTree.startBranch list.append
            ifBlock .orBranches=
            ifBlock [] .orBranchIds
              context [] .currentBranch list.append
            ifBlock .orBranchIds=
            ## mergeValues
              context .stackInfo
              ifBlock [] .orBranches list.asSlice
              mergeBranches@
              ## MergePoint
                "or-if":s
                ifBlock [] .blockId
                ifBlock [] .orBranchIds list.asSlice
                op [] .pos
                context
                newSb@
              MergePoint new
            branchTree.merge .error ?? if
              "could not merge or-if branches" sb.copyPtr
              op [] .pos errors appendError
            end
          end
          newSb
            ifBranch "if":s context startBranch
          return
        AND_IF OR_IF AND_TRUE AND_FALSE OR_TRUE OR_FALSE case
          context [] .openBlocks list.peek =:: ifBlock?
          ifBlock? optional.hasData and
              ifBlock? .data =:: ifBlock
              ifBlock [] .If ?? and
              ifBlock [] .If .hasIf ! if
            ifBlock .If
          else ## start if block if not already open
            op [] .val .block .blockId context openIfBlock
            context [] .openBlocks list.peek .data .If
          end =:: ifBlock
          op [] .val .block .blockType .OR_IF or
            op [] .val .block .blockType .OR_TRUE or
            op [] .val .block .blockType .OR_FALSE end =:: isOr
          ## appendBranchId
            BranchType .NEXT
            context nextJumpLabelId
          BranchId new =:: nextBranch
          sb
            op [] .pos sb.appendPosQBE
            "jnz %s" sb.appendS
            op [] .pos context popValue sb.appendI
            ", " sb.appendS
            isOr if
              ## appendBranchId
                BranchType .LABEL
                opIndex  op [] .val .block .jumpDistance i32 cast +
              BranchId new sb.appendBranchId
              ", " sb.appendS
            end
            nextBranch sb.appendBranchId
            isOr ! if
              ", " sb.appendS
              ## appendBranchId
                BranchType .LABEL
                opIndex  op [] .val .block .jumpDistance i32 cast +
              BranchId new sb.appendBranchId
            end
            '\n' sb.appendC
            isOr if
              ifBlock [] .orBranches
                context .stackInfo branchTree.startBranch list.append
              ifBlock .orBranches=
              ifBlock [] .orBranchIds
                context [] .currentBranch list.append
              ifBlock .orBranchIds=
            else
              ifBlock [] .andBranches
                context .stackInfo branchTree.startBranch list.append
              ifBlock .andBranches=
              ifBlock [] .andBranchIds
                context [] .currentBranch list.append
              ifBlock .andBranchIds=
            end
            nextBranch
              "and/or if":s
            context startBranch
          return
        ELSE ELSE_TRUE ELSE_FALSE case
          context [] .openBlocks list.peek .data =:: ifBlock
          context .stackInfo ifBlock [] .If .branchRoot branchTree.reset =:: ifBranch
          context [] .reachable ifBlock .If .ifBranchTerminates=
          ## BranchPoint
          ifBranch ifBlock .If .ifBranch=
          context [] .currentBranch ifBlock .If .ifBranchId=
          sb
            ## don't add position for labels
            context [] .reachable if
              "jmp " sb.appendS
              ## appendBranchId
                BranchType .LABEL
                opIndex  op [] .val .block .jumpDistance i32 cast +
              BranchId new sb.appendBranchId
              '\n' sb.appendC
            end
            ## startBranch
              ## BranchId
                BranchType .LABEL
                opIndex
              BranchId new
              "else":s
              context
            startBranch
            true context .reachable=
          =:: mut: newSb
          ifBlock [] .If .andBranches .length 1:iSize u>= "if block has if branch" assert
          ## mergeValues
            context .stackInfo
            ifBlock [] .If .andBranches list.asSlice
            mergeBranches@
            ## MergePoint
              "and-if":s
              ifBlock [] .If .blockId
              ifBlock [] .If .andBranchIds list.asSlice
              op [] .pos
              context
              newSb@
            MergePoint new
          branchTree.merge .error ?? if
            "could not merge and-if branches" sb.copyPtr
            op [] .pos errors appendError
          end
          newSb return
        SWITCH case
          op [] .val .block .blockId =:: switchId
          prog [] .switchData
            switchId i64 cast list.at .data
          =:: switchData
          sb
            op [] .pos sb.appendPosQBE
            ## appendSwitchTable
              switchData [] .switchType
              op [] .pos context popValue
              switchData [] .defaultJumpDistance
              switchData [] .labels
              switchData [] .caseJumpDistances
              opIndex
              op [] .pos
              context
            appendSwitchTable
            switchId
              opIndex op [] .val .block .jumpDistance i32 cast +
            context openSwitchBlock
            false context .reachable=
          return
        CASE DEFAULT case
            sb
              ## startBranch
                ## BranchId
                  BranchType .LABEL
                  opIndex
                BranchId new
                "case/default":s
              context startBranch
              true context .reachable=
            return
        BREAK_SWITCH case
            ## findBreakableBlock
              op [] .val .block .blockId
              BreakType .SWITCH
              op [] .pos
              context
            findBreakableBlock =:: breakBlock?
            breakBlock? optional.isEmpty if
              ## error message handled by findBreakableBlock
              sb return
            end
            breakBlock? .data =:: breakBlock
            breakBlock [] .Switch ?? ! if
              "unexpected block for " sb.copyPtr
                BlockType .BREAK_SWITCH sb.appendBlockType
                ": " sb.appendS
                breakBlock [] sb.appendBlockInfo
              op [] .pos errors appendError
              sb return
            end
            context .stackInfo
              breakBlock [] .Switch .branchRoot
            branchTree.reset =:: caseBranchId
            ## remember break (if reachable)
            context [] .reachable if
              breakBlock [] .Switch .caseBranches
                caseBranchId list.append
              breakBlock .Switch .caseBranches=
              breakBlock [] .Switch .caseBranchIds
                context [] .currentBranch list.append
              breakBlock .Switch .caseBranchIds=
            end
            sb
              context [] .reachable if
                ## don't add jump in unreachable branches
                op [] .pos sb.appendPosQBE
                "jmp " sb.appendS
                ## BlockId
                  BranchType .LABEL
                  opIndex op [] .val .block .jumpDistance i32 cast +
                BranchId new sb.appendBranchId
                '\n' sb.appendC
              end
              false context .reachable=
            return
          break
        WHILE case
            ## don't add position before label
            op [] .val .block .blockId =:: whileId
            ## BranchId
              BranchType .LABEL
              opIndex
            BranchId new =:: branchId
            whileId
              opIndex
            context openWhileBlock
            context [] .openBlocks list.peek .data .While =:: whileBlock
            prog [] .whileData whileId i64 cast list.at .data =:: whileData
            context [] .currentBranch =:: prevBranch
            whileData [] .modifiedTypes =:: loopEltCount
            loopEltCount StackElement list.create =:: mut: loopElts
            context [] .stackInfo branchTree.depth loopEltCount < if
              "stack underflow" sb.copyPtr
              op [] .pos errors appendError
              sb return
            end
            0:i32 while ..dup loopEltCount < do 1 +
              loopElts
                context .stackInfo branchTree.pop .data list.appendP
              loopElts=
            end ..drop
            sb
              "jmp " sb.appendS
              branchId sb.appendBranchId
              '\n' sb.appendC
              branchId "while":s context startBranch
              loopEltCount 1 - while ..dup 0 >= do =:: i
                loopElts i list.at .data =:: elt
                "%s" sb.appendS
                elt [] .valType context pushValue sb.appendI
                " =" sb.appendS
                elt [] .valType sb.appendValTypeQBE
                " phi " sb.appendS
                prevBranch sb.appendBranchId
                " %s" sb.appendS
                elt [] .varId sb.appendI
                ',' sb.appendC
                ## BranchId
                  BranchType .LABEL_PRE
                  opIndex op [] .val .block .jumpDistance i32 cast +
                BranchId new sb.appendBranchId
                " %t" sb.appendS
                whileBlock [] .loopValOffset i + sb.appendI
                '\n' sb.appendC
                i 1 -
              end ..drop
              loopElts list.free loopElts=
            return
        AND_DO OR_DO case
          context [] .openBlocks list.peek .data .While =:: whileBlock
          op [] .val .block .blockType .OR_DO =:: isOr
          ## BranchId
            BranchType .NEXT
            context nextJumpLabelId
          BranchId new =:: nextBranch
          sb
            op [] .pos sb.appendPosQBE
            "jnz %s" sb.appendS
            op [] .pos context popValue sb.appendI
            ", " sb.appendS
            isOr if
              ## appendBranchId
                BranchType .LABEL
                opIndex op [] .val .block .jumpDistance i32 cast +
              BranchId new sb.appendBranchId
              ", " sb.appendS
            end
            nextBranch sb.appendBranchId
            isOr ! if
              ", " sb.appendS
              ## appendBranchId
                BranchType .LABEL
                opIndex op [] .val .block .jumpDistance i32 cast +
              BranchId new sb.appendBranchId
            end
            '\n' sb.appendC
            isOr if
              whileBlock [] .doBranches
                context .stackInfo branchTree.startBranch list.append
              whileBlock .doBranches=
              whileBlock [] .doBranchIds
                context [] .currentBranch list.append
              whileBlock .doBranchIds=
            else
              whileBlock [] .breakBranches
                context .stackInfo branchTree.startBranch list.append
              whileBlock .breakBranches=
              whileBlock [] .breakBranchIds
                context [] .currentBranch list.append
              whileBlock .breakBranchIds=
            end
            nextBranch "and/or do":s context startBranch
          return
        DO case
          context [] .openBlocks list.peek .data .While =:: whileBlock
          ## BranchId
            BranchType .LABEL
            opIndex
          BranchId new =:: doBranch
          sb
            op [] .pos sb.appendPosQBE
            "jnz %s" sb.appendS
            op [] .pos context popValue sb.appendI
            ", " sb.appendS
            doBranch sb.appendBranchId
            ", " sb.appendS
            ## appendBranchId
              BranchType .LABEL
              opIndex op [] .val .block .jumpDistance i32 cast +
            BranchId new sb.appendBranchId
            '\n' sb.appendC
          =:: mut: newSb
          whileBlock [] .breakBranches
            context .stackInfo branchTree.startBranch list.append
          whileBlock .breakBranches=
          whileBlock [] .breakBranchIds
            context [] .currentBranch list.append
          whileBlock .breakBranchIds=
          whileBlock [] .doBranches .length 0:iSize != if
            whileBlock [] .doBranches
              context .stackInfo branchTree.startBranch list.append
            whileBlock .doBranches=
            whileBlock [] .doBranchIds
              context [] .currentBranch list.append
            whileBlock .doBranchIds=
            ## mergeValues
            context .stackInfo
            whileBlock [] .doBranches list.asSlice
            mergeBranches@
            ## MergePoint
                "or-do":s
                whileBlock [] .blockId
                whileBlock [] .doBranchIds list.asSlice
                op [] .pos
                context
                newSb@
              MergePoint new
            branchTree.merge .error ?? if
              "could not merge or-do branches" sb.copyPtr
              op [] .pos errors appendError
            end
          end
          newSb
            doBranch "do":s context startBranch
          return
        BREAK CONTINUE case
          op [] .val .block .blockType =:: blockType
          ## findBreakableBlock
            op [] .val .block .blockId
            BreakType .WHILE
            op [] .pos
            context
          findBreakableBlock =:: breakBlock?
          breakBlock? optional.isEmpty if
            ## error message handled by findBreakableBlock
            sb return
          end
          breakBlock? .data =:: breakBlock
          breakBlock [] .While ?? ! if
            "unexpected block for " sb.copyPtr
              blockType sb.appendBlockType
              ": " sb.appendS
              breakBlock [] sb.appendBlockInfo
            op [] .pos errors appendError
            sb return
          end
          blockType .CONTINUE if
            breakBlock .While .continueBranches
            breakBlock .While .continueBranchIds
          else
            breakBlock .While .breakBranches
            breakBlock .While .breakBranchIds
          end =:: branchIds =:: branches
          branches []
            context .stackInfo branchTree.startBranch list.append
          branches =[]
          branchIds []
            context [] .currentBranch list.append
          branchIds =[]
          sb
            op [] .pos sb.appendPosQBE
            "jmp " sb.appendS
            ## BlockId
              BranchType .LABEL
              opIndex op [] .val .block .jumpDistance i32 cast +
            BranchId new sb.appendBranchId
            '\n' sb.appendC
            false context .reachable=
          return
        FINALLY case
          context [] .openBlocks list.peek
            .data .While
          =:: mut: whileBlock
          whileBlock .continueBranches =:: mut: continueBranches
          context [] .reachable if
            whileBlock .continueBranchIds []
              context [] .currentBranch list.append
            whileBlock .continueBranchIds =[]
            continueBranches []
              context .stackInfo branchTree.startBranch list.append
            continueBranches =[]
          end
          sb
            ## don't add position for labels
            ## startBranch
              ## BranchId
                BranchType .LABEL
                opIndex
              BranchId new
              "finally":s
              context
            startBranch
          =:: mut: newSb
          continueBranches .length [] 1:iSize u>= if
            continueBranches .length [] =:: nodeCount
            ## mergeValues
              context .stackInfo
              continueBranches [] list.asSlice
              mergeBranches@
              ## MergePoint
                "while":s
                whileBlock [] .blockId
                whileBlock .continueBranchIds [] list.asSlice
                op [] .pos
                context
                newSb@
              MergePoint new
            branchTree.merge .error ?? if
              "could not merge continue branches of while block" sb.copyPtr
              op [] .pos errors appendError
            end
          end
          newSb return
        AND OR case
          op [] .val .block .blockType .OR =:: isOr
          context [] .openBlocks list.peek =:: currentBlock?
          currentBlock? optional.hasData and
              currentBlock? .data =:: andOrBlock
              andOrBlock [] .AndOr ?? if
            andOrBlock .AndOr
          else ## start if block if not already open
            op [] .val .block .blockId context openAndOrBlock
            context [] .openBlocks list.peek .data .AndOr
          end =:: andOrBlock
          andOrBlock [] .branches
            context .stackInfo branchTree.startBranch list.append
          andOrBlock .branches=
          andOrBlock [] .branchIds
            context [] .currentBranch list.append
          andOrBlock .branchIds=
          ## BranchId
            BranchType .NEXT
            context nextJumpLabelId
          BranchId new =:: nextBranch
          sb
            op [] .pos sb.appendPosQBE
            "jnz %s" sb.appendS
            op [] .pos context popValue sb.appendI
            ", " sb.appendS
            isOr ! if
              nextBranch sb.appendBranchId
              ", " sb.appendS
            end
            ## appendBranchId
              BranchType .LABEL
              opIndex op [] .val .block .jumpDistance i32 cast +
            BranchId new sb.appendBranchId
            isOr if
              ", " sb.appendS
              nextBranch sb.appendBranchId
            end
            '\n' sb.appendC
            nextBranch "and/or":s context startBranch
          return
        INLINE_PROCEDURE case sb return
        PROCEDURE INITIALIZER NAMESPACE TYPE_TYPESET DOT_CASE
        TYPE_TUPLE TYPE_STRUCT TYPE_ENUM TYPE_UNION TYPE_UNTAGGED_UNION TYPE_PROC_IN
        TYPE_CPROC_IN TYPE_PROC_ARROW TYPE_COMPOSITE UNKNOWN case
          ## XXX error message
          break
      end
      break
    blockEnd case
      op [] .val .blockEnd .blockType switch
        PROCEDURE case
          Type .undefined context .currentProc=
          sb
            ## end of procedure block always unreachable
            ## ( type-checker ensures there is a return before end )
            "@end\nhlt\n}\n" sb.appendS
            op [] .pos context sb.appendLocalConstants
          return
        INLINE_PROCEDURE case
          sb
            ## BranchId
              BranchType .END_INLINE
              op [] .val .blockEnd .blockId i32 cast
            BranchId new "inline proc":s context startBranch
            ## TODO merge branches if neccessary
          return
        ELSE case
          context [] .openBlocks
            list.pop .If =:: ifBlock
          context .openBlocks=
          branchTree.NodeId 2 array new =:: mut: branches
          BranchId 2 array new =:: mut: branchIds
          0 =:: mut: nBranches
          ifBlock .ifBranchTerminates if
            ifBlock .ifBranch branches@ nBranches =[]
            ifBlock .ifBranchId branchIds@ nBranches =[]
            nBranches 1 + nBranches=
          end
          context [] .reachable if
            context .stackInfo branchTree.startBranch branches@ nBranches =[]
            context [] .currentBranch branchIds@ nBranches =[]
            nBranches 1 + nBranches=
          end
          sb
            ## don't add position for labels
            ## startBranch
              ## BranchId
                BranchType .LABEL
                opIndex
              BranchId new
              "end if":s
              context
            startBranch
          =:: mut: newSb
          nBranches 1 >= if
            ## mergeValues
              context .stackInfo
              branches@ nBranches slice.create
              mergeBranches@
              ## MergeIf
                "if":s
                ifBlock .blockId
                branchIds@ nBranches slice.create
                op [] .pos
                context
                newSb@
              MergePoint new
            branchTree.merge .error ?? if
              "could not merge branches of if-else block" sb.copyPtr
              op [] .pos errors appendError
            end
          end
          nBranches 0 > context .reachable=
          ifBlock .andBranches list.free ..drop
          ifBlock .andBranchIds list.free ..drop
          ifBlock .orBranches list.free ..drop
          ifBlock .orBranchIds list.free ..drop
          newSb return
        SWITCH case
          context [] .openBlocks
            list.pop .Switch =:: switchBlock
          context .openBlocks=
          switchBlock .caseBranches =:: caseBranches
          caseBranches .length 0:iSize != context .reachable=
          sb
            ## don't add position for labels
            ## startBranch
              ## BranchId
                BranchType .LABEL
                opIndex
              BranchId new
              "end switch":s
              context
            startBranch
          =:: mut: newSb
          caseBranches .length 1:iSize u>= if
            caseBranches .length =:: nodeCount
            ## mergeValues
              context .stackInfo
              caseBranches list.asSlice
              mergeBranches@
              ## MergePoint
                "switch":s
                switchBlock .blockId
                switchBlock .caseBranchIds list.asSlice
                op [] .pos
                context
                newSb@
              MergePoint new
            branchTree.merge .error ?? if
              "could not merge branches of switch-case block" sb.copyPtr
              op [] .pos errors appendError
            end
          end
          caseBranches .length 0:iSize != context .reachable=
          caseBranches list.free ..drop
          switchBlock .caseBranchIds list.free ..drop
          newSb return
        WHILE case
          context [] .openBlocks
            list.pop .While =:: mut: whileBlock
          context .openBlocks=
          prog [] .whileData whileBlock .blockId i32 cast list.at .data =:: whileData
          context [] .stackInfo branchTree.depth whileData [] .modifiedTypes < if
            "stack underflow" sb.copyPtr
            op [] .pos errors appendError
            sb return
          end
          sb
            ## copy values to loop vars
            0:i32 while ..dup whileData [] .modifiedTypes < do =:: i
              context .stackInfo branchTree.pop .data =:: elt
              "%t" sb.appendS
              whileBlock .loopValOffset i + sb.appendI
              " =" sb.appendS
              elt [] .valType sb.appendValTypeQBE
              " copy %s" sb.appendS
              elt [] .varId sb.appendI
              '\n' sb.appendC
              i 1 +
            end ..drop
            ## BranchId
              BranchType .LABEL_PRE
              opIndex
            BranchId new sb.appendBranchId
            ## jump to start of loop
            "\njmp " sb.appendS
            ## BranchId
              BranchType .LABEL
              opIndex op [] .val .blockEnd .jumpDistance i32 cast +
            BranchId new sb.appendBranchId
            '\n' sb.appendC
          =:: mut: newSb
          newSb
            ## don't add position for labels
            ## startBranch
              ## BranchId
                BranchType .LABEL
                opIndex
              BranchId new
              "end while":s
              context
            startBranch
          newSb=
          whileBlock .breakBranches =:: breakBranches
          breakBranches .length 1:iSize u>= if
            breakBranches .length =:: nodeCount
            ## mergeValues
              context .stackInfo
              breakBranches list.asSlice
              mergeBranches@
              ## MergePoint
                "while":s
                whileBlock .blockId
                whileBlock .breakBranchIds list.asSlice
                op [] .pos
                context
                newSb@
              MergePoint new
            branchTree.merge .error ?? if
              "could not merge break branches of while block" sb.copyPtr
              op [] .pos errors appendError
            end
          end
          breakBranches .length 0:iSize != context .reachable=
          breakBranches list.free ..drop
          whileBlock .breakBranchIds list.free ..drop
          whileBlock .continueBranches list.free ..drop
          whileBlock .continueBranchIds list.free ..drop
          whileBlock .doBranches list.free ..drop
          whileBlock .doBranchIds list.free ..drop
          newSb return
        AND OR case
          context [] .openBlocks
            list.pop .AndOr =:: mut: andOrBlock
          context .openBlocks=
          andOrBlock .branches
            context .stackInfo branchTree.startBranch list.append
          andOrBlock@ .branches=
          andOrBlock .branchIds
            context [] .currentBranch list.append
          andOrBlock@ .branchIds=
          sb
            ## startBranch
              ## BranchId
                BranchType .LABEL
                opIndex
              BranchId new
              "end and/or":s
              context
            startBranch
          =:: mut: newSb
          ## mergeValues
            context .stackInfo
            andOrBlock .branches list.asSlice
            mergeBranches@
            ## MergePoint
              "and/or":s
              andOrBlock .blockId
              andOrBlock .branchIds list.asSlice
              op [] .pos
              context
              newSb@
            MergePoint new
          branchTree.merge .error ?? if
            "could not merge break branches of and/or block" sb.copyPtr
            op [] .pos errors appendError
          end
          andOrBlock .branches list.free ..drop
          andOrBlock .branchIds list.free ..drop
          newSb return
        IF DO BREAK CONTINUE CASE DOT_CASE DEFAULT BREAK_SWITCH
        AND_IF OR_IF AND_DO OR_DO INITIALIZER NAMESPACE FINALLY
        IF_TRUE IF_FALSE AND_TRUE AND_FALSE
        OR_TRUE OR_FALSE ELSE_TRUE ELSE_FALSE TYPE_TYPESET
        TYPE_TUPLE TYPE_STRUCT TYPE_ENUM TYPE_UNION TYPE_UNTAGGED_UNION TYPE_PROC_IN
        TYPE_CPROC_IN TYPE_PROC_ARROW TYPE_COMPOSITE UNKNOWN case
          ## XXX error message
          break
      end
      break
    Return case
      op [] .dataType typeContext types.isProcedure ! if
        "unexpected type for return: " sb.copyPtr
          op [] .dataType typeContext sb.appendType
          " expected procedure" sb.appendS
        op [] .pos errors appendError
        sb return
      end
      op [] .dataType typeContext types.getProcRet =:: retType
      op [] .dataType typeContext types.getProcOutArgs =:: outTypes
      retType switch
        Empty case 0:i32 break
        Value case 1:i32 break
        Tuple case retType .Tuple typeContext types.compositeEltCount break
      end =:: retCount
      false context .reachable=
      sb
        op [] .pos sb.appendPosQBE
        retCount 1 == if
          op [] .pos context popValue
          "ret %s":s
        else retCount 0 > _if
          retType .Value ?? if retType .Value else retType .Tuple end =:: retVal
          retVal op [] .pos context true appendAlloc =:: tmpId
          retVal 't' tmpId op [] .pos context initializeTupleQBE
          tmpId
          "ret %t":s
        else
          -1:i32  string.empty ## values will be ignored
        end =:: retStr =:: retId
        outTypes .length 1:iSize - i32 cast while $ 0 >= do =:: i
          outTypes i [] =:: elt
          elt typeContext types.isEmpty if
            i 1 - continue
          end
          elt context referenceOnly if
            "blit" sb.appendS
          else
            "store" sb.appendS
            elt StorageType .STORE op [] .pos context sb.appendTypeNameQBE
          end
          " %s" sb.appendS
          op [] .pos context popValue sb.appendI
          ", " sb.appendS
          i context sb.appendOutArgName
          elt context referenceOnly if
            ", " sb.appendS
            elt op [] .pos context typeSizeInt sb.appendI
          end
          '\n' sb.appendC
        i 1 -
        end ..drop
        retCount 0 == if
          "ret\n" sb.appendS
          return
        end
        retStr sb.appendStr
        retId sb.appendI
        '\n' sb.appendC
      return
    InlineReturn case
      sb
        "jmp " sb.appendS
        ## BranchId
          BranchType .END_INLINE
          op [] .val .InlineReturn i32 cast
        BranchId new sb.appendBranchId
        '\n' sb.appendC
        ## TODO! keep track of branches
      return
    RuntimeAssert case
      ## BranchId
        BranchType .NEXT
        context nextJumpLabelId
      BranchId new =:: successBranch
      ## BranchId
        BranchType .ERROR
        context nextJumpLabelId
      BranchId new =:: errorBranch
      sb
        op [] .pos sb.appendPosQBE
        "## assert\n" sb.appendS
        "jnz %s" sb.appendS
        op [] .pos context popValue sb.appendI
        ", " sb.appendS
        successBranch sb.appendBranchId
        ", " sb.appendS
        errorBranch sb.appendBranchId
        '\n' sb.appendC
        errorBranch sb.appendBranchId
        '\n' sb.appendC
        "call $printf(l $" sb.appendS
        ASSERT_FORMAT sb.appendS
        ",l " sb.appendS
        op [] .val .RuntimeAssert .length sb.appendI
        ",l " sb.appendS
        op [] .val .RuntimeAssert context sb.appendStringPtrConstQBE
        op [] .pos prog appendPosPrintfArgs
        ")\ncall $exit(w 1)\nhlt\n" sb.appendS
        successBranch "end assert":s context startBranch
      return
    panicWithMessage case
      false context .reachable=
      sb
        op [] .pos sb.appendPosQBE
        "call $printf(l $" sb.appendS ## TODO? print to stderr
        PANIC_FORMAT sb.appendS
        ",l " sb.appendS
        op [] .val .panicWithMessage .length sb.appendI
        ",l " sb.appendS
        op [] .val .panicWithMessage context sb.appendStringPtrConstQBE
        op [] .pos prog appendPosPrintfArgs
        ")\ncall $exit(w 1)\nhlt\n" sb.appendS
      return
    stackMod case
      op [] .val .stackMod .modType switch
        DROP case
          op [] .val .stackMod .n =:: count
          count while ..dup 0 > do 1 -
             context .stackInfo branchTree.pop ..drop
          end ..drop
          sb return
        COPY case
          op [] .val .stackMod .n =:: offset
          context [] .stackInfo branchTree.depth offset <= if
            "stack underflow" sb.copyPtr
            op [] .pos errors appendError
            sb return
          end
          ## copy value on stack
          context .stackInfo
            offset
          branchTree.at .data =:: copied
          context .stackInfo
            copied []
          branchTree.push
          sb return
        ROTATE case
          op [] .val .stackMod .n =:: offset
          offset i32.abs 1 + =:: eltCount
          context [] .stackInfo branchTree.depth eltCount < if
            "stack underflow" sb.copyPtr
            op [] .pos errors appendError
            sb return
          end
          context .stackInfo eltCount offset 0 > branchTree.rotate
          sb return
      end
      break
    compilerInfo case
      sb return ## XXX? print compiler info
    autoTypedInitializeId typeInfo copy usingNamespace usingIdentifier StaticConstant
    getName atName setName getLabel getUnionLabel Error Assert panic declareName initializeName
    setLabel length typeModifier hasLabel existsLabel existsName NestedProc case
      break ## XXX error message
  end
  "unable to compile operation " sb.copyPtr
    op [] prog sb.appendOp
  op [] .pos errors appendError
  sb return
end

proc( CompilerContext ptr.mut : context -> ) =>: cleanupCompilerContext
  context .stackInfo branchTree.free
  context [] .openBlocks
    list.free
  context .openBlocks=
  context [] .localConstants
    list.free
  context .localConstants=
  context [] .stringConstants
    list.free
  context .stringConstants=
  context [] .ptrConstants
    list.free
  context .ptrConstants=
end
proc( io.FILE : target ProgramContext ptr.mut : program -> ) =>: export: compileToQBE
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  ## CompilerContext
    program
    StackElement branchTree.create
    BranchType .START 0 BranchId new
    32 BlockInfo list.create
    32 LocalConst list.create
    32 string list.create
    32 PtrConstant list.create
    types.typeHash@ types.typeEquals@ 1024 i64 map.create
    0
    Type .undefined
    0
    0
    0
    0
    true
  CompilerContext new =:: mut: contextData
  contextData@ =:: context
  program [] .mainLabelId =:: mainId
  program [] .progFiles 0 list.at .data [] .fileScope idContext id.setScope
  labelContext id.clearNamespace
  1024 sb.create
    program getDeclaredTypes =:: types
    types for =:: t
      t
        ## TODO? use declaration position of type
        FILE_POS_UNKNOWN
      context sb.appendTypeDeclarationQBE
    end
    program [] .hasCheckEnum if
      "data $" sb.appendS
      CHECK_ENUM_FORMAT sb.appendS
      " = { b \"enum index (%i) does not match current value (%u) at %.*s:%i:%i\\n\", b 0 }\n" sb.appendS
    end
    "data $" sb.appendS
    ASSERT_FORMAT sb.appendS
    " = { b \"assertion failed: \\\"%.*s\\\" at %.*s:%i:%i\\n\", b 0 }\n" sb.appendS
    "data $" sb.appendS
    PANIC_FORMAT sb.appendS
    " = { b \"PANIC!: \\\"%.*s\\\" at %.*s:%i:%i\\n\", b 0 }\n" sb.appendS
  =:: mut: sb
  ## TODO find better way to iterate through all global variables
  idContext .identifierNames map.itr.start while map.itr.hasNext do map.itr.next
    =:: declaration ## TODO find out which declarations are actually used
    declaration .1 [] .aliasId id.NO_ALIAS != if continue end
    declaration .1 [] .labelId =:: labelId
    labelId idContext id.getIdentifier
      ! "labelId is identifier" assert
    =:: idData
    idData [] .idType .GLOBAL_VAR ! if
      continue
    end
    idData [] .valueType =:: mut: valType
    labelId labelContext id.labelFlags =:: labelFlags
    valType types.isAutoType if
      program [] .autoTypes
        valType types.getAutoTypeId
      list.at .data []
      valType=
    end
    valType types.primitive.TYPE types.typeEquals or
        valType typeContext types.isEmpty or
        valType typeContext types.isProcedure or
        labelFlags id.FLAG_EXTERN & ? if
      continue
    end
    sb
      labelFlags id.FLAG_EXPORT & ? if
        "export " sb.appendS
      end
      "data " sb.appendS
      labelId -1 context sb.appendGlobalName
      " = align " sb.appendS
      valType idData [] .declaredAt context typeAlignmentInt sb.appendI
      " {" sb.appendS
      idData [] .constValue .None ?? ! if
        valType idData [] .constValue true idData [] .declaredAt context sb.appendConstQBE
      else
        "z " sb.appendS
        valType idData [] .declaredAt context typeSizeInt sb.appendI
      end
      "}\n" sb.appendS
      target ..over io.fputSb ..drop
      sb.clear
    sb=
  end ..drop
  sb
    ## constant references
    program [] .constantReferences .length for =:: i
      program [] .constantReferences i [] =:: constRef
      "data $" sb.appendS
      CONST_REFERENCE_NAME sb.appendS
      i sb.appendI
      " = {" sb.appendS
        constRef .constType constRef .value true constRef .pos context sb.appendConstQBE
      "} \n" sb.appendS
    end
    program [] .progFiles .length for =:: fileId
      "data $" sb.appendS
      FILE_NAME_NAME sb.appendS
      fileId sb.appendI
      " = {" sb.appendS
        program [] .progFiles fileId [] .fileName sb.asStr string.bytes 'b' true sb.appendPrimitiveArrayConstQBE
      "} \n" sb.appendS
    end
    ## code
    program [] .procedures for =:: proc
      proc .implementation .code ?? ! if continue end
      proc .implementation .code =:: impl
      impl .codeState .UNUSED if continue end
      program [] .progFiles proc .fileId iSize cast.u list.get .if =:: f
        "dbgfile \"" sb.appendS
        f .fileName sb.appendSb
        "\"\n"    sb.appendS
      else
        "dbgfile \"..internal\"\n"    sb.appendS
      end
      impl .codeState .COMPILED if
        impl .code .length for i32 cast.u =:: opIndex
          impl .code opIndex @[] opIndex context compileOp
        end
        target ..over io.fputSb ..drop
        sb.clear
      end
      impl .implementations for =:: genericImpl
        genericImpl .codeState .COMPILED if
          genericImpl .code .length for i32 cast.u =:: opIndex
            genericImpl .code opIndex @[] opIndex context compileOp
          end
          target ..over io.fputSb ..drop
          sb.clear
        end
      end
    end
    target ..over io.fputSb ..drop
    sb.clear
    context [] .stringConstants .length for =:: i
      context [] .stringConstants i [] =:: str
      "data $" sb.appendS
      STRING_CONST_NAME sb.appendS
      i sb.appendI
      " = {" sb.appendS
        str string.bytes 'b' true sb.appendPrimitiveArrayConstQBE
      "} ## \"" sb.appendS
      str sb.appendEscapedStr
      "\"\n" sb.appendS
    end
    ## cannot replace with for as loop-counter is changed during loop
    0:iSize while $ context [] .ptrConstants .length u< do =:: i
      context [] .ptrConstants i list.at .data =:: val
      "data $" sb.appendS
      PTR_CONST_NAME sb.appendS
      i sb.appendI
      " = {" sb.appendS
        val context sb.appendPtrConstDataQBE
      "}\n" sb.appendS ## XXX? append string value of string16/string32 constants
    finally i 1:iSize + end ..drop
    target ..over io.fputSb ..drop
    sb.clear
    mainId id.LABEL_ID_NONE == if ## no main
      sb.free ..drop
      context cleanupCompilerContext
      return
    end
    program [] .hasGetArgs if
      "data $" sb.appendS
      CONCAT_ARGC_NAME sb.appendS
      " = { l 0 }\n" sb.appendS
      "data $" sb.appendS
      CONCAT_ARGV_NAME sb.appendS
      " = { l 0 }\n" sb.appendS
      "data $" sb.appendS
      CONCAT_ENVP_NAME sb.appendS
      " = { l 0 }\n" sb.appendS
      "export function w $main(l %argc,l %argv,l %envp){\n@start\n" sb.appendS
      "storel %argc,$" sb.appendS
      CONCAT_ARGC_NAME sb.appendS
      '\n' sb.appendC
      "storel %argv,$" sb.appendS
      CONCAT_ARGV_NAME sb.appendS
      '\n' sb.appendC
      "storel %envp,$" sb.appendS
      CONCAT_ENVP_NAME sb.appendS
      '\n' sb.appendC
      "call " sb.appendS
    else
      "export function w $main(){\n@start\ncall " sb.appendS
    end
    mainId -1 context sb.appendGlobalName
    "()\nret 0\n}\n" sb.appendS
    target ..over io.fputSb ..drop
  sb.free ..drop
  context cleanupCompilerContext
end
