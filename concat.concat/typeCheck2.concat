        #dup .length =:: childOffset
        container .opIndex list.append
        containerType typeContext types.isEnum if
          containerType elementIndex op [] .pos opCheckEnum state appendOp onRead =
          true true 0 0 state updateOpInfo
          onRead list.append
          childCount 1 + childCount =
        end
      state [] .childIds =
      ## pushValue
        ConstValue .none ## XXX compute constant value
        srcType elementIndex op [] .pos isAddr if op@Element else opGetElement end
      state pushValue
      isAddr srcType typeContext types.isPointer | if
        eltType mutable typeContext types.getAddressType
      else srcType typeContext types.isReference _if
        eltType mutable typeContext types.newReferenceType
      else
        eltType
      end =:: targetType
      targetType state replaceType
      elementLabel state replaceLabel
      onRead state [] .stack list.peek .data [] .readCheckIndex =
      mutable ! true childCount childOffset state updateOpInfo
      return
    getElement @Element case
      break
    getArrayElement @ArrayElement case ## TODO? extract to procedure
      op [] .val .@ArrayElement ?? =:: isAddr
      0 =:: mut indexCount
      state [] .stack .length while #dup 0 > do 1 -
        state [] .stack #over list.at .data =:: typeInfo
        typeInfo [] .valueType typeContext types.isReference if
          ## unwrap references
          typeInfo [] .valueType typeContext types.getBaseType
        else
          typeInfo [] .valueType
        end =:: baseType
        baseType typeContext types.isPointer if
          break
        end
        baseType typeContext types.isArray if
          break
        end
        baseType typeContext types.isInt ! if #drop
          "invalid type for operation " sb.wrap
            op [] constContext labelContext typeContext sb.appendOp
            " " sb.appendS
            typeInfo [] .valueType labelContext typeContext sb.appendType
            " is not a pointer or integer" sb.appendS
          op [] .pos errors appendError
          return
        end
        indexCount 1 + indexCount =
      end =:: offset
      offset 0 < if
        "missing type for operation " sb.wrap
          op [] constContext labelContext typeContext sb.appendOp
          " expected pointer" sb.appendS
        op [] .pos errors appendError
      end
      state [] .stack offset list.at .data [] .valueType =:: srcType
      srcType op [] .dataType =
      srcType
        #dup typeContext types.isReference if
          typeContext types.getBaseType
        end
      =:: arrayType
      arrayType typeContext types.getArrayDims =:: dimensions
      indexCount dimensions > if
        "too much indices for pointer access " sb.wrap
          indexCount sb.appendI
          " dimensions:" sb.appendS
          dimensions sb.appendI
        op [] .pos errors appendError
        return
      end
      arrayType typeContext types.isFixedSize =:: fixedSize
      arrayType typeContext types.getArraySize =:: size
      indexCount fixedSize ! if 1 - end =:: checkedIndices
      isAddr if
        indexCount op [] .val .@ArrayElement =
      else
        indexCount op [] .val .getArrayElement =
      end
      indexCount Type list.create =:: mut typeBuffer ## XXX? store type-buffer in context
      typeBuffer
        srcType list.append
        #dup .length =:: bufferOffset
        indexCount 1 - while #dup 0 >= do ## push index types in reverse order (0th index last)
          #swap
            arrayType #over:2 typeContext types.getIndexType if
              "could not find index type for index " sb.wrap
                #over:3 sb.appendI
              op [] .pos errors appendError
            end list.append
          #swap 1 -
        end #drop
      typeBuffer =
      ## requireTypes
        typeBuffer list.asArray
        "index" string.wrap
        op [] .pos
      state requireTypes if
        #drop return
      end =:: opOffset
      typeBuffer list.free #drop
      ConstValue .none op [] state pushValue
      indexCount 0 == if
        dimensions 1 -
      else
        dimensions indexCount -
      end =:: freeDimensions
      arrayType typeContext types.isArray if
        srcType
      else
        arrayType
      end typeContext types.isMutable =:: mutable
      arrayType typeContext types.getBaseType
        freeDimensions 0 > if
          ## newArrayType
            #+baseType+#
            isAddr
            size freeDimensions array.head
            true ## remaining dimensions always fixed size
            mutable
          typeContext types.newArrayType if
            "could not create array type" sb.wrap
            op [] .pos errors appendError
          end
        end
        isAddr ! if
          #+eltType+# mutable typeContext types.newReferenceType
        end
      state replaceType
      fixedSize isAddr | #dup indexCount 1 + opOffset state updateOpInfo
      return
    Cast Cast! case
      op [] .dataType .undefined ?? if
        ## resolve data type
        op [] .pos state popType op [] .dataType =
      end
      1 op [] .pos state checkStackSize if
        return
      end
      state [] .stack
        list.pop =:: value
      state [] .stack =
      op [] .val .Cast ?? if
        value .valueType op [] .val .Cast =
      else
        value .valueType op [] .val .Cast! =
      end
      ## canCast
        value .valueType
        op [] .dataType
        op [] .val
        .Cast! ??
      typeContext types.canCast ! if
        "cannot cast " sb.wrap
          value .valueType labelContext typeContext sb.appendType
          " to " sb.appendS
          op [] .dataType labelContext typeContext sb.appendType
        op [] .pos errors appendError
      end
      ## XXX try cast constant on stack
      value .value op [] state pushValue
      state [] .childIds
        #dup .length =:: offset
        value .opIndex list.append
      state [] .childIds =
      true true 1 offset state updateOpInfo
      return
    New case
      op [] .dataType .undefined ?? if
        ## resolve data type
        op [] .pos state popType op [] .dataType =
      end
      op [] .dataType typeContext types.isArray if
        op [] .dataType typeContext types.isFixedSize ! if
          "variable size arrays are not supported" sb.wrap op [] .pos errors appendError
        end
        ConstValue .none op [] state pushValue
        true true 0 0 state updateOpInfo
        return
      end
      op [] .dataType typeContext types.isTuple if
        op [] .dataType typeContext types.compositeEltCount =:: count
        ## requireTypes
          op [] .dataType typeContext types.compositeElts
          "tuple element" string.wrap
          op [] .pos
        state requireTypes if
          #drop return
        end =:: opOffset
        ConstValue .none op [] state pushValue
        false true count opOffset state updateOpInfo
        return
      end
      break
    block case
      op [] .val .block .blockType switch
        TYPE_TUPLE
        TYPE_STRUCT
        TYPE_ENUM
        TYPE_UNION
        TYPE_PROC_IN
        TYPE_PROC_OUT
        TYPE_COMPOSITE
        INITIALIZER case
          state unfreezeInterpreter
          ## type-blocks and initializers are handled by the interpreter
          op state [] .interpreter @ true evaluateOperation if
            "could not evaluate " sb.wrap
              op [] .val .block .blockType sb.appendBlockType
              " block" sb.appendS
            op [] .pos errors appendError
          end
          return
        PROCEDURE
        EXPERIMENTAL_PROCEDURE
        IF
        IFIF
        ELSE
        WHILE
        DO
        BREAK
        CONTINUE
        SWITCH
        CASE
        DEFAULT
        UNKNOWN case
          break
      end
      break
    blockEnd case
      op [] .val .blockEnd .blockType switch
        TYPE_TUPLE
        TYPE_STRUCT
        TYPE_ENUM
        TYPE_UNION
        TYPE_PROC_IN
        TYPE_PROC_OUT
        TYPE_COMPOSITE
        INITIALIZER case ## XXX allow dynamic interpreter blocks
          "could not evaluate " sb.wrap
            op [] .val .blockEnd .blockType sb.appendBlockType
            " block" sb.appendS
          op [] .pos errors appendError
          return
        PROCEDURE EXPERIMENTAL_PROCEDURE case
          op [] .pos state closeBlock =:: closed
          closed op [] .val .blockEnd .blockType != if
            "unexpected end of " sb.wrap
              closed sb.appendBlockType
              " block expected " sb.appendS
              op [] .val .blockEnd .blockType sb.appendBlockType
            op [] .pos errors appendError
          end
          op [] state appendOp #drop
          return
        IF
        IFIF
        ELSE
        WHILE
        DO
        BREAK
        CONTINUE
        SWITCH
        CASE
        DEFAULT
        UNKNOWN case
          break
      end
      break
    length size case
      state [] .stack list.peek =:: value?
      value? optional.isEmpty if
        "missing argument for " sb.wrap
          op [] constContext labelContext typeContext sb.appendOp
          " expected pointer or array" sb.appendS
        op [] .pos errors appendError
        return
      end
      value? .data [] .valueType =:: mut valType
      valType typeContext types.isReference if ## unwrap references
        valType typeContext types.getBaseType valType =
      end
      valType typeContext types.isPointer valType typeContext types.isArray | if
        valType typeContext types.isFixedSize ! if
          "invalid operand for : " sb.wrap
            op [] constContext labelContext typeContext sb.appendOp
            " cannot get the length of " sb.appendS
            valType labelContext typeContext sb.appendType
          op [] .pos errors appendError
          return
        end
        1 op [] .pos state discardValues ## remove value from stack
        valType typeContext types.getArraySize =:: sizes
        op [] .val .length ?? if
          sizes .length 0 == if
            1 ConstValue .int new types.primitive.I_SIZE op [] .pos state pushConstant
            return
          else sizes 0 array.get .sizeType .int ?? _if
            ## pushConstant
              sizes 0 array.get .value ConstValue .int new
              types.primitive.I_SIZE
              op [] .pos
            state pushConstant
            return
          else sizes 0 array.get .sizeType .staticArg ?? _if
            ## pushConstant
              sizes 0 array.get .value i32 cast ConstValue .genericArg new
              types.primitive.I_SIZE
              op [] .pos
            state pushConstant
            return
          else
            "unsupported array-size type for " sb.wrap
              op [] constContext labelContext typeContext sb.appendOp
            op [] .pos errors appendError
            return
          end
        else
          idContext [] .templateArgBuffer .length =:: offset
          0 while #dup sizes .length < do
            sizes #over array.get =:: current
            idContext [] .templateArgBuffer
              current .sizeType .int ?? if
                current .value ConstValue .int new list.append
              else current .sizeType .staticArg ?? _if
                current .value i32 cast ConstValue .genericArg new list.append
              else #drop:2
                "unsupported array-size type for " sb.wrap
                  op [] idContext [] .constContext @ labelContext typeContext sb.appendOp
                op [] .pos errors appendError
                return
              end
            idContext [] .templateArgBuffer =
            1 +
          end #drop
          sizes .length types.ArraySizeType .int types.ArraySize new =:: sizeLength
          ## pushConstant
            ## newArrayConst
              idContext [] .templateArgBuffer .data offset + idContext [] .templateArgBuffer .length offset - array.create
              idContext [] .constContext @
            newArrayConst
            types.primitive.I_SIZE false sizeLength @ array.wrap true false typeContext types.newArrayType #drop
            op [] .pos
          state pushConstant
          idContext [] .templateArgBuffer
            offset list.setLength
          idContext [] .templateArgBuffer =
          return
        end
      end ## XXX? support length on structs/tuples/enums
      "unsupported argument type for " sb.wrap
        op [] constContext labelContext typeContext sb.appendOp
        valType labelContext typeContext sb.appendType
      op [] .pos errors appendError
      return
      break
    Return getName
    newEnum call callPtr
    argc getArg getArgLen
    unaryOperator binaryOperator
    checkEnumLabel setEnumLabel
    checkArrayIndex setName @Name
    hasName hasElement
    compilerInfo unreachable case
      break
    Print case
      1 op [] .pos state checkStackSize if
        return
      end
      state [] .stack
        list.pop =:: value
      state [] .stack =
      value .valueType op [] .dataType =
      op [] state appendOp #drop
      return
    stackMod case
      op [] .val .stackMod .modType switch
        DROP case
          op [] .val .stackMod .n op [] .pos state discardValues
          return
        COPY case
          op [] .val .stackMod .n =:: offset
          offset op [] .pos state checkStackSize if
            return
          end
          ## copy value on stack
          state [] .stack state [] .stack .length 1 - offset - list.at .data =:: copied
          state [] .stack
            copied list.appendP
          state [] .stack =
          state [] .stack list.peek .data =:: newOp
          op [] .pos newOp [] .pushedAt =
          ## copy value in code
          copied [] .opIndex op [] .pos state tryCopyOp if #drop
            op [] state appendOp
          end newOp [] .opIndex =
          return
        SWAP case
          2 op [] .pos state checkStackSize if
            return
          end
          state [] .stack .length 2 - =:: offset
          state [] .stack offset list.at .data =:: lower
          ## swap values in code
          lower [] .opIndex op [] .pos state tryCopyOp if #drop
            op [] state appendOp #drop
          else =:: newIndex
            ## discard old operations for lower value
            lower [] .opIndex state tryDeleteOp if
              "internal compiler error: could not move operation" sb.wrap
              op [] .pos errors appendError
            end
            newIndex lower [] .opIndex =
          end
          ## swap values on stack
          state [] .stack
            lower list.appendP
          state [] .stack =
          ## mem.move
            state [] .stack .data offset +
            state [] .stack .data offset 1 + +
            2
          mem.move #drop
          state [] .stack
            #dup .length 1 - list.setLength
          state [] .stack =
          return
      end
      break
    typeModifier case
      state unfreezeInterpreter
      ## type-modifiers are handled by the interpreter
      op state [] .interpreter @ true evaluateOperation if
        "could not evaluate type modifier" sb.wrap
          op [] .val .typeModifier sb.appendTypeModifier
        op [] .pos errors appendError
      end
      return
    setId setLabel setElement setArrayElement autoCast case
      "unsupported operation" sb.wrap
        op [] constContext labelContext typeContext sb.appendOp
      op [] .pos errors appendError
      return
  end
  "type-checking for operation: " sb.wrap
    op [] constContext labelContext typeContext sb.appendOp
    " has not been implemented" sb.appendS
  op [] .pos errors appendError
end

proc( ProgramContext ptr mut : program => ) =: public typeCheckProgram2
  ## TypeCheckState
    program
    program wrapProgram
    true
    32  TypeInfo  list.create
    32  BlockInfo list.create
    128 Operation list.create
    128 OpInfo    list.create
    128 i64       list.create
    FILE_ID_NONE
  TypeCheckState new =:: mut state
  program [] .errors @ =:: errors
  program [] .idContext @ =:: idContext
  program [] .idContext .constContext @ =:: constContext
  program [] .idContext .typeContext @ =:: typeContext
  program [] .idContext .labelContext @ =:: labelContext
  ## global code
  0 while #dup program [] .progFiles .length < do
    #dup state .currentFile =
    program [] .progFiles #over list.at .data =:: progFile
    state @ clearOps
    0 while #dup progFile [] .globalOps .length < do
      progFile [] .globalOps #over list.at .data state @ typeCheckOp
      1 +
    end #drop
    progFile [] .globalOps list.clear
      state .compiledOps progFile [] .globalOps =
    state .compiledOps =
    state @ resetInterpreter
    state .stack list.clear state .stack = ## TODO error on unhandled values
    1 +
  end #drop
  state @ clearOps
  state .compiledOps =:: originalOps
  ## procedures
  0 while #dup program [] .procedures .length < do
    program [] .procedures #over list.at .data =:: currentProc
    currentProc [] .procType typeContext types.getProcIn #drop =:: procIn
    procIn typeContext types.compositeElts =:: inTypes
    false =:: mut hasStaticArg ## TODO store info about static args in procedure
    0 while #dup inTypes .length < do
      procIn #over typeContext types.compositeGetLabel
       labelContext id.labelFlags id.FLAG_STATIC & ? if
        true hasStaticArg =
        break
      end
      inTypes #over array.get types.primitive.TYPE types.typeEquals if
        true hasStaticArg =
        break
      end
      1 +
    end #drop
    hasStaticArg if
      1 + continue
    end
    currentProc [] .fileId state .currentFile = ## compile procedures to local code of given file
    program [] .progFiles currentProc [] .fileId list.at .data =:: procFile
    state @ clearOps
    procFile [] .localOps state .compiledOps =
    0 while #dup currentProc [] .codeLength < do
      program [] .templateOps
        #over currentProc [] .codeStart + list.at .data
      state @ typeCheckOp
      1 +
    end #drop
    state .compiledOps procFile [] .localOps =
    originalOps state .compiledOps =
    state @ resetInterpreter
    state .stack list.clear state .stack = ## TODO error on wrong return types
    1 +
  end #drop
  ## static procedures
  ## TODO type-check static procedures
  state @ freeOps
  state .interpreter @ cleanupContext
end
