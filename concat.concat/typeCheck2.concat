          op [] .pos state closeBlock =:: closed
          closed .Procedure ?? ! if
            "unexpected end of " sb.wrap
              closed sb.appendBlockInfoName
              " block expected Procedure block" sb.appendS
            op [] .pos errors appendError
          end
          op [] state appendOp ..drop
          return
        ELSE case
          op [] .pos state closeBlock =:: closed
          closed .If ?? ! if
            "unexpected end of " sb.wrap
              closed sb.appendBlockInfoName
              " block expected If-Else block" sb.appendS
            op [] .pos errors appendError
          end
          closed .If .hasElse ! if
            "unexpected end of " sb.wrap
              closed sb.appendBlockInfoName
