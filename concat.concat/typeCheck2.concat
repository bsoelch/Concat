          end
          state [] .stack branchTree.depth op [] .pos state appendNOPs =:: elseCastOffset
          state [] .blockStarts
            list.pop ..drop
          state [] .blockStarts =
          branchTree.NodeId 2 array new =:: mut branches
          closed .If .ifBranch branches @ 0 [] =
          state [] .stack .branchHead branches @ 1 [] =
          i64 2 array new =:: mut castOffsets
          closed .If .ifCastsOffset castOffsets @ 0 [] =
          elseCastOffset castOffsets @ 1 [] =
          ## mergeValues
            state [] .stack @
            branches @ array.wrap
            mergeBranches @
            ## MergePoint
              "If-Else block" string.wrap
              op [] .pos
              castOffsets @ array.wrap
              state
              false
            MergePoint new
          branchTree.merge if
            "could not merge branches of " sb.wrap
              closed sb.appendBlockInfoName
              " block" sb.appendS
            op [] .pos errors appendError
          end
          closed .If .blockId op [] .val .blockEnd .blockId =
          op [] state appendOp ..drop
          return
        IF
        IFIF
        WHILE
        DO
        BREAK
        CONTINUE
        SWITCH
        CASE
        DEFAULT
        UNKNOWN
        NAMESPACE case
          break
      end
      break
    length size case
      state [] .stack @ branchTree.peek =:: value?
      value? optional.isEmpty if
        "missing argument for " sb.wrap
          op [] constContext labelContext typeContext sb.appendOp
          " expected pointer or array" sb.appendS
