          else sizes 0 array.get .sizeType .int ?? _if
            ## pushConstant
              sizes 0 array.get .value ConstValue .int new
              types.primitive.I_SIZE
              op [] .pos
            state pushConstant
            return
          else sizes 0 array.get .sizeType .staticArg ?? _if
            ## pushConstant
              sizes 0 array.get .value i32 cast ConstValue .genericArg new
              types.primitive.I_SIZE
              op [] .pos
            state pushConstant
            return
          else
            "unsupported array-size type for " sb.wrap
              op [] constContext labelContext typeContext sb.appendOp
            op [] .pos errors appendError
            return
          end
        else
          idContext [] .templateArgBuffer .length =:: offset
          0 while ..dup sizes .length < do
            sizes ..over array.get =:: current
            idContext [] .templateArgBuffer
              current .sizeType .int ?? if
                current .value ConstValue .int new list.append
              else current .sizeType .staticArg ?? _if
                current .value i32 cast ConstValue .genericArg new list.append
              else ..drop.2
                "unsupported array-size type for " sb.wrap
                  op [] idContext [] .constContext @ labelContext typeContext sb.appendOp
                op [] .pos errors appendError
                return
              end
            idContext [] .templateArgBuffer =
            1 +
          end ..drop
          sizes .length types.ArraySizeType .int types.ArraySize new =:: sizeLength
          ## pushConstant
            ## newArrayConst
              idContext [] .templateArgBuffer .data offset + idContext [] .templateArgBuffer .length offset - array.create
              idContext [] .constContext @
            newArrayConst
            types.primitive.I_SIZE false sizeLength @ array.wrap true false typeContext types.newArrayType ..drop
            op [] .pos
          state pushConstant
          idContext [] .templateArgBuffer
            offset list.setLength
          idContext [] .templateArgBuffer =
          return
        end
      end ## XXX? support length on structs/tuples/enums
      "unsupported argument type for " sb.wrap
        op [] constContext labelContext typeContext sb.appendOp
        valType labelContext typeContext sb.appendType
      op [] .pos errors appendError
      return
      break
    typeInfo case
      op [] .dataType typeContext types.containsGeneric | if
        break ## generic type-info not implemented
      end
      ConstValue .none op [] state pushValue
      types.primitive.I_SIZE state replaceType
      break
    Return getName
    newEnum call callPtr
    argc getArg getArgLen
    unaryOperator binaryOperator
    checkEnumLabel setEnumLabel
    checkArrayIndex setName @Name
    hasName hasElement
    compilerInfo unreachable case
      break
    Print case
      1 op [] .pos state checkStackSize if
        return
      end
      state [] .stack @ branchTree.pop .data [] =:: value
      value .valueType op [] .dataType =
      op [] state appendOp ..drop
      return
    stackMod case
      op [] .val .stackMod .modType switch
        DROP case
          op [] .val .stackMod .n op [] .pos state discardValues
          return
