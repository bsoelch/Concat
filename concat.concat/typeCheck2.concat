          op .pos errors appendError
          return
        end
        types.primitive.I_SIZE
        op .pos
      state pushConstant
      return
    typeModifier case
      state unfreezeInterpreter
      ## type-modifiers are handled by the interpreter
      op @ state [] .interpreter @ evaluateOperation if
        "could not evaluate type modifier " sb.wrap
          op .val .typeModifier sb.appendTypeModifier
        op .pos errors appendError
      end
      return
    setId setLabel setElement setArrayElement autoCast
    copy call_old case
      "unsupported operation: " sb.wrap
        op program sb.appendOp
      op .pos errors appendError
      return
    compilerInfo case
      op .val .compilerInfo switch
        typeInfo case
          op .val .compilerInfo .typeInfo =:: info
          ## printTypes
            false
            info .count
            info .depth
          state printTypes
          return
        stackInfo case
          ## printTypes
            true
            op .val .compilerInfo .stackInfo
            0
          state printTypes
          return
        compiledOps case
          return ## TODO print ops
        find case
          return ## TODO find
      end
      break
  end
  "type-checking for operation: " sb.wrap
    op program sb.appendOp
    " has not been implemented" sb.appendS
  op .pos errors appendError
end

proc(
  ProcedureInfo ptr : procInfo
  ProgramContext ptr mut : program
-> i64 ) =>: nextImpl
  program [] .templateOps
    procInfo [] .implementation .code .codeStart list.at .data
  =:: procStart
  procStart [] .val .implementProcedure ?? ! if
    0 return
  end
  ## implementationId contains id of last compiled implementation
  procStart [] .val .implementProcedure .implementationId 1 + return
end

proc(
  ProcId : procId
  i64 : implId
  TypeCheckState ptr mut : state
-> ) =>: typeCheckProcedure
  state [] .program [] .autoTypes list.copy =:: globalAutoTypes
  state [] .program =:: program
  program [] .procedures procId list.at .data =:: currentProc
  ## compile procedures to local code of given file
  currentProc [] .fileId state [] .currentFile =
  currentProc [] .fileId state [] .interpreter .currentFile =
  program [] .progFiles currentProc [] .fileId list.at .data =:: procFile
  state clearOps
  state resetInterpreter
  currentProc [] .implementation .code @ =:: codeImpl
  program [] .templateOps
     codeImpl [] .codeStart list.at .data
  =:: procStart
  ## ProcedureImpl
    procId
    implId
  ProcedureImpl new OpValue .implementProcedure procStart [] .val =
  implId 0 >= if ## update procedure type
    codeImpl [] .implementations
      implId list.at .data
    [] .procType =:: procType
    procType procStart [] .dataType =
    procType state [] .currentProcType =
  else
    currentProc [] .procType state [] .currentProcType =
  end
  0 while ..dup codeImpl [] .codeLength < do =:: i
    program [] .templateOps
      i codeImpl [] .codeStart + list.get
    state typeCheckOp
    i 1 +
  end ..drop
  procFile [] .localOps
    state [] .compiledOps list.appendAll
  procFile [] .localOps =
  state [] .program [] .autoTypes
    list.free ..drop
    globalAutoTypes ## reset local auto-types
  state [] .program [] .autoTypes =
  state [] .stack @ branchTree.clear ## TODO error on unhandled values
end

64 =:: MAX_STATIC_RECURSION

proc( ProgramContext ptr mut : program -> ) =>: export: typeCheckProgram2
  ## TypeCheckState
    program
    program -1 InterpreterType .GLOBAL interpreter.wrapProgram
    labelHash @ labelEq @ 64 TypedValue map.create
    Type .undefined
    true
    TypeInfo branchTree.create
    32  BlockInfo list.create
    0
    128 Operation list.create
    0
    128 OpInfo    list.create
    128 i64       list.create
    FILE_ID_NONE
    true
    true
  TypeCheckState new =:: mut: state
  program [] .errors @ =:: errors
  program [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  ## global code
  0 while ..dup program [] .progFiles .length < do =:: fileId
    fileId state .currentFile =
    fileId state .interpreter .currentFile =
    program [] .progFiles fileId list.at .data =:: progFile
    state @ clearOps
    state @ resetInterpreter
    0 while ..dup progFile [] .globalOps .length < do
      progFile [] .globalOps ..over list.get state @ typeCheckOp
      1 +
    end ..drop
    progFile [] .globalOps list.clear
      state .compiledOps progFile [] .globalOps =
    state .compiledOps =
    state .stack @ branchTree.clear ## TODO error on unhandled values
    fileId 1 +
  end ..drop
  state @ clearOps
  state .compiledOps =:: originalOps
  false state .isGlobal =
  ## procedures
  0 while ..dup program [] .procedures .length < do =:: procId
    program [] .procedures procId list.at .data =:: currentProc
    currentProc [] .implementation .code ?? ! if
      procId 1 + continue ## procedure implementation not in code
    end
    currentProc [] .procType typeContext types.getProcIn ..drop =:: procIn
    currentProc [] .implementation .code .codeStart 0 < if
      procId 1 + continue ## procedure not implemented
    end
    currentProc [] .hasStaticArg if
      procId 1 + continue
    end
    procId -1 state @ typeCheckProcedure
    procId 1 +
  end ..drop
  ## static procedures
  0 =:: mut: depth
  false =:: mut: compiledImplementation
  while
    false compiledImplementation =
    0 while ..dup program [] .procedures .length < do =:: procId
      program [] .procedures procId list.at .data =:: currentProc
      currentProc [] .implementation .code ?? ! if
        procId 1 + continue ## procedure implementation not in code
      end
      currentProc [] .implementation .code @ =:: codeImpl
      codeImpl [] .codeStart 0 < if
        procId 1 + continue ## procedure not implemented
      end
      currentProc program nextImpl =:: nextId
      codeImpl [] .implementations .length =:: implLength
      nextId implLength >= if
        procId 1 + continue
      end
      true compiledImplementation =
      nextId while ..dup implLength < do =:: implId
        codeImpl [] .implementations
          implId list.at .data
        =:: implData
        depth MAX_STATIC_RECURSION >= if
          "exceeded maximum static recursion depth (" sb.wrap
            MAX_STATIC_RECURSION sb.appendI
            ')' sb.appendC
          implData [] .firstUse errors appendError
        end
        implData [] .procType typeContext types.getProcIn ..drop =:: procIn
        procIn typeContext types.compositeElts =:: inTypes
        0 =:: mut: staticArgCount
        ## XXX? clear argument map
        0 while ..dup inTypes .length < do =:: i
          procIn i typeContext types.compositeGetLabel =:: labelId
          inTypes i types.compositeElts.get =:: argType
          labelId labelContext id.labelFlags id.FLAG_STATIC & ? if
            implData [] .staticArgs
              staticArgCount constContext constArrayGet
            =:: argValue
            state .argData @ labelId
              argType argValue TypedValue new
            map.put ..drop
            staticArgCount 1 + staticArgCount =
          else
            state .argData @ labelId
              argType ConstValue .none TypedValue new
            map.put ..drop
          end
          i 1 +
        end ..drop
        procId implId state @ typeCheckProcedure
        implId 1 +
      end ..drop
      procId 1 +
    end ..drop
    compiledImplementation if
      depth 1 + depth =
      depth MAX_STATIC_RECURSION > if
        ## error message appended in implementation
        break
      end
      continue
    end
    false ## break loop while reaching condition
  do end
  ## create implementations for built-in procedure-pointers
  0 while ..dup program [] .procedures .length < do =:: procId
    program [] .procedures procId list.at .data =:: currentProc
    currentProc [] .implementation .builtIn ?? ! if
      procId break ## built-ins at start of procedure list
    end
    currentProc [] .implementation .builtIn .hasPtr ! if
      procId 1 + continue
    end
    program [] .progFiles 0 list.at .data =:: procFile ## XXX? use separate "file" for built-ins
    currentProc [] .labelId labelContext id.labelPos .data =:: pos
    procFile [] .localOps
      ## opImplementProc
        currentProc [] .procType
        ## ProcedureImpl
          procId
          -1
        ProcedureImpl new
        pos
      opImplementProc list.append
      ## opBuiltIn
        currentProc [] .procType
        currentProc [] .implementation .builtIn .builtIn
        pos
      opBuiltIn list.append
      currentProc [] .procType pos opReturn list.append
      BlockType .PROCEDURE pos opEndBlock list.append
    procFile [] .localOps =
    procId 1 +
  end ..drop
  state @ freeOps
  state .stack @ branchTree.free
  state .interpreter @ interpreter.cleanupContext
  state .argData @ map.free
end
