        "could not evaluate type modifier" sb.wrap
          op [] .val .typeModifier sb.appendTypeModifier
        op [] .pos errors appendError
      end
      return
    setId setLabel setElement setArrayElement autoCast copy case
      "unsupported operation" sb.wrap
        op [] constContext labelContext typeContext sb.appendOp
      op [] .pos errors appendError
      return
  end
  "type-checking for operation: " sb.wrap
    op [] constContext labelContext typeContext sb.appendOp
    " has not been implemented" sb.appendS
  op [] .pos errors appendError
end

proc( ProgramContext ptr mut : program -> ) =>: export typeCheckProgram2
  ## TypeCheckState
    program
    program wrapProgram
    true
    TypeInfo branchTree.create
    32  BlockInfo list.create
    0
    128 Operation list.create
    128 i64       list.create
    128 OpInfo    list.create
    128 i64       list.create
    FILE_ID_NONE
  TypeCheckState new =:: mut state
  program [] .errors @ =:: errors
  program [] .idContext @ =:: idContext
  program [] .idContext .constContext @ =:: constContext
  program [] .idContext .typeContext @ =:: typeContext
  program [] .idContext .labelContext @ =:: labelContext
  ## global code
  0 while ..dup program [] .progFiles .length < do
    ..dup state .currentFile =
    program [] .progFiles ..over list.at .data =:: progFile
    state @ clearOps
    0 while ..dup progFile [] .globalOps .length < do
      progFile [] .globalOps ..over list.at .data state @ typeCheckOp
      1 +
    end ..drop
    progFile [] .globalOps list.clear
      state .compiledOps progFile [] .globalOps =
    state .compiledOps =
    state @ resetInterpreter
    state .stack @ branchTree.clear ## TODO error on unhandled values
    1 +
  end ..drop
  state @ clearOps
  state .compiledOps =:: originalOps
  ## procedures
  0 while ..dup program [] .procedures .length < do
    program [] .procedures ..over list.at .data =:: currentProc
    currentProc [] .procType typeContext types.getProcIn ..drop =:: procIn
    procIn typeContext types.compositeElts =:: inTypes
    false =:: mut hasStaticArg ## TODO store info about static args in procedure
    0 while ..dup inTypes .length < do
      procIn ..over typeContext types.compositeGetLabel
       labelContext id.labelFlags id.FLAG_STATIC & ? if
        true hasStaticArg =
        break
      end
      inTypes ..over types.compositeElts.get types.primitive.TYPE types.typeEquals if
        true hasStaticArg =
        break
      end
      1 +
    end ..drop
    hasStaticArg if
      1 + continue
    end
    currentProc [] .fileId state .currentFile = ## compile procedures to local code of given file
    program [] .progFiles currentProc [] .fileId list.at .data =:: procFile
    state @ clearOps
    0 while ..dup currentProc [] .codeLength < do
      program [] .templateOps
        ..over currentProc [] .codeStart + list.at .data
      state @ typeCheckOp
      1 +
    end ..drop
    procFile [] .localOps
      state .compiledOps list.appendAll
    procFile [] .localOps =
    state @ resetInterpreter
    state .stack @ branchTree.clear ## TODO error on wrong return types
    1 +
  end ..drop
  ## static procedures
  ## TODO type-check static procedures
  state @ freeOps
  state .stack @ branchTree.free
  state .interpreter @ cleanupContext
end
