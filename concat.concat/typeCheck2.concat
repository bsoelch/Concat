        TYPE_STRUCT
        TYPE_ENUM
        TYPE_UNION
        TYPE_PROC_IN
        TYPE_PROC_OUT
        TYPE_COMPOSITE
        INITIALIZER case ## XXX allow dynamic interpreter blocks
