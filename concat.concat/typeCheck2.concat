    ## branchTree.push
      state [] .stack @
      ## TypeInfo
        op .dataType
        value
        id.LABEL_ID_NONE
        op .pos
        state [] .compiledOps .length
        -1
        -1
      TypeInfo new
    branchTree.push
    state [] .compiledOps
      op list.append
    state [] .compiledOps =
    state [] .opInfo
      ## OpInfo
        0
        0
        false
        false
      OpInfo new list.append
    state [] .opInfo =
end
proc( bool : canMove bool : canDelete i64 : argCount i64 : argOffset TypeCheckState ptr mut : state -> ) =>: updateOpInfo
  state [] .program [] .errors @ =:: errors
  state [] .stack @ branchTree.peek .data =:: typeInfo
  typeInfo [] .opIndex =:: opIndex
  opIndex 0 < if
    "cannot update information of operations pushed outside current block" sb.wrap
    typeInfo [] .pushedAt errors appendError
    return
  end
  canMove canDelete argCount argOffset state opIndex updateOpInfoIndex
end
proc( bool : canMove bool : canDelete i64 : argCount i64 : argOffset TypeCheckState ptr mut : state -> ) =>: updateOpInfo_noStack
  canMove canDelete argCount argOffset state state [] .opInfo .length 1 - updateOpInfoIndex
end
proc( bool : canMove bool : canDelete i64 : argCount i64 : argOffset TypeCheckState ptr mut : state i64 : opIndex -> ) =>: updateOpInfoIndex
  state [] .opInfo opIndex list.at .data =:: opInfo
  argCount i32.MAX > if
    ..unreachable ## XXX handle case of too many arguments
  end
  argCount i32 cast opInfo [] .childCount =
  argOffset opInfo [] .childOffset =
  true =:: mut canMoveChildren
  0 while ..dup argCount < do
    state [] .childIds ..over argOffset + list.get =:: childId
    state [] .opInfo childId list.at .data [] .canMove ! if
      false canMoveChildren =
    end
    1 +
  end ..drop
  canMove canMoveChildren & opInfo [] .canMove =
  canDelete opInfo [] .canDelete =
end
proc( LabelId : label TypeCheckState ptr mut : state -> ) =>: replaceLabel
  state [] .stack @ branchTree.peek .data =:: top
  label top [] .valueId =
end
proc( Type : newType TypeCheckState ptr mut : state -> ) =>: replaceType
  state [] .stack @ branchTree.peek .data =:: top
  newType top [] .valueType =
end

proc( BlockInfo : blockInfo TypeCheckState ptr mut : state -> ) =>: openBlock
  state [] .openBlocks
    blockInfo list.append
  state [] .openBlocks =
end

proc( TypeCheckState ptr mut : state -> BlockInfo ptr mut optional ) =>: peekBlock
  state [] .openBlocks list.peek
end
proc( FilePosition : pos TypeCheckState ptr mut : state -> BlockInfo ) =>: closeBlock
  state [] .program [] .errors @ =:: errors
  state [] .openBlocks .length 0 == if
    BlockInfo .Unknown return
  end
  state [] .openBlocks .length 1 - =:: newLength
  state [] .openBlocks newLength list.at .data [] =:: closed
  state [] .openBlocks
    newLength list.setLength
  state [] .openBlocks =
  closed return
end

struct(
  string : blockName
  FilePosition : mergePoint
  i64 arrayView : castPointOffsets
  TypeCheckState ptr mut : state
  bool : fixRootTypes
) =:: MergePoint
proc(
  TypeInfo ptr arrayView : toMerge
  i64 : offset
  MergePoint : mergePoint
-> TypeInfo ) =>: mergeBranches
  mergePoint .state [] .program =:: program
  program [] .errors @ =:: errors
  program [] .idContext @ =:: idContext
  program [] .idContext .constContext @ =:: constContext
  program [] .idContext .typeContext @ =:: typeContext
  program [] .idContext .labelContext @ =:: labelContext
  toMerge .length 1 == if
    toMerge 0 array.get [] return
  end
  toMerge 0 array.get =:: root
  root [] .valueType =:: mut mergedType
  1 while ..dup toMerge .length < do =:: i
    toMerge i array.get =:: current
    mergePoint .fixRootTypes if
      current [] .valueType mergedType typeContext types.canAutoCast ! if
        "cannot merge the branches of " sb.wrap
          mergePoint .blockName sb.appendStr
          "\n expected: " sb.appendS
          mergedType labelContext typeContext sb.appendType
          " ( pushed at " sb.appendS
          root [] .pushedAt sb.appendPos
          " )\n got: " sb.appendS
          current [] .valueType labelContext typeContext sb.appendType
          " ( pushed at " sb.appendS
          current [] .pushedAt sb.appendPos
          " )\n" sb.appendS
        mergePoint .mergePoint errors appendError
      end
    else
      current [] .valueType mergedType typeContext types.mergeTypes if ..drop
        "cannot merge the branches of " sb.wrap
          mergePoint .blockName sb.appendStr
          "\n cannot merge types " sb.appendS
          mergedType labelContext typeContext sb.appendType
          " ( pushed at " sb.appendS
          root [] .pushedAt sb.appendPos
          " )\n and " sb.appendS
          current [] .valueType labelContext typeContext sb.appendType
          " ( pushed at " sb.appendS
          current [] .pushedAt sb.appendPos
          " )\n" sb.appendS
        mergePoint .mergePoint errors appendError
      else
        mergedType =
      end
    end
    i 1 +
  end ..drop
  0 while ..dup toMerge .length < do =:: i
    toMerge i array.get =:: current
      current [] .valueType mergedType types.typeEquals ! if
        mergePoint .castPointOffsets i array.get =:: castRoot
        castRoot 0 >= if
          mergePoint .state [] .compiledOps castRoot offset + list.at .data =:: castPoint
          castPoint [] .val .NOP ?? if
            ## opAutoCast
              current [] .valueType
              offset i32 cast
              mergedType
              mergePoint .mergePoint
            opAutoCast castPoint [] =
            i 1 + continue
          end
          "operation is not a NO-OP" sb.wrap
            castPoint [] constContext labelContext typeContext sb.appendOp
          mergePoint .mergePoint errors appendError
        end
        "cannot cast " sb.wrap
          offset sb.appendI
          "th value in " sb.appendS
          i sb.appendI
          "th branch" sb.appendS
        mergePoint .mergePoint errors appendError
      end
    i 1 +
  end ..drop
  ## TypeInfo
    mergedType
    ConstValue .none ## XXX merge constants
    id.LABEL_ID_NONE
    mergePoint .mergePoint
    -1
    -1
    -1
  TypeInfo new return
end

proc( Operation : op TypeCheckState ptr mut : state -> i64 #+opIndex+# ) =>: appendOp
  state [] .compiledOps .length =:: index
  state [] .compiledOps
    op list.append
  state [] .compiledOps =
  state [] .opInfo
    ## OpInfo
      0
      0
      false
      false
    OpInfo new list.append
  state [] .opInfo =
  index return
end
## appends count NOPs to the code, returns the position of the first NOP
proc( i64 : count FilePosition : pos TypeCheckState ptr mut : state -> i64 ) =>: appendNOPs
  state [] .compiledOps .length =:: offset
  state [] .compiledOps
    offset count + list.ensureCap
    offset count + list.setLength
  state [] .compiledOps =
  ## mem.fill
    state [] .compiledOps .data offset +
    count
    pos opNOP
  mem.fill
  state [] .opInfo
  0 while ..dup count < do =:: i
    ## OpInfo
      0
      0
      false
      false
    OpInfo new list.append
    i 1 +
  end ..drop
  state [] .opInfo =
  offset return
end
proc( TypeCheckState ptr mut : state -> ) =>: wrapCopy
  state [] .stack @ branchTree.peek .data =:: topValue
  state [] .childIds
    topValue [] .opIndex list.append
  state [] .childIds =
  state [] .compiledOps .length =:: index
  state [] .compiledOps
    topValue [] .valueType topValue [] .pushedAt opCopy list.append
  state [] .compiledOps =
  state [] .opInfo list.peek .data =:: prev
  state [] .opInfo
    ## OpInfo
      1
      state [] .childIds .length 1 -
      prev [] .canMove
      prev [] .canDelete
    OpInfo new list.append
  state [] .opInfo =
  index topValue [] .opIndex =
  index topValue [] .copyMutableIndex =
end
proc( i64 : copyMutableIndex TypeCheckState ptr mut : state -> ) =>: removeCopy
  copyMutableIndex -1 != if
    ## no copy when writing to value
    OpValue .NOP state [] .compiledOps copyMutableIndex list.at .data [] .val =
  end
end

## FIXME prevent editing of operations outside current block
proc( i64 : index TypeCheckState ptr mut : state -> bool ) =>: tryDeleteOp
  index state currentBlockStart < if
    true return
  end
  state [] .opInfo index list.at .data [] .canDelete if
    index state deleteOp
    false return
  else
    true return
  end
end
proc( i64 : index TypeCheckState ptr mut : state -> ) =>: deleteOp
  state [] .opInfo index list.at .data =:: opInfo
  0 =:: mut toDrop
  0 while ..dup opInfo [] .childCount < do
    state [] .childIds ..over opInfo [] .childOffset + list.get state tryDeleteOp if
      toDrop 1 + toDrop =
    end
    1 +
  end ..drop
  toDrop 0 == if
    OpValue .NOP state [] .compiledOps index list.at .data [] .val =
  else
    state [] .compiledOps index list.at .data =:: prev
    toDrop StackModType .DROP prev [] .pos opStackMod prev [] =
  end
  false opInfo [] .canMove =
  false opInfo [] .canDelete =
end
proc( i64 : index TypeCheckState ptr mut : state -> i64 ) =>: copyOp
  state [] .opInfo index list.at .data =:: opInfo
  state [] .childIds .length =:: argOffset
  0 while ..dup opInfo [] .childCount < do ## copy child operations
    state [] .childIds ..over opInfo [] .childOffset + list.get =:: childId
    state [] .childIds
      childId state copyOp list.append
    state [] .childIds =
    1 +
  end ..drop
  state [] .compiledOps .length =:: copyIndex
  state [] .compiledOps
    ..dup index list.at .data list.appendP
  state [] .compiledOps =
  state [] .compiledOps list.peek .data =:: newOp
  newOp [] .val .autoCast ?? if
    1 newOp [] .val .autoCast .offset = ## update to head of stack moving operation and arguments
  end
  state [] .opInfo
    ..dup index list.at .data list.appendP
  state [] .opInfo =
  ## update internal data
  state [] .opInfo list.peek .data =:: newOpInfo
  argOffset newOpInfo [] .childOffset =
  copyIndex return
end
proc( i64 : opIndex FilePosition : pos TypeCheckState ptr mut : state -> i64 bool ) =>: tryCopyOp
  opIndex 0 < if
    0 true return
  end
  state [] .opInfo opIndex list.at .data =:: opInfo
  opInfo [] .canMove ! if
    0 true return
