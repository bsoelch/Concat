proc(
  Operation ptr : op
  TypeCheckState ptr mut : state
-> bool #+consume op+# ) =>: typeCheckSwitchLabel
  state [] .program =:: program
  state [] .program [] .errors @ =:: errors
  state [] .program [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  state peekBlock .data [] .Switch @ =:: switchBlock
  switchBlock [] .switchType =:: switchType
  switchBlock [] .blockId =:: switchId
  op [] .val .block ?? if
    op [] .val .block .blockType switch
      CASE DEFAULT case
        ## resolveSwitchLabels
          switchId
          switchType
        state resolveSwitchLabels
        false return
      BREAK case
        switchBlock [] .allowBreak if
          false switchBlock [] .allowBreak =
          true return
        end
        break
      default
        break
    end
  else op [] .val .blockEnd ?? _if
    ## resolveSwitchLabels
      switchId
      switchType
    state resolveSwitchLabels
    false return
  end
  ## operation after switch -> don't allow break statement
  false switchBlock [] .allowBreak =
  switchType typeContext types.isEnum ! if
    op state [] .interpreter @ evaluateOperation if
      "unsupported operation in switch label:\n " sb.wrap
        op [] program sb.appendOp
      op [] .pos errors appendError
    end
    true return
  end
  ## enum-switch -> try read label
  op [] .val .getId ?? if
    op [] .val .getId .labelId
  else op [] .val .getName ?? _if
    op [] .val .getName
  else op [] .val .Constant ?? _if
      op [] .val .Constant =:: constVal
      constVal .typeId ?? _if
      constVal .typeId types.isNamedType _if
    constVal .typeId typeContext types.namedTypeName
  else
    "unsupported operation for switch label of type " sb.wrap
      switchType typeContext sb.appendType
      " : " sb.appendS
      op [] program sb.appendOp
      " expected identifier" sb.appendS
    op [] .pos errors appendError
    true return
  end =:: labelId
  ## compositeFindLabel
    switchType
    labelId
  typeContext types.compositeFindLabel =:: labelIndex
  labelIndex 0 < if
    "enum " sb.wrap
      switchType typeContext sb.appendType
      " does not have a label " sb.appendS
      labelId labelContext sb.appendLabelName
    op [] .pos errors appendError
    true return
  end
  ## newSwitchLabel
    switchId
    ## ConstValue
      labelIndex
    ConstValue .enumLabel
    op [] .pos
  state newSwitchLabel
  true return
end

