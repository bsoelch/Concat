#+
The old type-checker does two separate transformations on the source code
 1) type-checking the code
 2) converting the code to prefix notation
the new type-checking code in this file will only perform the first operation outputting
type-checked code in post-fix notation.
+#
import "program.concat"
import "types.concat"
import "identifiers.concat"
import "interpreter.concat"
import "branchTree.concat"
import "callResolver.concat"

struct(
  Type         : mut: valueType
  ConstValue   : mut: value
  LabelId      : mut: valueId
  FilePosition : mut: pushedAt
  i64          : mut: opIndex
  i64          : mut: readEnumCheckIndex
  i64          : mut: copyMutableIndex
) =:: TypeInfo

struct(
  i32  : mut: childCount
  i64  : mut: childOffset
  bool : mut: canMove
  bool : mut: canDelete ## XXX flags are not independent -> combine to single modifier
) =:: OpInfo

-1i64 =:: OP_UNLINKED
-2i64 =:: OP_EMPTY

struct(
  branchTree.NodeId : node
  FilePosition : pos
) =:: BranchPoint
struct(
  branchTree.NodeId : branchRoot
  BranchPoint : mut: ifBranch
  BranchPoint list : mut: ififBranches
  i64 : mut: ifCastsOffset
  i32 : blockId
  bool : mut: hasElse
  bool : mut: ifBranchTerminates
) =:: IfBlockInfo
struct(
  Type : switchType
  branchTree.NodeId : branchRoot
  BranchPoint list : mut: caseBranches
  i64 list : mut: castOffsets
  i32 : blockId
  bool : mut: inLabel
  bool : mut: allowBreak
) =:: SwitchBlockInfo
struct(
  BranchPoint : branchRoot
  BranchPoint list : mut: breakBranches
  i64 list : mut: breakCastOffsets
  BranchPoint list : mut: continueBranches
  i64 list : mut: continueCastOffsets
  i64 : mut: doBranchIndex ## index of do-branch in break branches
  i32 : blockId
) =:: WhileBlockInfo
enum(
  Unknown
  Type : Procedure
  IfBlockInfo : mut: If
  SwitchBlockInfo : mut: Switch
  WhileBlockInfo : mut: While
) =:: BlockInfo
proc( branchTree.NodeId : branchRoot i32 : blockId FilePosition : pos -> BlockInfo ) =>: newIfBlock
  ## IfBlockInfo
    branchRoot
    -1 pos BranchPoint new ## dummy value
    8 BranchPoint list.create
    -1
    blockId
    false
    false
  IfBlockInfo new BlockInfo .If return
end
proc( Type : switchType branchTree.NodeId : branchRoot i32 : blockId FilePosition : pos -> BlockInfo ) =>: newSwitchBlock
  ## SwitchBlockInfo
    switchType
    branchRoot
    16 BranchPoint list.create
    16 i64 list.create
    blockId
    true
    false
  SwitchBlockInfo new BlockInfo .Switch return
end
proc( branchTree.NodeId : branchRoot i32 : blockId FilePosition : pos -> BlockInfo ) =>: newWhileBlock
  ## WhileBlockInfo
      branchRoot
      pos
    BranchPoint new
    16 BranchPoint list.create
    16 i64 list.create
    16 BranchPoint list.create
    16 i64 list.create
    -1
    blockId
  WhileBlockInfo new BlockInfo .While return
end
"if-else" =:: IF_BLOCK_INFO_NAME
"switch-case" =:: SWITCH_BLOCK_INFO_NAME
"while" =:: WHILE_BLOCK_INFO_NAME
namespace: sb
  proc( stringBuilder BlockInfo -> stringBuilder ) =>: appendBlockInfoName
    switch
      Unknown case "unknown" sb.appendS return
      Procedure case "procedure" sb.appendS return
      If case IF_BLOCK_INFO_NAME sb.appendS return
      Switch case SWITCH_BLOCK_INFO_NAME sb.appendS return
      While case WHILE_BLOCK_INFO_NAME sb.appendS return
    end
  end
end

## XXX? merge all typed-value types
struct( Type : valType ConstValue : value ) =:: TypedValue

struct(
  ProgramContext ptr mut : program
  InterpreterContext : mut: interpreter
  LabelId TypedValue hashMap : mut: argData
  Type : mut: currentProcType
  bool : mut: interpreterActive
  TypeInfo BranchTree : mut: stack
  BlockInfo list : mut: openBlocks
  i32 : mut: blockCount
  Operation list : mut: compiledOps
  i64 : mut: blockStart
  OpInfo list : mut: opInfo
  i64 list : mut: childIds
  FileId : mut: currentFile
  bool : mut: reachable
  bool : mut: isGlobal
  ## TODO flags:
  ## * disable reorganizing of operations (excluding types)
  ## * is it allowed to optimize out reading from variables
  ## * is folding (non-type) constants allowed
) =:: TypeCheckState

proc( TypeCheckState ptr : state -> i64 ) =>: currentBlockStart
  state [] .blockStart return
end
proc( TypeCheckState ptr mut : state -> ) =>: freezeInterpreter
  state [] .interpreterActive ! if
    return
  end
  state [] .program =:: progContext
  progContext [] .errors @ =:: errors
  progContext [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  state [] .interpreter @ =:: interpreter
  ##  -> store computed constants
  0 while ..dup interpreter [] .stack .length < do
    interpreter [] .stack ..over list.at .data =:: constant
    interpreter [] .stackInfo ..over list.at .data =:: constInfo
    constInfo [] .valueType typeContext types.isReference if
      constInfo [] .valueId idContext id.getIdentifier if
        "cannot find identifier: " sb.wrap
          constInfo [] .valueId
            labelContext
          sb.appendLabelName
        constInfo [] .pushedAt errors appendError
      end id.asIdInfo =:: idInfo
      constInfo [] .valueType
      idInfo
      constInfo [] .pushedAt opGet =:: tmp
      ## pushValue
        constInfo [] .valueType
        constant  []
        tmp
      state pushValue
    else
      ## pushConstant
        constant  []
        constInfo [] .valueType
        constInfo [] .pushedAt
      state pushConstant
    end
    constInfo [] .valueId state replaceLabel
    1 +
  end ..drop
  ## TODO check open blocks (cannot freeze within type-block, special cleanup for freeze in initializer)
  ##  -> reset interpreter
  state resetInterpreter
  false state [] .interpreterActive =
end
proc( TypeCheckState ptr mut : state -> ) =>: unfreezeInterpreter
  state [] .interpreterActive if
    return
  end
  state [] .program =:: progContext
  state [] .interpreter @ =:: interpreter
  ## XXX? make buffer part of state
  state [] .stack branchTree.depth TypeInfo list.create =:: mut: buffer
  TypeInfo ptr optional : typeInfo?
  state currentBlockStart =:: minEditableIndex
  while
    state [] .stack @ branchTree.peek typeInfo? =
  typeInfo? optional.hasData do
    typeInfo? .data =:: typeInfo
    typeInfo [] .value .none ?? if
      break
    else typeInfo [] .opIndex 0 < _if
      break
    else typeInfo [] .opIndex minEditableIndex < _if
        state [] .opInfo typeInfo [] .opIndex list.at .data =:: opInfo
        opInfo [] .canMove ! opInfo [] .childCount 0 != | _if
      break
    end
    buffer
      typeInfo list.appendP
    buffer =
    state [] .stack @ branchTree.pop ..drop
  end
  ##  -> reset interpreter
  state resetInterpreter
  ##  -> copy values to interpreter
  buffer .length 1 - while ..dup 0 >= do
    buffer ..over list.at .data =:: typeInfo
    typeInfo [] .opIndex state deleteOp ## clear previous location of operation
    interpreter [] .stack
      typeInfo [] .value list.append
    interpreter [] .stack =
    interpreter [] .stackInfo
      ## ValueInfo
        typeInfo [] .valueType
        typeInfo [] .valueId
        id.LABEL_ID_NONE
        typeInfo [] .pushedAt
      ValueInfo new list.append
    interpreter [] .stackInfo =
    1 -
  end ..drop
  buffer list.free ..drop
  state removeTrailingNOPs
  true state [] .interpreterActive =
end

proc( TypeCheckState ptr mut : state -> ) =>: resetInterpreter
  state [] .interpreter @ =:: interpreter
  interpreter
    state [] .isGlobal if
      InterpreterType .GLOBAL
    else
      InterpreterType .FOLD_LOCAL
    end 
  interpreter.resetContext
  true state [] .interpreterActive =
end


proc(
  bool : printValues
  i32 : maxCount
  i32 : depth
  TypeCheckState ptr mut : state
-> ) =>: printTypes
  state [] .program [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  idContext [] .constContext @ =:: constContext
  maxCount =:: mut: remaining
  printValues if
    "stack:\n" sb.wrap
  else
    "types:\n" sb.wrap
  end
    "-----------------\n" sb.appendS
  =:: mut: sb
  state [] .stack @ branchTree.itr.start while
    branchTree.itr.hasNext do branchTree.itr.next =:: val
    remaining 0 > if
        remaining 1 - remaining =
        remaining 0 == _if
      break
    end
    sb
      printValues if val [] .valueId id.LABEL_ID_NONE != _if
        val [] .valueId labelContext sb.appendLabelName
        ": " sb.appendS
      end
      val [] .valueType
        typeContext
        depth
      sb.appendTypeRecursive
      printValues if
        val [] .value .none ?? ! if
          " { " sb.appendS
          val [] .value
            constContext
            typeContext
          sb.appendConstant
          " }" sb.appendS
        end
        " pushed at " sb.appendS
        val [] .pushedAt sb.appendPos
      end
      '\n' sb.appendC
    sb =
  end ..drop
  sb
    "-----------------\n" sb.appendS
    io.stdOut ..over io.fputSb ..drop
  sb.free ..drop
end

proc(
  i64 : count
  FilePosition : pos
  TypeCheckState ptr mut : state
-> bool ) =>: checkStackSize
  state [] .stack branchTree.depth count < if
    "stack underflow: need " sb.wrap
      count sb.appendI
      " values got " sb.appendS
      state [] .stack branchTree.depth sb.appendI
    pos state [] .program [] .errors @ appendError
    true return
  end
  false return
end

proc(
  TypeInfo : src
  Type : target
  FilePosition : pos
  TypeCheckState ptr mut : state
-> bool ) =>: tryCastConstant
  state [] .program [] .errors @ =:: errors
  state [] .program [] .idContext .typeContext @ =:: typeContext
  src .value .none ?? if
    true return
  end
  src .opIndex 0 < if ## XXX? why is this reachable
    true return
  end
  state [] .compiledOps src .opIndex list.at .data =:: srcOp
  srcOp [] .val .Constant ?? ! if
    true return
  end
  ## casting between integer constants
  src .value .int ?? if target typeContext types.isInt _if
    target .arrayIndex ?? if
      src .value .int 0 < if
        "array indices cannot be less than 0 got: " sb.wrap
        src .value .int sb.appendI
        pos errors appendError
        false return
      end
      target typeContext types.getArraySize 0 array.get =:: index
      index .sizeType .int ?? ! if
        true return
      end
      src .value .int 0 < src .value .int index .value >= | if
        "array index outside allowed range: " sb.wrap
        src .value .int sb.appendI
        " size: " sb.appendS
        index .value sb.appendI
        pos errors appendError
      end
    end
    target srcOp [] .dataType =
    false return
  end
  true return
end
proc(
  Type arrayView : types
  string : name
  ## number of values already popped by instruction
  i32 : stackCastOffset
  FilePosition : pos
  TypeCheckState ptr mut : state
-> i64 #+argOffset+# bool ) =>: requireTypes
  state [] .program [] .errors @ =:: errors
  state [] .program [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  types .length i64 list.create =:: mut: argOffsets
  1 while ..dup types .length <= do =:: i
    types types .length i - array.get =:: expectedType
    state [] .stack branchTree.depth 0 <= if
      expectedType .empty ?? if
        i 1 + continue ## skip empty arguments if no values on stack
      end
      "not enough types for " sb.wrap
        name sb.appendStr
      pos errors appendError
      state [] .childIds .length true return
    end
    ## append dummy value for argument offset
    argOffsets
      OP_UNLINKED list.append
    argOffsets =
    expectedType .empty ?? if
      state [] .stack @ branchTree.peek .data =:: typeInfo
      typeInfo [] .valueType typeContext types.isEmpty ! if
        i 1 + continue ## skip empty if stack value non-empty
      end
    end
    state [] .stack @ branchTree.pop .data [] =:: typeInfo
    ## set argument offset to correct value
    typeInfo .opIndex argOffsets list.peek .data [] =
    typeInfo .valueType expectedType types.typeEquals if
      i 1 + continue
    end
    ## canAutoCast
      typeInfo .valueType
      expectedType
    typeContext types.canAutoCast if
      typeInfo expectedType pos state tryCastConstant ! if
        i 1 + continue
      end
      expectedType .arrayIndex ?? if
        true state [] .program [] .hasCheckIndex =
      end
      ## opAutoCast
        typeInfo .valueType
        i 1 - stackCastOffset +
        expectedType
        pos
      opAutoCast state appendOp =:: opId
      typeInfo .opIndex 0 < if
        ## no index update necessary
        i 1 + continue
      end
      state [] .childIds
        ..dup .length =:: argId
        typeInfo .opIndex list.append
      state [] .childIds =
      state [] .opInfo
        typeInfo .opIndex list.at .data
      =:: opData
      ## updateOpInfo
        opData [] .canMove
        opData [] .canDelete
        1
        argId
        state
      updateOpInfo_noStack
      ## update argument offset
      opId argOffsets list.peek .data [] =
      i 1 + continue
    end
    "wrong type for " sb.wrap
      name sb.appendStr
      " expected " sb.appendS
      expectedType typeContext sb.appendType
      " got " sb.appendS
      typeInfo .valueType typeContext sb.appendType
    pos errors appendError
    i 1 +
  end ..drop
  state [] .childIds
    ..dup .length =:: argsOffset
    argOffsets list.appendAll
  state [] .childIds =
  argOffsets list.free ..drop
  argsOffset false return
end
proc( i64 : count FilePosition : pos TypeCheckState ptr mut : state -> ) =>: discardValues
  state [] .program =:: program
  state [] .program [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  count pos state checkStackSize if return end
  0 =:: mut: toDrop
  0 while ..dup count < do
    state [] .stack @ branchTree.pop .data =:: typeInfo
    typeInfo [] .valueType typeContext types.isEmpty if
      1 + continue
    end
    typeInfo [] .opIndex state tryDeleteOp if
      toDrop 1 + toDrop =
    end
    1 +
  end ..drop
  state removeTrailingNOPs
  toDrop 0 > if
    toDrop StackModType .DROP pos opStackMod state appendOp ..drop
  end
end

proc( FilePosition : pos TypeCheckState ptr mut : state -> Type ) =>: popType
  state [] .program =:: program
  state [] .program [] .errors @ =:: errors
  state [] .program [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  1 pos state checkStackSize if Type .undefined return end
  state [] .stack @ branchTree.peek .data =:: typeInfo
  typeInfo [] .valueType =:: mut: valType
  valType typeContext types.unwrapReference valType =
  valType types.primitive.TYPE != if
    "expected type got " sb.wrap
      valType typeContext sb.appendType
    pos errors appendError
    Type .undefined return
  end
  typeInfo [] .value .typeId ?? ! if
    "expected type-constant got " sb.wrap
      typeInfo [] .value constContext typeContext sb.appendConstant
    pos errors appendError
    Type .undefined return
  end
  typeInfo [] .opIndex state currentBlockStart < if
    "type-constant " sb.wrap
      typeInfo [] .value constContext typeContext sb.appendConstant
      " at " sb.appendS
      typeInfo [] .pushedAt sb.appendPos
      " was declared outside current block" sb.appendS
    pos errors appendError
    Type .undefined return
  end
  typeInfo [] .value .typeId =:: typeId
    state [] .stack @ branchTree.pop ..drop ## drop value
    typeInfo [] .opIndex state deleteOp ## remove stored operation
  typeId return
end

proc(
  ConstValue : value
  Type : valType
  FilePosition : pos
  TypeCheckState ptr mut : state
-> ) =>: pushConstant
    state [] .program =:: program
    program [] .idContext @ =:: idContext
    idContext [] .typeContext @ =:: typeContext
    valType typeContext types.isEmpty if
      OP_EMPTY
    else
      state [] .compiledOps .length
    end =:: opIndex
    ## branchTree.push
      state [] .stack @
      ## TypeInfo
        valType
        value
        id.LABEL_ID_NONE
        pos
        opIndex
        OP_UNLINKED
        OP_UNLINKED
      TypeInfo new
    branchTree.push
    opIndex 0 < if
      return
    end
    state [] .compiledOps
      value valType pos opConst list.append
    state [] .compiledOps =
    state [] .opInfo
      ## OpInfo
        0
        0
        true
        true
      OpInfo new list.append
    state [] .opInfo =
end
proc(
  Type : valType
  ConstValue : value
  Operation : op
  TypeCheckState ptr mut : state
-> ) =>: pushValue
    state [] .program =:: program
    program [] .idContext @ =:: idContext
    idContext [] .typeContext @ =:: typeContext
    valType typeContext types.isEmpty if
      OP_EMPTY
    else
      state [] .compiledOps .length
    end =:: opIndex
    ## branchTree.push
      state [] .stack @
      ## TypeInfo
        valType
        value
        id.LABEL_ID_NONE
        op .pos
        opIndex
        OP_UNLINKED
        OP_UNLINKED
      TypeInfo new
    branchTree.push
    opIndex 0 < if
      return
    end
    state [] .compiledOps
      op list.append
    state [] .compiledOps =
    state [] .opInfo
      ## OpInfo
        0
        0
        false
        false
      OpInfo new list.append
    state [] .opInfo =
end
proc(
  Type arrayView : types
  FilePosition : pos
  TypeCheckState ptr mut : state
-> ) =>: pushTypes
  state [] .program [] .idContext
    .typeContext @
  =:: typeContext
  0 while ..dup types .length < do =:: i
    state [] .stack @
      ## TypeInfo
        types i array.get
        ConstValue .none
        id.LABEL_ID_NONE
        pos
        ## multiple types from one op -> cannot modify op to modify types
        OP_UNLINKED
        OP_UNLINKED
        OP_UNLINKED
      TypeInfo new
    branchTree.push
    i 1 +
  end ..drop
end
proc(
  bool : canMove
  bool : canDelete
  i64 : argCount
  i64 : argOffset
  TypeCheckState ptr mut : state
-> ) =>: updateOpInfo
  state [] .program [] .errors @ =:: errors
  state [] .stack @ branchTree.peek .data =:: typeInfo
  typeInfo [] .opIndex =:: opIndex
  opIndex OP_UNLINKED == if
    "cannot update information of operations pushed outside current block" sb.wrap
    typeInfo [] .pushedAt errors appendError
    return
  else opIndex OP_EMPTY == _if
    return ## no need to update empty operation
  end
  canMove canDelete argCount argOffset state opIndex updateOpInfoIndex
end
proc(
  bool : canMove
  bool : canDelete
  i64 : argCount
  i64 : argOffset
  TypeCheckState ptr mut : state
-> ) =>: updateOpInfo_noStack
  canMove canDelete argCount argOffset state state [] .opInfo .length 1 - updateOpInfoIndex
end
proc(
  bool : canMove
  bool : canDelete
  i64 : argCount
  i64 : argOffset
  TypeCheckState ptr mut : state
  i64 : opIndex
-> ) =>: updateOpInfoIndex
  opIndex 0 < if
    return ## no operation to update
  end
  state [] .opInfo opIndex list.at .data =:: opInfo
  argCount i32.MAX > if
    ..unreachable ## XXX handle case of too many arguments
  end
  argCount i32 cast opInfo [] .childCount =
  argOffset opInfo [] .childOffset =
  true =:: mut: canMoveChildren
  0 while ..dup argCount < do
    state [] .childIds ..over argOffset + list.get =:: childId
    childId 0 < if
      false canMoveChildren =
    else state [] .opInfo childId list.at .data [] .canMove ! _if
      false canMoveChildren =
    end
    1 +
  end ..drop
  canMove canMoveChildren & opInfo [] .canMove =
  canDelete opInfo [] .canDelete =
end
proc( i64 : opIndex TypeCheckState ptr mut : state -> ) =>: freezeOp
  opIndex 0 < if return end
  state [] .opInfo opIndex list.at .data =:: opInfo
  false opInfo [] .canMove =
  false opInfo [] .canDelete =
end
proc( LabelId : label TypeCheckState ptr mut : state -> ) =>: replaceLabel
  state [] .stack @ branchTree.pop .data [] =:: mut: top
  label top .valueId =
  state [] .stack @ top branchTree.push
end

proc(
  BlockInfo : blockInfo
  TypeCheckState ptr mut : state
-> ) =>: openBlock
  state [] .openBlocks
    blockInfo list.append
  state [] .openBlocks =
end

proc(
  TypeCheckState ptr mut : state
-> BlockInfo ptr mut optional ) =>: peekBlock
  state [] .openBlocks list.peek
end
proc(
  FilePosition : pos
  TypeCheckState ptr mut : state
-> BlockInfo ) =>: closeBlock
  state [] .program [] .errors @ =:: errors
  state [] .openBlocks .length 0 == if
    BlockInfo .Unknown return
  end
  state [] .openBlocks .length 1 - =:: newLength
  state [] .openBlocks newLength list.at .data [] =:: closed
  state [] .openBlocks
    newLength list.setLength
  state [] .openBlocks =
  closed return
end
proc( TypeCheckState ptr : state -> bool ) =>: inSwitchLabel
  state [] .openBlocks .length 0 == if
    false return
  end
  state [] .openBlocks list.peek .data [] .Switch ?? ! if
    false return
  end
  state [] .openBlocks list.peek .data [] .Switch .inLabel return
end
proc(
  BlockType : breakType
  FilePosition : pos
  TypeCheckState ptr mut : state
-> BlockInfo ptr mut optional ) =>: findBreakableBlock
  state [] .program =:: program
  program [] .errors @ =:: errors
  state [] .openBlocks .length 1 - while ..dup 0 >= do =:: i
    state [] .openBlocks i list.at .data =:: block
    block [] .While ?? if
      block optional.wrap return
    end
    breakType .BREAK ?? if block [] .Switch ?? _if
      block optional.wrap return
    end
    i 1 -
  end ..drop
  60 sb.create
    breakType sb.appendBlockType
    " can only appear in loops " sb.appendS
    breakType .BREAK ?? if
      "and switch-case statements" sb.appendS
    end
  pos errors appendError
  BlockInfo ptr mut optional.empty return
end

## break from current switch-branch, but don't terminate the branch
proc(
  SwitchBlockInfo ptr mut : switchBlock
  FilePosition : pos
  TypeCheckState ptr mut : state
-> ) =>: breakSwitch
  state [] .stack branchTree.depth =:: caseTypes
  state [] .stack @
    switchBlock [] .branchRoot
  branchTree.reset =:: caseBranch
  state [] .reachable if
    ## add space for casts of values on stack
    switchBlock [] .castOffsets
      ## reserveOps
        caseTypes
        pos
      state reserveOps list.append
    switchBlock [] .castOffsets =
    ## reset stack to start of if statement
    switchBlock [] .caseBranches
      ## BranchPoint
        caseBranch
        pos
      BranchPoint new list.append
    switchBlock [] .caseBranches =
  end
  BlockType .BREAK_SWITCH pos opBlock =:: mut: breakOp
  switchBlock [] .blockId breakOp .val .block .blockId =
  breakOp state appendOp ..drop
  false state [] .reachable =
end
## terminate current switch branch
proc( FilePosition : pos TypeCheckState ptr mut : state -> ) =>: endSwitchBranch
  state peekBlock =:: currentBlock?
  currentBlock? optional.hasData if
      currentBlock? .data =:: currentBlock
      currentBlock [] .Switch ?? _if
      currentBlock? .data [] .Switch @ =:: switchBlock
      switchBlock [] .inLabel ! _if
    true switchBlock [] .inLabel =
    switchBlock pos state breakSwitch
  end
end


proc(
  bool : clearConst
  i32 : offset
  FilePosition : pos
  TypeCheckState ptr mut : state
-> ) =>: clearReferences
  state [] .program [] .idContext .typeContext @ =:: typeContext
  ## list.create
    state [] .stack branchTree.depth
  TypeInfo list.create =:: mut: stackElements
  while state [] .stack @ branchTree.pop =:: next?
      next? optional.hasData do
    stackElements
      next? .data list.appendP
    stackElements =
  end
  while stackElements .length 0 > do
    stackElements
      list.pop =:: mut: elt
    stackElements =
    clearConst if
      ConstValue .none elt .value =
      id.LABEL_ID_NONE elt .valueId =
    end
    OP_UNLINKED elt .opIndex =
    elt .valueType typeContext types.isReference if
      elt .valueType =:: srcType
      elt .valueType
        typeContext types.getBaseType
      elt .valueType =
      ## update stack value
      ## opAutoCast
        srcType
        stackElements .length i32 cast offset +
        elt .valueType
        pos
      opAutoCast state appendOp ..drop
      ## remove possibility to overwrite copy
      OP_UNLINKED elt .copyMutableIndex =
    end
    state [] .stack @
      elt
    branchTree.push
  end
  stackElements list.free stackElements =
end

enum( MERGE MERGE_ROOT NO_CAST ) =:: MergeType
struct(
  string : blockName
  FilePosition : mergePoint
  i64 arrayView : castPointOffsets
  TypeCheckState ptr mut : state
  i64 : rootBranch
  MergeType : mergeType
) =:: MergePoint
proc(
  TypeInfo ptr arrayView : toMerge
  i64 : offset
  MergePoint : mergePoint
-> TypeInfo ) =>: mergeBranches
  mergePoint .state [] .program =:: program
  program [] .errors @ =:: errors
  program [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  toMerge .length 1 == if
    toMerge 0 array.get [] return
  end
  toMerge mergePoint .rootBranch array.get =:: root
  root [] .valueType =:: mut: mergedType
  true =:: mut: noError
  0 while ..dup toMerge .length < do =:: i
    i mergePoint .rootBranch == if
      i 1 + continue
    end
    toMerge i array.get =:: current
    mergePoint .mergeType switch
      MERGE case
        current [] .valueType mergedType typeContext types.mergeTypes if ..drop
          "cannot merge the branches of " sb.wrap
            mergePoint .blockName sb.appendStr
            "\n cannot merge types " sb.appendS
            mergedType typeContext sb.appendType
            " ( pushed at " sb.appendS
            root [] .pushedAt sb.appendPos
            " )\n and " sb.appendS
            current [] .valueType typeContext sb.appendType
            " ( pushed at " sb.appendS
            current [] .pushedAt sb.appendPos
            " )\n" sb.appendS
          mergePoint .mergePoint errors appendError
          false noError =
        else
          mergedType =
        end
        break
      MERGE_ROOT NO_CAST case
        current [] .valueType mergedType
          mergePoint .mergeType .NO_CAST ?? if
            types.typeEquals !
          else
            typeContext types.canAutoCast !
          end
        if
          "cannot merge the branches of " sb.wrap
            mergePoint .blockName sb.appendStr
            "\n expected: " sb.appendS
            mergedType typeContext sb.appendType
            " ( pushed at " sb.appendS
            root [] .pushedAt sb.appendPos
            " )\n got: " sb.appendS
            current [] .valueType typeContext sb.appendType
            " ( pushed at " sb.appendS
            current [] .pushedAt sb.appendPos
            " )\n" sb.appendS
          mergePoint .mergePoint errors appendError
          false noError =
        end
      break
    end
    i 1 +
  end ..drop
  noError if ## don't try casting values if merging types failed
    0 while ..dup toMerge .length < do =:: i
      toMerge i array.get =:: current
        current [] .valueType mergedType types.typeEquals ! if
          mergePoint .castPointOffsets i array.get =:: castRoot
          castRoot 0 >= if
            mergePoint .state [] .compiledOps castRoot offset + list.at .data =:: castPoint
            castPoint [] .val .NOP ?? if castPoint [] .val .NOP .RESERVED ?? _if
              ## opAutoCast
                current [] .valueType
                offset i32 cast
                mergedType
                mergePoint .mergePoint
              opAutoCast castPoint [] =
              i 1 + continue
            end
            "operation is not a NO-OP: " sb.wrap
              castPoint [] program sb.appendOp
            mergePoint .mergePoint errors appendError
          end
          "cannot cast " sb.wrap
            offset sb.appendI
            "th value in " sb.appendS
            i sb.appendI
            "th branch" sb.appendS
          mergePoint .mergePoint errors appendError
        end
      i 1 +
    end ..drop
  end
  ## TypeInfo
    mergedType
    ConstValue .none ## XXX merge constants
    id.LABEL_ID_NONE
    mergePoint .mergePoint
    OP_UNLINKED
    OP_UNLINKED
    OP_UNLINKED
  TypeInfo new return
end
proc(
  Operation ptr : op
  TypeCheckState ptr mut : state
-> ) =>: checkReachable
  state [] .reachable if
    return
  end
  ## check if op can appear in unreachable context
  op [] .val switch
    block case
      op [] .val .block .blockType switch
        ELSE CASE DEFAULT case
          return
        BREAK BREAK_SWITCH case
          state [] .openBlocks .length 0 > if
              state [] .openBlocks list.peek .data [] .Switch ?? _if
            return ## allow break in switch
          end
          break
        default break
      end
      break
    implementProcedure blockEnd unreachable NOP compilerInfo case
      return
    default break
  end
  state [] .program =:: program
  program [] .errors @ =:: errors
  program [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  "unreachable operation: " sb.wrap
    op [] program sb.appendOp
  op [] .pos errors appendError
end


