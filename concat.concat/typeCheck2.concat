proc(
  Operation : op0
  TypeCheckState ptr mut : state
-> ) =>: typeCheckOp
  op0 =:: mut: op
  state [] .program =:: program
  state [] .program [] .errors @ =:: errors
  state [] .program [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  op .dataType .autoType ?? if ## try resolving auto-types
    op .dataType types.getTypeId =:: id
    id 0 >= id program [] .autoTypes .length < & if
      program [] .autoTypes id list.get =:: autoType
      autoType .undefined ?? ! if
        autoType op .dataType =
      end
    end
  end
  state inSwitchLabel if op @ state typeCheckSwitchLabel _if
    return
  end
  op .val .getName ?? if
    op .val .getName
      op @ state resolveIdentifer
    ..dup optional.hasData if
      .data op .val .getId =
    else ..drop end
  else op .val .atName ?? _if
    op .val .atName
      op @ state resolveIdentifer
    ..dup optional.hasData if
      .data op .val .atId =
    else ..drop end
  else op .val .getId ?? _if ## convert static arguments to constants
      op .val .getId .labelId =:: label
      label labelContext id.labelFlags id.FLAG_STATIC & ? _if
      ConstValue .none =:: mut: argValue
      state [] .argData @ label map.at =:: argData?
      argData? optional.hasData _if
    argData? .data [] .valType op .dataType =
    argData? .data [] .value op .val .Constant =
  end
  state [] .interpreterActive if op @ state [] .interpreter @ evaluateOperation ! _if
    return ## evaluate constants
  end
  state freezeInterpreter
  op @ state checkReachable
  op .val switch
    NOP case return
    Constant case
      op .dataType types.primitive.TYPE types.typeEquals if
        state unfreezeInterpreter
        op @ state [] .interpreter @ evaluateOperation if
          "could not evaluate " sb.wrap
            op program sb.appendOp
          op .pos errors appendError
        end
        return
      end
      op .val .Constant op .dataType op .pos state pushConstant
      return
    getId case
      op .val .getId =:: idInfo
      idInfo .labelId labelContext id.labelFlags id.FLAG_MUTABLE & ? =:: mutable
      mutable if
        ConstValue .none
      else
        idInfo .constValue
      end =:: constValue
      idInfo .idType switch
        GLOBAL_VAR LOCAL_VAR TMP_VAR case
          ## pushValue
            op .dataType
              mutable
            typeContext types.newReferenceType
            constValue
            op
          state pushValue
          op .val .getId .labelId state replaceLabel
          mutable ! true 0 0 state updateOpInfo
          mutable if ## insert copy for mutable values
            state wrapCopy
          end
          return
        TYPE TEMPLATE_ARG case
          op .dataType constValue op state pushValue
          op .val .getId .labelId state replaceLabel
          true true 0 0 state updateOpInfo
          return
        ARGUMENT case
          op .val .getId .labelId =:: label
          ConstValue .none =:: mut: argValue
          state [] .argData @ label map.at =:: argData?
          argData? optional.hasData if
            argData? .data [] .valType op .dataType =
            argData? .data [] .value argValue =
          end
          op .dataType argValue op state pushValue
          label state replaceLabel
          true true 0 0 state updateOpInfo
          return
        PROCEDURE PROCEDURE_BUNDLE case
          ## getIdentifierByLabel
            idInfo .labelId
            idContext
          id.getIdentifier if ..drop
            "could not find " sb.wrap
              idInfo labelContext sb.appendIdInfo
            op .pos errors appendError
            return
          end =:: idData
          idInfo .idType .PROCEDURE ?? if
            idData [] .constValue .procedure @ =:: procId
            program [] .procedures
              procId [] list.at .data
            =:: procData
            procData [] .isStatic if
              state unfreezeInterpreter
              op @ state [] .interpreter @ evaluateOperation if
                "could not evaluate " sb.wrap
                  op program sb.appendOp
                op .pos errors appendError
              end
              return
            end
            procId array.wrap
          else  ## PROCEDURE_BUNDLE
            idData [] .constValue .procedureBundle =:: bundleId
            program [] .procBundles
              bundleId list.at .data [] .procedures
            list.asArray
          end =:: procedures
          0 =:: mut: stackConstants
          true =:: mut: headConstant
          state [] .stack branchTree.depth StackValue list.create =:: mut: stackValues
          state [] .stack @ branchTree.itr.start while
            branchTree.itr.hasNext do branchTree.itr.next =:: val ## don't consume value
            headConstant if val [] .value .none ?? ! _if
              stackConstants 1 + stackConstants =
            else
              false headConstant =
            end
            stackValues
              ## StackValue
                val [] .valueType
                val [] .value
              StackValue new list.append
            stackValues =
          end ..drop
          0 sb.create =:: mut: message
          ## resolveCall
            procedures
            stackValues list.asArray
            message @ optional.wrap
            op .pos
            program
          resolveCall =:: calledType =:: calledProc?
          calledProc? optional.isEmpty if
            message op .pos errors appendError
            return
          else
            io.stdOut message io.fputSb ..drop ## debug
            message sb.free ..drop
          end
          stackValues list.free ..drop
          calledProc? .data =:: calledProc
          program [] .procedures
            calledProc .procId list.at .data
          =:: calledProcData
          calledType op .dataType =
          calledProcData [] .implementation switch
            code case
              calledProc OpValue .call op .val =
            break
            builtIn case
              calledProcData [] .implementation .builtIn .builtIn
                OpValue .builtIn op .val =
            break
          end
          calledType typeContext types.getProcIn ..drop =:: inTypes
          inTypes typeContext types.compositeEltCount =:: argCount
          stackConstants argCount >= if ## enough arguments for interpreting call
              calledProcData [] .isStatic ## only try interpreting static and built-ins
              calledProcData [] .implementation .builtIn ?? | _if
            state unfreezeInterpreter
            op @ state [] .interpreter @ evaluateOperation ! if
              return
            end
            state freezeInterpreter ## constant evaluation failed
          end
          0 =:: mut: offset
