proc( TypeCheckState ptr mut : state -> ) =>: removeTrailingNOPs
  state [] .compiledOps .length 1 - while ..dup 0 >= do
    state [] .compiledOps ..over list.at .data [] .val .NOP ?? ! if
      break
    end
    1 -
  end 1 + =:: offset
  state [] .compiledOps
    offset list.setLength
  state [] .compiledOps =
  state [] .opInfo
    offset list.setLength
  state [] .opInfo =
end
