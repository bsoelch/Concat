              offset 1 + offset =
            end
            i 1 -
          end ..drop
          op state appendOp ..drop
          calledType typeContext types.getProcOut ..drop
            typeContext types.compositeEltArray
            op .pos
            state
          pushTypes
          return
        LABEL case
          break
      end
      break
    callPtr case
      state [] .stack @ branchTree.peek =:: value?
      value? optional.isEmpty if
        ## TODO? print instruction name instead of 'call'
