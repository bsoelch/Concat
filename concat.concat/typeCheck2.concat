proc( Operation ptr mut : op bool : autoTyped TypeCheckState ptr mut : state -> ) =>: resolveAutoType
  state [] .program [] .errors @ =:: errors
  state [] .program [] .autoTypes @ =:: autoTypes
  state [] .program [] .idContext .typeContext @ =:: typeContext
  op [] .dataType .autoType ?? if
    op [] .dataType types.getTypeId =:: id
    autoTyped if
      state [] .stack @ branchTree.peek =:: value?
      value? optional.hasData if
        value? .data [] .valueType
        ..dup typeContext types.isReference if
          typeContext types.getBaseType ## unwrap reference
        end
      else
        "missing type for declaration" sb.wrap op [] .pos errors appendError
        return
      end
    else
      op [] .pos state popType
    end =:: valType
    valType op [] .dataType =
    id 0 < id autoTypes [] .length >= | if
      "auto-type id outside allowed range:" sb.wrap
        id sb.appendI
        " maximum:" sb.appendS
        autoTypes [] .length 1 - sb.appendI
      op [] .pos errors appendError
    end
    ## XXX? check for redefinition of auto-type
    valType autoTypes [] id list.set
    end
end

proc( Operation ptr mut : op TypeCheckState ptr mut : state -> ) =>: typeCheckOp
  state [] .program =:: program
  state [] .program [] .errors @ =:: errors
  state [] .program [] .idContext @ =:: idContext
  state [] .program [] .idContext .constContext @ =:: constContext
  state [] .program [] .idContext .typeContext @ =:: typeContext
  state [] .program [] .idContext .labelContext @ =:: labelContext
  op [] .dataType .autoType ?? if ## try resolving auto-types
    op [] .dataType types.getTypeId =:: id
    id 0 >= id program [] .autoTypes .length < & if
      program [] .autoTypes id list.get =:: autoType
      autoType .undefined ?? ! if
        autoType op [] .dataType =
      end
    end
  end
  state [] .interpreterActive if op state [] .interpreter @ false evaluateOperation ! _if
    return ## evaluate constants
  end
  state freezeInterpreter
  op [] .val switch
    NOP case return
    OpValue .Constant case
      op [] .dataType types.primitive.TYPE types.typeEquals if
        state unfreezeInterpreter
        op state [] .interpreter @ true evaluateOperation if
          "could not evaluate " sb.wrap
            op [] constContext labelContext typeContext sb.appendOp
          op [] .pos errors appendError
        end
        return
      end
      op [] .val .Constant op [] .dataType op [] .pos state pushConstant
      return
    getId case
      op [] .val .getId =:: idInfo
      idInfo .labelId labelContext id.labelFlags id.FLAG_MUTABLE & ? =:: mutable
      mutable if
        idInfo .constValue
      else
        ConstValue .none
      end =:: constValue
      idInfo .idType switch
        GLOBAL_VAR LOCAL_VAR TMP_VAR case
          constValue op [] state pushValue
          op [] .dataType mutable typeContext types.newReferenceType state replaceType
          op [] .val .getId .labelId state replaceLabel
          mutable ! true 0 0 state updateOpInfo
          mutable if ## insert copy for mutable values
            state wrapCopy
          end
          return
