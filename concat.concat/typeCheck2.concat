        state [] .stack @ branchTree.peek .data
      [] .readCheckIndex =
      mutable ! true childCount childOffset state updateOpInfo
      isAddr if
        container .copyMutableIndex state removeCopy
      else
        container .copyMutableIndex state [] .stack @ branchTree.peek .data [] .copyMutableIndex =
      end
      return
    getElement @Element case
      break
    getArrayElement @ArrayElement case ## TODO? extract to procedure
      op [] .val .@ArrayElement ?? =:: isAddr
      0 =:: mut indexCount
      state [] .stack @ branchTree.itr.start while
        branchTree.itr.hasNext
      do branchTree.itr.peekNext =:: typeInfo ## don't consume value
        typeInfo [] .valueType typeContext types.isReference if
          ## unwrap references
          typeInfo [] .valueType typeContext types.getBaseType
        else
          typeInfo [] .valueType
