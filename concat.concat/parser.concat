  return
end
proc( io.IOError : err stringBuilder : fileName FilePosition : pos ParserState ptr mut : state => ) =: checkIOError
  #using io
  err switch
    FILE_ERROR_NONE case
      return
    FILE_ERR_PATH_OVERFLOW FILE_ERR_OPEN_MODE FILE_ERR_FILE_NOT_FOUND FILE_ERR_FILE_IS_DIR FILE_ERR_ACCESS_DENIED FILE_ERR_INVALID_FILE case
      "cannot include file \"" sb.wrap fileName sb.appendSb '"' sb.appendC pos state appendError
      return
    default
      "error while reading file \"" sb.wrap fileName sb.appendSb '"' sb.appendC pos state appendError
      return
  end
end
proc( stringBuilder : fileName FilePosition : pos ParserState ptr mut : state => ) =: includeFile
  FILE_ID_NONE =:: mut included
  0 while #dup state [] .progFiles .length < do
    state [] .progFiles #over list.get .fileName sb.toStr fileName sb.toStr string.eq if
      #dup included =
      break
    end
    1 +
  end #drop
  included FILE_ID_NONE == if ## file has not yet been included
    fileName state parseFile fileName pos state checkIOError included =
  end
  state [] .progFiles state [] .currentFile list.at .data
  #dup [] .includedFiles
      included
      pos
    IncludedFile new list.append
  #swap [] .includedFiles =
end

proc( stringBuilder : rootFile => Program ) =: public parseProgram
  ## ParserState
    rootFile sb.toStr '/' string.lastIndexOf #dup 0 >= if
      rootFile .data #swap 1 + string.create
    else
      #drop "./" string.wrap
    end
    "../lib/" string.wrap ## XXX allow to specify lib-path through arguments
    id.newIdentifierContext
    128 Constant        list.create 0
    128 types.Type      list.create
    32 StaticArgument   list.create 0
    16 ProgramFile      list.create
    FILE_ID_NONE
    128 Operation       list.create
    32 CompilerError    list.create
    0
  ParserState new =:: mut state
  rootFile state @ parseFile rootFile rootFile sb.toStr 0 0 FilePosition new state @ checkIOError #drop
  ## cleanup parser memory
  state .constants list.free #drop
  state .typeBuffer list.free #drop
  state .staticArgs list.free #drop
  ## Program
    state .idContext
    state .progFiles
    state .autoTypeCount types.Type list.createZeroInit ## ! assumes Type .undefined has all zero memory representation
    state .templateOps
    state .errors
    false ## has entry point XXX check in parser?
    false false ## helper function flags, set in type-check phase
    false ## has getArgs
  Program new return
end
proc( stringBuilder : fileName ParserState ptr mut : state => FileId io.IOError ) =: parseFile
  fileName
    #dup #over .length 1 - sb.charAt '\x00' != if
      '\x00' sb.appendC ## ensure file-name is zero terminated
      #dup .length 1 - #over .length = ## ensure there is a zero-terminator after the last character
    end
    #dup sb.toStr 0 1 FilePosition new #dup FileState new =:: mut fileState
    state [] .progFiles
      #over state [] .progFiles .length FileId cast state [] .idContext @ newProgFile list.append
    state [] .progFiles =
  state [] .currentFile
    state [] .progFiles .length 1 - FileId cast state [] .currentFile =
    #swap #dup .data #swap .length 1 + #+include zero-terminator after file-name+# io.OPEN_READ io.fopen
      #dup io.FILE_ERROR_NONE != if
        #swap #drop ## discard code file
        #swap state [] .currentFile = ## reset file id
        FILE_ID_NONE #swap return
      end #drop =:: f
      128 sb.create
        '\n' sb.appendC
        f sb.appendFile =:: err
        '\n' sb.appendC
      =:: fileBody
    f io.fclose #dup io.FILE_ERROR_NONE != err io.FILE_ERROR_NONE != | if
      #swap state [] .currentFile = ## reset file id
      err io.FILE_ERROR_NONE != if #drop
        FILE_ID_NONE err return
      else
        FILE_ID_NONE #swap return
      end
    end #drop
    fileState @
      fileBody sb.toStr while
        #over nextToken #over:2 state parseOperation
        #dup .length 0 >
      do end #drop
    #drop
    fileBody sb.free #drop
    state [] .currentFile #swap
  state [] .currentFile =
  io.FILE_ERROR_NONE return
end
