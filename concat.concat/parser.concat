      BlockType .TYPE_STRUCT fileState [] .wordStart opBlock state appendOp
      return
    else $ "union(":s string.eq _if ..drop
      BlockType .TYPE_UNION state openTypeBlock
      BlockType .TYPE_UNION fileState [] .wordStart opBlock state appendOp
      return
    else $ "union.raw(":s string.eq _if ..drop
      BlockType .TYPE_UNTAGGED_UNION state openTypeBlock
      BlockType .TYPE_UNTAGGED_UNION fileState [] .wordStart opBlock state appendOp
      return
    else $ "enum(":s string.eq _if ..drop
      BlockType .TYPE_ENUM state openTypeBlock
      BlockType .TYPE_ENUM fileState [] .wordStart opBlock state appendOp
      return
    ## forward compatability: `proc.c` will be used for proc with c-call convention
    else $ "proc(":s string.eq or $ "proc.c(":s string.eq _if =:: opName
      opName .length "proc(":s .length == if
        BlockType .TYPE_PROC_IN
      else
        BlockType .TYPE_CPROC_IN
      end =:: procBlockType
      procBlockType state openTypeBlock
      procBlockType fileState [] .wordStart opBlock state appendOp
      return
    else $ "->":s string.eq _if =:: opName
      state peekBlock .and =:: currentBlock
          currentBlock .blockData .?TypeBlock .if =:: typeData
        typeData [] .arrowPosition .if =:: oldArrowPos
          "type-blocks cannot contain multiple `" sb.copyPtr
            opName sb.appendStr
            "` statements" sb.appendS
