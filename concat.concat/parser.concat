        else .boolean end ! if
          "assertion failed \"" sb.wrap
            message sb.appendStr
            "\" " sb.appendS
          fileState [] .wordStart state appendError2
        end
      return
    end
  #dup state [] .currentFile idContext id.getIdentifier ! if ## try parsing as identifier
    #dup [] .valueType #swap id.asIdInfo fileState [] .wordStart opGet state appendOp
    #drop:2
    return
  end #drop:2
  id.FLAG_NONE fileState [] .wordStart state [] .currentFile labelContext id.newLabel fileState [] .wordStart opGetName  state appendOp
  return
end
proc( io.IOError : err stringBuilder : fileName FilePosition : pos ParserState ptr mut : state => ) =: checkIOError
  #using io
  err switch
    FILE_ERROR_NONE case
      return
    FILE_ERR_PATH_OVERFLOW FILE_ERR_OPEN_MODE FILE_ERR_FILE_NOT_FOUND FILE_ERR_FILE_IS_DIR FILE_ERR_ACCESS_DENIED FILE_ERR_INVALID_FILE case
      "cannot include file \"" sb.wrap fileName sb.appendSb '"' sb.appendC pos state appendError2
      return
    default
      "error while reading file \"" sb.wrap fileName sb.appendSb '"' sb.appendC pos state appendError2
      return
  end
end
proc( stringBuilder : fileName FilePosition : pos ParserState ptr mut : state => ) =: includeFile
  state [] .progContext =:: progContext
  FILE_ID_NONE =:: mut included
  0 while #dup progContext [] .progFiles .length < do
    progContext [] .progFiles #over list.get .fileName sb.asStr fileName sb.asStr string.eq if
      #dup included =
      break
    end
    1 +
  end #drop
  included FILE_ID_NONE == if ## file has not yet been included
    fileName state parseFile fileName pos state checkIOError included =
  end
  progContext [] .progFiles state [] .currentFile list.at .data
  #dup [] .includedFiles
      included
      pos
    IncludedFile new list.append
  #swap [] .includedFiles =
end

proc( stringBuilder : rootFile string : libPath string : basePath => ProgramContext ) =: public parseProgram
  ## ProgramContext
    id.newIdentifierContext
    16  ProgramFile           list.create
    64  ProcedureInfo         list.create
    0   Type                  list.create ## autoTypes, not used in parser
    128 Operation             list.create
    0   SwitchData            list.create
    32  CompilerError         list.create
    false ## hasEntryPoint
    false ## hasCheckIndex
    false ## hasCheckEnum
    false ## has getArgs
  ProgramContext new =:: mut programContext
  ## ParserState
    basePath
    libPath
    programContext @
    128 Operation               list.create
    128 Constant                list.create
    0
    128 Type                    list.create
    32  StaticArgument          list.create
    0
    FILE_ID_NONE
    ProcedureInfo               optional.empty
    128 CompositeConstantOffset list.create
    0   InterpreterInfo         list.create
    128 LabelId                 list.create
  ParserState new =:: mut state
  rootFile state @ parseFile rootFile rootFile sb.asStr 0 0 FilePosition new state @ checkIOError #drop
  ## cleanup parser memory
  state .constants list.free #drop
  state .typeBuffer list.free #drop
  state .staticArgs list.free #drop
  state .constantBlocks list.free #drop
  0 while #dup state .globalInterpreters .length < do
    state .globalInterpreters #over list.at .data [] .context @ cleanupContext
    1 +
  end #drop
  state .globalInterpreters list.free #drop
  programContext return
end
proc( stringBuilder : fileName ParserState ptr mut : state => FileId io.IOError ) =: parseFile
  fileName
    state [] .progContext =:: progContext
    #dup #over .length 1 - sb.charAt '\x00' != if
      '\x00' sb.appendC ## ensure file-name is zero terminated
      #dup .length 1 - list.setLength ## ensure there is a zero-terminator after the last character
    end
    #dup sb.asStr 0 1 FilePosition new #dup FileState new =:: mut fileState
    progContext [] .progFiles
      #over progContext [] .progFiles .length FileId cast progContext [] .idContext @ newProgFile list.append
    progContext [] .progFiles =
    state [] .globalInterpreters
      ## InterpreterInfo
        progContext wrapProgram
        0
      InterpreterInfo new list.append
    state [] .globalInterpreters =
  state [] .currentFile
    progContext [] .progFiles .length 1 - FileId cast state [] .currentFile =
    #swap #dup .data #swap .length 1 + #+include zero-terminator after file-name+# io.OPEN_READ io.fopen
      #dup io.FILE_ERROR_NONE != if
        #swap #drop ## discard code file
        #swap state [] .currentFile = ## reset file id
        FILE_ID_NONE #swap return
      end #drop =:: f
      128 sb.create
        '\n' sb.appendC
        f sb.appendFile =:: err
        '\n' sb.appendC
      =:: fileBody
    f io.fclose #dup io.FILE_ERROR_NONE != err io.FILE_ERROR_NONE != | if
      #swap state [] .currentFile = ## reset file id
      err io.FILE_ERROR_NONE != if #drop
        FILE_ID_NONE err return
      else
        FILE_ID_NONE #swap return
      end
    end #drop
    fileState @
      fileBody sb.asStr while
        #over nextToken #over:2 state parseOperation
        #dup .length 0 >
      do end #drop
    #drop
    fileBody sb.free #drop
    state [] .currentFile #swap
  state [] .currentFile =
  io.FILE_ERROR_NONE return
end
