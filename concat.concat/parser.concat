            state [] .currentProcs
              $ list.peek .if
                [] NO_PROC != if ## append op before poping procedure
                  BlockType .PROCEDURE fileState [] .wordStart opEndBlock  state appendOp
                end
              else ..drop ## current-procs are empty -> no pop possible
                "unexpected end of procedure" sb.copyPtr fileState [] .wordStart errors appendError
                return
              end
              list.pop =:: currentProcId
            state .currentProcs=
            skipBlock ! if
              progContext [] .procedures
                currentProcId i64 cast list.at .data
              =:: currentProc
              progContext [] .tmpOps list.asSlice
                procBlockData .blockStart slice.tail
                $ 0 @[] =:: procStart
                ## FIXME:in some edge cases this assertion is hit
                _EXPERIMENTAL_ or procStart [] .val .?implementProcedure ? or
                    procStart [] .val .?initializeId ?
                end "procedure starts with correct operation" assert
                slice.copy
              currentProc .implementation .code .code=
              progContext [] .tmpOps
                procBlockData .blockStart list.setLength
              progContext .tmpOps=
              _EXPERIMENTAL_ ! and currentProc [] .labelId labelContext id.labelFlags id.FLAG_LAMBDA & ? if
                currentProc [] .procType .?Undefined ? if
                  currentProcId fileState [] .wordStart opNestedProc state appendOp
                else
                  currentProcId ConstValue .Procedure
                    currentProc [] .procType false typeContext types.getAddressType
                  fileState [] .wordStart opConst state appendOp
                end
              end
              currentProc [] .procType .?Undefined ? ! if
                ProcCodeState .PARSED currentProc .implementation .code .codeState=
              end
            end
          break
          Namespace case
            _EXPERIMENTAL_ if
              BlockType .NAMESPACE fileState [] .wordStart opEndBlock state appendOp
