          fileState [] .wordStart errors appendError
        else
          state opCount optional.wrap typeData .arrowPosition=
        end
        typeData
      else
        "unexpected `" sb.copyPtr
          opName sb.appendStr
          "` statement" sb.appendS
        fileState [] .wordStart errors appendError
        return
      end =:: typeBlock
      typeBlock [] .blockType switch
        TYPE_PROC_IN TYPE_CPROC_IN case break
        TYPE_COMPOSITE case
          typeBlock [] .blockStart state findOp .if =:: oldOp
            oldOp .val .?block .and .blockType =:: blockType
                blockType [] .TYPE_COMPOSITE if
              BlockType .TYPE_PROC_IN blockType =[]
            else
              "blocks and operations out of sync expected start of composite type got: " sb.copyPtr
                oldOp [] progContext sb.appendOp
              fileState [] .wordStart errors appendError
              return
            end
          end
          BlockType .TYPE_PROC_IN typeBlock .blockType=
        break
        default
          "unexpected " sb.copyPtr
            opName sb.appendStr
            " statement" sb.appendS
            ## TODO! print block name
          fileState [] .wordStart errors appendError
        return
      end
      BlockType .TYPE_PROC_ARROW fileState [] .wordStart opBlock state appendOp
      return
    else $ "typeSet(":s string.eq _if ..drop
      BlockType .TYPE_TYPESET state openTypeBlock
      BlockType .TYPE_TYPESET fileState [] .wordStart opBlock state appendOp
      return
    else $ ")":s string.eq _if =:: opName
      state closeBlock .else
        "unexpected " sb.copyPtr opName sb.appendStr fileState [] .wordStart errors appendError
        return
      end .blockData switch
        TypeBlock .case =:: mut: typeBlock
          typeBlock .blockStart fileState [] .wordStart state setBlockJump
          typeBlock .blockType
            _EXPERIMENTAL_ and $ .TYPE_COMPOSITE if ..drop
              BlockType .TYPE_STRUCT
              typeBlock .blockStart state findOp .if =:: oldOp
                oldOp .val .?block .and .blockType =:: blockType
                    blockType [] .TYPE_COMPOSITE if
                  $ blockType =[]
                else ..drop
                  "blocks and operations out of sync expected start of composite type got: " sb.copyPtr
                    oldOp [] progContext sb.appendOp
                  fileState [] .wordStart errors appendError
                  return
                end
              end
            end
          fileState [] .wordStart opEndBlock state appendOp
          state closedConstBlock
        return
        If AndOr While Switch Namespace Procedure Initializer Overload case
          "unexpected `" sb.copyPtr
            opName sb.appendStr
            "` statement " sb.appendS
            ## TODO print block name
          fileState [] .wordStart errors appendError
        return
      end
    else $ "{":s string.eq _if ..drop
      state openInitializerBlock
      BlockType .INITIALIZER fileState [] .wordStart opBlock state appendOp
      return
    else $ "}":s string.eq _if =:: opName
      state closeBlock .else
        "unexpected " sb.copyPtr opName sb.appendStr fileState [] .wordStart errors appendError
        return
      end .blockData switch
        Initializer .case =:: initData
          state closedConstBlock
          initData .blockStart fileState [] .wordStart state setBlockJump
          BlockType .INITIALIZER fileState [] .wordStart opEndBlock state appendOp
        return
        TypeBlock case
          state closedConstBlock
        break
        default break
      end
      "unexpected " sb.copyPtr opName sb.appendStr fileState [] .wordStart errors appendError
      return
    end
    skipBlock if
      ..drop return ## code currently in skipped section
    end
    ## 2. parse keywords & built-in operators
    $ ":":s string.eq or $ "=:":s string.eq if =:: opName
      ## TODO extract declaration parser into procedure?
      opName ":":s string.eq ! =:: isInit
      state [] .currentProcs .length 0:iSize != =:: mut: inProcedure
      state [] .constBlockCount 0 != =:: mut: inConstBlock
      inProcedure and inConstBlock if
        ## ensure only the innermost proc/constant is active
        state [] .openBlocks list.reversed for: findContainer =:: b
          BlockType ..length 42:iSize == "no new block types" assert
          b .blockData switch
            Procedure case
              false inConstBlock=
              break.findContainer
            Initializer TypeBlock Namespace case
              false inProcedure=
              break.findContainer
            default break
          end
        end
        ## correct type will be resolved in type-check phase
        progContext newAutoType
      else _EXPERIMENTAL_ or inProcedure or inConstBlock _if
        ## correct type will be resolved in type-check phase
        progContext newAutoType
      else
        fileState state popTypeConstant .else
          Type .Undefined
        end
      end =:: mut: valType
      false =:: mut: allowImmutableDeclaration
      false =:: mut: forceImmutable
      inConstBlock if
        IdentifierType .LABEL
        true allowImmutableDeclaration=
      else inProcedure _if
        IdentifierType .LOCAL_VAR
      else isInit ! and valType typeContext types.isProcedure _if
        IdentifierType .PROCEDURE
        true forceImmutable=
        true allowImmutableDeclaration=
      else valType typeContext types.isType _if
        IdentifierType .TYPE
        true forceImmutable=
        true allowImmutableDeclaration=
      else ## for comparability with old parser
        IdentifierType .GLOBAL_VAR
        true allowImmutableDeclaration=
      end =:: idType
      fileState errors nextIdentifier fileState state
        ## make pre-declared variables mutable by default
        isInit or allowImmutableDeclaration if id.FLAG_NONE else id.FLAG_MUTABLE end
      readLabelAddFlags =:: mut: label
      label labelContext id.labelFlags =:: labelFlags
      labelFlags id.FLAG_ALIAS & ? =:: isAlias
      forceImmutable and labelFlags id.FLAG_MUTABLE & ? if
        "identifiers of type " sb.copyPtr
          idType sb.appendIdType
         " cannot be mutable" sb.appendS
        fileState [] .wordStart errors appendError
      else isAlias _if
        isInit if
          "alias cannot have an implementation" sb.copyPtr
          fileState [] .wordStart errors appendError
        else _EXPERIMENTAL_ ! and idType .PROCEDURE ! _if
          "alias is only supported for procedure declarations" sb.copyPtr
          fileState [] .wordStart errors appendError
        end
      end
      _EXPERIMENTAL_ or inProcedure if
        label fileState [] .wordStart
          isInit if
            opInitializeName
          else
            opDeclareName
          end
        state appendOp
        return
      end
      labelFlags id.FLAG_EXPERIMENTAL & ? =:: experimental
      label
        valType
        idType
        -1 ## index
        ConstValue .None
        isInit
        fileState [] .wordStart
        state [] .currentFile
        idContext
        progContext .errors
      id.declareIdentifier if ..drop.2
        return
      end =:: idData label=
      idType .TYPE if
        isInit if
          fileState state popTypeConstant .else
            "could not pop type" ..panic
          end
          label
          typeContext types.initializeNamedType $ ? if .data else ..drop
            "re-initialization of named type" sb.copyPtr
            fileState [] .wordStart errors appendError
            return
          end
        else
          label
          typeContext types.declareNamedType
        end
        fileState [] .wordStart newTypeConst .val
      else isInit ! _if
        ConstValue .None
      else state hasConst _if
        state peekConst .data =:: info .data =:: value
          info [] .valueType valType false typeContext types.canCast ! if
            "cannot cast " sb.copyPtr
              info [] .valueType typeContext sb.appendType
              " to " sb.appendS
              valType typeContext sb.appendType
            fileState [] .wordStart errors appendError
          end
        value []
      else
        ConstValue .None
      end
        label idContext id.getIdentifier
        ! "label is identifier" assert
      .constValue=
      inConstBlock ! if ## main
        label idData .valueType NO_PROC fileState [] .wordStart state checkMain
      end
      idData .idType .TYPE if
        return
      end
      idData .idType .PROCEDURE if
        isAlias if
          fileState errors nextIdentifier =:: baseIdentifier
          baseIdentifier idContext id.findIdentifierByName if ..drop
            "cannot find identifer: " sb.copyPtr
              baseIdentifier sb.appendStr
            fileState [] .wordStart errors appendError
            return
          end =:: aliasData
          aliasData .idType [] .PROCEDURE ! if
            "expected procedure name got: " sb.copyPtr
              aliasData [] .idType sb.appendIdType
            fileState [] .wordStart errors appendError
          end
          aliasData [] .constValue .?Procedure .else
            "alias procedure does not have const value" ..panic
          end =:: mut: aliasId
          progContext [] .procedures aliasId i64 cast list.at .data
            $ .implementation [] .?alias .if aliasId= ..drop
              progContext [] .procedures aliasId i64 cast list.at .data
              $ .implementation [] .?alias ? ! "no double alias" assert
            else ..drop end
          =:: aliasProc
          valType aliasProc [] .procType typeContext types.canAlias ! if
            "incompatible signatures for procedure alias: " sb.copyPtr
              valType typeContext sb.appendType
              " cannot be renamed to " sb.appendS
              aliasProc [] .procType typeContext sb.appendType
            fileState [] .wordStart errors appendError
          end
          ## TODO? check for compatible flags (should alias static <-> non-static be allowed)
          aliasId
        else
          NO_PROC
        end =:: aliasId
        idData .constValue =:: procData
        procData .?Procedure ? ! if
          label valType state [] .currentFile aliasId fileState [] .wordStart progContext newProcData
            ConstValue .Procedure
          label idContext id.getIdentifier
            ! "procName is identifier" assert
          .constValue=
        end
      end
      inConstBlock ! if
        isInit ! if
          return ## no operation for global pre-declaration
        end
        label idContext id.getIdentifier
          ! "label is identifier" assert
        [] .constValue .?None ? ! and valType .?Undefined ? ! if
          ## don't create global operation if declaration already is complete
          state popConst ..drop.2
          return
        end
      end
      idData .valueType idData@ id.asIdInfo fileState [] .wordStart isInit if
        opInitializeId
      else
        opDeclareId
      end
      state appendOp
      return
    else $ "=::":s string.eq _if ..drop
      fileState errors nextIdentifier fileState state readLabel =:: mut: labelId
      labelId labelContext id.labelFlags id.FLAG_ALIAS & ? if
        "alias is only supported for procedure declarations" sb.copyPtr
        fileState [] .wordStart errors appendError
      end
      ## TODO? are the auto-types needed (declaration is in type-check phase where actual type is known)
      _EXPERIMENTAL_ or state [] .currentProcs .length 0:iSize != if
        progContext newAutoType
          labelId fileState [] .wordStart
        opAutoTypedInitializeName state appendOp
        return
      end
      state hasConst if
        state peekConst =:: info =:: value
        info .data [] .valueType
        $ types.isLiteral if
          typeContext types.literalToType
        end
        value .data []
      else
        progContext newAutoType
        ConstValue .None
      end =:: constValue =:: constType
      constType typeContext types.isProcedure if
        "unexpected procedure" sb.copyPtr fileState [] .wordStart errors appendError
        return
      else constType typeContext types.isType _if
        IdentifierType .TYPE
      else
        IdentifierType .GLOBAL_VAR
      end =:: idType
      ## declareIdentifier
        labelId
        constType
        idType
        -1 ## index
        ConstValue .None
        true
        fileState [] .wordStart
        state [] .currentFile
        idContext
        progContext .errors
      id.declareIdentifier if ..drop.2
        return
      end =:: idData labelId=
      ## create constant value after creating declaration
      idType .TYPE if
        constValue .TypeId =:: typeConst
        state popConst ..drop.2
        typeConst typeContext types.isProcedure if
          "declaration of a procedure type as constant\n use '=>:' to declare procedures\n" sb.copyPtr
            "for declaring a procedure type constant use a explicit type declaration ( `type =:` ) " sb.appendS
          fileState [] .wordStart errors appendWarning
        end
        ## initializeNamedType
          typeConst
          labelId
          typeContext
        types.initializeNamedType $ ? if .data else ..drop
          "re-initialization of named type" sb.copyPtr
          fileState [] .wordStart errors appendError
          return
        end ConstValue .TypeId
      else
        constValue
      end
        labelId idContext id.getIdentifier
        ! "label is identifier" assert
      .constValue=
      idData .idType .TYPE if
        return
      end
      constValue .?None ? ! and constType .?Undefined ? ! if
        ## don't create global operation if declaration already is complete
        state popConst ..drop.2
        return
      end
      idData .valueType idData@ id.asIdInfo fileState [] .wordStart opAutoTypedInitializeId state appendOp
      return
    else $ "@":s string.eq _if =:: opName
      state peekOp .else
        "unexpected \"" sb.copyPtr
          opName sb.appendStr
        '"' sb.appendC fileState [] .wordStart errors appendError
        return
      end $ [] .val .?getId .if
        $1 .val .atId=
        fileState [] .wordStart >$ .pos=
        return
      else .?getName ._if
        $1 .val .atName=
        fileState [] .wordStart >$ .pos=
        return
      else ..drop
        "unexpected operation for \"" sb.copyPtr
        opName sb.appendStr
        "\"\n" sb.appendS
        >$ [] progContext sb.appendOp
        fileState [] .wordStart errors appendError
        return
      end
    else $ .length 1:iSize u> and $ 0 string.charAt '.' == and $ 1 string.charAt '.' != _if
      1 string.tail
        $ "=":s string.endsWith =:: isWrite
        isWrite if
          $ .length 1:iSize - string.head
        end
        $ "?":s string.startsWith =:: isTryGet ## temporary syntax for new union element access
        isTryGet if
          1 string.tail
        end
      =:: label
      label 10 number.tryParseUInt .NONE if
        $ i64 cast.u i32.UMAX > if
          "element index outside allowed range: " sb.copyPtr
            $1 sb.appendI
          fileState [] .wordStart errors appendError
        end
        Type .Undefined
          >$ i32 cast.u ## index
          fileState [] .wordStart
          isWrite if
            opSetElement
          else isTryGet _if
            opGetUnionElement
          else
            opGetElement
          end
        state appendOp
      else ..drop
        label id.FLAG_NONE fileState [] .wordStart state [] .currentFile labelContext id.newLabel
        fileState [] .wordStart
          isWrite if
            opSetLabel
          else isTryGet _if
            opGetUnionLabel
          else
            opGetLabel
          end
        state appendOp
      end
      return
    else ..dup "()":s string.eq _if ..drop
      fileState [] .wordStart opCallPtr state appendOp
      return
    else ..dup "new":s string.eq _if =:: opName
      ## new in procedure -> determine type in type-check phase
      Type .Undefined fileState [] .wordStart opNew state appendOp
      return
    #+ TODO improve cast system +#
    else ..dup "cast":s string.eq or ..dup "cast!":s string.eq _if =:: opName
      opName "cast!":s string.eq =:: forceCast
      Type .Undefined
        forceCast if
          fileState [] .wordStart
          opCast!
        else
          SignType .NONE
          fileState [] .wordStart
          opCast
        end
      state appendOp
      return
    else ..dup "..bitcast":s string.eq _if =:: opName
      Type .Undefined
        fileState [] .wordStart
      opBitCast state appendOp
      return
    else ..dup "cast.s":s string.eq _if =:: opName
      Type .Undefined
        SignType .SIGNED
        fileState [] .wordStart
      opCast state appendOp
      return
    else ..dup "cast.u":s string.eq _if =:: opName
      Type .Undefined
        SignType .UNSIGNED
        fileState [] .wordStart
      opCast state appendOp
      return
    else ..dup "===":s string.eq _if ..drop
      fileState [] .wordStart opEqual state appendOp
      return
    else ..dup "=!=":s string.eq _if ..drop
      fileState [] .wordStart opNotEqual state appendOp
      return
    else ..dup "..length":s string.eq _if ..drop
      fileState [] .wordStart opLength state appendOp
      return
    else ..dup "..raw":s string.eq _if ..drop
      fileState [] .wordStart opRawValue state appendOp
      return
    else ..dup "..label":s string.eq _if ..drop
      fileState [] .wordStart opGetEnumLabel state appendOp
      return
    else ..dup "..types.alignment":s string.eq or
         ..dup "..types.size":s string.eq or
         ..dup "..types.stride":s string.eq _if =:: opName
     opName "..types.alignment":s string.eq if
       TypeMemoryInfo .ALIGNMENT
     else opName "..types.size":s string.eq _if
       TypeMemoryInfo .SIZE
     else
       TypeMemoryInfo .STRIDE
     end =:: infoType
      Type .Undefined
      infoType fileState [] .wordStart opTypeInfo state appendOp
      return
    else ..dup "..unreachable":s string.eq _if ..drop
      "reached `..unreachable` statement":s fileState [] .wordStart opPanicWithMessage state appendOp
      fileState [] .wordStart state implicitBreakSwitch
      return
    else ..dup "..panic":s string.eq _if ..drop
      fileState [] .wordStart opPanic state appendOp
      fileState [] .wordStart state implicitBreakSwitch
      return
    else ..dup "ptr":s string.eq _if ..drop
      TypeModifier .PTR fileState [] .wordStart opTypeModifier state appendOp
      return
    else ..dup "ptr.mut":s string.eq _if ..drop
      TypeModifier .PTR_MUT fileState [] .wordStart opTypeModifier state appendOp
      return
    else ..dup "array":s string.eq _if ..drop
      TypeModifier .ARRAY fileState [] .wordStart opTypeModifier state appendOp
      return
    else ..dup "ptr.raw":s string.eq _if ..drop
      TypeModifier .RAW_PTR fileState [] .wordStart opTypeModifier state appendOp
      return
    else ..dup "ptr.raw.mut":s string.eq _if ..drop
      TypeModifier .RAW_PTR_MUT fileState [] .wordStart opTypeModifier state appendOp
      return
    else ..dup "..dup":s string.eq _if =:: opName ## XXX? completely repalce ..dup by $ ?
      0 StackModType .COPY fileState [] .wordStart opStackMod state appendOp
      return
    else ..dup "..over":s string.eq or
         ..dup "..over.":s string.startsWith  _if =:: mut: opName
      opName "..over." ..length string.tail =:: params
      "..over":s opName=
      params opName fileState [] .wordStart state getCompilerOpParam ## :offset
      StackModType .COPY fileState [] .wordStart opStackMod state appendOp
      return
    else ..dup "$":s string.eq or ..dup "$0":s string.eq _if =:: opName
      0 StackModType .COPY fileState [] .wordStart opStackMod state appendOp
      return
    else $ 0 string.charAt '$' == and $ .length 1:iSize u>= and
        $ 1 string.charAt '0' >= and $ 1 string.charAt '9' <= _if =:: mut: opName
      opName 1 string.tail =:: params
      "$":s opName=
      params opName fileState [] .wordStart state getCompilerOpParam ## :offset
      StackModType .COPY fileState [] .wordStart opStackMod state appendOp
      return
    else $ "..swap":s string.eq _if =:: opName
      1 StackModType .ROTATE fileState [] .wordStart opStackMod state appendOp
      return
    else $ $ .length 1:iSize - string.charAt '$' == and $ 0 string.charAt =:: c0 c0 '>' == or c0 '<' == _if =:: opName
      opName 0 string.charAt =:: c0
      1 =:: mut: rotCount
      1 =:: mut: i
      while opName i string.charAt c0 == do
        rotCount 1 + rotCount=
      finally i 1 + i= end
      opName i string.charAt '$' != if ## TODO? allow >N$ and <N$ (? stack rotation by more than 3 elements should be painful)
        64 sb.create
          "invalid stack-rotation, expected N occurences of eigher '>' or '<' followed by '$' got '" sb.appendS
            opName sb.appendStr
            "'" sb.appendS
          fileState [] .wordStart errors appendError
        return
      end
      rotCount
        c0 '<' == if -_ end
      StackModType .ROTATE fileState [] .wordStart opStackMod state appendOp
      return
    else ..dup "..drop":s string.eq or
         ..dup "..drop.":s string.startsWith _if =:: mut: opName
      opName "..drop." ..length string.tail =:: params
      "..drop":s opName=
      params opName fileState [] .wordStart state getCompilerOpParam ## :count
      StackModType .DROP fileState [] .wordStart opStackMod state appendOp
      return
    else $ "import":s string.eq _if =:: opName
      fileState nextToken ## XXX? distinquish string types
      .?String .if .value ## local file
        ## TODO? allow ignoring name of current folder (search base-path, then current folder)
        state [] .basePath .length $1 .length + sb.create
          state [] .basePath sb.appendStr
          >$ sb.appendStr
          state [] .inLibFile
        fileState [] .wordStart state importFile
        return
      else .?Identifier ._if ## library file
        fileState [] .wordStart state importLibraryFile return
      end
      64 sb.create
        "invalid parameter for " sb.appendS
        opName sb.appendStr
        ':' sb.appendC
        >$ sb.appendToken
        " expected identifier or string" sb.appendS
      fileState [] .wordStart errors appendError
      return
    else $ "using":s string.eq or $ "using:":s string.eq _if =:: opName
      opName "using:":s string.eq =:: isAlias
      isAlias if
        fileState errors nextIdentifier
      else string.empty end =:: aliasName
      fileState errors nextIdentifier
        $ ".":s string.endsWith =:: importNamespace
        importNamespace if
          $ .length 1:iSize - string.head
        end
      =:: usedName
      importNamespace if
        usedName id.FLAG_NONE
          fileState [] .wordStart state [] .currentFile
        labelContext id.newLabel =:: namespaceLabel
        state [] .currentProcs .length 0:iSize != if
          aliasName .length 0:iSize != if
            aliasName id.FLAG_NONE
              fileState [] .wordStart state [] .currentFile
            labelContext id.newLabel
          else id.LABEL_ID_NONE end =:: aliasLabel
          namespaceLabel aliasLabel fileState [] .wordStart opUsingNamespace state appendOp
          return
        end
        ## copy to ensure string stays alive
        aliasName labelContext id.copyString =:: newName
        namespaceLabel newName idContext id.importNamespace if
          "namespace \"" sb.copyPtr
            usedName sb.appendStr
          "\" does not exist in the current scope" sb.appendS fileState [] .wordStart errors appendWarning
        end
        return
      end
      state [] .currentProcs .length 0:iSize != if
        usedName id.FLAG_NONE
          fileState [] .wordStart state [] .currentFile
        labelContext id.newLabel =:: usedLabel
        aliasName .length 0:iSize != if
          aliasName id.FLAG_NONE
            fileState [] .wordStart state [] .currentFile
          labelContext id.newLabel
        else id.LABEL_ID_NONE end =:: aliasLabel
        usedLabel aliasLabel fileState [] .wordStart opUsingIdentifier state appendOp
        return
      end
      usedName
        aliasName
        idContext
        fileState [] .wordStart
      errors id.importIdentifier ..drop
      return
    else $ "assert":s string.eq _if =:: opName
      ## opAssert
        fileState [] .wordStart
      opAssert state appendOp
      return
    else $ "..compiler.error":s string.eq
        or $ "..compiler.warning":s string.eq
        or $ "..compiler.info":s string.eq _if =:: opName
      ## create error/warning/info if operation is reachable
      opName "..compiler.error":s string.eq if
        ErrorType .ERROR
      else opName "..compiler.warning":s string.eq _if
        ErrorType .WARNING
      else opName "..compiler.info":s string.eq _if
        ErrorType .INFO
      else
        "unexpected error type: " sb.copyPtr
          opName sb.appendStr
        fileState [] .wordStart errors appendError
        ErrorType .ERROR
      end =:: errorType
      ## opError
        errorType
        fileState [] .wordStart
      opError state appendOp
      return
    else $ "..compiler.flag.":s string.startsWith _if
      "..compiler.flag." ..length string.tail =:: flagName
      ## XXX? treat compiler constants as variables, allow :? operator to check if constant exists
      flagName "experimental":s string.eq if
        _EXPERIMENTAL_ ConstValue .Bool
        types.primitive.BOOL
      else flagName "foldConstants":s string.eq _if
        _FOLD_CONSTANTS_ ConstValue .Bool
        types.primitive.BOOL
      else flagName "noCore":s string.eq _if
        _INCLUDE_CORE_ ! ConstValue .Bool
        types.primitive.BOOL
      else flagName "wError":s string.eq _if
        _W_ERROR_ ConstValue .Bool
        types.primitive.BOOL
      else flagName "incrementVersionNumber":s string.eq _if
        _INCREMENT_VERSION_ ConstValue .Bool
        types.primitive.BOOL
      else
        ConstValue .None
        Type .Empty
      end
      fileState [] .wordStart opStaticConst state appendOp
      return
    else $ "..compiler.version":s string.eq _if ..drop
      _VERSION_ ConstValue .Int
      types.primitive.I64
      fileState [] .wordStart opStaticConst state appendOp
      return
    else $ "..compiler.return":s string.eq _if ..drop
      ..drop ## discard remainder of file
      ## close open if-blocks/switch-branches
      while state [] .openBlocks list.peek =:: next?
          BlockType ..length 42:iSize == "no new block types" assert
          next? optional.hasData and next? .data [] .blockData switch
            If Switch case true break
            default false break
          end do
        state [] .openBlocks
          list.pop ..drop
        state .openBlocks=
      end
      string.empty return
    else $ "..file":s string.eq _if ..drop
      fileState [] .wordStart .fileName =:: name
      name constContext newStringConst
      types.primitive.CHAR8
        types.ArrayType .POINTER
        name .length i64 cast.u types.ArraySize .Int =:: size
        size
      typeContext types.newArrayType .data
      fileState [] .wordStart opConst state appendOp
      return
    else $ "..line":s string.eq _if ..drop
      fileState [] .wordStart .line i64 cast.u ConstValue .Int
      types.primitive.I64
      fileState [] .wordStart opConst state appendOp
      return
    else ..dup "..?types":s string.eq or
        ..dup "..?types.":s string.startsWith _if =:: mut: opName
      opName "..?types." ..length string.tail =:: params
      "..?types":s opName=
      -1 =:: mut: count
      0 =:: mut: depth
      params .length 0:iSize != if
        params '.' string.split =:: head =:: tail
        head .length 0:iSize != if
          head
            opName
            fileState [] .wordStart
          state getCompilerOpParam count=
        end
        tail .length 0:iSize != if
          tail
            opName
            fileState [] .wordStart
          state getCompilerOpParam depth=
        end
      end
      ## opTypesInfo
        count
        depth
        fileState [] .wordStart
      opTypesInfo state appendOp
      return
    else ..dup "..?stack":s string.eq or
        ..dup "..?stack.":s string.startsWith _if =:: mut: opName
      opName "..?stack." ..length string.tail =:: params
      "..?stack":s opName=
      params .length 0:iSize != if
        params opName fileState [] .wordStart state getCompilerOpParam
      else -1 end
      fileState [] .wordStart opStackInfo state appendOp
      return
    else ..dup "..?ops":s string.eq or
        ..dup "..?ops.":s string.startsWith _if =:: mut: opName
      opName "..?ops." ..length string.tail =:: params
      "..?ops":s opName=
      params .length 0:iSize != if
        params opName fileState [] .wordStart state getCompilerOpParam
      else -1 end
      fileState [] .wordStart opPrintCompiledOps state appendOp
      return
    ## XXX ..?parser.ops
    else ..dup "..?find.":s string.startsWith _if =:: mut: opName
      opName "..?find." ..length string.tail =:: idName
      ## opPrintIdentifierMatches
        idName
          id.FLAG_NONE
          fileState [] .wordStart
          state [] .currentFile
        labelContext id.newLabel
        fileState [] .wordStart
      opPrintIdentifierMatches state appendOp
      return
    else ..dup "..?parser.find.":s string.startsWith _if =:: mut: opName
        opName "..?parser.find." ..length string.tail =:: idName
        16 id.IdentifierMatch list.create =:: mut: matches
        idName true idContext matches@ optional.wrap id.searchIdentifier ..drop.3
        "-----------------\n" sb.copyPtr
          "identifier \"" sb.appendS idName sb.appendStr "\":\n" sb.appendS
          0:iSize while $ matches .length u< do =:: i
            matches i list.at .data =:: match
            match [] .nameData .labelId =:: labelId
            match [] .nameData .aliasId =:: aliasId
            labelId idContext id.getIdentifier
              ! "matched identifier exists" assert
            =:: idData
            " - " sb.appendS
            aliasId id.NO_ALIAS != if
              "alias (declared at " sb.appendS
              aliasId idContext id.getAliasPos sb.appendPos
              ")  to " sb.appendS
            end
            idData id.asIdInfo labelContext sb.appendIdInfo
            " ( " sb.appendS
            idData [] .valueType typeContext sb.appendType
            idData [] .constValue .?None ? ! if
              " [ " sb.appendS
              idData [] .constValue typeContext sb.appendConstant
              " ]" sb.appendS
            end
            " ) declared at " sb.appendS
            labelId labelContext id.labelPos =:: pos?
            pos? optional.hasData if
              pos? .data sb.appendPos
            else
              "?" sb.appendS
            end
            '\n' sb.appendC
            i 1:iSize +
          end ..drop
          "-----------------\n" sb.appendS
          io.stdOut ..over io.fputSb ..drop
        sb.free ..drop
        matches list.free ..drop
        return
    else ..dup "begin":s string.eq or
         ..dup "defer":s string.eq _if =:: opName
      "`" sb.copyPtr
        opName sb.appendStr
        "` is a reserved keyword for a future language version" sb.appendS
      fileState [] .wordStart errors appendError
      return
    end
    $ "@":s string.endsWith =:: isAddr
    $ .length 1:iSize u> and $ "=":s string.endsWith and ## exclude = and ids ending with: == != >= <=
      "=<>!":s $1 $ .length 2:iSize - string.charAt string.contains !
    end =:: isSetter
    isAddr or isSetter if
      $ .length 1:iSize - string.head
    end
  =:: idName
  state [] .currentProcs .length 0:iSize == if
    idName idContext id.findIdentifierByName ! if ## try parsing as identifier
      ## $ [] .labelId labelContext id.labelFlags =:: flags
      ## XXX? detect setters
      ..dup [] .valueType ..swap id.asIdInfo fileState [] .wordStart
        isAddr if
          opAtId
        else isSetter _if
          opSetId
        else
          opGetId
        end
      state appendOp
      return
    end ..drop
  end
  idName
    id.FLAG_NONE fileState [] .wordStart state [] .currentFile
  labelContext id.newLabel =:: labelId
  labelId fileState [] .wordStart
  isAddr if
    opAtName
  else isSetter _if
    opSetName
  else
    opGetName
  end
  state appendOp
  return
end
proc( FileId : includedId io.IOError : err FilePosition : pos ParserState ptr.mut : state -> FileId ) =>: checkIOError
  using io.
  err FILE_ERROR_NONE == if
    includedId return ## exit early on normal path
  end
  state [] .progContext =:: progContext
  progContext .errors =:: errors
  progContext [] .progFiles includedId i64 cast list.at .data [] .fileName sb.asStr =:: fileName
  err switch
    FILE_ERROR_NONE case ..unreachable ## already handled this case
    FILE_ERR_PATH_OVERFLOW FILE_ERR_OPEN_MODE FILE_ERR_FILE_NOT_FOUND FILE_ERR_FILE_IS_DIR FILE_ERR_ACCESS_DENIED FILE_ERR_INVALID_FILE case
      "cannot include file \"" sb.copyPtr fileName sb.appendStr '"' sb.appendC pos errors appendError
      FILE_ID_NONE return
    default
      "error while reading file \"" sb.copyPtr fileName sb.appendStr '"' sb.appendC pos errors appendError
      FILE_ID_NONE return
  end
end

proc( string FilePosition : pos ParserState ptr.mut : state -> ) =>: importLibraryFile
  state [] .libPath .length $1 .length + ".concat" ..length + sb.create
    state [] .libPath sb.appendStr
    ..swap sb.appendStr ".concat" sb.appendS
    true
  pos state importFile
end
proc(
  stringBuilder : fileName
  bool : isLibImport
  FilePosition : pos
  ParserState ptr.mut : state
-> ) =>: importFile
  state [] .progContext =:: progContext
  FILE_ID_NONE =:: mut: imported
  0:iSize while $ progContext [] .progFiles .length u< do
    progContext [] .progFiles $1 [] .fileName sb.asStr fileName sb.asStr string.eq if
      $ FileId cast imported=
      break
    end
    1:iSize +
  end ..drop
  imported FILE_ID_NONE == if ## file has not yet been imported
    fileName isLibImport state parseFile pos state checkIOError imported=
    imported FILE_ID_NONE == if
      return
    end
  end
  ## TODO correctly resolve sub-imports for cyclic imports
  imported
    progContext [] .progFiles imported i64 cast list.at .data [] .fileScope
  progContext .idContext id.importFile
end

## procedures needed from type-checker
proc( ProgramContext ptr.mut : program -> TypeCheckState ) : export: newTypeCheckState
proc(
  ProgramContext ptr.mut : program
  TypeCheckState ptr.mut : state
->  ) : export: updateTypeCheckerPointers
proc(
  stringBuilder : rootFile
  string : libPath
  string : basePath
  bool : saveGlobalTokens
-> ProgramContext TypeCheckState ) =>: export: parseProgram
  newProgramContext =:: mut: programContext
  ## FilePosition
    rootFile sb.asStr
    0:FileId
    0
    0
  FilePosition new =:: rootPos
  ## initBuiltInConstants
    rootPos
    programContext@
  initBuiltInConstants
  ## initBuiltInProcs
    rootPos
    programContext@
  initBuiltInProcs if
    ## TODO handle error
  end
  programContext@ newTypeCheckState =:: mut: typeChecker
  programContext@ typeChecker@ updateTypeCheckerPointers
  ## ParserState
    basePath
    libPath
    programContext@
    typeChecker@
    64  BlockInfo               list.create
    128 Operation               list.create
    0:i32
    0:i32
    128 Type                    list.create
    FILE_ID_NONE
    32  ProcId                  list.create
    0   InterpreterInfo         list.create
    128 LabelId                 list.create
    128 sb.create
    false
    saveGlobalTokens
  ParserState new =:: mut: state
  rootFile false state@ parseFile rootPos state@ checkIOError ..drop
  ## cleanup parser memory
  state .typeBuffer list.free ..drop
  0:iSize while $ state .globalInterpreters .length u< do
    state .globalInterpreters
      ..over list.at .data .context
    interpreter.cleanupContext
    1:iSize +
  end ..drop
  state .globalInterpreters list.free ..drop
  state .tmpString sb.free ..drop
  programContext typeChecker return
end
## TODO why is a pre-declaration neccessary here
proc( Operation slice : ops TypeCheckState ptr.mut : state -> ) : export: typeCheckGlobalCode
proc(
  stringBuilder : fileName
  bool : isLibFile
  ParserState ptr.mut : state
-> FileId io.IOError ) =>: parseFile
  fileName
    state [] .progContext =:: progContext
    progContext .tmpOps [] .length =:: codeOffset
    progContext .idContext =:: idContext
    idContext .typeContext .labelContext =:: labelContext
    progContext .errors =:: errors
    ..dup ..over .length 1:iSize - sb.charAt '\x00' != if
      '\x00' sb.appendC ## ensure file-name is zero terminated
    end
    ..dup .length 1:iSize - sb.setLength ## do not include zero terminator in length
    progContext [] .progFiles .length FileId cast =:: fileId
    ..dup sb.asStr fileId 0 1 FilePosition new ..dup FileState new =:: mut: fileState
    progContext [] .progFiles
      ..over fileId newProgFile list.append
    progContext .progFiles=
    ## TODO? use same interpreter for all files
    state [] .globalInterpreters
      ## InterpreterInfo
        progContext
          state [] .typeChecker optional.wrap
          fileId
          interpreter.InterpreterType .GLOBAL
        interpreter.wrapProgram
        0
      InterpreterInfo new list.append
    state .globalInterpreters=
  state [] .currentFile =:: prevFile
  state [] .inLibFile =:: wasLibFile
  isLibFile state .inLibFile=
  fileId state .currentFile=
  $ .data >$ .length 1:iSize + #+include zero-terminator after file-name+# io.OPEN_READ io.fopen
    $ io.FILE_ERROR_NONE != if =:: openError
      ..drop ## discard code file
      prevFile state .currentFile= ## reset file id
      wasLibFile state .inLibFile=
      isLibFile state .inLibFile=
      fileId openError return
    end ..drop =:: f
    128 sb.create
      '\n' sb.appendC
      f sb.appendFile =:: readError
      '\n' sb.appendC
    =:: fileBody
  f io.fclose $ io.FILE_ERROR_NONE != or readError io.FILE_ERROR_NONE != if =:: closeError
      prevFile state .currentFile= ## reset file id
      wasLibFile state .inLibFile=
      readError io.FILE_ERROR_NONE != if
        fileId readError return
      else
        fileId closeError return
      end
  end ..drop
  state [] .openBlocks .length =:: blockCount
  labelContext id.currentNamespace =:: prevNamespace
  labelContext id.clearNamespace
  idContext id.currentScope =:: prevScope
  idContext id.clearScope
  _INCLUDE_CORE_ if
    false _INCLUDE_CORE_= ## don't include core in core
    "core":s fileState .currentPos state importLibraryFile
    true _INCLUDE_CORE_=
  end
  idContext id.openScope
  fileId id.NO_SCOPE idContext id.importFile ## import file in its own scope
  idContext id.currentScope progContext [] .progFiles fileId i64 cast list.at .data .fileScope=
  fileState@
    fileBody sb.asStr while
      $1 nextToken $2 state parseOperation
      $ .length 0:iSize !=
    do end ..drop
  ..drop
  fileBody sb.free ..drop
  progContext [] .tmpOps list.asSlice codeOffset slice.tail state [] .typeChecker typeCheckGlobalCode
  idContext id.closeScope ! "file scope closed correctly" assert
  prevScope idContext id.setScope
  prevNamespace labelContext id.resetNamespace
  state [] .currentFile =:: newFileId
  fileId newFileId == "fileId did not change" assert
  prevFile state .currentFile=
  wasLibFile state .inLibFile=
  state [] .openBlocks .length blockCount u> if
    ## XXX? print start of last block
    "unclosed block at end of file" sb.copyPtr
      fileState .currentPos
    errors appendError
  else state [] .openBlocks .length blockCount u< _if
    "file closed additional code block" sb.copyPtr
      fileState .currentPos
    errors appendError
  end
  progContext [] .tmpOps
    codeOffset list.setLength
  progContext .tmpOps=
  newFileId io.FILE_ERROR_NONE return
end
