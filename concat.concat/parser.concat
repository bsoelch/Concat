struct( Type : valueType ConstValue : val IdentifierInfo optional : idInfo FilePosition : pos ) =:: Constant
struct( Type : argType ConstValue : val LabelId : labelId ) =:: StaticArgument
struct( i64 : codeOffset i64 : constOffset ) =:: InitializerOffset
struct(
  string : mut basePath
  string : mut libPath
  IdentifierContext : mut idContext
  Constant list : mut constants
  i64 : mut constOffset
  Type list : mut typeBuffer
  StaticArgument list : mut staticArgs
  i64 : mut staticArgsOffset
  ProgramFile list : mut progFiles
  FileId : mut currentFile
  Operation list : mut templateOps
  InitializerOffset list : mut openInitializers
  LabelId list : mut labelBuffer
  CompilerError list : mut errors
  i32 : mut autoTypeCount
  bool : mut hasEntryPoint
) =:: ParserState

proc( FilePosition : pos => Constant ) =: newWildcardConst
  Type .undefined ConstValue .wildCard new IdentifierInfo optional.empty pos Constant new return
end
proc( bool FilePosition => Constant ) =: newBoolConstant
  =:: pos
  types.primitive.BOOL #swap ConstValue .boolean new IdentifierInfo optional.empty pos Constant new return
end
proc( i64 : value bool : unsigned i32 : preferedSize FilePosition : pos ParserState ptr mut : state => bool ) =: checkIntSize
  preferedSize 0 <= if
    false return
  end
  preferedSize types.MAX_INT_WIDTH >= if
    false return
  end
  unsigned if
    value 0 < if
      true return
    end
    preferedSize types.MAX_INT_WIDTH 1 - == if
      false return ## positive number fits in unsigned number of one smaller size
    end
  else
    value 1 i64 cast preferedSize << -_ < if
      true return
    end
  end
  value 1 i64 cast unsigned if preferedSize 1 + else preferedSize end << >= return
end
proc( i64 : value bool : unsigned i32 : preferedSize FilePosition : pos ParserState ptr mut : state => Constant ) =: newIntConstant
   ## TODO? sign extend unsigned constants of smaller types
  preferedSize 0 <= if
   unsigned if
     value 0 < value u32.MAX > | if types.primitive.I64 else types.primitive.I32 end
   else
     value i32.MIN < value i32.MAX > | if types.primitive.I64 else types.primitive.I32 end
   end
  else preferedSize 8 <= _if types.primitive.I8
  else preferedSize 16 <= _if types.primitive.I16
  else preferedSize 32 <= _if types.primitive.I32
  else types.primitive.I64 end
  value unsigned preferedSize pos state checkIntSize if
    "integer value overflows given size: " sb.wrap
      value unsigned if sb.appendU else sb.appendI end
      unsigned if 'u' else 'i' end sb.appendC
      preferedSize sb.appendU
    pos state [] .errors @ appendWarning
  end
  value ConstValue .int new IdentifierInfo optional.empty pos Constant new return
end
proc( i8 FilePosition => Constant ) =: newCharConstant
  =:: pos
  types.primitive.I8 #swap ConstValue .chr new IdentifierInfo optional.empty pos Constant new return
end
proc( StringConstant : str FilePosition : pos TypeContext ptr mut : context => Constant ) =: newStringConstant
  #using types
  str .length ArraySizeType .int ArraySize new =:: size
  types.primitive.I8 true size @ 1 array.create true false context newArrayType #drop str ConstValue .str new IdentifierInfo optional.empty pos Constant new return
end
proc( Type FilePosition => Constant ) =: newTypeConst
  =:: pos
  types.primitive.TYPE #swap ConstValue .typeId new IdentifierInfo optional.empty pos Constant new return
end
proc( Type i32 FilePosition => Constant ) =: newEnumLabelConstant
  =:: pos
  ConstValue .enumLabel new IdentifierInfo optional.empty pos Constant new return
end
proc( double FilePosition => Constant ) =: newFloatConst
  =:: pos
  types.primitive.FLOAT64 #swap ConstValue .Float new IdentifierInfo optional.empty pos Constant new return
end

proc( Constant : const => Operation ) =: constantToOp
  const .val const .valueType const .pos opConst return
end

proc( ParserState ptr mut : state => i64 ) =: opCount
  state [] .idContext .currentTemplate id.TEMPLATE_ID_NONE != if
    state [] .templateOps .length return
  end
  state [] .idContext @ id.isGlobal if
    state [] .progFiles state [] .currentFile list.at .data [] .globalOps .length return
  end
  state [] .progFiles state [] .currentFile list.at .data [] .localOps .length return
end
proc( Operation : op ParserState ptr mut : state => ) =: appendOp
  state [] .idContext .currentTemplate id.TEMPLATE_ID_NONE != if
    state [] .templateOps @
  else state [] .idContext @ id.isGlobal _if
    state [] .progFiles state [] .currentFile list.at .data [] .globalOps @
  else
    state [] .progFiles state [] .currentFile list.at .data [] .localOps @
  end
  #dup []
    0 while #dup state [] .constants .length < do
      #swap
        state [] .constants #over:2 list.get constantToOp list.append
      #swap
      1 +
    end #drop
    state [] .constants list.clear state [] .constants =
    op list.append
  #swap [] =
end
proc( stringBuilder : msg FilePosition : pos ParserState ptr mut : state => ) =: appendError2
  msg pos state [] .errors @ appendError
end
proc( ParserState ptr mut : state => Operation ptr mut optional ) =: peekOp
  state [] .idContext .currentTemplate id.TEMPLATE_ID_NONE != if
    state [] .templateOps
  else state [] .idContext @ id.isGlobal _if
    state [] .progFiles state [] .currentFile list.get .globalOps
  else
    state [] .progFiles state [] .currentFile list.get .localOps
  end list.peek
end

proc( Constant : const ParserState ptr mut : state => ) =: pushConst
  state [] .constants const list.append state [] .constants  =
end
proc( ParserState ptr mut : state => bool ) =: hasConst
  state [] .constants .length 0 > return
end

proc( ParserState ptr mut : state => Constant ) =: popConst
  state [] .constants
    list.pop #swap state [] .constants =
  return
end
proc( ParserState ptr mut : state => Constant ptr mut optional ) =: peekConst
  state [] .constants list.peek return
end
proc( FileState ptr mut : fileState ParserState ptr mut : state => Type bool ) =: peekTypeConstant
  state [] .constants .length state [] .constOffset <= if ## XXX more descriptive messages
    "missing type constant" sb.wrap fileState [] .wordStart state appendError2
     Type .undefined true return
  end
  state [] .constants list.peek .data [] .val ConstValue .typeId != if
    "wrong type for constant expected type" sb.wrap state [] .constants list.peek .data [] .pos state appendError2
    Type .undefined true return
  end
  state [] .constants list.peek .data [] .val .typeId false return
end
proc( FileState ptr mut : fileState ParserState ptr mut : state => Type bool ) =: popTypeConstant
  state [] .constants .length state [] .constOffset <= if
    "missing type constant" sb.wrap fileState [] .wordStart state appendError2
     Type .undefined true return
  end
  state [] .constants list.peek .data [] .val ConstValue .typeId != if
    "wrong type for constant expected type" sb.wrap state [] .constants list.peek .data [] .pos state appendError2
    Type .undefined true return
  end
  state [] .constants list.pop #swap state [] .constants =
    .val .typeId false return
end
proc( FileState ptr mut : fileState ParserState ptr mut : state => types.ArraySize arrayView bool #+fixed-size+# ) =: popArraySize
  state [] .constants .length state [] .constOffset <= if
    types.ArraySize array.empty true return
  end
  state [] .constants list.peek .data [] .val ConstValue .wildCard == if
    state [] .constants list.pop #drop state [] .constants = ## remove wildcard constant
    types.ArraySize array.empty false return
  end
  state [] .constants .length 1 - while #dup state [] .constOffset >= do
    state [] .constants #over list.get .valueType state [] .idContext .typeContext @ types.isInt ! if
      break
    end
    1 -
  end
  1 + ##revert last decrement
  #dup
  state [] .idContext .arraySizeBuffer
    list.clear
    #over state [] .constOffset - list.ensureCap
    #swap while #dup state [] .constants .length < do
      #swap
        state [] .constants #over:2 list.get .val
          #dup ConstValue .int == if
            .int types.ArraySizeType .int types.ArraySize new list.append
          else #dup ConstValue .genericArg == _if
            .genericArg types.ArraySizeType .staticArg types.ArraySize new list.append
          else #dup ConstValue .templateArg == _if
            .templateArg types.ArraySizeType .templateArg types.ArraySize new list.append
          else
            "unexpected constant for array size: " sb.wrap
              #swap state [] .idContext .constContext @ state [] .idContext .labelContext @ state [] .idContext .typeContext @ sb.appendConstant
            state [] .constants #over:4 list.get .pos state appendError2
          end
      #swap
      1 +
    end #drop
  state [] .idContext .arraySizeBuffer =
  state [] .constants .length =
  state [] .idContext .arraySizeBuffer list.asArray true return
end
proc( i64 : n FileState ptr mut : fileState ParserState ptr mut : state => Type arrayView bool ) =: popTypeConstants
  state [] .constants .length state [] .constOffset n + < if
    "missing type constant" sb.wrap fileState [] .wordStart state appendError2
     Type array.empty true return
  end
  state [] .typeBuffer list.clear state [] .typeBuffer =
  state [] .constants .length n -
    #dup while #dup state [] .constants .length < do
      state [] .constants #over list.get .val ConstValue .typeId != if #drop:2
        "wrong type for constant, expected type" sb.wrap state [] .constants list.peek .data [] .pos state appendError2
         Type array.empty true return
      end
      state [] .typeBuffer state [] .constants #over:2 list.get .val .typeId list.append state [] .typeBuffer =
      1 +
    end #drop
  state [] .constants .length =
  state [] .typeBuffer list.asArray false return
end
proc( Type : argTypes FileState ptr mut : fileState ParserState ptr mut : state => ConstantArray bool ) =: popTemplateArguments
  argTypes state [] .idContext .typeContext @ types.compositeEltCount =:: count
  count state [] .constants .length > if
    "not enough arguments for template" sb.wrap fileState [] .wordStart state appendError2
     0 0 ConstantArray new true return
  end
  state [] .idContext .templateArgBuffer .length =:: offset
  state [] .constants .length count - state [] .constants .length =
  0 while #dup count < do
    state [] .constants .data #over state [] .constants .length + []
      #dup .valueType argTypes #over:3 state [] .idContext .typeContext @ types.compositeGetElement types.typeEquals ! if
        "incompatible type for template argument" sb.wrap fileState [] .wordStart state appendError2 ## XXX print types in error message
        #drop:2 0 0 ConstantArray new true return
      end
    state [] .idContext .templateArgBuffer
      #swap .val list.append
    state [] .idContext .templateArgBuffer =
    1 +
  end #drop
  offset state [] .idContext .templateArgBuffer .length offset - ConstantArray new false return
end
proc( i64 : len FileState ptr mut : fileState ParserState ptr mut : state => Type arrayView ConstValue arrayView Type ) =: popConstantArray
  state [] .constants .length state [] .constOffset len + < if ## XXX compare size with expected size
    "no enough constants for array" sb.wrap fileState [] .wordStart state appendError2
     Type array.empty ConstValue array.empty Type .undefined return
  end
  Type .undefined =:: mut arrayType
  true =:: mut hasArrayType
  state [] .typeBuffer list.clear state [] .typeBuffer =
  state [] .idContext .templateArgBuffer .length =:: offset
  state [] .constants .length len -
    #dup while #dup state [] .constants .length < do
      state [] .constants #over list.at .data =:: const
      state [] .idContext .templateArgBuffer
        const [] .val list.append
      state [] .idContext .templateArgBuffer =
      state [] .typeBuffer const [] .valueType list.append state [] .typeBuffer =
      hasArrayType if
        arrayType Type .undefined types.typeEquals if
         const [] .valueType arrayType =
        else arrayType const [] .valueType types.typeEquals ! _if
          false hasArrayType =
        end
      end
      1 +
    end #drop
  state [] .constants .length =
  offset state [] .idContext .templateArgBuffer .length =
  ## return
    state [] .typeBuffer list.asArray
    state [] .idContext .templateArgBuffer .data offset + len array.create
    hasArrayType if arrayType else Type .undefined end
  return
end
proc( LabelId : label Type : valType i64 : index ParserState ptr mut : state => ) =: newStaticArg
  state [] .staticArgs
    valType
      #dup types.primitive.TYPE types.typeEquals if
        index i32 cast types.newGenericType ConstValue .typeId new
      else
        index i32 cast ConstValue .genericArg new
      end
    label
    StaticArgument new
  list.append state [] .staticArgs =
end
proc( string : name ParserState ptr mut : state => StaticArgument optional ) =: getStaticArg
  0 while #dup state [] .staticArgs .length < do
    state [] .staticArgs #over list.get
      #dup .labelId state [] .idContext .labelContext @ id.labelName #dup optional.hasData if .data name string.eq else #drop false end if
        #swap #drop optional.wrap return
      end
    #drop
    1 +
  end #drop
  StaticArgument optional.empty return
end

proc( ParserState ptr mut : state => i64 ) =: offsetConstants
  state [] .constOffset
    state [] .constants .length state [] .constOffset =
  return
end
proc( i64 ParserState ptr mut => ) =: resetConstants
  [] .constOffset =
end
proc( ParserState ptr mut : state => i64 ) =: offsetStaticArgs
  state [] .staticArgsOffset
    state [] .staticArgs .length state [] .staticArgsOffset =
  return
end
proc( i64 ParserState ptr mut =>  ) =: resetStaticArgs
  =:: state
  #dup
    state [] .staticArgsOffset =
  state [] .staticArgs .length =
end

proc( string : code FileState ptr mut : fileState  ParserState ptr mut : state => string string ) =: nextWord
  code
    fileState nextToken
    #dup Token .IDENTIFER != if
      "expected identifier" sb.wrap fileState [] .wordStart state appendError2
    end
    .IDENTIFER
  return
end
proc( string : code string : start FileState ptr mut : fileState  ParserState ptr mut : state LabelFlag : initFlags => string LabelId ) =: readLabelAddFlags
  0 LabelFlag =: mut flags
  false =:: mut isModifer
  code start
    while
      false isModifer =
      #dup "mut" string.wrap string.eq if
        id.FLAG_MUTABLE flags | flags =
        true isModifer =
      else #dup "static" string.wrap string.eq _if
        id.FLAG_STATIC flags | flags =
        true isModifer =
      else #dup "extern" string.wrap string.eq _if
        id.FLAG_EXTERN flags | flags =
        true isModifer =
      else #dup "public" string.wrap string.eq _if
        id.FLAG_PUBLIC flags | flags =
        true isModifer =
      else #dup "private" string.wrap string.eq _if
        id.FLAG_PRIVATE flags | flags =
        true isModifer =
      else #dup "#:" string.wrap string.startsWith _if
        true isModifer =
      end
      isModifer ! if
        break
      end
    isModifer do #drop
      fileState nextToken
      #dup Token .IDENTIFER != if #drop
        "expected identifier" sb.wrap state [] .constants list.peek .data [] .pos state appendError2
        "" string.wrap
      else
        .IDENTIFER
      end
    end
  flags initFlags | fileState [] .wordStart state [] .currentFile state [] .idContext .labelContext addrOf id.newLabel return
end
proc( string : code string : start FileState ptr mut : fileState  ParserState ptr mut : state => string LabelId ) =: readLabel
  code start fileState state 0 readLabelAddFlags
end
enum( NONE STRUCT ENUM PROC_IN ) =:: LabelType
proc( string : code LabelType : labelType string : endString string : nextEnd FileState ptr mut : fileState  ParserState ptr mut : state => string LabelId arrayView optional Type arrayView bool ) =: readCompositeType
  state offsetConstants =:: prevConstants
  state [] .constants .length =:: constOffset
  state [] .labelBuffer .length =:: labelOffset
  code
    while fileState nextToken
      fileState state tryParseConstant if #drop
        #dup .length 0 > if continue else break end
      end
      #dup endString string.eq if #drop
        labelType LabelType .NONE == if
          LabelId arrayView optional.empty
        else labelType LabelType .PROC_IN == state [] .labelBuffer .length labelOffset == & _if
          LabelId arrayView optional.empty ## procedure with no labels
        else
          state [] .constants .length constOffset -
          state [] .labelBuffer .length labelOffset - - #dup 0 > if
            "too many types for label" sb.wrap fileState [] .wordStart state appendError2
            while #dup 0 > do
              "" string.wrap id.FLAG_EMPTY fileState [] .wordStart state [] .currentFile state [] .idContext .labelContext @ id.newLabel
                state [] .labelBuffer #swap list.append
              state [] .labelBuffer =
              1 -
            end
          else #dup 0 < _if
            "not enough types for label" sb.wrap fileState [] .wordStart state appendError2
            while #dup 0 < do
              Type .undefined fileState [] .wordStart newTypeConst  state pushConst
              1 +
            end
          end #drop
          state [] .labelBuffer list.asArray labelOffset array.tail optional.wrap
        end
        prevConstants state resetConstants
        labelOffset state [] .labelBuffer .length =
        state [] .constants .length constOffset - fileState state popTypeConstants return
      else #dup nextEnd string.eq _if #drop ## XXX? allow procedures without arrow
        "unexpected \"" sb.wrap nextEnd sb.appendStr '"' sb.appendC fileState [] .wordStart state appendError2
        prevConstants state resetConstants
        labelOffset state [] .labelBuffer .length =
        LabelId arrayView optional.empty Type array.empty true return
      else #dup ":" string.wrap string.eq _if #drop
        labelType LabelType .NONE == if
          "unexpected ':' operator" sb.wrap fileState [] .wordStart state appendError2
        end
        state [] .constants .length constOffset - 1 -
        state [] .labelBuffer .length labelOffset - - #dup 0 > if
          "too many types for label" sb.wrap fileState [] .wordStart state appendError2
          while #dup 0 > do
            "" string.wrap id.FLAG_EMPTY fileState [] .wordStart state [] .currentFile state [] .idContext .labelContext @ id.newLabel
              state [] .labelBuffer #swap list.append
            state [] .labelBuffer =
            1 -
          end
        else #dup 0 < _if
          "not enough types for label" sb.wrap fileState [] .wordStart state appendError2
          while #dup 0 < do
            Type .undefined fileState [] .wordStart newTypeConst  state pushConst
            1 +
          end
        end #drop
        fileState nextToken
        #dup Token .IDENTIFER != if
          "expected identifier" sb.wrap fileState [] .wordStart state appendError2
        end
        .IDENTIFER
        fileState state readLabel
          state [] .labelBuffer #over list.append state [] .labelBuffer =
          #dup state [] .idContext .labelContext @ id.labelFlags  id.FLAG_STATIC & 0 != if
            labelType LabelType .PROC_IN != if
              "unexpected static label" sb.wrap fileState [] .wordStart state appendError2
            end
            fileState state peekTypeConstant if
              "missing type for static label" sb.wrap fileState [] .wordStart state appendError2
            end
           state [] .constants .length constOffset - 1 - state newStaticArg
          else #drop end
        continue
      end
      labelType LabelType .ENUM != if
        64 sb.create
          "unknown type name " sb.appendS
          #over sb.appendStr
        fileState [] .wordStart state appendError2
        #drop
        Type .undefined fileState [] .wordStart newTypeConst  state pushConst
        continue
      end
        state [] .constants .length constOffset -
        state [] .labelBuffer .length labelOffset - - #dup 0 > if
          "unexpected label in enum, expected ':' " sb.wrap fileState [] .wordStart state appendError2
          while #dup 1 > do
            "" string.wrap id.FLAG_EMPTY fileState [] .wordStart state [] .currentFile state [] .idContext .labelContext @ id.newLabel
              state [] .labelBuffer #swap list.append
            state [] .labelBuffer =
            1 -
          end #drop
          fileState state readLabel
            state [] .labelBuffer #swap list.append
          state [] .labelBuffer =
          continue
        else #dup 0 < _if
          "not enough types for label" sb.wrap fileState [] .wordStart state appendError2
          while #dup 0 < do
            Type .undefined fileState [] .wordStart newTypeConst  state pushConst
            1 +
          end
        end #drop
      id.FLAG_NONE fileState [] .wordStart state [] .currentFile state [] .idContext .labelContext @ id.newLabel
        state [] .labelBuffer #swap list.append
      state [] .labelBuffer =
      Type .undefined fileState [] .wordStart newTypeConst  state pushConst
      #dup .length 0 >
    do end
  "unexpected end of file" sb.wrap fileState [] .wordStart state appendError2
  LabelId arrayView optional.empty Type array.empty true return
end
proc( string : str FileState ptr mut : fileState  ParserState ptr mut : state => bool ) =: tryParseNumberLiteral
  str .length 0 == if
    false return
  end
  false =:: mut unsigned
  0 =:: mut size
  str
    str .length 1 - while #dup 0 > do
      #swap
        #dup #over:2 string.charAt
          #dup 'u' == #over 'U' == | if #drop
            true unsigned =
            #over string.splitIndex #swap 10 number.tryParseInt #dup number.ParserError .EMPTY == if
              #drop:2
            else number.ParserError .NONE != _if
              #drop:3 false return
            else #dup types.MAX_INT_WIDTH > _if
              "size of integer literal (" sb.wrap
                #swap sb.appendI
                ") exceeds maximum integer size (" sb.appendS
                types.MAX_INT_WIDTH sb.appendI
                ")" sb.appendS
              fileState [] .wordStart state [] .errors @ appendWarning
              64 size =
            else
              i32 cast size =
            end
            #swap break
          else #dup 'i' == #over 'I' == | _if #drop
            #over string.splitIndex #swap 10 number.tryParseInt number.ParserError .NONE != if
              #drop:3 false return
            else #dup types.MAX_INT_WIDTH > _if
              "size of integer literal (" sb.wrap
                #swap sb.appendI
                ") exceeds maximum integer size (" sb.appendS
                types.MAX_INT_WIDTH sb.appendI
                ")" sb.appendS
              fileState [] .wordStart state [] .errors @ appendWarning
              64 size =
            else
              i32 cast size =
            end
            #swap break
          else char.isDigit ! _if ## integer literal has to end with digit or u,U,i or I followed by digits
            #swap break
          end
      #swap 1 -
    end #drop
  unsigned if
    0 number.tryParseUInt
  else
    0 number.tryParseInt
  end
    #dup number.ParserError .NONE == if #drop
      unsigned size fileState [] .wordStart state newIntConstant  state pushConst
      true return
    else #dup number.ParserError .SIGN == _if #drop:2
      "unsigned value is marked as negative: " sb.wrap
        str sb.appendStr
      fileState [] .wordStart state [] .errors @ appendError
      true return
    else #dup number.ParserError .OVERFLOW == _if #drop:2
      "integer value outside allowed range: " sb.wrap
        str sb.appendStr
      fileState [] .wordStart state appendError2
      true return
    end
  #drop:2
  str 0 number.tryParseFloat ## XXX? float32 constants
    #dup number.ParserError .NONE == if #drop
      fileState [] .wordStart newFloatConst state pushConst
      true return
    else #dup number.ParserError .INT == _if #drop:2
      "integer value outside allowed range: " sb.wrap
        str sb.appendStr
      fileState [] .wordStart state appendError2
      true return
    end
  #drop:2
  false return
end
proc( string : code Token : token FileState ptr mut : fileState  ParserState ptr mut : state => string string bool ) =: tryParseConstant
  code
    token switch
      EMPTY case
        "" string.wrap true return
      STRING case
        ## newStringConstant
          ## parseStringConstant
            token .STRING
            fileState [] .wordStart
            state [] .errors @
            state [] .idContext .labelContext @
          id.parseStringConstant
          fileState [] .wordStart
          state [] .idContext .typeContext @
        newStringConstant state pushConst
        "" string.wrap true return
      CHAR case
        token .CHAR
          fileState [] .wordStart state [] .errors @  state [] .idContext .labelContext @ id.parseStringConstant ## escape character
          #dup .length 1 != if
            "A character literal has to contain exactly one character" sb.wrap fileState [] .wordStart state appendError2
          end
          state [] .idContext .labelContext addrOf id.scAsStr
          0 string.charAt
        fileState [] .wordStart newCharConstant state pushConst
        "" string.wrap true return
      IDENTIFER case
        token .IDENTIFER fileState state tryParseNumberLiteral if
          "" string.wrap true return
        end
        token .IDENTIFER
        break
    end
    #dup "_" string.wrap string.eq if
      fileState [] .wordStart newWildcardConst  state pushConst
      true return
    else #dup "true" string.wrap string.eq _if
      true fileState [] .wordStart newBoolConstant  state pushConst
      true return
    else #dup "false" string.wrap string.eq _if
      false fileState [] .wordStart newBoolConstant  state pushConst
      true return
    else #dup "bool" string.wrap string.eq _if
      types.primitive.BOOL fileState [] .wordStart newTypeConst  state pushConst
      true return
    else #dup "i8" string.wrap string.eq _if
      types.primitive.I8 fileState [] .wordStart newTypeConst  state pushConst
      true return
    else #dup "i16" string.wrap string.eq _if
      types.primitive.I16 fileState [] .wordStart newTypeConst  state pushConst
      true return
    else #dup "i32" string.wrap string.eq _if
      types.primitive.I32 fileState [] .wordStart newTypeConst  state pushConst
      true return
    else #dup "i64" string.wrap string.eq _if
      types.primitive.I64 fileState [] .wordStart newTypeConst  state pushConst
      true return
    else #dup "float" string.wrap string.eq _if
      types.primitive.FLOAT32 fileState [] .wordStart newTypeConst  state pushConst
      true return
    else #dup "double" string.wrap string.eq _if
      types.primitive.FLOAT64 fileState [] .wordStart newTypeConst  state pushConst
      true return
    else #dup "type" string.wrap string.eq _if
      types.primitive.TYPE fileState [] .wordStart newTypeConst  state pushConst
      true return
    else #dup "ptr" string.wrap string.eq _if
      fileState state popArraySize =:: fixedSize =:: sizes
      fileState state popTypeConstant if #drop
        Type .undefined fileState [] .wordStart newTypeConst  state pushConst
        true return
      end
      true sizes fixedSize false state [] .idContext .typeContext addrOf types.newArrayType if #drop
