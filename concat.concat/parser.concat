proc( string #+size+# string #+opName+# FilePosition ParserState ptr mut -> i32 ) =>: getCompilerOpParam
  =:: state
  =:: pos
  =:: opName
  ..dup 10 number.tryParseInt .NONE ?? ! if ..drop
    ..dup .length 0 > if
      64 sb.create
        "unexpected argument for " sb.appendS
        opName sb.appendStr
        " expected positive integer got: \"" sb.appendS
        ..swap  sb.appendStr
        '"'    sb.appendC
      pos state appendError2
    else ..drop end
    1 return
  else ..swap ..drop i32 cast ..dup 1 < _if
    50 sb.create
      "argument of " sb.appendS
        opName sb.appendStr
      " has to be positive got: " sb.appendS
      ..swap sb.appendI
    pos state appendError2
    1
  end
  return
end

proc( string : code Token : token FileState ptr mut : fileState  ParserState ptr mut : state -> string ) =>: parseOperation
  state [] .progContext =:: progContext
  state [] .progContext [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  idContext [] .typeContext .labelContext @ =:: labelContext
  idContext [] .constContext @ =:: constContext
  code
    token fileState state tryParseConstant if
      ..drop return
    end
    ..dup .length 0 == if ..drop
      return ## skip empty tokens
    end
    ..dup 0 string.charAt '#' == if ## compiler command
      1 string.tail
      ..dup ":" string.wrap string.startsWith if 1 string.tail
        "opt:!fold" string.wrap ..over string.eq if
          id.SCOPE_FLAG_NO_CONST_FOLD true idContext id.setScopeFlag
        else "opt:fold" string.wrap ..over string.eq _if
          id.SCOPE_FLAG_NO_CONST_FOLD false idContext id.setScopeFlag
        else "if:exp" string.wrap ..over string.eq _EXPERIMENTAL_ ! & _if ..drop
          while
            fileState nextToken =:: next
            next .IDENTIFIER ?? ! if continue end
          next .IDENTIFIER "#:end" string.wrap string.eq !
          next .IDENTIFIER "#:else" string.wrap string.eq ! & do end
          return
        else "ifnot:exp" string.wrap ..over string.eq _EXPERIMENTAL_ & _if ..drop
          while
            fileState nextToken =:: next
            next .IDENTIFIER ?? ! if continue end
          next .IDENTIFIER "#:end" string.wrap string.eq !
          next .IDENTIFIER "#:else" string.wrap string.eq ! & do end
          return
        else "else" string.wrap ..over string.eq _if ..drop
          while
            fileState nextToken =:: next
            next .IDENTIFIER ?? ! if continue end
          next .IDENTIFIER "#:end" string.wrap string.eq ! do end
          return
        end ..drop
        return ## ignore unknown annotations
      end
      ':' string.split
        "template" string.wrap ..over string.eq if ..drop
          state [] .currentProc optional.isEmpty ! if
            "#" sb.wrap
              ..swap sb.appendStr
            " can only be used at global level" sb.appendS fileState [] .wordStart state appendError2
          else ..drop end
          LabelType .TEMPLATE "#end" string.wrap fileState state readCompositeType if
            "error while parsing template arguments" sb.wrap fileState [] .wordStart state appendError2
          end ..drop ## labelType
          false typeContext types.newProcArgs
          progContext [] .templateOps .length state [] .currentFile fileState [] .wordStart idContext id.beginTemplate if
            "could not create template" sb.wrap fileState [] .wordStart state appendError2
          end
          return
        end
      64 sb.create
        "unknown compiler command \"" sb.appendS
        ..swap                         sb.appendStr
        ..over .length 0 > if
          ':'                         sb.appendC
          ..swap                       sb.appendStr
        else ..swap ..drop end
        '\"'                          sb.appendC
      fileState [] .wordStart state appendError2
      return
    else ..dup ":" string.wrap string.eq
       ..over "=:" string.wrap string.eq |
       ..over "=>:" string.wrap string.eq | _if =:: opName
      opName ":" string.wrap string.eq ! =:: isInit
      opName "=>:" string.wrap string.eq =:: isProc
      false =:: mut localDeclaration
      _EXPERIMENTAL_ ! if
        fileState state popTypeConstant ..drop ## comparability with old parser
      else state [] .constantBlocks .length 0 == state [] .currentProc optional.isEmpty & _if
        state tryInterpretGlobal ## try to interpret global operations before each declaration
        fileState state popTypeConstant ..drop
      else
        ## correct type will be resolved in type-check phase
        progContext [] .autoTypes .length i32 cast types.newAutoType
        progContext [] .autoTypes
          Type .undefined list.append
        progContext [] .autoTypes =
        true localDeclaration =
      end =:: mut valType
      isProc localDeclaration & if
        "procedures can only be declared at global level" sb.wrap
        fileState [] .wordStart state appendError2
        return
      end
      false =:: mut allowImmutableDeclaration
      false =:: mut forceImmutable
      state [] .constantBlocks .length 0 > if
        IdentifierType .LABEL
        true allowImmutableDeclaration =
      else localDeclaration _EXPERIMENTAL_ & _if
        IdentifierType .LOCAL_VAR
      else isProc isInit ! | _if valType typeContext types.isProcedure _if
        IdentifierType .PROCEDURE
        true forceImmutable =
        true allowImmutableDeclaration =
      else valType types.primitive.TYPE types.typeEquals _if
        IdentifierType .TYPE
        true forceImmutable =
        true allowImmutableDeclaration =
      else state [] .currentProc optional.isEmpty _if ## for comparability with old parser
        IdentifierType .GLOBAL_VAR
        true allowImmutableDeclaration =
      else
        IdentifierType .LOCAL_VAR
      end =:: idType
      isProc idType .PROCEDURE ?? ! & if
        "unexpected type for \"" sb.wrap
          opName sb.appendStr
          "\" expected procedure got: " sb.appendS
          valType typeContext sb.appendType
        fileState [] .wordStart state appendError2
        return
      end
      fileState state nextWord fileState state
        ## make pre-declared variables mutable by default
        isInit allowImmutableDeclaration | if id.FLAG_NONE else id.FLAG_MUTABLE end
      readLabelAddFlags =:: mut label
      forceImmutable if label labelContext id.labelFlags id.FLAG_MUTABLE & ? _if
        "identifiers of type " sb.wrap
          idType sb.appendIdType
         " cannot be mutable" sb.appendS
        fileState [] .wordStart state appendError2
      end
      label labelContext id.labelFlags id.FLAG_EXPERIMENTAL & ? =:: experimental
      label
        valType
        idType
        -1 ## id
        ConstValue .none
        isInit
        fileState [] .wordStart
        state [] .currentFile
        idContext
        progContext [] .errors @
      id.declareIdentifier if ..drop.2
        return
      end =:: idData label =
      idType .TYPE ?? if
        isInit if
          fileState state popTypeConstant if ..unreachable end ## XXX use assertion?
          label
          idContext [] .currentTemplate
          typeContext types.initializeNamedType if
            "re-initialization of named type" sb.wrap
            fileState [] .wordStart state appendError2
          end
        else
          label
          idContext [] .currentTemplate
          typeContext types.declareNamedType
        end
        fileState [] .wordStart newTypeConst .val
      else idType .PROCEDURE ?? _if
        progContext [] .procedures .length ConstValue .procedure
      else isInit ! _if
        ConstValue .none
      else state hasConst _EXPERIMENTAL_ ! & _if
        state popConst
          ..dup .valueType valType false typeContext types.canCast ! if
            "cannot cast " sb.wrap
              ..over .valueType typeContext sb.appendType
              " to " sb.appendS
              valType typeContext sb.appendType
            fileState [] .wordStart state appendError2
          end
          ..dup constantToOp state appendOp
        .val
      else state hasConst2 _EXPERIMENTAL_ & _if
        state peekConst2 .data =:: info .data =:: value
          info [] .valueType valType false typeContext types.canCast ! if
            "cannot cast " sb.wrap
              info [] .valueType typeContext sb.appendType
              " to " sb.appendS
              valType typeContext sb.appendType
            fileState [] .wordStart state appendError2
          end
        value []
      else
        ConstValue .none
      end
        _EXPERIMENTAL_ ! if
           label labelContext id.labelFlags id.FLAG_MUTABLE & ? _if
          ## old compiler does not support const-values on mutable identifiers
          ..drop ConstValue .none
        end
        label idContext id.getIdentifier
        if ..unreachable end
      [] .constValue =
      state [] .currentProc optional.isEmpty if
        idData .idType .PROCEDURE ?? ! isInit ! | if
          progContext [] .templateOps .length idContext  id.endOpenTemplate
        end
      end
      localDeclaration ! if
          MAIN_NAME string.wrap label labelContext id.labelNameEq _if ## main
        idType .PROCEDURE ?? ! if
          "main has to be a procedure got: " sb.wrap
            idData @ id.asIdInfo labelContext sb.appendIdInfo
