#include stringIO
#include io
#include stringBuilder
#include string
#include list

entryPoint:
  "./parser.concat" io.OPEN_READ io.fopen #drop =:: f
  128 sb.create
    '\n' sb.appendC
    f sb.appendFile #drop
    '\n' sb.appendC
  sb.toStr parseTokens ##printTokens
end

proc( char => bool ) =: isWhitespace
  switch
    ' ' '\n' '\t' '\v' '\f' '\r' case
      true return
    default
      false return
  end
end
proc( i8 : chr => i32 ) =: parseDigit
  chr '0' >= chr '9' <= & if
    chr '0' - return
  else chr 'A' >= chr 'Z' <= & _if
    chr 'A' - 10 + return
  else chr 'a' >= chr 'z' <= & _if
    chr 'a' - 10 + return
  end
  -1 return
end
enum( NONE INVALID_BASE EMPTY INVALID_CHAR OVERFLOW ) =:: ParseIntError
proc( string : str  i32 : base => i64 ParseIntError ) =: tryParseInt
  false =:: mut sign
  base =:: mut mBase
  base 0 != base 2 < base 62 > | & if
    0 ParseIntError .INVALID_BASE return
  end
  0 i64 =: mut res
  false =:: mut overflow
  str
    #dup 0 string.charAt '-' == if
      true sign =
      1 string.tail
    else #dup 0 string.charAt '+' == _if
      1 string.tail
    end
    #dup .length 0 == if
      #drop 0 ParseIntError .EMPTY return
    end
    mBase 0 == if
      10 mBase =
      #dup 0 string.charAt '0' == if
        #dup 1 string.charAt 'x' == if
          16 mBase =
          2 string.tail
        else #dup 1 string.charAt 'b' == _if
          2 mBase =
          2 string.tail
        end
      end
    end
    sign if -0x8000_0000_0000_0000 else 0x7fff_ffff_ffff_ffff end mBase /u =:: maxSafe
    0 while #dup #over:2 .length < do
      #over #over string.charAt
        #dup '_' == #over '\'' == | if
          #drop ## ignore _ and ' in numbers
          1 + continue
        end
      parseDigit
        #dup 0 < #over mBase > | if
          #drop:3 0 ParseIntError .INVALID_CHAR return ## ERR_INVALID_CHAR
        end
      res
        #dup maxSafe > if
          true overflow =
        end
        mBase * +
      res = ## add digit to number
      1 +
    end #drop
  #drop
  res
    sign if neg end
  overflow if ParseIntError .OVERFLOW return else ParseIntError .NONE return end
end

struct( string : mut fileName i64 : mut line i64 : mut posInLine ) =:: FilePosition
struct( FilePosition : mut currentPos FilePosition : mut wordStart ) =:: FileState

enum( EMPTY string : IDENTIFER string : STRING string : CHAR i64 : INTEGER string : ERROR ) =:: Token


proc( stringBuilder : sb Token : token => stringBuilder ) =: appendToken
  token switch
    EMPTY case
      sb "empty" sb.appendS return
    IDENTIFER case
      sb
        "identifier \"" sb.appendS
        token .IDENTIFER sb.appendStr
        '\"' sb.appendC
      return
    STRING case
      sb
        "string \"" sb.appendS
        token .STRING sb.appendStr
        '\"' sb.appendC
      return
    CHAR case
      sb "char \"" sb.appendS
        token .CHAR sb.appendStr
        '\"' sb.appendC
      return
    INTEGER case
      sb "integer " sb.appendS
        token .INTEGER sb.appendI
      return
    ERROR case
      sb "error \"" sb.appendS
        token .ERROR sb.appendStr
        '\"' sb.appendC
      return
  end
end
proc( string => ) =: printTokens
  "test" #dup .length string.create 0 1 FilePosition new #dup FileState new =:: mut state
  while
    state addrOf nextToken
    128 sb.create
      #swap appendToken
      " at " sb.appendS
      state .wordStart .fileName sb.appendStr
      ':' sb.appendC
      state .wordStart .line sb.appendI
      ':' sb.appendC
      state .wordStart .posInLine sb.appendI
      '\n' sb.appendC
    io.stdOut #swap io.fputSb #drop
    #dup .length 0 >
  do end #drop
end


proc( i8 : chr  FileState ptr mut : fileState => ) =: updateState
  chr '\n' == if
      fileState [] .currentPos .line ++ #drop
    1 fileState [] .currentPos .posInLine =
  else
    fileState [] .currentPos .posInLine ++ #drop
  end
end
proc( string : code FileState ptr mut : fileState => string ) =: skipSpaces
  0 while #dup code .length < code #over:2 string.charAt isWhitespace & do
    code #over string.charAt fileState updateState
    1 +
  end
  code #swap string.tail return
end
proc( string : code FileState ptr mut : fileState => string Token ) =: nextToken
  code .length 0 <= if
    "" string.wrap Token .EMPTY return
  end
  code fileState skipSpaces ## cut of leading white-spaces
    #dup 0 string.charAt '#' == #over 1 string.charAt '#' == & if ## line comment
      '#' fileState updateState
      '#' fileState updateState
      2 while #dup #over:2 .length < #over:2 #over:2 string.charAt '\n' != & do
        #over #over string.charAt fileState updateState
        1 +
      end
      string.tail fileState skipSpaces
    end
    #dup 0 string.charAt '#' == #over 1 string.charAt '+' == & if ## block comment
      '#' fileState updateState
      '+' fileState updateState
      2 while #dup #over:2 .length <  #over:2 #over:2 1 - string.charAt '+' !=  #over:3 #over:3 string.charAt '#' != |  & do
        #over #over string.charAt fileState updateState
        1 +
      end
      string.tail fileState skipSpaces
    end
    fileState [] .currentPos fileState [] .wordStart =
    #dup 0 string.charAt fileState updateState
    #dup 0 string.charAt '"' == if ## string
      1 string.tail
      0 while #dup #over:2 .length < #over:2 #over:2 string.charAt '"' != & do
        #over #over string.charAt '\\' == if ##escape characters
          #over #over string.charAt fileState updateState
          1 +
        end
        #over #over string.charAt fileState updateState
        1 +
      end
      #over #over string.charAt fileState updateState
      string.splitIndex Token .STRING new return
    end
    #dup 0 string.charAt '\'' == if ## char
      1 string.tail
      0 while #dup #over:2 .length < #over:2 #over:2 string.charAt '\'' != & do
        #over #over string.charAt '\\' == if ##escape characters
          #over #over string.charAt fileState updateState
          1 +
        end
        #over #over string.charAt fileState updateState
        1 +
      end
      #over #over string.charAt fileState updateState
      string.splitIndex Token .CHAR new return
    end
    1 while #dup #over:2 .length < #over:2 #over:2 string.charAt isWhitespace ! & do
      #over #over string.charAt fileState updateState
      1 +
    end
  string.cutIndex
    #dup 0 tryParseInt
      #dup ParseIntError .NONE == if #drop
        #swap #drop Token .INTEGER new return
      else #dup ParseIntError .OVERFLOW == _if #drop:3
        "Integer Overflow" string.wrap Token .ERROR new return
      end
    #drop:2
    #dup .length 0 == if
      #drop Token .EMPTY return
    end
  Token .IDENTIFER new return
end

enum( UNDEFINED BOOL I8 I32 I64 FLOAT TYPE ) =:: PrimitiveType

i32 =:: ArrayId
i32 =:: CompositeId
i32 =:: ProcId
i32 =:: NamedTypeId

enum( 
  PrimitiveType : primitive
        ArrayId : ptr
        ArrayId : array 
    CompositeId : tuple
    CompositeId : struct
    CompositeId : labeledProcIn
    CompositeId : procIn
    CompositeId : procOut
    CompositeId : enum
    CompositeId : enumLabel
         ProcId : procedure
    NamedTypeId : namedType
    NamedTypeId : namedLabel
            i32 : autoType
            i32 : genericType
            i32 : templateType
) =:: Type


## XXX composite types, proc types, named types, array types


enum( i64 : int string : str i8 : chr ) =:: ConstValue
enum( NOP ConstValue : Constant string : Error  string : Unknown ) =:: OpValue
struct( OpValue : val FilePosition : pos ) =:: Operation

proc( FilePosition => Operation ) =: opNOP
  OpValue .NOP #swap Operation new return
end
proc( i64 FilePosition => Operation ) =: opConstInt
  #swap ConstValue .int new OpValue .Constant new #swap Operation new return
end
proc( string FilePosition => Operation ) =: opConstStr
  #swap ConstValue .str new OpValue .Constant new #swap Operation new return
end
proc( i8 FilePosition => Operation ) =: opConstChar
  #swap ConstValue .chr new OpValue .Constant new #swap Operation new return
end
proc( string FilePosition  => Operation ) =: opError
  #swap OpValue .Error new #swap Operation new return
end
proc( string FilePosition  => Operation ) =: opUnknown
  #swap OpValue .Unknown new #swap Operation new return
end
proc( Operation => ) =: printOp
  64 sb.create
    #over .val switch
      NOP case break
      Constant case
        "Constant: " sb.appendS
        #over .val .Constant #swap
          #over switch
            int case
              "integer "  sb.appendS
              #over .int sb.appendI
              break
            str case
              "string \""  sb.appendS
              #over .str   sb.appendStr
                     '\"'  sb.appendC
              break
            chr case
              "char \'"  sb.appendS
              #over .chr sb.appendC
                   '\''  sb.appendC
              break
          end
        #swap #drop
        break
      Error case
        "Error: " sb.appendS
        #over .val .Error sb.appendStr
        break
      Unknown case
        "Unknown Operation: " sb.appendS
        #over .val .Unknown sb.appendStr
        break
      default
    end
    " at " sb.appendS
    #over .pos .fileName sb.appendStr
    ':' sb.appendC
    #over .pos .line sb.appendI
    ':' sb.appendC
    #over .pos .posInLine sb.appendI
    '\n' sb.appendC
    #swap #drop
  io.stdOut #swap io.fputSb #drop
end

proc( string : code Token : token FileState ptr mut : fileState  Operation list ptr mut : ops => string ) =: parseOperation
  code
    token switch
      EMPTY case
        return
      STRING case ## TODO escape sequences
        token .STRING fileState [] .wordStart opConstStr  ops [] #swap list.append ops [] =
        return
      CHAR case
        token .CHAR
          #dup .length 1 != if
            #drop
            "A character literal has to contain exactly one character" string.wrap fileState [] .wordStart opError  ops [] #swap list.append ops [] = 
            return
          end
          0 string.charAt
        fileState [] .wordStart opConstChar ops [] #swap list.append ops [] = 
        return
      INTEGER case
        token .INTEGER fileState [] .wordStart opConstInt  ops [] #swap list.append ops [] =
        return
      ERROR case
        token .ERROR fileState [] .wordStart opError  ops [] #swap list.append ops [] =
        return
      IDENTIFER case
        token .IDENTIFER
        break
    end
    #dup 0 string.charAt '#' == if ## compiler command
      1 string.tail
        "include" string.wrap #over string.eq if #drop
          fileState nextToken
          #dup Token .STRING == if .STRING
            ## TODO include local file
            #drop 
            return
          else #dup Token .IDENTIFER == _if .IDENTIFER
            ## TODO include library file
            #drop 
            return
          end
          64 sb.create
            "invalid token for include" sb.appendS
            #swap appendToken
          sb.toStr fileState [] .wordStart opError  ops [] #swap list.append ops [] = 
          return
        end
      64 sb.create
        "unknown compiler command \"" sb.appendS
        #swap                         sb.appendStr
        '\"'                          sb.appendC
      sb.toStr fileState [] .wordStart opError  ops [] #swap list.append ops [] =
      return
    end
    ## TODO try parsing identifier
  fileState [] .wordStart opUnknown  ops [] #swap list.append ops [] =
  return
end
proc( string => ) =: parseTokens
  "test" #dup .length string.create 0 1 FilePosition new #dup FileState new =:: mut state
  128 Operation list.create =:: mut ops
  state addrOf #swap
    while
      #over nextToken #over:2 ops addrOf parseOperation
      #dup .length 0 >
    do end #drop
  #drop
  0 while #dup ops .length < do
    ops #over list.get printOp
    1 +
  end #drop
end
