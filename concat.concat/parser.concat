struct( Type : valueType ConstValue : val IdentifierInfo optional : idInfo FilePosition : pos ) =:: Constant
struct( i64 : codeOffset ) =:: CompositeConstantOffset
struct( InterpreterContext : mut: context i64 : mut: offset ) =:: InterpreterInfo

struct(
  IdentifierInfo : itrVar
  Type : itrType
) =:: ItrVarInfo
struct(
  ItrVarInfo optional : itrVarInfo
  BlockType : mut: blockType
  i64  : mut: blockStart
  bool : mut: autoClose
  bool : hasScope
) =:: BlockInfo

struct(
  string : mut: basePath
  string : mut: libPath
  ProgramContext ptr.mut : progContext
  TypeCheckState ptr.mut : typeChecker
  BlockInfo list : mut: openBlocks
  i64 list : mut: andOrPositions
  Operation list : mut: globalOpBuffer
  i64 : mut: constOffset
  Type list : mut: typeBuffer
  FileId : mut: currentFile
  ProcId optional : mut: currentProc
  CompositeConstantOffset list : mut: constantBlocks
  InterpreterInfo list : mut: globalInterpreters
  LabelId list : mut: labelBuffer
  stringBuilder : mut: tmpString
  bool : saveGlobalTokens
) =:: ParserState

proc( FilePosition : pos -> Constant ) =>: newWildcardConst
  Type .undefined ConstValue .WildCard IdentifierInfo optional.empty pos Constant new return
end
proc( bool FilePosition -> Constant ) =>: newBoolConstant
  =:: pos
  types.primitive.BOOL ..swap ConstValue .Bool IdentifierInfo optional.empty pos Constant new return
end
proc(
  i64 : value
  i32 : preferedSize
-> bool ) =>: checkIntSize
  preferedSize 0 <= or preferedSize types.MAX_INT_WIDTH >= if
    false return
  end
  value -1:i64 preferedSize 1 - << < if
    true return
  end
  value 1:i64 preferedSize << >= return
end

enum( FIXED AUTO ) =:: IntLiteralType
proc(
  i64 : value
  IntLiteralType : literalType
  Type : intType
  string : literal
  FilePosition : pos
  ParserState ptr.mut : state
-> Constant ) =>: newIntConstant
  state .progContext@ =:: progContext
  progContext [] .errors@ =:: errors
  progContext [] .idContext .typeContext@ =:: typeContext
  literalType switch
    FIXED case
      intType typeContext types.sizeOf .fixed i32 cast 8 * =:: bitCount
      value bitCount checkIntSize if
        "integer literal overflows size for type " sb.wrap
          intType typeContext sb.appendType
          intType types.isPrimitive ! if
            " ( i" sb.appendS
            bitCount sb.appendU
            ')' sb.appendC
          end
          ": " sb.appendS
          literal sb.appendStr
        pos errors appendWarning
      end
      intType break
    AUTO case
      value f64.MIN_INT <  if types.intLiteral.S64 break end
      value i32.MIN i64 cast.s <  if types.intLiteral.S54_ break end
      value f32.MIN_INT i64 cast.s < if types.intLiteral.S32 break end
      value i16.MIN i64 cast.s <  if types.intLiteral.S25_ break end
      value  i8.MIN i64 cast.s <  if types.intLiteral.S16 break end
      value       0 <  if types.intLiteral.S8  break end
      value  i8.MAX i64 cast.u <= if types.intLiteral.U7  break end
      value i16.MAX i64 cast.u <= if types.intLiteral.U15 break end
      value f32.MAX_INT i64 cast.u <= if types.intLiteral.U24_ break end
      value i32.MAX i64 cast.u <= if types.intLiteral.U31 break end
      value f64.MAX_INT <= if types.intLiteral.U53_ break end
      types.intLiteral.U63
      break
  end =:: constType
  constType value ConstValue .Int IdentifierInfo optional.empty pos Constant new return
end
proc(
  unicode.Codepoint : char
  StringLiteralType : stringType
  FilePosition : pos
-> Constant ) =>: newCharConstant
  ## newConstant
    stringType switch
      DEFAULT case types.primitive.CHAR8  char char8 cast ConstValue .Char break
      UTF8    case types.primitive.CHAR8  char i64 cast.u 0xff & ConstValue .Int break
      UTF16   case types.primitive.CHAR16 char i64 cast.u 0xffff & ConstValue .Int break
      UTF32   case types.primitive.CHAR32 char i64 cast.u ConstValue .Int break
      UNKNOWN INT_LITERAL case ..unreachable
    end
  IdentifierInfo optional.empty pos Constant new return
end
proc(
  ConstValue : str
  StringLiteralType : stringType
  FilePosition : pos
  TypeContext ptr.mut : context
  ConstantContext ptr.mut : constContext
  CompilerError list ptr.mut : errors
-> Constant ) =>: newStringConstant
  using types
  str .Array8 ?? "string has type Array8" assert
  stringType switch
    DEFAULT case str str .Array8 .length types.primitive.CHAR8 break
    UTF8    case str str .Array8 .length types.primitive.CHAR8 break
    UTF16 case
      ## TODO? reuse the same buffer for all string conversion
      0 char16 list.create str .Array8 string.fromBytes utf8.toUTF16 =:: str16
      str16
        list.asArray string16.fromArray
      constContext newString16Const str16 .length types.primitive.CHAR16
        str16 list.free ..drop
      break
    UTF32 case
      0 char32 list.create str .Array8 string.fromBytes  utf8.toUTF32 =:: str32
      str32
        list.asArray string32.fromArray
      constContext newString32Const str32 .length types.primitive.CHAR32
        str32 list.free ..drop
      break
    UNKNOWN INT_LITERAL case
      "unsupported string literal type" sb.wrap pos errors appendError
      ConstValue .None 0 Type .undefined break
  end =:: charType =:: strLength =:: strValue
  strLength ArraySize .int =:: size
  ## Constant
    charType types.ArrayType .POINTER size@ 1 array.create false context newArrayType ..drop
    strValue
    IdentifierInfo optional.empty
  pos Constant new return
end
proc( Type FilePosition -> Constant ) =>: newTypeConst
  =:: pos
  types.primitive.TYPE ..swap ConstValue .TypeId IdentifierInfo optional.empty pos Constant new return
end

proc( f64 : value Type : constType FilePosition : pos -> Constant ) =>: newFloatConst
  ## Constant
    constType
    value ConstValue .Float
    IdentifierInfo optional.empty
    pos
  Constant new return
end

proc( Constant : const -> Operation ) =>: constantToOp
  const .val const .valueType const .pos opConst return
end

proc( ParserState ptr.mut : state -> i64 ) =>: opCount
  state [] .progContext =:: progContext
  state [] .currentProc optional.isEmpty if
    -1 return
  else
    progContext [] .tmpOps .length return
  end
end
proc( ParserState ptr.mut : state -> InterpreterInfo ptr.mut ) =>: getInterpreter
  state [] .globalInterpreters state [] .currentFile i64 cast list.at .data
end
proc( Operation : op ParserState ptr.mut : state -> ) =>: appendOp
  state [] .progContext =:: progContext
  progContext [] .errors@ =:: errors
  state [] .currentProc optional.isEmpty if
    state [] .saveGlobalTokens if
      progContext [] .progFiles
        state [] .currentFile i64 cast
      list.at .data =:: currentFile
      currentFile [] .globalOps
        op list.append
      currentFile [] .globalOps =
    end
    state getInterpreter =:: interpreter
    op =:: op1
    op1@ interpreter [] .context@ evaluateOperation .Ok ?? ! if
      "could not evaluate global operation: " sb.wrap
        op progContext sb.appendOp
      op .pos errors appendError
    end
  else
    progContext [] .tmpOps
      op list.append
    progContext [] .tmpOps =
  end
end

proc( ParserState ptr.mut : state -> Operation ptr.mut optional ) =>: peekOp
  state [] .progContext =:: progContext
  state [] .currentProc optional.isEmpty if
    state [] .globalOpBuffer
  else
    progContext [] .tmpOps
  end list.peek
end

proc( Constant : const ParserState ptr.mut : state -> ) =>: pushConst
  const constantToOp state appendOp
end

proc( ParserState ptr.mut : state -> ConstValue interpreter.ValueInfo ) =>: popConst
  state getInterpreter [] .context@ =:: interpreter
  interpreter [] .stack
    list.pop =:: value
  interpreter [] .stack =
  interpreter [] .stackInfo
    list.pop =:: info
  interpreter [] .stackInfo =
  value info return
end
proc( ParserState ptr.mut : state -> bool ) =>: hasConst
  state [] .currentProc optional.hasData if
    false return ## constants only exists at global level
  end
  state getInterpreter [] .context@ =:: interpreter
  interpreter [] .stack .length 0 > return
end
proc(
  ParserState ptr.mut : state
->
  ConstValue ptr.mut optional interpreter.ValueInfo ptr.mut optional
) =>: peekConst
  state getInterpreter [] .context@ =:: interpreter
  interpreter [] .stack list.peek interpreter [] .stackInfo list.peek return
end

proc( FileState ptr.mut : fileState ParserState ptr.mut : state -> Type bool ) =>: peekTypeConstant
  state [] .progContext@ =:: progContext
  progContext [] .errors@ =:: errors
  state peekConst =:: info? =:: value?
  value? optional.isEmpty if
    "missing type constant" sb.wrap fileState [] .wordStart errors appendError
    Type .undefined true return
  end
  value? .data [] .TypeId ?? ! if
    "wrong type for constant expected type" sb.wrap info? .data [] .pushedAt errors appendError
    Type .undefined true return
  end
  value? .data [] .TypeId false return
end
proc( FileState ptr.mut : fileState ParserState ptr.mut : state -> Type bool ) =>: popTypeConstant
  state [] .progContext@ =:: progContext
  progContext [] .errors@ =:: errors
  state peekConst =:: info? =:: value?
  value? optional.isEmpty if
    "missing type constant" sb.wrap fileState [] .wordStart errors appendError
    Type .undefined true return
  end
  value? .data [] .TypeId ?? ! if
    "wrong type for constant expected type" sb.wrap info? .data [] .pushedAt errors appendError
    Type .undefined true return
  end
  state popConst ..drop .TypeId false return
end

proc( BlockType : blockType ParserState ptr.mut : state -> ) =>: openBlock
  state [] .openBlocks
    ItrVarInfo optional.empty blockType -1 false false BlockInfo new list.append
  state [] .openBlocks =
end
proc( BlockType : blockType bool : forceScope ParserState ptr.mut : state -> ) =>: openBlockScope
  forceScope or state [] .currentProc optional.hasData if
    state [] .progContext [] .idContext@ id.openScope
    true
  else false end =:: hasScope
  state [] .openBlocks
    ItrVarInfo optional.empty blockType -1 false hasScope BlockInfo new list.append
  state [] .openBlocks =
end
proc( ItrVarInfo : itrVarInfo bool : forceScope ParserState ptr.mut : state -> ) =>: openForBlock
  forceScope or state [] .currentProc optional.hasData if
    state [] .progContext [] .idContext@ id.openScope
    true
  else false end =:: hasScope
  state [] .openBlocks
    itrVarInfo optional.wrap BlockType .DO -1 false hasScope BlockInfo new list.append
  state [] .openBlocks =
end
proc( bool : hasScope bool : experimental ParserState ptr.mut : state -> ) =>: openProcBlock
  state [] .openBlocks
    ## BlockInfo
      ItrVarInfo optional.empty
      experimental if
        BlockType .EXPERIMENTAL_PROCEDURE
      else
        BlockType .PROCEDURE
      end
      -1
      false
      hasScope
    BlockInfo new list.append
  state [] .openBlocks =
end
proc( ParserState ptr.mut : state -> ) =>: autoCloseCurrentBlock
  true state [] .openBlocks list.peek .data [] .autoClose =
end
proc(
  ParserState ptr.mut : state
->
  BlockType #+type+#
) =>: currentBlockType
  state [] .openBlocks .length 0 == if
    BlockType .UNKNOWN return
  end
  state [] .openBlocks list.peek .data [] .blockType return
end
proc(
  ParserState ptr.mut : state
->
  BlockInfo
  bool #+isError+#
) =>: closeBlock
  state [] .openBlocks .length 0 == if
    ItrVarInfo optional.empty BlockType .UNKNOWN -1 false false BlockInfo new true return
  end
  state [] .openBlocks
    list.pop =:: closed
  state [] .openBlocks =
  closed .hasScope if
    closed
      state [] .progContext [] .idContext@ id.closeScope
    return
  end
  closed false return
end

proc( BlockType : mergeWith FilePosition : pos ParserState ptr.mut : state -> ) =>: convertAndOrBlock
  state [] .currentProc optional.isEmpty if
    return ## cannot modify and/or in global block
  end
  state [] .progContext =:: progContext
  progContext [] .errors@ =:: errors
  state [] .andOrPositions =:: andOrPositions
  0:i64 while ..dup andOrPositions .length < do =:: i
    andOrPositions i list.get =:: opPos
    opPos 0 < or opPos progContext [] .tmpOps .length >= if
      "operations and blocks are out of sync, could not determine position of and/or" sb.wrap
      pos errors appendError
      return
    end
    progContext [] .tmpOps opPos list.at .data =:: opData
    opData [] .val .block ?? ! if
      "operations and blocks are out of sync, expected and/or got " sb.wrap
        opData [] progContext sb.appendOp
      pos errors appendError
      return
    end
    ## opBlock
      opData [] .val .block .blockType switch
        AND case mergeWith .DO ?? if BlockType .AND_DO else BlockType .AND_IF end break
        OR case mergeWith .DO ?? if BlockType .OR_DO else BlockType .OR_IF end break
        default
          "operations and blocks are out of sync, expected and/or got " sb.wrap
            opData [] .val .block .blockType sb.appendBlockType
          pos errors appendError
        return
      end
      opData [] .pos
    opBlock opData [] =
    i 1 +
  end ..drop
  andOrPositions list.clear state [] .andOrPositions =
end

proc( string : code FileState ptr.mut : fileState  ParserState ptr.mut : state -> string string ) =>: nextWord
  state [] .progContext@ =:: progContext
  progContext [] .errors@ =:: errors
  code
    fileState nextToken
    ..dup .IDENTIFIER ?? ! if ..drop ## XXX? print type of actual token
      "expected identifier" sb.wrap fileState [] .wordStart errors appendError
      string.empty return
    end
    .IDENTIFIER
  return
end
proc(
  string : code
  string : start
  FileState ptr.mut : fileState
  ParserState ptr.mut : state
  LabelFlag : initFlags
-> string LabelId ) =>: readLabelAddFlags
  state [] .progContext@ =:: progContext
  progContext [] .errors@ =:: errors
  0:LabelFlag =:: mut: flags
  false =:: mut: isModifier
  code start
    while
      false isModifier =
      ..dup "mut:" string.wrap string.eq if
        id.FLAG_MUTABLE flags | flags =
        true isModifier =
      else ..dup "auto:" string.wrap string.eq _if
        id.FLAG_AUTO flags | flags =
        true isModifier =
      else ..dup "static:" string.wrap string.eq _if
        id.FLAG_STATIC flags | flags =
        true isModifier =
      else ..dup "extern:" string.wrap string.eq _if
        id.FLAG_EXTERN flags | flags =
        true isModifier =
      else ..dup "export:" string.wrap string.eq _if
        id.FLAG_EXPORT flags | flags =
        true isModifier =
      else ..dup "inline:" string.wrap string.eq _if
        id.FLAG_INLINE flags | flags =
        true isModifier =
      else ..dup "no:inline:" string.wrap string.eq _if
        id.FLAG_NO_INLINE flags | flags =
        true isModifier =
      else ..dup "#:experimental:" string.wrap string.eq _if
        id.FLAG_EXPERIMENTAL flags | flags =
        true isModifier =
      else ..dup "shaddow:" string.wrap string.eq _if
        id.FLAG_SHADDOW flags | flags =
        true isModifier =
      else ..dup "alias:" string.wrap string.eq _if
        id.FLAG_ALIAS flags | flags =
        true isModifier =
      else ..dup ":" string.wrap string.endsWith _if
        true isModifier =
      end
      isModifier ! if
        break
      end
    isModifier do ..drop
      fileState nextToken ## XXX? print type of actual token
      ..dup .IDENTIFIER ?? ! if ..drop
        "expected identifier" sb.wrap fileState [] .wordStart errors appendError
        "" string.wrap
      else
        .IDENTIFIER
      end
    end
  flags initFlags | fileState [] .wordStart state [] .currentFile state [] .progContext [] .idContext .typeContext .labelContext@ id.newLabel return
end
proc( string : code string : start FileState ptr.mut : fileState  ParserState ptr.mut : state -> string LabelId ) =>: readLabel
  code start fileState state 0:LabelFlag readLabelAddFlags
end

proc(
  string : literal
  IntLiteralType : literalType
  Type : intType
  FilePosition : pos
  ParserState ptr.mut : state
-> bool ) =>: tryParseIntConstant
  state [] .progContext@ =:: progContext
  progContext [] .errors@ =:: errors
  progContext [] .idContext .typeContext@ =:: typeContext
  literal 0 number.tryParseInt switch
    NONE case
      literalType intType literal pos state newIntConstant  state pushConst
      true return
    UNSIGNED case
      literalType switch
        FIXED case
          intType typeContext types.sizeOf .fixed 8 * i32 cast types.MAX_INT_WIDTH < if
            ..drop types.MAX_SIGNED_INT ## replace with maximum signed value to trigger overflow check
          end
          break
        AUTO case
          "integer value does not fit into a signed integer: " sb.wrap
            literal sb.appendStr
          pos errors appendWarning
          break
      end
      literalType intType literal pos state newIntConstant  state pushConst
      true return
    SIGN case ..drop
      "unsigned value is marked as negative: " sb.wrap
        literal sb.appendStr
      pos errors appendWarning
      true return
    OVERFLOW case ..drop
      "integer value outside allowed range: " sb.wrap
        literal sb.appendStr
      pos errors appendError
      true return
    INT INVALID_BASE case ..unreachable
    INVALID_CHAR EMPTY case ..drop
      false return
  end
end
proc(
  string : literal
  string : literalTypeName
  FilePosition : pos
  ParserState ptr.mut : state
-> bool ) =>: tryParseNumberLiteral
  state [] .progContext@ =:: progContext
  progContext [] .errors@ =:: errors
  progContext [] .idContext@ =:: idContext
  idContext .typeContext@ =:: typeContext
  literal .length 0 == if
    false return
  end
  literal 0 string.charAt '#' == if
    false return ## annotations
  end
  literalTypeName .length 0 > if
    literalTypeName "i8"  string.wrap string.eq if types.primitive.I8
    else literalTypeName "i16" string.wrap string.eq _if types.primitive.I16
    else literalTypeName "i32" string.wrap string.eq _if types.primitive.I32
    else literalTypeName "i64" string.wrap string.eq _if types.primitive.I64
    else literalTypeName "f32" string.wrap string.eq _if types.primitive.F32
    else literalTypeName "f64" string.wrap string.eq _if types.primitive.F64
    else literalTypeName state [] .currentFile idContext id.findIdentifierByName
        ..swap =:: idData ! and
        idData .idType .TYPE ?? and idData .constValue .TypeId ?? _if
      idData .constValue .TypeId []
    else
      false return
    end =:: literalType
    literalType typeContext types.isInt if
      literal IntLiteralType .FIXED literalType pos state tryParseIntConstant ! if
        "invalid integer constant: `" sb.wrap
          literal sb.appendStr
          '`' sb.appendC
        pos errors appendWarning
      end
      true return
    else literalType typeContext types.isFloat _if
      literal 0 number.tryParseFloat =:: errCode
      errCode .NONE ?? or errCode .INT ?? if
        literalType pos newFloatConst state pushConst
        true return
      else ..drop
        "invalid float constant: `" sb.wrap
          literal sb.appendStr
          '`' sb.appendC
        pos errors appendWarning
      end
    else
      "unsupported literal type: " sb.wrap
        literalType typeContext sb.appendType
      pos errors appendError
      true return
    end
  end
  literal IntLiteralType .AUTO Type .undefined pos state tryParseIntConstant if
    true return
  end
  literal 0 number.tryParseFloat
    ..dup .NONE ?? if ..drop
      types.primitive.F64 pos newFloatConst state pushConst
      true return
    else ..dup .INT ?? _if ..drop.2
      "integer value outside allowed range: " sb.wrap
        literal sb.appendStr
      pos errors appendError
      true return
    end
  ..drop.2
  false return
end
proc(
  StringToken : token
  bool : isRawString
  FilePosition : pos
  ParserState ptr.mut : state
-> ConstValue ) =>: parseStringConstant
  state [] .progContext@ =:: progContext
  progContext [] .errors@ =:: errors
  state [] .progContext [] .idContext@ =:: idContext
  idContext [] .typeContext@ =:: typeContext
  idContext [] .constContext@ =:: constContext
  idContext [] .typeContext .labelContext@ =:: labelContext
  ## newStringConstant
    ## parseStringConstant
      token .value
      pos
      progContext [] .errors@
      constContext
    isRawString if
      constants.parseRawStringConstant
    else
      constants.parseStringConstant
    end
    token .stringType
    pos
    typeContext
    constContext
    progContext [] .errors@
  newStringConstant
    $ .val =:: stringConst
  state pushConst
  stringConst return
end
proc(
  StringToken : token
  FilePosition : pos
  ParserState ptr.mut : state
-> ) =>: parseCharConstant
  state [] .progContext@ =:: progContext
  progContext [] .errors@ =:: errors
  state [] .progContext [] .idContext@ =:: idContext
  idContext [] .typeContext@ =:: typeContext
  idContext [] .constContext@ =:: constContext
  idContext [] .typeContext .labelContext@ =:: labelContext
  token .value
    pos progContext [] .errors@ constContext constants.parseStringConstant ## escape character
      .Array8 string.fromBytes
      0 utf8.nextCodepoint =:: cp
    #+nextIndex+# ..swap .length < if
      "A character literal has to contain exactly one character" sb.wrap pos errors appendError
    end
    token .stringType switch
      DEFAULT case "byte" string.wrap 0x7F break
      UTF8  case "utf8-character"  string.wrap 0x7F    break
      UTF16 case "utf16-character" string.wrap 0xFFFF break
      UTF32 case "utf32-character" string.wrap unicode.MAX_CODEPOINT i32 cast.u break
      INT_LITERAL UNKNOWN case
        "invalid string literal type" sb.wrap pos errors appendError
        return
    end
    =:: maxCodepoint =:: charTypeName
    token .stringType .DEFAULT ?? ! and cp i32 cast 0 < if
      "unmatched byte in " sb.wrap
        charTypeName sb.appendStr
        ": 0x" sb.appendS
        cp i32 cast -_ sb.appendX
      pos errors appendError
    end
    cp i32 cast maxCodepoint > if
      "codepoint 0x"  sb.wrap
        cp i32 cast sb.appendX
        " ('" sb.appendS
        cp sb.appendCodepoint
       "') cannot be encoded as a single " sb.appendS
       charTypeName sb.appendStr
      pos errors appendError
    end
  ## newCharConstant
    cp $ i32 cast 0 < if i32 cast -_ unicode.Codepoint cast end
    token .stringType
  pos newCharConstant state pushConst
end
proc(
  Token : literalType
  FilePosition : pos
  CompilerError list ptr.mut : errors
-> bool ) =>: checkLiteralType
  literalType .LITERAL_TYPE ?? ! if
    "expected literal type got: " sb.wrap
    literalType sb.appendToken
    pos errors appendError
    true return
  end
  literalType .LITERAL_TYPE .length 0 == if
    "literal type should be non-empty" sb.wrap
    pos errors appendError
    true return
  end
  false return
end
proc(
  string : code
  Token : token
  FileState ptr.mut : fileState
  ParserState ptr.mut : state
-> string string bool ) =>: tryParseConstant
  state [] .progContext@ =:: progContext
  progContext [] .errors@ =:: errors
  state [] .progContext [] .idContext@ =:: idContext
  idContext [] .typeContext@ =:: typeContext
  idContext [] .constContext@ =:: constContext
  idContext [] .typeContext .labelContext@ =:: labelContext
  code
    token switch
      EMPTY case
        "" string.wrap true return
      EOF case
        "unexpected end of file in string-literal" sb.wrap fileState [] .wordStart errors appendError
        "" string.wrap true return
      STRING case
        token .STRING false fileState [] .wordStart state parseStringConstant ..drop
        "" string.wrap true return
      RAW_STRING case
        token .RAW_STRING true fileState [] .wordStart state parseStringConstant ..drop
        "" string.wrap true return
      CHAR case
        token .CHAR fileState [] .wordStart state parseCharConstant
        "" string.wrap true return
      IDENTIFIER case
        token .IDENTIFIER string.empty fileState [] .wordStart state tryParseNumberLiteral if
          "" string.wrap true return
        end
        token .IDENTIFIER
        break
      LITERAL case
        fileState [] .wordStart =:: literalStart
        fileState nextToken =:: literalType
        literalType fileState [] .wordStart errors checkLiteralType if
          string.empty true return
        end
        literalType .LITERAL_TYPE "?":s string.eq if
          false =:: mut: isElement
          token .LITERAL
            $ 0 string.charAt '.' == if
              1 string.tail
              true isElement =
            end
            $ "@":s string.endsWith if
              $ .length 1 - string.head
            end
          =:: idName
          idName
            id.FLAG_NONE
            literalStart
          state [] .currentFile labelContext id.newLabel
          literalStart
            isElement if opExistsLabel else opExistsName end
          state appendOp
          string.empty true return
        end
        token .LITERAL literalType .LITERAL_TYPE literalStart state tryParseNumberLiteral if
          string.empty true return
        end
        ## XXX add support for custom literal types
        "could not resolve literal: " sb.wrap
        token .LITERAL sb.appendStr
        ':' sb.appendC
        literalType .LITERAL_TYPE sb.appendStr
        literalStart errors appendError
        "" string.wrap true return
      LITERAL_CHAR LITERAL_STRING LITERAL_RAW_STRING case
        fileState [] .wordStart =:: literalStart
        token .LITERAL_STRING ?? if
          token .LITERAL_STRING false
        else token .LITERAL_CHAR ?? _if
          token .LITERAL_CHAR false
        else
          token .LITERAL_RAW_STRING true
        end literalStart state parseStringConstant =:: stringConst
        types.primitive.I_SIZE
          stringConst .Array8 ?? if
            stringConst .Array8 .length
          else stringConst .Array32 ?? _if
            stringConst .Array32 .length
          else stringConst .Array16 ?? _if
            stringConst .Array16 .length
          else ..unreachable end ConstValue .Int
          IdentifierInfo optional.empty
        fileState [] .wordStart Constant new state pushConst
        fileState nextToken =:: literalType
        literalType fileState [] .wordStart errors checkLiteralType  if
          "" string.wrap true return
        end
        ## XXX? more usefull error for missing parse procedure?
        ## :<name> -> <name>.parse
        state [] .tmpString
          sb.clear ## clear tmp string
          literalType .LITERAL_TYPE sb.appendStr
          ".static.parse" sb.appendS
        state [] .tmpString =
        state [] .tmpString sb.asStr false return
      LITERAL_TYPE case
        "unexpected token: " sb.wrap
        token sb.appendToken
        fileState [] .wordStart errors appendError
        "" string.wrap true return
    end
    ..dup "_" string.wrap string.eq if
      fileState [] .wordStart newWildcardConst  state pushConst
      true return
    else ..dup "true" string.wrap string.eq _if
      true fileState [] .wordStart newBoolConstant  state pushConst
      true return
    else ..dup "false" string.wrap string.eq _if
      false fileState [] .wordStart newBoolConstant  state pushConst
      true return
    else ..dup "bool" string.wrap string.eq _if
      types.primitive.BOOL fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "i8" string.wrap string.eq _if
      types.primitive.I8 fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "i16" string.wrap string.eq _if
      types.primitive.I16 fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "i32" string.wrap string.eq _if
      types.primitive.I32 fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "i64" string.wrap string.eq _if
      types.primitive.I64 fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "char8" string.wrap string.eq _if
      types.primitive.CHAR8  fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "char16" string.wrap string.eq _if
      types.primitive.CHAR16 fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "char32" string.wrap string.eq _if
      types.primitive.CHAR32 fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "f32" string.wrap string.eq _if
      types.primitive.F32 fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "f64" string.wrap string.eq _if
      types.primitive.F64 fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "type" string.wrap string.eq _if
      types.primitive.TYPE fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..ctype.void" string.wrap string.eq _if
      types.ctype.VOID fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..ctype.bool" string.wrap string.eq _if
      types.ctype.BOOL fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..ctype.char" string.wrap string.eq _if
      types.ctype.CHAR fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..ctype.schar" string.wrap string.eq _if
      types.ctype.S_CHAR fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..ctype.uchar" string.wrap string.eq _if
      types.ctype.U_CHAR fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..ctype.short" string.wrap string.eq _if
      types.ctype.SHORT fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..ctype.ushort" string.wrap string.eq _if
      types.ctype.U_SHORT fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..ctype.int" string.wrap string.eq _if
      types.ctype.INT fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..ctype.uint" string.wrap string.eq _if
      types.ctype.U_INT fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..ctype.long" string.wrap string.eq _if
      types.ctype.LONG fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..ctype.ulong" string.wrap string.eq _if
      types.ctype.U_LONG fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..ctype.longlong" string.wrap string.eq _if
      types.ctype.LONGLONG fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..ctype.ulonglong" string.wrap string.eq _if
      types.ctype.U_LONGLONG fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..ctype.size" string.wrap string.eq _if
      types.ctype.SIZE fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..ctype.float" string.wrap string.eq _if
      types.ctype.FLOAT fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..ctype.double" string.wrap string.eq _if
      types.ctype.DOUBLE fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..ctype.struct*" string.wrap string.eq _if
      types.ctype.STRUCT_PTR fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..ctype.union*" string.wrap string.eq _if
      types.ctype.UNION_PTR fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..type.align2" string.wrap string.eq _if
      2 Type .align fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..type.align4" string.wrap string.eq _if
      4 Type .align fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..type.align8" string.wrap string.eq _if
      8 Type .align fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..type.align16" string.wrap string.eq _if
      16 Type .align fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..type.align32" string.wrap string.eq _if
      32 Type .align fileState [] .wordStart newTypeConst  state pushConst
      true return
    end
  false return
end
proc(
  string #+size+#
  string : opName
  FilePosition : pos
  ParserState ptr.mut : state
-> i32 ) =>: getCompilerOpParam
  state [] .progContext@ =:: progContext
  progContext [] .errors@ =:: errors
  ..dup 10 number.tryParseInt .NONE ?? ! if ..drop
    ..dup .length 0 > if
      64 sb.create
        "unexpected argument for " sb.appendS
        opName sb.appendStr
        " expected positive integer got: \"" sb.appendS
        ..swap  sb.appendStr
        '"'    sb.appendC
      pos errors appendError
    else ..drop end
    1 return
  else ..swap ..drop i32 cast ..dup 1 < _if
    50 sb.create
      "argument of " sb.appendS
        opName sb.appendStr
      " has to be positive got: " sb.appendS
      ..swap sb.appendI
    pos errors appendError
    1
  end
  return
end
proc( ProgramContext ptr.mut : progContext -> Type ) =>: newAutoType
  progContext [] .autoTypes .length i32 cast types.newAutoType
  progContext [] .autoTypes
    Type .undefined list.append
  progContext [] .autoTypes =
end
proc( ItrVarInfo : varInfo ParserState ptr.mut : state FilePosition : pos -> ) =>: appendItrStep
  state [] .progContext [] .idContext@ =:: idContext
  varInfo .itrType varInfo .itrVar pos opGetId =:: getItr
  getItr state appendOp
  "..itr.step" string.wrap state [] .currentFile idContext id.findIdentifierByName
    ! "..itr.step" assert
  =:: itrStep
  itrStep [] .valueType itrStep id.asIdInfo pos opGetId state appendOp
  getItr state appendOp
  pos opSetValue state appendOp
end
proc( ItrVarInfo : varInfo ParserState ptr.mut : state FilePosition : pos -> ) =>: appendItrEnd
  state [] .progContext [] .idContext@ =:: idContext
  varInfo .itrType varInfo .itrVar pos opGetId state appendOp
  "..itr.end" string.wrap state [] .currentFile idContext id.findIdentifierByName
    ! "..itr.end" assert
  =:: itrEnd
  itrEnd [] .valueType itrEnd id.asIdInfo pos opGetId state appendOp
end
## if current procedure is a valid main
proc( LabelId : procName Type : procType FilePosition : pos ParserState ptr.mut : state -> ) =>: checkMain
  state [] .progContext =:: progContext
  progContext [] .errors@ =:: errors
  progContext [] .idContext@ =:: idContext
  idContext [] .typeContext@ =:: typeContext
  idContext [] .constContext@ =:: constContext
  typeContext .labelContext@ =:: labelContext
  MAIN_NAME string.wrap procName labelContext id.labelNameEq ! if
    return ## no main procedure -> skip checks
  end
  procType typeContext types.isProcedure ! if
    "main has to be a procedure got: " sb.wrap
      procType typeContext sb.appendType
    pos errors appendError
    return
  end
  procName labelContext id.getLabelFile 0:FileId != and
      procName labelContext id.labelFlags id.FLAG_EXPORT & ? ! if
    "main procedure is not visible from root file" sb.wrap
    pos errors appendWarning
    return
  end
  procName labelContext id.getLabelNamespace 0:NamespaceId != if
    "main procedure is not in global namespace" sb.wrap
    pos errors appendWarning
    return
  end
  procType typeContext types.getProcIn ! "main procIn" assert =:: inTypes
  procType typeContext types.getProcOut ! "main procOut" assert =:: outTypes
  inTypes typeContext types.compositeEltCount 0 > if
    "the main procedure should not take arguments" sb.wrap
     pos errors appendError
  end
  outTypes typeContext types.compositeEltCount 0 > if
    "the main procedure should not return a value" sb.wrap
     pos errors appendWarning
  end
end
## check if composite has any static elements, types are static by default
proc( Type : composite TypeContext ptr : typeContext -> bool ) =>: hasStaticElement
  typeContext [] .labelContext@ =:: labelContext
  composite typeContext types.compositeEltCount =:: eltCount
  eltCount for =:: i
    composite i typeContext types.compositeGetLabel
        labelContext id.labelFlags id.FLAG_STATIC & ? if
      true return
    end
    composite i typeContext types.compositeGetElement
        typeContext types.unwrapNamed
        types.primitive.TYPE types.typeEquals if
      true return
    end
  end
  false return
end
proc(
  LabelId : procName
  Type : procType
  FileId : fileId
  ProcId : aliasId
  i64 : codeStart
  ProgramContext ptr.mut : progContext
-> ProcId ) =>: newProcData
  progContext [] .idContext@ =:: idContext
  idContext [] .typeContext@ =:: typeContext
  typeContext [] .labelContext@ =:: labelContext
  procType typeContext types.getProcIn ..drop =:: procIn
  procType typeContext types.getProcOut ..drop =:: procOut
  procIn typeContext hasStaticElement =:: hasStaticArg
  procOut typeContext hasStaticElement
    procName labelContext id.labelFlags id.FLAG_STATIC & ? |
  =:: isStatic
  progContext [] .procedures
    $ .length ProcId cast =:: procId
    ## ProcedureInfo
      fileId
      procType
      procName
      aliasId -1:ProcId == if
        ## CodeProcData
          0 ProcImplementation list.create
          0 VariableInfo list.create
          codeStart
          -1
          ProcCodeState .PARSING
        CodeProcData new ProcImplType .code
      else
        codeStart -1:i64 == "no code in proc alias" assert
        aliasId ProcImplType .alias
      end
      hasStaticArg
      isStatic
    ProcedureInfo new list.append
  progContext [] .procedures =
  procId return
end

proc( string : code Token : token FileState ptr.mut : fileState  ParserState ptr.mut : state -> string ) =>: parseOperation
  state [] .progContext =:: progContext
  progContext [] .errors@ =:: errors
  progContext [] .idContext@ =:: idContext
  idContext [] .typeContext@ =:: typeContext
  idContext [] .constContext@ =:: constContext
  typeContext .labelContext@ =:: labelContext
  state getInterpreter [] .context@ interpreter.skipCurrentBlock =:: skipBlock
  code
    token fileState state tryParseConstant if
      ..drop return
    end
    ..dup .length 0 == if ..drop
      return ## skip empty tokens
    end
    ## 1. parse blocks
    ..dup "if" string.wrap string.eq if ..drop
      state currentBlockType =:: currentBlock
      currentBlock .AND ?? if ## sequence of ands -> allow access to local variables from if-branch
        BlockType .IF fileState [] .wordStart state convertAndOrBlock
        state [] .openBlocks list.peek .data =:: current
        BlockType .IF current [] .blockType =
      else currentBlock .OR ?? _if
        state closeBlock ! "correctly closed block" assert
        .blockType currentBlock == "closed block matches current block" assert
        BlockType .IF fileState [] .wordStart state convertAndOrBlock
      end
      BlockType .IF  fileState [] .wordStart opBlock  state appendOp
      currentBlock .AND ?? ! if
        BlockType .IF false state openBlockScope
      end
      return
    else ..dup "and" string.wrap string.eq
         ..over "or" string.wrap string.eq | _if =:: opName
      opName "or" string.wrap string.eq =:: isOr
      isOr if BlockType .OR else BlockType .AND end =:: blockType
      state currentBlockType =:: outerBlock
      outerBlock .AND ?? ! and outerBlock .OR ?? ! if
        ## not already within an and-or chain
        blockType false state openBlockScope
      else isOr _if ## remember if 'or' appeared
        state [] .openBlocks list.peek .data =:: current
        BlockType .OR current [] .blockType =
      end
      ## remember position to allow changing block-type when merging with if/do
      state [] .andOrPositions
        state opCount list.append
      state [] .andOrPositions =
      blockType  fileState [] .wordStart opBlock  state appendOp
      return
    else ..dup "_if" string.wrap string.eq _if ..drop
      state currentBlockType
        ..dup .AND ?? if ## sequence of ands -> allow access to local variables from if-branch
          BlockType .IF fileState [] .wordStart state convertAndOrBlock
          state [] .openBlocks list.peek .data =:: current
          BlockType .IF current [] .blockType =
        else ..dup .OR ?? _if
          state closeBlock ! "correctly closed block" assert
          .blockType == "closed block matches current block" assert
          BlockType .IF fileState [] .wordStart state convertAndOrBlock
          state currentBlockType ## get new enclosing block
        end
      =:: currentType
      currentType .ELSE ?? ! and currentType .AND ?? ! if
        "'_if' is only allowed in else-blocks" sb.wrap fileState [] .wordStart errors appendError
        return
      end
      BlockType .IF =:: blockType
      blockType fileState [] .wordStart opBlock  state appendOp
      currentType .AND ?? ! if ## no new scope for and .. _if
        blockType false state openBlockScope
      end
      state autoCloseCurrentBlock
      return
    else ..dup "else" string.wrap string.eq _if ..drop
      state closeBlock if ..drop
        "'else' statements can not appear at top level" sb.wrap fileState [] .wordStart errors appendError
        return
      end =:: closed
      closed .blockType .IF ?? ! if
        "'else' is only allowed in if-blocks" sb.wrap fileState [] .wordStart errors appendError
        return
      end
      BlockType .ELSE fileState [] .wordStart opBlock  state appendOp
      BlockType .ELSE false state openBlockScope
      closed .autoClose if
        state autoCloseCurrentBlock
      end
      return
    else ..dup "while" string.wrap string.eq or
        ..dup "while:" string.wrap string.eq _if =:: opName
      opName "while:" string.wrap string.eq if
        fileState nextToken
          ..dup .IDENTIFIER ?? ! if ## XXX? print type of actual token
            "expected identifier" sb.wrap fileState [] .wordStart errors appendError
          end
          .IDENTIFIER
          id.FLAG_NONE
          fileState [] .wordStart
          state [] .currentFile
        labelContext id.newLabel
      else
        id.LABEL_ID_NONE
      end =:: blockLabel
      BlockType .WHILE blockLabel fileState [] .wordStart opLabeledBlock state appendOp
      BlockType .WHILE false state openBlockScope
      return
    else ..dup "for" string.wrap string.eq or
        ..dup "for:" string.wrap string.eq _if =:: opName
      opName "for:" string.wrap string.eq if
        fileState nextToken
          ..dup .IDENTIFIER ?? ! if ## XXX? print type of actual token
            "expected identifier" sb.wrap fileState [] .wordStart errors appendError
          end
          .IDENTIFIER
          id.FLAG_NONE
          fileState [] .wordStart
          state [] .currentFile
        labelContext id.newLabel
      else
        id.LABEL_ID_NONE
      end =:: blockLabel
      "..itr.prepare" string.wrap state [] .currentFile idContext id.findIdentifierByName
        ! "..itr.prepare" assert
      =:: itrPrepare
      itrPrepare [] .valueType itrPrepare id.asIdInfo fileState [] .wordStart opGetId state appendOp
      progContext newAutoType =:: itrType
      fileState [] .wordStart state [] .currentFile idContext id.newItrVar =:: itrVar
      itrType itrVar fileState [] .wordStart opAutoTypedInitializeId state appendOp
      BlockType .WHILE blockLabel fileState [] .wordStart opLabeledBlock state appendOp
      itrType itrVar fileState [] .wordStart opGetId state appendOp
      "..itr.check" string.wrap state [] .currentFile idContext id.findIdentifierByName
        ! "..itr.check" assert
      =:: itrCheck
      itrCheck [] .valueType itrCheck id.asIdInfo fileState [] .wordStart opGetId state appendOp
      BlockType .DO fileState [] .wordStart opBlock  state appendOp
      itrType itrVar fileState [] .wordStart opGetId state appendOp
      "..itr.get" string.wrap state [] .currentFile idContext id.findIdentifierByName
        ! "..itr.get" assert
      =:: itrGet
      itrGet [] .valueType itrGet id.asIdInfo fileState [] .wordStart opGetId state appendOp
      itrVar itrType ItrVarInfo new false state openForBlock
      return
    else ..dup "do" string.wrap string.eq _if ..drop
      state currentBlockType =:: currentBlock
      currentBlock .AND ?? currentBlock .OR ?? | if
        state closeBlock ! "correctly closed block" assert
        .blockType currentBlock == "closed block matches current block" assert
        BlockType .DO fileState [] .wordStart state convertAndOrBlock
      end
      state [] .openBlocks list.peek =:: current?
      current? optional.isEmpty if true else current? .data [] .blockType .WHILE ?? ! end if
        "'do' is only allowed in while-blocks" sb.wrap fileState [] .wordStart errors appendError
        return
      end
      BlockType .DO  current? .data [] .blockType =
      BlockType .DO  fileState [] .wordStart opBlock  state appendOp
      return
    else ..dup "finally" string.wrap string.eq _if =:: opName
      state [] .openBlocks list.peek =:: current?
      current? optional.isEmpty if true else current? .data [] .blockType .DO ?? ! end if
        "'finally' is only allowed after 'do' in while-blocks" sb.wrap fileState [] .wordStart errors appendError
        return
      end
      BlockType .FINALLY  current? .data [] .blockType =
      BlockType .FINALLY  fileState [] .wordStart opBlock  state appendOp
      current? .data .itrVarInfo [] optional.hasData if ## update iterator in for-loop
        current? .data .itrVarInfo [] .data =:: varInfo
        varInfo state fileState [] .wordStart appendItrStep
      end
      return
    else ..dup "break" string.wrap string.eq or
        ..dup "break." string.wrap string.startsWith _if =:: opName
      opName '.' string.split ..drop =:: breakLabel
      breakLabel .length 0 > if
        ## newLabel
          breakLabel
          id.FLAG_NONE
          fileState [] .wordStart
          state [] .currentFile
        labelContext id.newLabel
      else
        id.LABEL_ID_NONE
      end =:: blockLabel
      BlockType .BREAK blockLabel fileState [] .wordStart opLabeledBlock state appendOp
      return
    else ..dup "continue" string.wrap string.eq or
        ..dup "continue." string.wrap string.startsWith _if =:: opName
      opName '.' string.split ..drop =:: continueLabel
      continueLabel .length 0 > if
        ## newLabel
          continueLabel
          id.FLAG_NONE
          fileState [] .wordStart
          state [] .currentFile
        labelContext id.newLabel
      else
        id.LABEL_ID_NONE
      end =:: blockLabel
      BlockType .CONTINUE blockLabel fileState [] .wordStart opLabeledBlock state appendOp
      return
    else ..dup "switch" string.wrap string.eq or
        ..dup "switch:" string.wrap string.eq _if =:: opName
      opName "switch:" string.wrap string.eq if
        fileState nextToken
          ..dup .IDENTIFIER ?? ! if ## XXX? print type of actual token
            "expected identifier" sb.wrap fileState [] .wordStart errors appendError
          end
          .IDENTIFIER
          id.FLAG_NONE
          fileState [] .wordStart
          state [] .currentFile
        labelContext id.newLabel
      else
        id.LABEL_ID_NONE
      end =:: blockLabel
      BlockType .SWITCH blockLabel fileState [] .wordStart opLabeledBlock state appendOp
      BlockType .SWITCH false state openBlockScope
      return
    else ..dup "case" string.wrap string.eq _if ..drop
      state closeBlock =:: isError .blockType =:: closedBlock
      closedBlock .SWITCH ?? ! closedBlock .CASE ?? ! & isError | if
        "'case' is only allowed in switch-blocks" sb.wrap fileState [] .wordStart errors appendError
        return
      end
      BlockType .CASE fileState [] .wordStart opBlock  state appendOp
      BlockType .CASE false state openBlockScope
      return
    else ..dup "default" string.wrap string.eq _if ..drop
      state closeBlock =:: isError =:: closed
      closed .blockType .CASE ?? ! isError | if
        "'default' is only allowed in switch-case-blocks" sb.wrap fileState [] .wordStart errors appendError
        return
      end
      BlockType .DEFAULT fileState [] .wordStart opBlock  state appendOp
      BlockType .DEFAULT false state openBlockScope
      return
    else $ "=>" string.wrap string.eq or $ "=>:" string.wrap string.eq _if =:: opName
      opName .length 3 == =:: named
      ## pop type before reading name
      fileState state popTypeConstant ..drop =:: mut: procType
      ## TODO? ensure global stack is empty at start of procedure
      named if ## =>:
        fileState state nextWord fileState state readLabel
        $ labelContext id.labelFlags =:: flags
        flags id.FLAG_MUTABLE & ? if
          "procedures cannot be mutable" sb.wrap
          fileState [] .wordStart errors appendError
        else flags id.FLAG_ALIAS & ? _if
          "procedure alias cannot have an implementation" sb.wrap
          fileState [] .wordStart errors appendError
        end
      else
        ## TODO generate name
        id.LABEL_ID_NONE
      end =:: mut: procName
      procName labelContext id.labelFlags id.FLAG_EXPERIMENTAL & ? =:: experimental
      ## declare procedure name outside procedure scope
      skipBlock if ## don't declare identifier in skipped block
        -1:ProcId optional.wrap state [] .currentProc =
        false experimental state openProcBlock
        return
      end
      ## declare procedure
      procName
        procType
        IdentifierType .PROCEDURE
        -1 ## index
        ConstValue .None
        true ## isInit
        fileState [] .wordStart
        state [] .currentFile
        idContext
        progContext [] .errors@
      id.declareIdentifier if ..drop.2
        return
      end =:: idData procName =
      idData .constValue =:: procConst
      state [] .currentProc optional.isEmpty ! =:: isNested
      ## ensure procedure block is opened after declaring procedure,
      ##   but before early return due to error
      true experimental state openProcBlock
      progContext [] .tmpOps .length =:: codeStart
      procConst .Procedure ?? if
        codeStart progContext [] .procedures
          procConst .Procedure i64 cast list.at .data
        =:: procData
        procData .implementation [] .code ?? ! if
          "unexpected implementation for " sb.wrap
            procData [] .implementation switch
              builtIn case " built-in procedure" sb.appendS break
              alias case " procedure alias" sb.appendS break
              code case ..unreachable
            end
          fileState [] .wordStart errors appendError
          ..drop return
        end
        procData .implementation .code .codeStart =
        procConst .Procedure
      else
        procName procType state [] .currentFile -1:ProcId codeStart progContext newProcData
          $ ConstValue .Procedure procName idContext id.getIdentifier
              ! "procName is identifier" assert
          [] .constValue =
      end =:: procId
      procId experimental idContext id.openProcScope
      procId optional.wrap state [] .currentProc =
      ## check for invalid procedure declaration
      isNested if
        "nested procedures are not supported" sb.wrap
        fileState [] .wordStart errors appendError
        return
      else state [] .constantBlocks .length 0 > _if
        "cannot declare procedure in type or initializer blocks" sb.wrap
        fileState [] .wordStart errors appendError
        return
      else procType typeContext types.isProcedure ! _if
        ## XXX? wrap non-procedure types in procedure: i32 =>: ... <-> ( -> i32 ) =>: ...
        "unexpected type for procedure declaration: " sb.wrap
          procType typeContext sb.appendType
        fileState [] .wordStart errors appendError
        return
      end
      ## check if current procedure is main
      procName procType fileState [] .wordStart state checkMain
      ## XXX? ensure global stack is empty at start of procedure?
      idData .valueType typeContext types.getProcIn if
        "could not resolve procedure signature" sb.wrap fileState [] .wordStart errors appendError
      end =:: inType
      inType typeContext types.compositeEltCount for =:: index
        inType index typeContext types.compositeGetLabel =:: argLabel
        inType index typeContext types.compositeGetElement =:: argType
        argLabel i32 cast =:: argId
        argLabel labelContext id.isLabelEmpty ! and
            argLabel labelContext id.labelFlags id.FLAG_DUMMY & ? ! if
          ## declareIdentifier
            argLabel
            argType
            IdentifierType .ARGUMENT
            index i32 cast
            ConstValue .None
            true
            fileState [] .wordStart
            state [] .currentFile
            idContext
            progContext [] .errors@
          id.declareIdentifier if ..drop.2
            return
          end ..drop.2
        end
      end
      ## TODO generate operation to push proc-ptr if unnamed
      ## ? allow unnamed procedures in overload: ... end block?
      idData .valueType idData@ id.asIdInfo fileState [] .wordStart opInitializeId
      state appendOp
      return
    else ..dup "return" string.wrap string.eq _if ..drop
      skipBlock if return end
      idContext id.currentScopeProc =:: experimental =:: procId
        procId -1:ProcId == if
          "return outside procedure" sb.wrap fileState [] .wordStart errors appendError
        end
      ## opReturn
        Type .undefined
        fileState [] .wordStart
      opReturn state appendOp
      return
