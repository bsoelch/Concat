        end
      else
        typeContext types.newTuple if
          "error while creating composite type" sb.wrap fileState [] .wordStart state appendError2
        end
      end
      fileState [] .wordStart newTypeConst  state pushConst
      "" string.wrap true return
    else ..dup "tuple(" string.wrap string.eq _EXPERIMENTAL_ ! & _if ..drop
