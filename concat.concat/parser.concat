      idContext id.closeScope if
        "unexpected " sb.wrap opName sb.appendStr fileState [] .wordStart state appendError2
        #drop:3
        return
      end =:: blockType #drop:2
      state [] .constantBlocks
        list.pop =:: offset
      state [] .constantBlocks =
      blockType fileState [] .wordStart opEndBlock state appendOp
      blockType switch
        TYPE_COMPOSITE TYPE_TUPLE TYPE_STRUCT TYPE_UNION TYPE_ENUM case
