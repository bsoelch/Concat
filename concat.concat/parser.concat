      end ..drop ## labelType
      typeContext types.newTuple if
        "error while creating tuple type" sb.wrap fileState [] .wordStart state appendError2
      end
      fileState [] .wordStart newTypeConst  state pushConst
      "" string.wrap true return
    else ..dup "struct(" string.wrap string.eq _EXPERIMENTAL_ ! & _if ..drop
      LabelType .STRUCT ")" string.wrap fileState state readCompositeType
      if
        "error while parsing structure type" sb.wrap fileState [] .wordStart state appendError2
      end ..drop ## labelType
      typeContext types.newTuple if
        "error while creating structure type" sb.wrap fileState [] .wordStart state appendError2
      end
      fileState [] .wordStart newTypeConst  state pushConst
      "" string.wrap true return
    else ..dup "union(" string.wrap string.eq _EXPERIMENTAL_ ! & _if ..drop
      LabelType .STRUCT ")" string.wrap fileState state readCompositeType
      if
        "error while parsing union type" sb.wrap fileState [] .wordStart state appendError2
      end ..drop ## labelType
      typeContext types.newUnion if
        "error while creating union type" sb.wrap fileState [] .wordStart state appendError2
      end
      fileState [] .wordStart newTypeConst  state pushConst
      "" string.wrap true return
    else ..dup "enum(" string.wrap string.eq _EXPERIMENTAL_ ! & _if ..drop
      LabelType .ENUM ")" string.wrap fileState state readCompositeType
      if
        "error while parsing enum type" sb.wrap fileState [] .wordStart state appendError2
      end ..drop ## labelType
      typeContext types.newEnum if
        "error while creating enum type" sb.wrap fileState [] .wordStart state appendError2
      end
      fileState [] .wordStart newTypeConst  state pushConst
      "" string.wrap true return
    else ..dup "proc(" string.wrap string.eq _EXPERIMENTAL_ ! & _if ..drop
      state offsetStaticArgs =:: prevArgs
      LabelType .PROC_IN "->" string.wrap fileState state readCompositeType
      if
        "error while parsing procedure arguments" sb.wrap fileState [] .wordStart state appendError2
      end ..drop ## labelType
      false typeContext types.newProcArgs
      =:: in
      LabelType .TUPLE ")" string.wrap fileState state readCompositeType
      prevArgs state resetStaticArgs
      if
        "error while parsing procedure return values" sb.wrap fileState [] .wordStart state appendError2
      end ..drop ## labelType
      true typeContext types.newProcArgs
      in ..swap CallingConvention.DEFAULT typeContext  types.newProcedure if
        "error while creating procedure type" sb.wrap fileState [] .wordStart state appendError2
      end
