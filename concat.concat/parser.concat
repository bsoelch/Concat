            idData [] .idType sb.appendIdType
            " ( declared at " sb.appendS
            idData [] .declaredAt sb.appendPos
            " ) expected: " sb.appendS
            IdentifierType .PROCEDURE_BUNDLE sb.appendIdType
          fileState [] .wordStart state appendError2
          return
        end
        ## XXX? warn for incompatible flags
        ## XXX? warn if overloads in different name-spaces are merged
        idData [] .constValue .procedureBundle
      end =:: bundleId
      progContext [] .procBundles bundleId i64 cast list.at .data =:: bundleData
      while fileState state nextWord =:: procName
        procName "end" string.wrap string.eq !
      do
        procName state [] .currentFile idContext id.findIdentifierByName if ..drop
          "could not find procedure \"" sb.wrap
            procName sb.appendStr
            '"' sb.appendC
          fileState [] .wordStart state appendError2
          continue
        end =:: idData
        idData [] .idType .PROCEDURE ?? ! if
          256 sb.create
            idData [] .idType sb.appendIdType
            " \"" sb.appendS
            idData [] .labelId labelContext sb.appendLabelName
            "\" ( declared at " sb.appendS
            idData [] .declaredAt sb.appendPos
            " ) is not a procedure" sb.appendS
            IdentifierType .PROCEDURE_BUNDLE sb.appendIdType
          fileState [] .wordStart state appendError2
          return
        end
        bundleData [] .procedures
          idData [] .constValue .procedure list.append
        bundleData [] .procedures =
      end
      return
    else ..dup "..?types" string.wrap string.eq or
        ..dup "..?types." string.wrap string.startsWith _if =:: mut: opName
      opName "..?types." ..length string.tail =:: params
      "..?types" string.wrap opName =
      -1 =:: mut: count
      0 =:: mut: depth
      params .length 0 > if
        params '.' string.split =:: head =:: tail
        head .length 0 > if
          head
            opName
            fileState [] .wordStart
          state getCompilerOpParam count =
        end
        tail .length 0 > if
          tail
            opName
            fileState [] .wordStart
          state getCompilerOpParam depth =
        end
      end
      ## opTypesInfo
        count
        depth
        fileState [] .wordStart
      opTypesInfo state appendOp
      return
    else ..dup "..?stack" string.wrap string.eq or
        ..dup "..?stack." string.wrap string.startsWith _if =:: mut: opName
      opName "..?stack." ..length string.tail =:: params
      "..?stack" string.wrap opName =
      params .length 0 > if
        params opName fileState [] .wordStart state getCompilerOpParam
      else -1 end
      fileState [] .wordStart opStackInfo state appendOp
      return
    else ..dup "..?ops" string.wrap string.eq or
        ..dup "..?ops." string.wrap string.startsWith _if =:: mut: opName
      opName "..?ops." ..length string.tail =:: params
      "..?ops" string.wrap opName =
      params .length 0 > if
        params opName fileState [] .wordStart state getCompilerOpParam
      else -1 end
      fileState [] .wordStart opPrintCompiledOps state appendOp
      return
    ## XXX ..?parser.ops
    else ..dup "..?find." string.wrap string.startsWith _if =:: mut: opName
      opName "..?find." ..length string.tail =:: idName
      ## opPrintIdentifierMatches
        idName
          id.FLAG_NONE
          fileState [] .wordStart
          state [] .currentFile
        labelContext id.newLabel
        fileState [] .wordStart
      opPrintIdentifierMatches state appendOp
      return
    else ..dup "..?parser.find." string.wrap string.startsWith _if =:: mut: opName
        opName "..?parser.find." ..length string.tail =:: idName
        16 IdentifierMatch list.create =:: mut: matches
        idName state [] .currentFile idContext matches @ optional.wrap id.searchIdentifier ..drop.3
        "-----------------\n" sb.wrap
          "identifier \"" sb.appendS idName sb.appendStr "\":\n" sb.appendS
          0 while ..dup matches .length < do =:: i
            matches i list.at .data =:: match
            match [] .labelId idContext id.getIdentifier
              ! assert "matched identifier exists"
            =:: idData
            " - " sb.appendS
            idData id.asIdInfo labelContext sb.appendIdInfo
            " ( " sb.appendS
            idData [] .valueType typeContext sb.appendType
            idData [] .constValue .none ?? ! if
              " [ " sb.appendS
              idData [] .constValue constContext typeContext sb.appendConstant
              " ]" sb.appendS
            end
            " ) declared at " sb.appendS
            match [] .labelId labelContext id.labelPos =:: pos?
            pos? optional.hasData if
              pos? .data sb.appendPos
            else
              "?" sb.appendS
            end
            '\n' sb.appendC
            i 1 +
          end ..drop
          "-----------------\n" sb.appendS
          io.stdOut ..over io.fputSb ..drop
        sb.free ..drop
        matches list.free ..drop
        return
    else ..dup "begin" string.wrap string.eq or
         ..dup "defer" string.wrap string.eq _if =:: opName
      "`" sb.wrap
        opName sb.appendStr
        "` is a reserved keyword for a future language version" sb.appendS
      fileState [] .wordStart state appendError2
      return
    end
    ..dup "@" string.wrap string.endsWith =:: isAddr
    isAddr if
      ..dup .length 1 - string.head
    end
  =:: idName
  idName
    state [] .currentFile
  idContext id.findIdentifierByName ! if ## try parsing as identifier
    ..dup [] .valueType ..swap id.asIdInfo fileState [] .wordStart
      isAddr if opAtId else opGetId end
    state appendOp
    return
  end ..drop
  idName
    id.FLAG_NONE fileState [] .wordStart state [] .currentFile
  labelContext id.newLabel =:: labelId
  labelId fileState [] .wordStart
  isAddr if opAtName else opGetName end
  state appendOp
  return
end
proc( io.IOError : err stringBuilder : fileName FilePosition : pos ParserState ptr mut : state -> ) =>: checkIOError
  using io
  err switch
    FILE_ERROR_NONE case
      return
    FILE_ERR_PATH_OVERFLOW FILE_ERR_OPEN_MODE FILE_ERR_FILE_NOT_FOUND FILE_ERR_FILE_IS_DIR FILE_ERR_ACCESS_DENIED FILE_ERR_INVALID_FILE case
      "cannot include file \"" sb.wrap fileName sb.appendSb '"' sb.appendC pos state appendError2
      return
    default
      "error while reading file \"" sb.wrap fileName sb.appendSb '"' sb.appendC pos state appendError2
      return
  end
end
proc( stringBuilder : fileName FilePosition : pos ParserState ptr mut : state -> ) =>: importFile
  state [] .progContext =:: progContext
  FILE_ID_NONE =:: mut: imported
  0 while ..dup progContext [] .progFiles .length < do
    progContext [] .progFiles ..over list.get .fileName sb.asStr fileName sb.asStr string.eq if
      ..dup FileId cast imported =
      break
    end
    1 +
  end ..drop
  imported FILE_ID_NONE == if ## file has not yet been imported
    fileName state parseFile fileName pos state checkIOError imported =
  end
  progContext [] .progFiles state [] .currentFile i64 cast list.at .data
  ..dup [] .includedFiles
      imported
      pos
    IncludedFile new list.append
  ..swap [] .includedFiles =
end


proc( stringBuilder : rootFile string : libPath string : basePath -> ProgramContext ) =>: export: parseProgram
  newProgramContext =:: mut: programContext
  ## FilePosition
    rootFile sb.asStr
    0
    0
  FilePosition new =:: rootPos
  ## initBuiltInProcs
    rootPos
    programContext @
  initBuiltInProcs if
    ## TODO handle error
  end
  ## ParserState
    basePath
    libPath
    programContext @
    64  BlockInfo               list.create
    32  i64                     list.create
    128 Operation               list.create
    128 Constant                list.create
    0
    128 Type                    list.create
    FILE_ID_NONE
    ProcId                   optional.empty
    128 CompositeConstantOffset list.create
    0   InterpreterInfo         list.create
    128 LabelId                 list.create
  ParserState new =:: mut: state
  rootFile state @ parseFile rootFile rootPos state @ checkIOError ..drop
  ## cleanup parser memory
  state .constants list.free ..drop
  state .typeBuffer list.free ..drop
  state .constantBlocks list.free ..drop
  0 while ..dup state .globalInterpreters .length < do
    state .globalInterpreters
      ..over list.at .data [] .context @
    interpreter.cleanupContext
    1 +
  end ..drop
  state .globalInterpreters list.free ..drop
  programContext return
end
proc( stringBuilder : fileName ParserState ptr mut : state -> FileId io.IOError ) =>: parseFile
  fileName
    state [] .progContext =:: progContext
    ..dup ..over .length 1 - sb.charAt '\x00' != if
      '\x00' sb.appendC ## ensure file-name is zero terminated
      ..dup .length 1 - sb.setLength ## ensure there is a zero-terminator after the last character
    end
    ..dup sb.asStr 0 1 FilePosition new ..dup FileState new =:: mut: fileState
    progContext [] .progFiles .length FileId cast =:: fileId
    progContext [] .progFiles
      ..over fileId progContext [] .idContext @ newProgFile list.append
    progContext [] .progFiles =
    state [] .globalInterpreters
      ## InterpreterInfo
        progContext fileId InterpreterType .PARSER interpreter.wrapProgram
        0
      InterpreterInfo new list.append
    state [] .globalInterpreters =
  state [] .currentFile
    progContext [] .progFiles .length 1 - FileId cast state [] .currentFile =
    ..swap ..dup .data ..swap .length 1 + #+include zero-terminator after file-name+# io.OPEN_READ io.fopen
      ..dup io.FILE_ERROR_NONE != if
        ..swap ..drop ## discard code file
        ..swap state [] .currentFile = ## reset file id
        FILE_ID_NONE ..swap return
      end ..drop =:: f
      128 sb.create
        '\n' sb.appendC
        f sb.appendFile =:: err
        '\n' sb.appendC
      =:: fileBody
    f io.fclose ..dup io.FILE_ERROR_NONE != err io.FILE_ERROR_NONE != | if
      ..swap state [] .currentFile = ## reset file id
      err io.FILE_ERROR_NONE != if ..drop
        FILE_ID_NONE err return
      else
        FILE_ID_NONE ..swap return
      end
    end ..drop
    state [] .openBlocks .length =:: blockCount
    fileState @
      fileBody sb.asStr while
        ..over nextToken ..over.2 state parseOperation
        ..dup .length 0 >
      do end ..drop
    ..drop
    fileBody sb.free ..drop
    state [] .currentFile ..swap
  state [] .currentFile =
  state [] .openBlocks .length blockCount > if
    ## XXX? print start of last block
    "unclosed block at end of file" sb.wrap
      fileState .currentPos
    state appendError2
  else state [] .openBlocks .length blockCount < _if
    "file closed additional code block" sb.wrap
      fileState .currentPos
    state appendError2
  end
  io.FILE_ERROR_NONE return
end
