#include stringIO
#include list
#include arrayView

#include future

#include "files.concat"
#include "labels.concat"
#include "types.concat"
#include "constants.concat"
#include "codeBlocks.concat"
#include "identifiers.concat"

entryPoint:
  "./test.concat" io.OPEN_READ io.fopen #drop =:: f
  128 sb.create
    '\n' sb.appendC
    f sb.appendFile #drop
    '\n' sb.appendC
  sb.toStr parseTokens ##printTokens
end

enum(
                         NOP
                         entryPoint
            ConstValue : Constant
  codeBlocks.BlockInfo : block
  codeBlocks.BlockInfo : blockEnd
     id.IdentifierInfo : getId
     id.IdentifierInfo : setId
     id.IdentifierInfo : declareId
     id.IdentifierInfo : predeclareId
                string : Error
                string : Unknown
) =:: OpValue
struct( OpValue : val FilePosition : pos ) =:: Operation
proc( FilePosition => Operation ) =: opNOP
  OpValue .NOP #swap Operation new return
end
proc( Constant  => Operation ) =: opConst
  #dup .val OpValue .Constant new #swap .pos Operation new return
end
proc( codeBlocks.BlockType FilePosition => Operation ) =: opBlock
  #swap -1 codeBlocks.BlockInfo new OpValue .block new #swap Operation new return
end
proc( codeBlocks.BlockType FilePosition => Operation ) =: opEndBlock
  #swap -1 codeBlocks.BlockInfo new OpValue .blockEnd new #swap Operation new return
end
proc( id.IdentifierInfo FilePosition  => Operation ) =: opGet
  #swap OpValue .getId new #swap Operation new return
end
proc( id.IdentifierInfo FilePosition  => Operation ) =: opSet
  #swap OpValue .setId new #swap Operation new return
end
proc( id.IdentifierInfo FilePosition  => Operation ) =: opDeclare
  #swap OpValue .declareId new #swap Operation new return
end
proc( id.IdentifierInfo FilePosition  => Operation ) =: opPredeclare
  #swap OpValue .predeclareId new #swap Operation new return
end
proc( FilePosition => Operation ) =: opEntryPoint
  OpValue .entryPoint #swap Operation new return
end
proc( string FilePosition  => Operation ) =: opError
  #swap OpValue .Error new #swap Operation new return
end
proc( string FilePosition  => Operation ) =: opUnknown
  #swap OpValue .Unknown new #swap Operation new return
end
struct(
    types.TypeContext : mut typeContext
 id.IdentifierContext : mut idContext
        Constant list : mut constants
                  i64 : mut constOffset
      types.Type list : mut typeBuffer
 types.ArraySize list : mut arraySizeBuffer
       Operation list : mut ops
) =:: ParserState
proc( Operation ParserState ptr => ) =: printOp
  =:: context
  64 sb.create
    #over .val switch
      NOP case
        "NOP" sb.appendS
        break
      entryPoint case
        "entryPoint" sb.appendS
        break
      OpValue .Constant case
        "Constant: " sb.appendS
        #over .val .Constant #swap ## XXX extract to sb.appendConstValue
          #over switch
            none case
              "none"  sb.appendS
              break
            wildCard case
              "_"  sb.appendS
              break
            boolean case
              "boolean " sb.appendS
              #over .boolean if "true" sb.appendS else "false" sb.appendS end
              break
            int case
              "integer "  sb.appendS
              #over .int sb.appendI
              break
            str case
              "string \""  sb.appendS
              #over .str context [] .idContext .labelContext addrOf id.scAsStr  sb.appendStr
                     '\"'  sb.appendC
              break
            chr case
              "char \'"  sb.appendS
              #over .chr sb.appendC
                   '\''  sb.appendC
              break
            typeId case
              "type \'"     sb.appendS
              #over .typeId context [] .typeContext addrOf sb.appendType
                   '\''     sb.appendC
              break
          end
        #swap #drop
        break
      block case
        "Block: " sb.appendS
        #over .val .block .blockType sb.appendBlockType
        break
      blockEnd case
        "End: " sb.appendS
        #over .val .blockEnd .blockType sb.appendBlockType
        break
      getId case
        "get: " sb.appendS
        #over .val .getId context [] .idContext .labelContext @ sb.appendIdInfo
        break
      setId case
        "set: " sb.appendS
        #over .val .setId context [] .idContext .labelContext @ sb.appendIdInfo
        break
      declareId case
        "declare: " sb.appendS
        #over .val .declareId context [] .idContext .labelContext @ sb.appendIdInfo
        break
      predeclareId case
        "predeclare: " sb.appendS
        #over .val .predeclareId context [] .idContext .labelContext @ sb.appendIdInfo
        break
      Error case
        "Error: " sb.appendS
        #over .val .Error sb.appendStr
        break
      Unknown case
        "Unknown Operation: " sb.appendS
        #over .val .Unknown sb.appendStr
        break
    end
    " at " sb.appendS
    #over .pos .fileName sb.appendStr
    ':' sb.appendC
    #over .pos .line sb.appendI
    ':' sb.appendC
    #over .pos .posInLine sb.appendI
    '\n' sb.appendC
    #swap #drop
  io.stdOut #swap io.fputSb #drop
end


proc( Operation : op ParserState ptr mut : state bool : pushConstants => ) =: appendOpInternal
  state [] .ops
    pushConstants if
      0 while #dup state [] .constants .length < do
        #swap
          state [] .constants #over:2 list.get opConst list.append
        #swap
        1 +
      end #drop
      state [] .constants list.clear state [] .constants =
    end
    op list.append
  state [] .ops  =
end
proc( Operation ParserState ptr mut => ) =: appendOp
  true appendOpInternal
end
proc( Operation ParserState ptr mut => ) =: appendError
  false appendOpInternal
end
proc( Constant : const ParserState ptr mut : state => ) =: pushConst
  state [] .constants const list.append state [] .constants  =
end
proc( ParserState ptr mut : state => bool ) =: hasConst
  state [] .constants .length 0 > return
end

proc( ParserState ptr mut : state => Constant ) =: popConst
  state [] .constants
    list.pop #swap state [] .constants =
  return
end
proc( FileState ptr mut : fileState ParserState ptr mut : state => types.Type bool ) =: popTypeConstant
  state [] .constants .length state [] .constOffset <= if ## XXX more descriptive messages
    "missing type constant" string.wrap fileState [] .wordStart opError state appendError
     types.Type .undefined true return
  end
  state [] .constants list.peek .data [] .val ConstValue .typeId != if
    "wrong type for constant expected type" string.wrap state [] .constants list.peek .data [] .pos opError state appendError
    types.Type .undefined true return
  end
  state [] .constants list.pop #swap state [] .constants =
    .val .typeId false return
end
proc( FileState ptr mut : fileState ParserState ptr mut : state => types.ArraySize arrayView bool #+fixed-size+# ) =: popArraySize
  state [] .constants .length state [] .constOffset <= if
    types.ArraySize array.empty true return
  end
  state [] .constants list.peek .data [] .val ConstValue .wildCard == if
    state [] .constants list.pop #drop state [] .constants = ## remove wildcard constant
    types.ArraySize array.empty false return
  end
  state [] .constants .length 1 - while #dup state [] .constOffset >= do
    state [] .constants #over list.get .val ConstValue .int != if ## TODO support generic sizes
      break
    end
    1 -
  end
  1 + ##revert last decrement
  #dup
  state [] .arraySizeBuffer
    list.clear
    #over state [] .constOffset - list.ensureCap
    #swap while #dup state [] .constants .length < do
      #swap
        ## XXX check if generic
        state [] .constants #over:2 list.get .val .int true types.ArraySize new list.append
      #swap
      1 +
    end #drop
  state [] .arraySizeBuffer =
  state [] .constants .length =
  state [] .arraySizeBuffer list.asArray true return
end
proc( i64 : n FileState ptr mut : fileState ParserState ptr mut : state => types.Type arrayView bool ) =: popTypeConstants
  state [] .constants .length state [] .constOffset n + < if
    "missing type constant" string.wrap fileState [] .wordStart opError state appendError
     types.Type array.empty true return
  end
  state [] .typeBuffer list.clear state [] .typeBuffer =
  state [] .constants .length n -
    #dup while #dup state [] .constants .length < do
      state [] .constants #over list.get .val ConstValue .typeId != if #drop:2
        "wrong type for constant, expected type" string.wrap state [] .constants list.peek .data [] .pos opError state appendError
         types.Type array.empty true return
      end
      state [] .typeBuffer state [] .constants #over:2 list.get .val .typeId list.append state [] .typeBuffer =
      1 +
    end #drop
  state [] .constants .length =
  state [] .typeBuffer list.asArray false return
end

proc( ParserState ptr mut : state => i64 ) =: offsetConstants
  state [] .constOffset
    state [] .constants .length state [] .constOffset =
  return
end
proc( i64 ParserState ptr mut => ) =: resetConstants
  [] .constOffset =
end

proc( string : code FileState ptr mut : fileState  ParserState ptr mut : state => string string ) =: nextWord
  code
    fileState nextToken
    #dup Token .IDENTIFER != if
      "expected identifier" string.wrap fileState [] .wordStart opError  state appendError
    end
    .IDENTIFER
  return
end
proc( string : code string : start FileState ptr mut : fileState  ParserState ptr mut : state => string id.LabelId ) =: readLabel
  0 id.LabelFlag =: mut flags
  false =:: mut isModifer
  code start
    while
      false isModifer =
      #dup "mut" string.wrap string.eq if
        id.FLAG_MUTABLE flags | flags =
        true isModifer =
      else #dup "static" string.wrap string.eq _if
        id.FLAG_STATIC flags | flags =
        true isModifer =
      else #dup "extern" string.wrap string.eq _if
        id.FLAG_EXTERN flags | flags =
        true isModifer =
      else #dup "public" string.wrap string.eq _if
        id.FLAG_PUBLIC flags | flags =
        true isModifer =
      else #dup "private" string.wrap string.eq _if
        id.FLAG_PRIVATE flags | flags =
        true isModifer =
      end
      isModifer ! if
        break
      end
    isModifer do #drop
      fileState nextToken
      #dup Token .IDENTIFER != if #drop
        "expected identifier" string.wrap state [] .constants list.peek .data [] .pos opError state appendError
        "" string.wrap
      else
        .IDENTIFER
      end
    end
  flags fileState [] .wordStart state [] .idContext .labelContext addrOf id.newLabel return
end
enum( NONE STRUCT ENUM PROC_IN ) =:: LabelType
proc( string : code LabelType : labelType string : endString FileState ptr mut : fileState  ParserState ptr mut : state => string id.LabelId types.Type arrayView bool ) =: readCompositeType
  state offsetConstants =:: prevConstants
  state [] .constants .length =:: constOffset
  labelType LabelType .NONE == if
    id.LABEL_ID_NONE
  else
    state [] .idContext .labelContext addrOf id.labelOffset
  end =:: labelOffset
  code
    while fileState nextToken
      fileState state tryParseConstant if #drop continue end
      #dup endString string.eq if #drop
        ## TODO check if labels balanced
        prevConstants state resetConstants
        labelOffset state [] .constants .length constOffset - fileState state popTypeConstants return
      else #dup ":" string.wrap string.eq _if #drop
        labelType LabelType .NONE == if
          "unexpected ':' operator" string.wrap fileState [] .wordStart opError  state appendError
        end
        state [] .constants .length constOffset - 1 -
        state [] .idContext .labelContext addrOf id.labelOffset labelOffset - - #dup 0 > if
          "two many types for label" string.wrap fileState [] .wordStart opError  state appendError
          while #dup 0 > do
            "" string.wrap id.FLAG_EMPTY fileState [] .wordStart state [] .idContext .labelContext addrOf id.newLabel #drop
            1 -
          end
        else #dup 0 < _if
          "not enough types for label" string.wrap fileState [] .wordStart opError  state appendError
          while #dup 0 < do
            types.Type .undefined fileState [] .wordStart constType  state pushConst
            1 +
          end
        end #drop
        fileState nextToken
        #dup Token .IDENTIFER != if
          "expected identifier" string.wrap fileState [] .wordStart opError  state appendError
        end
        .IDENTIFER
        fileState state readLabel #drop
        continue
      end
      labelType LabelType .ENUM != if
        64 sb.create
          "unknown type name " sb.appendS
          #over sb.appendStr
        sb.toStr fileState [] .wordStart opError  state appendError
        #drop
        types.Type .undefined fileState [] .wordStart constType  state pushConst
        continue
      end
        state [] .constants .length constOffset -
        state [] .idContext .labelContext addrOf id.labelOffset labelOffset - - #dup 0 > if
          "unexpected label in enum, expected ':' " string.wrap fileState [] .wordStart opError  state appendError
          while #dup 1 > do
            "" string.wrap id.FLAG_EMPTY fileState [] .wordStart state [] .idContext .labelContext addrOf id.newLabel #drop
            1 -
          end #drop
          fileState state readLabel #drop
          continue
        else #dup 0 < _if
          "not enough types for label" string.wrap fileState [] .wordStart opError  state appendError
          while #dup 0 < do
            types.Type .undefined fileState [] .wordStart constType  state pushConst
            1 +
          end
        end #drop
      id.FLAG_NONE fileState [] .wordStart state [] .idContext .labelContext addrOf id.newLabel #drop
      types.Type .undefined fileState [] .wordStart constType  state pushConst
      #dup .length 0 >
    do end
  "unexpected end of file" string.wrap fileState [] .wordStart opError  state appendError
  id.LABEL_ID_NONE types.Type array.empty true return
end
proc( string : code Token : token FileState ptr mut : fileState  ParserState ptr mut : state => string string bool ) =: tryParseConstant
  code
    token switch
      EMPTY case
        "" string.wrap true return
      STRING case
        token .STRING state [] .idContext .labelContext addrOf id.newStringConstant fileState [] .wordStart constStr  state pushConst
        "" string.wrap true return
      CHAR case
        token .CHAR
          state [] .idContext .labelContext addrOf id.newStringConstant ## escape character
          #dup .length 1 != if
            "A character literal has to contain exactly one character" string.wrap fileState [] .wordStart opError  state appendError
          end
          state [] .idContext .labelContext addrOf id.scAsStr
          0 string.charAt
        fileState [] .wordStart constChar state pushConst
        "" string.wrap true return
      INTEGER case
        token .INTEGER fileState [] .wordStart constInt  state pushConst
        "" string.wrap true return
      ERROR case
        token .ERROR fileState [] .wordStart opError  state appendError
        "" string.wrap true return
      IDENTIFER case
        token .IDENTIFER
        break
    end
    #dup "_" string.wrap string.eq if
      fileState [] .wordStart constWildcard  state pushConst
      true return
    else #dup "true" string.wrap string.eq _if
      true fileState [] .wordStart constBool  state pushConst
      true return
    else #dup "false" string.wrap string.eq _if
      false fileState [] .wordStart constBool  state pushConst
      true return
    else #dup "bool" string.wrap string.eq _if
      types.primitive.BOOL fileState [] .wordStart constType  state pushConst
      true return
    else #dup "i8" string.wrap string.eq _if
      types.primitive.I8 fileState [] .wordStart constType  state pushConst
      true return
    else #dup "i32" string.wrap string.eq _if
      types.primitive.I32 fileState [] .wordStart constType  state pushConst
      true return
    else #dup "i64" string.wrap string.eq _if
      types.primitive.I64 fileState [] .wordStart constType  state pushConst
      true return
    else #dup "float" string.wrap string.eq _if
      types.primitive.FLOAT fileState [] .wordStart constType  state pushConst
      true return
    else #dup "type" string.wrap string.eq _if
      types.primitive.TYPE fileState [] .wordStart constType  state pushConst
      true return
    else #dup "ptr" string.wrap string.eq _if
      fileState state popArraySize =:: fixedSize =:: sizes
      fileState state popTypeConstant if #drop
        types.Type .undefined fileState [] .wordStart constType  state pushConst
        true return
      end
      true sizes fixedSize false state [] .typeContext addrOf types.newArrayType if #drop
        types.Type .undefined fileState [] .wordStart constType  state pushConst
        "could not create pointer type" string.wrap fileState [] .wordStart opError  state appendError
        true return
      end
        fileState [] .wordStart constType  state pushConst
      true return
    else #dup "array" string.wrap string.eq _if
      fileState state popArraySize =:: fixedSize =:: sizes
      fileState state popTypeConstant if #drop
        types.Type .undefined fileState [] .wordStart constType  state pushConst
        true return
      end
      false sizes fixedSize false state [] .typeContext addrOf types.newArrayType if #drop
        types.Type .undefined fileState [] .wordStart constType  state pushConst
        "could not create array type" string.wrap fileState [] .wordStart opError  state appendError
        true return
      end
        fileState [] .wordStart constType  state pushConst
      true return
    else #dup "mut" string.wrap string.eq _if
      fileState state popTypeConstant if #drop
        types.Type .undefined fileState [] .wordStart constType  state pushConst
        true return
      end
      ## TODO make type mutable
      fileState [] .wordStart constType  state pushConst
      true return
    else #dup "(" string.wrap string.eq  #over "tuple(" string.wrap string.eq | #over "struct(" string.wrap string.eq | _if
      "struct(" string.wrap string.eq if
        LabelType .STRUCT ")" string.wrap fileState state readCompositeType
      else
        LabelType .NONE ")" string.wrap fileState state readCompositeType
      end
      if
        "error while parsing tuple type" string.wrap fileState [] .wordStart opError  state appendError
      end
      #swap state [] .typeContext addrOf types.newTuple if
        "error while creating tuple type" string.wrap fileState [] .wordStart opError  state appendError
      end
      fileState [] .wordStart constType  state pushConst
      "" string.wrap true return
    else #dup "enum(" string.wrap string.eq _if #drop
      LabelType .ENUM ")" string.wrap fileState state readCompositeType
      if
        "error while parsing enum type" string.wrap fileState [] .wordStart opError  state appendError
      end
      #swap false state [] .typeContext addrOf types.newEnum if
        "error while creating enum type" string.wrap fileState [] .wordStart opError  state appendError
      end
      fileState [] .wordStart constType  state pushConst
      "" string.wrap true return
    else #dup "proc(" string.wrap string.eq _if #drop
      LabelType .PROC_IN "=>" string.wrap fileState state readCompositeType
      if
        "error while parsing procedure arguments" string.wrap fileState [] .wordStart opError  state appendError
      end
      #swap false state [] .typeContext addrOf types.newProcArgs if
        "error while creating procedure arguments" string.wrap fileState [] .wordStart opError  state appendError
      end
      =:: in
      LabelType .NONE ")" string.wrap fileState state readCompositeType
      if
        "error while parsing procedure return values" string.wrap fileState [] .wordStart opError  state appendError
      end
      #swap true state [] .typeContext addrOf types.newProcArgs if
        "error while creating procedure return values" string.wrap fileState [] .wordStart opError  state appendError
      end
      in #swap state [] .typeContext addrOf  types.newProcedure if
        "error while creating procedure type" string.wrap fileState [] .wordStart opError  state appendError
      end
      fileState [] .wordStart constType  state pushConst
      "" string.wrap true return
    end
    ## TODO check if name is constant identifier
  false return
end
proc( string : code Token : token FileState ptr mut : fileState  ParserState ptr mut : state => string ) =: parseOperation
  code
    token fileState state tryParseConstant if
      #drop return
    end
    #dup 0 string.charAt '#' == if ## compiler command
      1 string.tail
        "include" string.wrap #over string.eq if #drop
          fileState nextToken
          #dup Token .STRING == if .STRING
            ## TODO include local file
            #drop
            return
          else #dup Token .IDENTIFER == _if .IDENTIFER
            ## TODO include library file
            #drop
            return
          end
          64 sb.create
            "invalid token for include" sb.appendS
            #swap appendToken
          sb.toStr fileState [] .wordStart opError  state appendError
          return
        end
      64 sb.create
        "unknown compiler command \"" sb.appendS
        #swap                         sb.appendStr
        '\"'                          sb.appendC
      sb.toStr fileState [] .wordStart opError  state appendError
      return
    else #dup ":" string.wrap string.eq
       #over "=:" string.wrap string.eq | _if
      "=:" string.wrap string.eq =:: isInit
      fileState state nextWord fileState state readLabel
        fileState state popTypeConstant #drop =:: valType
        valType
          #dup types.isProcedure if
            ## TODO check for declaration of non-extern procedures
            id.IdentifierType .PROCEDURE new ## TODO automatically convert label at end of if to enum-value
          else #dup types.primitive.TYPE types.typeEquals _if
            ## TODO create constant for declarations
            id.IdentifierType .TYPE new
          else state [] .idContext @ id.isGlobal _if
            id.IdentifierType .GLOBAL_VAR new
          else
            id.IdentifierType .LOCAL_VAR new
          end
        isInit state hasConst & if
          state popConst .val
          ## TODO check if type correct
        else
          ConstValue .none new
        end
      fileState [] .wordStart state [] .idContext @ id.declareIdentifier if #drop
        .name fileState [] .wordStart opError  state appendError
        return
      end
      #dup [] .idType id.IdentifierType .TYPE == if
        #drop:2
        return
      end
      #dup [] .idType id.IdentifierType .PROCEDURE == isInit & if
        state [] .idContext @ id.isGlobal ! if
          "procedures have to be declared at global level" string.wrap fileState [] .wordStart opError  state appendError
        end
        codeBlocks.BlockType .PROCEDURE valType state [] .idContext @ id.openProcScope
        ## TODO declare procedure label variables
      end
      id.asIdInfo fileState [] .wordStart isInit if
        opDeclare
      else
        opPredeclare
      end
      state appendOp
      #drop return
    else #dup "=::" string.wrap string.eq _if #drop
      "unimplemented" string.wrap fileState [] .wordStart opError  state appendError
      return
    else #dup "entryPoint:" string.wrap string.eq _if #drop
      codeBlocks.BlockType .PROCEDURE types.Type .undefined state [] .idContext @ id.openProcScope
      fileState [] .wordStart opEntryPoint  state appendOp
      return
    else #dup "if" string.wrap string.eq _if #drop
      codeBlocks.BlockType .IF  fileState [] .wordStart opBlock  state appendOp
      codeBlocks.BlockType .IF  state [] .idContext @ id.openScope
      return
    else #dup "_if" string.wrap string.eq _if #drop
      state [] .idContext @ id.currentScopeType codeBlocks.BlockType .ELSE != if
        "'_if' is only allowed in else-blocks" string.wrap fileState [] .wordStart opError  state appendError
        return
      end
      codeBlocks.BlockType ._IF fileState [] .wordStart opBlock  state appendOp
      codeBlocks.BlockType .IF  state [] .idContext @ id.updateScopeType #drop
      return
    else #dup "else" string.wrap string.eq _if #drop
      state [] .idContext @ id.closeScope #swap codeBlocks.BlockType .IF != | if
        "'else' is only allowed in if-blocks" string.wrap fileState [] .wordStart opError  state appendError
        return
      end
      codeBlocks.BlockType .ELSE  fileState [] .wordStart opBlock  state appendOp
      codeBlocks.BlockType .ELSE  state [] .idContext @ id.openScope
      return
    else #dup "while" string.wrap string.eq _if #drop
      codeBlocks.BlockType .WHILE  fileState [] .wordStart opBlock  state appendOp
      codeBlocks.BlockType .WHILE  state [] .idContext @ id.openScope
      return
    else #dup "do" string.wrap string.eq _if #drop
      state [] .idContext @ id.closeScope #swap codeBlocks.BlockType .WHILE != | if
        "'do' is only allowed in while-blocks" string.wrap fileState [] .wordStart opError  state appendError
        return
      end
      codeBlocks.BlockType .DO  fileState [] .wordStart opBlock  state appendOp
      codeBlocks.BlockType .DO  state [] .idContext @ id.openScope
      return
    else #dup "break" string.wrap string.eq _if #drop
      codeBlocks.BlockType .BREAK  fileState [] .wordStart opBlock  state appendOp
      return
    else #dup "continue" string.wrap string.eq _if #drop
      codeBlocks.BlockType .CONTINUE  fileState [] .wordStart opBlock  state appendOp
      return
    else #dup "switch" string.wrap string.eq _if #drop
      codeBlocks.BlockType .SWITCH  fileState [] .wordStart opBlock  state appendOp
      codeBlocks.BlockType .SWITCH  state [] .idContext @ id.openScope
      return
    else #dup "case" string.wrap string.eq _if #drop
      state [] .idContext @ id.closeScope #swap #dup codeBlocks.BlockType .SWITCH != #swap codeBlocks.BlockType .CASE != & | if
        "'case' is only allowed in switch-blocks" string.wrap fileState [] .wordStart opError  state appendError
        return
      end
      codeBlocks.BlockType .CASE  fileState [] .wordStart opBlock  state appendOp
      codeBlocks.BlockType .CASE  state [] .idContext @ id.openScope
      return
    else #dup "default" string.wrap string.eq _if #drop
      state [] .idContext @ id.closeScope #swap codeBlocks.BlockType .CASE != | if
        "'default' is only allowed in switch-case-blocks" string.wrap fileState [] .wordStart opError  state appendError
        return
      end
      codeBlocks.BlockType .DEFAULT  fileState [] .wordStart opBlock  state appendOp
      codeBlocks.BlockType .DEFAULT  state [] .idContext @ id.openScope
      return
    else #dup "return" string.wrap string.eq _if #drop
      state [] .idContext @ id.currentScopeProc
        #dup types.Type .undefined types.typeEquals if
          "return outside procedure" string.wrap fileState [] .wordStart opError  state appendError
        end
      #drop
      ## TODO store return type in return operation
      "unimplemented" string.wrap fileState [] .wordStart opError  state appendError
      return
    else #dup "end" string.wrap string.eq _if #drop
      state [] .idContext @ id.closeScope if #drop
        "unexpected 'end'" string.wrap fileState [] .wordStart opError  state appendError
        return
      end
        fileState [] .wordStart opEndBlock  state appendOp
      return
    end
  #dup state [] .idContext @ id.getIdentifier ! if ## try parsing as identifier
    id.asIdInfo fileState [] .wordStart opGet state appendOp
    #drop:2
    return
  end #drop:2
  fileState [] .wordStart opUnknown  state appendOp
  return
end
proc( string => ) =: parseTokens
  "test" #dup .length string.create 0 1 FilePosition new #dup FileState new =:: mut fileState
  ## ParserState
    types.newTypeContext
    id.newIdentifierContext
    128 Constant   list.create 0
    128 types.Type list.create
    128 types.ArraySize list.create
    128 Operation  list.create
  ParserState new =:: mut state
  fileState addrOf #swap
    while
      #over nextToken #over:2 state addrOf parseOperation
      #dup .length 0 >
    do end #drop
  #drop
  0 while #dup state .ops .length < do
    state .ops #over list.get state addrOf printOp
    1 +
  end #drop
end
