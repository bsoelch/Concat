     else opName "..types.size" string.wrap string.eq _if
       TypeMemoryInfo .SIZE
     else
       TypeMemoryInfo .STRIDE
     end =:: infoType
      Type .undefined
      infoType fileState [] .wordStart opTypeInfo state appendOp
      return
    else ..dup "..unreachable" string.wrap string.eq _if ..drop
      fileState [] .wordStart opUnreachable state appendOp
      return
    else ..dup "ptr" string.wrap string.eq _if ..drop
      TypeModifier .PTR fileState [] .wordStart opTypeModifier state appendOp
      return
    else ..dup "ptr.mut" string.wrap string.eq _if ..drop
      TypeModifier .PTR_MUT fileState [] .wordStart opTypeModifier state appendOp
      return
    else ..dup "array" string.wrap string.eq _if ..drop
      TypeModifier .ARRAY fileState [] .wordStart opTypeModifier state appendOp
      return
    else ..dup "..dup" string.wrap string.eq _if =:: opName ## XXX? completely repalce ..dup by $ ?
      0 StackModType .COPY fileState [] .wordStart opStackMod state appendOp
      return
    else ..dup "..over" string.wrap string.eq or
         ..dup "..over." string.wrap string.startsWith  _if =:: mut: opName
      opName "..over." ..length string.tail =:: params
      "..over" string.wrap opName =
      params opName fileState [] .wordStart state getCompilerOpParam ## :offset
      StackModType .COPY fileState [] .wordStart opStackMod state appendOp
      return
    else ..dup "$" string.wrap string.eq or ..dup "$0" string.wrap string.eq _if =:: opName
      0 StackModType .COPY fileState [] .wordStart opStackMod state appendOp
      return
    else ..dup 0 string.charAt '$' == and ..dup .length 1 >= and
        ..dup 1 string.charAt '0' >= and ..dup 1 string.charAt '9' <= _if =:: mut: opName
      opName 1 string.tail =:: params
      "$" string.wrap opName =
      params opName fileState [] .wordStart state getCompilerOpParam ## :offset
      StackModType .COPY fileState [] .wordStart opStackMod state appendOp
      return
    else ..dup "..swap" string.wrap string.eq _if =:: opName
      1 StackModType .SWAP fileState [] .wordStart opStackMod state appendOp
      return
    else ..dup "..drop" string.wrap string.eq or
         ..dup "..drop." string.wrap string.startsWith _if =:: mut: opName
      opName "..drop." ..length string.tail =:: params
      "..drop" string.wrap opName =
      params opName fileState [] .wordStart state getCompilerOpParam ## :count
      StackModType .DROP fileState [] .wordStart opStackMod state appendOp
      return
    else ..dup "import" string.wrap string.eq _if =:: opName
      fileState nextToken ## XXX? distinquish string types
      ..dup .STRING ?? if .STRING .value ## local file
        ## TODO? allow ignoring name of current folder (search base-path, then current folder)
        state [] .basePath .length ..over .length + sb.create
          state [] .basePath sb.appendStr
          ..swap sb.appendStr
        fileState [] .wordStart state importFile
        return
      else ..dup .IDENTIFIER ?? _if .IDENTIFIER ## library file
        fileState [] .wordStart state importLibraryFile return
      end
      64 sb.create
        "invalid parameter for " sb.appendS
        opName sb.appendStr
        ':' sb.appendC
        ..swap sb.appendToken
        " expected identifier or string" sb.appendS
      fileState [] .wordStart errors appendError
      return
    else ..dup "using" string.wrap string.eq _if =:: opName
      fileState nextToken
      ..dup .IDENTIFIER ?? ! if ..drop ## XXX? print type of actual token
        "namespace names have to be identifiers" sb.wrap fileState [] .wordStart errors appendError
        return
      end .IDENTIFIER
      ..dup id.FLAG_NONE fileState [] .wordStart state [] .currentFile labelContext id.newLabel
      idContext id.importNamespace if
        "namespace \"" sb.wrap
          ..swap sb.appendStr
        "\" does not exist" sb.appendS fileState [] .wordStart errors appendError
      else ..drop end
      return
    else $ "assert" string.wrap string.eq _if =:: opName
      ## opAssert
        fileState [] .wordStart
      opAssert state appendOp
      return
    else $ "..compiler.error" string.wrap string.eq
        or $ "..compiler.warning" string.wrap string.eq
        or $ "..compiler.info" string.wrap string.eq _if =:: opName
      ## create error/warning/info if operation is reachable
      opName "..compiler.error" string.wrap string.eq if
        ErrorType .ERROR
      else opName "..compiler.warning" string.wrap string.eq _if
        ErrorType .WARNING
      else opName "..compiler.info" string.wrap string.eq _if
        ErrorType .INFO
      else
        "unexpected error type: " sb.wrap
          opName sb.appendStr
        fileState [] .wordStart errors appendError
        ErrorType .ERROR
      end =:: errorType
      ## opError
        errorType
        fileState [] .wordStart
      opError state appendOp
      return
    else $ "..compiler.flag." string.wrap string.startsWith _if
      "..compiler.flag." ..length string.tail =:: flagName
      ## XXX? treat compiler constants as variables, allow :? operator to check if constant exists
      flagName "experimental" string.wrap string.eq if
        _EXPERIMENTAL_ ConstValue .Bool
        types.primitive.BOOL
      else flagName "foldConstants" string.wrap string.eq _if
        _FOLD_CONSTANTS_ ConstValue .Bool
        types.primitive.BOOL
      else flagName "noCore" string.wrap string.eq _if
        _INCLUDE_CORE_ ! ConstValue .Bool
        types.primitive.BOOL
      else flagName "wError" string.wrap string.eq _if
        _W_ERROR_ ConstValue .Bool
        types.primitive.BOOL
      else flagName "incrementVersionNumber" string.wrap string.eq _if
        _INCREMENT_VERSION_ ConstValue .Bool
        types.primitive.BOOL
      else
        ConstValue .None
        Type .empty
      end
      fileState [] .wordStart opConst state appendOp
      return
    else $ "..compiler.version" string.wrap string.eq _if ..drop
      _VERSION_ ConstValue .Int
      types.primitive.I64
      fileState [] .wordStart opConst state appendOp
      return
    else $ "..compiler.return" string.wrap string.eq _if ..drop
      ..drop ## discard remainder of file
      ## close open if-blocks/switch-branches
      while state [] .openBlocks list.peek =:: next?
          BlockType ..length 38 == "no new block types" assert
          next? optional.hasData and next? .data [] .blockType switch
            IF IF_TRUE IF_FALSE ELSE ELSE_TRUE ELSE_FALSE CASE DEFAULT case true break
            default false break
          end do
        state [] .openBlocks
          list.pop ..drop
        state [] .openBlocks =
      end
      string.empty return
    else $ "..file" string.wrap string.eq _if ..drop
      fileState [] .wordStart .fileName =:: name
      name constContext newStringConst
      types.primitive.CHAR8
        types.ArrayType .POINTER
        name .length types.ArraySize .int =:: size
        size@ 1 array.create
        false
      typeContext types.newArrayType ..drop
      fileState [] .wordStart opConst state appendOp
      return
    else $ "..line" string.wrap string.eq _if ..drop
      fileState [] .wordStart .line ConstValue .Int
      types.primitive.I64
      fileState [] .wordStart opConst state appendOp
      return
    else ..dup "..?types" string.wrap string.eq or
        ..dup "..?types." string.wrap string.startsWith _if =:: mut: opName
      opName "..?types." ..length string.tail =:: params
      "..?types" string.wrap opName =
      -1 =:: mut: count
      0 =:: mut: depth
      params .length 0 > if
        params '.' string.split =:: head =:: tail
        head .length 0 > if
          head
            opName
            fileState [] .wordStart
          state getCompilerOpParam count =
        end
        tail .length 0 > if
          tail
            opName
            fileState [] .wordStart
          state getCompilerOpParam depth =
        end
      end
      ## opTypesInfo
        count
        depth
        fileState [] .wordStart
      opTypesInfo state appendOp
      return
    else ..dup "..?stack" string.wrap string.eq or
        ..dup "..?stack." string.wrap string.startsWith _if =:: mut: opName
      opName "..?stack." ..length string.tail =:: params
      "..?stack" string.wrap opName =
      params .length 0 > if
        params opName fileState [] .wordStart state getCompilerOpParam
      else -1 end
      fileState [] .wordStart opStackInfo state appendOp
      return
    else ..dup "..?ops" string.wrap string.eq or
        ..dup "..?ops." string.wrap string.startsWith _if =:: mut: opName
      opName "..?ops." ..length string.tail =:: params
      "..?ops" string.wrap opName =
      params .length 0 > if
        params opName fileState [] .wordStart state getCompilerOpParam
      else -1 end
      fileState [] .wordStart opPrintCompiledOps state appendOp
      return
    ## XXX ..?parser.ops
    else ..dup "..?find." string.wrap string.startsWith _if =:: mut: opName
      opName "..?find." ..length string.tail =:: idName
      ## opPrintIdentifierMatches
        idName
          id.FLAG_NONE
          fileState [] .wordStart
          state [] .currentFile
        labelContext id.newLabel
        fileState [] .wordStart
      opPrintIdentifierMatches state appendOp
      return
    else ..dup "..?parser.find." string.wrap string.startsWith _if =:: mut: opName
        opName "..?parser.find." ..length string.tail =:: idName
        16 IdentifierMatch list.create =:: mut: matches
        idName state [] .currentFile idContext matches@ optional.wrap id.searchIdentifier ..drop.3
        "-----------------\n" sb.wrap
          "identifier \"" sb.appendS idName sb.appendStr "\":\n" sb.appendS
          0:i64 while ..dup matches .length < do =:: i
            matches i list.at .data =:: match
            match [] .labelId idContext id.getIdentifier
              ! "matched identifier exists" assert
            =:: idData
            " - " sb.appendS
            idData id.asIdInfo labelContext sb.appendIdInfo
            " ( " sb.appendS
            idData [] .valueType typeContext sb.appendType
            idData [] .constValue .None ?? ! if
              " [ " sb.appendS
              idData [] .constValue typeContext sb.appendConstant
              " ]" sb.appendS
            end
            " ) declared at " sb.appendS
            match [] .labelId labelContext id.labelPos =:: pos?
            pos? optional.hasData if
              pos? .data sb.appendPos
            else
              "?" sb.appendS
            end
            '\n' sb.appendC
            i 1 +
          end ..drop
          "-----------------\n" sb.appendS
          io.stdOut ..over io.fputSb ..drop
        sb.free ..drop
        matches list.free ..drop
        return
    else ..dup "begin" string.wrap string.eq or
         ..dup "defer" string.wrap string.eq _if =:: opName
      "`" sb.wrap
        opName sb.appendStr
        "` is a reserved keyword for a future language version" sb.appendS
      fileState [] .wordStart errors appendError
      return
    end
    ..dup "@" string.wrap string.endsWith =:: isAddr
    isAddr if
      ..dup .length 1 - string.head
    end
  =:: idName
  idName
    state [] .currentFile
  idContext id.findIdentifierByName ! if ## try parsing as identifier
    isAddr ! and $ [] .idType .ARGUMENT ?? and
        $ [] .labelId labelContext id.labelFlags =:: flags
        flags id.FLAG_AUTO & ? and flags id.FLAG_STATIC & ? ! if
      ## opConst
        $ [] .labelId ConstValue .GenericArg
        ..swap [] .valueType
        fileState [] .wordStart
      opConst state appendOp
      return
    end
    ..dup [] .valueType ..swap id.asIdInfo fileState [] .wordStart
      isAddr if opAtId else opGetId end
    state appendOp
    return
  end ..drop
  idName
    id.FLAG_NONE fileState [] .wordStart state [] .currentFile
  labelContext id.newLabel =:: labelId
  labelId fileState [] .wordStart
  isAddr if opAtName else opGetName end
  state appendOp
  return
end
proc( io.IOError : err stringBuilder : fileName FilePosition : pos ParserState ptr.mut : state -> ) =>: checkIOError
  state [] .progContext@ =:: progContext
  progContext [] .errors@ =:: errors
  using io
  err switch
    FILE_ERROR_NONE case
      return
    FILE_ERR_PATH_OVERFLOW FILE_ERR_OPEN_MODE FILE_ERR_FILE_NOT_FOUND FILE_ERR_FILE_IS_DIR FILE_ERR_ACCESS_DENIED FILE_ERR_INVALID_FILE case
      "cannot include file \"" sb.wrap fileName sb.appendSb '"' sb.appendC pos errors appendError
      return
    default
      "error while reading file \"" sb.wrap fileName sb.appendSb '"' sb.appendC pos errors appendError
      return
  end
end

proc( string FilePosition : pos ParserState ptr.mut : state -> ) =>: importLibraryFile
  state [] .libPath .length $1 .length + ".concat" ..length + sb.create
    state [] .libPath sb.appendStr
    ..swap sb.appendStr ".concat" sb.appendS
  pos state importFile
end
proc( stringBuilder : fileName FilePosition : pos ParserState ptr.mut : state -> ) =>: importFile
  state [] .progContext =:: progContext
  FILE_ID_NONE =:: mut: imported
  0:i64 while ..dup progContext [] .progFiles .length < do
    progContext [] .progFiles ..over list.get .fileName sb.asStr fileName sb.asStr string.eq if
      ..dup FileId cast imported =
      break
    end
    1 +
  end ..drop
  imported FILE_ID_NONE == if ## file has not yet been imported
    fileName state parseFile fileName pos state checkIOError imported =
  end
  progContext [] .progFiles state [] .currentFile i64 cast list.at .data
  ..dup [] .includedFiles
      imported
      pos
    IncludedFile new list.append
  ..swap [] .includedFiles =
end


proc(
  stringBuilder : rootFile
  string : libPath
  string : basePath
  bool : saveGlobalTokens
-> ProgramContext TypeCheckState ) =>: export: parseProgram
  newProgramContext =:: mut: programContext
  ## FilePosition
    rootFile sb.asStr
    0
    0
  FilePosition new =:: rootPos
  ## initBuiltInProcs
    rootPos
    programContext@
  initBuiltInProcs if
    ## TODO handle error
  end
  programContext@ newTypeCheckState =:: mut: typeChecker
  programContext@ typeChecker@ updateTypeCheckerPointers
  ## ParserState
    basePath
    libPath
    programContext@
    typeChecker@
    64  BlockInfo               list.create
    32  i64                     list.create
    128 Operation               list.create
    0
    128 Type                    list.create
    FILE_ID_NONE
    ProcId                   optional.empty
    128 CompositeConstantOffset list.create
    0   InterpreterInfo         list.create
    128 LabelId                 list.create
    128 sb.create
    saveGlobalTokens
  ParserState new =:: mut: state
  rootFile state@ parseFile rootFile rootPos state@ checkIOError ..drop
  ## cleanup parser memory
  state .typeBuffer list.free ..drop
  state .constantBlocks list.free ..drop
  0:i64 while ..dup state .globalInterpreters .length < do
    state .globalInterpreters
      ..over list.at .data [] .context@
    interpreter.cleanupContext
    1 +
  end ..drop
  state .globalInterpreters list.free ..drop
  state .tmpString sb.free ..drop
  programContext typeChecker return
end
proc( stringBuilder : fileName ParserState ptr.mut : state -> FileId io.IOError ) =>: parseFile
  fileName
    state [] .progContext =:: progContext
    progContext [] .errors@ =:: errors
    ..dup ..over .length 1 - sb.charAt '\x00' != if
      '\x00' sb.appendC ## ensure file-name is zero terminated
      ..dup .length 1 - sb.setLength ## ensure there is a zero-terminator after the last character
    end
    ..dup sb.asStr 0 1 FilePosition new ..dup FileState new =:: mut: fileState
    progContext [] .progFiles .length FileId cast =:: fileId
    progContext [] .progFiles
      ..over fileId progContext [] .idContext@ newProgFile list.append
    progContext [] .progFiles =
    state [] .globalInterpreters
      ## InterpreterInfo
        progContext
          state [] .typeChecker optional.wrap
          fileId
          InterpreterType .GLOBAL
        interpreter.wrapProgram
        0
      InterpreterInfo new list.append
    state [] .globalInterpreters =
  state [] .currentFile
    progContext [] .progFiles .length 1 - FileId cast state [] .currentFile =
    ..swap ..dup .data ..swap .length 1 + #+include zero-terminator after file-name+# io.OPEN_READ io.fopen
      ..dup io.FILE_ERROR_NONE != if
        ..swap ..drop ## discard code file
        ..swap state [] .currentFile = ## reset file id
        FILE_ID_NONE ..swap return
      end ..drop =:: f
      128 sb.create
        '\n' sb.appendC
        f sb.appendFile =:: err
        '\n' sb.appendC
      =:: fileBody
    f io.fclose ..dup io.FILE_ERROR_NONE != err io.FILE_ERROR_NONE != | if
      ..swap state [] .currentFile = ## reset file id
      err io.FILE_ERROR_NONE != if ..drop
        FILE_ID_NONE err return
      else
        FILE_ID_NONE ..swap return
      end
    end ..drop
    state [] .openBlocks .length =:: blockCount
    _INCLUDE_CORE_ if
      "core" string.wrap fileState .currentPos state importLibraryFile
    end
    fileState@
      fileBody sb.asStr while
        ..over nextToken ..over.2 state parseOperation
        ..dup .length 0 >
      do end ..drop
    ..drop
    fileBody sb.free ..drop
    state [] .currentFile ..swap
  state [] .currentFile =
  state [] .openBlocks .length blockCount > if
    ## XXX? print start of last block
    "unclosed block at end of file" sb.wrap
      fileState .currentPos
    errors appendError
  else state [] .openBlocks .length blockCount < _if
    "file closed additional code block" sb.wrap
      fileState .currentPos
    errors appendError
  end
  io.FILE_ERROR_NONE return
end
