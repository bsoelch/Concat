          "not enough types for label" sb.wrap fileState [] .wordStart state appendError2
          while ..dup 0 < do
            Type .undefined fileState [] .wordStart newTypeConst  state pushConst
            1 +
          end
        end ..drop
        fileState nextToken
        ..dup .IDENTIFIER ?? ! if
          "expected identifier" sb.wrap fileState [] .wordStart state appendError2
        end
        .IDENTIFIER
        fileState
        state
        fileState state peekTypeConstant if
          "missing type for label" sb.wrap fileState [] .wordStart state appendError2
        end =:: argType
        labelType .TEMPLATE ?? ! argType types.primitive.TYPE types.typeEquals & if
          id.FLAG_STATIC else 0 LabelFlag cast
        end
        readLabelAddFlags
          state [] .labelBuffer ..over list.append state [] .labelBuffer =
          ..dup idContext [] .typeContext .labelContext @ id.labelFlags id.FLAG_AUTO id.FLAG_STATIC |  & ? if
             labelType .PROC_IN ?? ! labelType .NONE ?? ! & if
               "unexpected label: `static` and `auto` can only be used in procedure arguments\n  values of type `type` are labeled `static` by default" sb.wrap fileState [] .wordStart state appendError2
             end
             argType
           state [] .constants .length constOffset - 1 - state newStaticArg
          else ..drop end
        continue
      end
      labelType .ENUM ?? ! if
        64 sb.create
          "unknown type name " sb.appendS
          ..over sb.appendStr
        fileState [] .wordStart state appendError2
        ..drop
        Type .undefined fileState [] .wordStart newTypeConst  state pushConst
        continue
      end
        state [] .constants .length constOffset -
        state [] .labelBuffer .length labelOffset - - ..dup 0 > if
          "unexpected label in enum, expected ':' " sb.wrap fileState [] .wordStart state appendError2
          while ..dup 1 > do
            "" string.wrap id.FLAG_EMPTY fileState [] .wordStart state [] .currentFile idContext [] .typeContext .labelContext @ id.newLabel
              state [] .labelBuffer ..swap list.append
            state [] .labelBuffer =
            1 -
          end ..drop
          fileState state readLabel
            state [] .labelBuffer ..swap list.append
          state [] .labelBuffer =
          continue
        else ..dup 0 < _if
          "not enough types for label" sb.wrap fileState [] .wordStart state appendError2
          while ..dup 0 < do
            Type .undefined fileState [] .wordStart newTypeConst  state pushConst
            1 +
          end
        end ..drop
      id.FLAG_NONE fileState [] .wordStart state [] .currentFile idContext [] .typeContext .labelContext @ id.newLabel
        state [] .labelBuffer ..swap list.append
      state [] .labelBuffer =
      Type .empty fileState [] .wordStart newTypeConst  state pushConst
      ..dup .length 0 >
    do end
  "unexpected end of file" sb.wrap fileState [] .wordStart state appendError2
  Type array.empty LabelId arrayView optional.empty labelType true return
end
proc( string : str FileState ptr mut : fileState  ParserState ptr mut : state -> bool ) =>: tryParseNumberLiteral
  str .length 0 == if
    false return
  end
  false =:: mut unsigned
  0 =:: mut size
  str
    str .length 1 - while ..dup 0 > do
      ..swap
        ..dup ..over.2 string.charAt
          ..dup 'u' == ..over 'U' == | if ..drop
            true unsigned =
            ..over string.splitIndex ..swap 10 number.tryParseInt ..dup .EMPTY ?? if
              ..drop.2
            else .NONE ?? ! _if
              ..drop.3 false return
            else ..dup types.MAX_INT_WIDTH > _if
              "size of integer literal (" sb.wrap
                ..swap sb.appendI
                ") exceeds maximum integer size (" sb.appendS
                types.MAX_INT_WIDTH sb.appendI
                ")" sb.appendS
              fileState [] .wordStart state appendWarning2
              64 size =
            else
              i32 cast size =
            end
            ..swap break
          else ..dup 'i' == ..over 'I' == | _if ..drop
            ..over string.splitIndex ..swap 10 number.tryParseInt .NONE ?? ! if
              ..drop.3 false return
            else ..dup types.MAX_INT_WIDTH > _if
              "size of integer literal (" sb.wrap
                ..swap sb.appendI
                ") exceeds maximum integer size (" sb.appendS
                types.MAX_INT_WIDTH sb.appendI
                ")" sb.appendS
              fileState [] .wordStart state appendWarning2
              64 size =
            else
              i32 cast size =
            end
            ..swap break
          else char.isDigit ! _if ## integer literal has to end with digit or u,U,i or I followed by digits
            ..swap break
          end
      ..swap 1 -
    end ..drop
  unsigned if
    0 number.tryParseUInt
  else
    0 number.tryParseInt
  end
    ..dup .NONE ?? if ..drop
      unsigned size fileState [] .wordStart state newIntConstant  state pushConst
      true return
    else ..dup .SIGN ?? _if ..drop.2
      "unsigned value is marked as negative: " sb.wrap
        str sb.appendStr
      fileState [] .wordStart state appendError2
      true return
    else ..dup .OVERFLOW ?? _if ..drop.2
      "integer value outside allowed range: " sb.wrap
        str sb.appendStr
      fileState [] .wordStart state appendError2
      true return
    end
  ..drop.2
  str 0 number.tryParseFloat ## XXX? float32 constants
    ..dup .NONE ?? if ..drop
      fileState [] .wordStart newFloatConst state pushConst
      true return
    else ..dup .INT ?? _if ..drop.2
      "integer value outside allowed range: " sb.wrap
        str sb.appendStr
      fileState [] .wordStart state appendError2
      true return
    end
  ..drop.2
  false return
end
proc( string : code Token : token FileState ptr mut : fileState  ParserState ptr mut : state -> string string bool ) =>: tryParseConstant
  state [] .progContext =:: progContext
  state [] .progContext [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  idContext [] .typeContext .labelContext @ =:: labelContext
  code
    token switch
      EMPTY case
        "" string.wrap true return
      STRING case
        ## newStringConstant
          ## parseStringConstant
            token .STRING
            fileState [] .wordStart
            progContext [] .errors @
            labelContext
          id.parseStringConstant
          fileState [] .wordStart
          typeContext
        newStringConstant state pushConst
