#include stringIO
#include io
#include stringBuilder
#include string
#include list

#include "lib.concat"
#include "files.concat"
#include "types.concat"

entryPoint:
  "./parser.concat" io.OPEN_READ io.fopen #drop =:: f
  128 sb.create
    '\n' sb.appendC
    f sb.appendFile #drop
    '\n' sb.appendC
  sb.toStr parseTokens ##printTokens
end

enum( i64 : int string : str i8 : chr ) =:: ConstValue

enum( NOP ConstValue : Constant string : Error  string : Unknown ) =:: OpValue
struct( OpValue : val FilePosition : pos ) =:: Operation

proc( FilePosition => Operation ) =: opNOP
  OpValue .NOP #swap Operation new return
end
proc( i64 FilePosition => Operation ) =: opConstInt
  #swap ConstValue .int new OpValue .Constant new #swap Operation new return
end
proc( string FilePosition => Operation ) =: opConstStr
  #swap ConstValue .str new OpValue .Constant new #swap Operation new return
end
proc( i8 FilePosition => Operation ) =: opConstChar
  #swap ConstValue .chr new OpValue .Constant new #swap Operation new return
end
proc( string FilePosition  => Operation ) =: opError
  #swap OpValue .Error new #swap Operation new return
end
proc( string FilePosition  => Operation ) =: opUnknown
  #swap OpValue .Unknown new #swap Operation new return
end
proc( Operation => ) =: printOp
  64 sb.create
    #over .val switch
      NOP case break
      Constant case
        "Constant: " sb.appendS
        #over .val .Constant #swap
          #over switch
            int case
              "integer "  sb.appendS
              #over .int sb.appendI
              break
            str case
              "string \""  sb.appendS
              #over .str   sb.appendStr
                     '\"'  sb.appendC
              break
            chr case
              "char \'"  sb.appendS
              #over .chr sb.appendC
                   '\''  sb.appendC
              break
          end
        #swap #drop
        break
      Error case
        "Error: " sb.appendS
        #over .val .Error sb.appendStr
        break
      Unknown case
        "Unknown Operation: " sb.appendS
        #over .val .Unknown sb.appendStr
        break
      default
    end
    " at " sb.appendS
    #over .pos .fileName sb.appendStr
    ':' sb.appendC
    #over .pos .line sb.appendI
    ':' sb.appendC
    #over .pos .posInLine sb.appendI
    '\n' sb.appendC
    #swap #drop
  io.stdOut #swap io.fputSb #drop
end

proc( string : code Token : token FileState ptr mut : fileState  Operation list ptr mut : ops => string ) =: parseOperation
  code
    token switch
      EMPTY case
        return
      STRING case ## TODO escape sequences
        token .STRING fileState [] .wordStart opConstStr  ops [] #swap list.append ops [] =
        return
      CHAR case
        token .CHAR
          #dup .length 1 != if
            #drop
            "A character literal has to contain exactly one character" string.wrap fileState [] .wordStart opError  ops [] #swap list.append ops [] = 
            return
          end
          0 string.charAt
        fileState [] .wordStart opConstChar ops [] #swap list.append ops [] = 
        return
      INTEGER case
        token .INTEGER fileState [] .wordStart opConstInt  ops [] #swap list.append ops [] =
        return
      ERROR case
        token .ERROR fileState [] .wordStart opError  ops [] #swap list.append ops [] =
        return
      IDENTIFER case
        token .IDENTIFER
        break
    end
    #dup 0 string.charAt '#' == if ## compiler command
      1 string.tail
        "include" string.wrap #over string.eq if #drop
          fileState nextToken
          #dup Token .STRING == if .STRING
            ## TODO include local file
            #drop 
            return
          else #dup Token .IDENTIFER == _if .IDENTIFER
            ## TODO include library file
            #drop 
            return
          end
          64 sb.create
            "invalid token for include" sb.appendS
            #swap appendToken
          sb.toStr fileState [] .wordStart opError  ops [] #swap list.append ops [] = 
          return
        end
      64 sb.create
        "unknown compiler command \"" sb.appendS
        #swap                         sb.appendStr
        '\"'                          sb.appendC
      sb.toStr fileState [] .wordStart opError  ops [] #swap list.append ops [] =
      return
    end
    ## TODO try parsing identifier
  fileState [] .wordStart opUnknown  ops [] #swap list.append ops [] =
  return
end
proc( string => ) =: parseTokens
  "test" #dup .length string.create 0 1 FilePosition new #dup FileState new =:: mut state
  128 Operation list.create =:: mut ops
  state addrOf #swap
    while
      #over nextToken #over:2 ops addrOf parseOperation
      #dup .length 0 >
    do end #drop
  #drop
  0 while #dup ops .length < do
    ops #over list.get printOp
    1 +
  end #drop
end
