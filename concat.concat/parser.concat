      end
      t @ true typeContext types.setMutability if
        "could not change mutability of type" sb.wrap fileState [] .wordStart state appendError2
      end
      t fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "(" string.wrap string.eq _EXPERIMENTAL_ ! & _if ..drop
