struct( Type : valueType ConstValue : val IdentifierInfo optional : idInfo FilePosition : pos ) =:: Constant
struct( InterpreterContext : context i64 : offset ) =:: InterpreterInfo

struct(
  IdentifierInfo : var
  Type : varType
) =:: TmpVarInfo
struct(
  iSize list : andOrPositions
  bool : hasOr
) =:: AndOrBlockData
struct(
  iSize slice.mut : andPositions
  iSize : ifPosition
  iSize optional : elsePosition
) =:: IfBlockData
enum( WHILE DO FINALLY ) =:: WhileBlockState
struct(
  iSize list : breakPositions
  iSize list : continuePositions
  iSize : whilePosition
  WhileBlockState : state
) =:: WhileBlockData
## case-label -(case)> case-body -(break)> case-label -> (default) -> default-body
##  case-body -(return,panic) -> implicit-break -(case)> case-body
##                               implicit-break -(break)> case-label
enum( CASE_LABEL CASE_BODY IMPLICIT_BREAK DEFAULT ) =:: SwitchBlockState
struct(
  iSize list : breakPositions
  iSize : switchPosition
  iSize : prevCasePosition
  iSize optional : implicitBreak
  SwitchBlockState : state
) =:: SwitchBlockData
struct(
  iSize : blockStart
) =:: ProcBlockData
struct(
  iSize : blockStart
) =:: InitializerBlockData
struct(
  iSize : blockStart
  iSize optional : arrowPosition
  BlockType : blockType
) =:: TypeBlockData
union(
  IfBlockData : If
  AndOrBlockData : AndOr
  WhileBlockData : While
  SwitchBlockData : Switch
  ProcBlockData : Procedure
  TypeBlockData : TypeBlock
  InitializerBlockData : Initializer
  _ : Namespace
  iSize : Overload
) =:: BlockInfoData
## TODO? assign block-ids in parser
struct(
  BlockInfoData : blockData
  LabelId : blockLabel
  TmpVarInfo optional : tmpVarInfo
  bool : autoClose
  bool : hasScope
) =:: BlockInfo
struct(
  string : basePath
  string : libPath
  ProgramContext ptr.mut : progContext
  TypeCheckState ptr.mut : typeChecker
  BlockInfo list : openBlocks
  Operation list : globalOpBuffer
  i32 : constOffset
  i32 : constBlockCount
  Type list : typeBuffer
  FileId : currentFile
  ProcId list : currentProcs
  InterpreterInfo list : globalInterpreters
  LabelId list : labelBuffer
  stringBuilder : tmpString
  bool : inLibFile
  bool : saveGlobalTokens
) =:: ParserState

proc( FilePosition : pos -> Constant ) =>: newWildcardConst
  Type .Undefined ConstValue .WildCard IdentifierInfo optional.empty pos Constant new return
end
proc(
  i64 : value
  i32 : preferedSize
-> bool ) =>: checkIntSize
  preferedSize 0 <= or preferedSize types.MAX_INT_WIDTH >= if
    false return
  end
  value -1:i64 preferedSize 1 - << < if
    true return
  end
  value 1:i64 preferedSize << >= return
end

enum( FIXED AUTO ) =:: IntLiteralType
proc(
  i64 : value
  IntLiteralType : literalType
  Type : intType
  string : literal
  FilePosition : pos
  ParserState ptr.mut : state
-> Constant ) =>: newIntConstant
  state [] .progContext =:: progContext
  progContext .errors =:: errors
  progContext .idContext .typeContext =:: typeContext
  literalType switch
    FIXED case
      intType typeContext types.sizeOf .fixed i32 cast 8 * =:: bitCount
      value bitCount checkIntSize if
        "integer literal overflows size for type " sb.copyPtr
          intType typeContext sb.appendType
          intType types.isPrimitive ! if
            " ( i" sb.appendS
            bitCount sb.appendU
            ')' sb.appendC
          end
          ": " sb.appendS
          literal sb.appendStr
        pos errors appendWarning
      end
      intType break
    AUTO case
      value f64.MIN_INT <  if types.intLiteral.S64 break end
      value i32.MIN i64 cast.s <  if types.intLiteral.S54 break end
      value f32.MIN_INT i64 cast.s < if types.intLiteral.S32 break end
      value i16.MIN i64 cast.s <  if types.intLiteral.S25 break end
      value  i8.MIN i64 cast.s <  if types.intLiteral.S16 break end
      value       0 <  if types.intLiteral.S8  break end
      value  i8.MAX i64 cast.u <= if types.intLiteral.U7  break end
      value i16.MAX i64 cast.u <= if types.intLiteral.U15 break end
      value f32.MAX_INT i64 cast.u <= if types.intLiteral.U24 break end
      value i32.MAX i64 cast.u <= if types.intLiteral.U31 break end
      value f64.MAX_INT <= if types.intLiteral.U53 break end
      types.intLiteral.U63
      break
  end =:: constType
  constType value ConstValue .Int IdentifierInfo optional.empty pos Constant new return
end
proc(
  unicode.Codepoint : char
  StringLiteralType : stringType
  FilePosition : pos
-> Constant ) =>: newCharConstant
  ## newConstant
    stringType switch
      DEFAULT case types.primitive.CHAR8  char char8 cast ConstValue .Char break
      UTF8    case types.primitive.CHAR8  char i64 cast.u 0xff & ConstValue .Int break
      UTF16   case types.primitive.CHAR16 char i64 cast.u 0xffff & ConstValue .Int break
      UTF32   case types.primitive.CHAR32 char i64 cast.u ConstValue .Int break
      UNKNOWN INT_LITERAL case ..unreachable
    end
  IdentifierInfo optional.empty pos Constant new return
end
proc(
  ConstValue : str
  StringLiteralType : stringType
  FilePosition : pos
  TypeContext ptr.mut : context
  ConstantContext ptr.mut : constContext
  CompilerError list ptr.mut : errors
-> Constant ) =>: newStringConstant
  using types.
  str .?Array8 .else
    "expected string to have type Array8" ..panic
  end =:: strArray
  stringType switch
    DEFAULT case str strArray .length types.primitive.CHAR8 break
    UTF8    case str strArray .length types.primitive.CHAR8 break
    UTF16 case
      ## TODO? reuse the same buffer for all string conversion
      0 char16 list.create strArray string.fromBytes utf8.toUTF16 =:: str16
      str16
        list.asSlice string16.fromSlice
      constContext newString16Const str16 .length types.primitive.CHAR16
        str16 list.free ..drop
      break
    UTF32 case
      0 char32 list.create strArray string.fromBytes  utf8.toUTF32 =:: str32
      str32
        list.asSlice string32.fromSlice
      constContext newString32Const str32 .length types.primitive.CHAR32
        str32 list.free ..drop
      break
    UNKNOWN INT_LITERAL case
      "unsupported string literal type" sb.copyPtr pos errors appendError
      ConstValue .None 0:iSize Type .Undefined break
  end =:: charType =:: strLength =:: strValue
  strLength i64 cast.u ArraySize .Int =:: size
  ## Constant
    charType types.ArrayType .POINTER size context newArrayType .data
    strValue
    IdentifierInfo optional.empty
  pos Constant new return
end
proc( Type FilePosition -> Constant ) =>: newTypeConst
  =:: pos
  types.primitive.TYPE ..swap ConstValue .TypeId IdentifierInfo optional.empty pos Constant new return
end

proc( f64 : value Type : constType FilePosition : pos -> Constant ) =>: newFloatConst
  ## Constant
    constType
    value ConstValue .Float
    IdentifierInfo optional.empty
    pos
  Constant new return
end

proc( Constant : const -> Operation ) =>: constantToOp
  const .val const .valueType const .pos opConst return
end

proc( ParserState ptr.mut : state -> iSize ) =>: opCount
  state [] .progContext =:: progContext
  _EXPERIMENTAL_ ! and state [] .currentProcs .length 0 == if
    0 return
  else
    progContext [] .tmpOps .length return
  end
end
proc( ParserState ptr.mut : state -> InterpreterInfo ptr.mut ) =>: getInterpreter
  state [] .globalInterpreters state [] .currentFile i64 cast list.at .data
end
proc( Operation : op ParserState ptr.mut : state -> ) =>: appendOp
  state [] .progContext =:: progContext
  progContext .errors =:: errors
  _EXPERIMENTAL_ ! and state [] .currentProcs .length 0:iSize == if
    state [] .saveGlobalTokens if
      progContext [] .globalOps
        op list.append
      progContext .globalOps=
    end
    state getInterpreter =:: interpreter
    op =:: op1
    op1@ interpreter .context evaluateOperation .?Ok ? ! if
      "could not evaluate global operation: " sb.copyPtr
        op progContext sb.appendOp
      op .pos errors appendError
    end
  else
    state [] .currentProcs .length 0:iSize == and state [] .saveGlobalTokens if
      progContext [] .globalOps
        op list.append
      progContext .globalOps=
    end
    progContext [] .tmpOps
      op list.append
    progContext .tmpOps=
  end
end

proc( ParserState ptr.mut : state -> Operation ptr.mut optional ) =>: peekOp
  state [] .progContext =:: progContext
  _EXPERIMENTAL_ ! and state [] .currentProcs .length 0:iSize == if
    state [] .globalOpBuffer
  else
    progContext [] .tmpOps
  end list.peek
end

proc( Constant : const ParserState ptr.mut : state -> ) =>: pushConst
  state getInterpreter .context interpreter.skipCurrentBlock if
    return
  end
  const constantToOp state appendOp
end

proc( ParserState ptr.mut : state -> ConstValue interpreter.ValueInfo ) =>: popConst
  state getInterpreter .context =:: interpreter
  interpreter [] .stack
    list.pop =:: value
  interpreter .stack=
  interpreter [] .stackInfo
    list.pop =:: info
  interpreter .stackInfo=
  value info return
end
proc( ParserState ptr.mut : state -> bool ) =>: hasConst
  state [] .currentProcs .length 0:iSize != if
    false return ## constants only exists at global level
  end
  state getInterpreter .context =:: interpreter
  interpreter [] .stack .length 0:iSize != return
end
proc(
  ParserState ptr.mut : state
->
  ConstValue ptr.mut optional interpreter.ValueInfo ptr.mut optional
) =>: peekConst
  state getInterpreter .context =:: interpreter
  interpreter [] .stack list.peek interpreter [] .stackInfo list.peek return
end

proc( FileState ptr.mut : fileState ParserState ptr.mut : state -> Type optional ) =>: popTypeConstant
  state [] .progContext =:: progContext
  progContext .errors =:: errors
  state peekConst =:: info? =:: value?
  value? .else
    "missing type constant" sb.copyPtr fileState [] .wordStart errors appendError
    Type optional.empty return
  end [] .?TypeId ? ! if
    "wrong type for constant expected type" sb.copyPtr info? .if
      [] .pushedAt
    else
      fileState [] .wordStart
    end errors appendError
    Type optional.empty return
  end
  state popConst ..drop .?TypeId .else
    "stack changed between peek and pop" ..panic
  end optional.wrap return
end

proc( BlockInfoData : blockData ParserState ptr.mut : state -> BlockInfoData ptr.mut ) =>: openBlock
  state [] .openBlocks
    blockData id.LABEL_ID_NONE TmpVarInfo optional.empty false false BlockInfo new list.append
  state .openBlocks=
  state [] .openBlocks list.peek .data .blockData
end
proc( ParserState ptr.mut : state -> ) =>: closedConstBlock
  state [] .constBlockCount
    1 -
  state .constBlockCount=
end
proc( BlockType : baseType ParserState ptr.mut : state -> ) =>: openTypeBlock
  state [] .progContext .idContext id.openScope
  state [] .constBlockCount
    1 +
  state .constBlockCount=
  state [] .openBlocks
    ## TypeBlockData
      state opCount
      iSize optional.empty
      baseType
    TypeBlockData new BlockInfoData .TypeBlock id.LABEL_ID_NONE TmpVarInfo optional.empty false true BlockInfo new list.append
  state .openBlocks=
end
proc( ParserState ptr.mut : state -> ) =>: openInitializerBlock
  state [] .progContext .idContext id.openScope
  state [] .constBlockCount
    1 +
  state .constBlockCount=
  state [] .openBlocks
    ## InitializerBlockData
      state opCount
    InitializerBlockData new BlockInfoData .Initializer id.LABEL_ID_NONE TmpVarInfo optional.empty false true BlockInfo new list.append
  state .openBlocks=
end
## TODO handle initializer blocks
proc( ParserState ptr.mut : state -> ) =>: openProcBlock
  state [] .openBlocks
    ## BlockInfo
      ## ProcBlockData
        state opCount
      ProcBlockData new BlockInfoData .Procedure
      id.LABEL_ID_NONE
      TmpVarInfo optional.empty
      false
      false
    BlockInfo new list.append
  state .openBlocks=
end
proc(
  ParserState ptr.mut : state
->
  BlockInfo ptr.mut optional
) =>: peekBlock
  state [] .openBlocks list.peek
end
proc(
  ParserState ptr.mut : state
->
  BlockInfo optional
) =>: closeBlock
  state [] .openBlocks .length 0:iSize == if
    BlockInfo optional.empty return
  end
  state [] .openBlocks
    list.pop =:: closed
  state .openBlocks=
  closed .hasScope if
    closed
      ## TODO better handling of this error case
      state [] .progContext .idContext id.closeScope if ..drop
        BlockInfo optional.empty
      else
        optional.wrap
      end
    return
  end
  closed optional.wrap return
end

proc( iSize : opPosition ParserState ptr.mut : state -> Operation ptr.mut optional ) =>: findOp
  _EXPERIMENTAL_ ! and state [] .currentProcs .length 0:iSize == if
    Operation ptr.mut optional.empty return ## cannot jumps in global block
  end
  state [] .progContext [] .tmpOps opPosition list.at
end
proc( iSize : blockPosition FilePosition : pos ParserState ptr.mut : state -> ) =>: setBlockJump
  _EXPERIMENTAL_ ! and state [] .currentProcs .length 0:iSize == if
    return ## cannot jumps in global block
  end
  state [] .progContext =:: progContext
  progContext .errors =:: errors
  progContext [] .tmpOps blockPosition list.at .and =:: opData
      opData .val .?block .if =:: block
    state opCount
      blockPosition - JumpDistance cast
    block .jumpDistance=
  else
    "operations and blocks are out of sync" sb.copyPtr
    pos errors appendError
    return
  end
end
proc( iSize slice : blockPositions FilePosition : pos ParserState ptr.mut : state -> ) =>: setBlockJumps
  _EXPERIMENTAL_ ! and state [] .currentProcs .length 0:iSize == if
    return ## cannot jumps in global block
  end
  state [] .progContext =:: progContext
  progContext .errors =:: errors
  blockPositions for =:: opPos
    progContext [] .tmpOps opPos list.at .and =:: opData
        opData .val .?block .if =:: block
      state opCount
        opPos - JumpDistance cast
      block .jumpDistance=
    else
      "operations and blocks are out of sync, expected and got " sb.copyPtr
      pos errors appendError
      return
    end
  end
end
proc( AndOrBlockData : andOrBlock BlockType : mergeWith FilePosition : pos ParserState ptr.mut : state -> iSize slice.mut ) =>: convertAndOrBlock
  _EXPERIMENTAL_ ! and state [] .currentProcs .length 0:iSize == if
    iSize slice.emptyMutable return ## cannot modify and/or in global block
  end
  state [] .progContext =:: progContext
  progContext .errors =:: errors
  andOrBlock .andOrPositions list.filter for =:: opPos
    opPos iSize cast.u progContext [] .tmpOps .length u>= if
      "operations and blocks are out of sync, could not determine position of and/or" sb.copyPtr
      pos errors appendError
      iSize slice.emptyMutable return
    end
    progContext [] .tmpOps opPos list.at .data =:: opData
    opData .val .?block .else ..drop
      "operations and blocks are out of sync, expected and/or got " sb.copyPtr
        opData [] progContext sb.appendOp
      pos errors appendError
      iSize slice.emptyMutable return
    end =:: blockData
    blockData [] .blockType switch
      AND case
        true
        mergeWith .DO if BlockType .AND_DO else BlockType .AND_IF end
      break
      OR case
        state opCount
          opPos - JumpDistance cast
        blockData .jumpDistance=
        false
        mergeWith .DO if BlockType .OR_DO else BlockType .OR_IF end
      break
      default
        "operations and blocks are out of sync, expected and/or got " sb.copyPtr
          opData [] .val .block .blockType sb.appendBlockType
        pos errors appendError
      iSize slice.emptyMutable return
    end blockData .blockType=
  end list.asMutableSlice
end
proc(
  BlockType : breakType
  LabelId : blockLabel
  FilePosition : pos
  ParserState ptr.mut : state
-> BlockInfo ptr.mut optional ) =>: findBreakableBlock
  state [] .progContext =:: program
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  program .errors =:: errors
  state [] .openBlocks list.atReversed for =:: block
    block [] .blockData .?While ? and blockLabel id.LABEL_ID_NONE == or
        block [] .blockLabel blockLabel labelContext id.labelNamesEq if
      block optional.wrap return
    end
    breakType .BREAK and block [] .blockData .?Switch ? and
        blockLabel id.LABEL_ID_NONE == or
        block [] .blockLabel blockLabel labelContext id.labelNamesEq if
      block optional.wrap return
    end
  end
  ## TODO! adjust error message to work in case of labeled blocks
  64 sb.create
    breakType sb.appendBlockType
    " can only appear in loops " sb.appendS
    breakType .BREAK if
      "and switch-case statements" sb.appendS
    end
  pos errors appendError
  BlockInfo ptr.mut optional.empty return
end
proc(
  SwitchBlockData ptr : switchData
  FilePosition : pos
  ParserState ptr.mut : state
-> ) =>: clearImplicitBreak
  state [] .progContext =:: progContext
  progContext .errors =:: errors
  switchData [] .implicitBreak .if =:: prevBreak
    progContext [] .tmpOps prevBreak list.at .and =:: opData
    opData .val .?block .and .blockType [] .BREAK if
      opValNOP opData .val=
    else
      "operations and blocks are out of sync" sb.copyPtr
      pos errors appendError
      return
    end
  end
end
proc(
  FilePosition : pos
  ParserState ptr.mut : state
-> ) =>: implicitBreakSwitch
  _EXPERIMENTAL_ ! and state [] .currentProcs .length 0:iSize == if
    return ## cannot modify and/or in global block
  end
  state peekBlock .and =:: currentBlock
      currentBlock .blockData .?Switch .if =:: switchData
    switchData pos state clearImplicitBreak
    state opCount optional.wrap switchData .implicitBreak=
    BlockType .BREAK currentBlock [] .blockLabel pos opLabeledBlock state appendOp
  end
end

proc( string : code FileState ptr.mut : fileState  CompilerError list ptr.mut : errors -> string string ) =>: nextIdentifier
  code
    fileState nextToken .?Identifier .else =:: nameToken
      "expected identifier got:" sb.copyPtr
        nameToken sb.appendToken
      fileState [] .wordStart errors appendError
      string.empty return
    end
  return
end
## TODO? restict flag-types depending on id-type
proc(
  string : code
  string : start
  FileState ptr.mut : fileState
  ParserState ptr.mut : state
  id.LabelFlag : initFlags
-> string LabelId ) =>: readLabelAddFlags
  state [] .progContext =:: progContext
  progContext .errors =:: errors
  state [] .inLibFile if
    id.FLAG_LIB_FILE
  else
    0:LabelFlag
  end =:: mut: flags
  false =:: mut: isModifier
  code start
    while
      false isModifier=
      ..dup "mut:":s string.eq if
        id.FLAG_MUTABLE flags | flags=
        true isModifier=
      else ..dup "auto:":s string.eq _if
        id.FLAG_AUTO flags | flags=
        id.FLAG_STATIC flags | flags=
        ## XXX? allow auto-args to be non-static
        ##  + error when generic-argument passed to sub-procedure
        true isModifier=
      else ..dup "static:":s string.eq _if
        id.FLAG_STATIC flags | flags=
        true isModifier=
      else ..dup "extern:":s string.eq _if
        id.FLAG_EXTERN flags | flags=
        true isModifier=
      else ..dup "export:":s string.eq _if
        id.FLAG_EXPORT flags | flags=
        true isModifier=
      else ..dup "inline:":s string.eq _if
        id.FLAG_INLINE flags | flags=
        true isModifier=
      else ..dup "no:inline:":s string.eq _if
        id.FLAG_NO_INLINE flags | flags=
        true isModifier=
      else ..dup "#:experimental:":s string.eq _if
        id.FLAG_EXPERIMENTAL flags | flags=
        true isModifier=
      else ..dup "shadow:":s string.eq _if
        id.FLAG_SHADOW flags | flags=
        true isModifier=
      else ..dup "alias:":s string.eq _if
        id.FLAG_ALIAS flags | flags=
        true isModifier=
      else ..dup "merge:":s string.eq _if
        id.FLAG_MERGE flags | flags=
        true isModifier=
      else ..dup "ignoreUnused:":s string.eq _if
        id.FLAG_IGNORE_UNUSED flags | flags=
        true isModifier=
      else ..dup "nowrap:":s string.eq _if
        id.FLAG_NO_WRAP flags | flags=
        true isModifier=
      else ..dup ":":s string.endsWith _if
        true isModifier=
      end
      isModifier ! if
        break
      end
    isModifier do ..drop
      fileState errors nextIdentifier
    end
  flags initFlags | fileState [] .wordStart state [] .currentFile state [] .progContext .idContext .typeContext .labelContext id.newLabel return
end
proc( string : code string : start FileState ptr.mut : fileState  ParserState ptr.mut : state -> string LabelId ) =>: readLabel
  code start fileState state 0:LabelFlag readLabelAddFlags
end

proc(
  string : literal
  IntLiteralType : literalType
  Type : intType
  FilePosition : pos
  ParserState ptr.mut : state
-> bool ) =>: tryParseIntConstant
  state [] .progContext =:: progContext
  progContext .errors =:: errors
  progContext .idContext .typeContext =:: typeContext
  literal 0 number.tryParseInt switch
    NONE case
      literalType intType literal pos state newIntConstant  state pushConst
      true return
    UNSIGNED case
      literalType switch
        FIXED case
          intType typeContext types.sizeOf .fixed 8 * i32 cast types.MAX_INT_WIDTH < if
            ..drop types.MAX_SIGNED_INT ## replace with maximum signed value to trigger overflow check
          end
          break
        AUTO case
          "integer value does not fit into a signed integer: " sb.copyPtr
            literal sb.appendStr
          pos errors appendWarning
          break
      end
      literalType intType literal pos state newIntConstant  state pushConst
      true return
    SIGN case ..drop
      "unsigned value is marked as negative: " sb.copyPtr
        literal sb.appendStr
      pos errors appendWarning
      true return
    OVERFLOW case ..drop
      "integer value outside allowed range: " sb.copyPtr
        literal sb.appendStr
      pos errors appendError
      true return
    INT INVALID_BASE case ..unreachable
    INVALID_CHAR EMPTY case ..drop
      false return
  end
end
proc(
  string : literal
  string : literalTypeName
  FilePosition : pos
  ParserState ptr.mut : state
-> bool ) =>: tryParseNumberLiteral
  state [] .progContext =:: progContext
  progContext .errors =:: errors
  progContext .idContext =:: idContext
  idContext .typeContext =:: typeContext
  literal .length 0:iSize == if
    false return
  end
  literal 0 string.charAt '#' == if
    false return ## annotations
  end
  literalTypeName .length 0:iSize != if
    literalTypeName "i8":s string.eq if types.primitive.I8
    else literalTypeName "i16":s string.eq _if types.primitive.I16
    else literalTypeName "i32":s string.eq _if types.primitive.I32
    else literalTypeName "i64":s string.eq _if types.primitive.I64
    else literalTypeName "f32":s string.eq _if types.primitive.F32
    else literalTypeName "f64":s string.eq _if types.primitive.F64
    else literalTypeName idContext id.findIdentifierByName
        ..swap =:: idData ! and
        idData .idType .TYPE and idData .constValue .?TypeId ._if
      []
    else
      false return
    end =:: literalType
    literalType typeContext types.isInt if
      literal IntLiteralType .FIXED literalType pos state tryParseIntConstant ! if
        "invalid integer constant: `" sb.copyPtr
          literal sb.appendStr
          '`' sb.appendC
        pos errors appendWarning
      end
      true return
    else literalType typeContext types.isFloat _if
      literal 0 number.tryParseFloat =:: errCode
      errCode .NONE or errCode .INT if
        literalType pos newFloatConst state pushConst
        true return
      else ..drop
        "invalid float constant: `" sb.copyPtr
          literal sb.appendStr
          '`' sb.appendC
        pos errors appendWarning
      end
    else
      false return
    end
  end
  literal IntLiteralType .AUTO Type .Undefined pos state tryParseIntConstant if
    true return
  end
  literal 0 number.tryParseFloat
    ..dup .NONE if ..drop
      types.primitive.F64 pos newFloatConst state pushConst
      true return
    else ..dup .INT _if ..drop.2
      "integer value outside allowed range: " sb.copyPtr
        literal sb.appendStr
      pos errors appendError
      true return
    end
  ..drop.2
  false return
end
proc(
  StringToken : token
  bool : isRawString
  FilePosition : pos
  ParserState ptr.mut : state
-> ConstValue ) =>: parseStringConstant
  state [] .progContext =:: progContext
  progContext .errors =:: errors
  state [] .progContext .idContext =:: idContext
  idContext .typeContext =:: typeContext
  idContext .constContext =:: constContext
  idContext .typeContext .labelContext =:: labelContext
  ## newStringConstant
    ## parseStringConstant
      token .value
      pos
      progContext .errors
      constContext
    isRawString if
      constants.parseRawStringConstant
    else
      constants.parseStringConstant
    end
    token .stringType
    pos
    typeContext
    constContext
    progContext .errors
  newStringConstant
    $ .val =:: stringConst
  state pushConst
  stringConst return
end
proc(
  StringToken : token
  FilePosition : pos
  ParserState ptr.mut : state
-> ) =>: parseCharConstant
  state [] .progContext =:: progContext
  progContext .errors =:: errors
  state [] .progContext .idContext =:: idContext
  idContext .typeContext =:: typeContext
  idContext .constContext =:: constContext
  idContext .typeContext .labelContext =:: labelContext
  token .value
    pos progContext .errors constContext constants.parseStringConstant ## escape character
      .Array8 string.fromBytes
      0:iSize utf8.nextCodepoint =:: cp
    #+nextIndex+# >$ .length u< if
      "A character literal has to contain exactly one character" sb.copyPtr pos errors appendError
    end
    token .stringType switch
      DEFAULT case "byte":s 0x7F break
      UTF8  case "utf8-character":s  0x7F   break
      UTF16 case "utf16-character":s 0xFFFF break
      UTF32 case "utf32-character":s unicode.MAX_CODEPOINT i32 cast.u break
      INT_LITERAL UNKNOWN case
        "invalid string literal type" sb.copyPtr pos errors appendError
        return
    end
    =:: maxCodepoint =:: charTypeName
    token .stringType .DEFAULT ! and cp i32 cast 0 < if
      "unmatched byte in " sb.copyPtr
        charTypeName sb.appendStr
        ": 0x" sb.appendS
        cp i32 cast -_ sb.appendX
      pos errors appendError
    end
    cp i32 cast maxCodepoint > if
      "codepoint 0x"  sb.copyPtr
        cp i32 cast sb.appendX
        " ('" sb.appendS
        cp sb.appendCodepoint
       "') cannot be encoded as a single " sb.appendS
       charTypeName sb.appendStr
      pos errors appendError
    end
  ## newCharConstant
    cp $ i32 cast 0 < if i32 cast -_ unicode.Codepoint cast end
    token .stringType
  pos newCharConstant state pushConst
end
proc(
  Token : literalType
  FilePosition : pos
  CompilerError list ptr.mut : errors
-> bool ) =>: checkLiteralType
  literalType .?LiteralType .else ..drop
    "expected literal type got: " sb.copyPtr
    literalType sb.appendToken
    pos errors appendError
    true return
  end .length 0:iSize == if
    "literal type should be non-empty" sb.copyPtr
    pos errors appendError
    true return
  end
  false return
end
proc(
  string : code
  Token : token
  FileState ptr.mut : fileState
  ParserState ptr.mut : state
-> string string bool ) =>: tryParseConstant
  state [] .progContext =:: progContext
  progContext .errors =:: errors
  state [] .progContext .idContext =:: idContext
  idContext .typeContext =:: typeContext
  idContext .constContext =:: constContext
  idContext .typeContext .labelContext =:: labelContext
  code
    token switch
      Empty case
        string.empty true return
      Eof case
        "unexpected end of file in string-literal" sb.copyPtr fileState [] .wordStart errors appendError
        string.empty true return
      String .case false fileState [] .wordStart state parseStringConstant ..drop
        string.empty true return
      RawString .case true fileState [] .wordStart state parseStringConstant ..drop
        string.empty true return
      Char .case fileState [] .wordStart state parseCharConstant
        string.empty true return
      Identifier .case string.empty fileState [] .wordStart state tryParseNumberLiteral if
          string.empty true return
        end
        token .Identifier
        break
      Literal case
        fileState [] .wordStart =:: literalStart
        fileState nextToken =:: literalType
        literalType fileState [] .wordStart errors checkLiteralType if
          string.empty true return
        end
        literalType .LiteralType "?":s string.eq if
          false =:: mut: isElement
          token .Literal
            $ .length 2:iSize u>= and $ 0 string.charAt '.' == and $ 1 string.charAt '.' != if
              1 string.tail
              true isElement=
            end
            $ "@":s string.endsWith if
              $ .length 1:iSize - string.head
            end
          =:: idName
          idName
            id.FLAG_NONE
            literalStart
          state [] .currentFile labelContext id.newLabel
          literalStart
            isElement if opExistsLabel else opExistsName end
          state appendOp
          string.empty true return
        end
        ## XXX? remove special case for number literals
        token .Literal literalType .LiteralType literalStart state tryParseNumberLiteral if
          string.empty true return
        end
        ## literal not a primitive number type -> convert to string and call literal procedure
        ## newStringConstant
          token .Literal constContext newStringConst
          StringLiteralType .UTF8
          literalStart
        typeContext constContext errors newStringConstant
          $ .val =:: stringConst
        state pushConst
        types.I_SIZE
          stringConst .Array8 .length i64 cast.u ConstValue .Int
          IdentifierInfo optional.empty
        fileState [] .wordStart Constant new state pushConst
        state [] .tmpString
          sb.clear ## clear tmp string
          ':' sb.appendC
          literalType .LiteralType sb.appendStr
        state .tmpString=
        state [] .tmpString sb.asStr false return
      LiteralChar LiteralString LiteralRawString .case
        token .?LiteralRawString ? fileState [] .wordStart state parseStringConstant =:: stringConst
        types.I_SIZE
          stringConst
            .?Array8 .if .length
            else .?Array32 ._if .length
            else .?Array16 ._if .length
          else ..unreachable end i64 cast.u ConstValue .Int
          IdentifierInfo optional.empty
        fileState [] .wordStart Constant new state pushConst
        fileState nextToken =:: literalType
        literalType fileState [] .wordStart errors checkLiteralType  if
          string.empty true return
        end
        ## XXX? more usefull error for missing parse procedure?
        state [] .tmpString
          sb.clear ## clear tmp string
          ':' sb.appendC
          literalType .LiteralType sb.appendStr
        state .tmpString=
        state [] .tmpString sb.asStr false return
      LiteralType case
        "unexpected token: " sb.copyPtr
        token sb.appendToken
        fileState [] .wordStart errors appendError
        string.empty true return
    end
    ..dup "_":s string.eq if
      fileState [] .wordStart newWildcardConst  state pushConst
      true return
    end
  false return
end
proc(
  string #+size+#
  string : opName
  FilePosition : pos
  ParserState ptr.mut : state
-> i32 ) =>: getCompilerOpParam
  state [] .progContext =:: progContext
  progContext .errors =:: errors
  ..dup 10 number.tryParseInt .NONE ! if ..drop
    ..dup .length 0:iSize != if
      64 sb.create
        "unexpected argument for " sb.appendS
        opName sb.appendStr
        " expected positive integer got: \"" sb.appendS
        ..swap  sb.appendStr
        '"'    sb.appendC
      pos errors appendError
    else ..drop end
    1 return
  else ..swap ..drop i32 cast ..dup 1 < _if
    50 sb.create
      "argument of " sb.appendS
        opName sb.appendStr
      " has to be positive got: " sb.appendS
      ..swap sb.appendI
    pos errors appendError
    1
  end
  return
end
proc( ProgramContext ptr.mut : progContext -> Type ) =>: newAutoType
  progContext [] .autoTypes .length i32 cast types.newAutoType
  progContext [] .autoTypes
    Type .Undefined list.append
  progContext .autoTypes=
end
proc( TmpVarInfo : varInfo ParserState ptr.mut : state FilePosition : pos -> ) =>: appendItrStep
  state [] .progContext .idContext =:: idContext
  varInfo .varType varInfo .var pos opGetId state appendOp
  "..itr.step":s idContext id.findIdentifierByName
    ! "..itr.step" assert
  =:: itrStep
  itrStep [] .valueType itrStep id.asIdInfo pos opGetId state appendOp
  varInfo .varType varInfo .var pos opSetId state appendOp
end
proc( TmpVarInfo : varInfo ParserState ptr.mut : state FilePosition : pos -> ) =>: appendItrEnd
  state [] .progContext .idContext =:: idContext
  varInfo .varType varInfo .var pos opGetId state appendOp
  "..itr.end":s idContext id.findIdentifierByName
    ! "..itr.end" assert
  =:: itrEnd
  itrEnd [] .valueType itrEnd id.asIdInfo pos opGetId state appendOp
end
proc( ParserState ptr.mut : state FilePosition : pos -> TmpVarInfo ) =>: appendDotIfCheck
  state [] .progContext =:: progContext
  progContext .idContext =:: idContext
  "..if.prepare":s idContext id.findIdentifierByName
    ! "..if.prepare" assert
  =:: ifPrepare
  ifPrepare [] .valueType ifPrepare id.asIdInfo pos opGetId state appendOp
  progContext newAutoType =:: varType
  varType pos state [] .currentFile idContext id.newItrVar =:: ifVar
  varType ifVar pos opAutoTypedInitializeId state appendOp
  varType ifVar pos opGetId state appendOp
  "..if.check":s idContext id.findIdentifierByName
    ! "..if.check" assert
  =:: ifCheck
  ifCheck [] .valueType ifCheck id.asIdInfo pos opGetId state appendOp
  ifVar varType TmpVarInfo new
end
proc( TmpVarInfo : varInfo ParserState ptr.mut : state FilePosition : pos -> ) =>: appendElseVal
  state [] .progContext .idContext =:: idContext
  varInfo .varType varInfo .var pos opGetId state appendOp
  "..if.elseVal":s idContext id.findIdentifierByName
    ! "..if.elseVal" assert
  =:: elseVal
  elseVal [] .valueType elseVal id.asIdInfo pos opGetId state appendOp
end
## if current procedure is a valid main
proc( LabelId : procName Type : procType ProcId : procId FilePosition : pos ParserState ptr.mut : state -> ) =>: checkMain
  state [] .progContext =:: progContext
  progContext .errors =:: errors
  progContext .idContext =:: idContext
  idContext .typeContext =:: typeContext
  idContext .constContext =:: constContext
  typeContext .labelContext =:: labelContext
  MAIN_NAME procName labelContext id.labelNameEq ! if
    return ## no main procedure -> skip checks
  end
  procType typeContext types.isProcedure ! if
    "main has to be a procedure got: " sb.copyPtr
      procType typeContext sb.appendType
    pos errors appendError
    return
  end
  procName labelContext id.getLabelFile 0:FileId != and
      procName labelContext id.labelFlags id.FLAG_EXPORT & ? ! if
    "main procedure is not visible from root file" sb.copyPtr
    pos errors appendWarning
    return
  end
  procName labelContext id.getLabelNamespace 0:NamespaceId != if
    "main procedure is not in global namespace" sb.copyPtr
    pos errors appendWarning
    return
  end
  procType typeContext types.getProcIn .data =:: inTypes
  procType typeContext types.getProcOut .data =:: outTypes
  inTypes .length 0:iSize != if
    "the main procedure should not take arguments" sb.copyPtr
     pos errors appendError
  end
  outTypes .length 0:iSize != if
    "the main procedure should not return a value" sb.copyPtr
     pos errors appendWarning
  end
  procName progContext .mainLabelId=
  procId NO_PROC != if ## don't update proc-id for main without body
    procId progContext .mainProcId=
  end
end
## check if composite has any static elements, types are static by default
proc( Type slice : elements LabelId slice : labels TypeContext ptr : typeContext -> bool ) =>: hasStaticElement
  typeContext .labelContext =:: labelContext
  elements .length for =:: i
    i labels .length u< and labels i []
        labelContext id.labelFlags id.FLAG_STATIC & ? if
      true return
    end
    elements i [] typeContext types.isType if
      true return
    end
  end
  false return
end
proc(
  LabelId : procName
  Type : procType
  FileId : fileId
  ProcId : aliasId
  FilePosition : pos
  ProgramContext ptr.mut : progContext
-> ProcId ) =>: newProcData
  progContext .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  procType typeContext types.getProcIn $ ? if .data else ..drop
    Type slice.empty
  end =:: inTypes
  procType typeContext types.getProcOut $ ? if .data else ..drop
    Type slice.empty
  end =:: outTypes
  inTypes procType typeContext types.getProcArgLabels typeContext hasStaticElement =:: hasStaticArg
  outTypes procType typeContext types.getProcRetLabels typeContext hasStaticElement
    procName labelContext id.labelFlags id.FLAG_STATIC & ? |
  =:: isStatic
  progContext [] .procedures
    $ .length ProcId cast =:: procId
    ## ProcedureInfo
      aliasId NO_PROC == if
        ## CodeProcData
          0 ProcImplementation list.create
          0 VariableInfo list.create
          Operation slice.emptyMutable
          0:i16
          ProcCodeState .PARSING
        CodeProcData new ProcImplType .code
      else
        aliasId ProcImplType .alias
      end
      procType
      procName
      fileId
      idContext id.currentScope
      hasStaticArg
      isStatic
    ProcedureInfo new list.append
  progContext .procedures=
  procId return
end

proc( string : code Token : token FileState ptr.mut : fileState  ParserState ptr.mut : state -> string ) =>: parseOperation
  state [] .progContext =:: progContext
  progContext .errors =:: errors
  progContext .idContext =:: idContext
  idContext .typeContext =:: typeContext
  idContext .constContext =:: constContext
  typeContext .labelContext =:: labelContext
  state getInterpreter .context interpreter.skipCurrentBlock =:: skipBlock
  code
    token fileState state tryParseConstant if
      ..drop return
    end
    ..dup .length 0:iSize == if ..drop
      return ## skip empty tokens
    end
    ## 1. parse blocks
    $ "if":s string.eq or $ "_if":s string.eq or
        $ ".if":s string.eq or $ ".else":s string.eq or
        $ "._if":s string.eq or $ "._else":s string.eq if =:: opName
      opName 0 string.charAt '.' == =:: hasDot
      opName .length 4 u> =:: hasElse
      opName 0 string.charAt '_' == or opName 1 string.charAt '_' == end =:: autoClose
      state peekBlock .and =:: currentBlock
          currentBlock .blockData [] .?AndOr .if $ .hasOr =:: hasOr
        ## sequence of ands -> allow access to local variables from if-branch
          BlockType .IF
          fileState [] .wordStart
        state convertAndOrBlock =:: andPositions
        ## IfBlockData
          andPositions
          state opCount
          iSize optional.empty
        IfBlockData new currentBlock .blockData .If=
        hasOr
      else
        ## IfBlockData
          iSize slice.emptyMutable
          state opCount
          iSize optional.empty
        IfBlockData new BlockInfoData .If state openBlock ..drop
        false
      end =:: hasOrIf
      state peekBlock .else
        "expected block" ..panic
      end =:: current
      current .blockData .?If .else
        "expected top block to be if" ..panic
      end =:: ifData
      autoClose if
        state [] .openBlocks $ .length 2 - list.get .and .blockData .?If .and .elsePosition ? if
          true current .autoClose=
        else
          "'_if' is only allowed in if-else-blocks" sb.copyPtr fileState [] .wordStart errors appendError
        end
      end
      hasDot if
        state fileState [] .wordStart appendDotIfCheck optional.wrap current .tmpVarInfo=
        ## patch if-position after inserting dot-if operations
        state opCount ifData .ifPosition=
      end
      BlockType .IF  fileState [] .wordStart opBlock  state appendOp
      hasDot if
        current .tmpVarInfo [] .else
          "expected if-block to have tmp-var" ..panic
        end =:: varInfo
        hasOrIf ! if
          varInfo .varType varInfo .var fileState [] .wordStart opGetId state appendOp
          "..if.ifVal":s idContext id.findIdentifierByName
            ! "..if.ifVal" assert
          =:: ifGet
          ifGet [] .valueType ifGet id.asIdInfo fileState [] .wordStart opGetId state appendOp
        else ifData [] .andPositions .length 0 != _if
          ".if has no effect on if-statements with both `and` and `or` statements" sb.copyPtr
          fileState [] .wordStart errors appendWarning
        end
        hasElse if
          state opCount optional.wrap ifData .elsePosition=
          ifData [] .ifPosition fileState [] .wordStart state setBlockJump
          ifData [] .andPositions slice.freeze fileState [] .wordStart state setBlockJumps
          state peekBlock .data current == "top pointer does not change" assert
          BlockType .ELSE fileState [] .wordStart opBlock state appendOp
          ifData [] .andPositions .length 0 == if
            varInfo state fileState [] .wordStart appendElseVal
          end
        end
      end
      return
    else $ "and":s string.eq or $ "or":s string.eq or
        $ ".and":s string.eq or $ ".or":s string.eq _if =:: opName
      opName "or":s string.endsWith =:: isOr
      opName 0 string.charAt '.' == if
        state fileState [] .wordStart appendDotIfCheck optional.wrap
      else TmpVarInfo optional.empty end =:: varInfo?
      isOr if BlockType .OR else BlockType .AND end =:: blockType
      state peekBlock .and .blockData .?AndOr .if =:: andOrData
        isOr if
          true andOrData .hasOr=
        end
        andOrData
      else ## not already within an and-or chain
        ## AndOrBlockData
          8 iSize list.create ## TODO? pool of short lists for and-or blocks
          isOr
        AndOrBlockData new BlockInfoData .AndOr state openBlock .?AndOr .else
          "opening AndOr should return AndOr" ..panic
        end
      end =:: andOrBlock
      ## remember position to allow changing block-type when merging with if/do
      andOrBlock [] .andOrPositions
        state opCount list.append
      andOrBlock .andOrPositions=
      blockType  fileState [] .wordStart opBlock  state appendOp
      varInfo? .if =:: varInfo
        varInfo .varType varInfo .var fileState [] .wordStart opGetId state appendOp
        isOr if "..if.elseVal":s else "..if.ifVal":s end idContext id.findIdentifierByName
          ! "and/or val" assert
        =:: ifGet
        ifGet [] .valueType ifGet id.asIdInfo fileState [] .wordStart opGetId state appendOp
      end
      return
    else $ "else":s string.eq _if ..drop
      state peekBlock .else
        "'else' is only allowed in if-blocks" sb.copyPtr fileState [] .wordStart errors appendError
        return
      end =:: currentBlock
      currentBlock .blockData .?If .if
        $ [] .elsePosition ? if ..drop
          "if block can only contain one 'else' statement" sb.copyPtr fileState [] .wordStart errors appendError
          return
        end
      else ..drop
        "'else' is only allowed in if-blocks" sb.copyPtr fileState [] .wordStart errors appendError
        return
      end =:: ifBlockData
      state opCount optional.wrap ifBlockData .elsePosition=
      ifBlockData [] .ifPosition fileState [] .wordStart state setBlockJump
      ifBlockData [] .andPositions .length 0 != =:: hasAnd
      ifBlockData [] .andPositions slice.freeze fileState [] .wordStart state setBlockJumps
      BlockType .ELSE fileState [] .wordStart opBlock  state appendOp
      hasAnd ! and currentBlock [] .tmpVarInfo .if
        state fileState [] .wordStart appendElseVal
      end
      return
    else $ "while":s string.eq or $ "while:":s string.eq _if =:: opName
      opName "while:":s string.eq if
        fileState errors nextIdentifier
          id.FLAG_NONE
          fileState [] .wordStart
          state [] .currentFile
        labelContext id.newLabel
      else
        id.LABEL_ID_NONE
      end =:: blockLabel
      ## WhileBlockData
        16 iSize list.create
        16 iSize list.create
        state opCount
        WhileBlockState .WHILE
      WhileBlockData new BlockInfoData .While state openBlock ..drop
      blockLabel state peekBlock .data .blockLabel=
      BlockType .WHILE blockLabel fileState [] .wordStart opLabeledBlock state appendOp
      return
    else $ "for":s string.eq or $ "for:":s string.eq _if =:: opName
      opName "for:":s string.eq if
        fileState errors nextIdentifier
          id.FLAG_NONE
          fileState [] .wordStart
          state [] .currentFile
        labelContext id.newLabel
      else
        id.LABEL_ID_NONE
      end =:: blockLabel
      "..itr.prepare":s idContext id.findIdentifierByName
        ! "..itr.prepare" assert
      =:: itrPrepare
      itrPrepare [] .valueType itrPrepare id.asIdInfo fileState [] .wordStart opGetId state appendOp
      progContext newAutoType =:: itrType
      itrType fileState [] .wordStart state [] .currentFile idContext id.newItrVar =:: itrVar
      itrType itrVar fileState [] .wordStart opAutoTypedInitializeId state appendOp
      state opCount =::  whilePos
      BlockType .WHILE blockLabel fileState [] .wordStart opLabeledBlock state appendOp
      itrType itrVar fileState [] .wordStart opGetId state appendOp
      "..itr.check":s idContext id.findIdentifierByName
        ! "..itr.check" assert
      =:: itrCheck
      itrCheck [] .valueType itrCheck id.asIdInfo fileState [] .wordStart opGetId state appendOp
      state opCount =::  doPos
      BlockType .DO fileState [] .wordStart opBlock  state appendOp
      itrType itrVar fileState [] .wordStart opGetId state appendOp
      "..itr.get":s idContext id.findIdentifierByName
        ! "..itr.get" assert
      =:: itrGet
      itrGet [] .valueType itrGet id.asIdInfo fileState [] .wordStart opGetId state appendOp
      ## WhileBlockData
        16 iSize list.create
          doPos list.append
        16 iSize list.create
        whilePos
        WhileBlockState .DO
      WhileBlockData new BlockInfoData .While state openBlock ..drop
      blockLabel state peekBlock .data .blockLabel=
      itrVar itrType TmpVarInfo new optional.wrap state peekBlock .data .tmpVarInfo=
      return
    else $ "do":s string.eq _if ..drop ## TODO? `.do` statement similar to `.and`
      state peekBlock .and =:: currentBlock
          currentBlock .blockData .?AndOr ? if
        state closeBlock .and .blockData .?AndOr .else
          "closed block does not match current block" ..panic
        end BlockType .DO fileState [] .wordStart state convertAndOrBlock
      else iSize slice.emptyMutable end =:: andPositions
      state peekBlock .and .blockData .?While .else
        "'do' is only allowed in while-blocks" sb.copyPtr fileState [] .wordStart errors appendError
        return
      end =:: whileData
      whileData [] .state .WHILE ! if
        "while-block can only contain a single 'do' statement" sb.copyPtr fileState [] .wordStart errors appendError
        return
      end
      WhileBlockState .DO whileData .state=
      whileData [] .breakPositions
        andPositions slice.freeze list.appendSlice
        andPositions slice.free ..drop
        state opCount list.append
      whileData .breakPositions=
      BlockType .DO  fileState [] .wordStart opBlock  state appendOp
      return
    else $ "finally":s string.eq _if =:: opName
      state peekBlock .and .blockData .?While .else
        "'finally' is only allowed in while-blocks" sb.copyPtr fileState [] .wordStart errors appendError
        return
      end =:: whileData
      whileData [] .state switch
        WHILE case
          whileData [] .breakPositions state opCount list.append whileData .breakPositions=
          BlockType .DO  fileState [] .wordStart opBlock  state appendOp
        break
        DO case break
        FINALLY case
          "while-blocks can only contain a single 'finally' statement" sb.copyPtr fileState [] .wordStart errors appendError
        return
      end
      whileData [] .continuePositions list.asSlice fileState [] .wordStart state setBlockJumps
      WhileBlockState .FINALLY whileData .state=
      BlockType .FINALLY  fileState [] .wordStart opBlock  state appendOp
      ## update for-loop iterator
      state peekBlock .and .tmpVarInfo [] .if
        state fileState [] .wordStart appendItrStep
      end
      return
    else $ "break":s string.eq or $ "break.":s string.startsWith or
      $ "continue":s string.eq or $ "continue.":s string.startsWith _if =:: opName
      opName 0 string.charAt 'c' == =:: isContinue ## ! checking length is not correct
      opName '.' string.split ..drop =:: breakLabel
      breakLabel .length 0:iSize != if
        ## newLabel
          breakLabel
          id.FLAG_NONE
          fileState [] .wordStart
          state [] .currentFile
        labelContext id.newLabel
      else
        id.LABEL_ID_NONE
      end =:: blockLabel
      isContinue if BlockType .CONTINUE else BlockType .BREAK end =:: blockType
      blockType blockLabel fileState [] .wordStart state findBreakableBlock .else
        return ## error message handled by findBreakableBlock
      end =:: breakBlock
      breakBlock .blockData .?While .if =:: whileData
        isContinue if
          whileData .state .FINALLY if
            "continue cannot be used after 'finally' statement" sb.copyPtr fileState [] .wordStart errors appendError
            return
          end
          whileData [] .continuePositions
            state opCount list.append
          whileData .continuePositions=
        else
          whileData [] .breakPositions
            state opCount list.append
          whileData .breakPositions=
        end
      else .?Switch ._if =:: switchData
        ## FIXME: do not clear implicit break if broken block is not innermost switch
        switchData fileState [] .wordStart state clearImplicitBreak
        isContinue if
          "unimplemented: continue switch" ..panic
        end
        switchData [] .breakPositions
          state opCount list.append
        switchData .breakPositions=
      else
        "unsupported block for break" ..panic
      end
      blockType blockLabel fileState [] .wordStart opLabeledBlock state appendOp
      ## broken block is not the same as innermost block
      state peekBlock .and .blockLabel breakBlock .blockLabel != if
        fileState [] .wordStart state implicitBreakSwitch
      end
      return
    else $ "switch":s string.eq or $ "switch:":s string.eq _if =:: opName
      opName "switch:":s string.eq if
        fileState errors nextIdentifier
          id.FLAG_NONE
          fileState [] .wordStart
          state [] .currentFile
        labelContext id.newLabel
      else
        id.LABEL_ID_NONE
      end =:: blockLabel
      ## SwitchBlockData
        16 iSize list.create
        state opCount
        state opCount
        iSize optional.empty
        SwitchBlockState .CASE_LABEL
      SwitchBlockData new BlockInfoData .Switch state openBlock ..drop
      blockLabel state peekBlock .data .blockLabel=
      BlockType .SWITCH blockLabel fileState [] .wordStart opLabeledBlock state appendOp
      return
    else $ "case":s string.eq or $ ".case":s string.eq _if =:: opName
      state peekBlock .and .blockData .?Switch .if =:: switchData
        switchData .state .DEFAULT if
          "unexpected 'case' statement, 'default' has to be the last branch of switch" sb.copyPtr
          fileState [] .wordStart errors appendError
        else switchData .state .CASE_LABEL ! and switchData .state .IMPLICIT_BREAK ! _if
          "unexpected 'case' statement, missing 'break' at end of case-body" sb.copyPtr
          fileState [] .wordStart errors appendError
        end
        SwitchBlockState .CASE_LABEL switchData .state=
        iSize optional.empty switchData .implicitBreak=
        switchData [] .prevCasePosition fileState [] .wordStart state setBlockJump
        state opCount switchData .prevCasePosition=
        opName 0 string.charAt '.' == if
          BlockType .DOT_CASE
        else
          BlockType .CASE
        end fileState [] .wordStart opBlock  state appendOp
        return
      else
        "'case' is only allowed in switch-blocks" sb.copyPtr fileState [] .wordStart errors appendError
        return
      end
    ## TODO? merge with `case`
    else $ "default":s string.eq _if ..drop
      state peekBlock .and .blockData .?Switch .if =:: switchData
        switchData .state .DEFAULT if
          "unexpected 'default' statement, switch-block already has a 'default' branch" sb.copyPtr
          fileState [] .wordStart errors appendError
        else switchData .state .CASE_LABEL ! and switchData .state .IMPLICIT_BREAK ! _if
          "unexpected 'default' statement, missing 'break' at end of case-body" sb.copyPtr
          fileState [] .wordStart errors appendError
        end
        SwitchBlockState .DEFAULT switchData .state=
        iSize optional.empty switchData .implicitBreak=
        switchData [] .prevCasePosition fileState [] .wordStart state setBlockJump
        state opCount switchData .prevCasePosition=
        BlockType .DEFAULT fileState [] .wordStart opBlock  state appendOp
        return
      else
        "'default' is only allowed in switch-case-blocks" sb.copyPtr fileState [] .wordStart errors appendError
        return
      end
    else $ "=>":s string.eq or $ "=>:":s string.eq _if =:: opName
      opName .length 3:iSize == =:: named
      state [] .currentProcs .length 0:iSize != =:: isNested
      _EXPERIMENTAL_ or isNested if
        ## TODO! find better way to handle creation of proc-data for nested procs (with type unknown at parse-time)
        Type .Undefined
      else
        ## pop type before reading name
        fileState state popTypeConstant .else
          Type .Undefined
        end
      end =:: mut: procType
      ## TODO? ensure global stack is empty at start of procedure
      named ! or _EXPERIMENTAL_ if
        char8 64 array : buffer
          buffer@ sb.wrapBuffer
            "lambda@" sb.appendS
            fileState [] .wordStart .line sb.appendI
            ":" sb.appendS
            fileState [] .wordStart .posInLine sb.appendI
          sb.asStr
          id.FLAG_LAMBDA
          fileState [] .wordStart
          state [] .currentFile
        labelContext id.newLabel
      else
        id.LABEL_ID_NONE
      end =:: procImplName
      named if ## =>:
        fileState errors nextIdentifier fileState state readLabel
        $ labelContext id.labelFlags =:: flags
        flags id.FLAG_MUTABLE & ? if
          "procedures cannot be mutable" sb.copyPtr
          fileState [] .wordStart errors appendError
        else flags id.FLAG_ALIAS & ? _if
          "procedure alias cannot have an implementation" sb.copyPtr
          fileState [] .wordStart errors appendError
        end
      else
        procImplName
      end =:: mut: procName
      ## declare procedure name outside procedure
      skipBlock if ## don't declare identifier in skipped block
        state [] .currentProcs NO_PROC list.append state .currentProcs=
        state openProcBlock
        return
      end
      _EXPERIMENTAL_ if
        procImplName procType state [] .currentFile NO_PROC fileState [] .wordStart progContext newProcData =:: procId
        procId fileState [] .wordStart opNestedProc state appendOp
        named if
          progContext newAutoType
            procName fileState [] .wordStart
          opAutoTypedInitializeName state appendOp
        end
        state [] .currentProcs procId list.append state .currentProcs=
        state openProcBlock
        ## TODO? special op for proc-start
        return
      end
      ## declare procedure
      procName
        procType
        IdentifierType .PROCEDURE
        -1 ## index
        ConstValue .None
        true ## isInit
        fileState [] .wordStart
        state [] .currentFile
        idContext
        progContext .errors
      id.declareIdentifier if ..drop.2
        state openProcBlock
        return
      end =:: idData procName=
      idData .constValue =:: procConst
      ## ensure procedure block is opened after declaring procedure,
      ##   but before early return due to error
      state openProcBlock
      procConst .?Procedure .if =:: constProcId
        progContext [] .procedures
          constProcId i64 cast list.at .data
        =:: procData
        procData .implementation .?code ? ! if
          "unexpected implementation for " sb.copyPtr
            procData [] .implementation switch
              builtIn case " built-in procedure" sb.appendS break
              alias case " procedure alias" sb.appendS break
              code case ..unreachable
            end
          fileState [] .wordStart errors appendError
          return
        end
        constProcId
      else ..drop
        procName procType state [] .currentFile NO_PROC fileState [] .wordStart progContext newProcData
          $ ConstValue .Procedure procName idContext id.getIdentifier
              ! "procName is identifier" assert
          .constValue=
      end =:: procId
      state [] .currentProcs procId list.append state .currentProcs=
      isNested if
        named if
          "named procedures cannot be nested" sb.copyPtr
          fileState [] .wordStart errors appendError
        end
        procType idData@ id.asIdInfo fileState [] .wordStart opInitializeId state appendOp
        return
      end
      ## check for invalid procedure declaration
      named and state [] .constBlockCount 0 != if
        "cannot declare named procedure in type or initializer blocks" sb.copyPtr
        fileState [] .wordStart errors appendError
      else procType typeContext types.isProcedure ! _if
        ## TODO? wrap non-procedure types in procedure: i32 =>: ... <-> ( -> i32 ) =>: ...
        "unexpected type for procedure declaration: " sb.copyPtr
          procType typeContext sb.appendType
        fileState [] .wordStart errors appendError
      end
      ## check if current procedure is main
      procName procType procId fileState [] .wordStart state checkMain
      idData .valueType idData@ id.asIdInfo fileState [] .wordStart opInitializeId state appendOp
      return
    else $ "return":s string.eq _if ..drop
      skipBlock if return end
      state [] .currentProcs .length 0:iSize == if
        "return outside procedure" sb.copyPtr fileState [] .wordStart errors appendError
      end
      ## opReturn
        Type .Undefined
        fileState [] .wordStart
      opReturn state appendOp
      fileState [] .wordStart state implicitBreakSwitch
      return
    else $ "namespace:":s string.eq _if =:: opName
      fileState errors nextIdentifier
      $
        id.NameContext .NAMESPACE
      fileState [] .wordStart progContext .errors id.checkIdentifier if
        "\"" sb.copyPtr
          >$ sb.appendStr
        "\" is not a valid namespace name" sb.appendS
        fileState [] .wordStart errors appendError return
      end
      id.FLAG_NONE fileState [] .wordStart state [] .currentFile labelContext id.newLabel
        _EXPERIMENTAL_ if
          BlockType .NAMESPACE >$ fileState [] .wordStart opLabeledBlock state appendOp
        else
          idContext id.beginNamespace
        end
      BlockInfoData .Namespace state openBlock ..drop
      return
    else $ "overload:":s string.eq _if =:: opName
      state [] .currentProcs .length 0:iSize != if
        "overload cannot be declared within procedure" sb.copyPtr
        fileState [] .wordStart errors appendError
      end
      ## TODO? allow unnamed procedures in overload: ... end block?
      skipBlock if ## skip to end of overload
        while fileState errors nextIdentifier =:: procName
          procName "end":s string.eq !
        end
        return
      end
      fileState errors nextIdentifier
        fileState state
        id.FLAG_MERGEABLE
      readLabelAddFlags =:: mut: labelId
      labelId labelContext id.labelFlags =:: labelFlags
      labelFlags id.FLAG_ALIAS & ? if
        "alias is only supported for procedure declarations" sb.copyPtr
        fileState [] .wordStart errors appendError
      end
      _EXPERIMENTAL_ if
        state opCount BlockInfoData .Overload state openBlock ..drop
        BlockType .OVERLOAD labelId fileState [] .wordStart opLabeledBlock state appendOp
        return
      end
      labelId idContext id.findDeclaredIdentifierByLabel or
          labelFlags id.FLAG_MERGE & ? ! and ## explicitly merge with parent overload
          $ [] .labelId labelContext id.getLabelNamespace labelContext id.currentNamespace .current != if ..drop
        labelFlags id.FLAG_MERGE & ? if
          "unable to merge namespace: \"" sb.copyPtr
          labelId labelContext sb.appendLabelPath
          '"' sb.appendC
          fileState [] .wordStart errors appendError
        end
        progContext [] .procBundles
          ..dup .length ProcBundleId cast =:: bundleId
          newProcBundle list.append
        progContext .procBundles=
        ## declareIdentifier
          labelId
          Type .Undefined
          IdentifierType .PROCEDURE_BUNDLE
          -1
          bundleId ConstValue .ProcedureBundle
          true
          fileState [] .wordStart
          state [] .currentFile
          idContext
          progContext .errors
        id.declareIdentifier if ..drop.2
          return
        end ..drop labelId=
        bundleId
      else =:: idData
        idData [] .idType .PROCEDURE_BUNDLE ! if
          "cannot overload \"" sb.copyPtr
            labelId labelContext sb.appendLabelPath
            "\", incompatible id-type for previous declaration: " sb.appendS
            idData [] .idType sb.appendIdType
            " ( declared at " sb.appendS
            idData [] .declaredAt sb.appendPos
            " ) expected: " sb.appendS
            IdentifierType .PROCEDURE_BUNDLE sb.appendIdType
          fileState [] .wordStart errors appendError
          return
        end
        ## XXX? warn for incompatible flags
        idData [] .constValue .ProcedureBundle
      end =:: bundleId
      ## TODO: delay overload creation to type-check phase
      progContext [] .procBundles bundleId i64 cast list.at .data =:: bundleData
      while fileState errors nextIdentifier =:: procName
        procName "end":s string.eq !
      do
        procName idContext id.findIdentifierByName if ..drop
          "could not find identifier \"" sb.copyPtr
            procName sb.appendStr
            '"' sb.appendC
          fileState [] .wordStart errors appendError
          continue
        end =:: idData
        idData [] .idType .PROCEDURE if
          idData [] .constValue .?Procedure .else ..drop
            256 sb.create
              idData [] .idType sb.appendIdType
              "missing procedure data for \"" sb.appendS
              idData [] .labelId labelContext sb.appendLabelPath
              "\" ( declared at " sb.appendS
              idData [] .declaredAt sb.appendPos
              " ) expected ProcId got:" sb.appendS
              idData [] .constValue typeContext sb.appendConstant
            fileState [] .wordStart errors appendError
            return
          end
          bundleData [] .procedures
            >$ list.append
          bundleData .procedures=
        else idData [] .idType .PROCEDURE_BUNDLE _if
          idData [] .constValue .?ProcedureBundle .else ..drop
            256 sb.create
              idData [] .idType sb.appendIdType
              "missing procedure data for \"" sb.appendS
              idData [] .labelId labelContext sb.appendLabelPath
              "\" ( declared at " sb.appendS
              idData [] .declaredAt sb.appendPos
              " ) expected ProcBundleId got:" sb.appendS
              idData [] .constValue typeContext sb.appendConstant
            fileState [] .wordStart errors appendError
            return
          end =:: constBundleId
          bundleData [] .procedures
            progContext [] .procBundles
              constBundleId i64 cast list.at .data
            [] .procedures list.appendAll
          bundleData .procedures=
        else
          256 sb.create
            idData [] .idType sb.appendIdType
            " \"" sb.appendS
            idData [] .labelId labelContext sb.appendLabelPath
            "\" ( declared at " sb.appendS
            idData [] .declaredAt sb.appendPos
            " ) is not a procedure" sb.appendS
