struct(
  NameId : varId
) =:: TmpVarInfo
struct(
  iSize list : andOrPositions
  bool : hasOr
) =:: AndOrBlockData
struct(
  iSize slice.mut : andPositions
  iSize : ifPosition
  iSize optional : elsePosition
) =:: IfBlockData
enum( WHILE DO FINALLY ) =:: WhileBlockState
struct(
  iSize list : breakPositions
  iSize list : continuePositions
  iSize : whilePosition
  WhileBlockState : state
) =:: WhileBlockData
## case-label -(case)> case-body -(break)> case-label -> (default) -> default-body
##  case-body -(return,panic) -> implicit-break -(case)> case-body
##                               implicit-break -(break)> case-label
enum( CASE_LABEL CASE_BODY IMPLICIT_BREAK DEFAULT ) =:: SwitchBlockState
struct(
  iSize list : breakPositions
  iSize : switchPosition
  iSize : prevCasePosition
  iSize optional : implicitBreak
  SwitchBlockState : state
) =:: SwitchBlockData
struct(
  iSize : blockStart
) =:: ProcBlockData
struct(
  iSize : blockStart
) =:: InitializerBlockData
struct(
  iSize : blockStart
  iSize optional : arrowPosition
  BlockType : blockType
) =:: TypeBlockData
union(
  IfBlockData : If
  AndOrBlockData : AndOr
  WhileBlockData : While
  SwitchBlockData : Switch
  ProcBlockData : Procedure
  TypeBlockData : TypeBlock
  InitializerBlockData : Initializer
  _ : Namespace
  iSize : Overload
  iSize : With
) =:: BlockInfoData
## TODO? assign block-ids in parser
struct(
  BlockInfoData : blockData
  NameId : blockName
  FilePosition ptr : openedAt
  TmpVarInfo optional : tmpVarInfo
  bool : autoClose
  bool : hasScope
) =:: BlockInfo

struct(
  ProgramContext ptr.mut : program
  TypeCheckState ptr.mut : typeChecker ## -> ? recreate for each file
  BlockInfo list : openBlocks
  Operation list : parsedOps
  i32 : constBlockCount
  FileId : currentFile
  ProcId list : currentProcs
) =:: ParserState
proc( ParserState : state -> ) =>: cleanupParserState
  state .currentProcs list.free ..drop
  state .openBlocks list.free ..drop
  state .parsedOps list.free ..drop
end

proc( FilePosition ptr : pos ParserState ptr.mut : state -> ) =>: appendWildcardConst
  ConstValue .WildCard Type .Undefined pos opConst state appendOp
end
proc( f64 : value Type : constType FilePosition ptr : pos ParserState ptr.mut : state -> ) =>: appendFloatConst
  ## Constant
    value ConstValue .Float
    constType
    pos
  opConst state appendOp
end


proc(
  i64 : value
  i32 : preferedSize
-> bool ) =>: checkIntSize
  preferedSize 0 <= or preferedSize types.MAX_INT_WIDTH >= if
    false return
  end
  value -1:i64 preferedSize 1 - << < if
    true return
  end
  value 1:i64 preferedSize << >= return
end

enum( FIXED AUTO ) =:: IntLiteralType
proc(
  i64 : value
  IntLiteralType : literalType
  Type : intType
  string : literal
  FilePosition ptr : pos
  ParserState ptr.mut : state
-> ) =>: appendIntConstant
  state [] .program =:: program
  program .errors =:: errors
  program .idContext .typeContext =:: typeContext
  literalType switch
    FIXED case
      intType typeContext types.sizeOf .Fixed .else
        "expected fixed size" ..panic
      end i32 cast 8 * =:: bitCount
      value bitCount checkIntSize if
        "integer literal overflows size for type " sb.copyPtr
          intType typeContext sb.appendType
          intType types.isPrimitive ! if
            " ( i" sb.appendS
            bitCount sb.appendU
            ')' sb.appendC
          end
          ": " sb.appendS
          literal sb.appendStr
        pos errors appendWarning
      end
      intType break
    AUTO case
      value f64.MIN_INT <  if types.intLiteral.S64 break end
      value i32.MIN i64 cast.s <  if types.intLiteral.S54 break end
      value f32.MIN_INT i64 cast.s < if types.intLiteral.S32 break end
      value i16.MIN i64 cast.s <  if types.intLiteral.S25 break end
      value  i8.MIN i64 cast.s <  if types.intLiteral.S16 break end
      value       0 <  if types.intLiteral.S8  break end
      value  i8.MAX i64 cast.u <= if types.intLiteral.U7  break end
      value i16.MAX i64 cast.u <= if types.intLiteral.U15 break end
      value f32.MAX_INT i64 cast.u <= if types.intLiteral.U24 break end
      value i32.MAX i64 cast.u <= if types.intLiteral.U31 break end
      value f64.MAX_INT <= if types.intLiteral.U53 break end
      types.intLiteral.U63
      break
  end =:: constType
  ## opConst
    value ConstValue .Int
    constType
    pos
  opConst state appendOp
end
proc(
  unicode.Codepoint : char
  FilePosition ptr : pos
  ParserState ptr.mut : state
-> ) =>: appendCharConstant
  ## newConstant
    char char8 cast ConstValue .Char
    types.CHAR8
  pos opConst state appendOp
end
proc(
  ConstValue : str
  FilePosition ptr : pos
  ParserState ptr.mut : state
-> iSize ) =>: appendStringConstant
  state [] .program =:: program
  program .errors =:: errors
  state [] .program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  idContext .constContext =:: constContext
  using types.
  str .Array8 .else
    "expected string to have type Array8" ..panic
  end =:: strArray
  strArray .length i64 cast.u ArraySize .Int =:: size
  ## opConst
    str
    types.CHAR8 types.ArrayType .POINTER size typeContext newArrayType .else
      "failed to create array-type" ..panic
    end
    pos
  opConst state appendOp
  strArray .length
end


proc( ParserState ptr.mut : state -> iSize ) =>: opCount
  state [] .parsedOps .length return
end

proc( Operation : op ParserState ptr.mut : state -> ) =>: appendOp
  state [] .program =:: program
  program .errors =:: errors
  state [] .currentProcs .length 0:iSize == and program [] .saveGlobalTokens if
    program [] .globalOps
      op list.append
    program .globalOps=
  end
  state [] .parsedOps
    op list.append
  state .parsedOps=
end

proc( ParserState ptr.mut : state -> Operation ptr.mut optional ) =>: peekOp
  state [] .parsedOps list.peek
end

proc( BlockInfoData : blockData FilePosition ptr : pos ParserState ptr.mut : state -> BlockInfoData ptr.mut ) =>: openBlock
  state [] .openBlocks
    blockData id.NAME_ID_NONE pos TmpVarInfo optional.empty false false BlockInfo new list.append
  state .openBlocks=
  state [] .openBlocks list.peek optional.unwrap .blockData
end
proc( ParserState ptr.mut : state -> ) =>: closedConstBlock
  state [] .constBlockCount
    1 -
  state .constBlockCount=
end
proc( BlockType : baseType FilePosition ptr : pos ParserState ptr.mut : state -> ) =>: openTypeBlock
  state [] .program .idContext id.openScope
  state [] .constBlockCount
    1 +
  state .constBlockCount=
  state [] .openBlocks
    ## TypeBlockData
      state opCount
      iSize optional.empty
      baseType
    TypeBlockData new BlockInfoData .TypeBlock id.NAME_ID_NONE pos TmpVarInfo optional.empty false true BlockInfo new list.append
  state .openBlocks=
end
proc( FilePosition ptr : pos ParserState ptr.mut : state -> ) =>: openInitializerBlock
  state [] .program .idContext id.openScope
  state [] .constBlockCount
    1 +
  state .constBlockCount=
  state [] .openBlocks
    ## InitializerBlockData
      state opCount
    InitializerBlockData new BlockInfoData .Initializer id.NAME_ID_NONE pos TmpVarInfo optional.empty false true BlockInfo new list.append
  state .openBlocks=
end
## TODO handle initializer blocks
proc( FilePosition ptr : pos ParserState ptr.mut : state -> ) =>: openProcBlock
  state [] .openBlocks
    ## BlockInfo
      ## ProcBlockData
        state opCount
      ProcBlockData new BlockInfoData .Procedure
      id.NAME_ID_NONE
      pos
      TmpVarInfo optional.empty
      false
      false
    BlockInfo new list.append
  state .openBlocks=
end
proc(
  ParserState ptr.mut : state
->
  BlockInfo ptr.mut optional
) =>: peekBlock
  state [] .openBlocks list.peek
end
proc(
  ParserState ptr.mut : state
->
  BlockInfo optional
) =>: closeBlock
  state [] .openBlocks .length 0:iSize == if
    BlockInfo optional.empty return
  end
  state [] .openBlocks
    list.removeLast =:: closed
  state .openBlocks=
  closed .hasScope if
    closed
      ## TODO better handling of this error case
      state [] .program .idContext id.closeScope if ..drop
        BlockInfo optional.empty
      else
        optional.wrap
      end
    return
  end
  closed optional.wrap return
end

proc( iSize : opPosition ParserState ptr.mut : state -> Operation ptr.mut optional ) =>: findOp
  state [] .parsedOps opPosition list.at
end
proc( iSize : blockPosition FilePosition ptr : pos ParserState ptr.mut : state -> ) =>: setBlockJump
  state [] .program =:: program
  program .errors =:: errors
  state [] .parsedOps blockPosition list.at .and =:: opData
      opData .val .Block .if =:: block
    state opCount
      blockPosition - JumpDistance cast
    block .jumpDistance=
  else
    "operations and blocks are out of sync" sb.copyPtr
    pos errors appendError
    return
  end
end
proc( iSize slice : blockPositions FilePosition ptr : pos ParserState ptr.mut : state -> ) =>: setBlockJumps
  state [] .program =:: program
  program .errors =:: errors
  blockPositions for =:: opPos
    state [] .parsedOps opPos list.at .and =:: opData
        opData .val .Block .if =:: block
      state opCount
        opPos - JumpDistance cast
      block .jumpDistance=
    else
      "operations and blocks are out of sync" sb.copyPtr
      pos errors appendError
      return
    end
  end
end
proc( AndOrBlockData : andOrBlock BlockType : mergeWith FilePosition ptr : pos ParserState ptr.mut : state -> iSize slice.mut ) =>: convertAndOrBlock
  state [] .program =:: program
  program .errors =:: errors
  andOrBlock .andOrPositions list.filter for =:: opPos
    opPos iSize cast.u state [] .parsedOps .length u>= if
      "operations and blocks are out of sync, could not determine position of and/or" sb.copyPtr
      pos errors appendError
      iSize slice.emptyMutable return
    end
    state [] .parsedOps opPos @[] =:: opData
    opData .val .Block .else ..drop
      "operations and blocks are out of sync, expected and/or got " sb.copyPtr
        opData [] program sb.appendOp
      pos errors appendError
      iSize slice.emptyMutable return
    end =:: blockData
    blockData [] .blockType switch
      AND case
        true
        mergeWith .DO if BlockType .AND_DO else BlockType .AND_IF end
      break
      OR case
        state opCount
          opPos - JumpDistance cast
        blockData .jumpDistance=
        false
        mergeWith .DO if BlockType .OR_DO else BlockType .OR_IF end
      break
      default
        "operations and blocks are out of sync, expected and/or got " sb.copyPtr
          blockData [] .blockType sb.appendBlockType
        pos errors appendError
      iSize slice.emptyMutable return
    end blockData .blockType=
  end list.asMutableSlice
end
proc(
  BlockType : breakType
  NameId : blockName
  FilePosition ptr : pos
  ParserState ptr.mut : state
-> BlockInfo ptr.mut optional ) =>: findBreakableBlock
  state [] .program =:: program
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  typeContext .nameContext =:: nameContext
  program .errors =:: errors
  state [] .openBlocks list.atReversed for =:: block
    block [] .blockData .While ? and blockName id.NAME_ID_NONE == or
        block [] .blockName blockName nameContext id.identifierNamesEq if
      block optional.wrap return
    end
    breakType .BREAK and block [] .blockData .Switch ? and
        blockName id.NAME_ID_NONE == or
        block [] .blockName blockName nameContext id.identifierNamesEq if
      block optional.wrap return
    end
  end
  ## TODO! adjust error message to work in case of named blocks
  64 sb.create
    breakType sb.appendBlockType
    " can only appear in loops " sb.appendS
    breakType .BREAK if
      "and switch-case statements" sb.appendS
    end
  pos errors appendError
  BlockInfo ptr.mut optional.empty return
end
proc(
  SwitchBlockData ptr : switchData
  FilePosition ptr : pos
  ParserState ptr.mut : state
-> ) =>: clearImplicitBreak
  state [] .program =:: program
  program .errors =:: errors
  switchData [] .implicitBreak .if =:: prevBreak
    state [] .parsedOps prevBreak list.at .and =:: opData
    opData .val .Block .and .blockType [] .BREAK if
      opValNOP opData .val=
    else
      "operations and blocks are out of sync" sb.copyPtr
      pos errors appendError
      return
    end
  end
end
proc(
  FilePosition ptr : pos
  ParserState ptr.mut : state
-> ) =>: implicitBreakSwitch
  state peekBlock .and =:: currentBlock
      currentBlock .blockData .Switch .if =:: switchData
    switchData pos state clearImplicitBreak
    state opCount optional.wrap switchData .implicitBreak=
    BlockType .BREAK currentBlock [] .blockName pos opNamedBlock state appendOp
  end
end

## TODO! check for unneccessary calls to wordPos (called twice without position change inbetween)
proc( FileState ptr.mut : fileState ProgramContext ptr.mut : program -> FilePosition ptr ) =>: wordPos
  program [] .programMemory
    fileState [] .wordStart mixedArena.copyValue <$
  program .programMemory=
end
proc( string : code FileState ptr.mut : fileState ProgramContext ptr.mut : program -> string string ) =>: nextIdentifier
  code
    fileState nextToken .Identifier .else =:: nameToken
      "expected identifier got:" sb.copyPtr
        nameToken sb.appendToken
      fileState program wordPos program .errors appendError
      string.empty return
    end
  return
end
## TODO? restict flag-types depending on id-type
proc(
  string : code
  string : start
  FileState ptr.mut : fileState
  ParserState ptr.mut : state
  id.IdentifierFlag : initFlags
-> string NameId ) =>: readIdentifierAddFlags
  state [] .program =:: program
  program .errors =:: errors
  program [] .inLibFile if
    id.FLAG_LIB_FILE
  else
    0:IdentifierFlag
  end =:: mut: flags
  false =:: mut: isModifier
  code start
    while
      false isModifier=
      ..dup "mut:":s string.eq if
        id.FLAG_MUTABLE flags | flags=
        true isModifier=
      else ..dup "auto:":s string.eq _if
        id.FLAG_AUTO flags | flags=
        id.FLAG_STATIC flags | flags=
        ## XXX? allow auto-args to be non-static
        ##  + error when generic-argument passed to sub-procedure
        true isModifier=
      else ..dup "static:":s string.eq _if
        id.FLAG_STATIC flags | flags=
        true isModifier=
      else ..dup "extern:":s string.eq _if
        id.FLAG_EXTERN flags | flags=
        true isModifier=
      else ..dup "export:":s string.eq _if
        id.FLAG_EXPORT flags | flags=
        true isModifier=
      else ..dup "inline:":s string.eq _if
        id.FLAG_INLINE flags | flags=
        true isModifier=
      else ..dup "no:inline:":s string.eq _if
        id.FLAG_NO_INLINE flags | flags=
        true isModifier=
      else ..dup "#:experimental:":s string.eq _if
        id.FLAG_EXPERIMENTAL flags | flags=
        true isModifier=
      else ..dup "shadow:":s string.eq _if
        id.FLAG_SHADOW flags | flags=
        true isModifier=
      else ..dup "alias:":s string.eq _if
        id.FLAG_ALIAS flags | flags=
        true isModifier=
      else ..dup "merge:":s string.eq _if
        id.FLAG_MERGE flags | flags=
        true isModifier=
      else ..dup "ignoreUnused:":s string.eq _if
        id.FLAG_IGNORE_UNUSED flags | flags=
        true isModifier=
      else ..dup "nowrap:":s string.eq _if
        id.FLAG_NO_WRAP flags | flags=
        true isModifier=
      else ..dup ":":s string.endsWith _if
        true isModifier=
      end
      isModifier ! if
        break
      end
    isModifier do ..drop
      fileState program nextIdentifier
    end
  flags initFlags | fileState program wordPos state [] .program .idContext .typeContext .nameContext id.newIdentifier return
end
proc( string : code string : start FileState ptr.mut : fileState  ParserState ptr.mut : state -> string NameId ) =>: readIdentifier
  code start fileState state 0:IdentifierFlag readIdentifierAddFlags
end

proc(
  string : literal
  IntLiteralType : literalType
  Type : intType
  FilePosition ptr : pos
  ParserState ptr.mut : state
-> bool ) =>: tryParseIntConstant
  state [] .program =:: program
  program .errors =:: errors
  program .idContext .typeContext =:: typeContext
  literal 0 number.tryParseInt switch
    NONE case
      literalType intType literal pos state appendIntConstant
      true return
    UNSIGNED case
      literalType switch
        FIXED case
          intType typeContext types.sizeOf .Fixed .else
            "expected fixed size" ..panic
          end 8 * i32 cast types.MAX_INT_WIDTH < if
            ..drop types.MAX_SIGNED_INT ## replace with maximum signed value to trigger overflow check
          end
          break
        AUTO case
          "integer value does not fit into a signed integer: " sb.copyPtr
            literal sb.appendStr
          pos errors appendWarning
          break
      end
      literalType intType literal pos state appendIntConstant
      true return
    SIGN case ..drop
      "unsigned value is marked as negative: " sb.copyPtr
        literal sb.appendStr
      pos errors appendWarning
      true return
    OVERFLOW case ..drop
      "integer value outside allowed range: " sb.copyPtr
        literal sb.appendStr
      pos errors appendError
      true return
    INT INVALID_BASE case ..unreachable
    INVALID_CHAR EMPTY case ..drop
      false return
  end
end
proc(
  string : literal
  string : literalTypeName
  FilePosition ptr : pos
  ParserState ptr.mut : state
-> bool ) =>: tryParseNumberLiteral
  state [] .program =:: program
  program .errors =:: errors
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  literal .length 0:iSize == if
    false return
  end
  literal 0 string.charAt '#' == if
    false return ## annotations
  end
  literalTypeName .length 0:iSize != if
    literalTypeName "i8":s string.eq if types.primitive.I8
    else literalTypeName "i16":s string.eq _if types.primitive.I16
    else literalTypeName "i32":s string.eq _if types.primitive.I32
    else literalTypeName "i64":s string.eq _if types.primitive.I64
    else literalTypeName "f32":s string.eq _if types.primitive.F32
    else literalTypeName "f64":s string.eq _if types.primitive.F64
    else literalTypeName idContext id.findIdentifierByName
        ..swap =:: idData ! and
        idData .idType .TYPE and idData .constValue .TypeId ._if
      []
    else
      false return
    end =:: literalType
    literalType typeContext types.isInt if
      literal IntLiteralType .FIXED literalType pos state tryParseIntConstant ! if
        "invalid integer constant: `" sb.copyPtr
          literal sb.appendStr
          '`' sb.appendC
        pos errors appendWarning
      end
      true return
    else literalType typeContext types.isFloat _if
      literal 0 number.tryParseFloat =:: errCode
      errCode .NONE or errCode .INT if
        literalType pos state appendFloatConst
        true return
      else ..drop
        "invalid float constant: `" sb.copyPtr
          literal sb.appendStr
          '`' sb.appendC
        pos errors appendWarning
      end
    else
      false return
    end
  end
  literal IntLiteralType .AUTO Type .Undefined pos state tryParseIntConstant if
    true return
  end
  literal 0 number.tryParseFloat
    ..dup .NONE if ..drop
      types.primitive.F64 pos state appendFloatConst
      true return
    else ..dup .INT _if ..drop.2
      "integer value outside allowed range: " sb.copyPtr
        literal sb.appendStr
      pos errors appendError
      true return
    end
  ..drop.2
  false return
end
proc(
  string : token
  bool : isRawString
  FileState ptr.mut : fileState
  ParserState ptr.mut : state
-> iSize ) =>: parseStringConstant
  state [] .program =:: program
  program .idContext .constContext =:: constContext
  ## appendStringConstant
    ## parseStringConstant
      token
      fileState [] .wordStart
      program .errors
      constContext
    isRawString if
      constants.parseRawStringConstant
    else
      constants.parseStringConstant
    end
    fileState program wordPos
    state
  appendStringConstant return
end
proc(
  string : token
  FileState ptr.mut : fileState
  ParserState ptr.mut : state
-> ) =>: parseCharConstant
  state [] .program =:: program
  program .errors =:: errors
  state [] .program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  idContext .constContext =:: constContext
  idContext .typeContext .nameContext =:: nameContext
  token
    fileState [] .wordStart program .errors constContext constants.parseStringConstant ## escape character
    fileState program wordPos =:: opPos
    ## TODO is check for unicode needed?, source is already utf8 would checking for length 1 be enough
    ## TODO? allow multi-char character literals (push char8 ... array)
      .Array8 .else
        "expected array8" ..panic
      end string.fromBytes
      0:iSize utf8.nextCodepoint =:: cp
    #+nextIndex+# >$ .length u< if
      "A character literal has to contain exactly one character" sb.copyPtr opPos errors appendError
    end
    0x7F =:: maxCodepoint
    cp i32 cast maxCodepoint > if
      "codepoint 0x"  sb.copyPtr
        cp i32 cast sb.appendX
        " ('" sb.appendS
        cp sb.appendCodepoint
       "') cannot be encoded as a single character" sb.appendS
      opPos errors appendError
    end
  ## appendCharConstant
    cp $ i32 cast 0 < if i32 cast -_ unicode.Codepoint cast end
  opPos state appendCharConstant
end
proc(
  Token : literalType
  FilePosition ptr : pos
  CompilerError list ptr.mut : errors
-> bool ) =>: checkLiteralType
  literalType .LiteralType .else ..drop
    "expected literal type got: " sb.copyPtr
    literalType sb.appendToken
    pos errors appendError
    true return
  end .length 0:iSize == if
    "literal type should be non-empty" sb.copyPtr
    pos errors appendError
    true return
  end
  false return
end
proc(
  string : code
  Token : token
  FileState ptr.mut : fileState
  ParserState ptr.mut : state
-> string string bool ) =>: tryParseConstant
  state [] .program =:: program
  program .errors =:: errors
  state [] .program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  idContext .constContext =:: constContext
  idContext .typeContext .nameContext =:: nameContext
  code
    token switch
      Empty case
        string.empty true return
      Eof case
        "unexpected end of file in string-literal" sb.copyPtr fileState program wordPos  errors appendError
        string.empty true return
      String .case false fileState state parseStringConstant ..drop
        string.empty true return
      RawString .case true fileState state parseStringConstant ..drop
        string.empty true return
      Char .case fileState state parseCharConstant
        string.empty true return
      Identifier .case =:: idToken
        idToken string.empty fileState program wordPos state tryParseNumberLiteral if
          string.empty true return
        end
        idToken
        break
      Literal .case =:: literalToken
        fileState program wordPos  =:: literalStart
        fileState nextToken =:: literalType
        fileState program wordPos =:: literalPos
        literalType literalPos  errors checkLiteralType if
          string.empty true return
        end
        literalType .LiteralType unionElement.unwrap =:: literalTypeName
        literalTypeName "?":s string.eq if
          false =:: mut: isElement
          literalToken
            $ .length 2:iSize u>= and $ 0 string.charAt '.' == and $ 1 string.charAt '.' != if
              1 string.tail
              true isElement=
            end
            $ "@":s string.endsWith if
              $ .length 1:iSize - string.head
            end
          nameContext id.copyString
            literalStart
            isElement if opExistsNamedElt else opExistsName end
          state appendOp
          string.empty true return
        end
        ## XXX? remove special case for number literals
        literalToken literalTypeName literalStart state tryParseNumberLiteral if
          string.empty true return
        end
        ## literal not a primitive number type -> convert to string and call literal procedure
        ## appendStringConstant
          literalToken constContext newStringConst
          literalStart
        state appendStringConstant =:: charCount
        charCount i64 cast.u ConstValue .Int
          types.I_SIZE
        literalPos  opConst state appendOp
        program [] .tmpString
          sb.clear ## clear tmp string
          ':' sb.appendC
          literalTypeName sb.appendStr
        program .tmpString=
        program [] .tmpString sb.asStr false return
      LiteralChar LiteralString LiteralRawString .case
        token .LiteralRawString ? fileState state parseStringConstant =:: charCount
        charCount i64 cast.u ConstValue .Int
          types.I_SIZE
        fileState program wordPos opConst state appendOp
        fileState nextToken =:: literalType
        fileState program wordPos =:: literalPos
        literalType literalPos errors checkLiteralType  if
          string.empty true return
        end
        literalType .LiteralType unionElement.unwrap =:: literalTypeName
        ## XXX? more usefull error for missing parse procedure?
        program [] .tmpString
          sb.clear ## clear tmp string
          ':' sb.appendC
          literalTypeName sb.appendStr
        program .tmpString=
        program [] .tmpString sb.asStr false return
      LiteralType case
        "unexpected token: " sb.copyPtr
        token sb.appendToken
        fileState program wordPos errors appendError
        string.empty true return
    end
    ..dup "_":s string.eq if
      fileState program wordPos  state appendWildcardConst
      true return
    end
  false return
end
proc(
  string #+size+#
  string : opName
  FilePosition ptr : pos
  ParserState ptr.mut : state
-> i32 ) =>: getCompilerOpParam
  state [] .program =:: program
  program .errors =:: errors
  ..dup 10 number.tryParseInt .NONE ! if ..drop
    ..dup .length 0:iSize != if
      64 sb.create
        "unexpected argument for " sb.appendS
        opName sb.appendStr
        " expected positive integer got: \"" sb.appendS
        ..swap  sb.appendStr
        '"'    sb.appendC
      pos errors appendError
    else ..drop end
    1 return
  else ..swap ..drop i32 cast ..dup 1 < _if
    50 sb.create
      "argument of " sb.appendS
        opName sb.appendStr
      " has to be positive got: " sb.appendS
      ..swap sb.appendI
    pos errors appendError
    1
  end
  return
end
proc( string : eltName bool : isWrite FilePosition ptr : pos ParserState ptr.mut : state -> ) =>: parseElementAccess
  eltName state [] .program .idContext .typeContext .nameContext id.copyString
    pos
    isWrite if
      opSetNamedElt
    else
      opGetNamedElt
    end
  state appendOp
end
proc( TmpVarInfo : varInfo FilePosition ptr : pos ParserState ptr.mut : state -> ) =>: appendItrStep
  state [] .program .idContext =:: idContext
  idContext .typeContext .nameContext =:: nameContext
  varInfo .varId nameContext id.getIdentifierName pos opGetName state appendOp
  "..itr.step":s idContext id.findIdentifierByName
    ! "..itr.step" assert
  =:: itrStep
  itrStep [] .valueType itrStep id.asIdInfo pos opGetId state appendOp
  varInfo .varId nameContext id.getIdentifierName pos opSetName state appendOp
end
proc( TmpVarInfo : varInfo FilePosition ptr : pos ParserState ptr.mut : state -> ) =>: appendItrEnd
  state [] .program .idContext =:: idContext
  idContext .typeContext .nameContext =:: nameContext
  varInfo .varId nameContext id.getIdentifierName pos opGetName state appendOp
  "..itr.end":s idContext id.findIdentifierByName
    ! "..itr.end" assert
  =:: itrEnd
  itrEnd [] .valueType itrEnd id.asIdInfo pos opGetId state appendOp
end
proc(
  FilePosition ptr : pos
  NameContext ptr.mut : nameContext
-> NameId ) =>: newItrId
  char8 32 array : buffer
  ## newIdentifier
    buffer@ sb.wrapBuffer
      "itr@" sb.appendS
      pos [] .line sb.appendI
      ":" sb.appendS
      pos [] .posInLine sb.appendI
    sb.asStr
    id.FLAG_ITR_VAR id.FLAG_MUTABLE | id.FLAG_BUILT_IN |
    pos
  nameContext id.newIdentifier
end
proc( FilePosition ptr : pos ParserState ptr.mut : state -> TmpVarInfo ) =>: appendDotIfCheck
  state [] .program =:: program
  program .idContext =:: idContext
  idContext .typeContext .nameContext =:: nameContext
  "..if.prepare":s idContext id.findIdentifierByName
    ! "..if.prepare" assert
  =:: ifPrepare
  ifPrepare [] .valueType ifPrepare id.asIdInfo pos opGetId state appendOp
  pos nameContext newItrId =:: ifName
  ifName pos opAutoTypedInitializeName state appendOp
  ifName nameContext id.getIdentifierName pos opGetName state appendOp
  "..if.check":s idContext id.findIdentifierByName
    ! "..if.check" assert
  =:: ifCheck
  ifCheck [] .valueType ifCheck id.asIdInfo pos opGetId state appendOp
  ifName TmpVarInfo new
end
proc( TmpVarInfo : varInfo ParserState ptr.mut : state FilePosition ptr : pos -> ) =>: appendElseVal
  state [] .program .idContext =:: idContext
  idContext .typeContext .nameContext =:: nameContext
  varInfo .varId nameContext id.getIdentifierName pos opGetName state appendOp
  "..if.elseVal":s idContext id.findIdentifierByName
    ! "..if.elseVal" assert
  =:: elseVal
  elseVal [] .valueType elseVal id.asIdInfo pos opGetId state appendOp
end

proc( string : code Token : token FileState ptr.mut : fileState  ParserState ptr.mut : state -> string ) =>: parseOperation
  state [] .program =:: program
  program .errors =:: errors
  program .idContext =:: idContext
  idContext .typeContext =:: typeContext
  idContext .constContext =:: constContext
  typeContext .nameContext =:: nameContext
  code
    token fileState state tryParseConstant if
      ..drop return
    end
    ..dup .length 0:iSize == if ..drop
      return ## skip empty tokens
    end
    ## 1. parse blocks
    $ "if":s string.eq or $ "_if":s string.eq or
        $ ".if":s string.eq or $ ".else":s string.eq or
        $ "._if":s string.eq or $ "._else":s string.eq if =:: opName
      opName 0 string.charAt '.' == =:: hasDot
      opName .length 4 u> =:: hasElse
      opName 0 string.charAt '_' == or opName 1 string.charAt '_' == end =:: autoClose
      fileState program wordPos =:: blockPos
      state peekBlock .and =:: currentBlock
          currentBlock .blockData [] .AndOr .if $ .hasOr =:: hasOr
        ## sequence of ands -> allow access to local variables from if-branch
          BlockType .IF
          blockPos
        state convertAndOrBlock =:: andPositions
        ## IfBlockData
          andPositions
          state opCount
          iSize optional.empty
        IfBlockData new currentBlock .blockData .If=
        hasOr
      else
        ## IfBlockData
          iSize slice.emptyMutable
          state opCount
          iSize optional.empty
        IfBlockData new BlockInfoData .If blockPos state openBlock ..drop
        false
      end =:: hasOrIf
      state peekBlock .else
        "expected block" ..panic
      end =:: current
      current .blockData .If .else
        "expected top block to be if" ..panic
      end =:: ifData
      autoClose if
        state [] .openBlocks $ .length 2 - list.get .and .blockData .If .and .elsePosition ? if
          true current .autoClose=
        else
          "'_if' is only allowed in if-else-blocks" sb.copyPtr blockPos errors appendError
        end
      end
      hasDot if
        blockPos state appendDotIfCheck optional.wrap current .tmpVarInfo=
        ## patch if-position after inserting dot-if operations
        state opCount ifData .ifPosition=
      end
      BlockType .IF  blockPos opBlock  state appendOp
      hasDot if
        current .tmpVarInfo [] .else
          "expected if-block to have tmp-var" ..panic
        end =:: varInfo
        hasOrIf ! if
          varInfo .varId nameContext id.getIdentifierName blockPos opGetName state appendOp
          "..if.ifVal":s idContext id.findIdentifierByName
            ! "..if.ifVal" assert
          =:: ifGet
          ifGet [] .valueType ifGet id.asIdInfo blockPos opGetId state appendOp
        else ifData [] .andPositions .length 0 != _if
          ".if has no effect on if-statements with both `and` and `or` statements" sb.copyPtr
          blockPos errors appendWarning
        end
        hasElse if
          state opCount optional.wrap ifData .elsePosition=
          ifData [] .ifPosition blockPos state setBlockJump
          ifData [] .andPositions slice.freeze blockPos state setBlockJumps
          state peekBlock .and current == end "top pointer does not change" assert
          BlockType .ELSE blockPos opBlock state appendOp
          ifData [] .andPositions .length 0 == if
            varInfo state blockPos appendElseVal
          end
        end
      end
      return
    else $ "and":s string.eq or $ "or":s string.eq or
        $ ".and":s string.eq or $ ".or":s string.eq _if =:: opName
      opName "or":s string.endsWith =:: isOr
      fileState program wordPos =:: blockPos
      opName 0 string.charAt '.' == if
        blockPos state appendDotIfCheck optional.wrap
      else TmpVarInfo optional.empty end =:: varInfo?
      isOr if BlockType .OR else BlockType .AND end =:: blockType
      state peekBlock .and .blockData .AndOr .if =:: andOrData
        isOr if
          true andOrData .hasOr=
        end
        andOrData
      else ## not already within an and-or chain
        ## AndOrBlockData
          8 iSize list.create ## TODO? pool of short lists for and-or blocks
          isOr
        AndOrBlockData new BlockInfoData .AndOr blockPos state openBlock .AndOr .else
          "opening AndOr should return AndOr" ..panic
        end
      end =:: andOrBlock
      ## remember position to allow changing block-type when merging with if/do
      andOrBlock [] .andOrPositions
        state opCount list.append
      andOrBlock .andOrPositions=
      blockType blockPos opBlock  state appendOp
      varInfo? .if =:: varInfo
        varInfo .varId nameContext id.getIdentifierName blockPos opGetName state appendOp
        isOr if "..if.elseVal":s else "..if.ifVal":s end idContext id.findIdentifierByName
          ! "and/or val" assert
        =:: ifGet
        ifGet [] .valueType ifGet id.asIdInfo blockPos opGetId state appendOp
      end
      return
    else $ "else":s string.eq _if ..drop
      fileState program wordPos =:: blockPos
      state peekBlock .else
        "'else' is only allowed in if-blocks" sb.copyPtr blockPos errors appendError
        return
      end =:: currentBlock
      currentBlock .blockData .If .if
        $ [] .elsePosition ? if ..drop
          "if block can only contain one 'else' statement" sb.copyPtr blockPos errors appendError
          return
        end
      else ..drop
        "'else' is only allowed in if-blocks" sb.copyPtr blockPos errors appendError
        return
      end =:: ifBlockData
      state opCount optional.wrap ifBlockData .elsePosition=
      ifBlockData [] .ifPosition blockPos state setBlockJump
      ifBlockData [] .andPositions .length 0 != =:: hasAnd
      ifBlockData [] .andPositions slice.freeze blockPos state setBlockJumps
      BlockType .ELSE blockPos opBlock  state appendOp
      hasAnd ! and currentBlock [] .tmpVarInfo .if
        state blockPos appendElseVal
      end
      return
    else $ "while":s string.eq or $ "while:":s string.eq _if =:: opName
      opName "while:":s string.eq if
        fileState program nextIdentifier
          id.FLAG_NONE
          fileState program wordPos
        nameContext id.newIdentifier
      else
        id.NAME_ID_NONE
      end =:: blockName
      fileState program wordPos =:: blockPos
      ## WhileBlockData
        16 iSize list.create
        16 iSize list.create
        state opCount
        WhileBlockState .WHILE
      WhileBlockData new BlockInfoData .While blockPos state openBlock ..drop
      blockName state peekBlock optional.unwrap .blockName=
      BlockType .WHILE blockName blockPos opNamedBlock state appendOp
      return
    else $ "for":s string.eq or $ "for:":s string.eq _if =:: opName
      opName "for:":s string.eq if
        fileState program nextIdentifier
          id.FLAG_NONE
          fileState program wordPos
        nameContext id.newIdentifier
      else
        id.NAME_ID_NONE
      end =:: blockName
      fileState program wordPos =:: blockPos
      "..itr.prepare":s idContext id.findIdentifierByName
        ! "..itr.prepare" assert
      =:: itrPrepare
      itrPrepare [] .valueType itrPrepare id.asIdInfo blockPos opGetId state appendOp
      blockPos idContext .typeContext .nameContext newItrId =:: itrId
      itrId blockPos opAutoTypedInitializeName state appendOp
      state opCount =::  whilePos
      BlockType .WHILE blockName blockPos opNamedBlock state appendOp
      itrId nameContext id.getIdentifierName blockPos opGetName state appendOp
      "..itr.check":s idContext id.findIdentifierByName
        ! "..itr.check" assert
      =:: itrCheck
      itrCheck [] .valueType itrCheck id.asIdInfo blockPos opGetId state appendOp
      state opCount =::  doPos
      BlockType .DO blockPos opBlock  state appendOp
      itrId nameContext id.getIdentifierName blockPos opGetName state appendOp
      "..itr.get":s idContext id.findIdentifierByName
        ! "..itr.get" assert
      =:: itrGet
      itrGet [] .valueType itrGet id.asIdInfo blockPos opGetId state appendOp
      ## WhileBlockData
        16 iSize list.create
          doPos list.append
        16 iSize list.create
        whilePos
        WhileBlockState .DO
      WhileBlockData new BlockInfoData .While blockPos state openBlock ..drop
      blockName state peekBlock optional.unwrap .blockName=
      itrId TmpVarInfo new optional.wrap state peekBlock optional.unwrap .tmpVarInfo=
      return
    else $ "do":s string.eq or $ ".do":s string.eq _if =:: opName
      fileState program wordPos =:: blockPos
      state peekBlock .and =:: currentBlock
          currentBlock .blockData .AndOr ? if
        state closeBlock .and .blockData .AndOr .else
          "closed block does not match current block" ..panic
        end BlockType .DO blockPos state convertAndOrBlock
      else iSize slice.emptyMutable end =:: andPositions
      state peekBlock .and .blockData .While .else
        "'do' is only allowed in while-blocks" sb.copyPtr blockPos errors appendError
        return
      end =:: whileData
      whileData [] .state .WHILE ! if
        "while-block can only contain a single 'do' statement" sb.copyPtr blockPos errors appendError
        return
      end
      WhileBlockState .DO whileData .state=
      opName 0 string.charAt '.' == if
        blockPos state appendDotIfCheck optional.wrap
      else TmpVarInfo optional.empty end =:: varInfo?
      whileData [] .breakPositions
        andPositions slice.freeze list.appendSlice
        andPositions slice.free ..drop
        state opCount list.append
      whileData .breakPositions=
      BlockType .DO blockPos opBlock  state appendOp
      varInfo? .if =:: varInfo
        varInfo .varId nameContext id.getIdentifierName blockPos opGetName state appendOp
        "..if.ifVal":s idContext id.findIdentifierByName
          ! "and/or val" assert
        =:: ifGet
        ifGet [] .valueType ifGet id.asIdInfo blockPos opGetId state appendOp
      end
      ## TODO? return else value at end of `while`, if `.do` is only branch to end
      return
    else $ "finally":s string.eq _if =:: opName
      fileState program wordPos =:: blockPos
      state peekBlock .and .blockData .While .else
        "'finally' is only allowed in while-blocks" sb.copyPtr blockPos errors appendError
        return
      end =:: whileData
      whileData [] .state switch
        WHILE case
          whileData [] .breakPositions state opCount list.append whileData .breakPositions=
          BlockType .DO blockPos opBlock  state appendOp
        break
        DO case break
        FINALLY case
          "while-blocks can only contain a single 'finally' statement" sb.copyPtr blockPos errors appendError
        return
      end
      whileData [] .continuePositions list.asSlice blockPos state setBlockJumps
      WhileBlockState .FINALLY whileData .state=
      BlockType .FINALLY blockPos opBlock  state appendOp
      ## update for-loop iterator
      state peekBlock .and .tmpVarInfo [] .if
        blockPos state appendItrStep
      end
      return
    else $ "break":s string.eq or $ "break.":s string.startsWith or
      $ "continue":s string.eq or $ "continue.":s string.startsWith _if =:: opName
      opName 0 string.charAt 'c' == =:: isContinue ## ! checking length is not correct
      opName '.' string.split ..drop =:: breakName
      fileState program wordPos =:: blockPos
      breakName .length 0:iSize != if
        ## newIdentifier
          breakName
          id.FLAG_NONE
          blockPos
        nameContext id.newIdentifier
      else
        id.NAME_ID_NONE
      end =:: blockName
      isContinue if BlockType .CONTINUE else BlockType .BREAK end =:: blockType
      blockType blockName blockPos state findBreakableBlock .else
        return ## error message handled by findBreakableBlock
      end =:: breakBlock
      breakBlock .blockData .While .if =:: whileData
        isContinue if
          whileData .state .FINALLY if
            "continue cannot be used after 'finally' statement" sb.copyPtr blockPos errors appendError
            return
          end
          whileData [] .continuePositions
            state opCount list.append
          whileData .continuePositions=
        else
          whileData [] .breakPositions
            state opCount list.append
          whileData .breakPositions=
        end
      else .Switch ._if =:: switchData
        switchData blockPos state clearImplicitBreak
        isContinue if
          "unimplemented: continue switch" ..panic
        end
        switchData [] .breakPositions
          state opCount list.append
        switchData .breakPositions=
      else
        "unsupported block for break" ..panic
      end
      blockType blockName blockPos opNamedBlock state appendOp
      ## broken block is not the same as innermost block
      state peekBlock .and .blockName breakBlock .blockName != if
        blockPos state implicitBreakSwitch
      end
      return
    else $ "switch":s string.eq or $ "switch:":s string.eq _if =:: opName
      opName "switch:":s string.eq if
        fileState program nextIdentifier
          id.FLAG_NONE
          fileState program wordPos
        nameContext id.newIdentifier
      else
        id.NAME_ID_NONE
      end =:: blockName
      fileState program wordPos =:: blockPos
      ## SwitchBlockData
        16 iSize list.create
        state opCount
        state opCount
        iSize optional.empty
        SwitchBlockState .CASE_LABEL
      SwitchBlockData new BlockInfoData .Switch blockPos state openBlock ..drop
      blockName state peekBlock optional.unwrap .blockName=
      BlockType .SWITCH blockName blockPos opNamedBlock state appendOp
      return
    ## TODO? remember if if contains .case / .default
    else $ "case":s string.eq or $ ".case":s string.eq _if =:: opName
      fileState program wordPos =:: blockPos
      state peekBlock .and .blockData .Switch .if =:: switchData
        switchData .state .DEFAULT if
          "unexpected 'case' statement, 'default' has to be the last branch of switch" sb.copyPtr
          blockPos errors appendError
        else switchData .state .CASE_LABEL ! and switchData .state .IMPLICIT_BREAK ! _if
          "unexpected 'case' statement, missing 'break' at end of case-body" sb.copyPtr
          blockPos errors appendError
        end
        SwitchBlockState .CASE_LABEL switchData .state=
        iSize optional.empty switchData .implicitBreak=
        switchData [] .prevCasePosition blockPos state setBlockJump
        state opCount switchData .prevCasePosition=
        opName 0 string.charAt '.' == if
          BlockType .DOT_CASE
        else
          BlockType .CASE
        end blockPos opBlock  state appendOp
        return
      else
        "'case' is only allowed in switch-blocks" sb.copyPtr blockPos errors appendError
        return
      end
    ## TODO? merge with `case`
    else $ "default":s string.eq or $ ".default":s string.eq _if =:: opName
      fileState program wordPos =:: blockPos
      state peekBlock .and .blockData .Switch .if =:: switchData
        switchData .state .DEFAULT if
          "unexpected 'default' statement, switch-block already has a 'default' branch" sb.copyPtr
          blockPos errors appendError
        else switchData .state .CASE_LABEL ! and switchData .state .IMPLICIT_BREAK ! _if
          "unexpected 'default' statement, missing 'break' at end of case-body" sb.copyPtr
          blockPos errors appendError
        end
        SwitchBlockState .DEFAULT switchData .state=
        iSize optional.empty switchData .implicitBreak=
        switchData [] .prevCasePosition blockPos state setBlockJump
        state opCount switchData .prevCasePosition=
        opName 0 string.charAt '.' == if
          BlockType .DOT_DEFAULT
        else
          BlockType .DEFAULT
        end blockPos opBlock  state appendOp
        return
      else
        "'default' is only allowed in switch-case-blocks" sb.copyPtr blockPos errors appendError
        return
      end
    else $ "=>":s string.eq or $ "=>:":s string.eq _if =:: opName
      opName .length 3:iSize == =:: named
      state [] .currentProcs .length 0:iSize != =:: isNested
      ## TODO? ensure global stack is empty at start of procedure
      char8 32 array : buffer
        buffer@ sb.wrapBuffer
          "lambda@" sb.appendS
          fileState [] .wordStart .line sb.appendI
          ":" sb.appendS
          fileState [] .wordStart .posInLine sb.appendI
        sb.asStr
        id.FLAG_LAMBDA
        fileState program wordPos
      nameContext id.newIdentifier =:: procImplName
      named if ## =>:
        fileState program nextIdentifier fileState state readIdentifier
        $ nameContext id.identifierFlags =:: flags
        fileState program wordPos =:: idPos
        flags id.FLAG_MUTABLE & ? if
          "procedures cannot be mutable" sb.copyPtr
          idPos errors appendError
        else flags id.FLAG_ALIAS & ? _if
          "procedure alias cannot have an implementation" sb.copyPtr
          idPos errors appendError
          idPos >>$
            fileState program nextIdentifier
              id.FLAG_NONE
              fileState program wordPos
            nameContext id.newIdentifier <<<$
          <<<$ opAliasName state appendOp
          return
        end
      else
        procImplName
      end =:: mut: procName
      fileState program wordPos =:: procPos
      ## declare procedure name outside procedure
      procImplName Type .Undefined state [] .currentFile ProcId optional.empty true procPos program newProcData =:: procId
      procId procPos opNestedProc state appendOp
      named if
        procName procPos opAutoTypedInitializeName state appendOp
      end
      state [] .currentProcs procId list.append state .currentProcs=
      procPos state openProcBlock
      ## TODO? special op for proc-start
      return
    else $ "return":s string.eq _if ..drop
      fileState program wordPos =:: retPos
      state [] .currentProcs .length 0:iSize == if
        "return outside procedure" sb.copyPtr retPos errors appendError
      end
      ## opReturn
        Type .Undefined
        retPos
      opReturn state appendOp
      retPos state implicitBreakSwitch
      return
    else $ "namespace:":s string.eq _if =:: opName
      fileState program nextIdentifier
      fileState program wordPos =:: namePos
      $
        id.DeclarationContext .NAMESPACE
      namePos program .errors id.checkIdentifier if
        "\"" sb.copyPtr
          >$ sb.appendStr
        "\" is not a valid namespace name" sb.appendS
        namePos errors appendError return
      end
      id.FLAG_NONE namePos nameContext id.newIdentifier
        BlockType .NAMESPACE >$ namePos opNamedBlock state appendOp
      BlockInfoData .Namespace namePos state openBlock ..drop
      return
    else $ "overload:":s string.eq _if =:: opName
      state [] .currentProcs .length 0:iSize != if
        "overload cannot be declared within procedure" sb.copyPtr
        fileState program wordPos errors appendError
      end
      fileState program nextIdentifier
        fileState state
        id.FLAG_MERGEABLE
      readIdentifierAddFlags =:: mut: nameId
      nameId nameContext id.identifierFlags =:: identifierFlags
      fileState program wordPos =:: namePos
      identifierFlags id.FLAG_ALIAS & ? if
        "alias is only supported for procedure declarations" sb.copyPtr
        namePos errors appendError
      end
      state opCount BlockInfoData .Overload namePos state openBlock ..drop
      BlockType .OVERLOAD nameId namePos opNamedBlock state appendOp
      return
    else $ "end":s string.eq _if ..drop
      fileState program wordPos =:: blockPos
      while
        state closeBlock .else
          "unexpected 'end'" sb.copyPtr blockPos errors appendError
          return
        end =:: closedBlock
        closedBlock .blockData switch
          If .case =:: ifData
            ifData .elsePosition .if
              blockPos state setBlockJump
            else
              ifData .ifPosition blockPos state setBlockJump
              ifData .andPositions .length 0 != =:: hasAnd
              ifData .andPositions slice.freeze blockPos state setBlockJumps
              BlockType .ELSE blockPos opBlock  state appendOp
              1:JumpDistance state peekOp .and .val .Block .if .jumpDistance= else ..drop end
              hasAnd ! and closedBlock .tmpVarInfo .if
                state blockPos appendElseVal
              end
            end
            BlockType .ELSE blockPos opEndBlock  state appendOp
            ifData .andPositions slice.free ..drop
          break
          AndOr .case =:: andOrData
            andOrData .andOrPositions list.asSlice blockPos state setBlockJumps
            andOrData .andOrPositions list.free ..drop
            BlockType .AND blockPos opEndBlock  state appendOp
          break
          While .case =:: whileData
            whileData .breakPositions =:: mut: breakPositions
            whileData .state .WHILE if
              breakPositions state opCount list.append breakPositions=
              BlockType .DO blockPos opBlock  state appendOp
              BlockType .FINALLY blockPos opBlock  state appendOp
            else whileData .state .DO _if
              BlockType .FINALLY blockPos opBlock  state appendOp
              closedBlock .tmpVarInfo .if
                blockPos state appendItrStep
              end
            end
            breakPositions list.asSlice blockPos state setBlockJumps
            whileData .whilePosition blockPos state setBlockJump
            BlockType .FINALLY blockPos opEndBlock  state appendOp
            whileData .whilePosition
              state opCount - JumpDistance cast
            state peekOp .and .val .BlockEnd .if .jumpDistance= else ..drop end
            closedBlock .tmpVarInfo .if
              blockPos state appendItrEnd
            end
            breakPositions list.free ..drop
            whileData .continuePositions list.free ..drop
          break
          Switch .case =:: switchData
            switchData .breakPositions list.asSlice blockPos state setBlockJumps
            switchData .prevCasePosition blockPos state setBlockJump
            switchData .switchPosition blockPos state setBlockJump
            ## allow switch without default (behavior depends on switched type)
            BlockType .SWITCH blockPos opEndBlock  state appendOp
            switchData .breakPositions list.free ..drop
          break
          Procedure .case =:: procBlockData
            state [] .currentProcs
              $ .length 0 != if ## append op before poping procedure
                BlockType .PROCEDURE blockPos opEndBlock  state appendOp
              else ..drop ## current-procs are empty -> no pop possible
                "unexpected end of procedure" sb.copyPtr blockPos errors appendError
                return
              end
              list.removeLast =:: currentProcId
            state .currentProcs=
            currentProcId ProcId.getProcInfo =:: currentProc
            currentProc .implementation .Code .else
              "expected code-implementation" ..panic
            end =:: codeImpl
            state [] .parsedOps list.asSlice
              procBlockData .blockStart slice.tail
              $ 0 @[] =:: procStart
              slice.copy
            codeImpl .code=
            state [] .parsedOps
              procBlockData .blockStart list.setLength
            state .parsedOps=
          break
          Namespace case
            BlockType .NAMESPACE blockPos opEndBlock state appendOp
          break
          Overload .case =:: blockStart
            blockStart blockPos state setBlockJump
            BlockType .OVERLOAD blockPos opEndBlock state appendOp
          break
          TypeBlock Initializer With case
            state closedConstBlock
            ## TODO print block name
            "unexpected 'end' statement in type- or initializer-block" sb.copyPtr
            blockPos errors appendError
          break
        end
        closedBlock .autoClose
      do end
      return
    else $ "(":s string.eq _if ..drop
      fileState program wordPos =:: blockPos
      BlockType .TYPE_COMPOSITE blockPos state openTypeBlock
      BlockType .TYPE_COMPOSITE blockPos opBlock state appendOp
      return
    else $ "tuple(":s string.eq _if ..drop
      fileState program wordPos =:: blockPos
      BlockType .TYPE_TUPLE blockPos state openTypeBlock
      BlockType .TYPE_TUPLE blockPos opBlock state appendOp
      return
    ## forward compatability: `struct.fixed` will be used for structure with fixed element order
    ## forward compatability: `struct.c` will be used for structure with c-style padding
    else $ "struct(":s string.eq or $ "struct.fixed(":s string.eq or $ "struct.c(":s string.eq _if ..drop
      fileState program wordPos =:: blockPos
      BlockType .TYPE_STRUCT blockPos state openTypeBlock
      BlockType .TYPE_STRUCT blockPos opBlock state appendOp
      return
    else $ "union(":s string.eq _if ..drop
      fileState program wordPos =:: blockPos
      BlockType .TYPE_UNION blockPos state openTypeBlock
      BlockType .TYPE_UNION blockPos opBlock state appendOp
      return
    else $ "union.raw(":s string.eq _if ..drop
      fileState program wordPos =:: blockPos
      BlockType .TYPE_UNTAGGED_UNION blockPos state openTypeBlock
      BlockType .TYPE_UNTAGGED_UNION blockPos opBlock state appendOp
      return
    else $ "enum(":s string.eq _if ..drop
      fileState program wordPos =:: blockPos
      BlockType .TYPE_ENUM blockPos state openTypeBlock
      BlockType .TYPE_ENUM blockPos opBlock state appendOp
      return
    ## forward compatability: `proc.c` will be used for proc with c-call convention
    else $ "proc(":s string.eq or $ "proc.c(":s string.eq _if =:: opName
      opName .length "proc(":s .length == if
        BlockType .TYPE_PROC_IN
      else
        BlockType .TYPE_CPROC_IN
      end =:: procBlockType
      fileState program wordPos =:: blockPos
      procBlockType blockPos state openTypeBlock
      procBlockType blockPos opBlock state appendOp
      return
    else $ "->":s string.eq _if =:: opName
      fileState program wordPos =:: blockPos
      state peekBlock .and =:: currentBlock
          currentBlock .blockData .TypeBlock .if =:: typeData
        typeData [] .arrowPosition .if =:: oldArrowPos
          "type-blocks cannot contain multiple `" sb.copyPtr
            opName sb.appendStr
            "` statements" sb.appendS
            ## TODO? point to previous use
          blockPos errors appendError
        else
          state opCount optional.wrap typeData .arrowPosition=
        end
        typeData
      else
        "unexpected `" sb.copyPtr
          opName sb.appendStr
          "` statement" sb.appendS
        blockPos errors appendError
        return
      end =:: typeBlock
      typeBlock [] .blockType switch
        TYPE_PROC_IN TYPE_CPROC_IN case break
        TYPE_COMPOSITE case
          typeBlock [] .blockStart state findOp .if =:: oldOp
            oldOp .val .Block .and .blockType =:: blockType
                blockType [] .TYPE_COMPOSITE if
              BlockType .TYPE_PROC_IN blockType =[]
            else
              "blocks and operations out of sync expected start of composite type got: " sb.copyPtr
                oldOp [] program sb.appendOp
              blockPos errors appendError
              return
            end
          end
          BlockType .TYPE_PROC_IN typeBlock .blockType=
        break
        default
          "unexpected " sb.copyPtr
            opName sb.appendStr
            " statement" sb.appendS
            ## TODO! print block name
          blockPos errors appendError
        return
      end
      BlockType .TYPE_PROC_ARROW blockPos opBlock state appendOp
      return
    else $ "oneOf(":s string.eq _if ..drop
      fileState program wordPos =:: blockPos
      BlockType .TYPE_SETTYPE blockPos state openTypeBlock
      BlockType .TYPE_SETTYPE blockPos opBlock state appendOp
      return
    else $ ".with(":s string.eq _if ..drop
      fileState program wordPos =:: blockPos
      state opCount BlockInfoData .With blockPos state openBlock ..drop
      char8 32 array : buffer
        buffer@ sb.wrapBuffer
          "with@" sb.appendS
          fileState [] .wordStart .line sb.appendI
          ":" sb.appendS
          fileState [] .wordStart .posInLine sb.appendI
        sb.asStr
        id.FLAG_LAMBDA id.FLAG_IGNORE_UNUSED |
        blockPos
      nameContext id.newIdentifier
        Type .Undefined
        state [] .currentFile
        ProcId optional.empty true
      blockPos program newProcData =:: procId
      state [] .currentProcs procId list.append state .currentProcs=
      return
    else $ ")":s string.eq _if =:: opName
      fileState program wordPos =:: blockPos
      state closeBlock .else
        "unexpected " sb.copyPtr opName sb.appendStr blockPos errors appendError
        return
      end .blockData switch
        TypeBlock .case =:: mut: typeBlock
          typeBlock .blockStart blockPos state setBlockJump
          typeBlock .blockType
            $ .TYPE_COMPOSITE if ..drop
              BlockType .TYPE_STRUCT
              typeBlock .blockStart state findOp .if =:: oldOp
                oldOp .val .Block .and .blockType =:: blockType
                    blockType [] .TYPE_COMPOSITE if
                  $ blockType =[]
                else ..drop
                  "blocks and operations out of sync expected start of composite type got: " sb.copyPtr
                    oldOp [] program sb.appendOp
                  blockPos errors appendError
                  return
                end
              end
            end
          blockPos opEndBlock state appendOp
          state closedConstBlock
        return
        With .case =:: offset
          state [] .currentProcs
            $ .length 0 != if ## append op before poping procedure
              BlockType .PROCEDURE blockPos opEndBlock  state appendOp
            else ..drop ## current-procs are empty -> no pop possible
              "unexpected end of procedure" sb.copyPtr blockPos errors appendError
              return
            end
            list.removeLast =:: withProcId
          state .currentProcs=
          withProcId ProcId.getProcInfo =:: withProc
          state [] .parsedOps
            offset list.tail
            slice.copy
          withProc .implementation .Code .else
            "expected code-implementation" ..panic
          end .code=
          state [] .parsedOps
            offset list.setLength
          state .parsedOps=
          withProcId blockPos opTypeWith state appendOp
        return
        If AndOr While Switch Namespace Procedure Initializer Overload case
          "unexpected `" sb.copyPtr
            opName sb.appendStr
            "` statement " sb.appendS
            ## TODO print block name
          blockPos errors appendError
        return
      end
    else $ "{":s string.eq _if ..drop
      fileState program wordPos =:: blockPos
      blockPos state openInitializerBlock
      BlockType .INITIALIZER blockPos opBlock state appendOp
      return
    else $ "}":s string.eq _if =:: opName
      fileState program wordPos =:: blockPos
      state closeBlock .else
        "unexpected " sb.copyPtr opName sb.appendStr blockPos errors appendError
        return
      end .blockData switch
        Initializer .case =:: initData
          state closedConstBlock
          initData .blockStart blockPos state setBlockJump
          BlockType .INITIALIZER blockPos opEndBlock state appendOp
        return
        TypeBlock case
          state closedConstBlock
        break
        default break
      end
      "unexpected " sb.copyPtr opName sb.appendStr blockPos errors appendError
      return
    ## 2. parse keywords & built-in operators
    else $ ":":s string.eq or $ "=:":s string.eq _if =:: opName
      ## TODO extract declaration parser into procedure?
      opName ":":s string.eq ! =:: isInit
      state [] .currentProcs .length 0:iSize != =:: mut: inProcedure
      state [] .constBlockCount 0 != =:: mut: inConstBlock
      inProcedure and inConstBlock if
        ## ensure only the innermost proc/constant is active
        BlockType ..length 33:iSize == "no new block types" assert
        state [] .openBlocks list.reversed for: findContainer =:: b
          b .blockData switch
            Procedure case
              false inConstBlock=
              break.findContainer
            Initializer TypeBlock Namespace case
              false inProcedure=
              break.findContainer
            default break
          end
        end
      end
      fileState program nextIdentifier fileState state
        ## make pre-declared variables mutable by default
        isInit ! and inProcedure if id.FLAG_MUTABLE else id.FLAG_NONE end
      readIdentifierAddFlags =:: mut: label
      label nameContext id.identifierFlags =:: identifierFlags
      identifierFlags id.FLAG_ALIAS & ? =:: isAlias
      fileState program wordPos =:: opPos
      isAlias and isInit if
        "alias cannot have an implementation" sb.copyPtr
        opPos errors appendError
      end
      label opPos
        isInit if
          opInitializeName
        else isAlias _if
          >>$
            fileState program nextIdentifier
              id.FLAG_NONE
              opPos
            nameContext id.newIdentifier <<<$
          <<<$ opAliasName
        else
          opDeclareName
        end
      state appendOp
      return
    else $ "=::":s string.eq _if ..drop
      fileState program nextIdentifier fileState state readIdentifier =:: mut: nameId
      fileState program wordPos =:: opPos
      nameId nameContext id.identifierFlags id.FLAG_ALIAS & ? if
        "alias is only supported for procedure declarations" sb.copyPtr
        opPos errors appendError
      end
      nameId opPos opAutoTypedInitializeName state appendOp
      return
    else $ .length 1:iSize u> and $ 0 string.charAt '.' == and $ 1 string.charAt '.' != _if
      fileState program wordPos =:: opPos
      1 string.tail
        $ "=":s string.endsWith =:: isWrite
        isWrite if
          $ .length 1:iSize - string.head
        end
      isWrite opPos state parseElementAccess return
    else ..dup "()":s string.eq _if ..drop
      fileState program wordPos opCallPtr state appendOp
      return
    else ..dup "new":s string.eq _if =:: opName
      ## new in procedure -> determine type in type-check phase
      Type .Undefined fileState program wordPos opNew state appendOp
      return
    #+ TODO improve cast system +#
    else ..dup "cast":s string.eq or ..dup "cast!":s string.eq _if =:: opName
      opName "cast!":s string.eq =:: forceCast
      fileState program wordPos =:: opPos
      Type .Undefined
        forceCast if
          opPos
          opCast!
        else
          SignType .NONE
          opPos
          opCast
        end
      state appendOp
      return
    else ..dup "..bitcast":s string.eq _if =:: opName
      Type .Undefined
        fileState program wordPos
      opBitCast state appendOp
      return
    else ..dup "cast.s":s string.eq _if =:: opName
      Type .Undefined
        SignType .SIGNED
        fileState program wordPos
      opCast state appendOp
      return
    else ..dup "cast.u":s string.eq _if =:: opName
      Type .Undefined
        SignType .UNSIGNED
        fileState program wordPos
      opCast state appendOp
      return
    else ..dup "..length":s string.eq _if ..drop
      fileState program wordPos opLength state appendOp
      return
    else ..dup "..raw":s string.eq _if ..drop
      fileState program wordPos opRawValue state appendOp
      return
    else $ "..tag":s string.eq _if ..drop
      fileState program wordPos opGetUnionTag state appendOp
      return
    else ..dup "..types.alignment":s string.eq or
         ..dup "..types.size":s string.eq or
         ..dup "..types.stride":s string.eq _if =:: opName
     opName "..types.alignment":s string.eq if
       TypeMemoryInfo .ALIGNMENT
     else opName "..types.size":s string.eq _if
       TypeMemoryInfo .SIZE
     else
       TypeMemoryInfo .STRIDE
     end =:: infoType
      Type .Undefined
      infoType fileState program wordPos opTypeInfo state appendOp
      return
    else ..dup "..unreachable":s string.eq _if ..drop
      fileState program wordPos =:: opPos
      "reached `..unreachable` statement":s opPos opPanicWithMessage state appendOp
      opPos state implicitBreakSwitch
      return
    else ..dup "..panic":s string.eq _if ..drop
      fileState program wordPos =:: opPos
      opPos opPanic state appendOp
      opPos state implicitBreakSwitch
      return
    else ..dup "ptr":s string.eq _if ..drop
      TypeModifier .PTR fileState program wordPos opTypeModifier state appendOp
      return
    else ..dup "ptr.mut":s string.eq _if ..drop
      TypeModifier .PTR_MUT fileState program wordPos opTypeModifier state appendOp
      return
    else ..dup "array":s string.eq _if ..drop
      TypeModifier .ARRAY fileState program wordPos opTypeModifier state appendOp
      return
    else ..dup "ptr.raw":s string.eq _if ..drop
      TypeModifier .RAW_PTR fileState program wordPos opTypeModifier state appendOp
      return
    else ..dup "ptr.raw.mut":s string.eq _if ..drop
      TypeModifier .RAW_PTR_MUT fileState program wordPos opTypeModifier state appendOp
      return
    else ..dup "...":s string.eq _if ..drop
      fileState program wordPos opSplat state appendOp
      return
    else ..dup "..dup":s string.eq _if =:: opName ## XXX? completely repalce ..dup by $ ?
      0 StackModType .COPY fileState program wordPos opStackMod state appendOp
      return
    else ..dup "..over":s string.eq or
         ..dup "..over.":s string.startsWith  _if =:: mut: opName
      opName "..over." ..length string.tail =:: params
      "..over":s opName=
      fileState program wordPos =:: opPos
      params opName opPos state getCompilerOpParam ## :offset
      StackModType .COPY opPos opStackMod state appendOp
      return
    else ..dup "$":s string.eq or ..dup "$0":s string.eq _if =:: opName
      0 StackModType .COPY fileState program wordPos opStackMod state appendOp
      return
    else $ 0 string.charAt '$' == and $ .length 1:iSize u>= and
        $ 1 string.charAt '0' >= and $ 1 string.charAt '9' <= _if =:: mut: opName
      opName 1 string.tail =:: params
      "$":s opName=
      fileState program wordPos =:: opPos
      params opName opPos state getCompilerOpParam ## :offset
      StackModType .COPY opPos opStackMod state appendOp
      return
    else $ "..swap":s string.eq _if =:: opName
      1 StackModType .ROTATE fileState program wordPos opStackMod state appendOp
      return
    else $ $ .length 1:iSize - string.charAt '$' == and $ 0 string.charAt =:: c0 c0 '>' == or c0 '<' == _if =:: opName
      opName 0 string.charAt =:: c0
      1 =:: mut: rotCount
      1 =:: mut: i
      while opName i string.charAt c0 == do
        rotCount 1 + rotCount=
      finally i 1 + i= end
      opName i string.charAt '$' != if ## TODO? allow >N$ and <N$ (? stack rotation by more than 3 elements should be painful)
        64 sb.create
          "invalid stack-rotation, expected N occurences of eigher '>' or '<' followed by '$' got '" sb.appendS
            opName sb.appendStr
            "'" sb.appendS
          fileState program wordPos errors appendError
        return
      end
      rotCount
        c0 '<' == if -_ end
      StackModType .ROTATE fileState program wordPos opStackMod state appendOp
      return
    else ..dup "..drop":s string.eq or
         ..dup "..drop.":s string.startsWith _if =:: mut: opName
      opName "..drop." ..length string.tail =:: params
      "..drop":s opName=
      fileState program wordPos =:: opPos
      params opName opPos state getCompilerOpParam ## :count
      StackModType .DROP opPos opStackMod state appendOp
      return
    else $ "import":s string.eq _if =:: opName
      fileState nextToken ## XXX? distinquish string types
      fileState program wordPos =:: importPos
      .String .if ## local file
        false importPos state prepareImport
        return
      else .Identifier ._if ## library file
        true importPos state prepareImport return
      end
      64 sb.create
        "invalid parameter for " sb.appendS
        opName sb.appendStr
        ':' sb.appendC
        >$ sb.appendToken
        " expected identifier or string" sb.appendS
      importPos errors appendError
      return
    else $ "using":s string.eq or $ "using:":s string.eq _if =:: opName
      opName "using:":s string.eq =:: isAlias
      isAlias if
        fileState program nextIdentifier
      else string.empty end =:: aliasName
      fileState program nextIdentifier
        $ ".":s string.endsWith =:: importNamespace
        importNamespace if
          $ .length 1:iSize - string.head
        end
      =:: usedName
      fileState program wordPos =:: usePos
      importNamespace if
        usedName id.FLAG_NONE
          usePos
        nameContext id.newIdentifier =:: namespaceName
        aliasName .length 0:iSize != if
          aliasName id.FLAG_NONE
            usePos
          nameContext id.newIdentifier
        else id.NAME_ID_NONE end =:: aliasNameId
        namespaceName aliasNameId usePos opUsingNamespace state appendOp
        return
      end
      usedName id.FLAG_NONE
        usePos
      nameContext id.newIdentifier =:: usedIdentifier
      aliasName .length 0:iSize != if
        aliasName id.FLAG_NONE
          usePos
        nameContext id.newIdentifier
      else id.NAME_ID_NONE end =:: aliasNameId
      usedIdentifier aliasNameId usePos opUsingIdentifier state appendOp
      return
    else $ "assert":s string.eq _if =:: opName
      ## opAssert
        fileState program wordPos
      opAssert state appendOp
      return
    else $ "..compiler.error":s string.eq
        or $ "..compiler.warning":s string.eq
        or $ "..compiler.info":s string.eq _if =:: opName
      fileState program wordPos =:: opPos
      ## create error/warning/info if operation is reachable
      opName "..compiler.error":s string.eq if
        ErrorType .ERROR
      else opName "..compiler.warning":s string.eq _if
        ErrorType .WARNING
      else opName "..compiler.info":s string.eq _if
        ErrorType .INFO
      else
        "unexpected error type: " sb.copyPtr
          opName sb.appendStr
        opPos errors appendError
        ErrorType .ERROR
      end =:: errorType
      ## opError
        errorType
        opPos
      opError state appendOp
      return
    else $ "..compiler.flag.":s string.startsWith _if
      "..compiler.flag." ..length string.tail =:: flagName
      ## XXX? treat compiler constants as variables, allow :? operator to check if constant exists
      flagName "experimental":s string.eq if
        _EXPERIMENTAL_ ConstValue .Bool
        types.primitive.BOOL
      else flagName "noCore":s string.eq _if
        _INCLUDE_CORE_ ! ConstValue .Bool
        types.primitive.BOOL
      else flagName "wError":s string.eq _if
        _W_ERROR_ ConstValue .Bool
        types.primitive.BOOL
      else flagName "incrementVersionNumber":s string.eq _if
        _INCREMENT_VERSION_ ConstValue .Bool
        types.primitive.BOOL
      else
        ConstValue .None
        Type .Empty
      end
      fileState program wordPos opConst state appendOp
      return
    else $ "..compiler.version":s string.eq _if ..drop
      _VERSION_ ConstValue .Int
      types.primitive.I64
      fileState program wordPos opConst state appendOp
      return
    else $ "..compiler.return":s string.eq _if ..drop
      ..drop ## discard remainder of file
      BlockType ..length 33:iSize == "no new block types" assert
      ## close open if-blocks/switch-branches
      while state [] .openBlocks list.peek .and [] .blockData switch
            If Switch case true break
            default false break
          end do
        state [] .openBlocks
          list.pop ..drop
        state .openBlocks=
      end
      string.empty return
    else $ "..file":s string.eq _if ..drop
      fileState [] .wordStart .fileName =:: name
      name constContext newStringConst
      types.CHAR8
        types.ArrayType .POINTER
        name .length i64 cast.u types.ArraySize .Int =:: size
        size
      typeContext types.newArrayType .else
        "failed to create array-type" ..panic
      end
      fileState program wordPos opConst state appendOp
      return
    else $ "..line":s string.eq _if ..drop
      fileState [] .wordStart .line i64 cast.u ConstValue .Int
      types.primitive.I64 ## TODO? change to iSize
      fileState program wordPos opConst state appendOp
      return
    else $ "..?types":s string.eq or $ "..?types.":s string.startsWith _if =:: mut: opName
      opName "..?types." ..length string.tail =:: params
      "..?types":s opName=
      -1 =:: mut: count
      0 =:: mut: depth
      fileState program wordPos =:: opPos
      params .length 0:iSize != if
        params '.' string.split =:: head =:: tail
        head .length 0:iSize != if
          head
            opName
            opPos
          state getCompilerOpParam count=
        end
        tail .length 0:iSize != if
          tail
            opName
            opPos
          state getCompilerOpParam depth=
        end
      end
      ## opTypesInfo
        count
        depth
        opPos
      opTypesInfo state appendOp
      return
    else $ "..?stack":s string.eq or $ "..?stack.":s string.startsWith _if =:: mut: opName
      opName "..?stack." ..length string.tail =:: params
      "..?stack":s opName=
      fileState program wordPos =:: opPos
      params .length 0:iSize != if
        params opName opPos state getCompilerOpParam
      else -1 end
      opPos opStackInfo state appendOp
      return
    else $ "..?ops":s string.eq or $ "..?ops.":s string.startsWith _if =:: mut: opName
      opName "..?ops." ..length string.tail =:: params
      "..?ops":s opName=
      fileState program wordPos =:: opPos
      params .length 0:iSize != if
        params opName opPos state getCompilerOpParam
      else -1 end
      opPos opPrintCompiledOps state appendOp
      return
    else $ "..?find.":s string.startsWith _if =:: mut: opName
      opName "..?find." ..length string.tail =:: idName
      fileState program wordPos =:: opPos
      ## opPrintIdentifierMatches
        idName
          id.FLAG_NONE
          opPos
        nameContext id.newIdentifier
        opPos
      opPrintIdentifierMatches state appendOp
      return
    else $ "..?type.layout":s string.eq or $ "..?type.layout.":s string.startsWith _if =:: mut: opName
      opName "..?type.layout." ..length string.tail =:: params
      "..?type.layout":s opName=
      fileState program wordPos =:: opPos
      params .length 0:iSize != if
        params opName opPos state getCompilerOpParam
      else 1 end
      opPos opTypeLayout state appendOp
      return
    else $ "begin":s string.eq or $ "defer":s string.eq or $ "@":s string.eq _if =:: opName
      "`" sb.copyPtr
        opName sb.appendStr
        "` is a reserved keyword for a future language version" sb.appendS
      fileState program wordPos errors appendError
      return
    end
    $ "@":s string.endsWith =:: isAddr
    $ .length 1:iSize u> and $ "=":s string.endsWith and ## exclude = and ids ending with: == != >= <=
      "=<>!":s $1 $ .length 2:iSize - string.charAt string.contains !
    end =:: isSetter
    isAddr or isSetter if
      $ .length 1:iSize - string.head
    end
    $ "..":s string.startsWith if string.empty else
      "..":s string.splitStr >$
    end =:: tail
  =:: idName
  fileState program wordPos =:: opPos
  idName nameContext id.copyString =:: name
  name
    opPos
    isAddr if
      opAtName
    else isSetter and tail .length 0 == _if
      opSetName
    else
      opGetName
    end
  state appendOp
  tail .length 0 != if
    tail isSetter opPos state parseElementAccess
    isSetter if
      name opPos opSetName state appendOp
    end
  end
  return
end
proc( FileId : includedId file.Error : err FilePosition ptr : pos ParserState ptr.mut : state -> FileId ) =>: checkIOError
  err file.Error.NONE == if
    includedId return ## exit early on normal path
  end
  state [] .program =:: program
  program .errors =:: errors
  program [] .progFiles includedId i64 cast @[] .fileName [] sb.asStr =:: fileName
  err switch
    file.Error.NONE case ..unreachable ## already handled this case
    file.Error.PATH_OVERFLOW file.Error.OPEN_MODE file.Error.FILE_NOT_FOUND file.Error.FILE_IS_DIR file.Error.ACCESS_DENIED file.Error.INVALID_FILE case
      "cannot include file \"" sb.copyPtr fileName sb.appendStr '"' sb.appendC pos errors appendError
      FILE_ID_NONE return
    default
      "error while reading file \"" sb.copyPtr fileName sb.appendStr '"' sb.appendC pos errors appendError
      FILE_ID_NONE return
  end
end

proc(
  string : fileName
  FilePosition ptr : pos
  ParserState ptr.mut : state
-> ) =>: importLibraryFile
  state [] .program [] .libPath .length fileName .length + ".concat" ..length + sb.create
    state [] .program [] .libPath sb.appendStr
    fileName sb.appendStr
    ".concat" sb.appendS
  true pos state importFile
end
proc(
  string : fileName
  bool : isLibImport
  FilePosition ptr : pos
  ParserState ptr.mut : state
-> ) =>: prepareImport
  state [] .program .idContext .typeContext .nameContext =:: nameContext
  fileName nameContext id.copyString isLibImport pos opImportFile state appendOp
end
proc(
  string : fileName
  bool : isLibImport
  FileId : hostFile
  FilePosition ptr : pos
  ProgramContext ptr.mut : program
  TypeCheckState ptr.mut : typeChecker
-> ) =>: export: parseImportFile
  ## ParserState
    program
    typeChecker
    64  BlockInfo               list.create
    Operation list.empty
    0:i32
    hostFile
    32  ProcId                  list.create
  ParserState new =:: mut: parserState
    isLibImport if
      fileName pos parserState@ importLibraryFile
    else
      program [] .basePath .length fileName .length + sb.create
        program [] .basePath sb.appendStr
        fileName sb.appendStr
      program [] .inLibFile pos parserState@ importFile
    end
  parserState cleanupParserState
end
proc(
  stringBuilder : fileName
  bool : isLibImport
  FilePosition ptr : pos
  ParserState ptr.mut : state
-> ) =>: importFile
  state [] .program =:: program
  FILE_ID_NONE =:: mut: imported
  0:iSize while $ program [] .progFiles .length u< do
    program [] .progFiles $1 [] .fileName sb.asStr fileName sb.asStr string.eq if
      $ FileId cast imported=
      break
    end
    1:iSize +
  end ..drop
  imported FILE_ID_NONE == if ## file has not yet been imported
    fileName isLibImport state parseFile pos state checkIOError imported=
    imported FILE_ID_NONE == if
      return
    end
  end
  ## TODO correctly resolve sub-imports for cyclic imports
  imported
    program [] .progFiles imported i64 cast @[] .fileScope []
  program .idContext id.importFile
end

import "typeCheck.concat"
proc(
  stringBuilder : rootFile
  string : libPath
  string : basePath
  bool : saveGlobalTokens
-> ProgramContext TypeCheckState ) =>: export: parseProgram
  basePath libPath saveGlobalTokens newProgramContext =:: mut: programContext
  ## initBuiltInConstants
    FILE_POS_BUILTIN@
    programContext@
  initBuiltInConstants
  ## initBuiltInProcs
    FILE_POS_BUILTIN@
    programContext@
  initBuiltInProcs if
    ## TODO handle error
  end
  programContext@ newTypeCheckState =:: mut: typeChecker
  programContext@ typeChecker@ updateTypeCheckerPointers
  ## ParserState
    programContext@
    typeChecker@
    64  BlockInfo               list.create
    Operation list.empty
    0:i32
    FILE_ID_NONE
    32  ProcId                  list.create
  ParserState new =:: mut: state
  rootFile false state@ parseFile FILE_POS_UNKNOWN@ state@ checkIOError ..drop
  state cleanupParserState
  programContext typeChecker return
end

proc(
  stringBuilder : fileName
  bool : isLibFile
  ParserState ptr.mut : state
-> FileId file.Error ) =>: parseFile
  fileName
    state [] .program =:: program
    state [] .parsedOps =:: oldOps
    Operation list.empty state .parsedOps=
    program .idContext =:: idContext
    idContext .typeContext .nameContext =:: nameContext
    program .errors =:: errors
    ..dup ..over .length 1:iSize - sb.charAt '\x00' != if
      '\x00' sb.appendC ## ensure file-name is zero terminated
    end
    $ .length 1:iSize - sb.setLength ## do not include zero terminator in length
    program [] .progFiles .length FileId cast =:: fileId
    $ sb.asStr fileId 0 1 FilePosition new ..dup FileState new =:: mut: fileState
    program [] .progFiles
      ..over fileId newProgFile list.append
    program .progFiles=
  state [] .currentFile =:: prevFile
  program [] .inLibFile =:: wasLibFile
  isLibFile program .inLibFile=
  fileId state .currentFile=
    $ .length 1:iSize + sb.setLength ## include zero terminate for open
  sb.asStr file.OpenMode .READ file.open
    ## TODO the newline at the file-start and end feely a bit hacky...
    1024 sb.create
      '\n' sb.appendC
      file.readTo
      '\n' sb.appendC
    =:: fileBody
    $ .error =:: readError
  file.close
  readError file.Error.NONE != if
    prevFile state .currentFile= ## reset file id
    wasLibFile program .inLibFile=
    fileId readError return
  end
  state [] .openBlocks .length =:: blockCount
  nameContext id.currentNamespace =:: prevNamespace
  nameContext id.clearNamespace
  idContext id.currentScope =:: prevScope
  idContext id.clearScope
  _INCLUDE_CORE_ if
    false _INCLUDE_CORE_= ## don't include core in core
    "core":s fileState@ program wordPos state importLibraryFile
    true _INCLUDE_CORE_=
  end
  idContext id.openScope
  fileId id.NO_SCOPE idContext id.importFile ## import file in its own scope
  idContext id.currentScope program [] .progFiles fileId i64 cast @[] .fileScope=
  ## TODO? find good heuristic for token count based on character to reduce number of buffer reallocations
  state [] .parsedOps
    fileBody .length 8 / list.ensureCap
  state .parsedOps=
  fileState@
    fileBody sb.asStr while
      $1 nextToken $2 state parseOperation
      $ .length 0:iSize !=
    do end ..drop
  ..drop
  fileBody sb.free ..drop
  fileState .currentPos fileState@ .wordStart=
  state [] .openBlocks .length blockCount u> if
    ## XXX? print start of last block
    "unclosed block at end of file ( opened at " sb.copyPtr
      state [] .openBlocks blockCount @[] .openedAt [] [] sb.appendPos
      " )" sb.appendS
      fileState@ program wordPos
    errors appendError
  else state [] .openBlocks .length blockCount u< _if
    "file closed additional code block" sb.copyPtr
      fileState@ program wordPos
    errors appendError
  else
    state [] .parsedOps list.asSlice state [] .typeChecker typeCheckGlobalCode
  end
  idContext id.closeScope ! "file scope closed correctly" assert
  prevScope idContext id.setScope
  prevNamespace nameContext id.resetNamespace
  state [] .currentFile =:: newFileId
  fileId newFileId == "fileId did not change" assert
  prevFile state .currentFile=
  wasLibFile program .inLibFile=
  state [] .parsedOps list.free ..drop
  oldOps state .parsedOps=
  newFileId file.Error.NONE return
end
