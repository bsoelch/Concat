struct( Type : valueType ConstValue : val IdentifierInfo optional : idInfo FilePosition : pos ) =:: Constant
struct( i64 : codeOffset i64 : constOffset ) =:: CompositeConstantOffset
struct( InterpreterContext : mut: context i64 : mut: offset ) =:: InterpreterInfo

struct(
  BlockType : mut: blockType
  i64  : mut: blockStart
  bool : mut: autoClose
  bool : hasScope
) =:: BlockInfo

struct(
  string : mut: basePath
  string : mut: libPath
  ProgramContext ptr mut : progContext
  BlockInfo list : mut: openBlocks
  i64 list : mut: andOrPositions
  Operation list : mut: globalOpBuffer
  Constant list : mut: constants
  i64 : mut: constOffset
  Type list : mut: typeBuffer
  FileId : mut: currentFile
  ProcId optional : mut: currentProc
  CompositeConstantOffset list : mut: constantBlocks
  InterpreterInfo list : mut: globalInterpreters
  LabelId list : mut: labelBuffer
) =:: ParserState

proc( FilePosition : pos -> Constant ) =>: newWildcardConst
  Type .undefined ConstValue .wildCard IdentifierInfo optional.empty pos Constant new return
end
proc( bool FilePosition -> Constant ) =>: newBoolConstant
  =:: pos
  types.primitive.BOOL ..swap ConstValue .boolean IdentifierInfo optional.empty pos Constant new return
end
proc(
  i64 : value
  bool : unsigned
  i32 : preferedSize
-> bool ) =>: checkIntSize
  preferedSize 0 <= if
    false return
  end
  preferedSize types.MAX_INT_WIDTH >= if
    false return
  end
  unsigned if
    value 0 < if
      true return
    end
    preferedSize types.MAX_INT_WIDTH 1 - == if
      false return ## positive number fits in unsigned number of one smaller size
    end
  else
    value 1:i64 preferedSize << -_ < if
      true return
    end
  end
  value 1:i64 unsigned if preferedSize else preferedSize 1 - end << >= return
end

enum( FIXED AUTO AUTO_UNSIGNED ) =:: IntLiteralType
proc(
  i64 : value
  IntLiteralType : literalType
  Type : intType
  FilePosition : pos
  ParserState ptr mut : state
-> Constant ) =>: newIntConstant
  state .progContext [] .idContext .typeContext@ =:: typeContext
  literalType switch
    FIXED case
      intType typeContext types.isUnsignedInt =:: isUnsigned
      ## TODO? better way to get bit-size of integer
      intType typeContext types.sizeOf .fixed i32 cast 8 * =:: bitCount
      value isUnsigned bitCount checkIntSize if
        "integer literal overflows maximum size for type " sb.wrap
          intType typeContext sb.appendType
          intType types.isPrimitive ! if
            isUnsigned if " ( u" sb.appendS else " ( i" sb.appendS end
            bitCount sb.appendU
            ')' sb.appendC
          end
          ": " sb.appendS
          value isUnsigned if sb.appendU else sb.appendI end
        pos state appendWarning2
      end
      intType break
    AUTO case
      value f64.MIN_INT <  if types.intLiteral.S64 break end
      value i32.MIN i64 cast.s <  if types.intLiteral.S54_ break end
      value f32.MIN_INT i64 cast.s < if types.intLiteral.S32 break end
      value i16.MIN i64 cast.s <  if types.intLiteral.S25_ break end
      value  i8.MIN i64 cast.s <  if types.intLiteral.S16 break end
      value       0 <  if types.intLiteral.S8  break end
      value  i8.MAX i64 cast.u <= if types.intLiteral.U7  break end
      value i16.MAX i64 cast.u <= if types.intLiteral.U15 break end
      value f32.MAX_INT i64 cast.u <= if types.intLiteral.U24_ break end
      value i32.MAX i64 cast.u <= if types.intLiteral.U31 break end
      value f64.MAX_INT <= if types.intLiteral.U53_ break end
      types.intLiteral.U63
      break
    AUTO_UNSIGNED case
      value i8.MAX   i64 cast.u ..u<= if types.intLiteral.U7  break end
      value i8.UMAX  i64 cast.u ..u<= if types.intLiteral.U8  break end
      value i16.MAX  i64 cast.u ..u<= if types.intLiteral.U15 break end
      value i16.UMAX i64 cast.u ..u<= if types.intLiteral.U16 break end
      value f32.MAX_INT i64 cast.u ..u<= if types.intLiteral.U24_ break end
      value i32.MAX  i64 cast.u ..u<= if types.intLiteral.U31 break end
      value i32.UMAX ..u<= if types.intLiteral.U32 break end
      value f64.MAX_INT ..u<= if types.intLiteral.U53_ break end
      value i64.MAX  ..u<= if types.intLiteral.U63 break end
      types.intLiteral.U64
      break
  end =:: constType
  constType value ConstValue .int IdentifierInfo optional.empty pos Constant new return
end
proc( i8 FilePosition -> Constant ) =>: newCharConstant
  =:: pos
  types.primitive.I8 ..swap ConstValue .chr IdentifierInfo optional.empty pos Constant new return
end
proc( StringConstant : str FilePosition : pos TypeContext ptr mut : context -> Constant ) =>: newStringConstant
  using types
  str .length ArraySizeType .int ArraySize new =:: size
  types.primitive.I8 true size @ 1 array.create true false context newArrayType ..drop str ConstValue .str IdentifierInfo optional.empty pos Constant new return
end
proc( Type FilePosition -> Constant ) =>: newTypeConst
  =:: pos
  types.primitive.TYPE ..swap ConstValue .typeId IdentifierInfo optional.empty pos Constant new return
end

proc( f64 : value Type : constType FilePosition : pos -> Constant ) =>: newFloatConst
  ## Constant
    constType
    value ConstValue .Float
    IdentifierInfo optional.empty
    pos
  Constant new return
end

proc( Constant : const -> Operation ) =>: constantToOp
  const .val const .valueType const .pos opConst return
end

proc( ParserState ptr mut : state -> i64 ) =>: opCount
  state [] .progContext =:: progContext
  state [] .currentProc optional.isEmpty if
    state [] .globalOpBuffer .length return
  else
    progContext [] .tmpOps .length return
  end
end
proc( ParserState ptr mut : state -> Operation list ptr mut ) =>: currentOps
  state [] .progContext =:: progContext
  state [] .currentProc optional.isEmpty if
    state [] .globalOpBuffer @ return
  else
    progContext [] .tmpOps @ return
  end
end
proc( Operation : op ParserState ptr mut : state -> ) =>: appendOp
  state [] .progContext =:: progContext
  state currentOps =:: ops
  ops []
    0 while ..dup state [] .constants .length < do =:: i
      state [] .constants i list.get constantToOp list.append
      i 1 +
    end ..drop
    state [] .constants list.clear state [] .constants =
    op list.append
  ops [] =
end
proc( stringBuilder : msg FilePosition : pos ParserState ptr mut : state -> ) =>: appendError2
  msg pos state [] .progContext [] .errors @ appendError
end
proc( stringBuilder : msg FilePosition : pos ParserState ptr mut : state -> ) =>: appendWarning2
  msg pos state [] .progContext [] .errors @ appendWarning
end

proc( ParserState ptr mut : state -> ) =>: skipGlobalInterpreter
  state [] .progContext [] .progFiles state [] .currentFile i64 cast list.at .data [] .globalOps @ =:: ops
  state [] .currentProc optional.hasData if
    return ## don't skip if inside procedure
  end
  state [] .constantBlocks .length 0 > if
    return ## don't skip if inside constant block
  end
  ops []
    state [] .globalOpBuffer list.appendAll
  ops [] =
  state [] .globalOpBuffer
    list.clear
  state [] .globalOpBuffer =
end
proc( Operation ptr optional : next? ParserState ptr mut : state -> ) =>: resetGlobalInterpreter
  state [] .progContext =:: progContext
  state [] .globalInterpreters state [] .currentFile i64 cast list.at .data =:: interpreter
  progContext [] .progFiles state [] .currentFile i64 cast list.at .data [] .globalOps @ =:: ops
  ##  -> store computed constants
  0 while ..dup interpreter [] .context .stack .length < do
    interpreter [] .context .stack ..over list.at .data =:: constant
    interpreter [] .context .stackInfo ..over list.at .data =:: constInfo
    ops []
      constant [] constInfo [] .valueType constInfo [] .pushedAt opConst list.append
    ops [] =
    1 +
  end ..drop
  ## -> store current operation
  next? optional.hasData if
    ops []
      next? .data list.appendP
    ops [] =
  end
  ##  -> reset interpreter
  interpreter [] .context @ InterpreterType .PARSER interpreter.resetContext
end
proc( ParserState ptr mut : state -> ) =>: tryInterpretGlobal
  ## TODO only interpret code after start of current block
  ##   preserve positions of unclosed code-blocks
  state [] .progContext =:: progContext
  state [] .currentProc optional.hasData if
    return ## don't interpret inside procedure
  end
  state [] .constantBlocks .length 0 > if
    return ## don't interpret inside constant blocks
  end
  state [] .globalInterpreters state [] .currentFile i64 cast list.at .data =:: interpreter
  interpreter [] .offset =:: offset
  offset while ..dup state [] .globalOpBuffer .length < do
    state [] .globalOpBuffer ..over list.at .data =:: op
    op interpreter [] .context @ evaluateOperation if
      ## interpreter failed
      op Operation ptr cast optional.wrap state resetGlobalInterpreter
    end
    1 +
  end ..drop
  state [] .globalOpBuffer
    list.clear
  state [] .globalOpBuffer =
end
proc( ParserState ptr mut : state -> Operation ptr mut optional ) =>: peekOp
  state [] .progContext =:: progContext
  state [] .currentProc optional.isEmpty if
    state [] .globalOpBuffer
  else
    progContext [] .tmpOps
  end list.peek
end

proc( Constant : const ParserState ptr mut : state -> ) =>: pushConst
  ## inline when code is no longer experimental
  const constantToOp state appendOp
  return
end

proc( ParserState ptr mut : state -> bool ) =>: hasConst
  state [] .constants .length 0 > return
end
proc( ParserState ptr mut : state -> Constant ) =>: popConst
  state [] .constants
    list.pop ..swap state [] .constants =
  return
end
proc( ParserState ptr mut : state -> Constant ptr mut optional ) =>: peekConst
  state [] .constants list.peek return
end
proc( ParserState ptr mut : state -> ConstValue ValueInfo ) =>: popConst2
  state [] .globalInterpreters state [] .currentFile i64 cast list.at .data [] .context @ =:: interpreter
  interpreter [] .stack
    list.pop =:: value
  interpreter [] .stack =
  interpreter [] .stackInfo
    list.pop =:: info
  interpreter [] .stackInfo =
  value info return
end
proc( ParserState ptr mut : state -> bool ) =>: hasConst2
  state [] .currentProc optional.hasData if
    false return ## constants only exists at global level
  end
  state [] .globalInterpreters state [] .currentFile i64 cast list.at .data [] .context @ =:: interpreter
  interpreter [] .stack .length 0 > return
end
proc( ParserState ptr mut : state -> ConstValue ptr mut optional ValueInfo ptr mut optional ) =>: peekConst2
  state [] .globalInterpreters state [] .currentFile i64 cast list.at .data [] .context @ =:: interpreter
  interpreter [] .stack list.peek interpreter [] .stackInfo list.peek return
end

proc( FileState ptr mut : fileState ParserState ptr mut : state -> Type bool ) =>: peekTypeConstant
  state peekConst2 =:: info? =:: value?
  value? optional.isEmpty if
    "missing type constant" sb.wrap fileState [] .wordStart state appendError2
    Type .undefined true return
  end
  value? .data [] .typeId ?? ! if
    "wrong type for constant expected type" sb.wrap info? .data [] .pushedAt state appendError2
    Type .undefined true return
  end
  value? .data [] .typeId false return
end
proc( FileState ptr mut : fileState ParserState ptr mut : state -> Type bool ) =>: popTypeConstant
  state peekConst2 =:: info? =:: value?
  value? optional.isEmpty if
    "missing type constant" sb.wrap fileState [] .wordStart state appendError2
    Type .undefined true return
  end
  value? .data [] .typeId ?? ! if
    "wrong type for constant expected type" sb.wrap info? .data [] .pushedAt state appendError2
    Type .undefined true return
  end
  state popConst2 ..drop .typeId false return
end
proc( FileState ptr mut : fileState ParserState ptr mut : state -> types.ArraySize arrayView bool #+fixed-size+# ) =>: popArraySize
  state [] .progContext [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext .labelContext @ =:: labelContext
  idContext [] .typeContext @ =:: typeContext
  state [] .constants .length state [] .constOffset <= if
    types.ArraySize array.empty true return
  end
  state [] .constants list.peek .data [] .val .wildCard ?? if
    state [] .constants list.pop ..drop state [] .constants = ## remove wildcard constant
    types.ArraySize array.empty false return
  end
  state [] .constants .length 1 - while ..dup state [] .constOffset >= do
    state [] .constants ..over list.get .valueType typeContext types.isInt ! if
      break
    end
    1 -
  end 1 + =:: sizesOffset ##revert last decrement
  idContext [] .arraySizeBuffer
    list.clear
    sizesOffset state [] .constOffset - list.ensureCap
    sizesOffset while ..dup state [] .constants .length < do
      ..swap
        state [] .constants ..over.2 list.at .data =:: constant
        constant []  .val =:: constVal
          constVal .int ?? if
            constVal .int types.ArraySizeType .int types.ArraySize new list.append
          else constVal .genericArg ?? _if
            constVal .genericArg i64 cast types.ArraySizeType .staticArg types.ArraySize new list.append
          else
            "unexpected constant for array size: " sb.wrap
              constVal constContext typeContext sb.appendConstant
            constant [] .pos state appendError2
          end
      ..swap
      1 +
    end ..drop
  idContext [] .arraySizeBuffer =
  state [] .constants
    sizesOffset list.setLength
  state [] .constants =
  idContext [] .arraySizeBuffer list.asArray true return
end
proc( i64 : n FileState ptr mut : fileState ParserState ptr mut : state -> Type arrayView bool ) =>: popTypeConstants
  state [] .constants .length state [] .constOffset n + < if
    "missing type constant" sb.wrap fileState [] .wordStart state appendError2
     Type array.empty true return
  end
  state [] .typeBuffer list.clear state [] .typeBuffer =
  state [] .constants .length n - =:: newLength
  newLength while ..dup state [] .constants .length < do
    state [] .constants ..over list.at .data =:: constant
    constant [] .val =:: constVal
    constVal .typeId ?? ! if ..drop
      "wrong type for constant, expected type" sb.wrap state [] .constants list.peek .data [] .pos state appendError2
       Type array.empty true return
    end
    state [] .typeBuffer constVal .typeId list.append state [] .typeBuffer =
    1 +
  end ..drop
  state [] .constants
    newLength list.setLength
  state [] .constants =
  state [] .typeBuffer list.asArray false return
end
proc( i64 : len FileState ptr mut : fileState ParserState ptr mut : state -> Type arrayView ConstValue arrayView Type ) =>: popConstantArray
  state [] .progContext [] .idContext @ =:: idContext
  state [] .constants .length state [] .constOffset len + < if ## XXX compare size with expected size
    "no enough constants for array" sb.wrap fileState [] .wordStart state appendError2
     Type array.empty ConstValue array.empty Type .undefined return
  end
  Type .undefined =:: mut: arrayType
  true =:: mut: hasArrayType
  state [] .typeBuffer list.clear state [] .typeBuffer =
  idContext [] .argBuffer .length =:: offset
  state [] .constants .length len - =:: newLength
  newLength while ..dup state [] .constants .length < do
    state [] .constants ..over list.at .data =:: const
    idContext [] .argBuffer
      const [] .val list.append
    idContext [] .argBuffer =
    state [] .typeBuffer const [] .valueType list.append state [] .typeBuffer =
    hasArrayType if
      arrayType Type .undefined types.typeEquals if
       const [] .valueType arrayType =
      else arrayType const [] .valueType types.typeEquals ! _if
        false hasArrayType =
      end
    end
    1 +
  end ..drop
  state [] .constants
    newLength list.setLength
  state [] .constants =
  idContext [] .argBuffer
    offset list.setLength
  idContext [] .argBuffer =
  ## return
    state [] .typeBuffer list.asArray
    idContext [] .argBuffer .data offset + len array.create
    hasArrayType if arrayType else Type .undefined end
  return
end

proc( ParserState ptr mut : state -> i64 ) =>: offsetConstants
  state [] .constOffset
    state [] .constants .length state [] .constOffset =
  return
end
proc( i64 ParserState ptr mut -> ) =>: resetConstants
  [] .constOffset =
end

proc( BlockType : blockType ParserState ptr mut : state -> ) =>: openBlock
  state [] .openBlocks
    blockType -1 false false BlockInfo new list.append
  state [] .openBlocks =
end
proc( BlockType : blockType ParserState ptr mut : state -> ) =>: openBlockScope
  state [] .progContext [] .idContext @ id.openScope
  state [] .openBlocks
    blockType -1 false true BlockInfo new list.append
  state [] .openBlocks =
end
proc( Type : valType bool : experimental ParserState ptr mut : state -> ) =>: openProcBlock
  ## openProcScope
    valType
    experimental
  state [] .progContext [] .idContext @ id.openProcScope
  state [] .openBlocks
    ## BlockInfo
      experimental if
        BlockType .EXPERIMENTAL_PROCEDURE
      else
        BlockType .PROCEDURE
      end
      -1
      false
      true
    BlockInfo new list.append
  state [] .openBlocks =
end
proc( ParserState ptr mut : state -> ) =>: autoCloseCurrentBlock
  true state [] .openBlocks list.peek .data [] .autoClose =
end
proc(
  ParserState ptr mut : state
->
  BlockType #+type+#
) =>: currentBlockType
  state [] .openBlocks .length 0 == if
    BlockType .UNKNOWN return
  end
  state [] .openBlocks list.peek .data [] .blockType return
end
proc(
  ParserState ptr mut : state
->
  BlockInfo
  bool #+isError+#
) =>: closeBlock
  state [] .openBlocks .length 0 == if
    BlockType .UNKNOWN -1 false false BlockInfo new true return
  end
  state [] .openBlocks
    list.pop =:: closed
  state [] .openBlocks =
  closed .hasScope if
    closed
      state [] .progContext [] .idContext @ id.closeScope
    return
  end
  closed false return
end

proc( BlockType : mergeWith FilePosition : pos ParserState ptr mut : state -> ) =>: convertAndOrBlock
  state [] .progContext =:: progContext
  state [] .andOrPositions =:: andOrPositions
  0 while ..dup andOrPositions .length < do =:: i
    andOrPositions i list.get =:: opPos
    opPos 0 <  opPos state currentOps [] .length >= | if
      "operations and blocks are out of sync, could not determine position of and/or" sb.wrap
      pos state appendError2
      return
    end
    state currentOps [] opPos list.at .data =:: opData
    opData [] .val .block ?? ! if
      "operations and blocks are out of sync, expected and/or got " sb.wrap
        opData [] progContext sb.appendOp
      pos state appendError2
      return
    end
    ## opBlock
      opData [] .val .block .blockType switch
        AND case mergeWith .DO ?? if BlockType .AND_DO else BlockType .AND_IF end break
        OR case mergeWith .DO ?? if BlockType .OR_DO else BlockType .OR_IF end break
        default
          "operations and blocks are out of sync, expected and/or got " sb.wrap
            opData [] .val .block .blockType sb.appendBlockType
          pos state appendError2
        return
      end
      opData [] .pos
    opBlock opData [] =
    i 1 +
  end ..drop
  andOrPositions list.clear state [] .andOrPositions =
end

proc( string : code FileState ptr mut : fileState  ParserState ptr mut : state -> string string ) =>: nextWord
  code
    fileState nextToken
    ..dup .IDENTIFIER ?? ! if ..drop
      "expected identifier" sb.wrap fileState [] .wordStart state appendError2
      string.empty return
    end
    .IDENTIFIER
  return
end
proc(
  string : code
  string : start
  FileState ptr mut : fileState
  ParserState ptr mut : state
  LabelFlag : initFlags
-> string LabelId ) =>: readLabelAddFlags
  0:LabelFlag =:: mut: flags
  false =:: mut: isModifier
  code start
    while
      false isModifier =
      ..dup "mut:" string.wrap string.eq if
        id.FLAG_MUTABLE flags | flags =
        true isModifier =
      else ..dup "auto:" string.wrap string.eq _if
        id.FLAG_AUTO flags | flags =
        true isModifier =
      else ..dup "static:" string.wrap string.eq _if
        id.FLAG_STATIC flags | flags =
        true isModifier =
      else ..dup "extern:" string.wrap string.eq _if
        id.FLAG_EXTERN flags | flags =
        true isModifier =
      else ..dup "export:" string.wrap string.eq _if
        id.FLAG_EXPORT flags | flags =
        true isModifier =
      else ..dup "inline:" string.wrap string.eq _if
        id.FLAG_INLINE flags | flags =
        true isModifier =
      else ..dup "no:inline:" string.wrap string.eq _if
        id.FLAG_NO_INLINE flags | flags =
        true isModifier =
      else ..dup "#:experimental:" string.wrap string.eq _if
        id.FLAG_EXPERIMENTAL flags | flags =
        true isModifier =
      else ..dup ":" string.wrap string.endsWith _if
        true isModifier =
      end
      isModifier ! if
        break
      end
    isModifier do ..drop
      fileState nextToken
      ..dup .IDENTIFIER ?? ! if ..drop
        "expected identifier" sb.wrap state [] .constants list.peek .data [] .pos state appendError2
        "" string.wrap
      else
        .IDENTIFIER
      end
    end
  flags initFlags | fileState [] .wordStart state [] .currentFile state [] .progContext [] .idContext .typeContext .labelContext @ id.newLabel return
end
proc( string : code string : start FileState ptr mut : fileState  ParserState ptr mut : state -> string LabelId ) =>: readLabel
  code start fileState state 0:LabelFlag readLabelAddFlags
end
enum( NONE TUPLE STRUCT ENUM PROC_IN ) =:: LabelType
proc( string : code LabelType : labelType string : endString FileState ptr mut : fileState  ParserState ptr mut : state -> string Type arrayView LabelId arrayView optional LabelType bool ) =>: readCompositeType
  state offsetConstants =:: prevConstants
  state [] .constants .length =:: constOffset
  state [] .labelBuffer .length =:: labelOffset
  state [] .progContext [] .idContext @ =:: idContext
  code
    while fileState nextToken
      fileState state tryParseConstant if ..drop
        ..dup .length 0 > if continue else break end
      end
      ..dup endString string.eq labelType .NONE ?? if ..over "->" string.wrap  string.eq | end
      if
        endString string.eq =:: isEnd
        labelType .TUPLE ?? if
          LabelId arrayView optional.empty
        else state [] .labelBuffer .length labelOffset == and
            labelType .PROC_IN ?? or labelType .NONE ?? _if
          LabelId arrayView optional.empty ## procedure with no labels
        else
          state [] .constants .length constOffset -
          state [] .labelBuffer .length labelOffset - - ..dup 0 > if
            "too many types for label" sb.wrap fileState [] .wordStart state appendError2
            while ..dup 0 > do
              "" string.wrap id.FLAG_EMPTY fileState [] .wordStart state [] .currentFile idContext [] .typeContext .labelContext @ id.newLabel
                state [] .labelBuffer ..swap list.append
              state [] .labelBuffer =
              1 -
            end
          else ..dup 0 < _if
            "not enough types for label" sb.wrap fileState [] .wordStart state appendError2
            while ..dup 0 < do
              Type .undefined fileState [] .wordStart newTypeConst  state pushConst
              1 +
            end
          end ..drop
          state [] .labelBuffer list.asArray labelOffset array.tail optional.wrap
        end
        prevConstants state resetConstants
        state [] .labelBuffer
          labelOffset list.setLength
        state [] .labelBuffer  =
        state [] .constants .length constOffset - fileState state popTypeConstants =:: isError
        ..swap
        isEnd if labelType else LabelType .PROC_IN end
        isError
        return
      else labelType .PROC_IN ?? and ..dup ")" string.wrap string.eq _if ..drop
        "unexpected \")\"" sb.wrap fileState [] .wordStart state appendError2
        prevConstants state resetConstants
        state [] .labelBuffer
          labelOffset list.setLength
        state [] .labelBuffer  =
        Type array.empty LabelId arrayView optional.empty labelType true return
      else ..dup ":" string.wrap string.eq _if ..drop
        labelType .TUPLE ?? if
          "unexpected ':' operator" sb.wrap fileState [] .wordStart state appendError2
        end
        state [] .constants .length constOffset - 1 -
        state [] .labelBuffer .length labelOffset - - ..dup 0 > if
          "too many types for label" sb.wrap fileState [] .wordStart state appendError2
          while ..dup 0 > do
            "" string.wrap id.FLAG_EMPTY fileState [] .wordStart state [] .currentFile idContext [] .typeContext .labelContext @ id.newLabel
              state [] .labelBuffer ..swap list.append
            state [] .labelBuffer =
            1 -
          end
        else ..dup 0 < _if
          "not enough types for label" sb.wrap fileState [] .wordStart state appendError2
          while ..dup 0 < do
            Type .undefined fileState [] .wordStart newTypeConst  state pushConst
            1 +
          end
        end ..drop
        fileState nextToken
        ..dup .IDENTIFIER ?? ! if
          "expected identifier" sb.wrap fileState [] .wordStart state appendError2
        end
        .IDENTIFIER
        fileState
        state
        fileState state peekTypeConstant if
          "missing type for label" sb.wrap fileState [] .wordStart state appendError2
        end =:: argType
        argType types.primitive.TYPE types.typeEquals if
          id.FLAG_STATIC else 0 LabelFlag cast
        end
        readLabelAddFlags
          state [] .labelBuffer ..over list.append state [] .labelBuffer =
          idContext [] .typeContext .labelContext@ id.labelFlags id.FLAG_AUTO id.FLAG_STATIC | & ? and
              labelType .PROC_IN ?? ! and labelType .NONE ?? ! if
             "unexpected label: `static` and `auto` can only be used in procedure arguments\n  values of type `type` are labeled `static` by default" sb.wrap fileState [] .wordStart state appendError2
          end
        continue
      end
      labelType .ENUM ?? ! if
        64 sb.create
          "unknown type name " sb.appendS
          ..over sb.appendStr
        fileState [] .wordStart state appendError2
        ..drop
        Type .undefined fileState [] .wordStart newTypeConst  state pushConst
        continue
      end
        state [] .constants .length constOffset -
        state [] .labelBuffer .length labelOffset - - ..dup 0 > if
          "unexpected label in enum, expected ':' " sb.wrap fileState [] .wordStart state appendError2
          while ..dup 1 > do
            "" string.wrap id.FLAG_EMPTY fileState [] .wordStart state [] .currentFile idContext [] .typeContext .labelContext @ id.newLabel
              state [] .labelBuffer ..swap list.append
            state [] .labelBuffer =
            1 -
          end ..drop
          fileState state readLabel
            state [] .labelBuffer ..swap list.append
          state [] .labelBuffer =
          continue
        else ..dup 0 < _if
          "not enough types for label" sb.wrap fileState [] .wordStart state appendError2
          while ..dup 0 < do
            Type .undefined fileState [] .wordStart newTypeConst  state pushConst
            1 +
          end
        end ..drop
      id.FLAG_NONE fileState [] .wordStart state [] .currentFile idContext [] .typeContext .labelContext @ id.newLabel
        state [] .labelBuffer ..swap list.append
      state [] .labelBuffer =
      Type .empty fileState [] .wordStart newTypeConst  state pushConst
      ..dup .length 0 >
    do end
  "unexpected end of file" sb.wrap fileState [] .wordStart state appendError2
  Type array.empty LabelId arrayView optional.empty labelType true return
end

proc(
  string : literal
  IntLiteralType : literalType
  Type : intType
  FileState ptr mut : fileState
  ParserState ptr mut : state
-> bool ) =>: tryParseIntConstant
  state .progContext [] .idContext .typeContext@ =:: typeContext
  literalType .AUTO_UNSIGNED ?? or intType typeContext types.isUnsignedInt if
    literal 0 number.tryParseUInt
  else
    literal 0 number.tryParseInt
  end switch
    NONE case
      literalType intType fileState [] .wordStart state newIntConstant  state pushConst
      true return
    SIGN case ..drop
      "unsigned value is marked as negative: " sb.wrap
        literal sb.appendStr
      fileState [] .wordStart state appendError2
      true return
    OVERFLOW case ..drop
      "integer value outside allowed range: " sb.wrap
        literal sb.appendStr
      fileState [] .wordStart state appendError2
      true return
    INT INVALID_BASE case ..unreachable
    INVALID_CHAR EMPTY case ..drop
      false return
  end
end
proc( string : str FileState ptr mut : fileState  ParserState ptr mut : state -> bool ) =>: tryParseNumberLiteral
  state [] .progContext .idContext@ =:: idContext
  idContext .typeContext@ =:: typeContext
  str .length 0 == if
    false return
  end
  str 0 string.charAt '#' == if
    false return ## annotations
  end
  false =:: mut: unsigned
  0 =:: mut: size
  str ':' string.lastIndexOf =:: i
  i 0 > and i str .length 1 - < if
    str i string.splitIndex =:: literal =:: literalTypeName
    literal ':'  string.contains if
      false return ## literal cannot contain :
    end
    literalTypeName "u" string.wrap string.eq  if
      literal IntLiteralType .AUTO_UNSIGNED Type .undefined fileState state tryParseIntConstant ! if
        "invalid integer constant: `" sb.wrap
          literal sb.appendStr
          '`' sb.appendC
        fileState [] .wordStart state appendWarning2
      end
      true return
    else literalTypeName "i8"  string.wrap string.eq _if types.primitive.I8
    else literalTypeName "u8"  string.wrap string.eq _if types.primitive.U8
    else literalTypeName "i16" string.wrap string.eq _if types.primitive.I16
    else literalTypeName "u16" string.wrap string.eq _if types.primitive.U16
    else literalTypeName "i32" string.wrap string.eq _if types.primitive.I32
    else literalTypeName "u32" string.wrap string.eq _if types.primitive.U32
    else literalTypeName "i64" string.wrap string.eq _if types.primitive.I64
    else literalTypeName "u64" string.wrap string.eq _if types.primitive.U64
    else literalTypeName "f32" string.wrap string.eq _if types.primitive.F32
    else literalTypeName "f64" string.wrap string.eq _if types.primitive.F64
    else literalTypeName state [] .currentFile idContext id.findIdentifierByName
        ..swap =:: idData ! and
        idData .idType .TYPE ?? and idData .constValue .typeId ?? _if
      idData .constValue .typeId []
    else
      "unexpected type for number literal: " sb.wrap
        literalTypeName sb.appendStr
      fileState [] .wordStart state appendError2
      true return
    end =:: literalType
    literalType typeContext types.isInt if
      literalType typeContext types.isUnsignedInt unsigned =
      literalType typeContext types.sizeOf .fixed i32 cast 8 * size =
      ## TODO ensure constant has correct type
      literal IntLiteralType .FIXED literalType fileState state tryParseIntConstant ! if
        "invalid integer constant: `" sb.wrap
          literal sb.appendStr
          '`' sb.appendC
        fileState [] .wordStart state appendWarning2
      end
      true return
    else literalType typeContext types.isFloat _if
      literal 0 number.tryParseFloat =:: errCode
      errCode .NONE ?? or errCode .INT ?? if
        literalType fileState [] .wordStart newFloatConst state pushConst
        true return
      else ..drop
        "invalid float constant: `" sb.wrap
          literal sb.appendStr
          '`' sb.appendC
        fileState [] .wordStart state appendWarning2
      end
    else
      "unsupported literal type: " sb.wrap
        literalType typeContext sb.appendType
      fileState [] .wordStart state appendError2
      true return
    end
  end
  str IntLiteralType .AUTO Type .undefined fileState state tryParseIntConstant if
    true return
  end
  str 0 number.tryParseFloat
    ..dup .NONE ?? if ..drop
      types.primitive.F64 fileState [] .wordStart newFloatConst state pushConst
      true return
    else ..dup .INT ?? _if ..drop.2
      "integer value outside allowed range: " sb.wrap
        str sb.appendStr
      fileState [] .wordStart state appendError2
      true return
    end
  ..drop.2
  false return
end
proc( string : code Token : token FileState ptr mut : fileState  ParserState ptr mut : state -> string string bool ) =>: tryParseConstant
  state [] .progContext =:: progContext
  state [] .progContext [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  idContext [] .typeContext .labelContext @ =:: labelContext
  code
    token switch
      EMPTY case
        "" string.wrap true return
      STRING case
        ## newStringConstant
          ## parseStringConstant
            token .STRING
            fileState [] .wordStart
            progContext [] .errors @
            labelContext
          id.parseStringConstant
          fileState [] .wordStart
          typeContext
        newStringConstant state pushConst
        "" string.wrap true return
      RAW_STRING case
        ## newStringConstant
          ## parseRawStringConstant
            token .RAW_STRING
            fileState [] .wordStart
            progContext [] .errors @
            labelContext
          id.parseRawStringConstant
          fileState [] .wordStart
          typeContext
        newStringConstant state pushConst
        "" string.wrap true return
      CHAR case
        token .CHAR
          fileState [] .wordStart progContext [] .errors @  labelContext id.parseStringConstant ## escape character
          ..dup .length 1 != if
            "A character literal has to contain exactly one character" sb.wrap fileState [] .wordStart state appendError2
          end
          0 labelContext id.scCharAt
        fileState [] .wordStart newCharConstant state pushConst
        "" string.wrap true return
      IDENTIFIER case
        token .IDENTIFIER fileState state tryParseNumberLiteral if
          "" string.wrap true return
        end
        token .IDENTIFIER
        break
    end
    ..dup "_" string.wrap string.eq if
      fileState [] .wordStart newWildcardConst  state pushConst
      true return
    else ..dup "true" string.wrap string.eq _if
      true fileState [] .wordStart newBoolConstant  state pushConst
      true return
    else ..dup "false" string.wrap string.eq _if
      false fileState [] .wordStart newBoolConstant  state pushConst
      true return
    else ..dup "bool" string.wrap string.eq _if
      types.primitive.BOOL fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "i8" string.wrap string.eq _if
      types.primitive.I8 fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "i16" string.wrap string.eq _if
      types.primitive.I16 fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "i32" string.wrap string.eq _if
      types.primitive.I32 fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "i64" string.wrap string.eq _if
      types.primitive.I64 fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "u8" string.wrap string.eq _if
      types.primitive.U8 fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "u16" string.wrap string.eq _if
      types.primitive.U16 fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "u32" string.wrap string.eq _if
      types.primitive.U32 fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "u64" string.wrap string.eq _if
      types.primitive.U64 fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "f32" string.wrap string.eq _if
      types.primitive.F32 fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "f64" string.wrap string.eq _if
      types.primitive.F64 fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "type" string.wrap string.eq _if
      types.primitive.TYPE fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..ctype.void" string.wrap string.eq _if
      types.ctype.VOID fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..ctype.bool" string.wrap string.eq _if
      types.ctype.BOOL fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..ctype.char" string.wrap string.eq _if
      types.ctype.CHAR fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..ctype.schar" string.wrap string.eq _if
      types.ctype.S_CHAR fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..ctype.uchar" string.wrap string.eq _if
      types.ctype.U_CHAR fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..ctype.short" string.wrap string.eq _if
      types.ctype.SHORT fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..ctype.ushort" string.wrap string.eq _if
      types.ctype.U_SHORT fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..ctype.int" string.wrap string.eq _if
      types.ctype.INT fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..ctype.uint" string.wrap string.eq _if
      types.ctype.U_INT fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..ctype.long" string.wrap string.eq _if
      types.ctype.LONG fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..ctype.ulong" string.wrap string.eq _if
      types.ctype.U_LONG fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..ctype.longlong" string.wrap string.eq _if
      types.ctype.LONGLONG fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..ctype.ulonglong" string.wrap string.eq _if
      types.ctype.U_LONGLONG fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..ctype.size" string.wrap string.eq _if
      types.ctype.SIZE fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..ctype.float" string.wrap string.eq _if
      types.ctype.FLOAT fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..ctype.double" string.wrap string.eq _if
      types.ctype.DOUBLE fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..ctype.struct*" string.wrap string.eq _if
      types.ctype.STRUCT_PTR fileState [] .wordStart newTypeConst  state pushConst
      true return
    else ..dup "..ctype.union*" string.wrap string.eq _if
      types.ctype.UNION_PTR fileState [] .wordStart newTypeConst  state pushConst
      true return
    end
  false return
end
proc( string #+size+# string #+opName+# FilePosition ParserState ptr mut -> i32 ) =>: getCompilerOpParam
  =:: state
  =:: pos
  =:: opName
  ..dup 10 number.tryParseInt .NONE ?? ! if ..drop
    ..dup .length 0 > if
      64 sb.create
        "unexpected argument for " sb.appendS
        opName sb.appendStr
        " expected positive integer got: \"" sb.appendS
        ..swap  sb.appendStr
        '"'    sb.appendC
      pos state appendError2
    else ..drop end
    1 return
  else ..swap ..drop i32 cast ..dup 1 < _if
    50 sb.create
      "argument of " sb.appendS
        opName sb.appendStr
      " has to be positive got: " sb.appendS
      ..swap sb.appendI
    pos state appendError2
    1
  end
  return
end

proc( string : code Token : token FileState ptr mut : fileState  ParserState ptr mut : state -> string ) =>: parseOperation
  state [] .progContext =:: progContext
  state [] .progContext [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  idContext [] .typeContext .labelContext @ =:: labelContext
  idContext [] .constContext @ =:: constContext
  code
    token fileState state tryParseConstant if
      ..drop return
    end
    ..dup .length 0 == if ..drop
      return ## skip empty tokens
    end
    ..dup 0 string.charAt '#' == if ## compiler command
      1 string.tail
      ..dup ":" string.wrap string.startsWith if 1 string.tail
        ..drop
        ## TODO annotation for (partially) disabiling constant folding in current procedure
        return ## ignore unknown annotations
      end
      64 sb.create
        "unsupported compiler command \"" sb.appendS
        ..swap                         sb.appendStr
        '\"'                          sb.appendC
      fileState [] .wordStart state appendError2
      return
    else ..dup ":" string.wrap string.eq
       ..over "=:" string.wrap string.eq |
       ..over "=>:" string.wrap string.eq | _if =:: opName
      opName ":" string.wrap string.eq ! =:: isInit
      opName "=>:" string.wrap string.eq =:: isProc
      false =:: mut: localDeclaration
      state [] .constantBlocks .length 0 == state [] .currentProc optional.isEmpty & if
        state tryInterpretGlobal ## try to interpret global operations before each declaration
        fileState state popTypeConstant ..drop
      else
        ## correct type will be resolved in type-check phase
        progContext [] .autoTypes .length i32 cast types.newAutoType
        progContext [] .autoTypes
          Type .undefined list.append
        progContext [] .autoTypes =
        true localDeclaration =
      end =:: mut: valType
      isProc localDeclaration & if
        "procedures can only be declared at global level" sb.wrap
        fileState [] .wordStart state appendError2
        return
      end
      false =:: mut: allowImmutableDeclaration
      false =:: mut: forceImmutable
      state [] .constantBlocks .length 0 > if
        IdentifierType .LABEL
        true allowImmutableDeclaration =
      else localDeclaration _if
        IdentifierType .LOCAL_VAR
      else isProc isInit ! | and valType typeContext types.isProcedure _if
        IdentifierType .PROCEDURE
        true forceImmutable =
        true allowImmutableDeclaration =
      else valType types.primitive.TYPE types.typeEquals _if
        IdentifierType .TYPE
        true forceImmutable =
        true allowImmutableDeclaration =
      else ## for comparability with old parser
        IdentifierType .GLOBAL_VAR
        true allowImmutableDeclaration =
      end =:: idType
      isProc idType .PROCEDURE ?? ! & if
        "unexpected type for \"" sb.wrap
          opName sb.appendStr
          "\" expected procedure got: " sb.appendS
          valType typeContext sb.appendType
        fileState [] .wordStart state appendError2
        return
      end
      fileState state nextWord fileState state
        ## make pre-declared variables mutable by default
        isInit allowImmutableDeclaration | if id.FLAG_NONE else id.FLAG_MUTABLE end
      readLabelAddFlags =:: mut: label
      forceImmutable and label labelContext id.labelFlags id.FLAG_MUTABLE & ? if
        "identifiers of type " sb.wrap
          idType sb.appendIdType
         " cannot be mutable" sb.appendS
        fileState [] .wordStart state appendError2
      end
      label labelContext id.labelFlags id.FLAG_EXPERIMENTAL & ? =:: experimental
      label
        valType
        idType
        -1 ## id
        ConstValue .none
        isInit
        fileState [] .wordStart
        state [] .currentFile
        idContext
        progContext [] .errors @
      id.declareIdentifier if ..drop.2
        return
      end =:: idData label =
      idType .TYPE ?? if
        isInit if
          fileState state popTypeConstant ! assert "pop type"
          label
          typeContext types.initializeNamedType if
            "re-initialization of named type" sb.wrap
            fileState [] .wordStart state appendError2
          end
        else
          label
          typeContext types.declareNamedType
        end
        fileState [] .wordStart newTypeConst .val
      else idType .PROCEDURE ?? _if
        progContext [] .procedures .length ProcId cast ConstValue .procedure
      else isInit ! _if
        ConstValue .none
      else state hasConst2 _if
        state peekConst2 .data =:: info .data =:: value
          info [] .valueType valType false typeContext types.canCast ! if
            "cannot cast " sb.wrap
              info [] .valueType typeContext sb.appendType
              " to " sb.appendS
              valType typeContext sb.appendType
            fileState [] .wordStart state appendError2
          end
        value []
      else
        ConstValue .none
      end
        label idContext id.getIdentifier
        ! assert "label is identifier"
      [] .constValue =
      localDeclaration ! and
          MAIN_NAME string.wrap label labelContext id.labelNameEq if ## main
        idType .PROCEDURE ?? ! if
          "main has to be a procedure got: " sb.wrap
            idData @ id.asIdInfo labelContext sb.appendIdInfo
          fileState [] .wordStart state appendError2
        end
        true =:: mut: validMain
        label labelContext id.getLabelFile 0:FileId != and
            idData .labelId labelContext id.labelFlags id.FLAG_EXPORT & ? ! if
          "main procedure is not visible from root file" sb.wrap
          fileState [] .wordStart state appendWarning2
          false validMain =
        end
        label labelContext id.getLabelNamespace 0:NamespaceId != if
          "main procedure not in global namespace" sb.wrap
          fileState [] .wordStart state appendWarning2
          false validMain =
        end
        validMain if
          idData .valueType typeContext types.getProcIn ..swap =:: inTypes
          idData .valueType typeContext types.getProcOut ..swap =:: outTypes
          #+no inTypes+# #+no outTypes+# | if
            "could not resolve signature of main" sb.wrap
            fileState [] .wordStart state appendError2
          end
          inTypes typeContext types.compositeEltCount 0 > if
            "main procedure should not take arguments" sb.wrap
             fileState [] .wordStart state appendError2
          end
          outTypes typeContext types.compositeEltCount 0 > if
            "main procedure should not return a value" sb.wrap
             fileState [] .wordStart state appendWarning2
          end
        end
      end
      idData .idType .TYPE ?? if
        return
      end
      idData .idType .PROCEDURE ?? if
        state [] .currentProc optional.hasData if
          "procedures cannot be nested" sb.wrap fileState [] .wordStart state appendError2
        end
        valType typeContext types.getProcIn ..drop =:: procIn
        procIn typeContext types.compositeEltCount =:: inCount
        false =:: mut: hasStaticArg
        0:i64 while ..dup inCount < do =:: i
          procIn i typeContext types.compositeGetLabel
              labelContext id.labelFlags id.FLAG_STATIC & ? if
            true hasStaticArg =
            i break
          end
          i 1 +
        end ..drop
        label labelContext id.labelFlags id.FLAG_STATIC & ? =:: mut: isStatic
        valType typeContext types.getProcOut ..drop =:: procOut
        procOut typeContext types.compositeEltCount =:: outCount
        0:i64 while ..dup outCount < do =:: i
          procOut i typeContext types.compositeGetLabel
              labelContext id.labelFlags id.FLAG_STATIC & ? if
            true isStatic =
            i break
          end
          procOut i typeContext types.compositeGetElement
              typeContext types.unwrapNamed
              types.primitive.TYPE types.typeEquals if
            true isStatic =
            i break
          end
          i 1 +
        end ..drop
        progContext [] .procedures
          ..dup .length ProcId cast =:: procId
          isInit if
            progContext [] .tmpOps .length
          else -1:i64 end =:: procStart
          ## ProcedureInfo
            state [] .currentFile
            valType
            label
            ## CodeProcData
              0 ProcImplementation list.create
              0 VariableInfo list.create
              procStart
              -1
            CodeProcData new ProcImplType .code
            hasStaticArg
            isStatic
          ProcedureInfo new list.append
        progContext [] .procedures =
        isInit if
          state hasConst2 if
            state popConst2 =:: info ..drop
            "unexpected constant at global level" sb.wrap info .pushedAt state appendError2
          end
          valType experimental state openProcBlock
          procId optional.wrap state [] .currentProc =
          idData .valueType typeContext types.getProcIn if
            "could not resolve procedure signature" sb.wrap fileState [] .wordStart state appendError2
          end =:: inType
          inType typeContext types.compositeEltCount =:: count
          0:i64 while ..dup count < do =:: index
            inType index typeContext types.compositeGetLabel =:: argLabel
            inType index typeContext types.compositeGetElement =:: argType
            argLabel i32 cast =:: argId
              argLabel labelContext id.isLabelEmpty ! and
                  argLabel labelContext id.labelFlags id.FLAG_DUMMY & ? ! if
                ## declareIdentifier
                  argLabel
                  argType
                  IdentifierType .ARGUMENT
                  index i32 cast
                  ConstValue .none
                  true
                  fileState [] .wordStart
                  state [] .currentFile
                  idContext
                  progContext [] .errors @
                id.declareIdentifier if ..drop.2
                  return
                end ..drop.2
              end
            index 1 +
          end ..drop
        end
      end
      isInit ! localDeclaration ! & if
        return ## no operation for global pre-declaration
      end
      idData .valueType idData @ id.asIdInfo fileState [] .wordStart isInit if
        opInitializeId
      else
        opDeclareId
      end
      localDeclaration if
        state appendOp
        return
      end
      Operation ptr optional.empty state resetGlobalInterpreter
      state appendOp
      state skipGlobalInterpreter
      return
    else ..dup "=::" string.wrap string.eq _if ..drop
      state tryInterpretGlobal
      fileState state nextWord fileState state readLabel =:: mut: labelId
      state hasConst2 if
        state peekConst2 =:: info =:: value
        info .data [] .valueType
        $ .intLiteral ?? if
          .intLiteral types.intLiteralAsInt
        end
        value .data []
      else
        progContext [] .autoTypes .length i32 cast types.newAutoType
        progContext [] .autoTypes
          Type .undefined list.append
        progContext [] .autoTypes =
        ConstValue .none
      end =:: constValue =:: constType
      constType typeContext types.isProcedure if
        "unexpected procedure" sb.wrap fileState [] .wordStart state appendError2
        return
      else constType types.primitive.TYPE types.typeEquals _if
        IdentifierType .TYPE
      else state [] .currentProc optional.isEmpty _if
        IdentifierType .GLOBAL_VAR
      else
        IdentifierType .LOCAL_VAR
      end =:: idType
      ## declareIdentifier
        labelId
        constType
        idType
        -1 ## id
        ConstValue .none
        true
        fileState [] .wordStart
        state [] .currentFile
        idContext
        progContext [] .errors @
      id.declareIdentifier if ..drop.2
        return
      end =:: idData labelId =
      ## create constant value after creating declaration
      idType .TYPE ?? if
        constValue .typeId =:: typeConst
        state popConst2 ..drop.2
        typeConst typeContext types.isProcedure if
          "declaration of a procedure type as constant\n use '=>:' to declare procedures\n" sb.wrap
            "for declaring a procedure type constant use a explicit type declaration ( `type =:` ) " sb.appendS
          fileState [] .wordStart state appendWarning2
        end
        ## initializeNamedType
          typeConst
          labelId
          typeContext
        types.initializeNamedType if
          "re-initialization of named type" sb.wrap
          fileState [] .wordStart state appendError2
        end ConstValue .typeId
      else
        constValue
      end
        labelId idContext id.getIdentifier
        ! assert "label is identifier"
      [] .constValue =
      idData .idType .TYPE ?? if
        return
      end
      Operation ptr optional.empty state resetGlobalInterpreter
      idData .valueType idData @ id.asIdInfo fileState [] .wordStart opAutoTypedInitializeId state appendOp
      state skipGlobalInterpreter
      return
    else ..dup "=" string.wrap string.eq _if ..drop
      fileState [] .wordStart opSetValue state appendOp
      return
    else ..dup "@" string.wrap string.eq _if =:: opName
      state peekOp ..dup optional.isEmpty if ..drop
        "unexpected \"" sb.wrap
          opName sb.appendStr
        '"' sb.appendC fileState [] .wordStart state appendError2
        return
      end .data
      ..dup [] .val .getId ?? if
        ..dup [] .val .getId ..over [] .val .atId =
        fileState [] .wordStart ..swap [] .pos =
        return
      else ..dup [] .val .getLabel ?? _if
        ..dup [] .val .getLabel ..over [] .val .atLabel =
        fileState [] .wordStart ..swap [] .pos =
        return
      else ..dup [] .val .getElement ?? _if
        ..dup [] .val .getElement ..over [] .val .atElement =
        fileState [] .wordStart ..swap [] .pos =
        return
      else ..dup [] .val .getArrayElement ?? _if
        ..dup [] .val .getArrayElement ..over [] .val .atArrayElement =
        fileState [] .wordStart ..swap [] .pos =
        return
      else ..dup [] .val .getName ?? _if
        ..dup [] .val .getName ..over [] .val .atName =
        fileState [] .wordStart ..swap [] .pos =
        return
      else
        "unexpected operation for \"" sb.wrap
        opName sb.appendStr
        "\"\n" sb.appendS
        ..swap [] progContext sb.appendOp
        fileState [] .wordStart state appendError2
        return
      end
    else ..dup "??" string.wrap string.eq _if =:: opName
      state peekOp ..dup optional.isEmpty if ..drop
        "unexpected \"" sb.wrap
