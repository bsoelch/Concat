      while
        state closeBlock .else
          "unexpected 'end'" sb.copyPtr fileState [] .wordStart errors appendError
          return
        end =:: closedBlock
        closedBlock .blockData switch
          If .case =:: ifData
            ifData .elsePosition .if
              fileState [] .wordStart state setBlockJump
            else
              ifData .ifPosition fileState [] .wordStart state setBlockJump
              ifData .andPositions .length 0 != =:: hasAnd
              ifData .andPositions slice.freeze fileState [] .wordStart state setBlockJumps
              BlockType .ELSE fileState [] .wordStart opBlock  state appendOp
              1:JumpDistance state peekOp .if .val .block .jumpDistance= else ..drop end
              hasAnd ! and closedBlock .tmpVarInfo .if
                state fileState [] .wordStart appendElseVal
              end
            end
            BlockType .ELSE fileState [] .wordStart opEndBlock  state appendOp
            ifData .andPositions slice.free ..drop
          break
          AndOr .case =:: andOrData
            andOrData .andOrPositions list.asSlice fileState [] .wordStart state setBlockJumps
            andOrData .andOrPositions list.free ..drop
            BlockType .AND fileState [] .wordStart opEndBlock  state appendOp
          break
          While .case =:: whileData
            whileData .breakPositions =:: mut: breakPositions
            whileData .state .WHILE if
              breakPositions state opCount list.append breakPositions=
              BlockType .DO fileState [] .wordStart opBlock  state appendOp
              BlockType .FINALLY fileState [] .wordStart opBlock  state appendOp
            else whileData .state .DO _if
              BlockType .FINALLY fileState [] .wordStart opBlock  state appendOp
              closedBlock .tmpVarInfo .if
                state fileState [] .wordStart appendItrStep
              end
            end
            breakPositions list.asSlice fileState [] .wordStart state setBlockJumps
            whileData .whilePosition fileState [] .wordStart state setBlockJump
            BlockType .FINALLY fileState [] .wordStart opEndBlock  state appendOp
            whileData .whilePosition
              state opCount - JumpDistance cast
            state peekOp .if
              .val .blockEnd .jumpDistance=
            else ..drop end
            closedBlock .tmpVarInfo .if
              state fileState [] .wordStart appendItrEnd
            end
            breakPositions list.free ..drop
            whileData .continuePositions list.free ..drop
          break
          Switch .case =:: switchData
            switchData .breakPositions list.asSlice fileState [] .wordStart state setBlockJumps
            switchData .prevCasePosition fileState [] .wordStart state setBlockJump
            switchData .switchPosition fileState [] .wordStart state setBlockJump
            ## allow switch without default (behavior depends on switched type)
            BlockType .SWITCH fileState [] .wordStart opEndBlock  state appendOp
            switchData .breakPositions list.free ..drop
          break
