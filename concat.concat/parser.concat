      "..drop":s opName@ =
      params opName fileState [] .wordStart state getCompilerOpParam ## :count
      StackModType .DROP fileState [] .wordStart opStackMod state appendOp
      return
    else ..dup "import":s string.eq _if =:: opName
      fileState nextToken ## XXX? distinquish string types
      ..dup .STRING ?? if .STRING .value ## local file
        ## TODO? allow ignoring name of current folder (search base-path, then current folder)
        state [] .basePath .length ..over .length + sb.create
          state [] .basePath sb.appendStr
          ..swap sb.appendStr
        fileState [] .wordStart state importFile
        return
      else ..dup .IDENTIFIER ?? _if .IDENTIFIER ## library file
        fileState [] .wordStart state importLibraryFile return
      end
      64 sb.create
        "invalid parameter for " sb.appendS
        opName sb.appendStr
        ':' sb.appendC
        ..swap sb.appendToken
        " expected identifier or string" sb.appendS
      fileState [] .wordStart errors appendError
      return
    else $ "using":s string.eq or $ "using:":s string.eq _if =:: opName
      opName "using:":s string.eq =:: isAlias
      isAlias if
        fileState errors nextIdentifier
      else string.empty end =:: aliasName
      fileState errors nextIdentifier
        $ ".":s string.endsWith =:: importNamespace
        importNamespace if
          $ .length 1 - string.head
        end
      =:: usedName
      importNamespace if
        usedName id.FLAG_NONE
          fileState [] .wordStart state [] .currentFile
        labelContext id.newLabel =:: namespaceLabel
        state [] .currentProcs .length 0 > if
          aliasName .length 0 > if
            aliasName id.FLAG_NONE
              fileState [] .wordStart state [] .currentFile
            labelContext id.newLabel
          else id.LABEL_ID_NONE end =:: aliasLabel
          namespaceLabel aliasLabel fileState [] .wordStart opUsingNamespace state appendOp
          return
        end
        ## copy to ensure string stays alive
        aliasName labelContext id.copyString =:: newName
        namespaceLabel newName idContext id.importNamespace if
          "namespace \"" sb.copyPtr
            usedName sb.appendStr
          "\" does not exist in the current scope" sb.appendS fileState [] .wordStart errors appendWarning
        end
        return
      end
      state [] .currentProcs .length 0 > if
        usedName id.FLAG_NONE
          fileState [] .wordStart state [] .currentFile
        labelContext id.newLabel =:: usedLabel
        aliasName .length 0 > if
          aliasName id.FLAG_NONE
            fileState [] .wordStart state [] .currentFile
          labelContext id.newLabel
        else id.LABEL_ID_NONE end =:: aliasLabel
        usedLabel aliasLabel fileState [] .wordStart opUsingIdentifier state appendOp
        return
      end
      usedName
        aliasName
        idContext
        fileState [] .wordStart
      errors id.importIdentifier ..drop
      return
    else $ "assert":s string.eq _if =:: opName
      ## opAssert
        fileState [] .wordStart
      opAssert state appendOp
      return
    else $ "..compiler.error":s string.eq
        or $ "..compiler.warning":s string.eq
        or $ "..compiler.info":s string.eq _if =:: opName
      ## create error/warning/info if operation is reachable
      opName "..compiler.error":s string.eq if
        ErrorType .ERROR
      else opName "..compiler.warning":s string.eq _if
        ErrorType .WARNING
      else opName "..compiler.info":s string.eq _if
        ErrorType .INFO
      else
        "unexpected error type: " sb.copyPtr
          opName sb.appendStr
        fileState [] .wordStart errors appendError
        ErrorType .ERROR
      end =:: errorType
      ## opError
        errorType
        fileState [] .wordStart
      opError state appendOp
      return
    else $ "..compiler.flag.":s string.startsWith _if
      "..compiler.flag." ..length string.tail =:: flagName
      ## XXX? treat compiler constants as variables, allow :? operator to check if constant exists
      flagName "experimental":s string.eq if
        _EXPERIMENTAL_ ConstValue .Bool
        types.primitive.BOOL
      else flagName "foldConstants":s string.eq _if
        _FOLD_CONSTANTS_ ConstValue .Bool
        types.primitive.BOOL
      else flagName "noCore":s string.eq _if
        _INCLUDE_CORE_ ! ConstValue .Bool
        types.primitive.BOOL
      else flagName "wError":s string.eq _if
        _W_ERROR_ ConstValue .Bool
        types.primitive.BOOL
      else flagName "incrementVersionNumber":s string.eq _if
        _INCREMENT_VERSION_ ConstValue .Bool
        types.primitive.BOOL
      else
        ConstValue .None
        Type .empty
      end
      fileState [] .wordStart opConst state appendOp
      return
    else $ "..compiler.version":s string.eq _if ..drop
      _VERSION_ ConstValue .Int
      types.primitive.I64
      fileState [] .wordStart opConst state appendOp
      return
    else $ "..compiler.return":s string.eq _if ..drop
      ..drop ## discard remainder of file
      ## close open if-blocks/switch-branches
      while state [] .openBlocks list.peek =:: next?
          BlockType ..length 38 == "no new block types" assert
          next? optional.hasData and next? .data [] .blockType switch
            IF IF_TRUE IF_FALSE ELSE ELSE_TRUE ELSE_FALSE CASE DEFAULT case true break
            default false break
          end do
        state [] .openBlocks
          list.pop ..drop
        state .openBlocks=
      end
      string.empty return
    else $ "..file":s string.eq _if ..drop
      fileState [] .wordStart .fileName =:: name
      name constContext newStringConst
      types.primitive.CHAR8
        types.ArrayType .POINTER
        name .length types.ArraySize .int =:: size
        size@ 1 slice.create
        false
      typeContext types.newArrayType ..drop
      fileState [] .wordStart opConst state appendOp
      return
    else $ "..line":s string.eq _if ..drop
      fileState [] .wordStart .line ConstValue .Int
      types.primitive.I64
      fileState [] .wordStart opConst state appendOp
      return
    else ..dup "..?types":s string.eq or
        ..dup "..?types.":s string.startsWith _if =:: mut: opName
      opName "..?types." ..length string.tail =:: params
      "..?types":s opName@ =
      -1 =:: mut: count
      0 =:: mut: depth
      params .length 0 > if
        params '.' string.split =:: head =:: tail
        head .length 0 > if
          head
            opName
            fileState [] .wordStart
          state getCompilerOpParam count@ =
        end
        tail .length 0 > if
          tail
            opName
            fileState [] .wordStart
          state getCompilerOpParam depth@ =
        end
      end
      ## opTypesInfo
        count
        depth
        fileState [] .wordStart
      opTypesInfo state appendOp
      return
    else ..dup "..?stack":s string.eq or
        ..dup "..?stack.":s string.startsWith _if =:: mut: opName
      opName "..?stack." ..length string.tail =:: params
      "..?stack":s opName@ =
      params .length 0 > if
        params opName fileState [] .wordStart state getCompilerOpParam
      else -1 end
      fileState [] .wordStart opStackInfo state appendOp
      return
    else ..dup "..?ops":s string.eq or
        ..dup "..?ops.":s string.startsWith _if =:: mut: opName
      opName "..?ops." ..length string.tail =:: params
      "..?ops":s opName@ =
      params .length 0 > if
        params opName fileState [] .wordStart state getCompilerOpParam
      else -1 end
      fileState [] .wordStart opPrintCompiledOps state appendOp
      return
    ## XXX ..?parser.ops
    else ..dup "..?find.":s string.startsWith _if =:: mut: opName
      opName "..?find." ..length string.tail =:: idName
      ## opPrintIdentifierMatches
        idName
          id.FLAG_NONE
          fileState [] .wordStart
          state [] .currentFile
        labelContext id.newLabel
        fileState [] .wordStart
      opPrintIdentifierMatches state appendOp
      return
    else ..dup "..?parser.find.":s string.startsWith _if =:: mut: opName
        opName "..?parser.find." ..length string.tail =:: idName
        16 id.IdentifierMatch list.create =:: mut: matches
        idName true idContext matches@ optional.wrap id.searchIdentifier ..drop.3
        "-----------------\n" sb.copyPtr
          "identifier \"" sb.appendS idName sb.appendStr "\":\n" sb.appendS
          0:i32 while ..dup matches .length < do =:: i
            matches i list.at .data =:: match
            match [] .nameData .labelId =:: labelId
            match [] .nameData .aliasId =:: aliasId
            labelId idContext id.getIdentifier
              ! "matched identifier exists" assert
            =:: idData
            " - " sb.appendS
            aliasId id.NO_ALIAS != if
              "alias (declared at " sb.appendS
              aliasId idContext id.getAliasPos sb.appendPos
              ")  to" sb.appendS
            end
            idData id.asIdInfo labelContext sb.appendIdInfo
            " ( " sb.appendS
            idData [] .valueType typeContext sb.appendType
            idData [] .constValue .None ?? ! if
              " [ " sb.appendS
              idData [] .constValue typeContext sb.appendConstant
              " ]" sb.appendS
            end
            " ) declared at " sb.appendS
            labelId labelContext id.labelPos =:: pos?
            pos? optional.hasData if
              pos? .data sb.appendPos
            else
              "?" sb.appendS
            end
            '\n' sb.appendC
            i 1 +
          end ..drop
          "-----------------\n" sb.appendS
          io.stdOut ..over io.fputSb ..drop
        sb.free ..drop
        matches list.free ..drop
        return
    else ..dup "begin":s string.eq or
         ..dup "defer":s string.eq _if =:: opName
      "`" sb.copyPtr
        opName sb.appendStr
        "` is a reserved keyword for a future language version" sb.appendS
      fileState [] .wordStart errors appendError
      return
    end
    ..dup "@":s string.endsWith =:: isAddr
    isAddr if
      ..dup .length 1 - string.head
    end
  =:: idName
  state [] .currentProcs .length 0 == if
    idName idContext id.findIdentifierByName ! if ## try parsing as identifier
      isAddr ! and $ [] .idType .ARGUMENT ?? and
          $ [] .labelId labelContext id.labelFlags =:: flags
          flags id.FLAG_AUTO & ? and flags id.FLAG_STATIC & ? ! if
        ## opConst
          $ [] .labelId ConstValue .GenericArg
          ..swap [] .valueType
          fileState [] .wordStart
        opConst state appendOp
        return
      end
      ..dup [] .valueType ..swap id.asIdInfo fileState [] .wordStart
        isAddr if opAtId else opGetId end
      state appendOp
      return
    end ..drop
  end
  idName
    id.FLAG_NONE fileState [] .wordStart state [] .currentFile
  labelContext id.newLabel =:: labelId
  labelId fileState [] .wordStart
  isAddr if opAtName else opGetName end
  state appendOp
  return
end
proc( io.IOError : err stringBuilder : fileName FilePosition : pos ParserState ptr.mut : state -> ) =>: checkIOError
  state [] .progContext =:: progContext
  progContext .errors =:: errors
  using io.
  err switch
    FILE_ERROR_NONE case
      return
    FILE_ERR_PATH_OVERFLOW FILE_ERR_OPEN_MODE FILE_ERR_FILE_NOT_FOUND FILE_ERR_FILE_IS_DIR FILE_ERR_ACCESS_DENIED FILE_ERR_INVALID_FILE case
      "cannot include file \"" sb.copyPtr fileName sb.appendSb '"' sb.appendC pos errors appendError
      return
    default
      "error while reading file \"" sb.copyPtr fileName sb.appendSb '"' sb.appendC pos errors appendError
      return
  end
end

proc( string FilePosition : pos ParserState ptr.mut : state -> ) =>: importLibraryFile
  state [] .libPath .length $1 .length + ".concat" ..length + sb.create
    state [] .libPath sb.appendStr
    ..swap sb.appendStr ".concat" sb.appendS
  pos state importFile
end
proc( stringBuilder : fileName FilePosition : pos ParserState ptr.mut : state -> ) =>: importFile
  state [] .progContext =:: progContext
  FILE_ID_NONE =:: mut: imported
  0:i32 while ..dup progContext [] .progFiles .length < do
    progContext [] .progFiles ..over list.get .fileName sb.asStr fileName sb.asStr string.eq if
      ..dup FileId cast imported@ =
      break
    end
    1 +
  end ..drop
  imported FILE_ID_NONE == if ## file has not yet been imported
    fileName state parseFile fileName pos state checkIOError imported@ =
  end
  ## TODO correctly resolve sub-imports for cyclic imports
  imported
    progContext [] .progFiles imported i64 cast list.at .data [] .fileScope
  progContext .idContext id.importFile
end

## procedures needed from type-checker
proc( ProgramContext ptr.mut : program -> TypeCheckState ) : export: newTypeCheckState
proc(
  ProgramContext ptr.mut : program
  TypeCheckState ptr.mut : state
->  ) : export: updateTypeCheckerPointers
proc(
  stringBuilder : rootFile
  string : libPath
  string : basePath
  bool : saveGlobalTokens
-> ProgramContext TypeCheckState ) =>: export: parseProgram
  newProgramContext =:: mut: programContext
  ## FilePosition
    rootFile sb.asStr
    0
    0
  FilePosition new =:: rootPos
  ## initBuiltInConstants
    rootPos
    programContext@
  initBuiltInConstants
  ## initBuiltInProcs
    rootPos
    programContext@
  initBuiltInProcs if
    ## TODO handle error
  end
  programContext@ newTypeCheckState =:: mut: typeChecker
  programContext@ typeChecker@ updateTypeCheckerPointers
  ## ParserState
    basePath
    libPath
    programContext@
    typeChecker@
    64  BlockInfo               list.create
    32  i32                     list.create
    128 Operation               list.create
    0
    128 Type                    list.create
    FILE_ID_NONE
    32  ProcId                  list.create
    128 CompositeConstantOffset list.create
    0   InterpreterInfo         list.create
    128 LabelId                 list.create
    128 sb.create
    saveGlobalTokens
  ParserState new =:: mut: state
  rootFile state@ parseFile rootFile rootPos state@ checkIOError ..drop
  ## cleanup parser memory
  state .typeBuffer list.free ..drop
  state .constantBlocks list.free ..drop
  0:i32 while ..dup state .globalInterpreters .length < do
    state .globalInterpreters
      ..over list.at .data .context
    interpreter.cleanupContext
    1 +
  end ..drop
  state .globalInterpreters list.free ..drop
  state .tmpString sb.free ..drop
  programContext typeChecker return
end
proc( stringBuilder : fileName ParserState ptr.mut : state -> FileId io.IOError ) =>: parseFile
  fileName
    state [] .progContext =:: progContext
    progContext .idContext =:: idContext
    idContext .typeContext .labelContext =:: labelContext
    progContext .errors =:: errors
    ..dup ..over .length 1 - sb.charAt '\x00' != if
      '\x00' sb.appendC ## ensure file-name is zero terminated
    end
    ..dup .length 1 - sb.setLength ## do not include zero terminator in length
    ..dup sb.asStr 0 1 FilePosition new ..dup FileState new =:: mut: fileState
    progContext [] .progFiles .length FileId cast =:: fileId
    progContext [] .progFiles
      ..over fileId progContext .idContext newProgFile list.append
    progContext .progFiles=
    ## TODO? use same interpreter for all files
    state [] .globalInterpreters
      ## InterpreterInfo
        progContext
          state [] .typeChecker optional.wrap
          fileId
          interpreter.InterpreterType .GLOBAL
        interpreter.wrapProgram
        0
      InterpreterInfo new list.append
    state .globalInterpreters=
  state [] .currentFile =:: prevFile
  fileId state .currentFile=
  $ .data >$ .length i64 cast.u 1 + #+include zero-terminator after file-name+# io.OPEN_READ io.fopen
    $ io.FILE_ERROR_NONE != if =:: openError
      ..drop ## discard code file
      prevFile state .currentFile= ## reset file id
      FILE_ID_NONE openError return
    end ..drop =:: f
    128 sb.create
      '\n' sb.appendC
      f sb.appendFile =:: readError
      '\n' sb.appendC
    =:: fileBody
  f io.fclose $ io.FILE_ERROR_NONE != or readError io.FILE_ERROR_NONE != if =:: closeError
      prevFile state .currentFile= ## reset file id
      readError io.FILE_ERROR_NONE != if
        FILE_ID_NONE readError return
      else
        FILE_ID_NONE closeError return
      end
  end ..drop
  state [] .openBlocks .length =:: blockCount
  labelContext id.currentNamespace =:: prevNamespace
  labelContext id.clearNamespace
  idContext id.currentScope =:: prevScope
  idContext id.clearScope
  _INCLUDE_CORE_ if
    false _INCLUDE_CORE_@ = ## don't include core in core
    "core":s fileState .currentPos state importLibraryFile
    true _INCLUDE_CORE_@ =
  end
  idContext id.openScope
  fileId id.NO_SCOPE idContext id.importFile ## import file in its own scope
  idContext id.currentScope progContext [] .progFiles fileId i64 cast list.at .data .fileScope=
  fileState@
    fileBody sb.asStr while
      $1 nextToken $2 state parseOperation
      $ .length 0 >
    do end ..drop
  ..drop
  fileBody sb.free ..drop
  idContext id.closeScope ! "file scope closed correctly" assert
  prevScope idContext id.setScope
  prevNamespace labelContext id.resetNamespace
  state [] .currentFile =:: newFileId
  fileId newFileId == "fileId did not change" assert
  prevFile state .currentFile=
  state [] .openBlocks .length blockCount > if
    ## XXX? print start of last block
    "unclosed block at end of file" sb.copyPtr
      fileState .currentPos
    errors appendError
  else state [] .openBlocks .length blockCount < _if
    "file closed additional code block" sb.copyPtr
      fileState .currentPos
    errors appendError
  end
  newFileId io.FILE_ERROR_NONE return
end
