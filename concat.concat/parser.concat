#include stringIO
#include list
#include arrayView

#include future

#include "program.concat"
#include "files.concat"
#include "labels.concat"
#include "types.concat"
#include "constants.concat"
#include "codeBlocks.concat"
#include "identifiers.concat"

struct( types.Type : argType ConstValue : val id.LabelId : labelId ) =:: StaticArgument
struct(
               string : mut basePath
               string : mut libPath
 id.IdentifierContext : mut idContext
        Constant list : mut constants
                  i64 : mut constOffset
      types.Type list : mut typeBuffer
  StaticArgument list : mut staticArgs
                  i64 : mut staticArgsOffset
     ProgramFile list : mut progFiles
               FileId : mut currentFile
       Operation list : mut templateOps
   CompilerError list : mut errors
                  i32 : mut autoTypeCount
) =:: ParserState

proc( Operation : op ParserState ptr mut : state => ) =: appendOp
  state [] .idContext .currentTemplate id.TEMPLATE_ID_NONE != if
    state [] .templateOps @
  else state [] .idContext @ id.isGlobal _if
    state [] .progFiles state [] .currentFile list.at .data [] .globalOps @
  else
    state [] .progFiles state [] .currentFile list.at .data [] .localOps @
  end
  #dup []
    0 while #dup state [] .constants .length < do
      #swap
        state [] .constants #over:2 list.get opConst list.append
      #swap
      1 +
    end #drop
    state [] .constants list.clear state [] .constants =
    op list.append
  #swap [] =
end
proc( stringBuilder FilePosition ParserState ptr mut => ) =: appendError
  =:: state
  CompilerError new
  state [] .errors
    #swap list.append
  state [] .errors =
end
proc( ParserState ptr mut : state => Operation ptr mut optional ) =: peekOp
  state [] .idContext .currentTemplate id.TEMPLATE_ID_NONE != if
    state [] .templateOps
  else state [] .idContext @ id.isGlobal _if
    state [] .progFiles state [] .currentFile list.get .globalOps
  else
    state [] .progFiles state [] .currentFile list.get .localOps
  end list.peek
end

proc( Constant : const ParserState ptr mut : state => ) =: pushConst
  state [] .constants const list.append state [] .constants  =
end
proc( ParserState ptr mut : state => bool ) =: hasConst
  state [] .constants .length 0 > return
end

proc( ParserState ptr mut : state => Constant ) =: popConst
  state [] .constants
    list.pop #swap state [] .constants =
  return
end
proc( FileState ptr mut : fileState ParserState ptr mut : state => types.Type bool ) =: peekTypeConstant
  state [] .constants .length state [] .constOffset <= if ## XXX more descriptive messages
    "missing type constant" sb.wrap fileState [] .wordStart state appendError
     types.Type .undefined true return
  end
  state [] .constants list.peek .data [] .val ConstValue .typeId != if
    "wrong type for constant expected type" sb.wrap state [] .constants list.peek .data [] .pos state appendError
    types.Type .undefined true return
  end
  state [] .constants list.peek .data [] .val .typeId false return
end
proc( FileState ptr mut : fileState ParserState ptr mut : state => types.Type bool ) =: popTypeConstant
  state [] .constants .length state [] .constOffset <= if
    "missing type constant" sb.wrap fileState [] .wordStart state appendError
     types.Type .undefined true return
  end
  state [] .constants list.peek .data [] .val ConstValue .typeId != if
    "wrong type for constant expected type" sb.wrap state [] .constants list.peek .data [] .pos state appendError
    types.Type .undefined true return
  end
  state [] .constants list.pop #swap state [] .constants =
    .val .typeId false return
end
proc( FileState ptr mut : fileState ParserState ptr mut : state => types.ArraySize arrayView bool #+fixed-size+# ) =: popArraySize
  state [] .constants .length state [] .constOffset <= if
    types.ArraySize array.empty true return
  end
  state [] .constants list.peek .data [] .val ConstValue .wildCard == if
    state [] .constants list.pop #drop state [] .constants = ## remove wildcard constant
    types.ArraySize array.empty false return
  end
  state [] .constants .length 1 - while #dup state [] .constOffset >= do
    state [] .constants #over list.get .valueType state [] .idContext .typeContext @ types.isInt ! if
      break
    end
    1 -
  end
  1 + ##revert last decrement
  #dup
  state [] .idContext .arraySizeBuffer
    list.clear
    #over state [] .constOffset - list.ensureCap
    #swap while #dup state [] .constants .length < do
      #swap
        state [] .constants #over:2 list.get .val
          #dup ConstValue .int == if
            .int types.ArraySizeType .int types.ArraySize new list.append
          else #dup ConstValue .genericArg == _if
            .genericArg types.ArraySizeType .staticArg types.ArraySize new list.append
          else #dup ConstValue .templateArg == _if
            .templateArg types.ArraySizeType .templateArg types.ArraySize new list.append
          else
            "unexpected constant for array size: " sb.wrap
              #swap state [] .idContext .labelContext addrOf state [] .idContext .typeContext addrOf sb.appendConstant
            state [] .constants #over:4 list.get .pos state appendError
          end
      #swap
      1 +
    end #drop
  state [] .idContext .arraySizeBuffer =
  state [] .constants .length =
  state [] .idContext .arraySizeBuffer list.asArray true return
end
proc( i64 : n FileState ptr mut : fileState ParserState ptr mut : state => types.Type arrayView bool ) =: popTypeConstants
  state [] .constants .length state [] .constOffset n + < if
    "missing type constant" sb.wrap fileState [] .wordStart state appendError
     types.Type array.empty true return
  end
  state [] .typeBuffer list.clear state [] .typeBuffer =
  state [] .constants .length n -
    #dup while #dup state [] .constants .length < do
      state [] .constants #over list.get .val ConstValue .typeId != if #drop:2
        "wrong type for constant, expected type" sb.wrap state [] .constants list.peek .data [] .pos state appendError
         types.Type array.empty true return
      end
      state [] .typeBuffer state [] .constants #over:2 list.get .val .typeId list.append state [] .typeBuffer =
      1 +
    end #drop
  state [] .constants .length =
  state [] .typeBuffer list.asArray false return
end
proc( types.Type : argTypes FileState ptr mut : fileState ParserState ptr mut : state => ConstantArray bool ) =: popTemplateArguments
  argTypes state [] .idContext .typeContext @ types.compositeEltCount =:: count
  count state [] .constants .length > if
    "not enough arguments for template" sb.wrap fileState [] .wordStart state appendError
     0 0 ConstantArray new true return
  end
  state [] .idContext .templateArgBuffer .length =:: offset
  state [] .constants .length count - state [] .constants .length =
  0 while #dup count < do
    state [] .constants .data #over state [] .constants .length + []
      #dup .valueType argTypes #over:3 state [] .idContext .typeContext @ types.compositeGetElement types.typeEquals ! if
        "incompatible type for template argument" sb.wrap fileState [] .wordStart state appendError ## XXX print types in error message
        #drop:2 0 0 ConstantArray new true return
      end
    state [] .idContext .templateArgBuffer
      #swap .val list.append
    state [] .idContext .templateArgBuffer =
    1 +
  end #drop
  offset state [] .idContext .templateArgBuffer .length offset - ConstantArray new false return
end
proc( id.LabelId : label types.Type : valType i64 : index ParserState ptr mut : state => ) =: newStaticArg
  state [] .staticArgs
    valType
      #dup types.primitive.TYPE types.typeEquals if
        index i32 cast types.newGenericType ConstValue .typeId new
      else
        index ConstValue .genericArg new
      end
    label
    StaticArgument new
  list.append state [] .staticArgs =
end
proc( string : name ParserState ptr mut : state => StaticArgument optional ) =: getStaticArg
  state [] .staticArgsOffset while #dup state [] .staticArgs .length < do
    state [] .staticArgs #over list.get
      #dup .labelId state [] .idContext .labelContext @ id.labelName #dup optional.hasData if .data name string.eq else #drop false end if
        #swap #drop optional.wrap return
      end
    #drop
    1 +
  end #drop
  StaticArgument optional.empty return
end

proc( ParserState ptr mut : state => i64 ) =: offsetConstants
  state [] .constOffset
    state [] .constants .length state [] .constOffset =
  return
end
proc( i64 ParserState ptr mut => ) =: resetConstants
  [] .constOffset =
end
proc( ParserState ptr mut : state => i64 ) =: offsetStaticArgs
  state [] .staticArgsOffset
    state [] .staticArgs .length state [] .staticArgsOffset =
  return
end
proc( i64 ParserState ptr mut =>  ) =: resetStaticArgs
  =:: state
  #dup
    state [] .staticArgsOffset =
  state [] .staticArgs .length =
end

proc( string : code FileState ptr mut : fileState  ParserState ptr mut : state => string string ) =: nextWord
  code
    fileState nextToken
    #dup Token .IDENTIFER != if
      "expected identifier" sb.wrap fileState [] .wordStart state appendError
    end
    .IDENTIFER
  return
end
proc( string : code string : start FileState ptr mut : fileState  ParserState ptr mut : state => string id.LabelId ) =: readLabel
  0 id.LabelFlag =: mut flags
  false =:: mut isModifer
  code start
    while
      false isModifer =
      #dup "mut" string.wrap string.eq if
        id.FLAG_MUTABLE flags | flags =
        true isModifer =
      else #dup "static" string.wrap string.eq _if
        id.FLAG_STATIC flags | flags =
        true isModifer =
      else #dup "extern" string.wrap string.eq _if
        id.FLAG_EXTERN flags | flags =
        true isModifer =
      else #dup "public" string.wrap string.eq _if
        id.FLAG_PUBLIC flags | flags =
        true isModifer =
      else #dup "private" string.wrap string.eq _if
        id.FLAG_PRIVATE flags | flags =
        true isModifer =
      end
      isModifer ! if
        break
      end
    isModifer do #drop
      fileState nextToken
      #dup Token .IDENTIFER != if #drop
        "expected identifier" sb.wrap state [] .constants list.peek .data [] .pos state appendError
        "" string.wrap
      else
        .IDENTIFER
      end
    end
  flags fileState [] .wordStart state [] .idContext .labelContext addrOf id.newLabel return
end
enum( NONE STRUCT ENUM PROC_IN ) =:: LabelType
proc( string : code LabelType : labelType string : endString FileState ptr mut : fileState  ParserState ptr mut : state => string id.LabelId types.Type arrayView bool ) =: readCompositeType
  state offsetConstants =:: prevConstants
  state [] .constants .length =:: constOffset
  labelType LabelType .NONE == if
    id.LABEL_ID_NONE
  else
    state [] .idContext .labelContext addrOf id.labelOffset
  end =:: labelOffset
  code
    while fileState nextToken
      fileState state tryParseConstant if #drop continue end
      #dup endString string.eq if #drop
        labelType LabelType .NONE == if
          id.LABEL_ID_NONE
        else labelType LabelType .PROC_IN == state [] .idContext .labelContext addrOf id.labelOffset labelOffset == & _if
          id.LABEL_ID_NONE ## procedure with no lables
        else
          state [] .constants .length constOffset -
          state [] .idContext .labelContext addrOf id.labelOffset labelOffset - - #dup 0 > if
            "two many types for label" sb.wrap fileState [] .wordStart state appendError
            while #dup 0 > do
              "" string.wrap id.FLAG_EMPTY fileState [] .wordStart state [] .idContext .labelContext addrOf id.newLabel #drop
              1 -
            end
          else #dup 0 < _if
            "not enough types for label" sb.wrap fileState [] .wordStart state appendError
            while #dup 0 < do
              types.Type .undefined fileState [] .wordStart constType  state pushConst
              1 +
            end
          end #drop
          labelOffset
        end
        prevConstants state resetConstants
        state [] .constants .length constOffset - fileState state popTypeConstants return
      else #dup ":" string.wrap string.eq _if #drop
        labelType LabelType .NONE == if
          "unexpected ':' operator" sb.wrap fileState [] .wordStart state appendError
        end
        state [] .constants .length constOffset - 1 -
        state [] .idContext .labelContext addrOf id.labelOffset labelOffset - - #dup 0 > if
          "two many types for label" sb.wrap fileState [] .wordStart state appendError
          while #dup 0 > do
            "" string.wrap id.FLAG_EMPTY fileState [] .wordStart state [] .idContext .labelContext addrOf id.newLabel #drop
            1 -
          end
        else #dup 0 < _if
          "not enough types for label" sb.wrap fileState [] .wordStart state appendError
          while #dup 0 < do
            types.Type .undefined fileState [] .wordStart constType  state pushConst
            1 +
          end
        end #drop
        fileState nextToken
        #dup Token .IDENTIFER != if
          "expected identifier" sb.wrap fileState [] .wordStart state appendError
        end
        .IDENTIFER
        fileState state readLabel
          #dup state [] .idContext .labelContext @ id.labelFlags  id.FLAG_STATIC & 0 != if
            labelType LabelType .PROC_IN != if
              "unexpected static label" sb.wrap fileState [] .wordStart state appendError
            end
            fileState state peekTypeConstant if
              "missing type for static label" sb.wrap fileState [] .wordStart state appendError
            end
           state [] .constants .length constOffset - 1 - state newStaticArg
          else #drop end
        continue
      end
      labelType LabelType .ENUM != if
        64 sb.create
          "unknown type name " sb.appendS
          #over sb.appendStr
        fileState [] .wordStart state appendError
        #drop
        types.Type .undefined fileState [] .wordStart constType  state pushConst
        continue
      end
        state [] .constants .length constOffset -
        state [] .idContext .labelContext addrOf id.labelOffset labelOffset - - #dup 0 > if
          "unexpected label in enum, expected ':' " sb.wrap fileState [] .wordStart state appendError
          while #dup 1 > do
            "" string.wrap id.FLAG_EMPTY fileState [] .wordStart state [] .idContext .labelContext addrOf id.newLabel #drop
            1 -
          end #drop
          fileState state readLabel #drop
          continue
        else #dup 0 < _if
          "not enough types for label" sb.wrap fileState [] .wordStart state appendError
          while #dup 0 < do
            types.Type .undefined fileState [] .wordStart constType  state pushConst
            1 +
          end
        end #drop
      id.FLAG_NONE fileState [] .wordStart state [] .idContext .labelContext addrOf id.newLabel #drop
      types.Type .undefined fileState [] .wordStart constType  state pushConst
      #dup .length 0 >
    do end
  "unexpected end of file" sb.wrap fileState [] .wordStart state appendError
  id.LABEL_ID_NONE types.Type array.empty true return
end
proc( string : code Token : token FileState ptr mut : fileState  ParserState ptr mut : state => string string bool ) =: tryParseConstant
  code
    token switch
      EMPTY case
        "" string.wrap true return
      STRING case
        ## constStr
          ## newStringConstant
            token .STRING
            fileState [] .wordStart
            state [] .errors @
            state [] .idContext .labelContext @
          id.newStringConstant
          fileState [] .wordStart
          state [] .idContext .typeContext @
        constStr state pushConst
        "" string.wrap true return
      CHAR case
        token .CHAR
          fileState [] .wordStart state [] .errors @  state [] .idContext .labelContext @ id.newStringConstant ## escape character
          #dup .length 1 != if
            "A character literal has to contain exactly one character" sb.wrap fileState [] .wordStart state appendError
          end
          state [] .idContext .labelContext addrOf id.scAsStr
          0 string.charAt
        fileState [] .wordStart constChar state pushConst
        "" string.wrap true return
      INTEGER case
        token .INTEGER fileState [] .wordStart constInt  state pushConst
        "" string.wrap true return
      ERROR case
        0 sb.create
          token .ERROR sb.appendStr
        fileState [] .wordStart state appendError
        "" string.wrap true return
      IDENTIFER case
        token .IDENTIFER
        break
    end
    #dup "_" string.wrap string.eq if
      fileState [] .wordStart constWildcard  state pushConst
      true return
    else #dup "true" string.wrap string.eq _if
      true fileState [] .wordStart constBool  state pushConst
      true return
    else #dup "false" string.wrap string.eq _if
      false fileState [] .wordStart constBool  state pushConst
      true return
    else #dup "bool" string.wrap string.eq _if
      types.primitive.BOOL fileState [] .wordStart constType  state pushConst
      true return
    else #dup "i8" string.wrap string.eq _if
      types.primitive.I8 fileState [] .wordStart constType  state pushConst
      true return
    else #dup "i32" string.wrap string.eq _if
      types.primitive.I32 fileState [] .wordStart constType  state pushConst
      true return
    else #dup "i64" string.wrap string.eq _if
      types.primitive.I64 fileState [] .wordStart constType  state pushConst
      true return
    else #dup "float" string.wrap string.eq _if
      types.primitive.FLOAT fileState [] .wordStart constType  state pushConst
      true return
    else #dup "type" string.wrap string.eq _if
      types.primitive.TYPE fileState [] .wordStart constType  state pushConst
      true return
    else #dup "ptr" string.wrap string.eq _if
      fileState state popArraySize =:: fixedSize =:: sizes
      fileState state popTypeConstant if #drop
        types.Type .undefined fileState [] .wordStart constType  state pushConst
        true return
      end
      true sizes fixedSize false state [] .idContext .typeContext addrOf types.newArrayType if #drop
        types.Type .undefined fileState [] .wordStart constType  state pushConst
        "could not create pointer type" sb.wrap fileState [] .wordStart state appendError
        true return
      end
        fileState [] .wordStart constType  state pushConst
      true return
    else #dup "array" string.wrap string.eq _if
      fileState state popArraySize =:: fixedSize =:: sizes
      fileState state popTypeConstant if #drop
        types.Type .undefined fileState [] .wordStart constType  state pushConst
        true return
      end
      false sizes fixedSize false state [] .idContext .typeContext addrOf types.newArrayType if #drop
        types.Type .undefined fileState [] .wordStart constType  state pushConst
        "could not create array type" sb.wrap fileState [] .wordStart state appendError
        true return
      end
        fileState [] .wordStart constType  state pushConst
      true return
    else #dup "mut" string.wrap string.eq _if
      fileState state popTypeConstant if #drop
        types.Type .undefined fileState [] .wordStart constType  state pushConst
        true return
      end
      #dup state [] .idContext .typeContext @ types.isMutable if
        "type is already mutable" sb.wrap fileState [] .wordStart state appendError
      end
      =:: mut t
      t @ true state [] .idContext .typeContext @ types.setMutability if
        "could not change mutability of type" sb.wrap fileState [] .wordStart state appendError
      end
      t fileState [] .wordStart constType  state pushConst
      true return
    else #dup "(" string.wrap string.eq  #over "tuple(" string.wrap string.eq | #over "struct(" string.wrap string.eq | _if
      "struct(" string.wrap string.eq if
        LabelType .STRUCT ")" string.wrap fileState state readCompositeType
      else
        LabelType .NONE ")" string.wrap fileState state readCompositeType
      end
      if
        "error while parsing tuple type" sb.wrap fileState [] .wordStart state appendError
      end
      #swap state [] .idContext .typeContext addrOf types.newTuple if
        "error while creating tuple type" sb.wrap fileState [] .wordStart state appendError
      end
      fileState [] .wordStart constType  state pushConst
      "" string.wrap true return
    else #dup "enum(" string.wrap string.eq _if #drop
      LabelType .ENUM ")" string.wrap fileState state readCompositeType
      if
        "error while parsing enum type" sb.wrap fileState [] .wordStart state appendError
      end
      #swap false state [] .idContext .typeContext addrOf types.newEnum if
        "error while creating enum type" sb.wrap fileState [] .wordStart state appendError
      end
      fileState [] .wordStart constType  state pushConst
      "" string.wrap true return
    else #dup "proc(" string.wrap string.eq _if #drop
      state offsetStaticArgs =:: prevArgs
      LabelType .PROC_IN "=>" string.wrap fileState state readCompositeType
      if
        "error while parsing procedure arguments" sb.wrap fileState [] .wordStart state appendError
      end
      #swap false state [] .idContext .typeContext addrOf types.newProcArgs if
        "error while creating procedure arguments" sb.wrap fileState [] .wordStart state appendError
      end
      =:: in
      LabelType .NONE ")" string.wrap fileState state readCompositeType
      prevArgs state resetStaticArgs
      if
        "error while parsing procedure return values" sb.wrap fileState [] .wordStart state appendError
      end
      #swap true state [] .idContext .typeContext addrOf types.newProcArgs if
        "error while creating procedure return values" sb.wrap fileState [] .wordStart state appendError
      end
      in #swap state [] .idContext .typeContext addrOf  types.newProcedure if
        "error while creating procedure type" sb.wrap fileState [] .wordStart state appendError
      end
      fileState [] .wordStart constType  state pushConst
      "" string.wrap true return
    end
    #dup state getStaticArg #dup optional.hasData if .data
      #dup .val #swap .argType fileState [] .wordStart newConst state pushConst
      true return
    else #drop end
    #dup state [] .currentFile state [] .idContext @ id.getIdentifier if ## read named constants
      #drop:2 false return
    end
    #dup [] .constValue ConstValue .none == if
      #drop:2 false return
    end
    #dup [] .constValue =:: mut constVal
    #dup [] .templateId -1 != #over [] .idType id.IdentifierType .TEMPLATE_ARG != & if
      state [] .idContext .templateArgBuffer .length =:: offset
      #dup [] .templateId state [] .idContext @ id.templateArgs fileState state popTemplateArguments if
        "could not get template arguments" sb.wrap fileState [] .wordStart state appendError
        offset state [] .idContext .templateArgBuffer .length = ## reset template arguments
        #drop:3 true return
      end =:: args
      constVal args 0 0 ConstantArray new fileState [] .wordStart state [] .idContext @ types.replaceGenerics constVal =
      offset state [] .idContext .templateArgBuffer .length =
    end
    constVal #over [] .valueType fileState [] .wordStart newConst  state pushConst
  #drop:2 true return
end
proc( string FilePosition ParserState ptr mut => i32 ) =: getStackModParam
  =:: state
  =:: pos
  #dup 10 tryParseInt ParseIntError .NONE != if #drop
    #dup .length 0 > if
      64 sb.create
        "parameter of stack modification is not an integer: \"" sb.appendS
        #swap  sb.appendStr
        '"'    sb.appendC
      pos state appendError
    else #drop end
    1 return
  else #swap #drop i32 cast #dup 1 < _if
    50 sb.create
      "size of stack modification has to be positive got: " sb.appendS
      #swap sb.appendI
    pos state appendError
    1
  end
  return
end
proc( string : code Token : token FileState ptr mut : fileState  ParserState ptr mut : state => string ) =: parseOperation
  code
    token fileState state tryParseConstant if
      #drop return
    end
    #dup 0 string.charAt '#' == if ## compiler command
      1 string.tail
      ':' string.split
        "dup" string.wrap #over string.eq if #drop ':' string.split #swap #drop ## ignore 2nd parameter
          1 #swap
          fileState [] .wordStart state getStackModParam ## :count
          StackModType .DUP fileState [] .wordStart opStackMod state appendOp
          return
        else "over" string.wrap #over string.eq _if #drop ':' string.split
          fileState [] .wordStart state getStackModParam #swap ':' string.split #swap #drop
          fileState [] .wordStart state getStackModParam #swap ## :offset:count
          StackModType .OVER fileState [] .wordStart opStackMod state appendOp
          return
        else "swap" string.wrap #over string.eq _if #drop ':' string.split #swap #drop
          fileState [] .wordStart state getStackModParam ## :index
          1 #swap
          StackModType .SWAP fileState [] .wordStart opStackMod state appendOp
          return
        else "rot" string.wrap #over string.eq "rotate" string.wrap #over:2 string.eq | _if #drop ':' string.split
          fileState [] .wordStart state getStackModParam #swap ':' string.split #swap #drop
          fileState [] .wordStart state getStackModParam ## :count:amount
          StackModType .ROT fileState [] .wordStart opStackMod state appendOp
          return
        else "drop" string.wrap #over string.eq _if #drop ':' string.split #swap #drop
          1 #swap
          fileState [] .wordStart state getStackModParam ## :count
          StackModType .DROP fileState [] .wordStart opStackMod state appendOp
          return
        else "include" string.wrap #over string.eq _if #drop:2
          fileState nextToken
          #dup Token .STRING == if .STRING ## local file
            state [] .basePath .length #over .length + sb.create
              state [] .basePath sb.appendStr
              #swap sb.appendStr
            fileState [] .wordStart state includeFile
            return
          else #dup Token .IDENTIFER == _if .IDENTIFER ## library file
            state [] .libPath .length #over .length + ".concat" ..length + sb.create
              state [] .libPath sb.appendStr
              #swap sb.appendStr ".concat" sb.appendS
            fileState [] .wordStart state includeFile
            return
          end
          64 sb.create
            "invalid token for include" sb.appendS
            #swap appendToken
          fileState [] .wordStart state appendError
          return
        else "namespace" string.wrap #over string.eq _if #drop
          state [] .idContext @ id.isGlobal ! if
            "#" sb.wrap
              #swap sb.appendStr
            " can only be used at global level" sb.appendS fileState [] .wordStart state appendError
          else #drop end
          fileState nextToken
          #dup Token .IDENTIFER != if #drop
            "namespace names have to be identifiers" sb.wrap fileState [] .wordStart state appendError
            return
          end .IDENTIFER
          #dup .length 0 == #over 0 string.charAt '#' == | #over '.' string.contains | if
            "\"" sb.wrap
              #swap sb.appendStr
            "\" is not a valid namespace name" sb.appendS
            fileState [] .wordStart state appendError return
          end
          state [] .idContext @ id.hasOpenTemplate if #drop
            "cannot open namespace inside template" sb.wrap fileState [] .wordStart state appendError
            return
          end
          id.FLAG_NONE fileState [] .wordStart state [] .idContext .labelContext @ id.newLabel
          state [] .idContext @ id.beginNamespace
          return
        else "using" string.wrap #over string.eq _if #drop:2
          fileState nextToken
          #dup Token .IDENTIFER != if #drop
            "namespace names have to be identifiers" sb.wrap fileState [] .wordStart state appendError
            return
          end .IDENTIFER
          #dup id.FLAG_NONE fileState [] .wordStart state [] .idContext .labelContext @ id.newLabel
          state [] .idContext @ id.importNamespace if
            "namespace \"" sb.wrap
              #swap sb.appendStr
            "\" does not exist" sb.appendS fileState [] .wordStart state appendError
          else #drop end
          return
        else "end" string.wrap #over string.eq _if #drop
          state [] .idContext @ id.isGlobal ! if
            "#" sb.wrap
