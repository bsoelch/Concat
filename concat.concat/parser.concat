      return
    else #dup "<=" string.wrap string.eq _if #drop
      BinaryOperator .LE fileState [] .wordStart opBinOp state appendOp
      return
    else #dup ">=" string.wrap string.eq _if #drop
      BinaryOperator .GE fileState [] .wordStart opBinOp state appendOp
      return
    else #dup ">" string.wrap string.eq _if #drop
