#include stringIO
#include io
#include stringBuilder
#include string
#include list
#include arrayView

#include "lib.concat"
#include "files.concat"
#include "identifers.concat"
#include "types.concat"

entryPoint:
  "./test.concat" io.OPEN_READ io.fopen #drop =:: f
  128 sb.create
    '\n' sb.appendC
    f sb.appendFile #drop
    '\n' sb.appendC
  sb.toStr parseTokens ##printTokens
end

enum( i64 : int id.StringConstant : str i8 : chr types.Type : typeId ) =:: ConstValue
struct( ConstValue : val FilePosition : pos ) =:: Constant

proc( i64 FilePosition => Constant ) =: constInt
  #swap ConstValue .int new #swap Constant new return
end
proc( id.StringConstant FilePosition => Constant ) =: constStr
  #swap ConstValue .str new #swap Constant new return
end
proc( i8 FilePosition => Constant ) =: constChar
  #swap ConstValue .chr new #swap Constant new return
end
proc( types.Type FilePosition => Constant ) =: constType
  #swap ConstValue .typeId new #swap Constant new return
end

enum( NOP ConstValue : Constant string : Error  string : Unknown ) =:: OpValue
struct( OpValue : val FilePosition : pos ) =:: Operation
proc( FilePosition => Operation ) =: opNOP
  OpValue .NOP #swap Operation new return
end
proc( Constant  => Operation ) =: opConst
  #dup .val OpValue .Constant new #swap .pos Operation new return
end
proc( string FilePosition  => Operation ) =: opError
  #swap OpValue .Error new #swap Operation new return
end
proc( string FilePosition  => Operation ) =: opUnknown
  #swap OpValue .Unknown new #swap Operation new return
end
struct(
    types.TypeContext : mut typeContext
      id.LabelContext : mut labelContext
        Constant list : mut constants
                  i64 : mut constOffset
      types.Type list : mut typeBuffer
       Operation list : mut ops
) =:: ParserState
proc( Operation ParserState ptr => ) =: printOp
  =:: context
  64 sb.create
    #over .val switch
      NOP case break
      OpValue .Constant case
        "Constant: " sb.appendS
        #over .val .Constant #swap ## XXX sb.appendConstValue
          #over switch
            int case
              "integer "  sb.appendS
              #over .int sb.appendI
              break
            str case
              "string \""  sb.appendS
              #over .str context [] .labelContext addrOf id.scAsStr  sb.appendStr
                     '\"'  sb.appendC
              break
            chr case
              "char \'"  sb.appendS
              #over .chr sb.appendC
                   '\''  sb.appendC
              break
            typeId case
              "type \'"     sb.appendS
              #over .typeId context [] .typeContext addrOf sb.appendType
                   '\''     sb.appendC
              break
          end
        #swap #drop
        break
      Error case
        "Error: " sb.appendS
        #over .val .Error sb.appendStr
        break
      Unknown case
        "Unknown Operation: " sb.appendS
        #over .val .Unknown sb.appendStr
        break
      default
    end
    " at " sb.appendS
    #over .pos .fileName sb.appendStr
    ':' sb.appendC
    #over .pos .line sb.appendI
    ':' sb.appendC
    #over .pos .posInLine sb.appendI
    '\n' sb.appendC
    #swap #drop
  io.stdOut #swap io.fputSb #drop
end


proc( Operation : op ParserState ptr mut : state bool : pushConstants => ) =: appendOpInternal
  state [] .ops
    pushConstants if
      0 while #dup state [] .constants .length < do
        #swap
          state [] .constants #over:2 list.get opConst list.append
        #swap
        1 +
      end #drop
      state [] .constants list.reset state [] .constants =
    end
    op list.append
  state [] .ops  =
end
proc( Operation ParserState ptr mut => ) =: appendOp
  true appendOpInternal
end
proc( Operation ParserState ptr mut => ) =: appendError
  false appendOpInternal
end
proc( Constant : const ParserState ptr mut : state => ) =: pushConst
  state [] .constants const list.append state [] .constants  =
end
## TODO get array size
proc( FileState ptr mut : fileState ParserState ptr mut : state => types.Type bool ) =: popTypeConstant
  state [] .constants .length state [] .constOffset <= if ## XXX more descriptive messages
    "missing type constant" string.wrap fileState [] .wordStart opError state appendError
     types.primitiveType.UNDEFINED true return
  end
  state [] .constants list.peek .val ConstValue .typeId != if
    "wrong type for constant expected type" string.wrap state [] .constants list.peek .pos opError state appendError
    types.primitiveType.UNDEFINED true return
  end
  state [] .constants list.pop #swap state [] .constants =
    .val .typeId false return
end
proc( i64 : n FileState ptr mut : fileState ParserState ptr mut : state => types.Type arrayView bool ) =: popTypeConstants
  state [] .constants .length state [] .constOffset n + < if
    "missing type constant" string.wrap fileState [] .wordStart opError state appendError
     types.Type array.empty true return
  end
  state [] .typeBuffer list.reset state [] .typeBuffer =
  state [] .constants .length n -
    #dup while #dup state [] .constants .length < do
      state [] .constants #over list.get .val ConstValue .typeId != if #drop:2
        "wrong type for constant, expected type" string.wrap state [] .constants list.peek .pos opError state appendError
         types.Type array.empty true return
      end
      state [] .typeBuffer state [] .constants #over:2 list.get .val .typeId list.append state [] .typeBuffer =
      1 +
    end #drop
  state [] .constants .length =
  state [] .typeBuffer list.asArray false return
end
proc( ParserState ptr mut : state => i64 ) =: offsetConstants
  state [] .constOffset =:: prev
    state [] .constants .length state [] .constOffset =
  prev return
end
proc( i64 ParserState ptr mut => ) =: resetConstants
  [] .constOffset =
end

proc( string : code string : start FileState ptr mut : fileState  ParserState ptr mut : state => string id.LabelId ) =: readLabel
  0 id.LabelFlag =: mut flags
  false =:: mut isModifer
  code start
    while
      false isModifer =
      #dup "mut" string.wrap string.eq if
        id.FLAG_MUTABLE flags | flags =
        true isModifer =
      else #dup "static" string.wrap string.eq _if
        id.FLAG_STATIC flags | flags =
        true isModifer =
      else #dup "extern" string.wrap string.eq _if
        id.FLAG_EXTERN flags | flags =
        true isModifer =
      else #dup "public" string.wrap string.eq _if
        id.FLAG_PUBLIC flags | flags =
        true isModifer =
      else #dup "private" string.wrap string.eq _if
        id.FLAG_PRIVATE flags | flags =
        true isModifer =
      end
      isModifer ! if
        break
      end 
    isModifer do #drop
      fileState nextToken 
      #dup Token .IDENTIFER != if #drop
        "expected identifier" string.wrap state [] .constants list.peek .pos opError state appendError
        "" string.wrap
      else
        .IDENTIFER
      end
    end
  flags fileState [] .wordStart state [] .labelContext addrOf id.newLabel return
end
enum( NONE STRUCT ENUM PROC_IN ) =:: LabelType
proc( string : code LabelType : labelType string : endString FileState ptr mut : fileState  ParserState ptr mut : state => string id.LabelId types.Type arrayView bool ) =: readCompositeType
  state offsetConstants =:: constOffset
  labelType LabelType .NONE == if
    id.LABEL_ID_NONE
  else
    state [] .labelContext addrOf id.labelOffset
  end =:: labelOffset
  code
    while fileState nextToken
      fileState state tryParseConstant if #drop continue end
      #dup endString string.eq if #drop
        ## TODO check if labels balanced
        constOffset state resetConstants
        labelOffset state [] .constants .length constOffset - fileState state popTypeConstants return
      else #dup ":" string.wrap string.eq _if #drop
        labelType LabelType .NONE == if
          "unexpected ':' operator" string.wrap fileState [] .wordStart opError  state appendError
        end
        state [] .constants .length constOffset - 1 -
        state [] .labelContext addrOf id.labelOffset labelOffset - - #dup 0 > if
          "two many types for label" string.wrap fileState [] .wordStart opError  state appendError
          while #dup 0 > do
            "" string.wrap id.FLAG_EMPTY fileState [] .wordStart state [] .labelContext addrOf id.newLabel #drop
            1 -
          end
        else #dup 0 < _if
          "not enough types for label" string.wrap fileState [] .wordStart opError  state appendError
          while #dup 0 < do
            types.primitiveType.UNDEFINED fileState [] .wordStart constType  state pushConst
            1 +
          end
        end #drop
        fileState nextToken
        #dup Token .IDENTIFER != if
          "expected identifier" string.wrap fileState [] .wordStart opError  state appendError
        end
        .IDENTIFER
        fileState state readLabel #drop
        continue
      end
      labelType LabelType .ENUM != if
        64 sb.create
          "unknown type name " sb.appendS
          #over sb.appendStr
        sb.toStr fileState [] .wordStart opError  state appendError
        #drop
        types.primitiveType.UNDEFINED fileState [] .wordStart constType  state pushConst
        continue
      end
        state [] .constants .length constOffset -
        state [] .labelContext addrOf id.labelOffset labelOffset - - #dup 0 > if
          "unexpected label in enum, expected ':' " string.wrap fileState [] .wordStart opError  state appendError
          while #dup 1 > do
            "" string.wrap id.FLAG_EMPTY fileState [] .wordStart state [] .labelContext addrOf id.newLabel #drop
            1 -
          end #drop
          fileState state readLabel #drop
          continue
        else #dup 0 < _if
          "not enough types for label" string.wrap fileState [] .wordStart opError  state appendError
          while #dup 0 < do
            types.primitiveType.UNDEFINED fileState [] .wordStart constType  state pushConst
            1 +
          end
        end #drop
      id.FLAG_NONE fileState [] .wordStart state [] .labelContext addrOf id.newLabel #drop
      types.primitiveType.UNDEFINED fileState [] .wordStart constType  state pushConst
      #dup .length 0 >
    do end
  "unexpected end of file" string.wrap fileState [] .wordStart opError  state appendError
  id.LABEL_ID_NONE types.Type array.empty true return
end
proc( string : code Token : token FileState ptr mut : fileState  ParserState ptr mut : state => string string bool ) =: tryParseConstant
  code
    token switch
      EMPTY case
        "" string.wrap true return
      STRING case ## TODO escape sequences
        token .STRING state [] .labelContext addrOf id.newStringConstant fileState [] .wordStart constStr  state pushConst
        "" string.wrap true return
      CHAR case
        token .CHAR
          state [] .labelContext addrOf id.newStringConstant ## escape character
          #dup .length 1 != if
            "A character literal has to contain exactly one character" string.wrap fileState [] .wordStart opError  state appendError
          end
          state [] .labelContext addrOf id.scAsStr
          0 string.charAt
        fileState [] .wordStart constChar state pushConst
        "" string.wrap true return
      INTEGER case
        token .INTEGER fileState [] .wordStart constInt  state pushConst
        "" string.wrap true return
      ERROR case
        token .ERROR fileState [] .wordStart opError  state appendError
        "" string.wrap true return
      IDENTIFER case
        token .IDENTIFER
        break
    end
    #dup "bool" string.wrap string.eq if
      types.primitiveType.BOOL fileState [] .wordStart constType  state pushConst
      true return
    else #dup "i8" string.wrap string.eq _if
      types.primitiveType.I8 fileState [] .wordStart constType  state pushConst
      true return
    else #dup "i32" string.wrap string.eq _if
      types.primitiveType.I32 fileState [] .wordStart constType  state pushConst
      true return
    else #dup "i64" string.wrap string.eq _if
      types.primitiveType.I64 fileState [] .wordStart constType  state pushConst
      true return
    else #dup "float" string.wrap string.eq _if
      types.primitiveType.FLOAT fileState [] .wordStart constType  state pushConst
      true return
    else #dup "type" string.wrap string.eq _if
      types.primitiveType.TYPE fileState [] .wordStart constType  state pushConst
      true return
    else #dup "ptr" string.wrap string.eq _if
      ## XXX get size
      fileState state popTypeConstant if #drop
        types.primitiveType.UNDEFINED fileState [] .wordStart constType  state pushConst
        true return
      end
      true types.ArraySize array.empty true false state [] .typeContext addrOf types.newArrayType if #drop
        "could not create array type" string.wrap fileState [] .wordStart opError  state appendError true return
      end
        fileState [] .wordStart constType  state pushConst
      true return
    else #dup "array" string.wrap string.eq _if
      ## XXX get size
      fileState state popTypeConstant if #drop
        types.primitiveType.UNDEFINED fileState [] .wordStart constType  state pushConst
        true return
      end
      false types.ArraySize array.empty true false state [] .typeContext addrOf types.newArrayType if #drop
        "could not create array type" string.wrap fileState [] .wordStart opError  state appendError true return
      end
        fileState [] .wordStart constType  state pushConst
      true return
    else #dup "mut" string.wrap string.eq _if
      fileState state popTypeConstant if #drop
        types.primitiveType.UNDEFINED fileState [] .wordStart constType  state pushConst
        true return
      end
      ## TODO make type mutable
      fileState [] .wordStart constType  state pushConst
      true return
    else #dup "(" string.wrap string.eq  #over "tuple(" string.wrap string.eq | #over "struct(" string.wrap string.eq | _if
      "struct(" string.wrap string.eq if
        LabelType .STRUCT ")" string.wrap fileState state readCompositeType
      else
        LabelType .NONE ")" string.wrap fileState state readCompositeType
      end
      if
        "error while parsing tuple type" string.wrap fileState [] .wordStart opError  state appendError
      end
      #swap state [] .typeContext addrOf types.newTuple if
        "error while creating tuple type" string.wrap fileState [] .wordStart opError  state appendError
      end
      fileState [] .wordStart constType  state pushConst
      "" string.wrap true return
    else #dup "enum(" string.wrap string.eq _if #drop
      LabelType .ENUM ")" string.wrap fileState state readCompositeType
      if
        "error while parsing enum type" string.wrap fileState [] .wordStart opError  state appendError
      end
      #swap false state [] .typeContext addrOf types.newEnum if
        "error while creating enum type" string.wrap fileState [] .wordStart opError  state appendError
      end
      fileState [] .wordStart constType  state pushConst
      "" string.wrap true return
    else #dup "proc(" string.wrap string.eq _if #drop
      LabelType .PROC_IN "=>" string.wrap fileState state readCompositeType
      if
        "error while parsing procedure arguments" string.wrap fileState [] .wordStart opError  state appendError
      end
      #swap false state [] .typeContext addrOf types.newProcArgs if
        "error while creating procedure arguments" string.wrap fileState [] .wordStart opError  state appendError
      end
      =:: in
      LabelType .NONE ")" string.wrap fileState state readCompositeType
      if
        "error while parsing procedure return values" string.wrap fileState [] .wordStart opError  state appendError
      end
      #swap true state [] .typeContext addrOf types.newProcArgs if
        "error while creating procedure return values" string.wrap fileState [] .wordStart opError  state appendError
      end
      in #swap state [] .typeContext addrOf  types.newProcedure if
        "error while creating procedure type" string.wrap fileState [] .wordStart opError  state appendError
      end
      fileState [] .wordStart constType  state pushConst
      "" string.wrap true return
    end
  false return
end
proc( string : code Token : token FileState ptr mut : fileState  ParserState ptr mut : state => string ) =: parseOperation
  code
    token fileState state tryParseConstant if
      #drop return
    end
    #dup 0 string.charAt '#' == if ## compiler command
      1 string.tail
        "include" string.wrap #over string.eq if #drop
          fileState nextToken
          #dup Token .STRING == if .STRING
            ## TODO include local file
            #drop
            return
          else #dup Token .IDENTIFER == _if .IDENTIFER
            ## TODO include library file
            #drop
            return
          end
          64 sb.create
            "invalid token for include" sb.appendS
            #swap appendToken
          sb.toStr fileState [] .wordStart opError  state appendError
          return
        end
      64 sb.create
        "unknown compiler command \"" sb.appendS
        #swap                         sb.appendStr
        '\"'                          sb.appendC
      sb.toStr fileState [] .wordStart opError  state appendError
      return
    else #dup ":" string.wrap string.eq _if
      
    else #dup "=:" string.wrap string.eq _if
    
    else #dup "=::" string.wrap string.eq _if
    
    end
    ## TODO try parsing identifier
  fileState [] .wordStart opUnknown  state appendOp
  return
end
proc( string => ) =: parseTokens
  "test" #dup .length string.create 0 1 FilePosition new #dup FileState new =:: mut fileState
  ## ParserState
    types.newTypeContext
    id.newLabelContext
    128 Constant   list.create 0
    128 types.Type list.create
    128 Operation  list.create
  ParserState new =:: mut state
  fileState addrOf #swap
    while
      #over nextToken #over:2 state addrOf parseOperation
      #dup .length 0 >
    do end #drop
  #drop
  0 while #dup state .ops .length < do
    state .ops #over list.get state addrOf printOp
    1 +
  end #drop
end
