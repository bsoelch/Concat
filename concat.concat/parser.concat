struct( Type : valueType ConstValue : val IdentifierInfo optional : idInfo FilePosition : pos ) =:: Constant
struct( Type : argType ConstValue : val LabelId : labelId ) =:: StaticArgument
struct( i64 : codeOffset i64 : constOffset ) =:: CompositeConstantOffset
struct( InterpreterContext : mut context i64 : mut offset ) =:: InterpreterInfo

struct(
  string : mut basePath
  string : mut libPath
  ProgramContext ptr mut : progContext
  Operation list : mut globalOpBuffer
  Constant list : mut constants
  i64 : mut constOffset
  Type list : mut typeBuffer
  StaticArgument list : mut staticArgs
  i64 : mut staticArgsOffset
  FileId : mut currentFile
  ProcedureInfo optional : mut currentProc
  CompositeConstantOffset list : mut constantBlocks
  InterpreterInfo list : mut globalInterpreters
  LabelId list : mut labelBuffer
) =:: ParserState

proc( FilePosition : pos => Constant ) =: newWildcardConst
  Type .undefined ConstValue .wildCard new IdentifierInfo optional.empty pos Constant new return
end
proc( bool FilePosition => Constant ) =: newBoolConstant
  =:: pos
  types.primitive.BOOL #swap ConstValue .boolean new IdentifierInfo optional.empty pos Constant new return
end
proc( i64 : value bool : unsigned i32 : preferedSize FilePosition : pos ParserState ptr mut : state => bool ) =: checkIntSize
  preferedSize 0 <= if
    false return
  end
  preferedSize types.MAX_INT_WIDTH >= if
    false return
  end
  unsigned if
    value 0 < if
      true return
    end
    preferedSize types.MAX_INT_WIDTH 1 - == if
      false return ## positive number fits in unsigned number of one smaller size
    end
  else
    value 1 i64 cast preferedSize << -_ < if
      true return
    end
  end
  value 1 i64 cast unsigned if preferedSize 1 + else preferedSize end << >= return
end
proc( i64 : value bool : unsigned i32 : preferedSize FilePosition : pos ParserState ptr mut : state => Constant ) =: newIntConstant
   ## TODO? sign extend unsigned constants of smaller types
  preferedSize 0 <= if
   unsigned if
     value 0 < value u32.MAX > | if types.primitive.I64 else types.primitive.I32 end
   else
     value i32.MIN < value i32.MAX > | if types.primitive.I64 else types.primitive.I32 end
   end
  else preferedSize 8 <= _if types.primitive.I8
  else preferedSize 16 <= _if types.primitive.I16
  else preferedSize 32 <= _if types.primitive.I32
  else types.primitive.I64 end
  value unsigned preferedSize pos state checkIntSize if
    "integer value overflows given size: " sb.wrap
      value unsigned if sb.appendU else sb.appendI end
      unsigned if 'u' else 'i' end sb.appendC
      preferedSize sb.appendU
    pos state appendWarning2
  end
  value ConstValue .int new IdentifierInfo optional.empty pos Constant new return
end
proc( i8 FilePosition => Constant ) =: newCharConstant
  =:: pos
  types.primitive.I8 #swap ConstValue .chr new IdentifierInfo optional.empty pos Constant new return
end
proc( StringConstant : str FilePosition : pos TypeContext ptr mut : context => Constant ) =: newStringConstant
  #using types
  str .length ArraySizeType .int ArraySize new =:: size
  types.primitive.I8 true size @ 1 array.create true false context newArrayType #drop str ConstValue .str new IdentifierInfo optional.empty pos Constant new return
end
proc( Type FilePosition => Constant ) =: newTypeConst
  =:: pos
  types.primitive.TYPE #swap ConstValue .typeId new IdentifierInfo optional.empty pos Constant new return
end

proc( Type i32 FilePosition => Constant ) =: newEnumLabelConstant
  =:: pos
  ConstValue .enumLabel new IdentifierInfo optional.empty pos Constant new return
end
proc( double FilePosition => Constant ) =: newFloatConst
  =:: pos
  types.primitive.FLOAT64 #swap ConstValue .Float new IdentifierInfo optional.empty pos Constant new return
end

proc( Constant : const => Operation ) =: constantToOp
  const .val const .valueType const .pos opConst return
end

proc( ParserState ptr mut : state => i64 ) =: opCount
  state [] .progContext =:: progContext
  progContext [] .idContext .currentTemplate id.TEMPLATE_ID_NONE != if
    progContext [] .templateOps .length return
  end
  progContext [] .idContext @ id.isGlobal if
    progContext [] .progFiles state [] .currentFile list.at .data [] .globalOps .length return
  end
  _EXPERIMENTAL_ if
    progContext [] .templateOps .length return
  end
  progContext [] .progFiles state [] .currentFile list.at .data [] .localOps .length return
end
proc( Operation : op ParserState ptr mut : state => ) =: appendOp
  state [] .progContext =:: progContext
  progContext [] .idContext .currentTemplate id.TEMPLATE_ID_NONE != if
    progContext [] .templateOps @
  else progContext [] .idContext @ id.isGlobal _if
    _EXPERIMENTAL_ if
      state [] .globalOpBuffer @
    else
      progContext [] .progFiles state [] .currentFile list.at .data [] .globalOps @
    end
  else
    _EXPERIMENTAL_ if
      progContext [] .templateOps @
    else
      progContext [] .progFiles state [] .currentFile list.at .data [] .localOps @
    end
  end
  #dup []
    0 while #dup state [] .constants .length < do
      #swap
        state [] .constants #over:2 list.get constantToOp list.append
      #swap
      1 +
    end #drop
    state [] .constants list.clear state [] .constants =
    op list.append
  #swap [] =
end
proc( stringBuilder : msg FilePosition : pos ParserState ptr mut : state => ) =: appendError2
  msg pos state [] .progContext [] .errors @ appendError
end
proc( stringBuilder : msg FilePosition : pos ParserState ptr mut : state => ) =: appendWarning2
  msg pos state [] .progContext [] .errors @ appendWarning
end

proc( ParserState ptr mut : state => ) =: skipGlobalInterpreter
  state [] .progContext [] .progFiles state [] .currentFile list.at .data [] .globalOps @ =:: ops
  state [] .currentProc optional.hasData if
    return ## don't skip if inside procedure
  end
  state [] .constantBlocks .length 0 > if
    return ## don't skip if inside constant block
  end
  ops []
    state [] .globalOpBuffer list.appendAll
  ops [] =
  state [] .globalOpBuffer
    list.clear
  state [] .globalOpBuffer =
end
proc( Operation ptr optional : next? ParserState ptr mut : state => ) =: resetGlobalInterpreter
  state [] .progContext =:: progContext
  state [] .globalInterpreters state [] .currentFile list.at .data =:: interpreter
  progContext [] .progFiles state [] .currentFile list.at .data [] .globalOps @ =:: ops
  ##  -> store computed constants
  0 while #dup interpreter [] .context .stack .length < do
    interpreter [] .context .stack #over list.at .data =:: constant
    interpreter [] .context .stackInfo #over list.at .data =:: constInfo
    ops []
      constant [] constInfo [] .valueType constInfo [] .pushedAt opConst list.append
    ops [] =
    1 +
  end #drop
  ## -> store current operation
  next? optional.hasData if
    ops []
      next? .data list.appendP
    ops [] =
  end
  ##  -> reset interpreter
  interpreter [] .context @ resetContext
end
proc( ParserState ptr mut : state => ) =: tryInterpretGlobal
  state [] .progContext =:: progContext
  state [] .currentProc optional.hasData if
    return ## don't interpret inside procedure
  end
  state [] .constantBlocks .length 0 > if
    return ## don't interpret inside constant blocks
  end
  state [] .globalInterpreters state [] .currentFile list.at .data =:: interpreter
  interpreter [] .offset =:: offset
  offset while #dup state [] .globalOpBuffer .length < do
    state [] .globalOpBuffer #over list.at .data =:: op
    op interpreter [] .context @ false evaluateOperation if
      ## interpreter failed
      op Operation ptr cast optional.wrap state resetGlobalInterpreter
    end
    1 +
  end #drop
  state [] .globalOpBuffer
    list.clear
  state [] .globalOpBuffer =
end
proc( ParserState ptr mut : state => Operation ptr mut optional ) =: peekOp
  state [] .progContext =:: progContext
  progContext [] .idContext .currentTemplate id.TEMPLATE_ID_NONE != if
    progContext [] .templateOps
  else progContext [] .idContext @ id.isGlobal _if
    _EXPERIMENTAL_ if
      state [] .globalOpBuffer
    else
      progContext [] .progFiles state [] .currentFile list.at .data [] .globalOps
    end
  else
    _EXPERIMENTAL_ if
      progContext [] .templateOps
    else
      progContext [] .progFiles state [] .currentFile list.at .data [] .localOps
    end
  end list.peek
end

proc( Constant : const ParserState ptr mut : state => ) =: pushConst
  _EXPERIMENTAL_ if
    ## inline when code is no longer experimental
    const constantToOp state appendOp
    return
  end
  state [] .constants const list.append state [] .constants  =
end

proc( ParserState ptr mut : state => bool ) =: hasConst
  state [] .constants .length 0 > return
end
proc( ParserState ptr mut : state => Constant ) =: popConst
  state [] .constants
    list.pop #swap state [] .constants =
  return
end
proc( ParserState ptr mut : state => Constant ptr mut optional ) =: peekConst
  state [] .constants list.peek return
end
proc( ParserState ptr mut : state => ConstValue ValueInfo ) =: popConst2
  state [] .globalInterpreters state [] .currentFile list.at .data [] .context @ =:: interpreter
  interpreter [] .stack
    list.pop =:: value
  interpreter [] .stack =
  interpreter [] .stackInfo
    list.pop =:: info
  interpreter [] .stackInfo =
  value info return
end
proc( ParserState ptr mut : state => bool ) =: hasConst2
  state [] .currentProc optional.hasData if
    false return ## constants only exists at global level
  end
  state [] .globalInterpreters state [] .currentFile list.at .data [] .context @ =:: interpreter
  interpreter [] .stack .length 0 > return
end
proc( ParserState ptr mut : state => ConstValue ptr mut optional ValueInfo ptr mut optional ) =: peekConst2
  state [] .globalInterpreters state [] .currentFile list.at .data [] .context @ =:: interpreter
  interpreter [] .stack list.peek interpreter [] .stackInfo list.peek return
end

proc( FileState ptr mut : fileState ParserState ptr mut : state => Type bool ) =: peekTypeConstant
  _EXPERIMENTAL_ if
    state peekConst2 =:: info? =:: value?
    value? optional.isEmpty if
      "missing type constant" sb.wrap fileState [] .wordStart state appendError2
      Type .undefined true return
    end
    value? .data [] ConstValue .typeId != if
      "wrong type for constant expected type" sb.wrap info? .data [] .pushedAt state appendError2
      Type .undefined true return
    end
    value? .data [] .typeId false return
  end
  state peekConst =:: typeConst?
  typeConst? optional.isEmpty if
    "missing type constant" sb.wrap fileState [] .wordStart state appendError2
    Type .undefined true return
  end
  typeConst? .data [] .val ConstValue .typeId != if
    "wrong type for constant expected type" sb.wrap typeConst? .data [] .pos state appendError2
    Type .undefined true return
  end
  typeConst? .data [] .val .typeId false return
end
proc( FileState ptr mut : fileState ParserState ptr mut : state => Type bool ) =: popTypeConstant
  _EXPERIMENTAL_ if
    state peekConst2 =:: info? =:: value?
    value? optional.isEmpty if
      "missing type constant" sb.wrap fileState [] .wordStart state appendError2
      Type .undefined true return
    end
    value? .data [] ConstValue .typeId != if
      "wrong type for constant expected type" sb.wrap info? .data [] .pushedAt state appendError2
      Type .undefined true return
    end
    state popConst2 #drop .typeId false return
  end
  state peekConst =:: typeConst?
  typeConst? optional.isEmpty if
    "missing type constant" sb.wrap fileState [] .wordStart state appendError2
    Type .undefined true return
  end
  typeConst? .data [] .val ConstValue .typeId != if
    "wrong type for constant expected type" sb.wrap typeConst? .data [] .pos state appendError2
    Type .undefined true return
  end
  state popConst .val .typeId false return
end
proc( FileState ptr mut : fileState ParserState ptr mut : state => types.ArraySize arrayView bool #+fixed-size+# ) =: popArraySize
  state [] .progContext [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .labelContext @ =:: labelContext
  idContext [] .typeContext @ =:: typeContext
  state [] .constants .length state [] .constOffset <= if
    types.ArraySize array.empty true return
  end
  state [] .constants list.peek .data [] .val ConstValue .wildCard == if
    state [] .constants list.pop #drop state [] .constants = ## remove wildcard constant
    types.ArraySize array.empty false return
  end
  state [] .constants .length 1 - while #dup state [] .constOffset >= do
    state [] .constants #over list.get .valueType typeContext types.isInt ! if
      break
    end
    1 -
  end 1 + =:: sizesOffset ##revert last decrement
  idContext [] .arraySizeBuffer
    list.clear
    sizesOffset state [] .constOffset - list.ensureCap
    sizesOffset while #dup state [] .constants .length < do
      #swap
        state [] .constants #over:2 list.at .data =:: constant
        constant []  .val =:: constVal
          constVal ConstValue .int == if
            constVal .int types.ArraySizeType .int types.ArraySize new list.append
          else constVal ConstValue .genericArg == _if
            constVal .genericArg types.ArraySizeType .staticArg types.ArraySize new list.append
          else constVal ConstValue .templateArg == _if
            constVal .templateArg types.ArraySizeType .templateArg types.ArraySize new list.append
          else
            "unexpected constant for array size: " sb.wrap
              constVal constContext labelContext typeContext sb.appendConstant
            constant [] .pos state appendError2
          end
      #swap
      1 +
    end #drop
  idContext [] .arraySizeBuffer =
  state [] .constants
    sizesOffset list.setLength
  state [] .constants =
  idContext [] .arraySizeBuffer list.asArray true return
end
proc( i64 : n FileState ptr mut : fileState ParserState ptr mut : state => Type arrayView bool ) =: popTypeConstants
  state [] .constants .length state [] .constOffset n + < if
    "missing type constant" sb.wrap fileState [] .wordStart state appendError2
     Type array.empty true return
  end
  state [] .typeBuffer list.clear state [] .typeBuffer =
  state [] .constants .length n - =:: newLength
  newLength while #dup state [] .constants .length < do
    state [] .constants #over list.at .data =:: constant
    constant [] .val =:: constVal
    constVal ConstValue .typeId != if #drop
      "wrong type for constant, expected type" sb.wrap state [] .constants list.peek .data [] .pos state appendError2
       Type array.empty true return
    end
    state [] .typeBuffer constVal .typeId list.append state [] .typeBuffer =
    1 +
  end #drop
  state [] .constants
    newLength list.setLength
  state [] .constants =
  state [] .typeBuffer list.asArray false return
end
proc( Type : argTypes FileState ptr mut : fileState ParserState ptr mut : state => ConstantArray bool ) =: popTemplateArguments
  state [] .progContext [] .idContext @ =:: idContext
  argTypes idContext [] .typeContext @ types.compositeEltCount =:: count
  count state [] .constants .length > if
    "not enough arguments for template" sb.wrap fileState [] .wordStart state appendError2
     0 0 ConstantArray new true return
  end
  idContext [] .templateArgBuffer .length =:: offset
  state [] .constants
    #dup .length count - list.setLength
  state [] .constants =
  0 while #dup count < do
    state [] .constants .data #over state [] .constants .length + []
      #dup .valueType argTypes #over:3 idContext [] .typeContext @ types.compositeGetElement types.typeEquals ! if
        "incompatible type for template argument" sb.wrap fileState [] .wordStart state appendError2 ## XXX print types in error message
        #drop:2 0 0 ConstantArray new true return
      end
    idContext [] .templateArgBuffer
      #swap .val list.append
    idContext [] .templateArgBuffer =
    1 +
  end #drop
  offset idContext [] .templateArgBuffer .length offset - ConstantArray new false return
end
proc( i64 : len FileState ptr mut : fileState ParserState ptr mut : state => Type arrayView ConstValue arrayView Type ) =: popConstantArray
  state [] .progContext [] .idContext @ =:: idContext
  state [] .constants .length state [] .constOffset len + < if ## XXX compare size with expected size
    "no enough constants for array" sb.wrap fileState [] .wordStart state appendError2
     Type array.empty ConstValue array.empty Type .undefined return
  end
  Type .undefined =:: mut arrayType
  true =:: mut hasArrayType
  state [] .typeBuffer list.clear state [] .typeBuffer =
  idContext [] .templateArgBuffer .length =:: offset
  state [] .constants .length len - =:: newLength
  newLength while #dup state [] .constants .length < do
    state [] .constants #over list.at .data =:: const
    idContext [] .templateArgBuffer
      const [] .val list.append
    idContext [] .templateArgBuffer =
    state [] .typeBuffer const [] .valueType list.append state [] .typeBuffer =
    hasArrayType if
      arrayType Type .undefined types.typeEquals if
       const [] .valueType arrayType =
      else arrayType const [] .valueType types.typeEquals ! _if
        false hasArrayType =
      end
    end
    1 +
  end #drop
  state [] .constants
    newLength list.setLength
  state [] .constants =
  idContext [] .templateArgBuffer
    offset list.setLength
  idContext [] .templateArgBuffer =
  ## return
    state [] .typeBuffer list.asArray
    idContext [] .templateArgBuffer .data offset + len array.create
    hasArrayType if arrayType else Type .undefined end
  return
end
proc( LabelId : label Type : valType i64 : index ParserState ptr mut : state => ) =: newStaticArg
  state [] .staticArgs
    valType
      #dup types.primitive.TYPE types.typeEquals if
        index i32 cast types.newGenericType ConstValue .typeId new
      else
        index i32 cast ConstValue .genericArg new
      end
    label
    StaticArgument new
  list.append state [] .staticArgs =
end
proc( string : name ParserState ptr mut : state => StaticArgument optional ) =: getStaticArg
  0 while #dup state [] .staticArgs .length < do
    state [] .staticArgs #over list.get
      #dup .labelId state [] .progContext [] .idContext .labelContext @ id.labelName #dup optional.hasData if .data name string.eq else #drop false end if
        #swap #drop optional.wrap return
      end
    #drop
    1 +
  end #drop
  StaticArgument optional.empty return
end

proc( ParserState ptr mut : state => i64 ) =: offsetConstants
  state [] .constOffset
    state [] .constants .length state [] .constOffset =
  return
end
proc( i64 ParserState ptr mut => ) =: resetConstants
  [] .constOffset =
end
proc( ParserState ptr mut : state => i64 ) =: offsetStaticArgs
  state [] .staticArgsOffset
    state [] .staticArgs .length state [] .staticArgsOffset =
  return
end
proc( i64 : length ParserState ptr mut : state =>  ) =: resetStaticArgs
  length state [] .staticArgsOffset =
  state [] .staticArgs
    length list.setLength
  state [] .staticArgs =
end

proc( string : code FileState ptr mut : fileState  ParserState ptr mut : state => string string ) =: nextWord
  code
    fileState nextToken
    #dup Token .IDENTIFIER != if
      "expected identifier" sb.wrap fileState [] .wordStart state appendError2
    end
    .IDENTIFIER
  return
end
proc( string : code string : start FileState ptr mut : fileState  ParserState ptr mut : state LabelFlag : initFlags => string LabelId ) =: readLabelAddFlags
  0 LabelFlag =: mut flags
  false =:: mut isModifier
  code start
    while
      false isModifier =
      #dup "mut" string.wrap string.eq if
        id.FLAG_MUTABLE flags | flags =
        true isModifier =
      else #dup "auto" string.wrap string.eq _if
        id.FLAG_AUTO flags | flags =
        true isModifier =
      else #dup "static" string.wrap string.eq _if
        id.FLAG_STATIC flags | flags =
        true isModifier =
      else #dup "extern" string.wrap string.eq _if
        id.FLAG_EXTERN flags | flags =
        true isModifier =
      else #dup "public" string.wrap string.eq _if
        id.FLAG_PUBLIC flags | flags =
        true isModifier =
      else #dup "private" string.wrap string.eq _if
        id.FLAG_PRIVATE flags | flags =
        true isModifier =
      else #dup "#:experimental" string.wrap string.eq _if
        id.FLAG_EXPERIMENTAL flags | flags =
        true isModifier =
      else #dup "#:" string.wrap string.startsWith _if
        true isModifier =
      end
      isModifier ! if
        break
      end
    isModifier do #drop
      fileState nextToken
      #dup Token .IDENTIFIER != if #drop
        "expected identifier" sb.wrap state [] .constants list.peek .data [] .pos state appendError2
        "" string.wrap
      else
        .IDENTIFIER
      end
    end
  flags initFlags | fileState [] .wordStart state [] .currentFile state [] .progContext [] .idContext .labelContext @ id.newLabel return
end
proc( string : code string : start FileState ptr mut : fileState  ParserState ptr mut : state => string LabelId ) =: readLabel
  code start fileState state 0 readLabelAddFlags
end
enum( NONE TUPLE STRUCT ENUM PROC_IN TEMPLATE ) =:: LabelType
proc( string : code LabelType : labelType string : endString string : nextEnd FileState ptr mut : fileState  ParserState ptr mut : state => string Type arrayView LabelId arrayView optional LabelType bool ) =: readCompositeType
  state offsetConstants =:: prevConstants
  state [] .constants .length =:: constOffset
  state [] .labelBuffer .length =:: labelOffset
  state [] .progContext [] .idContext @ =:: idContext
  code
    while fileState nextToken
      fileState state tryParseConstant if #drop
        #dup .length 0 > if continue else break end
      end
      #dup endString string.eq  #over nextEnd string.eq labelType LabelType .NONE == &  | if
        endString string.eq =:: isEnd
        labelType LabelType .TUPLE == if
          LabelId arrayView optional.empty
        else labelType LabelType .PROC_IN == labelType LabelType .NONE == |
               state [] .labelBuffer .length labelOffset == & _if
          LabelId arrayView optional.empty ## procedure with no labels
        else
          state [] .constants .length constOffset -
          state [] .labelBuffer .length labelOffset - - #dup 0 > if
            "too many types for label" sb.wrap fileState [] .wordStart state appendError2
            while #dup 0 > do
              "" string.wrap id.FLAG_EMPTY fileState [] .wordStart state [] .currentFile idContext [] .labelContext @ id.newLabel
                state [] .labelBuffer #swap list.append
              state [] .labelBuffer =
              1 -
            end
          else #dup 0 < _if
            "not enough types for label" sb.wrap fileState [] .wordStart state appendError2
            while #dup 0 < do
              Type .undefined fileState [] .wordStart newTypeConst  state pushConst
              1 +
            end
          end #drop
          state [] .labelBuffer list.asArray labelOffset array.tail optional.wrap
        end
        prevConstants state resetConstants
        state [] .labelBuffer
          labelOffset list.setLength
        state [] .labelBuffer  =
        state [] .constants .length constOffset - fileState state popTypeConstants =:: isError
        #swap
        isEnd if labelType else LabelType .PROC_IN end
        isError
        return
      else #dup nextEnd string.eq _if #drop
        "unexpected \"" sb.wrap nextEnd sb.appendStr '"' sb.appendC fileState [] .wordStart state appendError2
        prevConstants state resetConstants
        state [] .labelBuffer
          labelOffset list.setLength
        state [] .labelBuffer  =
        Type array.empty LabelId arrayView optional.empty labelType true return
      else #dup ":" string.wrap string.eq _if #drop
        labelType LabelType .TUPLE == if
          "unexpected ':' operator" sb.wrap fileState [] .wordStart state appendError2
        end
        state [] .constants .length constOffset - 1 -
        state [] .labelBuffer .length labelOffset - - #dup 0 > if
          "too many types for label" sb.wrap fileState [] .wordStart state appendError2
          while #dup 0 > do
            "" string.wrap id.FLAG_EMPTY fileState [] .wordStart state [] .currentFile idContext [] .labelContext @ id.newLabel
              state [] .labelBuffer #swap list.append
            state [] .labelBuffer =
            1 -
          end
        else #dup 0 < _if
          "not enough types for label" sb.wrap fileState [] .wordStart state appendError2
          while #dup 0 < do
            Type .undefined fileState [] .wordStart newTypeConst  state pushConst
            1 +
          end
        end #drop
        fileState nextToken
        #dup Token .IDENTIFIER != if
          "expected identifier" sb.wrap fileState [] .wordStart state appendError2
        end
        .IDENTIFIER
        fileState
        state
        fileState state peekTypeConstant if
          "missing type for label" sb.wrap fileState [] .wordStart state appendError2
        end =:: argType
        labelType LabelType .TEMPLATE != argType types.primitive.TYPE types.typeEquals & if
          id.FLAG_STATIC else 0 LabelFlag cast
        end
        readLabelAddFlags
          state [] .labelBuffer #over list.append state [] .labelBuffer =
          #dup idContext [] .labelContext @ id.labelFlags id.FLAG_AUTO id.FLAG_STATIC |  & 0 != if
             labelType LabelType .PROC_IN != labelType LabelType .NONE != & if
               "unexpected label: `static` and `auto` can only be used in procedure arguments\n  values of type `type` are labeled `static` by default" sb.wrap fileState [] .wordStart state appendError2
             end
             argType
           state [] .constants .length constOffset - 1 - state newStaticArg
          else #drop end
        continue
      end
      labelType LabelType .ENUM != if
        64 sb.create
          "unknown type name " sb.appendS
          #over sb.appendStr
        fileState [] .wordStart state appendError2
        #drop
        Type .undefined fileState [] .wordStart newTypeConst  state pushConst
        continue
      end
        state [] .constants .length constOffset -
        state [] .labelBuffer .length labelOffset - - #dup 0 > if
          "unexpected label in enum, expected ':' " sb.wrap fileState [] .wordStart state appendError2
          while #dup 1 > do
            "" string.wrap id.FLAG_EMPTY fileState [] .wordStart state [] .currentFile idContext [] .labelContext @ id.newLabel
              state [] .labelBuffer #swap list.append
            state [] .labelBuffer =
            1 -
          end #drop
          fileState state readLabel
            state [] .labelBuffer #swap list.append
          state [] .labelBuffer =
          continue
        else #dup 0 < _if
          "not enough types for label" sb.wrap fileState [] .wordStart state appendError2
          while #dup 0 < do
            Type .undefined fileState [] .wordStart newTypeConst  state pushConst
            1 +
          end
        end #drop
      id.FLAG_NONE fileState [] .wordStart state [] .currentFile idContext [] .labelContext @ id.newLabel
        state [] .labelBuffer #swap list.append
      state [] .labelBuffer =
      Type .empty fileState [] .wordStart newTypeConst  state pushConst
      #dup .length 0 >
    do end
  "unexpected end of file" sb.wrap fileState [] .wordStart state appendError2
  Type array.empty LabelId arrayView optional.empty labelType true return
end
proc( string : str FileState ptr mut : fileState  ParserState ptr mut : state => bool ) =: tryParseNumberLiteral
  str .length 0 == if
    false return
  end
  false =:: mut unsigned
  0 =:: mut size
  str
    str .length 1 - while #dup 0 > do
      #swap
        #dup #over:2 string.charAt
          #dup 'u' == #over 'U' == | if #drop
            true unsigned =
            #over string.splitIndex #swap 10 number.tryParseInt #dup number.ParserError .EMPTY == if
              #drop:2
            else number.ParserError .NONE != _if
              #drop:3 false return
            else #dup types.MAX_INT_WIDTH > _if
              "size of integer literal (" sb.wrap
                #swap sb.appendI
                ") exceeds maximum integer size (" sb.appendS
                types.MAX_INT_WIDTH sb.appendI
                ")" sb.appendS
              fileState [] .wordStart state appendWarning2
              64 size =
            else
              i32 cast size =
            end
            #swap break
          else #dup 'i' == #over 'I' == | _if #drop
            #over string.splitIndex #swap 10 number.tryParseInt number.ParserError .NONE != if
              #drop:3 false return
            else #dup types.MAX_INT_WIDTH > _if
              "size of integer literal (" sb.wrap
                #swap sb.appendI
                ") exceeds maximum integer size (" sb.appendS
                types.MAX_INT_WIDTH sb.appendI
                ")" sb.appendS
              fileState [] .wordStart state appendWarning2
              64 size =
            else
              i32 cast size =
            end
            #swap break
          else char.isDigit ! _if ## integer literal has to end with digit or u,U,i or I followed by digits
            #swap break
          end
      #swap 1 -
    end #drop
  unsigned if
    0 number.tryParseUInt
  else
    0 number.tryParseInt
  end
    #dup number.ParserError .NONE == if #drop
      unsigned size fileState [] .wordStart state newIntConstant  state pushConst
      true return
    else #dup number.ParserError .SIGN == _if #drop:2
      "unsigned value is marked as negative: " sb.wrap
        str sb.appendStr
      fileState [] .wordStart state appendError2
      true return
    else #dup number.ParserError .OVERFLOW == _if #drop:2
      "integer value outside allowed range: " sb.wrap
        str sb.appendStr
      fileState [] .wordStart state appendError2
      true return
    end
  #drop:2
  str 0 number.tryParseFloat ## XXX? float32 constants
    #dup number.ParserError .NONE == if #drop
      fileState [] .wordStart newFloatConst state pushConst
      true return
    else #dup number.ParserError .INT == _if #drop:2
      "integer value outside allowed range: " sb.wrap
        str sb.appendStr
      fileState [] .wordStart state appendError2
      true return
    end
  #drop:2
  false return
end
proc( string : code Token : token FileState ptr mut : fileState  ParserState ptr mut : state => string string bool ) =: tryParseConstant
  state [] .progContext =:: progContext
  state [] .progContext [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  idContext [] .labelContext @ =:: labelContext
  code
    token switch
      EMPTY case
        "" string.wrap true return
      STRING case
        ## newStringConstant
          ## parseStringConstant
            token .STRING
            fileState [] .wordStart
            progContext [] .errors @
            labelContext
          id.parseStringConstant
          fileState [] .wordStart
          typeContext
        newStringConstant state pushConst
        "" string.wrap true return
      CHAR case
        token .CHAR
          fileState [] .wordStart progContext [] .errors @  labelContext id.parseStringConstant ## escape character
          #dup .length 1 != if
            "A character literal has to contain exactly one character" sb.wrap fileState [] .wordStart state appendError2
          end
          labelContext id.scAsStr
          0 string.charAt
        fileState [] .wordStart newCharConstant state pushConst
        "" string.wrap true return
      IDENTIFIER case
        token .IDENTIFIER fileState state tryParseNumberLiteral if
          "" string.wrap true return
        end
        token .IDENTIFIER
        break
    end
    #dup "_" string.wrap string.eq if
      fileState [] .wordStart newWildcardConst  state pushConst
      true return
    else #dup "true" string.wrap string.eq _if
      true fileState [] .wordStart newBoolConstant  state pushConst
      true return
    else #dup "false" string.wrap string.eq _if
      false fileState [] .wordStart newBoolConstant  state pushConst
      true return
    else #dup "bool" string.wrap string.eq _if
      types.primitive.BOOL fileState [] .wordStart newTypeConst  state pushConst
      true return
    else #dup "i8" string.wrap string.eq _if
      types.primitive.I8 fileState [] .wordStart newTypeConst  state pushConst
      true return
    else #dup "i16" string.wrap string.eq _if
      types.primitive.I16 fileState [] .wordStart newTypeConst  state pushConst
      true return
    else #dup "i32" string.wrap string.eq _if
      types.primitive.I32 fileState [] .wordStart newTypeConst  state pushConst
      true return
    else #dup "i64" string.wrap string.eq _if
      types.primitive.I64 fileState [] .wordStart newTypeConst  state pushConst
      true return
    else #dup "float" string.wrap string.eq _if
      types.primitive.FLOAT32 fileState [] .wordStart newTypeConst  state pushConst
      true return
    else #dup "double" string.wrap string.eq _if
      types.primitive.FLOAT64 fileState [] .wordStart newTypeConst  state pushConst
      true return
    else #dup "type" string.wrap string.eq _if
      types.primitive.TYPE fileState [] .wordStart newTypeConst  state pushConst
      true return
    else #dup "ptr" string.wrap string.eq _EXPERIMENTAL_ ! & _if
      fileState state popArraySize =:: fixedSize =:: sizes
      fileState state popTypeConstant if #drop
        Type .undefined fileState [] .wordStart newTypeConst  state pushConst
        true return
      end
      true sizes fixedSize false typeContext types.newArrayType if #drop
        Type .undefined fileState [] .wordStart newTypeConst  state pushConst
        "could not create pointer type" sb.wrap fileState [] .wordStart state appendError2
        true return
      end
        fileState [] .wordStart newTypeConst  state pushConst
      true return
    else #dup "array" string.wrap string.eq _EXPERIMENTAL_ ! & _if
      fileState state popArraySize =:: fixedSize =:: sizes
      fileState state popTypeConstant if #drop
        Type .undefined fileState [] .wordStart newTypeConst  state pushConst
        true return
      end
      false sizes fixedSize false typeContext types.newArrayType if #drop
        Type .undefined fileState [] .wordStart newTypeConst  state pushConst
        "could not create array type" sb.wrap fileState [] .wordStart state appendError2
        true return
      end
        fileState [] .wordStart newTypeConst  state pushConst
      true return
    else #dup "mut" string.wrap string.eq _EXPERIMENTAL_ ! & _if
      fileState state popTypeConstant if #drop
        Type .undefined fileState [] .wordStart newTypeConst  state pushConst
        true return
      end
      =:: mut t
      t typeContext types.isMutable if
        "type is already mutable" sb.wrap fileState [] .wordStart state appendError2
      end
      t @ true typeContext types.setMutability if
        "could not change mutability of type" sb.wrap fileState [] .wordStart state appendError2
      end
      t fileState [] .wordStart newTypeConst  state pushConst
      true return
    else #dup "(" string.wrap string.eq _EXPERIMENTAL_ ! & _if #drop
      state offsetStaticArgs =:: prevArgs
      LabelType .NONE ")" string.wrap "=>" string.wrap fileState state readCompositeType
      if
        "error while parsing composite type" sb.wrap fileState [] .wordStart state appendError2
      end
      LabelType .PROC_IN == =:: isProc
      isProc if
        false typeContext types.newProcArgs
        =:: in
        LabelType .TUPLE ")" string.wrap #dup  fileState state readCompositeType
        prevArgs state resetStaticArgs
        if
          "error while parsing procedure return values" sb.wrap fileState [] .wordStart state appendError2
        end #drop ## labelType
        true typeContext types.newProcArgs
        in #swap CallingConvention.DEFAULT typeContext  types.newProcedure if
          "error while creating procedure type" sb.wrap fileState [] .wordStart state appendError2
        end
      else
        typeContext types.newTuple if
          "error while creating composite type" sb.wrap fileState [] .wordStart state appendError2
        end
      end
      fileState [] .wordStart newTypeConst  state pushConst
      "" string.wrap true return
    else #dup "tuple(" string.wrap string.eq _EXPERIMENTAL_ ! & _if #drop
      LabelType .TUPLE ")" string.wrap #dup fileState state readCompositeType
      if
        "error while parsing tuple type" sb.wrap fileState [] .wordStart state appendError2
      end #drop ## labelType
      typeContext types.newTuple if
        "error while creating tuple type" sb.wrap fileState [] .wordStart state appendError2
      end
      fileState [] .wordStart newTypeConst  state pushConst
      "" string.wrap true return
    else #dup "struct(" string.wrap string.eq _EXPERIMENTAL_ ! & _if #drop
      LabelType .STRUCT ")" string.wrap #dup fileState state readCompositeType
      if
        "error while parsing structure type" sb.wrap fileState [] .wordStart state appendError2
      end #drop ## labelType
      typeContext types.newTuple if
        "error while creating structure type" sb.wrap fileState [] .wordStart state appendError2
      end
      fileState [] .wordStart newTypeConst  state pushConst
      "" string.wrap true return
    else #dup "union(" string.wrap string.eq _EXPERIMENTAL_ ! & _if #drop
      LabelType .STRUCT ")" string.wrap #dup fileState state readCompositeType
      if
        "error while parsing union type" sb.wrap fileState [] .wordStart state appendError2
      end #drop ## labelType
      typeContext types.newUnion if
        "error while creating union type" sb.wrap fileState [] .wordStart state appendError2
      end
      fileState [] .wordStart newTypeConst  state pushConst
      "" string.wrap true return
    else #dup "enum(" string.wrap string.eq _EXPERIMENTAL_ ! & _if #drop
      LabelType .ENUM ")" string.wrap #dup fileState state readCompositeType
      if
        "error while parsing enum type" sb.wrap fileState [] .wordStart state appendError2
      end #drop ## labelType
      typeContext types.newEnum if
        "error while creating enum type" sb.wrap fileState [] .wordStart state appendError2
      end
      fileState [] .wordStart newTypeConst  state pushConst
      "" string.wrap true return
    else #dup "proc(" string.wrap string.eq _EXPERIMENTAL_ ! & _if #drop
      state offsetStaticArgs =:: prevArgs
      LabelType .PROC_IN "=>" string.wrap ")" string.wrap fileState state readCompositeType
      if
        "error while parsing procedure arguments" sb.wrap fileState [] .wordStart state appendError2
      end #drop ## labelType
      false typeContext types.newProcArgs
      =:: in
      LabelType .TUPLE ")" string.wrap #dup  fileState state readCompositeType
      prevArgs state resetStaticArgs
      if
        "error while parsing procedure return values" sb.wrap fileState [] .wordStart state appendError2
      end #drop ## labelType
      true typeContext types.newProcArgs
      in #swap CallingConvention.DEFAULT typeContext  types.newProcedure if
        "error while creating procedure type" sb.wrap fileState [] .wordStart state appendError2
      end
      fileState [] .wordStart newTypeConst  state pushConst
      "" string.wrap true return
    end
    #dup state getStaticArg #dup optional.hasData if .data
        #dup .argType
        #swap .val
        IdentifierInfo optional.empty ## XXX? id-info
        fileState [] .wordStart
      Constant new state pushConst
      true return
    else #drop end
    #dup state [] .currentFile idContext id.getIdentifier if
      #drop:2 false return ## unknown identifier
    end
    #dup [] .constValue ConstValue .none == if
      #drop:2 false return ## not a constant
    end
    #dup [] .constValue ConstValue .procedure == if
      #drop:2 false return ## ignore procedure constants
    end
    #dup [] .constValue =:: mut constVal
    #dup [] .templateId -1 != #over [] .idType IdentifierType .TEMPLATE_ARG != & if
      idContext [] .templateArgBuffer .length =:: offset
      #dup [] .templateId idContext id.templateArgs fileState state popTemplateArguments if
        "could not get template arguments" sb.wrap fileState [] .wordStart state appendError2
        idContext [] .templateArgBuffer
          offset list.setLength
        idContext [] .templateArgBuffer = ## reset template arguments
        #drop:3 true return
      end =:: args
      constVal args 0 0 ConstantArray new fileState [] .wordStart idContext types.replaceGenerics constVal =
      idContext [] .templateArgBuffer
        offset list.setLength
      idContext [] .templateArgBuffer = ## reset template arguments
    end
    ## newIdentifierConstant
      #dup [] .valueType
      constVal
      #over:2 id.asIdInfo optional.wrap
      fileState [] .wordStart
    Constant new state pushConst
  #drop:2 true return
end
proc( string #+size+# string #+opName+# FilePosition ParserState ptr mut => i32 ) =: getCompilerOpParam
  =:: state
  =:: pos
  =:: opName
  #dup 10 number.tryParseInt number.ParserError .NONE != if #drop
    #dup .length 0 > if
      64 sb.create
        "unexpected argument for " sb.appendS
        opName sb.appendStr
        " expected positive integer got: \"" sb.appendS
        #swap  sb.appendStr
        '"'    sb.appendC
      pos state appendError2
    else #drop end
    1 return
  else #swap #drop i32 cast #dup 1 < _if
    50 sb.create
      "argument of " sb.appendS
        opName sb.appendStr
      " has to be positive got: " sb.appendS
      #swap sb.appendI
    pos state appendError2
    1
  end
  return
end

proc( string : code Token : token FileState ptr mut : fileState  ParserState ptr mut : state => string ) =: parseOperation
  state [] .progContext =:: progContext
  state [] .progContext [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  idContext [] .labelContext @ =:: labelContext
  code
    token fileState state tryParseConstant if
      #drop return
    end
    #dup .length 0 == if #drop
      return ## skip empty tokens
    end
    #dup 0 string.charAt '#' == if ## compiler command
      1 string.tail
      #dup ":" string.wrap string.startsWith if 1 string.tail
        "opt:!fold" string.wrap #over string.eq if
          id.SCOPE_FLAG_NO_CONST_FOLD true idContext id.setScopeFlag
        else "opt:fold" string.wrap #over string.eq _if
          id.SCOPE_FLAG_NO_CONST_FOLD false idContext id.setScopeFlag
        end
        #drop
        return ## ignore unknown annotations
      end
      ':' string.split
        "dup" string.wrap #over string.eq if =:: opName
          #drop ## ignore additional parameters
          0 StackModType .COPY fileState [] .wordStart opStackMod state appendOp
          return
        else "over" string.wrap #over string.eq _if =:: opName
          ':' string.split #swap #drop ## ignore additional parameters
          opName fileState [] .wordStart state getCompilerOpParam ## :offset
          StackModType .COPY fileState [] .wordStart opStackMod state appendOp
          return
        else "swap" string.wrap #over string.eq _if =:: opName
          #drop ## ignore additional parameters
          1 StackModType .SWAP fileState [] .wordStart opStackMod state appendOp
          return
        else "drop" string.wrap #over string.eq _if =:: opName ':' string.split #swap #drop
          ':' string.split #swap #drop ## ignore additional parameters
          opName fileState [] .wordStart state getCompilerOpParam ## :count
          StackModType .DROP fileState [] .wordStart opStackMod state appendOp
          return
        else "include" string.wrap #over string.eq _if #drop:2
          fileState nextToken
          #dup Token .STRING == if .STRING ## local file TODO? allow ignoring name of current folder (search base-path, then current folder)
            state [] .basePath .length #over .length + sb.create
              state [] .basePath sb.appendStr
              #swap sb.appendStr
            fileState [] .wordStart state includeFile
            return
          else #dup Token .IDENTIFIER == _if .IDENTIFIER ## library file
            state [] .libPath .length #over .length + ".concat" ..length + sb.create
              state [] .libPath sb.appendStr
              #swap sb.appendStr ".concat" sb.appendS
            fileState [] .wordStart state includeFile
            return
          end
          64 sb.create
            "invalid token for include" sb.appendS
            #swap sb.appendToken
          fileState [] .wordStart state appendError2
          return
        else "namespace" string.wrap #over string.eq _if #drop
          idContext id.isTopLevel ! if
            "#" sb.wrap
              #swap sb.appendStr
            " can only be used at global level" sb.appendS fileState [] .wordStart state appendError2
          else #drop end
          fileState nextToken
          #dup Token .IDENTIFIER != if #drop
            "namespace names have to be identifiers" sb.wrap fileState [] .wordStart state appendError2
            return
          end .IDENTIFIER
          #dup fileState [] .wordStart progContext [] .errors @ id.checkIdentifier if
            "\"" sb.wrap
              #swap sb.appendStr
            "\" is not a valid namespace name" sb.appendS
            fileState [] .wordStart state appendError2 return
          end
          idContext id.hasOpenTemplate if #drop
            "cannot open namespace inside template" sb.wrap fileState [] .wordStart state appendError2
            return
          end
          id.FLAG_NONE fileState [] .wordStart state [] .currentFile labelContext id.newLabel
          idContext id.beginNamespace
          return
        else "using" string.wrap #over string.eq _if #drop:2
          fileState nextToken
          #dup Token .IDENTIFIER != if #drop
            "namespace names have to be identifiers" sb.wrap fileState [] .wordStart state appendError2
            return
          end .IDENTIFIER
          #dup id.FLAG_NONE fileState [] .wordStart state [] .currentFile labelContext id.newLabel
          idContext id.importNamespace if
            "namespace \"" sb.wrap
              #swap sb.appendStr
            "\" does not exist" sb.appendS fileState [] .wordStart state appendError2
          else #drop end
          return
        else "end" string.wrap #over string.eq _if #drop
          idContext id.isTopLevel ! if
            "#" sb.wrap
              #swap sb.appendStr
            " can only be used at global level" sb.appendS fileState [] .wordStart state appendError2
          else #drop end
          idContext id.endNamespace if
            "no open namespaces" sb.wrap fileState [] .wordStart state appendError2
          end
          return
        else "template" string.wrap #over string.eq _if #drop
          idContext id.isTopLevel ! if
            "#" sb.wrap
              #swap sb.appendStr
            " can only be used at global level" sb.appendS fileState [] .wordStart state appendError2
          else #drop end
          LabelType .TEMPLATE "#end" string.wrap #dup fileState state readCompositeType if
            "error while parsing template arguments" sb.wrap fileState [] .wordStart state appendError2
          end #drop ## labelType
          false typeContext types.newProcArgs
          progContext [] .templateOps .length state [] .currentFile fileState [] .wordStart idContext id.beginTemplate if
            "could not create template" sb.wrap fileState [] .wordStart state appendError2
          end
          return
        else "typedef" string.wrap #over string.eq _if #drop:2
          fileState state nextWord fileState state readLabel
          ## declareIdentifier
            types.primitive.TYPE
            IdentifierType .TYPE
            -1 ## id
            fileState state popTypeConstant #drop ConstValue .typeId new
          fileState [] .wordStart state [] .currentFile idContext progContext [] .errors @ id.declareIdentifier if #drop
            .name 0 sb.create #swap sb.appendStr fileState [] .wordStart state appendError2
            return
          end
          idContext id.isTopLevel if
            progContext [] .templateOps .length idContext  id.endOpenTemplate
          end
          #drop:2 return
        else "types" string.wrap #over string.eq _if =:: opName ':' string.split #swap #drop ## ignore 2nd parameter
          #dup .length 0 > if
            opName fileState [] .wordStart state getCompilerOpParam
          else #drop -1 end
          fileState [] .wordStart opTypeInfo state appendOp
          return
        else "stack" string.wrap #over string.eq _if =:: opName ':' string.split #swap #drop ## ignore 2nd parameter
          #dup .length 0 > if
            opName fileState [] .wordStart state getCompilerOpParam
          else #drop -1 end
          fileState [] .wordStart opStackInfo state appendOp
          return
        else "ops" string.wrap #over string.eq _if =:: opName ':' string.split #swap #drop ## ignore 2nd parameter
          #dup .length 0 > if
            opName fileState [] .wordStart state getCompilerOpParam
          else #drop -1 end
          ## TODO print ops
          fileState [] .wordStart opPrintCompiledOps state appendOp
          return
        else "find" string.wrap #over string.eq _if #drop:2
          fileState nextToken
          #dup Token .IDENTIFIER != if #drop
            "expected identifier" sb.wrap fileState [] .wordStart state appendWarning2
            return
          end .IDENTIFIER =:: idName
          16 IdentifierMatch list.create =:: mut matches
          idName state [] .currentFile idContext matches @ optional.wrap id.searchIdentifier #drop:3
          "-----------------\n" sb.wrap
            "identifier \"" sb.appendS idName sb.appendStr "\":\n" sb.appendS
            0 while #dup matches .length < do
              matches #over list.at .data =:: match
              #swap
                " - " sb.appendS
                match [] .data id.asIdInfo labelContext sb.appendIdInfo
                " ( " sb.appendS
                match [] .data [] .valueType labelContext typeContext sb.appendType
                match [] .data [] .constValue ConstValue .none != if
                  " [ " sb.appendS
                  match [] .data [] .constValue idContext [] .constContext @ labelContext typeContext sb.appendConstant
                  " ]" sb.appendS
                end
                " ) declared at " sb.appendS
                match [] .data [] .labelId labelContext id.labelPos #dup optional.hasData if .data sb.appendPos else #drop "?" sb.appendS end
                '\n' sb.appendC
              #swap 1 +
            end #drop
            "-----------------\n" sb.appendS
            io.stdOut #over io.fputSb #drop
          sb.free #drop
          matches list.free #drop
          idName id.FLAG_NONE fileState [] .wordStart state [] .currentFile labelContext id.newLabel fileState [] .wordStart opPrintIdentifierMatches state appendOp
          return
        else "assert" string.wrap #over string.eq _if #drop:2
          fileState nextToken
          #dup Token .STRING == if .STRING
          else #drop
            "expected string" sb.wrap fileState [] .wordStart state appendWarning2
            return
          end  =:: message
          ## TODO handle asserts in local code
          state _EXPERIMENTAL_ if hasConst2 else hasConst end ! if
            "need boolean constant for static assertion" sb.wrap fileState [] .wordStart state appendError2
            return
          end
          state _EXPERIMENTAL_ if popConst2 #drop else popConst .val end
            #dup ConstValue .boolean == if
              .boolean
            else
              "expected boolean got " sb.wrap #swap idContext [] .constContext @ labelContext typeContext sb.appendConstant fileState [] .wordStart state appendWarning2
              false
            end
            ! if
              "assertion failed \"" sb.wrap message sb.appendStr "\" " sb.appendS fileState [] .wordStart state appendError2
            end
          return
        end
      64 sb.create
        "unknown compiler command \"" sb.appendS
        #swap                         sb.appendStr
        #over .length 0 > if
          ':'                         sb.appendC
          #swap                       sb.appendStr
        else #swap #drop end
        '\"'                          sb.appendC
      fileState [] .wordStart state appendError2
      return
    else #dup ":" string.wrap string.eq
       #over "=:" string.wrap string.eq | _if
      "=:" string.wrap string.eq =:: isInit
      false =:: mut localDeclaration
      _EXPERIMENTAL_ ! if
        fileState state popTypeConstant #drop ## comparability with old parser
      else state [] .constantBlocks .length 0 == state [] .currentProc optional.isEmpty & _if
        state tryInterpretGlobal ## try to interpret global operations before each declaration
        fileState state popTypeConstant #drop
      else
        ## correct type will be resolved in type-check phase
        progContext [] .autoTypes .length i32 cast types.newAutoType
        progContext [] .autoTypes
          Type .undefined list.append
        progContext [] .autoTypes =
        true localDeclaration =
      end =:: mut valType
      false =:: mut forceConst
      state [] .constantBlocks .length 0 > if
        IdentifierType .LABEL
        true forceConst =
      else localDeclaration _EXPERIMENTAL_ & _if
        IdentifierType .LOCAL_VAR
      else valType typeContext types.isProcedure _if
        IdentifierType .PROCEDURE
        true forceConst =
      else valType types.primitive.TYPE types.typeEquals _if
        IdentifierType .TYPE
        true forceConst =
      else state [] .currentProc optional.isEmpty _if ## for comparability with old parser
        IdentifierType .GLOBAL_VAR
      else
        IdentifierType .LOCAL_VAR
      end =:: idType
      fileState state nextWord fileState state
        ## make pre-declared variables mutable by default
        isInit forceConst | if id.FLAG_NONE else id.FLAG_MUTABLE end
      readLabelAddFlags =:: label
      label idContext [] .labelContext @ id.labelFlags id.FLAG_EXPERIMENTAL & 0 != =:: experimental
      label
        valType
        idType
        -1 ## id
        idType IdentifierType .TYPE == if
          isInit if
            fileState state popTypeConstant #drop ## ignore error code and use default value
          else
            Type .undefined
          end
          #over:4 idContext [] .currentTemplate typeContext types.newNamedType fileState [] .wordStart newTypeConst .val
        else isInit ! _if
          ConstValue .none
        else idType IdentifierType .PROCEDURE == _if
          progContext [] .procedures .length ConstValue .procedure new
        else state hasConst _EXPERIMENTAL_ ! & _if
          state popConst
            #dup .valueType valType false typeContext types.canCast ! if
              "cannot cast " sb.wrap
                #over .valueType labelContext typeContext sb.appendType
                " to " sb.appendS
                valType labelContext typeContext sb.appendType
              fileState [] .wordStart state appendError2
            end
            #dup constantToOp state appendOp
          .val
        else state hasConst2 _EXPERIMENTAL_ & _if
          state peekConst2 .data =:: info .data =:: value
            info [] .valueType valType false typeContext types.canCast ! if
              "cannot cast " sb.wrap
                info [] .valueType labelContext typeContext sb.appendType
                " to " sb.appendS
                valType labelContext typeContext sb.appendType
              fileState [] .wordStart state appendError2
            end
          value []
        else
