import map
import arenaAlloc

import "interpreter/operators.concat"
import "identifiers.concat"
import "program.concat"
import "callResolver.concat"

type : export: TypeCheckState

namespace: interpreter
  struct(
    Type : mut: valueType
    FilePosition : mut: pushedAt
  ) =:: export: ValueInfo

  struct(
    ConstValue : value
    ValueInfo  : info
  ) =:: Constant

  struct(
    BlockType : blockType
    i64 : stackOffset
    i64 : typeOffset
    i64 : valueOffset
    i64 : labelOffset
  ) =:: BlockInfo
end
enum( GLOBAL INTERPRET ) =:: export: InterpreterType
struct(
  using interpreter
  ProgramContext ptr.mut : mut: program
  TypeCheckState ptr.mut optional : mut: typeChecker
  LabelId Constant hashMap : mut: variables
  ConstValue list : mut: stack
  ValueInfo  list : mut: stackInfo
  BlockInfo  list : mut: openBlocks
  ConstValue ArenaAllocator : mut: localMemory
  ## XXX globalMemory (?heapMemory)
  Type list : mut: typeBuffer
  ConstValue list : mut: valueBuffer
  LabelId list : mut: labelBuffer
  FileId : mut: currentFile
  InterpreterType : mut: evalType
) =:: export: InterpreterContext

namespace: interpreter
  proc(
    ProgramContext ptr.mut : progContext
    TypeCheckState ptr.mut optional : typeChecker
    FileId : fileId
    InterpreterType : evalType
  ->
    InterpreterContext
  ) =>: export: wrapProgram
    ## InterpreterContext
      progContext
      typeChecker
      labelHash@ labelEq@ 32 Constant map.create
      64 ConstValue list.create
      64 ValueInfo  list.create
      64 BlockInfo  list.create
      ## no reordering of allocated blocks to prevent allocation below start of current stack frame
      512 true ConstValue arenaAlloc.create
      64 Type       list.create
      64 ConstValue list.create
      64 LabelId    list.create
      fileId
      evalType
    InterpreterContext new
  end
  proc(
    InterpreterContext ptr.mut : context
  -> ) =>: export: cleanupContext
    context [] .variables@ map.free
    context [] .stackInfo   list.free context [] .stackInfo =
    context [] .openBlocks  list.free context [] .openBlocks =
    context [] .typeBuffer  list.free context [] .typeBuffer =
    context [] .valueBuffer list.free context [] .valueBuffer =
    context [] .labelBuffer list.free context [] .labelBuffer =
    context [] .stack list.free context [] .stack =
  end

  proc(
    i64 : count
    string : name
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> bool ) =>: checkStack
    context [] .openBlocks .length 0 > if
      context [] .openBlocks context [] .openBlocks .length 1 - list.at .data [] .stackOffset
    else 0:i64 end =:: offset
    offset 0 >= assert "offset is non-negative"
    context [] .stack .length offset - count < if
      "not enough arguments for " sb.wrap
        name sb.appendStr
        " expected: " sb.appendS
        count sb.appendI
        " got: " sb.appendS
        context [] .stack .length offset - sb.appendI
      pos context [] .program [] .errors @ appendError
      true return
    end
    false return
  end
  proc( InterpreterContext ptr.mut : context -> i64 ) =>: minStackOffset
    context [] .openBlocks .length 0 > if
      context [] .openBlocks
        context [] .openBlocks .length 1 - list.at .data []
      .stackOffset return
    end
    0 return
  end

  proc( InterpreterContext ptr.mut : context -> bool ) =>: inEnum
    ## XXX cache number of open enum blocks
    context [] .openBlocks .length 1 - while $ 0 >= do
      context [] .openBlocks $1 list.at .data [] .blockType switch
        TYPE_ENUM case
           ..drop true return
        PROCEDURE EXPERIMENTAL_PROCEDURE INITIALIZER TYPE_TUPLE TYPE_STRUCT
            TYPE_PROC_IN TYPE_PROC_OUT TYPE_COMPOSITE TYPE_UNION TYPE_UNTAGGED_UNION case
          ..drop false return
        UNKNOWN IF ELSE WHILE DO BREAK CONTINUE
          SWITCH BREAK_SWITCH CASE DEFAULT FINALLY
          AND OR AND_IF OR_IF AND_DO OR_DO
          IF_TRUE IF_FALSE AND_TRUE AND_FALSE
          OR_TRUE OR_FALSE ELSE_TRUE ELSE_FALSE
          NAMESPACE case break
      end
      1 -
    end ..drop
    false return
  end
  proc( InterpreterContext ptr.mut : context -> bool ) =>: inUnion
    ## XXX cache/precompute result
    context [] .openBlocks .length 1 - while ..dup 0 >= do
      context [] .openBlocks ..over list.at .data [] .blockType switch
        TYPE_UNION TYPE_UNTAGGED_UNION case
           ..drop true return
        PROCEDURE EXPERIMENTAL_PROCEDURE INITIALIZER TYPE_TUPLE TYPE_STRUCT
            TYPE_PROC_IN TYPE_PROC_OUT TYPE_COMPOSITE TYPE_ENUM case
          ..drop false return
        UNKNOWN IF ELSE WHILE DO BREAK CONTINUE
            SWITCH BREAK_SWITCH CASE DEFAULT FINALLY
            AND OR AND_IF OR_IF AND_DO OR_DO
            IF_TRUE IF_FALSE AND_TRUE AND_FALSE
            OR_TRUE OR_FALSE ELSE_TRUE ELSE_FALSE
            NAMESPACE case break
      end
      1 -
    end ..drop
    false return
  end
  proc( InterpreterContext ptr.mut : context -> bool ) =>: export: inTypeOrInitializer
    ## XXX cache/precompute result
    context [] .openBlocks .length 1 - while ..dup 0 >= do
      context [] .openBlocks ..over list.at .data [] .blockType switch
        INITIALIZER TYPE_TUPLE TYPE_STRUCT TYPE_ENUM TYPE_UNION TYPE_UNTAGGED_UNION
            TYPE_PROC_IN TYPE_PROC_OUT TYPE_COMPOSITE case
          ..drop true return
        PROCEDURE EXPERIMENTAL_PROCEDURE case
          ..drop false return
        UNKNOWN IF ELSE WHILE DO BREAK CONTINUE
            SWITCH BREAK_SWITCH CASE DEFAULT FINALLY
            AND OR AND_IF OR_IF AND_DO OR_DO
            IF_TRUE IF_FALSE AND_TRUE AND_FALSE
            OR_TRUE OR_FALSE ELSE_TRUE ELSE_FALSE
            NAMESPACE case break
      end
      1 -
    end ..drop
    false return
  end
  proc( InterpreterContext ptr.mut : context -> bool ) =>: export: inTypeBlock
    ## XXX cache/precompute result
    context [] .openBlocks .length 1 - while ..dup 0 >= do
      context [] .openBlocks ..over list.at .data [] .blockType switch
        TYPE_TUPLE TYPE_STRUCT TYPE_ENUM TYPE_UNION TYPE_UNTAGGED_UNION
            TYPE_PROC_IN TYPE_PROC_OUT TYPE_COMPOSITE case
          ..drop true return
        PROCEDURE EXPERIMENTAL_PROCEDURE case
          ..drop false return
        UNKNOWN IF ELSE WHILE DO BREAK CONTINUE
            SWITCH BREAK_SWITCH CASE DEFAULT FINALLY
            AND OR AND_IF OR_IF AND_DO OR_DO
            IF_TRUE IF_FALSE AND_TRUE AND_FALSE
            OR_TRUE OR_FALSE ELSE_TRUE ELSE_FALSE
            NAMESPACE INITIALIZER case break
      end
      1 -
    end ..drop
    false return
  end
  proc( InterpreterContext ptr.mut : context -> bool ) =>: export: inGlobalBlock
    ## XXX cache/precompute result
    context [] .openBlocks .length 1 - while ..dup 0 >= do
      context [] .openBlocks ..over list.at .data [] .blockType switch
        TYPE_TUPLE TYPE_STRUCT TYPE_ENUM TYPE_UNION TYPE_UNTAGGED_UNION
            TYPE_PROC_IN TYPE_PROC_OUT TYPE_COMPOSITE case
          ..drop true return
        PROCEDURE EXPERIMENTAL_PROCEDURE case
          ..drop false return
        UNKNOWN IF ELSE WHILE DO BREAK CONTINUE
            SWITCH BREAK_SWITCH CASE DEFAULT FINALLY
            AND OR AND_IF OR_IF AND_DO OR_DO
            IF_TRUE IF_FALSE AND_TRUE AND_FALSE
            OR_TRUE OR_FALSE ELSE_TRUE ELSE_FALSE
            NAMESPACE INITIALIZER case break
      end
      1 -
    end ..drop
    true return
  end
  proc( InterpreterContext ptr.mut : context -> bool ) =>: export: skipCurrentBlock
    ## XXX cache/precompute result
    context [] .openBlocks .length 1 - while $ 0 >= do
      context [] .openBlocks $1 list.at .data [] .blockType switch
        IF_FALSE AND_FALSE OR_TRUE ELSE_TRUE case
           ..drop true return
        IF_TRUE AND_TRUE OR_FALSE ELSE_FALSE
          PROCEDURE EXPERIMENTAL_PROCEDURE INITIALIZER TYPE_TUPLE TYPE_STRUCT
          TYPE_PROC_IN TYPE_PROC_OUT TYPE_COMPOSITE TYPE_UNION TYPE_UNTAGGED_UNION
          UNKNOWN IF ELSE WHILE DO BREAK CONTINUE TYPE_ENUM
          SWITCH BREAK_SWITCH CASE DEFAULT FINALLY
          AND OR AND_IF OR_IF AND_DO OR_DO
          NAMESPACE case break
      end
      1 -
    end ..drop
    false return
  end

  proc(
    BlockType : blockType
    bool : truncateStack
    InterpreterContext ptr.mut : context
  -> ) =>: openBlock
    truncateStack if
      context [] .stack .length
    else
      context minStackOffset
    end =:: stackOffset
    context [] .openBlocks
      ## BlockInfo
        blockType
        stackOffset
        context [] .typeBuffer .length
        context [] .valueBuffer .length
        context [] .labelBuffer .length
      BlockInfo new list.append
    context [] .openBlocks =
  end
  BlockType ..length 38 == assert "number of block types"
  proc( InterpreterContext ptr.mut : context -> bool ) =>: inAndOrBlock
    context [] .openBlocks list.peek =:: current
    current optional.isEmpty if false return end
    current .data [] .blockType switch
      AND OR AND_TRUE AND_FALSE OR_TRUE OR_FALSE case
        true return
      default
        false return
    end
  end
  proc( InterpreterContext ptr.mut : context -> ) =>: closeAndOrBlock
    context [] .openBlocks list.peek =:: current
    current optional.isEmpty if return end
    current .data [] .blockType switch
      AND OR AND_TRUE AND_FALSE OR_TRUE OR_FALSE case
          context [] .openBlocks
            list.pop ..drop
          context [] .openBlocks =
        break
      default break
    end
  end
  ## current conditional value in the and-or block (or false if not inside and/or block)
  proc( InterpreterContext ptr.mut : context -> bool ) =>: andOrCondition
    context [] .openBlocks list.peek =:: currentBlock?
    currentBlock? optional.hasData and currentBlock? .data [] .blockType .OR_TRUE ?? end
  end

  enum( TYPE_STRUCT TYPE_UNION TYPE_ENUM TYPE_PROC INITIALIZER ) =:: LabeledValueContext
  proc( InterpreterContext ptr.mut : context -> i64 LabeledValueContext ) =>: getLabeledValueContext
    ## XXX cache/precompute result
    context [] .openBlocks .length 1 - while $ 0 >= do =:: i
      context [] .openBlocks i list.at .data =:: block
      block [] .blockType switch
        INITIALIZER case
           block [] .labelOffset LabeledValueContext .INITIALIZER return
        TYPE_TUPLE TYPE_STRUCT TYPE_COMPOSITE case
           block [] .labelOffset LabeledValueContext .TYPE_STRUCT return
        TYPE_UNION TYPE_UNTAGGED_UNION case
           block [] .labelOffset LabeledValueContext .TYPE_UNION return
        TYPE_ENUM case
           block [] .labelOffset LabeledValueContext .TYPE_ENUM return
        TYPE_PROC_IN TYPE_PROC_OUT case
           block [] .labelOffset LabeledValueContext .TYPE_PROC return
        PROCEDURE EXPERIMENTAL_PROCEDURE
        UNKNOWN IF ELSE WHILE DO BREAK CONTINUE
          SWITCH BREAK_SWITCH CASE DEFAULT FINALLY
          AND OR AND_IF OR_IF AND_DO OR_DO
          IF_TRUE IF_FALSE AND_TRUE AND_FALSE
          OR_TRUE OR_FALSE ELSE_TRUE ELSE_FALSE
          NAMESPACE case break
      end
    finally i 1 - end ..drop
    ## TODO? better default value/error condition
    ..unreachable
  end
  proc(
    LabelId : label
    i64 : initialLabelOffset
    LabeledValueContext : valueContext
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> ) =>: checkDuplicateLabel
    label id.LABEL_ID_NONE == if return end
    context [] .program [] .errors @ =:: errors
    context [] .program [] .idContext @ =:: idContext
    idContext [] .typeContext @ =:: typeContext
    typeContext [] .labelContext @ =:: labelContext
    context [] .labelBuffer@ =:: labels
    initialLabelOffset while $ labels [] .length < do =:: i
      labels [] i list.get =:: prevLabel
      prevLabel label labelContext id.labelNamesEq if
        "duplicate label \"" sb.wrap
        label labelContext sb.appendLabelName
        "\" in " sb.appendS
        valueContext switch
          TYPE_STRUCT case "struct" sb.appendS break
          TYPE_UNION case "union" sb.appendS break
          TYPE_ENUM case "enum" sb.appendS break
          TYPE_PROC case "procedure" sb.appendS break
          INITIALIZER case "initializer" sb.appendS break
        end
        prevLabel labelContext id.labelPos =:: prevPos
        prevPos optional.hasData if
          " ( previous declaration at " sb.appendS
          prevPos .data sb.appendPos
          " )" sb.appendS
        end
        pos errors appendError
      end
    finally i 1 + end ..drop
  end
  proc(
    LabelId : label
    ConstValue : value
    Type : valueType
    i64 : initialLabelOffset
    LabeledValueContext : valueContext
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> bool ) =>: addLabeledValue
    label initialLabelOffset valueContext pos context checkDuplicateLabel
    context [] .program [] .errors @ =:: errors
    context [] .program [] .idContext @ =:: idContext
    idContext [] .constContext @ =:: constContext
    idContext [] .typeContext @ =:: typeContext
    typeContext [] .labelContext @ =:: labelContext
    context [] .labelBuffer
      label list.append
    context [] .labelBuffer =
    valueContext switch
      INITIALIZER case
        context [] .typeBuffer
          valueType list.append
        context [] .typeBuffer =
        context [] .valueBuffer
          value list.append
        context [] .valueBuffer =
        false return
      TYPE_STRUCT TYPE_UNION TYPE_PROC case break
      TYPE_ENUM case ..unreachable
    end
    value .TypeId ?? ! or valueType types.primitive.TYPE types.typeEquals ! if
      "unexpected argument for type-field declaration expected type got " sb.wrap
        valueType typeContext sb.appendType
        " [ " sb.appendS
        value typeContext sb.appendConstant
        " ]" sb.appendS
      pos errors appendError
      true return
    end
    value .TypeId =:: typeValue
    context [] .typeBuffer
      typeValue list.append
    context [] .typeBuffer =
    label id.LABEL_ID_NONE != if
      typeValue
        typeContext types.unwrapNamed
      types.primitive.TYPE types.typeEquals =:: isType
      ## map.put
      context [] .variables@
        label
        ## Constant
          isType if
            label types.newGenericType ConstValue .TypeId
          else
            label ConstValue .GenericArg
          end
          ## ValueInfo
            typeValue
            pos
          ValueInfo new
        Constant new
      map.put ..drop
    end
    false return
  end

  proc(
    i64 : stackOffset
    i64 : initialLabelOffset
    LabeledValueContext : valueContext
    FilePosition : pos
    InterpreterContext  ptr.mut : context
  -> bool ) =>: finishLabledValues
    context [] .program [] .errors@ =:: errors
    context [] .program [] .idContext@ =:: idContext
    idContext [] .typeContext@ =:: typeContext
    typeContext [] .labelContext@ =:: labelContext
    context [] .stack .length stackOffset > if
      stackOffset while $ context [] .stack .length < do =:: i
        context [] .stack i list.at .data =:: eltVal
        context [] .stackInfo i list.at .data =:: eltInfo
        valueContext switch
          TYPE_ENUM case
            "unexpected value in enum-block" sb.wrap
              eltInfo [] .pushedAt
            errors appendError
            id.LABEL_ID_NONE
            break
          TYPE_UNION case
            "unexpected value in union-block" sb.wrap
              eltInfo [] .pushedAt
            errors appendError
            id.LABEL_ID_NONE
            break
          TYPE_PROC INITIALIZER case
            id.LABEL_ID_NONE break
          TYPE_STRUCT case
            ## newDummyLabel
              i stackOffset -
              pos
              -1:FileId ## TODO determine file-id
              labelContext
            id.newDummyLabel
            break
        end =:: eltLabel
        ## addLabeledValue
          eltLabel
          eltVal []
          eltInfo [] .valueType
          initialLabelOffset
          valueContext
          eltInfo [] .pushedAt
        context addLabeledValue if
          true return
        end
      finally i 1 + end ..drop
      ## truncate stack
      stackOffset context truncateStack
    end
    false return
  end
  proc(
    Operation ptr : op
    BlockInfo ptr : closedBlock
    LabeledValueContext : closedType
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> bool ) =>: closedTypeBlock
    ## XXX? use different contexts for different types of type-containers
    ## finishLabledValues
      closedBlock [] .stackOffset
      closedBlock [] .labelOffset
      closedType
    pos context finishLabledValues if
      true return
    end
    context [] .program [] .errors @ =:: errors
    context [] .program [] .idContext @ =:: idContext
    idContext [] .constContext @ =:: constContext
    idContext [] .typeContext @ =:: typeContext
    typeContext [] .labelContext @ =:: labelContext
    closedBlock [] .labelOffset =:: labelOffset
    closedBlock [] .typeOffset =:: typeOffset
    context [] .labelBuffer .length labelOffset - =:: elementCount
    context [] .typeBuffer .length typeOffset - elementCount == assert "type count == label count"
    0:i64 while $ elementCount < do =:: i
      context [] .typeBuffer typeOffset i + list.at .data [] =:: eltType
      context [] .labelBuffer labelOffset i + list.at .data [] =:: eltLabel
      ## types are always static
      eltType types.primitive.TYPE types.typeEquals if
        eltLabel id.FLAG_STATIC labelContext id.addLabelFlags
      end
    finally i 1 + end ..drop
    false return
  end

  proc( Operation ptr : op BlockInfo ptr : closedBlock InterpreterContext ptr.mut : context -> bool ) =>: closeStructBlock
    context [] .program [] .errors@ =:: errors
    context [] .program [] .idContext@ =:: idContext
    idContext [] .typeContext@ =:: typeContext
    op closedBlock
      LabeledValueContext .TYPE_STRUCT
      op [] .pos
    context closedTypeBlock if true return end
    closedBlock [] .labelOffset =:: labelOffset
    closedBlock [] .valueOffset =:: valueOffset
    closedBlock [] .typeOffset =:: typeOffset
    closedBlock [] .blockType .TYPE_COMPOSITE ?? and context [] .typeBuffer .length typeOffset == if
      Type .empty
    else
      ## newTuple
        context [] .typeBuffer list.asArray typeOffset array.tail
        context [] .labelBuffer list.asArray labelOffset array.tail optional.wrap
      typeContext types.newTuple if ..drop
        "could not create structure-type" sb.wrap op [] .pos errors appendError
        true return
      end
    end =:: tupleType
    context [] .typeBuffer typeOffset list.setLength context [] .typeBuffer =
    context [] .valueBuffer valueOffset list.setLength context [] .valueBuffer =
    context [] .labelBuffer labelOffset list.setLength context [] .labelBuffer =
    ## pushValue
      tupleType ConstValue .TypeId
      types.primitive.TYPE
      op [] .pos
    context pushValue
    false return
  end
  proc( Operation ptr : op BlockInfo ptr : closedBlock InterpreterContext ptr.mut : context -> bool ) =>: closeProcTypeBlock
    context [] .program [] .errors@ =:: errors
    context [] .program [] .idContext@ =:: idContext
    idContext [] .typeContext@ =:: typeContext
    closedBlock [] .labelOffset =:: labelOffset
    closedBlock [] .valueOffset =:: valueOffset
    closedBlock [] .typeOffset =:: typeOffset
    context [] .typeBuffer .length typeOffset - 1 < or
        ## last argument is procedure output
        context [] .typeBuffer
          $ .length 1 -
        list.get .procOut ?? ! if
      "missing return type for procedure" sb.wrap op [] .pos errors appendError
      true return
    end
    context [] .typeBuffer
      list.pop =:: procOut ## last value is return type
    context [] .typeBuffer =
    op closedBlock
      LabeledValueContext .TYPE_PROC
      op [] .pos
    context closedTypeBlock if true return end
    ## newProcArgs
      context [] .typeBuffer list.asArray typeOffset array.tail
      context [] .labelBuffer list.asArray labelOffset array.tail optional.wrap
      false
    typeContext types.newProcArgs =:: procIn
    procIn procOut CallingConvention.DEFAULT typeContext types.newProcedure if ..drop
      "could not create procedure-type" sb.wrap op [] .pos errors appendError
      true return
    end =:: newType
    context [] .typeBuffer typeOffset list.setLength context [] .typeBuffer =
    context [] .valueBuffer valueOffset list.setLength context [] .valueBuffer =
    context [] .labelBuffer labelOffset list.setLength context [] .labelBuffer =
    ## pushValue
      newType ConstValue .TypeId
      types.primitive.TYPE
      op [] .pos
    context pushValue
    false return
  end

  proc(
    Operation ptr : op
    BlockInfo ptr : closedBlock
    FilePosition : pos
    InterpreterContext ptr.mut : context
  ->
    Type
    bool
  ) =>: closedInitializer
    ## finishLabledValues
      closedBlock [] .stackOffset
      closedBlock [] .labelOffset
      LabeledValueContext .INITIALIZER
    pos context finishLabledValues if
      Type .undefined true return
    end
    context [] .program [] .errors @ =:: errors
    context [] .program [] .idContext @ =:: idContext
    idContext [] .constContext @ =:: constContext
    idContext [] .typeContext @ =:: typeContext
    typeContext [] .labelContext @ =:: labelContext
    closedBlock [] .typeOffset =:: typeOffset
    closedBlock [] .valueOffset =:: valueOffset
    closedBlock [] .labelOffset =:: labelOffset
    context [] .labelBuffer .length labelOffset - =:: elementCount
    context [] .typeBuffer .length typeOffset - elementCount == assert "type count == label count"
    context [] .valueBuffer .length valueOffset - elementCount == assert "value count == label count"
    ## newInitializerType
      context [] .typeBuffer list.asArray typeOffset array.tail
      context [] .labelBuffer list.asArray labelOffset array.tail optional.wrap
      typeContext
    types.newInitializerType =:: initializerType
    ## return
      initializerType
      false
    return
  end

  proc(
    ConstValue : value
    Type : valType
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> ) =>: pushValue
    context [] .stack
      value list.append
    context [] .stack =
    context [] .stackInfo
      ## ValueInfo
        valType
        pos
      ValueInfo new list.append
    context [] .stackInfo =
  end
  proc(
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> ValueInfo ConstValue bool ) =>: popValue
    context [] .stack .length 0 == if
      "stack underflow " sb.wrap
      pos context [] .program [] .errors@ appendError
      ## return
        ## ValueInfo
          Type .undefined
          pos
        ValueInfo new
        ConstValue .None
      true return
    end
    context [] .stack
      list.pop =:: value
    context [] .stack =
    context [] .stackInfo
      list.pop =:: valInfo
    context [] .stackInfo =
    valInfo value false return
  end
  proc(
    ConstValue : value
    ValueInfo : valInfo
    InterpreterContext ptr.mut : context
  ->  ) =>: unpopValue
    context [] .stack
       value list.append
    context [] .stack =
    context [] .stackInfo
      valInfo list.append
    context [] .stackInfo =
  end
  proc(
    ConstValue _ ptr : values
    ValueInfo _ ptr : valInfos
    i64 : count
    InterpreterContext ptr.mut : context
  ->  ) =>: unpopValues
    count 1 - while ..dup 0 >= do =:: i
      ## unpopValue
        values i []
        valInfos i []
        context
      unpopValue
      i 1 -
    end ..drop
  end
  proc(
    i64 : newLength
    InterpreterContext ptr.mut : context
  -> ) =>: truncateStack
    context [] .stack .length context [] .stackInfo .length == assert "len(stack)=len(stackInfo)"
    context [] .stack .length newLength >= assert "newLength<length"
    context [] .stack
      newLength list.setLength
    context [] .stack =
    context [] .stackInfo
      newLength list.setLength
    context [] .stackInfo =
  end

  proc(
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> ValueInfo Type bool ) =>: popType
    context [] .program [] .errors @ =:: errors
    context [] .program =:: program
    context [] .program [] .idContext @ =:: idContext
    idContext [] .constContext @ =:: constContext
    idContext [] .typeContext @ =:: typeContext
    typeContext [] .labelContext @ =:: labelContext
    pos context popValue =:: isError =:: value =:: valInfo
    isError if
      valInfo Type .undefined true return
    end
    value .TypeId ?? if
      valInfo value .TypeId false return
    end
    "expected type got: " sb.wrap
      valInfo .valueType typeContext sb.appendType
      " ( " sb.appendS
      value typeContext sb.appendConstant
      " )" sb.appendS
    pos errors appendError
    ## restore stack
    value valInfo context unpopValue
    valInfo Type .undefined true return
  end
  proc(
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> bool bool ) =>: popCondition
    context [] .program [] .errors@ =:: errors
    context [] .program =:: program
    context [] .program [] .idContext@ =:: idContext
    idContext [] .constContext@ =:: constContext
    idContext [] .typeContext@ =:: typeContext
    pos context popValue =:: isError =:: value =:: valInfo
    isError if
      ## popValue already created error message
      "missing value for condition" sb.wrap
      pos errors appendInfo
      false true return
    end
    value .Bool ?? if
      value .Bool false return
    end
    "expected boolean got: " sb.wrap
      valInfo .valueType typeContext sb.appendType
      " ( " sb.appendS
      value typeContext sb.appendConstant
      " )" sb.appendS
    pos errors appendError
    ## restore stack
    value valInfo context unpopValue
    false true return
  end
  proc(
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> i64 bool ) =>: popIndex
    context [] .program [] .errors@ =:: errors
    context [] .program =:: program
    context [] .program [] .idContext@ =:: idContext
    idContext [] .constContext@ =:: constContext
    idContext [] .typeContext@ =:: typeContext
    pos context popValue =:: isError =:: value =:: valInfo
    isError if
      ## popValue already created error message
      "missing value for index" sb.wrap
      pos errors appendInfo
      -1:i64 true return
    end
    value .Int ?? if
      value .Int false return
    end
    ## TODO support generic arguments
    "expected integer got: " sb.wrap
      valInfo .valueType typeContext sb.appendType
      " ( " sb.appendS
      value typeContext sb.appendConstant
      " )" sb.appendS
    pos errors appendError
    ## restore stack
    value valInfo context unpopValue
    -1:i64 true return
  end

## TODO use wrapper procedures for stack access

  proc(
    Type : t
    TypeMemoryInfo : infoType
    ProgramContext ptr.mut : program
  -> ConstValue bool ) =>: export: computeTypeInfo
    program [] .errors @ =:: errors
    program [] .idContext @ =:: idContext
    idContext [] .constContext @ =:: constContext
    idContext [] .typeContext @ =:: typeContext
    typeContext [] .labelContext @ =:: labelContext
    t typeContext types.containsGeneric if
      ConstValue .None true return
    end
    infoType switch
      ALIGNMENT case
        t typeContext types.alignOf
        break
      SIZE case
        t typeContext types.sizeOf
        break
      STRIDE case
        t typeContext types.strideOf
        break
    end =:: sizeValue
    sizeValue switch
      fixed case
        sizeValue .fixed ConstValue .Int false return
      dynamicArray case
        ConstValue .None true return ## XXX? support generic array size
      unknown case ## XXX? error message for unknown size
        ConstValue .None true return
    end
  end
  proc(
    Type : t
    ConstValue : value
    bool : isLength
    FilePosition : pos
    ProgramContext ptr.mut : program
  -> Type ConstValue bool ) =>: export: sizeOfValue
    ## TODO support length of initializers
    program [] .errors @ =:: errors
    program [] .idContext @ =:: idContext
    idContext [] .typeContext @ =:: typeContext
    idContext [] .constContext @ =:: constContext
    false =:: mut: isType
    t typeContext types.unwrapReference =:: mut: valType
    valType types.primitive.TYPE types.typeEquals if
      value .TypeId ?? ! if
        "unexpected constant value for type type: " sb.wrap
          value typeContext sb.appendConstant
        pos errors appendError
        Type .undefined ConstValue .None true return
      end
      value .TypeId valType =
      true isType =
    end
    valType typeContext types.isPointer or valType typeContext types.isArray if
      valType typeContext types.isFixedSize ! if
        "cannot get the " sb.wrap
          isLength if
            "length" sb.appendS
          else
            "size" sb.appendS
          end
          " of : " sb.appendS
          valType typeContext sb.appendType
        pos errors appendError
        Type .undefined ConstValue .None true return
      end
      valType typeContext types.getArraySize =:: sizes
      isLength if
        sizes .length 0 == if
          ## return
            types.primitive.I_SIZE
            1 ConstValue .Int
            false
          return
        end
        sizes
          ..dup .length 1 -
        array.get =:: outerSize
        outerSize .int ?? if
          ## return
            types.primitive.I_SIZE
            outerSize .int ConstValue .Int
            false
          return
        else outerSize .genericArg ?? _if
          ## return
            types.primitive.I_SIZE
            outerSize .genericArg ConstValue .GenericArg
            false
          return
        else
          "unsupported array-size type: " sb.wrap
            ## XXX? print array-size type name
          pos errors appendError
          Type .undefined ConstValue .None true return
        end
      else
        idContext [] .argBuffer .length =:: offset
        0:i64 while ..dup sizes .length < do =:: i
          sizes i array.get =:: current
          idContext [] .argBuffer
            current .int ?? if
              current .int ConstValue .Int list.append
            else current .genericArg ?? _if
              current .genericArg ConstValue .GenericArg list.append
            else ..drop
              "unsupported array-size type: " sb.wrap
                ## XXX? print array-size type name
              pos errors appendError
              Type .undefined ConstValue .None true return
            end
          idContext [] .argBuffer =
          i 1 +
        end ..drop
        sizes .length types.ArraySize .int =:: sizeLength
        ## return
          ## newArrayType
            types.primitive.I_SIZE
            types.ArrayType .ARRAY
            sizeLength @
            array.wrap
            false
          typeContext types.newArrayType ..drop
          ## newArrayConst
            ## array.create
              idContext [] .argBuffer .data offset +
              idContext [] .argBuffer .length offset -
            array.create
            idContext [] .constContext @
          newArrayConst
          idContext [] .argBuffer
            offset list.setLength
          idContext [] .argBuffer =
          false
        return
      end
    else isLength and valType typeContext types.isComposite
        and isType or valType .initializer ?? #+XXX? check if initializer is array+# _if
      ## return
        types.primitive.I_SIZE
        valType
          typeContext types.compositeEltCount
        ConstValue .Int
        false
      return
    end
    "unsupported argument type for " sb.wrap
      isLength if
        "length" sb.appendS
      else
        "size" sb.appendS
      end
      "-computation: " sb.appendS
      valType typeContext sb.appendType
    pos errors appendError
    Type .undefined ConstValue .None true return
  end
  proc(
    LabelId : generatorName
    ConstValue arrayView : args
    FilePosition : pos
    ProgramContext ptr.mut : program
  -> Type bool ) =>: export: initializeGeneratedType
    program [] .errors @ =:: errors
    program [] .idContext @ =:: idContext
    idContext [] .constContext @ =:: constContext
    idContext [] .typeContext @ =:: typeContext
    typeContext [] .labelContext @ =:: labelContext
    generatorName idContext id.getIdentifier if ..drop
      "could not find procedure " sb.wrap
        generatorName labelContext sb.appendLabelName
      pos errors appendError
      Type .undefined true return
    end =:: idData
    idData [] .idType .PROCEDURE ?? ! if
      "expected procedure got: " sb.wrap
        idData id.asIdInfo labelContext sb.appendIdInfo
      pos errors appendError
      Type .undefined true return
    end
    idData [] .constValue .Procedure =:: procId
    program [] .procedures
      procId i64 cast list.at .data
    =:: procData
    procData [] .procType =:: procType
    procType typeContext types.getProcIn
      ! assert "proc has in-types"
    =:: inType
    inType typeContext types.compositeEltCount =:: argCount
    procType
      ## IdentifierInfo
        IdentifierType .PROCEDURE
        generatorName
        procId i32 cast
      IdentifierInfo new
      pos
    opGetId =:: op ## create operation for call
    ## TODO? directly go to evaluation of call operation (for resolving auto-args),
    ##   instead of calling evaluateOperation
    program
      TypeCheckState ptr.mut optional.empty
      procData [] .fileId
      InterpreterType .GLOBAL
    wrapProgram =:: mut: context
      ## push arguments
      0:i64 while $ argCount < do =:: i
        inType i typeContext types.compositeGetLabel =:: argLabel
        argLabel labelContext id.labelFlags id.FLAG_AUTO & ? if
          continue
        end
        inType i typeContext types.compositeGetElement =:: argType
        args i array.get =:: argValue
        argValue argType pos context@ pushValue
      finally i 1 + end ..drop
      op@ context@ evaluateOperation ..drop
    context@ cleanupContext
    ## findGeneratedType
      generatorName
      args
      typeContext
      constContext
    types.findGeneratedType return
  end
  proc(
    Type : srcType
    SignType : signType
    ConstValue : oldValue
    Type : targetType
    TypeContext ptr : typeContext
  -> ConstValue ) =>: export: castConstant
    signType .UNSIGNED ?? or signType .NONE ?? and
      srcType typeContext types.isUnsignedInt or srcType typeContext types.isChar or
      srcType typeContext types.isSignedInt ! and
      targetType typeContext types.isUnsignedInt or targetType typeContext types.isChar
    end =:: unsignedCast
    ## XXX ? correctly handle 32-bit floats at compile time
    oldValue .Float ?? and targetType typeContext types.isInt if
      targetType typeContext types.unwrapNamed types.isPrimitive if
        targetType typeContext types.primitiveValue switch
          I8  case
            oldValue .Float unsignedCast if i8  cast.u i64 cast.u else i8  cast.s i64 cast.s end
            ConstValue .Int return
          I16 case
            oldValue .Float unsignedCast if i16 cast.u i64 cast.u else i16 cast.s i64 cast.s end
            ConstValue .Int return
          I32 case
            oldValue .Float unsignedCast if i32 cast.u i64 cast.u else i32 cast.s i64 cast.s end
            ConstValue .Int return
          I64 case
            oldValue .Float unsignedCast if i64 cast.u else i64 cast.s end
            ConstValue .Int return
          BOOL F32 F64 TYPE CHAR8 CHAR16 CHAR32 case ..unreachable
        end
      else unsignedCast _if
        oldValue .Float i64 cast.u ConstValue .Int return
      else
        oldValue .Float i64 cast.s ConstValue .Int return
      end
    end
    ## XXX? zero/sign extend small types
    oldValue .Int ?? if
      oldValue .Int i64 =: mut: intVal
      srcType typeContext types.unwrapNamed types.isPrimitive if
        srcType typeContext types.primitiveValue switch
          I8  CHAR8  case intVal i8 cast
            unsignedCast if i64 cast.u else i64 cast.s end intVal = break
          I16 CHAR16 case intVal i16 cast
            unsignedCast if i64 cast.u else i64 cast.s end intVal = break
          I32 CHAR32 case intVal i32 cast
            unsignedCast if i64 cast.u else i64 cast.s end intVal = break
          F32 F64 case break ## XXX? handle precission loss due to representing int as float
          I64 case break ## no change neccessary
          BOOL TYPE case ..unreachable
        end
      end
      ## uint -> float
      targetType typeContext types.isFloat and signType .UNSIGNED ?? or srcType typeContext types.isUnsignedInt if
        intVal f64 cast.u ConstValue .Float return
      else
        intVal ConstValue .Int return
      end
    end
    ## TODO? special handling for int <-> pointer
    ## TODO? convert primitive arrays to correct array type?
    oldValue return
  end
  proc(
    i64 : index
    i64 : length
    FilePosition : pos
    CompilerError list ptr.mut : errors
  -> bool ) =>: checkIndex
    index 0 < or index length >= if
      "index out of range: " sb.wrap
      index sb.appendI
      " size: " sb.appendS
      length sb.appendI
      pos errors appendError
      true return
    end
    false return
  end
  proc(
    ConstValue : value
    ValueInfo : valInfo
    i64 : elementIndex
    bool : isPtr0
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> bool ) =>: getElement
    context [] .program@ =:: program
    program [] .errors@ =:: errors
    program [] .idContext@ =:: idContext
    idContext [] .constContext@ =:: constContext
    idContext [] .typeContext@ =:: typeContext
    isPtr0 =:: mut: isPtr
      ## TODO! use correct base mutablity
    true =:: mut: eltMutable ## XXX ignore pointer mutability in interpreter?
    valInfo .valueType
      $ typeContext types.isPointer if
        $ typeContext types.isMutable eltMutable & eltMutable =
        typeContext types.getBaseType
        true isPtr =
      end
      eltMutable and $ elementIndex typeContext types.compositeGetLabel
        typeContext .labelContext@ id.labelFlags
      id.FLAG_MUTABLE & ? ! if
        false eltMutable =
      end
      elementIndex typeContext types.compositeGetElement
      isPtr if eltMutable typeContext types.getAddressType end
    =:: eltType
    value .Array ?? if
      value .Array elementIndex array.get
    else value .LocalArray ?? _if
      value .LocalArray ConstValue arrayView.mut cast
        elementIndex array.at .data
      $ [] .LocalValue ?? ! and $ [] .LocalArray ?? ! if
        LocalAddress cast ConstValue .LocalValue
      else [] end
    else value .Union ?? _if
      value elementIndex constUnionElement if
        "union index (" sb.wrap
          elementIndex sb.appendI
          ") does not match current value (" sb.appendS
          value .Union .eltIndex sb.appendI
          ")" sb.appendS
        pos errors appendError
      end
    else
      "unexpected value for composite constant: " sb.wrap
        value typeContext sb.appendConstant
      pos errors appendError
      ## unpopValue
        value
        valInfo
      context unpopValue
      true return
    end =:: eltValue
    ## pushValue
      eltValue
      eltType
      pos
    context pushValue
    false return
  end
  proc(
    LocalSlice : data
    ConstValue ArenaAllocator ptr.mut : allocator
    ConstantContext ptr.mut : constContext
  -> ConstValue ) =>: copyLocalArray
    data ConstValue arrayView.mut cast =:: dataArray
    allocator []
      dataArray arenaAlloc.copyMutableArray =:: tmpArray
    allocator [] =
    ## 1. copy elements
    dataArray .length for =:: i
      dataArray i array.get =:: elt
      elt .LocalValue ?? if
        elt .LocalValue []
      else elt .LocalArray ?? _if
        elt .LocalArray allocator constContext copyLocalArray
      else elt end tmpArray i array.set
    end
    ## XXX? reduce number of identical constants
    tmpArray array.freeze constContext newArrayConst
  end
  proc( ConstValue : value InterpreterContext ptr.mut : context -> ConstValue ) =>: localCopy
    value .Array ?? if
      context [] .localMemory
        value .Array arenaAlloc.copyArray =:: localSlice
      context [] .localMemory =
      ## copy sub-arrays
      localSlice .length for =:: i
        localSlice i array.at .data =:: elt
        elt [] .Array ?? if
          elt [] context localCopy elt [] =
        end
      end
      localSlice LocalSlice cast ConstValue .LocalArray
    ## TODO? replace union element by local copy
    else
      context [] .localMemory
        value arenaAlloc.copyValue =:: localAddress
      context [] .localMemory =
      localAddress LocalAddress cast ConstValue .LocalValue
    end
  end
  proc(
    Type : dataType
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> ConstValue ) =>: allocLocalValue
    context [] .program@ =:: program
    program [] .errors@ =:: errors
    program [] .idContext .typeContext@ =:: typeContext
    ## XXX? better way to detect multi-value types
    dataType typeContext types.isTuple if
      dataType typeContext types.compositeEltCount =:: eltCount
      context [] .localMemory
        eltCount i32 cast arenaAlloc.allocArray =:: localSlice
      context [] .localMemory =
      eltCount for =:: i
        dataType i typeContext types.compositeGetElement =:: eltType
        eltType typeContext types.isTuple or eltType typeContext types.isArray if
          eltType pos context allocLocalValue
        else
          ConstValue .None
        end localSlice i array.set
      end
      localSlice LocalSlice cast ConstValue .LocalArray
    else dataType typeContext types.isArray _if
      ## XXX? merge with previous case
      dataType typeContext types.getArraySize =:: arraySizes
      arraySizes .length 0 > if
        arraySizes $ .length 1 - array.get =:: arraySize
        arraySize .int ?? if
          arraySize .int
        else
          "generic arrays are not supported" sb.wrap
          pos errors appendError
          0
        end
      else 1 end =:: eltCount
      context [] .localMemory
        eltCount i32 cast arenaAlloc.allocArray =:: localSlice
      context [] .localMemory =
      dataType typeContext types.getElementType =:: eltType
      eltType typeContext types.isTuple or eltType typeContext types.isArray if
        eltCount for =:: i
          ## array.set
            eltType pos context allocLocalValue
          localSlice i array.set
        end
      else
        ConstValue .None localSlice array.fill
      end
      localSlice LocalSlice cast ConstValue .LocalArray
    else
      context [] .localMemory
        ConstValue .None arenaAlloc.copyValue =:: localAddress
      context [] .localMemory =
      localAddress LocalAddress cast ConstValue .LocalValue
    end
  end
  union(
    _ : Ok
    _ : Error
    JumpDistance : Jump
    _ : Return
  ) =:: EvalResult
  proc( bool -> EvalResult ) =>: wrapResult
    if EvalResult .Error else EvalResult .Ok end
  end
end
proc(
  Operation ptr : op
  InterpreterContext ptr.mut : context
->
  interpreter.EvalResult
) =>: export: evaluateOperation
  using interpreter
  context [] .program [] .errors@ =:: errors
  context [] .program =:: program
  context [] .program [] .idContext@ =:: idContext
  idContext [] .constContext@ =:: constContext
  idContext [] .typeContext@ =:: typeContext
  typeContext [] .labelContext@ =:: labelContext
  context skipCurrentBlock =:: skipBlock
  skipBlock and op [] .val .block ?? ! and op [] .val .blockEnd ?? ! if
    EvalResult .Ok return ## skip operation
  end
  op [] .val switch
    NOP case
      EvalResult .Ok return
    Constant case
      context inEnum if
        op [] .val .Constant  =:: constVal
        constVal .TypeId ?? ! or constVal .TypeId types.isNamedType ! if
          "unexpected constant in enum declaration expected identifier got " sb.wrap
            constVal typeContext sb.appendConstant
          op [] .pos errors appendError
          EvalResult .Error return
        end
        constVal .TypeId typeContext types.namedTypeName =:: eltLabel
        eltLabel context getLabeledValueContext op [] .pos context checkDuplicateLabel
        context [] .typeBuffer
          Type .empty list.append
        context [] .typeBuffer =
        context [] .labelBuffer
          eltLabel list.append
        context [] .labelBuffer =
        EvalResult .Ok return
      end
      op [] .val .Constant .GenericArg ?? if
        op [] .val .Constant .GenericArg =:: label
        context [] .variables@ label map.get =:: value?
        value? optional.isEmpty if
          "missing value for " sb.wrap
            op [] .val .getId labelContext sb.appendIdInfo
          op [] .pos errors appendError
          EvalResult .Error return
        end
        ## pushValue
          value? .data .value
          op [] .dataType
          op [] .pos
        context pushValue
        EvalResult .Ok return
      end
      ## pushValue
        op [] .val .Constant
        op [] .dataType
        op [] .pos
      context pushValue
      EvalResult .Ok return
    Return case
      context [] .openBlocks .length 1 - while ..dup 0 >= do
        context [] .openBlocks ..over list.at .data [] .blockType
         ..dup .PROCEDURE ?? ..swap .EXPERIMENTAL_PROCEDURE ?? | if
          ## close procedure block
          context [] .openBlocks
            ..swap list.setLength
          context [] .openBlocks =
          EvalResult .Return return
        end
        1 -
      end ..drop
      "return outside procedure" sb.wrap op [] .pos errors appendError
      EvalResult .Error return
    block case
      op [] .val .block .blockType switch
        TYPE_TUPLE TYPE_STRUCT TYPE_ENUM TYPE_UNION TYPE_UNTAGGED_UNION
        TYPE_PROC_IN TYPE_PROC_OUT TYPE_COMPOSITE
        INITIALIZER case
          op [] .val .block .blockType true context openBlock
          EvalResult .Ok return
        PROCEDURE EXPERIMENTAL_PROCEDURE NAMESPACE case
          "unsupported block-type in constant evaluation: " sb.wrap
            op [] .val .block .blockType sb.appendBlockType
          op [] .pos errors appendError
          EvalResult .Error return
        ## TODO use jumps from blocks
        IF case
          ## XXX allow if-folding within local type-blocks
          skipBlock if
            context andOrCondition
          else op [] .pos context popCondition _if ..drop
            EvalResult .Error return
          end =:: val
          context [] .evalType .INTERPRET ?? if
            op [] .val .block .jumpDistance 0:JumpDistance != assert "non-zero jump"
            val if
              EvalResult .Ok return
            else
              op [] .val .block .jumpDistance EvalResult .Jump return
            end
          end
          context closeAndOrBlock
          val
            if BlockType .IF_TRUE else BlockType .IF_FALSE end
            false
          context openBlock
          EvalResult .Ok return
        ELSE case
          context [] .evalType .INTERPRET ?? if
            op [] .val .block .jumpDistance 0:JumpDistance != assert "non-zero jump"
            op [] .val .block .jumpDistance EvalResult .Jump return
          end
          context [] .openBlocks list.peek =:: currentBlock
          currentBlock optional.isEmpty or currentBlock .data .blockType .IF ?? !
              and currentBlock .data .blockType .IF_TRUE ?? !
              and currentBlock .data .blockType .IF_FALSE ?? ! if
            "unexpected else statement, else can only appear in if-blocks" sb.wrap
            op [] .pos errors appendError
            EvalResult .Error return
          end
          context [] .openBlocks
            list.pop =:: closedBlock
          context [] .openBlocks =
          closedBlock .blockType .IF_TRUE ?? if
            BlockType .ELSE_TRUE
          else closedBlock .blockType .IF_FALSE ?? _if
            BlockType .ELSE_FALSE
          else
            BlockType .ELSE
          end false context openBlock
          EvalResult .Ok return
        AND OR AND_IF OR_IF case
          skipBlock if
            context inAndOrBlock if EvalResult .Ok return end
            op [] .val .block .blockType .OR ?? or
              op [] .val .block .blockType .OR_IF ??
            end
          else op [] .pos context popCondition _if ..drop
            EvalResult .Error return
          end =:: val
          context [] .evalType .INTERPRET ?? if
            op [] .val .block .jumpDistance 0:JumpDistance != assert "non-zero jump"
            op [] .val .block .blockType =:: blockType
            blockType .OR_IF ?? or blockType .OR ?? end =:: isOr
            val isOr == if
              blockType .AND ?? or blockType .OR ?? if
                val ConstValue .Bool types.primitive.BOOL op [] .pos context pushValue
              end
              op [] .val .block .jumpDistance EvalResult .Jump return
            else
              EvalResult .Ok return
            end
          end
          context closeAndOrBlock
          val
            op [] .val .block .blockType .AND ?? or
                op [] .val .block .blockType .AND_IF ?? if
              if BlockType .AND_TRUE else BlockType .AND_FALSE end
            else
              if BlockType .OR_TRUE else BlockType .OR_FALSE end
            end
            false
          context openBlock
          EvalResult .Ok return
        WHILE FINALLY case
          context [] .evalType .INTERPRET ?? if
              EvalResult .Ok return
          end
          break
        DO AND_DO case
          context [] .evalType .INTERPRET ?? if
            op [] .val .block .jumpDistance 0:JumpDistance != assert "non-zero jump"
            op [] .pos context popCondition if ..drop
              EvalResult .Error return
            end if
              EvalResult .Ok return
            else
              op [] .val .block .jumpDistance EvalResult .Jump return
            end
          end
          break
        OR_DO case
          context [] .evalType .INTERPRET ?? if
            op [] .val .block .jumpDistance 0:JumpDistance != assert "non-zero jump"
            op [] .pos context popCondition if ..drop
              EvalResult .Error return
            end if
              op [] .val .block .jumpDistance EvalResult .Jump return
            else
              EvalResult .Ok return
            end
          end
          break
        BREAK CONTINUE BREAK_SWITCH case
          context [] .evalType .INTERPRET ?? if
            op [] .val .block .jumpDistance 0:JumpDistance != assert "non-zero jump"
            op [] .val .block .jumpDistance EvalResult .Jump return
          end
          break
        SWITCH case
          context [] .evalType .INTERPRET ?? if
            op [] .pos context popValue if ..drop.2
              "stack underflow while evaluating operation: " sb.wrap
                op [] program sb.appendOp
              op [] .pos errors appendError
              EvalResult .Error return
            end
              $ .Union ?? if constUnionLabel end
            =:: switchValue ..drop
            program [] .switchData
              op [] .val .block .blockId i64 cast.u
            list.at .data =:: switchData
            switchData [] .labels .length for =:: i
              switchData [] .labels i list.at .data =:: label
              label [] .value switchValue labelContext constantEquals if
                switchData [] .caseJumpDistances
                  label [] .caseId array.get
                EvalResult .Jump return
              end
            end
            switchData [] .defaultJumpDistance EvalResult .Jump return
          end
          break
        IF_TRUE IF_FALSE AND_TRUE AND_FALSE
        OR_TRUE OR_FALSE ELSE_TRUE ELSE_FALSE
        CASE DEFAULT UNKNOWN case break
      end
      "unsupported block-type in constant evaluation: " sb.wrap
        op [] .val .block .blockType sb.appendBlockType
      op [] .pos errors appendError
      EvalResult .Error return
    blockEnd case
      op [] .val .blockEnd .blockType =:: blockType
      context [] .evalType .INTERPRET ?? if
        BlockType ..length 38 == assert "no-new block-types"
        blockType switch
          ELSE SWITCH AND OR case EvalResult .Ok return
          WHILE case
            op [] .val .blockEnd .jumpDistance 0:JumpDistance != assert "non-zero jump"
            op [] .val .blockEnd .jumpDistance EvalResult .Jump return
          default break
        end
      end
      context [] .openBlocks .length 0 == if
        "unexpected end of " sb.wrap
         blockType sb.appendBlockType
         "-block" sb.appendS
        op [] .pos errors appendError
        EvalResult .Error return
      end
      context [] .openBlocks
        list.pop =:: closedBlock ## XXX avoid copying blockInfo into local variable
      context [] .openBlocks =
      closedBlock .blockType switch
        IF_TRUE IF_FALSE case
          blockType .IF ?? if EvalResult .Ok return end break
        ELSE_TRUE ELSE_FALSE case
          blockType .ELSE ?? if EvalResult .Ok return end break
        default break
      end
      closedBlock .blockType blockType != if
        "unexpected end of " sb.wrap
         blockType sb.appendBlockType
         "-block expected " sb.appendS
         closedBlock .blockType sb.appendBlockType
        op [] .pos errors appendError
        EvalResult .Error return
      end
      blockType switch
        TYPE_COMPOSITE case
          context [] .typeBuffer list.peek =:: outType?
          outType? optional.hasData and outType? .data [] .procOut ?? if
            op closedBlock@ context closeProcTypeBlock wrapResult return
          else
            op closedBlock@ context closeStructBlock wrapResult return
          end
          break
        TYPE_TUPLE TYPE_STRUCT case
          op closedBlock@ context closeStructBlock wrapResult return
        TYPE_ENUM case
          op closedBlock@
            LabeledValueContext .TYPE_ENUM
            op [] .pos
          context closedTypeBlock if EvalResult .Error return end
          closedBlock .labelOffset =:: labelOffset
          closedBlock .valueOffset =:: valueOffset
          closedBlock .typeOffset =:: typeOffset
          ## newEnum
            context [] .typeBuffer list.asArray typeOffset array.tail
            context [] .labelBuffer list.asArray labelOffset array.tail optional.wrap
          typeContext types.newEnum if ..drop
            "could not create enum" sb.wrap op [] .pos errors appendError
            EvalResult .Error return
          end =:: enumType
          context [] .typeBuffer typeOffset list.setLength context [] .typeBuffer =
          context [] .valueBuffer valueOffset list.setLength context [] .valueBuffer =
          context [] .labelBuffer labelOffset list.setLength context [] .labelBuffer =
          ## pushValue
            enumType ConstValue .TypeId
            types.primitive.TYPE
            op [] .pos
          context pushValue
          EvalResult .Ok return
        TYPE_UNION TYPE_UNTAGGED_UNION case
          op closedBlock@
            LabeledValueContext .TYPE_UNION
            op [] .pos
          context closedTypeBlock if EvalResult .Error return end
          closedBlock .labelOffset =:: labelOffset
          closedBlock .valueOffset =:: valueOffset
          closedBlock .typeOffset =:: typeOffset
          ## newUnion
            context [] .typeBuffer list.asArray typeOffset array.tail
            context [] .labelBuffer list.asArray labelOffset array.tail optional.wrap
            blockType .TYPE_UNION ??
          typeContext types.newUnion if ..drop
            "could not create union-type" sb.wrap op [] .pos errors appendError
            EvalResult .Error return
          end =:: unionType
