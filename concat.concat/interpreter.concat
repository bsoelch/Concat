import map
import arenaAlloc
import string
using std.literals.

import "interpreter/operators.concat"
import "identifiers.concat"
import "program.concat"

namespace: interpreter
  struct(
    Type : valueType
    FilePosition : pushedAt
  ) =:: export: ValueInfo

  struct(
    ConstValue : value
    ValueInfo  : info
  ) =:: Constant

  struct(
    iSize : callStackDepth
    iSize : stackSize
  ) =:: InterpreterState
end
struct(
  using interpreter.
  ProgramContext ptr.mut : program
  LabelId Constant hashMap : globalVariables
  LabelId Constant hashMap ptr.mut optional : localVariables
  ConstValue list : stack
  ValueInfo  list : stackInfo
  iSize list : stackOffsets
  MixedArenaAllocator : localMemory
  ## XXX globalMemory (?heapMemory)
  Type list : typeBuffer
  ConstValue list : valueBuffer
  LabelId list : labelBuffer
  FilePosition list : callPositions
  InterpreterState list : stateStack
  FileId : currentFile
) =:: export: InterpreterContext

namespace: interpreter
  proc(
    ProgramContext ptr.mut : progContext
    FileId : fileId
  ->
    InterpreterContext
  ) =>: export: wrapProgram
    ## InterpreterContext
      progContext
      labelHash@ labelEq@ 512 Constant map.create
      LabelId Constant hashMap ptr.mut optional.empty
      64 ConstValue list.create
      64 ValueInfo  list.create
      64 iSize  list.create
      ## no reordering of allocated blocks to prevent allocation below start of current stack frame
      4096 true mixedArena.create
      64 Type       list.create
      64 ConstValue list.create
      64 LabelId    list.create
      64 FilePosition list.create
      32 InterpreterState list.create
      fileId
    InterpreterContext new
  end
  proc(
    InterpreterContext ptr.mut : context
  -> ) =>: export: cleanupContext
    context .globalVariables map.free
    context [] .stackInfo   list.free context .stackInfo=
    context [] .stackOffsets  list.free context .stackOffsets=
    context [] .typeBuffer  list.free context .typeBuffer=
    context [] .valueBuffer list.free context .valueBuffer=
    context [] .labelBuffer list.free context .labelBuffer=
    context [] .callPositions list.free context .callPositions=
    context [] .localMemory mixedArena.free context .localMemory=
    context [] .stack list.free context .stack=
    context [] .stateStack list.free context .stateStack=
  end
  proc(
    InterpreterContext ptr.mut : context
  -> ) =>: export: offsetContext
    context [] .stateStack
      ## InterpreterState
        context [] .stackOffsets .length
        context [] .stack .length
      InterpreterState new list.append
    context .stateStack=
  end
  proc(
    InterpreterContext ptr.mut : context
  -> ) =>: export: resetContext
    context [] .stateStack .length 0:iSize == if
      ## TODO error
      return
    end
    context [] .stateStack
      list.pop =:: prevState
    context .stateStack=
    context [] .stackOffsets
      prevState .callStackDepth list.setLength
    context .stackOffsets=
    prevState .stackSize context truncateStack
  end
  ## reset blocks while preserving stack (used when returning from calls)
  proc(
    InterpreterContext ptr.mut : context
  -> ) =>: resetContextKeepStack
    context [] .stateStack .length 0:iSize == if
      ## TODO error
      return
    end
    context [] .stateStack
      list.pop =:: prevState
    context .stateStack=
    context [] .stackOffsets
      prevState .callStackDepth list.setLength
    context .stackOffsets=
  end

  proc(
    iSize : count
    string : name
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> bool ) =>: export: checkStack
    context minStackOffset =:: offset
    context [] .stack .length offset - count iSize.slt if
      "not enough arguments for " sb.copyPtr
        name sb.appendStr
        " expected: " sb.appendS
        count sb.appendI
        " got: " sb.appendS
        context [] .stack .length offset - sb.appendI
      pos context [] .program .errors appendError
      true return
    end
    false return
  end
  proc( InterpreterContext ptr.mut : context -> iSize ) =>: minStackOffset
    context [] .stateStack .length 0:iSize != if
      context [] .stateStack list.peek .data =:: rootState
      rootState [] .stackSize rootState [] .callStackDepth
    else 0:iSize 0:iSize end =:: baseBlock =:: baseOffset
    context [] .stackOffsets .length baseBlock u> if
      context [] .stackOffsets list.peek .data [] return
    end
    baseOffset return
  end

  proc(
    InterpreterContext ptr.mut : context
  -> ) =>: offsetStack
    context [] .stackOffsets
      context [] .stack .length list.append
    context .stackOffsets=
  end

  proc(
    ConstValue : value
    Type : valType
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> ) =>: pushValue
    context [] .stack
      value list.append
    context .stack=
    context [] .stackInfo
      ## ValueInfo
        valType
        pos
      ValueInfo new list.append
    context .stackInfo=
  end
  proc(
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> ValueInfo ConstValue bool ) =>: popValue
    context [] .stack .length 0:iSize == if
      "stack underflow " sb.copyPtr
      pos context [] .program .errors appendError
      ## return
        ## ValueInfo
          Type .Undefined
          pos
        ValueInfo new
        ConstValue .None
      true return
    end
    context [] .stack
      list.pop =:: value
    context .stack=
    context [] .stackInfo
      list.pop =:: valInfo
    context .stackInfo=
    valInfo value false return
  end
  proc(
    ConstValue : value
    ValueInfo : valInfo
    InterpreterContext ptr.mut : context
  ->  ) =>: unpopValue
    context [] .stack
       value list.append
    context .stack=
    context [] .stackInfo
      valInfo list.append
    context .stackInfo=
  end
  proc(
    ConstValue ptr.raw : values
    ValueInfo ptr.raw : valInfos
    i64 : count
    InterpreterContext ptr.mut : context
  ->  ) =>: unpopValues
    count 1 - while ..dup 0 >= do =:: i
      ## unpopValue
        values i []
        valInfos i []
        context
      unpopValue
      i 1 -
    end ..drop
  end
  proc(
    iSize : newLength
    InterpreterContext ptr.mut : context
  -> ) =>: truncateStack
    context [] .stack .length context [] .stackInfo .length == "len(stack)=len(stackInfo)" assert
    context [] .stack .length newLength u>= "newLength<length" assert
    context [] .stack
      newLength list.setLength
    context .stack=
    context [] .stackInfo
      newLength list.setLength
    context .stackInfo=
  end

  proc(
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> ValueInfo Type bool ) =>: popType
    context [] .program .errors =:: errors
    context [] .program =:: program
    context [] .program .idContext =:: idContext
    idContext .constContext =:: constContext
    idContext .typeContext =:: typeContext
    typeContext .labelContext =:: labelContext
    pos context popValue =:: isError =:: value =:: valInfo
    isError if
      valInfo Type .Undefined true return
    end
    value .?TypeId .if
      valInfo >$ false return
    else ..drop end
    "expected type got: " sb.copyPtr
      valInfo .valueType typeContext sb.appendType
      " ( " sb.appendS
      value typeContext sb.appendConstant
      " )" sb.appendS
    pos errors appendError
    ## restore stack
    value valInfo context unpopValue
    valInfo Type .Undefined true return
  end
  proc(
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> bool bool ) =>: popCondition
    context [] .program .errors =:: errors
    context [] .program =:: program
    context [] .program .idContext =:: idContext
    idContext .constContext =:: constContext
    idContext .typeContext =:: typeContext
    pos context popValue =:: isError =:: value =:: valInfo
    isError if
      ## popValue already created error message
      "missing value for condition" sb.copyPtr
      pos errors appendInfo
      false true return
    end
    value .?Bool .if
      false return
    else ..drop end
    "expected boolean got: " sb.copyPtr
      valInfo .valueType typeContext sb.appendType
      " ( " sb.appendS
      value typeContext sb.appendConstant
      " )" sb.appendS
    pos errors appendError
    ## restore stack
    value valInfo context unpopValue
    false true return
  end
  proc(
    bool : persistentCopy
    ConstValue : value
    bool : allowArray
    ConstantContext ptr.mut : constContext
  -> string bool ) =>: constValueAsString
    value .?Array8 .if
      string.fromBytes false return
    else .?LocalArray8 ._if
      i8 slice.mut cast slice.freeze
        persistentCopy if
          constContext newArray8Const .Array8
        end
      string.fromBytes
      false return
    else ..drop allowArray ! _if
      string.empty true return
    end
    value .?Array .and =:: valArray
        valArray .length 2:iSize == if
      valArray
    else value .?LocalArray .and =:: valArray
        valArray .length 2:iSize == _if
      valArray ConstValue slice.mut cast slice.freeze
    else
      string.empty true return
    end =:: str
    str 1 [] .?Int .else ..drop
      string.empty true return
    end iSize cast.u =:: length
    persistentCopy str 0 [] false constContext constValueAsString =:: isErr
      $ .length length u< if true return end
      length string.head
    isErr return
  end
  proc(
    bool : persistentCopy
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> ValueInfo string bool ) =>: popString
    context [] .program =:: program
    program .errors =:: errors
    program .idContext =:: idContext
    idContext .constContext =:: constContext
    idContext .typeContext =:: typeContext
    typeContext .labelContext =:: labelContext
    pos context popValue =:: isError =:: value =:: valInfo
    isError if
      valInfo string.empty true return
    end
    valInfo persistentCopy value true constContext constValueAsString if
      "expected string got: " sb.copyPtr
        valInfo .valueType typeContext sb.appendType
        " ( " sb.appendS
        value typeContext sb.appendConstant
        " )" sb.appendS
      pos errors appendError
      ## restore stack
      value valInfo context unpopValue
       true return
    end
    false return
  end

## TODO use wrapper procedures for stack access

  proc(
    Type : t
    TypeMemoryInfo : infoType
    ProgramContext ptr.mut : program
  -> ConstValue bool ) =>: export: computeTypeInfo
    program .errors =:: errors
    program .idContext =:: idContext
    idContext .constContext =:: constContext
    idContext .typeContext =:: typeContext
    typeContext .labelContext =:: labelContext
    t typeContext types.containsGeneric if
      ConstValue .None true return
    end
    infoType switch
      ALIGNMENT case
        t typeContext types.alignOf
        break
      SIZE case
        t typeContext types.sizeOf
        break
      STRIDE case
        t typeContext types.strideOf
        break
    end =:: sizeValue
    sizeValue switch
      Fixed .case ConstValue .Int false return
      DynamicArray case
        ConstValue .None true return ## XXX? support generic array size
      Unknown case ## XXX? error message for unknown size
        ConstValue .None true return
    end
  end
  proc(
    Type : t
    ConstValue : value
    FilePosition : pos
    ProgramContext ptr.mut : program
  -> Type ConstValue bool ) =>: export: sizeOfValue
    ## TODO support length of initializers
    program .errors =:: errors
    program .idContext =:: idContext
    idContext .typeContext =:: typeContext
    idContext .constContext =:: constContext
    false =:: mut: isType
    t =:: mut: valType
    valType typeContext types.isType if
      value .?TypeId .else ..drop
        "unexpected constant value for type type: " sb.copyPtr
          value typeContext sb.appendConstant
        pos errors appendError
        Type .Undefined ConstValue .None true return
      end valType=
      true isType=
    end
    valType typeContext types.isPointer or valType typeContext types.isArray if
      valType typeContext types.isFixedSize ! if
        "cannot get the length  of : " sb.copyPtr
          valType typeContext sb.appendType
        pos errors appendError
        Type .Undefined ConstValue .None true return
      end
      valType typeContext types.getArraySize =:: size
      size .?Int .if =:: intVal
        ## return
          types.I_SIZE
          intVal ConstValue .Int
          false
        return
      else .?GenericArg ._if =:: genericVal
        ## return
          types.I_SIZE
          genericVal ConstValue .GenericArg
          false
        return
      else ..drop
        "unsupported array-size type: " sb.copyPtr
          ## XXX? print array-size type name
        pos errors appendError
        Type .Undefined ConstValue .None true return
      end
    else valType typeContext types.isArrayLiteral or isType and valType typeContext types.isComposite _if
      ## return
        types.I_SIZE
        valType
          typeContext types.compositeEltCount i64 cast.u
        ConstValue .Int
        false
      return
    end
    "unsupported argument type for length-computation: " sb.copyPtr
      valType typeContext sb.appendType
    pos errors appendError
    Type .Undefined ConstValue .None true return
  end
  proc(
    Type : srcType
    SignType : signType
    ConstValue : oldValue
    Type : targetType
    TypeContext ptr : typeContext
  -> ConstValue ) =>: export: castConstant
    signType .UNSIGNED or signType .NONE and
      srcType typeContext types.isUnsignedInt or srcType typeContext types.isChar or
      srcType typeContext types.isSignedInt ! and
      targetType typeContext types.isUnsignedInt or targetType typeContext types.isChar
    end =:: unsignedCast
    ## XXX ? correctly handle 32-bit floats at compile time
    oldValue .?Float .and =:: floatVal targetType typeContext types.isInt if
      targetType typeContext types.unwrapNamed types.isPrimitive if
        targetType typeContext types.primitiveValue switch
          I8  case
            floatVal unsignedCast if i8  cast.u i64 cast.u else i8  cast.s i64 cast.s end
            ConstValue .Int return
          I16 case
            floatVal unsignedCast if i16 cast.u i64 cast.u else i16 cast.s i64 cast.s end
            ConstValue .Int return
          I32 case
            floatVal unsignedCast if i32 cast.u i64 cast.u else i32 cast.s i64 cast.s end
            ConstValue .Int return
          I64 case
            floatVal unsignedCast if i64 cast.u else i64 cast.s end
            ConstValue .Int return
          BOOL F32 F64 TYPE CHAR8 CHAR16 CHAR32 case ..unreachable
        end
      else unsignedCast _if
        floatVal i64 cast.u ConstValue .Int return
      else
        floatVal i64 cast.s ConstValue .Int return
      end
    end
    ## XXX? zero/sign extend small types
    oldValue .?Int .if =:: mut: intVal
      srcType typeContext types.unwrapNamed types.isPrimitive if
        srcType typeContext types.primitiveValue switch
          I8  CHAR8  case intVal i8 cast
            unsignedCast if i64 cast.u else i64 cast.s end intVal= break
          I16 CHAR16 case intVal i16 cast
            unsignedCast if i64 cast.u else i64 cast.s end intVal= break
          I32 CHAR32 case intVal i32 cast
            unsignedCast if i64 cast.u else i64 cast.s end intVal= break
          F32 F64 case break ## XXX? handle precission loss due to representing int as float
          I64 case break ## no change neccessary
          BOOL TYPE case ..unreachable
        end
      end
      ## uint -> float
      targetType typeContext types.isFloat and signType .UNSIGNED or srcType typeContext types.isUnsignedInt if
        intVal f64 cast.u ConstValue .Float return
      else
        intVal ConstValue .Int return
      end
    else ..drop end
    ## TODO? special handling for int <-> pointer
    ## TODO? convert primitive arrays to correct array type?
    oldValue return
  end
  proc(
    ConstValue : value
    ValueInfo : valInfo
    i32 : elementIndex
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> bool ) =>: getElement
    context [] .program =:: program
    program .errors =:: errors
    program .idContext =:: idContext
    idContext .constContext =:: constContext
    idContext .typeContext =:: typeContext
    false =:: mut: isPtr
      ## TODO! use correct base mutablity
    true =:: mut: eltMutable ## XXX is it possible to ignore pointer mutability in interpreter?
    valInfo .valueType
      $ typeContext types.isPointer if
        $ typeContext types.isMutable eltMutable & eltMutable=
        typeContext types.getBaseType
        true isPtr=
      end
      elementIndex typeContext types.compositeGetElement
      isPtr if eltMutable typeContext types.getAddressType end
    =:: eltType
    ## TODO? support (Local)Array8 ... Array64
    value
      .?LocalValue .if ConstValue ptr.mut cast [] end
    =:: containerValue
    containerValue .?Array .if
      elementIndex slice.get .else
        "pointer read out of bounds" sb.copyPtr pos errors appendError
        true return
      end
    else .?LocalArray ._if
      ConstValue slice.mut cast
        elementIndex slice.at .else
          "pointer read out of bounds" sb.copyPtr pos errors appendError
          true return
        end
      ## TODO proc for checking if value is Local
      isPtr and $ [] .?LocalValue ? ! and $ [] .?LocalArray ? ! and $ [] .?LocalArray8 ? ! and
          $ [] .?LocalArray16 ? ! and $ [] .?LocalArray32 ? ! and $ [] .?LocalArray64 ? ! if
        LocalAddress cast ConstValue .LocalValue
      else [] end
    else .?Union ? _if
      containerValue elementIndex constUnionElement if
        "union index (" sb.copyPtr
          elementIndex sb.appendI
          ") does not match current value (" sb.appendS
          containerValue .Union .eltIndex sb.appendI
          ")" sb.appendS
        pos errors appendError
      end
    else
      "unexpected value for composite constant: " sb.copyPtr
        containerValue typeContext sb.appendConstant
      pos errors appendError
      ## unpopValue
        value
        valInfo
      context unpopValue
      true return
    end =:: eltValue
    ## pushValue
      eltValue
      eltType
      pos
    context pushValue
    false return
  end
  proc(
    ConstValue : value
    ValueInfo : valInfo
    i32 : elementIndex
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> bool ) =>: setElement
    context [] .program =:: program
    program .errors =:: errors
    program .idContext =:: idContext
    idContext .constContext =:: constContext
    idContext .typeContext =:: typeContext
    false =:: mut: isPtr
      ## TODO! use correct base mutablity
    true =:: mut: eltMutable ## XXX is it possible to ignore pointer mutability in interpreter?
    valInfo .valueType
      $ typeContext types.isPointer if
        $ typeContext types.isMutable eltMutable & eltMutable=
        typeContext types.getBaseType
        true isPtr=
      end
      elementIndex typeContext types.compositeGetElement
    =:: eltType
    eltMutable ! if
      ## XXX? better message
      "cannot write to immutable structure element" sb.copyPtr
      pos errors appendError
      value valInfo context unpopValue
      true return
    end
    pos context popValue if ..drop.2
      ## unpopValue
        value
        valInfo
      context unpopValue
      true return
    end =:: newValue =:: newValInfo
    newValInfo .valueType eltType typeContext types.canAutoCast ! if
      "cannot assign value of type " sb.copyPtr
        newValInfo .valueType typeContext sb.appendType
        " to element of type " sb.appendS
        eltType typeContext sb.appendType
      pos errors appendError
      newValue newValInfo context unpopValue
      value valInfo context unpopValue
      true return
    end
    value
      .?LocalValue .if ConstValue ptr.mut cast [] end
    =:: containerValue
    ## XXX? support (Local)Array8 ...  Array64
    containerValue .?Array .if =:: arrayValue
      context [] .localMemory
        arrayValue mixedArena.copySlice =:: localAddress
      context .localMemory=
      newValue localAddress elementIndex slice.set
      localAddress LocalSlice cast ConstValue .LocalArray
    else .?LocalArray ._if =:: arrayValue
      newValue
        arrayValue ConstValue slice.mut cast
      elementIndex slice.set
      containerValue
    else .?Union ? _if
      newValue elementIndex constContext newUnionConst
    else
      "unexpected value for writable constant: " sb.copyPtr
        containerValue typeContext sb.appendConstant
      pos errors appendError
      newValue newValInfo context unpopValue
      containerValue valInfo context unpopValue
      true return
    end =:: newContainer
    value .?LocalValue .if
      newContainer >$ ConstValue ptr.mut cast =[]
      true
    else ..drop false end =:: wrapped
    isPtr ! if
      ## pushValue
        wrapped if value else newContainer end
        valInfo .valueType
        pos
      context pushValue
    end
    false return
  end
  ## TODO try merging slice.. / Localslice.. code (? is there a good generic signature)
  proc(
    ConstValue : localArray
    Type : valType
    MixedArenaAllocator ptr.mut : allocator
    ProgramContext ptr.mut : program
  -> ConstValue ) =>: copyLocalArray
    program .idContext .typeContext =:: typeContext
    program .idContext .constContext =:: constContext
    valType typeContext types.isPointer if
      ## don't copy pointers
      localArray return
    end
    ConstValue ..length 23:iSize == "no new constants" assert
    localArray switch
      LocalArray case break
      LocalArray8 case
        localArray .LocalArray8 i8 slice.mut cast =:: arrayData
        localArray .LocalArray8 .length 1:iSize == and valType typeContext types.isIntLike if
          arrayData 0 [] i64 cast.u ConstValue .Int return
        end
        allocator []
          arrayData mixedArena.copyMutableSlice =:: tmpArray
        allocator =[]
        tmpArray slice.freeze constContext newArray8Const return
      LocalArray16 case
        localArray .LocalArray16 i16 slice.mut cast =:: arrayData
        arrayData .length 1:iSize == and valType typeContext types.isIntLike if
          arrayData 0 [] i64 cast.u ConstValue .Int return
        end
        allocator []
          arrayData mixedArena.copyMutableSlice =:: tmpArray
        allocator =[]
        tmpArray slice.freeze constContext newArray16Const return
      LocalArray32 case
        localArray .LocalArray32 i32 slice.mut cast =:: arrayData
        arrayData .length 1:iSize == and valType typeContext types.isIntLike if
          arrayData 0 [] i64 cast.u ConstValue .Int return
        end
        allocator []
          arrayData mixedArena.copyMutableSlice =:: tmpArray
        allocator =[]
        tmpArray slice.freeze constContext newArray32Const return
      LocalArray64 case
        localArray .LocalArray64 i64 slice.mut cast =:: arrayData
        arrayData .length 1:iSize == and valType typeContext types.isIntLike if
          arrayData 0 [] ConstValue .Int return
        end
        allocator []
          arrayData mixedArena.copyMutableSlice =:: tmpArray
        allocator =[]
        tmpArray slice.freeze constContext newArray64Const return
      default ..unreachable
    end
    localArray .LocalArray ConstValue slice.mut cast =:: dataArray
    allocator []
      dataArray mixedArena.copyMutableSlice =:: tmpArray
    allocator =[]
    valType typeContext types.getBaseType =:: arrayBase
    ## 1. copy elements
    dataArray .length for =:: i
      dataArray i [] =:: elt
      arrayBase .?Undefined ? ! if
        arrayBase
      else
        valType i i32 cast typeContext types.compositeGetElement
      end =:: eltType
      ConstValue ..length 23:iSize == "no new constants" assert
      elt switch
        LocalValue case elt .LocalValue ConstValue ptr.mut cast [] break
        LocalArray LocalArray8 LocalArray16 LocalArray32 LocalArray64 case
          elt eltType allocator program copyLocalArray break
        default elt break
      end tmpArray i slice.set
    end
    ## TODO find a way to avoid recreation of identical constants
    tmpArray slice.freeze constContext newArrayConst
  end
  proc(
    ConstValue : value
    Type : valType
    bool : wrapPointers
    InterpreterContext ptr.mut : context
  -> ConstValue ) =>: localCopy
    context [] .program .idContext .typeContext =:: typeContext
    valType typeContext types.isPointer if ## XXX? merge with default branch
      wrapPointers ! if
        value return
      end
      context [] .localMemory
        value mixedArena.copyValue =:: localAddress
      context .localMemory=
      localAddress LocalAddress cast ConstValue .LocalValue return
    end
    ConstValue ..length 23:iSize == "no new constants" assert
    value switch
      Array LocalArray case break
      Array8 case
        context [] .localMemory
          value .Array8 mixedArena.copySlice =:: localAddress
        context .localMemory=
        localAddress LocalSlice8 cast ConstValue .LocalArray8
        return
      LocalArray8 case
        context [] .localMemory
          value .LocalArray8 i8 slice.mut cast mixedArena.copyMutableSlice =:: localAddress
        context .localMemory=
        localAddress LocalSlice8 cast ConstValue .LocalArray8
        return
      Array16 case
        context [] .localMemory
          value .Array16 mixedArena.copySlice =:: localAddress
        context .localMemory=
        localAddress LocalSlice16 cast ConstValue .LocalArray16
        return
      LocalArray16 case
        context [] .localMemory
          value .LocalArray16 i16 slice.mut cast mixedArena.copyMutableSlice =:: localAddress
        context .localMemory=
        localAddress LocalSlice16 cast ConstValue .LocalArray16
        return
      Array32 case
        context [] .localMemory
          value .Array32 mixedArena.copySlice =:: localAddress
        context .localMemory=
        localAddress LocalSlice32 cast ConstValue .LocalArray32
        return
      LocalArray32 case
        context [] .localMemory
          value .LocalArray32 i32 slice.mut cast mixedArena.copyMutableSlice =:: localAddress
        context .localMemory=
        localAddress LocalSlice32 cast ConstValue .LocalArray32
        return
      Array64 case
        context [] .localMemory
          value .Array64 mixedArena.copySlice =:: localAddress
        context .localMemory=
        localAddress LocalSlice64 cast ConstValue .LocalArray64
        return
      LocalArray64 case
        context [] .localMemory
          value .LocalArray64 i64 slice.mut cast mixedArena.copyMutableSlice =:: localAddress
        context .localMemory=
        localAddress LocalSlice64 cast ConstValue .LocalArray64
        return
      ## TODO? replace union element by local copy
      default
        context [] .localMemory
          value mixedArena.copyValue =:: localAddress
        context .localMemory=
        localAddress LocalAddress cast ConstValue .LocalValue
        return
    end
    context [] .localMemory
      value .?Array .else
        .?LocalArray ._if ConstValue slice.mut cast slice.freeze
      else ..unreachable end mixedArena.copySlice =:: localSlice
    context .localMemory=
    valType typeContext types.getBaseType =:: arrayBase
    ## copy sub-arrays
    localSlice .length for =:: i
      localSlice i slice.at .data =:: elt
      arrayBase .?Undefined ? ! if
        arrayBase
      else
        valType i i32 cast typeContext types.compositeGetElement
      end =:: eltType
      elt [] .?Array ? if
        elt []
          eltType false context localCopy
        elt =[]
      end
    end
    localSlice LocalSlice cast ConstValue .LocalArray
  end
  proc(
    Type : dataType
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> ConstValue ) =>: allocLocalValue
    context [] .program =:: program
    program .errors =:: errors
    program .idContext .typeContext =:: typeContext
    ## XXX? better way to detect multi-value types
    dataType typeContext types.isTuple if
      dataType typeContext types.compositeEltCount =:: eltCount
      context [] .localMemory
        eltCount i32 cast ConstValue mixedArena.allocSlice =:: localSlice
      context .localMemory=
      eltCount for =:: i
        dataType i typeContext types.compositeGetElement =:: eltType
        eltType typeContext types.isTuple or eltType typeContext types.isArray if
          eltType pos context allocLocalValue
        else
          ConstValue .None
        end localSlice i slice.set
      end
      localSlice LocalSlice cast ConstValue .LocalArray return
    else dataType typeContext types.isArray _if
      ## XXX? merge with previous case
      dataType typeContext types.getArraySize .?Int .else ..drop
        "generic arrays are not supported" sb.copyPtr
        pos errors appendError
        0
      end =:: eltCount
      dataType typeContext types.getBaseType =:: eltType
      eltType typeContext types.unwrapNamed =:: eltBase
      eltBase types.isPrimitive if
        eltBase typeContext types.primitiveValue switch
          BOOL I8 CHAR8 case
            context [] .localMemory
              eltCount i32 cast i8 mixedArena.allocSlice =:: localSlice
            context .localMemory=
            0:i8 localSlice slice.fill
            localSlice LocalSlice8 cast ConstValue .LocalArray8 return
          I16 CHAR16 case
            context [] .localMemory
              eltCount i32 cast i16 mixedArena.allocSlice =:: localSlice
            context .localMemory=
            0:i16 localSlice slice.fill
            localSlice LocalSlice16 cast ConstValue .LocalArray16 return
          I32 CHAR32 case
            context [] .localMemory
              eltCount i32 cast i32 mixedArena.allocSlice =:: localSlice
            context .localMemory=
            0:i32 localSlice slice.fill
            localSlice LocalSlice32 cast ConstValue .LocalArray32 return
          I64 case
            context [] .localMemory
              eltCount i32 cast i64 mixedArena.allocSlice =:: localSlice
            context .localMemory=
            0:i64 localSlice slice.fill
            localSlice LocalSlice64 cast ConstValue .LocalArray64 return
          F32 F64 TYPE case break ## XXX? store float arrays in Array32/Array64
        end
      end
      context [] .localMemory
        eltCount i32 cast ConstValue mixedArena.allocSlice =:: localSlice
      context .localMemory=
      eltType typeContext types.isTuple or eltType typeContext types.isArray if
        eltCount for =:: i
          ## slice.set
            eltType pos context allocLocalValue
          localSlice i slice.set
        end
      else
        ConstValue .None localSlice slice.fill
      end
      localSlice LocalSlice cast ConstValue .LocalArray return
    else
      context [] .localMemory
        ConstValue .None mixedArena.copyValue =:: localAddress
      context .localMemory=
      localAddress LocalAddress cast ConstValue .LocalValue return
    end
  end
  proc(
    type : auto: W
    ConstValue : src
    W : localArray
    type : T
  -> bool ) =>: primitiveArrayTrySetElement
    localArray T slice.mut cast =:: arrayData
    ConstValue ..length 23 == "no new constants" assert
    src switch
      Char case src .Char i64 cast.u break
      Int case src .Int break
      ## XXX? support generic args
      ## XXX? support floats?
      ## XXX? support primitive values
      default false return
    end =:: intValue
    intValue T cast arrayData 0 slice.set
    true return
  end
  union(
    _ : Ok
    _ : Error
    JumpDistance : Jump
    _ : Return
  ) =:: EvalResult
  proc( bool -> EvalResult ) =>: wrapResult
    if EvalResult .Error else EvalResult .Ok end
  end
  proc(
    type : auto: W type : auto: T
    W : targetArray
    T slice : srcArray
    FilePosition : pos
    CompilerError list ptr.mut : errors
  -> EvalResult ) =>: setLocalArray
    srcArray .length targetArray .length != if
      "invalid array length for assignment expected " sb.copyPtr
        targetArray .length sb.appendI
        " got:" sb.appendS
        srcArray .length sb.appendI
      pos errors appendError
      EvalResult .Error return
    end
    targetArray .data srcArray .data != if
      targetArray .data srcArray .data srcArray .length mem.copy ..drop
    end
    EvalResult .Ok return
  end
  ## TODO try to (partially) merge with typeCheck.printType
  proc(
    bool : printValues
    i32 : maxCount
    i32 : depth
    InterpreterContext ptr.mut : context
  -> ) =>: printTypes
    context [] .program .idContext =:: idContext
    idContext .typeContext =:: typeContext
    typeContext .labelContext =:: labelContext
    idContext .constContext =:: constContext
    printValues if
      "stack:\n" sb.copyPtr
    else
      "types:\n" sb.copyPtr
    end
      "-----------------\n" sb.appendS
    =:: mut: sb
    ## TODO? print only up to some stack offset
    maxCount 0 > if
      context [] .stack .length
        maxCount iSize cast.u -
      0:iSize iSize.smax
    else 0:iSize end =:: minOffset
    context [] .stack .length 1:iSize - while $ minOffset iSize.sge do =:: i
      context [] .stack i list.at .data =:: value
      context [] .stackInfo i list.at .data =:: valueInfo
      sb
        valueInfo [] .valueType
          typeContext
          depth
        sb.appendTypeRecursive
        printValues if
          value [] .?None ? ! if
            " { " sb.appendS
            value [] typeContext sb.appendConstant
            " }" sb.appendS
          end
          " pushed at " sb.appendS
          valueInfo [] .pushedAt sb.appendPos
        end
        '\n' sb.appendC
      sb=
    finally i 1:iSize - end ..drop
    sb
      "-----------------\n" sb.appendS
      io.stdOut $1 io.fputSb ..drop
    sb.free ..drop
  end
end

proc(
  Operation ptr : op
  InterpreterContext ptr.mut : context
->
  interpreter.EvalResult
) =>: export: evaluateOperation
  using interpreter.
  context [] .program .errors =:: errors
  context [] .program =:: program
  context [] .program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  op [] .val switch
    NOP case
      EvalResult .Ok return
    Constant .case =:: constVal
      constVal .?GenericArg .and =:: label
          context [] .localVariables .if
        label map.get =:: value?
        value? optional.isEmpty if
          "missing value for " sb.copyPtr
            op [] .val .GetId labelContext sb.appendIdInfo
          op [] .pos errors appendError
          EvalResult .Error return
        end
        ## pushValue
          value? .data .value
          op [] .dataType
          op [] .pos
        context pushValue
        EvalResult .Ok return
      end
      ## pushValue
        constVal
        op [] .dataType
        op [] .pos
      context pushValue
      EvalResult .Ok return
    Return case
      ## XXX? check if in procedure
      EvalResult .Return return
    InlineReturn case
      "unimplemented" ..panic
    Block .case =:: blockInfo
      blockInfo .blockType switch
        TYPE_TUPLE TYPE_STRUCT TYPE_ENUM TYPE_UNION TYPE_UNTAGGED_UNION
        TYPE_PROC_IN TYPE_CPROC_IN TYPE_COMPOSITE TYPE_SETTYPE
        INITIALIZER TYPE_PROC_ARROW PROCEDURE INLINE_PROCEDURE NAMESPACE OVERLOAD case
          "unsupported block-type in constant evaluation: " sb.copyPtr
            blockInfo .blockType sb.appendBlockType
          op [] .pos errors appendError
          EvalResult .Error return
        ## TODO use jumps from blocks
        IF case
          op [] .pos context popCondition if ..drop
            EvalResult .Error return
          end =:: val
          blockInfo .jumpDistance 0:JumpDistance == if
            "jump distance should be non-zero" sb.copyPtr
            op [] .pos errors appendError
            EvalResult .Error return
          end
          val if
            EvalResult .Ok return
          else
            blockInfo .jumpDistance EvalResult .Jump return
          end
          break
        ELSE case
          blockInfo .jumpDistance 0:JumpDistance == if
            "jump distance should be non-zero" sb.copyPtr
            op [] .pos errors appendError
            EvalResult .Error return
          end
          blockInfo .jumpDistance EvalResult .Jump return
        AND OR AND_IF OR_IF case
          op [] .pos context popCondition if ..drop
            EvalResult .Error return
          end =:: val
          blockInfo .jumpDistance 0:JumpDistance == if
            "jump distance should be non-zero" sb.copyPtr
            op [] .pos errors appendError
            EvalResult .Error return
          end
          blockInfo .blockType =:: blockType
          blockType .OR_IF or blockType .OR end =:: isOr
          val isOr == if
            ## TODO? does this value get lost when poping the and-or block
            blockType .AND or blockType .OR if
              val ConstValue .Bool types.primitive.BOOL op [] .pos context pushValue
            end
            blockInfo .jumpDistance EvalResult .Jump return
          else
            EvalResult .Ok return
          end
          break
        WHILE FINALLY case
          EvalResult .Ok return
        DO AND_DO case
          blockInfo .jumpDistance 0:JumpDistance == if
            "jump distance should be non-zero" sb.copyPtr
            op [] .pos errors appendError
            EvalResult .Error return
          end
          op [] .pos context popCondition if ..drop
            EvalResult .Error return
          end if
            EvalResult .Ok return
          else
            blockInfo .jumpDistance EvalResult .Jump return
          end
          break
        OR_DO case
          blockInfo .jumpDistance 0:JumpDistance == if
            "jump distance should be non-zero" sb.copyPtr
            op [] .pos errors appendError
            EvalResult .Error return
          end
          op [] .pos context popCondition if ..drop
            EvalResult .Error return
          end if
            blockInfo .jumpDistance EvalResult .Jump return
          else
            EvalResult .Ok return
          end
          break
        BREAK CONTINUE BREAK_SWITCH case
          blockInfo .jumpDistance 0:JumpDistance == if
            "jump distance should be non-zero" sb.copyPtr
            op [] .pos errors appendError
            EvalResult .Error return
          end
          blockInfo .jumpDistance EvalResult .Jump return
          break
        SWITCH case
          op [] .pos context popValue if ..drop.2
            "stack underflow while evaluating operation: " sb.copyPtr
              op [] program sb.appendOp
            op [] .pos errors appendError
            EvalResult .Error return
          end
            $ .?Union ? if constUnionLabel end
          =:: switchValue ..drop
          program [] .switchData
            blockInfo .blockId i64 cast.u
          list.at .data =:: switchData
          switchData [] .switchType =:: switchType
          switchData [] .labels .length for =:: i
            switchData [] .labels i list.at .data =:: label
            label [] .value switchValue switchType typeContext operatorEq if
              "cannot check equality of switch value " sb.copyPtr
                switchValue typeContext sb.appendConstant
                " with label " sb.appendS
                label [] .value typeContext sb.appendConstant
              op [] .pos errors appendError
            end if
              switchData [] .caseJumpDistances
                label [] .caseId []
              EvalResult .Jump return
            end
          end
          switchData [] .defaultJumpDistance EvalResult .Jump return
          break
        IF_TRUE IF_FALSE AND_TRUE AND_FALSE
        OR_TRUE OR_FALSE ELSE_TRUE ELSE_FALSE
        CASE DOT_CASE DEFAULT UNKNOWN case break
      end
      "unsupported block-type in constant evaluation: " sb.copyPtr
        blockInfo .blockType sb.appendBlockType
      op [] .pos errors appendError
      EvalResult .Error return
    BlockEnd .case =:: blockInfo
      blockInfo .blockType =:: blockType
      BlockType ..length 42:iSize == "no-new block-types" assert
      blockType switch
        ELSE SWITCH AND OR case EvalResult .Ok return
        WHILE case
          blockInfo .jumpDistance 0:JumpDistance == if
            "jump distance should be non-zero" sb.copyPtr
            op [] .pos errors appendError
            EvalResult .Error return
          end
          blockInfo .jumpDistance EvalResult .Jump return
        default break
      end
      break
    DeclareId .case =:: idInfo
      idInfo .labelId =:: labelId
      idInfo .idType switch
        GLOBAL_VAR TYPE case
          break
        LOCAL_VAR TMP_VAR ITR_VAR case
          ## XXX? common procedure for resolving of auto-types
          op [] .dataType =:: dataType
          context [] .localVariables optional.isEmpty if
            "missing local variables " sb.copyPtr
            op [] .pos errors appendError
            EvalResult .Error return
          end
          context [] .localVariables .data
            labelId
            ## Constant
              dataType op [] .pos context allocLocalValue
              ## ValueInfo
                dataType
                op [] .pos
              ValueInfo new
            Constant new
          map.put ..drop
          EvalResult .Ok return
        LABEL ARGUMENT PROCEDURE PROCEDURE_BUNDLE case break
      end
      "unsupported operation in constant evaluation: " sb.copyPtr
        op [] program sb.appendOp
      op [] .pos errors appendError
      EvalResult .Error return
    GetName case
      "unsupported operation in constant evaluation: " sb.copyPtr
        op [] program sb.appendOp
      op [] .pos errors appendError
      EvalResult .Error return
    GetId .case =:: idInfo
      idInfo .labelId =:: label
      idInfo .idType switch
        PROCEDURE PROCEDURE_BUNDLE case
          "unresolved call " sb.copyPtr
          op [] .pos errors appendError
          EvalResult .Error return
        LOCAL_VAR ARGUMENT TMP_VAR ITR_VAR case
          context [] .localVariables optional.isEmpty if
            "missing local variables " sb.copyPtr
            op [] .pos errors appendError
            EvalResult .Error return
          end
          context [] .localVariables .data label map.get =:: value?
          value? optional.isEmpty if
            "missing value for " sb.copyPtr
              idInfo labelContext sb.appendIdInfo
            op [] .pos errors appendError
            EvalResult .Error return
          end
          value? .data =:: value
          value .value value .info .valueType op [] .pos context pushValue
          EvalResult .Ok return
        LABEL case
          context [] .localVariables optional.hasData if
            context [] .localVariables .data
          else
            context .globalVariables
          end label map.get =:: value?
          value? optional.isEmpty if
            "missing value for " sb.copyPtr
              idInfo labelContext sb.appendIdInfo
            op [] .pos errors appendError
            EvalResult .Error return
          end
          value? .data =:: value
          value .value value .info .valueType op [] .pos context pushValue
          EvalResult .Ok return
        TYPE GLOBAL_VAR case
          label
            idContext
          id.getIdentifier if ..drop
            "could not find identifier: " sb.copyPtr
              label labelContext sb.appendLabelPath
            op [] .pos errors appendError
            EvalResult .Error return ## unknown identifier
          end =:: idData
          idData [] .labelId labelContext id.labelFlags id.FLAG_MUTABLE & ? if
            "mutable global variables are not supported: " sb.copyPtr
              label labelContext sb.appendLabelPath
            op [] .pos errors appendError
            ## compile-time evaluation of mutable global variables not supported
            EvalResult .Error return
          end
          idData [] .constValue .?None ? if
            "identifier " sb.copyPtr
              label labelContext sb.appendLabelPath
              " has not been initialized" sb.appendS
            op [] .pos errors appendError
            EvalResult .Error return
          end
          idData [] .constValue idData [] .valueType op [] .pos context pushValue
          EvalResult .Ok return
      end
      break
    AtId .case =:: idInfo
      idInfo .labelId =:: label
      idInfo .idType switch
        LOCAL_VAR ARGUMENT TMP_VAR ITR_VAR case
          ## XXX? extract common code with getId to procedure
          context [] .localVariables optional.isEmpty if
            "missing local variables " sb.copyPtr
            op [] .pos errors appendError
            EvalResult .Error return
          end
          context [] .localVariables .data label map.get =:: value?
          value? optional.isEmpty if
            "missing value for " sb.copyPtr
              idInfo labelContext sb.appendIdInfo
            op [] .pos errors appendError
            EvalResult .Error return
          end
          value? .data =:: value
          label labelContext id.labelFlags id.FLAG_MUTABLE & ? =:: isMutable
          ## pushValue
            value .value
            value .info .valueType isMutable typeContext types.getAddressType
          op [] .pos context pushValue
          EvalResult .Ok return
        PROCEDURE case
          label idContext id.getIdentifier if ..drop
            "could not find " sb.copyPtr
              idInfo labelContext sb.appendIdInfo
            op [] .pos errors appendError
            EvalResult .Error return
          end =:: idData
          idData [] .constValue .?Procedure .else ..drop
            "could not determine id of procedure" sb.copyPtr
              label labelContext sb.appendLabelName
            op [] .pos errors appendError
            EvalResult .Error return
          end =:: procVal
          ## pushValue
            idData .constValue []
            program [] .procedures
              procVal i64 cast list.at .data
            [] .procType false typeContext types.getAddressType
            op [] .pos
          context pushValue
          EvalResult .Ok return
        PROCEDURE_BUNDLE
        TYPE GLOBAL_VAR LABEL case
          "unsupported operation in constant evaluation: " sb.copyPtr
            op [] program sb.appendOp
          op [] .pos errors appendError
          EvalResult .Error return
      end
      break
    SetId .case =:: idInfo
      idInfo .labelId =:: label
      label
        labelContext id.labelFlags id.FLAG_MUTABLE & ?
      "setId only created for mutable identifiers" assert
      op [] .pos context popValue if ..drop.2
        "stack underflow while evaluating operation: " sb.copyPtr
          op [] program sb.appendOp
        op [] .pos errors appendError
        EvalResult .Error return
      end =:: value =:: valInfo
      valInfo .valueType op [] .dataType typeContext types.canAutoCast ! if
        value valInfo context unpopValue
        "cannot assign values of type " sb.copyPtr
          valInfo .valueType typeContext sb.appendType
          " to variable of type " sb.appendS
          op [] .dataType typeContext sb.appendType
        op [] .pos errors appendError
        EvalResult .Error return
      end
      ## TODO? is it neccessary to cast value
      idInfo .idType switch
        LOCAL_VAR ARGUMENT TMP_VAR ITR_VAR case
          context [] .localVariables optional.isEmpty if
            value valInfo context unpopValue
            "missing local variables " sb.copyPtr
            op [] .pos errors appendError
            EvalResult .Error return
          end
          context [] .localVariables .data
            label
            value valInfo Constant new
          map.put ..drop
          EvalResult .Ok return
        TYPE GLOBAL_VAR case
          label
            idContext
          id.getIdentifier if ..drop
            value valInfo context unpopValue
            "could not find identifier: " sb.copyPtr
              label labelContext sb.appendLabelPath
            op [] .pos errors appendError
            EvalResult .Error return ## unknown identifier
          end =:: idData
          value idData .constValue=
          EvalResult .Ok return
        PROCEDURE PROCEDURE_BUNDLE LABEL case
          value valInfo context unpopValue
          "unsupported operation in constant evaluation: " sb.copyPtr
            op [] program sb.appendOp
          op [] .pos errors appendError
          EvalResult .Error return
      end
      break
    Call .case =:: callInfo
      callInfo .procId
        callInfo .implementationId
        op [] .dataType
        callInfo program getCallData [] .autoArgs
      op [] .pos context interpreter.evaluateCall wrapResult return
    InitializeId AutoTypedInitializeId .case =:: idInfo
      idInfo .labelId =:: label
      op [] .pos context popValue if ..drop.2
        "stack underflow while evaluating operation: " sb.copyPtr
          op [] program sb.appendOp
        op [] .pos errors appendError
        EvalResult .Error return
      end =:: value =:: valInfo
      idInfo .idType switch
        GLOBAL_VAR TYPE case
          context .globalVariables
            label
            ## Constant
              value
              ## ValueInfo
                valInfo .valueType
                op [] .pos
              ValueInfo new
            Constant new
          map.put ..drop
          EvalResult .Ok return
        LOCAL_VAR LABEL TMP_VAR ITR_VAR case
          context [] .localVariables optional.isEmpty if
            "missing local variables " sb.copyPtr
            op [] .pos errors appendError
            EvalResult .Error return
          end
          context [] .localVariables .data
            label
            ## Constant
              label labelContext id.labelFlags id.FLAG_MUTABLE & ? if
                value valInfo .valueType true context localCopy
              else
                value
              end
              ## ValueInfo
                valInfo .valueType
                op [] .pos
              ValueInfo new
            Constant new
          map.put ..drop
          EvalResult .Ok return
        ARGUMENT PROCEDURE PROCEDURE_BUNDLE case
          value valInfo context unpopValue
          "unsupported operation in constant evaluation: " sb.copyPtr
            op [] program sb.appendOp
          op [] .pos errors appendError
          EvalResult .Error return
      end
      break
    GetUnionLabel case "unimplemented" ..panic
    GetLabel SetLabel .case =:: labelId
      op [] .val .?SetLabel ? =:: isWrite
      op [] .pos context popValue if ..drop.2
        "stack underflow while evaluating operation: " sb.copyPtr
          op [] program sb.appendOp
        op [] .pos errors appendError
        EvalResult .Error return
      end =:: value =:: valInfo
      value .?TypeId .and =:: typeId
          typeId typeContext types.isEnumOrTaggedUnion if
        typeId true
      else
        valInfo .valueType false
      end  =:: isType =:: containerType
      ## enum/union element initializer
      containerType
        labelId
      typeContext types.compositeFindLabel $ ? if .data else ..drop
        "type " sb.copyPtr
          containerType typeContext sb.appendType
          " does not have a label \"" sb.appendS
          labelId labelContext sb.appendLabelName
          '"' sb.appendC
        op [] .pos errors appendError
        EvalResult .Error return
      end =:: elementIndex
      containerType elementIndex typeContext types.compositeGetElement =:: eltType
      isType if
        eltType .?Empty ? if
          ## pushValue
            containerType typeContext types.isEnum if
              elementIndex ConstValue .EnumLabel
            else
              ConstValue .None elementIndex constContext newUnionConst
            end
            containerType
            op [] .pos
          context pushValue
          EvalResult .Ok return
        end
        op [] .pos context popValue if ..drop.2
          "stack underflow while evaluating operation: " sb.copyPtr
            op [] program sb.appendOp
          op [] .pos errors appendError
          EvalResult .Error return
        end =:: eltValue =:: eltValInfo
        eltValInfo .valueType eltType typeContext types.canAutoCast if
          ## pushValue
            eltValue elementIndex constContext newUnionConst
            containerType
            op [] .pos
          context pushValue
          EvalResult .Ok return
        end
        ## unpopValue
          eltValue
          eltValInfo
        context unpopValue
        "wrong value for union element, expected " sb.copyPtr
          eltType typeContext sb.appendType
          " got " sb.appendS
          eltValInfo .valueType typeContext sb.appendType
        op [] .pos errors appendError
        EvalResult .Error return
      end
      isWrite if
        value valInfo elementIndex op [] .pos context setElement wrapResult return
      end
      value valInfo elementIndex op [] .pos context getElement wrapResult return
    GetUnionElement case "unimplemented: get union element" ..panic
    GetElement SetElement SetEnumElement .case =:: eltIndex
      op [] .pos context popValue if ..drop.2
        "stack underflow while evaluating operation: " sb.copyPtr
          op [] program sb.appendOp
        op [] .pos errors appendError
        EvalResult .Error return
      end =:: value =:: valInfo
      op [] .val .?GetElement ? ! =:: isWrite
      isWrite if
        value valInfo eltIndex op [] .pos context setElement wrapResult return
      end
      value valInfo eltIndex op [] .pos context getElement wrapResult return
    HasElement .case =:: expectedIndex
      op [] .pos context popValue if ..drop.2
        "stack underflow while evaluating operation: " sb.copyPtr
          op [] program sb.appendOp
        op [] .pos errors appendError
        EvalResult .Error return
      end =:: value =:: valInfo
      value .?EnumLabel .if
        expectedIndex == ConstValue .Bool
      else .?Union ? _if
        value constUnionLabel .EnumLabel expectedIndex == ConstValue .Bool
      else
        value valInfo context unpopValue
        "unexpected value for hasElement: " sb.copyPtr
          value typeContext sb.appendConstant
        op [] .pos errors appendError
        EvalResult .Error return
      end
        types.primitive.BOOL
        op [] .pos
      context pushValue
      EvalResult .Ok return
    ExistsName .case =:: label
      label idContext id.findIdentifierByLabel ! =:: exists
      ..drop
      ## pushValue
        exists ConstValue .Bool
        types.primitive.BOOL
        op [] .pos
      context pushValue
      EvalResult .Ok return
    AtName SetName ExistsLabel DeclareName AliasName InitializeName UsingNamespace UsingIdentifier TypeWith TypeModifier case
      ## label/name should have been resolved in type-checker
      "unsupported operation in constant evaluation: " sb.copyPtr
        op [] program sb.appendOp
      op [] .pos errors appendError
      EvalResult .Error return
    New case
      Type : poppedType
      ValueInfo : valInfo
      false =:: mut: poppedValue
      op [] .dataType .?Undefined ? if
        op [] .pos context popType if ..drop.2
          EvalResult .Error return
        end poppedType= valInfo=
        poppedType typeContext types.containsGeneric if
          "creating generic tuples is not supported" sb.copyPtr
          op [] .pos errors appendError
          ## unpopValue
            poppedType ConstValue .TypeId
            valInfo
          context unpopValue
          EvalResult .Error return
        end
        true poppedValue=
        poppedType
      else
        op [] .dataType
      end =:: targetType
      targetType typeContext types.isArray if
        ## TODO support constant evaluation of new array
        "unsupported operation in constant evaluation: " sb.copyPtr
          op [] program sb.appendOp
        op [] .pos errors appendError
      else targetType typeContext types.isTuple _if
        ## separate if block to avoid printing general error message on failure
        targetType op [] .pos context newTuple ! if
          EvalResult .Ok return
        end
      else
        "unsupported operation in constant evaluation: " sb.copyPtr
          op [] program sb.appendOp
        op [] .pos errors appendError
      end
      poppedValue if
        ## unpopValue
          poppedType ConstValue .TypeId
          valInfo
        context unpopValue
      end
      EvalResult .Error return
    NewEnum case
      op [] .val .NewEnum =:: elementIndex
      op [] .dataType =:: unionType
      unionType typeContext types.isEnum if
        elementIndex ConstValue .EnumLabel
      else unionType typeContext types.isUnion _if
        unionType
          elementIndex
        typeContext types.compositeGetElement =:: eltType
        eltType .?Empty ? ! if
          op [] .pos context popValue if ..drop.2
            "missing argument for union element expected" sb.copyPtr
              eltType typeContext sb.appendType
            op [] .pos errors appendError
            EvalResult .Error return
          end =:: eltValue =:: eltInfo
          eltInfo .valueType eltType typeContext types.canAutoCast ! if
            eltValue eltInfo context unpopValue
            "wrong type for union element expected" sb.copyPtr
              eltType typeContext sb.appendType
              " got " sb.appendS
              eltInfo .valueType typeContext sb.appendType
            op [] .pos errors appendError
            EvalResult .Error return
          end
          eltValue elementIndex constContext newUnionConst
        else
          ConstValue .None elementIndex constContext newUnionConst
        end
      else
        "unexpected type for new enum: " sb.copyPtr
          unionType typeContext sb.appendType
        op [] .pos errors appendError
        EvalResult .Error return
      end
        unionType
        op [] .pos
        context
      pushValue
      EvalResult .Ok return
    Cast Cast! case
      Type : poppedType
      ValueInfo : valInfo
      false =:: mut: isPoppedType
      op [] .dataType .?Undefined ? if
        op [] .pos context popType if ..drop.2
          EvalResult .Error return
        end poppedType= valInfo=
        true isPoppedType=
        poppedType typeContext types.containsGeneric if
          "generic casts are not supported" sb.copyPtr
          op [] .pos errors appendError
          ## casting to genetic value not possible, reset stack
          ## unpopValue
            poppedType ConstValue .TypeId
            valInfo
          context unpopValue
          EvalResult .Error return
        end
        poppedType
      else
        op [] .dataType
      end =:: targetType
      op [] .pos context popValue if ..drop.2
        isPoppedType if
          ## unpopValue
            poppedType ConstValue .TypeId
            valInfo
          context unpopValue
        end
        EvalResult .Error return
      end =:: oldValue valInfo= ## can overwrite value info
      ## canCast
        valInfo .valueType
        targetType
        op [] .val .?Cast! ?
      typeContext types.canCast ! if
        "cannot cast " sb.copyPtr
          valInfo .valueType typeContext sb.appendType
          " to " sb.appendS
          targetType typeContext sb.appendType
        op [] .pos errors appendError
        EvalResult .Error return
      end
      op [] .val .?Cast .if
        .signType
      else ..drop
        SignType .NONE
      end =:: signType
      ## castConstant
        valInfo .valueType
        signType
        oldValue
        targetType
        typeContext
      castConstant =:: newValue
      ## pushValue
        newValue
        targetType
        op [] .pos
        context
      pushValue
      EvalResult .Ok return
    AutoCast .case =:: castInfo
      castInfo .offset 1 + iSize cast.u =:: offset
      offset
        "autoCast":s
      op [] .pos context checkStack if
        EvalResult .Error return
      end
      context [] .stack $ .length offset - [] =:: value
      castInfo .src
        SignType .NONE
        value
        op [] .dataType
      typeContext castConstant =:: newValue
      value context [] .stack $ .length offset - list.set
      ## ValueInfo
        op [] .dataType
        op [] .pos
      ValueInfo new context [] .stackInfo $ .length offset - list.set
      EvalResult .Ok return
    BitCast .case =:: src
      1:iSize "bitCast":s op [] .pos context checkStack if
        EvalResult .Error return
      end
      op [] .dataType =:: dst
      src typeContext types.unwrapNamed =:: rawSrc
      dst typeContext types.unwrapNamed =:: rawDst
      rawSrc rawDst types.typeEquals if
        ## simply rename type
        dst context [] .stackInfo $ .length 1:iSize - @[] .valueType=
        EvalResult .Ok return
      else rawSrc types.isPrimitive and rawDst types.isPrimitive _if
        rawSrc typeContext types.primitiveValue =:: srcPrimitive
        rawDst typeContext types.primitiveValue =:: dstPrimitive
        context [] .stack $ .length 1:iSize - @[] =:: stackVal
        srcPrimitive .F32 and dstPrimitive .I32 if
          stackVal []
            constAsFloat if ..drop
              "unexpected value for float: " sb.copyPtr
                stackVal [] typeContext sb.appendConstant
              op [] .pos errors appendError
              EvalResult .Error return
            end f32 cast i32 ..bitcast i64 cast ConstValue .Int
          stackVal =[]
          dst context [] .stackInfo $ .length 1:iSize - @[] .valueType=
          EvalResult .Ok return
        else srcPrimitive .F64 and dstPrimitive .I64 _if
          stackVal []
            constAsFloat if ..drop
              "unexpected value for float: " sb.copyPtr
                stackVal [] typeContext sb.appendConstant
              op [] .pos errors appendError
              EvalResult .Error return
            end f64 cast i64 ..bitcast ConstValue .Int
          stackVal =[]
          dst context [] .stackInfo $ .length 1:iSize - @[] .valueType=
          EvalResult .Ok return
        else srcPrimitive .I32 and dstPrimitive .F32 _if
          stackVal []
            constAsInt if ..drop
              "unexpected value for int: " sb.copyPtr
                stackVal [] typeContext sb.appendConstant
              op [] .pos errors appendError
              EvalResult .Error return
            end i32 cast f32 ..bitcast f64 cast ConstValue .Float
          stackVal =[]
          dst context [] .stackInfo $ .length 1:iSize - @[] .valueType=
          EvalResult .Ok return
        else srcPrimitive .I64 and dstPrimitive .F64 _if
          stackVal []
            constAsInt if ..drop
              "unexpected value for int: " sb.copyPtr
                stackVal [] typeContext sb.appendConstant
              op [] .pos errors appendError
              EvalResult .Error return
            end i64 cast f64 ..bitcast ConstValue .Float
          stackVal =[]
          dst context [] .stackInfo $ .length 1:iSize - @[] .valueType=
          EvalResult .Ok return
        end
      end
      ## TODO allow bitcast between types with same "shape" (layout of primitive values)
      "bitcast from " sb.copyPtr
        src typeContext sb.appendType
        " to " sb.appendS
        dst typeContext sb.appendType
        " is not supported at compile-time" sb.appendS
      op [] .pos errors appendError
      EvalResult .Error return
    Copy case
      context [] .stack list.peek =:: value?
      value? optional.hasData if
        context [] .stackInfo
          list.peek .data [] .valueType
        =:: valType
        ConstValue ..length 23:iSize == "no new constants" assert
        value? .data [] switch
          LocalValue case
            value? .data []
              .LocalValue ConstValue ptr.mut cast []
            value? .data =[]
            break
          LocalArray LocalArray8 LocalArray16 LocalArray32 LocalArray64 case
            context [] .localMemory mixedArena.offset =:: localOffset
            value? .data []
              valType context .localMemory program copyLocalArray
            value? .data =[]
            ## clear memory used by copy
            context [] .localMemory
              localOffset mixedArena.reset
            context .localMemory=
            break
          default break ## nothing to copy
        end
      end
      EvalResult .Ok return
    Assert RuntimeAssert case
      op [] .val .?RuntimeAssert .else ..drop
        true op [] .pos context popString if ..drop.2
          EvalResult .Error return
        end ..swap ..drop
      end =:: message
      op [] .pos context popValue if
        ..drop.2
        "missing argument for assert, expected boolean" sb.copyPtr
        op [] .pos errors appendError
        EvalResult .Error return
      end =:: value =:: valInfo
      value .?Bool .else ..drop
        "wrong constant value for assert, expected boolean got: " sb.copyPtr
          value typeContext sb.appendConstant
        op [] .pos errors appendError
        EvalResult .Ok return
      end ! if
        "assertion failed: " sb.copyPtr
          message sb.appendStr
        op [] .pos errors appendError
      end
      EvalResult .Ok return
    Panic PanicWithMessage case
      op [] .val .?PanicWithMessage .else ..drop
        true op [] .pos context popString if ..drop.2
          EvalResult .Error return
        end ..swap ..drop
      end =:: message
      "PANIC!: " sb.copyPtr
        message sb.appendStr
      op [] .pos errors appendError
      EvalResult .Error return
    Error case
      false op [] .pos context popString if ..drop.2
        EvalResult .Error return
      end =:: msg ..drop
      msg sb.fromStr
        context [] .callPositions .length 0:iSize != if
          context [] .callPositions list.peek .data []
        else
          op [] .pos
        end
        errors
      op [] .val .Error switch
        ERROR case appendError break
        WARNING case appendWarning break
        INFO case appendInfo break
      end
      EvalResult .Ok return
    Length case
      op [] .pos context popValue if ..drop.2
        EvalResult .Error return
      end =:: value =:: valInfo
      ## sizeOfValue
        valInfo .valueType
        value
        op [] .pos
        program
      interpreter.sizeOfValue if ..drop.2
        "could not compute size: " sb.copyPtr
          op [] program sb.appendOp
        op [] .pos errors appendError
        value valInfo context unpopValue
        EvalResult .Error return
      end =:: constVal =:: constType
      ## pushValue
        constVal
        constType
        op [] .pos
        context
      pushValue
      EvalResult .Ok return
    RawValue case
      op [] .pos context popValue if ..drop.2
        EvalResult .Error return
      end =:: value =:: valInfo
      valInfo .valueType typeContext types.isUnionElement if
        valInfo .valueType typeContext types.getUnionElementType
      else valInfo .valueType typeContext types.isTaggedUnion _if
        ## TODO: implement ..raw for unions
        "unimplemented: ..raw for unions" ..panic
      else
        value valInfo context unpopValue
        EvalResult .Error return
      end =:: newType
      ## pushValue
        value
        newType
        op [] .pos
        context
      pushValue
      EvalResult .Ok return
    TypeInfo .case =:: typeInfo
      Type : poppedType
      ValueInfo : valInfo
      false =:: mut: poppedValue
      op [] .dataType .?Undefined ? if
        op [] .pos context popType if ..drop.2
          EvalResult .Error return
        end poppedType= valInfo=
        true poppedValue=
        poppedType typeContext types.containsGeneric if
          "generic types are not supported" sb.copyPtr
          op [] .pos errors appendError
          ## computing size not possible, reset stack
          ## unpopValue
            poppedType ConstValue .TypeId
            valInfo
          context unpopValue
          EvalResult .Error return
        end
        poppedType
      else
        op [] .dataType
      end =:: targetType
      ## pushValue
        ## computeTypeInfo
          targetType
          typeInfo
        program computeTypeInfo if ..drop
          "could not compute size of type" sb.copyPtr
            targetType typeContext sb.appendType
          op [] .pos errors appendError
          ## computing size not possible, reset stack
          poppedValue if
            ## unpopValue
              poppedType ConstValue .TypeId
              valInfo
            context unpopValue
          end
          EvalResult .Error return
        end
        types.I_SIZE
        op [] .pos
        context
      pushValue
      EvalResult .Ok return
    BuiltIn .case =:: builtIn
      op [] .dataType builtIn op [] .pos context tryEvaluateBuiltIn wrapResult return
    EqualityOperator .case =:: equalityOperator
      ConstValue 2 array new =:: mut: valueData
      valueData@ =:: values
      ValueInfo 2 array new =:: mut: valInfoData
      valInfoData@ =:: valInfos
      0:i64 =:: mut: nArgs
      0 while ..dup 2 < do 1 +
        op [] .pos context popValue if ..drop.3
          values valInfos nArgs context unpopValues
          EvalResult .Error return
        end values nArgs =[] valInfos nArgs =[]
        nArgs 1 + nArgs=
      end ..drop
      ## mergeTypes
        valInfos 0 [] .valueType
        valInfos 1 [] .valueType
      typeContext types.mergeTypes $ ? if .data else ..drop
        "incompatible types for equality check: " sb.copyPtr
          valInfos 0 [] .valueType typeContext sb.appendType
          " and " sb.appendS
          valInfos 1 [] .valueType typeContext sb.appendType
        op [] .pos errors appendError
        values valInfos nArgs context unpopValues
        EvalResult .Error return
      end =:: resType
      ## pushValue
        values 1 [] values 0 [] resType typeContext interpreter.operatorEq if ..drop
          "unsupported values for equality check: " sb.copyPtr
            values 0 [] typeContext sb.appendConstant
            " and " sb.appendS
            values 1 [] typeContext sb.appendConstant
          op [] .pos errors appendError
          values valInfos nArgs context unpopValues
          EvalResult .Error return
        end
          equalityOperator .NEQ ^ ## invert result for NEQ
        ConstValue .Bool
        types.primitive.BOOL
        op [] .pos
        context
      pushValue
      EvalResult .Ok return
    StackMod .case =:: stackMod
      stackMod .modType switch
        DROP case
          stackMod .n iSize cast.u
            "drop":s
          op [] .pos context checkStack if
            EvalResult .Error return
          end
          context [] .stack .length stackMod .n iSize cast.u - context truncateStack
          EvalResult .Ok return
        COPY case
          stackMod .n 1 + iSize cast.u =:: offset
          offset
            "stack modification":s
          op [] .pos context checkStack if
            EvalResult .Error return
          end
          context [] .stack
            $ $1 .length offset - [] list.append
          context .stack=
          context [] .stackInfo
            $ $1 .length offset - [] list.append
          context .stackInfo=
          EvalResult .Ok return
        ROTATE case
          stackMod .n =:: offset
          offset 1 == "! rotation is only implemented for two elements" assert
          2:iSize
            "swap":s
          op [] .pos context checkStack if
            EvalResult .Error return
          end
          op [] .pos context popValue
            ! "hasValue" assert
          =:: upper =:: upperInfo
          op [] .pos context popValue
            ! "hasValue" assert
          =:: lower =:: lowerInfo
          context [] .stack
            upper list.append
            lower list.append
          context .stack=
          context [] .stackInfo
            upperInfo list.append
            lowerInfo list.append
          context .stackInfo=
          EvalResult .Ok return
      end
      break
    CompilerInfo .case switch
        TypeInfo .case =:: info
          ## printTypes
            false
            info .count
            info .depth
          context printTypes
          EvalResult .Ok return
        StackInfo .case
          ## printTypes
            true
            >$
            0
          context printTypes
          EvalResult .Ok return
        CompiledOps case
          EvalResult .Ok return ## TODO print ops
        Find case
          EvalResult .Ok return ## TODO find
      end
      break
    GetEnumLabel Import LibImport
    NewEnumReference CallPtr
    ImplementProcedure ProcPtr
    ConstantReference NewReference
    CheckEnumLabel NestedProc Splat case break
  end
  "unsupported operation in constant evaluation: " sb.copyPtr
    op [] program sb.appendOp
  op [] .pos errors appendError
  EvalResult .Error return
end

namespace: interpreter
  proc(
    Type : calledType
    BuiltIn : builtIn
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> bool ) =>: tryEvaluateBuiltIn
    context [] .program .errors =:: errors
    context [] .program =:: program
    context [] .program .idContext =:: idContext
    idContext .constContext =:: constContext
    idContext .typeContext =:: typeContext
    typeContext .labelContext =:: labelContext
    calledType typeContext types.getProcIn .data =:: inTypes
    ConstValue 3 array new =:: mut: valueData
    valueData@ =:: values
    ValueInfo 3 array new =:: mut: valInfoData
    valInfoData@ =:: valInfos
    0:i64 =:: mut: nArgs
    inTypes slice.reversed for =:: eltType
      nArgs 3 < "built-ins have at most three arguments" assert
      pos context popValue if ..drop.2
        values valInfos nArgs context unpopValues
        true return
      end values nArgs =[] valInfos nArgs =[]
      valInfos nArgs [] .valueType typeContext types.unwrapNamed
          eltType typeContext types.unwrapNamed typeContext types.canAutoCast ! if
        "wrong argument type for built-in " sb.copyPtr
          builtIn sb.appendBuiltIn
          " expected: " sb.appendS
          eltType typeContext sb.appendType
          " got: " sb.appendS
          valInfos nArgs [] .valueType typeContext sb.appendType
        pos errors appendError
        values valInfos nArgs 1 + context unpopValues
        true return
      end
      nArgs 1 + nArgs=
    end
    ## bring arguments in correct order
    values nArgs iSize cast.u array.reverse
    valInfos nArgs iSize cast.u array.reverse
    builtIn
      inTypes
      values
      nArgs i32 cast
    pos typeContext errors interpreter.evaluateBuiltIn =:: resultType =:: value
    resultType switch
      SUCCESS case
        calledType typeContext types.getProcRet =:: retType
        retType switch
          Empty case break
          Value case
            value
              retType .Value
              pos
              context
            pushValue
          break
          Tuple case
            "builtIns with multiple return values are not supported" sb.copyPtr
            pos errors appendError
          break
        end
        false return
      ARGUMENT_ERROR case
        "invalid arguments for built-in " sb.copyPtr
          builtIn sb.appendBuiltIn
          ": " sb.appendS
          0:i64 while ..dup nArgs < do =:: i
            values i [] typeContext sb.appendConstant
            ", " sb.appendS
            i 1 +
          end ..drop
        pos errors appendError
        values nArgs iSize cast.u array.reverse
        valInfos nArgs iSize cast.u array.reverse
        values valInfos nArgs context unpopValues
        true return
      UNIMPLEMENTED case
        "unsupported built-in in constant evaluation: " sb.copyPtr
          builtIn sb.appendBuiltIn
        pos errors appendError
        values nArgs iSize cast.u array.reverse
        valInfos nArgs iSize cast.u array.reverse
        values valInfos nArgs context unpopValues
        true return
    end
  end
  proc(
    LabelId : procName
    Type slice : args
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> bool ) =>: evaluateExternCall
    context [] .program =:: program
    program .errors =:: errors
    program .idContext .typeContext =:: typeContext
    typeContext .labelContext =:: labelContext
    "memcpy":s procName labelContext id.labelNameEq if
      args .length 3:iSize != or
          args 2 [] typeContext types.isPointer ! or
          args 2 [] typeContext types.isMutable ! or
          args 1 [] typeContext types.isPointer ! or
          args 0 [] typeContext types.isIntLike ! if
        "unexpected arguments for `memcpy` expected: " sb.copyPtr
          "( <int-primitive> <ptr> <ptr.mut> -> ... ) got: ( " sb.appendS
          args for typeContext sb.appendType ' ' sb.appendC end
          "-> ... )" sb.appendS
        pos errors appendError
        true return
      end
      3:iSize "memcpy":s pos context checkStack if
        true return
      end
      pos context popValue ! "hasValue" assert =:: targetValue =:: targetInfo
      pos context popValue ! "hasValue" assert =:: srcValue =:: srcInfo
      pos context popValue ! "hasValue" assert =:: lenValue =:: lenInfo
      lenValue .?Int .else ..drop ## XXX? support GenericArg as length
        "unexpected argument for memcpy, expected Integer got: " sb.copyPtr
          lenValue typeContext sb.appendConstant
        pos errors appendError
        lenValue lenInfo context unpopValue
        srcValue srcInfo context unpopValue
        targetValue targetInfo context unpopValue
        true return
      end =:: length
      targetValue srcValue length iSize cast.u pos program opMemcopy if ..drop
        lenValue lenInfo context unpopValue
        srcValue srcInfo context unpopValue
        targetValue targetInfo context unpopValue
        true return
      end =:: resPtr
      resPtr
        args 2 []
        pos
      context pushValue
      false return
    end
    "call to unsupported extern procedure: " sb.copyPtr
      procName labelContext sb.appendLabelPath
    pos errors appendInfo
    true return
  end
end

proc(
  Operation slice : ops
  InterpreterContext ptr.mut : context
->
  bool
) =>: evaluateOperations
  using interpreter.
  0:iSize while $ ops .length u< do =:: offset
    ops offset slice.at .data =:: op
      op context evaluateOperation =:: result
      result switch
        Error case true return
        Return case false return
        Ok case offset break
        Jump case offset result .Jump iSize cast.s + break
      end
  finally 1:iSize + end ..drop
  ## XXX? error if unwanted open blocks
  false return
end

namespace: interpreter
  proc(
    Type : tupleType
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> bool ) =>: newTuple
    context [] .program .errors =:: errors
    context [] .program =:: program
    context [] .program .idContext =:: idContext
    idContext .constContext =:: constContext
    idContext .typeContext =:: typeContext
    typeContext .labelContext =:: labelContext
    tupleType typeContext types.compositeElts =:: elts
    elts .length "tuple-creation":s pos context checkStack if
      true return
    end
    context [] .stack .length elts .length - =:: offset
    0:iSize while $ elts .length u< do =:: i
      context [] .stackInfo offset i + list.at .data =:: stackInfo
      stackInfo [] .valueType elts i [] typeContext types.canAutoCast ! if
        "wrong argument for tuple creation expected: " sb.copyPtr
          elts i [] typeContext sb.appendType
          " got: " sb.appendS
          stackInfo [] .valueType typeContext sb.appendType
        pos errors appendError
        true return
      end
      i 1:iSize +
    end ..drop
    context [] .stack list.asSlice
      offset slice.tail
    constContext newArrayConst =:: tupleConst
    ## remove arguments and push tuple
    offset context truncateStack
    context [] .stack
      tupleConst list.append
    context .stack=
    context [] .stackInfo
      ## ValueInfo
        tupleType
        pos
      ValueInfo new list.append
    context .stackInfo=
    false return
  end
end
namespace: interpreter
  #+evaluate procedure body with the given arguments+#
  proc(
    ProcId : procId
    i32 : implId
    Type : calledType
    ConstValue slice : autoArgs
    FilePosition : pos
    InterpreterContext ptr.mut : context
  ->
    bool
  ) =>: export: evaluateCall
    using interpreter.
    context [] .program .errors =:: errors
    context [] .program =:: program
    context [] .program .idContext =:: idContext
    idContext .constContext =:: constContext
    idContext .typeContext =:: typeContext
    typeContext .labelContext =:: labelContext
    program [] .procedures procId i64 cast list.at .data =:: procData
    procData [] .procType =:: procType
    procType typeContext types.getProcIn .data =:: args
    0:iSize ## XXX? is there a better way to get number of non-auto static args
      implId -1:i32 != if
        args .length i32 cast.u for =:: i
          procType i typeContext types.getProcArgLabel =:: label
          label labelContext id.labelFlags =:: flags
          flags id.FLAG_AUTO & ? ! and flags id.FLAG_STATIC & ? or
              args i [] typeContext types.isType if
            1:iSize +
          end
        end
      end
    =:: nStaticArgs
    args .length autoArgs .length - nStaticArgs - =:: nArgs
    procData .implementation .?BuiltIn .if =:: builtInImpl
      implId -1:i32 != if
        "generic built-ins are not supported" sb.copyPtr
        pos errors appendError
      end
      ## tryEvaluateBuiltIn
        calledType
        builtInImpl [] .builtIn
      pos context tryEvaluateBuiltIn return
    else .?Extern ._if []
      args pos context evaluateExternCall return
    else .?Code ._else ..drop
      "unexpected implementation type" sb.copyPtr
      pos errors appendError
      true return
    end =:: codeImpl
    nArgs "procedure call":s pos context checkStack if
      128 sb.create
        "inTypes: (" sb.appendS
        args for typeContext sb.appendType ' ' sb.appendC end
        "-> ... ) arguments: " sb.appendS
        args .length sb.appendI
        " auto-args: " sb.appendS
        autoArgs .length sb.appendI
      pos errors appendInfo
      true return
    end
    context [] .stack .length nArgs - =:: argsOffset
    procData [] .labelId =:: procName
    procName labelContext id.labelFlags id.FLAG_EXTERN & ? and
        codeImpl [] .codeState .PARSING if
      procName args pos context evaluateExternCall return
    end
    context offsetContext
    context [] .stack .length =:: stackOffset
    context offsetStack
    0:i64 =:: mut: autoArgOffset
    0:i64 =:: mut: staticArgOffset
    argsOffset =:: mut: argOffset
    context [] .localVariables =:: prevVariables
    context [] .localMemory mixedArena.offset =:: offset
    context [] .localMemory
      LabelId Constant hashMap mixedArena.alloc =:: newVariables
    context .localMemory=
    ## XXX? allocate lookup table in localMemory
    labelHash@ labelEq@ 256 Constant map.create newVariables =[]
    newVariables optional.wrap context .localVariables=
    ## process procedure arguments
    false =:: mut: hasGenericArg
    false =:: mut: hasNonStaticGenericArg
    0:i32 while $ args .length i32 cast < do =:: i
      procType i typeContext types.getProcArgLabel =:: label
      label labelContext id.labelFlags =:: labelFlags
      labelFlags id.FLAG_AUTO & ? if
        autoArgs autoArgOffset []
          .?GenericArg .if =:: varId
            prevVariables optional.hasData and
                prevVariables .data varId map.get =:: labelValue?
              labelValue? ? if
              labelValue? .data .value
            else
              "missing generic value " sb.copyPtr
                varId i64 cast sb.appendI
                ":LabelId" sb.appendS
              pos errors appendError
              varId ConstValue .GenericArg
            end
          end
        =:: value
        context [] .localVariables .data
          label
          ## Constant
            value
            ## ValueInfo
              args i []
              pos
            ValueInfo new
          Constant new
        map.put ..drop
        autoArgOffset 1 + autoArgOffset=
        labelFlags id.FLAG_STATIC & ? if
          staticArgOffset 1 + staticArgOffset=
        end
        continue
      end
      labelFlags id.FLAG_STATIC & ? or
          args i [] typeContext types.isType if
        implId 0 >= "implId is not negative" assert
        codeImpl [] .implementations
          implId list.at .data
        [] .staticArgs staticArgOffset [] =:: value
        value .?GenericArg ? or value .?TypeId .and typeContext types.isGeneric if
          true hasGenericArg=
        end
        ## ValueInfo
          args i []
          pos
        ValueInfo new =:: valInfo
        label id.LABEL_ID_NONE != if
          context [] .localVariables .data
            label
            ## Constant
              value
              valInfo
            Constant new
          map.put ..drop
        end
        staticArgOffset 1 + staticArgOffset=
        continue
      end
      argOffset stackOffset u>= if
        "not enough arguments for procedure " sb.copyPtr
          procName labelContext sb.appendLabelPath
        pos errors appendError
        context [] .localVariables .data map.free
        prevVariables context .localVariables=
        context [] .localMemory offset mixedArena.reset context .localMemory=
        context resetContext
        true return
      end
      context [] .stack argOffset [] =:: value
      context [] .stackInfo argOffset [] =:: valueInfo
      value .?GenericArg .if =:: genericValue
        true hasGenericArg=
      else .?TypeId .and typeContext types.isGeneric _if
        true hasGenericArg=
      end
      argOffset 1:iSize + argOffset=
      label id.LABEL_ID_NONE == or labelFlags id.FLAG_DUMMY & ? if ## push argument
        context [] .stack
          value list.append
        context .stack=
        context [] .stackInfo
          ## ValueInfo
            valueInfo .valueType
            pos
          ValueInfo new list.append
        context .stackInfo=
      else ## store argument as value
        context [] .localVariables .data
          label
          ## Constant
            value
            valueInfo
          Constant new
        map.put ..drop
      end
    finally
      i 1 +
    end ..drop
    implId 0 >= if
      codeImpl [] .implementations
        implId list.at .data
      =:: currentImpl
      currentImpl .codeState .TYPE_CHECKED or currentImpl .codeState .UNUSED or currentImpl .codeState .COMPILED if
        currentImpl [] .code slice.freeze
      else
        "no implementaion for procedure " sb.copyPtr
          procName labelContext sb.appendLabelPath
        pos errors appendError
        Operation slice.empty
      end
    else
      codeImpl [] .codeState switch
        PARSING case
          "procedure " sb.copyPtr
            procName labelContext sb.appendLabelPath
            " has not finished parsing" sb.appendS
          pos errors appendError
          Operation slice.empty break
        TYPE_CHECKING case
          "procedure " sb.copyPtr
            procName labelContext sb.appendLabelPath
            " has not finished type-checking" sb.appendS
          pos errors appendError
          Operation slice.empty break
        PARSED TYPE_CHECKED UNUSED COMPILED case
          codeImpl [] .code slice.freeze
          break
      end
    end =:: code
    code .length 0:iSize == if
      "no operations in procedure " sb.copyPtr
        procName labelContext sb.appendLabelPath
      pos errors appendError
      context resetContext
      context [] .localVariables .data map.free
      prevVariables context .localVariables=
      context [] .localMemory offset mixedArena.reset context .localMemory=
      true return ## not a call
    end
    code 0 slice.at .data =:: op
    op [] .val .?ImplementProcedure ? ! and
        op [] .val .?InitializeId ! .or .idType .PROCEDURE ! if
      "expected procedure initialization got " sb.copyPtr
        op [] program sb.appendOp
      op [] .pos errors appendError
      context resetContext
      context [] .localVariables .data map.free
      prevVariables context .localVariables=
      context [] .localMemory offset mixedArena.reset context .localMemory=
      true return ## not a call
    end
    context [] .currentFile =:: oldFile
    procData [] .fileId context .currentFile=
    context [] .callPositions
      pos list.append
    context .callPositions=
    ## evaluateOperations
      code 1 slice.tail ## first operation declares procedure
      context
    evaluateOperations if
      context [] .callPositions
        list.pop ..drop
      context .callPositions=
      context [] .localVariables .data map.free
      prevVariables context .localVariables=
      context [] .localMemory offset mixedArena.reset context .localMemory=
      context resetContext
      true return
    end
    context [] .callPositions
      list.pop ..drop
    context .callPositions=
    calledType typeContext types.getProcOut .data =:: outTypes
    outTypes .length "return":s pos context checkStack if
      context [] .localVariables .data map.free
      prevVariables context .localVariables=
      context [] .localMemory offset mixedArena.reset context .localMemory=
      context resetContext
      true return
    end
    context [] .stack .length outTypes .length - =:: outOffset
    outTypes .length for =:: i
      outTypes i []
        $ typeContext types.containsGeneric if
          ## TODO update generics
        end
      =:: valType
      context [] .stackInfo outOffset i + list.at .data =:: outValInfo
      outValInfo [] .valueType valType typeContext types.canAutoCast ! if
        "cannot cast " sb.copyPtr
          outValInfo [] .valueType typeContext sb.appendType
          " to " sb.appendS
          valType typeContext sb.appendType
        pos errors appendError
      end
      ## TODO why is return value of list.empty not cast correctly (struct(...) instead of `T list`)
      context [] .stack outOffset i + []
        ## TODO ensure returned values do not point to deleted local memory
        valType typeContext types.isPointer ! if
          ## unwrap local values
          $ switch ## XXX? handle nested local values
            LocalValue case .LocalValue ConstValue ptr.mut cast [] break
            LocalArray LocalArray8 LocalArray16 LocalArray32 LocalArray64 case
              valType context .localMemory program copyLocalArray
              break
            default break
          end
        end
        outValInfo [] .valueType valType types.typeEquals ! if
          =:: oldValue
          ## castConstant
            outValInfo [] .valueType
            SignType .NONE
            oldValue
            valType
            typeContext
          castConstant
          valType outValInfo .valueType=
        end
      context [] .stack outOffset i + list.set
    end
    context [] .localVariables .data map.free
    prevVariables context .localVariables=
    context [] .localMemory
      offset mixedArena.reset
    context .localMemory=
    oldFile context .currentFile=
    context [] .stack .length stackOffset - =:: nReturn
    ## mem.copy
      context [] .stack .data argsOffset @[]
      context [] .stack .data stackOffset @[]
      nReturn iSize cast.u
    mem.copy ..drop
    ## mem.copy
      context [] .stackInfo .data argsOffset @[]
      context [] .stackInfo .data stackOffset @[]
      nReturn iSize cast.u
    mem.copy ..drop
    context resetContextKeepStack
    context [] .stack
      argsOffset nReturn + list.setLength
    context .stack=
    context [] .stackInfo
      argsOffset nReturn + list.setLength
    context .stackInfo=
    argsOffset while $ context [] .stackInfo .length u< do
      ## update push position of return values
      pos context [] .stackInfo $2 list.at .data .pushedAt=
      1:iSize +
    end ..drop
    false return
  end
end
