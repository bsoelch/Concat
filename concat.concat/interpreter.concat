          stackValues list.free ..drop
          calledProc? .data =:: calledProc
          calledProc .procId =:: procId
          program [] .procedures
            calledProc .procId i64 cast list.at .data
          =:: calledProcData
          context [] .evalType .FOLD_LOCAL ?? and calledProcData [] .isStatic ! if
            true return ## don't evalaute non-static procedures in fold-local mode
          end
          procId -1:i64 calledProc .autoArgs op [] .pos context evaluateCall return
        LOCAL_VAR ARGUMENT LABEL case
          context [] .variables @ label map.get =:: value?
          value? optional.isEmpty if
            context [] .evalType switch
              INTERPRET GLOBAL case break
              FOLD_LOCAL case true return
            end
            "missing value for " sb.wrap
              op [] .val .getId labelContext sb.appendIdInfo
            op [] .pos errors appendError
            true return
          end
          value? .data =:: value ## TODO? wrap local variable in reference?
