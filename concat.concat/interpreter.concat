import map

import "interpreter/operators.concat"
import "identifiers.concat"
import "program.concat"

## TODO wrap in namespace
struct(
  Type : mut: valueType
  LabelId : valueId
  FilePosition : mut: pushedAt
) =:: export: ValueInfo

struct(
  ConstValue : value
  ValueInfo  : info
) =:: Constant

struct(
  BlockType : blockType
  i64 : stackOffset
  i64 : typeOffset
  i64 : valueOffset
  i64 : labelOffset
) =:: BlockInfo

enum( PARSER GLOBAL FOLD_LOCAL INTERPRET ) =:: export: InterpreterType

struct(
  ProgramContext ptr.mut : program
  LabelId Constant hashMap : mut: variables
  ConstValue list : mut: stack
  ValueInfo  list : mut: stackInfo
  BlockInfo  list : mut: openBlocks
  Type list : mut: typeBuffer
  ConstValue list : mut: valueBuffer
  LabelId list : mut: labelBuffer
  FileId : mut: currentFile
  InterpreterType : mut: evalType
) =:: export: InterpreterContext

proc(
  i64 : count
  string : name
  bool : canIgnoreErrorMessage
  FilePosition : pos
  InterpreterContext ptr.mut : context
-> bool ) =>: checkStack
  context [] .openBlocks .length 0 > if
    context [] .openBlocks context [] .openBlocks .length 1 - list.at .data [] .stackOffset
  else 0:i64 end =:: offset
  offset 0 >= assert "offset is non-negative"
  context [] .stack .length offset - count < if
    canIgnoreErrorMessage if
      context [] .evalType switch
        INTERPRET GLOBAL case break
        PARSER FOLD_LOCAL case true return
      end
    end
    "not enough arguments for " sb.wrap
      name sb.appendStr
      " expected: " sb.appendS
      count sb.appendI
      " got: " sb.appendS
      context [] .stack .length offset - sb.appendI
    pos context [] .program [] .errors @ appendError
    true return
  end
  false return
end
proc( InterpreterContext ptr.mut : context -> i64 ) =>: minStackOffset
  context [] .openBlocks .length 0 > if
    context [] .openBlocks
      context [] .openBlocks .length 1 - list.at .data []
    .stackOffset return
  end
  0 return
end

proc( InterpreterContext ptr.mut : context -> bool ) =>: inEnum
  ## XXX cache number of open enum blocks
  context [] .openBlocks .length 1 - while $ 0 >= do
    context [] .openBlocks $1 list.at .data [] .blockType switch
      TYPE_ENUM case
         ..drop true return
      PROCEDURE EXPERIMENTAL_PROCEDURE INITIALIZER TYPE_TUPLE TYPE_STRUCT
          TYPE_PROC_IN TYPE_PROC_OUT TYPE_COMPOSITE TYPE_UNION TYPE_UNTAGGED_UNION case
        ..drop false return
      UNKNOWN IF ELSE WHILE DO BREAK CONTINUE
        SWITCH BREAK_SWITCH CASE DEFAULT FINALLY
        AND OR AND_IF OR_IF AND_DO OR_DO
        IF_TRUE IF_FALSE AND_IF_TRUE AND_IF_FALSE
        OR_IF_TRUE OR_IF_FALSE ELSE_TRUE ELSE_FALSE
        NAMESPACE case break
    end
    1 -
  end ..drop
  false return
end
proc( InterpreterContext ptr.mut : context -> bool ) =>: inUnion
  ## XXX cache/precompute result
  context [] .openBlocks .length 1 - while ..dup 0 >= do
    context [] .openBlocks ..over list.at .data [] .blockType switch
      TYPE_UNION TYPE_UNTAGGED_UNION case
         ..drop true return
      PROCEDURE EXPERIMENTAL_PROCEDURE INITIALIZER TYPE_TUPLE TYPE_STRUCT
          TYPE_PROC_IN TYPE_PROC_OUT TYPE_COMPOSITE TYPE_ENUM case
        ..drop false return
      UNKNOWN IF ELSE WHILE DO BREAK CONTINUE
          SWITCH BREAK_SWITCH CASE DEFAULT FINALLY
          AND OR AND_IF OR_IF AND_DO OR_DO
          IF_TRUE IF_FALSE AND_IF_TRUE AND_IF_FALSE
          OR_IF_TRUE OR_IF_FALSE ELSE_TRUE ELSE_FALSE
          NAMESPACE case break
    end
    1 -
  end ..drop
  false return
end
proc( InterpreterContext ptr.mut : context -> bool ) =>: inTypeOrInitializer
  ## XXX cache/precompute result
  context [] .openBlocks .length 1 - while ..dup 0 >= do
    context [] .openBlocks ..over list.at .data [] .blockType switch
      INITIALIZER TYPE_TUPLE TYPE_STRUCT TYPE_ENUM TYPE_UNION TYPE_UNTAGGED_UNION
          TYPE_PROC_IN TYPE_PROC_OUT TYPE_COMPOSITE case
        ..drop true return
      PROCEDURE EXPERIMENTAL_PROCEDURE case
        ..drop false return
      UNKNOWN IF ELSE WHILE DO BREAK CONTINUE
          SWITCH BREAK_SWITCH CASE DEFAULT FINALLY
          AND OR AND_IF OR_IF AND_DO OR_DO
          IF_TRUE IF_FALSE AND_IF_TRUE AND_IF_FALSE
          OR_IF_TRUE OR_IF_FALSE ELSE_TRUE ELSE_FALSE
          NAMESPACE case break
    end
    1 -
  end ..drop
  false return
end
proc( InterpreterContext ptr.mut : context -> bool ) =>: export: inTypeBlock
  ## XXX cache/precompute result
  context [] .openBlocks .length 1 - while ..dup 0 >= do
    context [] .openBlocks ..over list.at .data [] .blockType switch
      TYPE_TUPLE TYPE_STRUCT TYPE_ENUM TYPE_UNION TYPE_UNTAGGED_UNION
          TYPE_PROC_IN TYPE_PROC_OUT TYPE_COMPOSITE case
        ..drop true return
      PROCEDURE EXPERIMENTAL_PROCEDURE case
        ..drop false return
      UNKNOWN IF ELSE WHILE DO BREAK CONTINUE
          SWITCH BREAK_SWITCH CASE DEFAULT FINALLY
          AND OR AND_IF OR_IF AND_DO OR_DO
          IF_TRUE IF_FALSE AND_IF_TRUE AND_IF_FALSE
          OR_IF_TRUE OR_IF_FALSE ELSE_TRUE ELSE_FALSE
          NAMESPACE INITIALIZER case break
    end
    1 -
  end ..drop
  false return
end
proc( InterpreterContext ptr.mut : context -> bool ) =>: export: inGlobalBlock
  ## XXX cache/precompute result
  context [] .openBlocks .length 1 - while ..dup 0 >= do
    context [] .openBlocks ..over list.at .data [] .blockType switch
      TYPE_TUPLE TYPE_STRUCT TYPE_ENUM TYPE_UNION TYPE_UNTAGGED_UNION
          TYPE_PROC_IN TYPE_PROC_OUT TYPE_COMPOSITE case
        ..drop true return
      PROCEDURE EXPERIMENTAL_PROCEDURE case
        ..drop false return
      UNKNOWN IF ELSE WHILE DO BREAK CONTINUE
          SWITCH BREAK_SWITCH CASE DEFAULT FINALLY
          AND OR AND_IF OR_IF AND_DO OR_DO
          IF_TRUE IF_FALSE AND_IF_TRUE AND_IF_FALSE
          OR_IF_TRUE OR_IF_FALSE ELSE_TRUE ELSE_FALSE
          NAMESPACE INITIALIZER case break
    end
    1 -
  end ..drop
  true return
end

proc( BlockType : blockType InterpreterContext ptr.mut : context -> ) =>: openBlock
  context [] .openBlocks
    ## BlockInfo
      blockType
      context [] .stack .length ## XXX add possibility to inherit offset from outer block
      context [] .typeBuffer .length
      context [] .valueBuffer .length
      context [] .labelBuffer .length
    BlockInfo new list.append
  context [] .openBlocks =
end

enum( TYPE_STRUCT TYPE_UNION TYPE_ENUM TYPE_PROC INITIALIZER ) =:: LabeledValueContext
proc( InterpreterContext ptr.mut : context -> i64 LabeledValueContext ) =>: getLabeledValueContext
  ## XXX cache/precompute result
  context [] .openBlocks .length 1 - while $ 0 >= do =:: i
    context [] .openBlocks i list.at .data =:: block
    block [] .blockType switch
      INITIALIZER case
         block [] .labelOffset LabeledValueContext .INITIALIZER return
      TYPE_TUPLE TYPE_STRUCT TYPE_COMPOSITE case
         block [] .labelOffset LabeledValueContext .TYPE_STRUCT return
      TYPE_UNION TYPE_UNTAGGED_UNION case
         block [] .labelOffset LabeledValueContext .TYPE_UNION return
      TYPE_ENUM case
         block [] .labelOffset LabeledValueContext .TYPE_ENUM return
      TYPE_PROC_IN TYPE_PROC_OUT case
         block [] .labelOffset LabeledValueContext .TYPE_PROC return
      PROCEDURE EXPERIMENTAL_PROCEDURE
      UNKNOWN IF ELSE WHILE DO BREAK CONTINUE
        SWITCH BREAK_SWITCH CASE DEFAULT FINALLY
        AND OR AND_IF OR_IF AND_DO OR_DO
        IF_TRUE IF_FALSE AND_IF_TRUE AND_IF_FALSE
        OR_IF_TRUE OR_IF_FALSE ELSE_TRUE ELSE_FALSE
        NAMESPACE case break
    end
  finally i 1 - end ..drop
  ## TODO? better default value/error condition
  ..unreachable
end
proc(
  LabelId : label
  i64 : initialLabelOffset
  LabeledValueContext : valueContext
  FilePosition : pos
  InterpreterContext ptr.mut : context
-> ) =>: checkDuplicateLabel
  label id.LABEL_ID_NONE == if return end
  context [] .program [] .errors @ =:: errors
  context [] .program [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  context [] .labelBuffer@ =:: labels
  initialLabelOffset while $ labels [] .length < do =:: i
    labels [] i list.get =:: prevLabel
    prevLabel label labelContext id.labelNamesEq if
      "duplicate label \"" sb.wrap
      label labelContext sb.appendLabelName
      "\" in " sb.appendS
      valueContext switch
        TYPE_STRUCT case "struct" sb.appendS break
        TYPE_UNION case "union" sb.appendS break
        TYPE_ENUM case "enum" sb.appendS break
        TYPE_PROC case "procedure" sb.appendS break
        INITIALIZER case "initializer" sb.appendS break
      end
      prevLabel labelContext id.labelPos =:: prevPos
      prevPos optional.hasData if
        " ( previous declaration at " sb.appendS
        prevPos .data sb.appendPos
        " )" sb.appendS
      end
      pos errors appendError
    end
  finally i 1 + end ..drop
end
proc(
  LabelId : label
  ConstValue : value
  Type : valueType
  i64 : initialLabelOffset
  LabeledValueContext : valueContext
  FilePosition : pos
  InterpreterContext ptr.mut : context
-> bool ) =>: addLabeledValue
  label initialLabelOffset valueContext pos context checkDuplicateLabel
  context [] .program [] .errors @ =:: errors
  context [] .program [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  context [] .labelBuffer
    label list.append
  context [] .labelBuffer =
  valueContext switch
    INITIALIZER case
      context [] .typeBuffer
        valueType list.append
      context [] .typeBuffer =
      context [] .valueBuffer
        value list.append
      context [] .valueBuffer =
      false return
    TYPE_STRUCT TYPE_UNION TYPE_PROC case break
    TYPE_ENUM case ..unreachable
  end
  value .typeId ?? ! or valueType types.primitive.TYPE types.typeEquals ! if
    "unexpected argument for type-field declaration expected type got " sb.wrap
      valueType typeContext sb.appendType
      " [ " sb.appendS
      value constContext typeContext sb.appendConstant
      " ]" sb.appendS
    pos errors appendError
    true return
  end
  value .typeId =:: typeValue
  context [] .typeBuffer
    typeValue list.append
  context [] .typeBuffer =
  label id.LABEL_ID_NONE != if
    typeValue
      typeContext types.unwrapNamed
    types.primitive.TYPE types.typeEquals =:: isType
    ## map.put
    context [] .variables@
      label
      ## Constant
        isType if
          label types.newGenericType ConstValue .typeId
        else
          label ConstValue .genericArg
        end
        ## ValueInfo
          typeValue
          label
          pos
        ValueInfo new
      Constant new
    map.put ..drop
  end
  false return
end

proc(
  i64 : stackOffset
  i64 : initialLabelOffset
  LabeledValueContext : valueContext
  FilePosition : pos
  InterpreterContext  ptr.mut : context
-> bool ) =>: finishLabledValues
  context [] .program [] .errors@ =:: errors
  context [] .program [] .idContext@ =:: idContext
  idContext [] .typeContext@ =:: typeContext
  typeContext [] .labelContext@ =:: labelContext
  context [] .stack .length stackOffset > if
    stackOffset while $ context [] .stack .length < do =:: i
      context [] .stack i list.at .data =:: eltVal
      context [] .stackInfo i list.at .data =:: eltInfo
      valueContext switch
        TYPE_ENUM case
          "unexpected value in enum-block" sb.wrap
            eltInfo [] .pushedAt
          errors appendError
          id.LABEL_ID_NONE
          break
        TYPE_UNION case
          "unexpected value in union-block" sb.wrap
            eltInfo [] .pushedAt
          errors appendError
          id.LABEL_ID_NONE
          break
        TYPE_PROC INITIALIZER case
          id.LABEL_ID_NONE break
        TYPE_STRUCT case
          ## newDummyLabel
            i stackOffset -
            pos
            -1:FileId ## TODO determine file-id
            labelContext
          id.newDummyLabel
          break
      end =:: eltLabel
      ## addLabeledValue
        eltLabel
        eltVal []
        eltInfo [] .valueType
        initialLabelOffset
        valueContext
        eltInfo [] .pushedAt
      context addLabeledValue if
        true return
      end
    finally i 1 + end ..drop
    ## truncate stack
    stackOffset context truncateStack
  end
  false return
end
proc(
  Operation ptr : op
  BlockInfo ptr : closedBlock
  LabeledValueContext : closedType
  FilePosition : pos
  InterpreterContext ptr.mut : context
-> bool ) =>: closedTypeBlock
  ## XXX? use different contexts for different types of type-containers
  ## finishLabledValues
    closedBlock [] .stackOffset
    closedBlock [] .labelOffset
    closedType
  pos context finishLabledValues if
    true return
  end
  context [] .program [] .errors @ =:: errors
  context [] .program [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  closedBlock [] .labelOffset =:: labelOffset
  closedBlock [] .typeOffset =:: typeOffset
  context [] .labelBuffer .length labelOffset - =:: elementCount
  context [] .typeBuffer .length typeOffset - elementCount == assert "type count == label count"
  0:i64 while $ elementCount < do =:: i
    context [] .typeBuffer typeOffset i + list.at .data [] =:: eltType
    context [] .labelBuffer labelOffset i + list.at .data [] =:: eltLabel
    ## types are always static
    eltType types.primitive.TYPE types.typeEquals if
      eltLabel id.FLAG_STATIC labelContext id.addLabelFlags
    end
  finally i 1 + end ..drop
  false return
end

proc(
  Operation ptr : op
  BlockInfo ptr : closedBlock
  FilePosition : pos
  InterpreterContext ptr.mut : context
->
  Type
  bool
) =>: closedInitializer
  ## finishLabledValues
    closedBlock [] .stackOffset
    closedBlock [] .labelOffset
    LabeledValueContext .INITIALIZER
  pos context finishLabledValues if
    Type .undefined true return
  end
  context [] .program [] .errors @ =:: errors
  context [] .program [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  closedBlock [] .typeOffset =:: typeOffset
  closedBlock [] .valueOffset =:: valueOffset
  closedBlock [] .labelOffset =:: labelOffset
  context [] .labelBuffer .length labelOffset - =:: elementCount
  context [] .typeBuffer .length typeOffset - elementCount == assert "type count == label count"
  context [] .valueBuffer .length valueOffset - elementCount == assert "value count == label count"
  ## newInitializerType
    context [] .typeBuffer list.asArray typeOffset array.tail
    context [] .labelBuffer list.asArray labelOffset array.tail optional.wrap
    typeContext
  types.newInitializerType =:: initializerType
  ## return
    initializerType
    false
  return
end

proc(
  ConstValue : value
  Type : valType
  LabelId : id
  FilePosition : pos
  InterpreterContext ptr.mut : context
-> ) =>: pushValue
  context [] .stack
    value list.append
  context [] .stack =
  context [] .stackInfo
    ## ValueInfo
      valType
      id
      pos
    ValueInfo new list.append
  context [] .stackInfo =
end
proc(
  FilePosition : pos
  InterpreterContext ptr.mut : context
-> ValueInfo ConstValue bool ) =>: popValue
  context [] .stack .length 0 == if
    context [] .evalType switch
      INTERPRET GLOBAL case
        "stack underflow " sb.wrap
        pos context [] .program [] .errors @ appendError
      break
      PARSER FOLD_LOCAL case break ## allow underflow
    end
    ## return
      ## ValueInfo
        Type .undefined
        id.LABEL_ID_NONE
        pos
      ValueInfo new
      ConstValue .none
    true return
  end
  context [] .stack
    list.pop =:: value
  context [] .stack =
  context [] .stackInfo
    list.pop =:: valInfo
  context [] .stackInfo =
  valInfo value false return
end
proc(
  ConstValue : value
  ValueInfo : valInfo
  InterpreterContext ptr.mut : context
->  ) =>: unpopValue
  context [] .stack
     value list.append
  context [] .stack =
  context [] .stackInfo
    valInfo list.append
  context [] .stackInfo =
end
proc(
  ConstValue _ ptr : values
  ValueInfo _ ptr : valInfos
  i64 : count
  InterpreterContext ptr.mut : context
->  ) =>: unpopValues
  count 1 - while ..dup 0 >= do =:: i
    ## unpopValue
      values i []
      valInfos i []
      context
    unpopValue
    i 1 -
  end ..drop
end
proc(
  i64 : newLength
  InterpreterContext ptr.mut : context
-> ) =>: truncateStack
  context [] .stack .length context [] .stackInfo .length == assert "len(stack)=len(stackInfo)"
  context [] .stack .length newLength >= assert "newLength<length"
  context [] .stack
    newLength list.setLength
  context [] .stack =
  context [] .stackInfo
    newLength list.setLength
  context [] .stackInfo =
end

proc(
  FilePosition : pos
  InterpreterContext ptr.mut : context
-> ValueInfo Type bool ) =>: popType
  context [] .program [] .errors @ =:: errors
  context [] .program =:: program
  context [] .program [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  pos context popValue =:: isError =:: value =:: valInfo
  isError if
    valInfo Type .undefined true return
  end
  value .typeId ?? if
    valInfo value .typeId false return
  end
  "expected type got: " sb.wrap
    valInfo .valueType typeContext sb.appendType
    " ( " sb.appendS
    value constContext typeContext sb.appendConstant
    " )" sb.appendS
  pos errors appendError
  ## restore stack
  value valInfo context unpopValue
  valInfo Type .undefined true return
end

## TODO use wrapper procedures for stack access

namespace: interpreter
  proc(
    ProgramContext ptr.mut : progContext
    FileId : fileId
    InterpreterType : evalType
  ->
    InterpreterContext
  ) =>: export: wrapProgram
    ## InterpreterContext
      progContext
      labelHash @ labelEq @ 32 Constant map.create
      64 ConstValue list.create
      64 ValueInfo  list.create
      64 BlockInfo  list.create
      64 Type       list.create
      64 ConstValue list.create
      64 LabelId    list.create
      fileId
      evalType
    InterpreterContext new
  end

  proc(
    InterpreterContext ptr.mut : context
    InterpreterType : evalType
  -> ) =>: export: resetContext
    ## TODO? clear local variables in map
    context [] .stackInfo   list.clear context [] .stackInfo =
    context [] .openBlocks  list.clear context [] .openBlocks =
    context [] .typeBuffer  list.clear context [] .typeBuffer =
    context [] .valueBuffer list.clear context [] .valueBuffer =
    context [] .labelBuffer list.clear context [] .labelBuffer =
    context [] .stack       list.clear context [] .stack =
    evalType context [] .evalType =
  end

  proc(
    InterpreterContext ptr.mut : context
  -> ) =>: export: cleanupContext
    context [] .variables @ map.free
    context [] .stackInfo   list.free context [] .stackInfo =
    context [] .openBlocks  list.free context [] .openBlocks =
    context [] .typeBuffer  list.free context [] .typeBuffer =
    context [] .valueBuffer list.free context [] .valueBuffer =
    context [] .labelBuffer list.free context [] .labelBuffer =
    context [] .stack list.free context [] .stack =
  end

  proc(
    Type : t
    TypeMemoryInfo : infoType
    ProgramContext ptr.mut : program
  -> ConstValue bool ) =>: export: computeTypeInfo
    program [] .errors @ =:: errors
    program [] .idContext @ =:: idContext
    idContext [] .constContext @ =:: constContext
    idContext [] .typeContext @ =:: typeContext
    typeContext [] .labelContext @ =:: labelContext
    t typeContext types.containsGeneric if
      ConstValue .none true return
    end
    infoType switch
      ALIGNMENT case
        t typeContext types.alignOf
        break
      SIZE case
        t typeContext types.sizeOf
        break
      STRIDE case
        t typeContext types.strideOf
        break
    end =:: sizeValue
    sizeValue switch
      fixed case
        sizeValue .fixed ConstValue .int false return
      dynamicArray case
        ConstValue .none true return ## XXX? support generic array size
      unknown case ## XXX? error message for unknown size
        ConstValue .none true return
    end
  end
  proc(
    Type : t
    ConstValue : value
    bool : isLength
    FilePosition : pos
    ProgramContext ptr.mut : program
  -> Type ConstValue bool ) =>: export: sizeOfValue
    ## TODO support length of initializers
    program [] .errors @ =:: errors
    program [] .idContext @ =:: idContext
    idContext [] .typeContext @ =:: typeContext
    idContext [] .constContext @ =:: constContext
    false =:: mut: isType
    t typeContext types.unwrapReference =:: mut: valType
    valType types.primitive.TYPE types.typeEquals if
      value .typeId ?? ! if
        "unexpected constant value for type type: " sb.wrap
          value constContext typeContext sb.appendConstant
        pos errors appendError
        Type .undefined ConstValue .none true return
      end
      value .typeId valType =
      true isType =
    end
    valType typeContext types.isPointer or valType typeContext types.isArray if
      valType typeContext types.isFixedSize ! if
        "cannot get the " sb.wrap
          isLength if
            "length" sb.appendS
          else
            "size" sb.appendS
          end
          " of : " sb.appendS
          valType typeContext sb.appendType
        pos errors appendError
        Type .undefined ConstValue .none true return
      end
      valType typeContext types.getArraySize =:: sizes
      isLength if
        sizes .length 0 == if
          ## return
            types.primitive.I_SIZE
            1 ConstValue .int
            false
          return
        end
        sizes
          ..dup .length 1 -
        array.get =:: outerSize
        outerSize .sizeType .int ?? if
          ## return
            types.primitive.I_SIZE
            outerSize .value ConstValue .int
            false
          return
        else outerSize .sizeType .staticArg ?? _if
          ## return
            types.primitive.I_SIZE
            outerSize .value
              LabelId cast
            ConstValue .genericArg
            false
          return
        else
          "unsupported array-size type: " sb.wrap
            ## XXX? print array-size type name
          pos errors appendError
          Type .undefined ConstValue .none true return
        end
      else
        idContext [] .argBuffer .length =:: offset
        0:i64 while ..dup sizes .length < do =:: i
          sizes i array.get =:: current
          idContext [] .argBuffer
            current .sizeType .int ?? if
              current .value ConstValue .int list.append
            else current .sizeType .staticArg ?? _if
              current .value LabelId cast ConstValue .genericArg list.append
            else ..drop
              "unsupported array-size type: " sb.wrap
                ## XXX? print array-size type name
              pos errors appendError
              Type .undefined ConstValue .none true return
            end
          idContext [] .argBuffer =
          i 1 +
        end ..drop
        sizes .length
          types.ArraySizeType .int
          types.ArraySize new
        =:: sizeLength
        ## return
          ## newArrayType
            types.primitive.I_SIZE
            types.ArrayType .ARRAY
            sizeLength @
            array.wrap
            true false
          typeContext types.newArrayType ..drop
          ## newArrayConst
            ## array.create
              idContext [] .argBuffer .data offset +
              idContext [] .argBuffer .length offset -
            array.create
            idContext [] .constContext @
          newArrayConst
          idContext [] .argBuffer
            offset list.setLength
          idContext [] .argBuffer =
          false
        return
      end
    else isLength and valType typeContext types.isComposite
        and isType or valType .initializer ?? #+XXX? check if initializer is array+# _if
      ## return
        types.primitive.I_SIZE
        valType
          typeContext types.compositeEltCount
        ConstValue .int
        false
      return
    end
    "unsupported argument type for " sb.wrap
      isLength if
        "length" sb.appendS
      else
        "size" sb.appendS
      end
      "-computation: " sb.appendS
      valType typeContext sb.appendType
    pos errors appendError
    Type .undefined ConstValue .none true return
  end
  proc(
    LabelId : generatorName
    ProcId : generatorProc
    ConstValue arrayView : args
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> bool ) =>: evalGeneratedType
    context [] .program =:: program
    program [] .errors @ =:: errors
    program [] .idContext @ =:: idContext
    idContext [] .constContext @ =:: constContext
    idContext [] .typeContext @ =:: typeContext
    typeContext [] .labelContext @ =:: labelContext
    generatorProc pos context evaluateCall if
      "could not initialize type-generator " sb.wrap
        generatorName labelContext sb.appendLabelName
      pos errors appendError
      true return
    end
    ## initializeGeneratedType
      generatorName
      args
      context [] .stack list.peek .data [] .typeId ## return value of call
      typeContext
      constContext
    types.initializeGeneratedType if
      "could not initialize type-generator " sb.wrap
        generatorName labelContext sb.appendLabelName
      pos errors appendError
      true return
    end
    false return
  end
  proc(
    LabelId : generatorName
    ConstValue arrayView : args
    FilePosition : pos
    ProgramContext ptr.mut : program
  -> bool ) =>: export: initializeGeneratedType
    program [] .errors @ =:: errors
    program [] .idContext @ =:: idContext
    idContext [] .constContext @ =:: constContext
    idContext [] .typeContext @ =:: typeContext
    typeContext [] .labelContext @ =:: labelContext
    generatorName idContext id.getIdentifier if ..drop
      "could not find procedure " sb.wrap
        generatorName labelContext sb.appendLabelName
      pos errors appendError
      true return
    end =:: idData
    idData [] .idType .PROCEDURE ?? ! if
      "expected procedure got: " sb.wrap
        idData id.asIdInfo labelContext sb.appendIdInfo
      pos errors appendError
      true return
    end
    idData [] .constValue .procedure =:: procId
    program [] .procedures
      procId i64 cast list.at .data
    =:: procData
    procData [] .procType =:: procType
    procType typeContext types.getProcIn ..drop =:: inType
    inType typeContext types.compositeElts =:: inTypes
    program
      procData [] .fileId
      InterpreterType .GLOBAL
    wrapProgram =:: mut: context
      ## push arguments
      0:i64 while ..dup inTypes .length < do =:: i
        inTypes i types.compositeElts.get =:: argType
        args i array.get =:: argValue
        argValue argType id.LABEL_ID_NONE pos context @ pushValue
        i 1 +
      end ..drop
      ## evalGeneratedType
        generatorName
        procId
        args
        pos
        context @
      evalGeneratedType
    context @ cleanupContext
    return
  end
  proc(
    Type : srcType
    SignType : signType
    ConstValue : oldValue
    Type : targetType
    TypeContext ptr : typeContext
  -> ConstValue ) =>: export: castConstant
    signType .UNSIGNED ?? or signType .NONE ?? and
      srcType typeContext types.isUnsignedInt or srcType typeContext types.isChar or
      srcType typeContext types.isSignedInt ! and
      targetType typeContext types.isUnsignedInt or targetType typeContext types.isChar
    end =:: unsignedCast
    ## XXX ? correctly handle 32-bit floats at compile time
    oldValue .Float ?? and targetType typeContext types.isInt if
      targetType typeContext types.unwrapNamed types.isPrimitive if
        targetType typeContext types.primitiveValue switch
          I8  case
            oldValue .Float unsignedCast if i8  cast.u i64 cast.u else i8  cast.s i64 cast.s end
            ConstValue .int return
          I16 case
            oldValue .Float unsignedCast if i16 cast.u i64 cast.u else i16 cast.s i64 cast.s end
            ConstValue .int return
          I32 case
            oldValue .Float unsignedCast if i32 cast.u i64 cast.u else i32 cast.s i64 cast.s end
            ConstValue .int return
          I64 case
            oldValue .Float unsignedCast if i64 cast.u else i64 cast.s end
            ConstValue .int return
          BOOL F32 F64 TYPE CHAR8 CHAR16 CHAR32 case ..unreachable
        end
      else unsignedCast _if
        oldValue .Float i64 cast.u ConstValue .int return
      else
        oldValue .Float i64 cast.s ConstValue .int return
      end
    end
    ## XXX? zero/sign extend small types
    oldValue .int ?? if
      oldValue .int i64 =: mut: intVal
      srcType typeContext types.unwrapNamed types.isPrimitive if
        srcType typeContext types.primitiveValue switch
          I8  CHAR8  case intVal i8 cast
            unsignedCast if i64 cast.u else i64 cast.s end intVal = break
          I16 CHAR16 case intVal i16 cast
            unsignedCast if i64 cast.u else i64 cast.s end intVal = break
          I32 CHAR32 case intVal i32 cast
            unsignedCast if i64 cast.u else i64 cast.s end intVal = break
          F32 F64 case break ## XXX? handle precission loss due to representing int as float
          I64 case break ## no change neccessary
          BOOL TYPE case ..unreachable
        end
      end
      ## uint -> float
      targetType typeContext types.isFloat and signType .UNSIGNED ?? or srcType typeContext types.isUnsignedInt if
        intVal f64 cast.u ConstValue .Float return
      else
        intVal ConstValue .int return
      end
    end
    oldValue return
  end
end

proc(
  Operation ptr : op
