          end
          isPtr if
            arrayConst index array.tail ConstValue .Array
          else
            arrayConst index array.get
          end
          break
        Array8 case
          pointer .Array8 =:: arrayConst
          index arrayConst .length op [] .pos errors checkIndex if
            pointer pointerInfo context unpopValue
            indexValue indexInfo context unpopValue
            true return
          end
          isPtr if
            arrayConst index array.tail ConstValue .Array8
          else
            arrayConst index array.get i64 cast.u ConstValue .Int
          end
          break
        Array16 case
          pointer .Array16 =:: arrayConst
          index arrayConst .length op [] .pos errors checkIndex if
            pointer pointerInfo context unpopValue
            indexValue indexInfo context unpopValue
            true return
          end
          isPtr if
            arrayConst index array.tail ConstValue .Array16
          else
            arrayConst index array.get i64 cast.u ConstValue .Int
          end
          break
        Array32 case
          pointer .Array32 =:: arrayConst
          index arrayConst .length op [] .pos errors checkIndex if
            pointer pointerInfo context unpopValue
            indexValue indexInfo context unpopValue
            true return
          end
          isPtr if
            arrayConst index array.tail ConstValue .Array32
          else
            arrayConst index array.get i64 cast.u ConstValue .Int
          end
          break
        Array64 case
          pointer .Array64 =:: arrayConst
          index arrayConst .length op [] .pos errors checkIndex if
            pointer pointerInfo context unpopValue
            indexValue indexInfo context unpopValue
            true return
          end
          isPtr if
            arrayConst index array.tail ConstValue .Array64
          else
