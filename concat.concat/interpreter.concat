        valInfo .valueType false
      end  =:: isType =:: containerType
      ## enum/union element initializer
      containerType
        labelId
      typeContext types.compositeFindLabel i64 cast =:: elementIndex
      elementIndex 0 < if
        "type " sb.wrap
          containerType typeContext sb.appendType
          " does not have a label \"" sb.appendS
          labelId labelContext sb.appendLabelName
          '"' sb.appendC
        op [] .pos errors appendError
      end
      containerType elementIndex typeContext types.compositeGetElement =:: eltType
      isType if
        eltType .empty ?? if
          ## pushValue
            containerType typeContext types.isEnum if
              elementIndex ConstValue .EnumLabel
            else
              ConstValue .None elementIndex constContext newUnionConst
            end
            containerType
            op [] .pos
          context pushValue
          EvalResult .Ok return
        end
        op [] .pos context popValue if ..drop.2
          "stack underflow while evaluating operation: " sb.wrap
            op [] program sb.appendOp
          op [] .pos errors appendError
          EvalResult .Error return
        end =:: eltValue =:: eltValInfo
        eltValInfo .valueType eltType typeContext types.canAutoCast if
          ## pushValue
            eltValue elementIndex constContext newUnionConst
            containerType
            op [] .pos
          context pushValue
          EvalResult .Ok return
        end
        ## unpopValue
          eltValue
          eltValInfo
        context unpopValue
        "wrong value for union element, expected " sb.wrap
          eltType typeContext sb.appendType
          " got " sb.appendS
          eltValInfo .valueType typeContext sb.appendType
        op [] .pos errors appendError
        EvalResult .Error return
      end
      isWrite if
        "setLabel is not supported " sb.wrap
        op [] .pos errors appendError
        EvalResult .Error return
      end
      value valInfo elementIndex false op [] .pos context getElement wrapResult return
    getElement setElement case
      op [] .pos context popValue if ..drop.2
        "stack underflow while evaluating operation: " sb.wrap
          op [] program sb.appendOp
        op [] .pos errors appendError
        EvalResult .Error return
      end =:: value =:: valInfo
      op [] .val .setElement ?? =:: isWrite
      isWrite if
        op [] .val .setElement
      else
        op [] .val .getElement
      end =:: eltIndex
      isWrite if
        "setElement is not supported " sb.wrap
        op [] .pos errors appendError
        EvalResult .Error return
      end
      value valInfo eltIndex false op [] .pos context getElement wrapResult return
    hasElement hasLabel case
      op [] .pos context popValue if ..drop.2
        "stack underflow while evaluating operation: " sb.wrap
          op [] program sb.appendOp
        op [] .pos errors appendError
        EvalResult .Error return
      end =:: value =:: valInfo
      op [] .val .hasElement ?? if
        op [] .val .hasElement
      else
        op [] .val .hasLabel =:: labelId
        valInfo .valueType typeContext types.isTaggedUnion ! if
          value valInfo context unpopValue
          "unexpected type for hasLabel: " sb.wrap
            valInfo .valueType typeContext sb.appendType
          op [] .pos errors appendError
          EvalResult .Error return
        end
        valInfo .valueType labelId typeContext types.compositeFindLabel
      end =:: expectedIndex
      value .EnumLabel ?? if
        value .EnumLabel expectedIndex == ConstValue .Bool
      else value .Union ?? _if
        value constUnionLabel .EnumLabel expectedIndex == ConstValue .Bool
      else
        value valInfo context unpopValue
        "unexpected value for hasElement: " sb.wrap
          value typeContext sb.appendConstant
        op [] .pos errors appendError
        EvalResult .Error return
      end
        types.primitive.BOOL
        op [] .pos
      context pushValue
      EvalResult .Ok return
    existsName case
      op [] .val .existsName =:: label
      label
        context [] .currentFile
      idContext id.findIdentifierByLabel ! =:: exists
      ..drop
      ## pushValue
        exists ConstValue .Bool
        types.primitive.BOOL
        op [] .pos
      context pushValue
      EvalResult .Ok return
    atName existsLabel case
      ## label/name should have been resolved in type-checker
      "unsupported operation in constant evaluation: " sb.wrap
        op [] program sb.appendOp
      op [] .pos errors appendError
      EvalResult .Error return
    New case
      Type : poppedType
      ValueInfo : valInfo
      false =:: mut: poppedValue
      op [] .dataType .undefined ?? if
        op [] .pos context popType if ..drop.2
          EvalResult .Error return
        end poppedType@ = valInfo@ =
        poppedType typeContext types.containsGeneric if
          "creating generic tuples is not supported" sb.wrap
          op [] .pos errors appendError
          ## unpopValue
            poppedType ConstValue .TypeId
            valInfo
          context unpopValue
          EvalResult .Error return
        end
        true poppedValue@ =
        poppedType
      else
        op [] .dataType
      end =:: targetType
      targetType typeContext types.isArray if
        ## TODO support constant evaluation of new array
        "unsupported operation in constant evaluation: " sb.wrap
          op [] program sb.appendOp
        op [] .pos errors appendError
      else targetType typeContext types.isTuple _if
        ## separate if block to avoid printing general error message on failure
        targetType op [] .pos context newTuple ! if
          EvalResult .Ok return
        end
      else
        "unsupported operation in constant evaluation: " sb.wrap
          op [] program sb.appendOp
        op [] .pos errors appendError
      end
      poppedValue if
        ## unpopValue
          poppedType ConstValue .TypeId
          valInfo
        context unpopValue
      end
      EvalResult .Error return
    NewEnum case
      op [] .val .NewEnum =:: elementIndex
      op [] .dataType =:: unionType
      unionType typeContext types.isEnum if
        elementIndex ConstValue .EnumLabel
      else unionType typeContext types.isUnion _if
        unionType
          elementIndex
        typeContext types.compositeGetElement =:: eltType
        eltType .empty ?? ! if
          op [] .pos context popValue if ..drop.2
            "missing argument for union element expected" sb.wrap
              eltType typeContext sb.appendType
            op [] .pos errors appendError
            EvalResult .Error return
          end =:: eltValue =:: eltInfo
          eltInfo .valueType eltType typeContext types.canAutoCast ! if
            eltValue eltInfo context unpopValue
            "wrong type for union element expected" sb.wrap
              eltType typeContext sb.appendType
              " got " sb.appendS
              eltInfo .valueType typeContext sb.appendType
            op [] .pos errors appendError
            EvalResult .Error return
          end
          eltValue elementIndex constContext newUnionConst
        else
          ConstValue .None elementIndex constContext newUnionConst
        end
      else
        "unexpected type for new enum: " sb.wrap
          unionType typeContext sb.appendType
        op [] .pos errors appendError
        EvalResult .Error return
      end
        unionType
        op [] .pos
        context
      pushValue
      EvalResult .Ok return
    Cast Cast! case
      Type : poppedType
      ValueInfo : valInfo
      false =:: mut: isPoppedType
      op [] .dataType .undefined ?? if
        op [] .pos context popType if ..drop.2
          EvalResult .Error return
        end poppedType@ = valInfo@ =
        true isPoppedType@ =
        poppedType typeContext types.containsGeneric if
          "generic casts are not supported" sb.wrap
          op [] .pos errors appendError
          ## casting to genetic value not possible, reset stack
          ## unpopValue
            poppedType ConstValue .TypeId
            valInfo
          context unpopValue
          EvalResult .Error return
        end
        poppedType
      else
        op [] .dataType
      end =:: targetType
      op [] .pos context popValue if ..drop.2
        isPoppedType if
          ## unpopValue
            poppedType ConstValue .TypeId
            valInfo
          context unpopValue
        end
        EvalResult .Error return
      end =:: oldValue valInfo@ = ## can overwrite value info
      ## canCast
        valInfo .valueType
        targetType
        op [] .val .Cast! ??
      typeContext types.canCast ! if
        "cannot cast " sb.wrap
          valInfo .valueType typeContext sb.appendType
          " to " sb.appendS
          targetType typeContext sb.appendType
        op [] .pos errors appendError
        EvalResult .Error return
      end
      op [] .val .Cast ?? if
        op [] .val .Cast .signType
      else
        SignType .NONE
      end =:: signType
      ## castConstant
        valInfo .valueType
        signType
        oldValue
        targetType
        typeContext
      castConstant =:: newValue
      ## pushValue
        newValue
        targetType
        op [] .pos
        context
      pushValue
      EvalResult .Ok return
    autoCast case
      op [] .val .autoCast =:: castInfo
      castInfo .offset i64 cast.u 1 + =:: offset
      offset
        "autoCast" string.wrap
      op [] .pos context checkStack if
        EvalResult .Error return
      end
      context [] .stack $ .length offset - list.get =:: value
      castInfo .src
        SignType .NONE
        value
        op [] .dataType
      typeContext castConstant =:: newValue
      value context [] .stack $ .length offset - list.set
      ## ValueInfo
        op [] .dataType
        op [] .pos
      ValueInfo new context [] .stackInfo $ .length offset - list.set
      EvalResult .Ok return
    copy case
      context [] .stack list.peek =:: value?
      value? optional.hasData if
        context [] .stackInfo
          list.peek .data [] .valueType
        =:: valType
        value? .data [] .LocalValue ?? if
          value? .data []
            .LocalValue ConstValue ptr.mut cast []
          value? .data []=
        else value? .data [] .LocalArray ?? or
            value? .data [] .LocalArray8 ?? or
            value? .data [] .LocalArray16 ?? or
            value? .data [] .LocalArray32 ?? or
            value? .data [] .LocalArray64 ?? _if
          context [] .localMemory mixedArena.offset =:: localOffset
          value? .data []
            valType context .localMemory program copyLocalArray
          value? .data []=
          ## clear memory used by copy
          context [] .localMemory
            localOffset mixedArena.reset
          context .localMemory =
        else
          "unexpected constant for copy, expected local memory got: " sb.wrap
            value? .data [] typeContext sb.appendConstant
          op [] .pos errors appendError
        end
      end
      EvalResult .Ok return
    Assert RuntimeAssert case
      op [] .val .Assert ?? if
        true op [] .pos context popString if ..drop.2
          EvalResult .Error return
        end ..swap ..drop
      else
        op [] .val .RuntimeAssert
      end =:: message
      op [] .pos context popValue if
        ..drop.2
        "missing argument for assert, expected boolean" sb.wrap
        op [] .pos errors appendError
        EvalResult .Error return
      end =:: value =:: valInfo
      value .Bool ?? ! if
        "wrong constant value for assert, expected boolean got: " sb.wrap
          value typeContext sb.appendConstant
        op [] .pos errors appendError
        EvalResult .Ok return
      end
      value .Bool ! if
        "assertion failed: " sb.wrap
          message sb.appendStr
        op [] .pos errors appendError
      end
      EvalResult .Ok return
    panic panicWithMessage case
      op [] .val .panic ?? if
        true op [] .pos context popString if ..drop.2
          EvalResult .Error return
        end ..swap ..drop
      else
        op [] .val .panicWithMessage
      end =:: message
      "PANIC!: " sb.wrap
        message sb.appendStr
      op [] .pos errors appendError
      EvalResult .Error return
    Error case
      false op [] .pos context popString if ..drop.2
        EvalResult .Error return
      end =:: msg ..drop
      msg sb.fromStr
        context [] .callPositions .length 0 > if
          context [] .callPositions list.peek .data []
        else
          op [] .pos
        end
        errors
      op [] .val .Error switch
        ERROR case appendError break
        WARNING case appendWarning break
        INFO case appendInfo break
      end
      EvalResult .Ok return
    length size case
      op [] .pos context popValue if ..drop.2
        EvalResult .Error return
      end =:: value =:: valInfo
      ## sizeOfValue
        valInfo .valueType
        value
        op [] .val .length ??
        op [] .pos
        program
      interpreter.sizeOfValue if ..drop.2
        "could not compute size: " sb.wrap
          op [] program sb.appendOp
        op [] .pos errors appendError
        value valInfo context unpopValue
        EvalResult .Error return
      end =:: constVal =:: constType
      ## pushValue
        constVal
        constType
        op [] .pos
        context
      pushValue
      EvalResult .Ok return
    typeInfo case
      Type : poppedType
      ValueInfo : valInfo
      false =:: mut: poppedValue
      op [] .dataType .undefined ?? if
        op [] .pos context popType if ..drop.2
          EvalResult .Error return
        end poppedType@ = valInfo@ =
        true poppedValue@ =
        poppedType typeContext types.containsGeneric if
          "generic types are not supported" sb.wrap
          op [] .pos errors appendError
          ## computing size not possible, reset stack
          ## unpopValue
            poppedType ConstValue .TypeId
            valInfo
          context unpopValue
          EvalResult .Error return
        end
        poppedType
      else
        op [] .dataType
      end =:: targetType
      ## pushValue
        ## computeTypeInfo
          targetType
          op [] .val .typeInfo
        program computeTypeInfo if ..drop
          "could not compute size of type" sb.wrap
            targetType typeContext sb.appendType
          op [] .pos errors appendError
          ## computing size not possible, reset stack
          poppedValue if
            ## unpopValue
              poppedType ConstValue .TypeId
              valInfo
            context unpopValue
          end
          EvalResult .Error return
        end
        types.primitive.I_SIZE
        op [] .pos
        context
      pushValue
      EvalResult .Ok return
    builtIn case
      op [] .dataType op [] .val .builtIn op [] .pos context tryEvaluateBuiltIn wrapResult return
    equalityOperator case
      ConstValue 2 array new =:: mut: valueData
      valueData@ =:: values
      ValueInfo 2 array new =:: mut: valInfoData
      valInfoData@ =:: valInfos
      0:i64 =:: mut: nArgs
      0 while ..dup 2 < do 1 +
        op [] .pos context popValue if ..drop.3
          values valInfos nArgs context unpopValues
          EvalResult .Error return
        end values nArgs []= valInfos nArgs []=
        nArgs 1 + nArgs@ =
      end ..drop
      ## mergeTypes
        valInfos 0 [] .valueType
        valInfos 1 [] .valueType
      typeContext types.mergeTypes if ..drop
        "incompatible types for equality check: " sb.wrap
          valInfos 0 [] .valueType typeContext sb.appendType
          " and " sb.appendS
          valInfos 1 [] .valueType typeContext sb.appendType
        op [] .pos errors appendError
        values valInfos nArgs context unpopValues
        EvalResult .Error return
      end =:: resType
      ## pushValue
        values 1 [] values 0 [] resType typeContext interpreter.operatorEq if ..drop
          "unsupported values for equality check: " sb.wrap
            values 0 [] typeContext sb.appendConstant
            " and " sb.appendS
            values 1 [] typeContext sb.appendConstant
          op [] .pos errors appendError
          values valInfos nArgs context unpopValues
          EvalResult .Error return
        end
          op [] .val .equalityOperator .NEQ ?? ^ ## invert result for NEQ
        ConstValue .Bool
        types.primitive.BOOL
        op [] .pos
        context
      pushValue
      EvalResult .Ok return
    stackMod case
      op [] .val .stackMod .modType switch
        DROP case
          op [] .val .stackMod .n i64 cast.u
            "drop" string.wrap
          op [] .pos context checkStack if
            EvalResult .Error return
          end
          context [] .stack .length op [] .val .stackMod .n i64 cast.u - context truncateStack
          EvalResult .Ok return
        COPY case
          op [] .val .stackMod .n i64 cast.u 1 + =:: offset
          offset
            "stack modification" string.wrap
          op [] .pos context checkStack if
            EvalResult .Error return
          end
          context [] .stack
            $ $1 .length offset - list.get list.append
          context .stack =
          context [] .stackInfo
            $ $1 .length offset - list.get list.append
          context .stackInfo =
          EvalResult .Ok return
        SWAP case
          2
            "swap" string.wrap
          op [] .pos context checkStack if
            EvalResult .Error return
          end
          op [] .pos context popValue
            ! "hasValue" assert
          =:: upper =:: upperInfo
          op [] .pos context popValue
            ! "hasValue" assert
          =:: lower =:: lowerInfo
          context [] .stack
            upper list.append
            lower list.append
          context .stack =
          context [] .stackInfo
            upperInfo list.append
            lowerInfo list.append
          context .stackInfo =
          EvalResult .Ok return
      end
      break
    setValue case
      op [] .pos context popValue if ..drop.2
        EvalResult .Error return
      end =:: targetValue =:: targetInfo
      op [] .pos context popValue if ..drop.2
        targetValue targetInfo context unpopValue
        EvalResult .Error return
      end =:: value =:: valueInfo
      ConstValue ..length 23 == "no new constants" assert
      targetValue switch
        LocalValue case
          value targetValue .LocalValue ConstValue _ ptr.mut cast []=
          EvalResult .Ok return
        LocalArray case
          value .Array ?? if
            value .Array
          else value .LocalArray ?? _if
            value .LocalArray ConstValue arrayView.mut cast array.freeze
          else
            "unexpected source for assignment expected array got:" sb.wrap
              value typeContext sb.appendConstant
            op [] .pos errors appendError
            EvalResult .Error return
          end =:: srcArray
          targetValue .LocalArray srcArray op [] .pos errors setLocalArray return
        LocalArray8 case
          value targetValue .LocalArray8 i8 primitiveArrayTrySetElement if
            EvalResult .Ok return
          end
          value .Array8 ?? if
            value .Array8
          else value .LocalArray8 ?? _if
            value .LocalArray8 i8 arrayView.mut cast array.freeze
          else
            "unexpected source for assignment expected array got:" sb.wrap
              value typeContext sb.appendConstant
            op [] .pos errors appendError
            EvalResult .Error return
          end =:: srcArray
          targetValue .LocalArray8 srcArray op [] .pos errors setLocalArray return
        LocalArray16 case
          value targetValue .LocalArray16 i16 primitiveArrayTrySetElement if
            EvalResult .Ok return
          end
          value .Array16 ?? if
            value .Array16
          else value .LocalArray16 ?? _if
            value .LocalArray16 i16 arrayView.mut cast array.freeze
          else
            "unexpected source for assignment expected array got:" sb.wrap
              value typeContext sb.appendConstant
            op [] .pos errors appendError
            EvalResult .Error return
          end =:: srcArray
          targetValue .LocalArray16 srcArray op [] .pos errors setLocalArray return
        LocalArray32 case
          value targetValue .LocalArray32 i32 primitiveArrayTrySetElement if
            EvalResult .Ok return
          end
          value .Array32 ?? if
            value .Array32
          else value .LocalArray32 ?? _if
            value .LocalArray32 i32 arrayView.mut cast array.freeze
          else
            "unexpected source for assignment expected array got:" sb.wrap
              value typeContext sb.appendConstant
            op [] .pos errors appendError
            EvalResult .Error return
          end =:: srcArray
          targetValue .LocalArray32 srcArray op [] .pos errors setLocalArray return
        LocalArray64 case
          value targetValue .LocalArray64 i64 primitiveArrayTrySetElement if
            EvalResult .Ok return
          end
          value .Array64 ?? if
            value .Array64
          else value .LocalArray64 ?? _if
            value .LocalArray64 i64 arrayView.mut cast array.freeze
          else
            "unexpected source for assignment expected array got:" sb.wrap
              value typeContext sb.appendConstant
            op [] .pos errors appendError
            EvalResult .Error return
          end =:: srcArray
          targetValue .LocalArray64 srcArray op [] .pos errors setLocalArray return
        default
          "unexpected target for setValue, expected writable memory location got: " sb.wrap
            targetValue typeContext sb.appendConstant
          op [] .pos errors appendError
          value valueInfo context unpopValue
          targetValue targetInfo context unpopValue
          EvalResult .Error return
      end
      break
    compilerInfo case
      op [] .val .compilerInfo switch
        typeInfo case
          op [] .val .compilerInfo .typeInfo =:: info
          ## printTypes
            false
            info .count
            info .depth
          context printTypes
          EvalResult .Ok return
        stackInfo case
          ## printTypes
            true
            op [] .val .compilerInfo .stackInfo
            0
          context printTypes
          EvalResult .Ok return
        compiledOps case
          EvalResult .Ok return ## TODO print ops
        find case
          EvalResult .Ok return ## TODO find
      end
      break
    getEnumLabel
    NewEnumReference callPtr
    argc getArg implementProcedure procPtr
    bitCast
    ConstantReference NewReference
    checkEnumLabel setEnumLabel setEnumElement
    unreachable case
      "unsupported operation in constant evaluation: " sb.wrap
        op [] program sb.appendOp
      op [] .pos errors appendError
      EvalResult .Error return
  end
end

namespace: interpreter
  proc(
    Type : calledType
    BuiltIn : builtIn
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> bool ) =>: tryEvaluateBuiltIn
    context [] .program .errors =:: errors
    context [] .program =:: program
    context [] .program .idContext =:: idContext
    idContext .constContext =:: constContext
    idContext .typeContext =:: typeContext
    typeContext .labelContext =:: labelContext
    calledType typeContext types.getProcIn
      ! "has procedure in" assert
    =:: inType
    inType typeContext types.compositeElts =:: inTypes
    ConstValue 3 array new =:: mut: valueData
    valueData@ =:: values
    ValueInfo 3 array new =:: mut: valInfoData
    valInfoData@ =:: valInfos
    0:i64 =:: mut: nArgs
    inTypes .length 1 - while ..dup 0 >= do =:: i
      nArgs 3 < "built-ins have at most three arguments" assert
      inTypes i types.compositeElts.get =:: eltType
      pos context popValue if ..drop.2
        values valInfos nArgs context unpopValues
        true return
      end values nArgs []= valInfos nArgs []=
      valInfos nArgs [] .valueType eltType typeContext types.canAutoCast ! if
        "wrong argument type for built-in " sb.wrap
          builtIn sb.appendBuiltIn
          " expected: " sb.appendS
          eltType typeContext sb.appendType
          " got: " sb.appendS
          valInfos nArgs [] .valueType typeContext sb.appendType
        pos errors appendError
        values valInfos nArgs 1 + context unpopValues
        true return
      end
      nArgs 1 + nArgs@ =
      i 1 -
    end ..drop
    ## bring arguments in correct order
    values nArgs array.reverse
    valInfos nArgs array.reverse
    builtIn
      values
      nArgs i32 cast
    pos typeContext errors interpreter.evaluateBuiltIn =:: resultType =:: value
    resultType switch
      success case
        calledType typeContext types.getProcRet
          ! "has return type" assert
        =:: retType
        retType .empty ?? ! if
          value
            retType
            pos
            context
          pushValue
        end
        false return
      argumentError case
        "invalid arguments for built-in " sb.wrap
          builtIn sb.appendBuiltIn
          ": " sb.appendS
          0:i64 while ..dup nArgs < do =:: i
            values i [] typeContext sb.appendConstant
            ", " sb.appendS
            i 1 +
          end ..drop
        pos errors appendError
        values nArgs array.reverse
        valInfos nArgs array.reverse
        values valInfos nArgs context unpopValues
        true return
      unimplemented case
        "unsupported built-in in constant evaluation: " sb.wrap
          builtIn sb.appendBuiltIn
        pos errors appendError
        values nArgs array.reverse
        valInfos nArgs array.reverse
        values valInfos nArgs context unpopValues
        true return
    end
  end
  proc(
    LabelId : procName
    Type : procIn
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> bool ) =>: evaluateExternCall
    context [] .program =:: program
    program .errors =:: errors
    program .idContext .typeContext =:: typeContext
    typeContext .labelContext =:: labelContext
    "memcpy":s procName labelContext id.labelNameEq if
      procIn typeContext types.compositeEltArray =:: args
      args .length 3 != or
          args 0 array.get typeContext types.isPointer ! or
          args 0 array.get typeContext types.isMutable ! or
          args 1 array.get typeContext types.isPointer ! or
          args 2 array.get typeContext types.isIntLike ! if
        "unexpected arguments for `memcpy` expected: " sb.wrap
          "( <ptr.mut> <ptr> <int-primitive> -> ... ) got: ( " sb.appendS
          procIn typeContext sb.appendType
          " -> ... )" sb.appendS
        pos errors appendError
        true return
      end
      3 "memcpy":s pos context checkStack if
        true return
      end
      pos context popValue ! "hasValue" assert =:: lenValue =:: lenInfo
      pos context popValue ! "hasValue" assert =:: srcValue =:: srcInfo
      pos context popValue ! "hasValue" assert =:: targetValue =:: targetInfo
      lenValue .Int ?? if
        lenValue .Int
      else ## XXX? support GenericArg as length
        "unexpected argument for memcpy, expected Integer got: " sb.wrap
          lenValue typeContext sb.appendConstant
        pos errors appendError
        targetValue targetInfo context unpopValue
        srcValue srcInfo context unpopValue
        lenValue lenInfo context unpopValue
        true return
      end =:: length
      targetValue srcValue length pos program opMemcopy if ..drop
        targetValue targetInfo context unpopValue
        srcValue srcInfo context unpopValue
        lenValue lenInfo context unpopValue
        true return
      end =:: resPtr
      resPtr
        args 0 array.get
        pos
      context pushValue
      false return
    end
    "call to unsupported extern procedure: " sb.wrap
      procName labelContext sb.appendLabelName
    pos errors appendInfo
    true return
  end
end

proc(
  Operation arrayView : ops
  InterpreterContext ptr.mut : context
->
  bool
) =>: evaluateOperations
  using interpreter
  0:i64 while $ ops .length < do =:: offset
    ops offset array.at .data =:: op
      op context evaluateOperation =:: result
      result switch
        Error case true return
        Return case false return
        Ok case offset break
        Jump case offset result .Jump i64 cast.s + break
      end
  finally 1 + end ..drop
  ## XXX? error if unwanted open blocks
  false return
end

namespace: interpreter
  proc(
    Type : tupleType
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> bool ) =>: newTuple
    context [] .program .errors =:: errors
    context [] .program =:: program
    context [] .program .idContext =:: idContext
    idContext .constContext =:: constContext
    idContext .typeContext =:: typeContext
    typeContext .labelContext =:: labelContext
    tupleType typeContext types.compositeElts =:: elts
    elts .length "tuple-creation" string.wrap pos context checkStack if
      true return
    end
    context [] .stack .length elts .length - =:: offset
    0:i64 while ..dup elts .length < do =:: i
      context [] .stackInfo offset i + list.at .data =:: stackInfo
      stackInfo [] .valueType elts i types.compositeElts.get typeContext types.canAutoCast ! if
        "wrong argument for tuple creation expected: " sb.wrap
          elts i types.compositeElts.get typeContext sb.appendType
          " got: " sb.appendS
          stackInfo [] .valueType typeContext sb.appendType
        pos errors appendError
        true return
      end
      i 1 +
    end ..drop
    context [] .stack list.asArray
      offset array.tail
    constContext newArrayConst =:: tupleConst
    ## remove arguments and push tuple
    offset context truncateStack
    context [] .stack
      tupleConst list.append
    context .stack =
    context [] .stackInfo
      ## ValueInfo
        tupleType
        pos
      ValueInfo new list.append
    context .stackInfo =
    false return
  end
end
#+evaluate procedure body with the given arguments+#
proc(
  ProcId : procId
  i64 : implId
  ConstValue arrayView : autoArgs
  bool : consumeStaticArgs
  FilePosition : pos
  InterpreterContext ptr.mut : context
->
  bool
) =>: export: evaluateCall
  using interpreter
  context [] .program .errors =:: errors
  context [] .program =:: program
  context [] .program .idContext =:: idContext
  idContext .constContext =:: constContext
  idContext .typeContext =:: typeContext
  typeContext .labelContext =:: labelContext
  program [] .procedures procId i64 cast list.at .data =:: procData
  procData [] .procType =:: procType
  procType typeContext types.getProcIn ..drop =:: inType
  0:i64 ## XXX? is there a better way to get number of non-auto static args
    implId -1:i64 != if
      inType typeContext types.compositeEltCount for =:: i
        inType i typeContext types.compositeGetLabel =:: label
        label labelContext id.labelFlags =:: flags
        flags id.FLAG_STATIC & ? and flags id.FLAG_AUTO & ? ! if
          1 +
        end
      end
    end
  =:: nStaticArgs
  inType typeContext types.compositeElts =:: args
  args .length autoArgs .length -
    consumeStaticArgs ! if nStaticArgs - end
  =:: nArgs
  procData [] .implementation .builtIn ?? if
    implId -1:i64 != if
      "generic built-ins are not supported" sb.wrap
      pos errors appendError
    end
    ## tryEvaluateBuiltIn
      procType
      procData [] .implementation .builtIn .builtIn
    pos context tryEvaluateBuiltIn return
  else procData [] .implementation .code ?? ! _if
    "unexpected implementation type" sb.wrap
    pos errors appendError
    true return
  end
  nArgs "procedure call" string.wrap pos context checkStack if
    128 sb.create
      "inType: (" sb.appendS
      inType typeContext sb.appendType
      "-> ... ) arguments: " sb.appendS
      args .length sb.appendI
      " auto-args: " sb.appendS
      autoArgs .length sb.appendI
    pos errors appendInfo
    true return
  end
  context [] .stack .length nArgs - =:: argsOffset
  procData [] .labelId =:: procName
  procType typeContext types.getProcOut ..drop =:: outType
  outType typeContext types.compositeEltCount 1 == and
      outType 0 typeContext types.compositeGetElement types.primitive.TYPE types.typeEquals if
    ## findGeneratedType
      procName
      context [] .stack list.asArray argsOffset array.tail
      true
      typeContext
      constContext
    types.findGeneratedType ! if =:: genType
      argsOffset context truncateStack
      ## pushValue
        genType ConstValue .TypeId
        types.primitive.TYPE
        pos
      context pushValue
      false return
      ## TODO reuse value of type-generator
    end ..drop
    true
  else false end =:: isTypeGenerator
  procName labelContext id.labelFlags id.FLAG_EXTERN & ? and
      procData [] .implementation .code ?? and
      procData [] .implementation .code .codeState .PARSING ?? if
    procName inType pos context evaluateExternCall return
  end
  procData [] .isStatic ! and context [] .typeChecker optional.hasData if
    procId implId pos context [] .typeChecker .data typeCheckChildProcedures
  end
  context [] .stack .length =:: stackOffset
  context [] .openBlocks .length =:: prevBlocks
  BlockType .PROCEDURE true context openBlock
  0:i64 =:: mut: autoArgOffset
  0:i64 =:: mut: staticArgOffset
  argsOffset =:: mut: argOffset
  context [] .localVariables =:: prevVariables
  context [] .localMemory mixedArena.offset =:: offset
  context [] .localMemory
    LabelId Constant hashMap mixedArena.alloc =:: newVariables
  context .localMemory =
  ## XXX? allocate lookup table in localMemory
  labelHash@ labelEq@ 256 Constant map.create newVariables []=
  newVariables optional.wrap context .localVariables =
  ## process procedure arguments
  false =:: mut: hasGenericArg
  false =:: mut: hasNonStaticGenericArg
  0:i64 while $ args .length < do =:: i
    inType i typeContext types.compositeGetLabel =:: label
    label labelContext id.labelFlags =:: labelFlags
    labelFlags id.FLAG_AUTO & ? if
      autoArgs autoArgOffset array.get
        $ .GenericArg ?? if
          .GenericArg =:: varId
          prevVariables optional.hasData and
              prevVariables .data varId map.get =:: labelValue?
            labelValue? ? if
            labelValue? .data .value
          else
            "missing generic value " sb.wrap
              varId i64 cast sb.appendI
              ":LabelId" sb.appendS
            pos errors appendError
            varId ConstValue .GenericArg
          end
        end
      =:: value
      context [] .localVariables .data
        label
        ## Constant
          value
          ## ValueInfo
            args i types.compositeElts.get
            pos
          ValueInfo new
        Constant new
      map.put ..drop
      autoArgOffset 1 + autoArgOffset@ =
      labelFlags id.FLAG_STATIC & ? if
        staticArgOffset 1 + staticArgOffset@ =
      end
      continue
    end
    consumeStaticArgs ! and procData [] .isStatic ! and labelFlags id.FLAG_STATIC & ? if
      implId 0 >= "implId is not negative" assert
      procData .implementation .code [] .implementations
        implId list.at .data
      [] .staticArgs staticArgOffset array.get =:: value
      context [] .localVariables .data
        label
        ## Constant
          value
          ## ValueInfo
            args i types.compositeElts.get
            pos
          ValueInfo new
        Constant new
      map.put ..drop
      staticArgOffset 1 + staticArgOffset@ =
      continue
    end
    argOffset stackOffset >= if
      "not enough arguments for procedure " sb.wrap
        procName labelContext sb.appendLabelName
      pos errors appendError
      stackOffset context truncateStack
      context [] .localVariables .data map.free
      prevVariables context .localVariables =
      context [] .localMemory offset mixedArena.reset context .localMemory =
      context [] .openBlocks
        prevBlocks list.setLength
      context .openBlocks =
      true return
    end
    context [] .stack argOffset list.at .data =:: value
    context [] .stackInfo argOffset list.at .data =:: valueInfo
    value [] .GenericArg ?? if
      true hasGenericArg@ =
      isTypeGenerator and
          value [] .GenericArg labelContext id.labelFlags id.FLAG_STATIC & ? ! if
        "Arguments for Type-generators should be static" sb.wrap
        valueInfo [] .pushedAt errors appendError
      end
    else value [] .TypeId ?? and value [] .TypeId typeContext types.isGeneric _if
      true hasGenericArg@ =
    end
    argOffset 1 + argOffset@ =
    label id.LABEL_ID_NONE == or labelFlags id.FLAG_DUMMY & ? if ## push argument
      context [] .stack
        value list.appendP
      context .stack =
      context [] .stackInfo
        ## ValueInfo
          valueInfo [] .valueType
          pos
        ValueInfo new list.append
      context .stackInfo =
    else ## store argument as value
      context [] .localVariables .data
        label
        ## Constant
          value []
          valueInfo []
        Constant new
      map.put ..drop
    end
  finally
    i 1 +
  end ..drop
  ## don't evaluate type-generator for generic arguments
  isTypeGenerator and hasGenericArg if
    ## initializeGeneratedType
      procName
      context [] .stack argsOffset nArgs list.slice
      Type .undefined
      typeContext
      constContext
    types.initializeGeneratedType =:: generatorType
    argsOffset context truncateStack
    ## pushValue
      generatorType ConstValue .TypeId
      types.primitive.TYPE
      pos
    context pushValue
    context [] .localVariables .data map.free
    prevVariables context .localVariables =
    context [] .localMemory offset mixedArena.reset context .localMemory =
    context [] .openBlocks
      prevBlocks list.setLength
    context .openBlocks =
    false return
  end
  procData .implementation .code =:: codeImpl
  implId 0 >= if
    program [] .progFiles
      procData [] .fileId i64 cast
    list.at .data [] .localOps
      codeImpl [] .implementations
        implId list.at .data
      =:: currentImpl
      currentImpl .codeState .TYPE_CHECKED ?? ! if
        "no implementaion for procedure " sb.wrap
          procName labelContext sb.appendLabelName
        pos errors appendError
      end
      currentImpl [] .codeStart
      currentImpl [] .codeLength
    list.slice
  else
    codeImpl [] .codeState switch
      PARSING case
        "procedure " sb.wrap
          procName labelContext sb.appendLabelName
          " has not finished parsing" sb.appendS
        pos errors appendError
        Operation array.empty break
      TYPE_CHECKING case
        "procedure " sb.wrap
          procName labelContext sb.appendLabelName
          " has not finished type-checking" sb.appendS
        pos errors appendError
        Operation array.empty break
      PARSED case
        program [] .tmpOps
          codeImpl [] .codeStart
          codeImpl [] .codeLength
        list.slice
        break
      TYPE_CHECKED case
        program [] .progFiles
          procData [] .fileId i64 cast
        list.at .data [] .localOps
            codeImpl [] .codeStart
            codeImpl [] .codeLength
        list.slice
        break
    end
  end =:: code
  code .length 0 == if
    "no operations in procedure " sb.wrap
      procName labelContext sb.appendLabelName
    pos errors appendError
    stackOffset context truncateStack
    context [] .localVariables .data map.free
    prevVariables context .localVariables =
    context [] .localMemory offset mixedArena.reset context .localMemory =
    context [] .openBlocks
      prevBlocks list.setLength
    context .openBlocks =
    true return ## not a call
  end
  code 0 array.at .data =:: op
  op [] .val .implementProcedure ?? ! and
      op [] .val .initializeId ?? ! or
      op [] .val .initializeId .idType .PROCEDURE ?? ! if
    "expected procedure initialization got " sb.wrap
      op [] program sb.appendOp
    op [] .pos errors appendError
    stackOffset context truncateStack
    context [] .localVariables .data map.free
    prevVariables context .localVariables =
    context [] .localMemory offset mixedArena.reset context .localMemory =
    context [] .openBlocks
      prevBlocks list.setLength
    context .openBlocks =
    true return ## not a call
  end
  context [] .currentFile =:: oldFile
  procData [] .fileId context .currentFile =
  context [] .evalType =:: prevType
  ## change interpreter type when evaluating call
  procData [] .isStatic if
    implId -1 == "static procedure has implId -1" assert
    ## XXX? seperate interpreter type code in static procedure?
    InterpreterType .GLOBAL
  else
    InterpreterType .INTERPRET
  end context .evalType =
  context [] .callPositions
    pos list.append
  context .callPositions =
  ## evaluateOperations
    code 1 array.tail ## first operation declares procedure
    context
  evaluateOperations if
    stackOffset context truncateStack
    context [] .callPositions
      list.pop ..drop
    context .callPositions =
    context [] .localVariables .data map.free
    prevVariables context .localVariables =
    context [] .localMemory offset mixedArena.reset context .localMemory =
    context [] .openBlocks
      prevBlocks list.setLength
    context .openBlocks =
    prevType context .evalType =
    true return
  end
  context [] .callPositions
    list.pop ..drop
  context .callPositions =
  ## TODO ensure returned values do not point to deleted local memory
  context [] .localVariables .data map.free
  prevVariables context .localVariables =
  context [] .localMemory
    offset mixedArena.reset
  context .localMemory =
  ## FIXME static procedures don't cast their return value
  isTypeGenerator if
    context [] .stack .length 1 < if
      "could not initalized type generator " sb.wrap
        procName labelContext sb.appendLabelName
      pos errors appendError
      true return
    end
    context [] .stack
      list.pop =:: retValue
      retValue .TypeId ?? ! if ..drop
        "could not initalized type generator " sb.wrap
          procName labelContext sb.appendLabelName
          " expected type got " sb.appendS
          retValue typeContext sb.appendConstant
        pos errors appendError
        true return
      end
      retValue .TypeId =:: generatedType
    context .stack =
    ## initializeGeneratedType
      procName
      context [] .stack argsOffset nArgs list.slice
      generatedType
      typeContext
      constContext
    types.initializeGeneratedType =:: generatorType
    context [] .stack
      generatorType ConstValue .TypeId list.append
    context .stack =
  end
  prevType context .evalType =
  oldFile context .currentFile =
  context [] .stack .length stackOffset - =:: nReturn
  ## mem.copy
    context [] .stack .data argsOffset +
    context [] .stack .data stackOffset +
    nReturn
  mem.copy ..drop
  ## mem.copy
    context [] .stackInfo .data argsOffset +
    context [] .stackInfo .data stackOffset +
    nReturn
  mem.copy ..drop
  context [] .stack
    argsOffset nReturn + list.setLength
  context .stack =
  context [] .stackInfo
    argsOffset nReturn + list.setLength
  context .stackInfo =
  argsOffset while ..dup context [] .stackInfo .length < do
    ## update push position of return values
    pos context [] .stackInfo ..over.2 list.at .data .pushedAt =
    1 +
  end ..drop
  false return
end
