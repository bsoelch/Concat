          pointer pointerInfo context unpopValue
          indexValue indexInfo context unpopValue
          "unexpected constant for pointer value: " sb.wrap
            pointer typeContext sb.appendConstant
          op [] .pos errors appendError
          true return
      end =:: newValue
      ## pushValue
        newValue
        newType
        id.LABEL_ID_NONE
        op [] .pos
      context pushValue
      false return
    atId atElement getEnumLabel setValue
    NewEnum callPtr
    argc getArg implementProcedure procPtr
    bitCast NewEnumReference
    ConstantReference NewReference
    checkEnumLabel setEnumLabel
    hasElement
    compilerInfo unreachable case
      context [] .evalType switch
        INTERPRET GLOBAL case
          "unsupported operation in constant evaluation: " sb.wrap
            op [] program sb.appendOp
          op [] .pos errors appendError
          break
        FOLD_LOCAL case break
      end
      true return
  end
end

namespace: interpreter
  proc(
    Type : calledType
    BuiltIn : builtIn
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> bool ) =>: tryEvaluateBuiltIn
    context [] .program [] .errors @ =:: errors
    context [] .program =:: program
    context [] .program [] .idContext @ =:: idContext
    idContext [] .constContext @ =:: constContext
    idContext [] .typeContext @ =:: typeContext
    typeContext [] .labelContext @ =:: labelContext
    calledType typeContext types.getProcIn
      ! assert "has procedure in"
    =:: inType
    inType typeContext types.compositeElts =:: inTypes
    ConstValue 3 array new =:: mut: valueData
    valueData @ =:: values
    ValueInfo 3 array new =:: mut: valInfoData
    valInfoData @ =:: valInfos
    0:i64 =:: mut: nArgs
    context [] .evalType .FOLD_LOCAL ?? ! =:: showErrors
    inTypes .length 1 - while ..dup 0 >= do =:: i
      nArgs 3 < assert "built-ins have at most three arguments"
      inTypes i types.compositeElts.get =:: eltType
      pos context popValue if ..drop.2
        values valInfos nArgs context unpopValues
        true return
      end values nArgs [] = valInfos nArgs [] =
      valInfos nArgs [] .valueType eltType typeContext types.canAutoCast ! if
        showErrors if
          "wrong argument type for built-in " sb.wrap
            builtIn sb.appendBuiltIn
            " expected: " sb.appendS
            eltType typeContext sb.appendType
            " got: " sb.appendS
            valInfos nArgs [] .valueType typeContext sb.appendType
          pos errors appendError
        end
        values valInfos nArgs 1 + context unpopValues
        true return
      end
      nArgs 1 + nArgs =
      i 1 -
    end ..drop
    ## bring arguments in correct order
    values nArgs array.reverse
    valInfos nArgs array.reverse
    ## XXX ensure type arguments for pointer built-ins are present
    builtIn
      values
      nArgs i32 cast
    pos errors interpreter.evaluateBuiltIn =:: resultType =:: value
    resultType switch
      success case
        value
          calledType typeContext types.getProcRet
            ! assert "has return type"
          id.LABEL_ID_NONE
          pos
          context
        pushValue
        false return
      argumentError case
        showErrors if
          "invalid arguments for built-in " sb.wrap
            builtIn sb.appendBuiltIn
            ": " sb.appendS
            0:i64 while ..dup nArgs < do =:: i
              values i [] typeContext sb.appendConstant
              ", " sb.appendS
              i 1 +
            end ..drop
          pos errors appendError
        end
        values nArgs array.reverse
        valInfos nArgs array.reverse
        values valInfos nArgs context unpopValues
        true return
      unimplemented case
        showErrors if
          "unsupported built-in in constant evaluation: " sb.wrap
            builtIn sb.appendBuiltIn
          pos errors appendError
        end
        values nArgs array.reverse
        valInfos nArgs array.reverse
        values valInfos nArgs context unpopValues
        true return
    end
  end
end

proc(
  Operation arrayView : ops
  InterpreterContext ptr.mut : context
->
  bool
) =>: evaluateOperations
  using interpreter
  0:i64 =:: mut: offset
  context [] .openBlocks list.peek =:: outerBlock
  outerBlock optional.hasData and
      outerBlock .data [] .blockType =:: outerType
      outerType .PROCEDURE ?? or outerType .EXPERIMENTAL_PROCEDURE ?? if
    context [] .openBlocks .length
  else
    -1
  end =:: procBlockIndex
  while offset ops .length < do
    ops offset array.at .data =:: op
      op context evaluateOperation if
        true return
      end
      context [] .openBlocks .length procBlockIndex < if
        false return ## break evaluation when leaving procedure block
      end
    offset 1 + offset =
  end
  ## XXX error if unwanted open blocks
  false return
end

namespace: interpreter
  proc(
    Type : tupleType
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> bool ) =>: newTuple
    context [] .program [] .errors @ =:: errors
    context [] .program =:: program
    context [] .program [] .idContext @ =:: idContext
    idContext [] .constContext @ =:: constContext
    idContext [] .typeContext @ =:: typeContext
    typeContext [] .labelContext @ =:: labelContext
    tupleType typeContext types.compositeElts =:: elts
    elts .length "tuple-creation" string.wrap true pos context checkStack if
      true return
    end
    context [] .stack .length elts .length - =:: offset
    0:i64 while ..dup elts .length < do =:: i
      context [] .stackInfo offset i + list.at .data =:: stackInfo
      stackInfo [] .valueType elts i types.compositeElts.get typeContext types.canAutoCast ! if
        "wrong argument for tuple creation expected: " sb.wrap
          elts i types.compositeElts.get typeContext sb.appendType
          " got: " sb.appendS
          stackInfo [] .valueType typeContext sb.appendType
        pos errors appendError
        true return
      end
      i 1 +
    end ..drop
    context [] .stack list.asArray
      offset array.tail
    constContext newArrayConst =:: tupleConst
    ## remove arguments and push tuple
    offset context truncateStack
    context [] .stack
      tupleConst list.append
    context [] .stack =
    context [] .stackInfo
      ## ValueInfo
        tupleType
        pos
      ValueInfo new list.append
    context [] .stackInfo =
    false return
  end
end
#+evaluate procedure body with the given arguments+#
proc(
  ProcId : procId
  i64 : implId
  ConstValue arrayView : autoArgs
  FilePosition : pos
  InterpreterContext ptr.mut : context
->
  bool
) =>: export: evaluateCall
  using interpreter
  context [] .program [] .errors@ =:: errors
  context [] .program =:: program
  context [] .program [] .idContext@ =:: idContext
  idContext [] .constContext@ =:: constContext
  idContext [] .typeContext@ =:: typeContext
  typeContext [] .labelContext@ =:: labelContext
  program [] .procedures procId i64 cast list.at .data =:: procData
  procData [] .procType =:: procType
  procType typeContext types.getProcIn ..drop =:: inType
  inType typeContext types.compositeElts =:: args
  args .length autoArgs .length - =:: nArgs
  procData [] .implementation .builtIn ?? if
    implId -1:i64 != if
      "generic built-ins are not supported" sb.wrap
      pos errors appendError
    end
    ## tryEvaluateBuiltIn
      procType
      procData [] .implementation .builtIn .builtIn
    pos context tryEvaluateBuiltIn return
  else procData [] .implementation .code ?? ! _if
    "unexpected implementation type" sb.wrap
    pos errors appendError
    true return
  end
  nArgs "procedure call" string.wrap false pos context checkStack if
    128 sb.create
      "inType: " sb.appendS
      inType typeContext sb.appendType
      " arguments: " sb.appendS
      args .length sb.appendI
      " auto-args: " sb.appendS
      autoArgs .length sb.appendI
    pos errors appendInfo
    true return
  end
  context [] .stack .length nArgs - =:: argsOffset
  procData [] .labelId =:: procName
  procType typeContext types.getProcOut ..drop =:: outType
  outType typeContext types.compositeEltCount 1 == and
      outType 0 typeContext types.compositeGetElement types.primitive.TYPE types.typeEquals if
    ## findGeneratedType
      procName
      context [] .stack list.asArray argsOffset array.tail
      typeContext
      constContext
    types.findGeneratedType ! if =:: genType
      argsOffset context truncateStack
      ## pushValue
        genType ConstValue .TypeId
        types.primitive.TYPE
        id.LABEL_ID_NONE
        pos
      context pushValue
      false return
      ## TODO reuse value of type-generator
    end ..drop
    true
  else false end =:: isTypeGenerator
  procData [] .isStatic ! and context [] .typeChecker optional.hasData if
    procId implId pos context [] .typeChecker .data typeCheckChildProcedures
  end
  context [] .stack .length =:: stackOffset
  context [] .openBlocks .length =:: prevBlocks
  BlockType .PROCEDURE true context openBlock
  0:i64 =:: mut: autoArgOffset
  argsOffset =:: mut: argOffset
  ## process procedure arguments
  0:i64 while $ args .length < do =:: i
    argOffset stackOffset >= if
      "not enough arguments for procedure " sb.wrap
        procName labelContext sb.appendLabelName
      pos errors appendError
      stackOffset context truncateStack
      context [] .openBlocks
        prevBlocks list.setLength
      context [] .openBlocks =
      true return
    end
    inType i typeContext types.compositeGetLabel =:: label
    label labelContext id.labelFlags =:: labelFlags
    labelFlags id.FLAG_AUTO & ? if
      autoArgs autoArgOffset array.get =:: value
      context [] .variables @
        label
        ## Constant
          value
          ## ValueInfo
            args i types.compositeElts.get
            pos
          ValueInfo new
        Constant new
      map.put ..drop
      autoArgOffset 1 + autoArgOffset =
      continue
    end
    context [] .stack argOffset list.at .data =:: value
    context [] .stackInfo argOffset list.at .data =:: valueInfo
    argOffset 1 + argOffset =
    label id.LABEL_ID_NONE == or labelFlags id.FLAG_DUMMY & ? if ## push argument
      context [] .stack
        value list.appendP
      context [] .stack =
      context [] .stackInfo
        ## ValueInfo
          valueInfo [] .valueType
          pos
        ValueInfo new list.append
      context [] .stackInfo =
    else ## store argument as value
      context [] .variables @
        label
        ## Constant
          value []
          valueInfo []
        Constant new
      map.put ..drop
    end
  finally
    i 1 +
  end ..drop
  procData [] .implementation .code@ =:: codeImpl
  implId 0 >= if
    program [] .progFiles
      procData [] .fileId i64 cast
    list.at .data [] .localOps
      codeImpl [] .implementations
        implId list.at .data
      =:: currentImpl
      currentImpl .codeState .TYPE_CHECKED ?? ! if
        "no implementaion for procedure " sb.wrap
          procName labelContext sb.appendLabelName
        pos errors appendError
      end
      currentImpl [] .codeStart
      currentImpl [] .codeLength
    list.slice
  else
    codeImpl [] .codeState switch
      PARSING case
        "procedure " sb.wrap
          procName labelContext sb.appendLabelName
          " has not finished parsing" sb.appendS
        pos errors appendError
        Operation array.empty break
      TYPE_CHECKING case
        "procedure " sb.wrap
          procName labelContext sb.appendLabelName
          " has not finished type-checking" sb.appendS
        pos errors appendError
        Operation array.empty break
      PARSED case
        program [] .tmpOps
          codeImpl [] .codeStart
          codeImpl [] .codeLength
        list.slice
        break
      TYPE_CHECKED case
        program [] .progFiles
          procData [] .fileId i64 cast
        list.at .data [] .localOps
            codeImpl [] .codeStart
            codeImpl [] .codeLength
        list.slice
        break
    end
  end =:: code
  code .length 0 == if
    "no operations in procedure " sb.wrap
      procName labelContext sb.appendLabelName
    pos errors appendError
    stackOffset context truncateStack
    context [] .openBlocks
      prevBlocks list.setLength
    context [] .openBlocks =
    true return ## not a call
  end
  code 0 array.at .data =:: op
  op [] .val .implementProcedure ?? ! and
      op [] .val .initializeId ?? ! or
      op [] .val .initializeId .idType .PROCEDURE ?? ! if
    "expected procedure initialization got " sb.wrap
      op [] program sb.appendOp
    op [] .pos errors appendError
    stackOffset context truncateStack
    context [] .openBlocks
      prevBlocks list.setLength
    context [] .openBlocks =
    true return ## not a call
  end
  context [] .currentFile =:: oldFile
  procData [] .fileId context [] .currentFile =
  context [] .evalType =:: prevType
  prevType .FOLD_LOCAL ?? =:: isLocalFold
  ## change intrepreter type when evaluating call
  procName labelContext id.labelFlags id.FLAG_STATIC & ? if
    implId -1 == assert "static procedure has implId -1"
    ## XXX? seperate interpreter type code in static procedure?
    InterpreterType .GLOBAL
  else
    InterpreterType .INTERPRET
  end context [] .evalType =
  ## evaluateOperations
    code 1 array.tail ## first operation declares procedure
    context
  evaluateOperations if
    stackOffset context truncateStack
    context [] .openBlocks
      prevBlocks list.setLength
    context [] .openBlocks =
    prevType context [] .evalType =
    true return
  end
  ## FIXME static procedures don't cast their return value
  isTypeGenerator if
    context [] .stack .length 1 < if
      "could not initalized type generator " sb.wrap
        procName labelContext sb.appendLabelName
      pos errors appendError
      true return
    end
    context [] .stack
      list.pop =:: retValue
      retValue .TypeId ?? ! if ..drop
        "could not initalized type generator " sb.wrap
          procName labelContext sb.appendLabelName
          " expected type got " sb.appendS
          retValue typeContext sb.appendConstant
        pos errors appendError
        true return
      end
      retValue .TypeId =:: generatedType
    context [] .stack =
    ## initializeGeneratedType
      procName
      context [] .stack argsOffset nArgs list.slice
      generatedType
      typeContext
      constContext
    types.initializeGeneratedType if
      "could not initalized type generator " sb.wrap
        procName labelContext sb.appendLabelName
      pos errors appendError
    end =:: generatorType
    context [] .stack
      generatorType ConstValue .TypeId list.append
    context [] .stack =
  end
  prevType context [] .evalType =
  oldFile context [] .currentFile =
  context [] .stack .length stackOffset - =:: nReturn
  ## mem.copy
    context [] .stack .data argsOffset +
    context [] .stack .data stackOffset +
    nReturn
  mem.copy ..drop
  ## mem.copy
    context [] .stackInfo .data argsOffset +
    context [] .stackInfo .data stackOffset +
    nReturn
  mem.copy ..drop
  context [] .stack
    argsOffset nReturn + list.setLength
  context [] .stack =
  context [] .stackInfo
    argsOffset nReturn + list.setLength
  context [] .stackInfo =
  argsOffset while ..dup context [] .stackInfo .length < do
    ## update push position of return values
    pos context [] .stackInfo ..over.2 list.at .data [] .pushedAt =
    1 +
  end ..drop
  false return
end
