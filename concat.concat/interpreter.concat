      context [] .evalType switch
        INTERPRET case break
        PARSER FOLD_LOCAL GLOBAL case
          ## label/name resolving handled by type-checker
          true return
      end
      ## label/name should have been resolved in type-checker
      "unsupported operation in constant evaluation: " sb.wrap
        op [] program sb.appendOp
      op [] .pos errors appendError
      true return
    New case
      Type : poppedType
      ValueInfo : valInfo
      false =:: mut: poppedValue
      op [] .dataType .undefined ?? if
        op [] .pos context popType if ..drop.2
          true return
        end poppedType = valInfo =
        poppedType typeContext types.containsGeneric if
          ## creating tuple not possible, reset stack
          ## unpopValue
            poppedType ConstValue .typeId
            valInfo
          context unpopValue
          true return
        end
        true poppedValue =
        poppedType
      else
        op [] .dataType
      end =:: targetType
      targetType typeContext types.isArray if
        ## TODO support constant evaluation of new array
      else targetType typeContext types.isTuple _if
        ## separate if block to avoid printing general error message on failure
        targetType op [] .pos context newTuple ! if
          false return
        end
      else
        "unsupported operation in constant evaluation: " sb.wrap
          op [] program sb.appendOp
        op [] .pos errors appendError
      end
      poppedValue if
        ## unpopValue
          poppedType ConstValue .typeId
          valInfo
        context unpopValue
      end
      true return
    Cast Cast! case
      Type : poppedType
      ValueInfo : valInfo
      false =:: mut: isPoppedType
      op [] .dataType .undefined ?? if
        op [] .pos context popType if ..drop.2
          true return
        end poppedType = valInfo =
        true isPoppedType =
        poppedType typeContext types.containsGeneric if
          ## casting to genetic value not possible, reset stack
          ## unpopValue
            poppedType ConstValue .typeId
            valInfo
          context unpopValue
          true return
        end
        poppedType
      else
        op [] .dataType
      end =:: targetType
      op [] .pos context popValue if ..drop.2
        isPoppedType if
          ## unpopValue
            poppedType ConstValue .typeId
            valInfo
          context unpopValue
        end
        true return
      end =:: oldValue valInfo = ## can overwrite value info
      ## canCast
        valInfo .valueType
        targetType
        op [] .val .Cast! ??
      typeContext types.canCast ! if
        "cannot cast " sb.wrap
          valInfo .valueType typeContext sb.appendType
          " to " sb.appendS
          targetType typeContext sb.appendType
        op [] .pos errors appendError
        true return
      end
      op [] .val .Cast ?? if
        op [] .val .Cast .signType
      else
        SignType .NONE
      end =:: signType
      ## castConstant
        valInfo .valueType
        signType
        oldValue
        targetType
        typeContext
      castConstant =:: newValue
      ## pushValue
        newValue
        targetType
        id.LABEL_ID_NONE
        op [] .pos
        context
      pushValue
      false return
    Assert case
      op [] .pos context popValue if
        ..drop.2
        context [] .evalType switch
          INTERPRET GLOBAL case
            "missing argument for assert, expected boolean" sb.wrap
            op [] .pos errors appendError
            break
          PARSER FOLD_LOCAL case break
        end
        true return
      end =:: value =:: valInfo
      value .boolean ?? ! if
        "wrong constant value for assert, expected boolean got: " sb.wrap
          value constContext typeContext sb.appendConstant
        op [] .pos errors appendError
        value valInfo context unpopValue
        true return
      end
      value .boolean ! if
        "assertion failed: " sb.wrap
          op [] .val .Assert labelContext sb.appendStringConst
        op [] .pos errors appendError
      end
      false return
    Error case
      context [] .evalType switch
        FOLD_LOCAL case true return ## error is handled by type-checker
        INTERPRET GLOBAL PARSER case break
      end
      ## appendError
        op [] .val .Error .message .length sb.create
        op [] .val .Error .message labelContext sb.appendStringConst
        op [] .pos
        errors
      op [] .val .Error .errorType switch
        ERROR case appendError break
        WARNING case appendWarning break
        INFO case appendInfo break
      end
      false return
    length size case
      op [] .pos context popValue if ..drop.2
        true return
      end =:: value =:: valInfo
      ## sizeOfValue
        valInfo .valueType
        value
        op [] .val .length ??
        op [] .pos
        program
      interpreter.sizeOfValue if ..drop.2
        value valInfo context unpopValue
        true return
      end =:: constVal =:: constType
      ## pushValue
        constVal
        constType
        id.LABEL_ID_NONE
        op [] .pos
        context
      pushValue
      false return
    typeInfo case
      Type : poppedType
      ValueInfo : valInfo
      false =:: mut: poppedValue
      op [] .dataType .undefined ?? if
        op [] .pos context popType if ..drop.2
          true return
        end poppedType = valInfo =
        true poppedValue =
        poppedType typeContext types.containsGeneric if
          ## computing size not possible, reset stack
          ## unpopValue
            poppedType ConstValue .typeId
            valInfo
          context unpopValue
          true return
        end
        poppedType
      else
        op [] .dataType
      end =:: targetType
      ## pushValue
        ## computeTypeInfo
          targetType
          op [] .val .typeInfo
        program computeTypeInfo if ..drop
          ## computing size not possible, reset stack
          poppedValue if
            ## unpopValue
              poppedType ConstValue .typeId
              valInfo
            context unpopValue
          end
          true return
        end
        types.primitive.I_SIZE
        id.LABEL_ID_NONE
        op [] .pos
        context
      pushValue
      false return
    builtIn case
      op [] .dataType op [] .val .builtIn op [] .pos context tryEvaluateBuiltIn return
    equalityOperator case
      ConstValue 2 array new =:: mut: valueData
      valueData @ =:: values
      ValueInfo 2 array new =:: mut: valInfoData
      valInfoData @ =:: valInfos
      0:i64 =:: mut: nArgs
      0 while ..dup 2 < do 1 +
        op [] .pos context popValue if ..drop.3
          values valInfos nArgs context unpopValues
          true return
        end values nArgs [] = valInfos nArgs [] =
        nArgs 1 + nArgs =
      end ..drop
      ## mergeTypes
        valInfos 0 [] .valueType
        valInfos 1 [] .valueType
      typeContext types.mergeTypes if ..drop
        "incompatible types for equality check: " sb.wrap
          valInfos 0 [] .valueType typeContext sb.appendType
          " and " sb.appendS
          valInfos 1 [] .valueType typeContext sb.appendType
        op [] .pos errors appendError
        values valInfos nArgs context unpopValues
        true return
      end =:: resType
      ## pushValue
        values 1 [] values 0 [] resType typeContext interpreter.operatorEq if ..drop
          "unsupported values for equality check: " sb.wrap
            values 0 [] constContext typeContext sb.appendConstant
            " and " sb.appendS
            values 1 [] constContext typeContext sb.appendConstant
          op [] .pos errors appendError
          values valInfos nArgs context unpopValues
          true return
        end
          op [] .val .equalityOperator .NEQ ?? ^ ## invert result for NEQ
        ConstValue .boolean
        types.primitive.BOOL
        id.LABEL_ID_NONE
        op [] .pos
        context
      pushValue
      false return
    atId getElement atElement getEnumLabel
    getArrayElement atArrayElement setValue
    NewEnum call callPtr
    argc getArg implementProcedure procPtr
    autoCast bitCast NewEnumReference
    ConstantReference NewReference
    checkEnumLabel setEnumLabel
    hasElement stackMod copy
    compilerInfo unreachable case
      context [] .evalType switch
        INTERPRET GLOBAL case
          "unsupported operation in constant evaluation: " sb.wrap
            op [] program sb.appendOp
          op [] .pos errors appendError
          break
        PARSER FOLD_LOCAL case break
      end
      true return
  end
end

proc(
  Type : calledType
  BuiltIn : builtIn
  FilePosition : pos
  InterpreterContext ptr.mut : context
-> bool ) =>: tryEvaluateBuiltIn
  context [] .program [] .errors @ =:: errors
  context [] .program =:: program
  context [] .program [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  calledType typeContext types.getProcIn
    ! assert "has procedure in"
  =:: inType
  inType typeContext types.compositeElts =:: inTypes
  ConstValue 3 array new =:: mut: valueData
  valueData @ =:: values
  ValueInfo 3 array new =:: mut: valInfoData
  valInfoData @ =:: valInfos
  0:i64 =:: mut: nArgs
  context [] .evalType switch
    INTERPRET GLOBAL case true break
    PARSER FOLD_LOCAL case false break
  end =:: showErrors
  inTypes .length 1 - while ..dup 0 >= do =:: i
    nArgs 3 < assert "built-ins have at most three arguments"
    inTypes i types.compositeElts.get =:: eltType
    pos context popValue if ..drop.2
      values valInfos nArgs context unpopValues
      true return
    end values nArgs [] = valInfos nArgs [] =
    valInfos nArgs [] .valueType eltType typeContext types.canAutoCast ! if
      showErrors if
        "wrong argument type for built-in " sb.wrap
          builtIn sb.appendBuiltIn
          " expected: " sb.appendS
          eltType typeContext sb.appendType
          " got: " sb.appendS
          valInfos nArgs [] .valueType typeContext sb.appendType
        pos errors appendError
      end
      values valInfos nArgs 1 + context unpopValues
      true return
    end
    nArgs 1 + nArgs =
    i 1 -
  end ..drop
  ## bring arguments in correct order
  values nArgs array.reverse
  valInfos nArgs array.reverse
  ## XXX ensure type arguments for pointer built-ins are present
  builtIn values nArgs i32 cast interpreter.evaluateBuiltIn =:: resultType =:: value
  resultType switch
    success case
      value
        calledType typeContext types.getProcRet
          ! assert "has return type"
        id.LABEL_ID_NONE
        pos
        context
      pushValue
      false return
    argumentError case
      showErrors if
        "invalid arguments for built-in " sb.wrap
          builtIn sb.appendBuiltIn
          ": " sb.appendS
          0:i64 while ..dup nArgs < do =:: i
            values i [] constContext typeContext sb.appendConstant
            i 1 +
          end ..drop
        pos errors appendError
      end
      values valInfos nArgs context unpopValues
      true return
    unimplemented case
      showErrors if
        "unsupported built-in in constant evaluation: " sb.wrap
          builtIn sb.appendBuiltIn
        pos errors appendError
      end
      values valInfos nArgs context unpopValues
      true return
  end
end

proc(
  Operation arrayView : ops
  InterpreterContext ptr.mut : context
->
  bool
) =>: export: evaluateOperations
  0:i64 =:: mut: offset
  context [] .openBlocks .length 1 - while ..dup 0 >= do
    context [] .openBlocks ..over list.at .data [] .blockType
     ..dup .PROCEDURE ?? ..swap .EXPERIMENTAL_PROCEDURE ?? | if
      break
    end
    1 -
  end =:: procBlockIndex
  while offset ops .length < do
    ops offset array.at .data =:: op
      op context evaluateOperation if
        true return
      end
      context [] .openBlocks .length procBlockIndex < if
        false return ## break evaluation when leaving procedure block
      end
    offset 1 + offset =
  end
  ## XXX error if unwanted open blocks
  false return
end

proc(
  Type : tupleType
  FilePosition : pos
  InterpreterContext ptr.mut : context
-> bool ) =>: newTuple
  context [] .program [] .errors @ =:: errors
  context [] .program =:: program
  context [] .program [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  tupleType typeContext types.compositeElts =:: elts
  elts .length "tuple-creation" string.wrap true pos context checkStack if
    true return
  end
  context [] .stack .length elts .length - =:: offset
  0:i64 while ..dup elts .length < do =:: i
    context [] .stackInfo offset i + list.at .data =:: stackInfo
    stackInfo [] .valueType elts i types.compositeElts.get typeContext types.canAutoCast ! if
      "wrong argument for tuple creation expected: " sb.wrap
        elts i types.compositeElts.get typeContext sb.appendType
        " got: " sb.appendS
        stackInfo [] .valueType typeContext sb.appendType
      pos errors appendError
      true return
    end
    i 1 +
  end ..drop
  context [] .stack list.asArray
    offset array.tail
  constContext newArrayConst =:: tupleConst
  ## remove arguments and push tuple
  offset context truncateStack
  context [] .stack
    tupleConst list.append
  context [] .stack =
  context [] .stackInfo
    ## ValueInfo
      tupleType
      id.LABEL_ID_NONE
      pos
    ValueInfo new list.append
  context [] .stackInfo =
  false return
end

#+evaluate procedure body with the given arguments+#
proc(
  ProcId : procId
  FilePosition : pos
  InterpreterContext ptr.mut : context
->
  bool
) =>: export: evaluateCall
  context [] .program [] .errors @ =:: errors
  context [] .program =:: program
  context [] .program [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  program [] .procedures procId i64 cast list.at .data =:: procData
  procData [] .procType =:: procType
  procType typeContext types.getProcIn ..drop =:: inType
  inType typeContext types.compositeElts =:: args
  args .length "procedure" string.wrap true pos context checkStack if
    true return
  end
  context [] .stack .length args .length - =:: argsOffset
  procData [] .implementation .builtIn ?? if
    "interpreting built-in procs is not implemented" sb.wrap
    pos errors appendError
    true return
  end
  ## XXX resolve signature
  ## TODO check argument types
  context [] .evalType switch
    PARSER GLOBAL FOLD_LOCAL case
      program [] .tmpOps break
    INTERPRET case
      program [] .progFiles
        procData [] .fileId i64 cast
      list.at .data [] .localOps break
  end
    procData [] .implementation .code .codeStart
    procData [] .implementation .code .codeLength
  list.slice =:: code
  code 0 array.at .data =:: op
  op [] .val .initializeId ?? ! if true else
    op [] .val .initializeId .idType .PROCEDURE ?? !
  end if
    "expected procedure initialization got " sb.wrap
      op [] program sb.appendOp
    op [] .pos errors appendError
    true return ## not a call
  end
  context [] .stack .length =:: stackOffset
  ## process procedure arguments
  0:i64 while ..dup args .length < do
    context [] .stack ..over argsOffset + list.at .data =:: value
    context [] .stackInfo ..over argsOffset + list.at .data =:: valueInfo
    inType ..over typeContext types.compositeGetLabel =:: label
    label id.LABEL_ID_NONE == or
        label labelContext id.labelFlags id.FLAG_DUMMY & ? if ## push argument
      context [] .stack
        value list.appendP
      context [] .stack =
      context [] .stackInfo
        ## ValueInfo
          valueInfo [] .valueType
          id.LABEL_ID_NONE
          pos
        ValueInfo new list.append
      context [] .stackInfo =
    else ## store argument as value
      context [] .variables @
        label
        ## Constant
          value []
          valueInfo []
        Constant new
      map.put ..drop
    end
    1 +
  end ..drop
  context [] .currentFile =:: oldFile
  procData [] .fileId context [] .currentFile =
  BlockType .PROCEDURE context openBlock
  ## evaluateOperations
    code 1 array.tail ## first operation declares procedure
    context
  evaluateOperations if
    stackOffset context truncateStack
    true return
  else
    oldFile context [] .currentFile =
    context [] .stack .length stackOffset - =:: nReturn
    ## mem.copy
      context [] .stack .data argsOffset +
      context [] .stack .data stackOffset +
      nReturn
    mem.copy ..drop
    ## mem.copy
      context [] .stackInfo .data argsOffset +
      context [] .stackInfo .data stackOffset +
      nReturn
    mem.copy ..drop
    context [] .stack
      argsOffset nReturn + list.setLength
    context [] .stack =
    context [] .stackInfo
      argsOffset nReturn + list.setLength
    context [] .stackInfo =
    argsOffset while ..dup context [] .stackInfo .length < do
      ## update push position of return values
      pos context [] .stackInfo ..over.2 list.at .data [] .pushedAt =
      1 +
    end ..drop
    false return
  end
end
