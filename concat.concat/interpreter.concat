import map
import arenaAlloc
import string
using std.literals.

import "interpreter/operators.concat"
import "identifiers.concat"
import "program.concat"
type : export: InterpreterContext ## needed by call-resolver
import "callResolver.concat"

## declarations needed from typeChecker
type : export: TypeCheckState
proc(
  ProcId : procId
  i32 : implId
  FilePosition : expandedAt
  TypeCheckState ptr.mut : state
-> ) : export: typeCheckChildProcedures

namespace: interpreter
  struct(
    Type : valueType
    FilePosition : pushedAt
  ) =:: export: ValueInfo

  struct(
    ConstValue : value
    ValueInfo  : info
  ) =:: Constant

  struct(
    BlockType : blockType
    i32 : stackOffset
    i32 : typeOffset
    i32 : valueOffset
    i32 : labelOffset
  ) =:: BlockInfo

  enum( GLOBAL INTERPRET ) =:: export: InterpreterType
  struct(
    i32 : blockCount
    i32 : stackSize
    InterpreterType : evalType
  ) =:: InterpreterState
end
struct(
  using interpreter.
  ProgramContext ptr.mut : program
  TypeCheckState ptr.mut optional : typeChecker
  LabelId Constant hashMap : globalVariables
  LabelId Constant hashMap ptr.mut optional : localVariables
  ConstValue list : stack
  ValueInfo  list : stackInfo
  BlockInfo  list : openBlocks
  MixedArenaAllocator : localMemory
  ## XXX globalMemory (?heapMemory)
  Type list : typeBuffer
  ConstValue list : valueBuffer
  LabelId list : labelBuffer
  FilePosition list : callPositions
  InterpreterState list : stateStack
  FileId : currentFile
  InterpreterType : evalType
) =:: export: InterpreterContext
## TODO! enforce block-boundries for nested compilation
##   -> stack containing offset of root-block into block list

namespace: interpreter
  proc(
    ProgramContext ptr.mut : progContext
    TypeCheckState ptr.mut optional : typeChecker
    FileId : fileId
    InterpreterType : evalType
  ->
    InterpreterContext
  ) =>: export: wrapProgram
    ## InterpreterContext
      progContext
      typeChecker
      labelHash@ labelEq@ 512 Constant map.create
      LabelId Constant hashMap ptr.mut optional.empty
      64 ConstValue list.create
      64 ValueInfo  list.create
      64 BlockInfo  list.create
      ## no reordering of allocated blocks to prevent allocation below start of current stack frame
      4096 true mixedArena.create
      64 Type       list.create
      64 ConstValue list.create
      64 LabelId    list.create
      64 FilePosition list.create
      32 InterpreterState list.create
      fileId
      evalType
    InterpreterContext new
  end
  proc(
    InterpreterContext ptr.mut : context
  -> ) =>: export: cleanupContext
    context .globalVariables map.free
    context [] .stackInfo   list.free context .stackInfo=
    context [] .openBlocks  list.free context .openBlocks=
    context [] .typeBuffer  list.free context .typeBuffer=
    context [] .valueBuffer list.free context .valueBuffer=
    context [] .labelBuffer list.free context .labelBuffer=
    context [] .callPositions list.free context .callPositions=
    context [] .localMemory mixedArena.free context .localMemory=
    context [] .stack list.free context .stack=
    context [] .stateStack list.free context .stateStack=
  end
  proc(
    InterpreterContext ptr.mut : context
  -> ) =>: export: offsetContext
    context [] .stateStack
      ## InterpreterState
        context [] .openBlocks .length
        context [] .stack .length
        context [] .evalType
      InterpreterState new list.append
    context .stateStack=
  end
  proc(
    InterpreterContext ptr.mut : context
  -> ) =>: export: resetContext
    context [] .stateStack .length 0 == if
      ## TODO error
      return
    end
    context [] .stateStack
      list.pop =:: prevState
    context .stateStack=
    context [] .openBlocks
      prevState .blockCount list.setLength
    context .openBlocks=
    prevState .stackSize context truncateStack
    prevState .evalType context .evalType=
  end
  ## reset blocks while preserving stack (used when returning from calls)
  proc(
    InterpreterContext ptr.mut : context
  -> ) =>: resetContextKeepStack
    context [] .stateStack .length 0 == if
      ## TODO error
      return
    end
    context [] .stateStack
      list.pop =:: prevState
    context .stateStack=
    context [] .openBlocks
      prevState .blockCount list.setLength
    context .openBlocks=
    prevState .evalType context .evalType=
  end

  proc(
    i32 : count
    string : name
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> bool ) =>: checkStack
    context minStackOffset =:: offset
    offset 0 >= "offset is non-negative" assert
    context [] .stack .length offset - count < if
      "not enough arguments for " sb.copyPtr
        name sb.appendStr
        " expected: " sb.appendS
        count sb.appendI
        " got: " sb.appendS
        context [] .stack .length offset - sb.appendI
      pos context [] .program .errors appendError
      true return
    end
    false return
  end
  proc( InterpreterContext ptr.mut : context -> i32 ) =>: minStackOffset
    context [] .stateStack .length 0 > if
      context [] .stateStack list.peek .data =:: rootState
      rootState [] .stackSize rootState [] .blockCount
    else 0 0 end =:: baseBlock =:: baseOffset
    context [] .openBlocks .length baseBlock > if
      context [] .openBlocks list.peek .data [] .stackOffset return
    end
    baseOffset return
  end
  proc( InterpreterContext ptr.mut : context -> i32 ) =>: minBlockOffset
    context [] .stateStack .length 0 > if
      context [] .stateStack list.peek .data [] .blockCount return
    end
    0 return
  end

  proc( InterpreterContext ptr.mut : context -> bool ) =>: inEnum
    ## XXX cache number of open enum blocks
    context minBlockOffset =:: minBlock
    context [] .openBlocks .length 1 - while $ minBlock >= do =:: i
      context [] .openBlocks i list.at .data [] .blockType switch
        TYPE_ENUM case
          true return
        PROCEDURE EXPERIMENTAL_PROCEDURE INITIALIZER TYPE_TUPLE TYPE_STRUCT
            TYPE_PROC_IN TYPE_CPROC_IN TYPE_PROC_OUT TYPE_COMPOSITE TYPE_UNION
            TYPE_UNTAGGED_UNION case
          false return
        UNKNOWN IF ELSE WHILE DO BREAK CONTINUE
          SWITCH BREAK_SWITCH CASE DEFAULT FINALLY
          AND OR AND_IF OR_IF AND_DO OR_DO
          IF_TRUE IF_FALSE AND_TRUE AND_FALSE
          OR_TRUE OR_FALSE ELSE_TRUE ELSE_FALSE
          NAMESPACE case break
      end
    finally i 1 - end ..drop
    false return
  end
  proc( InterpreterContext ptr.mut : context -> bool ) =>: inUnion
    ## XXX cache/precompute result
    context minBlockOffset =:: minBlock
    context [] .openBlocks .length 1 - while $ minBlock >= do =:: i
      context [] .openBlocks i list.at .data [] .blockType switch
        TYPE_UNION TYPE_UNTAGGED_UNION case
           true return
        PROCEDURE EXPERIMENTAL_PROCEDURE INITIALIZER TYPE_TUPLE TYPE_STRUCT
            TYPE_PROC_IN TYPE_CPROC_IN TYPE_PROC_OUT TYPE_COMPOSITE TYPE_ENUM case
          false return
        UNKNOWN IF ELSE WHILE DO BREAK CONTINUE
            SWITCH BREAK_SWITCH CASE DEFAULT FINALLY
            AND OR AND_IF OR_IF AND_DO OR_DO
            IF_TRUE IF_FALSE AND_TRUE AND_FALSE
            OR_TRUE OR_FALSE ELSE_TRUE ELSE_FALSE
            NAMESPACE case break
      end
    finally i 1 - end ..drop
    false return
  end
  proc( InterpreterContext ptr.mut : context -> bool ) =>: export: inTypeOrInitializer
    ## XXX cache/precompute result
    context minBlockOffset =:: minBlock
    context [] .openBlocks .length 1 - while $ minBlock >= do =:: i
      context [] .openBlocks i list.at .data [] .blockType switch
        INITIALIZER TYPE_TUPLE TYPE_STRUCT TYPE_ENUM TYPE_UNION TYPE_UNTAGGED_UNION
            TYPE_PROC_IN TYPE_CPROC_IN TYPE_PROC_OUT TYPE_COMPOSITE case
          true return
        PROCEDURE EXPERIMENTAL_PROCEDURE case
          false return
        UNKNOWN IF ELSE WHILE DO BREAK CONTINUE
            SWITCH BREAK_SWITCH CASE DEFAULT FINALLY
            AND OR AND_IF OR_IF AND_DO OR_DO
            IF_TRUE IF_FALSE AND_TRUE AND_FALSE
            OR_TRUE OR_FALSE ELSE_TRUE ELSE_FALSE
            NAMESPACE case break
      end
    finally i 1 - end ..drop
    false return
  end
  proc( InterpreterContext ptr.mut : context -> bool ) =>: export: skipCurrentBlock
    ## XXX cache/precompute result
    context minBlockOffset =:: minBlock
    context [] .openBlocks .length 1 - while $ minBlock >= do =:: i
      context [] .openBlocks i list.at .data [] .blockType switch
        IF_FALSE AND_FALSE OR_TRUE ELSE_TRUE case
           true return
        IF_TRUE AND_TRUE OR_FALSE ELSE_FALSE
          PROCEDURE EXPERIMENTAL_PROCEDURE INITIALIZER TYPE_TUPLE TYPE_STRUCT
          TYPE_PROC_IN TYPE_CPROC_IN TYPE_PROC_OUT TYPE_COMPOSITE TYPE_UNION
          TYPE_UNTAGGED_UNION UNKNOWN IF ELSE WHILE DO BREAK CONTINUE TYPE_ENUM
          SWITCH BREAK_SWITCH CASE DEFAULT FINALLY
          AND OR AND_IF OR_IF AND_DO OR_DO
          NAMESPACE case break
      end
    finally i 1 - end ..drop
    false return
  end

  proc(
    BlockType : blockType
    bool : offsetStack
    InterpreterContext ptr.mut : context
  -> ) =>: openBlock
    offsetStack if
      context [] .stack .length
    else
      context minStackOffset
    end =:: stackOffset
    context [] .openBlocks
      ## BlockInfo
        blockType
        stackOffset
        context [] .typeBuffer .length
        context [] .valueBuffer .length
        context [] .labelBuffer .length
      BlockInfo new list.append
    context .openBlocks=
  end
  proc(
    InterpreterContext ptr.mut : context
  -> BlockInfo ptr.mut optional ) =>: peekBlock
    context [] .openBlocks .length context minBlockOffset <= if
      BlockInfo ptr.mut optional.empty return
    end
    context [] .openBlocks list.peek return
  end
  proc(
    InterpreterContext ptr.mut : context
  -> BlockInfo optional ) =>: popBlock
    context [] .openBlocks .length context minBlockOffset <= if
      BlockInfo optional.empty return
    end
    context [] .openBlocks
      list.pop =:: result
    context .openBlocks=
    result optional.wrap return
  end
  BlockType ..length 39 == "number of block types" assert
  proc( InterpreterContext ptr.mut : context -> bool ) =>: inAndOrBlock
    context peekBlock =:: current
    current optional.isEmpty if false return end
    current .data [] .blockType switch
      AND OR AND_TRUE AND_FALSE OR_TRUE OR_FALSE case
        true return
      default
        false return
    end
  end
  proc( InterpreterContext ptr.mut : context -> ) =>: closeAndOrBlock
    context peekBlock =:: current
    current optional.isEmpty if return end
    current .data [] .blockType switch
      AND OR AND_TRUE AND_FALSE OR_TRUE OR_FALSE case
          context popBlock ..drop
        break
      default break
    end
  end
  ## current conditional value in the and-or block (or false if not inside and/or block)
  proc( InterpreterContext ptr.mut : context -> bool ) =>: andOrCondition
    context peekBlock =:: currentBlock?
    currentBlock? optional.hasData and currentBlock? .data [] .blockType .OR_TRUE ?? end
  end

  enum( TYPE_STRUCT TYPE_UNION TYPE_ENUM TYPE_PROC INITIALIZER ) =:: LabeledValueContext
  proc( InterpreterContext ptr.mut : context -> i32 LabeledValueContext ) =>: getLabeledValueContext
    ## XXX cache/precompute result
    context minBlockOffset =:: minBlock
    context [] .openBlocks .length 1 - while $ minBlock >= do =:: i
      context [] .openBlocks i list.at .data =:: block
      block [] .blockType switch
        INITIALIZER case
           block [] .labelOffset LabeledValueContext .INITIALIZER return
        TYPE_TUPLE TYPE_STRUCT TYPE_COMPOSITE case
           block [] .labelOffset LabeledValueContext .TYPE_STRUCT return
        TYPE_UNION TYPE_UNTAGGED_UNION case
           block [] .labelOffset LabeledValueContext .TYPE_UNION return
        TYPE_ENUM case
           block [] .labelOffset LabeledValueContext .TYPE_ENUM return
        TYPE_PROC_IN TYPE_CPROC_IN TYPE_PROC_OUT case
           block [] .labelOffset LabeledValueContext .TYPE_PROC return
        PROCEDURE EXPERIMENTAL_PROCEDURE
        UNKNOWN IF ELSE WHILE DO BREAK CONTINUE
          SWITCH BREAK_SWITCH CASE DEFAULT FINALLY
          AND OR AND_IF OR_IF AND_DO OR_DO
          IF_TRUE IF_FALSE AND_TRUE AND_FALSE
          OR_TRUE OR_FALSE ELSE_TRUE ELSE_FALSE
          NAMESPACE case break
      end
    finally i 1 - end ..drop
    ## TODO? better default value/error condition
    ..unreachable
  end
  proc(
    LabelId : label
    i32 : initialLabelOffset
    LabeledValueContext : valueContext
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> ) =>: checkDuplicateLabel
    label id.LABEL_ID_NONE == if return end
    context [] .program .errors =:: errors
    context [] .program .idContext =:: idContext
    idContext .typeContext =:: typeContext
    typeContext .labelContext =:: labelContext
    context .labelBuffer =:: labels
    initialLabelOffset while $ labels [] .length < do =:: i
      labels [] i list.get =:: prevLabel
      prevLabel label labelContext id.labelNamesEq if
        "duplicate label \"" sb.copyPtr
        label labelContext sb.appendLabelName
        "\" in " sb.appendS
        valueContext switch
          TYPE_STRUCT case "struct" sb.appendS break
          TYPE_UNION case "union" sb.appendS break
          TYPE_ENUM case "enum" sb.appendS break
          TYPE_PROC case "procedure" sb.appendS break
          INITIALIZER case "initializer" sb.appendS break
        end
        prevLabel labelContext id.labelPos =:: prevPos
        prevPos optional.hasData if
          " ( previous declaration at " sb.appendS
          prevPos .data sb.appendPos
          " )" sb.appendS
        end
        pos errors appendError
      end
    finally i 1 + end ..drop
  end
  proc(
    LabelId : label
    ConstValue : value
    Type : valueType
    i32 : initialLabelOffset
    LabeledValueContext : valueContext
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> bool ) =>: addLabeledValue
    label initialLabelOffset valueContext pos context checkDuplicateLabel
    context [] .program .errors =:: errors
    context [] .program .idContext =:: idContext
    idContext .constContext =:: constContext
    idContext .typeContext =:: typeContext
    typeContext .labelContext =:: labelContext
    context [] .labelBuffer
      label list.append
    context .labelBuffer=
    valueContext switch
      INITIALIZER case
        context [] .typeBuffer
          valueType list.append
        context .typeBuffer=
        context [] .valueBuffer
          value list.append
        context .valueBuffer=
        false return
      TYPE_STRUCT TYPE_UNION TYPE_PROC case break
      TYPE_ENUM case ..unreachable
    end
    value .TypeId ?? ! or valueType types.primitive.TYPE types.typeEquals ! and
        valueType typeContext types.isTypeSet ! if
      "unexpected argument for type-field declaration expected type got " sb.copyPtr
        valueType typeContext sb.appendType
        " [ " sb.appendS
        value typeContext sb.appendConstant
        " ]" sb.appendS
      pos errors appendError
      true return
    end
    value .TypeId =:: typeValue
    context [] .typeBuffer
      typeValue list.append
    context .typeBuffer=
    label id.LABEL_ID_NONE != if
      typeValue
        typeContext types.unwrapNamed
      types.primitive.TYPE types.typeEquals =:: isType
      typeValue typeContext types.isTypeSet =:: isTypeSet
      ## map.put
      context [] .localVariables optional.hasData if
        context [] .localVariables .data
      else
        context .globalVariables
      end
        label
        ## Constant
          isType or isTypeSet if
            label types.newGenericType ConstValue .TypeId
          else
            label ConstValue .GenericArg
          end
          ## ValueInfo
            typeValue
            pos
          ValueInfo new
        Constant new
      map.put ..drop
    end
    false return
  end

  proc(
    i32 : stackOffset
    i32 : initialLabelOffset
    LabeledValueContext : valueContext
    FilePosition : pos
    InterpreterContext  ptr.mut : context
  -> bool ) =>: finishLabledValues
    context [] .program .errors =:: errors
    context [] .program .idContext =:: idContext
    idContext .typeContext =:: typeContext
    typeContext .labelContext =:: labelContext
    context [] .stack .length stackOffset > if
      stackOffset while $ context [] .stack .length < do =:: i
        context [] .stack i list.at .data =:: eltVal
        context [] .stackInfo i list.at .data =:: eltInfo
        valueContext switch
          TYPE_ENUM case
            "unexpected value in enum-block" sb.copyPtr
              eltInfo [] .pushedAt
            errors appendError
            id.LABEL_ID_NONE
            break
          TYPE_UNION case
            "unexpected value in union-block" sb.copyPtr
              eltInfo [] .pushedAt
            errors appendError
            id.LABEL_ID_NONE
            break
          TYPE_PROC INITIALIZER case
            id.LABEL_ID_NONE break
          TYPE_STRUCT case
            ## newDummyLabel
              context [] .labelBuffer .length initialLabelOffset -
              pos
              -1:FileId ## TODO determine file-id
              labelContext
            id.newDummyLabel
            break
        end =:: eltLabel
        ## addLabeledValue
          eltLabel
          eltVal []
          eltInfo [] .valueType
          initialLabelOffset
          valueContext
          eltInfo [] .pushedAt
        context addLabeledValue if
          true return
        end
      finally i 1 + end ..drop
      ## truncate stack
      stackOffset context truncateStack
    end
    false return
  end
  proc(
    Operation ptr : op
    BlockInfo ptr : closedBlock
    LabeledValueContext : closedType
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> bool ) =>: closedTypeBlock
    ## XXX? use different contexts for different types of type-containers
    ## finishLabledValues
      closedBlock [] .stackOffset
      closedBlock [] .labelOffset
      closedType
    pos context finishLabledValues if
      true return
    end
    context [] .program .errors =:: errors
    context [] .program .idContext =:: idContext
    idContext .constContext =:: constContext
    idContext .typeContext =:: typeContext
    typeContext .labelContext =:: labelContext
    closedBlock [] .labelOffset =:: labelOffset
    closedBlock [] .typeOffset =:: typeOffset
    context [] .labelBuffer .length labelOffset - =:: elementCount
    context [] .typeBuffer .length typeOffset - elementCount == "type count == label count" assert
    0:i32 while $ elementCount < do =:: i
      context [] .typeBuffer typeOffset i + list.at .data []
        typeContext types.unwrapNamed
      =:: eltType
      context [] .labelBuffer labelOffset i + list.at .data [] =:: eltLabel
      ## types are always static
      eltType types.primitive.TYPE types.typeEquals or eltType typeContext types.isTypeSet if
        eltLabel id.FLAG_STATIC labelContext id.addLabelFlags
      end
    finally i 1 + end ..drop
    false return
  end

  proc( Operation ptr : op BlockInfo ptr : closedBlock InterpreterContext ptr.mut : context -> bool ) =>: closeStructBlock
    context [] .program .errors =:: errors
    context [] .program .idContext =:: idContext
    idContext .typeContext =:: typeContext
    op closedBlock
      LabeledValueContext .TYPE_STRUCT
      op [] .pos
    context closedTypeBlock if true return end
    closedBlock [] .labelOffset =:: labelOffset
    closedBlock [] .valueOffset =:: valueOffset
    closedBlock [] .typeOffset =:: typeOffset
    closedBlock [] .blockType .TYPE_COMPOSITE ?? and context [] .typeBuffer .length typeOffset == if
      Type .empty
    else
      ## newTuple
        context [] .typeBuffer list.asSlice typeOffset slice.tail
        context [] .labelBuffer list.asSlice labelOffset slice.tail optional.wrap
      typeContext types.newTuple if ..drop
        "could not create structure-type" sb.copyPtr op [] .pos errors appendError
        true return
      end
    end =:: tupleType
    context [] .typeBuffer typeOffset list.setLength context .typeBuffer=
    context [] .valueBuffer valueOffset list.setLength context .valueBuffer=
    context [] .labelBuffer labelOffset list.setLength context .labelBuffer=
    ## pushValue
      tupleType ConstValue .TypeId
      types.primitive.TYPE
      op [] .pos
    context pushValue
    false return
  end
  proc(
    Operation ptr : op
    BlockInfo ptr : closedBlock
    InterpreterContext ptr.mut : context
  -> bool ) =>: closeProcTypeBlock
    context [] .program .errors =:: errors
    context [] .program .idContext =:: idContext
    idContext .typeContext =:: typeContext
    closedBlock [] .labelOffset =:: labelOffset
    closedBlock [] .valueOffset =:: valueOffset
    closedBlock [] .typeOffset =:: typeOffset
    context [] .typeBuffer .length typeOffset - 1 < or
        ## last argument is procedure output
        context [] .typeBuffer
          $ .length 1 -
        list.get .procOut ?? ! if
      "missing return type for procedure" sb.copyPtr op [] .pos errors appendError
      true return
    end
    context [] .typeBuffer
      list.pop =:: procOut ## last value is return type
    context .typeBuffer=
    closedBlock .blockType .TYPE_CPROC_IN ?? if
      CallingConvention .CCALL
      procOut typeContext types.compositeEltCount 1 > if
        "C-procedures cannot have multiple return values" sb.copyPtr
        op [] .pos errors appendError
      end
    else
      CallingConvention.DEFAULT
    end =:: callConvention
    op closedBlock
      LabeledValueContext .TYPE_PROC
      op [] .pos
    context closedTypeBlock if true return end
    ## newProcArgs
      context [] .typeBuffer list.asSlice typeOffset slice.tail
      context [] .labelBuffer list.asSlice labelOffset slice.tail optional.wrap
      false
    typeContext types.newProcArgs =:: procIn
    procIn procOut callConvention typeContext types.newProcedure if ..drop
      "could not create procedure-type" sb.copyPtr op [] .pos errors appendError
      true return
    end =:: newType
    context [] .typeBuffer typeOffset list.setLength context .typeBuffer=
    context [] .valueBuffer valueOffset list.setLength context .valueBuffer=
    context [] .labelBuffer labelOffset list.setLength context .labelBuffer=
    ## pushValue
      newType ConstValue .TypeId
      types.primitive.TYPE
      op [] .pos
    context pushValue
    false return
  end

  proc(
    Operation ptr : op
    BlockInfo ptr : closedBlock
    FilePosition : pos
    InterpreterContext ptr.mut : context
  ->
    Type
    bool
  ) =>: closedInitializer
    ## finishLabledValues
      closedBlock [] .stackOffset
      closedBlock [] .labelOffset
      LabeledValueContext .INITIALIZER
    pos context finishLabledValues if
      Type .undefined true return
    end
    context [] .program .errors =:: errors
    context [] .program .idContext =:: idContext
    idContext .constContext =:: constContext
    idContext .typeContext =:: typeContext
    typeContext .labelContext =:: labelContext
    closedBlock [] .typeOffset =:: typeOffset
    closedBlock [] .valueOffset =:: valueOffset
    closedBlock [] .labelOffset =:: labelOffset
    context [] .labelBuffer .length labelOffset - =:: elementCount
    context [] .typeBuffer .length typeOffset - elementCount == "type count == label count" assert
    context [] .valueBuffer .length valueOffset - elementCount == "value count == label count" assert
    ## newInitializerType
      context [] .typeBuffer list.asSlice typeOffset slice.tail
      context [] .labelBuffer list.asSlice labelOffset slice.tail optional.wrap
      typeContext
    types.newInitializerType =:: initializerType
    ## return
      initializerType
      false
    return
  end

  proc(
    ConstValue : value
    Type : valType
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> ) =>: pushValue
    context [] .stack
      value list.append
    context .stack=
    context [] .stackInfo
      ## ValueInfo
        valType
        pos
      ValueInfo new list.append
    context .stackInfo=
  end
  proc(
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> ValueInfo ConstValue bool ) =>: popValue
    context [] .stack .length 0 == if
      "stack underflow " sb.copyPtr
      pos context [] .program .errors appendError
      ## return
        ## ValueInfo
          Type .undefined
          pos
        ValueInfo new
        ConstValue .None
      true return
    end
    context [] .stack
      list.pop =:: value
    context .stack=
    context [] .stackInfo
      list.pop =:: valInfo
    context .stackInfo=
    valInfo value false return
  end
  proc(
    ConstValue : value
    ValueInfo : valInfo
    InterpreterContext ptr.mut : context
  ->  ) =>: unpopValue
    context [] .stack
       value list.append
    context .stack=
    context [] .stackInfo
      valInfo list.append
    context .stackInfo=
  end
  proc(
    ConstValue _ ptr : values
    ValueInfo _ ptr : valInfos
    i64 : count
    InterpreterContext ptr.mut : context
  ->  ) =>: unpopValues
    count 1 - while ..dup 0 >= do =:: i
      ## unpopValue
        values i []
        valInfos i []
        context
      unpopValue
      i 1 -
    end ..drop
  end
  proc(
    i32 : newLength
    InterpreterContext ptr.mut : context
  -> ) =>: truncateStack
    context [] .stack .length context [] .stackInfo .length == "len(stack)=len(stackInfo)" assert
    context [] .stack .length newLength >= "newLength<length" assert
    context [] .stack
      newLength list.setLength
    context .stack=
    context [] .stackInfo
      newLength list.setLength
    context .stackInfo=
  end

  proc(
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> ValueInfo Type bool ) =>: popType
    context [] .program .errors =:: errors
    context [] .program =:: program
    context [] .program .idContext =:: idContext
    idContext .constContext =:: constContext
    idContext .typeContext =:: typeContext
    typeContext .labelContext =:: labelContext
    pos context popValue =:: isError =:: value =:: valInfo
    isError if
      valInfo Type .undefined true return
    end
    value .TypeId ?? if
      valInfo value .TypeId false return
    end
    "expected type got: " sb.copyPtr
      valInfo .valueType typeContext sb.appendType
      " ( " sb.appendS
      value typeContext sb.appendConstant
      " )" sb.appendS
    pos errors appendError
    ## restore stack
    value valInfo context unpopValue
    valInfo Type .undefined true return
  end
  proc(
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> bool bool ) =>: popCondition
    context [] .program .errors =:: errors
    context [] .program =:: program
    context [] .program .idContext =:: idContext
    idContext .constContext =:: constContext
    idContext .typeContext =:: typeContext
    pos context popValue =:: isError =:: value =:: valInfo
    isError if
      ## popValue already created error message
      "missing value for condition" sb.copyPtr
      pos errors appendInfo
      false true return
    end
    value .Bool ?? if
      value .Bool false return
    end
    "expected boolean got: " sb.copyPtr
      valInfo .valueType typeContext sb.appendType
      " ( " sb.appendS
      value typeContext sb.appendConstant
      " )" sb.appendS
    pos errors appendError
    ## restore stack
    value valInfo context unpopValue
    false true return
  end
  proc(
    bool : persistentCopy
    ConstValue : value
    bool : allowArray
    ConstantContext ptr.mut : constContext
  -> string bool ) =>: constValueAsString
    value .Array8 ?? if
      value .Array8 string.fromBytes false return
    else value .LocalArray8 ?? _if
      value .LocalArray8 i8 slice.mut cast slice.freeze
        persistentCopy if
          constContext newArray8Const .Array8
        end
      string.fromBytes
      false return
    else allowArray ! _if
      string.empty true return
    end
    value .Array ?? and value .Array .length 2 == if
      value .Array
    else value .LocalArray ?? and value .LocalArray .length 2 == _if
      value .LocalArray ConstValue slice.mut cast slice.freeze
    else
      string.empty true return
    end =:: str
    str 1 slice.get .Int ?? ! if string.empty true return end
    str 1 slice.get .Int =:: length
    persistentCopy str 0 slice.get false constContext constValueAsString =:: isErr
      $ .length length < if true return end
      length string.head
    isErr return
  end
  proc(
    bool : persistentCopy
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> ValueInfo string bool ) =>: popString
    context [] .program =:: program
    program .errors =:: errors
    program .idContext =:: idContext
    idContext .constContext =:: constContext
    idContext .typeContext =:: typeContext
    typeContext .labelContext =:: labelContext
    pos context popValue =:: isError =:: value =:: valInfo
    isError if
      valInfo string.empty true return
    end
    valInfo persistentCopy value true constContext constValueAsString if
      "expected string got: " sb.copyPtr
        valInfo .valueType typeContext sb.appendType
        " ( " sb.appendS
        value typeContext sb.appendConstant
        " )" sb.appendS
      pos errors appendError
      ## restore stack
      value valInfo context unpopValue
       true return
    end
    false return
  end

## TODO use wrapper procedures for stack access

  proc(
    Type : t
    TypeMemoryInfo : infoType
    ProgramContext ptr.mut : program
  -> ConstValue bool ) =>: export: computeTypeInfo
    program .errors =:: errors
    program .idContext =:: idContext
    idContext .constContext =:: constContext
    idContext .typeContext =:: typeContext
    typeContext .labelContext =:: labelContext
    t typeContext types.containsGeneric if
      ConstValue .None true return
    end
    infoType switch
      ALIGNMENT case
        t typeContext types.alignOf
        break
      SIZE case
        t typeContext types.sizeOf
        break
      STRIDE case
        t typeContext types.strideOf
        break
    end =:: sizeValue
    sizeValue switch
      fixed case
        sizeValue .fixed ConstValue .Int false return
      dynamicArray case
        ConstValue .None true return ## XXX? support generic array size
      unknown case ## XXX? error message for unknown size
        ConstValue .None true return
    end
  end
  proc(
    Type : t
    ConstValue : value
    bool : isLength
    FilePosition : pos
    ProgramContext ptr.mut : program
  -> Type ConstValue bool ) =>: export: sizeOfValue
    ## TODO support length of initializers
    program .errors =:: errors
    program .idContext =:: idContext
    idContext .typeContext =:: typeContext
    idContext .constContext =:: constContext
    false =:: mut: isType
    t =:: mut: valType
    valType types.primitive.TYPE types.typeEquals if
      value .TypeId ?? ! if
        "unexpected constant value for type type: " sb.copyPtr
          value typeContext sb.appendConstant
        pos errors appendError
        Type .undefined ConstValue .None true return
      end
      value .TypeId valType@ =
      true isType@ =
    end
    valType typeContext types.isPointer or valType typeContext types.isArray if
      valType typeContext types.isFixedSize ! if
        "cannot get the " sb.copyPtr
          isLength if
            "length" sb.appendS
          else
            "size" sb.appendS
          end
          " of : " sb.appendS
          valType typeContext sb.appendType
        pos errors appendError
        Type .undefined ConstValue .None true return
      end
      valType typeContext types.getArraySize =:: sizes
      isLength if
        sizes .length 0 == if
          ## return
            types.primitive.I_SIZE
            1 ConstValue .Int
            false
          return
        end
        sizes
          ..dup .length 1 -
        slice.get =:: outerSize
        outerSize .int ?? if
          ## return
            types.primitive.I_SIZE
            outerSize .int ConstValue .Int
            false
          return
        else outerSize .genericArg ?? _if
          ## return
            types.primitive.I_SIZE
            outerSize .genericArg ConstValue .GenericArg
            false
          return
        else
          "unsupported array-size type: " sb.copyPtr
            ## XXX? print array-size type name
          pos errors appendError
          Type .undefined ConstValue .None true return
        end
      else
        idContext [] .argBuffer .length =:: offset
        0:i64 while ..dup sizes .length < do =:: i
          sizes i slice.get =:: current
          idContext [] .argBuffer
            current .int ?? if
              current .int ConstValue .Int list.append
            else current .genericArg ?? _if
              current .genericArg ConstValue .GenericArg list.append
            else ..drop
              "unsupported array-size type: " sb.copyPtr
                ## XXX? print array-size type name
              pos errors appendError
              Type .undefined ConstValue .None true return
            end
          idContext .argBuffer=
          i 1 +
        end ..drop
        sizes .length types.ArraySize .int =:: sizeLength
        ## return
          ## newArrayType
            types.primitive.I_SIZE
            types.ArrayType .ARRAY
            sizeLength@
            slice.wrap
            false
          typeContext types.newArrayType ..drop
          ## newArrayConst
            ## slice.create
              idContext [] .argBuffer .data offset i64 cast.u +
              idContext [] .argBuffer .length offset -
            slice.create
            idContext .constContext
          newArrayConst
          idContext [] .argBuffer
            offset list.setLength
          idContext .argBuffer=
          false
        return
      end
    else isLength and valType typeContext types.isComposite
        and isType or valType typeContext types.isArrayLiteral _if
      ## return
        types.primitive.I_SIZE
        valType
          typeContext types.compositeEltCount i64 cast.u
        ConstValue .Int
        false
      return
    end
    "unsupported argument type for " sb.copyPtr
      isLength if
        "length" sb.appendS
      else
        "size" sb.appendS
      end
      "-computation: " sb.appendS
      valType typeContext sb.appendType
    pos errors appendError
    Type .undefined ConstValue .None true return
  end
  proc(
    LabelId : generatorName
    ConstValue slice : args
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> Type bool ) =>: export: initializeGeneratedType
    context [] .program =:: program
    program .errors =:: errors
    program .idContext =:: idContext
    idContext .constContext =:: constContext
    idContext .typeContext =:: typeContext
    typeContext .labelContext =:: labelContext
    generatorName idContext id.getIdentifier if ..drop
      "could not find procedure " sb.copyPtr
        generatorName labelContext sb.appendLabelPath
      pos errors appendError
      Type .undefined true return
    end =:: idData
    idData [] .idType .PROCEDURE ?? ! if
      "expected procedure got: " sb.copyPtr
        idData id.asIdInfo labelContext sb.appendIdInfo
      pos errors appendError
      Type .undefined true return
    end
    idData [] .constValue .Procedure =:: procId
    program [] .procedures
      procId i64 cast list.at .data
    =:: procData
    procData [] .procType =:: procType
    procType typeContext types.getProcIn
      ! "proc has in-types" assert
    =:: inType
    inType typeContext types.compositeEltCount =:: argCount
    context offsetContext
    procType
      ## IdentifierInfo
        IdentifierType .PROCEDURE
        generatorName
      IdentifierInfo new
      pos
    opGetId =:: op ## create operation for call
    ## TODO? directly go to evaluation of call operation (for resolving auto-args),
    ##   instead of calling evaluateOperation
    ## push arguments
    0:i32 while $ argCount < do =:: i
      inType i typeContext types.compositeGetLabel =:: argLabel
      argLabel labelContext id.labelFlags id.FLAG_AUTO & ? if
        continue
      end
      inType i typeContext types.compositeGetElement =:: argType
      args i slice.get =:: argValue
      argValue argType pos context pushValue
    finally i 1 + end ..drop
    op@ context evaluateOperation ..drop
    context resetContext
    ## generated type has been initiliaized during evaluation
    ## findGeneratedType
      generatorName
      args
      false
      typeContext
      constContext
    types.findGeneratedType return
  end
  proc(
    ConstValue : value
    types.TypeSetId : typeSetId
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> bool ) =>: export: checkTypeSet
    context [] .program =:: progContext
    progContext .idContext .typeContext =:: typeContext
    value .TypeId ?? ! if
      false return ## only types can be in type-set
    end
    value .TypeId
      $ types.isLiteral if ## decompose literals to type
        typeContext types.literalToType
      end
    =:: toCheck
    typeSetId typeContext types.getTypeSetEntries =:: entries
    context [] .currentFile =:: prevFile
    entries for =:: e
      e .typeId ?? if
        e .typeId toCheck types.typeEquals if
          prevFile context .currentFile=
          true return
        end
        continue
      end
      progContext .procedures [] e .typeTrait i64 cast list.at .data =:: procData
      procData [] .fileId context .currentFile=
      ## StackValue
        types.primitive.TYPE
        toCheck ConstValue .TypeId
      StackValue new =:: arg
      ## resolveCall
        e@ .typeTrait 1 slice.create
        arg@ 1 slice.create
        stringBuilder ptr.mut optional.empty
        pos
        context
      resolveCall
        =:: calledType
        ..drop ## callProcId
      .data =:: callInfo ## procedure should allways match
      callInfo .procId e .typeTrait == "called proc is same as type-trait" assert
      procData .implementation .builtIn ?? if
        ## built-in needs argument on stack
        ## pushValue
          toCheck ConstValue .TypeId
          types.primitive.TYPE
        pos context pushValue
      end
      ## evaluateCall
        callInfo .procId
        callInfo .implementationId
        calledType
        callInfo .autoArgs
        false
      pos context evaluateCall if
        ## TODO? ignore errors produced by call
        continue
      end
      pos context popCondition if ..drop
        continue
      end if
        prevFile context .currentFile=
        true return
      end
    end
    prevFile context .currentFile=
    false return
  end
  proc(
    Type : srcType
    SignType : signType
    ConstValue : oldValue
    Type : targetType
    TypeContext ptr : typeContext
  -> ConstValue ) =>: export: castConstant
    signType .UNSIGNED ?? or signType .NONE ?? and
      srcType typeContext types.isUnsignedInt or srcType typeContext types.isChar or
      srcType typeContext types.isSignedInt ! and
      targetType typeContext types.isUnsignedInt or targetType typeContext types.isChar
    end =:: unsignedCast
    ## XXX ? correctly handle 32-bit floats at compile time
    oldValue .Float ?? and targetType typeContext types.isInt if
      targetType typeContext types.unwrapNamed types.isPrimitive if
        targetType typeContext types.primitiveValue switch
          I8  case
            oldValue .Float unsignedCast if i8  cast.u i64 cast.u else i8  cast.s i64 cast.s end
            ConstValue .Int return
          I16 case
            oldValue .Float unsignedCast if i16 cast.u i64 cast.u else i16 cast.s i64 cast.s end
            ConstValue .Int return
          I32 case
            oldValue .Float unsignedCast if i32 cast.u i64 cast.u else i32 cast.s i64 cast.s end
            ConstValue .Int return
          I64 case
            oldValue .Float unsignedCast if i64 cast.u else i64 cast.s end
            ConstValue .Int return
          BOOL F32 F64 TYPE CHAR8 CHAR16 CHAR32 case ..unreachable
        end
      else unsignedCast _if
        oldValue .Float i64 cast.u ConstValue .Int return
      else
        oldValue .Float i64 cast.s ConstValue .Int return
      end
    end
    ## XXX? zero/sign extend small types
    oldValue .Int ?? if
      oldValue .Int i64 =: mut: intVal
      srcType typeContext types.unwrapNamed types.isPrimitive if
        srcType typeContext types.primitiveValue switch
          I8  CHAR8  case intVal i8 cast
            unsignedCast if i64 cast.u else i64 cast.s end intVal@ = break
          I16 CHAR16 case intVal i16 cast
            unsignedCast if i64 cast.u else i64 cast.s end intVal@ = break
          I32 CHAR32 case intVal i32 cast
            unsignedCast if i64 cast.u else i64 cast.s end intVal@ = break
          F32 F64 case break ## XXX? handle precission loss due to representing int as float
          I64 case break ## no change neccessary
          BOOL TYPE case ..unreachable
        end
      end
      ## uint -> float
      targetType typeContext types.isFloat and signType .UNSIGNED ?? or srcType typeContext types.isUnsignedInt if
        intVal f64 cast.u ConstValue .Float return
      else
        intVal ConstValue .Int return
      end
    end
    ## TODO? special handling for int <-> pointer
    ## TODO? convert primitive arrays to correct array type?
    oldValue return
  end
  proc(
    ConstValue : value
    ValueInfo : valInfo
    i32 : elementIndex
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> bool ) =>: getElement
    context [] .program =:: program
    program .errors =:: errors
    program .idContext =:: idContext
    idContext .constContext =:: constContext
    idContext .typeContext =:: typeContext
    false =:: mut: isPtr
      ## TODO! use correct base mutablity
    true =:: mut: eltMutable ## XXX is it possible to ignore pointer mutability in interpreter?
    valInfo .valueType
      $ typeContext types.isPointer if
        $ typeContext types.isMutable eltMutable & eltMutable@ =
        typeContext types.getBaseType
        true isPtr@ =
      end
      elementIndex typeContext types.compositeGetElement
      isPtr if eltMutable typeContext types.getAddressType end
    =:: eltType
    ## XXX? support (Local)Array8 ... Array64
    value
      $ .LocalValue ?? if
        .LocalValue ConstValue ptr.mut cast []
      end
    =:: containerValue
    containerValue .Array ?? if
      containerValue .Array elementIndex slice.get
    else containerValue .LocalArray ?? _if
      containerValue .LocalArray ConstValue slice.mut cast
        elementIndex slice.at .data
      isPtr and $ [] .LocalValue ?? ! and $ [] .LocalArray ?? ! and $ [] .LocalArray8 ?? ! and
          $ [] .LocalArray16 ?? ! and $ [] .LocalArray32 ?? ! and $ [] .LocalArray64 ?? ! if
        LocalAddress cast ConstValue .LocalValue
      else [] end
    else containerValue .Union ?? _if
      containerValue elementIndex constUnionElement if
        "union index (" sb.copyPtr
          elementIndex sb.appendI
          ") does not match current value (" sb.appendS
          containerValue .Union .eltIndex sb.appendI
          ")" sb.appendS
        pos errors appendError
      end
    else
      "unexpected value for composite constant: " sb.copyPtr
        containerValue typeContext sb.appendConstant
      pos errors appendError
      ## unpopValue
        value
        valInfo
      context unpopValue
      true return
    end =:: eltValue
    ## pushValue
      eltValue
      eltType
      pos
    context pushValue
    false return
  end
  proc(
    ConstValue : value
    ValueInfo : valInfo
    i32 : elementIndex
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> bool ) =>: setElement
    context [] .program =:: program
    program .errors =:: errors
    program .idContext =:: idContext
    idContext .constContext =:: constContext
    idContext .typeContext =:: typeContext
    false =:: mut: isPtr
      ## TODO! use correct base mutablity
    true =:: mut: eltMutable ## XXX is it possible to ignore pointer mutability in interpreter?
    valInfo .valueType
      $ typeContext types.isPointer if
        $ typeContext types.isMutable eltMutable & eltMutable@ =
        typeContext types.getBaseType
        true isPtr@ =
      end
      elementIndex typeContext types.compositeGetElement
    =:: eltType
    eltMutable ! if
      ## XXX? better message
      "cannot write to immutable structure element" sb.copyPtr
      pos errors appendError
      value valInfo context unpopValue
      true return
    end
    pos context popValue if ..drop.2
      ## unpopValue
        value
        valInfo
      context unpopValue
      true return
    end =:: newValue =:: newValInfo
    newValInfo .valueType eltType typeContext types.canAutoCast ! if
      "cannot assign value of type " sb.copyPtr
        newValInfo .valueType typeContext sb.appendType
        " to element of type " sb.appendS
        eltType typeContext sb.appendType
      pos errors appendError
      newValue newValInfo context unpopValue
      value valInfo context unpopValue
      true return
    end
    value .LocalValue ?? =:: wrapped
    value
      wrapped if
        .LocalValue ConstValue ptr.mut cast []
      end
    =:: containerValue
    ## XXX? support (Local)Array8 ...  Array64
    containerValue .Array ?? if
      context [] .localMemory
        containerValue .Array mixedArena.copySlice =:: localAddress
      context .localMemory=
      newValue localAddress elementIndex slice.set
      localAddress LocalSlice cast ConstValue .LocalArray
    else containerValue .LocalArray ?? _if
      newValue
        containerValue .LocalArray ConstValue slice.mut cast
      elementIndex slice.set
      containerValue
    else containerValue .Union ?? _if
      newValue elementIndex constContext newUnionConst
    else
      "unexpected value for writable constant: " sb.copyPtr
        containerValue typeContext sb.appendConstant
      pos errors appendError
      newValue newValInfo context unpopValue
      containerValue valInfo context unpopValue
      true return
    end =:: newContainer
    wrapped if
      newContainer value .LocalValue ConstValue ptr.mut cast []=
    end
    isPtr ! if
      ## pushValue
        wrapped if value else newContainer end
        valInfo .valueType
        pos
      context pushValue
    end
    false return
  end
  ## TODO try merging slice.. / Localslice.. code (? is there a good generic signature)
  proc(
    ConstValue : localArray
    Type : valType
    MixedArenaAllocator ptr.mut : allocator
    ProgramContext ptr.mut : program
  -> ConstValue ) =>: copyLocalArray
    program .idContext .typeContext =:: typeContext
    program .idContext .constContext =:: constContext
    valType typeContext types.isPointer if
      ## don't copy pointers
      localArray return
    end
    ConstValue ..length 23 == "no new constants" assert
    localArray switch
      LocalArray case break
      LocalArray8 case
        localArray .LocalArray8 i8 slice.mut cast =:: arrayData
        localArray .LocalArray8 .length 1 == and valType typeContext types.isIntLike if
          arrayData 0 slice.get i64 cast.u ConstValue .Int return
        end
        allocator []
          arrayData mixedArena.copyMutableSlice =:: tmpArray
        allocator []=
        tmpArray slice.freeze constContext newArray8Const return
      LocalArray16 case
        localArray .LocalArray16 i16 slice.mut cast =:: arrayData
        arrayData .length 1 == and valType typeContext types.isIntLike if
          arrayData 0 slice.get i64 cast.u ConstValue .Int return
        end
        allocator []
          arrayData mixedArena.copyMutableSlice =:: tmpArray
        allocator []=
        tmpArray slice.freeze constContext newArray16Const return
      LocalArray32 case
        localArray .LocalArray32 i32 slice.mut cast =:: arrayData
        arrayData .length 1 == and valType typeContext types.isIntLike if
          arrayData 0 slice.get i64 cast.u ConstValue .Int return
        end
        allocator []
          arrayData mixedArena.copyMutableSlice =:: tmpArray
        allocator []=
        tmpArray slice.freeze constContext newArray32Const return
      LocalArray64 case
        localArray .LocalArray64 i64 slice.mut cast =:: arrayData
        arrayData .length 1 == and valType typeContext types.isIntLike if
          arrayData 0 slice.get ConstValue .Int return
        end
        allocator []
          arrayData mixedArena.copyMutableSlice =:: tmpArray
        allocator []=
        tmpArray slice.freeze constContext newArray64Const return
      default ..unreachable
    end
    localArray .LocalArray ConstValue slice.mut cast =:: dataArray
    allocator []
      dataArray mixedArena.copyMutableSlice =:: tmpArray
    allocator []=
    valType typeContext types.getElementType =:: arrayBase
    ## 1. copy elements
    dataArray .length for =:: i
      dataArray i slice.get =:: elt
      arrayBase .undefined ?? ! if
        arrayBase
      else
        valType i i32 cast typeContext types.compositeGetElement
      end =:: eltType
      ConstValue ..length 23 == "no new constants" assert
      elt switch
        LocalValue case elt .LocalValue ConstValue ptr.mut cast [] break
        LocalArray LocalArray8 LocalArray16 LocalArray32 LocalArray64 case
          elt eltType allocator program copyLocalArray break
        default elt break
      end tmpArray i slice.set
    end
    ## TODO find a way to avoid recreation of identical constants
    tmpArray slice.freeze constContext newArrayConst
  end
  proc(
    ConstValue : value
    Type : valType
    bool : wrapPointers
    InterpreterContext ptr.mut : context
  -> ConstValue ) =>: localCopy
    context [] .program .idContext .typeContext =:: typeContext
    valType typeContext types.isPointer if ## XXX? merge with default branch
      wrapPointers ! if
        value return
      end
      context [] .localMemory
        value mixedArena.copyValue =:: localAddress
      context .localMemory=
      localAddress LocalAddress cast ConstValue .LocalValue return
    end
    ConstValue ..length 23 == "no new constants" assert
    value switch
      Array LocalArray case break
      Array8 case
        context [] .localMemory
          value .Array8 mixedArena.copySlice =:: localAddress
        context .localMemory=
        localAddress LocalSlice8 cast ConstValue .LocalArray8
        return
      LocalArray8 case
        context [] .localMemory
          value .LocalArray8 i8 slice.mut cast mixedArena.copyMutableSlice =:: localAddress
        context .localMemory=
        localAddress LocalSlice8 cast ConstValue .LocalArray8
        return
      Array16 case
        context [] .localMemory
          value .Array16 mixedArena.copySlice =:: localAddress
        context .localMemory=
        localAddress LocalSlice16 cast ConstValue .LocalArray16
        return
      LocalArray16 case
        context [] .localMemory
          value .LocalArray16 i16 slice.mut cast mixedArena.copyMutableSlice =:: localAddress
        context .localMemory=
        localAddress LocalSlice16 cast ConstValue .LocalArray16
        return
      Array32 case
        context [] .localMemory
          value .Array32 mixedArena.copySlice =:: localAddress
        context .localMemory=
        localAddress LocalSlice32 cast ConstValue .LocalArray32
        return
      LocalArray32 case
        context [] .localMemory
          value .LocalArray32 i32 slice.mut cast mixedArena.copyMutableSlice =:: localAddress
        context .localMemory=
        localAddress LocalSlice32 cast ConstValue .LocalArray32
        return
      Array64 case
        context [] .localMemory
          value .Array64 mixedArena.copySlice =:: localAddress
        context .localMemory=
        localAddress LocalSlice64 cast ConstValue .LocalArray64
        return
      LocalArray64 case
        context [] .localMemory
          value .LocalArray64 i64 slice.mut cast mixedArena.copyMutableSlice =:: localAddress
        context .localMemory=
        localAddress LocalSlice64 cast ConstValue .LocalArray64
        return
      ## TODO? replace union element by local copy
      default
        context [] .localMemory
          value mixedArena.copyValue =:: localAddress
        context .localMemory=
        localAddress LocalAddress cast ConstValue .LocalValue
        return
    end
    context [] .localMemory
      value .Array ?? if
        value .Array
      else
        value .LocalArray ConstValue slice.mut cast slice.freeze
      end mixedArena.copySlice =:: localSlice
    context .localMemory=
    valType typeContext types.getElementType =:: arrayBase
    ## copy sub-arrays
    localSlice .length for =:: i
      localSlice i slice.at .data =:: elt
      arrayBase .undefined ?? ! if
        arrayBase
      else
        valType i i32 cast typeContext types.compositeGetElement
      end =:: eltType
      elt [] .Array ?? if
        elt [] eltType false context localCopy elt []=
      end
    end
    localSlice LocalSlice cast ConstValue .LocalArray
  end
  proc(
    Type : dataType
    FilePosition : pos
    InterpreterContext ptr.mut : context
  -> ConstValue ) =>: allocLocalValue
    context [] .program =:: program
    program .errors =:: errors
    program .idContext .typeContext =:: typeContext
    ## XXX? better way to detect multi-value types
    dataType typeContext types.isTuple if
      dataType typeContext types.compositeEltCount =:: eltCount
      context [] .localMemory
        eltCount i32 cast ConstValue mixedArena.allocSlice =:: localSlice
      context .localMemory=
      eltCount for =:: i
        dataType i typeContext types.compositeGetElement =:: eltType
        eltType typeContext types.isTuple or eltType typeContext types.isArray if
          eltType pos context allocLocalValue
        else
          ConstValue .None
        end localSlice i slice.set
      end
      localSlice LocalSlice cast ConstValue .LocalArray return
    else dataType typeContext types.isArray _if
      ## XXX? merge with previous case
      dataType typeContext types.getArraySize =:: arraySizes
      arraySizes .length 0 > if
        arraySizes $ .length 1 - slice.get =:: arraySize
        arraySize .int ?? if
          arraySize .int
        else
          "generic arrays are not supported" sb.copyPtr
          pos errors appendError
          0
        end
      else 1 end =:: eltCount
      dataType typeContext types.getElementType =:: eltType
      eltType typeContext types.unwrapNamed =:: eltBase
      eltBase types.isPrimitive if
        eltBase typeContext types.primitiveValue switch
          BOOL I8 CHAR8 case
            context [] .localMemory
              eltCount i32 cast i8 mixedArena.allocSlice =:: localSlice
            context .localMemory=
            0:i8 localSlice slice.fill
            localSlice LocalSlice8 cast ConstValue .LocalArray8 return
          I16 CHAR16 case
            context [] .localMemory
              eltCount i32 cast i16 mixedArena.allocSlice =:: localSlice
            context .localMemory=
            0:i16 localSlice slice.fill
            localSlice LocalSlice16 cast ConstValue .LocalArray16 return
          I32 CHAR32 case
            context [] .localMemory
              eltCount i32 cast i32 mixedArena.allocSlice =:: localSlice
            context .localMemory=
            0:i32 localSlice slice.fill
            localSlice LocalSlice32 cast ConstValue .LocalArray32 return
          I64 case
            context [] .localMemory
