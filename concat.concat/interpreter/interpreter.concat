#include map

#include "interpreter/operators.concat"
#include "identifiers.concat"
#include "program.concat"

struct(
  Type : valueType
  LabelId : valueId
  LabelId : mut valueName
  FilePosition : mut pushedAt
) =:: public ValueInfo

struct(
  ConstValue : value
  ValueInfo  : info
) =:: Constant

struct(
  BlockType : blockType
  i64 : stackOffset
) =:: BlockInfo

struct(
  ProgramContext ptr mut : program
  LabelId Constant hashMap : mut variables
  ConstValue list : mut stack
  ValueInfo  list : mut stackInfo
  BlockInfo  list : mut openBlocks
  Type list : mut typeBuffer
  LabelId list : mut labelBuffer
) =:: public InterpreterContext
proc( LabelId => i32 ) =: labelHash end
proc( LabelId LabelId => bool ) =: labelEq == end

proc( i64 : count InterpreterContext ptr mut : context => bool ) =: checkStack
  context [] .openBlocks .length 0 > if
    context [] .openBlocks context [] .openBlocks .length 1 - list.at .data [] .stackOffset
  else 0i64 end =:: offset
  context [] .stack .length offset - count <
end
proc( InterpreterContext ptr mut : context => i64 ) =: minStackOffset
  context [] .openBlocks .length 0 > if
    context [] .openBlocks
      context [] .openBlocks .length 1 - list.at .data []
    .stackOffset return
  end
  0 return
end

proc( InterpreterContext ptr mut : context => bool ) =: inEnum
  ## XXX cache number of open enum blocks
  context [] .openBlocks .length 1 - while #dup 0 >= do
    context [] .openBlocks #over list.at .data [] .blockType BlockType .TYPE_ENUM == if #drop
      true return
    end
    1 -
  end #drop
  false return
end
proc( InterpreterContext ptr mut : context => bool ) =: inTypeOrInitializer
  ## XXX cache/precompute result
  context [] .openBlocks .length 1 - while #dup 0 >= do
    context [] .openBlocks #over list.at .data [] .blockType switch
      INITIALIZER TYPE_TUPLE TYPE_STRUCT TYPE_ENUM TYPE_UNION
       TYPE_PROC_IN TYPE_PROC_OUT TYPE_COMPOSITE case
         #drop true return
      PROCEDURE EXPERIMENTAL_PROCEDURE case
        #drop false return
      UNKNOWN IF IFIF ELSE WHILE DO BREAK CONTINUE
       SWITCH CASE DEFAULT case break
    end
    1 -
  end #drop
  false return
end
proc( InterpreterContext ptr mut : context => bool ) =: inInitializer
  ## XXX cache/precompute result
  context [] .openBlocks .length 1 - while #dup 0 >= do
    context [] .openBlocks #over list.at .data [] .blockType switch
      INITIALIZER case
         #drop true return
      TYPE_TUPLE TYPE_STRUCT TYPE_ENUM TYPE_UNION
       TYPE_PROC_IN TYPE_PROC_OUT TYPE_COMPOSITE
       PROCEDURE EXPERIMENTAL_PROCEDURE case
         #drop false return
      UNKNOWN IF IFIF ELSE WHILE DO BREAK CONTINUE
       SWITCH CASE DEFAULT case break
    end
    1 -
  end #drop
  false return
end

proc( BlockType : blockType InterpreterContext ptr mut : context => ) =: openBlock
  context [] .openBlocks
    ## BlockInfo
      blockType
      context [] .stack .length ## XXX add possibility to inherit offset from outer block
    BlockInfo new list.append
  context [] .openBlocks =
end

proc(
  Operation ptr : op
  BlockInfo ptr : closedBlock
  bool : forceLabel
  InterpreterContext ptr mut : context
=> bool ) =: closedTypeBlock
  context [] .program [] .errors @ =:: errors
  context [] .program [] .idContext @ =:: idContext
  context [] .program [] .idContext .constContext @ =:: constContext
  context [] .program [] .idContext .typeContext @ =:: typeContext
  context [] .program [] .idContext .labelContext @ =:: labelContext
  closedBlock [] .stackOffset =:: offset
  context [] .stack .length offset - =:: elementCount
  context [] .typeBuffer
    list.clear
    elementCount list.ensureCap
  context [] .typeBuffer =
  context [] .labelBuffer
    list.clear
    elementCount list.ensureCap
  context [] .labelBuffer =
  false =:: mut error
  0 while #dup elementCount < do
    context [] .stack
      #over offset +
    list.at .data =:: stackValue
    context [] .stackInfo
      #over offset +
    list.at .data =:: stackInfo
    stackInfo [] .valueType types.primitive.TYPE types.typeEquals ! if
      "unsupported type in composite type, expected type got " sb.wrap
        stackInfo [] .valueType labelContext typeContext sb.appendType
      stackInfo [] .pushedAt errors appendError
      true error =
      1 + continue
    end
    context [] .typeBuffer
      stackValue [] .typeId list.append
    context [] .typeBuffer =
    forceLabel if stackInfo [] .valueName id.LABEL_ID_NONE == _if
      "missing label for composite element" sb.wrap
      stackInfo [] .pushedAt errors appendError
      true error =
    end
    context [] .labelBuffer
      stackInfo [] .valueName list.append
    context [] .labelBuffer =
    1 +
  end #drop
  context [] .stack
    offset list.setLength
  context [] .stack =
  context [] .stackInfo
    offset list.setLength
  context [] .stackInfo =
  error return
end


proc(
  Operation ptr : op
  BlockInfo ptr : closedBlock
  InterpreterContext ptr mut : context
=>
  ConstValue arrayView
  Type
  bool
) =: closedInitializer
  context [] .program [] .errors @ =:: errors
  context [] .program [] .idContext @ =:: idContext
  context [] .program [] .idContext .constContext @ =:: constContext
  context [] .program [] .idContext .typeContext @ =:: typeContext
  context [] .program [] .idContext .labelContext @ =:: labelContext
  closedBlock [] .stackOffset =:: offset
  context [] .stack .length offset - =:: elementCount
  context [] .typeBuffer
    list.clear
    elementCount list.ensureCap
  context [] .typeBuffer =
  context [] .labelBuffer
    list.clear
    elementCount list.ensureCap
  context [] .labelBuffer =
  Type .undefined =:: mut arrayType
  true =:: mut hasArrayType
  false =:: mut hasName
  false =:: mut error
  0 while #dup elementCount < do
    context [] .stack
      #over offset +
    list.at .data =:: stackValue
    context [] .stackInfo
      #over offset +
    list.at .data =:: stackInfo
    context [] .typeBuffer
      stackInfo [] .valueType list.append
    context [] .typeBuffer =
    context [] .labelBuffer
      stackInfo [] .valueName list.append
    context [] .labelBuffer =
    stackInfo [] .valueName id.LABEL_ID_NONE != if
      true hasName =
      ## if there is a labeled element the initializer is not an array
      false hasArrayType =
      Type .undefined arrayType =
    end
    hasArrayType if
      arrayType Type .undefined types.typeEquals if ## XXX compute common super-type if possible
       stackInfo [] .valueType arrayType =
      else arrayType stackInfo [] .valueType types.typeEquals ! _if
        false hasArrayType =
        Type .undefined arrayType =
      end
    end
    1 +
  end #drop
  context [] .stack list.asArray offset array.tail =:: values
  context [] .stack
    offset list.setLength
  context [] .stack =
  context [] .stackInfo
    offset list.setLength
  context [] .stackInfo =
  values arrayType error return
end

proc(
  ConstValue : value
  Type : valType
  LabelId : id
  FilePosition : pos
  InterpreterContext ptr mut : context
=> ) =: pushValue
  context [] .stack
    value list.append
  context [] .stack =
  context [] .stackInfo
    ## ValueInfo
      valType
      id
      id.LABEL_ID_NONE
      pos
    ValueInfo new list.append
  context [] .stackInfo =
end

## TODO use wrapper procedures for stack access

proc(
  Operation ptr : op
  InterpreterContext ptr mut : context
  bool : showErrorMessages ## TODO distinguish non-interpretable operations and errors
=>
  bool
) =: public evaluateOperation
  context [] .program [] .errors @ =:: errors
  context [] .program =:: program
  context [] .program [] .idContext @ =:: idContext
  context [] .program [] .idContext .constContext @ =:: constContext
  context [] .program [] .idContext .typeContext @ =:: typeContext
  context [] .program [] .idContext .labelContext @ =:: labelContext
  op [] .val switch
    NOP case
      false return
    OpValue .Constant case
      ## pushValue
        op [] .val .Constant
        op [] .dataType
        id.LABEL_ID_NONE ## XXX? remember id in op-type
        op [] .pos
      context pushValue
      false return
    Return case
      context [] .openBlocks .length 1 - while #dup 0 >= do
        context [] .openBlocks #over list.at .data [] .blockType
         #dup BlockType .PROCEDURE == #swap BlockType .EXPERIMENTAL_PROCEDURE == | if
          ## close procedure block
          context [] .openBlocks
            #swap list.setLength
          context [] .openBlocks =
          false return
        end
        1 -
      end #drop
      "return outside procedure" sb.wrap op [] .pos errors appendError
      true return
    block case
      op [] .val .block .blockType switch
        TYPE_TUPLE
        TYPE_STRUCT
        TYPE_ENUM
        TYPE_UNION
        TYPE_PROC_IN
        TYPE_PROC_OUT
        TYPE_COMPOSITE
        INITIALIZER case
          op [] .val .block .blockType context openBlock
          false return
        PROCEDURE
        EXPERIMENTAL_PROCEDURE
        IF
        IFIF
        ELSE
        WHILE
        DO
        BREAK
        CONTINUE
        SWITCH
        CASE
        DEFAULT
        UNKNOWN case
          showErrorMessages if
            "unsupported block-type in constant evaluation: " sb.wrap
              op [] .val .block .blockType sb.appendBlockType
            op [] .pos errors appendError
          end
          true return
      end
      break
    blockEnd case
      op [] .val .blockEnd .blockType =:: blockType
      context [] .openBlocks .length 0 == if
        "unexpected end of " sb.wrap
         blockType sb.appendBlockType
         "-Block" sb.appendS
        op [] .pos errors appendError
        true return
      end
      context [] .openBlocks
        list.pop =:: closedBlock ## XXX avoid copying blockInfo into local variable
      context [] .openBlocks =
      closedBlock .blockType blockType != if
        showErrorMessages if
          "unexpected end of " sb.wrap
           blockType sb.appendBlockType
           "-Block expected " sb.appendS
           closedBlock .blockType sb.appendBlockType
          op [] .pos errors appendError
        end
        true return
      end
      blockType switch
        TYPE_TUPLE TYPE_STRUCT case
          op closedBlock @ false context closedTypeBlock if true return end
          ## newProcArgs
            context [] .typeBuffer list.asArray
            context [] .labelBuffer list.asArray optional.wrap
          typeContext types.newTuple if #drop
            showErrorMessages if
              "could not create structure-type" sb.wrap op [] .pos errors appendError
            end
            true return
          end =:: tupleType
          ## pushValue
            tupleType ConstValue .typeId new
            types.primitive.TYPE
            id.LABEL_ID_NONE
            op [] .pos
          context pushValue
          false return
        TYPE_ENUM case
          op closedBlock @ true context closedTypeBlock if true return end
          ## newProcArgs
            context [] .typeBuffer list.asArray
            context [] .labelBuffer list.asArray optional.wrap
          typeContext types.newEnum if #drop
            showErrorMessages if
              "could not create enum" sb.wrap op [] .pos errors appendError
            end
            true return
          end =:: enumType
          ## pushValue
            enumType ConstValue .typeId new
            types.primitive.TYPE
            id.LABEL_ID_NONE
            op [] .pos
          context pushValue
          false return
        TYPE_UNION case
          op closedBlock @ true context closedTypeBlock if true return end
          ## newProcArgs
            context [] .typeBuffer list.asArray
            context [] .labelBuffer list.asArray optional.wrap
          typeContext types.newUnion if #drop
            showErrorMessages if
              "could not create union-type" sb.wrap op [] .pos errors appendError
            end
            true return
          end =:: unionType
          ## pushValue
            unionType ConstValue .typeId new
            types.primitive.TYPE
            id.LABEL_ID_NONE
            op [] .pos
          context pushValue
          false return
        TYPE_PROC_IN
        TYPE_COMPOSITE case
          op closedBlock @ false context closedTypeBlock if true return end
          context [] .typeBuffer .length 1 >= if
            ## last argument is procedure output
            context [] .typeBuffer context [] .typeBuffer .length 1 - list.get Type .procOut == _if
              true
          else false end =:: isProc
          context [] .typeBuffer .length
            isProc if 1 else 0 end - ## last value is return type
          =:: nArgs
          blockType BlockType .TYPE_PROC_IN == isProc ! & if
            showErrorMessages if
              "missing return type for procedure" sb.wrap op [] .pos errors appendError
            end
            true return
          end
          isProc if
            ## newProcArgs
              context [] .typeBuffer list.asArray nArgs array.head
              context [] .labelBuffer list.asArray nArgs array.head optional.wrap
              false
            typeContext types.newProcArgs =:: procIn
            context [] .typeBuffer nArgs list.get =:: procOut
            procIn procOut CallingConvention.DEFAULT typeContext types.newProcedure if #drop
              showErrorMessages if
                "could not create procedure-type" sb.wrap op [] .pos errors appendError
              end
              true return
            end
          else
            nArgs 0 == if
              Type .empty
            else
              ## newProcArgs
                context [] .typeBuffer list.asArray nArgs array.head
                context [] .labelBuffer list.asArray nArgs array.head optional.wrap
              typeContext types.newTuple if #drop
                showErrorMessages if
                  "could not create structure-type" sb.wrap op [] .pos errors appendError
                end
                true return
              end
            end
          end =:: newType
          ## pushValue
            newType ConstValue .typeId new
            types.primitive.TYPE
            id.LABEL_ID_NONE
            op [] .pos
          context pushValue
          false return
        TYPE_PROC_OUT case
          op closedBlock @ false context closedTypeBlock if true return end
          ## newProcArgs
            context [] .typeBuffer list.asArray
            context [] .labelBuffer list.asArray optional.wrap
            true
          typeContext types.newProcArgs =:: procOut
          ## pushValue
            procOut ConstValue .typeId new
            types.primitive.TYPE
            id.LABEL_ID_NONE
            op [] .pos
          context pushValue
          false return
        PROCEDURE EXPERIMENTAL_PROCEDURE case
          ## end procedure
          false return
        INITIALIZER case
          op closedBlock @ context closedInitializer if
            #drop:2 true return
          end =:: arrayType =:: values
          ## newArrayConst
            values
            idContext [] .constContext @
          newArrayConst =:: value
          arrayType Type .undefined types.typeEquals if
            context [] .typeBuffer .length 0 == if
              Type .empty
            else
              ## newTuple
                context [] .typeBuffer list.asArray
                context [] .labelBuffer list.asArray optional.wrap
                typeContext
              types.newTuple if
                "could not create type of structure-constant" sb.wrap
                op [] .pos errors appendError
              end
            end
          else ## TODO array of arrays -> 2D array
            ## ArraySize
              values .length
              types.ArraySizeType .int
            types.ArraySize new =:: mSize
            arrayType
             false
             mSize @ array.wrap
             true
             false
            typeContext types.newArrayType if
              "could not create type of array-constant " sb.wrap
              op [] .pos errors appendError
            end
          end =:: mType
          ## pushValue
            value
            mType
            id.LABEL_ID_NONE
            op [] .pos
          context pushValue
          false return
        IF
        IFIF
        ELSE
        WHILE
        DO
        BREAK
        CONTINUE
        SWITCH
        CASE
        DEFAULT
        UNKNOWN case
          showErrorMessages if
            "unsupported block-end in constant evaluation: " sb.wrap
              op [] .val .blockEnd .blockType sb.appendBlockType
            op [] .pos errors appendError
          end
          true return
      end
    declareId case
      context inTypeOrInitializer ! if
        showErrorMessages if
          "interpreting declarations is currently only supported in type-blocks and initializers " sb.wrap
          op [] .pos errors appendError
        end
        true return
      end
      1 context checkStack if
        showErrorMessages if
          "not enough arguments for declaration, expected 1 got 0" sb.wrap
          op [] .pos errors appendError
        end
        true return
      end
      ## TODO declare name as local variable
      context [] .stackInfo list.peek .data =:: valInfo
      context inInitializer ! if
        valInfo [] .valueType types.primitive.TYPE types.typeEquals ! if
          showErrorMessages if
            "wrong argument type for declartion expected type got " sb.wrap
              valInfo [] .valueType labelContext typeContext sb.appendType
            op [] .pos errors appendError
          end
          true return
        end
      end
      op [] .val .declareId .labelId valInfo [] .valueName =
      false return
    getName case
      context inEnum if
        context [] .stack
          Type .empty ConstValue .typeId new list.append
        context [] .stack =
        context [] .stackInfo
          ## ValueInfo
            types.primitive.TYPE
            id.LABEL_ID_NONE
            op [] .val .getName
            op [] .pos
          ValueInfo new list.append
        context [] .stackInfo =
        false return
      end
      showErrorMessages if
        "unsupported operation in constant evaluation: " sb.wrap
          op [] constContext labelContext typeContext sb.appendOp
        op [] .pos errors appendError
      end
      true return
    getId case
      op [] .val .getId .labelId =:: label
      op [] .val .getId .idType switch
        PROCEDURE case
          op [] .val .getId =:: idInfo
          idInfo .constValue ConstValue .procedure != if
            "unexpected value for procedure constant: " sb.wrap
              idInfo .constValue constContext labelContext typeContext sb.appendConstant
            op [] .pos errors appendError
            true return
          end
          op [] .dataType typeContext types.getProcOut #drop =:: procOut
          procOut typeContext types.compositeElts =:: outTypes
          outTypes .length 1 == if outTypes 0 array.get types.primitive.TYPE types.typeEquals _if
            ## type-generator (procedure returning type)
            op [] .dataType typeContext types.getProcIn #drop =:: procIn
            procOut typeContext types.compositeElts =:: inTypes
            inTypes .length context checkStack if
              "not enough arguments for type-generator " sb.wrap
                label labelContext id.labelName .data sb.appendStr
              op [] .pos errors appendError
              true return
            end
            ## XXX resolve arguments
            context [] .stack .length inTypes .length - =:: offset
            ## findGeneratedType
              label
              context [] .stack list.asArray offset array.tail
              typeContext
              labelContext
              constContext
            types.findGeneratedType if ## newType
              idContext [] .templateArgBuffer .length =:: argOffset
              idContext [] .templateArgBuffer ## remember procedure arguments
                context [] .stack list.asArray offset array.tail list.appendArray
              idContext [] .templateArgBuffer =
              idInfo .constValue .procedure op [] .pos context evaluateCall if #drop
                "could not initialize type-generator " sb.wrap
                  label labelContext id.labelName .data sb.appendStr
                op [] .pos errors appendError
                idContext [] .templateArgBuffer
                  argOffset list.setLength
                idContext [] .templateArgBuffer =
                true return
              end
              ## initializeGeneratedType
                label
                idContext [] .templateArgBuffer list.asArray argOffset array.tail
                  idContext [] .templateArgBuffer
                    argOffset list.setLength
                  idContext [] .templateArgBuffer =
                context [] .stack offset list.get .typeId ## return value of call
                typeContext
                labelContext
                constContext
              types.initializeGeneratedType if #drop
                "could not initialize type-generator " sb.wrap
                  label labelContext id.labelName .data sb.appendStr
                op [] .pos errors appendError
                true return
              end
            end =:: generated
            context [] .stack
              offset list.setLength
            context [] .stack =
            context [] .stackInfo
              offset list.setLength
            context [] .stackInfo =
            ## pushValue
              generated ConstValue .typeId new
              types.primitive.TYPE
              id.LABEL_ID_NONE
              op [] .pos
              context
            pushValue
            false return
          end
          idInfo .constValue .procedure op [] .pos context evaluateCall return
        LOCAL_VAR ARGUMENT case
          context [] .variables @ label map.get =:: value?
          value? optional.isEmpty if
            showErrorMessages if
              "missing value for " sb.wrap
                op [] .val .getId labelContext sb.appendIdInfo
              op [] .pos errors appendError
            end
            true return
          end
          value? .data =:: value ## TODO? wrap local variable in reference?
          value .value value .info .valueType label op [] .pos context pushValue
          false return
        TYPE TEMPLATE_ARG GLOBAL_VAR TMP_VAR LABEL case
        showErrorMessages if
          "unsupported operation in constant evaluation: " sb.wrap
            op [] constContext labelContext typeContext sb.appendOp
          op [] .pos errors appendError
        end
        true return
      end
      break
    typeModifier case
        true =:: mut fixedSize
        context minStackOffset =:: minOffset
        context [] .stack .length 1 - =:: mut offset
        offset minOffset > if context [] .stack offset list.get ConstValue .wildCard == _if
          false fixedSize =
          offset 1 - offset =
        end
        0 =:: mut intArgs
        offset while #dup minOffset >= do
          context [] .stackInfo #over list.at .data [] .valueType typeContext types.isInt ! if
            break
          end
          intArgs 1 + intArgs =
          1 -
        end offset =
        idContext [] .arraySizeBuffer
          list.clear
          intArgs list.ensureCap
        idContext [] .arraySizeBuffer =
        1 while #dup intArgs <= do
          context [] .stack offset #over:2 + list.get =:: intArg
          intArg ConstValue .int == if
            ## TODO ensure array sizes are positive
            idContext [] .arraySizeBuffer
              ## ArraySize
                intArg .int
                types.ArraySizeType .int
              types.ArraySize new list.append
            idContext [] .arraySizeBuffer =
          else intArg ConstValue .genericArg == _if
            idContext [] .arraySizeBuffer
              ## ArraySize
                intArg .genericArg
                types.ArraySizeType .staticArg
              types.ArraySize new list.append
            idContext [] .arraySizeBuffer =
          else intArg ConstValue .templateArg == _if
            idContext [] .arraySizeBuffer
              ## ArraySize
                intArg .templateArg
                types.ArraySizeType .templateArg
              types.ArraySize new list.append
            idContext [] .arraySizeBuffer =
          else
            "unexpected constant for array size: " sb.wrap
              intArg constContext labelContext typeContext sb.appendConstant
            context [] .stackInfo #over:2 list.at .data [] .pushedAt errors appendError
          end
          1 +
        end #drop
        offset minOffset < if
          "missing type parameter for type-modifier " sb.wrap
            op [] .val .typeModifier sb.appendTypeModifier
          op [] .pos errors appendError
          true return
        end
        context [] .stack offset list.get =:: typeConstant
        typeConstant ConstValue .typeId != if
          "unexpected constant parameter for type-modifier " sb.wrap
            op [] .val .typeModifier sb.appendTypeModifier
            " expected type got " sb.appendS
            typeConstant constContext labelContext typeContext sb.appendConstant
          op [] .pos errors appendError
          true return
        end
      op [] .val .typeModifier TypeModifier .ARRAY != =:: isPtr
      fixedSize ! isPtr ! & if
        "array types must have a fixed size" sb.wrap op [] .pos errors appendError
      end
      ## newArrayType
        typeConstant .typeId
        isPtr
        idContext [] .arraySizeBuffer list.asArray
        fixedSize
        op [] .val .typeModifier TypeModifier .PTR_MUT ==
        typeContext
      types.newArrayType if #drop
        isPtr if
          "could not create pointer type" sb.wrap op [] .pos errors appendError
        else
          "could not create array type" sb.wrap op [] .pos errors appendError
        end
        true return
      end =:: ptrType
      context [] .stack
        offset list.setLength
      context [] .stack =
      context [] .stackInfo
        offset list.setLength
      context [] .stackInfo =
      ## pushValue
        ptrType ConstValue .typeId new
        types.primitive.TYPE
        id.LABEL_ID_NONE
        op [] .pos
        context
      pushValue
      false return
    entryPoint
    setId @Id initializeId autoTypedInitializeId
    getLabel setLabel @Label
    getElement setElement @Element
    getArrayElement setArrayElement @ArrayElement setValue
    Print New newEnum call callPtr
    argc getArg getArgLen
    length size Cast Cast! autoCast
    unaryOperator binaryOperator
    enumLabelEq enumLabelNe checkEnumLabel setEnumLabel checkArrayIndex
    stackMod setName @Name
    compilerInfo unreachable case
      showErrorMessages if
        "unsupported operation in constant evaluation: " sb.wrap
          op [] constContext labelContext typeContext sb.appendOp
        op [] .pos errors appendError
      end
      true return
  end
end

proc(
  Operation arrayView : ops
  InterpreterContext ptr mut : context
=>
  bool
) =: public evaluateOperations
  0 =:: mut offset
  context [] .openBlocks .length 1 - while #dup 0 >= do
    context [] .openBlocks #over list.at .data [] .blockType
     #dup BlockType .PROCEDURE == #swap BlockType .EXPERIMENTAL_PROCEDURE == | if
      break
    end
    1 -
  end =:: procBlockIndex
  while offset ops .length < do
    ops offset array.at .data =:: op
      op context true evaluateOperation if
        true return
      end
      context [] .openBlocks .length procBlockIndex < if
        false return ## break evaluation when leaving procedure block
      end
    offset 1 + offset =
  end
  ## XXX error if unwanted open blocks
  false return
end
#+evaluate procedure body with the given arguments+#
proc(
  i64 : procId
  FilePosition : pos
  InterpreterContext ptr mut : context
=>
  bool
) =: public evaluateCall
  context [] .program [] .errors @ =:: errors
  context [] .program =:: program
  context [] .program [] .idContext @ =:: idContext
  context [] .program [] .idContext .typeContext @ =:: typeContext
  program [] .procedures procId list.at .data =:: procData
  procData [] .procType =:: procType
  procType typeContext types.getProcIn #drop =:: inType
  inType typeContext types.compositeElts =:: args
  args .length context checkStack if
    "not enough arguments for procedure " sb.wrap
      ## TODO print procedure label
    pos errors appendError
    true return
  end
  context [] .stack .length args .length - =:: argsOffset
  ## XXX resolve signature
  ## TODO check argument types
  ## TODO interpreter modes depending on program state
  program [] .templateOps ## -> procedures are stored in template ops until they are type-checked
  ## program [] .progFiles procData [] .fileId list.at .data [] .localOps
    procData [] .codeStart
    procData [] .codeLength
  list.slice =:: code
  code 0 array.at .data =:: op
  op [] .val OpValue .initializeId != if true else
    op [] .val .initializeId .idType IdentifierType .PROCEDURE !=
  end if
    "expected procedure initialization got " sb.wrap
      op []
        idContext [] .constContext @
        idContext [] .labelContext @
        idContext [] .typeContext @
      sb.appendOp
    op [] .pos errors appendError
    true return ## not a call
  end
  context [] .stack .length =:: stackOffset
  ## process procedure arguments
  0 while #dup args .length < do
    context [] .stack #over argsOffset + list.at .data =:: value
    context [] .stackInfo #over argsOffset + list.at .data =:: valueInfo
    inType #over typeContext types.compositeGetLabel =:: label
    label id.LABEL_ID_NONE != if ## store argument as value
      context [] .variables @
        label
        ## Constant
          value []
          valueInfo []
        Constant new
      map.put #drop
    else ## push argument
      context [] .stack
        value list.appendP
      context [] .stack =
      context [] .stackInfo
        ## ValueInfo
          valueInfo [] .valueType
          id.LABEL_ID_NONE
          id.LABEL_ID_NONE
          pos
        ValueInfo new list.append
      context [] .stackInfo =
    end
    1 +
  end #drop
  BlockType .PROCEDURE context openBlock
  ## evaluateOperations
    code 1 array.tail ## first operation declares procedure
    context
  evaluateOperations if
    context [] .stack
      stackOffset list.setLength
    context [] .stack =
    context [] .stackInfo
      stackOffset list.setLength
    context [] .stackInfo =
    true return
  else
    context [] .stack .length stackOffset - =:: nReturn
    ## mem.copy
      context [] .stack .data argsOffset +
      context [] .stack .data stackOffset +
      nReturn
    mem.copy #drop
    ## mem.copy
      context [] .stackInfo .data argsOffset +
      context [] .stackInfo .data stackOffset +
      nReturn
    mem.copy #drop
    context [] .stack
      argsOffset nReturn + list.setLength
    context [] .stack =
    context [] .stackInfo
      argsOffset nReturn + list.setLength
    context [] .stackInfo =
    argsOffset while #dup context [] .stackInfo .length < do
      ## update push position of return values
      pos context [] .stackInfo #over:2 list.at .data [] .pushedAt =
      1 +
    end #drop
    false return
  end
end

proc(
  ProgramContext ptr mut : progContext
=>
  InterpreterContext
) =: public wrapProgram
  ## InterpreterContext
    progContext
    labelHash @ labelEq @ 32 Constant map.create
    64 ConstValue list.create
    64 ValueInfo  list.create
    64 BlockInfo  list.create
    64 Type       list.create
    64 LabelId    list.create
  InterpreterContext new
end

proc(
  InterpreterContext ptr mut : context
=> ) =: public resetContext
  ## TODO? clear local variables in map
  context [] .stackInfo   list.clear context [] .stackInfo =
  context [] .openBlocks  list.clear context [] .openBlocks =
  context [] .typeBuffer  list.clear context [] .typeBuffer =
  context [] .labelBuffer list.clear context [] .labelBuffer =
  context [] .stack       list.clear context [] .stack =
end

proc(
  InterpreterContext ptr mut : context
=> ) =: public cleanupContext
  context [] .variables @ map.free
  context [] .stackInfo   list.free context [] .stackInfo =
  context [] .openBlocks  list.free context [] .openBlocks =
  context [] .typeBuffer  list.free context [] .typeBuffer =
  context [] .labelBuffer list.free context [] .labelBuffer =
  context [] .stack list.free context [] .stack =
end
