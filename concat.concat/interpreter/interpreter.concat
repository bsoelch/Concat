import map

import "interpreter/operators.concat"
import "identifiers.concat"
import "program.concat"

struct(
  Type : valueType
  LabelId : valueId
  LabelId : mut valueName
  FilePosition : mut pushedAt
) =:: export ValueInfo

struct(
  ConstValue : value
  ValueInfo  : info
) =:: Constant

struct(
  BlockType : blockType
  i64 : stackOffset
) =:: BlockInfo

struct(
  ProgramContext ptr mut : program
  LabelId Constant hashMap : mut variables
  ConstValue list : mut stack
  ValueInfo  list : mut stackInfo
  BlockInfo  list : mut openBlocks
  Type list : mut typeBuffer
  LabelId list : mut labelBuffer
  FileId : mut currentFile
) =:: export InterpreterContext

proc( i64 : count InterpreterContext ptr mut : context -> bool ) =>: checkStack
  context [] .openBlocks .length 0 > if
    context [] .openBlocks context [] .openBlocks .length 1 - list.at .data [] .stackOffset
  else 0i64 end =:: offset
  context [] .stack .length offset - count <
end
proc( InterpreterContext ptr mut : context -> i64 ) =>: minStackOffset
  context [] .openBlocks .length 0 > if
    context [] .openBlocks
      context [] .openBlocks .length 1 - list.at .data []
    .stackOffset return
  end
  0 return
end

proc( InterpreterContext ptr mut : context -> bool ) =>: inEnum
  ## XXX cache number of open enum blocks
  context [] .openBlocks .length 1 - while ..dup 0 >= do
    context [] .openBlocks ..over list.at .data [] .blockType .TYPE_ENUM ?? if ..drop
      true return
    end
    1 -
  end ..drop
  false return
end
proc( InterpreterContext ptr mut : context -> bool ) =>: inTypeOrInitializer
  ## XXX cache/precompute result
  context [] .openBlocks .length 1 - while ..dup 0 >= do
    context [] .openBlocks ..over list.at .data [] .blockType switch
      INITIALIZER TYPE_TUPLE TYPE_STRUCT TYPE_ENUM TYPE_UNION
       TYPE_PROC_IN TYPE_PROC_OUT TYPE_COMPOSITE case
         ..drop true return
      PROCEDURE EXPERIMENTAL_PROCEDURE case
        ..drop false return
      UNKNOWN IF IFIF ELSE WHILE DO BREAK CONTINUE
       SWITCH BREAK_SWITCH CASE DEFAULT NAMESPACE case break
    end
    1 -
  end ..drop
  false return
end
proc( InterpreterContext ptr mut : context -> bool ) =>: inInitializer
  ## XXX cache/precompute result
  context [] .openBlocks .length 1 - while ..dup 0 >= do
    context [] .openBlocks ..over list.at .data [] .blockType switch
      INITIALIZER case
         ..drop true return
      TYPE_TUPLE TYPE_STRUCT TYPE_ENUM TYPE_UNION
       TYPE_PROC_IN TYPE_PROC_OUT TYPE_COMPOSITE
       PROCEDURE EXPERIMENTAL_PROCEDURE case
         ..drop false return
      UNKNOWN IF IFIF ELSE WHILE DO BREAK CONTINUE
       SWITCH BREAK_SWITCH CASE DEFAULT NAMESPACE case break
    end
    1 -
  end ..drop
  false return
end

proc( BlockType : blockType InterpreterContext ptr mut : context -> ) =>: openBlock
  context [] .openBlocks
    ## BlockInfo
      blockType
      context [] .stack .length ## XXX add possibility to inherit offset from outer block
    BlockInfo new list.append
  context [] .openBlocks =
end

proc(
  Operation ptr : op
  BlockInfo ptr : closedBlock
  bool : createDummyLables
  bool : forceLabel
  InterpreterContext ptr mut : context
-> bool ) =>: closedTypeBlock
  context [] .program [] .errors @ =:: errors
  context [] .program [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  closedBlock [] .stackOffset =:: offset
  context [] .stack .length offset - =:: elementCount
  context [] .typeBuffer
    list.clear
    elementCount list.ensureCap
  context [] .typeBuffer =
  context [] .labelBuffer
    list.clear
    elementCount list.ensureCap
  context [] .labelBuffer =
  false =:: mut error
  0 while ..dup elementCount < do
    context [] .stack
      ..over offset +
    list.at .data =:: stackValue
    context [] .stackInfo
      ..over offset +
    list.at .data =:: stackInfo
    stackInfo [] .valueType types.primitive.TYPE types.typeEquals ! if
      "unsupported type in composite type, expected type got " sb.wrap
        stackInfo [] .valueType typeContext sb.appendType
      stackInfo [] .pushedAt errors appendError
      true error =
      1 + continue
    end
    context [] .typeBuffer
      stackValue [] .typeId list.append
    context [] .typeBuffer =
    stackInfo [] .valueName id.LABEL_ID_NONE == if
      forceLabel if
        "missing label for composite element" sb.wrap
        stackInfo [] .pushedAt errors appendError
        true error =
      end
      createDummyLables if
        ## newDummyLabel
          ..dup
          stackInfo [] .pushedAt
          -1 ## TODO resolve current file
          labelContext
        id.newDummyLabel stackInfo [] .valueName =
      end
    end
    ## types are always static
    stackValue [] .typeId types.primitive.TYPE types.typeEquals if
      stackInfo [] .valueName id.FLAG_STATIC labelContext id.addLabelFlags
    end
    context [] .labelBuffer
      stackInfo [] .valueName list.append
    context [] .labelBuffer =
    1 +
  end ..drop
  context [] .stack
    offset list.setLength
  context [] .stack =
  context [] .stackInfo
    offset list.setLength
  context [] .stackInfo =
  error return
end


proc(
  Operation ptr : op
  BlockInfo ptr : closedBlock
  InterpreterContext ptr mut : context
->
  ConstValue arrayView
  Type
  bool
) =>: closedInitializer
  context [] .program [] .errors @ =:: errors
  context [] .program [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  closedBlock [] .stackOffset =:: offset
  context [] .stack .length offset - =:: elementCount
  context [] .typeBuffer
    list.clear
    elementCount list.ensureCap
  context [] .typeBuffer =
  context [] .labelBuffer
    list.clear
    elementCount list.ensureCap
  context [] .labelBuffer =
  Type .undefined =:: mut arrayType
  true =:: mut hasArrayType
  false =:: mut hasName
  false =:: mut error
  0 while ..dup elementCount < do
    context [] .stack
      ..over offset +
    list.at .data =:: stackValue
    context [] .stackInfo
      ..over offset +
    list.at .data =:: stackInfo
    context [] .typeBuffer
      stackInfo [] .valueType list.append
    context [] .typeBuffer =
    context [] .labelBuffer
      stackInfo [] .valueName list.append
    context [] .labelBuffer =
    stackInfo [] .valueName id.LABEL_ID_NONE != if
      true hasName =
      ## if there is a labeled element the initializer is not an array
      false hasArrayType =
      Type .undefined arrayType =
    end
    hasArrayType if
      arrayType Type .undefined types.typeEquals if ## XXX compute common super-type if possible
       stackInfo [] .valueType arrayType =
      else arrayType stackInfo [] .valueType types.typeEquals ! _if
        false hasArrayType =
        Type .undefined arrayType =
      end
    end
    1 +
  end ..drop
  context [] .stack list.asArray offset array.tail =:: values
  context [] .stack
    offset list.setLength
  context [] .stack =
  context [] .stackInfo
    offset list.setLength
  context [] .stackInfo =
  values arrayType error return
end

proc(
  ConstValue : value
  Type : valType
  LabelId : id
  FilePosition : pos
  InterpreterContext ptr mut : context
-> ) =>: pushValue
  context [] .stack
    value list.append
  context [] .stack =
  context [] .stackInfo
    ## ValueInfo
      valType
      id
      id.LABEL_ID_NONE
      pos
    ValueInfo new list.append
  context [] .stackInfo =
end
proc(
  bool : showErrorMessages
  FilePosition : pos
  InterpreterContext ptr mut : context
-> ValueInfo ConstValue bool ) =>: popValue
  context [] .stack .length 0 == if
    showErrorMessages if
      "stack underflow " sb.wrap
      pos context [] .program [] .errors @ appendError
    end
    ## return
      ## ValueInfo
        Type .undefined
        -1 -1
        pos
      ValueInfo new
      ConstValue .none
    true return
  end
  context [] .stack
    list.pop =:: value
  context [] .stack =
  context [] .stackInfo
    list.pop =:: valInfo
  context [] .stackInfo =
  valInfo value false return
end
proc(
  ConstValue : value
  ValueInfo : valInfo
  InterpreterContext ptr mut : context
->  ) =>: unpopValue
  context [] .stack
     value list.append
  context [] .stack =
  context [] .stackInfo
    valInfo list.append
  context [] .stackInfo =
end

proc(
  bool : showErrorMessages
  FilePosition : pos
  InterpreterContext ptr mut : context
-> ValueInfo Type bool ) =>: popType
  context [] .program [] .errors @ =:: errors
  context [] .program =:: program
  context [] .program [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  ## popValue
    showErrorMessages
    pos
  context popValue =:: isError =:: value =:: valInfo
  isError if
    valInfo Type .undefined true return
  end
  value .typeId ?? if
    valInfo value .typeId false return
  end
  "expected type got: " sb.wrap
    valInfo .valueType typeContext sb.appendType
    " ( " sb.appendS
    value constContext typeContext sb.appendConstant
    " )" sb.appendS
  pos errors appendError
  ## restore stack
  value valInfo context unpopValue
  valInfo Type .undefined true return
end

## TODO use wrapper procedures for stack access

namespace: interpreter
  proc(
    Type : t
    TypeMemoryInfo : infoType
    bool : showErrors
    ProgramContext ptr mut : program
  -> ConstValue bool ) =>: export computeTypeInfo
    program [] .errors @ =:: errors
    program [] .idContext @ =:: idContext
    idContext [] .constContext @ =:: constContext
    idContext [] .typeContext @ =:: typeContext
    typeContext [] .labelContext @ =:: labelContext
    t typeContext types.containsGeneric | if
      0 ConstValue .int true return
    end
    infoType switch
      ALIGNMENT case
        t typeContext types.alignOf
        break
      SIZE case
        t typeContext types.sizeOf
        break
      STRIDE case
        t typeContext types.strideOf
        break
    end
    ConstValue .int false return
  end
  proc(
    LabelId : generatorName
    ProcId : generatorProc
    ConstValue arrayView : args
    FilePosition : pos
    InterpreterContext ptr mut : context
  -> bool ) =>: evalGeneratedType
    context [] .program =:: program
    program [] .errors @ =:: errors
    program [] .idContext @ =:: idContext
    idContext [] .constContext @ =:: constContext
    idContext [] .typeContext @ =:: typeContext
    typeContext [] .labelContext @ =:: labelContext
    generatorProc pos context evaluateCall if
      "could not initialize type-generator " sb.wrap
        generatorName labelContext sb.appendLabelName
      pos errors appendError
      true return
    end
    ## initializeGeneratedType
      generatorName
      args
      context [] .stack list.peek .data [] .typeId ## return value of call
      typeContext
      constContext
    types.initializeGeneratedType if
      "could not initialize type-generator " sb.wrap
        generatorName labelContext sb.appendLabelName
      pos errors appendError
      true return
    end
    false return
  end
  proc(
    LabelId : generatorName
    ConstValue arrayView : args
    FilePosition : pos
    ProgramContext ptr mut : program
  -> bool ) =>: export initializeGeneratedType
    program [] .errors @ =:: errors
    program [] .idContext @ =:: idContext
    idContext [] .constContext @ =:: constContext
    idContext [] .typeContext @ =:: typeContext
    typeContext [] .labelContext @ =:: labelContext
    generatorName idContext id.getIdentifier if ..drop
      "could not find procedure " sb.wrap
        generatorName labelContext sb.appendLabelName
      pos errors appendError
      true return
    end =:: idData
    idData [] .idType .PROCEDURE ?? ! if
      "expected procedure got: " sb.wrap
        idData id.asIdInfo labelContext sb.appendIdInfo
      pos errors appendError
      true return
    end
    idData [] .constValue .procedure =:: procId
    program [] .procedures
      procId list.at .data
    =:: procData
    procData [] .procType =:: procType
    procType typeContext types.getProcIn ..drop =:: inType
    inType typeContext types.compositeElts =:: inTypes
    program procData [] .fileId wrapProgram =:: mut context
      ## push arguments
      0 while ..dup inTypes .length < do =:: i
        inTypes i types.compositeElts.get =:: argType
        args i array.get =:: argValue
        argValue argType -1 pos context @ pushValue
        i 1 +
      end ..drop
      ## evalGeneratedType
        generatorName
        procId
        args
        pos
        context @
      evalGeneratedType
    context @ cleanupContext
    return
  end
end

proc(
  Operation ptr : op
  InterpreterContext ptr mut : context
  bool : showErrorMessages ## TODO distinguish non-interpretable operations and errors
->
  bool
) =>: export evaluateOperation
  using interpreter
  context [] .program [] .errors @ =:: errors
  context [] .program =:: program
  context [] .program [] .idContext @ =:: idContext
  idContext [] .constContext @ =:: constContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  op [] .val switch
    NOP case
      false return
    Constant case
      ## pushValue
        op [] .val .Constant
        op [] .dataType
        id.LABEL_ID_NONE ## XXX? remember id in op-type
        op [] .pos
      context pushValue
      false return
    Return case
      context [] .openBlocks .length 1 - while ..dup 0 >= do
        context [] .openBlocks ..over list.at .data [] .blockType
         ..dup .PROCEDURE ?? ..swap .EXPERIMENTAL_PROCEDURE ?? | if
          ## close procedure block
          context [] .openBlocks
            ..swap list.setLength
          context [] .openBlocks =
          false return
        end
        1 -
      end ..drop
      showErrorMessages if
        "return outside procedure" sb.wrap op [] .pos errors appendError
      end
      true return
    block case
      op [] .val .block .blockType switch
        TYPE_TUPLE
        TYPE_STRUCT
        TYPE_ENUM
        TYPE_UNION
        TYPE_PROC_IN
        TYPE_PROC_OUT
        TYPE_COMPOSITE
        INITIALIZER case
          op [] .val .block .blockType context openBlock
          false return
        PROCEDURE
        EXPERIMENTAL_PROCEDURE
        IF
        IFIF
        ELSE
        WHILE
        DO
        BREAK
        CONTINUE
        SWITCH
        BREAK_SWITCH
        CASE
        DEFAULT
        UNKNOWN
        NAMESPACE case
          showErrorMessages if
            "unsupported block-type in constant evaluation: " sb.wrap
              op [] .val .block .blockType sb.appendBlockType
            op [] .pos errors appendError
          end
          true return
      end
      break
    blockEnd case
      op [] .val .blockEnd .blockType =:: blockType
      context [] .openBlocks .length 0 == if
        showErrorMessages if
          "unexpected end of " sb.wrap
           blockType sb.appendBlockType
           "-block" sb.appendS
          op [] .pos errors appendError
        end
        true return
      end
      context [] .openBlocks
        list.pop =:: closedBlock ## XXX avoid copying blockInfo into local variable
      context [] .openBlocks =
      closedBlock .blockType blockType != if
        showErrorMessages if
          "unexpected end of " sb.wrap
           blockType sb.appendBlockType
           "-block expected " sb.appendS
           closedBlock .blockType sb.appendBlockType
          op [] .pos errors appendError
        end
        true return
      end
      blockType switch
        TYPE_TUPLE TYPE_STRUCT TYPE_COMPOSITE case
          op closedBlock @ true false context closedTypeBlock if true return end
          blockType .TYPE_COMPOSITE ?? if
              context [] .typeBuffer .length 0 == _if
            Type .empty
          else
            ## newTuple
              context [] .typeBuffer list.asArray
              context [] .labelBuffer list.asArray optional.wrap
            typeContext types.newTuple if ..drop
              "could not create structure-type" sb.wrap op [] .pos errors appendError
              true return
            end
          end =:: tupleType
          ## pushValue
            tupleType ConstValue .typeId
            types.primitive.TYPE
            id.LABEL_ID_NONE
            op [] .pos
          context pushValue
          false return
        TYPE_ENUM case
          op closedBlock @ false true context closedTypeBlock if true return end
          ## newEnum
            context [] .typeBuffer list.asArray
            context [] .labelBuffer list.asArray optional.wrap
          typeContext types.newEnum if ..drop
            "could not create enum" sb.wrap op [] .pos errors appendError
            true return
          end =:: enumType
          ## pushValue
            enumType ConstValue .typeId
            types.primitive.TYPE
            id.LABEL_ID_NONE
            op [] .pos
          context pushValue
          false return
        TYPE_UNION case
          op closedBlock @ false true context closedTypeBlock if true return end
          ## newUnion
            context [] .typeBuffer list.asArray
            context [] .labelBuffer list.asArray optional.wrap
          typeContext types.newUnion if ..drop
            "could not create union-type" sb.wrap op [] .pos errors appendError
            true return
          end =:: unionType
          ## pushValue
            unionType ConstValue .typeId
            types.primitive.TYPE
            id.LABEL_ID_NONE
            op [] .pos
          context pushValue
          false return
        TYPE_PROC_IN case
          ## TODO? distinguish tuple and proc in parser
          ##  -> removes need to create labels for procIn
          op closedBlock @
            false
            false
          context closedTypeBlock if true return end
          context [] .typeBuffer .length 1 >= if
              ## last argument is procedure output
              context [] .typeBuffer
                ..dup .length 1 -
              list.get .procOut ?? ! _if
            "missing return type for procedure" sb.wrap op [] .pos errors appendError
            true return
          end
          context [] .typeBuffer .length
            1 - ## last value is return type
          =:: nArgs
          ## newProcArgs
            context [] .typeBuffer list.asArray nArgs array.head
            context [] .labelBuffer list.asArray nArgs array.head optional.wrap
            false
          typeContext types.newProcArgs =:: procIn
          context [] .typeBuffer nArgs list.get =:: procOut
          procIn procOut CallingConvention.DEFAULT typeContext types.newProcedure if ..drop
            "could not create procedure-type" sb.wrap op [] .pos errors appendError
            true return
          end =:: newType
          ## pushValue
            newType ConstValue .typeId
            types.primitive.TYPE
            id.LABEL_ID_NONE
            op [] .pos
          context pushValue
          false return
        TYPE_PROC_OUT case
          op closedBlock @ false false context closedTypeBlock if true return end
          ## newProcArgs
            context [] .typeBuffer list.asArray
            context [] .labelBuffer list.asArray optional.wrap
            true
          typeContext types.newProcArgs =:: procOut
          ## pushValue
            procOut ConstValue .typeId
            types.primitive.TYPE
            id.LABEL_ID_NONE
            op [] .pos
          context pushValue
          false return
        PROCEDURE EXPERIMENTAL_PROCEDURE case
          ## end procedure
          false return
        INITIALIZER case
          op closedBlock @ context closedInitializer if
            ..drop.2 true return
          end =:: arrayType =:: values
          ## newArrayConst
            values
            idContext [] .constContext @
          newArrayConst =:: value
          arrayType Type .undefined types.typeEquals if
            context [] .typeBuffer .length 0 == if
              Type .empty
            else
              ## newTuple
                context [] .typeBuffer list.asArray
                context [] .labelBuffer list.asArray optional.wrap
                typeContext
              types.newTuple if
                "could not create type of structure-constant" sb.wrap
                op [] .pos errors appendError
              end
            end
          else ## TODO array of arrays -> 2D array
            ## ArraySize
              values .length
              types.ArraySizeType .int
            types.ArraySize new =:: mSize
            arrayType
             false
             mSize @ array.wrap
             true
             false
            typeContext types.newArrayType if
              "could not create type of array-constant " sb.wrap
              op [] .pos errors appendError
            end
          end =:: mType
          ## pushValue
            value
            mType
            id.LABEL_ID_NONE
            op [] .pos
          context pushValue
          false return
        IF
        IFIF
        ELSE
        WHILE
        DO
        BREAK
        BREAK_SWITCH
        CONTINUE
        SWITCH
        CASE
        DEFAULT
        UNKNOWN
        NAMESPACE case
          showErrorMessages if
            "unsupported block-end in constant evaluation: " sb.wrap
              op [] .val .blockEnd .blockType sb.appendBlockType
            op [] .pos errors appendError
          end
          true return
      end
      break
    declareId case
      context inTypeOrInitializer ! if
        showErrorMessages if
          "interpreting declarations is currently only supported in type-blocks and initializers " sb.wrap
          op [] .pos errors appendError
        end
        true return
      end
      1 context checkStack if
        showErrorMessages if
          "not enough arguments for declaration, expected 1 got 0" sb.wrap
          op [] .pos errors appendError
        end
        true return
      end
      context [] .stackInfo list.peek .data =:: valInfo
      context inInitializer ! if
        valInfo [] .valueType types.primitive.TYPE types.typeEquals ! if
          "wrong argument type for declaration expected type got " sb.wrap
            valInfo [] .valueType typeContext sb.appendType
          op [] .pos errors appendError
          true return
        end
      end
      context [] .stack list.peek .data =:: value
      value [] .typeId =:: valType
      valType
        typeContext types.unwrapNamed
      types.primitive.TYPE types.typeEquals =:: isType
      op [] .val .declareId .labelId =:: labelId
      labelId valInfo [] .valueName =
      ## map.put
        context [] .variables @
        labelId
        ## Constant
          isType if
            labelId types.newGenericType ConstValue .typeId
          else
            labelId ConstValue .genericArg
          end
          ## ValueInfo
            valType
            labelId
            labelId
            valInfo [] .pushedAt
          ValueInfo new
        Constant new
      map.put ..drop
      false return
    getName case
      context inEnum if
        context [] .stack
          Type .empty ConstValue .typeId list.append
        context [] .stack =
        context [] .stackInfo
          ## ValueInfo
            types.primitive.TYPE
            id.LABEL_ID_NONE
            op [] .val .getName
            op [] .pos
          ValueInfo new list.append
        context [] .stackInfo =
        false return
      end
      showErrorMessages if
        "unsupported operation in constant evaluation: " sb.wrap
          op [] program sb.appendOp
        op [] .pos errors appendError
      end
      true return
    getId case
      op [] .val .getId @ =:: idInfo
      idInfo [] .labelId =:: label
      idInfo [] .idType switch
        PROCEDURE case
          idInfo [] .constValue .procedure ?? ! if
            "unexpected value for procedure constant: " sb.wrap
              idInfo [] .constValue
                constContext
                typeContext
              sb.appendConstant
            op [] .pos errors appendError
            true return
          end
          idInfo [] .constValue .procedure =:: procId
          program [] .procedures procId list.at .data =:: procData
          procData [] .isStatic ! if
            true return ## only evaluate static procedures in interpreter
          end
          ## static procedure -> no call resolving necessary
          op [] .dataType typeContext types.getProcOut ..drop =:: procOut
          procOut typeContext types.compositeElts =:: outTypes
          outTypes .length 1 == if outTypes 0 types.compositeElts.get types.primitive.TYPE types.typeEquals _if
            ## type-generator (procedure returning type)
            op [] .dataType typeContext types.getProcIn ..drop =:: procIn
            procIn typeContext types.compositeElts =:: inTypes
            inTypes .length context checkStack if
              "not enough arguments for type-generator " sb.wrap
                label labelContext sb.appendLabelName
              op [] .pos errors appendError
              true return
            end
            context [] .stack .length inTypes .length - =:: offset
            ## findGeneratedType
              label
              context [] .stack list.asArray offset array.tail
              typeContext
              constContext
            types.findGeneratedType if ## newType
              idContext [] .templateArgBuffer .length =:: argOffset
              idContext [] .templateArgBuffer
                ## remember procedure arguments
                context [] .stack list.asArray
                  offset
                array.tail list.appendArray
              idContext [] .templateArgBuffer =
              ## evalGeneratedType
                label
                procId
                idContext [] .templateArgBuffer list.asArray
                  argOffset
                array.tail
                op [] .pos
                context
              evalGeneratedType
                idContext [] .templateArgBuffer
                  argOffset list.setLength
                idContext [] .templateArgBuffer =
              if ..drop
                true return
              end
            end =:: generated
            context [] .stack
              offset list.setLength
            context [] .stack =
            context [] .stackInfo
              offset list.setLength
            context [] .stackInfo =
            ## pushValue
              generated ConstValue .typeId
              types.primitive.TYPE
              id.LABEL_ID_NONE
              op [] .pos
              context
            pushValue
            false return
          end
          idInfo [] .constValue .procedure op [] .pos context evaluateCall return
        LOCAL_VAR ARGUMENT LABEL case
          context [] .variables @ label map.get =:: value?
          value? optional.isEmpty if
            showErrorMessages if
              "missing value for " sb.wrap
                op [] .val .getId labelContext sb.appendIdInfo
              op [] .pos errors appendError
            end
            true return
          end
          value? .data =:: value ## TODO? wrap local variable in reference?
          value .value value .info .valueType label op [] .pos context pushValue
          false return
        TYPE GLOBAL_VAR case
          label
            idContext
          id.getIdentifier if ..drop
            "could not find identifier: " sb.wrap
              label labelContext sb.appendLabelName
            op [] .pos errors appendError
            true return ## unknown identifier
          end =:: idData
          idData [] .labelId labelContext id.labelFlags id.FLAG_MUTABLE & ? if
            ## compile-time evaluation of mutable global variables not supported
            true return
          end
          idData [] .constValue .none ?? if
            showErrorMessages idInfo [] .idType .TYPE ?? | if
              "identifier " sb.wrap
                label labelContext sb.appendLabelName
                " has not been initialized" sb.appendS
              op [] .pos errors appendError
            end
            true return
          end
          idData [] .constValue idData [] .valueType label op [] .pos context pushValue
          false return
        TEMPLATE_ARG TMP_VAR PROCEDURE_BUNDLE case
        showErrorMessages if
          "unsupported operation in constant evaluation: " sb.wrap
            op [] program sb.appendOp
          op [] .pos errors appendError
        end
        true return
      end
      break
    typeModifier case
        true =:: mut fixedSize
        context minStackOffset =:: minOffset
        context [] .stack .length 1 - =:: mut offset
        offset minOffset > if context [] .stack offset list.get .wildCard ?? _if
          false fixedSize =
          offset 1 - offset =
        end
        0 =:: mut intArgs
        offset while ..dup minOffset >= do
          context [] .stackInfo ..over list.at .data [] .valueType typeContext types.isInt ! if
            break
          end
          intArgs 1 + intArgs =
          1 -
        end offset =
        idContext [] .arraySizeBuffer
          list.clear
          intArgs list.ensureCap
        idContext [] .arraySizeBuffer =
        1 while ..dup intArgs <= do
          context [] .stack offset ..over.2 + list.get =:: intArg
          intArg .int ?? if
            ## TODO ensure array sizes are positive
            idContext [] .arraySizeBuffer
              ## ArraySize
                intArg .int
                types.ArraySizeType .int
              types.ArraySize new list.append
            idContext [] .arraySizeBuffer =
          else intArg .genericArg ?? _if
            idContext [] .arraySizeBuffer
              ## ArraySize
                intArg .genericArg
                types.ArraySizeType .staticArg
              types.ArraySize new list.append
            idContext [] .arraySizeBuffer =
          else intArg .templateArg ?? _if
            idContext [] .arraySizeBuffer
              ## ArraySize
                intArg .templateArg
                types.ArraySizeType .templateArg
              types.ArraySize new list.append
            idContext [] .arraySizeBuffer =
          else
            "unexpected constant for array size: " sb.wrap
              intArg constContext typeContext sb.appendConstant
            context [] .stackInfo ..over.2 list.at .data [] .pushedAt errors appendError
          end
          1 +
        end ..drop
        offset minOffset < if
          "missing type parameter for type-modifier " sb.wrap
            op [] .val .typeModifier sb.appendTypeModifier
          op [] .pos errors appendError
          true return
        end
        context [] .stack offset list.get =:: typeConstant
        typeConstant .typeId ?? ! if
          "unexpected constant parameter for type-modifier " sb.wrap
            op [] .val .typeModifier sb.appendTypeModifier
            " expected type got " sb.appendS
            typeConstant constContext typeContext sb.appendConstant
          op [] .pos errors appendError
          true return
        end
      op [] .val .typeModifier .ARRAY ?? ! =:: isPtr
      fixedSize ! isPtr ! & if
        "array types must have a fixed size" sb.wrap op [] .pos errors appendError
      end
      ## newArrayType
        typeConstant .typeId
        isPtr
        idContext [] .arraySizeBuffer list.asArray
        fixedSize
        op [] .val .typeModifier .PTR_MUT ??
        typeContext
      types.newArrayType if ..drop
        isPtr if
          "could not create pointer type" sb.wrap op [] .pos errors appendError
        else
          "could not create array type" sb.wrap op [] .pos errors appendError
        end
        true return
      end =:: ptrType
      context [] .stack
        offset list.setLength
      context [] .stack =
      context [] .stackInfo
        offset list.setLength
      context [] .stackInfo =
      ## pushValue
        ptrType ConstValue .typeId
        types.primitive.TYPE
        id.LABEL_ID_NONE
        op [] .pos
        context
      pushValue
      false return
    typeInfo case
      op [] .dataType .undefined ?? if
        showErrorMessages op [] .pos context popType if ..drop.2
          true return
        end =:: poppedType =:: valInfo
        poppedType typeContext types.containsGeneric | if
          ## computing size not possible, reset stack
          ## unpopValue
            poppedType ConstValue .typeId
            valInfo
          context unpopValue
          true return
        end
        poppedType
      else
        op [] .dataType
      end =:: targetType
      ## pushValue
        ## computeTypeInfo
          targetType
          op [] .val .typeInfo
          true ## don't hide errors ( operation modifies stack )
        program computeTypeInfo if ..drop
          true return
        end
        types.primitive.I_SIZE
        id.LABEL_ID_NONE
        op [] .pos
        context
      pushValue
      false return
    Assert case
      showErrorMessages op [] .pos context popValue if
        ..drop.2
        showErrorMessages if
          "missing argument for assert, expected boolean" sb.wrap
          op [] .pos errors appendError
        end
        true return
      end =:: value =:: valInfo
      value .boolean ?? ! if
        "wrong constant value for assert, expected boolean got: " sb.wrap
          value constContext typeContext sb.appendConstant
        op [] .pos errors appendError
        value valInfo context unpopValue
        true return
      end
      value .boolean ! if
        "assertion failed: " sb.wrap
          op [] .val .Assert labelContext sb.appendStringConst
        op [] .pos errors appendError
      end
      false return
    setId atId initializeId autoTypedInitializeId
    getLabel setLabel atLabel
    getElement setElement atElement
    getArrayElement setArrayElement atArrayElement setValue
    Print New newEnum call callPtr call_old
    argc getArg getArgLen implementProcedure procPtr
    length size Cast Cast! autoCast
    unaryOperator binaryOperator
    checkEnumLabel setEnumLabel checkArrayIndex
    hasLabel hasName hasElement
    stackMod setName atName copy builtIn
    compilerInfo unreachable case
      showErrorMessages if
        "unsupported operation in constant evaluation: " sb.wrap
          op [] program sb.appendOp
        op [] .pos errors appendError
      end
      true return
  end
end

proc(
  Operation arrayView : ops
  InterpreterContext ptr mut : context
->
  bool
) =>: export evaluateOperations
  0 =:: mut offset
  context [] .openBlocks .length 1 - while ..dup 0 >= do
    context [] .openBlocks ..over list.at .data [] .blockType
     ..dup .PROCEDURE ?? ..swap .EXPERIMENTAL_PROCEDURE ?? | if
      break
    end
    1 -
  end =:: procBlockIndex
  while offset ops .length < do
    ops offset array.at .data =:: op
      op context true evaluateOperation if
        true return
      end
      context [] .openBlocks .length procBlockIndex < if
        false return ## break evaluation when leaving procedure block
      end
    offset 1 + offset =
  end
  ## XXX error if unwanted open blocks
  false return
end
#+evaluate procedure body with the given arguments+#
proc(
  ProcId : procId
  FilePosition : pos
  InterpreterContext ptr mut : context
->
  bool
) =>: export evaluateCall
  context [] .program [] .errors @ =:: errors
  context [] .program =:: program
  context [] .program [] .idContext @ =:: idContext
  idContext [] .typeContext @ =:: typeContext
  typeContext [] .labelContext @ =:: labelContext
  program [] .procedures procId list.at .data =:: procData
  procData [] .procType =:: procType
  procType typeContext types.getProcIn ..drop =:: inType
  inType typeContext types.compositeElts =:: args
  args .length context checkStack if
    "not enough arguments for procedure " sb.wrap
      ## TODO print procedure label
    pos errors appendError
    true return
  end
  context [] .stack .length args .length - =:: argsOffset
  procData [] .implementation .builtIn ?? if
    "interpreting built-in procs is not implemented" sb.wrap
    pos errors appendError
    true return
  end
  ## XXX resolve signature
  ## TODO check argument types
  ## TODO interpreter modes depending on program state
  program [] .templateOps ## -> procedures are stored in template ops until they are type-checked
  ## program [] .progFiles procData [] .fileId list.at .data [] .localOps
    procData [] .implementation .code .codeStart
    procData [] .implementation .code .codeLength
  list.slice =:: code
  code 0 array.at .data =:: op
  op [] .val .initializeId ?? ! if true else
    op [] .val .initializeId .idType .PROCEDURE ?? !
  end if
    "expected procedure initialization got " sb.wrap
      op [] program sb.appendOp
    op [] .pos errors appendError
    true return ## not a call
  end
  context [] .stack .length =:: stackOffset
  ## process procedure arguments
  0 while ..dup args .length < do
    context [] .stack ..over argsOffset + list.at .data =:: value
    context [] .stackInfo ..over argsOffset + list.at .data =:: valueInfo
    inType ..over typeContext types.compositeGetLabel =:: label
    label id.LABEL_ID_NONE != if ## store argument as value
     label labelContext id.labelFlags id.FLAG_DUMMY & ? ! _if
      context [] .variables @
        label
        ## Constant
          value []
          valueInfo []
        Constant new
      map.put ..drop
    else ## push argument
      context [] .stack
        value list.appendP
      context [] .stack =
      context [] .stackInfo
        ## ValueInfo
          valueInfo [] .valueType
          id.LABEL_ID_NONE
          id.LABEL_ID_NONE
          pos
        ValueInfo new list.append
      context [] .stackInfo =
    end
    1 +
  end ..drop
  context [] .currentFile =:: oldFile
  procData [] .fileId context [] .currentFile =
  BlockType .PROCEDURE context openBlock
  ## evaluateOperations
    code 1 array.tail ## first operation declares procedure
    context
  evaluateOperations if
    context [] .stack
      stackOffset list.setLength
    context [] .stack =
    context [] .stackInfo
      stackOffset list.setLength
    context [] .stackInfo =
    true return
  else
    oldFile context [] .currentFile =
    context [] .stack .length stackOffset - =:: nReturn
    ## mem.copy
      context [] .stack .data argsOffset +
      context [] .stack .data stackOffset +
      nReturn
    mem.copy ..drop
    ## mem.copy
      context [] .stackInfo .data argsOffset +
      context [] .stackInfo .data stackOffset +
      nReturn
    mem.copy ..drop
    context [] .stack
      argsOffset nReturn + list.setLength
    context [] .stack =
    context [] .stackInfo
      argsOffset nReturn + list.setLength
    context [] .stackInfo =
    argsOffset while ..dup context [] .stackInfo .length < do
      ## update push position of return values
      pos context [] .stackInfo ..over.2 list.at .data [] .pushedAt =
      1 +
    end ..drop
    false return
  end
end

proc(
  ProgramContext ptr mut : progContext
  FileId : fileId
->
  InterpreterContext
) =>: export wrapProgram
  ## InterpreterContext
    progContext
    labelHash @ labelEq @ 32 Constant map.create
    64 ConstValue list.create
    64 ValueInfo  list.create
    64 BlockInfo  list.create
    64 Type       list.create
    64 LabelId    list.create
    fileId
  InterpreterContext new
end

proc(
  InterpreterContext ptr mut : context
-> ) =>: export resetContext
  ## TODO? clear local variables in map
  context [] .stackInfo   list.clear context [] .stackInfo =
  context [] .openBlocks  list.clear context [] .openBlocks =
  context [] .typeBuffer  list.clear context [] .typeBuffer =
  context [] .labelBuffer list.clear context [] .labelBuffer =
  context [] .stack       list.clear context [] .stack =
end

proc(
  InterpreterContext ptr mut : context
-> ) =>: export cleanupContext
  context [] .variables @ map.free
  context [] .stackInfo   list.free context [] .stackInfo =
  context [] .openBlocks  list.free context [] .openBlocks =
  context [] .typeBuffer  list.free context [] .typeBuffer =
  context [] .labelBuffer list.free context [] .labelBuffer =
  context [] .stack list.free context [] .stack =
end
