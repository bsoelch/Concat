      | ConstValue .int new opType #swap e1 e2 | return
    BOOL case
      a err pos constAsBool =:: e1
      b err pos constAsBool =:: e2
      | ConstValue .boolean new opType #swap e1 e2 | return
    FLOAT32 FLOAT64 TYPE case
