import "constants.concat"
import "builtIns.concat"

namespace: interpreter
  proc( ConstValue : a -> bool bool ) =>: export: constAsBool
    ConstValue ..length 23 == "no new constants" assert
    a switch
      Bool case a .Bool false return
      default false true return
    end
  end
  proc( ConstValue : a -> i64 bool ) =>: export: constAsInt ## all integer calculations are done in 64 bits
    ConstValue ..length 23 == "no new constants" assert
    a switch
      Char case a .Char i64 cast.u false return
      Int case a .Int i64 cast false return
      default 0:i64 true return
    end
  end
  proc( ConstValue : a -> f64 bool ) =>: export: constAsFloat
    ConstValue ..length 23 == "no new constants" assert
    a switch
      Char case a .Char i32 cast.u f64 cast false return
      Int case a .Int f64 cast false return
      Float case a .Float f64 cast false return
      default 0 f64 cast true return
    end
  end
  proc( ConstValue : a -> Type bool ) =>: export: constAsType
    ConstValue ..length 23 == "no new constants" assert
    a switch
      TypeId case a .TypeId false return
      default Type .undefined true return
    end
  end

  enum( success argumentError unimplemented ) =:: export: OperatorResult
  proc(
    ConstValue _ ptr : args
    i32 : k
    ( bool -> bool ) ptr : op
  -> ConstValue OperatorResult ) =>: unaryOperatorBool
    k 1 != if ConstValue .None OperatorResult .argumentError return end
    args 0 [] constAsBool if ..drop
      ConstValue .None OperatorResult .argumentError return
    end =:: a
    a op () ConstValue .Bool OperatorResult .success return
  end
  proc(
    ConstValue _ ptr : args
    i32 : k
    type : T
  -> ConstValue OperatorResult ) =>: unaryOperatorToBool
    k 1 != if ConstValue .None OperatorResult .argumentError return end
    args 0 [] =:: a
    ConstValue ..length 23 == "no new constants" assert
    a switch
      Bool case a OperatorResult .success return
      Char case a .Char i8 cast ? ConstValue .Bool OperatorResult .success return
      Int case a .Int T cast ? ConstValue .Bool OperatorResult .success return
      Float case a .Float T cast ? ConstValue .Bool OperatorResult .success return
      default
        ConstValue .None OperatorResult .argumentError return
    end
  end
  proc(
    type : auto: T
    ConstValue _ ptr : args
    i32 : k
    ( T -> T ) ptr : op
  -> ConstValue OperatorResult ) =>: unaryOperatorInt
    k 1 != if ConstValue .None OperatorResult .argumentError return end
    args 0 [] constAsInt if ..drop
      ConstValue .None OperatorResult .argumentError return
    end T cast =:: n
    n op () i64 cast ConstValue .Int OperatorResult .success return
  end
  proc(
    type : auto: T
    ConstValue _ ptr : args
    i32 : k
    ( T -> T ) ptr : op
  -> ConstValue OperatorResult ) =>: unaryOperatorFloat
    k 1 != if ConstValue .None OperatorResult .argumentError return end
    args 0 [] constAsFloat if ..drop
      ConstValue .None OperatorResult .argumentError return
    end T cast =:: n
    n op () f64 cast ConstValue .Float OperatorResult .success return
  end

  proc(
    ConstValue _ ptr : args
    i32 : k
    ( bool bool -> bool ) ptr : op
  -> ConstValue OperatorResult ) =>: binaryOperatorBool
    k 2 != if ConstValue .None  OperatorResult .argumentError return end
    args 0 [] constAsBool  if ..drop
      ConstValue .None OperatorResult .argumentError return
    end =:: a
    args 1 [] constAsBool  if ..drop
      ConstValue .None OperatorResult .argumentError return
    end =:: b
    a b op () ConstValue .Bool OperatorResult .success return
  end

  proc(
    type : auto: T
    ConstValue _ ptr : args
    i32 : k
    ( T T -> T ) ptr : op
  -> ConstValue OperatorResult ) =>: binaryOperatorInt
    k 2 != if ConstValue .None  OperatorResult .argumentError return end
    args 0 [] constAsInt if ..drop
      ConstValue .None OperatorResult .argumentError return
    end T cast =:: n
    args 1 [] constAsInt if ..drop
      ConstValue .None OperatorResult .argumentError return
    end T cast =:: m
    n m op () i64 cast ConstValue .Int OperatorResult .success return
  end
  proc(
    type : auto: T
    ConstValue _ ptr : args
    i32 : k
    ( T T -> T ) ptr : op
  -> ConstValue OperatorResult ) =>: binaryOperatorFloat
    k 2 != if ConstValue .None  OperatorResult .argumentError return end
    args 0 [] constAsFloat if ..drop
      ConstValue .None OperatorResult .argumentError return
    end T cast =:: x
    args 1 [] constAsFloat if ..drop
      ConstValue .None OperatorResult .argumentError return
    end T cast =:: y
    x y op () f64 cast ConstValue .Float OperatorResult .success return
  end
  proc(
    type : auto: T
    ConstValue _ ptr : args
    i32 : k
    ( T T -> bool ) ptr : op
  -> ConstValue OperatorResult ) =>: cmpOperatorInt
    k 2 != if ConstValue .None  OperatorResult .argumentError return end
    args 0 [] constAsInt if ..drop
      ConstValue .None OperatorResult .argumentError return
    end T cast =:: n
    args 1 [] constAsInt if ..drop
      ConstValue .None OperatorResult .argumentError return
    end T cast =:: m
    n m op () ConstValue .Bool OperatorResult .success return
  end
  proc(
    type : auto: T
    ConstValue _ ptr : args
    i32 : k
    ( T T -> bool ) ptr : op
  -> ConstValue OperatorResult ) =>: cmpOperatorFloat
    k 2 != if ConstValue .None  OperatorResult .argumentError return end
    args 0 [] constAsFloat if ..drop
      ConstValue .None OperatorResult .argumentError return
    end T cast =:: x
    args 1 [] constAsFloat if ..drop
      ConstValue .None OperatorResult .argumentError return
    end T cast =:: y
    x y op () ConstValue .Bool OperatorResult .success return
  end

  ## XXX? do I need differnet handling for i64i32 operations
  proc(
    BuiltIn : builtIn
    Type : inType
    ConstValue _ ptr : args
    i32 : k
    FilePosition : pos
    TypeContext ptr.mut : typeContext
    CompilerError list ptr.mut : errors
  -> ConstValue OperatorResult ) =>: export: evaluateBuiltIn
    builtIn switch
      NEG_I8 NEG_I16 NEG_I32 NEG_I64 case
         args k i64.neg@ unaryOperatorInt return
      NEG_F32 case args k f32.neg@ unaryOperatorFloat return
      NEG_F64 case args k f64.neg@ unaryOperatorFloat return
      ADD_I8 ADD_I16 ADD_I32 ADD_I64 case
        args k i64.add@ binaryOperatorInt return
      ADD_F32 case args k f32.add@ binaryOperatorFloat return
      ADD_F64 case args k f64.add@ binaryOperatorFloat return
      SUB_I8 SUB_I16 SUB_I32 SUB_I64 C8_DIFF C16_DIFF C32_DIFF case
        args k i64.sub@ binaryOperatorInt return
      SUB_F32 case args k f32.sub@ binaryOperatorFloat return
      SUB_F64 case  args k f64.sub@ binaryOperatorFloat return
      MUL_I32 MUL_I64 case args k i64.mul@ binaryOperatorInt return
      MUL_F32 case args k f32.mul@ binaryOperatorFloat return
      MUL_F64 case args k f64.mul@ binaryOperatorFloat return
      DIV_I32 case args k i32.div@ binaryOperatorInt return
      DIV_I64I32 DIV_I64 case args k i64.div@ binaryOperatorInt return
      DIV_F32 case args k f32.div@ binaryOperatorFloat return
      DIV_F64 case args k f64.div@ binaryOperatorFloat return
      UDIV_I32 case args k i32.udiv@ binaryOperatorInt return
      UDIV_I64I32 UDIV_I64 case args k i64.udiv@ binaryOperatorInt return
      REM_I32 case args k i32.rem@ binaryOperatorInt return
      REM_I64I32 REM_I64 case args k i64.rem@ binaryOperatorInt return
      UMOD_I32 case args k i32.umod@ binaryOperatorInt return
      UMOD_I64I32 UMOD_I64 case args k i64.umod@ binaryOperatorInt return
      NOT_BOOL case
         args k bool.not@ unaryOperatorBool return
      FLIP_I8 FLIP_I16 FLIP_I32 FLIP_I64 case
         args k i64.flip@ unaryOperatorInt return
      AND_BOOL case args k bool.and@ binaryOperatorBool return
      AND_I8 AND_I16 AND_I32 AND_I64 case
        args k i64.and@ binaryOperatorInt return
      OR_BOOL case args k bool.or@ binaryOperatorBool return
      OR_I8 OR_I16 OR_I32 OR_I64 case
        args k i64.or@ binaryOperatorInt return
      XOR_BOOL case args k bool.xor@ binaryOperatorBool return
      XOR_I8 XOR_I16 XOR_I32 XOR_I64 case
        args k i64.xor@ binaryOperatorInt return
      LSHR_I8 case args k i8.lshr@ binaryOperatorInt return
      LSHR_I16 case args k i16.lshr@ binaryOperatorInt return
      LSHR_I32 case args k i32.lshr@ binaryOperatorInt return
      LSHR_I64I32 LSHR_I64 case args k i64.lshr@ binaryOperatorInt return
      ASHR_I8 case args k i8.ashr@ binaryOperatorInt return
      ASHR_I16 case args k i16.ashr@ binaryOperatorInt return
      ASHR_I32 case args k i32.ashr@ binaryOperatorInt return
      ASHR_I64I32 ASHR_I64 case args k i64.ashr@ binaryOperatorInt return
      SHL_I8 SHL_I16 SHL_I32 SHL_I64I32 SHL_I64 case
        args k i64.shl@ binaryOperatorInt return
      EQ_BOOL case args k bool.eq@ binaryOperatorBool return
      EQ_I8  EQ_C8  case args k i8.eq@ cmpOperatorInt return
      EQ_I16 EQ_C16 case args k i16.eq@ cmpOperatorInt return
      EQ_I32 EQ_C32 case args k i32.eq@ cmpOperatorInt return
      EQ_I64 case
        args k i64.eq@ cmpOperatorInt
          $ .argumentError ?? if ..drop.2
            args 0 [] args 1 [] typeContext pointerEq if ..drop
              ConstValue .None OperatorResult .argumentError return
            end
            ConstValue .Bool OperatorResult .success return
          end
        return
      EQ_F32 case args k f32.eq@ cmpOperatorFloat return
      EQ_F64 case args k f64.eq@ cmpOperatorFloat return
      NE_BOOL case args k bool.ne@ binaryOperatorBool return
      NE_I8  NE_C8  case args k i8.ne@ cmpOperatorInt return
      NE_I16 NE_C16 case args k i16.ne@ cmpOperatorInt return
      NE_I32 NE_C32 case args k i32.ne@ cmpOperatorInt return
      NE_I64 case
        args k i64.ne@ cmpOperatorInt
          $ .argumentError ?? if ..drop.2
            args 0 [] args 1 [] typeContext pointerEq if ..drop
              ConstValue .None OperatorResult .argumentError return
            end
            ! ConstValue .Bool OperatorResult .success return
          end
        return
      NE_F32 case args k f32.ne@ cmpOperatorFloat return
      NE_F64 case args k f64.ne@ cmpOperatorFloat return
      LT_I8 case args k i8.lt@ cmpOperatorInt return
      LT_I16 case args k i16.lt@ cmpOperatorInt return
      LT_I32 case args k i32.lt@ cmpOperatorInt return
      LT_I64 case args k i64.lt@ cmpOperatorInt return
      LT_F32 case args k f32.lt@ cmpOperatorFloat return
      LT_F64 case args k f64.lt@ cmpOperatorFloat return
      LE_I8 case args k i8.le@ cmpOperatorInt return
      LE_I16 case args k i16.le@ cmpOperatorInt return
      LE_I32 case args k i32.le@ cmpOperatorInt return
      LE_I64 case args k i64.le@ cmpOperatorInt return
      LE_F32 case args k f32.le@ cmpOperatorFloat return
      LE_F64 case args k f64.le@ cmpOperatorFloat return
      GE_I8 case args k i8.ge@ cmpOperatorInt return
      GE_I16 case args k i16.ge@ cmpOperatorInt return
      GE_I32 case args k i32.ge@ cmpOperatorInt return
      GE_I64 case args k i64.ge@ cmpOperatorInt return
      GE_F32 case args k f32.ge@ cmpOperatorFloat return
      GE_F64 case args k f64.ge@ cmpOperatorFloat return
      GT_I8 case args k i8.gt@ cmpOperatorInt return
      GT_I16 case args k i16.gt@ cmpOperatorInt return
      GT_I32 case args k i32.gt@ cmpOperatorInt return
      GT_I64 case args k i64.gt@ cmpOperatorInt return
      GT_F32 case args k f32.gt@ cmpOperatorFloat return
      GT_F64 case args k f64.gt@ cmpOperatorFloat return
      ULT_I8  LT_C8  case args k i8.ult@ cmpOperatorInt return
      ULT_I16 LT_C16 case args k i16.ult@ cmpOperatorInt return
      ULT_I32 LT_C32 case args k i32.ult@ cmpOperatorInt return
      ULT_I64 case args k i64.ult@ cmpOperatorInt return
      ULE_I8  LE_C8  case args k i8.ule@ cmpOperatorInt return
      ULE_I16 LE_C16 case args k i16.ule@ cmpOperatorInt return
      ULE_I32 LE_C32 case args k i32.ule@ cmpOperatorInt return
      ULE_I64 case args k i64.ule@ cmpOperatorInt return
      UGE_I8  GE_C8  case args k i8.uge@ cmpOperatorInt return
      UGE_I16 GE_C16 case args k i16.uge@ cmpOperatorInt return
      UGE_I32 GE_C32 case args k i32.uge@ cmpOperatorInt return
      UGE_I64 case args k i64.uge@ cmpOperatorInt return
      UGT_I8  GT_C8  case args k i8.ugt@ cmpOperatorInt return
      UGT_I16 GT_C16 case args k i16.ugt@ cmpOperatorInt return
      UGT_I32 GT_C32 case args k i32.ugt@ cmpOperatorInt return
      UGT_I64 case args k i64.ugt@ cmpOperatorInt return
      GET_PTR GET_PTR_MUT case
        k 1 == "correct number of arguments" assert
        inType 0 typeContext types.compositeGetElement typeContext types.getElementType =:: baseType
        baseType typeContext types.isComposite or baseType typeContext types.isArray if
          args 0 [] OperatorResult .success return
        end
        ## getOrOffset
          args 0 []
          false -1
          pos
          typeContext
        errors getOrOffset return
      OFFSET_PTR_I32 OFFSET_PTR_I64 OFFSET_PTR_MUT_I32 OFFSET_PTR_MUT_I64 case
        k 2 == "correct number of arguments" assert
        ## getOrOffset
          args 0 []
          true
          args 1 [] constAsInt if ..drop.3
            "unexpected constant for pointer offset expected integer: " sb.copyPtr
              args 1 [] typeContext sb.appendConstant
            pos errors appendError
            ConstValue .None OperatorResult .argumentError return
          end
          pos
          typeContext
        errors getOrOffset return
      SET_PTR case
        k 2 == "correct number of arguments" assert
        ConstValue .None
          args 0 []
          args 1 []
          pos
          typeContext
        errors setPointer return
      SYS_ARGC SYS_ARGV SYS_ENVP case break ## TODO error message
      PARSE_I8 PARSE_I16 PARSE_I32 PARSE_I64 case
        k 2 == "correct number of arguments" assert
        args 0 [] =:: argument
        args 1 [] =:: argLength
        argument .Array8 ?? "argument is string" assert
        argLength .Int ?? "length is int" assert
        argument .Array8 .length argLength .Int < if
          "length exceeds size of memory section" sb.copyPtr
          pos errors appendError
        end
        argument .Array8 string.fromBytes
          argLength .Int string.head
        =:: chars
        chars 0 number.tryParseInt =:: parserError =:: parsed
        false =:: mut: overflow
        ## XXX ? extract error handling code
        parserError switch
          NONE case break
          UNSIGNED OVERFLOW case
            parserError .UNSIGNED ?? and builtIn .PARSE_I64 ?? if break end
            true overflow=
            break
          SIGN INT EMPTY INVALID_BASE INVALID_CHAR case
            parserError number.errorString sb.fromStr
              " while parsing number " sb.appendS
              chars sb.appendStr
            pos errors appendError
            break
        end
        builtIn .PARSE_I64 ?? if
          overflow if
            chars sb.fromStr
              " does not fit into a 64-bit integer" sb.appendS
            pos errors appendWarning
          end
        else builtIn .PARSE_I32 ?? _if
          overflow or parsed i32.MIN i64 cast.s < or parsed i32.UMAX i64 cast.u > if
            chars sb.fromStr
              " does not fit into a 32-bit integer" sb.appendS
            pos errors appendWarning
          end
        else builtIn .PARSE_I16 ?? _if
          overflow or parsed i16.MIN i64 cast.s < or parsed i16.UMAX i64 cast.u > if
            chars sb.fromStr
              " does not fit into a 16-bit integer" sb.appendS
            pos errors appendWarning
          end
        else builtIn .PARSE_I8 ?? _if
          overflow or parsed i8.MIN i64 cast.s < or parsed i8.UMAX i64 cast.u > if
            chars sb.fromStr
              " does not fit into a 8-bit integer" sb.appendS
            pos errors appendWarning
          end
        end
        parsed ConstValue .Int OperatorResult .success return
      PARSE_F32 PARSE_F64 case
        k 2 == "correct number of arguments" assert
        args 0 [] =:: argument
        args 1 [] =:: argLength
        argument .Array8 ?? "argument is string" assert
        argLength .Int ?? "length is int" assert
        argument .Array8 .length argLength .Int < if
          "length exceeds size of memory section" sb.copyPtr
          pos errors appendError
        end
        argument .Array8 string.fromBytes
          argLength .Int string.head
        =:: chars
        chars 0 number.tryParseFloat =:: parserError =:: parsed
        parserError switch
          NONE INT case break
          UNSIGNED SIGN OVERFLOW EMPTY INVALID_BASE INVALID_CHAR case
            parserError number.errorString sb.fromStr
              " while parsing number " sb.appendS
              chars sb.appendStr
            pos errors appendError
            break
        end
        parsed ConstValue .Float OperatorResult .success return
     TYPE_IS_PRIMITIVE case ##XXX? wrapper proc for Type -> bool
        k 1 == "correct number of arguments" assert
        args 0 [] .TypeId ?? "argument is type" assert
        ## named primitives are not counted as primitive
        args 0 [] .TypeId types.isPrimitive
          ConstValue .Bool
        OperatorResult .success return
     TYPE_IS_POINTER case
        k 1 == "correct number of arguments" assert
        args 0 [] .TypeId ?? "argument is type" assert
        args 0 [] .TypeId typeContext types.isPointer
          ConstValue .Bool
        OperatorResult .success return
     TYPE_IS_RAW_POINTER case
        k 1 == "correct number of arguments" assert
        args 0 [] .TypeId ?? "argument is type" assert
        args 0 [] .TypeId typeContext types.isRawPointer
          ConstValue .Bool
        OperatorResult .success return
     TYPE_IS_ARRAY case
        k 1 == "correct number of arguments" assert
        args 0 [] .TypeId ?? "argument is type" assert
        args 0 [] .TypeId typeContext types.isArray
          ConstValue .Bool
        OperatorResult .success return
     TYPE_IS_STRUCT case
        k 1 == "correct number of arguments" assert
        args 0 [] .TypeId ?? "argument is type" assert
        args 0 [] .TypeId typeContext types.isTuple
          ConstValue .Bool
        OperatorResult .success return
     TYPE_IS_TYPESET case
        k 1 == "correct number of arguments" assert
        args 0 [] .TypeId ?? "argument is type" assert
        args 0 [] .TypeId typeContext types.isTypeSet
          ConstValue .Bool
        OperatorResult .success return
     TYPE_IS_TAGGED_UNION case
        k 1 == "correct number of arguments" assert
        args 0 [] .TypeId ?? "argument is type" assert
        args 0 [] .TypeId typeContext types.isUnion
          args 0 [] .TypeId typeContext types.isTaggedUnion &
          ConstValue .Bool
        OperatorResult .success return
     TYPE_IS_RAW_UNION case
        k 1 == "correct number of arguments" assert
        args 0 [] .TypeId ?? "argument is type" assert
        args 0 [] .TypeId typeContext types.isUnion
          args 0 [] .TypeId typeContext types.isTaggedUnion ! &
          ConstValue .Bool
        OperatorResult .success return
     TYPE_IS_ENUM case
        k 1 == "correct number of arguments" assert
        args 0 [] .TypeId ?? "argument is type" assert
        args 0 [] .TypeId typeContext types.isEnum
          ConstValue .Bool
        OperatorResult .success return
     TYPE_IS_PROC case
        k 1 == "correct number of arguments" assert
        args 0 [] .TypeId ?? "argument is type" assert
        args 0 [] .TypeId typeContext types.isProcedure
          ConstValue .Bool
        OperatorResult .success return
    TYPE_IS_NAMED case
        k 1 == "correct number of arguments" assert
        args 0 [] .TypeId ?? "argument is type" assert
        args 0 [] .TypeId types.isNamedType
          ConstValue .Bool
        OperatorResult .success return
     TYPE_IS_CTYPE case
        k 1 == "correct number of arguments" assert
        args 0 [] .TypeId ?? "argument is type" assert
        args 0 [] .TypeId typeContext types.unwrapNamed .cType ??
          ConstValue .Bool
        OperatorResult .success return
     TYPE_IS_ALIGN case
        k 1 == "correct number of arguments" assert
        args 0 [] .TypeId ?? "argument is type" assert
        args 0 [] .TypeId typeContext types.unwrapNamed .align ??
          ConstValue .Bool
        OperatorResult .success return
     TYPE_IS_MUTABLE case
        k 1 == "correct number of arguments" assert
        args 0 [] .TypeId ?? "argument is type" assert
        args 0 [] .TypeId typeContext types.isMutable
          ConstValue .Bool
        OperatorResult .success return
     TYPE_IS_DEFINED case
        k 1 == "correct number of arguments" assert
        args 0 [] .TypeId ?? "argument is type" assert
        args 0 [] .TypeId typeContext types.unwrapNamed
          .undefined ?? ! ConstValue .Bool
        OperatorResult .success return
     TYPE_CAN_ASSIGN case
        k 2 == "correct number of arguments" assert
        args 0 [] .TypeId ?? "argument1 is type" assert
        args 1 [] .TypeId ?? "argument2 is type" assert
        args 0 [] .TypeId args 1 [] .TypeId typeContext types.canAutoCast
          ConstValue .Bool
        OperatorResult .success return
     TYPE_CAN_CAST case
        k 2 == "correct number of arguments" assert
        args 0 [] .TypeId ?? "argument1 is type" assert
        args 1 [] .TypeId ?? "argument2 is type" assert
        args 0 [] .TypeId args 1 [] .TypeId false typeContext types.canCast
          ConstValue .Bool
        OperatorResult .success return
     TYPE_ARRAY_ELEMENT case
        k 1 == "correct number of arguments" assert
        args 0 [] .TypeId ?? "argument is type" assert
        args 0 [] .TypeId typeContext types.getElementType
          ConstValue .TypeId
        OperatorResult .success return
      TYPE_UNWRAP_NAMED case
        k 1 == "correct number of arguments" assert
        args 0 [] .TypeId ?? "argument is type" assert
        args 0 [] .TypeId typeContext types.unwrapNamed
          ConstValue .TypeId
        OperatorResult .success return
      TYPE_GET_ELEMENT case
        k 2 == "correct number of arguments" assert
        args 0 [] .TypeId ?? "argument is type" assert
        args 1 [] .Int ?? "argument is int" assert
        args 0 [] .TypeId args 1 [] .Int i32 cast typeContext types.compositeGetElement
          ConstValue .TypeId
        OperatorResult .success return
    end
    ConstValue .None  OperatorResult .unimplemented return
  end

  proc(
    ConstValue : ptrValue
    bool : isOffset
    i64 : offset
    FilePosition : pos
    TypeContext ptr.mut : typeContext
    CompilerError list ptr.mut : errors
  -> ConstValue OperatorResult ) =>: getOrOffset
    ConstValue ..length 23 == "no new constants" assert
    ptrValue switch
      Array8 case
        ptrValue .Array8 =:: arrayConst
          isOffset if
            arrayConst offset slice.tail ConstValue .Array8
          else
            arrayConst 0 slice.get i64 cast.u ConstValue .Int
          end
        OperatorResult .success return
      Array16 case
        ptrValue .Array16 =:: arrayConst
          isOffset if
            arrayConst offset slice.tail ConstValue .Array16
          else
            arrayConst 0 slice.get i64 cast.u ConstValue .Int
          end
        OperatorResult .success return
      Array32 case
        ptrValue .Array32 =:: arrayConst
          isOffset if
            arrayConst offset slice.tail ConstValue .Array32
          else
            arrayConst 0 slice.get i64 cast.u ConstValue .Int
          end
        OperatorResult .success return
      Array64 case
        ptrValue .Array64 =:: arrayConst
          isOffset if
            arrayConst offset slice.tail ConstValue .Array64
          else
            arrayConst 0 slice.get i64 cast.u ConstValue .Int
          end
        OperatorResult .success return
      Array case
        ptrValue .Array =:: arrayConst
          isOffset if
            arrayConst offset slice.tail ConstValue .Array
          else
            arrayConst 0 slice.get
          end
        OperatorResult .success return
      LocalValue case
        ## XXX? correctly handle local value ( local array ( ... ) )
        ptrValue .LocalValue ConstValue ptr.mut cast [] OperatorResult .success return
      LocalArray case
        ptrValue .LocalArray ConstValue slice.mut cast =:: arrayConst
          isOffset if
            arrayConst offset slice.tail LocalSlice cast ConstValue .LocalArray
          else
            arrayConst 0 slice.at .data LocalAddress cast ConstValue .LocalValue
          end
        OperatorResult .success return
      LocalArray8 case
        ptrValue .LocalArray8 i8 slice.mut cast =:: arrayConst
          isOffset if
            arrayConst offset slice.tail LocalSlice8 cast ConstValue .LocalArray8
          else
            arrayConst 0 slice.get i64 cast.u ConstValue .Int
          end
        OperatorResult .success return
      LocalArray16 case
        ptrValue .LocalArray16 i16 slice.mut cast =:: arrayConst
          isOffset if
            arrayConst offset slice.tail LocalSlice16 cast ConstValue .LocalArray16
          else
            arrayConst 0 slice.get i64 cast.u ConstValue .Int
          end OperatorResult .success return
      LocalArray32 case
        ptrValue .LocalArray32 i32 slice.mut cast =:: arrayConst
          isOffset if
            arrayConst offset slice.tail LocalSlice32 cast ConstValue .LocalArray32
          else
            arrayConst 0 slice.get i64 cast.u ConstValue .Int
          end OperatorResult .success return
      LocalArray64 case
        ptrValue .LocalArray64 i64 slice.mut cast =:: arrayConst
          isOffset if
            arrayConst offset slice.tail LocalSlice64 cast ConstValue .LocalArray64
          else
            arrayConst 0 slice.get i64 cast.u ConstValue .Int
          end OperatorResult .success return
      default
        "unexpected constant for pointer value: " sb.copyPtr
          ptrValue typeContext sb.appendConstant
        pos errors appendError
        ConstValue .None OperatorResult .argumentError return
    end
  end

  proc(
    type : auto: W
    ConstValue : src
    W : localArray
    type : T
  -> bool ) =>: primitiveArrayTrySetElement
    localArray T slice.mut cast =:: arrayData
    ConstValue ..length 23 == "no new constants" assert
    src switch
      Char case src .Char i64 cast.u break
      Int case src .Int break
      ## XXX? support floats?
      default false return
    end =:: intValue
    intValue T cast arrayData 0 slice.set
    true return
  end
  proc(
    type : auto: W type : auto: T
    W : targetArray
    T slice : srcArray
    FilePosition : pos
    CompilerError list ptr.mut : errors
  -> OperatorResult ) =>: setLocalArray
    srcArray .length targetArray .length != if
      "invalid array length for assignment expected " sb.copyPtr
        targetArray .length sb.appendI
        " got:" sb.appendS
        srcArray .length sb.appendI
      pos errors appendError
      OperatorResult .argumentError return
    end
    targetArray .data srcArray .data != if
      targetArray .data srcArray .data srcArray .length mem.copy ..drop
    end
    OperatorResult .success return
  end
  proc(
    ConstValue : newValue
    ConstValue : targetValue
    FilePosition : pos
    TypeContext ptr.mut : typeContext
    CompilerError list ptr.mut : errors
  -> OperatorResult ) =>: setPointer
    ConstValue ..length 23 == "no new constants" assert
    targetValue switch
      LocalValue case
        newValue targetValue .LocalValue ConstValue _ ptr.mut cast =[]
        OperatorResult .success return
      LocalArray case
        newValue .Array ?? if
          newValue .Array
        else newValue .LocalArray ?? _if
          newValue .LocalArray ConstValue slice.mut cast slice.freeze
        else
          "unexpected source for assignment expected array got:" sb.copyPtr
            newValue typeContext sb.appendConstant
          pos errors appendError
          OperatorResult .argumentError return
        end =:: srcArray
        targetValue .LocalArray srcArray pos errors setLocalArray return
      LocalArray8 case
        newValue targetValue .LocalArray8 i8 primitiveArrayTrySetElement if
          OperatorResult .success return
        end
        newValue .Array8 ?? if
          newValue .Array8
        else newValue .LocalArray8 ?? _if
          newValue .LocalArray8 i8 slice.mut cast slice.freeze
        else
          "unexpected source for assignment expected array got:" sb.copyPtr
            newValue typeContext sb.appendConstant
          pos errors appendError
          OperatorResult .argumentError return
        end =:: srcArray
        targetValue .LocalArray8 srcArray pos errors setLocalArray return
      LocalArray16 case
        newValue targetValue .LocalArray16 i16 primitiveArrayTrySetElement if
          OperatorResult .success return
        end
        newValue .Array16 ?? if
          newValue .Array16
        else newValue .LocalArray16 ?? _if
          newValue .LocalArray16 i16 slice.mut cast slice.freeze
        else
          "unexpected source for assignment expected array got:" sb.copyPtr
            newValue typeContext sb.appendConstant
          pos errors appendError
          OperatorResult .argumentError return
        end =:: srcArray
        targetValue .LocalArray16 srcArray pos errors setLocalArray return
      LocalArray32 case
        newValue targetValue .LocalArray32 i32 primitiveArrayTrySetElement if
          OperatorResult .success return
        end
        newValue .Array32 ?? if
          newValue .Array32
        else newValue .LocalArray32 ?? _if
          newValue .LocalArray32 i32 slice.mut cast slice.freeze
        else
          "unexpected source for assignment expected array got:" sb.copyPtr
            newValue typeContext sb.appendConstant
          pos errors appendError
          OperatorResult .argumentError return
        end =:: srcArray
        targetValue .LocalArray32 srcArray pos errors setLocalArray return
      LocalArray64 case
        newValue targetValue .LocalArray64 i64 primitiveArrayTrySetElement if
          OperatorResult .success return
        end
        newValue .Array64 ?? if
          newValue .Array64
        else newValue .LocalArray64 ?? _if
          newValue .LocalArray64 i64 slice.mut cast slice.freeze
        else
          "unexpected source for assignment expected array got:" sb.copyPtr
            newValue typeContext sb.appendConstant
          pos errors appendError
          OperatorResult .argumentError return
        end =:: srcArray
        targetValue .LocalArray64 srcArray pos errors setLocalArray return
      default
        "unexpected target for setValue, expected writable memory location got: " sb.copyPtr
          targetValue typeContext sb.appendConstant
        pos errors appendError
        OperatorResult .argumentError return
    end
  end

  proc(
    ConstValue : a
    ConstValue : b
    TypeContext ptr : typeContext
  -> bool bool ) =>: export: pointerEq
    ConstValue ..length 23 == "no new constants" assert
    a switch
      Int case
        b .Int ?? ! if false false return end
        a .Int b .Int == false return
      LocalValue case
        b .LocalValue ?? ! if false false return end
        a .LocalValue ConstValue _ ptr cast b .LocalValue ConstValue _ ptr cast == false return
      Array8 case
        b .Array8 ?? ! if false false return end
        a .Array8 .data b .Array8 .data == and
          a .Array8 .length b .Array8 .length ==
        end false return
      Array16 case
        b .Array16 ?? ! if false false return end
        a .Array16 .data b .Array16 .data == and
          a .Array16 .length b .Array16 .length ==
        end false return
      Array32 case
        b .Array32 ?? ! if false false return end
        a .Array32 .data b .Array32 .data == and
          a .Array32 .length b .Array32 .length ==
        end false return
      Array64 case
        b .Array64 ?? ! if false false return end
        a .Array64 .data b .Array64 .data == and
          a .Array64 .length b .Array64 .length ==
        end false return
      Array case
        b .Array ?? ! if false false return end
        a .Array .data b .Array .data == and
          a .Array .length b .Array .length ==
        end false return
      LocalArray case
        b .LocalArray ?? ! if false false return end
        a .LocalArray .data b .LocalArray .data == and
          a .LocalArray .length b .LocalArray .length ==
        end false return
      LocalArray8 case
        b .LocalArray8 ?? ! if false false return end
        a .LocalArray8 .data b .LocalArray8 .data == and
          a .LocalArray8 .length b .LocalArray8 .length ==
        end false return
      LocalArray16 case
        b .LocalArray16 ?? ! if false false return end
        a .LocalArray16 .data b .LocalArray16 .data == and
          a .LocalArray16 .length b .LocalArray16 .length ==
        end false return
      LocalArray32 case
        b .LocalArray32 ?? ! if false false return end
        a .LocalArray32 .data b .LocalArray32 .data == and
          a .LocalArray32 .length b .LocalArray32 .length ==
        end false return
      LocalArray64 case
        b .LocalArray64 ?? ! if false false return end
        a .LocalArray64 .data b .LocalArray64 .data == and
          a .LocalArray64 .length b .LocalArray64 .length ==
        end false return
      default ## unexpected type for pointer
        false true return
    end
  end
  proc(
    ConstValue : a
    ConstValue : b
    Type : valType0
    TypeContext ptr : typeContext
  -> bool  bool ) =>: export: operatorEq
    valType0 typeContext types.unwrapNamed =:: valType
    valType .primitiveType ?? if
      valType .primitiveType switch
        BOOL case
          a constAsBool if ..drop false true return end =:: x
          b constAsBool if ..drop false true return end =:: y
          x y == false return
        I8 CHAR8 case
          a constAsInt if ..drop false true return end i8 cast =:: x
          b constAsInt if ..drop false true return end i8 cast =:: y
          x y == false return
        I16 CHAR16 case
          a constAsInt if ..drop false true return end i16 cast =:: x
          b constAsInt if ..drop false true return end i16 cast =:: y
          x y == false return
        I32 CHAR32 case
          a constAsInt if ..drop false true return end i32 cast =:: x
          b constAsInt if ..drop false true return end i32 cast =:: y
          x y == false return
        I64 case
          a constAsInt if ..drop false true return end i64 cast =:: x
          b constAsInt if ..drop false true return end i64 cast =:: y
          x y == false return
        F32 case
          a constAsFloat if ..drop false true return end f32 cast =:: x
          b constAsFloat if ..drop false true return end f32 cast =:: y
          x y == false return
        F64 case
          a constAsFloat if ..drop false true return end f64 cast =:: x
          b constAsFloat if ..drop false true return end f64 cast =:: y
          x y == false return
        TYPE case
          a constAsType if ..drop false true return end =:: x
          b constAsType if ..drop false true return end =:: y
          x y types.typeEquals false
        return
      end
    else valType typeContext types.isEnum or valType typeContext types.isUnion _if
      a .EnumLabel ?? and b .EnumLabel ?? if
        a .EnumLabel b .EnumLabel == false return
      end
    else valType typeContext types.isPointer _if
      a b typeContext pointerEq return
    end
    false true return
  end

  proc(
    ConstValue : src
  -> i8 _ ptr i64 i64 bool ) =>: constantAsRawMemory
    ConstValue ..length 23 == "no new constants" assert
    src switch
      Array8 case
        src .Array8 .data i8 _ ptr cast!
        src .Array8 .length
        i8 ..types.stride
        false return
      Array16 case
        src .Array16 .data i8 _ ptr cast!
        src .Array16 .length
        i16 ..types.stride
        false return
      Array32 case
        src .Array32 .data i8 _ ptr cast!
        src .Array32 .length
        i32 ..types.stride
        false return
      Array64 case
        src .Array64 .data i8 _ ptr cast!
        src .Array64 .length
        i64 ..types.stride
        false return
      LocalArray8 case
        src .LocalArray8 .data i8 _ ptr cast!
        src .LocalArray8 .length
        i8 ..types.stride
        false return
      LocalArray16 case
        src .LocalArray16 .data i8 _ ptr cast!
        src .LocalArray16 .length
        i16 ..types.stride
        false return
      LocalArray32 case
        src .LocalArray32 .data i8 _ ptr cast!
        src .LocalArray32 .length
        i32 ..types.stride
        false return
      LocalArray64 case
        src .LocalArray64 .data i8 _ ptr cast!
        src .LocalArray64 .length
        i64 ..types.stride
        false return
      default 0 i8 _ ptr cast! 0 0 true return
    end
  end
  proc(
    ConstValue : src
  -> i8 _ ptr.mut i64 i64 bool ) =>: constantAsRawMutableMemory
    ConstValue ..length 23 == "no new constants" assert
    src switch
      LocalArray8 case
        src .LocalArray8 .data i8 _ ptr.mut cast!
        src .LocalArray8 .length
        i8 ..types.stride
        false return
      LocalArray16 case
        src .LocalArray16 .data i8 _ ptr.mut cast!
        src .LocalArray16 .length
        i16 ..types.stride
        false return
      LocalArray32 case
        src .LocalArray32 .data i8 _ ptr.mut cast!
        src .LocalArray32 .length
        i32 ..types.stride
        false return
      LocalArray64 case
        src .LocalArray64 .data i8 _ ptr.mut cast!
        src .LocalArray64 .length
        i64 ..types.stride
        false return
      default 0 i8 _ ptr.mut cast! 0 0 true return
    end
  end
  proc(
    ConstValue : target
    ConstValue : src
    i64 : length
    FilePosition : pos
    ProgramContext ptr.mut : program
  -> ConstValue bool ) =>: export: opMemcopy
    length 0 <= if
      target false return
    end
    program .errors =:: errors
    program .idContext .typeContext =:: typeContext
    src constantAsRawMemory if ..drop.3
      "unsupported constant for memcopy source: " sb.copyPtr
        src typeContext sb.appendConstant
      pos errors appendError
      target true return
    end =:: srcStride =:: srcLength =:: srcData
    target constantAsRawMutableMemory if ..drop.3
      "unsupported constant for memcopy target: " sb.copyPtr
        target typeContext sb.appendConstant
      pos errors appendError
      target true return
    end =:: targetStride =:: targetLength =:: targetData
    srcStride targetStride != or
        length srcStride u% 0 != or
        length targetStride u% 0 != if
      "unaligned copy is not supported" sb.copyPtr
      pos errors appendError
      target true return
    end
    srcStride srcLength * length < or targetStride targetLength * length < if
      "out of bounds memory access" sb.copyPtr
      pos errors appendError
      target true return
    end
    targetData srcData length mem.copy ..drop
    target false return
  end
end
