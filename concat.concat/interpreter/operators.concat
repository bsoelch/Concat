proc( Type : opType ConstValue : a ConstValue : b CompilerError list ptr mut : err FilePosition : pos => Type ConstValue bool ) =: public operator_unsigned>>
  opType Type .primitiveType != if ## unsupported type for constant evaluation
    Type .undefined ConstValue .none true return
  end
  opType .primitiveType switch
    I8 case
      a err pos constAsInt =:: e1 0xff &
      b err pos constAsInt =:: e2 i8 cast
      >>u ConstValue .int new opType #swap e1 e2 | return
    I16 case
      a err pos constAsInt =:: e1 0xffff &
      b err pos constAsInt =:: e2 i16 cast
      >>u ConstValue .int new opType #swap e1 e2 | return
    I32 case
      a err pos constAsInt =:: e1 0xffff_ffff &
      b err pos constAsInt =:: e2 i32 cast
      >>u ConstValue .int new opType #swap e1 e2 | return
    I64 case
      a err pos constAsInt =:: e1
      b err pos constAsInt =:: e2
      >>u ConstValue .int new opType #swap e1 e2 | return
    FLOAT32 FLOAT64 BOOL TYPE case
      "unsupported type for unsigned operator<<" sb.wrap pos err appendError
      Type .undefined ConstValue .none true return
  end
end
proc( Type : opType ConstValue : a ConstValue : b TypeContext ptr : tc CompilerError list ptr mut : err FilePosition : pos => Type ConstValue bool ) =: public operator==
  opType tc types.isEnum if
    a err pos constAsEnumLabel =:: e1
    b err pos constAsEnumLabel =:: e2
    == ConstValue .boolean new types.primitive.BOOL #swap e1 e2 | return
  end
  opType Type .primitiveType != if ## unsupported type for constant evaluation
    Type .undefined ConstValue .none true return
  end
  opType .primitiveType switch
    BOOL case
      a err pos constAsBool =:: e1
      b err pos constAsBool =:: e2
      == ConstValue .boolean new types.primitive.BOOL #swap e1 e2 | return
    I8 case
      a err pos constAsInt =:: e1 i8 cast
      b err pos constAsInt =:: e2 i8 cast
      == ConstValue .boolean new types.primitive.BOOL #swap e1 e2 | return
    I16 case
      a err pos constAsInt =:: e1 i16 cast
      b err pos constAsInt =:: e2 i16 cast
      == ConstValue .boolean new types.primitive.BOOL #swap e1 e2 | return
    I32 case
      a err pos constAsInt =:: e1 i32 cast
      b err pos constAsInt =:: e2 i32 cast
      == ConstValue .boolean new types.primitive.BOOL #swap e1 e2 | return
    I64 case
      a err pos constAsInt =:: e1
      b err pos constAsInt =:: e2
      == ConstValue .boolean new types.primitive.BOOL #swap e1 e2 | return
    FLOAT32 case
      a err pos constAsF32 =:: e1
      b err pos constAsF32 =:: e2
      == ConstValue .boolean new types.primitive.BOOL #swap e1 e2 | return
    FLOAT64 case
      a err pos constAsF64 =:: e1
      b err pos constAsF64 =:: e2
      == ConstValue .boolean new types.primitive.BOOL #swap e1 e2 | return
    TYPE case
      a err pos constAsType =:: e1
      b err pos constAsType =:: e2
      types.typeEquals ConstValue .boolean new types.primitive.BOOL #swap e1 e2 | return
  end
end
proc( Type : opType ConstValue : a ConstValue : b TypeContext ptr : tc CompilerError list ptr mut : err FilePosition : pos => Type ConstValue bool ) =: public operator!=
  opType tc types.isEnum if
    a err pos constAsEnumLabel =:: e1
    b err pos constAsEnumLabel =:: e2
    != ConstValue .boolean new types.primitive.BOOL #swap e1 e2 | return
  end
  opType Type .primitiveType != if ## unsupported type for constant evaluation
    Type .undefined ConstValue .none true return
  end
  opType .primitiveType switch
    BOOL case
      a err pos constAsBool =:: e1
      b err pos constAsBool =:: e2
      != ConstValue .boolean new types.primitive.BOOL #swap e1 e2 | return
    I8 case
      a err pos constAsInt =:: e1 i8 cast
      b err pos constAsInt =:: e2 i8 cast
      != ConstValue .boolean new types.primitive.BOOL #swap e1 e2 | return
    I16 case
      a err pos constAsInt =:: e1 i16 cast
      b err pos constAsInt =:: e2 i16 cast
      != ConstValue .boolean new types.primitive.BOOL #swap e1 e2 | return
    I32 case
      a err pos constAsInt =:: e1 i32 cast
      b err pos constAsInt =:: e2 i32 cast
      != ConstValue .boolean new types.primitive.BOOL #swap e1 e2 | return
    I64 case
      a err pos constAsInt =:: e1
      b err pos constAsInt =:: e2
      != ConstValue .boolean new types.primitive.BOOL #swap e1 e2 | return
    FLOAT32 case
      a err pos constAsF32 =:: e1
      b err pos constAsF32 =:: e2
      != ConstValue .boolean new types.primitive.BOOL #swap e1 e2 | return
    FLOAT64 case
      a err pos constAsF64 =:: e1
      b err pos constAsF64 =:: e2
      != ConstValue .boolean new types.primitive.BOOL #swap e1 e2 | return
    TYPE case
      a err pos constAsType =:: e1
      b err pos constAsType =:: e2
      types.typeEquals ! ConstValue .boolean new types.primitive.BOOL #swap e1 e2 | return
  end
end
proc( Type : opType ConstValue : a ConstValue : b CompilerError list ptr mut : err FilePosition : pos => i8 bool ) =: operator_compare
  opType Type .primitiveType != if ## unsupported type for constant evaluation
    0i8 true return
  end
  opType .primitiveType switch
    I8 case
      a err pos constAsInt =:: e1 i8 cast =:: x
      b err pos constAsInt =:: e2 i8 cast =:: y
      x y == if 0i8 else x y > _if 1i8 else -1i8 end e1 e2 | return
    I16 case
      a err pos constAsInt =:: e1 i16 cast =:: x
      b err pos constAsInt =:: e2 i16 cast =:: y
      x y == if 0i8 else x y > _if 1i8 else -1i8 end e1 e2 | return
    I32 case
      a err pos constAsInt =:: e1 i32 cast =:: x
      b err pos constAsInt =:: e2 i32 cast =:: y
      x y == if 0i8 else x y > _if 1i8 else -1i8 end e1 e2 | return
    I64 case
      a err pos constAsInt =:: e1 =:: x
      b err pos constAsInt =:: e2 =:: y
      x y == if 0i8 else x y > _if 1i8 else -1i8 end e1 e2 | return
    FLOAT32 case
      a err pos constAsF32 =:: e1 =:: x
      b err pos constAsF32 =:: e2 =:: y
      x y == if 0i8 else x y > _if 1i8 else -1i8 end e1 e2 | return
    FLOAT64 case
      a err pos constAsF64 =:: e1 =:: x
      b err pos constAsF64 =:: e2 =:: y
      x y == if 0i8 else x y > _if 1i8 else -1i8 end e1 e2 | return
    BOOL TYPE case
      "unsupported type for operator*" sb.wrap pos err appendError
      0i8 true return
  end
end
proc( Type : opType ConstValue : a ConstValue : b CompilerError list ptr mut : err FilePosition : pos => Type ConstValue bool ) =: public operator<
  opType a b err pos operator_compare if #drop
    Type .undefined ConstValue .none true return
  end
  0i8 < ConstValue .boolean new types.primitive.BOOL #swap false return
end
proc( Type : opType ConstValue : a ConstValue : b CompilerError list ptr mut : err FilePosition : pos => Type ConstValue bool ) =: public operator<=
  opType a b err pos operator_compare if #drop
