  proc( Type : opType ConstValue : a ConstValue : b TypeContext ptr : tc -> Type ConstValue bool ) =>: export: operator==
    opType tc types.isEnum if
      a constAsEnumLabel =:: e1
      b constAsEnumLabel =:: e2
      == ConstValue .boolean types.primitive.BOOL ..swap e1 e2 | return
    end
    opType .primitiveType ?? ! if ## unsupported type for constant evaluation
      Type .undefined ConstValue .none true return
    end
    opType .primitiveType switch
      BOOL case
        a constAsBool =:: e1
        b constAsBool =:: e2
        == ConstValue .boolean types.primitive.BOOL ..swap e1 e2 | return
      I8 case
        a constAsInt =:: e1 i8 cast
        b constAsInt =:: e2 i8 cast
        == ConstValue .boolean types.primitive.BOOL ..swap e1 e2 | return
      I16 case
        a constAsInt =:: e1 i16 cast
        b constAsInt =:: e2 i16 cast
        == ConstValue .boolean types.primitive.BOOL ..swap e1 e2 | return
      I32 case
        a constAsInt =:: e1 i32 cast
        b constAsInt =:: e2 i32 cast
        == ConstValue .boolean types.primitive.BOOL ..swap e1 e2 | return
      I64 case
        a constAsInt =:: e1
        b constAsInt =:: e2
        == ConstValue .boolean types.primitive.BOOL ..swap e1 e2 | return
      FLOAT32 case
        a constAsF32 =:: e1
        b constAsF32 =:: e2
        == ConstValue .boolean types.primitive.BOOL ..swap e1 e2 | return
      FLOAT64 case
        a constAsF64 =:: e1
        b constAsF64 =:: e2
        == ConstValue .boolean types.primitive.BOOL ..swap e1 e2 | return
      TYPE case
        a constAsType =:: e1
        b constAsType =:: e2
        types.typeEquals ConstValue .boolean types.primitive.BOOL ..swap e1 e2 | return
    end
  end
