#include "constants.concat"

#namespace interpreter

proc( ConstValue : a CompilerError list ptr mut : err FilePosition : pos => i64 bool ) =: constAsInt ## all integer calculations are done in 64 bits
  a switch
    chr case a .chr i64 cast false return
    int case a .int i64 cast false return
    none boolean enumLabel str arrayConstant typeId wildCard genericArg templateArg Float case 0i64 true return
  end
end
proc( ConstValue : a CompilerError list ptr mut : err FilePosition : pos => float bool ) =: constAsF32
  a switch
    chr case a .chr float cast false return
    int case a .int float cast false return
    Float case a .Float float cast false return
    none boolean enumLabel str arrayConstant typeId wildCard genericArg templateArg case 0 float cast true return
  end
end
proc( ConstValue : a CompilerError list ptr mut : err FilePosition : pos => double bool ) =: constAsF64
  a switch
    chr case a .chr double cast false return
    int case a .int double cast false return
    Float case a .Float double cast false return
    none boolean enumLabel str arrayConstant typeId wildCard genericArg templateArg case 0 double cast true return
  end
end

proc( Type : opType ConstValue : a ConstValue : b CompilerError list ptr mut : err FilePosition : pos => Type ConstValue bool ) =: public operator+
  opType Type .primitiveType != if ## XXX print types
    "constant evaluation is currently only supported for primitive types" sb.wrap pos err appendError
    Type .undefined ConstValue .none true return
  end
  opType .primitiveType switch
    I8 I16 I32 I64 case
      a err pos constAsInt =:: e1
      b err pos constAsInt =:: e2
      + ConstValue .int new opType #swap e1 e2 | return
    FLOAT32 case
      a err pos constAsF32 =:: e1
      b err pos constAsF32 =:: e2
      + ConstValue .Float new opType #swap e1 e2 | return
    FLOAT64 case
      a err pos constAsF64 =:: e1
      b err pos constAsF64 =:: e2
      + ConstValue .Float new opType #swap e1 e2 | return
    BOOL TYPE case
      "unsupported type for addition" sb.wrap pos err appendError
      Type .undefined ConstValue .none true return
  end
end
proc( Type : opType ConstValue : a ConstValue : b CompilerError list ptr mut : err FilePosition : pos => Type ConstValue bool ) =: public operator-
  opType Type .primitiveType != if ## XXX print types
    "constant evaluation is currently only supported for primitive types" sb.wrap pos err appendError
    Type .undefined ConstValue .none true return
  end
  opType .primitiveType switch
    I8 I16 I32 I64 case
      a err pos constAsInt =:: e1
      b err pos constAsInt =:: e2
      - ConstValue .int new opType #swap e1 e2 | return
    FLOAT32 case
      a err pos constAsF32 =:: e1
      b err pos constAsF32 =:: e2
      - ConstValue .Float new opType #swap e1 e2 | return
    FLOAT64 case
      a err pos constAsF64 =:: e1
      b err pos constAsF64 =:: e2
      - ConstValue .Float new opType #swap e1 e2 | return
    BOOL TYPE case
      "unsupported type for addition" sb.wrap pos err appendError
      Type .undefined ConstValue .none true return
  end
end
proc( Type : opType ConstValue : a ConstValue : b CompilerError list ptr mut : err FilePosition : pos => Type ConstValue bool ) =: public operator*
  opType Type .primitiveType != if ## XXX print types
    "constant evaluation is currently only supported for primitive types" sb.wrap pos err appendError
    Type .undefined ConstValue .none true return
  end
  opType .primitiveType switch
    I8 I16 I32 I64 case
      a err pos constAsInt =:: e1
      b err pos constAsInt =:: e2
      * ConstValue .int new opType #swap e1 e2 | return
    FLOAT32 case
      a err pos constAsF32 =:: e1
      b err pos constAsF32 =:: e2
      * ConstValue .Float new opType #swap e1 e2 | return
    FLOAT64 case
      a err pos constAsF64 =:: e1
      b err pos constAsF64 =:: e2
      * ConstValue .Float new opType #swap e1 e2 | return
    BOOL TYPE case
      "unsupported type for addition" sb.wrap pos err appendError
      Type .undefined ConstValue .none true return
  end
end
proc( Type : opType ConstValue : a ConstValue : b CompilerError list ptr mut : err FilePosition : pos => Type ConstValue bool ) =: public operator/
  opType Type .primitiveType != if ## XXX print types
    "constant evaluation is currently only supported for primitive types" sb.wrap pos err appendError
    Type .undefined ConstValue .none true return
  end
  opType .primitiveType switch
    I8 I16 I32 I64 case
      a err pos constAsInt =:: e1
      b err pos constAsInt =:: e2
      / ConstValue .int new opType #swap e1 e2 | return
    FLOAT32 case
      a err pos constAsF32 =:: e1
      b err pos constAsF32 =:: e2
      / ConstValue .Float new opType #swap e1 e2 | return
    FLOAT64 case
      a err pos constAsF64 =:: e1
      b err pos constAsF64 =:: e2
      / ConstValue .Float new opType #swap e1 e2 | return
    BOOL TYPE case
      "unsupported type for addition" sb.wrap pos err appendError
      Type .undefined ConstValue .none true return
  end
end
proc( Type : opType ConstValue : a ConstValue : b CompilerError list ptr mut : err FilePosition : pos => Type ConstValue bool ) =: public operator_unsigned/
  opType Type .primitiveType != if ## XXX print types
    "constant evaluation is currently only supported for primitive types" sb.wrap pos err appendError
    Type .undefined ConstValue .none true return
  end
  opType .primitiveType switch
    I8 case
      a err pos constAsInt =:: e1 0xff &
      b err pos constAsInt =:: e2 0xff &
      /u ConstValue .int new opType #swap e1 e2 | return
    I16 case
      a err pos constAsInt =:: e1 0xffff &
      b err pos constAsInt =:: e2 0xffff &
      /u ConstValue .int new opType #swap e1 e2 | return
    I32 case
      a err pos constAsInt =:: e1 0xffff_ffff &
      b err pos constAsInt =:: e2 0xffff_ffff &
      /u ConstValue .int new opType #swap e1 e2 | return
    I64 case
      a err pos constAsInt =:: e1
      b err pos constAsInt =:: e2
      /u ConstValue .int new opType #swap e1 e2 | return
    FLOAT32 FLOAT64 BOOL TYPE case
      "unsupported type for addition" sb.wrap pos err appendError
      Type .undefined ConstValue .none true return
  end
end
proc( Type : opType ConstValue : a ConstValue : b CompilerError list ptr mut : err FilePosition : pos => Type ConstValue bool ) =: public operator%
  opType Type .primitiveType != if ## XXX print types
    "constant evaluation is currently only supported for primitive types" sb.wrap pos err appendError
    Type .undefined ConstValue .none true return
  end
  opType .primitiveType switch
    I8 I16 I32 I64 case
      a err pos constAsInt =:: e1
      b err pos constAsInt =:: e2
      % ConstValue .int new opType #swap e1 e2 | return
    FLOAT32  FLOAT64 case ## XXX float mod support
      "float modulo currently unsupported" sb.wrap pos err appendError
      Type .undefined ConstValue .none true return
    BOOL TYPE case
      "unsupported type for addition" sb.wrap pos err appendError
      Type .undefined ConstValue .none true return
  end
end
proc( Type : opType ConstValue : a ConstValue : b CompilerError list ptr mut : err FilePosition : pos => Type ConstValue bool ) =: public operator_unsigned%
  opType Type .primitiveType != if ## XXX print types
    "constant evaluation is currently only supported for primitive types" sb.wrap pos err appendError
    Type .undefined ConstValue .none true return
  end
  opType .primitiveType switch
    I8 case
      a err pos constAsInt =:: e1 0xff &
      b err pos constAsInt =:: e2 0xff &
      %u ConstValue .int new opType #swap e1 e2 | return
    I16 case
      a err pos constAsInt =:: e1 0xffff &
      b err pos constAsInt =:: e2 0xffff &
      %u ConstValue .int new opType #swap e1 e2 | return
    I32 case
      a err pos constAsInt =:: e1 0xffff_ffff &
      b err pos constAsInt =:: e2 0xffff_ffff &
      %u ConstValue .int new opType #swap e1 e2 | return
    I64 case
      a err pos constAsInt =:: e1
      b err pos constAsInt =:: e2
      %u ConstValue .int new opType #swap e1 e2 | return
    FLOAT32 FLOAT64 BOOL TYPE case
      "unsupported type for addition" sb.wrap pos err appendError
      Type .undefined ConstValue .none true return
  end
end

#end
