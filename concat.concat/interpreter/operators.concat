import "constants.concat"

namespace: interpreter
  proc( ConstValue : a -> bool bool ) =>: constAsBool
    a switch
      boolean case a .boolean false return
      none chr int Float enumLabel str arrayConstant typeId wildCard genericArg templateArg procedure procedureBundle union case false true return
    end
  end
  proc( ConstValue : a -> i64 bool ) =>: constAsInt ## all integer calculations are done in 64 bits
    a switch
      chr case a .chr i64 cast false return
      int case a .int i64 cast false return
      none boolean enumLabel str arrayConstant typeId wildCard genericArg templateArg Float procedure procedureBundle union case 0i64 true return
    end
  end
  proc( ConstValue : a -> f32 bool ) =>: constAsF32
    a switch
      chr case a .chr f32 cast false return
      int case a .int f32 cast false return
      Float case a .Float f32 cast false return
      none boolean enumLabel str arrayConstant typeId wildCard genericArg templateArg procedure procedureBundle union case 0 f32 cast true return
    end
  end
  proc( ConstValue : a -> f64 bool ) =>: constAsF64
    a switch
      chr case a .chr f64 cast false return
      int case a .int f64 cast false return
      Float case a .Float f64 cast false return
      none boolean enumLabel str arrayConstant typeId wildCard genericArg templateArg procedure procedureBundle union case 0 f64 cast true return
    end
  end
  proc( ConstValue : a -> i32 bool ) =>: constAsEnumLabel
    a switch
      enumLabel case a .enumLabel false return
      none boolean chr int Float str arrayConstant typeId wildCard genericArg templateArg procedure procedureBundle union case 0 true return
    end
  end
  proc( ConstValue : a -> Type bool ) =>: constAsType
    a switch
      typeId case a .typeId false return
      none boolean chr int enumLabel Float str arrayConstant  wildCard genericArg templateArg procedure procedureBundle union case Type .undefined true return
    end
  end

  proc( ConstValue : a -> ConstValue bool ) =>: export operatorNegate
    a switch
      chr case a .chr -_ ConstValue .int false return
      int case a .int -_ ConstValue .int false return
      Float case a .Float -_ ConstValue .Float false return
      none boolean enumLabel str arrayConstant wildCard genericArg templateArg procedure procedureBundle union typeId case
        a true return
    end
  end
  proc( ConstValue : a ConstValue : b -> ConstValue bool ) =>: export operatorAddInt
    a constAsInt if ..drop a true return end =:: n
    b constAsInt if ..drop a true return end =:: m
    n m + ConstValue .int false return
  end
  proc( ConstValue : a ConstValue : b -> ConstValue bool ) =>: export operatorAddF32
    a constAsF32 if ..drop a true return end =:: x
    b constAsF32 if ..drop a true return end =:: y
    x y + ConstValue .Float false return
  end
  proc( ConstValue : a ConstValue : b -> ConstValue bool ) =>: export operatorAddF64
    a constAsF64 if ..drop a true return end =:: x
    b constAsF64 if ..drop a true return end =:: y
    x y + ConstValue .Float false return
  end
  proc( ConstValue : a ConstValue : b -> ConstValue bool ) =>: export operatorSubInt
    a constAsInt if ..drop a true return end =:: n
    b constAsInt if ..drop a true return end =:: m
    n m - ConstValue .int false return
  end
  proc( ConstValue : a ConstValue : b -> ConstValue bool ) =>: export operatorSubF32
    a constAsF32 if ..drop a true return end =:: x
    b constAsF32 if ..drop a true return end =:: y
    x y - ConstValue .Float false return
  end
  proc( ConstValue : a ConstValue : b -> ConstValue bool ) =>: export operatorSubF64
    a constAsF64 if ..drop a true return end =:: x
    b constAsF64 if ..drop a true return end =:: y
    x y - ConstValue .Float false return
  end
  proc( ConstValue : a ConstValue : b -> ConstValue bool ) =>: export operatorMulInt
    a constAsInt if ..drop a true return end =:: n
    b constAsInt if ..drop a true return end =:: m
    n m * ConstValue .int false return
  end
  proc( ConstValue : a ConstValue : b -> ConstValue bool ) =>: export operatorMulF32
    a constAsF32 if ..drop a true return end =:: x
    b constAsF32 if ..drop a true return end =:: y
    x y * ConstValue .Float false return
  end
  proc( ConstValue : a ConstValue : b -> ConstValue bool ) =>: export operatorMulF64
    a constAsF64 if ..drop a true return end =:: x
    b constAsF64 if ..drop a true return end =:: y
    x y * ConstValue .Float false return
  end
  proc( ConstValue : a ConstValue : b -> ConstValue bool ) =>: export operatorDivI32
    a constAsInt if ..drop a true return end i32 cast =:: n
    b constAsInt if ..drop a true return end i32 cast =:: m
    n m / ConstValue .int false return
  end
  proc( ConstValue : a ConstValue : b -> ConstValue bool ) =>: export operatorUDivI32
    a constAsInt if ..drop a true return end i32 cast =:: n
    b constAsInt if ..drop a true return end i32 cast =:: m
    n m ..udiv ConstValue .int false return
  end
  proc( ConstValue : a ConstValue : b -> ConstValue bool ) =>: export operatorDivI64
    a constAsInt if ..drop a true return end =:: n
    b constAsInt if ..drop a true return end =:: m
    n m / ConstValue .int false return
  end
  proc( ConstValue : a ConstValue : b -> ConstValue bool ) =>: export operatorUDivI64
    a constAsInt if ..drop a true return end =:: n
    b constAsInt if ..drop a true return end =:: m
    n m ..udiv ConstValue .int false return
  end
  proc( ConstValue : a ConstValue : b -> ConstValue bool ) =>: export operatorDivF32
    a constAsF32 if ..drop a true return end =:: x
    b constAsF32 if ..drop a true return end =:: y
    x y / ConstValue .Float false return
  end
  proc( ConstValue : a ConstValue : b -> ConstValue bool ) =>: export operatorDivF64
    a constAsF64 if ..drop a true return end =:: x
    b constAsF64 if ..drop a true return end =:: y
    x y / ConstValue .Float false return
  end
  proc( ConstValue : a ConstValue : b -> ConstValue bool ) =>: export operatorModI32
    a constAsInt if ..drop a true return end i32 cast =:: n
    b constAsInt if ..drop a true return end i32 cast =:: m
    n m % ConstValue .int false return
  end
  proc( ConstValue : a ConstValue : b -> ConstValue bool ) =>: export operatorUModI32
    a constAsInt if ..drop a true return end i32 cast =:: n
    b constAsInt if ..drop a true return end i32 cast =:: m
    n m ..umod ConstValue .int false return
  end
  proc( ConstValue : a ConstValue : b -> ConstValue bool ) =>: export operatorModI64
    a constAsInt if ..drop a true return end =:: n
    b constAsInt if ..drop a true return end =:: m
    n m % ConstValue .int false return
  end
  proc( ConstValue : a ConstValue : b -> ConstValue bool ) =>: export operatorUModI64
    a constAsInt if ..drop a true return end =:: n
    b constAsInt if ..drop a true return end =:: m
    n m ..umod ConstValue .int false return
  end
  proc( ConstValue : a ConstValue : b -> ConstValue bool ) =>: export operatorModF32
    a constAsF32 if ..drop a true return end =:: x
    b constAsF32 if ..drop a true return end =:: y
    x y % ConstValue .Float false return
  end
  proc( ConstValue : a ConstValue : b -> ConstValue bool ) =>: export operatorModF64
    a constAsF64 if ..drop a true return end =:: x
    b constAsF64 if ..drop a true return end =:: y
    x y % ConstValue .Float false return
  end

  proc(
    ConstValue : a
    ConstValue : b
    Type : valType0
    TypeContext ptr : typeContext
  -> bool  bool ) =>: export operatorEq
    valType0 typeContext types.unwrapNamed =:: valType
    valType .primitiveType ?? if
      valType .primitiveType switch
        BOOL case
          a constAsBool if ..drop false true return end =:: x
          b constAsBool if ..drop false true return end =:: y
          x y == false return
        I8 case
          a constAsInt if ..drop false true return end i8 cast =:: x
          b constAsInt if ..drop false true return end i8 cast =:: y
          x y == false return
        I16 case
          a constAsInt if ..drop false true return end i16 cast =:: x
          b constAsInt if ..drop false true return end i16 cast =:: y
          x y == false return
        I32 case
          a constAsInt if ..drop false true return end i32 cast =:: x
          b constAsInt if ..drop false true return end i32 cast =:: y
          x y == false return
        I64 case
          a constAsInt if ..drop false true return end i64 cast =:: x
          b constAsInt if ..drop false true return end i64 cast =:: y
          x y == false return
        FLOAT32 case
          a constAsF32 if ..drop false true return end =:: x
          b constAsF32 if ..drop false true return end =:: y
          x y == false return
        FLOAT64 case
          a constAsF64 if ..drop false true return end =:: x
          b constAsF64 if ..drop false true return end =:: y
          x y == false return
        TYPE case
          a constAsType if ..drop false true return end =:: x
          b constAsType if ..drop false true return end =:: y
          x y types.typeEquals false
        return
      end
    end
    valType typeContext types.isPointer if
      a .str ?? b .str ?? & if
        ## a and b are the same string constant
        a .str .offset b .str .offset ==
        a .str .length b .str .length == &
        false return
      end
      a constAsInt if ..drop false true return end =:: x
      b constAsInt if ..drop false true return end =:: y
      x y == false return
    end
    false true return
  end
  proc(
    ConstValue : a
    ConstValue : b
    Type : valType0
    TypeContext ptr : typeContext
  -> i32  bool ) =>: export operatorCompare
    valType0 typeContext types.unwrapNamed =:: valType
    valType .primitiveType ?? if
      valType .primitiveType switch
        BOOL case
          a constAsBool if ..drop 0 true return end =:: x
          b constAsBool if ..drop 0 true return end =:: y
          x y == if 0 else x _if 1 else -1 end false return
        I8 case
          a constAsInt if ..drop 0 true return end i8 cast =:: x
          b constAsInt if ..drop 0 true return end i8 cast =:: y
          x y == if 0 else x y > _if 1 else -1 end false return
        I16 case
          a constAsInt if ..drop 0 true return end i16 cast =:: x
          b constAsInt if ..drop 0 true return end i16 cast =:: y
          x y == if 0 else x y > _if 1 else -1 end false return
        I32 case
          a constAsInt if ..drop 0 true return end i32 cast =:: x
          b constAsInt if ..drop 0 true return end i32 cast =:: y
          x y == if 0 else x y > _if 1 else -1 end false return
        I64 case
          a constAsInt if ..drop 0 true return end i64 cast =:: x
          b constAsInt if ..drop 0 true return end i64 cast =:: y
          x y == if 0 else x y > _if 1 else -1 end false return
        FLOAT32 FLOAT64 case
          0 true return ## TODO support compare for floats
        TYPE case
          0 true return
      end
    end
    valType typeContext types.isPointer if
      ## cannot compare string-pointers in constant evaluation
      a constAsInt if ..drop 0 true return end =:: x
      b constAsInt if ..drop 0 true return end =:: y
      x y == if 0 else x y > _if 1 else -1 end false return
    end
    0 true return
  end
  proc(
    ConstValue : a
    ConstValue : b
    Type : valType0
    TypeContext ptr : typeContext
  -> i32  bool ) =>: export operatorUnsignedCompare
    valType0 typeContext types.unwrapNamed =:: valType
    valType .primitiveType ?? if
      valType .primitiveType switch
        I8 case
          a constAsInt if ..drop 0 true return end i8 cast =:: x
          b constAsInt if ..drop 0 true return end i8 cast =:: y
          x y == if 0 else x y ..u> _if 1 else -1 end false return
        I16 case
          a constAsInt if ..drop 0 true return end i16 cast =:: x
          b constAsInt if ..drop 0 true return end i16 cast =:: y
          x y == if 0 else x y ..u> _if 1 else -1 end false return
        I32 case
          a constAsInt if ..drop 0 true return end i32 cast =:: x
          b constAsInt if ..drop 0 true return end i32 cast =:: y
          x y == if 0 else x y ..u> _if 1 else -1 end false return
        I64 case
          a constAsInt if ..drop 0 true return end i64 cast =:: x
          b constAsInt if ..drop 0 true return end i64 cast =:: y
          x y == if 0 else x y ..u> _if 1 else -1 end false return
        BOOL FLOAT32 FLOAT64 TYPE case
          0 true return
      end
    end
    0 true return
  end

  proc( ConstValue : a ConstValue : b -> ConstValue bool ) =>: export operatorF32LT
    a constAsF32 if ..drop a true return end =:: x
    b constAsF32 if ..drop a true return end =:: y
    x y < ConstValue .boolean false return
  end
  proc( ConstValue : a ConstValue : b -> ConstValue bool ) =>: export operatorF64LT
    a constAsF64 if ..drop a true return end =:: x
    b constAsF64 if ..drop a true return end =:: y
    x y < ConstValue .boolean false return
  end
  proc( ConstValue : a ConstValue : b -> ConstValue bool ) =>: export operatorF32LE
    a constAsF32 if ..drop a true return end =:: x
    b constAsF32 if ..drop a true return end =:: y
    x y <= ConstValue .boolean false return
  end
  proc( ConstValue : a ConstValue : b -> ConstValue bool ) =>: export operatorF64LE
    a constAsF64 if ..drop a true return end =:: x
    b constAsF64 if ..drop a true return end =:: y
    x y <= ConstValue .boolean false return
  end
  proc( ConstValue : a ConstValue : b -> ConstValue bool ) =>: export operatorF32GE
    a constAsF32 if ..drop a true return end =:: x
    b constAsF32 if ..drop a true return end =:: y
    x y >= ConstValue .boolean false return
  end
  proc( ConstValue : a ConstValue : b -> ConstValue bool ) =>: export operatorF64GE
    a constAsF64 if ..drop a true return end =:: x
    b constAsF64 if ..drop a true return end =:: y
    x y >= ConstValue .boolean false return
  end
  proc( ConstValue : a ConstValue : b -> ConstValue bool ) =>: export operatorF32GT
    a constAsF32 if ..drop a true return end =:: x
    b constAsF32 if ..drop a true return end =:: y
    x y > ConstValue .boolean false return
  end
  proc( ConstValue : a ConstValue : b -> ConstValue bool ) =>: export operatorF64GT
    a constAsF64 if ..drop a true return end =:: x
    b constAsF64 if ..drop a true return end =:: y
    x y > ConstValue .boolean false return
  end

  ## old operator functions, for comparability

  proc( Type : opType ConstValue : a -> Type ConstValue bool ) =>: export operator-_
    opType .primitiveType ?? ! if ## unsupported type for constant evaluation
      Type .undefined ConstValue .none true return
    end
    opType .primitiveType switch
      I8 I16 I32 I64 case
        a constAsInt =:: e1
        -_ ConstValue .int opType ..swap e1 return
      FLOAT32 case
        a constAsF32 =:: e1
        -_ ConstValue .Float opType ..swap e1 return
      FLOAT64 case
        a constAsF64 =:: e1
        -_ ConstValue .Float opType ..swap e1 return
      BOOL TYPE case
        Type .undefined ConstValue .none true return
    end
  end
  proc( Type : opType ConstValue : a -> Type ConstValue bool ) =>: export operator!
    opType .primitiveType ?? ! if ## unsupported type for constant evaluation
      Type .undefined ConstValue .none true return
    end
    opType .primitiveType switch
      BOOL case
        a constAsBool =:: e1
        ! ConstValue .boolean opType ..swap e1 return
      I8 I16 I32 I64 FLOAT32 FLOAT64 TYPE case
        Type .undefined ConstValue .none true return
    end
  end
  proc( Type : opType ConstValue : a -> Type ConstValue bool ) =>: export operator~
    opType .primitiveType ?? ! if ## unsupported type for constant evaluation
      Type .undefined ConstValue .none true return
    end
    opType .primitiveType switch
      I8 case
        a constAsInt =:: e1 i8 cast
        ~ ConstValue .int opType ..swap e1 return
      I16 case
        a constAsInt =:: e1 i16 cast
        ~ ConstValue .int opType ..swap e1 return
      I32 case
        a constAsInt =:: e1 i32 cast
        ~ ConstValue .int opType ..swap e1 return
      I64 case
        a constAsInt =:: e1
        ~ ConstValue .int opType ..swap e1 return
      BOOL FLOAT32 FLOAT64 TYPE case
        Type .undefined ConstValue .none true return
    end
  end


  proc( Type : opType ConstValue : a ConstValue : b -> Type ConstValue bool ) =>: export operator+
    opType .primitiveType ?? ! if ## unsupported type for constant evaluation
      Type .undefined ConstValue .none true return
    end
    opType .primitiveType switch
      I8 I16 I32 I64 case
        a constAsInt =:: e1
        b constAsInt =:: e2
        + ConstValue .int opType ..swap e1 e2 | return
      FLOAT32 case
        a constAsF32 =:: e1
        b constAsF32 =:: e2
        + ConstValue .Float opType ..swap e1 e2 | return
      FLOAT64 case
        a constAsF64 =:: e1
        b constAsF64 =:: e2
        + ConstValue .Float opType ..swap e1 e2 | return
      BOOL TYPE case
        Type .undefined ConstValue .none true return
    end
  end
  proc( Type : opType ConstValue : a ConstValue : b -> Type ConstValue bool ) =>: export operator-
    opType .primitiveType ?? ! if ## unsupported type for constant evaluation
      Type .undefined ConstValue .none true return
    end
    opType .primitiveType switch
      I8 I16 I32 I64 case
        a constAsInt =:: e1
        b constAsInt =:: e2
        - ConstValue .int opType ..swap e1 e2 | return
      FLOAT32 case
        a constAsF32 =:: e1
        b constAsF32 =:: e2
        - ConstValue .Float opType ..swap e1 e2 | return
      FLOAT64 case
        a constAsF64 =:: e1
        b constAsF64 =:: e2
        - ConstValue .Float opType ..swap e1 e2 | return
      BOOL TYPE case
        Type .undefined ConstValue .none true return
    end
  end
  proc( Type : opType ConstValue : a ConstValue : b -> Type ConstValue bool ) =>: export operator*
    opType .primitiveType ?? ! if ## unsupported type for constant evaluation
      Type .undefined ConstValue .none true return
    end
    opType .primitiveType switch
      I8 I16 I32 I64 case
        a constAsInt =:: e1
        b constAsInt =:: e2
        * ConstValue .int opType ..swap e1 e2 | return
      FLOAT32 case
        a constAsF32 =:: e1
        b constAsF32 =:: e2
        * ConstValue .Float opType ..swap e1 e2 | return
      FLOAT64 case
        a constAsF64 =:: e1
        b constAsF64 =:: e2
        * ConstValue .Float opType ..swap e1 e2 | return
      BOOL TYPE case
        Type .undefined ConstValue .none true return
    end
  end
  proc( Type : opType ConstValue : a ConstValue : b -> Type ConstValue bool ) =>: export operator/
    opType .primitiveType ?? ! if ## unsupported type for constant evaluation
      Type .undefined ConstValue .none true return
    end
    opType .primitiveType switch
      I8 I16 I32 I64 case
        a constAsInt =:: e1
        b constAsInt =:: e2
        / ConstValue .int opType ..swap e1 e2 | return
      FLOAT32 case
        a constAsF32 =:: e1
        b constAsF32 =:: e2
        / ConstValue .Float opType ..swap e1 e2 | return
      FLOAT64 case
        a constAsF64 =:: e1
        b constAsF64 =:: e2
        / ConstValue .Float opType ..swap e1 e2 | return
      BOOL TYPE case
        Type .undefined ConstValue .none true return
    end
  end
  proc( Type : opType ConstValue : a ConstValue : b -> Type ConstValue bool ) =>: export operator_unsigned/
    opType .primitiveType ?? ! if ## unsupported type for constant evaluation
      Type .undefined ConstValue .none true return
    end
    opType .primitiveType switch
      I8 case
        a constAsInt =:: e1 0xff &
        b constAsInt =:: e2 0xff &
        ..udiv ConstValue .int opType ..swap e1 e2 | return
      I16 case
        a constAsInt =:: e1 0xffff &
        b constAsInt =:: e2 0xffff &
        ..udiv ConstValue .int opType ..swap e1 e2 | return
      I32 case
        a constAsInt =:: e1 0xffff_ffff &
        b constAsInt =:: e2 0xffff_ffff &
        ..udiv ConstValue .int opType ..swap e1 e2 | return
      I64 case
        a constAsInt =:: e1
        b constAsInt =:: e2
        ..udiv ConstValue .int opType ..swap e1 e2 | return
      FLOAT32 FLOAT64 BOOL TYPE case
        Type .undefined ConstValue .none true return
    end
  end
  proc( Type : opType ConstValue : a ConstValue : b -> Type ConstValue bool ) =>: export operator%
    opType .primitiveType ?? ! if ## unsupported type for constant evaluation
      Type .undefined ConstValue .none true return
    end
    opType .primitiveType switch
      I8 I16 I32 I64 case
        a constAsInt =:: e1
        b constAsInt =:: e2
        % ConstValue .int opType ..swap e1 e2 | return
      FLOAT32 case
        a constAsF32 =:: e1
        b constAsF32 =:: e2
        % ConstValue .Float opType ..swap e1 e2 | return ##XXX? float32 constants
      FLOAT64 case
        a constAsF64 =:: e1
        b constAsF64 =:: e2
        % ConstValue .Float opType ..swap e1 e2 | return
      BOOL TYPE case
        Type .undefined ConstValue .none true return
    end
  end
  proc( Type : opType ConstValue : a ConstValue : b -> Type ConstValue bool ) =>: export operator_unsigned%
    opType .primitiveType ?? ! if ## unsupported type for constant evaluation
      Type .undefined ConstValue .none true return
    end
    opType .primitiveType switch
      I8 case
        a constAsInt =:: e1 0xff &
        b constAsInt =:: e2 0xff &
        ..umod ConstValue .int opType ..swap e1 e2 | return
      I16 case
        a constAsInt =:: e1 0xffff &
        b constAsInt =:: e2 0xffff &
        ..umod ConstValue .int opType ..swap e1 e2 | return
      I32 case
        a constAsInt =:: e1 0xffff_ffff &
        b constAsInt =:: e2 0xffff_ffff &
        ..umod ConstValue .int opType ..swap e1 e2 | return
      I64 case
        a constAsInt =:: e1
        b constAsInt =:: e2
        ..umod ConstValue .int opType ..swap e1 e2 | return
      FLOAT32 FLOAT64 BOOL TYPE case
        Type .undefined ConstValue .none true return
    end
  end
  proc( Type : opType ConstValue : a ConstValue : b -> Type ConstValue bool ) =>: export operator&
    opType .primitiveType ?? ! if ## unsupported type for constant evaluation
      Type .undefined ConstValue .none true return
    end
    opType .primitiveType switch
      I8 I16 I32 I64 case
        a constAsInt =:: e1
        b constAsInt =:: e2
        & ConstValue .int opType ..swap e1 e2 | return
      BOOL case
        a constAsBool =:: e1
        b constAsBool =:: e2
        & ConstValue .boolean opType ..swap e1 e2 | return
      FLOAT32 FLOAT64 TYPE case
        Type .undefined ConstValue .none true return
    end
  end
  proc( Type : opType ConstValue : a ConstValue : b -> Type ConstValue bool ) =>: export operator|
    opType .primitiveType ?? ! if ## unsupported type for constant evaluation
      Type .undefined ConstValue .none true return
    end
    opType .primitiveType switch
      I8 I16 I32 I64 case
        a constAsInt =:: e1
        b constAsInt =:: e2
        | ConstValue .int opType ..swap e1 e2 | return
      BOOL case
        a constAsBool =:: e1
        b constAsBool =:: e2
        | ConstValue .boolean opType ..swap e1 e2 | return
      FLOAT32 FLOAT64 TYPE case
        Type .undefined ConstValue .none true return
    end
  end
  proc( Type : opType ConstValue : a ConstValue : b -> Type ConstValue bool ) =>: export operator^
    opType .primitiveType ?? ! if ## unsupported type for constant evaluation
      Type .undefined ConstValue .none true return
    end
    opType .primitiveType switch
      I8 I16 I32 I64 case
        a constAsInt =:: e1
        b constAsInt =:: e2
        ^ ConstValue .int opType ..swap e1 e2 | return
      BOOL case
        a constAsBool =:: e1
        b constAsBool =:: e2
        ^ ConstValue .boolean opType ..swap e1 e2 | return
      FLOAT32 FLOAT64 TYPE case
        Type .undefined ConstValue .none true return
    end
  end
  proc( Type : opType ConstValue : a ConstValue : b -> Type ConstValue bool ) =>: export operator<<
    opType .primitiveType ?? ! if ## unsupported type for constant evaluation
      Type .undefined ConstValue .none true return
    end
    opType .primitiveType switch
      I8 I16 I32 I64 case
        a constAsInt =:: e1
        b constAsInt =:: e2
        << ConstValue .int opType ..swap e1 e2 | return
      FLOAT32 FLOAT64 BOOL TYPE case
        Type .undefined ConstValue .none true return
    end
  end
  proc( Type : opType ConstValue : a ConstValue : b -> Type ConstValue bool ) =>: export operator>>
    opType .primitiveType ?? ! if ## unsupported type for constant evaluation
      Type .undefined ConstValue .none true return
    end
    opType .primitiveType switch
      I8 case
        a constAsInt =:: e1 i8 cast
        b constAsInt =:: e2 i8 cast
        >> ConstValue .int opType ..swap e1 e2 | return
      I16 case
        a constAsInt =:: e1 i16 cast
        b constAsInt =:: e2 i16 cast
        >> ConstValue .int opType ..swap e1 e2 | return
      I32 case
        a constAsInt =:: e1 i32 cast
        b constAsInt =:: e2 i32 cast
        >> ConstValue .int opType ..swap e1 e2 | return
      I64 case
        a constAsInt =:: e1
        b constAsInt =:: e2
        >> ConstValue .int opType ..swap e1 e2 | return
      FLOAT32 FLOAT64 BOOL TYPE case
        Type .undefined ConstValue .none true return
    end
  end
  proc( Type : opType ConstValue : a ConstValue : b -> Type ConstValue bool ) =>: export operator_unsigned>>
    opType .primitiveType ?? ! if ## unsupported type for constant evaluation
      Type .undefined ConstValue .none true return
    end
    opType .primitiveType switch
      I8 case
        a constAsInt =:: e1 0xff &
        b constAsInt =:: e2 i8 cast
        ..lshr ConstValue .int opType ..swap e1 e2 | return
      I16 case
        a constAsInt =:: e1 0xffff &
        b constAsInt =:: e2 i16 cast
        ..lshr ConstValue .int opType ..swap e1 e2 | return
      I32 case
        a constAsInt =:: e1 0xffff_ffff &
        b constAsInt =:: e2 i32 cast
        ..lshr ConstValue .int opType ..swap e1 e2 | return
      I64 case
        a constAsInt =:: e1
        b constAsInt =:: e2
        ..lshr ConstValue .int opType ..swap e1 e2 | return
      FLOAT32 FLOAT64 BOOL TYPE case
        Type .undefined ConstValue .none true return
    end
  end
  proc( Type : opType ConstValue : a ConstValue : b TypeContext ptr : tc -> Type ConstValue bool ) =>: export operator==
    opType tc types.isEnum if
      a constAsEnumLabel =:: e1
      b constAsEnumLabel =:: e2
      == ConstValue .boolean types.primitive.BOOL ..swap e1 e2 | return
    end
    opType .primitiveType ?? ! if ## unsupported type for constant evaluation
      Type .undefined ConstValue .none true return
    end
    opType .primitiveType switch
      BOOL case
        a constAsBool =:: e1
        b constAsBool =:: e2
        == ConstValue .boolean types.primitive.BOOL ..swap e1 e2 | return
      I8 case
        a constAsInt =:: e1 i8 cast
        b constAsInt =:: e2 i8 cast
        == ConstValue .boolean types.primitive.BOOL ..swap e1 e2 | return
      I16 case
        a constAsInt =:: e1 i16 cast
        b constAsInt =:: e2 i16 cast
        == ConstValue .boolean types.primitive.BOOL ..swap e1 e2 | return
      I32 case
        a constAsInt =:: e1 i32 cast
        b constAsInt =:: e2 i32 cast
        == ConstValue .boolean types.primitive.BOOL ..swap e1 e2 | return
      I64 case
        a constAsInt =:: e1
        b constAsInt =:: e2
        == ConstValue .boolean types.primitive.BOOL ..swap e1 e2 | return
      FLOAT32 case
        a constAsF32 =:: e1
        b constAsF32 =:: e2
        == ConstValue .boolean types.primitive.BOOL ..swap e1 e2 | return
      FLOAT64 case
        a constAsF64 =:: e1
        b constAsF64 =:: e2
        == ConstValue .boolean types.primitive.BOOL ..swap e1 e2 | return
      TYPE case
        a constAsType =:: e1
        b constAsType =:: e2
        types.typeEquals ConstValue .boolean types.primitive.BOOL ..swap e1 e2 | return
    end
  end
  proc( Type : opType ConstValue : a ConstValue : b TypeContext ptr : tc -> Type ConstValue bool ) =>: export operator!=
    opType tc types.isEnum if
      a constAsEnumLabel =:: e1
      b constAsEnumLabel =:: e2
      != ConstValue .boolean types.primitive.BOOL ..swap e1 e2 | return
    end
    opType .primitiveType ?? ! if ## unsupported type for constant evaluation
      Type .undefined ConstValue .none true return
    end
    opType .primitiveType switch
      BOOL case
        a constAsBool =:: e1
        b constAsBool =:: e2
        != ConstValue .boolean types.primitive.BOOL ..swap e1 e2 | return
      I8 case
        a constAsInt =:: e1 i8 cast
        b constAsInt =:: e2 i8 cast
        != ConstValue .boolean types.primitive.BOOL ..swap e1 e2 | return
      I16 case
        a constAsInt =:: e1 i16 cast
        b constAsInt =:: e2 i16 cast
        != ConstValue .boolean types.primitive.BOOL ..swap e1 e2 | return
      I32 case
        a constAsInt =:: e1 i32 cast
        b constAsInt =:: e2 i32 cast
        != ConstValue .boolean types.primitive.BOOL ..swap e1 e2 | return
      I64 case
        a constAsInt =:: e1
        b constAsInt =:: e2
        != ConstValue .boolean types.primitive.BOOL ..swap e1 e2 | return
      FLOAT32 case
        a constAsF32 =:: e1
        b constAsF32 =:: e2
        != ConstValue .boolean types.primitive.BOOL ..swap e1 e2 | return
      FLOAT64 case
        a constAsF64 =:: e1
        b constAsF64 =:: e2
        != ConstValue .boolean types.primitive.BOOL ..swap e1 e2 | return
      TYPE case
        a constAsType =:: e1
        b constAsType =:: e2
        types.typeEquals ! ConstValue .boolean types.primitive.BOOL ..swap e1 e2 | return
    end
  end
  proc( Type : opType ConstValue : a ConstValue : b -> i8 bool ) =>: operator_compare
    opType .primitiveType ?? ! if ## unsupported type for constant evaluation
      0i8 true return
    end
    opType .primitiveType switch
      I8 case
        a constAsInt =:: e1 i8 cast =:: x
        b constAsInt =:: e2 i8 cast =:: y
        x y == if 0i8 else x y > _if 1i8 else -1i8 end e1 e2 | return
      I16 case
        a constAsInt =:: e1 i16 cast =:: x
        b constAsInt =:: e2 i16 cast =:: y
        x y == if 0i8 else x y > _if 1i8 else -1i8 end e1 e2 | return
      I32 case
        a constAsInt =:: e1 i32 cast =:: x
        b constAsInt =:: e2 i32 cast =:: y
        x y == if 0i8 else x y > _if 1i8 else -1i8 end e1 e2 | return
      I64 case
        a constAsInt =:: e1 =:: x
        b constAsInt =:: e2 =:: y
        x y == if 0i8 else x y > _if 1i8 else -1i8 end e1 e2 | return
      FLOAT32 case
        a constAsF32 =:: e1 =:: x
        b constAsF32 =:: e2 =:: y
        x y == if 0i8 else x y > _if 1i8 else -1i8 end e1 e2 | return
      FLOAT64 case
        a constAsF64 =:: e1 =:: x
        b constAsF64 =:: e2 =:: y
        x y == if 0i8 else x y > _if 1i8 else -1i8 end e1 e2 | return
      BOOL TYPE case
        0i8 true return
    end
  end
  proc( Type : opType ConstValue : a ConstValue : b -> Type ConstValue bool ) =>: export operator<
    opType a b operator_compare if ..drop
      Type .undefined ConstValue .none true return
    end
    0i8 < ConstValue .boolean types.primitive.BOOL ..swap false return
  end
  proc( Type : opType ConstValue : a ConstValue : b -> Type ConstValue bool ) =>: export operator<=
