      b err pos constAsInt =:: e2 =:: y
      x y == if 0i8 else x y >u _if 1i8 else -1i8 end e1 e2 | return
    BOOL FLOAT32 FLOAT64 TYPE case
      "unsupported type for operator*" sb.wrap pos err appendError
      0i8 true return
  end
end
proc( Type : opType ConstValue : a ConstValue : b CompilerError list ptr mut : err FilePosition : pos => Type ConstValue bool ) =: public operator_unsigned<
  opType a b err pos operator_unsigned_compare if #drop
    Type .undefined ConstValue .none true return
  end
  0i8 < ConstValue .boolean new types.primitive.BOOL #swap false return
end
