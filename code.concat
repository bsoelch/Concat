
 
enum( A i32 : B i64 : ERROR ) =:: e

( i32 i64 ) =:: ERROR

struct( i32 : mut a i32 : b ) =:: struct

## TODO when assigning value to explicit variable, ensure that all previous occurrences of the same variable are buffered 
## assigning values to stack variables modifies all occurrences of the same value on stack, setting value only changes to occurrence
proc( i64 ptr mut : arg => i64 ) =: offsetConstants
  arg []
    2 arg [] =
  return
end
 ## FIXME wrong constant types in switch are not detected correctly
entryPoint:
  e .A switch
    A case
      break
    B case 
      break
    ERROR case
      break
  end
  ## FIXME pointer to mutable element of const tuple
  0 0 struct new =:: s
  s .a addrOf
  s .b addrOf 
  #types
  #drop 1 #swap [] =
  s .a print
  s .b print
end


