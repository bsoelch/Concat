#include "include.concat"
#include io
#include mem
#include string

#using std

entryPoint:
  1024 1024 * 16 * i32 mem.alloc i32 rawptr mut =: dynamicArray
  dynamicArray print
  dynamicArray 0 [] print
  dynamicArray 1000000 [] print

  "Hello World!" io.puts print

  16 std.newStringBuffer
    "Hello" sb_appendStr
    ' '     sb_appendC
    "World" sb_appendStr
    '\n'    sb_appendC
    -12345678             sb_appendI   '\n' sb_appendC
    "0x"                  sb_appendStr
    0x1234567             sb_appendHex '\n' sb_appendC
    "0b"                  sb_appendStr
    0b11001001            sb_appendBin '\n' sb_appendC
    0x7fff_ffff_ffff_ffff sb_appendHex  '\n' sb_appendC
   -0x8000_0000_0000_0000 sb_appendI    '\n' sb_appendC
   -1                     sb_appendU    '\n' sb_appendC
   -1                     sb_appendUBin '\n' sb_appendC
  =:: buff
  io.stdOut buff .data 0 buff .count io.fwrite print print
end

proc( => i32 ) =: test
 9
end
