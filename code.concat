
entryPoint:
  1024 1024 * 16 * i32 alloc i32 rawptr mut =: dynamicArray
  dynamicArray print
  dynamicArray 0 [] print
  dynamicArray 1000000 [] print

  "Hello World!" puts
end

proc( i64 : k  type : static T => T rawptr mut ) : extern alloc
type : extern _FILE
_FILE ptr mut =:: FILE
proc( => FILE ) : extern stdOut
proc( string => FILE ) : extern fopen
proc( FILE string => ) : extern fputs
proc( string : str => ) =: puts
  stdOut
    #dup str fputs
  "\n" fputs
end
proc( FILE => ) : extern fclose
 
