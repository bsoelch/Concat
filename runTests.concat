import argParse
import numbers
import print
import numbers/print
import file
import exec

{ "./tests":s } =:: DEFAULT_TESTS
{ "./tests":s "./examples":s } =:: DEFAULT_TESTS_FULL

"./concat":s =:: mut: COMPILER_PATH
0 =:: mut: THREAD_COUNT
string list.empty =:: mut: CCT_ARGS

0 =:: mut: TESTED
0 =:: mut: PASSED
string list.empty =:: mut: FAILED
sb.empty =:: mut: BASE_PATH

proc( string : filePath -> ) =>: runTest
  TESTED 1 + TESTED= ## TODO: atomic increment
  filePath $ '.' string.lastIndexOf .if string.head end =:: basePath
  basePath .length 3 + sb.create
    basePath sb.appendStr ".in\x00":s sb.appendStr
  =:: inPath
  basePath .length 6 + sb.create
    basePath sb.appendStr ".out2\x00":s sb.appendStr
  =:: outPath
  basePath .length 6 + sb.create
    basePath sb.appendStr ".err2\x00":s sb.appendStr
  =:: errPath
  basePath .length 5 + sb.create
    basePath sb.appendStr ".args\x00":s sb.appendStr
  =:: mut: tmpPath
  COMPILER_PATH exec.build
    filePath exec.add
    "-o":s exec.add basePath exec.add
    "-l":s exec.add "./lib/":s exec.add
    CCT_ARGS for exec.add end
    outPath sb.asStr exec.setStdOut
    errPath sb.asStr exec.setStdErr
  exec.run exec.check if
    basePath exec.build
      tmpPath sb.asStr file.OpenMode .READ file.open
        $ file.isFile if
          file.readAll
            $ sb.asStr while $ .length 0 != do
              '\n' string.split >>>>$ <$ exec.add <<<$
            end ..drop
            $ sb.asStr "\n":s string.endsWith if
              >>$ "":s exec.add <<$
            end
          sb.free ..drop
        end
      file.close
      inPath sb.asStr exec.setStdIn
      outPath sb.asStr exec.appendStdOut
      errPath sb.asStr exec.appendStdErr
    exec.run exec.check ..drop
  end
  inPath sb.free ..drop
  outPath sb.asStr file.OpenMode .READ file.open
    file.readAll =:: programOutput
  file.close
  tmpPath
    basePath .length sb.setLength
    ".out\x00":s sb.appendStr
  tmpPath=
  tmpPath sb.asStr file.OpenMode .READ file.open
    file.readAll
      $ sb.asStr programOutput sb.asStr string.eq
        $ =:: outputEqual
      if
        outPath sb.asStr false file.delete ..drop
      end
    sb.free ..drop
    programOutput sb.free ..drop
  file.close
  errPath sb.asStr file.OpenMode .READ file.open
    file.readAll =:: progamErrors
  file.close
  tmpPath
    basePath .length sb.setLength
    ".err\x00":s sb.appendStr
  tmpPath=
  tmpPath sb.asStr file.OpenMode .READ file.open
    file.readAll
      $ sb.asStr progamErrors sb.asStr string.eq
        $ =:: errorsEqual
      if
        errPath sb.asStr false file.delete ..drop
      end
    sb.free ..drop
    progamErrors sb.free ..drop
  file.close
  outputEqual and errorsEqual if
    PASSED 1 + PASSED= ## TODO: atomic increment
    "PASSED: ":s io.print basePath io.println
    ## cleanup temporary files
    tmpPath
      basePath .length sb.setLength
      ".ssa\x00":s sb.appendStr
    tmpPath=
    tmpPath sb.asStr false file.delete ..drop
    tmpPath
      basePath .length sb.setLength
      ".s\x00":s sb.appendStr
    tmpPath=
    tmpPath sb.asStr false file.delete ..drop
    tmpPath
      basePath .length sb.setLength
      '\x00' sb.appendC
    tmpPath=
    tmpPath sb.asStr false file.delete ..drop
  else
    "FAILED: ":s io.print basePath io.println
    ## TODO: lock list access
    FAILED
      filePath string.copy list.append
    FAILED=
  end
  outPath sb.free ..drop
  errPath sb.free ..drop
  tmpPath sb.free ..drop
end
proc( char8 slice.mut : filePath -> ) =>: runTestAsync
  filePath slice.freeze string.fromChars =:: filePathStr
  ## TODO: run test asynchronously using thread-pool
  filePathStr runTest
  filePath slice.free ..drop
end

proc( file.File -> file.File ) =>: runTestsInDirImpl
  $ file.entries for =:: fileName
    BASE_PATH
      $ .length =:: offset
      '/' sb.appendC
      fileName sb.appendStr
      '\x00' sb.appendC
    BASE_PATH=
    BASE_PATH sb.asStr file.OpenMode .DIR file.open
      $ file.isDir if
        BASE_PATH
          $ .length 1 - sb.setLength ## discard null-terminator
        BASE_PATH=
        runTestsInDirImpl
      end
    file.close
    fileName ".concat":s string.endsWith if
      THREAD_COUNT 0 u> if ## need owned string in async mode
        BASE_PATH sb.asStr string.chars slice.copy runTestAsync
      else
        BASE_PATH sb.asStr runTest
      end
    end
    BASE_PATH
      offset sb.setLength
    BASE_PATH=
  end ..drop
end
## TODO: allow running single files
proc( string : dirName -> ) =>: runTestsInDir
  BASE_PATH
    sb.clear
    dirName sb.appendStr
  BASE_PATH=
  dirName file.OpenMode .DIR file.open
    runTestsInDirImpl
  file.close
end

proc( -> ) =>: export: main
  false =:: mut: devVersion
  false =:: mut: includeExamples
  false =:: mut: hasPaths
  string.empty =:: mut: threadCountStr
  string list.empty =:: mut: testPathBuf
  args.start
    "-":s args.prefixes ## set argument prefix
    "[options] (-- test-paths)*":s args.usage
    arg.flag
      "use development version of compiler":s arg.helpText
    devVersion@ "-X":s arg.set
    arg.flag
      "include examples":s arg.helpText
    includeExamples@ "-full":s arg.set
    arg.flag
      "include examples":s arg.helpText
    includeExamples@ "--full":s arg.set
    arg.value
      "[thread cound]":s arg.value.setArgName
      "run tests on multiple threads, should be followed by a number specifiying the thread count":s arg.helpText
    threadCountStr@ "-j":s arg.set
    arg.values
      "[arg]":s arg.values.setArgName
      "add compiler-argument, can occur more than once":s arg.helpText
    CCT_ARGS@ "-cctArg":s arg.collect
    arg.values
      "[arg]":s arg.values.setArgName
      "add compiler-argument, can occur more than once":s arg.helpText
    CCT_ARGS@ "--cctArg":s arg.collect
    arg.flag
      "use remaining arguments as test-paths":s arg.helpText
      testPathBuf@ arg.flag.consumeTail
      "[paths]":s arg.flag.setArgName
    hasPaths@ "--":s arg.set
    "-h":s args.HelpLevel .DEFAULT arg.help
  args.parse if
    1 sys.exit
  end
  hasPaths if
    includeExamples if
      "`-full` is ignored with explicit arguments":s io.println
    end
    testPathBuf list.asSlice
  else includeExamples _if
    DEFAULT_TESTS_FULL@ slice.wrap
  else
    DEFAULT_TESTS@ slice.wrap
  end =:: testPaths
  devVersion if
    "running tests on development version of compiler":s io.println
    "./concatX":s
  else
    "./concat":s
  end COMPILER_PATH=
  CCT_ARGS .length 0 != if
    "running with arguments:":s io.print
    CCT_ARGS for ' ' io.print io.print end '\n' io.print
  end
  threadCountStr .length 0 != if
    threadCountStr 10 number.tryParseUInt .NONE ! if
      "could not parse thread count, expected unsigned integer got: ":s io.print threadCountStr io.println
    end
    $ 255 > if ..drop 255
      "thread count can be at most 255 got: ":s io.print threadCountStr io.println
    end
    $ 0 > if
      "running asynchronously on ":s io.print $ io.print " threads":s io.println
    end
  else 0 end i32 cast.u THREAD_COUNT=
  THREAD_COUNT 0 u> if
    ## TODO: prepare thread-pool
    "! multi-threading is not supported!":s io.println
  end
  testPaths for runTestsInDir end
  ## TODO: join thread pool
  PASSED TESTED == if
    "SUCCESS: passed ":s io.print
    PASSED io.print
    " tests":s io.println
  else
    "FAILURE: passed ":s io.print
    PASSED io.print
    " of ":s io.print
    TESTED io.print
    " tests":s io.println
    FAILED for
      "  ":s io.print io.println
    end
  end
  testPathBuf list.free ..drop
  CCT_ARGS list.free ..drop
  FAILED list.free ..drop
  BASE_PATH sb.free ..drop
end
